{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "packages/**",
    "apps/**/astro.config.ts",
    "apps/**/package.json",
    "apps/**/tsconfig.json",
    "**/.env",
    "public/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".astro/dist/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "preview": {
      "dependsOn": [
        "^preview"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}