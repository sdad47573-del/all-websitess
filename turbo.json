{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "concurrency": "200",
  "cacheDir": "node_modules/.cache/turbo",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".astro/dist/**",
        "dist/**",
        ".vercel/output/**",
        "packages/@assets/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "supabase:types": {
      "dependsOn": [
        "^supabase:types"
      ]
    },
    "test:ui": {
      "dependsOn": [
        "^test:ui"
      ]
    },
    "migrate": {
      "dependsOn": [
        "^migrate"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "preview": {
      "dependsOn": [
        "^preview"
      ]
    },
    "storybook": {
      "dependsOn": [
        "^storybook"
      ]
    },
    "build-storybook": {
      "dependsOn": [
        "^build-storybook"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
