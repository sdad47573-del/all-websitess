{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".astro/dist/**",
        "dist/**",
        "packages/@assets/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "migrate": {
      "dependsOn": [
        "^migrate"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "preview": {
      "dependsOn": [
        "^preview"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}