---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES } from '../data/site';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<section id="inicio" class="hero-totalbeauty relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.fotoEsmaltes}
			alt="Esmaltes de uñas del salón Sofía García Total Beauty (Málaga)"
			widths={[600, 1000]}
			sizes="100vw"
			quality={78}
			loading="eager"
			fetchpriority="high"
			format="webp"
			class="h-full w-full object-cover opacity-45"
		/>
		<div class="from-neutral/88 via-neutral/30 absolute inset-0 bg-gradient-to-r"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-32">
		<div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
			<div>
				<p
					class="text-accent inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase"
				>
					<span><i class="ri-map-pin-line"></i> {BUSINESS.district} · {BUSINESS.city}</span>
					<span class="text-white/60">Con cita previa</span>
				</p>
				<h1 class="font-display mt-4 text-4xl leading-[1.05] font-bold sm:text-5xl lg:text-6xl" set:html={piezas.portada.titulo} />
				<p class="font-display mt-3 text-xl font-semibold text-white/85 sm:text-2xl">
					Salón de belleza y manicuras en Málaga
				</p>
				<p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80">
					En la calle Mesonero Romanos, 10, a pasos del centro histórico de Málaga. Manicuras y
					diseños de uñas cuidados <strong class="text-white">al detalle</strong>, con productos de
					alta calidad y <strong class="text-white">valoración 5,0</strong> en Google.
				</p>

				<div class="mt-8 flex flex-wrap gap-3">
					<a
						href={BUSINESS.whatsapp}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-secondary btn-lg gap-2 rounded-full"
					>
						<i class="ri-whatsapp-line"></i>
						Pedir cita por WhatsApp
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline btn-lg hover:text-neutral rounded-full border-white/40 bg-white/5 text-white hover:border-white hover:bg-white"
					>
						<i class="ri-map-pin-line"></i> Cómo llegar
					</a>
				</div>

				<dl class="mt-10 grid max-w-lg grid-cols-3 gap-x-6 gap-y-5">
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Valoración</dt>
						<dd class="font-display mt-1 text-xl font-bold">{BUSINESS.ratingDisplay}★</dd>
					</div>
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Reseñas</dt>
						<dd class="font-display mt-1 text-xl font-bold">{BUSINESS.reviewsCount}</dd>
					</div>
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Teléfono</dt>
						<dd class="font-display mt-1 text-xl font-bold">{BUSINESS.phoneDisplay}</dd>
					</div>
				</dl>
				<p class="mt-4 text-xs text-white/55">
					Citas de lunes a viernes. Escríbele por WhatsApp para reservar.
				</p>
			</div>

			<figure class="relative hidden lg:block">
				<div
					class="etiqueta-totalbeauty rounded-box rotate-2 overflow-hidden shadow-2xl ring-1 ring-white/15"
				>
					<Image
						src={IMAGES.fotoManicura}
						alt="Manicura con esmalte morado realizada en Sofía García Total Beauty (Málaga)"
						widths={[500, 900]}
						sizes="(min-width: 1024px) 36vw, 90vw"
						quality={86}
						loading="eager"
						class="aspect-[4/5] w-full object-cover"
					/>
				</div>
				<figcaption
					class="font-display text-accent rounded-box bg-neutral absolute -bottom-5 -left-4 px-5 py-3 text-lg font-bold shadow-xl"
				>
					Mesonero Romanos, 10
				</figcaption>
			</figure>
		</div>
	</div>
</section>
