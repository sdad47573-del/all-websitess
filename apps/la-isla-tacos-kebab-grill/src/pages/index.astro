---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/la-isla-tacos-kebab-grill-apaisada-01.jpg';
import carta from '../assets/fotos/la-isla-tacos-kebab-grill-apaisada-04.jpg';
import interior from '../assets/fotos/la-isla-tacos-kebab-grill-apaisada-06.jpg';
import durumPlancha from '../assets/fotos/la-isla-tacos-kebab-grill-apaisada-10.jpg';
import nevera from '../assets/fotos/la-isla-tacos-kebab-grill-cuadrada-07.jpg';
import kebab from '../assets/fotos/la-isla-tacos-kebab-grill-vertical-02.jpg';
import dulces from '../assets/fotos/la-isla-tacos-kebab-grill-vertical-03.jpg';
import durum from '../assets/fotos/la-isla-tacos-kebab-grill-vertical-05.jpg';
import rincon from '../assets/fotos/la-isla-tacos-kebab-grill-vertical-08.jpg';
import mostrador from '../assets/fotos/la-isla-tacos-kebab-grill-vista-9-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'La Isla, Tacos, Kebab & Grill · Kebab y parrilla en Altea';
const description =
	'La Isla, Tacos, Kebab & Grill, Carrer Garganes, 2 (03590 Altea, Alicante). Kebab, durum, tacos y parrilla halal, con raciones grandes y menús completos. Abierto todos los días hasta la madrugada.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de La Isla en Carrer Garganes, con el rótulo de «Different Kebab» y las mesas de la acera',
	},
	{
		src: kebab,
		alt: 'Un kebab en pan abierto, lleno de pollo, patatas y salsa',
	},
	{
		src: durum,
		alt: 'Un durum envuelto en papel, cortado para que se vea el relleno con salsa',
	},
	{
		src: durumPlancha,
		alt: 'Un durum a la plancha, con las marcas de la parrilla, en su bandeja de aluminio',
	},
	{
		src: dulces,
		alt: 'Bandeja de dulces árabes: baklava con pistacho, triángulos de sésamo y pastelitos de avellana',
	},
	{
		src: mostrador,
		alt: 'El mostrador de La Isla con las bandejas de lechuga, tomate, maíz, cebolla morada y queso',
	},
	{
		src: interior,
		alt: 'El comedor de La Isla, con paredes de ladrillo, bancos corridos y lámparas colgantes',
	},
	{
		src: rincon,
		alt: 'Un rincón del comedor con la camiseta de Marruecos en la pared y el zócalo de azulejos',
	},
	{
		src: carta,
		alt: 'La carta de La Isla en una pantalla sobre el mostrador, con entrantes, ensaladas, kebabs, menús y platos',
	},
	{
		src: nevera,
		alt: 'La nevera de bebidas de La Isla y el comedor al fondo',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que se sirve en La Isla',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-isla`,
	name: BUSINESS.name,
	alternateName: ['La Isla Altea', 'Different Kebab Altea', 'La Isla Tacos Kebab'],
	description:
		'Kebab, durum, tacos y parrilla halal en Carrer Garganes, 2 (03590 Altea, Alicante), con raciones grandes, menús completos y dulces árabes.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34650830069',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Kebab', 'Tacos', 'Parrilla', 'Halal', 'Cocina turca'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Altea' },
		{ '@type': 'AdministrativeArea', name: 'Marina Baixa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '00:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday'],
			opens: '19:00',
			closes: '00:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-isla-tacos-kebab-grill-apaisada-01.jpg": fachada,
	"la-isla-tacos-kebab-grill-vertical-02.jpg": kebab,
	"la-isla-tacos-kebab-grill-vertical-05.jpg": durum,
	"la-isla-tacos-kebab-grill-apaisada-10.jpg": durumPlancha,
	"la-isla-tacos-kebab-grill-vertical-03.jpg": dulces,
	"la-isla-tacos-kebab-grill-vista-9-09.jpg": mostrador,
	"la-isla-tacos-kebab-grill-apaisada-06.jpg": interior,
	"la-isla-tacos-kebab-grill-vertical-08.jpg": rincon,
	"la-isla-tacos-kebab-grill-apaisada-04.jpg": carta,
	"la-isla-tacos-kebab-grill-cuadrada-07.jpg": nevera,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0f5c57" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;800&family=Work+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Isla Altea, kebab Altea, tacos Altea, durum Altea, parrilla halal Altea, comida halal Altea, Carrer Garganes, kebab para llevar"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Kebab, durum, tacos y parrilla halal en Carrer Garganes, 2 (Altea), con raciones grandes y menús completos. Abierto todos los días hasta la madrugada."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de La Isla en Altea, con el rótulo de Different Kebab y las mesas de la acera"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#0f5c57"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Isla"
			subtitle="Tacos, kebab & grill · Altea"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="La Isla"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma platos, precios y horario antes de ir."
			ctaLabel="Llamar a La Isla"
			navAriaLabel="Enlaces de La Isla"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34650830069?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Lo%20que%20se%20sirve%20en%20La%20Isla." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Lo que se sirve en La Isla"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
