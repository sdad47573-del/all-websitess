---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/la-isla-tacos-kebab-grill-apaisada-01.jpg';
import carta from '../assets/fotos/la-isla-tacos-kebab-grill-apaisada-04.jpg';
import interior from '../assets/fotos/la-isla-tacos-kebab-grill-apaisada-06.jpg';
import durumPlancha from '../assets/fotos/la-isla-tacos-kebab-grill-apaisada-10.jpg';
import nevera from '../assets/fotos/la-isla-tacos-kebab-grill-cuadrada-07.jpg';
import kebab from '../assets/fotos/la-isla-tacos-kebab-grill-vertical-02.jpg';
import dulces from '../assets/fotos/la-isla-tacos-kebab-grill-vertical-03.jpg';
import durum from '../assets/fotos/la-isla-tacos-kebab-grill-vertical-05.jpg';
import rincon from '../assets/fotos/la-isla-tacos-kebab-grill-vertical-08.jpg';
import mostrador from '../assets/fotos/la-isla-tacos-kebab-grill-vista-9-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'La Isla, Tacos, Kebab & Grill · Kebab y parrilla en Altea';
const description =
	'La Isla, Tacos, Kebab & Grill, Carrer Garganes, 2 (03590 Altea, Alicante). Kebab, durum, tacos y parrilla halal, con raciones grandes y menús completos. Abierto todos los días hasta la madrugada.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de La Isla en Carrer Garganes, con el rótulo de «Different Kebab» y las mesas de la acera',
	},
	{
		src: kebab,
		alt: 'Un kebab en pan abierto, lleno de pollo, patatas y salsa',
	},
	{
		src: durum,
		alt: 'Un durum envuelto en papel, cortado para que se vea el relleno con salsa',
	},
	{
		src: durumPlancha,
		alt: 'Un durum a la plancha, con las marcas de la parrilla, en su bandeja de aluminio',
	},
	{
		src: dulces,
		alt: 'Bandeja de dulces árabes: baklava con pistacho, triángulos de sésamo y pastelitos de avellana',
	},
	{
		src: mostrador,
		alt: 'El mostrador de La Isla con las bandejas de lechuga, tomate, maíz, cebolla morada y queso',
	},
	{
		src: interior,
		alt: 'El comedor de La Isla, con paredes de ladrillo, bancos corridos y lámparas colgantes',
	},
	{
		src: rincon,
		alt: 'Un rincón del comedor con la camiseta de Marruecos en la pared y el zócalo de azulejos',
	},
	{
		src: carta,
		alt: 'La carta de La Isla en una pantalla sobre el mostrador, con entrantes, ensaladas, kebabs, menús y platos',
	},
	{
		src: nevera,
		alt: 'La nevera de bebidas de La Isla y el comedor al fondo',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que se sirve en La Isla',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-isla`,
	name: BUSINESS.name,
	alternateName: ['La Isla Altea', 'Different Kebab Altea', 'La Isla Tacos Kebab'],
	description:
		'Kebab, durum, tacos y parrilla halal en Carrer Garganes, 2 (03590 Altea, Alicante), con raciones grandes, menús completos y dulces árabes.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34650830069',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Kebab', 'Tacos', 'Parrilla', 'Halal', 'Cocina turca'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Altea' },
		{ '@type': 'AdministrativeArea', name: 'Marina Baixa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '00:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday'],
			opens: '19:00',
			closes: '00:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0f5c57" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;800&family=Work+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Isla Altea, kebab Altea, tacos Altea, durum Altea, parrilla halal Altea, comida halal Altea, Carrer Garganes, kebab para llevar"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Kebab, durum, tacos y parrilla halal en Carrer Garganes, 2 (Altea), con raciones grandes y menús completos. Abierto todos los días hasta la madrugada."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de La Isla en Altea, con el rótulo de Different Kebab y las mesas de la acera"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#0f5c57"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Isla"
			subtitle="Tacos, kebab & grill · Altea"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer Garganes, 2 · Altea (Alicante)"
				title="Tacos, kebab y parrilla, <br /><em>hasta la madrugada.</em>"
				lede={`La Isla es el kebab de Carrer Garganes, en el casco de Altea: toldo blanco, mesas en la acera y un rótulo que avisa de que es un «different kebab». Tacos, durum, kebab en pan y parrilla halal, con raciones que las reseñas describen como enormes. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas y cierra a las 0:30.`}
				image={fachada}
				imageAlt="La fachada de La Isla en Carrer Garganes, con el toldo blanco, el rótulo de kebabs y las mesas de la acera"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>13:00–0:30</b> · lunes desde las 19:00' },
					{ label: 'Cocina', html: '<b>Halal</b> · tacos, kebab y parrilla' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Kebab y tacos"
			/>

			<LocalChips label="Lo que ofrece La Isla" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Carrer Garganes, 2. <br /><em>La barra y el ladrillo.</em>"
				paragraphs={[
					'La Isla está en el número 2 de Carrer Garganes, en pleno casco de Altea, a pocos metros del paseo. La ficha de Google la sitúa en las coordenadas 38.6033005, -0.0455965. La fachada es de piedra clara, con toldo blanco, mesas y sillas metálicas en la acera y un rótulo rojo y negro que anuncia, en inglés y español, el «different kebab».',
					'Dentro hay dos ambientes: el mostrador de acero con las bandejas de ingredientes —lechuga, tomate, maíz, cebolla morada, queso— y la vitrina; y el comedor, con paredes de ladrillo visto, bancos corridos de madera, mesas negras, lámparas de cuerda y un zócalo de azulejos hidráulicos. En una pared cuelga una camiseta de Marruecos y en otra, una pantalla con la carta completa.',
					'En las fotos del perfil se ve lo que sale de la cocina: kebabs en pan abiertos hasta arriba de pollo, patatas y salsa, durums envueltos en papel y otros pasados por la plancha, con las marcas de la parrilla, y una bandeja de dulces árabes con baklava de pistacho, triángulos de sésamo y pastelitos de avellana.',
					`Las reseñas lo confirman: «las raciones son enormes, y los menús sacian en cantidad» y «me encantó el hummus y la pizza turca me impresionó». Con ${RATING.count} opiniones, la media es de ${RATING.label} sobre 5 (noviembre de 2026). Se atiende en el ${BUSINESS.phone}.`,
				]}
				note="La ficha no publica carta con todos los platos ni precios. Lo que aparece en esta página es lo que citan las reseñas y lo que se reconoce en las fotos del perfil; la carta completa se consulta en el local."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> De la plancha al plato</p>
					<h2 id="highlights-title">Kebab, tacos <br /><em>y algo dulce.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Lo que sale <br /><em>del mostrador.</em>"
				description="Sin carta publicada en la ficha: esta lista reúne el nombre del local, la categoría con la que Google lo describe (restaurante halal) y los platos que citan las reseñas y se reconocen en las fotos del perfil."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note={`La carta completa está en la pantalla del local, sobre el mostrador, con entrantes, ensaladas, kebabs, menús y platos. Llama al ${BUSINESS.phone} para preguntar precios o si hacen reparto.`}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La fachada, el comedor <br /><em>y los platos.</em>"
				description="Diez fotografías del perfil de La Isla: la fachada con el toldo y las mesas de la acera, el mostrador de ingredientes, el comedor de ladrillo, un rincón con azulejos, el kebab en pan, el durum en papel, el durum a la plancha, la bandeja de dulces árabes y la carta."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,3 sobre 5, <em>con 475 reseñas.</em></h2>
						<p>
							Google publica una media de 4,3 con 475 opiniones (noviembre de 2026). Las reseñas
							que se ven hablan del tamaño de las raciones, del hummus, de la pizza turca, de la
							atención y de los menús.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span>
											<small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,3</strong>
						<span>★★★★☆</span>
						<small>475 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En el casco de Altea, <br /><em>calle Garganes.</em>"
				addressLines={[BUSINESS.street, BUSINESS.city, `${BUSINESS.postalCode} (Alicante)`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de martes a domingo de 13:00 a 0:30 y el lunes solo por la noche, de 19:00 a 0:30. ${HORARIO_AVISO}`}
				mapTitle="Mapa de La Isla, Tacos, Kebab & Grill, en Carrer Garganes, 2, Altea"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Carrer Garganes, 2 · Altea"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Los pedidos se hacen por teléfono o en el mostrador: la ficha no enlaza una web del local ni un sistema de pedidos online, y tampoco anuncia reparto a domicilio. Hay mesas dentro y en la acera, y el local cierra pasada la medianoche."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="La Isla"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma platos, precios y horario antes de ir."
			ctaLabel="Llamar a La Isla"
			navAriaLabel="Enlaces de La Isla"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
