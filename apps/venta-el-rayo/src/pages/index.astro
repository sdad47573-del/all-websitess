---
import '../styles/global.css';

const business = {
	name: 'Venta El Rayo',
	short: 'El Rayo',
	street: 'Ctra. Vejer–Medina s/n',
	city: 'Vejer de la Frontera',
	postalCode: '11150',
	phone: '+34 670 41 84 49',
	latitude: 36.2660872,
	longitude: -5.9642464,
	site: 'https://venta-el-rayo.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Venta+el+Rayo/@36.2660872,-5.9642464,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c45c02906d2ad:0x5439b7147804c1f9!8m2!3d36.2660872!4d-5.9642464!16s%2Fg%2F11b6_0dhbx?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const phoneHref = 'tel:+34670418449';

const specialties = [
	{
		kicker: 'De la zona',
		title: 'Caza y cuchara',
		text: 'Platos de caza, callos, alcachofas y ensaladas, en porciones generosas.',
	},
	{
		kicker: 'Desde las 6:00',
		title: 'Desayunos',
		text: 'Café de mañana para empezar ruta por La Janda.',
	},
	{
		kicker: 'De carretera',
		title: 'Terraza pequeña',
		text: 'Terraza con pocas mesas y parking justo al lado: mejor no llegar tarde.',
	},
	{
		kicker: 'Casero',
		title: 'Menú abundante',
		text: 'Variedad de platos, buenos y abundantes a precio asequible.',
	},
	{
		kicker: 'Contacto',
		title: '670 41 84 49',
		text: 'Llama para confirmar el menú del día antes de venir.',
	},
	{
		kicker: 'Aviso',
		title: 'Miércoles cerrado',
		text: 'Miércoles cerrado, según directorio. Confirma en el 670 41 84 49.',
	},
];

const gallery = [
	{ src: '/fotos/venta.svg', alt: 'Ilustración de la venta — sustituye por foto propia' },
	{ src: '/fotos/caza.svg', alt: 'Ilustración de caza — sustituye por foto propia' },
	{ src: '/fotos/terraza.svg', alt: 'Ilustración de la terraza — sustituye por foto propia' },
	{ src: '/fotos/desayuno.svg', alt: 'Ilustración del desayuno — sustituye por foto propia' },
	{ src: '/fotos/carretera.svg', alt: 'Ilustración de la carretera — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Venta El Rayo?',
		a: 'En Ctra. Vejer–Medina s/n, 11150 Vejer de la Frontera (Cádiz).',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Domingo, lunes, martes, jueves, viernes y sábado de 6:00 a 20:00; miércoles cerrado, según directorio. Confirma en el 670 41 84 49.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Bar restaurante de caza, alcachofas, callos, ensaladas y hamburguesas. Confirma la carta del día en el local.',
	},
	{
		q: '¿Hay terraza y parking?',
		a: 'Sí: terraza pequeña con pocas mesas y zona de aparcamiento justo al lado.',
	},
	{
		q: '¿Cómo llego?',
		a: 'A pie de la carretera Vejer–Medina. Usa el botón «Cómo llegar» para abrir la ruta en Google Maps.',
	},
];

const description =
	'Venta El Rayo en Ctra. Vejer–Medina s/n, Vejer de la Frontera. Bar restaurante de caza y menú casero. 6:00–20:00, mié cerrado. Tel. 670 41 84 49.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 670 41 84 49',
	image: [`${business.site}/fotos/venta.svg`],
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Andaluza'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '06:00',
			closes: '20:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.1,
		reviewCount: 776,
		bestRating: 5,
	},
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="Venta El Rayo: bar restaurante en Ctra. Vejer–Medina, Vejer. Caza y menú casero. 6:00–20:00, mié cerrado. 670 41 84 49." />
		<meta name="keywords" content="Venta El Rayo Vejer, comer Vejer Medina, bar Vejer Frontera, caza Vejer" />
		<meta name="author" content="Venta El Rayo" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>El Rayo | Venta de caza en Vejer</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="El Rayo · Caza y menú en Vejer" />
		<meta property="og:description" content="Caza, alcachofas y menú casero en la Vejer–Medina. Miércoles cerrado." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/venta.svg`} />
		<meta property="og:image:alt" content="Venta El Rayo, Vejer" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="El Rayo · Venta en Vejer" />
		<meta name="twitter:description" content="Vejer–Medina: caza y menú casero." />
		<meta name="twitter:image" content={`${business.site}/fotos/venta.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Vejer de la Frontera" />
		<meta name="geo.position" content="36.2660872;-5.9642464" />
		<meta name="ICBM" content="36.2660872, -5.9642464" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="El Rayo, inicio">
				<span class="brand-mark" aria-hidden="true">ER</span>
				<span class="brand-name">El Rayo <small>Vejer · Medina</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La venta</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>670 41 84 49</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Vejer–Medina · Vejer</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Bar restaurante a pie de carretera: desayunos desde las 6:00,
						caza, alcachofas y menú casero en porciones generosas.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 670 41 84 49</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>6–20</b> dom–sáb</li>
						<li><b>Mié</b> cerrado</li>
						<li>4,1 · 776 reseñas</li>
						<li>Terraza + parking</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/fotos/venta.svg" alt="Ilustración de Venta El Rayo, Vejer" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Vejer–Medina · Vejer</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>4,1</b><span>776 reseñas</span></div>
					<div><b>6–20</b><span>Dom–sáb</span></div>
					<div><b>Mié</b><span>Cerrado</span></div>
				</div>
				<ul class="services">
					<li>Caza</li>
					<li>Desayunos</li>
					<li>Terraza</li>
					<li>Parking</li>
					<li>Casero</li>
					<li>Paso</li>
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> La venta</p>
				<div class="about-grid">
					<h2>Pequeña por fuera,<br />grande <em>en mesa.</em></h2>
					<div class="about-copy">
						<p>
							El Rayo está en Ctra. Vejer–Medina s/n (11150 Vejer de la Frontera),
							con coordenadas 36.2660872, -5.9642464.
						</p>
						<p>
							Local pequeño con terraza de pocas mesas y parking al lado: servicio
							rápido una vez sentado, mejor ir pronto porque se llena.
						</p>
						<p class="about-note">
							Dom, lun, mar, jue, vie y sáb 6:00–20:00; miércoles cerrado, según directorio.
							Confirma en el 670 41 84 49.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales según su ficha pública: caza y caseras.
						Confirma la carta del día en el propio local.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>La carretera<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias de la venta.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Vejer–Medina s/n</p>
					<h2>Para en El Rayo<br /><em>a comer.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Domingo, lunes, martes, jueves, viernes y sábado</th>
								<td>6:00 – 20:00</td>
							</tr>
							<tr>
								<th scope="row">Miércoles</th>
								<td>Cerrado</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Según directorio. Confirma en el 670 41 84 49 antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar a la venta ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 670 41 84 49</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de Venta El Rayo en Vejer–Medina" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> El Rayo · Vejer</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">ER</span>
				<p>El Rayo<small>{business.street} · Vejer</small></p>
			</div>
			<nav aria-label="Enlaces de la venta">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} El Rayo · Vejer. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar a la venta <span>670 41 84 49</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34670418449?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Venta%20El%20Rayo." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Venta El Rayo"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
