---
import { HIGHLIGHTS } from '../data/site';
---

<section class="bg-base-200 py-16 sm:py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
			{
				HIGHLIGHTS.map((item) => (
					<article class="card border-base-300 bg-base-100 border transition-shadow hover:shadow-lg">
						<div class="card-body gap-3">
							<span class="bg-primary/10 text-primary flex size-12 items-center justify-center rounded-xl">
								<i class={`${item.icon} text-2xl`} />
							</span>
							<h2 class="font-display text-lg font-semibold">{item.title}</h2>
							<p class="text-base-content/70 text-sm leading-relaxed">{item.text}</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
