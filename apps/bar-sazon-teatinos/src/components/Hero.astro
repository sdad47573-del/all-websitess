---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES } from '../data/site';
---

<section id="inicio" class="relative isolate flex min-h-[92svh] items-center overflow-hidden">
	<Image
		src={IMAGES.costillas}
		alt="Platos de Sazón Teatinos, taberna de tapas y parrilla en Teatinos (Málaga)"
		loading="eager"
		fetchpriority="high"
		widths={[640, 1024, 1500]}
		sizes="100vw"
		class="absolute inset-0 -z-20 h-full w-full object-cover"
	/>
	<div
		class="from-neutral/90 via-neutral/70 to-primary/55 absolute inset-0 -z-10 bg-gradient-to-br"
	>
	</div>

	<div class="mx-auto w-full max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
		<div class="text-neutral-content max-w-2xl">
			<div
				class="mb-6 inline-flex items-center gap-3 rounded-full bg-black/35 px-4 py-2 ring-1 ring-white/20 backdrop-blur-sm"
			>
				<span class="text-accent flex items-center gap-0.5">
					<i class="ri-star-fill text-sm"></i>
					<i class="ri-star-fill text-sm"></i>
					<i class="ri-star-fill text-sm"></i>
					<i class="ri-star-fill text-sm"></i>
					<i class="ri-star-half-fill text-sm"></i>
				</span>
				<span class="text-sm font-semibold">{BUSINESS.rating} / 5</span>
				<span class="text-sm text-white/70"
					>· {BUSINESS.reviewsCount.toLocaleString('es-ES')}+ reseñas en Google</span
				>
			</div>

			<h1
				class="font-display text-shadow-soft text-5xl leading-[1.05] font-bold sm:text-6xl lg:text-7xl"
			>
				Sazón <span class="text-accent">Teatinos</span>
			</h1>

			<p class="font-display mt-5 text-xl text-white/90 sm:text-2xl">
				{BUSINESS.tagline}
			</p>

			<p class="mt-5 max-w-xl text-base text-white/80 sm:text-lg">
				{BUSINESS.summary}
			</p>

			<div class="mt-9 flex flex-wrap gap-3">
				<a href={BUSINESS.phoneHref} class="btn btn-primary btn-lg gap-2 rounded-full">
					<i class="ri-phone-line text-xl"></i>
					Reservar mesa
				</a>
				<a
					href="#carta"
					class="btn btn-lg hover:text-neutral gap-2 rounded-full border-white/40 bg-white/10 text-white backdrop-blur-sm hover:border-white hover:bg-white"
				>
					<i class="ri-book-2-line text-xl"></i>
					Ver la carta
				</a>
			</div>

			<ul class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm text-white/85">
				<li class="flex items-center gap-2">
					<i class="ri-map-pin-2-line text-accent"></i>
					{BUSINESS.street} · {BUSINESS.district}
				</li>
				<li class="flex items-center gap-2">
					<i class="ri-time-line text-accent"></i>
					Abierto todos los días 12:30 – 00:00
				</li>
				<li class="flex items-center gap-2">
					<i class="ri-magic-line text-accent"></i>
					Magia en directo los jueves
				</li>
			</ul>
		</div>
	</div>
</section>
