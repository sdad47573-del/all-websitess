---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import vitrina from '../assets/fotos/panaderia-polvillo-apaisada-01.jpg';
import caramelizadas from '../assets/fotos/panaderia-polvillo-apaisada-02.jpg';
import tartaChocolate from '../assets/fotos/panaderia-polvillo-vertical-03.jpg';
import tartaRectangular from '../assets/fotos/panaderia-polvillo-vertical-04.jpg';
import rosconEnvoltorio from '../assets/fotos/panaderia-polvillo-apaisada-05.jpg';
import corazones from '../assets/fotos/panaderia-polvillo-apaisada-06.jpg';
import tartaFrutas from '../assets/fotos/panaderia-polvillo-apaisada-07.jpg';
import tartaBlanca from '../assets/fotos/panaderia-polvillo-vertical-08.jpg';
import torreNieve from '../assets/fotos/panaderia-polvillo-apaisada-09.jpg';
import roscon from '../assets/fotos/panaderia-polvillo-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería Polvillo · Bailén-Miraflores, Málaga';
const description =
	'Panadería Polvillo, en la calle del Ciprés (Bailén-Miraflores, 29010 Málaga). Tartas y palmeras gigantes de obrador, bollería y dulces. 4,4/5 en Google. Teléfono 610 00 85 61.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#polvillo`,
	name: BUSINESS.name,
	alternateName: ['Polvillo Málaga', 'Panadería Polvillo Málaga', 'Pastelería Polvillo'],
	description:
		'Panadería y pastelería con obrador propio en la calle del Ciprés (Bailén-Miraflores, 29010 Málaga). Tartas, palmeras gigantes, bollería y dulces.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34610008561',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId }],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:00',
			closes: '18:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '08:00',
			closes: '14:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento accesible para sillas de ruedas',
			value: true,
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: caramelizadas,
		alt: 'Torre de pasteles caramelizados con nata y una ramita de abeto en una bandeja dorada',
	},
	{ src: tartaChocolate, alt: 'Tarta redonda de chocolate con lazo de chocolate y el número 2025' },
	{
		src: tartaRectangular,
		alt: 'Tarta rectangular de fruta con un reloj de azúcar y un abeto de azúcar encima',
	},
	{ src: rosconEnvoltorio, alt: 'Roscón de Reyes envuelto en film sobre su bandeja' },
	{ src: corazones, alt: 'Corazones de tarta de chocolate, fresa y rosa en una bandeja dorada' },
	{ src: tartaFrutas, alt: 'Tarta de frutas con kiwi, melocotón, fresa y frambuesa sobre hojaldre' },
	{
		src: tartaBlanca,
		alt: 'Tarta redonda cubierta de nata con decoración de chocolate y el número 2025',
	},
	{
		src: torreNieve,
		alt: 'Torre de dulces con azúcar glas, nata y una tarjeta de felicitación dorada',
	},
	{ src: roscon, alt: 'Roscón de Reyes con fruta escarchada y azúcar sobre papel de plata' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#f6e2d5" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Karla:ital,wght@0,300..700;1,300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Polvillo, panadería Málaga, pastelería Bailén-Miraflores, palmeras gigantes, tartas Málaga, calle del Ciprés, 29010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Tartas y palmeras gigantes de obrador en Bailén-Miraflores. 4,4 sobre 5 con 24 reseñas en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Vitrina de la Panadería Polvillo con tartas, dulces y bollería"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#f6e2d5"
			phone="+34610008561"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Polvillo"
			subtitle="Panadería · Obrador"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. del Ciprés · Bailén-Miraflores"
				title="Palmeras gigantes <br /><em>y tartas de obrador.</em>"
				lede={`La ficha del negocio lo dice en tres palabras: «hacemos tartas, palmeras gigantes». En la calle del Ciprés, la vitrina de Polvillo está llena de dulces, bollería y tartas recién hechas. Abre de lunes a viernes hasta las 18:00 y los fines de semana por la mañana. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={vitrina}
				imageAlt="Vitrina de la Panadería Polvillo con tartas, dulces, palmeras y bollería"
				primaryCta={{ label: 'Llamar · 610 00 85 61', href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4</b> en Google · 24 reseñas' },
					{ label: 'Horario', html: '<b>L–V 8:00–18:00</b> · fin de semana mañana' },
					{ label: 'Teléfono', html: '<b>610 00 85 61</b>' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver las fotos en Google"
				tag="Obrador propio"
			/>

			<LocalChips label="Lo que hay en la panadería" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un obrador <br /><em>de barrio.</em>"
				paragraphs={[
					'La Panadería Polvillo está en la calle del Ciprés, en Bailén-Miraflores. La ficha la describe en una línea: «hacemos tartas, palmeras gigantes». Es una panadería de barrio con obrador detrás del mostrador.',
					'La vitrina es el mejor resumen de la casa: tartas de chocolate y de nata, pasteles con el número del año, tartas de fruta sobre hojaldre, torres de dulces caramelizados, roscones de Reyes y bandejas de pasta de almendra. Todo con el mismo acabado de pastelería clásica.',
					'Las reseñas apuntan a lo mismo. Una dice que «todos los dulces que compramos, buenísimos»; otra que «tiene un montón de variedad de productos y la muchacha es un encanto». El trato y la variedad son lo que más se repite.',
					'Abre de lunes a viernes de 8:00 a 18:00 y el fin de semana de 8:00 a 14:00. La ficha no publica carta, precios ni web: lo que no está publicado, aquí no se inventa.',
				]}
				note="4,4 sobre 5 con 24 reseñas en Google. Las dos que se citan son las destacadas de la ficha y ambas son de cinco estrellas."
				links={[
					{ label: 'Llamar · 610 00 85 61', href: BUSINESS.phoneHref },
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas de la casa</p>
						<h2 id="three-title">Palmeras, tartas <br /><em>y variedad.</em></h2>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que se ve <br /><em>en la vitrina.</em>"
				description="Sin carta ni precios publicados: esto es lo que anuncia la propia ficha del negocio y lo que muestran las fotos del perfil."
				cta={{ label: 'Llamar · 610 00 85 61', href: BUSINESS.phoneHref }}
				groups={MENU_GROUPS}
				note="La ficha no recoge precios ni métodos de pago, así que esta web no publica importes. Para encargar una tarta o preguntar qué hay ese día, llama al 610 00 85 61."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="El mostrador, <br /><em>en detalle.</em>"
				description="Nueve fotos de la ficha de Google Maps: las tartas de chocolate y de nata, las de fruta, las torres de dulces caramelizados y los roscones."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="reviews-title">
				<div class="wrap">
					<div class="reviews-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Lo que dicen</p>
							<h2 id="reviews-title">Dos reseñas <br /><em>de la ficha.</em></h2>
						</div>
						<p>
							4,4 sobre 5 con 24 reseñas. Estas dos son las destacadas por Google y hablan
							de los dulces y de la variedad.
						</p>
					</div>
					<div class="review-grid">
						{
							REVIEWS.map((review) => (
								<figure class="review-card">
									<span class="stars" role="img" aria-label={`${review.rating} de 5 estrellas`}>
										★★★★★
									</span>
									<blockquote>{review.text}</blockquote>
									<figcaption>Reseña de Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<a class="reviews-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
						Leer las 24 reseñas en Google ↗
					</a>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la calle <br /><em>del Ciprés.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de la Panadería Polvillo en la calle del Ciprés, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Polvillo · Bailén-Miraflores"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: '610 00 85 61', href: BUSINESS.phoneHref }}
				reserveNote="La ficha de Google indica entrada y aparcamiento adaptados para sillas de ruedas. No publica web ni correo: el contacto es en el local o por teléfono."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y disponibilidad pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar a Polvillo"
			navAriaLabel="Enlaces de la Panadería Polvillo"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
