---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'El Cocinero en Casa · Comida para llevar en Retiro';
const description = BUSINESS.description;

import fachada from '../assets/fotos/el-cocinero-en-casa-apaisada-01.jpg';
import cordero from '../assets/fotos/el-cocinero-en-casa-apaisada-04.jpg';
import gratinados from '../assets/fotos/el-cocinero-en-casa-apaisada-07.jpg';
import arroz from '../assets/fotos/el-cocinero-en-casa-panoramica-03.jpg';
import tartas from '../assets/fotos/el-cocinero-en-casa-panoramica-05.jpg';
import salmon from '../assets/fotos/el-cocinero-en-casa-panoramica-06.jpg';
import ensaladilla from '../assets/fotos/el-cocinero-en-casa-vertical-02.jpg';
import guiso from '../assets/fotos/el-cocinero-en-casa-vista-10-10.jpg';

const galeria: { src: ImageMetadata; alt: string }[] = [
	{ src: fachada, alt: 'Fachada de El Cocinero en Casa, con su rótulo en la calle' },
	{ src: cordero, alt: 'Pata de cordero asada con patatas' },
	{ src: gratinados, alt: 'Bandejas de pasta gratinada en mostrador de buffet' },
	{ src: arroz, alt: 'Arroz blanco con salsa de tomate y huevo frito' },
	{ src: tartas, alt: 'Vitrina con tartas y comida preparada' },
	{ src: salmon, alt: 'Salmón al horno con pimientos y patatas en envase de aluminio' },
	{ src: ensaladilla, alt: 'Ensaladilla rusa con surimi y lechuga' },
	{ src: guiso, alt: 'Platos de guiso en envase para llevar' },
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-cocinero-en-casa`,
	name: BUSINESS.name,
	alternateName: ['El Cocinero en Casa Retiro', 'El Cocinero en Casa comida para llevar'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phoneHref.replace('tel:', ''),
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida preparada', 'Comida para llevar'],
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Comunidad de Madrid' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.locality,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: { '@type': 'GeoCoordinates', latitude: BUSINESS.geo.lat, longitude: BUSINESS.geo.lng },
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId }],
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '09:00', closes: '16:30' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#123c36" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400..700;1,400..700&family=Mulish:ital,wght@0,400..700;1,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Cocinero en Casa, comida para llevar Retiro, comida casera Retiro, restaurante para llevar Madrid"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar en Calle de Antonio Arias, 13 (Retiro, Madrid)."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tarjeta de El Cocinero en Casa con su nombre sobre fondo verde esmeralda"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#123c36"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Retiro"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Cocinero en Casa"
			subtitle="Comida para llevar · Retiro"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Calle de Antonio Arias, 13 · Retiro, Madrid"
				title="Comida casera <br /><em>para llevar.</em>"
				lede={`El Cocinero en Casa es comida para llevar en Retiro. Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>Mar–dom</b> 9:00–16:30 · <b>Lun</b> cerrado' },
					{ label: 'Servicio', html: '<b>Para llevar</b>' },
				]}
				image={fachada}
				imageAlt="Fachada de El Cocinero en Casa en la Calle de Antonio Arias, en Retiro"
				galleryHref={MAPS.place}
				photoCredit="Ficha de Google Maps"
				galleryLinkLabel="Ver en Google Maps"
				tag="Comida para llevar"
			/>

			<LocalChips label="Lo que ofrece El Cocinero en Casa" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Comida casera <br /><em>para llevar.</em>"
				paragraphs={[
					'El Cocinero en Casa está en la Calle de Antonio Arias, 13, en Retiro. Su ficha de Google Maps lo clasifica como restaurante de comida para llevar.',
					'Su ficha publica horario de martes a domingo, de 9:00 a 16:30. Los sábados y domingos hacen paellas, con encargos por teléfono.',
				]}
				note="La ficha no publica página web, redes sociales, carta con precios ni reparto a domicilio. Para precios concretos y encargos, llama al 915 73 28 16."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El local <br /><em>y la cocina.</em>"
				description="Vitrina de comida preparada, tartas y platos de la casa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Las fotos de la carta y de los platos de otros locales no se publican. Si tienes los derechos de alguna imagen y quieres retirarla, dilo y la eliminamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Retiro, <br /><em>Calle de Antonio Arias.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, BUSINESS.region]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.horas === 'Cerrado' }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: martes a domingo de 9:00 a 16:30, y lunes cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de El Cocinero en Casa en la Calle de Antonio Arias, 13, Retiro, Madrid"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Calle de Antonio Arias, 13"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="La ficha no publica reparto a domicilio ni pedidos online: se concreta todo por teléfono, en el 915 73 28 16. No da datos de accesibilidad, así que conviene llamar antes si necesitas algo concreto."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>ir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="El Cocinero en Casa"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma horario antes de la visita."
			ctaLabel="Llamar a El Cocinero en Casa"
			navAriaLabel="Enlaces de El Cocinero en Casa"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
