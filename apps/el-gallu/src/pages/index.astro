---
import '../styles/global.css';
import {
	business,
	directionsUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHrefs,
	specialties,
	structuredData,
} from '../lib/business';

const title = 'El Gallu | Cocina asturiana y sidrería en Rincón de la Victoria';
const description =
	'El Gallu, cocina asturiana y sidrería en Calle Jaén, 11, Rincón de la Victoria (Málaga). Cachopo, gildas, croquetas caseras y sidra natural. Reservas: 618 79 29 62.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#23262a" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="Rincón de la Victoria" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Overpass+Mono:wght@400;500&family=Rubik:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="El Gallu, inicio"><span class="brand-mark" aria-hidden="true">EG</span><span class="brand-label">EL GALLU <small>ASTURIANO · SIDRERÍA</small></span></a>
			<nav aria-label="Navegación principal"><a href="#carta">La carta</a><a href="#contacto">Contacto</a></nav>
			<a class="header-phone" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> {business.phones[0]}</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-content">
					<p class="eyebrow"><span></span> COCINA ASTURIANA · SIDRERÍA</p>
					<h1 id="hero-title">El<br /><em>Gallu</em></h1>
					<p class="hero-sub">Restaurante asturiano · Rincón de la Victoria</p>
					<p class="hero-intro">Cocina asturiana y del norte en Rincón de la Victoria. Cachopo, gildas, croquetas caseras y buenos postres, con sidra natural para acompañar. Un rincón tranquilo junto al parque.</p>
					<div class="hero-actions"><a class="button button-cider" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Llamar y reservar</a><a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
				</div>
				<div class="hero-bar">
					<div class="bar-cell"><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div>
					<div class="bar-cell"><small>RESERVAS</small><a href={phoneHrefs[0]}>{business.phones[0]}</a></div>
					<div class="bar-cell"><small>DÓNDE ESTAMOS</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a></div>
				</div>
			</section>

			<section class="placas-section" id="carta" aria-labelledby="placas-title">
				<div class="placas-head">
					<p class="section-label"><span>01 /</span> LO MÁS PEDIDO</p>
					<h2 id="placas-title">Clásicos<br /><em>del norte.</em></h2>
				</div>
				<ul class="placas">
					{specialties.map((dish, index) => (
						<li class="placa">
							<span class="placa-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
							<strong class="placa-name">{dish.name}</strong>
							<span class="placa-note">{dish.note}</span>
						</li>
					))}
				</ul>
				<p class="placas-foot">Y muchos más platos en la carta del local. Pregunta por las sugerencias del día.</p>
			</section>

			<section class="about-section" aria-labelledby="about-title">
				<p class="section-label"><span>02 /</span> EL GALLU · RINCÓN DE LA VICTORIA</p>
				<div class="about-content"><h2 id="about-title">Cocina de siempre,<br /><em>producto de verdad.</em></h2><div><p>En El Gallu traemos al sur la cocina asturiana: recetas honestas, raciones generosas y producto de calidad. Cachopo para compartir, gildas, croquetas caseras, quesos y embutidos del norte, y una sidra natural que sienta de maravilla. Terraza agradable junto al parque, ideal para ir en familia o con amigos.</p><a class="social-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver la ficha y las opiniones en Google Maps <span aria-hidden="true">↗</span></a></div></div>
				<div class="about-footer"><span>ASTURIANA · SIDRA · CACHOPO</span><span>29730 RINCÓN DE LA VICTORIA</span><span>✦</span></div>
			</section>

			<section class="contact-section" id="contacto" aria-labelledby="contact-title">
				<p class="section-label"><span>03 /</span> VISÍTANOS</p>
				<div class="contact-layout">
					<div class="contact-copy"><p class="contact-kicker">ESTAMOS EN CALLE JAÉN</p><h2 id="contact-title">Reserva<br /><em>tu mesa.</em></h2>
						<div class="contact-card">
							<div class="contact-row"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div></div>
							<div class="contact-row"><span aria-hidden="true">☎</span><div><small>RESERVAS</small><a href={phoneHrefs[0]}>{business.phones[0]}</a></div></div>
						</div>
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-card"><div class="map-header"><span><i></i> CALLE JAÉN · RINCÓN DE LA VICTORIA</span><a href={mapsUrl} target="_blank" rel="noreferrer">ABRIR MAPS ↗</a></div><iframe title="Mapa de El Gallu en Calle Jaén, Rincón de la Victoria" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><div class="map-footer"><span aria-hidden="true">⌖</span><div><strong>{business.name}</strong><small>{business.streetAddress} · {business.city}</small></div><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar a El Gallu">↗</a></div></div>
				</div>
				<div class="social-row"><span>ENCUÉNTRANOS TAMBIÉN EN</span><a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><a href={phoneHrefs[0]}>{business.phones[0]} ↗</a></div>
			</section>
		</main>

		<footer class="site-footer"><a class="brand footer-brand" href="#inicio" aria-label="El Gallu, volver al inicio"><span class="brand-mark">EG</span><span class="brand-label">EL GALLU <small>ASTURIANO · SIDRERÍA</small></span></a><p>{business.streetAddress}, {business.postalCode} {business.city}<br /><a href={phoneHrefs[0]}>{business.phones[0]}</a></p><a class="footer-social" href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><small>© {new Date().getFullYear()} El Gallu · Rincón de la Victoria &nbsp;·&nbsp; Consulta la carta y los horarios en el local.</small></footer>
		<a class="phone-cta" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Reservar en El Gallu <strong>{business.phones[0]}</strong></a>
	</body>
</html>
