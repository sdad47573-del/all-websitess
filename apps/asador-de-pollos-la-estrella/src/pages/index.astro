---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import rotulo from '../assets/fotos/asador-de-pollos-la-estrella-apaisada-01.jpg';
import pollosHorno from '../assets/fotos/asador-de-pollos-la-estrella-apaisada-03.jpg';
import asadorPinchos from '../assets/fotos/asador-de-pollos-la-estrella-vertical-02.jpg';
import asadorBandeja from '../assets/fotos/asador-de-pollos-la-estrella-vertical-08.jpg';
import hornoGiratorio from '../assets/fotos/asador-de-pollos-la-estrella-vertical-04.jpg';
import hornoLleno from '../assets/fotos/asador-de-pollos-la-estrella-vertical-05.jpg';
import fuente from '../assets/fotos/asador-de-pollos-la-estrella-apaisada-07.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'Asador de Pollos La Estrella · Triana, Sevilla';
const description = BUSINESS.description;

const galeria = [
	{
		src: pollosHorno,
		alt: 'Tres pollos dorados ensartados en el asador, con la piel crujiente y brillante',
	},
	{
		src: asadorPinchos,
		alt: 'El asador de La Estrella sosteniendo el pincho con dos pollos recién sacados del horno',
	},
	{
		src: hornoGiratorio,
		alt: 'Pollos ensartados en las varillas del horno giratorio del asador',
	},
	{
		src: hornoLleno,
		alt: 'Horno del asador lleno de pollos, unos ya dorados y otros aún por hacer',
	},
	{
		src: asadorBandeja,
		alt: 'El asador con una bandeja de pollo asado delante del horno, con el pulgar hacia arriba',
	},
	{
		src: fuente,
		alt: 'Fuente de jamón, huevos duros, nueces y orejones que aparece en el perfil del local',
	},
];

const carta = [
	{
		title: 'Del asador',
		items: [
			{ name: 'Pollo asado', note: 'la especialidad de la casa, en el horno giratorio que sale en las fotos' },
			{ name: 'Pollo para llevar', note: 'para recoger en el mostrador y comer en casa' },
		],
	},
	{
		title: 'De la freidora y la vitrina',
		items: [
			{ name: 'Patatas fritas', note: 'las que una reseña destacada llama deliciosas' },
			{ name: 'Tortillas', note: 'de patata, en la vitrina del local' },
			{ name: 'Aliños', note: 'el aliño de la casa, citado en las reseñas' },
			{ name: 'Ensaladilla', note: 'la que aparece en los comentarios del perfil' },
		],
	},
	{
		title: 'Para la mesa',
		items: [
			{ name: 'Raciones generosas', note: 'lo que repiten las reseñas que destaca Google' },
			{ name: 'Comida en el local', note: 'servicio de mediodía, con mesas y barra' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-estrella`,
	name: BUSINESS.name,
	alternateName: ['La Estrella Triana', 'Asador La Estrella', 'Pollos La Estrella Sevilla'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Andaluza', 'Pollo asado', 'Comida casera'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Triana, Sevilla' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday'],
			opens: '12:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '12:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '11:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '20:00',
			closes: '23:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"asador-de-pollos-la-estrella-apaisada-01.jpg": rotulo,
	"asador-de-pollos-la-estrella-apaisada-03.jpg": pollosHorno,
	"asador-de-pollos-la-estrella-vertical-02.jpg": asadorPinchos,
	"asador-de-pollos-la-estrella-vertical-04.jpg": hornoGiratorio,
	"asador-de-pollos-la-estrella-vertical-05.jpg": hornoLleno,
	"asador-de-pollos-la-estrella-vertical-08.jpg": asadorBandeja,
	"asador-de-pollos-la-estrella-apaisada-07.jpg": fuente,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#111a20" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Source+Sans+3:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador de Pollos La Estrella, pollos asados Triana, pollo asado San Jacinto, asador Sevilla 41010, pollería Triana, patatas fritas Triana, comida para llevar Triana, San Jacinto 34"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado en la calle San Jacinto 34, Triana. Comidas de 12:30 a 16:00 y viernes y sábado también de 20:00 a 23:00. 4,5 sobre 5 con 245 reseñas; miércoles cerrado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo azul de Asador de Pollos La Estrella en la calle San Jacinto de Triana"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#111a20"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Triana, Sevilla"
			preload={[rotulo]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Estrella"
			subtitle="Asador de pollos · Triana"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.neighbourhood} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías tomados de la ficha y del perfil públicos del asador en Google Maps. Sin carta de precios publicada: confirma horario y disponibilidad antes de venir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Asador de Pollos La Estrella"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34954340666?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Pollo%20asado." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Pollo asado"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
