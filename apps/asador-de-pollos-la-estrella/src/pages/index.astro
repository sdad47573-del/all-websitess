---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import rotulo from '../assets/fotos/asador-de-pollos-la-estrella-apaisada-01.jpg';
import pollosHorno from '../assets/fotos/asador-de-pollos-la-estrella-apaisada-03.jpg';
import asadorPinchos from '../assets/fotos/asador-de-pollos-la-estrella-vertical-02.jpg';
import asadorBandeja from '../assets/fotos/asador-de-pollos-la-estrella-vertical-08.jpg';
import hornoGiratorio from '../assets/fotos/asador-de-pollos-la-estrella-vertical-04.jpg';
import hornoLleno from '../assets/fotos/asador-de-pollos-la-estrella-vertical-05.jpg';
import fuente from '../assets/fotos/asador-de-pollos-la-estrella-apaisada-07.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, REVIEWS, SERVICIOS } from '../data/site';

const title = 'Asador de Pollos La Estrella · Triana, Sevilla';
const description = BUSINESS.description;

const galeria = [
	{
		src: pollosHorno,
		alt: 'Tres pollos dorados ensartados en el asador, con la piel crujiente y brillante',
	},
	{
		src: asadorPinchos,
		alt: 'El asador de La Estrella sosteniendo el pincho con dos pollos recién sacados del horno',
	},
	{
		src: hornoGiratorio,
		alt: 'Pollos ensartados en las varillas del horno giratorio del asador',
	},
	{
		src: hornoLleno,
		alt: 'Horno del asador lleno de pollos, unos ya dorados y otros aún por hacer',
	},
	{
		src: asadorBandeja,
		alt: 'El asador con una bandeja de pollo asado delante del horno, con el pulgar hacia arriba',
	},
	{
		src: fuente,
		alt: 'Fuente de jamón, huevos duros, nueces y orejones que aparece en el perfil del local',
	},
];

const carta = [
	{
		title: 'Del asador',
		items: [
			{ name: 'Pollo asado', note: 'la especialidad de la casa, en el horno giratorio que sale en las fotos' },
			{ name: 'Pollo para llevar', note: 'para recoger en el mostrador y comer en casa' },
		],
	},
	{
		title: 'De la freidora y la vitrina',
		items: [
			{ name: 'Patatas fritas', note: 'las que una reseña destacada llama deliciosas' },
			{ name: 'Tortillas', note: 'de patata, en la vitrina del local' },
			{ name: 'Aliños', note: 'el aliño de la casa, citado en las reseñas' },
			{ name: 'Ensaladilla', note: 'la que aparece en los comentarios del perfil' },
		],
	},
	{
		title: 'Para la mesa',
		items: [
			{ name: 'Raciones generosas', note: 'lo que repiten las reseñas que destaca Google' },
			{ name: 'Comida en el local', note: 'servicio de mediodía, con mesas y barra' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-estrella`,
	name: BUSINESS.name,
	alternateName: ['La Estrella Triana', 'Asador La Estrella', 'Pollos La Estrella Sevilla'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Andaluza', 'Pollo asado', 'Comida casera'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Triana, Sevilla' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday'],
			opens: '12:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '12:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '11:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '20:00',
			closes: '23:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#111a20" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Source+Sans+3:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador de Pollos La Estrella, pollos asados Triana, pollo asado San Jacinto, asador Sevilla 41010, pollería Triana, patatas fritas Triana, comida para llevar Triana, San Jacinto 34"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado en la calle San Jacinto 34, Triana. Comidas de 12:30 a 16:00 y viernes y sábado también de 20:00 a 23:00. 4,5 sobre 5 con 245 reseñas; miércoles cerrado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo azul de Asador de Pollos La Estrella en la calle San Jacinto de Triana"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#111a20"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Triana, Sevilla"
			preload={[rotulo]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Estrella"
			subtitle="Asador de pollos · Triana"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.neighbourhood} · ${BUSINESS.city}`}
				title="Pollo asado <br /><em>de Triana.</em>"
				lede="En el número 34 de la calle San Jacinto, en pleno Triana, La Estrella es un asador de los de siempre: pollo asado en el horno giratorio, patatas fritas, tortillas, aliños y ensaladilla. Abre para comer de 12:30 a 16:00 (el sábado desde las 12:00 y el domingo desde las 11:00) y añade cena los viernes y sábados, de 20:00 a 23:00. El miércoles cierra."
				image={rotulo}
				imageAlt="Rótulo azul de Asador de Pollos La Estrella sobre la fachada de la calle San Jacinto, con la estrella blanca"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5</b> en Google · 245 reseñas' },
					{ label: 'Horario', html: '<b>12:30–16:00</b><br />Vie y sáb también 20:00–23:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> encargos y consultas` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de La Estrella" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="El asador <br /><em>de San Jacinto.</em>"
				paragraphs={[
					'El Asador de Pollos La Estrella está en el número 34 de la calle San Jacinto, la arteria de Triana, con el rótulo azul de la estrella sobre la puerta. Google lo clasifica como pollería, y las fotos de su perfil enseñan el horno giratorio con los pollos ensartados y al asador sacándolos en la bandeja.',
					'El servicio es de comidas, de 12:30 a 16:00, con dos excepciones de fin de semana: el sábado abre a las 12:00 y el domingo a las 11:00. Viernes y sábados hay también turno de noche, de 20:00 a 23:00. El miércoles figura cerrado y no hay cena ningún otro día.',
					'Las reseñas que Google destaca hablan de raciones generosas, de patatas fritas deliciosas y de tortillas, aliños y patatas entre lo que se puede pedir. La media es de 4,5 sobre 5 con 245 reseñas, una de las más altas de la zona y con una muestra amplia.',
					'El local está a un paso del puente de Isabel II, así que se llega andando desde el centro. La ficha marca que no hay aparcamiento adaptado ni asientos adaptados para sillas de ruedas, y no publica más datos de accesibilidad.',
				]}
				note="La ficha no publica carta con precios, web propia ni reparto a domicilio. Los platos de esta página salen de la categoría de Google, del nombre del asador y de lo que mencionan las reseñas que la ficha destaca; no hay importes que mostrar sin inventarlos."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el asador en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Pollo, patatas <br /><em>y aliños.</em>"
				description="Sin precios publicados en la ficha, así que aquí van los productos de la casa tal como los declara Google y los cuentan las reseñas."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={carta}
				note="Esta lista sale de la categoría con la que Google clasifica el local, de su nombre y de las reseñas que la ficha destaca. No hay carta ni precios públicos: se confirman en el mostrador o llamando al 954 34 06 66."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
					<div class="reviews-head">
						<h2 id="resenas-title">Cuatro y medio, <br /><em>245 veces.</em></h2>
						<p>
							La ficha tiene 245 reseñas y una media de 4,5. Estas son las tres que Google destaca, con
							la puntuación que les dio su autor, la buena y la mala. En la ficha están todas.
						</p>
					</div>
					<div class="review-grid">
						{
							REVIEWS.map((review) => (
								<figure class="review-card">
									<p class="review-stars" aria-label={`${review.rating} sobre 5`}>
										{'★'.repeat(review.rating)}
										<span aria-hidden="true">{'★'.repeat(5 - review.rating)}</span>
									</p>
									<blockquote>{review.quote}</blockquote>
									<figcaption>Reseña publicada en Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="review-note">
						Citas de las reseñas públicas del local, con la puntuación del autor y la puntuación del
						texto normalizada. En la ficha de Google están las 245, incluidas las críticas.
					</p>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Seis fotos <br /><em>del asador.</em>"
				description="Del perfil del local: el horno giratorio con los pollos, el asador sacándolos en la bandeja y una de las fuentes de la casa."
				images={galeria}
				cta={{ label: 'Ver todas en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.neighbourhood}`}
				title="Ven a <br /><em>San Jacinto.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'España']}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: comidas de 12:30 a 16:00, sábado desde las 12:00 y domingo desde las 11:00. Cena solo viernes y sábado, de 20:00 a 23:00. El miércoles cierra. En festivos puede cambiar; llama antes si vas en día señalado."
				mapTitle="Mapa de Asador de Pollos La Estrella en la calle San Jacinto 34, Triana"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Estrella"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="La ficha no publica reservas ni reparto a domicilio. El pollo asado se puede encargar por teléfono y recoger en el mostrador, y para grupos grandes conviene llamar con antelación. Esta página no tramita pedidos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.neighbourhood} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías tomados de la ficha y del perfil públicos del asador en Google Maps. Sin carta de precios publicada: confirma horario y disponibilidad antes de venir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Asador de Pollos La Estrella"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
