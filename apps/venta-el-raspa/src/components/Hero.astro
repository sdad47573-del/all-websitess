---
import { Image } from 'astro:assets';
import { BUSINESS, IMAGES } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
---

<section id="inicio" class="hero-el-raspa relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.fotoPortada}
			alt="Venta El Raspa en La Algaida"
			widths={[640, 1100, 1600]}
			sizes="100vw"
			quality={72}
			loading="eager"
			fetchpriority="high"
			class="h-full w-full object-cover opacity-20"
		/>
		<div class="from-neutral/95 via-neutral/60 absolute inset-0 bg-gradient-to-r"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
		<div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
			<div>
				<p
					class="text-accent inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase"
				>
					<span><i class="ri-sun-line"></i> Venta · La Algaida</span>
					<span class="text-white/50">Sanlúcar de Barrameda</span>
				</p>

				<h1 class="font-display mt-4 text-6xl leading-[0.95] font-bold sm:text-7xl lg:text-8xl">
					Venta<br /><span class="text-accent">El Raspa</span>
				</h1>

				<p class="mt-6 max-w-xl text-base leading-relaxed text-white/80 sm:text-lg">
					Cocina de siempre y raciones para compartir en La Algaida. Cerveza bien fría, camarones al
					ajillo y una mesa abierta todos los días, de diez de la mañana a medianoche.
				</p>

				<div class="mt-7 flex flex-wrap items-center gap-3">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="badge badge-lg gap-2 border-white/20 bg-white/10 px-4 py-3 text-sm font-semibold text-white"
					>
						<span class="text-accent tracking-tight" aria-hidden="true">
							{
								estrellas.map((n) => (
									<i
										class={
											n <= Math.floor(BUSINESS.rating)
												? 'ri-star-fill'
												: n - BUSINESS.rating <= 0.5
													? 'ri-star-half-fill'
													: 'ri-star-line'
										}
									/>
								))
							}
						</span>
						{BUSINESS.rating.toString().replace('.', ',')} · {BUSINESS.reviewCount} reseñas en Google
					</a>
				</div>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-accent btn-lg gap-2 rounded-full">
						<i class="ri-phone-line text-xl"></i>
						{BUSINESS.phone}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-lg gap-2 rounded-full border-white/35 bg-transparent text-white hover:border-white hover:bg-white hover:text-neutral"
					>
						<i class="ri-google-fill"></i>
						Ver ficha de Google
					</a>
				</div>

				<dl class="mt-10 grid gap-x-6 gap-y-5 border-t border-white/15 pt-7 sm:grid-cols-3">
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Horario</dt>
						<dd class="mt-1 text-base font-bold">10:00 – 24:00</dd>
						<dd class="text-xs text-white/55">Todos los días</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">La mesa</dt>
						<dd class="mt-1 text-base font-bold">Raciones generosas</dd>
						<dd class="text-xs text-white/55">Cocina de siempre</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Dónde</dt>
						<dd class="mt-1 text-base font-bold">C. Central, 50</dd>
						<dd class="text-xs text-white/55">11549 La Algaida</dd>
					</div>
				</dl>
			</div>

			<figure class="relative mx-auto w-full max-w-md lg:max-w-none">
				<div class="border-accent/40 absolute -inset-2 -rotate-1 rounded-lg border"></div>
				<div class="relative grid grid-cols-5 gap-3">
					<div class="col-span-3 overflow-hidden rounded-lg shadow-2xl">
						<Image
							src={IMAGES.fotoVertical2}
							alt="Interior de Venta El Raspa"
							widths={[360, 620]}
							sizes="(min-width: 1024px) 22vw, 55vw"
							quality={85}
							loading="eager"
							class="foto-calida aspect-[3/4] w-full object-cover"
						/>
					</div>
					<div class="col-span-2 flex flex-col gap-3">
						<div class="overflow-hidden rounded-lg shadow-xl">
							<Image
								src={IMAGES.fotoApaisada4}
								alt="Mesa de Venta El Raspa"
								widths={[260, 440]}
								sizes="(min-width: 1024px) 15vw, 38vw"
								quality={85}
								loading="lazy"
								class="foto-calida aspect-square w-full object-cover"
							/>
						</div>
						<div
							class="sello-el-raspa bg-primary/85 flex flex-1 flex-col items-center justify-center rounded-full px-3 py-6 text-center"
						>
							<i class="ri-sun-line text-accent text-2xl" aria-hidden="true"></i>
							<span class="mt-1 text-[0.6rem] leading-tight tracking-[0.14em] text-white/70 uppercase">
								desde<br />las 10:00
							</span>
						</div>
					</div>
				</div>
				<figcaption
					class="text-accent-content bg-accent mt-5 inline-flex items-center gap-2 rounded-full px-4 py-2 text-xs font-bold shadow-lg"
				>
					<i class="ri-calendar-check-line"></i> Abierto todos los días
				</figcaption>
			</figure>
		</div>
	</div>

	<div class="cenefa-el-raspa relative h-2 w-full"></div>
</section>
