---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/el-cortijo-de-sanchez-apaisada-10.jpg';
import codillo from '../assets/fotos/el-cortijo-de-sanchez-apaisada-02.jpg';
import carne from '../assets/fotos/el-cortijo-de-sanchez-apaisada-04.jpg';
import arroz from '../assets/fotos/el-cortijo-de-sanchez-apaisada-06.jpg';
import bocadillo from '../assets/fotos/el-cortijo-de-sanchez-apaisada-09.jpg';
import sepia from '../assets/fotos/el-cortijo-de-sanchez-vertical-03.jpg';
import calamares from '../assets/fotos/el-cortijo-de-sanchez-vista-5-05.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description = BUSINESS.description;

const galeria = [
	{
		src: codillo,
		alt: 'Codillo asado con patatas panadera servido en El Cortijo de Sánchez',
	},
	{
		src: arroz,
		alt: 'Arroz de marisco en paella, con langostinos, en El Cortijo de Sánchez',
	},
	{
		src: carne,
		alt: 'Carne guisada con patatas fritas, brócoli y zanahoria en El Cortijo de Sánchez',
	},
	{
		src: sepia,
		alt: 'Sepia a la plancha con lechuga y aliño en El Cortijo de Sánchez',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo de bacon y queso con patatas y ensalada en El Cortijo de Sánchez',
	},
	{
		src: calamares,
		alt: 'Calamares a la romana con limón en El Cortijo de Sánchez',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.fullName,
	alternateName: ['El Cortijo de Sánchez', 'El Cortijo', 'Restaurante El Cortijo Vila-real'],
	slogan: BUSINESS.tagline,
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34604824732',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Mediterránea', 'Cocina casera', 'Brasa', 'Arroces'],
	areaServed: [
		{ '@type': 'City', name: 'Vila-real' },
		{ '@type': 'AdministrativeArea', name: 'Plana Baixa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.province,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday'],
			opens: '08:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '08:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '20:00',
			closes: '00:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '08:00',
			closes: '00:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '08:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'El Cortijo de Sánchez · Cocina mediterránea en Vila-real';
const cita = REVIEWS[2];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#23405c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="El Cortijo de Sánchez, restaurante Vila-real, cocina mediterránea Vila-real, almuerzos Vila-real, bocadillos, croquetas, brasa, Carrer Onda 42"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="El Cortijo de Sánchez · Cocina mediterránea en Vila-real"
			ogDescription="Cocina mediterránea, almuerzos con brasa y bocadillos, croquetas de la casa y comida de mediodía. 4,4 en Google con 345 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Arroz de marisco en paella de El Cortijo de Sánchez, en Vila-real"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#23405c"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.province}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone="+34604824732"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Vila-real, Castelló"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'España',
				phone: '+34 604 82 47 32',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[comedor]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Cocina mediterránea · Vila-real"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer Onda, 42 · Vila-real"
				title="Cocina de casa,<br />brasa y<br /><em>buen almuerzo.</em>"
				lede="El Cortijo de Sánchez es el restaurante mediterráneo de la calle Onda: almuerzos con brasa y bocadillos, croquetas que se recuerdan y comida de mediodía. De lunes a domingo, con cenas los viernes y los sábados."
				image={comedor}
				imageAlt="Comedor de El Cortijo de Sánchez con mesas de madera, espejos y la barra al fondo"
				primaryCta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Almuerzos y brasa"
				facts={[
					{ label: 'Nota', html: '<b>4,4 en Google</b> con 345 reseñas' },
					{ label: 'Almuerzos', html: 'brasa y <b>bocadillos</b>' },
					{ label: 'Cenas', html: '<b>viernes y sábado</b>' },
					{ label: 'Martes', html: '<b>Cerrado</b>' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Qué ofrece El Cortijo de Sánchez" items={SERVICIOS} />

			<LocalAbout
				label="Restaurante mediterráneo en la Plana Baixa"
				title="El almuerzo<br />de todos los días<br /><em>y la mesa de fiesta.</em>"
				paragraphs={[
					'En el número 42 de la calle Onda, en Vila-real, El Cortijo de Sánchez hace cocina mediterránea sin complicarse: producto de temporada, guisos de casa y una brasa que se enciende para el almuerzo y para las mesas que se alargan. El comedor es amplio, con mesas de madera y espejos, y la barra queda al fondo.',
					'Las reseñas repiten tres cosas: los almuerzos son variados, con brasa y distintas opciones de bocadillos; las croquetas son de las que se recuerdan («el mejor surtido que he probado en mi vida», dice una); y el trato de los dueños es cercano. La cerveza, bien fría, completa el cuadro.',
					'El horario es de mediodía de lunes a domingo, con el martes cerrado. Los viernes y los sábados hay servicio de noche, y el sábado la cocina no para de 8:00 a 24:00. Es un sitio de barrio para comer bien sin prisa y sin inventos.',
				]}
				note="«Los dueños muy buenas personas, las cervezas muy frescas y la comida exquisita», dice una reseña. Otra: «buenos y variados almuerzos, tanto brasa como diferentes opciones de bocadillos»."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="De la brasa<br /><em>al comedor.</em>"
				description="La ficha de Google no publica carta ni precios, así que esta selección sale de sus reseñas y de lo que se ve en las fotos del perfil: almuerzos con brasa y bocadillos, croquetas, cocina mediterránea, platos de cuchara y raciones para compartir."
				cta={{ label: 'Preguntar qué hay hoy', href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Sin precios: la ficha no los publica y esta web no los inventa. La carta y las raciones se consultan en la barra o por teléfono en el 604 82 47 32."
			/>

			<section class="cita" aria-label="Opinión destacada en Google">
				<div class="wrap">
					<blockquote>
						<p>“{cita.text}”</p>
						<footer>Reseña en Google · {cita.rating} estrellas</footer>
					</blockquote>
					<div class="cita-nota">
						<b>4,4</b>
						345 reseñas en Google
						<a href={MAPS.reviews} target="_blank" rel="noreferrer">Leerlas todas ↗</a>
					</div>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor,<br />la brasa<br /><em>y la mesa.</em>"
				description="Estas fotografías proceden del perfil de El Cortijo de Sánchez en Google Maps: el comedor, el codillo asado con patatas, el arroz de marisco, la carne con verduras, la sepia a la plancha, el bocadillo de bacon y queso y los calamares a la romana."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer Onda, 42 · 12540 Vila-real"
				title="Te esperamos<br /><em>en la calle Onda.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Castelló · Plana Baixa']}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="Horario publicado en la ficha de Google: de 8:00 a 16:00 de lunes a domingo, con el martes cerrado; viernes también de 20:00 a 24:00 y sábado de 8:00 a 24:00. En festivos como el Día de Todos los Santos puede cambiar: llama antes."
				mapTitle="Mapa de Restaurante El Cortijo de Sánchez en la calle Onda, 42, Vila-real"
				mapEmbedUrl={MAPS.embed}
				mapLabel="El Cortijo de Sánchez · Vila-real"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="Se reserva por teléfono, llamando al 604 82 47 32: no hay reserva online ni formulario en esta web. Para grupos y para las cenas de viernes y sábado conviene llamar con antelación."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>sentarse.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a El Cortijo"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
