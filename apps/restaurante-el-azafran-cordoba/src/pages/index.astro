---
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,		facebookUrl,
		faqSchema,
		faqs,
		instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	specialties,
	tripadvisorUrl,
} from '../lib/business';

const title = 'Restaurante El Azafrán | Cocina cordobesa en el Zoco de Córdoba';
const description =
	'Restaurante El Azafrán en el Zoco de Córdoba: cocina casera cordobesa, raciones para compartir y sabores tradicionales. Llama para consultar y reservar: 957 08 46 52.';
const keywords =
	'Restaurante El Azafrán Córdoba, restaurante Zoco Córdoba, cocina cordobesa, comida casera Córdoba, patatas al pelotón, salmorejo, rabo de toro, Calle Manuel Fuentes Bocanegra 31';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#30251e" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Córdoba, barrio del Zoco" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración original inspirada en la cocina cordobesa de El Azafrán; no es una fotografía del restaurante" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante El Azafrán, inicio">
				<span class="brand-mark" aria-hidden="true">A</span>
				<span class="brand-copy">El Azafrán <small>Cocina cordobesa · Zoco</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cocina">La cocina</a>
				<a href="#restaurante">La casa</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 957 08 46 52</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Barrio del Zoco · Córdoba</p>
					<h1 id="hero-title">Sabor de casa,<br /><em>mesa generosa.</em></h1>
					<p class="hero-intro">En El Azafrán, la cocina cordobesa y las recetas de siempre se sirven en un ambiente familiar. Un lugar para compartir raciones, probar las sugerencias del día y dejar sitio para el postre.</p>
					<div class="hero-actions">
						<a class="button button-terracotta" href={phoneHref}>Llamar y consultar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Nos encuentras en</small><address>{business.streetAddress}<br />{business.postalCode} · Córdoba</address></div>
						<div><small>Reservas</small><a href={phoneHref}>{business.phone}</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración vectorial original de un plato cordobés, no es una foto del restaurante">
					<span class="plate-dot" aria-hidden="true"></span><div class="plate" aria-hidden="true"><div class="dish"></div><span class="herb"></span></div>
					<div class="art-caption"><strong>Tradición en cada plato</strong>Cocina cordobesa · sabor casero</div>
				</div>
			</section>

			<div class="promise" aria-label="Propuesta gastronómica de El Azafrán">
				<span>Cocina cordobesa</span><span>Raciones generosas</span><span>Recetas caseras</span><span>Ambiente familiar</span>
			</div>

			<section class="section intro" id="restaurante" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Restaurante en el Zoco</p>
					<h2 id="intro-title">Un clásico familiar<br /><em>de Córdoba.</em></h2>
				</div>
				<div class="intro-copy">
					<p>En el barrio del Zoco, El Azafrán propone una cocina cordobesa de corte clásico en un ambiente familiar. Su carta combina tapas y raciones, platos caseros y sugerencias fuera de carta, con opciones para disfrutar en compañía.</p>
					<p>Entre los platos citados en fuentes gastronómicas figuran patatas al pelotón, salmorejo, croquetas, carrillada, rabo de toro y pisto con huevo. La disponibilidad y la carta actual pueden cambiar; consulta al restaurante antes de ir.</p>
					<p class="source-note">Las fuentes públicas difieren en el número de portal (31 o 33). Se muestra el 31, indicado por Turismo de Córdoba y ABC; confirma la dirección exacta al llamar si lo necesitas.</p>
				</div>
			</section>

			<section class="section menu-section" id="cocina" aria-labelledby="menu-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Cocina cordobesa · tradición casera</p>
						<h2 id="menu-title">Platos para<br /><em>disfrutar sin prisa.</em></h2>
					</div>
					<p>Una pequeña guía de platos citados en fuentes gastronómicas y directorios. No es una carta oficial: consulta disponibilidad, alérgenos, precios y horario con el establecimiento.</p>
				</div>
				<div class="menu-grid">
					{specialties.map((dish, index) => (
						<article class="menu-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<p class="menu-note">Platos orientativos, sujetos a carta y temporada. <a href={phoneHref}>Llama para consultar las sugerencias de hoy</a>.</p>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<p class="section-label"><span aria-hidden="true"></span> El Azafrán en imágenes</p>
				<h2 id="gallery-title">Conoce la casa<br /><em>desde la galería.</em></h2>
				<p class="gallery-copy">El enlace de Maps identifica el lugar pero no incluye enlaces directos a las fotos. Abre Maps o el perfil conjunto de Casa Fran y El Azafrán para ver imágenes reales del restaurante, sus platos y novedades.</p>
				<div class="gallery-grid">
					<a class="gallery-card" href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Ver ficha y fotos de Restaurante El Azafrán en Google Maps">
						<span class="gallery-tag">Fotos de la ficha</span><span class="gallery-title">Google Maps <span aria-hidden="true">↗</span></span>
					</a>
					<a class="gallery-card" href={instagramUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Casa Fran y El Azafrán en Instagram">
						<span class="gallery-tag">Instagram del grupo</span><span class="gallery-title">Casa Fran y Azafrán <span aria-hidden="true">↗</span></span>
					</a>
					<a class="gallery-card" href={facebookUrl} target="_blank" rel="noreferrer" aria-label="Ver la página de Facebook de Restaurante El Azafrán">
						<span class="gallery-tag">Página del restaurante</span><span class="gallery-title">Facebook <span aria-hidden="true">↗</span></span>
					</a>
				</div>
				<p class="gallery-note">Las ilustraciones y los fondos de las tarjetas son originales, no fotografías del restaurante. Las imágenes auténticas se consultan en las galerías externas.</p>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14005 · Zoco · Córdoba</p>
					<h2 id="visit-title">Te esperamos<br /><em>en El Azafrán.</em></h2>
					<address>{business.streetAddress}<br />{business.neighborhood} · {business.postalCode}<br />{business.city}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Contacto y reservas</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Indicaciones</small><a href={mapsUrl} target="_blank" rel="noreferrer">Abrir en Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Redes y opiniones</small><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a> · <a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar al restaurante</a>
					</div>
					<p class="menu-note">Los horarios publicados pueden estar desactualizados. Confirma el servicio llamando antes de venir.</p>
				</div>
				<div class="map-card">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa del Restaurante El Azafrán en calle Manuel Fuentes Bocanegra, Córdoba" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<div class="map-label"><div><strong>Restaurante El Azafrán</strong><small>Zoco · Córdoba</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
			<Galeria nombre="Restaurante El Azafrán" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="Restaurante El Azafrán, volver al inicio">
				<span class="brand-mark" aria-hidden="true">A</span><span class="brand-copy">Restaurante El Azafrán <small>Cocina cordobesa · Zoco</small></span>
			</a>
			<nav class="footer-nav" aria-label="Perfiles y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Restaurante El Azafrán · Córdoba. Consulta la carta y el horario con el establecimiento.</small>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar para consultar <span>957 08 46 52</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>


