---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import papas from '../assets/fotos/el-parcero-teatinos-apaisada-05.jpg';
import fachada from '../assets/fotos/el-parcero-teatinos-apaisada-01.jpg';
import comiendo from '../assets/fotos/el-parcero-teatinos-vertical-02.jpg';
import arepa from '../assets/fotos/el-parcero-teatinos-vertical-03.jpg';
import chicharron from '../assets/fotos/el-parcero-teatinos-vertical-04.jpg';
import papasQueso from '../assets/fotos/el-parcero-teatinos-vertical-06.jpg';
import arepaGuac from '../assets/fotos/el-parcero-teatinos-vertical-07.jpg';
import papasClose from '../assets/fotos/el-parcero-teatinos-vertical-08.jpg';
import nevera from '../assets/fotos/el-parcero-teatinos-vertical-09.jpg';
import barra from '../assets/fotos/el-parcero-teatinos-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'El Parcero Teatinos · Restaurante colombiano en Málaga';
const description =
	'El Parcero Teatinos, en Carril del Capitán, 9 (Teatinos-Universidad, 29010 Málaga). Restaurante 100% colombiano, con hamburguesas Angus, chicharrón y domicilios, de miércoles a domingo de 20:00 a 23:00.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de El Parcero Teatinos con el cartel amarillo de comida colombiana y la terraza',
	},
	{
		src: arepaGuac,
		alt: 'Arepa con carne desmechada, guacamole, queso rallado y salsas en un plato de papel',
	},
	{
		src: chicharron,
		alt: 'Bandeja de chicharrón en tiras sobre patatas fritas con salsa',
	},
	{
		src: arepa,
		alt: 'Primer plano de una arepa con guacamole, queso fundido y salsas en una caja de cartón',
	},
	{
		src: papasQueso,
		alt: 'Patatas cargadas con queso rallado, chicharrón y salsas en una bandeja de aluminio',
	},
	{
		src: papasClose,
		alt: 'Detalle de las papas con chicharrón, queso rallado y salsa de la casa',
	},
	{
		src: nevera,
		alt: 'Nevera de El Parcero con bebidas colombianas Postobón, Hit y Coca-Cola',
	},
	{
		src: barra,
		alt: 'Barra de El Parcero con el cartel «Autentic colombian food» y personal preparando pedidos',
	},
	{
		src: comiendo,
		alt: 'Cliente comiendo una arepa de El Parcero en una caja de cartón',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de El Parcero Teatinos',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-parcero`,
	name: BUSINESS.name,
	alternateName: ['El Parcero', 'El Parcero Málaga', 'Restaurante colombiano El Parcero'],
	description:
		'Restaurante 100% colombiano en Carril del Capitán, 9, Teatinos-Universidad (29010 Málaga). Hamburguesas Angus, chicharrón, arepas y domicilios.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, BUSINESS.website],
	telephone: '+34627621696',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina colombiana', 'Hamburguesas', 'Comida colombiana'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"el-parcero-teatinos-apaisada-05.jpg": papas,
	"el-parcero-teatinos-apaisada-01.jpg": fachada,
	"el-parcero-teatinos-vertical-07.jpg": arepaGuac,
	"el-parcero-teatinos-vertical-04.jpg": chicharron,
	"el-parcero-teatinos-vertical-03.jpg": arepa,
	"el-parcero-teatinos-vertical-06.jpg": papasQueso,
	"el-parcero-teatinos-vertical-08.jpg": papasClose,
	"el-parcero-teatinos-vertical-09.jpg": nevera,
	"el-parcero-teatinos-vertical-10.jpg": barra,
	"el-parcero-teatinos-vertical-02.jpg": comiendo,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#101a33" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Titan+One&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Parcero Teatinos, restaurante colombiano Málaga, comida colombiana Teatinos, hamburguesas Angus Málaga, chicharrón, arepas, domicilios Carril del Capitán"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Restaurante 100% colombiano en Carril del Capitán, 9. Hamburguesas Angus, chicharrón, arepas y domicilios. De miércoles a domingo."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Papas con chicharrón y salsa de El Parcero Teatinos"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#101a33"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[papas]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Parcero"
			subtitle="Comida colombiana · Teatinos"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Enlaces del local ↗', href: BUSINESS.website, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a El Parcero"
			navAriaLabel="Enlaces de El Parcero Teatinos"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
