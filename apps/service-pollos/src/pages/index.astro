---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import rotulo from '../assets/fotos/service-pollos-apaisada-01.jpg';
import fachada from '../assets/fotos/service-pollos-vertical-02.jpg';
import mostrador from '../assets/fotos/service-pollos-apaisada-03.jpg';
import paella from '../assets/fotos/service-pollos-vertical-04.jpg';
import pescado from '../assets/fotos/service-pollos-vertical-05.jpg';
import polloPatatas from '../assets/fotos/service-pollos-vertical-06.jpg';
import empanado from '../assets/fotos/service-pollos-vertical-07.jpg';
import polloGarbanzos from '../assets/fotos/service-pollos-vertical-08.jpg';
import fideua from '../assets/fotos/service-pollos-vertical-09.jpg';
import asado from '../assets/fotos/service-pollos-vertical-10.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'ServicePollos · Asador de pollos en Murcia';
const description =
	'ServicePollos, en C. del Carmen, 17 (30110 Murcia). Asador de pollos, arroces, fideuá y comidas para llevar, de martes a domingo de 9:30 a 16:30.';

const galeria = [
	{
		src: rotulo,
		alt: 'El rótulo de ServicePollos, asador de pollos, con el cartel de comidas para llevar y servicio a domicilio y los teléfonos',
	},
	{
		src: mostrador,
		alt: 'El mostrador de ServicePollos con paellas de arroz y fideos, bandejas de guisos y dos hornos rotativos llenos de pollos asados',
	},
	{
		src: asado,
		alt: 'Un pollo asado entero dorado en una bandeja de aluminio, recién sacado del horno',
	},
	{
		src: polloPatatas,
		alt: 'Un plato de pollo asado troceado con patatas panadera y hierbas',
	},
	{
		src: polloGarbanzos,
		alt: 'Una bandeja de pollo asado troceado con garbanzos y zanahoria en su jugo, en el mostrador',
	},
	{
		src: paella,
		alt: 'Una paella de marisco con gambas y pimiento rojo en el mostrador de ServicePollos',
	},
	{
		src: fideua,
		alt: 'Una paella de fideos con verduras y pimiento rojo, recién hecha',
	},
	{
		src: pescado,
		alt: 'Lomos de pescado rebozado sobre una cama de pimientos rojos asados en una bandeja',
	},
	{
		src: empanado,
		alt: 'Un filete empanado en una fiambrera de plástico, listo para llevar',
	},
	{
		src: fachada,
		alt: 'La fachada de ServicePollos en la calle del Carmen de Murcia, con el rótulo de asador de pollos y el escaparate',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#servicepollos`,
	name: BUSINESS.fullName,
	alternateName: ['ServicePollos Murcia', 'Service Pollos', 'Asador de pollos ServicePollos'],
	description:
		'Asador de pollos y comidas para llevar en la calle del Carmen, 17 (30110 Murcia): pollo a la brasa, arroces y fideuá, con servicio a domicilio.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34868973276',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Arroces', 'Cocina casera', 'Comida para llevar'],
	hasMenu: {
		'@type': 'Menu',
		name: 'Carta de ServicePollos',
		inLanguage: 'es-ES',
		hasMenuSection: MENU.map((group) => ({
			'@type': 'MenuSection',
			name: group.title,
			hasMenuItem: group.items.map((item) => ({
				'@type': 'MenuItem',
				name: item.name,
				description: item.note,
			})),
		})),
	},
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Murcia' },
		{ '@type': 'AdministrativeArea', name: 'Región de Murcia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:30',
			closes: '16:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#3f5136" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Rubik:wght@400;500;700&family=Yellowtail&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="ServicePollos Murcia, asador de pollos Murcia, pollo a la brasa Calle del Carmen, comida para llevar Murcia, arroces y fideuá Murcia, pollo por encargo 30110"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Asador de pollos, arroces y fideuá para llevar en C. del Carmen, 17, Murcia. Pollo a la brasa por encargo y servicio a domicilio. De 9:30 a 16:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Un pollo asado dorado del asador ServicePollos, en Murcia"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#3f5136"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Murcia"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[rotulo]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="ServicePollos"
			subtitle="Asador de pollos · Murcia"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. del Carmen, 17 · Murcia"
				title="Pollo a la brasa <br /><em>y comida para llevar.</em>"
				lede={`ServicePollos está en la calle del Carmen, 17, en Murcia. El rótulo lo dice sin rodeos: «Asador de pollos», «comidas para llevar» y «servicio a domicilio». En la ficha, el negocio firma su cocina así: «Asador de pollos y comidas para llevar con responsabilidad y seguridad». Abre de martes a domingo, de 9:30 a 16:30, y tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={rotulo}
				imageAlt="El rótulo de ServicePollos, asador de pollos, con el cartel de comidas para llevar y servicio a domicilio"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>9:30–16:30</b> · martes a domingo' },
					{ label: 'Servicio', html: '<b>Pollo por encargo</b><br />y a domicilio' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Asador"
			/>

			<LocalChips label="Lo que ofrece ServicePollos" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="El asador <br /><em>de la calle del Carmen.</em>"
				paragraphs={[
					'El local está en la calle del Carmen, 17, en Murcia, con el rótulo blanco de «SERVICEPOLLOS · Asador de Pollos» sobre el escaparate y una gallina pintada como mascota. En la fachada se leen también los teléfonos y las palabras «comidas para llevar» y «servicio a domicilio».',
					'Dentro, el mostrador separa dos mundos: a un lado las paellas de arroz y de fideos, las bandejas de guisos, pescado rebozado, croquetas y patatas; al otro, dos hornos rotativos con los pollos ensartados dorándose. El cartel de la puerta anuncia pollo a la brasa por encargo.',
					'La ficha lo clasifica como comida a domicilio y parrilla, y el propio negocio se describe como «asador de pollos y comidas para llevar con responsabilidad y seguridad». La cocina va más allá del pollo: hay arroces, fideuá, guisos y postres.',
					`Los vecinos le dan ${RATING.label} sobre 5 con ${RATING.count} reseñas. «Arroces buenos y fideuá muy buenos y el pollo brasa también muy rico», cuenta una; «los dulces son deliciosos», añade otra. La tercera, de dos estrellas, se queja del precio de unos carbonara.`,
				]}
				note="La ficha no publica carta con precios, zona de reparto, pedido mínimo ni formas de pago. Los platos de esta página salen de las reseñas destacadas y de las bandejas que aparecen en las fotos del perfil; no hay importes que mostrar sin inventarlos. El horario de la ficha es 9:30–16:30, aunque el cartel de la fachada marca 9:30–17:00."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que sale del horno</p>
					<h2 id="highlights-title">Brasa, arroz <br /><em>y vitrina.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La comida"
				title="Del asador <br /><em>al mostrador.</em>"
				description="Platos tomados de las reseñas del perfil y de las bandejas que se ven en sus fotos. La ficha no publica precios, así que aquí no hay importes."
				cta={{ label: `Encargar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Pollo a la brasa, arroces, fideuá y guisos del día, con guarniciones y postres. Los platos cambian y los precios no están publicados: se consultan en el 868 97 32 76. El pollo a la brasa se anuncia por encargo en el cartel de la puerta."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El rótulo, el mostrador <br /><em>y los pollos.</em>"
				description="Diez fotografías del perfil de ServicePollos: el rótulo de la fachada, el mostrador con las paellas y los hornos rotativos, el pollo asado entero, el pollo con patatas y con garbanzos, la paella de marisco, la fideuá, el pescado rebozado y un empanado listo para llevar."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,1 sobre 5, <em>con 131 reseñas.</em></h2>
						<p>
							Google publica una media de 4,1 con 131 opiniones (noviembre de 2026). Las reseñas
							que se ven aquí elogian los arroces, la fideuá, el pollo a la brasa y los dulces; la
							de dos estrellas se queja del precio de unos carbonara. Son las que destaca la
							ficha; hay muchas más opiniones en Google.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,1</strong>
						<span>★★★★★</span>
						<small>131 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En Murcia, <br /><em>calle del Carmen.</em>"
				addressLines={[BUSINESS.street, BUSINESS.postalCode, `${BUSINESS.district}, ${BUSINESS.region}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha: de 9:30 a 16:30, de martes a domingo, con el lunes cerrado. El cartel de la fachada marca hasta las 17:00, así que conviene llamar antes. ${HORARIO_AVISO}`}
				mapTitle="Mapa de ServicePollos en la calle del Carmen, 17, Murcia"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. del Carmen, 17 · Murcia"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote={`Pedidos por teléfono en el ${BUSINESS.phone}. La ficha incluye la categoría «comida a domicilio» y declara acceso para sillas de ruedas, pero no publica zona de reparto, pedido mínimo ni formas de pago.`}
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>encargar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultados en noviembre de 2026. La ficha no publica carta con precios: confirma platos, precios y reparto antes de encargar."
			ctaLabel="Llamar a ServicePollos"
			navAriaLabel="Enlaces de ServicePollos"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
