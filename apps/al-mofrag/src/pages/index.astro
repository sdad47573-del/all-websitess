---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/al-mofrag-vertical-01.jpg';
import carpa from '../assets/fotos/al-mofrag-vertical-02.jpg';
import calamar from '../assets/fotos/al-mofrag-vista-3-03.jpg';
import hamburguesa from '../assets/fotos/al-mofrag-apaisada-04.jpg';
import brasa from '../assets/fotos/al-mofrag-vertical-05.jpg';
import escalopines from '../assets/fotos/al-mofrag-panoramica-06.jpg';
import entrecot from '../assets/fotos/al-mofrag-vertical-08.jpg';
import postres from '../assets/fotos/al-mofrag-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'«Al Mofrag» Terraza & Restaurante, chiringuito al aire libre en Villarreal de San Carlos, 40, B (Monfragüe, Cáceres). Hamburguesa, brasa y terraza. 4,5 en Google con 629 reseñas. Tel. 927 19 92 05.';

const galeria = [
	{
		src: carpa,
		alt: 'Carpa de la terraza de Al Mofrag con césped artificial, sillas verdes y ventanales abiertos al campo',
	},
	{
		src: comedor,
		alt: 'Comedor de Al Mofrag con paredes de flores, madera, lámparas de mimbre y mesas largas con velas de colores',
	},
	{
		src: calamar,
		alt: 'Calamar a la plancha con ensalada de lechuga, cebolla y pimiento rojo en la terraza de Al Mofrag',
	},
	{
		src: brasa,
		alt: 'Carne a la brasa con patatas fritas, calabacín y calabaza asados y un cuenco de salsa en Al Mofrag',
	},
	{
		src: escalopines,
		alt: 'Escalopines empanados con patatas fritas, queso rallado y pimiento verde en Al Mofrag',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la brasa con patatas fritas y setas salteadas servido en Al Mofrag',
	},
	{
		src: postres,
		alt: 'Dos postres caseros de Al Mofrag: torrija con helado y tarta con pistacho y chocolate blanco',
	},
	{
		src: hamburguesa,
		alt: 'Hamburguesa partida en dos con patatas fritas en Al Mofrag Terraza & Restaurante',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#al-mofrag`,
	name: BUSINESS.name,
	alternateName: [
		'Al Mofrag',
		'Al Mofrag Villarreal de San Carlos',
		'Restaurante Al Mofrag Monfragüe',
	],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 927 19 92 05',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Casera', 'Brasa'],
	areaServed: [
		{ '@type': 'City', name: 'Villarreal de San Carlos' },
		{ '@type': 'City', name: 'Serradilla' },
		{ '@type': 'AdministrativeArea', name: 'Parque Nacional de Monfragüe' },
		{ '@type': 'AdministrativeArea', name: 'Cáceres' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday'],
			opens: '09:30',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '09:30',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '20:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '09:30',
			closes: '18:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Zona para no fumadores', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Pedimos la hamburguesa buenísima y las patatas una ración bastante grande.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Muy buena atencion del dueño y los camareros, raciones abundantes y de calidad.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La terraza', href: '#casa' },
	{ label: 'La cocina', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = '«Al Mofrag» Terraza & Restaurante · Monfragüe';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f6144" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Al Mofrag, Al Mofrag Monfragüe, restaurante Villarreal de San Carlos, terraza Monfragüe, comer en Monfragüe, bar Villarreal de San Carlos, chiringuito Cáceres, Villarreal de San Carlos 40"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="«Al Mofrag» Terraza & Restaurante · Monfragüe"
			ogDescription="Chiringuito al aire libre en Villarreal de San Carlos (Monfragüe): hamburguesa, brasa, raciones y terraza. 4,5 en Google con 629 reseñas. Tel. 927 19 92 05."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Hamburguesa con patatas fritas en la terraza de Al Mofrag, Villarreal de San Carlos"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2f6144"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			postalCode={BUSINESS.postalCode}
			phone="+34927199205"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[hamburguesa]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="«Al Mofrag»"
			subtitle="Terraza & restaurante · Monfragüe"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Villarreal de San Carlos · Monfragüe"
				title="Comer al aire<br /><em>en Monfragüe.</em>"
				lede={`«Al Mofrag» es terraza y restaurante en Villarreal de San Carlos, el pueblo del Parque Nacional de Monfragüe (Cáceres). Chiringuito al aire libre con hamburguesa, brasa, raciones y postres caseros, de miércoles a lunes. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={hamburguesa}
				imageAlt="Hamburguesa partida en dos con patatas fritas en Al Mofrag Terraza & Restaurante"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)`,
					},
					{ label: 'Horario', html: 'Mié–Lun · 9:30–16:30' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phoneDisplay}</b>` },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece «Al Mofrag» Terraza & Restaurante" items={SERVICIOS} />

			<LocalAbout
				label="La terraza"
				title="Un chiringuito<br /><em>en el parque.</em>"
				paragraphs={[
					'«Al Mofrag» Terraza & Restaurante está en Villarreal de San Carlos, 40, B, el pueblo que el Parque Nacional de Monfragüe tiene dentro de sus límites, en el término municipal de Serradilla (Cáceres).',
					'El propio local se describe en Google como «bar chiringuito al aire libre, rodeado de naturaleza, terraza», con zona para no fumadores. En sus fotos se ve el comedor cubierto —paredes de flores, madera, lámparas de mimbre y luces cálidas— y la terraza de césped bajo la carpa naranja, con sillas verdes y el campo al otro lado de los ventanales.',
					'La cocina es de bar restaurante: hamburguesa con patatas, escalopines empanados, calamar a la plancha, carne a la brasa con verduras asadas y postres caseros. Las reseñas coinciden en las raciones «abundantes y de calidad» y en el trato del dueño y los camareros.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña resume la experiencia: «pedimos la hamburguesa buenísima y las patatas una ración bastante grande».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La cocina"
				title="Hamburguesa, brasa<br /><em>y plancha.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que nombran sus reseñas y lo que se ve en las fotos de sus platos."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Sin carta publicada, los platos cambian según el día y la temporada. Llama al 927 19 92 05 para saber qué hay y si la terraza está abierta."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La terraza<br /><em>y los platos.</em>"
				description="Estas fotografías proceden del perfil de «Al Mofrag» en Google Maps: la carpa con césped, el comedor de flores y madera, y los platos que salen de su cocina."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En el corazón<br /><em>de Monfragüe.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google. De 9:30 a 16:30 de miércoles a lunes —el domingo, hasta las 18:00—, cenas de 20:00 a 23:00 los viernes y sábados, y martes cerrado."
				mapTitle="Mapa de «Al Mofrag» Terraza & Restaurante en Villarreal de San Carlos, 40, B (Serradilla, Cáceres)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="«Al Mofrag» Terraza & Restaurante · Monfragüe"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva llamando al 927 19 92 05. La ficha de Google marca acceso para sillas de ruedas. Está en Villarreal de San Carlos, el pueblo del Parque Nacional de Monfragüe, dentro del término de Serradilla."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Al Mofrag"
		/>
	</body>
</html>
