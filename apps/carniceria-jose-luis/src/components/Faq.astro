---
import { faqSchema } from '../data/schema';
import { BUSINESS, FAQ } from '../data/site';
---

<section id="faq" class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
		<div class="text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">
				Preguntas frecuentes
			</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">Lo que más nos preguntáis</h2>
			<div class="joseluis-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/70 mt-6">
				¿Te queda alguna duda? Llama a la carnicería al <a
					class="text-primary font-semibold"
					href={BUSINESS.phoneHref}>{BUSINESS.phoneDisplay}</a
				>.
			</p>
		</div>
		<div class="mt-12 space-y-3">
			{
				FAQ.map((item) => (
					<details class="collapse-arrow border-base-300 bg-base-200 collapse border">
						<summary class="collapse-title font-display text-lg font-semibold">{item.q}</summary>
						<div class="collapse-content">
							<p class="text-base-content/75 text-sm leading-relaxed">{item.a}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
</section>
