---
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	facebookPhotosUrl,
	facebookUrl,
	faqSchema,
	faqs,
	instagramUrl,
	mapEmbedUrl,
	mapsPhotosUrl,
	mapsUrl,
	openingHours,
	phoneHref,
	restaurantSchema,
	specialties,
	tripadvisorUrl,
} from '../lib/business';

const title = 'Restaurante Canadian | Tapas y menú del día en Poniente Sur, Córdoba';
const description =
	'Restaurante Canadian en Córdoba (Poniente Sur): tapas, menú del día y cocina española con risotto de rabo de toro, carrilladas al Pedro Ximénez, flamenquines y tarta de queso. Terraza y para llevar. C. Albéniz, 6 · 957 45 27 56.';
const keywords =
	'Restaurante Canadian Córdoba, Canadian bar and tapas, tapas Córdoba, menú del día Córdoba, comer en Poniente Sur Córdoba, risotto de rabo de toro Córdoba, carrilladas al Pedro Ximénez, flamenquines, tarta de queso Córdoba, Calle Albéniz 6 Córdoba, bar de tapas Córdoba centro, desayunos Córdoba';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#b33a2b" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Karla:wght@400;500;600;700&family=Courier+Prime:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración original de un plato de tapas para Restaurante Canadian; no es una fotografía del establecimiento" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante Canadian, inicio">
				<span class="brand-mark" aria-hidden="true">CA</span>
				<span class="brand-copy">Canadian <small>Bar &amp; tapas · Córdoba</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">La carta</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 957 45 27 56</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Poniente Sur · Córdoba</p>
					<h1 id="hero-title">Tapas, menú<br /><em>y buena mesa.</em></h1>
					<p class="hero-intro">Restaurante Canadian es el bar de tapas de la Calle Albéniz, en Poniente Sur: una carta enorme para todos los gustos, un menú del día que llena y clásicos cordobeses como el rabo de toro o la carrillada al Pedro Ximénez. Terraza, para llevar y opciones veganas.</p>
					<div class="hero-actions">
						<a class="button button-gold" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={phoneHref}>Llamar para llevar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Nos encontrarás en</small><address>{business.streetAddress}<br />{business.postalCode} · Córdoba</address></div>
						<div><small>Contacto</small><a href={phoneHref}>{business.phone}</a><br /><a href={mapsUrl} target="_blank" rel="noreferrer">Ficha en Google Maps ↗</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración original de una tabla de tapas; no es una fotografía del establecimiento">
					<span class="art-tile" aria-hidden="true"></span>
					<div class="tabla" aria-hidden="true">
						<span class="cuenco a"></span><span class="cuenco b"></span><span class="cuenco c"></span><span class="pincho"></span>
					</div>
					<div class="tapa-tag" aria-hidden="true"><small>De la carta</small><strong>Tapa 3,50 €</strong><span>Menú del día: primero, segundo, postre y bebida</span></div>
					<div class="art-caption"><strong>Canadian</strong>Bar &amp; tapas desde 2008</div>
				</div>
			</section>

			<div class="promise" aria-label="Información de Restaurante Canadian">
				<span>Bar de tapas</span><span>Menú del día</span><span>Desayunos y brunch</span><span>Terraza exterior</span>
			</div>

			<section class="section intro" id="casa" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Un clásico del Poniente Sur</p>
					<h2 id="intro-title">Carta enorme,<br /><em>precio de barrio.</em></h2>
				</div>
				<div class="intro-copy">
					<p>En la Calle Albéniz, junto a la Avenida de Medina Azahara y a un paso del centro, Restaurante Canadian es una de las casas de comidas más reconocidas de Poniente Sur. Su gran baza es una carta extraordinariamente variada: cocina española tradicional, tapas, platos italianos y asiáticos, hamburguesas artesanales y bocadillos.</p>
					<p>El local es informal y acogedor, con mesas en el interior y terraza exterior, y funciona igual de bien para un desayuno temprano, un menú del día de trabajo o una comida de grupo. No se admiten reservas: se atiende por orden de llegada, así que en horas punta conviene ir con tiempo.</p>
					<p class="source-note">La información de esta página procede de la ficha de Google Maps, de los perfiles oficiales del establecimiento y de directorios gastronómicos. La carta y los horarios pueden cambiar: confirma antes de tu visita.</p>
				</div>
			</section>

			<section class="section carta" id="carta" aria-labelledby="carta-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Tapas, cuchara y brasa</p>
						<h2 id="carta-title">Los platos que<br /><em>más se piden.</em></h2>
					</div>
					<p>Una selección orientativa de los platos más mencionados por la clientela en reseñas y fuentes gastronómicas. No sustituye la carta vigente, que es muy amplia y variada.</p>
				</div>
				<div class="carta-grid">
					{specialties.map((dish, index) => (
						<article class="carta-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<div class="carta-extra">
					<p><strong>Menú del día:</strong> primero, segundo, bebida y postre por unos 12–14 € de lunes a viernes, y en torno a 20 € los fines de semana.</p>
					<p><strong>Desayunos y brunch:</strong> tostadas de todo tipo, croissants y café a precios competitivos, con opciones saludables.</p>
					<p class="menu-note">Consulta la carta, los platos del día y los alérgenos con el establecimiento. <a href={phoneHref}>Llama al 957 45 27 56</a>.</p>
				</div>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<div class="gallery-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Imágenes del local</p>
						<h2 id="gallery-title">Canadian,<br /><em>en fotos.</em></h2>
					</div>
					<p>Consulta fotos reales del local, de la terraza y de los platos en la ficha de Google Maps y en los perfiles oficiales del restaurante.</p>
				</div>
				<div class="gallery-grid">
					<a class="photo-card" href={mapsPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Restaurante Canadian en Google Maps">
						<span class="photo-label">Fotos de la ficha</span><span class="photo-title">Google Maps <span aria-hidden="true">↗</span></span>
					</a>
					<a class="photo-card alt" href={instagramUrl} target="_blank" rel="noreferrer" aria-label="Ver el Instagram oficial de Canadian Córdoba">
						<span class="photo-label">Perfil oficial</span><span class="photo-title">Instagram <span aria-hidden="true">↗</span></span>
					</a>
					<a class="photo-card alt2" href={facebookPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Canadian en Facebook">
						<span class="photo-label">Página del negocio</span><span class="photo-title">Facebook <span aria-hidden="true">↗</span></span>
					</a>
				</div>
				<p class="gallery-note">El enlace de Google Maps identifica la ficha, pero no expone URLs directas a los archivos de imagen, por lo que las fotos se consultan en las galerías enlazadas. Las ilustraciones de esta web son gráficos originales, no fotografías del establecimiento.</p>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14005 · Poniente Sur, Córdoba</p>
					<h2 id="visit-title">Ven a tapear<br /><em>a Albéniz.</em></h2>
					<address>{business.streetAddress}<br />{business.postalCode} {business.locality}<br />{business.province}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Para llevar y consultas</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Ubicación</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Redes sociales</small><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a> · <a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a> · <a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar y pedir para llevar</a>
					</div>
					<p class="hours-note">No se admiten reservas: se atiende por orden de llegada. Los horarios pueden variar en festivos; llama antes de desplazarte para confirmarlo.</p>
				</div>
				<div class="visit-side">
					<div class="hours-card">
						<h3>Horario orientativo</h3>
						<ul>
							{openingHours.map((slot) => (
								<li><span>{slot.day}</span><strong>{slot.hours}</strong></li>
							))}
						</ul>
					</div>
					<div class="map-card">
						<iframe title="Mapa de Restaurante Canadian en Calle Albéniz, Córdoba" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<div class="map-label"><div><strong>Restaurante Canadian</strong><small>C. Albéniz, 6 · Córdoba</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
			<Galeria nombre="Restaurante Canadian" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="Restaurante Canadian, volver al inicio">
				<span class="brand-mark" aria-hidden="true">CA</span><span class="brand-copy">Canadian <small>Bar &amp; tapas · Poniente Sur</small></span>
			</a>
			<nav class="footer-nav" aria-label="Redes y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Restaurante Canadian · Córdoba. Consulta horarios, carta y alérgenos directamente con el establecimiento.</small>
		</footer>
		<a class="mobile-call" href={phoneHref}>Pedir para llevar en Canadian <span>957 45 27 56</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>
