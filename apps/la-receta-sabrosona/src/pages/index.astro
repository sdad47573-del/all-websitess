---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/la-receta-sabrosona-apaisada-01.jpg';
import paella from '../assets/fotos/la-receta-sabrosona-vertical-02.jpg';
import tortilla from '../assets/fotos/la-receta-sabrosona-cuadrada-03.jpg';
import interior from '../assets/fotos/la-receta-sabrosona-apaisada-04.jpg';
import tartaCoco from '../assets/fotos/la-receta-sabrosona-apaisada-06.jpg';
import roscon from '../assets/fotos/la-receta-sabrosona-apaisada-07.jpg';
import escaparate from '../assets/fotos/la-receta-sabrosona-apaisada-09.jpg';
import tartaChocolate from '../assets/fotos/la-receta-sabrosona-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'La Receta Sabrosona · Comida para llevar en Umbrete';
const description =
	'La Receta Sabrosona, comida para llevar en el Paseo 1º de Mayo, 32, Umbrete. Pollos asados, tortillas de patatas, arroces, fritos y comida casera. Fotos, horario y teléfono de encargos.';

const galeria = [
	{ src: fachada, alt: 'Fachada de La Receta Sabrosona con el rótulo azul en el Paseo 1º de Mayo' },
	{ src: paella, alt: 'Paella de arroz con gambas y verduras en la paellera' },
	{ src: tortilla, alt: 'Tortilla de patatas entera recién hecha' },
	{ src: interior, alt: 'Interior de La Receta Sabrosona con el mostrador y la pared verde' },
	{ src: tartaCoco, alt: 'Tarta de coco cubierta de coco rallado' },
	{ src: tartaChocolate, alt: 'Tarta de chocolate con virutas y estrellas de chocolate blanco' },
	{ src: roscon, alt: 'Roscón de Reyes con fruta escarchada y almendras' },
	{ src: escaparate, alt: 'Entrada y rótulo de La Receta Sabrosona en el Paseo 1º de Mayo' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Oferta de La Receta Sabrosona',
	inLanguage: 'es-ES',
	description:
		'Selección orientativa basada en la descripción del negocio, sus fotografías y sus reseñas; la ficha no publica una carta oficial ni precios.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-receta-sabrosona`,
	name: BUSINESS.name,
	alternateName: ['La Receta Sabrosona Umbrete', 'La Receta Sabrosona Sevilla'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34954495967',
	priceRange: '€',
	servesCuisine: ['Comida casera', 'Comida para llevar', 'Pollos asados', 'Arroces'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday', 'Friday', 'Saturday'],
			opens: '19:30',
			closes: '22:30',
		},
	],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-receta-sabrosona-cuadrada-03.jpg": tortilla,
	"la-receta-sabrosona-apaisada-01.jpg": fachada,
	"la-receta-sabrosona-vertical-02.jpg": paella,
	"la-receta-sabrosona-apaisada-04.jpg": interior,
	"la-receta-sabrosona-apaisada-06.jpg": tartaCoco,
	"la-receta-sabrosona-apaisada-10.jpg": tartaChocolate,
	"la-receta-sabrosona-apaisada-07.jpg": roscon,
	"la-receta-sabrosona-apaisada-09.jpg": escaparate,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..600;1,400..500&family=Nunito+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Receta Sabrosona, comida para llevar Umbrete, pollos asados Umbrete, tortillas de patatas Umbrete, arroces Umbrete, fritos Umbrete, Paseo 1º de Mayo"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollos asados, tortillas de patatas, arroces y fritos en el Paseo 1º de Mayo, 32. Fotos, horario y encargos por teléfono."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de La Receta Sabrosona en Umbrete"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#1b2a5e"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Umbrete"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[tortilla]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Receta Sabrosona"
			subtitle="Comida para llevar · Umbrete"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma horario, platos y precios con el establecimiento."
			ctaLabel="Encargar en La Receta"
			navAriaLabel="Enlaces de La Receta Sabrosona"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
