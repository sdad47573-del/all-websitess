---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/el-terrazeo-del-guinda-malaga.jpg';
import foto1 from '../assets/fotos/el-terrazeo-del-guinda-malaga-foto-1.jpg';
import foto2 from '../assets/fotos/el-terrazeo-del-guinda-malaga-foto-2.jpg';
import foto3 from '../assets/fotos/el-terrazeo-del-guinda-malaga-foto-3.jpg';
import foto4 from '../assets/fotos/el-terrazeo-del-guinda-malaga-foto-4.jpg';
import foto5 from '../assets/fotos/el-terrazeo-del-guinda-malaga-foto-5.jpg';
import foto6 from '../assets/fotos/el-terrazeo-del-guinda-malaga-foto-6.jpg';

const business = {
	name: 'El Terrazeo del Guinda',
	street: 'Av. del Obispo Ángel Herrera Oria, 1',
	district: 'Cruz de Humilladero',
	city: 'Málaga',
	postalCode: '29007',
	phone: '952 27 56 66',
	latitude: 36.7179042,
	longitude: -4.438198,
	site: 'https://el-terrazeo-del-guinda.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/El+Terrazeo+del+Guinda/@36.7179042,-4.438198,17z/data=!3m1!4b1!4m6!3m5!1s0xd72f79e2de28531:0x5c7c11545682b319!8m2!3d36.7179042!4d-4.438198!16s%2Fg%2F11bwpdzyhh';
const reviewsUrl = 'https://search.google.com/local/reviews?placeid=ChIJMYXiLZ73cg0RGbOCVlQRfFw';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34952275666';
const instagramUrl = 'https://www.instagram.com/terrazeodelguinda/';
const facebookUrl =
	'https://www.facebook.com/p/El-Terrazeo-del-Guinda-100066756086118/';

const photos = {
	hero: fotoHero,
	foto1,
	foto2,
	foto3,
	foto4,
	foto5,
	foto6,
};

const servicios = [
	'Terraza al aire libre',
	'Desayunos desde las 8:00',
	'Tapas con la bebida',
	'Comidas de mediodía',
	'Apto para perros',
	'Accesible con silla de ruedas',
	'WiFi',
	'TV',
	'Para llevar',
	'Reservas por teléfono',
];

const carta = [
	{
		title: 'Desayunos',
		text: 'Buen arranque de mañana desde las 8:00: café, tostadas y zumo. En las reseñas se destaca tanto el desayuno como el almuerzo.',
	},
	{
		title: 'Tapas con la bebida',
		text: 'La tapa llega con la cerveza o el vino. Es lo que más repiten los clientes: generosa, casera y distinta cada día.',
	},
	{
		title: 'Calamares fritos',
		text: 'Los calamares fritos caseros son uno de los platos por los que más se reconoce a esta casa.',
	},
	{
		title: 'Picoteo y pescados',
		text: 'Carta amplia de platos para picar, ensaladas, tostas y pescados, además de carnes y filetes a la plancha.',
	},
	{
		title: 'Cocina con acento',
		text: 'Una cocina española con guiños granadinos y malagueños. Pregunta al equipo por los platos del día.',
	},
	{
		title: 'Cafetería y copas',
		text: 'Cafetería, tapería y restaurante por la mañana y a mediodía, y copas para el afterwork cuando el local lo anuncia.',
	},
];

const galeria = [
	{ src: photos.foto1, alt: 'Fotografía de El Terrazeo del Guinda publicada en su ficha de Google Maps (Málaga)' },
	{ src: photos.foto2, alt: 'Imagen de El Terrazeo del Guinda, bar en la avenida Herrera Oria (Málaga)' },
	{ src: photos.foto3, alt: 'Foto del El Terrazeo del Guinda en Cruz de Humilladero, Málaga, desde Google Maps' },
	{ src: photos.foto4, alt: 'Detalle de El Terrazeo del Guinda (Málaga) según las fotos de su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Fotografía del El Terrazeo del Guinda, tapería y cafetería en Málaga' },
	{ src: photos.foto6, alt: 'Imagen del El Terrazeo del Guinda en la avenida del Obispo Ángel Herrera Oria, Málaga' },
];

const faqs = [
	{
		q: '¿Dónde está El Terrazeo del Guinda?',
		a: 'En la avenida del Obispo Ángel Herrera Oria, 1, en el barrio de Cruz de Humilladero (29007 Málaga), a un paso de los Jardines de Picasso.',
	},
	{
		q: '¿Cuál es el horario de El Terrazeo del Guinda?',
		a: 'Abre de lunes a viernes de 8:00 a 17:30 y los sábados de 12:30 a 17:30. Los domingos permanece cerrado. En festivos conviene llamar antes al 952 27 56 66.',
	},
	{
		q: '¿Se puede desayunar y comer allí?',
		a: 'Sí. Es cafetería, tapería y restaurante: sirve desayunos desde primera hora, comidas de mediodía y tapas que se acompañan con la bebida.',
	},
	{
		q: '¿Tiene terraza?',
		a: 'Sí, el local dispone de asientos al aire libre, además de mesas en el interior con televisión y WiFi.',
	},
	{
		q: '¿Admiten perros?',
		a: 'Sí, el establecimiento admite perros, así que se puede ir con la mascota.',
	},
	{
		q: '¿Es accesible y se puede reservar?',
		a: 'Está señalado como accesible para sillas de ruedas y acepta reservas por teléfono, algo útil para grupos y para las comidas de empresa o celebraciones.',
	},
];

const description =
	'Bar cafetería y tapería en Cruz de Humilladero (Málaga): desayunos desde las 8:00, tapas con la bebida, comidas de mediodía, calamares fritos caseros y terraza. En la avenida Herrera Oria, 1. Teléfono 952 27 56 66.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 952 27 56 66',
	image: [
		`${business.site}${photos.hero.src}`,
		`${business.site}${photos.foto1.src}`,
		`${business.site}${photos.foto2.src}`,
		`${business.site}${photos.foto3.src}`,
	],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo, tarjeta de crédito',
	servesCuisine: ['Cocina española', 'Tapas', 'Mediterránea'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [instagramUrl, facebookUrl],
	acceptsReservations: 'True',
	petsAllowed: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:00',
			closes: '17:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '12:30',
			closes: '17:30',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos al aire libre', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'WiFi gratuito', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Televisión', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Comida para llevar', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.6,
		reviewCount: 259,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1d2b2a" />
		<meta
			name="description"
			content="El Terrazeo del Guinda: desayunos, tapas y comidas de mediodía en Cruz de Humilladero (Málaga), con terraza y calamares fritos caseros. Av. Herrera Oria, 1."
		/>
		<meta
			name="keywords"
			content="El Terrazeo del Guinda, bar Cruz de Humilladero, terraza Málaga, desayunos Málaga, tapas con la bebida Málaga, tapería Málaga, calamares fritos Málaga, Av. Herrera Oria, Jardines de Picasso, bar para comer Málaga"
		/>
		<meta name="author" content="El Terrazeo del Guinda" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>El Terrazeo del Guinda | Desayunos y tapas en Cruz de Humilladero</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="El Terrazeo del Guinda · Tapas, desayunos y terraza en Málaga" />
		<meta
			property="og:description"
			content="Desayunos desde las 8:00, tapas que llegan con la bebida y comidas de mediodía. Av. del Obispo Ángel Herrera Oria, 1 (Málaga)."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="El Terrazeo del Guinda, bar con terraza en Málaga" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="El Terrazeo del Guinda · Tapas y terraza en Málaga" />
		<meta
			name="twitter:description"
			content="Desayunos, tapas con la bebida y comidas de mediodía en la avenida Herrera Oria, 1 (Málaga)."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7179042;-4.438198" />
		<meta name="ICBM" content="36.7179042, -4.438198" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="El Terrazeo del Guinda, inicio">
				<span class="brand-mark" aria-hidden="true">G</span>
				<span class="brand-name">El Terrazeo del Guinda <small>Málaga · Cruz de Humilladero</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">Qué pedir</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>952 27 56 66</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Cruz de Humilladero · Málaga</p>
					<h1 id="hero-title">Terraza, tapas<br />y café hasta<br /><em>media tarde.</em></h1>
					<p class="hero-lede">
						Bar cafetería y tapería en la avenida Herrera Oria, junto a los Jardines de Picasso.
						Desayunos desde las 8:00, comidas de mediodía y esa tapa que llega con la bebida y que
						todos recuerdan.
					</p>
					<div class="hero-actions">
						<a class="button button-clay" href={phoneHref}>Llamar 952 27 56 66</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,6</b> en Google</li>
						<li>Desayunos desde las 8:00</li>
						<li>Tapa con la bebida</li>
						<li>Terraza exterior</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						alt="Fotografía de El Terrazeo del Guinda publicada en su ficha de Google Maps (Málaga)"
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver la galería ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Servicios del local">
				<ul class="chips">
					{servicios.map((servicio) => <li>{servicio}</li>)}
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> Un bar de los de siempre</p>
				<div class="about-grid">
					<h2>Comida abundante,<br />precio de barrio<br /><em>y terraza.</em></h2>
					<div class="about-copy">
						<p>
							El Terrazeo del Guinda está en la avenida del Obispo Ángel Herrera Oria, 1, en Cruz de
							Humilladero y a un paso de los Jardines de Picasso. Es cafetería, tapería, restaurante y
							sitio de copas: se desayuna, se come y se echa la mañana sin cambiar de mesa.
						</p>
						<p>
							Lo que más se repite en las reseñas públicas es que la comida es abundante y casera, que
							los precios son razonables y que las tapas que acompañan a la bebida son de las que se
							recuerdan. El equipo, familiar y atento, es otra de las cosas que destacan los clientes.
						</p>
						<p class="about-note">
							Ojo con el horario: abre de lunes a viernes de 8:00 a 17:30 y los sábados desde las
							12:30. Los domingos descansa. Si vienes en festivo, llama antes para no encontrarte la
							persiana bajada.
						</p>
						<div class="about-links">
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">
								Instagram del bar <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href={reviewsUrl} target="_blank" rel="noreferrer">
								Leer reseñas en Google <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="menu section-pad" id="carta">
				<div class="menu-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Desayuno, tapeo y mediodía</p>
						<h2>Qué se come<br />en <em>el Guinda.</em></h2>
					</div>
					<p>
						La carta es de bar de barrio y cambia según el día. Estos son los puntos que aparecen en la
						información pública del local y en las reseñas de sus clientes. No se publican precios:
						consulta el menú del día directamente.
					</p>
				</div>
				<div class="cards">
					{
						carta.map((bloque) => (
							<article class="card">
								<h3>{bloque.title}</h3>
								<p>{bloque.text}</p>
							</article>
						))
					}
				</div>
				<p class="menu-note">
					Para grupos, comidas de empresa y celebraciones conviene reservar con antelación.
				</p>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>El bar, la barra<br /><em>y la terraza.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden del perfil y de la ficha de Google Maps de El Terrazeo del
							Guinda. En la ficha tienes la galería completa y las reseñas actualizadas.
						</p>
						<a class="button button-clay" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver todo en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						galeria.map((foto, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={foto.src}
									alt={foto.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="avif"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Imágenes alojadas en esta web procedentes de la ficha de Google Maps del establecimiento. Si
					eres el titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow dark"><span aria-hidden="true"></span> Av. del Obispo Ángel Herrera Oria, 1</p>
					<h2>Nos vemos<br /><em>en Cruz de Humilladero.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.district}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr><th scope="row">Lunes a viernes</th><td>8:00 – 17:30</td></tr>
							<tr><th scope="row">Sábado</th><td>12:30 – 17:30</td></tr>
							<tr><th scope="row">Domingo</th><td>Cerrado</td></tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario orientativo según las fichas públicas del local (Google Maps y guías
						gastronómicas). En festivos y puentes, mejor llamar antes.
					</p>

					<div class="visit-links">
						<a class="button button-clay" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-outline" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 {business.phone}</a>
					<p class="reserve-note">
						Reservas por teléfono, también para grupos y comidas de empresa.
					</p>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de El Terrazeo del Guinda en la avenida Herrera Oria, 1, Cruz de Humilladero, Málaga"
						src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> El Terrazeo del Guinda
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">G</span>
				<p>
					El Terrazeo del Guinda
					<small>{business.street} · {business.postalCode} {business.city}</small>
				</p>
			</div>
			<nav aria-label="Enlaces del local">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={reviewsUrl} target="_blank" rel="noreferrer">Reseñas ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} El Terrazeo del Guinda · Málaga. Fotografías procedentes de la ficha
				del establecimiento en Google Maps.
