---
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	facebookPhotosUrl,
	facebookUrl,
	faqSchema,
	faqs,
	mapEmbedUrl,
	mapsPhotosUrl,
	mapsUrl,
	openingHours,
	paginasAmarillasUrl,
	phoneHref,
	restaurantSchema,
	specialties,
} from '../lib/business';

const title = 'Restaurante Hermanos Plazuelo | Menú del día en el polígono Amargacena, Córdoba';
const description =
	'Restaurante Hermanos Plazuelo en Córdoba: menú del día casero, desayunos desde las 6:00, guisos de cuchara y carnes a la brasa en Av. Amargacena, 7 (polígono Torrecilla-Amargacena). Terraza y comida para llevar. Reservas: 957 20 49 93.';
const keywords =
	'Restaurante Hermanos Plazuelo, Hermanos Plazuelo Córdoba, menú del día Córdoba, comer en polígono Amargacena, bar restaurante Torrecilla Córdoba, cocina casera Córdoba, desayunos Córdoba polígono, berenjenas con miel, carrillada, Avenida Amargacena 7 Córdoba, comida para llevar Córdoba';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#2f4a3c" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración original de un plato y cubiertos para Restaurante Hermanos Plazuelo; no es una fotografía del establecimiento" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante Hermanos Plazuelo, inicio">
				<span class="brand-mark" aria-hidden="true">HP</span>
				<span class="brand-copy">Hnos. Plazuelo <small>Restaurante · Córdoba</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">La carta</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 957 20 49 93</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Polígono Amargacena · Córdoba</p>
					<h1 id="hero-title">Menú del día<br /><em>y plato lleno.</em></h1>
					<p class="hero-intro">Restaurante Hermanos Plazuelo es la casa de comidas del polígono Amargacena: desayunos desde las seis de la mañana, menú del día casero, guisos de cuchara y carnes a la brasa, con raciones que llenan.</p>
					<div class="hero-actions">
						<a class="button button-amber" href={phoneHref}>Reservar por teléfono <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Nos encontrarás en</small><address>{business.streetAddress}<br />{business.postalCode} · Córdoba</address></div>
						<div><small>Reservas</small><a href={phoneHref}>{business.phone}</a><br /><a href={mapsUrl} target="_blank" rel="noreferrer">Ficha en Google Maps ↗</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración original de un plato y cubiertos sobre una mesa; no es una fotografía del establecimiento">
					<span class="art-tile" aria-hidden="true"></span>
					<div class="plate" aria-hidden="true"><span></span><span></span><span></span></div>
					<div class="cutlery" aria-hidden="true"><i></i><i></i></div>
					<div class="menu-tag" aria-hidden="true"><small>Hoy en la pizarra</small><strong>Menú del día</strong><span>Primero · segundo · postre</span></div>
					<div class="art-caption"><strong>Hnos. Plazuelo</strong>Casa de comidas desde 1992</div>
				</div>
			</section>

			<div class="promise" aria-label="Información de Restaurante Hermanos Plazuelo">
				<span>Menú del día casero</span><span>Desayunos desde las 6:00</span><span>Terraza</span><span>Comida para llevar</span>
			</div>

			<section class="section intro" id="casa" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Una casa de comidas de polígono</p>
					<h2 id="intro-title">Cocina casera,<br /><em>precio de barrio.</em></h2>
				</div>
				<div class="intro-copy">
					<p>En pleno polígono industrial de Amargacena-Torrecilla, al sur de Córdoba, Restaurante Hermanos Plazuelo lleva años siendo el comedor de confianza de trabajadores, transportistas y vecinos. Abre de madrugada para el desayuno y sigue a pleno rendimiento a la hora del almuerzo.</p>
					<p>La familia Plazuelo mantiene la cocina de siempre: producto de mercado, guisos de cuchara, carnes a la brasa y un menú del día que cambia a diario. El local es amplio, limpio y climatizado, con terraza y salón para grupos, además de comida para llevar.</p>
					<p class="source-note">La información de esta página procede de la ficha de Google Maps, de la página de Facebook del negocio y de directorios gastronómicos y turísticos. La carta y los horarios pueden cambiar: confirma antes de tu visita.</p>
				</div>
			</section>

			<section class="section carta" id="carta" aria-labelledby="carta-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Cocina casera española y cordobesa</p>
						<h2 id="carta-title">Platos que<br /><em>se repiten.</em></h2>
					</div>
					<p>Una selección orientativa de los platos más mencionados por la clientela en reseñas y fuentes gastronómicas. No sustituye la carta vigente.</p>
				</div>
				<div class="carta-grid">
					{specialties.map((dish, index) => (
						<article class="carta-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<div class="carta-extra">
					<p><strong>Desayunos:</strong> la jornada arranca a las 6:00 con tostadas con jamón, bocadillos y pinchos de tortilla, muy elogiados por la clientela.</p>
					<p><strong>Grupos y eventos:</strong> salón privado, menús para grupos, banquetes y wifi gratuito para comidas de empresa.</p>
					<p class="menu-note">Consulta el menú del día, la disponibilidad y los alérgenos con el restaurante. <a href={phoneHref}>Llama al 957 20 49 93</a>.</p>
				</div>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<div class="gallery-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Imágenes del restaurante</p>
						<h2 id="gallery-title">Hermanos Plazuelo,<br /><em>en fotos.</em></h2>
					</div>
					<p>Consulta fotos reales del local, del menú y de los platos en la ficha de Google Maps y en el álbum del negocio en Facebook.</p>
				</div>
				<div class="gallery-grid">
					<a class="photo-card" href={mapsPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Restaurante Hermanos Plazuelo en Google Maps">
						<span class="photo-label">Fotos de la ficha</span><span class="photo-title">Google Maps <span aria-hidden="true">↗</span></span>
					</a>
					<a class="photo-card alt" href={facebookPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Bar Restaurante Hermanos Plazuelo en Facebook">
						<span class="photo-label">Álbum del negocio</span><span class="photo-title">Facebook <span aria-hidden="true">↗</span></span>
					</a>
					<a class="photo-card alt2" href={paginasAmarillasUrl} target="_blank" rel="noreferrer" aria-label="Ver la ficha de Hermanos Plazuelo en Páginas Amarillas">
						<span class="photo-label">Ficha y servicios</span><span class="photo-title">Páginas Amarillas <span aria-hidden="true">↗</span></span>
					</a>
				</div>
				<p class="gallery-note">El enlace de Google Maps identifica la ficha, pero no expone URLs directas a los archivos de imagen, por lo que las fotos se consultan en las galerías enlazadas. Las ilustraciones de esta web son gráficos originales, no fotografías del establecimiento.</p>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14013 · Distrito Sur, Córdoba</p>
					<h2 id="visit-title">Ven a comer<br /><em>al polígono.</em></h2>
					<address>{business.streetAddress}<br />{business.postalCode} {business.locality}<br />{business.province}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Reservas y consultas</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">✉</span><div><small>Correo</small><a href={`mailto:${business.email}`}>{business.email}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Ubicación</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Redes sociales</small><a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar y reservar</a>
					</div>
					<p class="hours-note">Los horarios pueden variar en festivos y según la jornada. Llama antes de desplazarte para confirmarlo.</p>
				</div>
				<div class="visit-side">
					<div class="hours-card">
						<h3>Horario orientativo</h3>
						<ul>
							{openingHours.map((slot) => (
								<li><span>{slot.day}</span><strong>{slot.hours}</strong></li>
							))}
						</ul>
					</div>
					<div class="map-card">
						<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Restaurante Hermanos Plazuelo en Avenida Amargacena, Córdoba" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-label"><div><strong>Hermanos Plazuelo</strong><small>Av. Amargacena, 7 · Córdoba</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
			<Galeria nombre="Restaurante Hermanos Plazuelo" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="Restaurante Hermanos Plazuelo, volver al inicio">
				<span class="brand-mark" aria-hidden="true">HP</span><span class="brand-copy">Hnos. Plazuelo <small>Restaurante · Amargacena</small></span>
			</a>
			<nav class="footer-nav" aria-label="Redes y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={paginasAmarillasUrl} target="_blank" rel="noreferrer">Páginas Amarillas ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Restaurante Hermanos Plazuelo · Córdoba. Consulta horarios, carta y alérgenos directamente con el establecimiento.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>
		<a class="mobile-call" href={phoneHref}>Reservar en Hermanos Plazuelo <span>957 20 49 93</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>


