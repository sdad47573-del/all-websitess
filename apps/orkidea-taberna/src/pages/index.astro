---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import pintxo from '../assets/fotos/orkidea-taberna-apaisada-01.jpg';
import fachada from '../assets/fotos/orkidea-taberna-panoramica-02.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Orkidea Taberna, taberna y restaurante en Aizkorri Kalea, 4, Lezo (Gipuzkoa). Pintxos, carne guisada y buen ambiente. Abre todos los días desde las 8:30. Ficha y cómo llegar, en Google Maps.';

const galeria = [
	{
		src: pintxo,
		alt: 'Un pintxo de tortilla con pan y una caña de cerveza sobre una mesa blanca al sol',
	},
	{
		src: fachada,
		alt: 'Fachada de Orkidea Taberna en Aizkorri Kalea, con el rótulo negro sobre la pared de ladrillo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#orkidea`,
	name: BUSINESS.name,
	alternateName: ['Orkidea', 'Orkidea Lezo', 'Orkidea Taberna Lezo'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	currenciesAccepted: 'EUR',
	servesCuisine: ['Vasca', 'Tradicional', 'Pinchos'],
	areaServed: [
		{ '@type': 'City', name: 'Lezo' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Sunday'],
			opens: '10:00',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday'],
			opens: '08:30',
			closes: '22:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '09:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody:
				'Buenos pintxos....carne guisada espectacular.....y muy buen ambiente',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Todo muy bien, ambiente total camareros 100 % lo recomiendo.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Muy agradable y un buen trato, para volver.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La barra', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Orkidea Taberna · Taberna en Lezo (Gipuzkoa)';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#3f5a45" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700&family=Gloock&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Orkidea Taberna, taberna Lezo, comer en Lezo, pintxos Lezo, carne guisada Lezo, restaurante Aizkorri Kalea, Orkidea Lezo, taberna Gipuzkoa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Taberna y restaurante en Aizkorri Kalea, 4 (Lezo). Pintxos, carne guisada y buen ambiente, todos los días desde las 8:30. Ficha y cómo llegar en Google Maps."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Pintxo de tortilla y una caña de cerveza en la mesa de Orkidea Taberna"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#3f5a45"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone=""
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lezo, Gipuzkoa"
			preload={[pintxo]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Orkidea"
			subtitle="Taberna · Lezo"
			phone="Cómo llegar"
			phoneHref={MAPS.directions}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Aizkorri Kalea, 4 · Lezo, Gipuzkoa"
				title="La taberna<br /><em>de Aizkorri.</em>"
				lede={`Orkidea Taberna es una taberna de barrio en Aizkorri Kalea, 4, en Lezo (Gipuzkoa). Pintxos, carne guisada y una barra de las de quedarse, con 4,6 sobre 5 en Google. Abre todos los días: lunes, martes y domingo de 10:00 a 21:00, y de miércoles a sábado hasta más tarde. La ficha de Google no publica teléfono, así que el mapa y la ficha son el único canal.`}
				image={pintxo}
				imageAlt="Un pintxo de tortilla con pan y una caña de cerveza sobre una mesa blanca al sol"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> en Google · 42 reseñas' },
					{ label: 'Horario', html: '<b>Todos los días</b> abre la barra' },
					{ label: 'La casa', html: '<b>Pintxos</b> y carne guisada' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Orkidea Taberna" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Pintxos<br /><em>y buen ambiente.</em>"
				paragraphs={[
					'Orkidea Taberna está en Aizkorri Kalea, 4, en Lezo (Gipuzkoa): una taberna de barrio con el rótulo negro en la fachada de ladrillo y una mesa a la calle donde cae el sol de la tarde.',
					'Google la clasifica como restaurante y le da 4,6 sobre 5 con 42 reseñas. Su ficha no incluye descripción del local, carta ni teléfono, así que esta web no inventa platos, precios ni número de contacto.',
					'Sus reseñas hablan de «buenos pintxos» y de una «carne guisada espectacular», pero sobre todo del ambiente: «muy buen ambiente», «ambiente total» y «muy agradable y un buen trato, para volver».',
					'Abre todos los días: lunes, martes y domingo de 10:00 a 21:00; de miércoles a viernes de 8:30 a 22:00; y el sábado de 9:00 a 23:00.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «Buenos pintxos....carne guisada espectacular.....y muy buen ambiente».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La barra"
				title="Pintxos<br /><em>y carne guisada.</em>"
				description="La ficha de Google no publica carta ni precios y el local no tiene web propia. Esto es lo que citan sus reseñas, sin inventar nada más."
				cta={{ label: 'Ver la ficha de Google', href: MAPS.place }}
				groups={MENU}
				note="No hay precios publicados ni teléfono de contacto en la ficha. Para saber qué hay hoy, lo más directo es acercarse a la barra."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Dos fotos<br /><em>de la casa.</em>"
				description="Son las dos fotografías publicadas en el perfil de Orkidea Taberna en Google Maps: el pintxo con la caña en la mesa de la calle y la fachada con el rótulo de la taberna."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a Lezo<br /><em>a la barra.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, `${BUSINESS.regionName}, España`]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: lunes, martes y domingo de 10:00 a 21:00; de miércoles a viernes de 8:30 a 22:00; sábado de 9:00 a 23:00. Abre todos los días."
				mapTitle="Mapa de Orkidea Taberna en Aizkorri Kalea, 4, Lezo (Gipuzkoa)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Orkidea Taberna · Lezo"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				reserveNote="La ficha de Google no publica teléfono ni correo, y el local no tiene web propia: los únicos canales publicados son la ficha de Google Maps y el propio local. La ficha marca acceso para sillas de ruedas."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone=""
			phoneHref={MAPS.directions}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Cómo llegar a Orkidea"
		/>
	</body>
</html>
