---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import rotulo from '../assets/fotos/paladar-cocina-tradicional-panoramica-03.jpg';
import bocadillo from '../assets/fotos/paladar-cocina-tradicional-vista-10-10.jpg';
import guisos from '../assets/fotos/paladar-cocina-tradicional-vista-9-09.jpg';
import pizza from '../assets/fotos/paladar-cocina-tradicional-apaisada-06.jpg';
import polloCurry from '../assets/fotos/paladar-cocina-tradicional-cuadrada-01.jpg';
import churrasco from '../assets/fotos/paladar-cocina-tradicional-cuadrada-08.jpg';
import envase from '../assets/fotos/paladar-cocina-tradicional-apaisada-02.jpg';
import cartel from '../assets/fotos/paladar-cocina-tradicional-vertical-04.jpg';
import marca from '../assets/fotos/paladar-cocina-tradicional-apaisada-05.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Paladar Cocina Tradicional · Comida casera en Alcalá de Guadaíra';
const description =
	'Paladar Cocina Tradicional, comida casera para llevar en Calle Zuloaga, 3, local 1, Alcalá de Guadaíra. Guisos de siempre, bocadillos con pan de Alcalá, pizzas, panadería y repostería. Fotos, horario y teléfono.';

const galeria = [
	{ src: rotulo, alt: 'Rótulo de Paladar Cocina Tradicional en la fachada del local' },
	{ src: bocadillo, alt: 'Bocadillo con pan de Alcalá, la especialidad de Paladar' },
	{ src: pizza, alt: 'Pizza recién hecha con carne picada y queso fundido' },
	{ src: polloCurry, alt: 'Pollo al curry con perejil fresco de Paladar Cocina Tradicional' },
	{ src: envase, alt: 'Ración recién servida en un envase de comida para llevar' },
	{ src: churrasco, alt: 'Churrasco de pollo asado con ajos laminados' },
	{ src: guisos, alt: 'Cartel de guisos caseros de Paladar con la lista de platos' },
	{ src: cartel, alt: 'Cartel de servicios del local: panadería, bocadillos, pizzas y catering' },
	{ src: marca, alt: 'Patrón con el logotipo de Paladar Cocina Tradicional' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Paladar Cocina Tradicional',
	inLanguage: 'es-ES',
	description:
		'Lista de guisos copiada de la cartelería del establecimiento; la ficha no publica precios.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#paladar-cocina-tradicional`,
	name: BUSINESS.name,
	alternateName: ['Paladar Alcalá de Guadaíra', 'Paladar Cocina Tradicional Sevilla'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34622173237',
	priceRange: '€',
	servesCuisine: ['Cocina tradicional', 'Comida casera', 'Comida para llevar', 'Panadería'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Sunday'],
			opens: '09:30',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '09:30',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '18:30',
			closes: '22:30',
		},
	],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Guisos', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..600;1,400..500&family=Nunito+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Paladar Cocina Tradicional, comida casera Alcalá de Guadaíra, comida para llevar Alcalá de Guadaíra, guisos caseros Sevilla, bocadillos pan de Alcalá, catering Alcalá de Guadaíra, Calle Zuloaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Guisos caseros, bocadillos con pan de Alcalá y repostería en Calle Zuloaga, 3. Fotos, horario y teléfono de encargos."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo de Paladar Cocina Tradicional en Alcalá de Guadaíra"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#1d2a44"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Alcalá de Guadaíra"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[churrasco]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Paladar"
			subtitle="Cocina tradicional · Alcalá"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Calle Zuloaga, 3, local 1 · Alcalá de Guadaíra"
				title="La cocina de siempre, <br /><em>para llevar.</em>"
				lede={`Paladar Cocina Tradicional prepara guisos caseros, pollo, verduras y bocadillos con pan de Alcalá para comer en casa. Está en la calle Zuloaga, 3, y la ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				image={churrasco}
				imageAlt="Churrasco de pollo asado con ajos laminados de Paladar"
				primaryCta={{ label: `Encargar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver ficha en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Tipo', html: '<b>Cocina tradicional</b> para llevar' },
					{ label: 'Valoración', html: `<b>${RATING.label}</b> · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>9:30 – 15:30</b> · y noches de martes a sábado' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver fotos y ficha"
				tag="Guisos del día"
			/>

			<LocalChips label="Servicios de Paladar Cocina Tradicional" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un paladar <br /><em>de barrio.</em>"
				paragraphs={[
					'Paladar Cocina Tradicional es un local de comida casera para llevar en la calle Zuloaga, 3, local 1, en Alcalá de Guadaíra. El negocio se presenta en Google como «tu rincón de cocina tradicional para llevar», con «sabores caseros y auténticos platos».',
					'La cartelería del local ordena la oferta en guisos caseros, pollo y verduras: carne con tomate, carrillá en salsa, albóndigas, pollo al curry, churrasco adobado, espinacas con garbanzos o revuelto de setas, entre otros. También anuncia bocadillos con pan de Alcalá como especialidad.',
					'Junto a la comida, el cartel suma panadería, repostería, pizzas y catering. Abre de martes a sábado en dos turnos y los lunes y domingos solo a mediodía; el teléfono de encargos es el 622 17 32 37.',
				]}
				note="La ficha no publica precios ni una carta cerrada con importes. Los platos que aparecen en esta web son los de la cartelería fotografiada del establecimiento; confirma la oferta y el precio al llamar."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotografías', href: '#galeria' },
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<ul class="highlights">
				{
					HIGHLIGHTS.map((item) => (
						<li>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</li>
					))
				}
			</ul>

			<LocalMenu
				eyebrow="La carta del local"
				title="Guisos de cuchara <br /><em>y pan de Alcalá.</em>"
				description="La ficha no tiene carta publicada, pero el local sí expone su lista de platos. Esta es la que aparece en su cartelería: guisos caseros, pollo, verduras y bocadillos."
				cta={{ label: `Preguntar el menú de hoy · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. La oferta cambia a diario y algunos platos se acaban: llama al 622 17 32 37 para confirmar el guiso del día, encargar o preguntar por el catering."
			/>

			<LocalGallery
				eyebrow="Fotos del perfil de Google Maps"
				title="El rótulo, la carta <br /><em>y los platos.</em>"
				description="El local en la calle Zuloaga, la lista de guisos de su cartelería y algunos de los platos que aparecen en las fotografías públicas del establecimiento."
				images={galeria}
				cta={{ label: 'Abrir la ficha en Google Maps', href: MAPS.place }}
				note="Imágenes descargadas del perfil público de Paladar Cocina Tradicional en Google Maps y servidas desde esta página."
			/>

			<section class="notas" aria-labelledby="notas-title">
				<div class="wrap notas-grid">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="notas-title">Lo que dicen <em>las reseñas.</em></h2>
						<p class="notas-score">
							<strong>{RATING.label}</strong>
							<span>
								<b>★★★★★</b>
								{RATING.count} reseñas<br />en Google
							</span>
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer reseñas en Google ↗
						</a>
					</div>

					<div class="notas-copy">
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>{resena.texto}</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Opinión en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<p class="notas-foot">
							La valoración y el número de reseñas corresponden a la ficha consultada en octubre
							de 2026 y pueden variar. <a href={MAPS.reviews} target="_blank" rel="noreferrer"
								>Consulta las opiniones actualizadas en Google ↗</a
							>.
						</p>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la calle <br /><em>Zuloaga.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Sevilla']}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de Paladar Cocina Tradicional en Calle Zuloaga, 3, Alcalá de Guadaíra"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Zuloaga, 3 · Alcalá de Guadaíra"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Los pedidos se atienden por teléfono en el 622 17 32 37. Pregunta por el menú del día, por el catering y por las condiciones de recogida antes de acercarte."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma horario, platos y precios con el establecimiento."
			ctaLabel="Encargar en Paladar"
			navAriaLabel="Enlaces de Paladar Cocina Tradicional"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
