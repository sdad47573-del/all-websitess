---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/venta-el-caldero-apaisada-09.jpg';
import foto1 from '../assets/fotos/venta-el-caldero-apaisada-01.jpg';
import foto2 from '../assets/fotos/venta-el-caldero-vertical-02.jpg';
import foto3 from '../assets/fotos/venta-el-caldero-apaisada-04.jpg';
import foto4 from '../assets/fotos/venta-el-caldero-vertical-06.jpg';
import foto5 from '../assets/fotos/venta-el-caldero-panoramica-05.jpg';

const business = {
	name: 'Venta El Caldero',
	short: 'El Caldero',
	street: 'A-66, Km 495',
	city: 'Malpartida de Plasencia',
	region: 'Extremadura',
	province: 'Cáceres',
	postalCode: '10680',
	phone: '+34 927 45 33 98',
	latitude: 39.8830958,
	longitude: -6.2760118,
	site: 'https://venta-el-caldero.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Venta+El+Caldero/@39.8830958,-6.2760118,17z/data=!3m1!4b1!4m6!3m5!1s0xd3e0377654b8475:0x13af4d6d15d17ec7!8m2!3d39.8830958!4d-6.2760118!16s%2Fg%2F11xfpqrr1?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34927453398';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'Para empezar el día',
		title: 'Tostadas con jamón y aceite',
		text: 'La tostada con jamón y aceite es de lo primero que citan quienes paran a desayunar. El bocadillo, según las reseñas, viene enorme.',
	},
	{
		kicker: 'De la carta',
		title: 'Menús y platos combinados',
		text: 'Menús variados, platos combinados y raciones: la comida de carretera de toda la vida, servida a cualquier hora del día.',
	},
	{
		kicker: 'Para la ruta',
		title: 'Bocadillos y tapas',
		text: 'Bocadillos, tapas y raciones para comer sentado o de pie antes de volver a la A-66. Hay donde elegir y el servicio es rápido.',
	},
	{
		kicker: 'La tienda',
		title: 'Jamones y productos locales',
		text: 'La venta tiene tienda de delicatessen y de jamones: la parada para llevarse producto de la zona a casa además de repostar.',
	},
	{
		kicker: 'Repostar',
		title: 'Gasolinera y descanso',
		text: 'Gasolinera y área de descanso en el mismo espacio, para estirar las piernas, repostar y seguir camino sin desviarse.',
	},
	{
		kicker: 'A cualquier hora',
		title: 'Cafetería abierta siempre',
		text: 'Café, bollería y bocadillos a las tantas de la madrugada: una venta de carretera pensada para quien viaja de noche.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de Venta El Caldero publicada en su ficha de Google Maps (A-66, km 495)' },
	{ src: photos.foto2, alt: 'Imagen de Venta El Caldero en Malpartida de Plasencia tomada de su galería de Google Maps' },
	{ src: photos.foto3, alt: 'Fotografía de la venta en la A-66, en el término de Malpartida de Plasencia' },
	{ src: photos.foto4, alt: 'Imagen de Venta El Caldero subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Vista de Venta El Caldero según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está Venta El Caldero?',
		a: 'En el kilómetro 495 de la A-66, 10680 Malpartida de Plasencia (Cáceres). Coordenadas 39.8830958, -6.2760118.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Según su ficha de Google Maps, abre 24 horas todos los días de la semana. Si vienes en festivo o quieres confirmar un servicio, llama antes al 927 45 33 98.',
	},
	{
		q: '¿Se puede repostar?',
		a: 'Sí. La ficha la incluye como gasolinera y área de descanso, así que se puede parar a repostar y descansar en la misma venta, junto a la A-66.',
	},
	{
		q: '¿Tiene tienda de productos locales?',
		a: 'Sí: aparece como tienda de delicatessen y tienda de jamones, con productos de la zona para llevar. Es una parada habitual para comprar jamón de camino.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Tapas, platos combinados, bocadillos, raciones y menús variados. Las reseñas destacan la tostada con jamón y aceite y el tamaño de los bocadillos.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso, aparcamiento, aseo y asientos adaptados para sillas de ruedas. Para necesidades concretas, llama antes de venir.',
	},
];

const images = [
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'Venta El Caldero en la A-66 (km 495), Malpartida de Plasencia: tapas, platos combinados, bocadillos y tienda de jamones. Abierta 24 horas todos los días.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: business.phone,
	image: images,
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Tapas', 'Platos combinados', 'Cocina de carretera'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '00:00',
			closes: '23:59',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Gasolinera', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Tienda de jamones', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Abierto 24 horas', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4,
		reviewCount: 16976,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1c1a16" />
		<meta
			name="description"
			content="Venta El Caldero en la A-66 (km 495), Malpartida de Plasencia: tapas, platos combinados, bocadillos y tienda de jamones. Abierta 24 horas todos los días."
		/>
		<meta
			name="keywords"
			content="Venta El Caldero, venta A-66 km 495, restaurante carretera Malpartida de Plasencia, bocadillos A-66, tienda de jamones Cáceres, gasolinera A-66, abierto 24 horas"
		/>
		<meta name="author" content="Venta El Caldero" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Venta El Caldero | A-66 km 495 · Malpartida de Plasencia</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Venta El Caldero · La parada de la A-66, 24 horas" />
		<meta
			property="og:description"
			content="Tapas, platos combinados, bocadillos y tienda de jamones en el km 495 de la A-66, Malpartida de Plasencia. Abierta 24 horas."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="Venta El Caldero, bar restaurante de carretera en la A-66" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Venta El Caldero · La parada de la A-66, 24 horas" />
		<meta
			name="twitter:description"
			content="Tapas, platos combinados y bocadillos en el km 495 de la A-66 (Malpartida de Plasencia), con tienda de jamones."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Malpartida de Plasencia" />
		<meta name="geo.position" content="39.8830958;-6.2760118" />
		<meta name="ICBM" content="39.8830958, -6.2760118" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Venta El Caldero, inicio">
				<span class="brand-mark" aria-hidden="true">C</span>
				<span class="brand-name">Venta El Caldero <small>A-66 · Km 495</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#venta">La venta</a>
				<a href="#especialidades">Qué hay</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>927 45 33 98</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> A-66 · Km 495 · Malpartida de Plasencia</p>
					<h1 id="hero-title">La parada de la A-66<br />que no cierra<br /><em>nunca.</em></h1>
					<p class="hero-lede">
						Venta El Caldero es bar restaurante, cafetería, gasolinera y tienda de productos locales en el
						kilómetro 495 de la A-66. Tapas, platos combinados y bocadillos a cualquier hora, con jamones de la
						tierra para llevar.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 927 45 33 98</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,0</b> en Google (16.976 reseñas)</li>
						<li>24 horas</li>
						<li>Gasolinera</li>
						<li>Tienda de jamones</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						alt="Venta El Caldero, bar restaurante de carretera en la A-66 (Malpartida de Plasencia)"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,0</b><span>Google</span></div>
					<div><b>16.976</b><span>Reseñas</span></div>
					<div><b>24/24</b><span>Horas</span></div>
				</div>
				<ul class="services">
					<li>Tapas y raciones</li>
					<li>Platos combinados</li>
					<li>Bocadillos</li>
					<li>Gasolinera</li>
					<li>Tienda de jamones</li>
					<li>Local accesible</li>
				</ul>
			</section>

			<section class="about section-pad" id="venta">
				<p class="section-label"><span aria-hidden="true"></span> Una venta en la A-66</p>
				<div class="about-grid">
					<h2>Cocina de carretera<br />abierta a cualquier<br /><em>hora.</em></h2>
					<div class="about-copy">
						<p>
							Venta El Caldero está en el kilómetro 495 de la A-66, en Malpartida de Plasencia (Cáceres). Es
							bar restaurante, cafetería, gasolinera y tienda de productos locales: todo lo que hace falta para
							una parada de ruta, sin salir del mismo sitio.
						</p>
						<p>
							La ficha de Google Maps la describe como «tapas, platos combinados y cocina española en un bar
							restaurante de carretera con tienda de productos locales». Sus clientes destacan las tostadas
							con jamón y aceite, el tamaño de los bocadillos y unos menús variados con platos combinados y
							raciones.
						</p>
						<p class="about-note">
							Según Google Maps, abre las 24 horas todos los días. Si vienes en festivo o quieres confirmar la
							gasolinera o la tienda, llama antes al 927 45 33 98.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="especialidades">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Lo que hay en la venta</p>
						<h2>Comer, repostar<br />y seguir <em>camino.</em></h2>
					</div>
					<p>
						Tapas, platos combinados, bocadillos y menús, más gasolinera y tienda de jamones. Es lo que
						cuenta la ficha del local y lo que repiten las reseñas de quien para en la A-66.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>La venta<br /><em>en imágenes.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Venta El Caldero. En la ficha
							encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="avif"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres el
					titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> A-66, Km 495</p>
					<h2>Para en<br /><em>El Caldero.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes a domingo</th>
								<td>24 horas</td>
							</tr>
							<tr>
								<th scope="row">Cocina</th>
								<td>Todo el día</td>
							</tr>
							<tr>
								<th scope="row">Gasolinera y tienda</th>
								<td>En el mismo espacio</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, llama antes de venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar 927 45 33 98</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 927 45 33 98</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Venta El Caldero en el kilómetro 495 de la A-66, Malpartida de Plasencia"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Venta El Caldero · A-66
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>parar.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">C</span>
				<p>Venta El Caldero<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Venta El Caldero · Malpartida de Plasencia. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>

			<p class="footer-credit">
				Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
				<a href="https://sur-digital.vercel.app/" rel="noopener">sur-digital.vercel.app</a>
			</p>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar a la venta <span>927 45 33 98</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
