---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import carta from '../assets/fotos/cafeteria-san-jose-vertical-10.jpg';
import bocadilloTortilla from '../assets/fotos/cafeteria-san-jose-apaisada-02.jpg';
import bocadilloJamon from '../assets/fotos/cafeteria-san-jose-apaisada-05.jpg';
import champinones from '../assets/fotos/cafeteria-san-jose-apaisada-08.jpg';
import calamares from '../assets/fotos/cafeteria-san-jose-vertical-01.jpg';
import chopitos from '../assets/fotos/cafeteria-san-jose-vertical-03.jpg';
import tostadaCarne from '../assets/fotos/cafeteria-san-jose-vertical-04.jpg';
import carne from '../assets/fotos/cafeteria-san-jose-vertical-06.jpg';
import club from '../assets/fotos/cafeteria-san-jose-vertical-07.jpg';
import tostadaGulas from '../assets/fotos/cafeteria-san-jose-vertical-09.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, RATING, SERVICIOS } from '../data/site';

const title = 'Cafetería San José · desayunos, tapas y raciones en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: carta,
		alt: 'Mesa de la cafetería con un plato de tortilla, un vaso de refresco de cola y la carta de raciones abierta sobre la mesa',
	},
	{
		src: calamares,
		alt: 'Ración de calamares a la andaluza rebozados y fritos, con un gajo de limón, en un plato blanco',
	},
	{
		src: chopitos,
		alt: 'Ración de chopitos fritos, con las patas y las aletas crujientes, en un plato de rayas azules y limón',
	},
	{
		src: champinones,
		alt: 'Champiñones a la plancha con perejil, un cuenco de aceitunas verdes y tomate con cebolleta en un plato cuadrado',
	},
	{
		src: tostadaGulas,
		alt: 'Tostada de pan con gulas salteadas y jamón en dados por encima, en un plato de rayas azules',
	},
	{
		src: tostadaCarne,
		alt: 'Tostada de pan con lonchas de carne y cebolla caramelizada por encima, en un plato de dibujo geométrico',
	},
	{
		src: club,
		alt: 'Sándwich club de tres pisos con lechuga, tomate, huevo y atún, con un sobre de mostaza al lado',
	},
	{
		src: carne,
		alt: 'Plato de carne de cerdo frita en trozos pequeños, dorada y crujiente, servido en un plato de rayas azules',
	},
	{
		src: bocadilloTortilla,
		alt: 'Bocadillo de tortilla de patata en pan de barra, abierto sobre un plato de rayas azules',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'CafeOrCoffeeShop',
	'@id': `${BUSINESS.siteUrl}/#cafeteria-san-jose`,
	name: BUSINESS.name,
	alternateName: ['Cafetería San José Ciudad Real', 'Bar San José Ciudad Real', 'San José Carlos Eraña'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Tapas', 'Desayunos', 'Raciones caseras', 'Cocina manchega'],
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.channel },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:45',
			closes: '23:59',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17130f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Cafetería San José Ciudad Real, bar de tapas Ciudad Real, desayunos Ciudad Real, Paseo Carlos Eraña 4, raciones Ciudad Real, café Ciudad Real centro, tapas 13004, bar San José"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Desayunos, tapas y raciones en el Paseo Carlos Eraña, 4, de Ciudad Real. De lunes a viernes, de 7:45 a 24:00. 4,4 sobre 5 con 612 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bocadillo de jamón de la Cafetería San José servido en un plato de rayas azules"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#17130f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[bocadilloJamon]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Desayunos · tapas · raciones"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Desayunos, tapas <br /><em>y raciones.</em>"
				lede={`La Cafetería San José está en el Paseo Carlos Eraña, 4, de Ciudad Real. Abre de lunes a viernes a las 7:45 y cierra a medianoche: café y tostadas por la mañana, tapas al mediodía y raciones caseras a la hora de la cerveza. La ficha de Google le da 4,4 sobre 5 con 612 reseñas.`}
				image={bocadilloJamon}
				imageAlt="Bocadillo de jamón con tomate abierto en dos mitades sobre un plato de rayas azules"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4</b> en Google · 612 reseñas' },
					{
						label: 'Horario',
						html: '<b>7:45–24:00</b><br />Lunes a viernes · sábado y domingo cerrado',
					},
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> raciones y consultas` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de la Cafetería San José" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="La cafetería <br /><em>de barrio.</em>"
				paragraphs={[
					'La Cafetería San José ocupa el número 4 del Paseo Carlos Eraña, en Ciudad Real: un local de barra larga, mesa de mármol y sillas de madera al que se entra a por el café de primera hora y se queda uno a la ración de mediodía. Google lo clasifica como bar de tapas y cafetería.',
					'La propia casa se presenta así en su ficha: «En Cafetería San José encontrarás un ambiente familiar y acogedor, ideal para desayunar, tomar un café o disfrutar de unas tapas y raciones caseras. Destacamos por nuestro trato cercano, servicio rápido y una excelente relación calidad-precio».',
					'Las fotos del perfil enseñan lo que sale de la barra: bocadillos de tortilla y de jamón, sándwiches de tres pisos, tostadas de gulas y de carne con cebolla, tortilla con el café de la mañana, champiñones a la plancha, calamares y chopitos fritos, y platos de carne dorada para picar entre varios.',
					'El horario es de lunes a viernes, de 7:45 a 24:00, con sábado y domingo cerrados. La ficha marca acceso, aparcamiento, aseo y asientos adaptados para sillas de ruedas, y no publica web propia: el teléfono y el mostrador son el canal de contacto.',
				]}
				note="Los datos salen de la ficha pública de Google Maps, de la descripción que publica el propio establecimiento, de las fotos de su perfil y de la foto de la carta. Si algo cambia, manda lo que digan en el mostrador o por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver la cafetería en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Raciones, barra <br /><em>y desayuno.</em>"
				description="Las raciones son las que lista la carta del local, leída en la foto del perfil. Los bocadillos, sándwiches y tostadas salen de las fotos de la barra: son los que se ven servidos, no una carta cerrada."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="Esta página no publica precios: la foto de la carta está recortada por la derecha y la columna de importes queda a medias, aunque los que se leen van de 10,00 a 15,00 €. La carta cambia con la temporada y el día, así que el precio y la disponibilidad se confirman en el mostrador o en el 926 036 598."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Nueve fotos <br /><em>de la barra.</em>"
				description="Las fotografías del perfil de la Cafetería San José en Google Maps: la mesa con la carta, las raciones fritas, las tostadas, los bocadillos y el sándwich de la casa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven al Paseo <br /><em>Carlos Eraña.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Castilla-La Mancha, España',
				]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: de lunes a viernes, de 7:45 a 24:00. El «24:00» es la medianoche del mismo día; no hay servicio de madrugada. Sábado y domingo figuran cerrados y en festivos puede cambiar: llama antes si vas en día señalado."
				mapTitle="Mapa de la Cafetería San José en el Paseo Carlos Eraña 4, Ciudad Real"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Cafetería San José"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. El local no publica web propia ni sistema de reservas, así que el teléfono es el canal directo para preguntar por el menú, encargar raciones o consultar una mesa."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de la Cafetería San José"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
