---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const business = {
	name: 'Floristería Emilia · El Perchel',
	city: 'Málaga',
	neighborhood: 'El Perchel',
	latitude: 36.7139825,
	longitude: -4.4266595,
	site: 'https://floristeria-emilia-perchel.vercel.app',
};
const mapsUrl =
	'https://www.google.com/maps/place/Florister%C3%ADa+Emilia+El+Perchel/@36.7139825,-4.4266595,17z/data=!3m1!4b1!4m6!3m5!1s0xd72f7a8c863af6d:0xc62b1bc6b50aab2a!8m2!3d36.7139825!4d-4.4266595!16s%2Fg%2F11kk7p6_fs';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const reviewsUrl = 'https://search.google.com/local/reviews?placeid=ChIJHW864ox7cg0RKqsKts';
const services = [
	{
		number: '01',
		title: 'Ramos y flores de temporada',
		text: 'Ramos del día y flores seleccionadas para regalar, acompañar y celebrar.',
	},
	{
		number: '02',
		title: 'Bodas y eventos',
		text: 'Decoración floral para bodas y ocasiones especiales en Málaga.',
	},
	{
		number: '03',
		title: 'Plantas y centros',
		text: 'Planta de interior y centros para dar vida a tu casa o espacio de trabajo.',
	},
	{
		number: '04',
		title: 'Un detalle con intención',
		text: 'Acércate a la floristería y descubre la selección disponible en tienda.',
	},
];
const images = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const manifest = import.meta.glob<{ default: Record<string, { file: string; author?: string }> }>(
	'../assets/fotos/.maps-manifest.json',
	{ eager: true, import: 'default' },
);
const photoCredits = Object.values(manifest)[0] ?? {};
const gallery = Object.entries(images)
	.map(([path, item]) => {
		const filename = path.split('/').at(-1) ?? '';
		const record = Object.values(photoCredits).find((entry) => entry.file === filename);
		return {
			image: item.default,
			filename,
			author: record?.author?.trim() || 'Autoría no indicada en Google Maps',
		};
	})
	.sort((a, b) => a.filename.localeCompare(b.filename));
const heroPhoto = gallery.find(({ filename }) => filename.includes('apaisada')) ?? gallery[0];
const title = 'Floristería Emilia El Perchel | Flores en Málaga';
const description =
	'Floristería Emilia en El Perchel, Málaga. Ramos, flores de temporada, plantas y decoración floral para bodas y eventos. Consulta ubicación y cómo llegar.';
const schema = {
	'@context': 'https://schema.org',
	'@type': 'Florist',
	name: business.name,
	description,
	url: `${business.site}/`,
	image: gallery.slice(0, 4).map(({ image }) => new URL(image.src, business.site).toString()),
	address: {
		'@type': 'PostalAddress',
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		addressCountry: 'ES',
	},
	geo: { '@type': 'GeoCoordinates', latitude: business.latitude, longitude: business.longitude },
	hasMap: mapsUrl,
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#26382d" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image:alt" content={`Fotografías de ${business.name} en Málaga`} />
		{heroPhoto && (
			<meta property="og:image" content={new URL(heroPhoto.image.src, business.site).toString()} />
		)}
		<meta name="twitter:card" content={heroPhoto ? 'summary_large_image' : 'summary'} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Floristería Emilia, inicio">
				<span class="brand-flower" aria-hidden="true">
					✿
				</span>
				<span>
					EMILIA<small>FLORISTERÍA · EL PERCHEL</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#esencia">La floristería</a>
				<a href="#servicios">Servicios</a>
				<a href="#galeria">Galería</a>
			</nav>
			<a class="header-cta" href={directionsUrl} target="_blank" rel="noopener noreferrer">
				Cómo llegar <span aria-hidden="true">↗</span>
			</a>
		</header>
		<main id="contenido">
			<section class="hero" id="inicio">
				<div class="hero-copy">
					<p class="eyebrow">
						<span></span> FLORES PARA DECIRLO TODO
					</p>
					<h1>
						Un detalle que
						<br />
						<em>hace florecer</em>
						<br />
						el día.
					</h1>
					<p class="hero-lede">
						Ramos, flores de temporada y plantas en Floristería Emilia, en el barrio de El Perchel,
						Málaga.
					</p>
					<div class="hero-actions">
						<a
							class="button button-light"
							href={directionsUrl}
							target="_blank"
							rel="noopener noreferrer"
						>
							Ven a visitarnos <span aria-hidden="true">↗</span>
						</a>
						<a class="text-link" href="#galeria">
							Ver fotografías <span aria-hidden="true">↓</span>
						</a>
					</div>
					<div class="hero-location">
						<span aria-hidden="true">⌖</span>
						<span>
							EL PERCHEL<small>MÁLAGA · ANDALUCÍA</small>
						</span>
					</div>
				</div>
				<div class="hero-visual">
					{heroPhoto ? (
						<figure class="hero-photo">
							<Image
								src={heroPhoto.image}
								alt="Floristería Emilia en El Perchel, fotografía publicada en Google Maps"
								widths={[600, 900, 1200]}
								sizes="(min-width: 900px) 48vw, 100vw"
								quality={82}
								loading="eager"
								fetchpriority="high"
							/>
							<figcaption>
								El color de cada estación <span>✿</span>
							</figcaption>
						</figure>
					) : (
						<div class="hero-placeholder">
							<span aria-hidden="true">✿</span>
							<p>
								Flores para
								<br />
								hacerte sonreír.
							</p>
						</div>
					)}
					<div class="hero-stamp" aria-hidden="true">
						<span>FLORES</span>
						<b>✿</b>
						<span>CON CARIÑO</span>
					</div>
				</div>
				<div class="hero-baseline">
					<span>36.71398° N</span>
					<i></i>
					<span>4.42666° O</span>
					<i></i>
					<span>FLORES PARA TODOS LOS DÍAS</span>
				</div>
			</section>
			<section class="intro section-pad" id="esencia">
				<div class="section-kicker">
					<span>01</span>
					<i></i>
					<span>LA BELLEZA DE LO NATURAL</span>
				</div>
				<div class="intro-grid">
					<h2>
						Hay cosas que
						<br />
						se dicen mejor
						<br />
						con <em>flores.</em>
					</h2>
					<div class="intro-copy">
						<p>
							Un ramo puede celebrar, acompañar y convertir un día cualquiera en un recuerdo
							especial. En Floristería Emilia encontrarás inspiración floral para regalar y para
							llenar de vida tus espacios.
						</p>
						<p>
							Estamos en El Perchel, Málaga. Acércate y consulta la selección disponible en tienda.
						</p>
						<a class="inline-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">
							Conoce la floristería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>
			<section class="services" id="servicios">
				<div class="services-head section-pad">
					<div>
						<div class="section-kicker">
							<span>02</span>
							<i></i>
							<span>IDEAS QUE FLORECEN</span>
						</div>
						<h2>
							Un gesto bonito
							<br />
							<em>en cada ocasión.</em>
						</h2>
					</div>
					<p>Flores frescas, plantas y decoración floral para acompañar tus momentos.</p>
				</div>
				<div class="service-grid section-pad">
					{services.map((service) => (
						<article class="service-card">
							<span>{service.number}</span>
							<div>
								<h3>{service.title}</h3>
								<p>{service.text}</p>
							</div>
							<b aria-hidden="true">✳</b>
						</article>
					))}
				</div>
			</section>
			<section class="gallery-section" id="galeria">
				<div class="gallery-head section-pad">
					<div>
						<div class="section-kicker">
							<span>03</span>
							<i></i>
							<span>UN VISTAZO A EMILIA</span>
						</div>
						<h2>
							Flores, formas
							<br />y <em>momentos.</em>
						</h2>
					</div>
					<p>
						Una selección de imágenes publicadas en la ficha de Floristería Emilia en Google Maps.
					</p>
				</div>
				{gallery.length ? (
					<div class="gallery-grid">
						{gallery.map(({ image, author }, index) => (
							<figure class={`gallery-item gallery-item-${index % 4}`}>
								<Image
									src={image}
									alt={`Fotografía ${index + 1} de Floristería Emilia en Málaga, publicada en Google Maps`}
									widths={[360, 600, 900]}
									sizes="(min-width: 1100px) 30vw, (min-width: 700px) 46vw, 92vw"
									quality={78}
									loading="lazy"
								/>
								<figcaption>
									<span>FLORISTERÍA EMILIA</span>
									<small>{author}</small>
								</figcaption>
							</figure>
						))}
					</div>
				) : (
					<div class="gallery-empty section-pad">
						<span aria-hidden="true">✿</span>
						<p>Visita la ficha para descubrir las fotografías de la floristería.</p>
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							Abrir ficha en Google Maps ↗
						</a>
					</div>
				)}
				<p class="gallery-credit">
					Fotografías de la ficha pública de Google Maps ·{' '}
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ver ficha completa ↗
					</a>
				</p>
			</section>
			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<div class="section-kicker">
						<span>04</span>
						<i></i>
						<span>TE ESPERAMOS</span>
					</div>
					<h2>
						Nos vemos
						<br />
						<em>entre flores.</em>
					</h2>
					<p>
						Encuentra Floristería Emilia en El Perchel, Málaga. Consulta el mapa y las indicaciones
						para llegar.
					</p>
					<a
						class="button button-dark"
						href={directionsUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cómo llegar <span aria-hidden="true">↗</span>
					</a>
					<a class="review-link" href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Leer opiniones en Google <span aria-hidden="true">↗</span>
					</a>
				</div>
				<div class="map-card">
					<iframe
						title="Mapa de Floristería Emilia en El Perchel, Málaga"
						src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
					<span class="map-tag">EL PERCHEL · MÁLAGA</span>
				</div>
			</section>
		</main>
		<footer>
			<a class="brand footer-brand" href="#inicio">
				<span class="brand-flower" aria-hidden="true">
					✿
				</span>
				<span>
					EMILIA<small>FLORISTERÍA · EL PERCHEL</small>
				</span>
			</a>
			<p>Flores para decirlo todo.</p>
			<span>© {new Date().getFullYear()} Floristería Emilia</span>
		</footer>
	</body>
</html>
