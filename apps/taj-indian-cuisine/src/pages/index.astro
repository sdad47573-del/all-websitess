---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import caris from '../assets/fotos/taj-indian-cuisine-apaisada-03.jpg';
import sala from '../assets/fotos/taj-indian-cuisine-apaisada-05.jpg';
import fachada from '../assets/fotos/taj-indian-cuisine-vertical-01.jpg';
import arrozNaan from '../assets/fotos/taj-indian-cuisine-vertical-02.jpg';
import cartaBorrego from '../assets/fotos/taj-indian-cuisine-vertical-04.jpg';
import lassi from '../assets/fotos/taj-indian-cuisine-vertical-06.jpg';
import chanaMasala from '../assets/fotos/taj-indian-cuisine-vertical-07.jpg';
import sobremesaManga from '../assets/fotos/taj-indian-cuisine-vertical-08.jpg';
import mesaTikka from '../assets/fotos/taj-indian-cuisine-vertical-09.jpg';
import pizza from '../assets/fotos/taj-indian-cuisine-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICOS } from '../data/site';

const title = 'Taj Indian Cuisine · Cozinha indiana em Setúbal';
const description = BUSINESS.description;

const galeria = [
	{
		src: sala,
		alt: 'Sala do Taj com garrafeira de madeira na parede, mesas de toalha preta, guardanapos amarelos e a vitrine ao fundo',
	},
	{
		src: fachada,
		alt: 'Fachada do Taj Indian Cuisine com o letreiro «Comida Indiano, Kebab e Pizza», os telefones e fotografias de pratos',
	},
	{
		src: arrozNaan,
		alt: 'Prato de arroz basmati com coentros e um pão naan cortado em triângulos sobre papel',
	},
	{
		src: cartaBorrego,
		alt: 'Página da carta do Taj dedicada ao prato de borrego, com onze caris e os preços de 10,50 a 10,90 euros',
	},
	{
		src: lassi,
		alt: 'Três copos altos de lassi de manga com canecas de cartão e fios de molho na borda',
	},
	{
		src: chanaMasala,
		alt: 'Chana masala de grão-de-bico num karahi de metal, com coentros e gengibre em juliana, e arroz basmati ao lado',
	},
	{
		src: sobremesaManga,
		alt: 'Taça de vidro com manga, waffle partido e molho de frutos vermelhos, com colher e garfo ao lado',
	},
	{
		src: caris,
		alt: 'Frango tikka masala em duas panelas de metal, arroz basmati, naan com coentros e molhos numa mesa escura',
	},
	{
		src: pizza,
		alt: 'Pizza com fiambre, milho, pimento verde e cogumelos, cortada em fatias',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#taj`,
	name: BUSINESS.name,
	alternateName: ['Taj Setúbal', 'Taj Indian Cuisine Setúbal', 'Taj Indiano Setúbal'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Indiana', 'Asiática', 'Kebab', 'Hambúrgueres', 'Pizza', 'Portuguesa', 'Vegana'],
	areaServed: [
		{ '@type': 'City', name: 'Setúbal' },
		{ '@type': 'AdministrativeArea', name: 'Península de Setúbal' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '10:00',
			closes: '23:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2a1a20" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Marcellus&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Taj Indian Cuisine, Taj Setúbal, restaurante indiano Setúbal, comida indiana Setúbal, caril Setúbal, naan Setúbal, kebab Setúbal, pizza Setúbal, comer em Setúbal"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Restaurante indiano na Av. Dom João II, loja c, em Setúbal. Comida indiana, kebab e pizza, todos os dias das 10:00 às 23:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Mesa com caris indianos, naan e arroz no Taj Indian Cuisine"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2a1a20"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-15"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Setúbal, Portugal"
			locale="pt_PT"
			countryName="Portugal"
			preload={[mesaTikka]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Taj"
			subtitle="Cozinha indiana · Setúbal"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow="Av. Dom João II, loja c · Setúbal"
				title="Cozinha indiana <br /><em>em Setúbal.</em>"
				lede={`O Taj Indian Cuisine é um restaurante indiano na Av. Dom João II, loja c, em Setúbal. Abre todos os dias às 10:00 e fecha às 23:30, e a ficha de Google dá-lhe 4,5 sobre 5 com 141 críticas.`}
				image={mesaTikka}
				imageAlt="Mesa do Taj com frango tikka masala em karahi, naan numa cesta, arroz e molhos"
				primaryCta={{ label: 'Como chegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha e críticas no Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5</b> no Google · 141 críticas' },
					{ label: 'Horário', html: '<b>10:00–23:30</b> todos os dias' },
					{ label: 'Telefone', html: `<b>${BUSINESS.phone}</b> contacto publicado` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto do perfil de Google Maps"
				galleryLinkLabel="Ver a galeria"
			/>

			<LocalChips label="O que encontras no Taj Indian Cuisine" items={SERVICOS} />

			<LocalAbout
				label="A casa"
				title="Comida indiana, <br /><em>kebab e pizza.</em>"
				paragraphs={[
					'O Taj Indian Cuisine fica na Av. Dom João II, loja c, em Setúbal (2910-548). A fachada é escura e leva um letreiro grande que resume a oferta: «Comida Indiano, Kebab e Pizza», com fotografias de pratos e dois números de telefone.',
					'A Google classifica a casa como restaurante indiano e asiático, e a mesma ficha acrescenta restaurante de döner kebab, hamburgueria, pizzaria, restaurante português e restaurante vegano. Tem 4,5 sobre 5 com 141 críticas e publica o telefone +351 920 499 430.',
					'As fotografias do perfil mostram a sala com uma garrafeira de madeira, mesas de toalha preta e guardanapos amarelos, e a mesa posta com caris em karahi, naan, arroz basmati e molhos. Também há lassi de manga, uma sobremesa de manga com waffle e pizza.',
					'O horário é contínuo: todos os dias, das 10:00 às 23:30. A ficha avisa que em feriados pode ser diferente. Não publica site próprio nem carta online, por isso esta página não apresenta preços como atuais.',
				]}
				note="A informação vem da ficha pública de Google Maps e das fotografias do perfil da casa. A ficha não publica carta nem preços, e a página de carta que aparece na galeria não está datada."
				links={[
					{ label: 'Ficha e críticas no Google', href: MAPS.reviews, external: true },
					{ label: 'Ver a casa no Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="A mesa"
				title="Caris, naan <br /><em>e mais.</em>"
				description="A ficha de Google não publica carta nem preços, e o restaurante não tem site próprio. O que segue são os pratos que aparecem nas fotografias do perfil da casa, incluindo a página de carta de borrego que a casa tem na sua galeria."
				cta={{ label: 'Ver fotos no Google Maps', href: MAPS.place }}
				groups={MENU}
				note="Não há carta oficial publicada. A fotografia da carta de borrego mostra preços de 10,50 a 10,90 €, mas não está datada e pode estar desatualizada; confirma por telefone ou na ficha antes de contar com um prato ou um preço."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Nove fotografias <br /><em>da casa.</em>"
				description="As fotografias do perfil do Taj Indian Cuisine em Google Maps: a sala, a fachada, os caris, o naan, o arroz, a carta, o lassi, a sobremesa e a pizza."
				images={galeria}
				cta={{ label: 'Ver tudo no Google Maps', href: MAPS.place }}
				note="Imagens alojadas nesta página e provenientes do perfil do estabelecimento em Google Maps. Se tens os direitos de alguma e queres retirá-la, diz-nos e apagamo-la."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Passa pela <br /><em>Dom João II.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Portugal']}
				hours={HOURS}
				hoursCaption="Horário"
				hoursNote="Horário publicado na ficha de Google: todos os dias, das 10:00 às 23:30. A ficha assinala que em feriados pode ser diferente, por isso convém confirmá-lo antes de ir."
				mapTitle="Mapa do Taj Indian Cuisine na Av. Dom João II, loja c, Setúbal"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Taj · Setúbal"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Como chegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Ligar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="O telefone é o único canal de contacto que publica a ficha; o letreiro da fachada mostra também +351 265 118 368. Não há reservas nem encomendas em linha: a casa não tem site próprio nem plataforma de reservas associada. A ficha também não indica informação sobre esplanada, take-away ou acessibilidade."
			/>

			<LocalFaq items={FAQ} eyebrow="Perguntas frequentes" title="Antes de <em>vir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Informação elaborada a partir de fontes públicas; confirma horário e oferta antes da visita."
			ctaLabel="Ligar"
			navAriaLabel="Ligações do Taj Indian Cuisine"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
