---
const business = {
	name: 'Restaurante El Cordobés',
	street: 'Calle Arte, 7',
	city: 'Marbella',
	region: 'Málaga',
	postalCode: '29601',
	country: 'ES',
	phone: '+34 952 82 98 10',
	latitude: 36.5103396,
	longitude: -4.8827553,
	site: 'https://restaurante-el-cordobes.vercel.app',
};

const mapsUrl = 'https://www.google.com/maps/place/Restaurante+El+Cordob%C3%A9s/@36.5103396,-4.8827553,17z/data=!4m6!3m5!1s0xd72d80805eb6bff:0xc766688aece07a28!8m2!3d36.5103396!4d-4.8827553!16s%2Fg%2F11bx561sw_?hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(`${business.name}, ${business.city}`)}&ll=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34952829810';
const siteUrl = `${business.site}/`;
const description = 'Restaurante El Cordobés en Marbella: cocina española, tapas y platos para compartir en la calle Arte, 7. Consulta las fotos de Google Maps, llama y encuentra cómo llegar.';

const faqs = [
	{
		question: '¿Dónde está el Restaurante El Cordobés?',
		answer: 'El restaurante está en la calle Arte, 7, 29601 Marbella (Málaga). Consulta el mapa de Google Maps para ver su ubicación y obtener indicaciones.',
	},
	{
		question: '¿Cuál es el teléfono del Restaurante El Cordobés?',
		answer: 'El teléfono publicado para el restaurante es el +34 952 82 98 10. Puedes llamar para consultar el horario, la carta o hacer una reserva.',
	},
	{
		question: '¿Qué tipo de cocina ofrece?',
		answer: 'Las fuentes públicas describen una propuesta de cocina española y platos tradicionales. Consulta la ficha del restaurante o llama para conocer la carta vigente y las especialidades del día.',
	},
	{
		question: '¿Cuál es el horario de apertura?',
		answer: 'No hemos podido confirmar un horario fiable y actualizado en fuentes públicas. Antes de desplazarte, consulta la ficha del restaurante en Google Maps o llama por teléfono.',
	},
	{
		question: '¿Dónde puedo ver fotos del restaurante?',
		answer: 'Abre la ficha oficial del Restaurante El Cordobés en Google Maps desde esta página para consultar las fotos y reseñas publicadas allí.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${siteUrl}#restaurant`,
	name: business.name,
	description,
	url: siteUrl,
	telephone: business.phone,
	servesCuisine: ['Española', 'Mediterránea'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: business.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [mapsUrl],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#38271f" />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" />
		<title>Restaurante El Cordobés en Marbella | Cocina española y tapas</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Restaurante El Cordobés · Marbella" />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${business.site}/og.svg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Restaurante El Cordobés, cocina tradicional española en Marbella" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Restaurante El Cordobés, inicio">
				<span class="brand-mark" aria-hidden="true">C</span>
				<span>El Cordobés <small>Restaurante · Marbella</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cocina">La cocina</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="header-call" href={phoneHref}>Llamar · 952 82 98 10</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span>Marbella · Málaga</span><i aria-hidden="true"></i> Cocina con carácter</p>
					<h1 id="hero-title">Sabor de siempre,<br />en el corazón <em>de Marbella.</em></h1>
					<p class="lede">Descubre el Restaurante El Cordobés, en la calle Arte, 7. Un lugar para disfrutar de cocina española y una buena mesa en Marbella. Consulta la ficha, mira las fotos y llámanos antes de venir.</p>
					<div class="actions">
						<a class="button button-gold" href={phoneHref}>Llamar al restaurante <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-details"><span>⌖ Calle Arte, 7 · Marbella</span><span>✦ Cocina española</span></div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración decorativa de una mesa con platos de cocina mediterránea y luz cálida">
					<div class="window"><span class="window-sun"></span><span class="window-hill"></span></div>
					<div class="table"></div><div class="plate plate-main"><span class="dish-main"></span><i class="garnish garnish-one"></i><i class="garnish garnish-two"></i><i class="garnish garnish-three"></i></div>
					<div class="plate plate-side"><span></span></div><div class="glass"><i></i></div><div class="napkin"></div>
					<div class="art-note">Una mesa<br /><b>para disfrutar</b></div>
				</div>
			</section>

			<div class="ticker" aria-label="Una buena mesa en Marbella"><span>Cocina española</span><b>✳</b><span>Marbella centro</span><b>✳</b><span>Buen producto</span><b>✳</b><span>Comer y compartir</span></div>

			<section class="intro section-wrap" id="cocina">
				<div><p class="eyebrow eyebrow-dark">Una dirección para recordar</p><h2>En Marbella,<br /><em>siéntate a la mesa.</em></h2></div>
				<div class="intro-copy"><p>El Cordobés es un restaurante situado en la calle Arte, en Marbella. Encuentra aquí la información práctica para organizar tu visita y consulta directamente con el local los detalles de su cocina, horarios y disponibilidad.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver opiniones, datos y ficha en Google Maps ↗</a></div>
			</section>

			<section class="specialties section-wrap" aria-labelledby="specialties-title">
				<div class="section-heading"><p class="eyebrow eyebrow-dark">Cocina española en Marbella</p><h2 id="specialties-title">Lo importante<br /><em>es compartir.</em></h2><p>Un plan sencillo: buena compañía y una mesa en Marbella. Consulta la carta actual y las sugerencias directamente con el restaurante.</p></div>
				<div class="special-grid">
					<article class="special-card special-tapas"><span class="special-icon" aria-hidden="true">✦</span><span class="card-kicker">PARA EMPEZAR</span><h3>Tapas y entrantes</h3><p>Pregunta por las opciones de la carta para abrir el apetito y compartir.</p></article>
					<article class="special-card special-kitchen"><span class="special-icon" aria-hidden="true">♨</span><span class="card-kicker">COCINA ESPAÑOLA</span><h3>Platos tradicionales</h3><p>Sabores conocidos y cocina de inspiración española en un ambiente cercano.</p></article>
					<article class="special-card special-table"><span class="special-icon" aria-hidden="true">◉</span><span class="card-kicker">BUENA COMPAÑÍA</span><h3>Una mesa para todos</h3><p>Un punto de encuentro para disfrutar de una comida o una cena en Marbella.</p></article>
				</div>
				<p class="menu-note">La carta, los precios y la disponibilidad pueden cambiar. Llama al restaurante para consultar la oferta actual.</p>
			</section>

			<section class="photo-section" id="fotos">
				<div class="photo-copy"><p class="eyebrow">Fotos del Restaurante El Cordobés</p><h2>Asómate a la ficha<br />antes de <em>venir.</em></h2><p>Consulta las imágenes, reseñas y datos del Restaurante El Cordobés publicados en su ficha de Google Maps. Abre el enlace para ver las fotos disponibles del local y la comida.</p><a class="button button-gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a></div>
				<div class="map-photo"><iframe title="Google Maps: ubicación del Restaurante El Cordobés en Marbella" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><a class="map-caption" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span>⌖</span><span><b>Restaurante El Cordobés</b><small>Ubicación, fotos y ficha en Google Maps ↗</small></span></a></div>
			</section>

			<section class="visit section-wrap" id="visitanos">
				<div class="visit-copy"><p class="eyebrow eyebrow-dark">Estamos en Marbella</p><h2>Nos encontramos<br /><em>en la calle Arte.</em></h2><p>Ven al Restaurante El Cordobés. Consulta cómo llegar desde Google Maps o llama para confirmar que estamos abiertos.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button button-dark" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Llamar · 952 82 98 10</a></div></div>
				<div class="hours-card"><div class="hours-title"><span class="clock" aria-hidden="true">◷</span><div><p class="eyebrow eyebrow-dark">Antes de salir</p><h3>Confirma el horario</h3></div></div><p class="hours-copy">No encontramos un horario público suficientemente fiable para mostrarlo aquí. La ficha de Google Maps o una llamada te ayudarán a confirmar el horario de hoy.</p><a class="hours-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Consultar horario en Google Maps ↗</a><a class="phone-card-link" href={phoneHref}>Llamar al +34 952 82 98 10</a></div>
			</section>

			<section class="faq-section section-wrap" id="preguntas"><p class="eyebrow eyebrow-dark">Información útil</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
		</main>

		<footer class="footer"><div class="footer-top"><a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">C</span><span>El Cordobés <small>Restaurante · Marbella</small></span></a><p>Cocina española<br />en Marbella.</p><nav aria-label="Enlaces del restaurante"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={phoneHref}>952 82 98 10</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Restaurante El Cordobés · Marbella</span><a href="/aviso-legal/">Aviso legal y privacidad</a><span>Confirma horario y carta directamente con el establecimiento.</span></div></footer>
		<a class="mobile-call" href={phoneHref}>Llamar <span>952 82 98 10</span></a>
	</body>
</html>

<style is:global>
	:root{font-family:'DM Sans',sans-serif;color:#342e2a;background:#f8f3e9;font-synthesis:none;text-rendering:optimizeLegibility;--brown:#38271f;--brown2:#54372a;--gold:#d9ae5e;--cream:#f8f3e9;--ink:#342e2a;--muted:#786d62;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid #d9ae5e;outline-offset:4px}.skip-link{position:absolute;z-index:99;top:-60px;left:16px;padding:12px 16px;background:var(--gold);color:var(--brown)}.skip-link:focus{top:12px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:22px;background:var(--brown);color:#fbf6ed}.brand{display:flex;align-items:center;gap:11px;font-size:15px;font-weight:700}.brand small{display:block;margin-top:4px;color:#d8cbb7;font-size:9px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid #d9ae5e;border-radius:50%;color:#e2bf78;font:700 23px var(--display)}.topbar nav{display:flex;gap:clamp(14px,2.5vw,32px);color:#eee5d8;font-size:12px}.topbar nav a:hover,.footer a:hover{color:#e2bf78}.header-call{padding:11px 17px;border:1px solid #ffffff50;border-radius:99px;font-size:11px;font-weight:700}.hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:560px;background:var(--brown);color:#fbf6ed;overflow:hidden}.hero-copy{padding:73px 4vw 64px 9vw;align-self:center}.eyebrow{margin:0 0 19px;color:#d7c396;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase}.eyebrow i{display:inline-block;width:22px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.section-heading h2,.photo-copy h2,.visit h2,.faq-section h2{margin:0;font:600 clamp(39px,4.7vw,64px)/1.08 var(--display);letter-spacing:-1.2px}.hero h1 em,.intro h2 em,.section-heading h2 em,.photo-copy h2 em,.visit h2 em,.faq-section h2 em{color:var(--gold);font-style:italic}.lede{max-width:475px;margin:24px 0 0;color:#e2d8cb;font-size:15px;line-height:1.8}.actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:27px}.button{display:inline-flex;min-height:47px;align-items:center;justify-content:center;gap:14px;padding:0 20px;border-radius:99px;font-size:12px;font-weight:700;transition:transform .18s ease}.button:hover{transform:translateY(-2px)}.button-gold{background:var(--gold);color:var(--brown)}.button-outline{border:1px solid #ffffff65;color:#fbf6ed}.hero-details{display:flex;flex-wrap:wrap;gap:12px 22px;margin-top:27px;padding-top:20px;border-top:1px solid #ffffff2a;color:#e0d5c8;font-size:11px}.hero-details span:first-child{color:#edcf91}.hero-art{position:relative;min-height:560px;overflow:hidden;background:linear-gradient(150deg,#6c4a39,#bc8057 56%,#e0ae74)}.window{position:absolute;top:8%;right:13%;width:47%;height:36%;overflow:hidden;border:9px solid #f0dfc1;background:#e8ba7f;box-shadow:0 14px 25px #39241e35}.window:before,.window:after{position:absolute;z-index:2;content:'';background:#f0dfc1}.window:before{top:0;bottom:0;left:49%;width:8px}.window:after{top:48%;right:0;left:0;height:8px}.window-sun{position:absolute;top:16%;right:18%;width:49px;height:49px;border-radius:50%;background:#f6d17c}.window-hill{position:absolute;right:-10%;bottom:-7%;left:-10%;height:53%;border-radius:50% 50% 0 0;background:#788158}.table{position:absolute;right:-10%;bottom:-10%;left:-10%;height:45%;border-radius:50% 50% 0 0;background:#754935;box-shadow:0 -8px 20px #35231c44}.plate{position:absolute;z-index:2;display:grid;place-items:center;border:12px solid #fff9ec;border-radius:50%;background:#e9dfc9;box-shadow:0 18px 30px #30211d55}.plate-main{left:37%;top:41%;width:min(260px,54%);aspect-ratio:1}.dish-main{width:68%;height:62%;border-radius:48% 52% 49% 51%;background:radial-gradient(ellipse at 50% 43%,#c47a48 0 28%,#804833 30% 38%,#d2a360 40% 48%,#6f4a32