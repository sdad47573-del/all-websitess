---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import vitrina from '../assets/fotos/sabores-del-hogar-comida-casera-para-llevar-apaisada-01.jpg';
import neon from '../assets/fotos/sabores-del-hogar-comida-casera-para-llevar-vista-2-02.jpg';
import guiso from '../assets/fotos/sabores-del-hogar-comida-casera-para-llevar-vertical-03.jpg';
import lomo from '../assets/fotos/sabores-del-hogar-comida-casera-para-llevar-vertical-04.jpg';
import albondigas from '../assets/fotos/sabores-del-hogar-comida-casera-para-llevar-vertical-05.jpg';
import verduras from '../assets/fotos/sabores-del-hogar-comida-casera-para-llevar-vertical-06.jpg';
import horneado from '../assets/fotos/sabores-del-hogar-comida-casera-para-llevar-vertical-07.jpg';
import verdurasSalsa from '../assets/fotos/sabores-del-hogar-comida-casera-para-llevar-vertical-10.jpg';
import bandejas from '../assets/fotos/sabores-del-hogar-comida-casera-para-llevar-apaisada-08.jpg';
import arroz from '../assets/fotos/sabores-del-hogar-comida-casera-para-llevar-apaisada-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Sabores del Hogar · Comida casera para llevar en Madrid';
const description =
	'Sabores del Hogar, en Calle de Gaztambide, 32 (28015 Madrid, Chamberí). Comida casera para llevar hecha por Dani: guisos, albóndigas, croquetas y patatas caseras.';

const galeria = [
	{
		src: vitrina,
		alt: 'El mostrador de Sabores del Hogar con las bandejas de lentejas, ensaladilla, garbanzos, pasta, berenjena, judías verdes, pollo asado, guiso, lomo y albóndigas',
	},
	{
		src: albondigas,
		alt: 'Primer plano de las albóndigas en salsa de Sabores del Hogar',
	},
	{
		src: arroz,
		alt: 'Una bandeja redonda de arroz al horno gratinado con queso, guisantes y pimiento',
	},
	{
		src: guiso,
		alt: 'Una bandeja de ternera guisada en su salsa en el mostrador',
	},
	{
		src: lomo,
		alt: 'Lomo asado loncheado con su jugo en una bandeja de acero',
	},
	{
		src: horneado,
		alt: 'Una bandeja de masa horneada cortada en porciones en el mostrador',
	},
	{
		src: verdurasSalsa,
		alt: 'Verduras asadas con salsa verde: berenjena, calabacín, calabaza, cebolla y tomate',
	},
	{
		src: verduras,
		alt: 'Bandeja de berenjena, calabacín, zanahoria, cebolla y pimiento asados',
	},
	{
		src: bandejas,
		alt: 'Bandejas de arroces, pastas y ensaladas en la vitrina de Sabores del Hogar',
	},
	{
		src: neon,
		alt: 'El cartel de neón del local con un muslo de pollo y el texto «Sabor de Hogar»',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Platos del mostrador de Sabores del Hogar',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#sabores-del-hogar`,
	name: BUSINESS.fullName,
	alternateName: ['Sabores del Hogar Madrid', 'Sabores del Hogar Chamberí', 'Sabores del Hogar by Dani'],
	description:
		'Comida casera para llevar en la calle de Gaztambide, 32 (Chamberí, 28015 Madrid). Guisos, albóndigas en salsa, croquetas y patatas caseras hechos por Dani.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34642912557',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Comida para llevar', 'Cocina española'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Chamberí' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '12:00',
			closes: '17:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El hogar', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"sabores-del-hogar-comida-casera-para-llevar-apaisada-01.jpg": vitrina,
	"sabores-del-hogar-comida-casera-para-llevar-vertical-05.jpg": albondigas,
	"sabores-del-hogar-comida-casera-para-llevar-apaisada-09.jpg": arroz,
	"sabores-del-hogar-comida-casera-para-llevar-vertical-03.jpg": guiso,
	"sabores-del-hogar-comida-casera-para-llevar-vertical-04.jpg": lomo,
	"sabores-del-hogar-comida-casera-para-llevar-vertical-07.jpg": horneado,
	"sabores-del-hogar-comida-casera-para-llevar-vertical-10.jpg": verdurasSalsa,
	"sabores-del-hogar-comida-casera-para-llevar-vertical-06.jpg": verduras,
	"sabores-del-hogar-comida-casera-para-llevar-apaisada-08.jpg": bandejas,
	"sabores-del-hogar-comida-casera-para-llevar-vista-2-02.jpg": neon,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#6b2130" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Manrope:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Sabores del Hogar Madrid, comida casera para llevar Chamberí, comida para llevar Gaztambide, albóndigas en salsa Madrid, croquetas caseras Chamberí, Sabores del Hogar by Dani"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar hecha por Dani, en Gaztambide, 32 (Chamberí). Guisos, albóndigas en salsa, croquetas y patatas caseras. De domingo a viernes, de 12:00 a 17:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="El mostrador de Sabores del Hogar con sus bandejas de comida casera"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#6b2130"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Chamberí"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Sabores del Hogar"
			subtitle="Comida casera · Chamberí"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a Sabores del Hogar"
			navAriaLabel="Enlaces de Sabores del Hogar"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34642912557?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Platos%20del%20mostrador%20de%20Sabores%20del%20Hogar." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Platos del mostrador de Sabores del Hogar"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
