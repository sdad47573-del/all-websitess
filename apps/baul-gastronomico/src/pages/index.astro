---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/baul-gastronomico-apaisada-01.jpg';
import paella from '../assets/fotos/baul-gastronomico-apaisada-03.jpg';
import terraza from '../assets/fotos/baul-gastronomico-apaisada-04.jpg';
import lomo from '../assets/fotos/baul-gastronomico-apaisada-05.jpg';
import comedor from '../assets/fotos/baul-gastronomico-apaisada-06.jpg';
import postre from '../assets/fotos/baul-gastronomico-apaisada-07.jpg';
import salmon from '../assets/fotos/baul-gastronomico-apaisada-09.jpg';
import marisco from '../assets/fotos/baul-gastronomico-vertical-02.jpg';
import tallarines from '../assets/fotos/baul-gastronomico-vertical-08.jpg';
import rellenos from '../assets/fotos/baul-gastronomico-vertical-10.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Baúl Gastronómico · Comida casera para llevar en Murcia';
const description =
	'Baúl Gastronómico, Avenida de Europa, 38, local 10 (30007 Murcia). Comida casera para llevar y a domicilio, paellas por encargo y menús diarios con opciones vegetarianas.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de Baúl Gastronómico con los toldos, las mesas de mantel verde y la pizarra de menús',
	},
	{
		src: paella,
		alt: 'Una paella de marisco con mejillones, gambas y anillas de calamar en la paellera',
	},
	{
		src: lomo,
		alt: 'Lomo de cerdo asado en salsa de azafrán con perejil fresco',
	},
	{
		src: comedor,
		alt: 'El comedor interior de Baúl Gastronómico, con paredes verdes y mesas preparadas',
	},
	{
		src: salmon,
		alt: 'Salmón en hojaldre cortado en porciones sobre la bandeja',
	},
	{
		src: marisco,
		alt: 'Un guiso de marisco y arroz en su paellera sobre el fuego',
	},
	{
		src: tallarines,
		alt: 'Tallarines negros a la tinta de calamar con mejillones y gambas',
	},
	{
		src: rellenos,
		alt: 'Pimientos rellenos gratinados servidos con ensalada verde',
	},
	{
		src: postre,
		alt: 'Postre en vaso con yogur, frambuesa, arándano y mermelada',
	},
	{
		src: terraza,
		alt: 'Otra vista de la terraza, con los manteles verdes y las mesitas del local',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que se prepara en Baúl Gastronómico',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#baul-gastronomico`,
	name: BUSINESS.fullName,
	alternateName: ['Baúl Gastronómico Murcia', 'Baúl Gastronómico Avenida de Europa'],
	description:
		'Comida casera para llevar y a domicilio en la Avenida de Europa, 38, local 10 (30007 Murcia). Platos elaborados, menús diarios, paellas por encargo y opciones vegetarianas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34968906193',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Comida para llevar', 'Cocina española', 'Paellas'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Murcia' },
		{ '@type': 'AdministrativeArea', name: 'Región de Murcia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '11:30',
			closes: '16:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La cocina', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1d5c3f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400..700;1,400&family=Assistant:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Baúl Gastronómico Murcia, comida para llevar Murcia, comida casera Avenida de Europa, paellas por encargo Murcia, menús diarios Murcia, comida a domicilio Murcia"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar y a domicilio en la Avenida de Europa, 38 (Murcia): platos elaborados, menús diarios y paellas por encargo."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de Baúl Gastronómico con las mesas de mantel verde y la pizarra de menús"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1d5c3f"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Baúl Gastronómico"
			subtitle="Comida casera · Murcia"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Avenida de Europa, 38, local 10 · Murcia"
				title="Comida de casa, <br /><em>a tu mesa.</em>"
				lede={`Baúl Gastronómico es una casa de comidas en la Avenida de Europa. Se prepara para llevar y a domicilio —platos elaborados, menús diarios y paellas por encargo—, con mesas de mantel verde en la terraza y una pequeña sala dentro. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas, y abre de lunes a viernes de 8:00 a 17:00 y el sábado de 11:30 a 16:30.`}
				image={fachada}
				imageAlt="La fachada de Baúl Gastronómico con toldos, plantas, mesas de mantel verde y la pizarra de menús"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>8:00–17:00</b> · sábado desde las 11:30' },
					{ label: 'Servicio', html: '<b>Para llevar</b> · y a domicilio' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Paellas por encargo"
			/>

			<LocalChips label="Lo que ofrece Baúl Gastronómico" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Avenida de Europa, 38. <br /><em>Comida de puchero.</em>"
				paragraphs={[
					'Baúl Gastronómico está en la Avenida de Europa, 38, local 10, en Murcia. En la acera se ven los toldos blancos, las jardineras, una pizarra con la lista del día y dos mesas largas cubiertas con manteles verdes. En el cristal, el letrero «comidas para llevar» deja claro a qué se dedica la casa.',
					'Dentro hay una sala pequeña con paredes verdes, mesas y sillas de madera y un ventilador de techo. En el perfil de Google aparecen además fotos de la cocina: una paella de marisco con mejillones y gambas, un lomo de cerdo asado en salsa de azafrán, salmón en hojaldre, un guiso de marisco en paellera, tallarines negros a la tinta de calamar y pimientos rellenos con ensalada.',
					'La ficha la describe como comida casera y anuncia «ricas paellas que poder hacer por encargo», además de menús diarios con opciones vegetarianas y platos saludables. Un local de barrio, de los que se llenan a la hora de comer y en los que se compra para llevar a casa o para recoger un encargo.',
					`Las opiniones de Google hablan de buena comida, buen precio y raciones generosas. La media es de ${RATING.label} sobre 5 con ${RATING.count} reseñas (octubre de 2026). Atiende en el ${BUSINESS.phone}, de lunes a viernes de 8:00 a 17:00 y el sábado de 11:30 a 16:30.`,
				]}
				note="La ficha no publica una carta con todos los platos ni los precios. Lo que aparece en esta página son los platos que se ven en las fotos del perfil y lo que anuncia la propia ficha; confirma disponibilidad, precios y encargos por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> De la cocina al táper</p>
					<h2 id="highlights-title">Casero, por encargo <br /><em>y al peso del día.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La cocina"
				title="Lo que sale <br /><em>del puchero.</em>"
				description="La ficha no publica carta, así que esta lista reúne lo que anuncia el propio establecimiento (menús diarios, paellas por encargo, opciones vegetarianas) y los platos que se reconocen en las fotos del perfil de Google."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Sin precios publicados: ni la ficha ni la pizarra del local los dejan claros en las fotos. Llama al 968 90 61 93 para saber el menú del día, el precio de las raciones y el plazo de encargo de las paellas."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La terraza, la sala <br /><em>y los platos.</em>"
				description="Diez fotografías del perfil de Baúl Gastronómico: la fachada con los manteles verdes, la terraza, el comedor, la paella de marisco, el lomo asado, el salmón en hojaldre, los tallarines negros, los pimientos rellenos y el postre."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,6 sobre 5, <em>con 123 reseñas.</em></h2>
						<p>
							Google publica una media de 4,6 con 123 opiniones (octubre de 2026). Las reseñas
							que se ven en la ficha destacan la comida, el trato, el precio y la variedad de
							los menús diarios, con opciones vegetarianas.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,6</strong>
						<span>★★★★★</span>
						<small>123 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Murcia, <br /><em>junto a la Avenida de Europa.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de lunes a viernes, de 8:00 a 17:00, y el sábado de 11:30 a 16:30. El domingo está cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Baúl Gastronómico en la Avenida de Europa, 38, Murcia"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Avenida de Europa, 38 · Murcia"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos y encargos por teléfono: la ficha no enlaza una web propia ni un sistema de pedidos online. Avisa de que el local tiene acceso para sillas de ruedas en la entrada, pero no publica datos de aparcamiento adaptado ni de aseos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma platos y horario antes de la visita."
			ctaLabel="Llamar a Baúl Gastronómico"
			navAriaLabel="Enlaces de Baúl Gastronómico"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
