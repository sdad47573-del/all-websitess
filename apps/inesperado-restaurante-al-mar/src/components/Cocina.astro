---
import { BUSINESS, PLATOS, VENTAJAS } from '../data/site';
---

<section id="cocina" class="bg-base-200 relative overflow-hidden py-20 sm:py-24">
	<div class="reflejo-inesperado absolute inset-x-0 top-0 h-40 opacity-40" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
			<div>
				<p class="text-secondary text-xs font-semibold tracking-[0.22em] uppercase">La cocina</p>
				<h2 class="font-display mt-3 text-3xl leading-tight font-bold sm:text-4xl">
					Del desayuno a la puesta de sol
				</h2>
				<p class="text-base-content/70 mt-4 max-w-xl leading-relaxed">
					La casa ofrece desayunos, comida, chill out y cena. Esta es la parte que cuenta su ficha y
					sus reseñas; la carta completa se consulta en el local.
				</p>
			</div>
			<a href={BUSINESS.phoneHref} class="btn btn-primary shrink-0 gap-2 rounded-full">
				<i class="ri-phone-line"></i> Reservar mesa
			</a>
		</div>

		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				PLATOS.map((plato, index) => (
					<article class="border-base-300 bg-base-100 relative flex flex-col rounded-xl border p-6">
						<div class="flex items-start justify-between gap-4">
							<h3 class="font-display text-xl font-bold">{plato.title}</h3>
							<span class="font-display text-secondary/30 text-3xl leading-none font-bold">
								{String(index + 1).padStart(2, '0')}
							</span>
						</div>
						<p class="text-base-content/65 mt-2 flex-1 text-sm leading-relaxed">{plato.text}</p>
						<span class="text-secondary mt-5 inline-flex size-9 items-center justify-center rounded-full bg-secondary/10">
							<i class={`${plato.icon} text-lg`} />
						</span>
					</article>
				))
			}
		</div>

		<div class="bg-primary mt-6 grid gap-6 rounded-xl px-6 py-7 text-white sm:px-8 lg:grid-cols-[1fr_auto] lg:items-center">
			<div>
				<h3 class="font-display text-xl font-bold sm:text-2xl">Carta y precios, en el local</h3>
				<p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/65">
					Esta web no publica importes sin confirmar. La carta, el menú y la disponibilidad se consultan
					en el restaurante o llamando al {BUSINESS.phone}.
				</p>
			</div>
			<div class="flex flex-wrap gap-2">
				{
					VENTAJAS.map((v) => (
						<span class="badge gap-1.5 rounded-full border-white/20 bg-white/10 px-3 py-3 text-xs text-white">
							<i class={`${v.icon} text-accent`} /> {v.title}
						</span>
					))
				}
			</div>
		</div>
	</div>
</section>
