---
import { Image } from 'astro:assets';
import { BUSINESS, IMAGES, NAV } from '../data/site';

interface Props {
	base?: string;
}

const { base = '' } = Astro.props;
---

<div class="border-base-300/80 bg-base-100/90 sticky top-0 z-50 border-b backdrop-blur-md">
	<header class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
		<a href={`${base}#inicio`} class="flex min-w-0 items-center gap-3" aria-label={BUSINESS.name}>
			<Image
				src={IMAGES.logo}
				alt=""
				width={44}
				height={44}
				quality={90}
				class="size-10 shrink-0 rounded-xl object-cover"
			/>
			<span class="min-w-0 leading-tight">
				<span class="font-display block truncate text-base font-medium tracking-tight sm:text-lg">
					<span class="sm:hidden">Puerta de las Hurdes</span>
					<span class="hidden sm:inline">Mesón Puerta de las Hurdes</span>
				</span>
				<span class="text-base-content/60 block truncate text-[0.6rem] tracking-[0.22em] uppercase">
					<span class="sm:hidden">Pozuelo de Zarzón</span>
					<span class="hidden sm:inline">Pozuelo de Zarzón · Cáceres</span>
				</span>
			</span>
		</a>

		<nav class="hidden items-center gap-6 lg:flex" aria-label="Navegación principal">
			{
				NAV.map((item) => (
					<a
						href={`${base}${item.href}`}
						class="text-base-content/75 hover:text-secondary text-sm font-semibold transition-colors"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex shrink-0 items-center gap-2">
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-primary btn-sm gap-2 rounded-full px-4"
			>
				<i class="ri-map-pin-line text-base"></i>
				<span class="hidden sm:inline">Cómo llegar</span>
				<span class="sm:hidden">Ruta</span>
			</a>
			<details class="dropdown dropdown-end lg:hidden">
				<summary class="btn btn-ghost btn-sm list-none" aria-label="Abrir menú"
					><i class="ri-menu-line text-xl"></i></summary
				>
				<ul
					class="menu dropdown-content rounded-box border-base-300 bg-base-100 z-50 mt-2 w-60 border p-2 shadow-xl"
				>
					{
						NAV.map((item) => (
							<li>
								<a href={`${base}${item.href}`}>{item.label}</a>
							</li>
						))
					}
					<li>
						<a href={`${base}aviso-legal`}>Aviso legal y privacidad</a>
					</li>
				</ul>
			</details>
		</div>
	</header>
</div>
