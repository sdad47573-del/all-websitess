---
import { BUSINESS, VALORES } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
---

<section id="opiniones" class="bg-base-200 border-base-300 border-y py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-14">
			<div>
				<p class="text-secondary text-xs font-semibold tracking-[0.22em] uppercase">Opiniones</p>
				<h2 class="font-display mt-3 text-4xl leading-tight font-medium text-primary sm:text-5xl">
					Lo que dicen en Google
				</h2>

				<div class="border-base-300 bg-base-100 mt-7 rounded-2xl border p-6">
					<div class="flex items-end gap-4">
						<span class="font-display text-6xl leading-none font-medium text-primary">
							{BUSINESS.rating.toString().replace('.', ',')}
						</span>
						<div class="pb-1">
							<div class="text-secondary text-lg tracking-tight" aria-hidden="true">
								{
									estrellas.map((n) => (
										<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
									))
								}
							</div>
							<p class="text-base-content/60 mt-1 text-xs">
								{BUSINESS.reviewCount} reseñas en Google Maps
							</p>
						</div>
					</div>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline btn-sm mt-5 w-full gap-2 rounded-full"
					>
						<i class="ri-google-fill"></i> Leer todas las reseñas
					</a>
					<p class="text-base-content/45 mt-3 text-center text-[0.65rem]">
						Valoración de la ficha de Google en octubre de 2026.
					</p>
				</div>
			</div>

			<div class="grid gap-4 sm:grid-cols-2">
				{
					VALORES.map((valor) => (
						<article class="border-base-300 bg-base-100 flex flex-col rounded-2xl border p-6">
							<span class="bg-primary/8 text-primary flex size-10 items-center justify-center rounded-full">
								<i class={`${valor.icon} text-lg`} />
							</span>
							<h3 class="font-display mt-4 text-xl text-primary">{valor.title}</h3>
							<p class="text-base-content/65 mt-1 flex-1 text-sm leading-relaxed">{valor.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</div>
</section>
