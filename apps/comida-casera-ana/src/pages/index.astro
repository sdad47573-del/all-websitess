---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/comida-casera-ana-apaisada-04.jpg';
import lentejas from '../assets/fotos/comida-casera-ana-apaisada-03.jpg';
import cookies from '../assets/fotos/comida-casera-ana-apaisada-06.jpg';
import bandeja from '../assets/fotos/comida-casera-ana-apaisada-07.jpg';
import espinacas from '../assets/fotos/comida-casera-ana-apaisada-08.jpg';
import croquetas from '../assets/fotos/comida-casera-ana-apaisada-09.jpg';
import tarta from '../assets/fotos/comida-casera-ana-cuadrada-05.jpg';
import tortillas from '../assets/fotos/comida-casera-ana-vertical-02.jpg';
import carne from '../assets/fotos/comida-casera-ana-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Comida Casera Ana · Comida para llevar en Sevilla';
const description =
	'Comida Casera Ana, tienda de comida para llevar en Calle Fernández de Ribera, 34, Sevilla. Platos caseros del día, raciones y reparto a domicilio. Fotos, horario, teléfono y opiniones.';

const galeria = [
	{ src: fachada, alt: 'Escaparate de Comida Casera Ana con el rótulo naranja en la calle Fernández de Ribera' },
	{ src: lentejas, alt: 'Lentejas estofadas con chorizo, patata y zanahoria en una cazuela de barro' },
	{ src: tortillas, alt: 'Tortillas de patata y empanadas enteras en la bandeja del local' },
	{ src: carne, alt: 'Carne guisada en trozos recién hecha en una bandeja' },
	{ src: espinacas, alt: 'Plato de espinacas con garbanzos de Comida Casera Ana' },
	{ src: croquetas, alt: 'Croquetas caseras doradas en una bandeja blanca' },
	{ src: bandeja, alt: 'Bandeja de aluminio con queso rallado lista para gratinar' },
	{ src: cookies, alt: 'Dos cookies de chocolate sobre una pizarra' },
	{ src: tarta, alt: 'Tarta de merengue con frambuesas y arándanos en su caja' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Oferta de Comida Casera Ana',
	inLanguage: 'es-ES',
	description:
		'Selección orientativa basada en las fotografías del perfil público y en las reseñas; la ficha no publica una carta oficial ni precios.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#comida-casera-ana`,
	name: BUSINESS.name,
	alternateName: ['Comida Casera Ana Sevilla', 'Comida Ana'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34604838297',
	servesCuisine: ['Comida casera', 'Comida para llevar', 'Andaluza'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '20:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '09:00',
			closes: '16:00',
		},
	],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Oferta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..600;1,400..500&family=Nunito+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Comida Casera Ana, comida para llevar Sevilla, comida casera Fernández de Ribera, menú del día Sevilla, comida a domicilio Sevilla, platos caseros Sevilla"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar y a domicilio en Fernández de Ribera, 34. Consulta fotos, horario, teléfono y opiniones."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Escaparate de Comida Casera Ana en Sevilla"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#7a2f2a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Sevilla"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Comida Casera Ana"
			subtitle="Comida para llevar · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Calle Fernández de Ribera, 34 · Sevilla"
				title="Comida de casa, <br /><em>lista para llevar.</em>"
				lede={`Comida Casera Ana prepara platos caseros con ingredientes frescos y recetas de toda la vida. Atiende en la calle Fernández de Ribera, 34, para recoger o con reparto a domicilio. La ficha de Google muestra ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				image={fachada}
				imageAlt="Escaparate de Comida Casera Ana con el rótulo naranja del local"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver ficha en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Tipo', html: '<b>Comida casera</b> para llevar' },
					{ label: 'Valoración', html: `<b>${RATING.label}</b> · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>9:00 – 20:00</b> de lunes a viernes' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver fotos y ficha"
				tag="Recién hecha"
			/>

			<LocalChips label="Servicios y oferta de Comida Casera Ana" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Ana cocina <br /><em>como en casa.</em>"
				paragraphs={[
					'Comida Casera Ana es una tienda de comida para llevar en la calle Fernández de Ribera, 34, en Sevilla. El negocio se presenta en Google con una idea sencilla: llevar comida casera «hecha con cariño y con el sabor de siempre».',
					'Cada plato se prepara con ingredientes frescos y recetas de toda la vida. En las fotos de la ficha aparecen lentejas con chorizo en cazuela de barro, tortillas de patata, espinacas con garbanzos, croquetas, carnes guisadas y algún postre.',
					'Google la clasifica como restaurante de comida para llevar, productor de alimentos y servicio de comida a domicilio. Abre de 9:00 a 20:00 de lunes a viernes y los sábados hasta las 16:00; los domingos cierra.',
				]}
				note="La ficha no publica carta ni precios. Los platos citados son los que aparecen en las fotografías del propio negocio; la oferta cambia a diario, así que conviene llamar para saber qué hay ese día."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotografías', href: '#galeria' },
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<ul class="highlights">
				{
					HIGHLIGHTS.map((item) => (
						<li>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</li>
					))
				}
			</ul>

			<LocalMenu
				eyebrow="En la vitrina y en las fotos"
				title="Cocina de cuchara <br /><em>y de todos los días.</em>"
				description="La ficha no publica carta, pero sus fotografías muestran el tipo de comida que prepara: guisos en cazuela, tortillas, espinacas con garbanzos, croquetas y carnes. Esta selección es orientativa."
				cta={{ label: `Preguntar el menú de hoy · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios ni carta oficial publicados. Confirma los platos del día, el precio de las raciones y las condiciones del reparto llamando al establecimiento."
			/>

			<LocalGallery
				eyebrow="Fotos del perfil de Google Maps"
				title="El escaparate <br /><em>y los platos.</em>"
				description="El local en la calle Fernández de Ribera y algunos de los platos que aparecen en las fotografías públicas del establecimiento."
				images={galeria}
				cta={{ label: 'Abrir la ficha en Google Maps', href: MAPS.place }}
				note="Imágenes descargadas del perfil público de Comida Casera Ana en Google Maps y servidas desde esta página."
			/>

			<section class="notas" aria-labelledby="notas-title">
				<div class="wrap notas-grid">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="notas-title">Lo que cuentan <em>las reseñas.</em></h2>
						<p class="notas-score">
							<strong>{RATING.label}</strong>
							<span>
								<b>★★★★★</b>
								{RATING.count} reseñas<br />en Google
							</span>
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer reseñas en Google ↗
						</a>
					</div>

					<div class="notas-copy">
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>{resena.texto}</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Opinión en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<p class="notas-foot">
							La valoración y el número de reseñas corresponden a la ficha consultada en octubre
							de 2026 y pueden variar. <a href={MAPS.reviews} target="_blank" rel="noreferrer"
								>Consulta las opiniones actualizadas en Google ↗</a
							>.
						</p>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Fernández <br /><em>de Ribera.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de Comida Casera Ana en Calle Fernández de Ribera, 34, Sevilla"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Fernández de Ribera, 34 · Sevilla"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="La ficha no detalla zonas ni mínimos de reparto. Llama para encargar, preguntar por los platos del día o confirmar si llevan a tu zona."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma horario, platos y precios con el establecimiento."
			ctaLabel="Llamar a Comida Casera Ana"
			navAriaLabel="Enlaces de Comida Casera Ana"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
