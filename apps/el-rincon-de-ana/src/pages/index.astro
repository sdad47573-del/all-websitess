---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import {
	business,
	directionsUrl,
	faqSchema,
	faqs,
	HOURS,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	REVIEWS,
	SPECIALTIES,
} from '../lib/business';

const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);

const rutas = Object.keys(fotos).sort((a, b) => a.localeCompare(b));

/**
 * La foto del hero se elige por la forma que `fetch-maps-photos` pone en el nombre: la vertical,
 * que es la que encaja en el marco 3/4 de la portada, y si no hay, la cuadrada. Así la portada no
 * depende de que Google devuelva un nombre concreto de archivo.
 */
const rutaHero =
	rutas.find((r) => r.includes('-vertical-')) ??
	rutas.find((r) => r.includes('-cuadrada-')) ??
	rutas[0];
const heroFoto = rutaHero ? fotos[rutaHero].default : undefined;

const galeria = rutas.map((ruta) => {
	const archivo = ruta.split('/').pop() ?? '';
	const clave = ['panoramica', 'apaisada', 'vertical', 'cuadrada'].find((forma) =>
		archivo.includes(`-${forma}`),
	);
	const forma =
		clave === 'apaisada' ? 'horizontal' : clave === 'panoramica' ? 'panorámica' : (clave ?? 'general');
	return {
		src: fotos[ruta].default,
		alt: `Fotografía ${forma} de ${business.name}, publicada en su ficha de Google Maps`,
	};
});

const title = 'Bar restaurante El rincón de Ana | Pescados y raciones en Huelva';
const description = `Bar restaurante El rincón de Ana, en la calle los Emires 1 de Huelva: pescados, mariscos y raciones según las 387 reseñas de su ficha de Google (4,6). Abre de martes a viernes en dos turnos. Mapa, horario y teléfono (${business.phoneDisplay}).`;
const keywords = `El rincón de Ana, bar restaurante Huelva, pescados Huelva, mariscos Huelva, raciones Huelva, fritos Huelva, comer en Huelva, C. los Emires Huelva, 21002 Huelva`;
const address = `${business.streetAddress}, ${business.postalCode} ${business.locality}`;
const rating = business.rating.toString().replace('.', ',');
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0f3b3a" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-H" />
		<meta name="geo.placename" content={business.locality} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Outfit:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Tarjeta de Bar restaurante El rincón de Ana, en Huelva" />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.locality} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">A</span>
				<span class="brand-copy">
					El rincón de Ana
					<small>{business.category} · {business.locality}</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">Qué se come</a>
				<a href="#horario">Horario</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-call" href={phoneHref}><span aria-hidden="true">☎</span> {business.phoneDisplay}</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light">
						<span aria-hidden="true"></span> {business.category} · {business.streetAddress} · {business.locality}
					</p>
					<h1 id="hero-title">El rincón<br /><em>de Ana.</em></h1>
					<p class="hero-lede">
						Bar restaurante en la calle los Emires de Huelva. En sus {business.reviewCount} reseñas de
						Google se repiten los pescados y mariscos, las raciones y los fritos de la casa, con una
						media de {rating}. Abre de martes a viernes en dos turnos.
					</p>
					<div class="hero-actions">
						<a class="button button-coral" href={phoneHref}>Llamar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div>
							<small>Dónde</small>
							<address>{business.streetAddress}<br />{business.postalCode} {business.locality}</address>
						</div>
						<div>
							<small>Horario</small>
							<p>Martes a viernes<br />7:30–16:00 · 21:00–23:30</p>
						</div>
					</div>
				</div>
				{
					heroFoto && (
						<figure class="hero-art">
							<div class="hero-frame">
								<Image
									class="hero-photo"
									src={heroFoto}
									alt={`Fotografía de ${business.name}, en ${business.streetAddress}, ${business.locality}`}
									widths={[420, 640, 900]}
									sizes="(max-width: 1000px) 88vw, 42vw"
									format="avif"
									quality={70}
									loading="eager"
									fetchpriority="high"
									decoding="async"
								/>
								<span class="hero-stamp">
									<strong>{rating}</strong>
									<small>{business.reviewCount} reseñas · Google</small>
								</span>
							</div>
							<figcaption class="hero-caption">Foto de la ficha de Google Maps</figcaption>
						</figure>
					)
				}
			</section>

			<div class="promise">
				<span>Pescados y mariscos frescos</span>
				<span>Fritos de la casa</span>
				<span>Raciones para compartir</span>
				<span>Martes a viernes · dos turnos</span>
			</div>

			<section class="section about" id="casa" aria-labelledby="casa-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> La casa</p>
					<h2 id="casa-title">Un bar de barrio<br />en <em>el centro.</em></h2>
				</div>
				<div class="about-copy">
					<p>
						Bar restaurante El rincón de Ana está en la calle los Emires, 1, en {business.locality}, y su
						ficha de Google Maps lo clasifica simplemente como <strong>bar restaurante</strong>. No
						declara ninguna categoría más, así que esta web tampoco se la inventa.
					</p>
					<p>
						La ficha acumula {business.reviewCount} reseñas con una media de {rating}. En ellas se repite
						el <strong>pescado fresco</strong>, se citan los <strong>calamares</strong> y los
						<strong>chocos fritos</strong> y se destaca el tamaño de las <strong>raciones</strong>. Su
						horario se parte en dos turnos: mañana y mediodía, y cena de martes a viernes.
					</p>
					<p class="note">
						Esta web es informativa y no publica carta ni precios: el negocio no los tiene publicados en
						su ficha. Llama al {business.phoneDisplay} para consultar platos del día, alérgenos y
						disponibilidad.
					</p>
				</div>
			</section>

			<section class="section carta" id="carta" aria-labelledby="carta-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Qué se come</p>
						<h2 id="carta-title">Lo que citan<br /><em>las reseñas.</em></h2>
					</div>
					<p>
						No hay carta publicada en la ficha. Esto es, literalmente, lo que se repite en las reseñas de
						Google Maps: producto fresco de mar y raciones para compartir. Todo lo demás se pregunta por
						teléfono.
					</p>
				</div>
				<div class="card-grid">
					{SPECIALTIES.map((plato, index) => (
						<article class="card">
							<small>0{index + 1}</small>
							<h3>{plato.name}</h3>
							<p>{plato.detail}</p>
						</article>
					))}
				</div>
			</section>

			<section class="section hours" id="horario" aria-labelledby="horario-title">
				<div class="hours-grid">
					<div>
						<p class="section-label eyebrow-light"><span aria-hidden="true"></span> Horario</p>
						<h2 id="horario-title">Martes a viernes,<br /><em>dos turnos.</em></h2>
						<p class="hours-intro">
							El bar abre por la mañana y al mediodía y vuelve por la noche, de martes a viernes. Lunes,
							sábado y domingo permanece cerrado. En festivos y vísperas el horario puede cambiar.
						</p>
					</div>
					<div>
						<ul class="hours-list">
							{HOURS.map((dia) => (
								<li>
									<span class="hours-day">{dia.days}</span>
									<span class={`hours-time${dia.ranges.length === 0 ? ' hours-closed' : ''}`}>
										{dia.ranges.length === 0 ? 'Cerrado' : dia.ranges.join(' · ')}
										{dia.ranges.length > 1 && <small class="hours-turns">dos turnos</small>}
									</span>
								</li>
							))}
						</ul>
						<p class="hours-note">
							Lunes, sábado y domingo cerrado. Llama al {business.phoneDisplay} para confirmar festivos y
							vísperas.
						</p>
					</div>
				</div>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="fotos-title">
				<p class="section-label"><span aria-hidden="true"></span> Fotos · ficha de Google Maps</p>
				<h2 id="fotos-title">El bar, <em>en imágenes.</em></h2>
				<p class="gallery-copy">
					Las {galeria.length} fotografías que el propio negocio publica en su ficha de Google Maps,
					servidas aquí en AVIF y varios tamaños para que carguen rápido.
				</p>
				<div class="gallery-grid">
					{galeria.map((imagen, index) => (
						<div class="gallery-photo">
							<Image
								src={imagen.src}
								alt={imagen.alt}
								widths={[320, 480, 720]}
								sizes="(max-width: 560px) 46vw, (max-width: 1000px) 46vw, 24vw"
								format="avif"
								quality={65}
								loading={index < 2 ? 'eager' : 'lazy'}
								decoding="async"
							/>
						</div>
					))}
				</div>
				<p class="gallery-note">
					Fotografías de la ficha pública de <a href={mapsUrl} target="_blank" rel="noreferrer">{business.name} en Google Maps ↗</a>.
					Las imágenes pertenecen a sus autores.
				</p>
			</section>

			<section class="section reviews" aria-labelledby="resenas-title">
				<div class="reviews-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
						<h2 id="resenas-title">Lo que cuentan<br /><em>los clientes.</em></h2>
					</div>
					<div class="reviews-score">
						{rating}
						<small>{business.reviewCount} reseñas en Google Maps</small>
					</div>
				</div>
				<div class="review-grid">
					{REVIEWS.map((texto) => (
						<blockquote class="review-card">
							<p>«{texto}»</p>
							<small>Reseña publicada en la ficha de Google Maps</small>
						</blockquote>
					))}
				</div>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visitanos-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> {business.postalCode} · {business.locality}</p>
					<h2 id="visitanos-title">Calle los<br /><em>Emires, 1.</em></h2>
					<address>{business.streetAddress}<br />{business.postalCode} {business.locality}<br />Código Plus: {business.plusCodeLocal}</address>
					<div class="contact-list">
						<div class="contact-row">
							<span class="contact-icon" aria-hidden="true">☎</span>
							<div><small>Teléfono</small><a href={phoneHref}>{business.phone}</a></div>
						</div>
						<div class="contact-row">
							<span class="contact-icon" aria-hidden="true">⌖</span>
							<div><small>Ubicación</small><a href={mapsUrl} target="_blank" rel="noreferrer">Abrir ficha de Google Maps ↗</a></div>
						</div>
						<div class="contact-row">
							<span class="contact-icon" aria-hidden="true">◷</span>
							<div><small>Horario</small><p>Martes a viernes, 7:30–16:00 y 21:00–23:30 · lunes, sábado y domingo cerrado</p></div>
						</div>
						<div class="contact-row">
							<span class="contact-icon" aria-hidden="true">↗</span>
							<div><small>Coordenadas</small><p>{business.latitude}, {business.longitude}</p></div>
						</div>
					</div>
					<p class="note">
						Si vas a comer y quieres asegurar mesa, llama antes: la ficha no publica un sistema de
						reservas y en horas punta el bar se llena.
					</p>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar</a>
					</div>
				</div>
				<div class="map-card">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
						title={`Mapa de ${business.name} en ${business.streetAddress}, ${business.locality}`}
					 src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<div class="map-label">
						<div>
							<strong>{business.name}</strong>
							<small>{business.streetAddress} · {business.postalCode} {business.locality}</small>
						</div>
						<a href={directionsUrl} target="_blank" rel="noreferrer">Indicaciones ↗</a>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="preguntas-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="preguntas-title">Antes de <em>ir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
				<span class="brand-mark" aria-hidden="true">A</span>
				<span class="brand-copy">El rincón de Ana<small>{business.category} · {business.locality}</small></span>
			</a>
			<p>{address}<br />Teléfono: {business.phone}<br />Código Plus: {business.plusCodeLocal}</p>
			<nav class="footer-nav" aria-label="Enlaces de la ficha">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} {business.name} · {business.locality}. Confirma horarios, platos y precios por teléfono.</small>
		</footer>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
		<a class="mobile-call" href={phoneHref}>Llamar al bar <span>{business.phoneDisplay}</span></a>
		<WhatsappFab phone={datos.phoneHref} name={datos.business?.name} />
	</body>
</html>


