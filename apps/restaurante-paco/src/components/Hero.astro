---
import { Image } from 'astro:assets';
import { BUSINESS, IMAGES } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
const media = Math.round(BUSINESS.rating * 2) / 2;
---

<section id="inicio" class="hero-paco relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.fotoPatio}
			alt=""
			widths={[640, 1100, 1600]}
			sizes="100vw"
			quality={70}
			loading="eager"
			fetchpriority="high"
			class="h-full w-full object-cover opacity-25"
		/>
		<div class="from-neutral/95 via-neutral/80 absolute inset-0 bg-gradient-to-r"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
		<div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
			<div>
				<p
					class="text-accent inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase"
				>
					<span><i class="ri-restaurant-2-line"></i> Restaurante</span>
					<span class="text-white/50">Santa Cruz · Murcia</span>
				</p>

				<h1 class="font-display mt-4 text-6xl leading-[0.9] font-bold sm:text-7xl lg:text-8xl">
					<span class="text-accent">P</span>aco
				</h1>
				<p class="font-display text-accent mt-2 text-xl sm:text-2xl">Cocina y celebraciones</p>

				<p class="mt-6 max-w-xl text-base leading-relaxed text-white/80 sm:text-lg">
					Un restaurante de cocina española y salón de celebraciones en Santa Cruz, a las
					afueras de Murcia. Comida de mediodía, cenas los viernes y sábados y una casa
					preparada para bodas, bautizos y comidas de grupo.
				</p>

				<div class="mt-7 flex flex-wrap items-center gap-3">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="badge badge-lg gap-2 border-white/20 bg-white/10 px-4 py-3 text-sm font-semibold text-white"
					>
						<span class="text-accent tracking-tight" aria-hidden="true">
							{
								estrellas.map((n) => (
									<i
										class={
											n <= media
												? 'ri-star-fill'
												: n - media === 0.5
													? 'ri-star-half-fill'
													: 'ri-star-line'
										}
									/>
								))
							}
						</span>
						{BUSINESS.rating.toString().replace('.', ',')} · {BUSINESS.reviewCount} reseñas en Google
					</a>
				</div>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-accent btn-lg gap-2 rounded-full">
						<i class="ri-phone-line text-xl"></i>
						{BUSINESS.phone}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-lg gap-2 rounded-full border-white/35 bg-transparent text-white hover:border-white hover:bg-white hover:text-neutral"
					>
						<i class="ri-google-fill"></i>
						Ver ficha de Google
					</a>
				</div>

				<dl class="mt-10 grid gap-x-6 gap-y-5 border-t border-white/15 pt-7 sm:grid-cols-3">
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Mediodía</dt>
						<dd class="mt-1 text-base font-bold">10:00 – 17:00</dd>
						<dd class="text-xs text-white/55">Lun, mar, mié y dom</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Cenas</dt>
						<dd class="mt-1 text-base font-bold">20:00 – 23:00</dd>
						<dd class="text-xs text-white/55">Viernes y sábado</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Dónde</dt>
						<dd class="mt-1 text-base font-bold">Carril Palmeral, 1</dd>
						<dd class="text-xs text-white/55">30162 Santa Cruz · Murcia</dd>
					</div>
				</dl>
				<p class="mt-4 flex items-center gap-2 text-xs text-white/55">
					<i class="ri-information-line"></i>
					Jueves cerrado · Viernes, cena hasta las 23:30
				</p>
			</div>

			<figure class="relative mx-auto w-full max-w-md lg:max-w-none">
				<div class="border-accent/40 absolute -inset-2 rotate-2 rounded-2xl border"></div>
				<div class="relative grid grid-cols-5 gap-3">
					<div class="col-span-3 overflow-hidden rounded-2xl shadow-2xl">
						<Image
							src={IMAGES.fotoPaella}
							alt="Paella de marisco con langostinos de Restaurante Paco"
							widths={[360, 620]}
							sizes="(min-width: 1024px) 22vw, 55vw"
							quality={85}
							loading="eager"
							class="foto-calida aspect-[3/4] w-full object-cover"
						/>
					</div>
					<div class="col-span-2 flex flex-col gap-3">
						<div class="overflow-hidden rounded-2xl shadow-xl">
							<Image
								src={IMAGES.fotoEntrantes}
								alt="Entrantes y aperitivos en la mesa de Restaurante Paco"
								widths={[260, 440]}
								sizes="(min-width: 1024px) 15vw, 38vw"
								quality={85}
								loading="lazy"
								class="foto-calida aspect-square w-full object-cover"
							/>
						</div>
						<div
							class="sello-paco bg-primary/85 flex flex-1 flex-col items-center justify-center rounded-full px-3 py-6 text-center"
						>
							<i class="ri-goblet-line text-accent text-3xl" aria-hidden="true"></i>
							<span class="font-display text-accent mt-1 text-2xl leading-none font-bold">Salón</span>
							<span class="mt-2 text-[0.6rem] leading-tight tracking-[0.14em] text-white/70 uppercase">
								celebraciones<br />y grupos
							</span>
						</div>
					</div>
				</div>
				<figcaption
					class="text-accent-content bg-accent mt-5 inline-flex items-center gap-2 rounded-full px-4 py-2 text-xs font-bold shadow-lg"
				>
					<i class="ri-map-pin-line"></i> Santa Cruz, Murcia
				</figcaption>
			</figure>
		</div>
	</div>

	<div class="cenefa-paco relative h-2 w-full"></div>
</section>
