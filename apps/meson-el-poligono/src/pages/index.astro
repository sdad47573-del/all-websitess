---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/meson-el-poligono-vista-1-01.jpg';
import fachadaNoche from '../assets/fotos/meson-el-poligono-vertical-02.jpg';
import paella from '../assets/fotos/meson-el-poligono-vertical-03.jpg';
import postal from '../assets/fotos/meson-el-poligono-panoramica-04.jpg';
import fachadaDia from '../assets/fotos/meson-el-poligono-vertical-05.jpg';
import tarta from '../assets/fotos/meson-el-poligono-vertical-06.jpg';
import revuelto from '../assets/fotos/meson-el-poligono-vertical-07.jpg';
import costillas from '../assets/fotos/meson-el-poligono-apaisada-08.jpg';
import cafe from '../assets/fotos/meson-el-poligono-vertical-09.jpg';
import cerveza from '../assets/fotos/meson-el-poligono-vertical-10.jpg';

import { AVISO_FOTOS, BUSINESS, FAQ, HORARIO, HORARIO_AVISO, MAPS, SERVICIOS } from '../data/site';

const title = 'Mesón El Polígono · Bar restaurante en Miguelturra';
const description = BUSINESS.description;

const galeria = [
	{
		src: comedor,
		alt: 'Comedor del mesón con mesas de mantel rojo y la pizarra de raciones y tapas pintada en la pared',
	},
	{
		src: fachadaNoche,
		alt: 'Fachada de noche con el letrero de Mesón El Polígono, la sombrilla de la terraza y las jardineras',
	},
	{
		src: paella,
		alt: 'Paella de marisco con langostinos y mejillones en la paellera, recién hecha',
	},
	{
		src: postal,
		alt: 'Cartel del mesón con Don Quijote y Sancho Panza sobre una vista de Miguelturra y el lema «A buen hambre no hay pan duro»',
	},
	{
		src: fachadaDia,
		alt: 'Fachada de día con el toldo, la terraza acristalada y el cartel del teléfono sobre la puerta',
	},
	{
		src: tarta,
		alt: 'Tarta de tres chocolates con nata montada y sirope servida en plato blanco',
	},
	{
		src: revuelto,
		alt: 'Revuelto de huevos con jamón en plato hondo sobre mantel rojo',
	},
	{
		src: costillas,
		alt: 'Bandeja de chuletillas de cordero asadas, recién sacadas del horno',
	},
	{
		src: cafe,
		alt: 'Café solo en taza blanca con el sobre de azúcar de la casa en el plato',
	},
	{
		src: cerveza,
		alt: 'Botellín de cerveza frío sobre la mesa de la terraza, con el palillero al lado',
	},
];

const carta = [
	{
		title: 'Raciones de la pizarra',
		items: [
			{ name: 'Carne a la plancha', note: 'de la pizarra de raciones' },
			{ name: 'Carne con tomate', note: 'guiso de la casa' },
			{ name: 'Carne de monte', note: 'según temporada' },
			{ name: 'Caldera', note: 'de la pizarra de raciones' },
			{ name: 'Lomo con berenjena', note: 'de la pizarra de raciones' },
			{ name: 'Albóndigas', note: 'en salsa' },
			{ name: 'Patatas a lo pobre', note: 'de la pizarra de raciones' },
			{ name: 'Alpargatas', note: 'de la pizarra de raciones' },
			{ name: 'Picadillo de chorizos', note: 'de la pizarra de raciones' },
		],
	},
	{
		title: 'Del mar y del horno',
		items: [
			{ name: 'Paella de marisco', note: 'con langostinos y mejillones, por encargo' },
			{ name: 'Bacalao', note: 'de la pizarra de raciones' },
			{ name: 'Calamares', note: 'de la pizarra de raciones' },
			{ name: 'Patatas en caldo con almejas', note: 'citada en las reseñas de Google' },
			{ name: 'Chuletillas de cordero', note: 'a la brasa, en bandeja' },
			{ name: 'Revuelto de huevos con jamón', note: 'de la pizarra de la casa' },
		],
	},
	{
		title: 'Tapas, panes y desayunos',
		items: [
			{ name: 'Hamburguesas', note: 'de la pizarra de raciones' },
			{ name: 'Perritos', note: 'de la pizarra de raciones' },
			{ name: 'Sándwich', note: 'de la pizarra de raciones' },
			{ name: 'Pinchos de pollo', note: 'de la pizarra de raciones' },
			{ name: 'Patatas bravas', note: 'para picar' },
			{ name: 'Café y desayunos', note: 'desde primera hora de la mañana' },
			{ name: 'Tarta de tres chocolates', note: 'postre de la casa' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#meson-el-poligono`,
	name: BUSINESS.name,
	alternateName: ['El Polígono Miguelturra', 'Mesón El Polígono Miguelturra', 'Bar El Polígono'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina casera', 'Tapas', 'Paella'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Miguelturra' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Feature ID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Código', value: '/g/11hbqck1h7' },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '06:30',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Entrada adaptada', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const resenas = [
	'Un buen sitio, muy agradable la camarera, buenas cervezas y muy buenas tapas.',
	'Las patatas en caldo con almejas estaban deliciosas.',
	'Bien atendidos, rápidos y muy buena cocina.',
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#12160f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,700&family=Nunito+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Mesón El Polígono Miguelturra, bar restaurante Miguelturra, menú del día Miguelturra, tapas Polígono La Estrella, comer en Miguelturra, C. Segadores 2 Miguelturra, paella por encargo Miguelturra, bar de brunch Ciudad Real"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Bar restaurante en la calle Segadores, 2, Polígono la Estrella, 13170 Miguelturra. Desayunos, raciones, tapas y menú del día de 6:30 a 16:00, de lunes a sábado; domingo cerrado. Teléfono 926 09 02 23."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Mesón El Polígono, bar restaurante en Miguelturra"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#12160f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CR"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Miguelturra"
			preload={[costillas]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Mesón El Polígono"
			subtitle="Bar restaurante · Miguelturra"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · Polígono la Estrella`}
				title="El mesón <br /><em>del polígono.</em>"
				lede="Mesón El Polígono es un bar restaurante de Miguelturra, en la calle Segadores, 2, en pleno Polígono la Estrella. Desayunos desde primera hora, raciones y tapas al mediodía y menú del día, de 6:30 a 16:00 de lunes a sábado, con el domingo cerrado. Se come en la mesa del comedor o en la terraza, y se llama al 926 09 02 23."
				image={costillas}
				imageAlt="Bandeja de chuletillas de cordero asadas, recién sacadas del horno"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,7</b> en Google · 259 reseñas' },
					{ label: 'Horario', html: '<b>6:30–16:00</b><br />Lunes a sábado · domingo cerrado' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b><br />Para mesas y encargos` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Mesón El Polígono" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Comer bien <br /><em>en el polígono.</em>"
				paragraphs={[
					'El local está en la calle Segadores, 2, en el Polígono la Estrella de Miguelturra, con el edificio blanco de dos plantas y la terraza acristalada delante. El letrero de «Mesón El Polígono» se ve desde la acera, con la sombrilla de la cerveza y las jardineras separando la terraza de la calle.',
					'Dentro manda el comedor: manteles rojos, sillas de madera y una pizarra pintada en la pared con la carta de raciones y tapas. Ahí están la carne a la plancha, la carne con tomate, la carne de monte, la caldera, el lomo con berenjena, las albóndigas, las patatas a lo pobre, las alpargatas, el picadillo de chorizos, las hamburguesas, los perritos, el sándwich, los calamares, el bacalao, los pinchos de pollo y las patatas bravas. Esa pizarra es el origen de la carta de esta página.',
					'La ficha de Google lo clasifica como bar restaurante y bar de brunch, y el horario lo confirma: se abre a las 6:30, así que hay desayunos desde primera hora, y se cierra a las 16:00, con el domingo cerrado. La propia ficha avisa de que en el Día de Todos los Santos el local está cerrado.',
					'La valoración publicada es de 4,7 sobre 5 con 259 reseñas. Las citas de esta página son las que Google destaca de su ficha, y hablan del trato, de las tapas, de la cerveza y de las patatas en caldo con almejas.',
				]}
				note="La ficha de Google no publica la carta con precios. Los platos que figuran aquí salen de la pizarra pintada en el comedor y de las fotos del propio perfil: si algo no está ese día, manda la cocina."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Raciones, tapas <br /><em>y paella.</em>"
				description="Lo que cuelga de la pizarra del comedor, lo que se ve en las fotos del perfil y lo que citan las reseñas: raciones de cuchara, plancha, fritos, panes y postre de la casa."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={carta}
				note="Platos copiados de la pizarra pintada en la pared del comedor y de las fotos del perfil de Google Maps. La ficha no publica precios: se consultan en el local o llamando al 926 09 02 23. La paella y los guisos de encargo conviene pedirlos con antelación."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
					<div class="reviews-head">
						<h2 id="resenas-title">Buenas tapas, <br /><em>buen trato.</em></h2>
						<p>
							La ficha tiene 259 reseñas y una media de 4,7 sobre 5. Estas son tres de las que Google
							destaca, copiadas tal cual; en la ficha están todas, también las que puntúan por debajo.
						</p>
					</div>
					<div class="review-grid">
						{
							resenas.map((quote) => (
								<figure class="review-card">
									<blockquote>{quote}</blockquote>
									<figcaption>Reseña publicada en Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="review-note">
						Citas de las reseñas públicas del local. Lee todas, con su puntuación y su fecha, en la
						ficha de Google; esta página no cambia ni resume el texto de nadie.
					</p>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor <br /><em>y la mesa.</em>"
				description="Diez fotos del perfil del local: el comedor con la pizarra de la carta, la fachada de día y de noche con la terraza, la paella, las chuletillas, el revuelto, el postre y la postal de Miguelturra que preside el mesón."
				images={galeria}
				cta={{ label: 'Ver todas en Google Maps', href: MAPS.place }}
				note={AVISO_FOTOS}
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="De desayuno <br /><em>a la sobremesa.</em>"
				addressLines={[BUSINESS.street, 'Polígono la Estrella', `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Ciudad Real · España']}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de Mesón El Polígono en la calle Segadores, 2, Miguelturra"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Mesón El Polígono"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="No hay reservas online ni esta página las tramita: las mesas se piden en el local o por teléfono, en el 926 09 02 23. La ficha marca entrada, aseo, aparcamiento y asientos accesibles para sillas de ruedas. Al estar en un polígono, se aparca en la calle."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Mesón El Polígono"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.place, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos, horario y fotografías tomados de la ficha y del perfil públicos del local en Google Maps, consultados en noviembre de 2026. La ficha no publica carta ni precios: confirma horario y disponibilidad antes de ir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Mesón El Polígono"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
