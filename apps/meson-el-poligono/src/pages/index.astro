---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import comedor from '../assets/fotos/meson-el-poligono-vista-1-01.jpg';
import fachadaNoche from '../assets/fotos/meson-el-poligono-vertical-02.jpg';
import paella from '../assets/fotos/meson-el-poligono-vertical-03.jpg';
import postal from '../assets/fotos/meson-el-poligono-panoramica-04.jpg';
import fachadaDia from '../assets/fotos/meson-el-poligono-vertical-05.jpg';
import tarta from '../assets/fotos/meson-el-poligono-vertical-06.jpg';
import revuelto from '../assets/fotos/meson-el-poligono-vertical-07.jpg';
import costillas from '../assets/fotos/meson-el-poligono-apaisada-08.jpg';
import cafe from '../assets/fotos/meson-el-poligono-vertical-09.jpg';
import cerveza from '../assets/fotos/meson-el-poligono-vertical-10.jpg';

import {
	AVISO_FOTOS,
	BUSINESS,
	FAQ,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	SERVICIOS,
} from '../data/site';

const title = 'Mesón El Polígono · Bar restaurante en Miguelturra';
const description = BUSINESS.description;

const galeria = [
	{
		src: comedor,
		alt: 'Comedor del mesón con mesas de mantel rojo y la pizarra de raciones y tapas pintada en la pared',
	},
	{
		src: fachadaNoche,
		alt: 'Fachada de noche con el letrero de Mesón El Polígono, la sombrilla de la terraza y las jardineras',
	},
	{
		src: paella,
		alt: 'Paella de marisco con langostinos y mejillones en la paellera, recién hecha',
	},
	{
		src: postal,
		alt: 'Cartel del mesón con Don Quijote y Sancho Panza sobre una vista de Miguelturra y el lema «A buen hambre no hay pan duro»',
	},
	{
		src: fachadaDia,
		alt: 'Fachada de día con el toldo, la terraza acristalada y el cartel del teléfono sobre la puerta',
	},
	{
		src: tarta,
		alt: 'Tarta de tres chocolates con nata montada y sirope servida en plato blanco',
	},
	{
		src: revuelto,
		alt: 'Revuelto de huevos con jamón en plato hondo sobre mantel rojo',
	},
	{
		src: costillas,
		alt: 'Bandeja de chuletillas de cordero asadas, recién sacadas del horno',
	},
	{
		src: cafe,
		alt: 'Café solo en taza blanca con el sobre de azúcar de la casa en el plato',
	},
	{
		src: cerveza,
		alt: 'Botellín de cerveza frío sobre la mesa de la terraza, con el palillero al lado',
	},
];

const carta = [
	{
		title: 'Raciones de la pizarra',
		items: [
			{ name: 'Carne a la plancha', note: 'de la pizarra de raciones' },
			{ name: 'Carne con tomate', note: 'guiso de la casa' },
			{ name: 'Carne de monte', note: 'según temporada' },
			{ name: 'Caldera', note: 'de la pizarra de raciones' },
			{ name: 'Lomo con berenjena', note: 'de la pizarra de raciones' },
			{ name: 'Albóndigas', note: 'en salsa' },
			{ name: 'Patatas a lo pobre', note: 'de la pizarra de raciones' },
			{ name: 'Alpargatas', note: 'de la pizarra de raciones' },
			{ name: 'Picadillo de chorizos', note: 'de la pizarra de raciones' },
		],
	},
	{
		title: 'Del mar y del horno',
		items: [
			{ name: 'Paella de marisco', note: 'con langostinos y mejillones, por encargo' },
			{ name: 'Bacalao', note: 'de la pizarra de raciones' },
			{ name: 'Calamares', note: 'de la pizarra de raciones' },
			{ name: 'Patatas en caldo con almejas', note: 'citada en las reseñas de Google' },
			{ name: 'Chuletillas de cordero', note: 'a la brasa, en bandeja' },
			{ name: 'Revuelto de huevos con jamón', note: 'de la pizarra de la casa' },
		],
	},
	{
		title: 'Tapas, panes y desayunos',
		items: [
			{ name: 'Hamburguesas', note: 'de la pizarra de raciones' },
			{ name: 'Perritos', note: 'de la pizarra de raciones' },
			{ name: 'Sándwich', note: 'de la pizarra de raciones' },
			{ name: 'Pinchos de pollo', note: 'de la pizarra de raciones' },
			{ name: 'Patatas bravas', note: 'para picar' },
			{ name: 'Café y desayunos', note: 'desde primera hora de la mañana' },
			{ name: 'Tarta de tres chocolates', note: 'postre de la casa' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#meson-el-poligono`,
	name: BUSINESS.name,
	alternateName: ['El Polígono Miguelturra', 'Mesón El Polígono Miguelturra', 'Bar El Polígono'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina casera', 'Tapas', 'Paella'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Miguelturra' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Feature ID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Código', value: '/g/11hbqck1h7' },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '06:30',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Entrada adaptada', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const resenas = [
	'Un buen sitio, muy agradable la camarera, buenas cervezas y muy buenas tapas.',
	'Las patatas en caldo con almejas estaban deliciosas.',
	'Bien atendidos, rápidos y muy buena cocina.',
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"meson-el-poligono-apaisada-08.jpg": costillas,
	"meson-el-poligono-vista-1-01.jpg": comedor,
	"meson-el-poligono-vertical-02.jpg": fachadaNoche,
	"meson-el-poligono-vertical-03.jpg": paella,
	"meson-el-poligono-panoramica-04.jpg": postal,
	"meson-el-poligono-vertical-05.jpg": fachadaDia,
	"meson-el-poligono-vertical-06.jpg": tarta,
	"meson-el-poligono-vertical-07.jpg": revuelto,
	"meson-el-poligono-vertical-09.jpg": cafe,
	"meson-el-poligono-vertical-10.jpg": cerveza,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#12160f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,700&family=Nunito+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Mesón El Polígono Miguelturra, bar restaurante Miguelturra, menú del día Miguelturra, tapas Polígono La Estrella, comer en Miguelturra, C. Segadores 2 Miguelturra, paella por encargo Miguelturra, bar de brunch Ciudad Real"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Bar restaurante en la calle Segadores, 2, Polígono la Estrella, 13170 Miguelturra. Desayunos, raciones, tapas y menú del día de 6:30 a 16:00, de lunes a sábado; domingo cerrado. Teléfono 926 09 02 23."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Mesón El Polígono, bar restaurante en Miguelturra"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#12160f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CR"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Miguelturra"
			preload={[costillas]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Mesón El Polígono"
			subtitle="Bar restaurante · Miguelturra"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Mesón El Polígono"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.place, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos, horario y fotografías tomados de la ficha y del perfil públicos del local en Google Maps, consultados en noviembre de 2026. La ficha no publica carta ni precios: confirma horario y disponibilidad antes de ir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Mesón El Polígono"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34926090223?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carne%20a%20la%20plancha." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carne a la plancha"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
