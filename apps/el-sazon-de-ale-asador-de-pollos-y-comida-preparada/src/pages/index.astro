---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-01.jpg';
import alitas from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-02.jpg';
import ensaladaCol from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-03.jpg';
import cesar from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-04.jpg';
import ensaladaTomate from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-05.jpg';
import fachadaPizarra from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-06.jpg';
import pasta from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-07.jpg';
import arroz from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-09.jpg';
import fideos from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-10.jpg';
import vitrina from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-cuadrada-08.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'El Sazón de Ale · Asador de pollos en Chamartín';
const description =
	'El Sazón de Ale, en Calle de Zabaleta, 7 bis (28002 Madrid, Chamartín). Asador de pollos y comida casera para llevar: pollo asado, paella, croquetas y ensaladas.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de El Sazón de Ale en la calle de Zabaleta, 7 bis, con el rótulo y la pizarra en la acera',
	},
	{
		src: vitrina,
		alt: 'La vitrina de El Sazón de Ale con las bandejas de tortilla, croquetas, empanadillas, callos, pollo rebozado y ensaladas',
	},
	{
		src: alitas,
		alt: 'Una bandeja de alitas de pollo asadas en su jugo',
	},
	{
		src: arroz,
		alt: 'Una tarrina para llevar con arroz y langostinos',
	},
	{
		src: fideos,
		alt: 'Una bandeja de fideos con marisco, almejas y langostinos',
	},
	{
		src: pasta,
		alt: 'Una bandeja de pasta con nata y bacon',
	},
	{
		src: cesar,
		alt: 'Una ensalada César con tiras de pollo empanado y picatostes',
	},
	{
		src: ensaladaCol,
		alt: 'Una ensalada de col, jamón y maíz con una rama de perejil',
	},
	{
		src: ensaladaTomate,
		alt: 'Una ensalada de tomate, huevo cocido, pepino, cebolla y aceitunas negras',
	},
	{
		src: fachadaPizarra,
		alt: 'La fachada lateral de El Sazón de Ale con la pizarra del menú en la acera',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Platos de El Sazón de Ale',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-sazon-de-ale`,
	name: BUSINESS.fullName,
	alternateName: ['El Sazón de Ale Madrid', 'El Sazón de Ale Chamartín', 'El Sazón de Ale Zabaleta'],
	description:
		'Asador de pollos y comida casera para llevar en la calle de Zabaleta, 7 bis (Chamartín, 28002 Madrid), con género fresco y de primera.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34624414604',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Comida casera', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Chamartín' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El asador', href: '#casa' },
	{ label: 'La vitrina', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-01.jpg": fachada,
	"el-sazon-de-ale-asador-de-pollos-y-comida-preparada-cuadrada-08.jpg": vitrina,
	"el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-02.jpg": alitas,
	"el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-09.jpg": arroz,
	"el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-10.jpg": fideos,
	"el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-07.jpg": pasta,
	"el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-04.jpg": cesar,
	"el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-03.jpg": ensaladaCol,
	"el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-05.jpg": ensaladaTomate,
	"el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-06.jpg": fachadaPizarra,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f2a24" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Karla:wght@400;500;700&family=Playfair+Display:wght@400..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Sazón de Ale Madrid, asador de pollos Chamberí, pollo asado Chamartín, comida casera para llevar Zabaleta, paella para llevar Madrid, croquetas caseras Chamartín"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Asador de pollos y comida casera para llevar en la calle de Zabaleta, 7 bis (Chamartín). Pollo asado, paella, croquetas y ensaladas. Todos los días de 9:00 a 16:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de El Sazón de Ale en la calle de Zabaleta, 7 bis"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2f2a24"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Chamartín"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Sazón de Ale"
			subtitle="Asador de pollos · Chamartín"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma platos y horario antes de la visita."
			ctaLabel="Llamar a El Sazón de Ale"
			navAriaLabel="Enlaces de El Sazón de Ale"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34624414604?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Platos%20de%20El%20Saz%C3%B3n%20de%20Ale." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Platos de El Sazón de Ale"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
