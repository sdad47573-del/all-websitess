---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-01.jpg';
import alitas from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-02.jpg';
import ensaladaCol from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-03.jpg';
import cesar from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-04.jpg';
import ensaladaTomate from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-05.jpg';
import fachadaPizarra from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-06.jpg';
import pasta from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-07.jpg';
import arroz from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-09.jpg';
import fideos from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-apaisada-10.jpg';
import vitrina from '../assets/fotos/el-sazon-de-ale-asador-de-pollos-y-comida-preparada-cuadrada-08.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'El Sazón de Ale · Asador de pollos en Chamartín';
const description =
	'El Sazón de Ale, en Calle de Zabaleta, 7 bis (28002 Madrid, Chamartín). Asador de pollos y comida casera para llevar: pollo asado, paella, croquetas y ensaladas.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de El Sazón de Ale en la calle de Zabaleta, 7 bis, con el rótulo y la pizarra en la acera',
	},
	{
		src: vitrina,
		alt: 'La vitrina de El Sazón de Ale con las bandejas de tortilla, croquetas, empanadillas, callos, pollo rebozado y ensaladas',
	},
	{
		src: alitas,
		alt: 'Una bandeja de alitas de pollo asadas en su jugo',
	},
	{
		src: arroz,
		alt: 'Una tarrina para llevar con arroz y langostinos',
	},
	{
		src: fideos,
		alt: 'Una bandeja de fideos con marisco, almejas y langostinos',
	},
	{
		src: pasta,
		alt: 'Una bandeja de pasta con nata y bacon',
	},
	{
		src: cesar,
		alt: 'Una ensalada César con tiras de pollo empanado y picatostes',
	},
	{
		src: ensaladaCol,
		alt: 'Una ensalada de col, jamón y maíz con una rama de perejil',
	},
	{
		src: ensaladaTomate,
		alt: 'Una ensalada de tomate, huevo cocido, pepino, cebolla y aceitunas negras',
	},
	{
		src: fachadaPizarra,
		alt: 'La fachada lateral de El Sazón de Ale con la pizarra del menú en la acera',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Platos de El Sazón de Ale',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-sazon-de-ale`,
	name: BUSINESS.fullName,
	alternateName: ['El Sazón de Ale Madrid', 'El Sazón de Ale Chamartín', 'El Sazón de Ale Zabaleta'],
	description:
		'Asador de pollos y comida casera para llevar en la calle de Zabaleta, 7 bis (Chamartín, 28002 Madrid), con género fresco y de primera.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34624414604',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Comida casera', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Chamartín' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El asador', href: '#casa' },
	{ label: 'La vitrina', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f2a24" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Karla:wght@400;500;700&family=Playfair+Display:wght@400..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Sazón de Ale Madrid, asador de pollos Chamberí, pollo asado Chamartín, comida casera para llevar Zabaleta, paella para llevar Madrid, croquetas caseras Chamartín"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Asador de pollos y comida casera para llevar en la calle de Zabaleta, 7 bis (Chamartín). Pollo asado, paella, croquetas y ensaladas. Todos los días de 9:00 a 16:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de El Sazón de Ale en la calle de Zabaleta, 7 bis"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2f2a24"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Chamartín"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Sazón de Ale"
			subtitle="Asador de pollos · Chamartín"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Calle de Zabaleta, 7 bis · Chamartín, Madrid"
				title="Pollo asado <br /><em>y comida de casa.</em>"
				lede={`El Sazón de Ale es un asador de pollos y una tienda de comida casera en la calle de Zabaleta. En la vitrina esperan la tortilla, las croquetas de jamón, los chopitos, los callos, la pasta, los arroces y las ensaladas, todo con género fresco y solo para llevar. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas, y abre todos los días de 9:00 a 16:00.`}
				image={fachada}
				imageAlt="La fachada de El Sazón de Ale en la calle de Zabaleta, 7 bis, con el rótulo y la pizarra en la acera"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>9:00–16:00</b> · todos los días' },
					{ label: 'Servicio', html: '<b>Solo para llevar</b> · comida casera' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Asador de pollos"
			/>

			<LocalChips label="Lo que ofrece El Sazón de Ale" items={SERVICIOS} />

			<LocalAbout
				label="El asador"
				title="Zabaleta, 7 bis. <br /><em>Solo para llevar.</em>"
				paragraphs={[
					'El Sazón de Ale está en la calle de Zabaleta, 7 bis, local, en el distrito de Chamartín. La fachada es de ladrillo y el rótulo ocupa todo el escaparate: «El Sazón de Ale». En la acera, una pizarra anuncia el menú del día.',
					'La ficha lo describe así: «asador de pollos y comida casera usando género fresco y de primera, solo para llevar». En la vitrina se alinean las bandejas de tortilla de patatas, croquetas de jamón, empanadillas, chopitos encebollados, callos con garbanzos, pastas, pollo rebozado y ensaladas.',
					'Las fotos del perfil enseñan también las alitas de pollo asadas en su jugo, la pasta con nata y bacon, los fideos con marisco, una tarrina de arroz con langostinos y tres ensaladas: César, de col y jamón, y de tomate con huevo.',
					`Las reseñas insisten en la comida casera y en el trato: «deliciosa comida casera, súper amables». La ficha le da ${RATING.label} sobre 5 con ${RATING.count} opiniones (octubre de 2026), abre todos los días de 9:00 a 16:00 y atiende los pedidos en el ${BUSINESS.phone}.`,
				]}
				note="La ficha no publica carta ni precios. Los platos de esta página son los que aparecen en la descripción del local, en las etiquetas de la vitrina y en las fotos del perfil de Google; pregunta por teléfono qué hay cada día y cuánto cuesta."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Del asador a la vitrina</p>
					<h2 id="highlights-title">Pollo, arroces <br /><em>y ensaladas.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La vitrina"
				title="Lo que hay <br /><em>en el mostrador.</em>"
				description="La ficha no publica una carta, pero la vitrina sí enseña sus etiquetas: tortilla, croquetas, empanadillas, chopitos, callos, pastas y ensaladas. Estos son los platos que aparecen en las fotos del perfil."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Sin precios publicados en la ficha: las etiquetas del mostrador cambian de un día para otro. Llama al 624 41 46 04 para saber qué hay, cuánto cuesta y si queda pollo asado."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La fachada, la vitrina <br /><em>y los platos.</em>"
				description="Diez fotografías del perfil de El Sazón de Ale en Google Maps: la fachada, la vitrina con sus etiquetas, las alitas, el arroz con langostinos, los fideos con marisco, la pasta, tres ensaladas y la pizarra del menú."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,6 sobre 5, <em>con 22 reseñas.</em></h2>
						<p>
							Google publica una media de 4,6 con 22 opiniones (octubre de 2026). Las reseñas
							que se ven aquí hablan de la paella, de la comida casera y del trato con los
							clientes.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,6</strong>
						<span>★★★★☆</span>
						<small>22 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En Chamartín, <br /><em>Zabaleta 7 bis.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: todos los días, de 9:00 a 16:00. ${HORARIO_AVISO}`}
				mapTitle="Mapa de El Sazón de Ale en la calle de Zabaleta, 7 bis, Chamartín, Madrid"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Zabaleta, 7 bis · Chamartín"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos y consultas por teléfono: la ficha no publica reservas, pedidos online ni reparto a domicilio, y el servicio es solo para llevar. Tampoco indica que la entrada sea accesible y avisa de que no hay aparcamiento adaptado."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma platos y horario antes de la visita."
			ctaLabel="Llamar a El Sazón de Ale"
			navAriaLabel="Enlaces de El Sazón de Ale"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
