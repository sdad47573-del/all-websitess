---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES } from '../data/site';
---

<section id="inicio" class="hero-astyle relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.fotoFachada}
			alt="The Merced Barber's, barbería en La Merced (Málaga)"
			widths={[600, 1000]}
			sizes="100vw"
			quality={78}
			loading="eager"
			fetchpriority="high"
			class="h-full w-full object-cover opacity-30"
		/>
		<div class="from-neutral/90 via-neutral/40 absolute inset-0 bg-gradient-to-r"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-32">
		<div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
			<div>
				<p
					class="text-accent inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase"
				>
					<span><i class="ri-map-pin-line"></i> La Merced · {BUSINESS.city}</span>
					<span class="text-white/60">Barbería · {BUSINESS.ratingBizoo} de valoración</span>
				</p>
				<h1 class="font-display mt-4 text-5xl leading-[1.05] font-bold sm:text-6xl lg:text-7xl">
					The Merced Barber's<br />
					<span class="text-accent">corte y barba en La Merced</span>
				</h1>
				<p class="mt-3 text-xl font-semibold text-white/85 sm:text-2xl">
					Barbería en Calle San Juan de Letrán, 2, Local 36
				</p>
				<p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80">
					Barbería en
					<strong class="text-white">Calle San Juan de Letrán, 2, Local 36</strong>
					(29012 Málaga). Corte, barba y afeitado clásico a navaja. Precio a consultar: reserva por WhatsApp o llama al
					<a class="text-white underline" href={BUSINESS.phoneHref}>{BUSINESS.phoneDisplay}</a>.
				</p>

				<div class="mt-8 flex flex-wrap gap-3">
					<a
						href={BUSINESS.whatsapp}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-accent btn-lg gap-2 rounded-full"
					>
						<i class="ri-calendar-check-line"></i>
						Reservar en WhatsApp
					</a>
					<a
						href={BUSINESS.phoneHref}
						class="btn btn-outline btn-lg hover:text-neutral rounded-full border-white/40 bg-white/5 text-white hover:border-white hover:bg-white"
					>
						<i class="ri-phone-line"></i> {BUSINESS.phoneDisplay}
					</a>
				</div>

				<dl class="mt-10 grid max-w-lg grid-cols-3 gap-x-6 gap-y-5">
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Valoración</dt>
						<dd class="mt-1 text-xl font-bold">{BUSINESS.ratingBizoo} ★</dd>
					</div>
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Horario</dt>
						<dd class="mt-1 text-xl font-bold">L-S 10–20</dd>
					</div>
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Reserva</dt>
						<dd class="mt-1 text-xl font-bold">WhatsApp</dd>
					</div>
				</dl>
				<p class="mt-4 text-xs text-white/55">
					Calle San Juan de Letrán, 2, Local 36 · La Merced · 29012 Málaga · L-S 10:00–20:00
				</p>
			</div>

			<figure class="relative hidden lg:block">
				<div class="rotate-2 overflow-hidden rounded-sm shadow-2xl ring-1 ring-white/15">
					<Image
						src={IMAGES.fotoCejas}
						alt="Corte caballero en The Merced Barber's (Málaga)"
						widths={[500, 900]}
						sizes="(min-width: 1024px) 36vw, 90vw"
						quality={86}
						loading="eager"
						class="aspect-[4/5] w-full object-cover"
					/>
				</div>
				<figcaption
					class="text-accent bg-neutral absolute -bottom-5 -left-4 rounded-sm px-5 py-3 text-lg font-bold shadow-xl"
				>
					La Merced · Centro
				</figcaption>
			</figure>
		</div>
	</div>
</section>
