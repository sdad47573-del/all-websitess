---
/**
 * Adaptador: el botón flotante vive en `LocalPhoneFab` (@astro-components);
 * aquí solo se conecta con los datos de esta web.
 */
import { LocalPhoneFab } from '@astro-components';
import { BUSINESS } from '../data/site';
---

<LocalPhoneFab
	href={BUSINESS.phoneHref}
	businessName={BUSINESS.name}
	phone={BUSINESS.phoneDisplay}
/>
