---
import { Image } from 'astro:assets';
import { BUSINESS, IMAGES } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<section id="inicio" class="hero-batan relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.fotoPanoramica6}
			alt="Entorno de Restaurante Batán en Casas del Monte"
			widths={[640, 1100, 1600]}
			sizes="100vw"
			quality={70}
			loading="eager"
			fetchpriority="high"
			class="h-full w-full object-cover opacity-25"
		/>
		<div class="from-neutral/95 via-neutral/65 absolute inset-0 bg-gradient-to-r"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
		<div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
			<div>
				<p class="text-accent inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase">
					<span>
						<i class="ri-map-pin-line"></i> Casas del Monte
					</span>
					<span class="text-white/50">Valle del Ambroz</span>
				</p>

				<h1 class="font-display mt-4 text-6xl leading-[0.95] font-bold sm:text-7xl lg:text-8xl" set:html={piezas.portada.titulo} />

				<p class="mt-6 max-w-xl text-base leading-relaxed text-white/80 sm:text-lg">
					Cocina casera de la tierra, arroces y asados en el centro de Casas del Monte. Con comedor
					y bar para el invierno, y terraza con chill-out junto a la garganta para el verano.
				</p>

				<div class="mt-7 flex flex-wrap items-center gap-3">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="badge badge-lg gap-2 border-white/20 bg-white/10 px-4 py-3 text-sm font-semibold text-white"
					>
						<span class="text-accent tracking-tight" aria-hidden="true">
							{estrellas.map((n) => (
								<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
							))}
						</span>
						{BUSINESS.rating.toString().replace('.', ',')} · {BUSINESS.reviewCount} reseñas en
						Google
					</a>
				</div>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-secondary btn-lg gap-2 rounded-full">
						<i class="ri-phone-line text-xl"></i>
						{BUSINESS.phone}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-lg gap-2 rounded-full border-white/35 bg-transparent text-white hover:border-white hover:bg-white hover:text-neutral"
					>
						<i class="ri-google-fill"></i>
						Ver ficha de Google
					</a>
				</div>

				<dl class="mt-10 grid gap-x-6 gap-y-5 border-t border-white/15 pt-7 sm:grid-cols-3">
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Horario</dt>
						<dd class="mt-1 text-base font-bold">12:00 – 24:00</dd>
						<dd class="text-xs text-white/55">Viernes, sábado y domingo</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">El entorno</dt>
						<dd class="mt-1 text-base font-bold">La garganta</dd>
						<dd class="text-xs text-white/55">Terraza y piscina natural</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Dónde</dt>
						<dd class="mt-1 text-base font-bold">{BUSINESS.street}</dd>
						<dd class="text-xs text-white/55">
							{BUSINESS.postalCode} {BUSINESS.city}
						</dd>
					</div>
				</dl>
			</div>

			<figure class="relative mx-auto w-full max-w-md lg:max-w-none">
				<div class="border-accent/40 absolute -inset-2 -rotate-2 rounded-xl border"></div>
				<div class="relative grid grid-cols-5 gap-3">
					<div class="col-span-3 overflow-hidden rounded-xl shadow-2xl">
						<Image
							src={IMAGES.fotoVertical4}
							alt="Interior del restaurante Batán en Casas del Monte"
							widths={[360, 620]}
							sizes="(min-width: 1024px) 22vw, 55vw"
							quality={85}
							loading="eager"
							class="foto-calida aspect-[3/4] w-full object-cover"
						/>
					</div>
					<div class="col-span-2 flex flex-col gap-3">
						<div class="overflow-hidden rounded-xl shadow-xl">
							<Image
								src={IMAGES.fotoPanoramica9}
								alt="Terraza de El Batán junto a la garganta"
								widths={[260, 440]}
								sizes="(min-width: 1024px) 15vw, 38vw"
								quality={85}
								loading="lazy"
								class="foto-calida aspect-square w-full object-cover"
							/>
						</div>
						<div class="sello-batan bg-primary/85 flex flex-1 flex-col items-center justify-center rounded-full px-3 py-6 text-center">
							<i class="ri-drop-line text-accent text-2xl" aria-hidden="true"></i>
							<span class="mt-1 text-[0.6rem] leading-tight tracking-[0.14em] text-white/70 uppercase">
								valle
								<br />
								del ambroz
							</span>
						</div>
					</div>
				</div>
				<figcaption class="text-accent-content bg-accent mt-5 inline-flex items-center gap-2 rounded-full px-4 py-2 text-xs font-bold shadow-lg">
					<i class="ri-sun-line"></i> Terraza con chill-out en verano
				</figcaption>
			</figure>
		</div>
	</div>

	<div class="cenefa-batan relative h-3 w-full"></div>
</section>
