---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalFaq,
} from '@astro-components';

import vitrina from '../assets/fotos/d-lunch-apaisada-04.jpg';
import carteles from '../assets/fotos/d-lunch-vertical-01.jpg';
import mostrador from '../assets/fotos/d-lunch-vertical-02.jpg';
import estanteria from '../assets/fotos/d-lunch-vertical-03.jpg';
import equipo from '../assets/fotos/d-lunch-apaisada-05.jpg';
import oferton from '../assets/fotos/d-lunch-vertical-06.jpg';
import comidasCaseras from '../assets/fotos/d-lunch-vertical-07.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const title = "D'LUNCH · Pollo asado y comida casera en Málaga";
const description = BUSINESS.description;

const galeria = [
	{
		src: carteles,
		alt: "Carteles amarillos de D'LUNCH con los menús 1 y 2, los precios del pollo asado y las raciones de patatas",
	},
	{
		src: comidasCaseras,
		alt: 'Cartel de comidas caseras y ensalada por 2,50 € con la lista de platos y fotos de cuscús, albóndigas y croquetas',
	},
	{
		src: equipo,
		alt: "Tres personas del equipo de D'LUNCH posando junto a una mesa con tetera y vasos, en el interior amarillo del local",
	},
	{
		src: mostrador,
		alt: 'Mostrador con estanterías rojas, bolsas de pan y patatas, y la vitrina de postres y refrescos',
	},
	{
		src: estanteria,
		alt: 'Estantería de la cocina con botes de aceitunas, bandejas de empanadas y botellas de refrescos',
	},
	{
		src: oferton,
		alt: "Cartel de ofertón del miércoles con pollo asado a 5,90 € en el interior del local",
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#d-lunch`,
	name: BUSINESS.name,
	alternateName: ['D’Lunch Málaga', 'Asador de Pollos Rafa y Saida', 'DLunch'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Casera', 'Marroquí'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Distrito Centro' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17120f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="D'LUNCH Málaga, pollo asado Málaga, asador de pollos Rafa y Saida, C. Eugenio Gross 16, comida casera para llevar Málaga, cuscús Málaga, croquetas caseras Málaga, menú del día Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado, comidas caseras, cuscús y croquetas en la calle Eugenio Gross 16, Distrito Centro. 4,4 sobre 5 con 21 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Vitrina de D'LUNCH con comidas caseras, postres y refrescos en la calle Eugenio Gross"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#17120f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Distrito Centro, Málaga"
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="D'LUNCH"
			subtitle="Pollo asado · comida casera"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.neighbourhood}`}
				title="Pollo asado <br /><em>y comida de casa.</em>"
				lede={`D'LUNCH es un asador de pollos con comida casera en la calle Eugenio Gross 16, en el Distrito Centro de Málaga. Pollo asado, raciones del día a 2,50 €, cuscús, tajine y croquetas. La ficha de Google le da 4,4 sobre 5 con 21 reseñas, aunque no publica horario: llama antes de ir.`}
				image={vitrina}
				imageAlt="Vitrina de D'LUNCH con recipientes de comida casera, postres y botellas de refrescos"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4</b> en Google · 21 reseñas' },
					{ label: 'Pollo asado', html: '<b>8,00 €</b><br />el miércoles, 5,90 €' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> encargos y horario` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de D'LUNCH" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Pollo, cuscús <br /><em>y cuchara.</em>"
				paragraphs={[
					"D'LUNCH está en la calle Eugenio Gross 16, en el Distrito Centro de Málaga, con los carteles amarillos del asador de pollos en la puerta. Google lo clasifica como pollería y le da 4,4 sobre 5 con 21 reseñas.",
					'La casa se presenta en sus carteles como «Asador de Pollos Rafa y Saida» y trabaja dos cocinas a la vez: el horno de pollos, con patatas y ensaladas, y el mostrador de comidas caseras que cambia cada día. La mano marroquí se nota en el tajine de pollo y en el cuscús que anuncian como «el mejor».',
					'Las fotos del perfil enseñan la vitrina con las raciones del día, la estantería de aceitunas y pan, la nevera de refrescos y postres, y el interior amarillo con la taza de D’LUNCH en la pared. En los carteles está la carta: menús 1 y 2, medio pollo, patatas, ensaladas, croquetas, berenjenas rellenas, pisto con pollo, albóndigas o callos con garbanzos.',
					'El local funciona sobre todo para llevar y para comer de forma sencilla. La ficha de Google no publica horario, así que esta web no lo inventa: el teléfono es la forma de confirmar cuándo está abierto y de encargar el pollo.',
				]}
				note="La información sale de la ficha pública de Google Maps, de las fotografías del perfil y de los carteles de la casa. No hay web oficial: los precios y la disponibilidad pueden cambiar, confírmalos en el local o por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver la casa en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Pollo, menús <br /><em>y raciones.</em>"
				description="La carta está copiada de los carteles amarillos del local: los pollos, los menús 1 y 2, las comidas caseras a 2,50 € y las ensaladas. Los precios son los de esos carteles y pueden haber cambiado."
				cta={{ label: 'Ver los carteles en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="Algunos precios de los carteles aparecen tapados o corregidos en las fotos, y el Menú 1 y el Menú 2 no muestran una cifra legible. Para una cuenta cerrada, llama al restaurante antes de encargar."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Seis fotos <br /><em>de la casa.</em>"
				description="Las fotografías del perfil de D'LUNCH en Google Maps: los carteles con la carta, el mostrador, la vitrina, la cocina y el equipo del local."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a <br /><em>Eugenio Gross.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.neighbourhood} · ${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Málaga, España',
				]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="La ficha de Google no publica horario de este local. Para no dar una hora falsa, la web no lo inventa: llama al teléfono y confirma antes de acercarte, sobre todo si vas a encargar pollo o cuscús."
				mapTitle="Mapa de D'LUNCH en la calle Eugenio Gross 16, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="D'LUNCH · Málaga"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. La ficha no publica un sistema de reservas ni una web propia, así que el teléfono es el canal directo para encargar pollo, preguntar por el menú del día o confirmar el horario."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de D'LUNCH"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
