---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';
import bocadilloCalamares from '../assets/fotos/restaurante-raco-del-mercat-apaisada-02.jpg';
import caracoles from '../assets/fotos/restaurante-raco-del-mercat-apaisada-09.jpg';
import bocadilloLomo from '../assets/fotos/restaurante-raco-del-mercat-cuadrada-01.jpg';
import croquetas from '../assets/fotos/restaurante-raco-del-mercat-vertical-03.jpg';
import ensaladaSalmon from '../assets/fotos/restaurante-raco-del-mercat-vertical-04.jpg';
import boquerones from '../assets/fotos/restaurante-raco-del-mercat-vertical-05.jpg';
import ensaladilla from '../assets/fotos/restaurante-raco-del-mercat-vertical-06.jpg';
import tostadas from '../assets/fotos/restaurante-raco-del-mercat-vertical-07.jpg';
import flautas from '../assets/fotos/restaurante-raco-del-mercat-vertical-10.jpg';

const business = {
	name: 'Restaurante El Racó del Mercat',
	brand: 'El Racó del Mercat',
	street: 'Carrer de la Carretera de Ribesalbes, s/n',
	city: "L'Alcora",
	region: 'Castellón',
	postalCode: '12110',
	phone: '667 43 18 01',
	latitude: 40.0736381,
	longitude: -0.215534,
	rating: 4.7,
	reviewsCount: 81,
	site: 'https://restaurante-raco-del-mercat.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd5fe52eddf42df7:0x417a14748605ff9';
const cidDecimal = '294881628145082361';
const placeId = 'ChIJ9y303S7lXw0R-V9gSEehFwQ';

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+El+rac%C3%B3+del+mercat/@40.0736381,-0.215534,17z/data=!3m1!4b1!4m6!3m5!1s0xd5fe52eddf42df7:0x417a14748605ff9!8m2!3d40.0736381!4d-0.215534!16s%2Fg%2F11hh35l2d2?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34667431801';

const description =
	"Restaurante El Racó del Mercat, en la carretera de Ribesalbes (L'Alcora): desayunos, tostadas y tapas por la mañana y cenas los viernes y sábados.";

const servicios = [
	'Desayunos',
	'Tostadas',
	'Bocadillos',
	'Tapas y raciones',
	'Ensaladilla',
	'Caracoles',
	'Croquetas',
	'Boquerones',
	'Ensaladas',
	'Cenas viernes y sábado',
	'Acceso adaptado',
	'Reservas por teléfono',
];

const grupos = [
	{
		title: 'Desayunos y tostadas',
		items: [
			{
				name: 'Tostada de aguacate y huevo',
				note: 'la que destaca una reseña: «sus tostadas de aguacate y jamón son brutales»',
			},
			{
				name: 'Tostada de jamón con tomate',
				note: 'pan tostado, tomate rallado y lonchas de jamón por encima',
			},
			{
				name: 'Bocadillo de lomo con huevo',
				note: 'con pimientos y huevo frito dentro, en pan de bocadillo',
			},
		],
	},
	{
		title: 'Para picar',
		items: [
			{
				name: 'Ensaladilla rusa',
				note: 'en timbal sobre pizarra, con un toque de pimentón',
			},
			{
				name: 'Croquetas',
				note: 'doradas por fuera y cremosas, con alioli y salsa aparte',
			},
			{
				name: 'Boquerones fritos',
				note: 'con limón y perejil, recién salidos de la sartén',
			},
			{
				name: 'Caracoles',
				note: 'guisados con jamón en su caldo, con pan para mojar',
			},
			{
				name: 'Flautas con salsa',
				note: 'crujientes, con una salsa cremosa para mojar',
			},
		],
	},
	{
		title: 'Ensaladas y bocadillos',
		items: [
			{
				name: 'Ensalada con salmón',
				note: 'con salmón, palitos de cangrejo y verduras',
			},
			{
				name: 'Bocadillo de calamares',
				note: 'anillas de calamar rebozadas en pan de bocadillo',
			},
		],
	},
];

const galeria = [
	{
		src: tostadas,
		alt: 'Tostada de aguacate con huevo y tostada de jamón con tomate en El Racó del Mercat, L\'Alcora',
	},
	{
		src: croquetas,
		alt: 'Croquetas con alioli y salsa en El Racó del Mercat, L\'Alcora',
	},
	{
		src: caracoles,
		alt: 'Caracoles guisados con jamón en un bol, con pan y cerveza, en El Racó del Mercat',
	},
	{
		src: ensaladilla,
		alt: 'Ensaladilla rusa en timbal sobre pizarra con pimentón en El Racó del Mercat',
	},
	{
		src: boquerones,
		alt: 'Boquerones fritos con limón y perejil en El Racó del Mercat',
	},
	{
		src: ensaladaSalmon,
		alt: 'Ensalada con salmón y palitos de cangrejo en El Racó del Mercat',
	},
	{
		src: bocadilloCalamares,
		alt: 'Bocadillo de calamares en El Racó del Mercat, L\'Alcora',
	},
	{
		src: flautas,
		alt: 'Flautas crujientes con salsa para mojar en El Racó del Mercat',
	},
];

const faqs = [
	{
		q: '¿Dónde está El Racó del Mercat?',
		a: 'En el Carrer de la Carretera de Ribesalbes, sin número, 12110 L\'Alcora (Castellón), en la salida del pueblo hacia Ribesalbes. Se llega en coche por esa misma carretera. Desde esta página puedes abrir el mapa y trazar la ruta con el botón «Cómo llegar».',
	},
	{
		q: '¿Qué horario tiene?',
		a: 'Por las mañanas abre de 9:00 a 13:00 (los miércoles desde las 7:00). Los viernes y los sábados vuelve a abrir por la noche, a las 20:00: el viernes hasta las 24:00 y el sábado hasta la 1:30. El lunes permanece cerrado. En festivos conviene llamar antes al 667 43 18 01.',
	},
	{
		q: '¿Se puede desayunar?',
		a: 'Sí, es lo que se sirve por la mañana: tostadas de aguacate y de jamón, bocadillos como el de lomo con huevo y café. Una reseña de Google lo resume así: «sus tostadas de aguacate y jamón son brutales, una atención genial».',
	},
	{
		q: '¿Se puede cenar?',
		a: 'Solo los viernes y los sábados, desde las 20:00. El resto de días el restaurante cierra a mediodía, después del servicio de mañana. Para cenar en grupo conviene reservar por teléfono.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'No hay reserva online ni formulario en esta web: se reserva llamando al 667 43 18 01. Al ser un local pequeño, con servicio de mañana y solo dos noches de cena a la semana, es la forma de asegurar mesa.',
	},
	{
		q: '¿Hay carta publicada?',
		a: 'No. En la ficha de Google no hay carta ni precios, así que esta web solo recoge los platos que aparecen en sus fotos y los que citan las reseñas: tostadas, bocadillos, ensaladilla, croquetas, boquerones, caracoles, flautas, ensaladas y calamares. Lo que haya cada día se pregunta en el local o por teléfono.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'La ficha de Google marca entrada, aseo y asientos adaptados para sillas de ruedas. No marca plaza de aparcamiento adaptada.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: [
		'El Racó del Mercat',
		'Raco del Mercat',
		'Restaurante El Racó del Mercat L\'Alcora',
	],
	slogan: 'Desayunos, tapas y cenas de viernes y sábado en L\'Alcora',
	description,
	url: `${business.site}/`,
	telephone: '+34 667 43 18 01',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Tapas', 'Desayunos', 'Cocina española'],
	areaServed: [
		{ '@type': 'City', name: "L'Alcora" },
		{ '@type': 'AdministrativeArea', name: 'Alcalatén' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Thursday', 'Sunday'],
			opens: '09:00',
			closes: '13:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday'],
			opens: '07:00',
			closes: '13:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '09:00',
			closes: '13:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '20:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '09:00',
			closes: '13:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '20:00',
			closes: '01:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>El Racó del Mercat · Desayunos y tapas en L'Alcora</title>
		<meta name="theme-color" content="#3c5a3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="El Racó del Mercat, Raco del Mercat, restaurante L'Alcora, desayunos L'Alcora, tapas L'Alcora, tostadas de aguacate, bocadillos L'Alcora, cenas L'Alcora, carretera de Ribesalbes, comer en L'Alcora, restaurante Alcalatén"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="El Racó del Mercat · Desayunos y tapas en L'Alcora"
			ogDescription="Tostadas de aguacate y jamón, bocadillos, tapas y raciones en L'Alcora. Mañanas de 9 a 13 y cenas viernes y sábado. 4,7 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Bocadillo de lomo con huevo y pimientos de El Racó del Mercat"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#3c5a3a"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="L'Alcora, Castellón"
			contact={{
				street: business.street,
				locality: business.city,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[bocadilloLomo]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="RM"
			name={business.brand}
			subtitle="Desayunos y tapas · L'Alcora"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carretera de Ribesalbes, s/n · L'Alcora"
				title="Tostadas, tapas<br />y cenas<br /><em>de viernes.</em>"
				lede="El Racó del Mercat está en la carretera de Ribesalbes, en L'Alcora. Abre por las mañanas, de 9:00 a 13:00, para desayunar y picar algo, y vuelve a encender los fogones los viernes y los sábados por la noche."
				image={bocadilloLomo}
				imageAlt="Bocadillo de lomo con huevo frito y pimientos en El Racó del Mercat, L'Alcora"
				primaryCta={{ label: 'Llamar 667 43 18 01', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,7</b> en Google (81 reseñas)' },
					{ label: 'Mañanas', html: '<b>9:00 – 13:00</b>' },
					{ label: 'Cenas', html: '<b>Viernes y sábado</b>' },
					{ label: 'Lunes', html: '<b>Cerrado</b>' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece El Racó del Mercat" items={servicios} />

			<LocalAbout
				label="Desayunos, tapas y cenas en L'Alcora"
				title="Un rincón<br />de mercado<br /><em>en L'Alcora.</em>"
				paragraphs={[
					'El Racó del Mercat está en el Carrer de la Carretera de Ribesalbes, sin número, a la salida de L\'Alcora. El horario es el de un puesto de mercado: se abre por la mañana, de 9:00 a 13:00 (los miércoles a las 7:00), y se cierra a mediodía. El lunes descansa.',
					'Por la mañana se desayuna y se pica: tostadas de aguacate y de jamón, bocadillos de lomo con huevo y de calamares, ensaladilla rusa, croquetas, boquerones, caracoles y flautas. Las fotos de la ficha son de esa barra: platos sencillos, bien servidos y con la salsa aparte.',
					'Los viernes y los sábados vuelve a abrir por la noche, a las 20:00, para cenar raciones y platos para compartir; el sábado aguanta hasta la 1:30. La ficha reúne 81 opiniones con un 4,7, y las reseñas insisten en el trato y en las cantidades.',
				]}
				note="«Comida fantástica, la camarera súper atenta y educada», dice una reseña. Otra lo resume así: «todo buenísimo, buenas cantidades y muy buen trato»."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La pizarra"
				title="Tostadas, tapas<br /><em>y raciones.</em>"
				description="En la ficha de Google no hay carta, así que esta selección se ha hecho con lo que aparece en sus fotos y con lo que citan las reseñas: tostadas de aguacate y jamón, bocadillos, ensaladilla, croquetas, boquerones, caracoles, flautas, ensaladas y calamares."
				cta={{ label: 'Preguntar qué hay hoy', href: phoneHref }}
				groups={grupos}
				note="Esta web no publica precios: no hay carta ni tarifas en la ficha de Google. Lo que se sirve cada día, las raciones y su importe se confirman en el local o llamando al 667 43 18 01."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La barra,<br /><em>plato a plato.</em>"
				description="Estas fotografías proceden del perfil de El Racó del Mercat en Google Maps: las tostadas de aguacate y de jamón, las croquetas, los caracoles, la ensaladilla, los boquerones, la ensalada de salmón, el bocadillo de calamares y las flautas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carretera de Ribesalbes, s/n · 12110 L'Alcora"
				title="Nos vemos<br /><em>en el racó.</em>"
				addressLines={[
					business.street,
					`${business.postalCode} ${business.city}`,
					'Castellón, España',
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: '9:00 – 13:00' },
					{ day: 'Miércoles', value: '7:00 – 13:00' },
					{ day: 'Jueves', value: '9:00 – 13:00' },
					{ day: 'Viernes', value: '9:00 – 13:00 · 20:00 – 24:00' },
					{ day: 'Sábado', value: '9:00 – 13:00 · 20:00 – 1:30' },
					{ day: 'Domingo', value: '9:00 – 13:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google: mañanas de 9:00 a 13:00 (los miércoles desde las 7:00) y cenas solo los viernes y los sábados desde las 20:00. El lunes cierra. En festivos puede cambiar: llama antes al 667 43 18 01."
				mapTitle="Mapa de El Racó del Mercat en la carretera de Ribesalbes, L'Alcora"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="El Racó del Mercat · L'Alcora"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Las reservas se hacen por teléfono, llamando al 667 43 18 01: no hay reserva online ni formulario en esta web. Para cenar los viernes y los sábados, o si vais en grupo, conviene llamar con tiempo."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="RM"
			name={business.brand}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a El Racó"
		/>
	</body>
</html>
