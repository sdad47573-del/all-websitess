---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import {
	business,
	directionsUrl,
	faqSchema,
	faqs,
	HOURS,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	REVIEWS,
	SPECIALTIES,
} from '../lib/business';

const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);

const rutas = Object.keys(fotos).sort((a, b) => a.localeCompare(b));

/**
 * La foto del hero se elige por la forma que `fetch-maps-photos` pone en el nombre: la más
 * panorámica disponible, y si no hay, la primera horizontal. Así la portada no depende de que
 * Google devuelva un nombre concreto de archivo.
 */
const rutaHero =
	rutas.find((r) => r.includes('-panoramica-')) ??
	rutas.find((r) => r.includes('-apaisada-')) ??
	rutas[0];
const heroFoto = rutaHero ? fotos[rutaHero].default : undefined;

const galeria = rutas.map((ruta) => {
	const archivo = ruta.split('/').pop() ?? '';
	const clave = ['panoramica', 'apaisada', 'vertical', 'cuadrada'].find((forma) =>
		archivo.includes(`-${forma}`),
	);
	const forma = clave === 'apaisada' ? 'horizontal' : clave === 'panoramica' ? 'panorámica' : (clave ?? 'general');
	return {
		src: fotos[ruta].default,
		alt: `Fotografía ${forma} de ${business.name}, publicada en su ficha de Google Maps`,
	};
});

const title = 'Restaurante La Nicoba | Menú del día en Huelva (A-5000-R)';
const description = `Restaurante La Nicoba, en la carretera A-5000-R de Huelva: menú del día y cocina de siempre, de lunes a viernes de 6:30 a 17:00. Mapa, horario y reservas por teléfono (${business.phoneDisplay}).`;
const keywords = `Restaurante La Nicoba, restaurante Huelva, menu del dia Huelva, comer en Huelva, A-5000 Huelva, restaurante carretera Huelva, salmorejo Huelva, 21007 Huelva`;
const address = `${business.streetAddress}, ${business.postalCode} ${business.locality}`;
const rating = business.rating.toString().replace('.', ',');
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#12324a" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-H" />
		<meta name="geo.placename" content={business.locality} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Tarjeta de Restaurante La Nicoba, en la carretera A-5000-R de Huelva" />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.locality} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">N</span>
				<span class="brand-copy">
					La Nicoba
					<small>{business.category} · {business.locality}</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">Qué se come</a>
				<a href="#horario">Horario</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-call" href={phoneHref}><span aria-hidden="true">☎</span> {business.phoneDisplay}</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				{
					heroFoto && (
						<div class="hero-media">
							<Image
								class="hero-photo"
								src={heroFoto}
								alt={`Fotografía de ${business.name}, en la carretera A-5000-R de ${business.locality}`}
								widths={[640, 1000, 1400, 1600]}
								sizes="100vw"
								format="avif"
								quality={68}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</div>
					)
				}
				<div class="hero-inner">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> {business.category} · A-5000-R · {business.locality}</p>
					<h1 id="hero-title">Restaurante<br /><em>La Nicoba.</em></h1>
					<p class="hero-lede">
						Menú del día y cocina de siempre en la carretera A-5000-R de Huelva, con el {rating} de
						valoración media que le dan sus {business.reviewCount} reseñas en Google. Abre de lunes a
						viernes, de 6:30 a 17:00.
					</p>
					<div class="hero-actions">
						<a class="button button-orange" href={phoneHref}>Llamar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
				</div>
				<p class="hero-caption">Foto de la ficha de Google Maps</p>
			</section>

			<div class="facts" aria-label="Datos de Restaurante La Nicoba">
				<div class="fact">
					<small>Valoración</small>
					<strong>{rating} ★</strong>
					<span>{business.reviewCount} reseñas en Google Maps</span>
				</div>
				<div class="fact">
					<small>Horario</small>
					<strong>6:30 – 17:00</strong>
					<span>Lunes a viernes · sábado y domingo cerrado</span>
				</div>
				<div class="fact">
					<small>Teléfono</small>
					<strong><a href={phoneHref}>{business.phoneDisplay}</a></strong>
					<span>Consultas y menú del día</span>
				</div>
				<div class="fact">
					<small>Dónde</small>
					<strong>{business.streetAddress}</strong>
					<span>{business.postalCode} {business.locality} · <a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Maps ↗</a></span>
				</div>
			</div>

			<section class="section about" id="casa" aria-labelledby="casa-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> La casa</p>
					<h2 id="casa-title">Un restaurante<br />de <em>carretera.</em></h2>
				</div>
				<div class="about-copy">
					<p>
						Restaurante La Nicoba está en la carretera A-5000-R, en {business.locality}, y su ficha de
						Google Maps lo clasifica simplemente como <strong>restaurante</strong>. No declara ninguna
						categoría más, así que la web tampoco se la inventa.
					</p>
					<p>
						La ficha acumula {business.reviewCount} reseñas con una media de {rating}. En ellas se
						repite el <strong>menú del día</strong>, se cita el <strong>salmorejo</strong> y se describe
						un plato con huevo acompañado de patatas fritas o ensalada. El horario es continuo de lunes
						a viernes, de 6:30 a 17:00.
					</p>
					<p class="note">
						Esta web es informativa y no publica carta ni precios: el negocio no los tiene publicados
						en su ficha. Llama al {business.phoneDisplay} para consultar el menú del día, los alérgenos
						y la disponibilidad.
					</p>
				</div>
			</section>

			<section class="section carta" id="carta" aria-labelledby="carta-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Qué se come</p>
						<h2 id="carta-title">Lo que citan<br /><em>las reseñas.</em></h2>
					</div>
					<p>
						No hay carta publicada. Esto es, literalmente, lo que aparece en las reseñas de su ficha de
						Google Maps: platos concretos y el menú del día. Todo lo demás se pregunta por teléfono.
					</p>
				</div>
				<div class="card-grid">
					{SPECIALTIES.map((plato, index) => (
						<article class="card">
							<small>0{index + 1}</small>
							<h3>{plato.name}</h3>
							<p>{plato.detail}</p>
						</article>
					))}
				</div>
			</section>

			<section class="section hours" id="horario" aria-labelledby="horario-title">
				<div class="hours-grid">
					<div>
						<p class="section-label eyebrow-light"><span aria-hidden="true"></span> Horario</p>
						<h2 id="horario-title">De lunes a viernes,<br /><em>mañana y mediodía.</em></h2>
						<p class="hours-intro">
							Horario continuo de 6:30 a 17:00, el que publica la ficha del restaurante. El fin de
							semana permanece cerrado y en festivos el horario puede cambiar.
						</p>
					</div>
					<div>
						<ul class="hours-list">
							{HOURS.map((dia) => (
								<li>
									<span class="hours-day">{dia.days}</span>
									<span class={`hours-time${dia.ranges.length === 0 ? ' hours-closed' : ''}`}>
										{dia.ranges.length === 0 ? 'Cerrado' : dia.ranges[0]}
									</span>
								</li>
							))}
						</ul>
						<p class="hours-note">
							Sábado y domingo cerrado. Llama al {business.phoneDisplay} para confirmar festivos y
							vísperas.
						</p>
					</div>
				</div>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="fotos-title">
				<p class="section-label"><span aria-hidden="true"></span> Fotos · ficha de Google Maps</p>
				<h2 id="fotos-title">El restaurante, <em>en imágenes.</em></h2>
				<p class="gallery-copy">
					Las {galeria.length} fotografías que el propio negocio publica en su ficha de Google Maps,
					servidas aquí en AVIF y varios tamaños para que carguen rápido.
				</p>
				<div class="gallery-grid">
					{galeria.map((imagen, index) => (
						<div class="gallery-photo">
							<Image
								src={imagen.src}
								alt={imagen.alt}
								widths={[320, 480, 720]}
								sizes="(max-width: 560px) 46vw, (max-width: 1000px) 46vw, 24vw"
								format="avif"
								quality={65}
								loading={index < 2 ? 'eager' : 'lazy'}
								decoding="async"
							/>
						</div>
					))}
				</div>
				<p class="gallery-note">
					Fotografías de la ficha pública de <a href={mapsUrl} target="_blank" rel="noreferrer">{business.name} en Google Maps ↗</a>.
					Las imágenes pertenecen a sus autores.
				</p>
			</section>

			<section class="section reviews" aria-labelledby="resenas-title">
				<div class="reviews-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
						<h2 id="resenas-title">Lo que cuentan<br /><em>los clientes.</em></h2>
					</div>
					<div class="reviews-score">
						{rating}
						<small>{business.reviewCount} reseñas en Google Maps</small>
					</div>
				</div>
				<div class="review-grid">
					{REVIEWS.map((texto) => (
						<blockquote class="review-card">
							<p>«{texto}»</p>
							<small>Reseña publicada en la ficha de Google Maps</small>
						</blockquote>
					))}
				</div>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visitanos-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> {business.postalCode} · {business.locality}</p>
					<h2 id="visitanos-title">Carretera<br /><em>A-5000-R.</em></h2>
					<address>{business.streetAddress}<br />{business.postalCode} {business.locality}<br />Código Plus: {business.plusCodeLocal}</address>
					<div class="contact-list">
						<div class="contact-row">
							<span class="contact-icon" aria-hidden="true">☎</span>
							<div><small>Teléfono y menú del día</small><a href={phoneHref}>{business.phone}</a></div>
						</div>
						<div class="contact-row">
							<span class="contact-icon" aria-hidden="true">⌖</span>
							<div><small>Ubicación</small><a href={mapsUrl} target="_blank" rel="noreferrer">Abrir ficha de Google Maps ↗</a></div>
						</div>
						<div class="contact-row">
							<span class="contact-icon" aria-hidden="true">◷</span>
							<div><small>Horario</small><p>Lunes a viernes, 6:30 – 17:00 · fin de semana cerrado</p></div>
						</div>
						<div class="contact-row">
							<span class="contact-icon" aria-hidden="true">↗</span>
							<div><small>Coordenadas</small><p>{business.latitude}, {business.longitude}</p></div>
						</div>
					</div>
					<p class="note">
						La ficha no publica número de portal, solo la carretera. Abre el mapa y usa las
						indicaciones para llegar; si vas con prisa, llama antes y te lo explican.
					</p>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar</a>
					</div>
				</div>
				<div class="map-card">
					<div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<button type="button" data-cargar-mapa aria-label="Cargar mapa interactivo" style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
							<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
							<strong style="font-size:1rem;">Cargar mapa interactivo</strong>
							<small style="opacity:0.65;">Se carga solo al pulsar</small>
						</button>
<iframe
						title={`Mapa de ${business.name} en ${business.streetAddress}, ${business.locality}`}
					 data-src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<div class="map-label">
						<div>
							<strong>{business.name}</strong>
							<small>{business.streetAddress} · {business.postalCode} {business.locality}</small>
						</div>
						<a href={directionsUrl} target="_blank" rel="noreferrer">Indicaciones ↗</a>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="preguntas-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="preguntas-title">Antes de <em>ir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
				<span class="brand-mark" aria-hidden="true">N</span>
				<span class="brand-copy">La Nicoba<small>{business.category} · {business.locality}</small></span>
			</a>
			<p>{address}<br />Teléfono: {business.phone}<br />Código Plus: {business.plusCodeLocal}</p>
			<nav class="footer-nav" aria-label="Enlaces de la ficha">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} {business.name} · {business.locality}. Confirma horarios, platos y precios por teléfono.</small>
		</footer>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>{business.phoneDisplay}</span></a>
		<WhatsappFab phone={datos.phoneHref} name={datos.business?.name} />
	</body>
</html>

<script>
// mapa-fachada: la URL del iframe vive en data-src y solo se asigna al pulsar (ahorra ~1MB de JS).
document.addEventListener('click', function (e) {
	var t = e.target && e.target.closest ? e.target.closest('[data-cargar-mapa]') : null;
	if (!t) return;
	var w = t.closest('[data-mapa-fachada]');
	if (!w || w.dataset.cargado) return;
	var f = w.querySelector('iframe');
	if (!f || !f.dataset.src || f.getAttribute('src')) return;
	w.dataset.cargado = '1';
	f.setAttribute('src', f.dataset.src);
	t.remove();
});
</script>
