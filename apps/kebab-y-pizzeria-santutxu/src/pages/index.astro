---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import durum from '../assets/fotos/kebab-y-pizzeria-santutxu-vertical-08.jpg';
import fachada from '../assets/fotos/kebab-y-pizzeria-santutxu-apaisada-01.jpg';
import carta from '../assets/fotos/kebab-y-pizzeria-santutxu-vertical-03.jpg';
import durumCortado from '../assets/fotos/kebab-y-pizzeria-santutxu-vertical-04.jpg';
import pita from '../assets/fotos/kebab-y-pizzeria-santutxu-vertical-05.jpg';
import patatas from '../assets/fotos/kebab-y-pizzeria-santutxu-vertical-06.jpg';
import barra from '../assets/fotos/kebab-y-pizzeria-santutxu-vertical-07.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Kebab y Pizzería Santutxu · Kebab halal en Bilbao';
const description =
	'Kebab y Pizzería Santutxu, Santutxu Kalea (48004 Bilbao). Kebab halal, durum, pizzas, hamburguesas y fritos, con servicio a domicilio. 4,1 sobre 5 con 88 reseñas. Abierto todos los días desde las 12:30.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada roja del local en Santutxu, con el cartel de Asia Döner Kebab y la carta en el escaparate',
	},
	{
		src: durumCortado,
		alt: 'Durum cortado por la mitad, con la carne y la salsa dentro de la tortilla',
	},
	{
		src: pita,
		alt: 'Kebab en pan de pita con pollo desmenuzado, lechuga y salsa blanca',
	},
	{
		src: patatas,
		alt: 'Caja de patatas fritas recién hechas para llevar',
	},
	{
		src: barra,
		alt: 'La barra del local con paredes verdes, taburetes altos y la cocina al fondo',
	},
	{
		src: carta,
		alt: 'La carta del local en la ventana, con los kebabs, durums, pizzas y fritos',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que sirve Kebab y Pizzería Santutxu',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'FastFoodRestaurant',
	'@id': `${BUSINESS.siteUrl}/#santutxu`,
	name: BUSINESS.name,
	alternateName: ['Kebab y Pizzeria Santutxu', 'Asia Döner Kebab Santutxu', 'Kebab Santutxu'],
	description:
		'Kebab halal, durum, pizzas, hamburguesas y fritos en Santutxu Kalea (48004 Bilbao), con servicio a domicilio.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, BUSINESS.web],
	telephone: '+34666234905',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Kebab', 'Turca', 'Pizza', 'Halal'],
	hasTakeaway: true,
	hasDeliveryMethod: 'http://purl.org/goodrelations/v1#DeliveryModeOwnFleet',
	areaServed: [
		{ '@type': 'City', name: 'Bilbao' },
		{ '@type': 'Place', name: 'Santutxu' },
		{ '@type': 'AdministrativeArea', name: 'Bizkaia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '12:30',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '12:30',
			closes: '00:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"kebab-y-pizzeria-santutxu-vertical-08.jpg": durum,
	"kebab-y-pizzeria-santutxu-apaisada-01.jpg": fachada,
	"kebab-y-pizzeria-santutxu-vertical-04.jpg": durumCortado,
	"kebab-y-pizzeria-santutxu-vertical-05.jpg": pita,
	"kebab-y-pizzeria-santutxu-vertical-06.jpg": patatas,
	"kebab-y-pizzeria-santutxu-vertical-07.jpg": barra,
	"kebab-y-pizzeria-santutxu-vertical-03.jpg": carta,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#3c201a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Karla:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="kebab Santutxu, kebab Bilbao, pizzeria Santutxu, kebab halal Bilbao, durum Santutxu, kebab a domicilio Bilbao, Santutxu Kalea"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Kebab halal, durum, pizzas y fritos en Santutxu (Bilbao), con servicio a domicilio. Todos los días de 12:30 a 23:30 y hasta las 24:00 los viernes y sábados."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Durum de Kebab y Pizzería Santutxu, con la carne y la salsa dentro de la tortilla"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#3c201a"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[durum]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Kebab y Pizzería Santutxu"
			subtitle="Kebab, pizza y durum · Bilbao"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma platos, precios y horario antes de pedir."
			ctaLabel="Llamar a Kebab y Pizzería Santutxu"
			navAriaLabel="Enlaces de Kebab y Pizzería Santutxu"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
