---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import chicharrones from '../assets/fotos/la-casita-hortaleza-apaisada-01.jpg';
import croquetasRedondas from '../assets/fotos/la-casita-hortaleza-apaisada-07.jpg';
import pollo from '../assets/fotos/la-casita-hortaleza-vertical-02.jpg';
import fachada from '../assets/fotos/la-casita-hortaleza-vertical-03.jpg';
import croquetas from '../assets/fotos/la-casita-hortaleza-vertical-04.jpg';
import patata from '../assets/fotos/la-casita-hortaleza-vertical-05.jpg';
import chicharronPlato from '../assets/fotos/la-casita-hortaleza-vertical-06.jpg';
import lomo from '../assets/fotos/la-casita-hortaleza-vertical-08.jpg';
import terraza from '../assets/fotos/la-casita-hortaleza-vertical-09.jpg';
import ensaladilla from '../assets/fotos/la-casita-hortaleza-vertical-10.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'La Casita · Pollo a la brasa en Hortaleza, Madrid';
const description =
	'La Casita, en Calle de Montalbos, 3 (28043 Madrid, Hortaleza). Pollo a la brasa, paellas y cocina peruana y española para llevar o a domicilio. De martes a domingo.';

const galeria = [
	{
		src: croquetasRedondas,
		alt: 'Cinco croquetas redondas con crema y jalapeño en un plato negro',
	},
	{
		src: fachada,
		alt: 'La fachada de La Casita con el toldo negro, el teléfono, el Instagram y los vinilos de platos peruanos',
	},
	{
		src: pollo,
		alt: 'Medio pollo a la brasa dorado, recién salido del asador',
	},
	{
		src: chicharronPlato,
		alt: 'Chicharrón de pollo con patatas fritas, arroz, ensalada y salsa',
	},
	{
		src: lomo,
		alt: 'Lomo saltado con arroz, patatas fritas, cebolla roja y zanahoria',
	},
	{
		src: croquetas,
		alt: 'Cinco croquetas alargadas con aros de cebolla encurtida en un plato blanco',
	},
	{
		src: patata,
		alt: 'Un plato de patata con mayonesa, huevo cocido y una aceituna negra sobre lechuga',
	},
	{
		src: ensaladilla,
		alt: 'Ensaladilla rusa con huevo cocido, aceituna negra y mayonesa',
	},
	{
		src: chicharrones,
		alt: 'Chicharrones de pollo fritos con ensalada y salsa',
	},
	{
		src: terraza,
		alt: 'La mesa de la terraza con el cartel de oferta de croquetas y la pizarra del menú al fondo',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de La Casita',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-casita`,
	name: BUSINESS.fullName,
	alternateName: ['La Casita Hortaleza', 'La Casita Madrid', 'La Casita Montalbos'],
	description:
		'Restaurante de pollo a la brasa y cocina peruana y española en la calle de Montalbos, 3 (Hortaleza, 28043 Madrid). Comida para llevar y a domicilio.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34654759370',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo a la brasa', 'Cocina peruana', 'Comida española', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Hortaleza' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:00',
			closes: '22:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#33523c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Nunito+Sans:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Casita Hortaleza, pollo a la brasa Madrid, comida peruana Hortaleza, comida para llevar Montalbos, paellas para llevar Madrid, croquetas caseras Hortaleza"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo a la brasa, paellas y cocina peruana y española en la calle de Montalbos, 3 (Hortaleza). Para llevar y a domicilio, de martes a domingo."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Chicharrones de pollo de La Casita con ensalada y salsa"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#33523c"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Hortaleza"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[chicharrones]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Casita"
			subtitle="Pollo a la brasa · Hortaleza"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Calle de Montalbos, 3 · Hortaleza, Madrid"
				title="Pollo a la brasa <br /><em>y sabor de casa.</em>"
				lede={`La Casita es un asador de pollos con cocina peruana y española en la calle de Montalbos. El pollo a la brasa es la especialidad, y a su lado conviven las paellas, la fideuá, el lomo saltado, los chicharrones y los platos caseros, con opciones vegetarianas. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas, y abre de martes a domingo, de 10:00 a 22:00.`}
				image={chicharrones}
				imageAlt="Chicharrones de pollo de La Casita con ensalada y salsa"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>10:00–22:00</b> · lunes cerrado' },
					{ label: 'Servicio', html: '<b>Para llevar</b> · y a domicilio' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Pollo a la brasa"
			/>

			<LocalChips label="Lo que ofrece La Casita" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Montalbos, 3. <br /><em>Perú y España.</em>"
				paragraphs={[
					'La Casita está en la calle de Montalbos, 3, local 13 A, en el distrito de Hortaleza. El toldo negro de la fachada anuncia lo que se cocina dentro: «Asador de pollos · arroces y paellas · reservas: 654 759 370». Los vinilos del escaparate añaden la parte peruana de la carta.',
					'La ficha lo describe como «un rincón gastronómico en Madrid con auténticos sabores peruanos y españoles», con pollo a la brasa, paellas y una selección de platos caseros para todos los gustos, incluida variedad vegetariana.',
					'En el escaparate se leen los nombres de la casa: causa peruana, tortilla de patatas, lomo saltado, tallarines salteados, arroz con pollo, chicharrón de pollo, saltado de calamar, pan con chicharrón peruano, seco de cordero, tartas de queso y picarones. En las fotos del perfil aparecen además las croquetas, la ensaladilla y el pollo recién hecho.',
					`Las reseñas repiten el pollo, la comida peruana y la fideuá. La ficha le da ${RATING.label} sobre 5 con ${RATING.count} opiniones (octubre de 2026), abre de martes a domingo de 10:00 a 22:00 y atiende pedidos y reservas en el ${BUSINESS.phone}.`,
				]}
				note="La ficha no publica carta ni precios, y no enlaza la web que menciona su descripción. Los platos de esta página son los que aparecen en el escaparate del local, en sus fotos y en las reseñas de Google; confirma precios y disponibilidad por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> La brasa y el sabor peruano</p>
					<h2 id="highlights-title">Pollo, arroces <br /><em>y lomo saltado.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Lo que se cocina <br /><em>en La Casita.</em>"
				description="La ficha no publica la carta, así que esta lista sale del escaparate del local, de sus fotos y de las reseñas de Google. Todo se puede pedir para llevar y para comer allí."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La única oferta con precio a la vista es la de croquetas: 4 unidades por 6,50 € y 8 por 10,00 €, de jamón, pollo, setas y trufa. Para el resto de platos, llama al 654 75 93 70."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La brasa, la mesa <br /><em>y los platos.</em>"
				description="Diez fotografías del perfil de La Casita en Google Maps: las croquetas, la fachada, el pollo a la brasa, el chicharrón, el lomo saltado, la ensaladilla, los chicharrones y la terraza."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,1 sobre 5, <em>con 55 reseñas.</em></h2>
						<p>
							Google publica una media de 4,1 con 55 opiniones (octubre de 2026). Las reseñas
							que se ven aquí hablan del pollo a la brasa, de la comida peruana, de la fideuá y
							de la ensalada mixta.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,1</strong>
						<span>★★★★☆</span>
						<small>55 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En Hortaleza, <br /><em>Montalbos 3.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de martes a domingo, de 10:00 a 22:00, con el lunes cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de La Casita en la calle de Montalbos, 3, Hortaleza, Madrid"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Montalbos, 3 · Hortaleza"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos, reservas y consultas por teléfono: 654 75 93 70. La fachada anuncia reservas y en las fotos se ven mesas dentro. La ficha no publica reparto en una plataforma concreta, aunque Google la clasifica como comida a domicilio, ni datos de entrada accesible; sí avisa de que no hay aparcamiento adaptado."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma platos y horario antes de la visita."
			ctaLabel="Llamar a La Casita"
			navAriaLabel="Enlaces de La Casita"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
