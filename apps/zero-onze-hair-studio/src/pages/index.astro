---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import { Image } from 'astro:assets';
import heroFoto from '../assets/fotos/zero-onze-hair-studio-vertical-01.jpg';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	horario,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	structuredData,
} from '../lib/business';

const title = 'Zero Onze hair studio | Barbería y peluquería en Teatinos, Málaga';
const description =
	'Zero Onze hair studio, barbería y peluquería en Av. Parménides, 17, Teatinos (Málaga). 5,0 sobre 5 con 135 reseñas; abre de lunes a sábado. Llama al 624 22 19 15.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#171714" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Oswald:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.jpg`} />
		<meta property="og:image:alt" content="Fotografía de Zero Onze hair studio compartida en Google Maps" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.jpg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7207816;-4.4798433" />
		<meta name="ICBM" content="36.7207816, -4.4798433" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Zero Onze hair studio, inicio">
				<span class="brand-mark" aria-hidden="true">ZO<span>✳</span></span>
				<span class="brand-name">ZERO ONZE HAIR STUDIO <small>BARBERÍA Y PELUQUERÍA · TEATINOS</small></span>
			</a>
			<nav aria-label="Navegación principal"><a href="#barberia">La barbería</a><a href="#ubicacion">Encuéntranos</a></nav>
			<a class="header-call" href={phoneHref}><span aria-hidden="true">☎</span> {business.phone}</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> BARBERÍA Y PELUQUERÍA · TEATINOS</p>
					<h1 id="hero-title">CORTE<br />CON <em>CARÁCTER.</em></h1>
					<p class="hero-description">Zero Onze hair studio. Un espacio en Teatinos para cuidar tu estilo, con atención cercana y el oficio de la barbería y la peluquería en cada detalle.</p>
					<div class="hero-actions"><a class="button button-gold" href={phoneHref}><span aria-hidden="true">☎</span> Llamar ahora</a><a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-address"><span class="address-icon" aria-hidden="true">⌖</span><p>{business.streetAddress}<br /><strong>{business.postalCode} · {business.city}</strong></p></div>
				</div>

				<figure class="hero-image">
					<div class="image-label"><span>ZO / 01</span><span>ZERO ONZE HAIR STUDIO</span></div>
					<a href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Abrir la fotografía y galería de Zero Onze hair studio en Google Maps">
						<Image src={heroFoto} alt="Fotografía de Zero Onze hair studio publicada en Google Maps" width={1200} height={900} fetchpriority="high" decoding="async" />
						<span class="image-open" aria-hidden="true">↗</span>
					</a>
					<figcaption><span>IMAGEN DE LA FICHA DE GOOGLE MAPS</span><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha ↗</a></figcaption>
					<div class="image-seal" aria-hidden="true">GOOD<br />CUTS<br /><b>✳</b></div>
				</figure>
				<span class="hero-mark" aria-hidden="true">✳</span>
			</section>

			<section class="barber-section" id="barberia" aria-labelledby="barber-title">
				<div class="section-index"><span>01</span> EL OFICIO DE LA BARBERÍA</div>
				<div class="barber-content">
					<h2 id="barber-title">Tu barbería<br /><em>en Málaga.</em></h2>
					<div class="barber-text"><p>En Zero Onze hair studio, el estilo empieza con una buena conversación. Acércate al local de Av. Parménides y descubre una atención personal en un entorno pensado para la barbería y la peluquería.</p><a href={directionsUrl} target="_blank" rel="noreferrer" class="text-link">Visítanos en Málaga <span aria-hidden="true">↗</span></a></div>
				</div>
				<div class="barber-details"><span>ZERO ONZE HAIR STUDIO</span><span>TEATINOS · MÁLAGA</span><span>✳</span></div>
			</section>

			<section class="location-section" id="ubicacion" aria-labelledby="location-title">
				<div class="section-index"><span>02</span> CÓMO LLEGAR</div>
				<div class="location-content">
					<div class="location-info"><p class="location-kicker">TE ESPERAMOS EN</p><h2 id="location-title">Av. Parménides,<br /><em>Teatinos.</em></h2>
						<div class="contact-list">
							<div class="contact-item"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div></div>
							<div class="contact-item"><span aria-hidden="true">↗</span><div><small>TELÉFONO</small><a href={phoneHref}>{business.phone}</a></div></div>
							<div class="contact-item"><span aria-hidden="true">◷</span><div><small>HORARIO</small><p>{horario.map((h) => `${h.days}: ${h.hours}`).join(' · ')}</p></div></div>
						</div>
						<a class="button button-gold map-button" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-frame"><div class="map-head"><span><i></i> ZERO ONZE HAIR STUDIO</span><a href={mapsUrl} target="_blank" rel="noreferrer">GOOGLE MAPS ↗</a></div><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Zero Onze hair studio en Av. Parménides, Teatinos, Málaga" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div><div class="map-caption"><span class="map-pin" aria-hidden="true">⌖</span><span><strong>Zero Onze hair studio</strong><small>{business.streetAddress} · {business.city}</small></span><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar">↗</a></div></div>
				</div>
			</section>
			<Galeria nombre="Zero Onze hair studio" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer"><a class="brand footer-brand" href="#inicio" aria-label="Volver arriba"><span class="brand-mark">ZO<span>✳</span></span><span class="brand-name">ZERO ONZE HAIR STUDIO <small>BARBERÍA Y PELUQUERÍA · TEATINOS</small></span></a><p>{business.streetAddress}, {business.city}<br /><a href={phoneHref}>{business.phone}</a></p><a class="footer-maps" href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><small>© {new Date().getFullYear()} Zero Onze hair studio · Teatinos, Málaga</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
</footer>
		<a class="phone-cta" href={phoneHref}><span aria-hidden="true">☎</span> Llamar al salón <strong>{business.phone}</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						<WhatsappFab phone={datos.phoneHref} name={datos.business?.name} />
						</body>
</html>


