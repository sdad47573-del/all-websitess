---
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	facebookPhotosUrl,
	facebookUrl,
	faqSchema,
	faqs,
	instagramLocationUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	specialties,
	tripadvisorUrl,
} from '../lib/business';

const title = 'La Antigua Brasa | Asador y carnes a la brasa en Córdoba';
const description =
	'Restaurante La Antigua Brasa en Córdoba, Polígono Tecnocórdoba: carnes a la brasa, cocina andaluza y platos caseros. Consulta y reserva: 957 32 63 54.';
const keywords =
	'La Antigua Brasa Córdoba, asador Córdoba, restaurante Tecnocórdoba, carne a la brasa Córdoba, cocina andaluza, Calle Letonia 5, menú del día Córdoba, reservar La Antigua Brasa';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#30241f" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración original de una pieza de carne a la brasa para La Antigua Brasa; no es una fotografía del restaurante" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante La Antigua Brasa, inicio">
				<span class="brand-mark" aria-hidden="true">A</span>
				<span class="brand-copy">La Antigua Brasa <small>Asador · Córdoba</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cocina">La brasa</a>
				<a href="#restaurante">El restaurante</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 957 32 63 54</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Córdoba · Polígono Tecnocórdoba</p>
					<h1 id="hero-title">Tradición que<br />se cocina <em>al fuego.</em></h1>
					<p class="hero-intro">Carnes a la brasa, cocina andaluza y platos caseros en La Antigua Brasa. Una mesa acogedora para disfrutar del sabor del asador, desde el desayuno hasta la comida.</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar y reservar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Estamos en</small><address>{business.streetAddress}<br />{business.postalCode} · Córdoba</address></div>
						<div><small>Reservas y consultas</small><a href={phoneHref}>{business.phone}</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración vectorial original de un corte a la brasa, no es una foto del restaurante">
					<span class="plate-dot" aria-hidden="true"></span><div class="plate" aria-hidden="true"><div class="steak"></div></div>
					<div class="art-caption"><strong>El punto de la brasa</strong>Cocina andaluza · producto</div>
				</div>
			</section>

			<div class="promise" aria-label="La cocina de La Antigua Brasa">
				<span>Cocina a la brasa</span><span>Especialidades andaluzas</span><span>Platos caseros</span><span>Menú del día</span>
			</div>

			<section class="section intro" id="restaurante" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Asador en Córdoba</p>
					<h2 id="intro-title">Un alto en el camino,<br /><em>una buena mesa.</em></h2>
				</div>
				<div class="intro-copy">
					<p>La Antigua Brasa está en el Polígono Industrial Tecnocórdoba, en la calle Letonia. Su cocina combina el recetario andaluz y los platos caseros con carnes preparadas a la brasa: una opción para hacer una pausa y compartir la mesa en Córdoba.</p>
					<p>Además de sus cortes a la parrilla, en publicaciones y reseñas se mencionan desayunos, menú del día, solomillo y alcachofas. La carta cambia según el servicio; llama para conocer lo que preparan hoy.</p>
					<p class="source-note">La dirección C. Letonia, 5 figura en varios directorios y coincide con la ubicación de Maps. Las fuentes muestran dos variantes del número de teléfono; el que aparece en el perfil público de Facebook es 957 32 63 54. Confírmalo si no consigues contactar.</p>
				</div>
			</section>

			<section class="section menu-section" id="cocina" aria-labelledby="menu-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Cocina andaluza · a la brasa</p>
						<h2 id="menu-title">El sabor de<br /><em>la parrilla.</em></h2>
					</div>
					<p>Selección orientativa basada en fuentes locales y publicaciones de clientes; no es la carta oficial. Pregunta por platos, disponibilidad, precios y alérgenos antes de pedir.</p>
				</div>
				<div class="menu-grid">
					{specialties.map((dish, index) => (
						<article class="menu-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<p class="menu-note">La disponibilidad depende del día y del servicio. <a href={phoneHref}>Llama para consultar y reservar</a>.</p>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<p class="section-label"><span aria-hidden="true"></span> La Antigua Brasa en imágenes</p>
				<h2 id="gallery-title">Mira el local<br /><em>y sus brasas.</em></h2>
				<p class="gallery-copy">El enlace de Google Maps identifica el lugar, pero no ofrece URLs directas de los archivos fotográficos. Abre las galerías externas para ver las imágenes reales del restaurante y sus platos.</p>
				<div class="gallery-grid">
					<a class="gallery-card" href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Ver ficha y fotos de La Antigua Brasa en Google Maps">
						<span class="gallery-tag">Fotos en la ficha</span><span class="gallery-title">Google Maps <span aria-hidden="true">↗</span></span>
					</a>
					<a class="gallery-card" href={facebookPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos publicadas en la página de Facebook del restaurante">
						<span class="gallery-tag">Página del negocio</span><span class="gallery-title">Facebook <span aria-hidden="true">↗</span></span>
					</a>
					<a class="gallery-card" href={instagramLocationUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos etiquetadas en Instagram en La Antigua Brasa">
						<span class="gallery-tag">Fotos etiquetadas</span><span class="gallery-title">Instagram <span aria-hidden="true">↗</span></span>
					</a>
				</div>
				<p class="gallery-note">La ilustración de portada y los fondos son gráficos vectoriales originales, no fotografías del local. Las fotos reales se consultan en Maps y en las galerías vinculadas.</p>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14014 · Córdoba</p>
					<h2 id="visit-title">Te esperamos<br /><em>en la brasa.</em></h2>
					<address>{business.streetAddress}<br />Polígono Tecnocórdoba<br />{business.postalCode} {business.city}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Contacto y reservas</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Indicaciones</small><a href={mapsUrl} target="_blank" rel="noreferrer">Abrir ficha de Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Perfil del establecimiento</small><a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a> · <a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor ↗</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar al restaurante</a>
					</div>
					<p class="menu-note">Confirma horario, disponibilidad y teléfono por los canales del establecimiento antes de desplazarte.</p>
				</div>
				<div class="map-card">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Restaurante La Antigua Brasa en Calle Letonia, Córdoba" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<div class="map-label"><div><strong>Restaurante La Antigua Brasa</strong><small>C. Letonia · Tecnocórdoba · Córdoba</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
			<Galeria nombre="Restaurante La Antigua Brasa" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="La Antigua Brasa, volver al inicio">
				<span class="brand-mark" aria-hidden="true">A</span><span class="brand-copy">Restaurante La Antigua Brasa <small>Asador · Córdoba</small></span>
			</a>
			<nav class="footer-nav" aria-label="Perfiles y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Restaurante La Antigua Brasa · Córdoba. Consulta carta y horarios con el establecimiento.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar para reservar <span>957 32 63 54</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>


