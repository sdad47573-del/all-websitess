---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/comidas-para-llevar-el-brujo-apaisada-01.jpg';
import pasta from '../assets/fotos/comidas-para-llevar-el-brujo-vertical-02.jpg';
import postre from '../assets/fotos/comidas-para-llevar-el-brujo-apaisada-03.jpg';
import arrozBacalao from '../assets/fotos/comidas-para-llevar-el-brujo-vertical-04.jpg';
import terrazaCubierta from '../assets/fotos/comidas-para-llevar-el-brujo-apaisada-05.jpg';
import salon from '../assets/fotos/comidas-para-llevar-el-brujo-apaisada-06.jpg';
import terraza from '../assets/fotos/comidas-para-llevar-el-brujo-apaisada-07.jpg';
import polloPlato from '../assets/fotos/comidas-para-llevar-el-brujo-apaisada-08.jpg';
import polloBrasa from '../assets/fotos/comidas-para-llevar-el-brujo-apaisada-09.jpg';
import pulpo from '../assets/fotos/comidas-para-llevar-el-brujo-apaisada-10.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'El Brujo · Asador y comida para llevar en Murcia';
const description =
	'Comidas para llevar El Brujo, en Cam. San José, 127 (30570 San José de la Montaña, Murcia). Pollos y corderos asados, carnes a la brasa y arroces.';

const galeria = [
	{
		src: comedor,
		alt: 'El comedor de El Brujo con mesas de mantel rojo, discos de vinilo en la pared y el rótulo del local sobre la puerta',
	},
	{
		src: polloBrasa,
		alt: 'Pollo a la brasa dorado y crujiente, recién sacado del asador de El Brujo',
	},
	{
		src: arrozBacalao,
		alt: 'Un plato de arroz rojo de arroz a banda con un lomo de pescado y una cucharada de alioli',
	},
	{
		src: pulpo,
		alt: 'Tres tostas de pulpo a la brasa con tomates cherry y hierbas sobre una pizarra negra',
	},
	{
		src: pasta,
		alt: 'Una bandeja de pasta con jamón y tomate en el mostrador de la cocina',
	},
	{
		src: polloPlato,
		alt: 'Una fuente de pollo troceado a la brasa con limón y lima, servida en la mesa',
	},
	{
		src: postre,
		alt: 'Cuatro canutillos de crema bañados con hilo de chocolate en un plato blanco',
	},
	{
		src: salon,
		alt: 'El salón principal de El Brujo con mesas vestidas, sillas de madera y grandes ventanales con rejas',
	},
	{
		src: terrazaCubierta,
		alt: 'La terraza cubierta de El Brujo con mesas de mantel azul, plantas y el muro de piedra al fondo',
	},
	{
		src: terraza,
		alt: 'La terraza exterior de El Brujo con mesas de mantel blanco, macetas y vistas al campo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-brujo`,
	name: BUSINESS.fullName,
	alternateName: ['El Brujo', 'El Brujo San José de la Montaña', 'Asador El Brujo Murcia'],
	description:
		'Asador y comida para llevar en el Camino de San José, 127 (30570 San José de la Montaña, Murcia): pollos y corderos asados, carnes a la brasa y arroces, con comedor y terraza.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34968823380',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina murciana', 'Carnes a la brasa', 'Arroces', 'Comida para llevar'],
	hasMenu: {
		'@type': 'Menu',
		name: 'Carta de El Brujo',
		inLanguage: 'es-ES',
		hasMenuSection: MENU.map((group) => ({
			'@type': 'MenuSection',
			name: group.title,
			hasMenuItem: group.items.map((item) => ({
				'@type': 'MenuItem',
				name: item.name,
				description: item.note,
			})),
		})),
	},
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Murcia' },
		{ '@type': 'AdministrativeArea', name: 'Región de Murcia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday'],
			opens: '09:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2a120a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Karla:wght@400;500;700&family=Oswald:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Comidas para llevar El Brujo, El Brujo Murcia, asador San José de la Montaña, pollos asados Murcia, cordero asado San José de la Montaña, carnes a la brasa Murcia, arroz a banda 30570"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollos y corderos asados, carnes a la brasa y arroces en Cam. San José, 127, San José de la Montaña. Comedor, terraza y comida para llevar."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Pollo a la brasa dorado del asador El Brujo, en San José de la Montaña"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2a120a"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="San José de la Montaña, Murcia"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Brujo"
			subtitle="Asador · Comidas para llevar · Murcia"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Cam. San José, 127 · San José de la Montaña"
				title="Del asador <br /><em>a la mesa.</em>"
				lede={`El Brujo es asador y casa de comidas en el Camino de San José, 127, a las afueras de Murcia. La ficha lo define con tres etiquetas: comida para llevar, especialidad en pollo y asador de cordero. Las fotos del perfil enseñan los dos comedores, la terraza y el pollo recién sacado de la brasa. Abre de jueves a domingo de 9:00 a 16:00 y los lunes hasta las 17:00, con ${RATING.label} sobre 5 en Google y ${RATING.count} reseñas.`}
				image={comedor}
				imageAlt="El comedor de El Brujo con mesas de mantel rojo, discos de vinilo en la pared y el rótulo del local sobre la puerta"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>9:00–16:00</b> · jueves a domingo' },
					{ label: 'Especialidad', html: '<b>Pollo y cordero</b> al asador' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Asador"
			/>

			<LocalChips label="Lo que ofrece El Brujo" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Brasa, comedor <br /><em>y terraza.</em>"
				paragraphs={[
					'El Brujo está en el Camino de San José, 127, en San José de la Montaña, a las afueras de Murcia. La ficha lo clasifica como restaurante de comida para llevar, restaurante especializado en pollo y asador de cordero: el asador no es un añadido, es la razón de la casa.',
					'Las fotos del perfil enseñan el sitio por dentro: dos comedores con mesas vestidas de rojo y cuadros vichy, sillas de madera, paredes alicatadas y discos de vinilo colgados; fuera, una terraza cubierta con manteles azules y otra al aire con vistas al campo. El rótulo «El Brujo» preside la puerta del salón.',
					'En la mesa se repiten las carnes a la brasa y los arroces. Una reseña elogia «el tataki de atún, la croqueta de gamba roja y el arroz a banda»; otra resume el sitio como «buen sitio para carnes a la brasa y arroces»; una tercera habla de «buena comida, buen precio y buena calidad y buen servicio».',
					`La ficha suma ${RATING.count} reseñas con una media de ${RATING.label}. No publica carta ni precios, así que aquí solo aparecen los platos que citan esas opiniones y las categorías del propio local.`,
				]}
				note="La ficha no publica carta con precios, formas de pago, reparto a domicilio ni redes sociales. Los platos de esta página salen de las categorías del local y de las reseñas destacadas; el resto de la carta se consulta por teléfono. El horario puede cambiar en festivos."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que se pide</p>
					<h2 id="highlights-title">Pollo, cordero <br /><em>y brasa.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La comida"
				title="Lo que sale <br /><em>del asador.</em>"
				description="No hay carta pública con precios: esto es lo que la ficha del local y sus reseñas destacadas permiten afirmar, sin inventar platos ni importes."
				cta={{ label: `Preguntar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Platos tomados de las categorías de Google (comida para llevar, especialidad en pollo, asador de cordero) y de las reseñas destacadas del perfil. La carta completa, la disponibilidad del día y los precios se confirman en el 968 82 33 80."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor, la terraza <br /><em>y la brasa.</em>"
				description="Diez fotografías del perfil de El Brujo: el comedor con los discos en la pared, el pollo a la brasa, el arroz con pescado, el pulpo sobre pizarra, la pasta del mostrador, los canutillos de postre, el salón principal y las dos terrazas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,2 sobre 5, <em>con 363 reseñas.</em></h2>
						<p>
							Google publica una media de 4,2 con 363 opiniones (noviembre de 2026). Las reseñas
							que se ven aquí elogian el tataki, la croqueta de gamba roja, el arroz a banda, las
							carnes a la brasa y la relación calidad-precio. Son las que destaca la ficha; hay
							muchas más opiniones en Google.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,2</strong>
						<span>★★★★★</span>
						<small>363 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En el camino <br /><em>de San José.</em>"
				addressLines={[BUSINESS.street, BUSINESS.postalCode, `${BUSINESS.district}, ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha: lunes de 9:00 a 17:00, de jueves a domingo de 9:00 a 16:00, con martes y miércoles cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Comidas para llevar El Brujo en el Camino de San José, 127, San José de la Montaña"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Cam. San José, 127 · Murcia"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote={`Pedidos y mesa por teléfono en el ${BUSINESS.phone}. La ficha declara acceso para sillas de ruedas, aunque no asientos adaptados, y no publica reparto a domicilio ni reserva online.`}
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>ir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultados en noviembre de 2026. La ficha no publica carta con precios: confirma platos y horario antes de la visita."
			ctaLabel="Llamar a El Brujo"
			navAriaLabel="Enlaces de Comidas para llevar El Brujo"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
