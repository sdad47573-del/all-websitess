---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/restaurante-habibi-panoramica-01.jpg';
import shawarma from '../assets/fotos/restaurante-habibi-vertical-02.jpg';
import mesaCaril from '../assets/fotos/restaurante-habibi-panoramica-03.jpg';
import shawarmaPrato from '../assets/fotos/restaurante-habibi-vertical-04.jpg';
import mesaKabsah from '../assets/fotos/restaurante-habibi-vista-5-05.jpg';
import kabsah from '../assets/fotos/restaurante-habibi-apaisada-06.jpg';
import batatas from '../assets/fotos/restaurante-habibi-vertical-07.jpg';
import kabsahFatayer from '../assets/fotos/restaurante-habibi-vertical-08.jpg';
import fatteh from '../assets/fotos/restaurante-habibi-vertical-09.jpg';
import doce from '../assets/fotos/restaurante-habibi-cuadrada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICOS,
} from '../data/site';

const title = 'Habibi · Cozinha síria e shawarma halal em Lisboa';
const description =
	'Restaurante Habibi, cozinha síria e shawarma halal na Rua Cavaleiro de Oliveira, 39D, em Lisboa. Aberto das 12:00 às 22:30, exceto à segunda.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada do Restaurante Habibi com o toldo negro, o letreiro de comida do Médio Oriente e shawarma, e as mesas na calçada',
	},
	{
		src: shawarma,
		alt: 'Prato de shawarma com pão sírio, batatas fritas, pickles e molho de alho',
	},
	{
		src: mesaCaril,
		alt: 'Mesa do Habibi com um caril de carne, arroz, hommus, salada e pão sírio',
	},
	{
		src: shawarmaPrato,
		alt: 'Shawarma em pão sírio com tiras de cenoura, pickles, pepino e molho de alho',
	},
	{
		src: mesaKabsah,
		alt: 'Mesa posta no Habibi com kabsah de borrego, hommus, tabbouleh, sopa e kibbeh',
	},
	{
		src: kabsah,
		alt: 'Kabsah de arroz amarelo com carne de borrego, castanha de caju e molho de tomate picante',
	},
	{
		src: batatas,
		alt: 'Batatas fritas com pão sírio, salada e molho de alho num prato fundo',
	},
	{
		src: kabsahFatayer,
		alt: 'Kabsah de borrego com fatayer, labneh, folhas de videira e salada',
	},
	{
		src: fatteh,
		alt: 'Fatteh com pão estaladiço, iogurte, carne picada e amêndoas laminadas',
	},
	{
		src: doce,
		alt: 'Dois doces halawet al-jbn cobertos de pistácio num prato azul',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta do Restaurante Habibi',
	inLanguage: 'pt-PT',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			offers: {
				'@type': 'Offer',
				price: item.price?.replace(' €', '').replace(',', '.'),
				priceCurrency: 'EUR',
			},
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#habibi`,
	name: BUSINESS.name,
	alternateName: ['Habibi', 'Habibi Lisboa', 'Restaurante Habibi Lisboa'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, MAPS.ubereats, MAPS.bolt],
	telephone: '+351 21 813 1655',
	currenciesAccepted: 'EUR',
	priceRange: '€€',
	servesCuisine: ['Cozinha síria', 'Cozinha do Médio Oriente', 'Shawarma', 'Falafel', 'Cozinha halal'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Distrito de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '22:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-habibi-vista-5-05.jpg": mesaKabsah,
	"restaurante-habibi-panoramica-01.jpg": fachada,
	"restaurante-habibi-vertical-02.jpg": shawarma,
	"restaurante-habibi-panoramica-03.jpg": mesaCaril,
	"restaurante-habibi-vertical-04.jpg": shawarmaPrato,
	"restaurante-habibi-apaisada-06.jpg": kabsah,
	"restaurante-habibi-vertical-07.jpg": batatas,
	"restaurante-habibi-vertical-08.jpg": kabsahFatayer,
	"restaurante-habibi-vertical-09.jpg": fatteh,
	"restaurante-habibi-cuadrada-10.jpg": doce,
};
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2a1a18" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Jost:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Habibi, Habibi Lisboa, shawarma Lisboa, comida síria Lisboa, falafel Lisboa, restaurante halal Lisboa, Cavaleiro de Oliveira, kabsah, hommus"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cozinha síria e shawarma halal na Rua Cavaleiro de Oliveira, 39D, em Lisboa. Aberto das 12:00 às 22:30, exceto à segunda. 4,9 no Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada do Restaurante Habibi em Lisboa, com o toldo negro e as mesas na calçada"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2a1a18"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lisboa"
			locale="pt_PT"
			countryName="Portugal"
			preload={[mesaKabsah]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Habibi"
			subtitle="Cozinha síria · Lisboa"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Uber Eats ↗', href: MAPS.ubereats, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Carta e preços do menu de entrega da casa; confirma horário e valores antes da visita."
			ctaLabel="Ligar ao Habibi"
			navAriaLabel="Ligações do Restaurante Habibi"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/351218131655?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carta%20do%20Restaurante%20Habibi." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carta do Restaurante Habibi"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
