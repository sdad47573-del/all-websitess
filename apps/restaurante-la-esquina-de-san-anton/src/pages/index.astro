---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/restaurante-la-esquina-de-san-anton-apaisada-01.jpg';
import foto1 from '../assets/fotos/restaurante-la-esquina-de-san-anton-apaisada-03.jpg';
import foto2 from '../assets/fotos/restaurante-la-esquina-de-san-anton-vertical-04.jpg';
import foto3 from '../assets/fotos/restaurante-la-esquina-de-san-anton-apaisada-05.jpg';
import foto4 from '../assets/fotos/restaurante-la-esquina-de-san-anton-vertical-06.jpg';
import foto5 from '../assets/fotos/restaurante-la-esquina-de-san-anton-apaisada-08.jpg';

const business = {
	name: 'Restaurante La Esquina de San Antón',
	short: 'La Esquina de San Antón',
	street: 'C. Camilo José Cela, 2',
	city: 'Fortuna',
	region: 'Región de Murcia',
	province: 'Murcia',
	postalCode: '30620',
	phone: '+34 615 57 31 45',
	latitude: 38.1829019,
	longitude: -1.1268699,
	site: 'https://restaurante-la-esquina-de-san-anton.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+La+Esquina+de+San+Ant%C3%B3n/@38.1829019,-1.1268699,17z/data=!3m1!4b1!4m6!3m5!1s0xd638f8799ee29d1:0xb2ad9a96906cf055!8m2!3d38.1829019!4d-1.1268699!16s%2Fg%2F11k1dqp2bp?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34615573145';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'La despensa',
		title: 'Pescado y carnes frescas',
		text: 'Pescado y carnes frescas: es lo primero que citan las reseñas de la casa cuando hablan de la comida.',
	},
	{
		kicker: 'Para picar',
		title: 'Aperitivos y pulpo',
		text: 'Todo tipo de aperitivos, con el pulpo entre los que más se nombran: «sabrosos trozos de pulpo», cuenta una reseña.',
	},
	{
		kicker: 'El postre',
		title: 'Postres caseros',
		text: 'Postres caseros para terminar el almuerzo, junto a los aperitivos y la cocina de siempre.',
	},
	{
		kicker: 'Al mediodía',
		title: 'Buen sitio para almorzar',
		text: '«Un buen sitio para almorzar, buen servicio y económico», resume uno de los comentarios de Google Maps.',
	},
	{
		kicker: 'El fin de semana',
		title: 'Viernes y sábado, hasta las 23:00',
		text: 'Viernes y sábado abre hasta las 23:00; el resto de días, hasta las 17:00. El martes cierra.',
	},
	{
		kicker: 'En familia',
		title: 'Aperitivo con niños',
		text: 'Una reseña cuenta que disfrutaron del aperitivo con los niños: es un sitio al que se puede ir en familia.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de La Esquina de San Antón publicada en su ficha de Google Maps' },
	{ src: photos.foto2, alt: 'Imagen del restaurante en Fortuna tomada de su galería de Google Maps' },
	{ src: photos.foto3, alt: 'Fotografía del restaurante en la calle Camilo José Cela, 2, Fortuna' },
	{ src: photos.foto4, alt: 'Imagen de La Esquina de San Antón subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Vista de La Esquina de San Antón según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está La Esquina de San Antón?',
		a: 'En la calle Camilo José Cela, 2, 30620 Fortuna (Murcia). Coordenadas 38.1829019, -1.1268699.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Lunes, miércoles, jueves y domingo abre de 7:30 a 17:00; viernes y sábado, de 7:30 a 23:00. El martes cierra, según su ficha de Google Maps.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Cocina española con pescado y carnes frescas, aperitivos, tapas y postres caseros. Las reseñas citan también el pulpo del aperitivo.',
	},
	{
		q: '¿Se puede almorzar?',
		a: 'Sí. Las reseñas lo describen como un buen sitio para almorzar, con buen servicio y económico. Abre desde las 7:30.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso, aparcamiento, aseo y asientos adaptados para sillas de ruedas.',
	},
	{
		q: '¿Cómo se contacta?',
		a: 'Llamando al 615 57 31 45. Si vienes en festivo o quieres confirmar el horario, es mejor llamar antes.',
	},
];

const images = [
	`${business.site}/og.jpg`,
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'Restaurante La Esquina de San Antón, cocina española en Fortuna (Murcia): pescado y carnes frescas, aperitivos y postres caseros. Llama al 615 57 31 45.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: business.short,
	description,
	url: `${business.site}/`,
	telephone: business.phone,
	image: images,
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Tapas'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Sunday'],
			opens: '07:30',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '07:30',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.5,
		reviewCount: 551,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1b222b" />
		<meta
			name="description"
			content="Restaurante La Esquina de San Antón, cocina española en Fortuna (Murcia): pescado y carnes frescas, aperitivos y postres caseros. Llama al 615 57 31 45."
		/>
		<meta
			name="keywords"
			content="La Esquina de San Antón, restaurante Fortuna, cocina española Fortuna, pescado fresco Murcia, aperitivos Fortuna, postres caseros"
		/>
		<meta name="author" content="Restaurante La Esquina de San Antón" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>La Esquina de San Antón | Cocina española en Fortuna</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="La Esquina de San Antón · Cocina española en Fortuna" />
		<meta
			property="og:description"
			content="Pescado y carnes frescas, aperitivos y postres caseros en la calle Camilo José Cela, 2 (Fortuna)."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.jpg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Restaurante La Esquina de San Antón, en Fortuna (Murcia)" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="La Esquina de San Antón · Cocina española en Fortuna" />
		<meta
			name="twitter:description"
			content="Cocina española en Fortuna (Murcia), con pescado y carnes frescas. Llama al 615 57 31 45."
		/>
		<meta name="twitter:image" content={`${business.site}/og.jpg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Fortuna" />
		<meta name="geo.position" content="38.1829019;-1.1268699" />
		<meta name="ICBM" content="38.1829019, -1.1268699" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="La Esquina de San Antón, inicio">
				<span class="brand-mark" aria-hidden="true">E</span>
				<span class="brand-name">La Esquina de San Antón <small>Fortuna · Murcia</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">El restaurante</a>
				<a href="#cocina">La cocina</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>615 57 31 45</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C. Camilo José Cela, 2 · Fortuna</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante La Esquina de San Antón, cocina española en Fortuna (Murcia). Pescado y carnes
						frescas, aperitivos, tapas y postres caseros. Abre al mediodía y amplía hasta las 23:00 los
						viernes y sábados.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 615 57 31 45</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,5</b> en Google (551 reseñas)</li>
						<li>Pescado y carnes frescas</li>
						<li>Postres caseros</li>
						<li>Fortuna</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						alt="Restaurante La Esquina de San Antón, cocina española en Fortuna"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,5</b><span>Google</span></div>
					<div><b>551</b><span>Reseñas</span></div>
					<div><b>6/7</b><span>Días</span></div>
				</div>
				<ul class="services">
					<li>Cocina española</li>
					<li>Pescado fresco</li>
					<li>Aperitivos</li>
					<li>Postres caseros</li>
					<li>Almuerzos</li>
					<li>Local accesible</li>
				</ul>
			</section>

			<section class="about section-pad" id="restaurante">
				<p class="section-label"><span aria-hidden="true"></span> Cocina española en Fortuna</p>
				<div class="about-grid">
					<h2>Producto fresco<br />y cocina<br /><em>de siempre.</em></h2>
					<div class="about-copy">
						<p>
							Restaurante La Esquina de San Antón está en la calle Camilo José Cela, 2, en Fortuna (Murcia).
							Cocina española con pescado y carnes frescas, aperitivos, tapas y postres caseros.
						</p>
						<p>
							Las reseñas destacan el pescado y la carne frescos, los aperitivos y los postres caseros.
							También el pulpo del aperitivo y el buen servicio: un buen sitio para almorzar, económico,
							según sus clientes.
						</p>
						<p class="about-note">
							Abre lunes, miércoles, jueves y domingo de 7:30 a 17:00; viernes y sábado, hasta las 23:00. El
							martes cierra. Llama al 615 57 31 45.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="cocina">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Lo que se pide</p>
						<h2>De la barra<br />a la <em>mesa.</em></h2>
					</div>
					<p>
						Aperitivos, pescado y carnes frescas, y postres caseros. Lo que más repiten sus clientes en las
						reseñas, además del buen servicio y los precios.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>La Esquina<br /><em>en imágenes.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Restaurante La Esquina de San Antón.
							En la ficha encontrarás la galería completa, con aportaciones de clientes, y las reseñas
							actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="avif"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres el
					titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C. Camilo José Cela, 2</p>
					<h2>Ven a Fortuna<br /><em>a comer.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes, miércoles y jueves</th>
								<td>7:30 – 17:00</td>
							</tr>
							<tr>
								<th scope="row">Viernes y sábado</th>
								<td>7:30 – 23:00</td>
							</tr>
							<tr>
								<th scope="row">Domingo</th>
								<td>7:30 – 17:00</td>
							</tr>
							<tr>
								<th scope="row">Martes</th>
								<td>Cerrado</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, llama antes de venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar 615 57 31 45</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 615 57 31 45</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Restaurante La Esquina de San Antón en la calle Camilo José Cela, 2, Fortuna"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> La Esquina de San Antón · Fortuna
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">E</span>
				<p>La Esquina de San Antón<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Restaurante La Esquina de San Antón · Fortuna, Murcia. Fotografías procedentes de la
				ficha del restaurante en Google Maps.
			</small>

			<p class="footer-credit">
				Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
				<a href="https://sur-digital.vercel.app/" rel="noopener">sur-digital.vercel.app</a>
			</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>615 57 31 45</span></a>
		<nav class="legal-links" aria-label="Información legal">
