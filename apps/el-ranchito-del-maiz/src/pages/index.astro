---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import arepaPollo from '../assets/fotos/el-ranchito-del-maiz-apaisada-01.jpg';
import arepaBacon from '../assets/fotos/el-ranchito-del-maiz-apaisada-02.jpg';
import arepaPlato from '../assets/fotos/el-ranchito-del-maiz-apaisada-03.jpg';
import arepaEmpanadas from '../assets/fotos/el-ranchito-del-maiz-vertical-05.jpg';
import pescadoPatacones from '../assets/fotos/el-ranchito-del-maiz-vertical-06.jpg';
import rotulo from '../assets/fotos/el-ranchito-del-maiz-vertical-07.jpg';
import arepaSalsas from '../assets/fotos/el-ranchito-del-maiz-vertical-08.jpg';
import pescadoArroz from '../assets/fotos/el-ranchito-del-maiz-vertical-09.jpg';
import arepaCarne from '../assets/fotos/el-ranchito-del-maiz-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'El Ranchito del Maíz · Arepas y empanadas en Sevilla';
const description =
	'El Ranchito del Maíz, arepas y empanadas 100 % de maíz en C. Fernando Zóbel, 1, local 24, Sevilla. Comida tradicional, rellenos generosos y pedidos por WhatsApp. Fotos, horario, teléfono y reseñas.';

const galeria = [
	{ src: arepaPlato, alt: 'Arepa rellena con carne, queso y aguacate junto a patatas fritas' },
	{ src: arepaPollo, alt: 'Arepa de pollo desmechado con queso rallado y aguacate' },
	{ src: arepaEmpanadas, alt: 'Arepa de pollo con aguacate junto a empanadas fritas y lima' },
	{ src: arepaBacon, alt: 'Arepa con bacon, huevo, queso y aguacate' },
	{ src: pescadoPatacones, alt: 'Pescado frito con arroz, ensalada y patacones fritos' },
	{ src: pescadoArroz, alt: 'Pescado frito con arroz y ensalada de tomate y cebolla' },
	{ src: arepaSalsas, alt: 'Arepa servida en bandeja azul con dos salsas de la casa' },
	{ src: arepaCarne, alt: 'Arepa de carne mechada con queso rallado y aguacate' },
	{ src: rotulo, alt: 'Rótulo de neón de El Ranchito del Maíz en la fachada del local' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Oferta de El Ranchito del Maíz',
	inLanguage: 'es-ES',
	description:
		'Selección orientativa basada en las fotografías del perfil público; la ficha no publica una carta oficial ni precios.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-ranchito-del-maiz`,
	name: BUSINESS.name,
	alternateName: ['El Ranchito del Maiz', 'El Ranchito del Maiz Sevilla'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34661317803',
	servesCuisine: ['Arepas', 'Empanadas', 'Comida tradicional', 'Comida para llevar'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Sunday'],
			opens: '10:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Sunday'],
			opens: '20:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '10:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '20:00',
			closes: '02:00',
		},
	],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Oferta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..600;1,400..500&family=Nunito+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Ranchito del Maíz Sevilla, arepas Sevilla, empanadas de maíz Sevilla, comida venezolana Sevilla, Fernando Zóbel, comida para llevar Sevilla, pedidos WhatsApp"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Arepas y empanadas 100 % de maíz en Fernando Zóbel, 1. Comida tradicional, fotos, horario y pedidos por WhatsApp."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Arepa de El Ranchito del Maíz con carne, queso y aguacate"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#14484a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Sevilla"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[arepaPlato]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Ranchito del Maíz"
			subtitle="Arepas de maíz · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Fernando Zóbel, 1, local 24 · Sevilla"
				title="Arepas de maíz, <br /><em>hechas al momento.</em>"
				lede={`El Ranchito del Maíz prepara arepas y empanadas 100 % de maíz, con rellenos generosos y salsas de la casa. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas y el negocio atiende pedidos por WhatsApp.`}
				image={arepaPlato}
				imageAlt="Arepa rellena de carne con queso, aguacate y patatas fritas"
				primaryCta={{ label: 'Pedir por WhatsApp', href: BUSINESS.whatsapp }}
				secondaryCta={{ label: 'Ver ficha en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Especialidad', html: '<b>Arepas y empanadas</b> de maíz' },
					{ label: 'Valoración', html: `<b>${RATING.label}</b> · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>10:00–16:00</b> y <b>20:00</b> noche' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver fotos y ficha"
				tag="100 % maíz"
			/>

			<LocalChips label="Servicios de El Ranchito del Maíz" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Maíz, plancha <br /><em>y buen relleno.</em>"
				paragraphs={[
					'El Ranchito del Maíz es un local de comida tradicional en la calle Fernando Zóbel, 1, local 24, en Sevilla. Su especialidad son las arepas y las empanadas 100 % de maíz, preparadas al momento y con ingredientes de calidad, como explica el propio negocio en su ficha.',
					'En las fotografías del perfil se ven arepas rellenas de pollo o de carne desmechada con queso rallado y aguacate, arepas con bacon y huevo, empanadas fritas, pescado frito con arroz y ensalada, y platos con patatas. Cada pedido llega con dos salsas, una roja y una blanca.',
					'La ficha lo clasifica como comida a domicilio y el negocio invita a pedir por WhatsApp. Abre a mediodía y vuelve por la noche; los viernes y los sábados alarga el servicio hasta las 2:00. Los lunes cierra.',
				]}
				note="La ficha no publica carta ni precios. Los platos citados son los que aparecen en las fotografías públicas del establecimiento; pregunta por WhatsApp por los rellenos, las salsas y el reparto."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotografías', href: '#galeria' },
					{ label: `Escribir al ${BUSINESS.phone}`, href: BUSINESS.whatsapp, external: true },
				]}
			/>

			<ul class="highlights">
				{
					HIGHLIGHTS.map((item) => (
						<li>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</li>
					))
				}
			</ul>

			<LocalMenu
				eyebrow="Lo que sale de la plancha"
				title="Arepas, empanadas <br /><em>y platos.</em>"
				description="La ficha no tiene carta publicada, así que esta selección se apoya en las fotografías del local: arepas de maíz con distintos rellenos, empanadas fritas, pescado con arroz y las salsas de la casa."
				cta={{ label: 'Preguntar precios por WhatsApp', href: BUSINESS.whatsapp }}
				groups={MENU}
				note="No hay precios ni carta oficial publicados. Confirma rellenos, disponibilidad y precio del pedido por WhatsApp o teléfono antes de acercarte."
			/>

			<LocalGallery
				eyebrow="Fotos del perfil de Google Maps"
				title="Arepas, empanadas <br /><em>y el rótulo de neón.</em>"
				description="Algunas de las fotografías públicas del establecimiento: las arepas con sus rellenos, las empanadas fritas, el pescado con arroz y la fachada del local."
				images={galeria}
				cta={{ label: 'Abrir la ficha en Google Maps', href: MAPS.place }}
				note="Imágenes descargadas del perfil público de El Ranchito del Maíz en Google Maps y servidas desde esta página."
			/>

			<section class="notas" aria-labelledby="notas-title">
				<div class="wrap notas-grid">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="notas-title">Lo que dicen <em>las reseñas.</em></h2>
						<p class="notas-score">
							<strong>{RATING.label}</strong>
							<span>
								<b>★★★★★</b>
								{RATING.count} reseñas<br />en Google
							</span>
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer reseñas en Google ↗
						</a>
					</div>

					<div class="notas-copy">
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>{resena.texto}</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Opinión en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<p class="notas-foot">
							La valoración y el número de reseñas corresponden a la ficha consultada en octubre
							de 2026 y pueden variar. <a href={MAPS.reviews} target="_blank" rel="noreferrer"
								>Consulta las opiniones actualizadas en Google ↗</a
							>.
						</p>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Fernando <br /><em>Zóbel.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de El Ranchito del Maíz en C. Fernando Zóbel, 1, local 24, Sevilla"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Fernando Zóbel, 1 · Sevilla"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Pedir por WhatsApp · ${BUSINESS.phone}`, href: BUSINESS.whatsapp, external: true }}
				reserveNote="Los pedidos se atienden por WhatsApp o teléfono en el 661 31 78 03. Pregunta por los rellenos del día, las salsas y las condiciones de reparto antes de encargar."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma horario, platos y precios con el establecimiento."
			ctaLabel="Pedir en El Ranchito"
			navAriaLabel="Enlaces de El Ranchito del Maíz"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
