---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import arepaPollo from '../assets/fotos/el-ranchito-del-maiz-apaisada-01.jpg';
import arepaBacon from '../assets/fotos/el-ranchito-del-maiz-apaisada-02.jpg';
import arepaPlato from '../assets/fotos/el-ranchito-del-maiz-apaisada-03.jpg';
import arepaEmpanadas from '../assets/fotos/el-ranchito-del-maiz-vertical-05.jpg';
import pescadoPatacones from '../assets/fotos/el-ranchito-del-maiz-vertical-06.jpg';
import rotulo from '../assets/fotos/el-ranchito-del-maiz-vertical-07.jpg';
import arepaSalsas from '../assets/fotos/el-ranchito-del-maiz-vertical-08.jpg';
import pescadoArroz from '../assets/fotos/el-ranchito-del-maiz-vertical-09.jpg';
import arepaCarne from '../assets/fotos/el-ranchito-del-maiz-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'El Ranchito del Maíz · Arepas y empanadas en Sevilla';
const description =
	'El Ranchito del Maíz, arepas y empanadas 100 % de maíz en C. Fernando Zóbel, 1, local 24, Sevilla. Comida tradicional, rellenos generosos y pedidos por WhatsApp. Fotos, horario, teléfono y reseñas.';

const galeria = [
	{ src: arepaPlato, alt: 'Arepa rellena con carne, queso y aguacate junto a patatas fritas' },
	{ src: arepaPollo, alt: 'Arepa de pollo desmechado con queso rallado y aguacate' },
	{ src: arepaEmpanadas, alt: 'Arepa de pollo con aguacate junto a empanadas fritas y lima' },
	{ src: arepaBacon, alt: 'Arepa con bacon, huevo, queso y aguacate' },
	{ src: pescadoPatacones, alt: 'Pescado frito con arroz, ensalada y patacones fritos' },
	{ src: pescadoArroz, alt: 'Pescado frito con arroz y ensalada de tomate y cebolla' },
	{ src: arepaSalsas, alt: 'Arepa servida en bandeja azul con dos salsas de la casa' },
	{ src: arepaCarne, alt: 'Arepa de carne mechada con queso rallado y aguacate' },
	{ src: rotulo, alt: 'Rótulo de neón de El Ranchito del Maíz en la fachada del local' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Oferta de El Ranchito del Maíz',
	inLanguage: 'es-ES',
	description:
		'Selección orientativa basada en las fotografías del perfil público; la ficha no publica una carta oficial ni precios.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-ranchito-del-maiz`,
	name: BUSINESS.name,
	alternateName: ['El Ranchito del Maiz', 'El Ranchito del Maiz Sevilla'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34661317803',
	servesCuisine: ['Arepas', 'Empanadas', 'Comida tradicional', 'Comida para llevar'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Sunday'],
			opens: '10:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Sunday'],
			opens: '20:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '10:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '20:00',
			closes: '02:00',
		},
	],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Oferta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"el-ranchito-del-maiz-apaisada-03.jpg": arepaPlato,
	"el-ranchito-del-maiz-apaisada-01.jpg": arepaPollo,
	"el-ranchito-del-maiz-vertical-05.jpg": arepaEmpanadas,
	"el-ranchito-del-maiz-apaisada-02.jpg": arepaBacon,
	"el-ranchito-del-maiz-vertical-06.jpg": pescadoPatacones,
	"el-ranchito-del-maiz-vertical-09.jpg": pescadoArroz,
	"el-ranchito-del-maiz-vertical-08.jpg": arepaSalsas,
	"el-ranchito-del-maiz-vertical-10.jpg": arepaCarne,
	"el-ranchito-del-maiz-vertical-07.jpg": rotulo,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..600;1,400..500&family=Nunito+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Ranchito del Maíz Sevilla, arepas Sevilla, empanadas de maíz Sevilla, comida venezolana Sevilla, Fernando Zóbel, comida para llevar Sevilla, pedidos WhatsApp"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Arepas y empanadas 100 % de maíz en Fernando Zóbel, 1. Comida tradicional, fotos, horario y pedidos por WhatsApp."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Arepa de El Ranchito del Maíz con carne, queso y aguacate"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#14484a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Sevilla"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[arepaPlato]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Ranchito del Maíz"
			subtitle="Arepas de maíz · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma horario, platos y precios con el establecimiento."
			ctaLabel="Pedir en El Ranchito"
			navAriaLabel="Enlaces de El Ranchito del Maíz"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
