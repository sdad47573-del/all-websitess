---
import '../styles/global.css';
import { BUSINESS, MAPS, SERVICES, MENU, FAQ } from '../data/site';
import { Image } from 'astro:assets';
import HeroPhoto from '../assets/fotos/desavio-el-abuelo-curro-apaisada-02.jpg';
import GalleryPhoto02 from '../assets/fotos/desavio-el-abuelo-curro-apaisada-03.jpg';
import GalleryPhoto03 from '../assets/fotos/desavio-el-abuelo-curro-apaisada-04.jpg';
import GalleryPhoto04 from '../assets/fotos/desavio-el-abuelo-curro-apaisada-06.jpg';
import GalleryPhoto05 from '../assets/fotos/desavio-el-abuelo-curro-apaisada-07.jpg';
import GalleryPhoto06 from '../assets/fotos/desavio-el-abuelo-curro-vertical-01.jpg';
import GalleryPhoto07 from '../assets/fotos/desavio-el-abuelo-curro-vertical-09.jpg';
import GalleryPhoto08 from '../assets/fotos/desavio-el-abuelo-curro-vertical-10.jpg';
import GalleryPhoto09 from '../assets/fotos/desavio-el-abuelo-curro-cuadrada-08.jpg';

const galleryPhotos = [
  { src: GalleryPhoto02, alt: 'Plato casero de la galería pública de Desavío El Abuelo Curro', caption: 'Cocina casera' },
  { src: GalleryPhoto03, alt: 'Comida para llevar fotografiada en el perfil de Google Maps', caption: 'Para llevar' },
  { src: GalleryPhoto04, alt: 'Una de las especialidades del establecimiento', caption: 'Hecho con cariño' },
  { src: GalleryPhoto05, alt: 'Plato preparado en Desavío El Abuelo Curro', caption: 'Sabor de casa' },
  { src: GalleryPhoto06, alt: 'Comida casera de la galería del establecimiento', caption: 'El gusto de siempre' },
  { src: GalleryPhoto07, alt: 'Detalle de la oferta gastronómica del local', caption: 'Cocina de barrio' },
  { src: GalleryPhoto08, alt: 'Plato disponible en el perfil de Google Maps', caption: 'Pásate a recoger' },
  { src: GalleryPhoto09, alt: 'Otra imagen del local en Google Maps', caption: 'Palomares del Río' },
];

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: BUSINESS.name,
  description: BUSINESS.description,
  url: `${BUSINESS.siteUrl}/`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.street,
    addressLocality: BUSINESS.city,
    addressRegion: BUSINESS.region,
    postalCode: BUSINESS.postalCode,
    addressCountry: BUSINESS.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: BUSINESS.geo.lat, longitude: BUSINESS.geo.lng },
  hasMap: MAPS.place,
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={BUSINESS.description} />
    <meta name="keywords" content="comida casera, comidas para llevar, Palomares del Río, El Abuelo Curro, reparto a domicilio" />
    <meta name="theme-color" content="#254334" />
    <link rel="canonical" href={`${BUSINESS.siteUrl}/`} />
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:title" content={`${BUSINESS.name} | Comida casera para llevar en Palomares del Río`} />
    <meta property="og:description" content={BUSINESS.description} />
    <meta property="og:url" content={`${BUSINESS.siteUrl}/`} />
    <meta property="og:image" content={`${BUSINESS.siteUrl}/og.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="topbar">
      <div class="topbar-inner wrap">
        <a class="brand" href="#inicio" aria-label="Desavío El Abuelo Curro, inicio"><span class="brand-mark" aria-hidden="true">{BUSINESS.mark}</span><span class="brand-name">El Abuelo Curro<small>Comidas para llevar</small></span></a>
        <nav aria-label="Navegación principal"><a href="#la-casa">La casa</a><a href="#servicios">Qué hacemos</a><a href="#carta">La carta</a><a href="#galeria">Galería</a><a href="#visitanos">Cómo llegar</a></nav>
        <a class="topbar-phone" href={MAPS.directions} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
      </div>
    </header>
    <main id="contenido">
      <section class="hero wrap" id="inicio">
        <div>
          <p class="eyebrow"><span aria-hidden="true"></span> Cocina casera · Palomares del Río</p>
          <h1 set:html={piezas.portada.titulo} />
          <p class="hero-lede">En Desavío El Abuelo Curro encontrarás comida casera y platos preparados para llevar. Una opción cercana para resolver el almuerzo y compartir los sabores de siempre.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={MAPS.directions} target="_blank" rel="noopener noreferrer">Encuéntranos <span aria-hidden="true">↗</span></a>
            <a class="button button-ghost" href="#carta">Descubre la propuesta</a>
          </div>
          <ul class="hero-facts" aria-label="Información del establecimiento">
            <li><b>Comida casera</b>Recetas de siempre</li>
            <li><b>Para llevar</b>Listo para disfrutar</li>
            <li><b>Palomares del Río</b>Avda. del Aljarafe, 2</li>
          </ul>
        </div>
        <figure class="hero-photo">
          <span class="hero-tag">Sabor de barrio</span>
          <Image src={HeroPhoto} alt="Comida casera en Desavío El Abuelo Curro" widths={[480, 720, 960]} sizes="(max-width: 899px) 100vw, 46vw" format="webp" quality={78} loading="eager" fetchpriority="high" />
          <figcaption><span>Una cocina para disfrutar</span><a href={MAPS.place} target="_blank" rel="noopener noreferrer">Fotos de Google Maps ↗</a></figcaption>
        </figure>
      </section>

      <section class="wrap" aria-label="Servicios de Desavío El Abuelo Curro"><ul class="chips">{SERVICES.map((service) => <li>{service}</li>)}</ul></section>

      <section class="about section-pad wrap" id="la-casa">
        <p class="section-label"><span aria-hidden="true"></span> Con sabor de siempre</p>
        <div class="about-grid"><h2>La cocina sencilla que siempre apetece.</h2><div class="about-copy">
          <p>Desavío El Abuelo Curro es un establecimiento de comidas para llevar en Palomares del Río. Una propuesta práctica para quienes buscan platos caseros y el sabor cotidiano de la cocina tradicional.</p>
          <p>Consulta directamente qué platos tienen hoy, encarga con tiempo y pregunta por las opciones de reparto. La carta puede variar según el día y la disponibilidad.</p>
          <p class="about-note">Los datos de platos, precios, horarios y reparto pueden cambiar. Confirma la información actual directamente con el local antes de hacer tu pedido.</p>
          <div class="about-links"><a class="simple-link" href={MAPS.place} target="_blank" rel="noopener noreferrer">Ver ficha en Google Maps ↗</a></div>
        </div></div>
      </section>

      <section class="wrap" id="servicios" aria-label="Lo que encontrarás">
        <div class="highlights">
          <article><h3>Comida casera</h3><p>Platos preparados con ese punto familiar, listos para llevar a la mesa.</p></article>
          <article><h3>Para llevar</h3><p>Una forma cómoda de disfrutar comida hecha sin complicarte en casa.</p></article>
          <article><h3>Reparto</h3><p>El establecimiento anuncia reparto. Consulta zona, disponibilidad y condiciones.</p></article>
        </div>
      </section>

      <section class="menu" id="carta">
        <div class="wrap">
          <div class="menu-head">
            <div><p class="eyebrow"><span aria-hidden="true"></span> Para abrir el apetito</p><h2>Lo bueno es<br /><em>compartir.</em></h2></div>
            <div><p>Una orientación sobre la propuesta de comidas para llevar. Para conocer los platos concretos del día, disponibilidad y precios, pregunta directamente al establecimiento.</p><a class="button button-primary" href={MAPS.place} target="_blank" rel="noopener noreferrer">Consultar en Google Maps ↗</a></div>
          </div>
          <div class="menu-groups">
            {MENU.map((group) => <div class="menu-group"><h3>{group.title}</h3><ul class="dishes">{group.items.map((item) => <li><span class="dish">{item.name}<em>{item.note}</em></span></li>)}</ul></div>)}
          </div>
          <p class="menu-note">No se publican precios porque no se ha encontrado una carta actual verificable. Confirma platos y precios con el establecimiento.</p>
        </div>
      </section>

      <section class="gallery section-pad wrap" id="galeria">
        <div class="gallery-head"><div><p class="eyebrow"><span aria-hidden="true"></span> Un vistazo al Abuelo Curro</p><h2>Así sabe <em>Palomares.</em></h2></div><div><p>Imágenes publicadas en la ficha de Google Maps del establecimiento. Consulta allí la galería completa y las novedades.</p><a class="button button-primary" href={MAPS.place} target="_blank" rel="noopener noreferrer">Abrir ficha en Google Maps ↗</a></div></div>
        <div class="gallery-grid">{galleryPhotos.map((photo) => <figure class="shot"><Image src={photo.src} alt={photo.alt} widths={[320, 480, 640]} sizes="(max-width: 640px) 92vw, (max-width: 980px) 45vw, 23vw" format="avif" quality={65} loading="lazy" decoding="async" /></figure>)}</div>
        <p class="gallery-note">Fotografías descargadas del perfil público del establecimiento en Google Maps.</p>
      </section>

      <section class="visit section-pad" id="visitanos"><div class="wrap visit-grid">
        <div class="visit-copy"><p class="eyebrow"><span aria-hidden="true"></span> Nos vemos por aquí</p><h2>Ven a por algo <em>rico.</em></h2>
          <p class="address">{BUSINESS.street}<br />{BUSINESS.postalCode} {BUSINESS.city}, {BUSINESS.region}<br />España</p>
          <p class="hours-note">No hay un horario confirmado en las fuentes consultadas. Revisa la ficha de Google Maps antes de desplazarte.</p>
          <div class="visit-links"><a class="button button-primary" href={MAPS.directions} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a><a class="button button-ghost" href={MAPS.order} target="_blank" rel="noopener noreferrer">Pedidos en línea ↗</a></div>
          <p class="reserve-note">Consulta en el establecimiento la disponibilidad de platos y las condiciones del servicio de reparto.</p>
        </div>
        <div class="map-frame"><iframe title="Mapa de Desavío El Abuelo Curro en Palomares del Río" src={MAPS.embed} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><a class="map-label" href={MAPS.directions} target="_blank" rel="noopener noreferrer">⌖ Abrir ruta</a></div>
      </div></section>

      <section class="faq section-pad wrap" id="preguntas"><p class="section-label"><span aria-hidden="true"></span> Preguntas útiles</p><h2>Antes de <em>hacer tu pedido.</em></h2><div class="faq-list">{FAQ.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></section>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand"><span class="brand-mark" aria-hidden="true">AC</span><div><p>Desavío El Abuelo Curro</p><small>{BUSINESS.street} · {BUSINESS.city}</small></div></div>
          <nav aria-label="Enlaces del pie"><a href="#inicio">Inicio</a><a href={MAPS.place} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href="/aviso-legal">Aviso legal</a></nav>
        </div>
        <span class="legal">La información de platos, servicios y horarios está sujeta a cambios.</span>
        <p class="credit">Creado por <a href="https://sur-digital.vercel.app" target="_blank" rel="noopener noreferrer">Sur Digital · sur-digital.vercel.app</a></p>
      </div>
    </footer>
    <a class="mobile-call" href={MAPS.directions} target="_blank" rel="noopener noreferrer">Cómo llegar a El Abuelo Curro ↗</a>
  </body>
</html>
