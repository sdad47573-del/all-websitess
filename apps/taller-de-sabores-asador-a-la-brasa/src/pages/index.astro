---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	business,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Taller de Sabores · Asador a la Brasa en Huércal de Almería';
const description =
	'Asador a la brasa y restaurante argentino en el paraje de la Cepa, 04230 Huércal de Almería. 4,3 sobre 5 con 422 reseñas; cocina de 8:00 a 18:00 y brasa de noche.';
const keywords =
	'Taller de Sabores, asador Huércal de Almería, asador a la brasa Almería, restaurante argentino Huércal de Almería, paraje de la Cepa, N-340a, carne a la brasa Almería, Taller de Sabores teléfono';

/**
 * Texto alternativo de las fotos.
 *
 * Google no describe el contenido de ninguna de las diez que trae la galería de esta ficha
 * (`cap=null` en todas; el único dato es el autor, que repite el nombre del negocio), así que no se
 * inventa una descripción y todos los `alt` avisan solo de dónde salen las fotos.
 */
const altFoto =
	'Fotografía publicada en la ficha de Google Maps del Taller de Sabores Asador a la Brasa, en Huércal de Almería (Almería)';
const altOg =
	'Fotografía del Taller de Sabores Asador a la Brasa publicada en su ficha de Google Maps';

/**
 * Galería completa: las ocho fotografías publicables de la ficha.
 *
 * La portada de la galería trae diez; dos son fotogramas de vídeo (`…-cuadrada-02.jpg` y
 * `…-vertical-08.jpg`, con proporción de vídeo 1:1 y 9:16), así que se quedan en disco y en el
 * manifiesto pero fuera del código.
 */
const galeria = [
	foto('taller-de-sabores-asador-a-la-brasa-apaisada-09.jpg'),
	foto('taller-de-sabores-asador-a-la-brasa-vertical-01.jpg'),
	foto('taller-de-sabores-asador-a-la-brasa-vertical-05.jpg'),
	foto('taller-de-sabores-asador-a-la-brasa-apaisada-07.jpg'),
	foto('taller-de-sabores-asador-a-la-brasa-apaisada-10.jpg'),
	foto('taller-de-sabores-asador-a-la-brasa-apaisada-03.jpg'),
	foto('taller-de-sabores-asador-a-la-brasa-cuadrada-04.jpg'),
	foto('taller-de-sabores-asador-a-la-brasa-vista-6-06.jpg'),
];

/** Tres fotos de avance en el collage de la portada (también están en la galería). */
const collage = [
	{ src: galeria[0], clase: 'collage-item collage-item-a' },
	{ src: galeria[1], clase: 'collage-item collage-item-b' },
	{ src: galeria[2], clase: 'collage-item collage-item-c' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1f1b18" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-AL" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Barlow:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">
					TS
				</span>
				<span class="brand-text">
					Taller de Sabores
					<small>Huércal de Almería</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#asador">El asador</a>
				<a href="#cocina">Las fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Huércal de Almería · Almería</p>
						<h1 id="hero-title">
							Carne a la brasa
							<br />
							<em>y terraza.</em>
						</h1>
						<p class="hero-lede">
							El Taller de Sabores está en el paraje de la Cepa, junto a la N-340a, en Huércal de
							Almería, y enciende la brasa de noche además de abrir toda la mañana y la tarde.
							Google le da {business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas, y sus reseñas destacadas
							hablan de carne a la brasa, de la terraza y de la cerveza de grifo.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>
								Llamar al {business.phone}
							</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas
								</strong>
							</li>
						</ul>
					</div>

					<div class="hero-collage">
						{collage.map((item, index) => (
							<figure class={item.clase}>
								<Image
									src={item.src}
									alt={altFoto}
									widths={index === 0 ? [640, 900, 1200] : [320, 480, 640]}
									sizes={
										index === 0
											? '(max-width: 1080px) 92vw, 46vw'
											: '(max-width: 1080px) 45vw, 23vw'
									}
									format="avif"
									quality={68}
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : undefined}
									decoding="async"
								/>
							</figure>
						))}
					</div>
				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
					{business.reviewCount.toLocaleString('es-ES')} reseñas
				</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>{hoursSummary}</span>
				<span>Teléfono {business.phone}</span>
			</div>

			<section class="section" id="asador" aria-labelledby="asador-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">El asador</p>
						<h2 class="title" id="asador-title">
							Brasa de noche
							<br />
							<em>y mesa de día.</em>
						</h2>
						<p>
							El Taller de Sabores Asador a la Brasa está en el paraje de la Cepa, 79, junto a la
							carretera N-340a, en Huércal de Almería. Google lo cataloga como restaurante argentino
							y le da {business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas.
						</p>
						<p>
							Mantiene un horario partido: abre de 8:00 a 18:00 de lunes a viernes —el sábado desde
							las 12:00— y vuelve de noche desde las 19:30 los lunes, martes, jueves y viernes. El
							domingo cierra todo el día y el miércoles no abre de noche. El lunes de la semana de
							la consulta era el festivo del 12 de octubre, y la ficha avisaba de que el horario
							podía ser diferente.
						</p>
						<p class="bar-note">
							La ficha escribe la dirección como «paraje de la cepa 79, N-340a, 85»: aquí se
							desarrolla la minúscula a «Paraje de la Cepa» y se conserva el resto tal cual, con el
							punto de la carretera detrás. Esta web se ha preparado solo con lo que publica esa
							ficha, consultada el {site.consultado}: nombre, dirección, teléfono, categorías,
							horario, valoración, sus reseñas y sus propias fotografías. La ficha no publica la
							carta, así que aquí no se reproduce.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>{business.reviewCount.toLocaleString('es-ES')} reseñas en Google Maps</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
								Ver todas ↗
							</a>
						</div>
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>{review.source}</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section cocina" id="cocina" aria-labelledby="cocina-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="cocina-title">
						Las fotos del <em>propio asador.</em>
					</h2>
					<p class="lead">
						Son las fotografías que el Taller de Sabores publica en su ficha de Google Maps. De las
						diez que trae la portada de la galería, dos son fotogramas de vídeo y no se publican
						aquí. Google no describe lo que se ve en ninguna, así que no se inventa un contenido que
						no consta.
					</p>
					<div class="cocina-grid">
						{galeria.map((src) => (
							<figure class="cocina-item">
								<Image
									src={src}
									alt={altFoto}
									widths={[380, 560, 800]}
									sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
									format="avif"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))}
					</div>
					<p class="cocina-note">
						La ficha no publica la carta ni los precios, así que esta web no los reproduce. Para
						saber qué hay hoy, lo más rápido es <a href={phoneHref}>llamar al {business.phone}</a> o
						mirar las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos y reseñas de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Paraje de la Cepa, 79,
							<br />
							<em>junto a la N-340a.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr class:list={[{ 'is-closed': item.shifts.length === 0 }]}>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							El lunes 12 de octubre de 2026 la ficha lo marcaba como Fiesta Nacional de España,
							abierto con el horario habitual, con el aviso de que el horario podía ser diferente.
							Llama y confirma el día antes de desplazarte.
						</p>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
						 src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>venir.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">
						TS
					</span>
					<span>
						Taller de Sabores
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del asador">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
						Cómo llegar ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Taller de Sabores Asador a la Brasa · Huércal de Almería
					(Almería). Web informativa elaborada con los datos y las fotografías que el asador publica
					en su ficha de Google Maps, consultada el {site.consultado}. Confirma horario y
					disponibilidad por teléfono antes de venir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar al Taller de Sabores <span>{business.phone}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>


