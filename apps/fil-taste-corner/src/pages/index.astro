---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import yakisoba from '../assets/fotos/fil-taste-corner-yakisoba.jpg';
import gyozas from '../assets/fotos/fil-taste-corner-gyozas.jpg';
import ramen from '../assets/fotos/fil-taste-corner-ramen-02.jpg';
import arroz from '../assets/fotos/fil-taste-corner-arroz-cerdo.jpg';
import fideos from '../assets/fotos/fil-taste-corner-fideos-marisco.jpg';
import nachos from '../assets/fotos/fil-taste-corner-nachos.jpg';
import pato from '../assets/fotos/fil-taste-corner-pato.jpg';
import fachada from '../assets/fotos/fil-taste-corner-fachada.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Fil taste corner · Cocina filipina y japonesa en Andorra la Vella';
const description =
	'Fil taste corner, Carrer Callaueta, 11 (AD500 Andorra la Vella). Cocina filipina y japonesa en la calle peatonal: gyozas, ramen, yakisoba, beef pares y menú del día. 4,8 sobre 5 con 237 reseñas. Martes cerrado.';

const galeria = [
	{
		src: gyozas,
		alt: 'Cuatro gyozas amarillas con semillas de sésamo y un cuenco de salsa de soja',
	},
	{
		src: ramen,
		alt: 'Cuenco de ramen de cerdo con fideos, kamaboko y alga nori, con los palillos',
	},
	{
		src: fideos,
		alt: 'Fideos salteados con langostinos, brotes de soja y cacahuetes, con una rodaja de limón',
	},
	{
		src: arroz,
		alt: 'Plato de arroz blanco con cerdo caramelizado y cebolleta',
	},
	{
		src: nachos,
		alt: 'Nachos con tomate, cebolla, huevo y hierbas frescas en una bandeja blanca',
	},
	{
		src: pato,
		alt: 'Magret de pato en lonchas con salsa oscura y cebolleta en un plato alargado',
	},
	{
		src: fachada,
		alt: 'Fachada de Fil taste corner con el toldo, la terraza y el cartel del menú en la calle',
	},
	{
		src: yakisoba,
		alt: 'Plato de yakisoba con pollo, zanahoria y cebolleta',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Los platos de Fil taste corner',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#fil-taste-corner`,
	name: BUSINESS.name,
	alternateName: ['Fil-taste Corner', 'FilTaste Corner Andorra'],
	description:
		'Cocina asiática de raíz filipina y japonesa en Carrer Callaueta, 11 (AD500 Andorra la Vella): gyozas, ramen, yakisoba, beef pares y menú del día.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376833733',
	currenciesAccepted: 'EUR',
	priceRange: '€€',
	servesCuisine: ['Filipina', 'Japonesa', 'Asiática'],
	areaServed: [
		{ '@type': 'City', name: 'Andorra la Vella' },
		{ '@type': 'AdministrativeArea', name: 'Andorra' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Monday', opens: '12:00', closes: '22:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Tuesday', opens: '00:00', closes: '00:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Wednesday', opens: '12:30', closes: '22:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Thursday', opens: '12:00', closes: '22:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '12:00', closes: '22:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '12:00', closes: '22:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '13:00', closes: '22:00' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1d2b29" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700&family=Sora:wght@400;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Fil taste corner Andorra, restaurante filipino Andorra la Vella, comida japonesa Andorra, ramen Andorra la Vella, yakisoba Andorra, calle Callaueta restaurante, menú del día Andorra"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina filipina y japonesa en la calle peatonal Callaueta (Andorra la Vella). Gyozas, ramen, yakisoba y menú del día. 4,8 en Google con 237 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Gyozas amarillas con salsa de soja de Fil taste corner"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1d2b29"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-07"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[yakisoba]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Fil taste corner"
			subtitle="Cocina filipina y japonesa · Andorra"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer Callaueta, 11 · Andorra la Vella"
				title="Filipino y japonés, <br /><em>en una calle peatonal.</em>"
				lede={`Fil taste corner es el pequeño restaurante de la calle Callaueta: cocina filipina y japonesa, menú del día a mediodía y terraza en la calle peatonal. Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas, una de las notas más altas de la zona. Abre de 12:00 a 22:00, con el martes cerrado.`}
				image={yakisoba}
				imageAlt="Yakisoba con pollo y verduras de Fil taste corner"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>12:00–22:00</b> · martes cerrado' },
					{ label: 'Cocina', html: '<b>Filipina</b> · y japonesa' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Menú del día"
			/>

			<LocalChips label="Lo que ofrece Fil taste corner" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Callaueta, 11. <br /><em>Cocina de casa.</em>"
				paragraphs={[
					'Fil taste corner está en el número 11 de la calle Callaueta, en la calle peatonal nueva de Andorra la Vella, junto al despacho de lotería y a pocos minutos del centro. La ficha de Google sitúa el local en la planta baja, en las coordenadas 42.5068653, 1.5299884. El teléfono es un fijo andorrano, el +376 833 733.',
					'La cocina cruza Filipinas y Japón: gyozas de pollo con un punto de curry, ramen de cerdo, yakisoba, takoyaki, kung pao y el beef pares, el guiso de ternera filipino que las reseñas señalan como plato de la casa. Hay también arroces, entrantes para compartir y postres como el mousse de coco.',
					'El local es pequeño, de pocas mesas, con un trato familiar que se repite en casi todas las opiniones. Fuera, la terraza ocupa la calle peatonal con mesas que se cubren los días de lluvia. Las reseñas avisan de que no hay aparcamiento propio: lo práctico es dejar el coche en el Parc Central.',
					`La ficha tiene ${RATING.count} reseñas y una media de ${RATING.label} sobre 5 (noviembre de 2026), con elogios constantes al servicio y a la relación calidad-precio. Google lo clasifica como restaurante asiático, y el menú del día con bebida y postre o café, que ronda los 13 € según las opiniones, se sirve también los fines de semana.`,
				]}
				note="La ficha no publica carta ni precios. Los platos que aparecen en esta página son los que citan las reseñas públicas y los que se ven en las fotos del perfil; los importes se confirman en el local o por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> De la cocina</p>
					<h2 id="highlights-title">Filipino y japonés, <br /><em>casero.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Gyozas, ramen <br /><em>y yakisoba.</em>"
				description="Lo que más se pide, según las reseñas del local y sus fotos. La carta cambia con el menú del día, así que no es una lista cerrada."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note={`El menú del día, con bebida y postre o café, se sirve también los fines de semana y ronda los 13 € según las reseñas. La carta no está publicada: para saber qué hay hoy, llama al ${BUSINESS.phone}.`}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Los platos <br /><em>y la terraza.</em>"
				description="Ocho fotografías del perfil de Fil taste corner: las gyozas, el ramen de cerdo, el yakisoba, los fideos con langostinos, el arroz con cerdo caramelizado, los nachos, el pato y la fachada con la terraza."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,8 sobre 5, <em>con 237 reseñas.</em></h2>
						<p>
							Es una de las notas más altas de los restaurantes de Andorra la Vella. Las reseñas
							repiten tres cosas: el trato de la sala, la relación calidad-precio del menú y el
							ramen. También hay quien avisa de que las bebidas han subido de precio.
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer todas las reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,8</strong>
						<span>★★★★★</span>
						<small>237 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la calle peatonal, <br /><em>junto a la lotería.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Principado de Andorra']}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de 12:00 a 22:00 de lunes a sábado (el miércoles desde las 12:30) y de 13:00 a 22:00 el domingo; el martes cierra. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Fil taste corner en la calle Callaueta, Andorra la Vella"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Carrer Callaueta, 11 · Andorra la Vella"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote={`Se atiende por teléfono en el ${BUSINESS.phone}: el local no tiene web propia ni reservas online. La calle es peatonal y no hay aparcamiento propio; las reseñas recomiendan el Parc Central, a pocos minutos andando.`}
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma platos, precios y horario antes de ir."
			ctaLabel="Llamar a Fil taste corner"
			navAriaLabel="Enlaces de Fil taste corner"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
