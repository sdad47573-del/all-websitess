---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import mostrador from '../assets/fotos/asador-el-torcal-panoramica-03.jpg';
import cuscus from '../assets/fotos/asador-el-torcal-apaisada-01.jpg';
import rotulo from '../assets/fotos/asador-el-torcal-vertical-04.jpg';
import cerveza from '../assets/fotos/asador-el-torcal-vertical-05.jpg';
import paella from '../assets/fotos/asador-el-torcal-apaisada-06.jpg';
import albondigas from '../assets/fotos/asador-el-torcal-vertical-07.jpg';
import pinchos from '../assets/fotos/asador-el-torcal-apaisada-08.jpg';
import rotuloCompleto from '../assets/fotos/asador-el-torcal-vertical-09.jpg';
import pizarra from '../assets/fotos/asador-el-torcal-vertical-10.jpg';
import ensalada from '../assets/fotos/asador-el-torcal-vertical-02.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Asador el Torcal · Comida casera para llevar en Málaga';
const description =
	'Asador el Torcal, en C. Antonio Chacón, 7 (Carretera de Cádiz, Málaga). Comida casera para llevar de lunes a viernes, de 12:00 a 15:30. Croquetas, pisto, albóndigas y ensaladas.';

const galeria = [
	{
		src: mostrador,
		alt: 'El mostrador de Asador el Torcal con bandejas de croquetas, albóndigas en salsa, guiso de carne, pisto, ensaladilla y ensalada',
	},
	{
		src: pizarra,
		alt: 'La pizarra de precios del local: croquetas a 3,50 euros la ración de ocho, pisto y ensaladas a 4,95 y filetitos rusos y albóndigas a 5,25',
	},
	{
		src: rotulo,
		alt: 'El rótulo de Asador el Torcal sobre el toldo rojo, con el dibujo del pollo y las patatas y los teléfonos 951 250 374 y 677 766 036',
	},
	{
		src: albondigas,
		alt: 'Bandeja de albóndigas bañadas en salsa de azafrán en el mostrador del asador',
	},
	{
		src: pinchos,
		alt: 'Pinchos de pollo a la brasa con tomate, cebolla y pimiento verde, recién hechos en la plancha',
	},
	{
		src: paella,
		alt: 'Paella en paellera sobre el mostrador, con pollo, chorizo, verduras y cigalas',
	},
	{
		src: cuscus,
		alt: 'Cazuela de barro con cuscús, pimientos, chorizo, pollo y huevo duro',
	},
	{
		src: ensalada,
		alt: 'Ensalada de hojas verdes con fresas, arándanos, frambuesas, moras y tiras de mango',
	},
	{
		src: rotuloCompleto,
		alt: 'Cartel completo de Asador el Torcal en la fachada amarilla del local, con los dos teléfonos de contacto',
	},
	{
		src: cerveza,
		alt: 'El rótulo de Asador el Torcal junto al letrero redondo de Estrella Galicia, sobre el toldo rojo del local',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Asador el Torcal',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#asador-el-torcal`,
	name: BUSINESS.name,
	alternateName: ['Asador El Torcal Málaga', 'El Torcal Carretera de Cádiz'],
	description:
		'Asador de comida casera para llevar en la calle Antonio Chacón, 7, Carretera de Cádiz (29003 Málaga). Abre de lunes a viernes, de 12:00 a 15:30.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34677766036',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '12:00',
			closes: '15:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#191411" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Manrope:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador el Torcal, comida casera para llevar Málaga, comida casera Carretera de Cádiz, croquetas Málaga, albóndigas Málaga, pisto, ensaladas para llevar, asador Antonio Chacón, comida para llevar 29003"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar en la calle Antonio Chacón, 7, Carretera de Cádiz. De lunes a viernes, de 12:00 a 15:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="El mostrador de Asador el Torcal con sus bandejas de comida casera"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#191411"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[mostrador]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Torcal"
			subtitle="Comida casera · Carretera de Cádiz"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Antonio Chacón, 7 · Carretera de Cádiz, Málaga"
				title="Comida casera <br /><em>para llevar.</em>"
				lede={`Asador el Torcal es una casa de comida para llevar en la Carretera de Cádiz. En el mostrador se alinean las bandejas de croquetas, albóndigas, guisos y ensaladas, y en la pizarra de la puerta se leen los precios del día. Abre de lunes a viernes, de 12:00 a 15:30, y tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={mostrador}
				imageAlt="El mostrador de Asador el Torcal con bandejas de croquetas, albóndigas, guisos, pisto y ensaladas"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>12:00–15:30</b> · de lunes a viernes' },
					{ label: 'Servicio', html: '<b>Para llevar</b> · pedidos por teléfono' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Croquetas 3,50 € · pizarra del local"
			/>

			<LocalChips label="Lo que ofrece Asador el Torcal" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un asador de barrio <br /><em>en Carretera de Cádiz.</em>"
				paragraphs={[
					'Asador el Torcal está en la calle Antonio Chacón, 7, en plena Carretera de Cádiz. La fachada amarilla, el toldo rojo y el rótulo con el pollo y las patatas se ven desde la acera; en la puerta, una pizarra escrita a mano anuncia lo que hay ese día.',
					'Google lo clasifica como restaurante de comida para llevar y la descripción del negocio lo resume en cuatro palabras: «Comida casera para llevar». La cocina trabaja al mediodía, de lunes a viernes, de 12:00 a 15:30, y cierra sábados y domingos.',
					'La pizarra del local lista croquetas —de pollo, de gambas al pil pil, de jamón serrano y de pollo al curry con manzana—, pisto, filetitos rusos, albóndigas y ensaladas, con precios que van de los 3,50 euros de la ración de croquetas a los 5,25 de los filetitos y las albóndigas.',
					'En el mostrador, las bandejas muestran guisos de carne, albóndigas en salsa, pisto, ensaladilla y ensaladas. La galería de la ficha incluye además pinchos de pollo y paellas, platos que se preparan por encargo. El rótulo del local muestra dos teléfonos: el 951 250 374 y el 677 76 60 36 que publica Google.',
				]}
				note="La ficha no publica página web ni redes sociales, y tampoco carta completa: los platos y precios de esta página son los que se leen en la pizarra del propio local en las fotos de Google. Conviene confirmarlos por teléfono antes de encargar."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que se cocina</p>
					<h2 id="highlights-title">Mostrador, pizarra <br /><em>y comida de casa.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Lo que dice <br /><em>la pizarra.</em>"
				description="La ficha de Google no publica carta. Estos son los platos y precios que se leen en la pizarra del local, más lo que nombran la descripción del negocio y las reseñas."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Los precios son los de la pizarra fotografiada en el perfil de Google del local, consultada en octubre de 2026: croquetas 3,50 € la ración de 8, pisto 4,95 €, filetitos rusos 5,25 €, albóndigas 5,25 € y ensaladas 4,95 €. La pizarra cambia con el día y la temporada; confirma la carta por teléfono."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El mostrador <br /><em>y la pizarra.</em>"
				description="Diez fotografías del perfil de Asador el Torcal en Google Maps: el rótulo de la fachada, la pizarra de precios, el mostrador de comida casera y algunos de sus platos."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,6 sobre 5, <em>con 96 reseñas.</em></h2>
						<p>
							La valoración que publica Google en octubre de 2026 es de 4,6 con 96 opiniones. Las
							reseñas destacadas hablan de la comida, del trato y de los precios; aquí se reproducen
							tal como aparecen en la ficha.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,6</strong>
						<span>★★★★★</span>
						<small>96 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Carretera de Cádiz, <br /><em>al mediodía.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de lunes a viernes, de 12:00 a 15:30, con el sábado y el domingo cerrados. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Asador el Torcal en la calle Antonio Chacón, 7, Carretera de Cádiz, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. Antonio Chacón, 7 · Carretera de Cádiz"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos y consultas por teléfono: la ficha no publica reservas ni pedidos online. Google marca el acceso para sillas de ruedas, pero no hay aparcamiento adaptado ni asientos adaptados. El local está en la Carretera de Cádiz, con paradas de autobús y el metro a pocos minutos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a El Torcal"
			navAriaLabel="Enlaces de Asador el Torcal"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
