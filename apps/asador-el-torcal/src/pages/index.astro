---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import mostrador from '../assets/fotos/asador-el-torcal-panoramica-03.jpg';
import cuscus from '../assets/fotos/asador-el-torcal-apaisada-01.jpg';
import rotulo from '../assets/fotos/asador-el-torcal-vertical-04.jpg';
import cerveza from '../assets/fotos/asador-el-torcal-vertical-05.jpg';
import paella from '../assets/fotos/asador-el-torcal-apaisada-06.jpg';
import albondigas from '../assets/fotos/asador-el-torcal-vertical-07.jpg';
import pinchos from '../assets/fotos/asador-el-torcal-apaisada-08.jpg';
import rotuloCompleto from '../assets/fotos/asador-el-torcal-vertical-09.jpg';
import pizarra from '../assets/fotos/asador-el-torcal-vertical-10.jpg';
import ensalada from '../assets/fotos/asador-el-torcal-vertical-02.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Asador el Torcal · Comida casera para llevar en Málaga';
const description =
	'Asador el Torcal, en C. Antonio Chacón, 7 (Carretera de Cádiz, Málaga). Comida casera para llevar de lunes a viernes, de 12:00 a 15:30. Croquetas, pisto, albóndigas y ensaladas.';

const galeria = [
	{
		src: mostrador,
		alt: 'El mostrador de Asador el Torcal con bandejas de croquetas, albóndigas en salsa, guiso de carne, pisto, ensaladilla y ensalada',
	},
	{
		src: pizarra,
		alt: 'La pizarra de precios del local: croquetas a 3,50 euros la ración de ocho, pisto y ensaladas a 4,95 y filetitos rusos y albóndigas a 5,25',
	},
	{
		src: rotulo,
		alt: 'El rótulo de Asador el Torcal sobre el toldo rojo, con el dibujo del pollo y las patatas y los teléfonos 951 250 374 y 677 766 036',
	},
	{
		src: albondigas,
		alt: 'Bandeja de albóndigas bañadas en salsa de azafrán en el mostrador del asador',
	},
	{
		src: pinchos,
		alt: 'Pinchos de pollo a la brasa con tomate, cebolla y pimiento verde, recién hechos en la plancha',
	},
	{
		src: paella,
		alt: 'Paella en paellera sobre el mostrador, con pollo, chorizo, verduras y cigalas',
	},
	{
		src: cuscus,
		alt: 'Cazuela de barro con cuscús, pimientos, chorizo, pollo y huevo duro',
	},
	{
		src: ensalada,
		alt: 'Ensalada de hojas verdes con fresas, arándanos, frambuesas, moras y tiras de mango',
	},
	{
		src: rotuloCompleto,
		alt: 'Cartel completo de Asador el Torcal en la fachada amarilla del local, con los dos teléfonos de contacto',
	},
	{
		src: cerveza,
		alt: 'El rótulo de Asador el Torcal junto al letrero redondo de Estrella Galicia, sobre el toldo rojo del local',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Asador el Torcal',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#asador-el-torcal`,
	name: BUSINESS.name,
	alternateName: ['Asador El Torcal Málaga', 'El Torcal Carretera de Cádiz'],
	description:
		'Asador de comida casera para llevar en la calle Antonio Chacón, 7, Carretera de Cádiz (29003 Málaga). Abre de lunes a viernes, de 12:00 a 15:30.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34677766036',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '12:00',
			closes: '15:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"asador-el-torcal-panoramica-03.jpg": mostrador,
	"asador-el-torcal-vertical-10.jpg": pizarra,
	"asador-el-torcal-vertical-04.jpg": rotulo,
	"asador-el-torcal-vertical-07.jpg": albondigas,
	"asador-el-torcal-apaisada-08.jpg": pinchos,
	"asador-el-torcal-apaisada-06.jpg": paella,
	"asador-el-torcal-apaisada-01.jpg": cuscus,
	"asador-el-torcal-vertical-02.jpg": ensalada,
	"asador-el-torcal-vertical-09.jpg": rotuloCompleto,
	"asador-el-torcal-vertical-05.jpg": cerveza,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#191411" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Manrope:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador el Torcal, comida casera para llevar Málaga, comida casera Carretera de Cádiz, croquetas Málaga, albóndigas Málaga, pisto, ensaladas para llevar, asador Antonio Chacón, comida para llevar 29003"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar en la calle Antonio Chacón, 7, Carretera de Cádiz. De lunes a viernes, de 12:00 a 15:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="El mostrador de Asador el Torcal con sus bandejas de comida casera"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#191411"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[mostrador]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Torcal"
			subtitle="Comida casera · Carretera de Cádiz"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a El Torcal"
			navAriaLabel="Enlaces de Asador el Torcal"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
