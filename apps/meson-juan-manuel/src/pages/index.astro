---
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	email,
	mapEmbedUrl,
	mapsUrl,
	phoneDisplay,
	phoneHrefs,
	phoneMobileDisplay,
	specialties,
	structuredData,
} from '../lib/business';

const title = 'Mesón Juan Manuel | Cocina andaluza en Antequera';
const description =
	'Restaurante Mesón Juan Manuel, cocina andaluza tradicional en Calle San Agustín, 1, Antequera (Málaga). Porra antequerana, pío antequerano y ensaladilla de pescada, con terraza de patio andaluz. Reserva tu mesa por teléfono.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#3b2b20" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="Antequera" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Prata&family=Rubik:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://meson-juan-manuel-antequera.vercel.app/og.png" />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante Mesón Juan Manuel, inicio">
				<span class="brand-mark" aria-hidden="true">JM</span>
				<span class="brand-label">MESÓN JUAN MANUEL <small>COCINA ANDALUZA · ANTEQUERA</small></span>
			</a>
			<nav aria-label="Navegación principal"><a href="#cocina">La cocina</a><a href="#meson">El mesón</a><a href="#visitanos">Visítanos</a></nav>
			<a class="header-action" href={`tel:${phoneHrefs[0]}`}><span aria-hidden="true">☎</span> Reservar</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-arch" aria-hidden="true"></div>
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true">✦</span> COCINA TRADICIONAL ANDALUZA · ANTEQUERA</p>
					<h1 id="hero-title">Mesón<br />Juan <em>Manuel</em></h1>
					<p class="hero-sub">Desde el corazón de Antequera · Calle San Agustín, 1</p>
					<p class="hero-intro">Cocina de la comarca, de la de siempre: porra antequerana, pío antequerano, gazpacho y ajoblanco. Y una terraza de patio andaluz, llena de plantas, para las noches largas de verano.</p>
					<div class="hero-actions">
						<a class="button button-terra" href={`tel:${phoneHrefs[0]}`}><span aria-hidden="true">☎</span> Reservar mesa</a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
				</div>
				<div class="hero-datos">
					<div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div>
					<div><small>TELÉFONOS</small><a href={`tel:${phoneHrefs[0]}`}>{phoneDisplay}</a><a href={`tel:${phoneHrefs[1]}`}>{phoneMobileDisplay}</a></div>
					<div><small>EN LA FICHA</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a><span>Terraza de patio andaluz</span></div>
				</div>
			</section>

			<div class="patio-strip" aria-hidden="true">
				<span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
			</div>

			<section class="cocina-section" id="cocina" aria-labelledby="cocina-title">
				<p class="section-label"><span>01 /</span> LA COCINA</p>
				<div class="cocina-head">
					<h2 id="cocina-title">Recetas de<br />la <em>comarca.</em></h2>
					<p class="cocina-lead">Platos antequeranos y andaluces de toda la vida, con la materia prima de la vega y de la sierra. Purificación Lebrón está al frente de los fogones.</p>
				</div>
				<ul class="cocina-list">
					{specialties.map((dish) => (
						<li class="cocina-item">
							<span class="cocina-pin" aria-hidden="true"></span>
							<div><strong>{dish.name}</strong><small>{dish.note}</small></div>
						</li>
					))}
				</ul>
				<p class="cocina-foot">También hay menú del día y platos de temporada. Pregunta en el mesón o llama antes de venir.</p>
			</section>

			<section class="meson-section" id="meson" aria-labelledby="meson-title">
				<p class="section-label"><span>02 /</span> EL MESÓN</p>
				<div class="meson-content">
					<h2 id="meson-title">Un patio<br />andaluz <em>en el centro.</em></h2>
					<div>
						<p>Juan Manuel Pérez lleva el mesón y su mujer, Purificación Lebrón, se encarga de la cocina. Juntos han convertido este rincón de la Calle San Agustín en una parada obligada para quien quiere comer como se come en Antequera.</p>
						<p>En verano abren su terraza: un callejón de una comunidad privada, lleno de plantas trepadoras, fresquito y sin coches. Un patio andaluz de verdad, donde los niños juegan en la calle mientras se cena. Y dentro, una barra tipo taberna con barriles de madera para tapear.</p>
					</div>
				</div>
				<div class="meson-footer">
					<span>COCINA TRADICIONAL</span>
					<span>TERRAZA · BARRA DE TABERNA</span>
					<span aria-hidden="true">✦</span>
				</div>
			</section>

			<section class="contact-section" id="visitanos" aria-labelledby="contact-title">
				<p class="section-label"><span>03 /</span> VISÍTANOS</p>
				<div class="contact-layout">
					<div class="contact-copy">
						<p class="contact-kicker">EN PLENO CENTRO DE ANTEQUERA</p>
						<h2 id="contact-title">Reserva<br />tu <em>mesa.</em></h2>
						<div class="contact-card">
							<div class="contact-row"><span aria-hidden="true">☎</span><div><small>TELÉFONOS</small><a href={`tel:${phoneHrefs[0]}`}>{phoneDisplay}</a><a href={`tel:${phoneHrefs[1]}`}>{phoneMobileDisplay}</a></div></div>
							<div class="contact-row"><span aria-hidden="true">✉</span><div><small>CORREO</small><a href={`mailto:${email}`}>{email}</a></div></div>
							<div class="contact-row"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div></div>
						</div>
						<a class="button button-terra" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-card">
						<div class="map-header"><span><i></i> CALLE SAN AGUSTÍN, 1 · ANTEQUERA</span><a href={mapsUrl} target="_blank" rel="noreferrer">ABRIR MAPS ↗</a></div>
						<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa del Restaurante Mesón Juan Manuel en Calle San Agustín, 1, Antequera" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-footer"><span aria-hidden="true">⌖</span><div><strong>{business.name}</strong><small>{business.streetAddress} · {business.city}</small></div><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar al Mesón Juan Manuel">↗</a></div>
					</div>
				</div>
				<div class="social-row"><span>ENCUÉNTRANOS TAMBIÉN EN</span><a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><span>Ruta Gastroturística de Antequera</span></div>
			</section>
			<Galeria nombre="Restaurante Mesón Juan Manuel" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio" aria-label="Mesón Juan Manuel, volver al inicio"><span class="brand-mark">JM</span><span class="brand-label">MESÓN JUAN MANUEL <small>COCINA ANDALUZA · ANTEQUERA</small></span></a>
			<p>{business.streetAddress}<br />{business.postalCode} {business.city}<br /><a href={`tel:${phoneHrefs[0]}`}>{phoneDisplay}</a></p>
			<a class="footer-social" href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
			<small>© {new Date().getFullYear()} Restaurante Mesón Juan Manuel · Antequera &nbsp;·&nbsp; Consulta la carta y los horarios en el local.</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
	<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
	<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
	<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
</nav>
</footer>
		<a class="phone-cta" href={`tel:${phoneHrefs[0]}`}><span aria-hidden="true">☎</span> Reservar mesa <strong>{phoneDisplay}</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>


