import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/campo-cafe-bar-malaga-foto-13.jpg';
import foto01 from '../assets/fotos/campo-cafe-bar-malaga-foto-01.jpg';
