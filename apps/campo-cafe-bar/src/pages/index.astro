			},
			{ name: 'Rooibos', note: 'chocolate, menta árabe o canela' },
			{ name: 'Té matcha con leche' },
		],
	},
	{
		title: 'Batidos y zumos',
		items: [
			{ name: 'Batido Puleva', note: 'chocolate, vainilla o fresa' },
			{ name: 'Vaso de Cola Cao' },
			{ name: 'Vaso de zumo de naranja' },
			{
				name: 'Batidos y smoothies de fruta',
				note: 'fresa, mango y frutos rojos, como los de las fotos',
			},
		],
	},
	{
		title: 'Desayunos, bocadillos y brunch',
		items: [
			{ name: 'Tostadas', note: 'de tomate y aceite, con aguacate o con huevo' },
			{ name: 'Bocadillos Campo', note: 'Veggie, Serrano, Agridulce «o más»' },
			{ name: 'Mini chapata de serrano y aguacate', note: 'de la pizarra de la terraza' },
			{
				name: 'Brunch',
				note: 'Mediterráneo, Campo, Amalúz o de mar; incluye bebida, tostada, yogur con fruta y 1 dulce',
			},
			{ name: 'Tapa de verduras en tempura', note: 'novedad de la casa' },
		],
	},
	{
		title: 'Dulce',
		items: [
			{ name: 'Tartas caseras', note: 'la tarta del día, expuesta en la barra' },
			{ name: 'Alfajores argentinos', note: 'el dulce que más se repite en las reseñas' },
			{ name: 'Galletas y repostería', note: 'para acompañar el café' },
		],
	},
];

const galeria = [
	{
		src: foto13,
		alt: 'Sala de Campo Café-Bar con sillas estilo retro y el rótulo CAMPO al fondo, cafetería en Teatinos (Málaga)',
	},
	{
		src: foto01,
		alt: 'Barra de azulejos verdes de Campo Café-Bar, con el tirador de cerveza y la nevera de bebidas, Málaga',
	},
	{
		src: foto03,
		alt: 'Barra y taburetes de Campo Café-Bar, cafetería de desayunos y brunch en Teatinos, Málaga',
	},
	{
		src: foto04,
		alt: 'Comedor de Campo Café-Bar con sofá, pizarra de bocadillos y brunch y pared vegetal, Teatinos, Málaga',
	},
	{
		src: foto08,
		alt: 'Clientes en la barra de Campo Café-Bar, cafetería en la calle Orson Welles, 24, Málaga',
	},
	{
		src: foto02,
		alt: 'Mesa con batidos, bocadillo, galleta y alfajores argentinos en Campo Café-Bar, Málaga',
	},
	{
		src: foto06,
		alt: 'Sándwich tostado con tomate y café con leche servidos en Campo Café-Bar, Teatinos, Málaga',
	},
	{
		src: foto10,
		alt: 'Tostada de aguacate con huevo y café con leche en Campo Café-Bar, cafetería en Málaga',
	},
	{
		src: foto07,
		alt: 'Tostadas de tomate y aguacate con un café con leche en Campo Café-Bar, Teatinos, Málaga',
	},
	{
		src: foto05,
		alt: 'Café con leche y alfajor argentino en la barra de Campo Café-Bar, cafetería en Málaga',
	},
	{
		src: foto12,
		alt: 'Batidos de fresa, mango y frutos rojos en Campo Café-Bar, cafetería de Teatinos, Málaga',
	},
	{
		src: foto14,
		alt: 'Batido servido en la sala de Campo Café-Bar, junto a los ventanales, Teatinos, Málaga',
	},
	{
		src: foto09,
		alt: 'Carta de cafés, batidos e infusiones de Campo Café-Bar con sus precios, Málaga',
	},
	{
		src: foto11,
		alt: 'Pizarra de la terraza de Campo Café-Bar con los bocadillos Campo y el brunch, Teatinos, Málaga',
	},
];

const faqs = [
	{
		q: '¿Dónde está Campo Café-Bar?',
		a: 'En la calle Orson Welles, 24, en el barrio de Teatinos-Universidad (29010 Málaga), junto a la Ciudad de la Justicia. Es una cafetería de barrio con mesas para desayunar con calma y asientos al aire libre.',
	},
	{
		q: '¿Cuál es el horario de Campo Café-Bar?',
		a: 'De martes a viernes abre de 8:30 a 13:00 y de 17:00 a 20:00, y los sábados y domingos de 9:30 a 13:00. El lunes permanece cerrado. Como puede cambiar en festivos, si vienes de lejos conviene llamar antes.',
	},
	{
		q: '¿Qué se puede desayunar o tomar en Campo?',
		a: 'El local es una cafetería de desayunos y brunch: tostadas de tomate y aceite, con aguacate o con huevo; sándwiches y los Bocadillos Campo (veggie, serrano o agridulce); tortitas, tartas caseras y alfajores argentinos. El brunch incluye bebida, tostada, yogur con fruta y un dulce. Para beber, café de especialidad, matcha, tés e infusiones, batidos y zumos.',
	},
	{
		q: '¿Hay opciones sin gluten o vegetarianas?',
		a: 'La carta incluye un bocadillo veggie y varios clientes mencionan el tema del gluten en sus reseñas, así que hay alternativas, pero la oferta cambia según el día. Lo mejor es preguntar directamente en el local o por teléfono para confirmar qué opciones hay disponibles hoy.',
	},
	{
		q: '¿Es un sitio tranquilo para trabajar, leer o quedar?',
		a: 'Sí. Las reseñas insisten en que es un lugar tranquilo y bien decorado, «con muy buen gusto», ideal para desayunar sin prisa, leer o quedar con alguien. El ambiente cuidado y la decoración en tonos verdes son una de sus señas de identidad.',
	},
	{
		q: '¿Tiene terraza o asientos al aire libre?',
		a: 'La ficha del local indica que dispone de asientos al aire libre, además de mesas en el interior. En la terraza hay una pizarra con los bocadillos y el brunch del día. El aforo exterior depende del tiempo, así que en días de lluvia es mejor contar con la sala.',
	},
	{
		q: '¿Se puede reservar o pedir para llevar?',
		a: 'No hay reserva online: lo habitual es llamar al 668 57 54 60 para consultar disponibilidad. Muchos desayunos y bocadillos se pueden pedir para tomar fuera, pero confírmalo al llamar o al llegar.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'Sí. La ficha de Google recoge acceso y asientos accesibles para sillas de ruedas, y también que se aceptan tarjetas de crédito como forma de pago.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'CafeOrCoffeeShop',
	'@id': `${business.site}/#cafeteria`,
	name: business.name,
	alternateName: ['Campo Cafebar', 'Campo Café Bar Teatinos'],
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 668 57 54 60',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cafetería', 'Desayunos', 'Brunch', 'Café de especialidad', 'Repostería'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	image: `${business.site}/og.jpg`,
	sameAs: [tiktokUrl, cidUrl],
	identifier: [{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId }],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:30',
			closes: '13:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '17:00',
			closes: '20:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '09:30',
			closes: '13:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos al aire libre', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Se aceptan tarjetas de crédito', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Desayunos y brunch', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Café de especialidad', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Campo Café-Bar · Brunch y café en Teatinos, Málaga</title>
		<meta name="theme-color" content="#2b1d15" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Campo Café-Bar, Campo cafebar, cafetería Teatinos, brunch Málaga, desayunos Teatinos, café de especialidad Málaga, matcha Málaga, alfajores argentinos, bocadillos Campo, cafetería Orson Welles, desayunar Ciudad de la Justicia, cafetería Málaga 29010, tartas caseras Málaga"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Campo Café-Bar · Café de especialidad y brunch en Teatinos, Málaga"
			ogDescription="Café de especialidad y matcha, desayunos, brunch, bocadillos Campo, tartas y alfajores argentinos en C. Orson Welles, 24 (Teatinos). 4,6 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Sala de Campo Café-Bar, cafetería de desayunos y brunch en la calle Orson Welles, 24, Teatinos, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#2b1d15"
			street={business.street}
			city={business.city}
			region="Andalucía"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Teatinos-Universidad, Málaga"
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://campo-cafe-bar.vercel.app/og.jpg" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7230668;-4.4628323" />
		<meta name="ICBM" content="36.7230668, -4.4628323" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="C"
			name="Campo"
			subtitle="Café-Bar · Teatinos"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Teatinos · Málaga"
				title="Desayunos, brunch<br />y <em>café de especialidad.</em>"
				lede="Cafetería de barrio en la calle Orson Welles, 24, junto a la Ciudad de la Justicia. Café de especialidad y matcha, tostadas, bocadillos Campo, tartas caseras y alfajores argentinos. Un sitio tranquilo, de azulejos verdes y madera, para desayunar sin prisa de martes a domingo."
				image={heroImage}
				imageAlt="Sala de Campo Café-Bar con sillas estilo retro y el rótulo CAMPO, cafetería en Teatinos (Málaga)"
				primaryCta={{ label: 'Llamar 668 57 54 60', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> en Google (103 reseñas)' },
					{ label: 'Horario', html: 'Mar–Vie 8:30–13:00 y 17:00–20:00' },
					{ label: 'Fin de semana', html: 'Sáb y Dom 9:30–13:00' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Campo Café-Bar" items={servicios} />

			<LocalAbout
				label="Una cafetería de barrio con identidad"
				title="Café, matcha y<br /><em>desayunos de verdad.</em>"
				paragraphs={[
					'Campo Café-Bar está en la calle Orson Welles, 24, en pleno Teatinos y a un paso de la Ciudad de la Justicia. La idea es sencilla: buen café, buen ambiente y desayunos hechos con calma. Una cafetería de las de siempre, con café de especialidad y matcha en la barra y una carta de tés e infusiones que no te esperas.',
					'El local es luminoso, con azulejos verdes en la barra, madera y sillas estilo retro. Se desayuna, se bruncha y se merienda: tostadas de tomate y aceite, con aguacate o con huevo; sándwiches y los Bocadillos Campo (veggie, serrano o agridulce); tortitas, tartas caseras y alfajores argentinos. Los clientes repiten que está decorado «con muy buen gusto» y que es un lugar tranquilo para empezar el día.',
					'Abrimos de martes a domingo, con doble turno entre semana y las mañanas del fin de semana reservadas al brunch y a los desayunos largos. Fuera hay mesas al aire libre y una pizarra con lo del día. Si buscas un sitio sin prisa en Teatinos, aquí tienes mesa.',
				]}
				note="Lo que más se repite en las reseñas de Google es el café, los bocadillos y la repostería, además del trato del personal y la decoración del local. La nota media es 4,6 sobre 103 opiniones. Como en todo local de barrio, en algún comentario aislado hay una crítica puntual, pero el tono general es muy positivo."
				links={[
					{ label: 'TikTok de Campo Café-Bar', href: tiktokUrl, external: true },
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del local', href: cidUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Desayuno, brunch<br /><em>y algo dulce.</em>"
				description="Selección tomada de la carta y de la pizarra del propio local (fotografiadas en su ficha de Google) y de los platos que mencionan los clientes. Los platos pueden cambiar, así que confírmalos al venir."
				cta={{ label: 'Llamar para preguntar', href: phoneHref }}
				groups={grupos}
				note="La carta cambia según el producto del día, así que confirma antes de venir."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El local,<br /><em>por dentro.</em>"
				description="Estas fotografías proceden del perfil de Campo Café-Bar en Google Maps, con las imágenes de la ficha y de sus clientes. En la ficha del local están todas las fotos y las reseñas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del local en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="C. Orson Welles, 24 · 29010 Málaga"
				title="Nos vemos<br /><em>en Teatinos.</em>"
				addressLines={[business.street, business.district, `${business.postalCode} ${business.city}, España`]}
				hours={[
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: '8:30–13:00 · 17:00–20:00' },
					{ day: 'Miércoles', value: '8:30–13:00 · 17:00–20:00' },
					{ day: 'Jueves', value: '8:30–13:00 · 17:00–20:00' },
					{ day: 'Viernes', value: '8:30–13:00 · 17:00–20:00' },
					{ day: 'Sábado', value: '9:30–13:00' },
					{ day: 'Domingo', value: '9:30–13:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google. El local cierra por descanso los lunes y trabaja en doble turno de martes a viernes. Puede variar en festivos, así que llama antes si vienes de lejos."
				mapTitle="Mapa de Campo Café-Bar en la calle Orson Welles, 24, Teatinos-Universidad, Málaga"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Campo Café-Bar · Teatinos, Málaga"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'TikTok', href: tiktokUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="No hay reserva en línea: para grupos o para confirmar el desayuno del día, llama al 668 57 54 60. Aparcar en la zona de Teatinos y la Ciudad de la Justicia es complicado a ciertas horas, así que si puedes, ven en metro o autobús."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="C"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: 'TikTok ↗', href: tiktokUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Campo"
		/>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
