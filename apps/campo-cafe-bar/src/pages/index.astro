	'Accesible para sillas de ruedas',
];

const grupos = [
	{
		title: 'Café de especialidad',
		items: [
			{ name: 'Expreso' },
			{ name: 'Cortado' },
			{ name: 'Café con leche', note: 'también en XL' },
