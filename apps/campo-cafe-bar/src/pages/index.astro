const business = {
	name: 'Campo Café-Bar',
	tagline: 'Cafetería, desayunos y brunch en Teatinos',
	street: 'C. Orson Welles, 24',
	district: 'Teatinos-Universidad',
	city: 'Málaga',
	postalCode: '29010',
	phone: '668 57 54 60',
	latitude: 36.7230668,
	longitude: -4.4628323,
	rating: 4.6,
	reviewsCount: 103,
	site: 'https://campo-cafe-bar.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd72f70066a1dcff:0x404d588d9ab9731a';
const cidDecimal = '4633456956843586330';
const placeId = 'ChIJ_9yhZgD3cg0RGnO5mo1YTUA';

const mapsUrl = `https://www.google.com/maps/place/Campo+Caf%C3%A9-Bar/@${business.latitude},${business.longitude},17z/data=!3m1!4b1!4m6!3m5!1s${cid}!8m2!3d${business.latitude}!4d${business.longitude}`;
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&q=Campo+Caf%C3%A9-Bar&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34668575460';
const tiktokUrl = 'https://www.tiktok.com/@campo.cafebar';

const description =
	'Campo Café-Bar en la calle Orson Welles, 24 (Teatinos, Málaga): café de especialidad y matcha, desayunos, brunch, bocadillos Campo, tartas y alfajores argentinos. Abierto de martes a domingo. Tel. 668 57 54 60.';

const servicios = [
	'Cafetería y desayunos',
	'Brunch',
	'Café de especialidad',
	'Tés, infusiones y matcha',
	'Batidos y zumos naturales',
	'Bocadillos Campo',
	'Tostadas y sándwiches',
	'Tartas y repostería casera',
	'Alfajores argentinos',
	'Asientos al aire libre',
