---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import bodegon from '../assets/fotos/aboca2-comida-para-llevar-apaisada-04.jpg';
import tortilla from '../assets/fotos/aboca2-comida-para-llevar-apaisada-07.jpg';
import mostrador from '../assets/fotos/aboca2-comida-para-llevar-apaisada-08.jpg';
import croqueta from '../assets/fotos/aboca2-comida-para-llevar-cuadrada-05.jpg';
import tartaLotus from '../assets/fotos/aboca2-comida-para-llevar-cuadrada-06.jpg';
import asador from '../assets/fotos/aboca2-comida-para-llevar-panoramica-03.jpg';
import ensalada from '../assets/fotos/aboca2-comida-para-llevar-panoramica-09.jpg';
import fachada from '../assets/fotos/aboca2-comida-para-llevar-vertical-01.jpg';
import vitrina from '../assets/fotos/aboca2-comida-para-llevar-vertical-02.jpg';
import tartaPistacho from '../assets/fotos/aboca2-comida-para-llevar-vertical-10.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Aboca2 · Comida casera y pollos asados en Torrejón';
const description =
	'Aboca2, en Carretera de Loeches, 13 (28850 Torrejón de Ardoz, Madrid). Comida casera para llevar: pollos asados, croquetas, tortilla, san jacobos y flamenquines.';

const galeria = [
	{
		src: bodegon,
		alt: 'Un surtido de Aboca2 con medio pollo asado, pimientos verdes, croquetas, empanada, ensaladilla, flamenquín, tortilla de patata y ensalada',
	},
	{
		src: asador,
		alt: 'Pollos asados ensartados en el asador de Aboca2',
	},
	{
		src: tortilla,
		alt: 'Una tortilla de patata entera, dorada por fuera, en un plato blanco',
	},
	{
		src: croqueta,
		alt: 'Una croqueta casera rebozada sobre una pizarra',
	},
	{
		src: tartaLotus,
		alt: 'Un trozo de tarta de queso con galleta Lotus y caramelo',
	},
	{
		src: tartaPistacho,
		alt: 'Una tarta de queso de pistacho con pistachos al lado en una pizarra',
	},
	{
		src: ensalada,
		alt: 'Una ensalada de lechuga, tomate, huevo cocido y atún en un plato cuadrado',
	},
	{
		src: mostrador,
		alt: 'El mostrador de Aboca2 con las bandejas de comida y el asador de pollos al fondo',
	},
	{
		src: vitrina,
		alt: 'Bandejas de ensaladilla rusa y otros platos tapados con film en la vitrina de Aboca2',
	},
	{
		src: fachada,
		alt: 'La fachada de Aboca2 con el rótulo de comida casera y la lista de especialidades en el escaparate',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Especialidades de Aboca2',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#aboca2`,
	name: BUSINESS.fullName,
	alternateName: ['Aboca2 Torrejón', 'Aboca2 Comida para llevar', 'Aboca 2'],
	description:
		'Comida casera tradicional para llevar en la carretera de Loeches, 13 (Torrejón de Ardoz, 28850 Madrid). Especialidad en pollos asados, croquetas, san jacobos, flamenquines y tortilla de patata.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34910410626',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Comida para llevar', 'Pollo asado'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Torrejón de Ardoz' },
		{ '@type': 'AdministrativeArea', name: 'Comunidad de Madrid' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La cocina', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#9c2f22" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400&family=Work+Sans:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Aboca2 Torrejón, comida para llevar Torrejón de Ardoz, pollos asados Torrejón, croquetas caseras Torrejón, tortilla de patata, flamenquín cordobés, san jacobo granadino"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar en la carretera de Loeches, 13 (Torrejón de Ardoz). Pollos asados, croquetas, tortilla, san jacobos y flamenquines. De martes a domingo."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Un surtido de pollo asado, croquetas, tortilla y ensaladilla de Aboca2"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#9c2f22"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Torrejón de Ardoz"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[bodegon]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Aboca2"
			subtitle="Comida casera · Torrejón"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carretera de Loeches, 13 · Torrejón de Ardoz"
				title="Pollo asado <br /><em>y comida de casa.</em>"
				lede={`Aboca2 es una tienda de comida casera para llevar en la carretera de Loeches. El asador de pollos se ve desde la calle y la vitrina se llena cada día de croquetas, tortilla de patata, san jacobos, flamenquines y platos cocinados. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas, y abre de martes a domingo, de 11:00 a 16:00.`}
				image={bodegon}
				imageAlt="Un surtido de Aboca2 con medio pollo asado, pimientos verdes, croquetas, empanada, ensaladilla, flamenquín, tortilla de patata y ensalada"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>11:00–16:00</b> · lunes cerrado' },
					{ label: 'Servicio', html: '<b>Para llevar</b> · comida casera' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Pollos asados"
			/>

			<LocalChips label="Lo que ofrece Aboca2" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Loeches, 13. <br /><em>Comida casera.</em>"
				paragraphs={[
					'Aboca2 está en la carretera de Loeches, 13, en Torrejón de Ardoz. La fachada lo anuncia en letras grandes: «Comida casera». En el escaparate, el local escribe su lista de especialidades: pollo asado, tortilla de patatas, cachopo, croquetas, flamenquín cordobés y san jacobo granadino.',
					'Dentro manda el asador. Los pollos giran ensartados en las varas y después pasan a la vitrina, junto a las bandejas de croquetas, ensaladilla, tortilla y platos cocinados. La ficha lo describe como «comida casera tradicional» y «una gran variedad de platos cocinados como en tu casa».',
					'Las fotos del perfil añaden los postres: tartas de queso con galleta Lotus y de pistacho, además de la ensalada de atún, la tortilla entera y el surtido de pollo con pimientos, empanada y flamenquín.',
					`Las reseñas insisten en el pollo y en las croquetas, y también en el precio y el trato. La ficha le da ${RATING.label} sobre 5 con ${RATING.count} opiniones (octubre de 2026), abre de martes a domingo de 11:00 a 16:00 y atiende los pedidos en el ${BUSINESS.phone}.`,
				]}
				note="La ficha no publica carta ni precios. Los platos de esta página son los que aparecen en la descripción del local, en su fachada y en las fotos del perfil de Google; pregunta por teléfono qué hay cada día y cuánto cuesta."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que sale del asador</p>
					<h2 id="highlights-title">Pollo, croquetas <br /><em>y tortilla.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La cocina"
				title="La lista <br /><em>de la fachada.</em>"
				description="Estas son las especialidades que anuncian la ficha de Google y el escaparate del local. No hay carta con precios: la vitrina cambia cada día."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Sin precios publicados: la ficha no incluye carta y el local no los anuncia en el escaparate. Llama al 910 41 06 26 para saber qué hay ese día, cuánto cuesta y si queda pollo."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El asador, la vitrina <br /><em>y los platos.</em>"
				description="Diez fotografías del perfil de Aboca2 en Google Maps: el surtido de pollo, los pollos en el asador, la tortilla, la croqueta, las tartas de queso, la ensalada, el mostrador y la fachada."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,9 sobre 5, <em>con 121 reseñas.</em></h2>
						<p>
							Google publica una media de 4,9 con 121 opiniones (octubre de 2026). Las reseñas
							que se ven aquí hablan del pollo asado, de las croquetas, de la tortilla, del
							precio y del trato.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,9</strong>
						<span>★★★★★</span>
						<small>121 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En Torrejón, <br /><em>Loeches 13.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de martes a domingo, de 11:00 a 16:00, con el lunes cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Aboca2 en la carretera de Loeches, 13, Torrejón de Ardoz, Madrid"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Loeches, 13 · Torrejón de Ardoz"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos y consultas por teléfono: la ficha no publica reservas, pedidos online ni reparto a domicilio. Tiene acceso para sillas de ruedas en la entrada, pero no aparcamiento ni asientos adaptados."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma platos y horario antes de la visita."
			ctaLabel="Llamar a Aboca2"
			navAriaLabel="Enlaces de Aboca2"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
