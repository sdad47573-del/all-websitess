---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import croquetas from '../assets/fotos/taberna-portu-apaisada-06.jpg';
import carne from '../assets/fotos/taberna-portu-apaisada-07.jpg';
import platos from '../assets/fotos/taberna-portu-apaisada-08.jpg';
import fachadaDia from '../assets/fotos/taberna-portu-apaisada-01.jpg';
import fachadaNoche from '../assets/fotos/taberna-portu-apaisada-09.jpg';
import barra from '../assets/fotos/taberna-portu-vertical-02.jpg';
import salmorejo from '../assets/fotos/taberna-portu-vertical-03.jpg';
import bacalhau from '../assets/fotos/taberna-portu-vertical-05.jpg';
import postre from '../assets/fotos/taberna-portu-vertical-10.jpg';
import plancha from '../assets/fotos/taberna-portu-vista-4-04.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Taberna Portu, cocina portuguesa y española en la calle Maestro Pablo Luna 4 (29010 Málaga, Bailén-Miraflores): bacalhau à Brás, pica-pau, croquetas y tapas caseras. 5,0 en Google con 209 reseñas. Tel. 641 38 77 12.';

const galeria = [
	{
		src: bacalhau,
		alt: 'Bacalhau à Brás con olivas negras y perejil servido en plato azul en Taberna Portu',
	},
	{
		src: croquetas,
		alt: 'Croquetas caseras recién fritas con canónigos en plato de azulejo en Taberna Portu',
	},
	{
		src: carne,
		alt: 'Carne de cerdo con azeitonas, zanahoria y cebolla en plato de barro en Taberna Portu',
	},
	{
		src: platos,
		alt: 'Tres platos de barro de Taberna Portu con carne, zanahoria aliñada y guiso de olivas',
	},
	{
		src: salmorejo,
		alt: 'Salmorejo con huevo y jamón en cuenco de barro, con picos de pan en Taberna Portu',
	},
	{
		src: plancha,
		alt: 'Carne a la plancha con patatas fritas, ensalada, limón y salsa verde en Taberna Portu',
	},
	{
		src: postre,
		alt: 'Postre de la casa en tarro de cristal con almendras laminadas en Taberna Portu',
	},
	{
		src: barra,
		alt: 'Barra de Taberna Portu con azulejos azules, tiradores de cerveza y bombillas colgantes',
	},
	{
		src: fachadaDia,
		alt: 'Fachada de Taberna Portu con el cartel de azulejo «Sabores de Portugal y España»',
	},
	{
		src: fachadaNoche,
		alt: 'Fachada de Taberna Portu de noche, con los toldos azules y la pizarra de la puerta',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	acceptsReservations: true,
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['Taberna Portu Málaga', 'Portu Málaga'],
	slogan: 'Sabores de Portugal y España en Málaga',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 641 38 77 12',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Portuguesa', 'Española', 'Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Andalucía' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '19:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '13:00',
			closes: '00:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '13:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos accesibles para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((body) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
		reviewBody: body,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Taberna Portu · Sabores de Portugal y España en Málaga';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f4e6b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,500;0,600;0,700;1,500&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Taberna Portu Málaga, restaurante portugués Málaga, bacalhau à Brás Málaga, pica-pau Málaga, tapas Bailén Miraflores, cocina portuguesa y española Málaga, C. Maestro Pablo Luna, restaurante Miraflores"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Taberna Portu · Sabores de Portugal y España en Málaga"
			ogDescription="Bacalhau à Brás, pica-pau, croquetas y tapas caseras. Cenas entre semana y mediodía el fin de semana. 5,0 en Google con 209 reseñas. Tel. 641 38 77 12."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Croquetas caseras de Taberna Portu, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1f4e6b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone="+34641387712"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.regionName}`}
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'España',
				phone: '+34 641 38 77 12',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[croquetas]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Sabores de Portugal y España"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Maestro Pablo Luna, 4 · Bailén-Miraflores · Málaga"
				title="Sabores de Portugal<br /><em>y España, en Málaga.</em>"
				lede="Taberna Portu es una taberna de barrio en Bailén-Miraflores donde se mezcla la cocina portuguesa y la española: bacalhau à Brás, pica-pau, pastéis de bacalhau, tortillas hechas al momento y montaditos. Ambiente acogedor, producto fresco y un equipo que las reseñas describen como cercano."
				image={croquetas}
				imageAlt="Croquetas caseras recién fritas con canónigos en plato de azulejo en Taberna Portu"
				primaryCta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Portuguesa y española"
				facts={[
					{ label: 'Nota', html: '<b>5,0 en Google</b> con 209 reseñas' },
					{ label: 'Entre semana', html: '<b>Cenas 19:00 – 23:00</b>' },
					{ label: 'Viernes y sábado', html: '<b>13:00 – 24:00</b>' },
					{ label: 'Domingo', html: '<b>13:00 – 23:00</b>' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Taberna Portu" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una taberna<br /><em>de dos orillas.</em>"
				paragraphs={[
					'Taberna Portu está en la calle Maestro Pablo Luna, 4 (Local 10), en Bailén-Miraflores, Málaga. La fachada no deja dudas: azulejo azul con el cartel de «Taberna Portu · Sabores de Portugal y España», toldos azules y una pizarra en la puerta con la comida casera del día. Dentro, barra de azulejo, taburetes de madera y luz cálida de bombilla.',
					'La cocina va de Portugal a España sin cambiar de mesa: bacalhau à Brás con patata paja, huevo y olivas; bacalhau com natas gratinado; pica-pau para mojar pan; pastéis de bacalhau y croquetas recién fritas; montaditos de jamón, lomo o chorizo. Y tortillas hechas al momento, de bacalao, de calabacín y queso o de chorizo.',
					'El local describe su cocina como «platos caseros y tapas exquisitas», con producto fresco y sabor auténtico. Las reseñas de Google coinciden en lo mismo: comida rica y un trato muy atento. Con 209 opiniones y un 5,0, es una de las tabernas mejor valoradas del barrio.',
				]}
				note="«Pedimos unas patatas brava, croquetas y unos montaditos, todo muy rico», dice una reseña. Otra: «La camarera y el cocinero encantadores, muy atentos y cercanos». Y una tercera: «Volveremos y agradecemos el trato de las camareras»."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Bacalhau,<br />pica-pau<br /><em>y tortillas.</em>"
				description="La ficha no publica carta completa ni precios: estos platos salen de la pizarra de la puerta, de la descripción del restaurante y de las fotos del perfil."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Taberna Portu no publica precios en Google y esta web no los inventa. La pizarra cambia con lo que se cocine ese día, así que confirma platos y precio al llamar al 641 38 77 12. Las tapas están pensadas para compartir: dos o tres por persona y un plato de la casa."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La barra,<br />los platos<br /><em>y la fachada.</em>"
				description="Estas fotografías proceden del perfil de Taberna Portu en Google Maps: el bacalhau à Brás, las croquetas, la carne con azeitonas, los platos de barro, el salmorejo, la plancha, el postre de la casa y la fachada de azulejo."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="C. Maestro Pablo Luna, 4 · 29010 Málaga"
				title="En Bailén-Miraflores,<br /><em>de noche entre semana.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Bailén-Miraflores, Málaga']}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="De lunes a jueves abre solo para cenar, de 19:00 a 23:00. El viernes y el sábado sirve desde la 13:00 hasta medianoche, y el domingo de 13:00 a 23:00. En festivos el horario puede cambiar, así que llama antes."
				mapTitle="Mapa de Taberna Portu en la calle Maestro Pablo Luna, 4, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Taberna Portu · Málaga"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva por teléfono, en el 641 38 77 12. La ficha marca entrada y asientos accesibles para sillas de ruedas, pero no confirma aseo adaptado. Los fines de semana abre al mediodía, así que conviene llamar con antelación."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, platos y precios antes de la visita."
			ctaLabel="Llamar a Taberna Portu"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
