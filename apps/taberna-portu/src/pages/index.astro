---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import croquetas from '../assets/fotos/taberna-portu-apaisada-06.jpg';
import carne from '../assets/fotos/taberna-portu-apaisada-07.jpg';
import platos from '../assets/fotos/taberna-portu-apaisada-08.jpg';
import fachadaDia from '../assets/fotos/taberna-portu-apaisada-01.jpg';
import fachadaNoche from '../assets/fotos/taberna-portu-apaisada-09.jpg';
import barra from '../assets/fotos/taberna-portu-vertical-02.jpg';
import salmorejo from '../assets/fotos/taberna-portu-vertical-03.jpg';
import bacalhau from '../assets/fotos/taberna-portu-vertical-05.jpg';
import postre from '../assets/fotos/taberna-portu-vertical-10.jpg';
import plancha from '../assets/fotos/taberna-portu-vista-4-04.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Taberna Portu, cocina portuguesa y española en la calle Maestro Pablo Luna 4 (29010 Málaga, Bailén-Miraflores): bacalhau à Brás, pica-pau, croquetas y tapas caseras. 5,0 en Google con 209 reseñas. Tel. 641 38 77 12.';

const galeria = [
	{
		src: bacalhau,
		alt: 'Bacalhau à Brás con olivas negras y perejil servido en plato azul en Taberna Portu',
	},
	{
		src: croquetas,
		alt: 'Croquetas caseras recién fritas con canónigos en plato de azulejo en Taberna Portu',
	},
	{
		src: carne,
		alt: 'Carne de cerdo con azeitonas, zanahoria y cebolla en plato de barro en Taberna Portu',
	},
	{
		src: platos,
		alt: 'Tres platos de barro de Taberna Portu con carne, zanahoria aliñada y guiso de olivas',
	},
	{
		src: salmorejo,
		alt: 'Salmorejo con huevo y jamón en cuenco de barro, con picos de pan en Taberna Portu',
	},
	{
		src: plancha,
		alt: 'Carne a la plancha con patatas fritas, ensalada, limón y salsa verde en Taberna Portu',
	},
	{
		src: postre,
		alt: 'Postre de la casa en tarro de cristal con almendras laminadas en Taberna Portu',
	},
	{
		src: barra,
		alt: 'Barra de Taberna Portu con azulejos azules, tiradores de cerveza y bombillas colgantes',
	},
	{
		src: fachadaDia,
		alt: 'Fachada de Taberna Portu con el cartel de azulejo «Sabores de Portugal y España»',
	},
	{
		src: fachadaNoche,
		alt: 'Fachada de Taberna Portu de noche, con los toldos azules y la pizarra de la puerta',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	acceptsReservations: true,
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['Taberna Portu Málaga', 'Portu Málaga'],
	slogan: 'Sabores de Portugal y España en Málaga',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 641 38 77 12',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Portuguesa', 'Española', 'Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Andalucía' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '19:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '13:00',
			closes: '00:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '13:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos accesibles para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((body) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
		reviewBody: body,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Taberna Portu · Sabores de Portugal y España en Málaga';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"taberna-portu-apaisada-06.jpg": croquetas,
	"taberna-portu-vertical-05.jpg": bacalhau,
	"taberna-portu-apaisada-07.jpg": carne,
	"taberna-portu-apaisada-08.jpg": platos,
	"taberna-portu-vertical-03.jpg": salmorejo,
	"taberna-portu-vista-4-04.jpg": plancha,
	"taberna-portu-vertical-10.jpg": postre,
	"taberna-portu-vertical-02.jpg": barra,
	"taberna-portu-apaisada-01.jpg": fachadaDia,
	"taberna-portu-apaisada-09.jpg": fachadaNoche,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f4e6b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,500;0,600;0,700;1,500&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Taberna Portu Málaga, restaurante portugués Málaga, bacalhau à Brás Málaga, pica-pau Málaga, tapas Bailén Miraflores, cocina portuguesa y española Málaga, C. Maestro Pablo Luna, restaurante Miraflores"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Taberna Portu · Sabores de Portugal y España en Málaga"
			ogDescription="Bacalhau à Brás, pica-pau, croquetas y tapas caseras. Cenas entre semana y mediodía el fin de semana. 5,0 en Google con 209 reseñas. Tel. 641 38 77 12."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Croquetas caseras de Taberna Portu, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1f4e6b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone="+34641387712"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.regionName}`}
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'España',
				phone: '+34 641 38 77 12',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[croquetas]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Sabores de Portugal y España"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, platos y precios antes de la visita."
			ctaLabel="Llamar a Taberna Portu"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
