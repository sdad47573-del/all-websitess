---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/restaurante-casa-carmelo-paqui-apaisada-03.jpg';
import foto1 from '../assets/fotos/restaurante-casa-carmelo-paqui-vertical-01.jpg';
import foto2 from '../assets/fotos/restaurante-casa-carmelo-paqui-apaisada-02.jpg';
import foto3 from '../assets/fotos/restaurante-casa-carmelo-paqui-apaisada-04.jpg';
import foto4 from '../assets/fotos/restaurante-casa-carmelo-paqui-vertical-06.jpg';
import foto5 from '../assets/fotos/restaurante-casa-carmelo-paqui-apaisada-05.jpg';

const business = {
	name: 'Restaurante Casa Carmelo y Paqui',
	street: 'C. Padre Fidel, 10',
	district: 'Mesas de Asta',
	city: 'Jerez de la Frontera',
	region: 'Andalucía',
	province: 'Cádiz',
	postalCode: '11590',
	phone: '+34 956 16 20 86',
	latitude: 36.7893273,
	longitude: -6.1745532,
	site: 'https://restaurante-casa-carmelo-paqui.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+Casa+Carmelo+y+Paqui/@36.7893273,-6.1745532,17z/data=!3m1!4b1!4m6!3m5!1s0xd0dc274ae59eccf:0xda9b8beb1565c66!8m2!3d36.7893273!4d-6.1745532!16s%2Fg%2F1hc1gln4z?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34956162086';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'Lo que citan',
		title: 'Menús para elegir',
		text: 'Menús para elegir y de mucha calidad, según sus clientes. Buen servicio, familiar y rápido, con cuidada presentación.',
	},
	{
		kicker: 'Relación calidad-precio',
		title: 'Cocina casera',
		text: 'Relación precio-calidad magnífica: cocina casera de trato excelente, ideal para comer entre semana en Mesas de Asta.',
	},
	{
		kicker: 'De mañana',
		title: 'Desayunos y mediodía',
		text: 'Abre desde las 7:00 casi toda la semana: desayunos y comidas hasta las 18:00. Los martes solo hasta las 12:00.',
	},
	{
		kicker: 'Familiar',
		title: 'Trato de casa',
		text: 'Restaurante muy familiar: rapidez y menús de calidad para quienes trabajan o pasan por la zona.',
	},
	{
		kicker: 'Para grupos',
		title: 'Comidas de trabajo',
		text: 'Por su horario y sus menús es un sitio típico de comidas de trabajo. Llama si vienes en grupo.',
	},
	{
		kicker: 'Aviso',
		title: 'Martes corto',
		text: 'El martes abre de 7:00 a 12:00. El resto de días, de 7:00 a 18:00. Confirma festivos por teléfono.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de Restaurante Casa Carmelo y Paqui publicada en su ficha de Google Maps (Mesas de Asta)' },
	{ src: photos.foto2, alt: 'Interior de Restaurante Casa Carmelo y Paqui, en la calle Padre Fidel, Mesas de Asta' },
	{ src: photos.foto3, alt: 'Fotografía de Restaurante Casa Carmelo y Paqui en Jerez de la Frontera, desde Google Maps' },
	{ src: photos.foto4, alt: 'Imagen de Restaurante Casa Carmelo y Paqui (Mesas de Asta) subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Detalle de Restaurante Casa Carmelo y Paqui según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está Restaurante Casa Carmelo y Paqui?',
		a: 'En la calle Padre Fidel, 10, 11590 Mesas de Asta, Jerez de la Frontera (Cádiz). Coordenadas 36.7893273, -6.1745532.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Lunes, miércoles, jueves, viernes, sábado y domingo de 7:00 a 18:00. Martes de 7:00 a 12:00. Confirma festivos por teléfono.',
	},
	{
		q: '¿Cómo reservo mesa?',
		a: 'Llamando al 956 16 20 86. Es un local familiar con menús para elegir: para grupos conviene llamar con antelación.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Cocina casera con menús para elegir de mucha calidad y cuidada presentación, con magnífica relación precio-calidad según sus clientes.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso y asientos adaptados para sillas de ruedas. Para necesidades concretas, llama antes al 956 16 20 86.',
	},
];

const images = [
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'Restaurante Casa Carmelo y Paqui en Mesas de Asta, Jerez (calle Padre Fidel, 10): menús caseros de calidad y trato familiar. Reserva en el 956 16 20 86.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 956 16 20 86',
	image: images,
	priceRange: '€',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo, tarjeta de crédito',
	servesCuisine: ['Española', 'Casera', 'Mediterránea', 'Andaluza'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.district,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '07:00',
			closes: '18:00',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Tuesday', opens: '07:00', closes: '12:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Ideal para grupos', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.6,
		reviewCount: 509,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1b1714" />
		<meta
			name="description"
			content="Restaurante Casa Carmelo y Paqui en Mesas de Asta, Jerez: menús caseros de calidad y trato familiar en la calle Padre Fidel, 10. Reserva en el 956 16 20 86."
		/>
		<meta
			name="keywords"
			content="Restaurante Casa Carmelo y Paqui, Mesas de Asta restaurante, calle Padre Fidel, menús Jerez, cocina casera Cádiz"
		/>
		<meta name="author" content="Restaurante Casa Carmelo y Paqui" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Restaurante Casa Carmelo y Paqui | Menús en Mesas de Asta</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Restaurante Casa Carmelo y Paqui · Menús en Mesas de Asta" />
		<meta
			property="og:description"
			content="Menús caseros para elegir, de mucha calidad y buen precio, en la calle Padre Fidel, 10 (Mesas de Asta, Jerez)."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="Restaurante Casa Carmelo y Paqui, en Mesas de Asta" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.district} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Restaurante Casa Carmelo y Paqui · Menús en Mesas de Asta" />
		<meta
			name="twitter:description"
			content="Menús caseros de calidad en la calle Padre Fidel, 10 (Mesas de Asta, Jerez)."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Mesas de Asta" />
		<meta name="geo.position" content="36.7893273;-6.1745532" />
		<meta name="ICBM" content="36.7893273, -6.1745532" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Restaurante Casa Carmelo y Paqui, inicio">
				<span class="brand-mark" aria-hidden="true">C</span>
				<span class="brand-name">Casa Carmelo y Paqui <small>Mesas de Asta · Jerez</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#especialidades">Especialidades</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>956 16 20 86</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Padre Fidel · Mesas de Asta</p>
					<h1 id="hero-title">Menús caseros<br />para elegir<br /><em>en Jerez.</em></h1>
					<p class="hero-lede">
						Restaurante Casa Carmelo y Paqui en Mesas de Asta: menús para elegir y de mucha calidad, trato
						familiar y rapidez, con cuidada presentación y magnífica relación precio-calidad.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>
							Reservar 956 16 20 86
						</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,6</b> en Google (509 reseñas)</li>
						<li>Menús</li>
						<li>Cocina casera</li>
						<li>Familiar</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						alt="Fotografía de Restaurante Casa Carmelo y Paqui publicada en su ficha de Google Maps (Mesas de Asta)"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,6</b><span>Google</span></div>
					<div><b>509</b><span>Reseñas</span></div>
					<div><b>7:00</b><span>Apertura</span></div>
				</div>
				<ul class="services">
					<li>Menús</li>
					<li>Cocina casera</li>
					<li>Local accesible</li>
					<li>Grupos</li>
					<li>Reservas</li>
					<li>Familiar</li>
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> Una casa en Mesas de Asta</p>
				<div class="about-grid">
					<h2>Calidad y precio<br />con trato familiar<br /><em>desde por la mañana.</em></h2>
					<div class="about-copy">
						<p>
							Restaurante Casa Carmelo y Paqui está en la calle Padre Fidel, 10, 11590 Mesas de Asta, Jerez de
							la Frontera (Cádiz). Restaurante de cocina casera con menús para elegir.
						</p>
						<p>
							Lo que más citan sus clientes: excelente trato, cuidada presentación y magnífica relación
							precio-calidad, con servicio familiar y rápido y menús de mucha calidad.
						</p>
						<p class="about-note">
							Sobre el horario: la ficha de Google Maps marca lunes, miércoles, jueves, viernes, sábado y domingo
							de 7:00 a 18:00, y martes de 7:00 a 12:00. Si vienes en festivo, llama antes.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="especialidades">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su carta</p>
						<h2>Lo que más<br />se pide <em>en la mesa.</em></h2>
					</div>
					<p>
						Lo citado en las reseñas de sus clientes: menús caseros para elegir. La carta cambia, así que confirma
						disponibilidad al reservar.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>La casa<br /><em>por dentro.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Restaurante Casa Carmelo y Paqui. En la ficha
							encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="avif"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres
					el titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C. Padre Fidel, 10</p>
					<h2>Ven a comer<br /><em>a Mesas de Asta.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.district}, {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Martes</th>
								<td>7:00 – 12:00</td>
							</tr>
							<tr>
								<th scope="row">Lunes, miércoles a domingo</th>
								<td>7:00 – 18:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, llama antes de
						venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>
							Llamar 956 16 20 86
						</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 956 16 20 86</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Restaurante Casa Carmelo y Paqui en la calle Padre Fidel, 10, Mesas de Asta"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Casa Carmelo y Paqui · Jerez
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">C</span>
				<p>Restaurante Casa Carmelo y Paqui<small>{business.street} · {business.postalCode} {business.district}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Restaurante Casa Carmelo y Paqui · Mesas de Asta. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>

			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar a la casa <span>956 16 20 86</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
