---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/tasca-la-posada-apaisada-10.jpg';
import comedor from '../assets/fotos/tasca-la-posada-apaisada-01.jpg';
import servicio from '../assets/fotos/tasca-la-posada-vertical-02.jpg';
import brasa from '../assets/fotos/tasca-la-posada-vertical-03.jpg';
import burrata from '../assets/fotos/tasca-la-posada-vertical-04.jpg';
import tartar from '../assets/fotos/tasca-la-posada-vertical-05.jpg';
import barraIbericos from '../assets/fotos/tasca-la-posada-vertical-06.jpg';
import vieiras from '../assets/fotos/tasca-la-posada-vertical-07.jpg';
import pulpo from '../assets/fotos/tasca-la-posada-vertical-08.jpg';
import sepia from '../assets/fotos/tasca-la-posada-vista-9-09.jpg';

const business = {
	name: 'Tasca La Posada',
	brand: 'La Posada',
	tagline: 'Tasca de mar y de ibéricos en el centro de Castelló',
	street: 'Carrer de Temprado, 19',
	city: 'Castelló de la Plana',
	region: 'Comunitat Valenciana',
	postalCode: '12002',
	phone: '964 73 74 74',
	latitude: 39.9833345,
	longitude: -0.0369753,
	rating: 4.9,
	reviewsCount: 242,
	site: 'https://tasca-la-posada.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd5fffd4d618e5a5:0xd44fc3c697fc6a2a';
const cidDecimal = '15298661716921707050';
const placeId = 'ChIJpeUY1tT_Xw0RKmr8l8bDT9Q';

const mapsUrl =
	'https://www.google.com/maps/place/Tasca+La+Posada/@39.9833345,-0.0369753,17z/data=!3m1!4b1!4m6!3m5!1s0xd5fffd4d618e5a5:0xd44fc3c697fc6a2a!8m2!3d39.9833345!4d-0.0369753!16s%2Fg%2F11cmf_rd0z?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&q=Tasca+La+Posada+Castell%C3%B3&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34964737474';

const description =
	'Tasca La Posada, en Carrer de Temprado 19 (Castelló de la Plana): marisco, ibéricos, arroces y carnes. Cenas de domingo a jueves y comidas viernes y sábado.';

const servicios = [
	'Tasca',
	'Marisco y pescado',
	'Productos ibéricos',
	'Jamón y cecina',
	'Arroces',
	'Carnes a la brasa',
	'Ensaladas',
	'Postres caseros',
	'Cenas',
	'Acceso para sillas de ruedas',
];

const grupos = [
	{
		title: 'De la mar',
		items: [
			{
				name: 'Gambas, galeras y tellinas',
				note: 'el marisco de la casa, tal como lo anuncia la propia tasca',
			},
			{
				name: 'Mejillones y ostras',
				note: 'producto de lonja para abrir la mesa',
			},
			{
				name: 'Sepia y calamar a la plancha',
				note: 'con patatas y pimientos del padrón',
			},
			{
				name: 'Vieiras a la plancha',
				note: 'servidas en su concha, con aceite y limón',
			},
			{
				name: 'Pulpo a la plancha',
				note: 'con patatas, pimentón y verduras asadas',
			},
		],
	},
	{
		title: 'De la matanza',
		items: [
			{
				name: 'Tabla de ibéricos',
				note: 'jamón ibérico, cecina de León, lomo, chorizo y salchichón, cortados en la barra',
			},
			{
				name: 'Queso curado',
				note: 'en la misma vitrina de la barra, junto a la mojama de Huelva',
			},
			{
				name: 'Tostas y croquetas',
				note: 'de lo más recomendado en las reseñas de Google, con las bravas',
			},
		],
	},
	{
		title: 'De la cocina',
		items: [
			{
				name: 'Arroces',
				note: 'uno de los pilares de la carta',
			},
			{
				name: 'Carnes a la brasa',
				note: 'secreto a la brasa, entrecot y magret de pato en salsa, entre las opciones del menú',
			},
			{
				name: 'Ensaladas y entrantes',
				note: 'como la burrata con tomate y aceite de albahaca',
			},
			{
				name: 'Tartar de gambas',
				note: 'sobre base de aguacate, con patatas chips',
			},
		],
	},
	{
		title: 'Postres y bodega',
		items: [
			{ name: 'Postres caseros', note: 'la tasca los anuncia como propios' },
			{ name: 'Vinos tintos y blancos', note: 'botellas de Ribera, Rioja y Valdepeñas en la estantería' },
			{ name: 'Café y sobremesa' },
		],
	},
];

const galeria = [
	{
		src: burrata,
		alt: 'Burrata con tomate, aceite de albahaca y totopos de Tasca La Posada, Castelló de la Plana',
	},
	{
		src: comedor,
		alt: 'Comedor de Tasca La Posada con las mesas puestas, lámparas de mimbre y la puerta de la calle, Castelló de la Plana',
	},
	{
		src: sepia,
		alt: 'Sepia a la plancha con patatas y pimientos verdes de Tasca La Posada, Castelló de la Plana',
	},
	{
		src: pulpo,
		alt: 'Pulpo a la plancha con patatas, pimentón y verduras de Tasca La Posada, Castelló de la Plana',
	},
	{
		src: vieiras,
		alt: 'Vieiras a la plancha en su concha con limón en Tasca La Posada, Castelló de la Plana',
	},
	{
		src: brasa,
		alt: 'Carne a la brasa con patatas y pimientos del padrón de Tasca La Posada, Castelló de la Plana',
	},
	{
		src: tartar,
		alt: 'Tartar de gambas sobre aguacate con patatas chips de Tasca La Posada, Castelló de la Plana',
	},
	{
		src: servicio,
		alt: 'Servicio de sala en Tasca La Posada con una tosta recién hecha, Castelló de la Plana',
	},
	{
		src: barraIbericos,
		alt: 'Barra de Tasca La Posada con jamón ibérico, cecina de León, chorizo, salchichón y quesos curados, Castelló de la Plana',
	},
];

const faqs = [
	{
		q: '¿Dónde está Tasca La Posada?',
		a: 'En el Carrer de Temprado, 19, 12002 Castelló de la Plana, en pleno centro de la ciudad. Desde esta página puedes abrir Google Maps y trazar la ruta hasta la puerta con el botón «Cómo llegar».',
	},
	{
		q: '¿Qué horario tiene la tasca?',
		a: 'Abre para cenar de domingo a jueves de 19:00 a 23:30 y el martes permanece cerrado. Los viernes y sábados hay también servicio de mediodía: el viernes de 12:00 a 16:30 y el sábado de 12:00 a 16:00, además de la cena de 19:00 a 23:30. En festivos y puentes conviene confirmarlo por teléfono.',
	},
	{
		q: '¿Qué se puede comer en La Posada?',
		a: 'La propia tasca describe su carta como productos del mar (gambas, galeras, tellinas, mejillones, ostras, sepia y calamar), productos ibéricos (jamón, cecina, salchichón y chorizo), arroces, pastas, carnes, ensaladas y postres caseros. En las fotos y en las reseñas aparecen además las vieiras, el pulpo, el tartar de gambas, las tostas, las croquetas y las patatas bravas.',
	},
	{
		q: '¿Hay menú del día?',
		a: 'Los clientes mencionan un menú con varias opciones, entre ellas el secreto a la brasa o el magret de pato en salsa. Esta web no publica precios ni copia la carta: pregunta por el menú del día al llamar o al llegar al local.',
	},
	{
		q: '¿Es necesario reservar?',
		a: 'Es una tasca de comedor pequeño, así que reservar es lo más cómodo, sobre todo para cenar el fin de semana. El teléfono publicado en su ficha de Google es el 964 73 74 74; no hay reserva online en esta web.',
	},
	{
		q: '¿El local es accesible?',
		a: 'La ficha de Google indica que el establecimiento tiene acceso para sillas de ruedas, pero no aparcamiento adaptado. Si necesitas una mesa concreta o más espacio, avisa al reservar por teléfono.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: 'Tasca La Posada',
	alternateName: ['La Posada', 'Tasca La Posada Castelló'],
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 964 73 74 74',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Tasca', 'Marisco', 'Productos ibéricos', 'Arroces', 'Cocina española'],
	areaServed: [
		{ '@type': 'City', name: 'Castelló de la Plana' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday', 'Monday', 'Wednesday', 'Thursday'],
			opens: '19:00',
			closes: '23:30',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday'], opens: '12:00', closes: '16:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday'], opens: '19:00', closes: '23:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday'], opens: '12:00', closes: '16:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday'], opens: '19:00', closes: '23:30' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Reservas por teléfono', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Barra de ibéricos', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Cenas', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La tasca', href: '#casa' },
	{ label: 'Qué pedir', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>Tasca La Posada · Mar, ibéricos y arroces en Castelló</title>
		<meta name="theme-color" content="#0f1517" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,600&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Tasca La Posada, La Posada Castelló, tasca Castelló de la Plana, marisco Castellón, ibéricos Castelló, arroces Castelló, Carrer de Temprado 19, restaurante centro Castellón, cenar Castelló, tasca La Posada reservas"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Tasca La Posada · Mar, ibéricos y arroces en Castelló"
			ogDescription="Tasca marinera y de ibéricos en el centro de Castelló de la Plana: marisco de lonja, jamón y cecina, arroces, carnes y postres caseros. Carrer de Temprado, 19. 4,9 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Carne a la brasa con patatas y pimientos de Tasca La Posada, Castelló de la Plana"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#0f1517"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Castelló de la Plana, Castellón"
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="P"
			name={business.brand}
			subtitle="Tasca · Castelló de la Plana"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer de Temprado · Castelló"
				title={piezas.portada.titulo}
				lede="Tasca La Posada es una casa de comidas en el Carrer de Temprado, 19, a un paso del centro de Castelló de la Plana. Marisco de lonja, jamón y cecina cortados en la barra, arroces, carnes a la brasa y postres caseros, con servicio de cena casi toda la semana y comidas los viernes y sábados."
				image={heroImage}
				imageAlt="Carne a la brasa con patatas y pimientos del padrón servida en Tasca La Posada, Castelló de la Plana"
				primaryCta={{ label: 'Llamar 964 73 74 74', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,9</b> en Google (242 reseñas)' },
					{ label: 'Cocina', html: 'Marisco e ibéricos' },
					{ label: 'Cenas', html: 'De domingo a jueves, 19:00–23:30' },
					{ label: 'Zona', html: 'Centro de Castelló' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Tasca La Posada" items={servicios} />

			<LocalAbout
				label="Una tasca de las de siempre"
				title="Barra de ibéricos,<br />lonja y<br /><em>mantel de losa.</em>"
				paragraphs={[
					'Tasca La Posada ocupa un local con solera en el Carrer de Temprado, 19, en pleno centro de Castelló de la Plana: paredes de yeso, vigas, lámparas de mimbre y una barra con la cortadora de embutido a la vista. Al fondo, una puerta con el nombre de la casa y una mesa junto al cristal para ver pasar la calle.',
					'La carta mezcla dos mundos que en Castellón van juntos: el mar y la matanza. De un lado, gambas, galeras, tellinas, mejillones, ostras, sepia y calamar, además de vieiras y pulpo a la plancha según el día. Del otro, jamón ibérico, cecina de León, lomo, chorizo, salchichón y queso curado, cortados al momento, con la mojama de Huelva en la vitrina.',
					'La cocina se completa con arroces, pastas, carnes a la brasa, ensaladas y postres caseros. El comedor es pequeño y el servicio es de los que se toman su tiempo, así que la tasca funciona igual para una cena tranquila de entre semana que para una comida larga de sábado.',
				]}
				note="La ficha de Google reúne 242 opiniones con una nota media de 4,9: es una de las más altas del centro de Castelló. Los clientes destacan «las patatas bravas maravillosas», las tostas y las croquetas, el menú con secreto a la brasa o magret de pato en salsa, y las «texturas y sabores» del chef. El martes cierra."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="Qué pedir"
				title="De la mar<br /><em>y de la matanza.</em>"
				description="Selección hecha a partir de la descripción de la propia tasca en Google («productos del mar, ibéricos, arroces, pastas, carnes, ensaladas, postres caseros»), de los platos de sus fotos y de los que citan los clientes en las reseñas."
				cta={{ label: 'Reservar por teléfono', href: phoneHref }}
				groups={grupos}
				note="Esta web no publica precios: no hay carta oficial publicada y no se inventan importes. La carta del día, el menú y el precio se confirman en el local o por teléfono."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La barra,<br /><em>el plato y la sala.</em>"
				description="Estas fotografías proceden del perfil de Tasca La Posada en Google Maps, con imágenes de la ficha y de sus clientes: la barra de ibéricos, las mesas del comedor, la carne a la brasa, la sepia, el pulpo, las vieiras y el tartar de gambas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer de Temprado, 19 · 12002 Castelló"
				title="Nos vemos<br /><em>en La Posada.</em>"
				addressLines={[
					business.street,
					`${business.postalCode} ${business.city}`,
					'Castellón, España',
				]}
				hours={[
					{ day: 'Lunes', value: '19:00 – 23:30' },
					{ day: 'Martes', value: 'Cerrado', closed: true },
					{ day: 'Miércoles', value: '19:00 – 23:30' },
					{ day: 'Jueves', value: '19:00 – 23:30' },
					{ day: 'Viernes', value: '12:00 – 16:30 · 19:00 – 23:30' },
					{ day: 'Sábado', value: '12:00 – 16:00 · 19:00 – 23:30' },
					{ day: 'Domingo', value: '19:00 – 23:30' },
				]}
				hoursNote="Horario publicado en la ficha de Google. La tasca abre sobre todo para cenar; las comidas solo se sirven viernes y sábado, y el martes cierra todo el día. En festivos y puentes puede cambiar, así que llama al 964 73 74 74 antes de ir."
				mapTitle="Mapa de Tasca La Posada en el Carrer de Temprado, 19, Castelló de la Plana"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Tasca La Posada · Castelló de la Plana"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Reservas por teléfono, en el 964 73 74 74. No hay reserva online ni formulario en esta web. La ficha de Google indica acceso para sillas de ruedas, pero no aparcamiento adaptado; si necesitas una mesa concreta, avisa al reservar."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="P"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a La Posada"
		/>
	</body>
</html>
