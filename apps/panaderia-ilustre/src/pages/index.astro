---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import panaderia from '../assets/fotos/panaderia-ilustre-apaisada-09.jpg';
import hogaza from '../assets/fotos/panaderia-ilustre-apaisada-04.jpg';
import galletas from '../assets/fotos/panaderia-ilustre-apaisada-08.jpg';
import bolleria from '../assets/fotos/panaderia-ilustre-apaisada-06.jpg';
import mostrador from '../assets/fotos/panaderia-ilustre-vertical-03.jpg';
import horarioFoto from '../assets/fotos/panaderia-ilustre-vertical-05.jpg';
import palmeras from '../assets/fotos/panaderia-ilustre-vertical-07.jpg';
import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería Ilustre · Pan y bollería en Málaga';
const description =
	'Panadería Ilustre, C. Don Juan de Austria, 33, Distrito Centro, Málaga. Panes, bollería y pastelería. L–V 8:00–14:30 y 17:15–20:30; S–D 8:30–14:30. 4,7/5 en Google.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#ilustre`,
	name: BUSINESS.name,
	alternateName: ['Ilustre', 'Panadería Ilustre Málaga'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34652875674',
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:00',
			closes: '14:30',
		},
	{
		'@type': 'OpeningHoursSpecification',
		dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
		opens: '17:15',
		closes: '20:30',
	},
	{
		'@type': 'OpeningHoursSpecification',
		dayOfWeek: ['Saturday', 'Sunday'],
		opens: '08:30',
		closes: '14:30',
	},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};
const nav = [
	{ label: 'La panadería', href: '#casa' },
	{ label: 'Pan y bollería', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];
const galeria = [
	{ src: hogaza, alt: 'Hogaza de pan de miga oscura y corteza rústica, fotografiada en el perfil del local' },
	{ src: mostrador, alt: 'Vitrina con surtido de bollería y pasteles de la panadería' },
	{ src: galletas, alt: 'Tarros de galletas y otros productos junto al mostrador' },
	{ src: bolleria, alt: 'Selección de bollería variada en una bandeja' },
	{ src: horarioFoto, alt: 'Horario escrito en el escaparate de Panadería Ilustre' },
	{ src: palmeras, alt: 'Palmeras de hojaldre fotografiadas en la galería del local' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#283c35" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Ilustre, panadería Málaga, Distrito Centro, C. Don Juan de Austria, panes variados, bollería, 29009"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panes, bollería y pastelería en C. Don Juan de Austria, 33, Málaga."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Panadería Ilustre, en C. Don Juan de Austria, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#283c35"
			phone="+34652875674"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[panaderia]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Panadería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>
		<main id="contenido">
			<LocalHero
				eyebrow="C. Don Juan de Austria, 33 · Málaga"
				title="Panes de barrio, <br /><em>hechos con mimo.</em>"
				lede={`Panadería Ilustre está en C. Don Juan de Austria, 33, en el centro de Málaga. Las fotos muestran hogazas de corteza rústica, bollería, pasteles y galletas. Abre todos los días por la mañana y de lunes a viernes también por la tarde. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={panaderia}
				imageAlt="Estantes de panes y bollería de Panadería Ilustre"
				primaryCta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Valoración', html: '<b>4,7</b> en Google · 100 reseñas' },
					{ label: 'Horario', html: '<b>L–V 8:00–14:30</b> · S–D 8:30–14:30' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b>` },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Panadería · Málaga"
			/>
			<LocalChips label="En Panadería Ilustre" items={SERVICIOS} />
			<LocalAbout
				label="La panadería"
				title="En el centro <br /><em>de Málaga.</em>"
				paragraphs={[
					'Panadería Ilustre se encuentra en C. Don Juan de Austria, 33, en el Distrito Centro de Málaga. La ficha de Google la identifica como panadería y publica el teléfono, el horario y las indicaciones para llegar.',
					'En las imágenes del perfil se ven hogazas de corteza rústica, panes de miga clara y oscura, bollería hojaldrada, pasteles, galletas y palmeras. Una reseña también menciona pan de cerveza, pan de tomate y bases para pizza. La disponibilidad puede variar.',
					'El horario escrito en el escaparate indica mañanas todos los días, y apertura por la tarde de lunes a viernes. La ficha de Google muestra una valoración de 4,7 sobre 5, basada en 100 reseñas.',
				]}
				note="No hay una carta completa publicada: la selección aquí se basa en las fotos del establecimiento y en productos mencionados en reseñas. El surtido puede variar."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>
			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow"><span aria-hidden="true"></span> Tres apuntes</p>
						<h2 id="three-title">Hogazas, horno <br /><em>y mostrador.</em></h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>
			<LocalMenu
				eyebrow="Pan, bollería y pastelería"
				title="Pan, bollería <br /><em>y algo dulce.</em>"
				description="Una muestra del surtido que aparece en las fotos públicas del establecimiento. La disponibilidad puede cambiar a lo largo del día."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU_GROUPS}
				note={`El surtido puede cambiar. Para consultar qué hay disponible hoy, llama al ${BUSINESS.phone}.`}
			/>
			<LocalGallery
				eyebrow="Fotos"
				title="Del horno <br /><em>al mostrador.</em>"
				description="Hogazas de corteza rústica, bandeja de bollería, galletas, palmeras y escaparate del local: imágenes de la ficha pública en Google Maps."
				images={galeria}
				cta={{ label: 'Ver fotos en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>
			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Don Juan <br /><em>de Austria.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario del cartel de la puerta"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de Panadería Ilustre, C. Don Juan de Austria, 33, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Panadería Ilustre · Distrito Centro"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phone, href: BUSINESS.phoneHref }}
				reserveNote="El horario escrito en el escaparate indica apertura todos los días por la mañana; comprueba posibles cambios en festivos antes de desplazarte."
			/>
			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>
		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar a Panadería Ilustre"
			navAriaLabel="Enlaces de Panadería Ilustre"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
