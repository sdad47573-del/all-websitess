---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fideua from '../assets/fotos/la-tasca-vertical-02.jpg';
import mariscada from '../assets/fotos/la-tasca-panoramica-01.jpg';
import mariscadaCerca from '../assets/fotos/la-tasca-apaisada-03.jpg';
import bocadillo from '../assets/fotos/la-tasca-apaisada-05.jpg';
import parrillada from '../assets/fotos/la-tasca-apaisada-06.jpg';
import pescado from '../assets/fotos/la-tasca-apaisada-08.jpg';
import comedor from '../assets/fotos/la-tasca-apaisada-09.jpg';
import pulpo from '../assets/fotos/la-tasca-vertical-04.jpg';
import almuerzo from '../assets/fotos/la-tasca-vertical-07.jpg';
import postre from '../assets/fotos/la-tasca-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description = BUSINESS.description;

const galeria = [
	{
		src: mariscada,
		alt: 'Mariscada de La Tasca con langostinos, gambas, mejillones, almejas y calamares en una bandeja honda',
	},
	{
		src: parrillada,
		alt: 'Parrillada de costillas y pollo a la brasa con pimientos en una bandeja metálica',
	},
	{
		src: comedor,
		alt: 'Comedor de La Tasca con mesas de madera, sillas altas y guirnaldas de luz, en plena celebración',
	},
	{
		src: pulpo,
		alt: 'Pulpo a la brasa sobre patata y pimentón, servido en un plato llano',
	},
	{
		src: almuerzo,
		alt: 'Plancha de almuerzo con huevos fritos, salchichas, pollo y pimientos',
	},
	{
		src: mariscadaCerca,
		alt: 'Detalle de la mariscada de La Tasca con anillas de calamar, cigalas y langostinos',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo de bacon y queso con pan de barra en el plato de La Tasca',
	},
	{
		src: pescado,
		alt: 'Pescado a la plancha con patatas y ensalada de remolacha en La Tasca',
	},
	{
		src: postre,
		alt: 'Copas de helado con nata y barquillo en la terraza de La Tasca',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': ['BarOrPub', 'Restaurant'],
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.fullName,
	alternateName: ['La Tasca', 'Bar La Tasca', 'La Tasca Sant Joan de Moró'],
	slogan: BUSINESS.tagline,
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34623116045',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Cocina española', 'Cocina casera', 'Brasa', 'Marisco', 'Arroces'],
	areaServed: [
		{ '@type': 'City', name: 'Sant Joan de Moró' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.province,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday'],
			opens: '08:30',
			closes: '13:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday'],
			opens: '08:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday', 'Sunday'],
			opens: '08:30',
			closes: '24:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'La Tasca · Bar restaurante en Sant Joan de Moró';
const cita = REVIEWS[0];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-tasca-vertical-02.jpg": fideua,
	"la-tasca-panoramica-01.jpg": mariscada,
	"la-tasca-apaisada-06.jpg": parrillada,
	"la-tasca-apaisada-09.jpg": comedor,
	"la-tasca-vertical-04.jpg": pulpo,
	"la-tasca-vertical-07.jpg": almuerzo,
	"la-tasca-apaisada-03.jpg": mariscadaCerca,
	"la-tasca-apaisada-05.jpg": bocadillo,
	"la-tasca-apaisada-08.jpg": pescado,
	"la-tasca-vertical-10.jpg": postre,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#a44a26" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,500;0,600;1,400;1,600&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="La Tasca, bar Sant Joan de Moró, restaurante Sant Joan de Moró, menú diario Plana Alta, almuerzo a la brasa, parrillada, mariscada, fideuà, cocina casera Castellón, Àngel Pallarés 14"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="La Tasca · Bar restaurante en Sant Joan de Moró"
			ogDescription="Cocina casera, menú diario de 9 € y almuerzo a la brasa por 5 €, con parrillada y mariscada. 4,4 en Google con 269 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fideuà de marisco en la paella de Bar Restaurante La Tasca, en Sant Joan de Moró"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#a44a26"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.province}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone="+34623116045"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Sant Joan de Moró, Castelló"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'España',
				phone: '+34 623 11 60 45',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fideua]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Bar restaurante · Sant Joan de Moró"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a La Tasca"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
