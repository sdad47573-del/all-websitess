---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import cuscus from '../assets/fotos/asador-la-esperanza-2-apaisada-01.jpg';
import cocina from '../assets/fotos/asador-la-esperanza-2-apaisada-02.jpg';
import vitrina from '../assets/fotos/asador-la-esperanza-2-apaisada-03.jpg';
import cartel from '../assets/fotos/asador-la-esperanza-2-apaisada-04.jpg';
import fritura from '../assets/fotos/asador-la-esperanza-2-apaisada-07.jpg';
import ensaladilla from '../assets/fotos/asador-la-esperanza-2-vertical-05.jpg';
import patatas from '../assets/fotos/asador-la-esperanza-2-vertical-08.jpg';
import combinado from '../assets/fotos/asador-la-esperanza-2-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const title = 'Asador la Esperanza 2 · Pollo asado y parrilla en Los Corazones';
const description = BUSINESS.description;

const galeria = [
	{
		src: cartel,
		alt: 'Pizarra del Asador la Esperanza 2 con los menús 1, 2 y 3, los precios del pollo, las patatas y las ensaladas, y los platos combinados',
	},
	{
		src: cuscus,
		alt: 'Cuscús en una cazuela de barro con pimientos verdes asados, chorizo, morcilla y garbanzos',
	},
	{
		src: fritura,
		alt: 'Fuente de fritura con calamares, gambas y pescado rebozado, junto a una jarra de cerveza',
	},
	{
		src: ensaladilla,
		alt: 'Bandejas de ensaladilla rusa decoradas con pimientos y aceitunas, y otra con naranja y salchicha',
	},
	{
		src: patatas,
		alt: 'Guiso de patatas con tomate y perejil en una cazuela de barro',
	},
	{
		src: cocina,
		alt: 'Cocina del asador con el horno de pollos, la campana extractora y la vitrina de comidas preparadas',
	},
	{
		src: vitrina,
		alt: 'Vitrina del asador con pollo, albóndigas y croquetas, y el tablero de fotos con los platos de la casa',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#asador-la-esperanza-2`,
	name: BUSINESS.fullName,
	alternateName: ['Asador la Esperanza 2', 'La Esperanza 2 Los Corazones', 'Asador Los Corazones'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Parrilla', 'Andaluza'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Cruz de Humilladero' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:30',
			closes: '15:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17120f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Asador la Esperanza 2, Los Corazones Málaga, pollo asado Málaga, C. Corregidor Francisco de Molina 7, parrilla Málaga, Cruz de Humilladero, menú del día Málaga, callos Málaga, paella Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado, parrilla y menús desde 5,00 € en el barrio de los Corazones, Málaga. De miércoles a domingo, de 10:30 a 15:30. 4,7 sobre 5 con 90 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Plato combinado del Asador la Esperanza 2 con chorizo, huevo, pimientos y pollo"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#17120f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Los Corazones, Málaga"
			preload={[combinado]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Asador la Esperanza 2"
			subtitle="Pollo asado · parrilla · Los Corazones"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.neighbourhood}`}
				title="Pollo asado <br /><em>en Los Corazones.</em>"
				lede={`El Asador la Esperanza 2 está en la calle Corregidor Francisco de Molina 7, en el barrio de los Corazones, Cruz de Humilladero. Abre de miércoles a domingo de 10:30 a 15:30: pollo asado, parrilla, menús desde 5,00 € y especiales de paella, callos o estofado según el día. La ficha de Google le da 4,7 sobre 5 con 90 reseñas.`}
				image={combinado}
				imageAlt="Plato combinado del Asador la Esperanza 2 con chorizo, huevo frito, pimientos verdes asados, pollo y patatas fritas"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,7</b> en Google · 90 reseñas' },
					{ label: 'Horario', html: '<b>10:30–15:30</b><br />Miércoles a domingo' },
					{ label: 'Menú 1', html: '<b>5,00 €</b><br />½ pollo, patatas y pimientos o berenjenas' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Asador la Esperanza 2" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Pollo, parrilla <br /><em>y guisos de siempre.</em>"
				paragraphs={[
					'El Asador la Esperanza 2 es un asador de barrio en la calle Corregidor Francisco de Molina 7, en Los Corazones (Cruz de Humilladero), con el horno de pollos a la vista y una vitrina de comidas preparadas. Google lo clasifica como restaurante especializado en pollo y parrilla, y le da 4,7 sobre 5 con 90 reseñas.',
					'La pizarra de la pared es la carta: menús 1, 2 y 3 con pollo, patatas y pimientos o berenjenas, raciones sueltas, ensaladas, croquetas y platos combinados. También hay especiales por día: paella los martes y domingos, estofado de ternera los jueves y callos los sábados y domingos.',
					'En las fotos del perfil se ven los pollos en el horno, la vitrina de ensaladilla y croquetas, la fritura de calamares y gambas, el cuscús en cazuela de barro y las patatas guisadas con tomate. La casa hace además encargos para bautizos, comuniones, cumpleaños y celebraciones.',
					'El horario es de comidas: de 10:30 a 15:30, de miércoles a domingo, con lunes y martes cerrados. La ficha marca acceso para sillas de ruedas, pero no asientos adaptados ni aparcamiento adaptado.',
				]}
				note="La información sale de la ficha pública de Google Maps, de la pizarra y las fotografías del perfil del asador. Los precios son los de esa pizarra y pueden haber cambiado; confírmalos en el local o por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver la casa en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Menús desde <br /><em>5,00 €.</em>"
				description="La carta está copiada de la pizarra del local: menús con pollo y patatas, raciones, ensaladas, platos combinados y un especial distinto para cada día de la semana."
				cta={{ label: 'Ver la pizarra en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="Los precios son los que aparecen en la pizarra fotografiada y pueden estar desactualizados. Para una cuenta cerrada o un encargo de celebración, llama al restaurante antes de pedir."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Siete fotos <br /><em>de la casa.</em>"
				description="Las fotografías del perfil del Asador la Esperanza 2 en Google Maps: la pizarra con los menús, el horno, la vitrina de comidas, el cuscús, la fritura y los guisos."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a <br /><em>Los Corazones.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.neighbourhood} · ${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Málaga, España',
				]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: de 10:30 a 15:30, de miércoles a domingo, en horario continuado. Lunes y martes está cerrado. En festivos puede cambiar; llama antes si vas en día señalado."
				mapTitle="Mapa del Asador la Esperanza 2 en la calle Corregidor Francisco de Molina 7, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Esperanza 2 · Los Corazones"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. La ficha no publica un sistema de reservas ni una web propia, así que el teléfono es el canal directo para mesa, para encargar pollo o para organizar una celebración."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Asador la Esperanza 2"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
