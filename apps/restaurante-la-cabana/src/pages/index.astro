---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import costillas from '../assets/fotos/cabana-costillas-patatas.jpg';
import calamares from '../assets/fotos/cabana-calamares.jpg';
import playa from '../assets/fotos/cabana-playa-marbella.jpg';

const business = {
	name: 'Restaurante la Cabaña',
	tagline: 'Cocina marbellí en la Campana',
	street: 'Av. General López Domínguez, 5',
	district: 'La Campana',
	city: 'Marbella',
	postalCode: '29603',
	phone: '952 77 88 95',
	latitude: 36.5109298,
	longitude: -4.875206,
	rating: 4.8,
	reviewsCount: 12,
	site: 'https://restaurante-la-cabana.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd72d80a882e3a09:0xb03de3b295ba7df5';
const cidDecimal = '12699556880410377717';
const placeId = 'ChIJCTouiArYcg0R9X26lbLjPbA';

const mapsUrl = `https://www.google.com/maps/place/?q=place_id:${placeId}&hl=es`;
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = `tel:+34${business.phone.replace(/\s/g, '')}`;

const description =
	'Restaurante la Cabaña en Av. General López Domínguez, 5 (Marbella). Menú del día, pescado, marisco y carne a la plancha en un local de La Campana. 4,8 en Google.';

const servicios = [
	'Menú del día',
	'Pesca y mariscos',
	'Carne a la plancha',
	'Cocina española',
	'Postres caseros',
	'Menú del día',
	'Pan, bebida y postre',
	'Sala amplia',
	'Mesas en el exterior',
	'Comer en el local',
	'Para llevar',
	'Admite reservas',
	'Acepta tarjeta',
];

const grupos = [
	{
		title: 'Menú del día con pan, bebida y postre',
		items: [
			{ name: 'Más de diez primeros platos', note: 'Cambian a diario, según el mercado y el día' },
			{ name: 'Y otros tantos segundos', note: 'Pescados, mariscos y carnes a la plancha' },
			{ name: 'Pan, bebida y postre incluidos', note: 'El postre también entra en el menú' },
			{ name: 'Postres caseros', note: 'Varias tartas, todas de casa' },
		],
	},
	{
		title: 'Platos que se repiten en las reseñas',
		items: [
			{ name: 'Tomate rosa con ventresca', note: 'Uno de los primeros platos que se citan en Google' },
			{ name: 'Atún a la plancha con patatas a lo pobre', note: 'Segundo de pescado muy solicitado' },
			{ name: 'Tarta de la abuela', note: 'El postre que recomienda una de las reseñas' },
			{ name: 'Costillas con patatas y pimientos', note: 'Carne a la plancha con guarnición' },
			{ name: 'Aros de calamares', note: 'Emplatado con limón' },
		],
	},
];

const galeria = [
	{ src: costillas, alt: 'Costillas de cerdo a la plancha con patatas fritas, tomate y pimiento en Restaurante la Cabaña, Marbella' },
	{ src: calamares, alt: 'Aros de calamares fritos con limón en Restaurante la Cabaña, Marbella' },
	{ src: playa, alt: 'Playa de Marbella al atardecer, el entorno del restaurante La Campana' },
];

const faqs = [
	{
		q: '¿Dónde está el Restaurante la Cabaña?',
		a: 'En la avenida General López Domínguez, 5, en el barrio de La Campana de Marbella (29603, Málaga), con Parking underground a pie de calle. El teléfono es el 952 77 88 95.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'El local funciona a doble servicio. De martes a sábado sirve de 0:00 a 15:00 y de 19:30 a 24:00. El domingo solo por la mañana, de 0:00 a 11:00. El lunes abre de 9:00 a 15:00 y de 19:30 a 24:00. Puede variar en festivos.',
	},
	{
		q: '¿Qué se come en La Cabaña?',
		a: 'Cocina española con mucho peso del mar: pescado y marisco de la costa, carnes a la plancha y postres caseros. Entre los platos que más se citan están el tomate rosa con ventresca, el atún a la plancha con patatas a lo pobre y la tarta de la abuela.',
	},
	{
		q: '¿Hace falta reservar?',
		a: 'La ficha indica que el local admite reservas. Teniendo en cuenta que son muchos los clientes que cenan aquí, sobre todo entre semana al mediodía y los fines de semana por la noche, conviene llamar al 952 77 88 95 para ensure mesa.',
	},
	{
		q: '¿Tiene terraza?',
		a: 'Sí. Las reseñas mencionan muchas mesas, tanto dentro como fuera, y el conjunto del local es amplio y acogedor, con un estilo de salón tradicional.',
	},
	{
		q: '¿Qué nota tiene en Google?',
		a: 'La nota media es de 4,8 sobre 12 reseñas. Las reseñas coinciden en la calidad-precio, la profesionalidad del servicio y la limpieza del local. Con doce reseñas la muestra es pequeña, así que conviene leerlasenteras.',
	},
	{
		q: '¿Aceptan tarjeta?',
		a: 'Sí, el local acepta tarjeta de crédito, débito y también pago móvil sin contacto.',
	},
	{
		q: '¿Se puede comer para llevar?',
		a: 'La ficha indica servicio para llevar además de comer en el local. Aun así, al tratarse de una cocina con platos del menú del día, lo más habitual es consumir en casa o en la terraza.',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': ['Restaurant', 'LocalBusiness', 'FoodEstablishment'],
	'@id': `${business.site}/#negocio`,
	name: business.name,
	alternateName: ['La Cabaña', 'Restaurante La Cabaña', 'La Cabaña Marbella'],
	slogan: 'Cocina marbellí en La Campana',
	description,
	url: `${business.site}/`,
	priceRange: '10–20 €',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina española', 'Pescados', 'Mariscos', 'Carne a la plancha'],
	areaServed: [
		{ '@type': 'City', name: 'Marbella' },
		{ '@type': 'AdministrativeArea', name: 'La Campana' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	telephone: `+34 ${business.phone}`,
	image: `${business.site}/og.jpg`,
	sameAs: [mapsUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
	],
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '00:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday'],
			opens: '09:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '19:30',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '00:00',
			closes: '11:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Mesas en el exterior', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Admite reservas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Menú del día', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Comida para llevar', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Pago sin contacto', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Restaurante la Cabaña · Marbella · Menú del día en La Campana</title>
		<meta name="theme-color" content="#4a5d34" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Restaurante la Cabaña Marbella, La Campana Marbella, menú del día Marbella, pescado Marbella, mariscos Marbella, restaurante General López Domínguez, comida Marbella La Campana, postres caseros Marbella, cena Marbella, atún a la plancha Marbella"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Restaurante la Cabaña · Menú del día en La Campana, Marbella"
			ogDescription="Cocina española con pescado, marisco y carne a la plancha en Av. General López Domínguez, 5, Marbella. Menú del día con postre. 4,8 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Costillas a la plancha con patatas en Restaurante la Cabaña, Marbella"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#4a5d34"
			street={business.street}
			city={business.city}
			region="Andalucía"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="La Campana, Marbella"
			preload={[costillas]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="C"
			name="La Cabaña"
			subtitle="Marbella"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="La Campana · Marbella"
				title="Menú del día, pescado<br /><em>y cocina de casa.</em>"
				lede="El Restaurante la Cabaña está en la avenida General López Domínguez, 5, en el barrio de La Campana. Sirve a doble servicio: por la mañana y a mediodía, y por la noche de 19:30 a medianoche. El menú del día incluye pan, bebida y postre casero. 4,8 en Google."
				image={costillas}
				imageAlt="Costillas de cerdo a la plancha con patatas fritas en Restaurante la Cabaña, Marbella"
				primaryCta={{ label: 'Llamar al 952 77 88 95', href: phoneHref }}
				secondaryCta={{ label: 'Cómo llegar', href: directionsUrl }}
				facts={[
					{ label: 'Nota', html: '<b>4,8</b> en Google (12 reseñas)' },
					{ label: 'Menú del día', html: 'Con postre incluido' },
					{ label: 'Horario', html: 'Martes a sábado, <b>15:00 y 24:00</b>' },
					{ label: 'Cocina', html: 'Pescado, marisco y <b>carne a la plancha</b>' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece La Cabaña" items={servicios} />

			<LocalAbout
				label="Restaurante"
				title="Un salón tradicional<br /><em>en La Campana.</em>"
				paragraphs={[
					'La Cabaña ocupa el número 5 de la avenida General López Domínguez, en pleno barrio de La Campana, a tiro de piedra del centro de Marbella y con el aparcamiento underground justo al lado. El local es de los de toda la vida: salón amplio, servicio cercano y una cocina que se apoya en el producto del día.',
					'El menú del día cambia cada jornada y se centra en el mar y en la plancha. Las reseñas de Google lo describen así: más de diez primeros platos y otros tantos segundos, con pan, bebida y postre incluidos. Entre los platos que más se repiten en los comentarios están el tomate rosa con ventresca y el atún a la plancha con patatas a lo pobre.',
					'Los postres son caseros y entran también en el menú del día: hay distintas tartas, y una de las reseñas recomienda expresamente la tarta de la abuela. También se puede ir solo por la carne a la plancha, que es la otra cara de la carta.',
					'El servicio funciona a doble turno: por la mañana y hasta las tres de la tarde, y por la noche de 19:30 a medianoche, de martes a sábado. El domingo solo por la mañana y el lunes abre a las nueve. Dentro hay muchas mesas y también se come en el exterior.',
				]}
				note="La ficha de Google le da un 4,8 sobre 12 reseñas. Las opiniones coinciden en tres cosas: la relación calidad-precio, la profesionalidad del personal y la limpieza del local. Con doce reseñas la muestra es pequeña, así que conviene leerlas antes de decidir."
				links={[{ label: 'Ficha y reseñas en Google', href: cidUrl, external: true }]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Lo que se come<br /><em>aquí.</em>"
				description="La ficha no publica la carta escrita, pero las reseñas de Google detallan el menú del día y los platos que más se piden. Todo lo que sigue está recogido de opiniones de clientes, así que conviene confirmarlo en el local."
				cta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl }}
				groups={grupos}
				note="El precio del menú del día y su composición pueden cambiar. Para confirmar la carta y los precios de hoy, llama al 952 77 88 95 o consulta la ficha de Google Maps."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Lo que sirven<br /><em>y dónde está.</em>"
				description="Estas fotografías proceden del perfil del Restaurante la Cabaña en Google Maps. La ficha tiene muy pocas imágenes: dos de platos y una de la playa de Marbella, que se incluye como contexto del entorno."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del local en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Av. General López Domínguez, 5 · 29603 Marbella"
				title="Te esperamos<br /><em>en Marbella.</em>"
				addressLines={[
					business.street,
					business.district,
					`${business.postalCode} ${business.city}, España`,
				]}
				hours={[
					{ day: 'Lunes', value: '9:00–15:00 y 19:30–24:00' },
					{ day: 'Martes', value: '0:00–15:00 y 19:30–24:00' },
					{ day: 'Miércoles', value: '0:00–15:00 y 19:30–24:00' },
					{ day: 'Jueves', value: '0:00–15:00 y 19:30–24:00' },
					{ day: 'Viernes', value: '0:00–15:00 y 19:30–24:00' },
					{ day: 'Sábado', value: '0:00–15:00 y 19:30–24:00' },
					{ day: 'Domingo', value: '0:00–11:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google: doble servicio de martes a sábado, de 0:00 a 15:00 y de 19:30 a 24:00; el domingo solo de 0:00 a 11:00 y el lunes de 9:00 a 15:00 y de 19:30 a 24:00. Puede variar en festivos."
				mapTitle="Mapa del Restaurante la Cabaña en la avenida General López Domínguez, 5, Marbella"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="La Cabaña · Marbella"
				mapHref={cidUrl}
				links={[{ label: 'Llamar al 952 77 88 95', href: phoneHref, external: true, variant: 'primary' }]}
				contactLink={{ label: 'Llamar al 952 77 88 95', href: phoneHref, external: true }}
				reserveNote="El local admite reservas y el teléfono está publicado. Con la sala llena entre semana al mediodía y los fines de semana por la noche, conviene llamar antes para guardar mesa."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="C"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Ficha y fotos ↗', href: cidUrl, external: true },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar al 952 77 88 95"
		/>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>