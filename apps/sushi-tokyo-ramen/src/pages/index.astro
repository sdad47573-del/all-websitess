---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalWhatsappFab,
} from '@astro-components';

import ramen from '../assets/fotos/sushi-tokyo-ramen-apaisada-04.jpg';
import surtido from '../assets/fotos/sushi-tokyo-ramen-apaisada-03.jpg';
import nigiri from '../assets/fotos/sushi-tokyo-ramen-apaisada-05.jpg';
import sashimi from '../assets/fotos/sushi-tokyo-ramen-apaisada-09.jpg';
import miso from '../assets/fotos/sushi-tokyo-ramen-apaisada-10.jpg';
import arroz from '../assets/fotos/sushi-tokyo-ramen-cuadrada-06.jpg';
import salon from '../assets/fotos/sushi-tokyo-ramen-vertical-01.jpg';
import clientes from '../assets/fotos/sushi-tokyo-ramen-vertical-02.jpg';
import wakame from '../assets/fotos/sushi-tokyo-ramen-vertical-08.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Sushi TOKYO Ramen Restaurant, restaurante japonés en la Rua do Forno do Tijolo 36C D (1170-137 Lisboa): sushi, ramen y platos japoneses, en sala o a domicilio. Abre todos los días, con mediodía y cena. 4,7 en Google con 252 reseñas. Tel. 920 163 272.';

const galeria = [
	{
		src: surtido,
		alt: 'Bandeja de sushi de Sushi TOKYO Ramen con nigiri, maki y rollos, con wasabi y jengibre',
	},
	{
		src: ramen,
		alt: 'Ramen de Sushi TOKYO Ramen con chashu, huevo, nori, enoki y cebolleta',
	},
	{
		src: nigiri,
		alt: 'Fila de nigiri de salmón con jengibre y wasabi en Sushi TOKYO Ramen',
	},
	{
		src: sashimi,
		alt: 'Sashimi de salmón sobre hoja verde en Sushi TOKYO Ramen',
	},
	{
		src: miso,
		alt: 'Cuenco de sopa de miso con tofu, alga y cebolleta en Sushi TOKYO Ramen',
	},
	{
		src: arroz,
		alt: 'Arroz frito con huevo, jamón y verduras en Sushi TOKYO Ramen',
	},
	{
		src: wakame,
		alt: 'Ensalada de wakame con sésamo en cuenco blanco en Sushi TOKYO Ramen',
	},
	{
		src: salon,
		alt: 'Comedor de Sushi TOKYO Ramen con manteles rojos, lámparas de mimbre y luz de neón',
	},
	{
		src: clientes,
		alt: 'Clientes cenando en las mesas rojas del comedor de Sushi TOKYO Ramen',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	acceptsReservations: true,
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['Sushi Tokyo Ramen', 'Sushi TOKYO Lisboa', 'Sushi Tokyo Ramen Lisboa'],
	slogan: 'Sushi y ramen en Lisboa',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, BUSINESS.whatsapp],
	telephone: '+351 920 163 272',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Japonesa', 'Sushi', 'Ramen'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Saturday'],
			opens: '12:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '18:30',
			closes: '01:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '18:30',
			closes: '02:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '18:30',
			closes: '23:30',
		},
	],
	hasDeliveryMethod: 'http://purl.org/goodrelations/v1#DeliveryModeOwnFleet',
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Sushi TOKYO Ramen · Sushi y ramen en Lisboa';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1c2b3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Sushi TOKYO Ramen Lisboa, sushi Lisboa, ramen Lisboa, restaurante japones Lisboa, sushi a domicilio Lisboa, sashimi Lisboa, Rua do Forno do Tijolo, restaurante Intendente, ramen a domicilio Lisboa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Sushi TOKYO Ramen · Sushi y ramen en Lisboa"
			ogDescription="Sushi, sashimi, ramen con chashu y arroz frito. En sala o a domicilio por WhatsApp. Abre todos los días. 4,7 en Google con 252 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bandeja de sushi con nigiri y rollos de Sushi TOKYO Ramen, Lisboa"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1c2b3a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone="+351920163272"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.regionName}`}
			countryName="Portugal"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				phone: '+351 920 163 272',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[ramen]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Sushi y ramen · Lisboa"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Rua do Forno do Tijolo, 36C D · Lisboa"
				title="Sushi y ramen,<br /><em>a cualquier hora.</em>"
				lede="Sushi TOKYO Ramen está en la Rua do Forno do Tijolo, en Lisboa: sushi y sashimi de salmón, ramen con chashu y huevo, arroz frito y sopa de miso. Se come en el comedor de manteles rojos o se pide a domicilio por WhatsApp. Abre todos los días, con turno de mediodía y de cena."
				image={ramen}
				imageAlt="Ramen de Sushi TOKYO Ramen con chashu, huevo, nori, enoki y cebolleta"
				primaryCta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Pedir por WhatsApp', href: BUSINESS.whatsapp, external: true }}
				tag="Japonesa"
				facts={[
					{ label: 'Nota', html: '<b>4,7 en Google</b> con 252 reseñas' },
					{ label: 'Mediodía', html: '<b>12:30 – 16:00</b>' },
					{ label: 'Cena', html: '<b>18:30 – 1:00</b>' },
					{ label: 'Domingo', html: '<b>Solo cena</b>' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Sushi TOKYO Ramen" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Japonesa de barrio,<br /><em>con sushi y ramen.</em>"
				paragraphs={[
					'Sushi TOKYO Ramen está en la Rua do Forno do Tijolo, 36C D, entre Intendente y Almirante Reis. El comedor es inconfundible: manteles rojos, sillas y mesas de madera, lámparas de mimbre y una luz de neón que tiñe la sala de rosa y azul. Hay un cartel vertical con caligrafía japonesa y una pantalla al fondo.',
					'La cocina es japonesa de fusión, como la describe el propio restaurante: bandejas de sushi y sashimi de salmón, nigiri, ramen con chashu, huevo y nori, arroz frito al wok y sopa de miso. Para acompañar, ensalada de wakame y bebidas frescas.',
					'Se puede comer en sala o pedir a domicilio: el enlace que el restaurante publica en Google es su WhatsApp, el 920 163 272. Abre todos los días, con turno de mediodía y de cena, y los viernes y sábados alarga la noche hasta las dos de la mañana.',
				]}
				note="«Sushi TOKYO Ramen Restaurant is your go-to destination for a delightful fusion of Japanese cuisine», escribe el restaurante en su ficha de Google. Y añade que trabaja con «the freshest ingredients and a passion for flavor»."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Pedir por WhatsApp', href: BUSINESS.whatsapp, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Sushi,<br />ramen y<br /><em>arroz frito.</em>"
				description="La ficha no publica carta con precios: estos platos salen de la descripción del propio restaurante y de las fotos del perfil, con las bandejas de sushi, el ramen, el arroz frito, la sopa de miso y la ensalada de wakame."
				cta={{ label: 'Pedir por WhatsApp', href: BUSINESS.whatsapp }}
				groups={MENU}
				note="Sushi TOKYO Ramen no publica precios en Google y esta web no los inventa. La carta es amplia y cambia, así que lo mejor es pedir la actualizada por WhatsApp, al 920 163 272, y confirmar allí alérgenos y disponibilidad para grupos."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El sushi,<br />el ramen<br /><em>y el comedor.</em>"
				description="Estas fotografías proceden del perfil de Sushi TOKYO Ramen en Google Maps: la bandeja de sushi, el ramen, el nigiri y el sashimi de salmón, la sopa de miso, el arroz frito, la ensalada de wakame y el comedor de manteles rojos."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Rua do Forno do Tijolo, 36C D · 1170-137 Lisboa"
				title="En el Forno do Tijolo,<br /><em>todos los días.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Portugal']}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="De lunes a jueves hay dos turnos: 12:30–16:00 y 18:30–1:00. El viernes solo cena, de 18:30 a 2:00. El sábado repite los dos turnos y alarga la noche hasta las 2:00, y el domingo solo abre para cenar, de 18:30 a 23:30. En festivos el horario puede cambiar."
				mapTitle="Mapa de Sushi TOKYO Ramen en la Rua do Forno do Tijolo, 36C D, Lisboa"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Sushi TOKYO Ramen · Lisboa"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: 'Pedir por WhatsApp ↗', href: BUSINESS.whatsapp, external: true }}
				reserveNote="No hay reserva online: se reserva por teléfono o por WhatsApp, en el 920 163 272. El restaurante anuncia servicio a domicilio en su ficha de Google, así que también se puede pedir sin salir de casa. La ficha no detalla información de accesibilidad."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>venir.</em>" />
		</main>

		<LocalWhatsappFab
			phone={BUSINESS.phoneHref}
			name={BUSINESS.shortName}
			message="Hola, os escribo desde la web de Sushi TOKYO Ramen. Quería hacer un pedido."
		/>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'WhatsApp ↗', href: BUSINESS.whatsapp, external: true },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, platos y precios antes de la visita."
			ctaLabel="Llamar a Sushi TOKYO Ramen"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
