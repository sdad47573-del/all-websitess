---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería Confitería Miguel · C. Libertador Simón Bolívar, Córdoba';
const description =
	'Panadería Confitería Miguel, en C. Libertador Simón Bolívar, 12 (barrio del Sur, 14013 Córdoba). Panadería y confitería de barrio, abierta todos los días de 8:00 a 15:00. 4,0/5 con 8 reseñas en Google.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#miguel`,
	name: BUSINESS.name,
	alternateName: ['Panadería Miguel', 'Confitería Miguel', 'Miguel Córdoba'],
	description:
		'Panadería y confitería en C. Libertador Simón Bolívar, 12 (14013 Córdoba), abierta todos los días de 8:00 a 15:00.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34957421123',
	servesCuisine: ['Panadería', 'Confitería'],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '08:00',
			closes: '15:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Horario', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#f7f2e8" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Manrope:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Confitería Miguel, panadería Córdoba, confitería Córdoba, Barrio del Sur, Libertador Simón Bolívar, 14013, pan del día"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería y confitería de barrio en C. Libertador Simón Bolívar, 12. Abierta todos los días de 8:00 a 15:00. 4,0 sobre 5 con 8 reseñas en Google."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Cartel de la Panadería Confitería Miguel en Córdoba"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#f7f2e8"
			phone="+34957421123"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Confitería Miguel"
			subtitle="Panadería · Confitería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<section class="hero wrap" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C. Libertador Simón Bolívar, 12 · Sur</p>
					<h1 id="hero-title">Panadería y confitería <br /><em>de barrio.</em></h1>
					<p class="hero-lede">
						Miguel es la panadería-confitería de la calle Libertador Simón Bolívar, 12, en
						el barrio del Sur. Abre todos los días de 8:00 a 15:00, domingo incluido, y su
						teléfono es el 957 42 11 23. La ficha de Google no publica carta, precios ni
						fotos: aquí encontrarás los datos que sí constan, sin inventar el resto.
						{BUSINESS.rating.toString().replace('.', ',')} sobre 5 con {BUSINESS.reviewsCount} reseñas en Google.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href={MAPS.directions}>Cómo llegar</a>
						<a class="button button-ghost" href={BUSINESS.phoneHref}>
							Llamar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<ul class="hero-facts">
						<li><b>{BUSINESS.street}</b> · {BUSINESS.district}</li>
						<li><b>Todos los días</b> · 8:00–15:00</li>
						<li><b>{BUSINESS.phone}</b> · atención en el local</li>
					</ul>
				</div>

				<aside class="hero-card" aria-label="Datos del establecimiento">
					<span class="hero-card-mark" aria-hidden="true">{BUSINESS.mark}</span>
					<p class="hero-card-name">Panadería <em>Confitería</em> Miguel</p>
					<dl>
						<div><dt>Horario</dt><dd>Todos los días · 8:00–15:00</dd></div>
						<div><dt>Dirección</dt><dd>{BUSINESS.street}</dd></div>
						<div><dt>Barrio</dt><dd>{BUSINESS.district} · {BUSINESS.postalCode} {BUSINESS.city}</dd></div>
						<div><dt>Teléfono</dt><dd>{BUSINESS.phone}</dd></div>
						<div><dt>Google</dt><dd>4,0 / 5 · {BUSINESS.reviewsCount} reseñas</dd></div>
					</dl>
					<a class="hero-card-link" href={MAPS.place} target="_blank" rel="noreferrer">
						Ver la ficha en Google Maps ↗
					</a>
				</aside>
			</section>

			<LocalChips label="Lo que consta en la ficha" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un nombre, <br /><em>una dirección.</em>"
				paragraphs={[
					'De esta panadería se sabe lo que figura en su ficha pública: se llama «Panadería Confitería Miguel», está en la calle Libertador Simón Bolívar, 12, en el barrio del Sur (14013 Córdoba), y su teléfono es el 957 42 11 23.',
					'La ficha la clasifica con una sola categoría, «Panadería». El nombre añade lo de confitería, así que es un negocio que se presenta como panadería y confitería a la vez, aunque Google no detalla qué productos tiene ni publica precios.',
					'El horario es de mañana completa y no descansa: todos los días, de 8:00 a 15:00, domingo incluido. Es un dato útil para quien va andando desde el centro o desde los barrios del sur de Córdoba.',
					'La ficha tampoco tiene fotos: Google no muestra ninguna imagen del local ni de sus productos. En lugar de rellenar ese hueco con fotos de otros sitios, esta página se queda con lo comprobable: dirección, horario, teléfono y nota.',
				]}
				note="No hay carta, catálogo ni precios publicados, y no hay fotos de la ficha. Si necesitas saber qué hay en el mostrador o si hacen encargos, lo más rápido es llamar al 957 42 11 23."
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas que sí constan</p>
							<h2 id="three-title">Panadería, confitería <br /><em>y barrio.</em></h2>
						</div>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="rating-band" aria-labelledby="rating-title">
				<div class="wrap rating-inner">
					<div class="rating-score">
						<strong>4,0</strong>
						<div>
							<span class="rating-stars" role="img" aria-label="4 de 5 estrellas">4 / 5</span>
							<p id="rating-title" style="margin:0;font-size:.78rem">8 reseñas en Google Maps</p>
						</div>
					</div>
					<p class="rating-copy">
						La media de la ficha es 4,0 sobre 5 con 8 reseñas: un número redondo, con pocas
						opiniones. Esta página no reproduce sus textos; se leen completas en Google.
					</p>
					<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
						Leer las 8 reseñas en Google ↗
					</a>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En el barrio <br /><em>del Sur.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de la Panadería Confitería Miguel en la calle Libertador Simón Bolívar, 12, Córdoba"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Miguel · Barrio del Sur"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phone, href: BUSINESS.phoneHref }}
				reserveNote="La ficha de Google no publica web propia, carta ni información de accesibilidad del local (solo indica que no hay aparcamiento adaptado). Esta página no gestiona pedidos ni encargos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>llamar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos y reseñas de la ficha pública de Google Maps, consultada en octubre de 2026. La ficha no publica fotos, carta ni precios. Horario y disponibilidad pueden cambiar; confírmalos antes de ir."
			ctaLabel="Llamar a Miguel"
			navAriaLabel="Enlaces de la Panadería Confitería Miguel"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
