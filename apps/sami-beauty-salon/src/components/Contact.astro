---
import { BUSINESS } from '../data/site';
---

<section id="contacto" class="bg-base-100 scroll-mt-20 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">Visítanos</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">En Carlos Haya, Málaga</h2>
			<div class="sami-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/70 mt-6">
				El salón está en el Local 3 de la avenida de Carlos Haya, 23, en Cruz de Humilladero. Se
				trabaja con cita, que se pide por teléfono o online.
			</p>
		</div>

		<div class="mt-14 grid gap-8 lg:grid-cols-2">
			<div class="space-y-6">
				<div class="etiqueta-sami rounded-box border-base-300 bg-base-200 border p-7">
					<h3 class="font-display text-xl font-semibold">Horario</h3>
					<div class="mt-5 space-y-4 text-sm">
						{
							BUSINESS.hours.map((tramo) => (
								<div class="border-base-300 flex items-baseline justify-between gap-4 border-b pb-3">
									<span class="font-semibold">{tramo.days}</span>
									<span class="text-base-content/70 text-right">{tramo.hours}</span>
								</div>
							))
						}
					</div>
					<p class="text-base-content/55 mt-4 text-xs leading-relaxed">{BUSINESS.hoursNote}</p>
					<div class="mt-6 flex flex-wrap gap-3">
						<a href={BUSINESS.phoneHref} class="btn btn-primary gap-2 rounded-full">
							<i class="ri-phone-line"></i> Llamar para reservar
						</a>
						<a
							href={BUSINESS.reservation}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline gap-2 rounded-full"
						>
							<i class="ri-calendar-event-line"></i> Reservar online
						</a>
					</div>
				</div>

				<div class="rounded-box border-base-300 bg-base-200 border p-7">
					<h3 class="font-display text-xl font-semibold">Datos del salón</h3>
					<ul class="mt-5 space-y-5 text-sm">
						<li class="flex items-start gap-4">
							<span
								class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl"
							>
								<i class="ri-map-pin-line text-xl"></i>
							</span>
							<div>
								<p class="font-semibold">Dirección</p>
								<p class="text-base-content/70">
									{BUSINESS.street}<br />{BUSINESS.postalCode}
									{BUSINESS.district}, {BUSINESS.city}
								</p>
								<p class="text-base-content/50 mt-1 text-xs">Plus Code: {BUSINESS.plusCode}</p>
							</div>
						</li>
						<li class="flex items-start gap-4">
							<span
								class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl"
							>
								<i class="ri-phone-line text-xl"></i>
							</span>
							<div>
								<p class="font-semibold">Teléfono</p>
								<a href={BUSINESS.phoneHref} class="text-base-content/70 hover:text-primary">
									{BUSINESS.phoneDisplay}
								</a>
								<p class="text-base-content/50 mt-1 text-xs">
									La vía de contacto directa del salón.
								</p>
							</div>
						</li>
						<li class="flex items-start gap-4">
							<span
								class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl"
							>
								<i class="ri-calendar-event-line text-xl"></i>
							</span>
							<div>
								<p class="font-semibold">Reserva online</p>
								<p class="text-base-content/70">
									El salón tiene ficha de reserva en Booksy, enlazada desde su propio perfil de
									Google.
								</p>
								<a
									href={BUSINESS.reservation}
									target="_blank"
									rel="noopener noreferrer"
									class="text-primary mt-1 inline-block text-xs font-semibold underline"
								>
									Reservar ahora
								</a>
							</div>
						</li>
						<li class="flex items-start gap-4">
							<span
								class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl"
							>
								<i class="ri-home-heart-line text-xl"></i>
							</span>
							<div>
								<p class="font-semibold">Un sitio al que se vuelve</p>
								<p class="text-base-content/70">
									Las reseñas describen el salón como un ambiente relajado y tranquilo, con trato
									cercano y sin esperas.
								</p>
							</div>
						</li>
					</ul>
					<div class="mt-7 flex flex-wrap gap-3">
						<a href={BUSINESS.phoneHref} class="btn btn-primary gap-2 rounded-full">
							<i class="ri-phone-line"></i> Llamar
						</a>
						<a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline gap-2 rounded-full"
						>
							<i class="ri-map-pin-line"></i> Google Maps
						</a>
					</div>
				</div>
			</div>

			<div class="rounded-box border-base-300 bg-base-200 min-h-[420px] overflow-hidden border">
				<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
				 src={BUSINESS.googleMapsEmbed}
					title={`Ubicación de ${BUSINESS.name}, ${BUSINESS.street}, ${BUSINESS.city}`}
					width="100%"
					height="100%"
					style="border: 0; min-height: 420px;"
					loading="lazy"
					allowfullscreen
					referrerpolicy="no-referrer-when-downgrade"></iframe>
				</div>
			</div>
		</div>
	</div>
</section>


