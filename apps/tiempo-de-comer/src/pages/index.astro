---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import vitrina from '../assets/fotos/tiempo-de-comer-apaisada-01.jpg';
import fachada from '../assets/fotos/tiempo-de-comer-fachada-street-view.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Tiempo de Comer · Comida casera para llevar en Chamartín';
const description =
	'Tiempo de Comer, en C. del Padre Jesús Ordóñez, 16 (Chamartín, 28002 Madrid). Comida casera y menú del día para llevar, de lunes a sábado, de 12:15 a 16:00.';

const galeria = [
	{
		src: vitrina,
		alt: 'La vitrina de Tiempo de Comer con bandejas de guisos, pasta y ensaladas y las pizarras con los precios',
	},
	{
		src: fachada,
		alt: 'La fachada de Tiempo de Comer en la calle del Padre Jesús Ordóñez, 16, con el rótulo verde y la persiana metálica',
	},
];

const precioNumerico = (price) => price?.replace(/[^\d,]/g, '').replace(',', '.');

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Tiempo de Comer',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: precioNumerico(item.price),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#tiempo-de-comer`,
	name: BUSINESS.name,
	alternateName: ['Tiempo de Comer Madrid', 'Tiempo de Comer Chamartín', 'Tiempo de Comer Padre Jesús Ordóñez'],
	description:
		'Restaurante de comida casera para llevar en la calle del Padre Jesús Ordóñez, 16 (Chamartín, 28002 Madrid). Menú del día, guisos, pasta y ensaladas preparados cada día.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34911663047',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Chamartín' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '12:15',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f4a3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Karla:wght@400;500;700&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Tiempo de Comer Madrid, comida para llevar Chamartín, comida casera Padre Jesús Ordóñez, menú del día Chamartín, Tiempo de Comer 28002, comida casera Madrid, platos preparados Chamartín"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera y menú del día para llevar en Padre Jesús Ordóñez, 16, Chamartín. De lunes a sábado, de 12:15 a 16:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La vitrina de Tiempo de Comer con bandejas de comida casera y pizarras con precios"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2f4a3a"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Chamartín"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Tiempo de Comer"
			subtitle="Comida casera · Chamartín"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. del Padre Jesús Ordóñez, 16 · Chamartín, Madrid"
				title="Comida casera <br /><em>para llevar.</em>"
				lede={`Tiempo de Comer es un restaurante de comida para llevar en la calle del Padre Jesús Ordóñez, en Chamartín. Cada día prepara menú del día, guisos, pasta y ensaladas que se ven en la vitrina, con raciones para comer en casa o en la oficina. Abre de lunes a sábado, de 12:15 a 16:00, y tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={vitrina}
				imageAlt="La vitrina de Tiempo de Comer con bandejas de guisos, pasta y ensaladas y las pizarras con los precios"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>12:15–16:00</b> · domingo cerrado' },
					{ label: 'Servicio', html: '<b>Para llevar</b> · menú del día' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Comida casera"
			/>

			<LocalChips label="Lo que ofrece Tiempo de Comer" items={SERVICIOS} />

			<LocalAbout
				label="El local"
				title="Cocina de cada día <br /><em>en Chamartín.</em>"
				paragraphs={[
					'Dentro manda la vitrina. Las bandejas llevan su pizarra con el nombre y el precio: ensalada capresse, lentejas, patatas al ajillo, albóndigas de ternera, pimientos rellenos, lomo asado con naranja, pechuga con setas, espaguetis al ajillo o estufado de ternera, entre otros platos.',
					'La ficha de Google clasifica el local como restaurante de comida para llevar. No publica descripción, carta ni página web, pero las fotos del perfil muestran el mostrador lleno de envases preparados y las pizarras con los precios del día.',
					'Las reseñas dejan claro el perfil de la casa: «Menú del día y platos de comida casera elaborados cada día», «comida variada y de muy buena calidad con un trato inmejorable» y «los espaguetis al ajillo impresionantes, volveré seguro».',
					`La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas. Abre de lunes a sábado, de 12:15 a 16:00, y cierra el domingo. El teléfono que publica es el ${BUSINESS.phone}.`,
				]}
				note="La ficha no publica carta oficial, precio del menú ni datos de accesibilidad. Los platos y precios de esta página son los que aparecen en la pizarra de la vitrina en la foto del perfil de Google, consultada en octubre de 2026. La disponibilidad cambia cada día: confírmala por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que se prepara</p>
					<h2 id="highlights-title">Menú, vitrina <br /><em>y raciones de casa.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La comida"
				title="Lo que hay <br /><em>en la vitrina.</em>"
				description="La ficha de Google no publica una carta. Esta lista sale de la pizarra de la vitrina que aparece en la foto del local: platos caseros, raciones preparadas y su precio."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Precios vistos en la pizarra de la vitrina en la foto del perfil de Google (octubre de 2026). La ficha no publica carta, menú del día ni precios actualizados; los platos cambian cada día y conviene confirmarlos por teléfono."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La vitrina <br /><em>y la fachada.</em>"
				description="Dos imágenes de Google Maps: la vitrina con los platos del día y las pizarras de precios, y la fachada del local en la calle del Padre Jesús Ordóñez."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento y de Street View en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,3 sobre 5, <em>con 23 reseñas.</em></h2>
						<p>
							Google publica una media de 4,3 con 23 opiniones (octubre de 2026). Las tres
							reseñas que destaca la ficha son de cinco estrellas y coinciden en la comida
							casera, la variedad y el trato. La media no es perfecta, así que hay opiniones
							para todos los gustos; estas son las que aparecen publicadas.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,3</strong>
						<span>★★★★☆</span>
						<small>23 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En Chamartín, <br /><em>Padre Jesús Ordóñez.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de lunes a sábado, de 12:15 a 16:00, con el domingo cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Tiempo de Comer en la calle del Padre Jesús Ordóñez, 16, Chamartín, Madrid"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Padre Jesús Ordóñez, 16 · Chamartín"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos y consultas por teléfono: la ficha no publica reservas ni pedidos online. Tampoco publica datos de accesibilidad, así que conviene llamar antes si necesitas acceso para silla de ruedas."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma platos y horario antes de la visita."
			ctaLabel="Llamar a Tiempo de Comer"
			navAriaLabel="Enlaces de Tiempo de Comer"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
