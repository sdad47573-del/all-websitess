# Stripe secret key, used only by the API server (server/stripe.ts).
#
# This is a SECRET: it never reaches the browser. The Vite build only exposes
# variables prefixed with VITE_, and this one is not, so it stays on the server.
#
# Without it the shop still works: orders can be placed and the API reports card
# payment as unavailable (503) with a message pointing the customer at WhatsApp.
STRIPE_SECRET_KEY=

# Port for the API server. Vite proxies /api here in development.
PORT=8787
