---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import mostrador from '../assets/fotos/panaderia-la-miguita-apaisada-01.jpg';
import puesto from '../assets/fotos/panaderia-la-miguita-vertical-10.jpg';
import rotulo from '../assets/fotos/panaderia-la-miguita-vertical-05.jpg';
import dulces from '../assets/fotos/panaderia-la-miguita-vertical-02.jpg';
import rosco from '../assets/fotos/panaderia-la-miguita-apaisada-04.jpg';
import estanteria from '../assets/fotos/panaderia-la-miguita-apaisada-03.jpg';
import mostradorLado from '../assets/fotos/panaderia-la-miguita-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería La Miguita · pan y bollería en el Mercado del Marrubial, Córdoba';
const description =
	'Panadería La Miguita, puesto nº 17 del Mercado del Marrubial (Av. de Jesús Rescatado, 1, 14010 Córdoba). Pan del día, barras, teleras y bollería, de lunes a sábado de 8:30 a 14:00. 5,0/5 en Google.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#miguita`,
	name: BUSINESS.name,
	alternateName: ['La Miguita', 'Panadería La Miguita Córdoba'],
	description:
		'Panadería en el puesto nº 17 del Mercado del Marrubial (Av. de Jesús Rescatado, 1, 14010 Córdoba). Pan del día, barras, teleras y bollería, de lunes a sábado de 8:30 a 14:00.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34658394831',
	servesCuisine: ['Panadería', 'Bollería'],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Av. de Jesús Rescatado, 1 (Mercado del Marrubial, puesto nº 17)',
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:30',
			closes: '14:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El puesto', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Horario', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const galeria = [
	{
		src: puesto,
		alt: 'Fachada del puesto de la Panadería La Miguita en el Mercado del Marrubial, con el rótulo blanco de letras negras',
	},
	{
		src: rotulo,
		alt: 'Rótulo «Panadería La Miguita» visto en diagonal sobre el mostrador del puesto',
	},
	{
		src: dulces,
		alt: 'Bolsa de bollería envasada de la marca Cristi con roscones glaseados y napolitanas de chocolate',
	},
	{
		src: rosco,
		alt: 'Roscón de Reyes con nata, fruta escarchada y azúcar en su caja de cartón',
	},
	{
		src: estanteria,
		alt: 'Estanterías del puesto con galletas, chocolates, conservas y una huevera llena de huevos',
	},
	{
		src: mostradorLado,
		alt: 'Pasillo del mercado junto al puesto, con las estanterías de bollería y la vitrina de pan',
	},
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"panaderia-la-miguita-apaisada-01.jpg": mostrador,
	"panaderia-la-miguita-vertical-10.jpg": puesto,
	"panaderia-la-miguita-vertical-05.jpg": rotulo,
	"panaderia-la-miguita-vertical-02.jpg": dulces,
	"panaderia-la-miguita-apaisada-04.jpg": rosco,
	"panaderia-la-miguita-apaisada-03.jpg": estanteria,
	"panaderia-la-miguita-vertical-09.jpg": mostradorLado,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#f7f0e3" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Karla:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería La Miguita, panadería Córdoba, Mercado del Marrubial, puesto 17, pan del día, bollería Córdoba, Av. de Jesús Rescatado, 14010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan del día, barras, teleras y bollería en el puesto nº 17 del Mercado del Marrubial, de lunes a sábado de 8:30 a 14:00. 5,0 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Puesto de la Panadería La Miguita en el Mercado del Marrubial, Córdoba"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#f7f0e3"
			phone="+34658394831"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[mostrador]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Miguita"
			subtitle="Panadería · Mercado del Marrubial"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario, productos y precios pueden cambiar; confírmalos en el puesto."
			ctaLabel="Llamar a La Miguita"
			navAriaLabel="Enlaces de la Panadería La Miguita"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
