---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/la-sultana-vertical-01.jpg';
import pastelaMesa from '../assets/fotos/la-sultana-vertical-02.jpg';
import comedor from '../assets/fotos/la-sultana-vertical-03.jpg';
import pastelas from '../assets/fotos/la-sultana-vista-4-04.jpg';
import vitrina from '../assets/fotos/la-sultana-panoramica-05.jpg';
import te from '../assets/fotos/la-sultana-vertical-06.jpg';
import neon from '../assets/fotos/la-sultana-vertical-07.jpg';
import mesa from '../assets/fotos/la-sultana-vertical-08.jpg';
import polloFrito from '../assets/fotos/la-sultana-apaisada-09.jpg';
import tajin from '../assets/fotos/la-sultana-apaisada-10.jpg';

import { AVISO_FOTOS, BUSINESS, FAQ, HORARIO, HORARIO_AVISO, MAPS, RESENAS, SERVICIOS } from '../data/site';

const title = 'La Sultana · Restaurante marroquí en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de La Sultana con el toldo negro, el rótulo de bar restaurante y la madera oscura bajo el local',
	},
	{
		src: pastelaMesa,
		alt: 'Dos comensales cortando una pastela recién servida en la mesa del comedor',
	},
	{
		src: comedor,
		alt: 'Comedor con mesas de madera, sillas negras y la barra verde al fondo',
	},
	{
		src: pastelas,
		alt: 'Tres pastelas espolvoreadas con azúcar glas y pétalos de rosa sobre hojas de lechuga',
	},
	{
		src: vitrina,
		alt: 'Vitrina de pastas marroquíes con bandejas de dulces y el cartel de Sin Gluten',
	},
	{
		src: te,
		alt: 'Vaso de té con hierbabuena junto a la tetera marroquí sobre la mesa',
	},
	{
		src: neon,
		alt: 'Pared verde del comedor con el neón de la hamsa y un rótulo de la casa',
	},
	{
		src: mesa,
		alt: 'Mesa puesta con mantel amarillo, copas y cubertería antes del servicio',
	},
	{
		src: polloFrito,
		alt: 'Pollo frito crujiente con patatas y salsa blanca servido sobre papel de periódico',
	},
	{
		src: tajin,
		alt: 'Tajín de verduras con garbanzos y zanahoria sobre plato de cerámica negra',
	},
];

const carta = [
	{
		title: 'La cocina de la casa',
		items: [
			{ name: 'Pastela', note: 'con azúcar glas y canela, la que citan las reseñas' },
			{ name: 'Cuscús de pollo', note: 'citado en las reseñas de Google' },
			{ name: 'Tajín de verduras', note: 'con garbanzos y zanahoria' },
			{ name: 'Cuscús', note: 'sémola con verduras y garbanzos' },
		],
	},
	{
		title: 'De la vitrina',
		items: [
			{ name: 'Pastas marroquíes', note: 'surtido de dulces de la vitrina' },
			{ name: 'Pastas sin gluten', note: 'bandeja marcada con el cartel de la vitrina' },
			{ name: 'Dulces con almendra', note: 'pastas de la casa para acompañar el té' },
		],
	},
	{
		title: 'Para beber y picar',
		items: [
			{ name: 'Té con hierbabuena', note: 'servido en tetera, como en las fotos' },
			{ name: 'Pollo frito con patatas', note: 'con salsa blanca, de la carta de picoteo' },
			{ name: 'Menú diario', note: 'anunciado en el rótulo de la fachada' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-sultana`,
	name: BUSINESS.name,
	alternateName: ['La Sultana Ciudad Real', 'Restaurante La Sultana', 'La Sultana Marroquí'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Marroquí', 'Cocina del norte de África'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Ciudad Real' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Código', value: '/g/11x5l11m1n' },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '19:00',
			closes: '00:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1a1114" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,700&family=Nunito+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Sultana Ciudad Real, restaurante marroquí Ciudad Real, pastela Ciudad Real, cuscús Ciudad Real, tajín Ciudad Real, comer marroquí C. del Lirio 37, menú diario Ciudad Real, té a la menta Ciudad Real"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Restaurante marroquí en la calle del Lirio, 37, 13004 Ciudad Real. Pastela, cuscús, tajines, pastas y té a la menta, con menú diario. De miércoles a domingo de 10:30 a 16:00 y de 19:00 a 24:00. Teléfono 643 89 94 42."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="La Sultana, restaurante marroquí en Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1a1114"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CR"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[pastelas]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Sultana"
			subtitle="Restaurante marroquí · Ciudad Real"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="Cocina marroquí <br /><em>en el centro.</em>"
				lede="La Sultana es un restaurante marroquí en la calle del Lirio, 37, a un paso del centro de Ciudad Real. Pastela espolvoreada con azúcar glas y canela, cuscús de pollo, tajines, pastas de la vitrina y té con hierbabuena, con menú diario para comer o cenar. De miércoles a domingo, de 10:30 a 16:00 y de 19:00 a 24:00; los martes solo cena y los lunes cierra. Se llama al 643 89 94 42."
				image={pastelas}
				imageAlt="Tres pastelas espolvoreadas con azúcar glas y pétalos de rosa sobre hojas de lechuga"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,3</b> en Google · 81 reseñas' },
					{ label: 'Horario', html: '<b>10:30–16:00 · 19:00–24:00</b><br />Lunes cerrado' },
					{ label: 'Reservas', html: `<b>${BUSINESS.phone}</b><br />Por teléfono, en el local` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de La Sultana" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una mesa <br /><em>marroquí.</em>"
				paragraphs={[
					'El local está en la calle del Lirio, 37, con el toldo negro y el rótulo de «La Sultana» sobre la madera que cubre la fachada. Al lado, el cartel anuncia «Bar restaurante» y «Menú diarios», así que se puede entrar a comer de menú, a cenar o a tomar un té.',
					'Dentro hay dos ambientes: el comedor con mesas de madera y sillas negras junto a la barra verde, y el rincón de la pared verde con el neón de la hamsa. En las mesas aparecen las pastelas espolvoreadas con azúcar glas y pétalos de rosa, los tajines de barro y el juego de té con la tetera marroquí.',
					'La ficha de Google lo clasifica como restaurante marroquí, y la valoración publicada es de 4,3 sobre 5 con 81 reseñas. Google destaca tres, todas de cinco estrellas: hablan de la pastela, del cuscús de pollo, del trato y de que las raciones son abundantes.',
					'La ficha añade dos distintivos del negocio: se identifica como local de propietarias mujeres y como espacio amable con las personas LGBTQ+. El horario es de dos turnos, con el lunes cerrado y el martes solo de cena.',
				]}
				note="La ficha de Google no publica la carta con precios. Los platos de esta página salen de las fotos del propio perfil, del rótulo de menú diario de la fachada y de las reseñas: si algo no está ese día, manda la cocina."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Pastela, cuscús <br /><em>y tajín.</em>"
				description="Lo que aparece en las fotos del perfil y lo que citan las reseñas: pastela, cuscús de pollo, tajín de verduras, el surtido de pastas de la vitrina y el té con hierbabuena."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={carta}
				note="Platos tomados de las fotos del perfil de Google Maps, del rótulo de la fachada y de las reseñas destacadas. La ficha no publica precios: se consultan en el local o llamando al 643 89 94 42."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
					<div class="reviews-head">
						<h2 id="resenas-title">Pastela <br /><em>y buenas raciones.</em></h2>
						<p>
							La ficha tiene 81 reseñas y una media de 4,3 sobre 5. Estas son las tres que Google
							destaca, todas de cinco estrellas, copiadas tal cual.
						</p>
					</div>
					<div class="review-grid">
						{
							RESENAS.map((review) => (
								<figure class="review-card">
									<p class="review-stars" aria-label={`${review.rating} sobre 5`}>
										{'★'.repeat(review.rating)}
									</p>
									<blockquote>{review.quote}</blockquote>
									<figcaption>Reseña publicada en Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="review-note">
						Citas de las reseñas públicas del local, con la puntuación del autor. En la ficha de Google
						están todas, incluidas las que puntúan por debajo.
					</p>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La mesa <br /><em>y la casa.</em>"
				description="Diez fotos del perfil del local: la fachada, el comedor, las pastelas, la vitrina de pastas con su cartel de sin gluten, el té con hierbabuena, el neón de la hamsa y el tajín de verduras."
				images={galeria}
				cta={{ label: 'Ver todas en Google Maps', href: MAPS.place }}
				note={AVISO_FOTOS}
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="A comer <br /><em>o a cenar.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Ciudad Real · España']}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de La Sultana en la calle del Lirio, 37, Ciudad Real"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Sultana"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="No hay reservas online ni esta página las tramita: las mesas se piden en el local o por teléfono, en el 643 89 94 42. La ficha marca aseo y aparcamiento adaptados para sillas de ruedas; de la entrada y los asientos no publica nada."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="La Sultana"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos, horario y fotografías tomados de la ficha y del perfil públicos del local en Google Maps, consultados en noviembre de 2026. La ficha no publica carta ni precios: confirma horario y disponibilidad antes de ir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de La Sultana"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
