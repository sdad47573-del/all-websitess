---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/la-sultana-vertical-01.jpg';
import pastelaMesa from '../assets/fotos/la-sultana-vertical-02.jpg';
import comedor from '../assets/fotos/la-sultana-vertical-03.jpg';
import pastelas from '../assets/fotos/la-sultana-vista-4-04.jpg';
import vitrina from '../assets/fotos/la-sultana-panoramica-05.jpg';
import te from '../assets/fotos/la-sultana-vertical-06.jpg';
import neon from '../assets/fotos/la-sultana-vertical-07.jpg';
import mesa from '../assets/fotos/la-sultana-vertical-08.jpg';
import polloFrito from '../assets/fotos/la-sultana-apaisada-09.jpg';
import tajin from '../assets/fotos/la-sultana-apaisada-10.jpg';

import {
	AVISO_FOTOS,
	BUSINESS,
	FAQ,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'La Sultana · Restaurante marroquí en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de La Sultana con el toldo negro, el rótulo de bar restaurante y la madera oscura bajo el local',
	},
	{
		src: pastelaMesa,
		alt: 'Dos comensales cortando una pastela recién servida en la mesa del comedor',
	},
	{
		src: comedor,
		alt: 'Comedor con mesas de madera, sillas negras y la barra verde al fondo',
	},
	{
		src: pastelas,
		alt: 'Tres pastelas espolvoreadas con azúcar glas y pétalos de rosa sobre hojas de lechuga',
	},
	{
		src: vitrina,
		alt: 'Vitrina de pastas marroquíes con bandejas de dulces y el cartel de Sin Gluten',
	},
	{
		src: te,
		alt: 'Vaso de té con hierbabuena junto a la tetera marroquí sobre la mesa',
	},
	{
		src: neon,
		alt: 'Pared verde del comedor con el neón de la hamsa y un rótulo de la casa',
	},
	{
		src: mesa,
		alt: 'Mesa puesta con mantel amarillo, copas y cubertería antes del servicio',
	},
	{
		src: polloFrito,
		alt: 'Pollo frito crujiente con patatas y salsa blanca servido sobre papel de periódico',
	},
	{
		src: tajin,
		alt: 'Tajín de verduras con garbanzos y zanahoria sobre plato de cerámica negra',
	},
];

const carta = [
	{
		title: 'La cocina de la casa',
		items: [
			{ name: 'Pastela', note: 'con azúcar glas y canela, la que citan las reseñas' },
			{ name: 'Cuscús de pollo', note: 'citado en las reseñas de Google' },
			{ name: 'Tajín de verduras', note: 'con garbanzos y zanahoria' },
			{ name: 'Cuscús', note: 'sémola con verduras y garbanzos' },
		],
	},
	{
		title: 'De la vitrina',
		items: [
			{ name: 'Pastas marroquíes', note: 'surtido de dulces de la vitrina' },
			{ name: 'Pastas sin gluten', note: 'bandeja marcada con el cartel de la vitrina' },
			{ name: 'Dulces con almendra', note: 'pastas de la casa para acompañar el té' },
		],
	},
	{
		title: 'Para beber y picar',
		items: [
			{ name: 'Té con hierbabuena', note: 'servido en tetera, como en las fotos' },
			{ name: 'Pollo frito con patatas', note: 'con salsa blanca, de la carta de picoteo' },
			{ name: 'Menú diario', note: 'anunciado en el rótulo de la fachada' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-sultana`,
	name: BUSINESS.name,
	alternateName: ['La Sultana Ciudad Real', 'Restaurante La Sultana', 'La Sultana Marroquí'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Marroquí', 'Cocina del norte de África'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Ciudad Real' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Código', value: '/g/11x5l11m1n' },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '19:00',
			closes: '00:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-sultana-vista-4-04.jpg": pastelas,
	"la-sultana-vertical-01.jpg": fachada,
	"la-sultana-vertical-02.jpg": pastelaMesa,
	"la-sultana-vertical-03.jpg": comedor,
	"la-sultana-panoramica-05.jpg": vitrina,
	"la-sultana-vertical-06.jpg": te,
	"la-sultana-vertical-07.jpg": neon,
	"la-sultana-vertical-08.jpg": mesa,
	"la-sultana-apaisada-09.jpg": polloFrito,
	"la-sultana-apaisada-10.jpg": tajin,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1a1114" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,700&family=Nunito+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Sultana Ciudad Real, restaurante marroquí Ciudad Real, pastela Ciudad Real, cuscús Ciudad Real, tajín Ciudad Real, comer marroquí C. del Lirio 37, menú diario Ciudad Real, té a la menta Ciudad Real"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Restaurante marroquí en la calle del Lirio, 37, 13004 Ciudad Real. Pastela, cuscús, tajines, pastas y té a la menta, con menú diario. De miércoles a domingo de 10:30 a 16:00 y de 19:00 a 24:00. Teléfono 643 89 94 42."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="La Sultana, restaurante marroquí en Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1a1114"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CR"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[pastelas]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Sultana"
			subtitle="Restaurante marroquí · Ciudad Real"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="La Sultana"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos, horario y fotografías tomados de la ficha y del perfil públicos del local en Google Maps, consultados en noviembre de 2026. La ficha no publica carta ni precios: confirma horario y disponibilidad antes de ir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de La Sultana"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34643899442?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Pastela." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Pastela"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
