---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/can-tu-rostisseria-fachada.jpg';
import pollo from '../assets/fotos/can-tu-rostisseria-pollo-asado.jpg';
import gratinados from '../assets/fotos/can-tu-rostisseria-gratinados.jpg';
import carbassa from '../assets/fotos/can-tu-rostisseria-carbassa.jpg';
import mostrador from '../assets/fotos/can-tu-rostisseria-mostrador.jpg';
import pimientos from '../assets/fotos/can-tu-rostisseria-pimientos.jpg';
import fachada2 from '../assets/fotos/can-tu-rostisseria-fachada-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'CAN TU Rostisseria · Pollo asado y platos para llevar en Andorra la Vella';
const description =
	'CAN TU Rostisseria, Cap del Carrer, 16 (AD500 Andorra la Vella). Pollo asado en bandeja, gratinados, calabaza rellena y platos preparados para llevar. De martes a domingo al mediodía y noches de martes a sábado; lunes cerrado.';

const galeria = [
	{
		src: pollo,
		alt: 'Pollo asado en bandeja de acero con patatas, calabacín, tomate asado y cebolla morada',
	},
	{
		src: gratinados,
		alt: 'Dos barquetas de aluminio con un gratinado de queso y una carne con cebolla',
	},
	{
		src: carbassa,
		alt: 'Calabaza entera horneada y rellena de garbanzos, butifarra negra y tomate',
	},
	{
		src: mostrador,
		alt: 'Mostrador de cristal con bandejas de carne con bacon y verduras asadas',
	},
	{
		src: pimientos,
		alt: 'Pimientos rojos y verdes rellenos de arroz y pollo en una bandeja metálica',
	},
	{
		src: fachada2,
		alt: 'Entrada de la rostisseria CAN TU con el toldo negro y la pizarra en la acera',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que sale de la rostisseria',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#can-tu-rostisseria`,
	name: BUSINESS.name,
	alternateName: ['Can Tu', 'Rostisseria Can Tu', 'Can Tu Andorra'],
	description:
		'Rostisseria y platos preparados en Andorra la Vella: pollo asado en bandeja con patatas y verduras, gratinados, calabaza rellena y pimientos rellenos para llevar.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376740000',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Rostisseria', 'Catalana', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Andorra la Vella' },
		{ '@type': 'AdministrativeArea', name: 'Andorra' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Tuesday', opens: '11:00', closes: '15:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Tuesday', opens: '19:30', closes: '22:30' },
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Sunday'],
			opens: '10:30',
			closes: '15:00',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Thursday', opens: '10:30', closes: '15:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Thursday', opens: '19:30', closes: '22:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '10:30', closes: '15:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '19:30', closes: '22:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '10:30', closes: '15:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '19:30', closes: '22:30' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"can-tu-rostisseria-fachada.jpg": fachada,
	"can-tu-rostisseria-pollo-asado.jpg": pollo,
	"can-tu-rostisseria-gratinados.jpg": gratinados,
	"can-tu-rostisseria-carbassa.jpg": carbassa,
	"can-tu-rostisseria-mostrador.jpg": mostrador,
	"can-tu-rostisseria-pimientos.jpg": pimientos,
	"can-tu-rostisseria-fachada-09.jpg": fachada2,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2b2620" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,800&family=Inter:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Can Tu Rostisseria, pollo asado Andorra la Vella, rostisseria Andorra, comida para llevar Andorra, calabaza rellena Andorra, platos preparados Cap del Carrer"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado en bandeja, gratinados y platos preparados para llevar en Cap del Carrer, 16 (Andorra la Vella). Lunes cerrado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Pollo asado con patatas, tomate y cebolla en la bandeja de Can Tu Rostisseria"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2b2620"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-07"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Can Tu Rostisseria"
			subtitle="Rostisseria · Andorra la Vella"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma platos, precios y horario antes de ir."
			ctaLabel="Llamar a Can Tu Rostisseria"
			navAriaLabel="Enlaces de Can Tu Rostisseria"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
