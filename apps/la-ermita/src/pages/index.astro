---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import buffet from '../assets/fotos/la-ermita-apaisada-01.jpg';
import migas from '../assets/fotos/la-ermita-apaisada-03.jpg';
import guisoPatatas from '../assets/fotos/la-ermita-vertical-02.jpg';
import berenjenas from '../assets/fotos/la-ermita-vertical-05.jpg';
import potaje from '../assets/fotos/la-ermita-vertical-06.jpg';
import cartel from '../assets/fotos/la-ermita-vertical-08.jpg';
import fachada from '../assets/fotos/la-ermita-vertical-10.jpg';
import interior from '../assets/fotos/la-ermita-vista-4-04.jpg';
import tortilla from '../assets/fotos/la-ermita-vista-7-07.jpg';
import menestra from '../assets/fotos/la-ermita-vista-9-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'La Ermita · Comida casera para llevar en San Ginés, Murcia';
const description =
	'La Ermita, Camino de la Ermita (30169 San Ginés, Murcia). Comida casera en bandejas: arroces, croquetas de cocido, potaje, migas y tortilla. De lunes a viernes, de 8:00 a 15:30.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada amarilla de La Ermita en el Camino de la Ermita, con el rótulo y la placa del Carril Saavedra',
	},
	{
		src: buffet,
		alt: 'El mostrador de bandejas de La Ermita, con los guisos, el cartel de la tapa sellada y una paella en la pared',
	},
	{
		src: migas,
		alt: 'Cazuela de barro con migas y tropezones de carne, con la cuchara de servir',
	},
	{
		src: tortilla,
		alt: 'Tortilla de patatas en la bandeja metálica, cortada en porciones',
	},
	{
		src: berenjenas,
		alt: 'Berenjenas gratinadas cubiertas de queso fundido y dorado',
	},
	{
		src: potaje,
		alt: 'Cazo blanco con potaje de garbanzos, acelgas y huevo picado',
	},
	{
		src: guisoPatatas,
		alt: 'Bandeja de guiso de patatas en salsa de tomate y pimiento, recién hecha',
	},
	{
		src: menestra,
		alt: 'Menestra de judía verde, guisante y champiñón con huevo picado',
	},
	{
		src: interior,
		alt: 'El interior de La Ermita, con la estantería de cajas de madera, el extintor y el carro del pan',
	},
	{
		src: cartel,
		alt: 'El cartel de la puerta con el horario: lunes a viernes de 8:00 a 15:30',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que se sirve en La Ermita',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-ermita`,
	name: BUSINESS.name,
	alternateName: ['La Ermita San Ginés', 'La Ermita Murcia', 'Comidas La Ermita'],
	description:
		'Comida casera para llevar en el Camino de la Ermita (30169 San Ginés, Murcia): arroces, croquetas de cocido, potaje de garbanzos, migas, berenjenas gratinadas y tortilla.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34621206507',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Comida para llevar', 'Guisos', 'Arroces'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Murcia' },
		{ '@type': 'AdministrativeArea', name: 'Región de Murcia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:00',
			closes: '15:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#4a3428" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;700&family=Spectral:ital,wght@0,400..700;1,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Ermita San Ginés, comida casera para llevar Murcia, comida por bandejas San Ginés, croquetas de cocido, potaje de garbanzos, migas murcianas, Camino de la Ermita"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera en bandejas para llevar en el Camino de la Ermita (San Ginés, Murcia): arroces, croquetas de cocido, potaje, migas y tortilla. De lunes a viernes."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="El mostrador de bandejas de La Ermita, con los guisos del día listos para llevar"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#4a3428"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[buffet]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Ermita"
			subtitle="Comida para llevar · San Ginés"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Camino de la Ermita · San Ginés (Murcia)"
				title="Comida de casa, <br /><em>servida en bandejas.</em>"
				lede={`La Ermita es la casa de comidas del Camino de la Ermita, en San Ginés: un mostrador corrido de bandejas donde se elige el guiso del día y se va en táper. Potaje de garbanzos, arroces, migas, berenjenas gratinadas y tortilla de patatas. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas y abre de lunes a viernes, de 8:00 a 15:30.`}
				image={buffet}
				imageAlt="El mostrador de bandejas de La Ermita, con los guisos del día y los tápers apilados debajo"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>8:00–15:30</b> · lunes a viernes' },
					{ label: 'Servicio', html: '<b>Para llevar</b> · por bandejas' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Comida casera"
			/>

			<LocalChips label="Lo que ofrece La Ermita" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Camino de la Ermita. <br /><em>El mostrador y las bandejas.</em>"
				paragraphs={[
					'La Ermita está en el Camino de la Ermita, s/n, en la pedanía de San Ginés, Murcia. La ficha de Google sitúa el local en las coordenadas 37.9584484, -1.179648. La fachada es amarilla, con el rótulo del local y un cartel bajo el toldo; enfrente, la placa del Carril Saavedra que aparece en una de las fotos del perfil.',
					'Dentro hay un mostrador corrido de acero y bandejas con los guisos del día, un cartel que recuerda que «la tapa se sella, cierra con seguridad» y, debajo, los tápers y tapas apilados para servir. Al fondo, una estantería hecha con cajas de madera, un extintor rojo y un carro con el pan. No hay mesas: se entra, se elige y se sale con la bolsa.',
					'En las fotos del perfil se reconocen los platos de siempre: una cazuela de barro con migas y tropezones de carne, la tortilla de patatas en su bandeja, berenjenas gratinadas con queso fundido, un potaje de garbanzos con acelgas y huevo, un guiso de patatas en salsa de tomate y una menestra de judía verde con huevo picado. Y en la pared, la paella del cartel del local.',
					`Las reseñas lo confirman: «comida casera sabrosa, variada, higiene excepcional, trato inmejorable» y «todo buenísimo, raciones generosas, todo muy limpio y muy económico». Con ${RATING.count} opiniones, la media es de ${RATING.label} sobre 5 (noviembre de 2026). Se atiende en el ${BUSINESS.phone}.`,
				]}
				note="La ficha no publica carta ni precios. Lo que aparece en esta página es lo que citan las reseñas y lo que se reconoce en las fotos del perfil; como el menú cambia cada día, confirma qué hay y cuánto cuesta por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> De la olla a la bandeja</p>
					<h2 id="highlights-title">Casero, variado <br /><em>y sin florituras.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La comida"
				title="Lo que se ve <br /><em>en las bandejas.</em>"
				description="Sin carta publicada: esta lista reúne lo que citan las reseñas de la ficha (arroces, croquetas de cocido, raciones generosas) y los platos que se reconocen en las fotos del perfil."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note={`El menú cambia cada día, así que ni la ficha ni esta página pueden darte la lista completa. Llama al ${BUSINESS.phone} para saber qué hay y cuánto cuesta la bandeja.`}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La fachada, las bandejas <br /><em>y el horario.</em>"
				description="Diez fotografías del perfil de La Ermita: la fachada con el rótulo, el mostrador de bandejas, las migas en cazuela de barro, la tortilla, las berenjenas gratinadas, el potaje de garbanzos, el guiso de patatas, la menestra, el interior con la estantería de cajas y el cartel con el horario."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,5 sobre 5, <em>con 105 reseñas.</em></h2>
						<p>
							Google publica una media de 4,5 con 105 opiniones (noviembre de 2026). Las reseñas
							que se ven insisten en tres cosas: la comida casera y variada, la limpieza y el
							precio.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span>
											<small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,5</strong>
						<span>★★★★☆</span>
						<small>105 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En San Ginés, <br /><em>camino de la Ermita.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google y confirmado por el cartel de la puerta: lunes a viernes de 8:00 a 15:30, sábado y domingo cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de La Ermita en el Camino de la Ermita, San Ginés, Murcia"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Camino de la Ermita · San Ginés"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Los pedidos se hacen por teléfono o en el mostrador: la ficha no enlaza una web del local ni un sistema de pedidos online, y tampoco anuncia reparto a domicilio. Para bandejas grandes o para un grupo, avisa con tiempo."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>ir a por la comida.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="La Ermita"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district} (${BUSINESS.city})`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. El menú cambia cada día: confirma platos y precios antes de ir."
			ctaLabel="Llamar a La Ermita"
			navAriaLabel="Enlaces de La Ermita"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
