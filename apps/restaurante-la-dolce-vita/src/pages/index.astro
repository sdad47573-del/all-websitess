---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import heroImage from '../assets/fotos/restaurante-la-dolce-vita-apaisada-08.jpg';
import vitrina from '../assets/fotos/restaurante-la-dolce-vita-apaisada-01.jpg';
import mesa from '../assets/fotos/restaurante-la-dolce-vita-apaisada-07.jpg';
import vegetal from '../assets/fotos/restaurante-la-dolce-vita-panoramica-02.jpg';
import bacon from '../assets/fotos/restaurante-la-dolce-vita-vertical-09.jpg';
import suppliCesta from '../assets/fotos/restaurante-la-dolce-vita-vertical-10.jpg';
import suppliPlato from '../assets/fotos/restaurante-la-dolce-vita-vertical-06.jpg';
import tiramisu from '../assets/fotos/restaurante-la-dolce-vita-cuadrada-03.jpg';
import fachadaNoche from '../assets/fotos/restaurante-la-dolce-vita-apaisada-04.jpg';
import fachadaDia from '../assets/fotos/restaurante-la-dolce-vita-vista-5-05.jpg';

const business = {
	name: 'Restaurante La Dolce Vita',
	brand: 'La Dolce Vita',
	tagline: 'Pinseria romana en Castellón de la Plana',
	street: "Plaça Vilanova d'Alcolea, 6",
	city: 'Castellón de la Plana',
	region: 'Comunitat Valenciana',
	postalCode: '12006',
	phone: '964 17 99 46',
	latitude: 39.9758499,
	longitude: -0.0478192,
	rating: 4.7,
	reviewsCount: 570,
	site: 'https://restaurante-la-dolce-vita.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd6001e0a5a3b2bb:0x4ab1ed5e0ac358f4';
const cidDecimal = '5382344017847736564';
const placeId = 'ChIJu7KjpeABYA0R9FjDCl7tsUo';

const mapsUrl =
	"https://www.google.com/maps/place/Restaurante+La+Dolce+Vita/@39.9758499,-0.0478192,17z/data=!3m1!4b1!4m6!3m5!1s0xd6001e0a5a3b2bb:0x4ab1ed5e0ac358f4!8m2!3d39.9758499!4d-0.0478192!16s%2Fg%2F11fflsrvv5?authuser=0&hl=es&entry=ttu";
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&q=Restaurante+La+Dolce+Vita&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34964179946';

const description =
	"Pinseria romana en la Plaça Vilanova d'Alcolea, 6, Castellón de la Plana: pinsas de masa madre fermentadas 48-72 horas, supplì de arroz y tiramisú casero.";

const servicios = [
	'Pinseria romana',
	'Pinsas artesanales',
	'Masa de alta fermentación (48-72 h)',
	'Ingredientes traídos de Italia',
	'Harinas de arroz, soja y trigo',
	'Supplì de arroz',
	'Tiramisú en tarro',
	'Cenas desde las 18:00',
	'Mediodías de viernes a domingo',
	"Plaça Vilanova d'Alcolea",
];

const grupos = [
	{
		title: 'Pinsas romanas',
		items: [
			{
				name: 'Margherita',
				note: 'tomate, mozzarella y albahaca, la base de todas las demás',
			},
			{
				name: 'Carbonara',
				note: 'la que citan las reseñas de Google, con huevo y pimienta',
			},
			{
				name: 'Jamón cocido y champiñones',
				note: 'una de las que más sale de la vitrina',
			},
			{
				name: 'Jamón y alcachofas',
				note: 'la otra que recomiendan los clientes en sus opiniones',
			},
			{
				name: 'Bacon y cebolla',
				note: 'con queso fundido y un buen rallado por encima',
			},
			{
				name: 'Pepperoni',
				note: 'picante suave, recién horneada',
			},
			{
				name: 'Vegetal',
				note: 'calabacín, berenjena y pimiento asado con mozzarella',
			},
			{
				name: 'La del día',
				note: 'la que salga de la vitrina; se pregunta en la barra',
			},
		],
	},
	{
		title: 'Para picar',
		items: [
			{
				name: 'Supplì de arroz',
				note: 'la croqueta de arroz romana, crujiente por fuera y servida al momento',
			},
		],
	},
	{
		title: 'Dolci y bebidas',
		items: [
			{
				name: 'Tiramisú',
				note: 'en tarro de cristal, con cacao por encima',
			},
			{
				name: 'Cerveza',
				note: 'de barril o de botella, también sin gluten y sin alcohol',
			},
			{
				name: 'Refrescos y agua',
				note: 'Coca-Cola, Fanta de limón o naranja y agua mineral',
			},
			{
				name: 'Café',
				note: 'para cerrar la pinsa al estilo italiano',
			},
		],
	},
];

const galeria = [
	{
		src: vitrina,
		alt: 'Vitrina de pinsas romanas recién horneadas en Restaurante La Dolce Vita, Castellón de la Plana',
	},
	{
		src: mesa,
		alt: 'Mesa con varias pinsas romanas, cervezas y refrescos en La Dolce Vita, Castellón',
	},
	{
		src: vegetal,
		alt: 'Pinsa vegetal con calabacín, berenjena y pimiento asado de La Dolce Vita, Castellón',
	},
	{
		src: bacon,
		alt: 'Detalle de una pinsa con bacon y queso recién rallado en La Dolce Vita, Castellón',
	},
	{
		src: suppliCesta,
		alt: 'Supplì de arroz en cestillo de mimbre en La Dolce Vita, Castellón',
	},
	{
		src: suppliPlato,
		alt: 'Supplì de arroz servido en plato blanco en Restaurante La Dolce Vita, Castellón',
	},
	{
		src: tiramisu,
		alt: 'Tiramisú en tarro de cristal de La Dolce Vita, Castellón de la Plana',
	},
	{
		src: fachadaNoche,
		alt: 'Fachada de La Dolce Vita de noche con el rótulo Autentica Pinseria Romana, Castellón',
	},
	{
		src: fachadaDia,
		alt: 'Entrada de La Dolce Vita con la bandera italiana y el rótulo de pinseria romana, Castellón',
	},
];

const faqs = [
	{
		q: '¿Dónde está Restaurante La Dolce Vita?',
		a: "En la Plaça Vilanova d'Alcolea, 6, 12006 Castellón de la Plana. Desde esta página puedes abrir Google Maps y trazar la ruta con el botón «Cómo llegar».",
	},
	{
		q: '¿Qué es una pinsa romana?',
		a: 'Una masa alargada de alta fermentación, entre 48 y 72 horas, que la propia casa describe con un 80 % de agua y harinas certificadas de arroz, soja y trigo con masa madre, sin grasas saturadas. El resultado es una base ligera, con los bordes crujientes y el centro tierno, muy distinta de una pizza al uso.',
	},
	{
		q: '¿Cuál es el horario de La Dolce Vita?',
		a: 'Abre los martes, miércoles y jueves solo por la noche, de 18:00 a 24:00. Los viernes suma el mediodía de 12:00 a 16:00 y vuelve a abrir de 18:00 a 24:00. Sábados y domingos sirve de 12:00 a 17:00 y de 19:00 a 24:00. Los lunes cierra.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'No hay reserva online ni formulario en esta web: se reserva llamando al 964 17 99 46. En fin de semana y en las noches de más ambiente conviene llamar con antelación, porque el local es pequeño.',
	},
	{
		q: '¿Hay pinsas vegetarianas?',
		a: 'Sí. En la vitrina hay pinsas sin carne, como la vegetal de calabacín, berenjena y pimiento asado, además de la margherita. Si sigues una dieta concreta o tienes alguna alergia, coméntalo al pedir para confirmar ingredientes y harinas.',
	},
	{
		q: '¿De dónde vienen los ingredientes?',
		a: 'La ficha del restaurante explica que los ingredientes son auténticos y se traen directamente de Italia, y que las harinas son certificadas y no modificadas genéticamente. La masa se prepara según la receta tradicional de la pinsa romana.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['La Dolce Vita', 'La Dolce Vita Castellón', 'Pinseria La Dolce Vita'],
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 964 17 99 46',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Pinseria', 'Cocina romana', 'Italiana', 'Pizza'],
	areaServed: [
		{ '@type': 'City', name: 'Castellón de la Plana' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday'],
			opens: '18:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Friday',
			opens: '12:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday', 'Sunday'],
			opens: '18:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '12:00',
			closes: '17:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Pinsas', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-la-dolce-vita-apaisada-08.jpg": heroImage,
	"restaurante-la-dolce-vita-apaisada-01.jpg": vitrina,
	"restaurante-la-dolce-vita-apaisada-07.jpg": mesa,
	"restaurante-la-dolce-vita-panoramica-02.jpg": vegetal,
	"restaurante-la-dolce-vita-vertical-09.jpg": bacon,
	"restaurante-la-dolce-vita-vertical-10.jpg": suppliCesta,
	"restaurante-la-dolce-vita-vertical-06.jpg": suppliPlato,
	"restaurante-la-dolce-vita-cuadrada-03.jpg": tiramisu,
	"restaurante-la-dolce-vita-apaisada-04.jpg": fachadaNoche,
	"restaurante-la-dolce-vita-vista-5-05.jpg": fachadaDia,
};

const horas = [
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: '18:00 – 24:00' },
					{ day: 'Miércoles', value: '18:00 – 24:00' },
					{ day: 'Jueves', value: '18:00 – 24:00' },
					{ day: 'Viernes', value: '12:00 – 16:00 · 18:00 – 24:00' },
					{ day: 'Sábado', value: '12:00 – 17:00 · 19:00 – 24:00' },
					{ day: 'Domingo', value: '12:00 – 17:00 · 19:00 – 24:00' },
				];
const mapasPagina = {
	place: cidUrl,
	directions: cidUrl,
	streetView: cidUrl,
	embed: mapEmbedUrl,
};---

<!doctype html>
<html lang="es">
	<head>
		<title>La Dolce Vita · Pinseria romana en Castellón</title>
		<meta name="theme-color" content="#7c2f22" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,600;0,6..96,700;1,6..96,400;1,6..96,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="La Dolce Vita Castellón, pinseria Castellón, pinsa romana Castellón, pinsa Castelló de la Plana, restaurante italiano Castellón, pizzería romana Castellón, Plaça Vilanova d'Alcolea, supplì Castellón, tiramisú Castellón, comer pinsa Castellón, cocina romana Castellón"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="La Dolce Vita · Pinseria romana en Castellón"
			ogDescription="Pinsas de masa madre fermentadas 48-72 horas, supplì de arroz y tiramisú en la Plaça Vilanova d'Alcolea, 6. 4,7 en Google con 570 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Pinsa romana con jamón y queso recién rallado de La Dolce Vita, Castellón"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#7c2f22"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Castellón de la Plana, Castellón"
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="DV"
			name={business.brand}
			subtitle="Pinseria romana · Castellón"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: business.name,
					street: business.street,
					district: business.district ?? '',
					postalCode: business.postalCode,
					city: business.city,
				}}
								horario={horas}
								mapas={mapasPagina}
			/>
		</main>

		<LocalFooter
			mark="DV"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a La Dolce Vita"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34964179946?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Restaurante%20la%20dolce%20vita." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Restaurante la dolce vita"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
