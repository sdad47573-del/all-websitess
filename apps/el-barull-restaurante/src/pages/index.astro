---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/el-barull-restaurante-apaisada-06.jpg';
import barra from '../assets/fotos/el-barull-restaurante-panoramica-09.jpg';
import fachada from '../assets/fotos/el-barull-restaurante-apaisada-01.jpg';
import arroz from '../assets/fotos/el-barull-restaurante-apaisada-10.jpg';
import bocadilloLonganiza from '../assets/fotos/el-barull-restaurante-vertical-04.jpg';
import bocadilloCarne from '../assets/fotos/el-barull-restaurante-vertical-02.jpg';
import brasa from '../assets/fotos/el-barull-restaurante-vertical-05.jpg';
import chuleta from '../assets/fotos/el-barull-restaurante-vertical-07.jpg';
import carajillo from '../assets/fotos/el-barull-restaurante-vertical-03.jpg';
import corte from '../assets/fotos/el-barull-restaurante-vertical-08.jpg';

const business = {
	name: 'El Barull restaurante',
	brand: 'El Barull',
	tagline: 'Almuerzos y brasa en Castellón',
	street: 'Av. Diputació, 10',
	city: 'Castellón de la Plana',
	region: 'Comunitat Valenciana',
	postalCode: '12004',
	phone: '964 24 26 78',
	latitude: 40.0010648,
	longitude: -0.0461681,
	rating: 4.5,
	reviewsCount: 1232,
	site: 'https://el-barull-restaurante.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd5ffe37f9ddb46f:0x40e81b06fcd7bea1';
const cidDecimal = '4677017929850011297';
const placeId = 'ChIJb7Td-Tf-Xw0Rob7X_AYb6EA';

const mapsUrl =
	'https://www.google.com/maps/place/El+Barull+restaurante/@40.0010648,-0.0461681,17z/data=!3m1!4b1!4m6!3m5!1s0xd5ffe37f9ddb46f:0x40e81b06fcd7bea1!8m2!3d40.0010648!4d-0.0461681!16s%2Fg%2F1tcwy1fv?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&q=El+Barull+restaurante&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34964242678';

const description =
	'Bar restaurante de almuerzos y brasa en la Av. Diputació, 10, Castellón: bocadillos de longaniza, carnes a la brasa, pulpo y arroces. Abre de 6:00 a 17:00.';

const servicios = [
	'Almuerzos',
	'Bocadillos a la brasa',
	'Carnes a la brasa',
	'Longaniza y chorizo',
	'Pulpo',
	'Arroces',
	'Pimientos de padrón',
	'Ensaladas',
	'Carajillo',
	'Cocina mediterránea',
	'Barra con vitrina',
	'Aparcamiento en la puerta',
];

const grupos = [
	{
		title: 'Los almuerzos',
		items: [
			{
				name: 'Bocadillo de longaniza',
				note: 'longaniza a la brasa con pimientos y tomate rallado',
			},
			{
				name: 'Bocadillo de carne a la brasa',
				note: 'con pimientos verdes y un chorro de aceite',
			},
			{
				name: 'El almuerzo completo',
				note: 'bocadillo, bebida y lo que hay en la mesa: cacahuetes, patatas y olivas',
			},
		],
	},
	{
		title: 'De la brasa',
		items: [
			{
				name: 'Chuleta de cerdo con patatas',
				note: 'a la parrilla, con patatas fritas de corte grueso',
			},
			{
				name: 'Longaniza, chorizo y morcilla',
				note: 'a la brasa, servidos juntos en la misma fuente',
			},
			{
				name: 'Pimientos de padrón',
				note: 'con sal gorda, para acompañar la carne',
			},
		],
	},
	{
		title: 'Del mar y la huerta',
		items: [
			{
				name: 'Pulpo a la brasa',
				note: 'con su salsa, aceite y pimentón; se sirve entero en el plato',
			},
			{
				name: 'Arroz con judías y costillas',
				note: 'de interior, con judía verde y un trozo de limón',
			},
			{
				name: 'Ensalada de tomate y cebolla',
				note: 'con aceite de oliva y sal, de las que se piden para compartir',
			},
		],
	},
	{
		title: 'Para terminar',
		items: [
			{
				name: 'Carajillo',
				note: 'con la espuma de siempre, el café de después del almuerzo',
			},
			{
				name: 'Café',
				note: 'de máquina, en vaso o en taza',
			},
		],
	},
];

const galeria = [
	{
		src: barra,
		alt: 'Barra de El Barull con la vitrina de tapas y la brasa al fondo, Castellón',
	},
	{
		src: fachada,
		alt: 'Fachada de Asador Restaurante El Barull con el cartel y el teléfono, Castellón',
	},
	{
		src: arroz,
		alt: 'Arroz con judías verdes y costillas de El Barull, Castellón de la Plana',
	},
	{
		src: bocadilloLonganiza,
		alt: 'Bocadillo de longaniza a la brasa con pimientos y tomate en El Barull, Castellón',
	},
	{
		src: bocadilloCarne,
		alt: 'Bocadillo de carne a la brasa con cacahuetes y patatas en El Barull, Castellón',
	},
	{
		src: brasa,
		alt: 'Fuente de longaniza, chorizo y morcilla a la brasa con pimientos de padrón en El Barull',
	},
	{
		src: chuleta,
		alt: 'Chuleta de cerdo a la brasa con patatas fritas en El Barull, Castellón',
	},
	{
		src: carajillo,
		alt: 'Carajillo en vaso de cristal servido en El Barull, Castellón',
	},
	{
		src: corte,
		alt: 'Bocadillo de longaniza abierto con la brasa de El Barull al fondo, Castellón',
	},
];

const faqs = [
	{
		q: '¿Dónde está El Barull?',
		a: 'En la Avenida Diputació, 10, 12004 Castellón de la Plana, en una nave con aparcamiento en la misma puerta y cartel de Asador Restaurante. Desde esta página puedes abrir Google Maps y trazar la ruta con el botón «Cómo llegar».',
	},
	{
		q: '¿A qué hora se puede almorzar?',
		a: 'El Barull abre a las 6:00 de la mañana de lunes a viernes y sirve hasta las 17:00; los sábados abre a las 6:00 y cierra a las 13:00, y los domingos no abre. Es el horario de la ficha de Google, así que en festivos conviene confirmarlo por teléfono.',
	},
	{
		q: '¿Qué es un almuerzo de Castellón?',
		a: 'El almuerzo es la comida de media mañana: un bocadillo a la brasa con bebida y algo para picar. En El Barull lo sirven desde primera hora, con longaniza, chorizo, morcilla o carne a la parrilla dentro del pan, y las reseñas lo destacan como «buen sitio para almorzar» y «económico».',
	},
	{
		q: '¿Hay carnes a la brasa?',
		a: 'Sí, es la especialidad de la casa. La brasa está a la vista y por ella pasan la longaniza, el chorizo, la morcilla, la chuleta de cerdo y la carne de los bocadillos, que se sirven con pimientos de padrón o patatas.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'No hay reserva online ni formulario en esta web: se reserva llamando al 964 24 26 78. Para el almuerzo de entre semana suele haber sitio, pero en fines de semana y para grupos conviene llamar antes.',
	},
	{
		q: '¿Se puede comer, además de almorzar?',
		a: 'La ficha de Google lo clasifica como restaurante y restaurante mediterráneo, y sus fotos incluyen pulpo, arroces y carnes, así que también se puede comer. La carta del día y lo que hay fuera de la brasa se confirman llamando al 964 24 26 78.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['El Barull', 'Asador Restaurante El Barull', 'El Barull Castellón'],
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 964 24 26 78',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Cocina mediterránea', 'Brasa', 'Almuerzos', 'Cocina valenciana'],
	areaServed: [
		{ '@type': 'City', name: 'Castellón de la Plana' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '06:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '06:00',
			closes: '13:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>El Barull · Almuerzos y brasa en Castellón</title>
		<meta name="theme-color" content="#2b2320" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500;1,600&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="El Barull Castellón, El Barull restaurante, asador El Barull, almuerzos Castellón, bocadillos a la brasa Castellón, carne a la brasa Castellón, restaurante Av. Diputació 10, carajillo Castellón, almuerzo castellonense, restaurante mediterráneo Castellón"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="El Barull · Almuerzos y brasa en Castellón"
			ogDescription="Bocadillos de longaniza, carnes a la brasa, pulpo y arroces en la Av. Diputació, 10. Abre a las 6:00 para el almuerzo. 4,5 en Google con 1.232 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Pulpo a la brasa con su salsa servido en El Barull, Castellón"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#2b2320"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Castellón de la Plana, Castellón"
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="EB"
			name={business.brand}
			subtitle="Asador · Av. Diputació, Castellón"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. Diputació, 10 · Castellón"
				title="Almuerzos<br />y brasa<br /><em>desde las 6:00.</em>"
				lede="El Barull es el asador restaurante de la Avenida Diputació, 10, en Castellón. Abre a las 6:00 para el almuerzo: bocadillos de longaniza, chorizo o carne a la brasa, con pimientos y una cerveza. A mediodía, pulpo, arroces y carnes a la parrilla, servidos sin prisa."
				image={heroImage}
				imageAlt="Pulpo a la brasa con su salsa en un plato de El Barull, Castellón"
				primaryCta={{ label: 'Llamar 964 24 26 78', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5</b> en Google (1.232 reseñas)' },
					{ label: 'Almuerzos', html: 'Desde las 6:00' },
					{ label: 'Cocina', html: 'Brasa y mediterránea' },
					{ label: 'Cierre', html: 'Domingos, cerrado' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece El Barull" items={servicios} />

			<LocalAbout
				label="Asador y almuerzos en Castellón"
				title="La brasa,<br />el bocadillo<br /><em>y la barra.</em>"
				paragraphs={[
					'El Barull está en la Avenida Diputació, 10, en una nave de Castellón con el cartel de Asador Restaurante y aparcamiento en la misma puerta. Abre a las 6:00 de la mañana, cuando en Castellón se almuerza: un bocadillo caliente, una bebida y un rato de barra antes de seguir el día.',
					'La brasa está a la vista. Por ella pasan la longaniza, el chorizo, la morcilla y la carne que va dentro del pan, con pimientos verdes y tomate rallado. También la chuleta de cerdo, que sale con patatas fritas de corte grueso, y los pimientos de padrón para acompañar.',
					'A la hora de comer, la cocina se abre al mar y a la huerta: pulpo a la brasa con su salsa, arroces de interior como el de judías y costillas, y ensaladas de tomate y cebolla. Se termina con un carajillo, que en esta casa se sirve en vaso y con la espuma bien hecha.',
				]}
				note="La ficha de Google reúne 1.232 opiniones con una nota media de 4,5. Las reseñas hablan de «buen sitio para almorzar», del trato de las camareras, de almuerzos «impresionantes» y económicos, y de la brasa para los aficionados a la carne."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="De la brasa<br /><em>al carajillo.</em>"
				description="Selección hecha con lo que aparece en las fotos de la ficha de Google y con los platos que citan los clientes: bocadillos de longaniza y de carne, longaniza, chorizo y morcilla, chuleta con patatas, pulpo, arroz con judías y carajillo."
				cta={{ label: 'Llamar al bar', href: phoneHref }}
				groups={grupos}
				note="Esta web no publica precios: no hay carta oficial publicada y los importes cambian con el mercado. El almuerzo del día, las carnes disponibles y el precio se confirman en la barra o por teléfono."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Brasa, bocadillos<br /><em>y barra.</em>"
				description="Estas fotografías proceden del perfil de El Barull en Google Maps: la barra con la vitrina y la brasa al fondo, la fachada con el cartel del asador, el arroz con judías y costillas, el bocadillo de longaniza, el de carne, la fuente de longaniza y chorizo, la chuleta con patatas, el carajillo y el corte del bocadillo."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Av. Diputació, 10 · 12004 Castellón"
				title="Nos vemos<br /><em>en El Barull.</em>"
				addressLines={[
					business.street,
					`${business.postalCode} ${business.city}`,
					'Castellón, España',
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: '6:00 – 17:00' },
					{ day: 'Martes', value: '6:00 – 17:00' },
					{ day: 'Miércoles', value: '6:00 – 17:00' },
					{ day: 'Jueves', value: '6:00 – 17:00' },
					{ day: 'Viernes', value: '6:00 – 17:00' },
					{ day: 'Sábado', value: '6:00 – 13:00' },
					{ day: 'Domingo', value: 'Cerrado', closed: true },
				]}
				hoursNote="Horario publicado en la ficha de Google: de 6:00 a 17:00 de lunes a viernes, sábados de 6:00 a 13:00 y domingos cerrado. En festivos y en verano puede cambiar, así que llama al 964 24 26 78 antes de ir."
				mapTitle="Mapa de El Barull en la Avenida Diputació, 10, Castellón"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="El Barull · Castellón de la Plana"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Las reservas se hacen por teléfono, en el 964 24 26 78: no hay reserva online ni formulario en esta web. Para el almuerzo de entre semana no suele hacer falta, pero en fin de semana y para grupos conviene llamar antes. Si alguien tiene alguna alergia, avisad al pedir."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="EB"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a El Barull"
		/>
	</body>
</html>
