---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/restaurant-l-horta-apaisada-01.jpg';
import comedor from '../assets/fotos/restaurant-l-horta-apaisada-05.jpg';
import pizzasMesa from '../assets/fotos/restaurant-l-horta-apaisada-03.jpg';
import arroz from '../assets/fotos/restaurant-l-horta-apaisada-06.jpg';
import croquetas from '../assets/fotos/restaurant-l-horta-apaisada-08.jpg';
import patata from '../assets/fotos/restaurant-l-horta-apaisada-10.jpg';
import embutido from '../assets/fotos/restaurant-l-horta-apaisada-02.jpg';
import pizzaCalabaza from '../assets/fotos/restaurant-l-horta-vista-9-09.jpg';
import pizzaPollo from '../assets/fotos/restaurant-l-horta-vertical-04.jpg';

const business = {
	name: "Restaurant L'Horta, Cuina Conscient",
	brand: "L'Horta",
	street: 'Carrer de Miquel V Arnau Abad, 6',
	city: "La Vall d'Uixó",
	region: 'Castelló',
	postalCode: '12600',
	phone: '964 69 79 18',
	latitude: 39.8209844,
	longitude: -0.2290967,
	rating: 4.6,
	reviewsCount: 1150,
	site: 'https://restaurant-l-horta.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd600dcd6be50d07:0xdfaa311805aba7b2';
const cidDecimal = '16116748195742853042';
const placeId = 'ChIJBw3la80NYA0RsqerBRgxqt8';

const mapsUrl =
	'https://www.google.com/maps/place/Restaurant+L%27Horta,+Cuina+Conscient/@39.8209844,-0.2290967,17z/data=!3m1!4b1!4m6!3m5!1s0xd600dcd6be50d07:0xdfaa311805aba7b2!8m2!3d39.8209844!4d-0.2290967!16s%2Fg%2F11h77qcpy1?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34964697918';
const instagramUrl = 'https://www.instagram.com/lhortacuinaconscient/';
const facebookUrl = 'https://www.facebook.com/lhortacuinaconscient/';

const description =
	"Restaurant L'Horta, Cuina Conscient, en La Vall d'Uixó: cocina mediterránea de temporada, pizzas al horno y menú laboral al mediodía. Comidas todos los días y cenas viernes, sábado y domingo.";

const servicios = [
	'Cocina mediterránea',
	'Pizzería',
	'Menú laboral',
	'Producto de temporada',
	'Opciones vegetarianas',
	'Sin gluten',
	'Eventos y celebraciones',
	'Acceso adaptado',
	'Reservas por teléfono',
];

const grupos = [
	{
		title: 'Pizzas al horno',
		items: [
			{
				name: 'Pizza de calabaza y bacon',
				note: 'calabaza asada, bacon crujiente y queso curado sobre masa fina, recién salida del horno',
			},
			{
				name: 'Pizza de pollo y verduras',
				note: 'con calabacín, berenjena, cebolla, pimiento y aceitunas negras',
			},
			{
				name: 'Pizza de Nutella',
				note: 'de postre, la que cita una reseña: «la pizza de Nutella y la tarta de queso geniales»',
			},
		],
	},
	{
		title: 'Arroces y cuchara',
		items: [
			{
				name: 'Arroz con costilla y langostinos',
				note: 'en paella, con costilla de cerdo desmenuzada y langostinos pelados',
			},
			{
				name: 'Croquetas gratinadas',
				note: 'en salsa de tomate y gratinadas con queso, de las que la reseña llama «buenísimas»',
			},
		],
	},
	{
		title: 'Para compartir',
		items: [
			{
				name: 'Patata con jamón y huevo',
				note: 'patata en rodajas con jamón, huevo poché y una salsa cremosa por encima',
			},
			{
				name: 'Embutido con patata y encurtidos',
				note: 'tabla de embutido curado sobre patata, con granos de granada y piparras',
			},
		],
	},
];

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de Restaurant L\'Horta, Cuina Conscient, con celosías de madera y suelo claro',
	},
	{
		src: pizzasMesa,
		alt: 'Varias pizzas recién horneadas en la mesa de Restaurant L\'Horta, Cuina Conscient',
	},
	{
		src: arroz,
		alt: 'Arroz con costilla y langostinos en paella en Restaurant L\'Horta, Cuina Conscient',
	},
	{
		src: croquetas,
		alt: 'Croquetas gratinadas en salsa de tomate en Restaurant L\'Horta, Cuina Conscient',
	},
	{
		src: patata,
		alt: 'Patata con jamón, huevo poché y salsa cremosa en Restaurant L\'Horta, Cuina Conscient',
	},
	{
		src: embutido,
		alt: 'Embutido curado con patata, granada y piparras en Restaurant L\'Horta, Cuina Conscient',
	},
	{
		src: pizzaCalabaza,
		alt: 'Pizza de calabaza asada y bacon en Restaurant L\'Horta, Cuina Conscient',
	},
	{
		src: pizzaPollo,
		alt: 'Pizza de pollo y verduras en Restaurant L\'Horta, Cuina Conscient',
	},
];

const faqs = [
	{
		q: '¿Dónde está Restaurant L\'Horta?',
		a: "En el Carrer de Miquel V Arnau Abad, 6, 12600 La Vall d'Uixó (Castelló), en un bajo de esquina acristalado con toldos, en la zona de la avenida. La ficha de Google no marca aparcamiento propio, así que se aparca en la vía pública alrededor. El botón «Cómo llegar» abre la ruta exacta en Google Maps.",
	},
	{
		q: '¿Qué horario tiene?',
		a: 'Las comidas son todos los días de 13:30 a 16:00. Las cenas, solo viernes y sábado de 20:00 a 24:00 y domingo de 20:00 a 23:00. Entre semana por la noche cierra, y no hay servicio de desayunos ni meriendas.',
	},
	{
		q: '¿Qué es el menú laboral?',
		a: 'Es el menú de mediodía que el restaurante ofrece de lunes a viernes, pensado para la pausa del trabajo: en sus redes lo presentan como una forma de romper la rutina, con un entrante a elegir. La ficha de Google no publica ni el precio ni los platos de cada día, así que se consultan al reservar.',
	},
	{
		q: '¿Hacen pizza?',
		a: 'Sí, es su especialidad: la ficha los clasifica como pizzería y restaurante mediterráneo, y en sus fotos aparecen pizzas de masa fina con calabaza asada y bacon, pollo y verduras, y también la pizza de Nutella de postre. Una reseña lo resume: «muy buen restaurante, con pizzas muy variadas y excelente servicio».',
	},
	{
		q: '¿Hay opciones vegetarianas, veganas o sin gluten?',
		a: 'La ficha de Tripadvisor recoge opciones vegetarianas, veganas y sin gluten en este restaurante, y su cocina se basa en producto fresco de temporada. En la web no hay carta con alérgenos, así que conviene avisar al reservar o al llegar para que la cocina lo tenga en cuenta.',
	},
	{
		q: '¿Se puede reservar? ¿Y celebrar un evento?',
		a: 'No hay reserva online ni formulario en esta web: se reserva llamando al 964 69 79 18. La ficha de Google también lo clasifica como organizador de eventos, así que para comidas de grupo, celebraciones o empresa lo mejor es llamar con antelación y contar cuántos sois.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'La ficha de Google marca entrada, aseo y asientos adaptados para sillas de ruedas. No marca plaza de aparcamiento adaptada ni aparcamiento propio.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ["L'Horta", "L'Horta Cuina Conscient", 'Restaurante L\'Horta La Vall d\'Uixó'],
	slogan: 'Cuina conscient: cocina mediterránea y pizza en La Vall d\'Uixó',
	description,
	url: `${business.site}/`,
	telephone: '+34 964 69 79 18',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Mediterránea', 'Pizza', 'Italiana', 'Cocina saludable'],
	areaServed: [
		{ '@type': 'City', name: "La Vall d'Uixó" },
		{ '@type': 'AdministrativeArea', name: 'Plana Baixa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [instagramUrl, facebookUrl, cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '13:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '20:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '20:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La mesa', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>L'Horta, Cuina Conscient · Restaurante en La Vall d'Uixó</title>
		<meta name="theme-color" content="#2f5d43" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=Instrument+Serif:ital@0;1&family=Work+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Restaurant L'Horta, L'Horta Cuina Conscient, restaurante La Vall d'Uixó, pizzeria La Vall d'Uixó, pizza La Vall, cocina mediterránea, menú laboral La Vall d'Uixó, comer en La Vall d'Uixó, Plana Baixa, Castellón"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="L'Horta, Cuina Conscient · Restaurante en La Vall d'Uixó"
			ogDescription="Cocina mediterránea de temporada, pizzas al horno y menú laboral al mediodía en La Vall d'Uixó. 4,6 en Google con 1.150 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Fachada iluminada de Restaurant L'Horta, Cuina Conscient, en La Vall d'Uixó"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#2f5d43"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="La Vall d'Uixó, Castellón"
			contact={{
				street: business.street,
				locality: business.city,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[fachada]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="H"
			name={business.brand}
			subtitle="Cuina conscient · La Vall d'Uixó"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer de Miquel V Arnau Abad, 6 · La Vall d'Uixó"
				title="Cocina mediterránea<br /><em>con consciencia.</em>"
				lede="Restaurant L'Horta, Cuina Conscient, está en un bajo de esquina del Carrer de Miquel V Arnau Abad, en La Vall d'Uixó. Cocina mediterránea de temporada con la pizza como especialidad, menú laboral al mediodía y cenas los viernes, sábados y domingos."
				image={fachada}
				imageAlt="Fachada iluminada de Restaurant L'Horta, Cuina Conscient, en una esquina de La Vall d'Uixó"
				primaryCta={{ label: 'Llamar 964 69 79 18', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> en Google (1.150 reseñas)' },
					{ label: 'Comidas', html: '<b>13:30 – 16:00</b>' },
					{ label: 'Cenas', html: '<b>Viernes, sábado y domingo</b>' },
					{ label: 'Mediodía', html: '<b>Menú laboral</b>' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece L'Horta, Cuina Conscient" items={servicios} />

			<LocalAbout
				label="Cuina conscient en La Vall d'Uixó"
				title="Producto,<br />pizza y<br /><em>temporada.</em>"
				paragraphs={[
					'El restaurante ocupa un bajo de esquina acristalado, con toldos y el comedor a la vista desde la calle. Dentro, celosías de madera separan las mesas y el suelo es claro, con las lámparas encendidas: un espacio moderno, pensado para comidas largas y para grupos.',
					'En su ficha de Google se definen como restaurante de comida tradicional mediterránea especializado en pizza, con «producto fresco, de temporada, de autoproducción local y saludable». La misma ficha añade la parte de consciencia: políticas medioambientales, conciliación familiar y un comedor abierto a artistas locales.',
					'El servicio se reparte entre el mediodía y la noche: comidas todos los días de 13:30 a 16:00, con menú laboral de lunes a viernes, y cenas solo viernes, sábado y domingo. La ficha suma 1.150 opiniones con un 4,6, y las reseñas insisten en las pizzas, las croquetas y el trato del servicio.',
				]}
				note="«Croquetas buenísimas, y la pizza de Nutella y la tarta de queso geniales», dice una reseña. Otra añade: «muy buen restaurante, con pizzas muy variadas y excelente servicio»."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Instagram', href: instagramUrl, external: true },
					{ label: 'Facebook', href: facebookUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La mesa"
				title="Del horno<br />y de <em>la huerta.</em>"
				description="La ficha de Google no publica carta ni precios, así que esta selección sale de las fotos del propio restaurante y de lo que citan sus reseñas: pizzas, arroces, croquetas y platos para compartir."
				cta={{ label: 'Preguntar el menú de hoy', href: phoneHref }}
				groups={grupos}
				note="Esta web no publica precios: no hay carta ni menú con importes en la ficha de Google. El menú laboral de mediodía, los platos del día y las raciones se consultan en el restaurante o llamando al 964 69 79 18."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor,<br />la pizza<br /><em>y el arroz.</em>"
				description="Estas fotografías proceden del perfil de Restaurant L'Horta en Google Maps: la fachada, el comedor con las celosías, las pizzas recién horneadas, el arroz con costilla y langostinos, las croquetas gratinadas y los platos para compartir."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer de Miquel V Arnau Abad, 6 · 12600"
				title="Comer aquí,<br /><em>sin prisa.</em>"
				addressLines={[
					business.street,
					`${business.postalCode} ${business.city}`,
					'Castelló, España',
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: '13:30 – 16:00' },
					{ day: 'Martes', value: '13:30 – 16:00' },
					{ day: 'Miércoles', value: '13:30 – 16:00' },
					{ day: 'Jueves', value: '13:30 – 16:00' },
					{ day: 'Viernes', value: '13:30 – 16:00 · 20:00 – 24:00' },
					{ day: 'Sábado', value: '13:30 – 16:00 · 20:00 – 24:00' },
					{ day: 'Domingo', value: '13:30 – 16:00 · 20:00 – 23:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google: comidas todos los días de 13:30 a 16:00 y cenas solo viernes, sábado (hasta las 24:00) y domingo (hasta las 23:00). Entre semana por la noche cierra, y no hay desayunos ni meriendas."
				mapTitle="Mapa de Restaurant L'Horta, Cuina Conscient, en La Vall d'Uixó"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="L'Horta, Cuina Conscient · La Vall d'Uixó"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Las reservas se hacen por teléfono, llamando al 964 69 79 18: no hay reserva online ni formulario en esta web. Para el menú laboral de mediodía y para grupos o celebraciones conviene llamar con tiempo."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="H"
			name="Restaurant L'Horta, Cuina Conscient"
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Instagram ↗', href: instagramUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, platos y precios antes de la visita."
			ctaLabel="Llamar a L'Horta"
		/>
	</body>
</html>
