---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Alimentación Preparada El Dorado · Latina, Madrid';
const description = BUSINESS.description;

import fachada from '../assets/fotos/alimentacion-preparada-el-dorado-vista-1-01.jpg';
import vitrina from '../assets/fotos/alimentacion-preparada-el-dorado-apaisada-02.jpg';
import local from '../assets/fotos/alimentacion-preparada-el-dorado-apaisada-03.jpg';
import fachada2 from '../assets/fotos/alimentacion-preparada-el-dorado-apaisada-04.jpg';
import tortilla from '../assets/fotos/alimentacion-preparada-el-dorado-apaisada-06.jpg';
import tortilla2 from '../assets/fotos/alimentacion-preparada-el-dorado-apaisada-07.jpg';
import fritos from '../assets/fotos/alimentacion-preparada-el-dorado-apaisada-10.jpg';
import pollo from '../assets/fotos/alimentacion-preparada-el-dorado-vertical-09.jpg';
import fachada3 from '../assets/fotos/alimentacion-preparada-el-dorado-vertical-05.jpg';
import croquetas from '../assets/fotos/alimentacion-preparada-el-dorado-vertical-08.jpg';

const galeria: { src: ImageMetadata; alt: string }[] = [
	{
		src: fachada,
		alt: 'Fachada de Alimentación Preparada El Dorado, con su rótulo de platos preparados',
	},
	{ src: vitrina, alt: 'Mostrador del local con platos preparados en la vitrina' },
	{ src: local, alt: 'Fuentes de guisos y platos preparados en la vitrina' },
	{ src: fachada2, alt: 'Fachada del local con su rótulo de pollos asados' },
	{ src: tortilla, alt: 'Tortilla de patatas cortada en porciones' },
	{ src: tortilla2, alt: 'Tortilla de patatas entera en bandeja de aluminio' },
	{ src: fritos, alt: 'Filetes empanados y fritos en la vitrina' },
	{ src: pollo, alt: 'Pollo asado con salsa en un plato azul' },
	{ src: fachada3, alt: 'Fachada del local con su rótulo de platos preparados' },
	{ src: croquetas, alt: 'Bandejas de croquetas en la vitrina' },
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-dorado`,
	name: BUSINESS.name,
	alternateName: ['El Dorado Latina', 'Alimentación Preparada El Dorado'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phoneHref.replace('tel:', ''),
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida preparada', 'Pollo'],
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Comunidad de Madrid' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.locality,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: { '@type': 'GeoCoordinates', latitude: BUSINESS.geo.lat, longitude: BUSINESS.geo.lng },
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId }],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#123c36" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400..700;1,400..700&family=Mulish:ital,wght@0,400..700;1,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Dorado, comida preparada Latina, pollo asado Latina, platos preparados Madrid"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Platos preparados y pollo asado en C. de Oliva de Plasencia, 1, Latina (Madrid)."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tarjeta de Alimentación Preparada El Dorado sobre fondo verde"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#123c36"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Latina"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="GASTROCHEF"
			subtitle="Comida para llevar · Pinto"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. de las Naciones, 37, Loc · Pinto, Madrid"
				title="Comida para llevar <br /><em>en Pinto.</em>"
				lede={`GASTROCHEF es comida para llevar en Pinto. Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>Jue–dom</b> 9:30–16:30 · <b>Lun–mié</b> cerrado' },
					{ label: 'Servicio', html: '<b>Para llevar</b>' },
				]}
				image={fachada}
				imageAlt="Fachada de GASTROCHEF en la Av. de las Naciones, en Pinto"
				galleryHref={MAPS.place}
				photoCredit="Ficha de Google Maps"
				galleryLinkLabel="Ver en Google Maps"
				tag="Comida para llevar"
			/>

			<LocalChips label="Lo que ofrece GASTROCHEF" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Comida casera <br /><em>para llevar.</em>"
				paragraphs={[
					'GASTROCHEF está en la Av. de las Naciones, 37, Loc, en Pinto. Su ficha de Google Maps lo clasifica como restaurante de comida para llevar.',
					'Su ficha publica horario de jueves a domingo, de 9:30 a 16:30.',
				]}
				note="La ficha no publica página web, redes sociales, carta con precios ni reparto a domicilio. Para precios concretos y encargos, llama al 919 39 76 69."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El local <br /><em>y la cocina.</em>"
				description="Interior del local, vitrina de comida preparada y platos de la casa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Las fotos de la carta y de los platos de otros locales no se publican. Si tienes los derechos de alguna imagen y quieres retirarla, dilo y la eliminamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Pinto, <br /><em>Av. de las Naciones.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, BUSINESS.region]}
				hours={HORARIO.map((row) => ({
					day: row.dia,
					value: row.horas,
					closed: row.horas === 'Cerrado',
				}))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: jueves a domingo de 10:30 a 16:00, y de lunes a miércoles cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de GASTROCHEF en la Av. de las Naciones, 37, Pinto, Madrid"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Av. de las Naciones, 37"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="La ficha no publica reparto a domicilio, encargos ni pedidos online: se concreta todo por teléfono, en el 919 39 76 69. No da datos de accesibilidad, así que conviene llamar antes si necesitas algo concreto."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>ir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="GASTROCHEF"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma horario antes de la visita."
			ctaLabel="Llamar a GASTROCHEF"
			navAriaLabel="Enlaces de GASTROCHEF"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
