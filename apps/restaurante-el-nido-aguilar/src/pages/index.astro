---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import {
	business,
	directionsUrl,
	facebookUrl,
	faqSchema,
	faqs,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	specialties,
	tripadvisorUrl,
} from '../lib/business';

const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Restaurante El Nido | Carnes a la brasa en Aguilar de la Frontera';
const description =
	'Restaurante El Nido en Aguilar de la Frontera, Córdoba: carnes a la brasa, cocina casera y menú del día. Consulta y reserva por teléfono: 692 60 51 83.';
const keywords =
	'Restaurante El Nido Aguilar de la Frontera, restaurante Córdoba, carnes a la brasa Aguilar, cocina casera, menú del día Aguilar, Avenida Bernat Soria 17, reservar Restaurante El Nido';
const instagramPhotoPosts = [
	'DZiaTCzCuXN',
	'Dcd3VFNCwH-',
	'DZXsA4UiGpf',
	'DOndJEZgt2G',
	'DMs80utsJPt',
	'DMkpU6OiYMQ',
	'DL-ZCyHio04',
	'DLvTtfSsTnS',
	'DLM0k9CMUOL',
];
const galleryPhotos = instagramPhotoPosts.map((postId, index) => {
	const photoNumber = String(index + 1).padStart(2, '0');
	return {
		src: foto(`el-nido-${photoNumber}.jpg`),
		href: `https://www.instagram.com/p/${postId}/`,
		alt: `Foto ${index + 1} de Restaurante El Nido, Aguilar de la Frontera`,
	};
});
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#33251f" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Aguilar de la Frontera, Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración vectorial original de una llama para Restaurante El Nido; no es una fotografía del local" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante El Nido, inicio">
				<span class="brand-mark" aria-hidden="true">N</span>
				<span class="brand-copy">Restaurante El Nido <small>Brasas · Aguilar de la Frontera</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cocina">La cocina</a>
				<a href="#restaurante">El restaurante</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-call" href={phoneHref}><span aria-hidden="true">☎</span> 692 60 51 83</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Aguilar de la Frontera · Córdoba</p>
					<h1 id="hero-title">Cocina de casa,<br /><em>fuego de brasa.</em></h1>
					<p class="hero-intro">En Restaurante El Nido, la cocina tradicional española se encuentra con el sabor de la brasa. Un lugar para sentarse a la mesa, compartir platos caseros y disfrutar de Aguilar sin prisas.</p>
					<div class="hero-actions">
						<a class="button button-rust" href={phoneHref}>Llamar y reservar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Encuéntranos</small><address>{business.streetAddress}<br />{business.postalCode} · Córdoba</address></div>
						<div><small>Reservas y consultas</small><a href={phoneHref}>{business.phone}</a></div>
					</div>
				</div>
				<figure class="hero-art">
					<Image
						class="hero-image"
						src={foto('restaurante-el-nido-aguilar-apaisada-04.jpg')}
						alt="Fotografía de Restaurante El Nido, en Aguilar de la Frontera (Córdoba)"
						widths={[640, 900, 1200, 1600]}
						sizes="(max-width: 780px) 100vw, 48vw"
						format="avif"
						quality={70}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption class="art-caption"><strong>El Nido</strong>Carnes a la brasa · Aguilar</figcaption>
				</figure>
			</section>

			<div class="promise" aria-label="Especialidades de Restaurante El Nido">
				<span>Carnes a la brasa</span><span>Cocina tradicional</span><span>Menú del día</span><span>Comida para llevar</span>
			</div>

			<section class="section intro" id="restaurante" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Restaurante en Aguilar de la Frontera</p>
					<h2 id="intro-title">Un lugar para<br />reunirse y <em>compartir.</em></h2>
				</div>
				<div class="intro-copy">
					<p>Restaurante El Nido ofrece cocina tradicional española con un toque innovador y especialidad en carnes a la brasa. Su carta combina guisos, platos caseros y propuestas para compartir en un ambiente cercano y familiar.</p>
					<p>Cuenta con un salón amplio para comidas y reuniones, además de opciones como menú del día y comida para llevar. Llama para consultar la carta actual, reservar o preguntar por la disponibilidad de grupos.</p>
					<p class="note">La ficha de Maps proporcionada sitúa el restaurante en Aguilar de la Frontera. Algunos directorios muestran datos de ubicación diferentes; usa las coordenadas del mapa y confirma la dirección por teléfono si tienes dudas.</p>
				</div>
			</section>

			<section class="section menu-section" id="cocina" aria-labelledby="menu-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Cocina tradicional · toque propio</p>
						<h2 id="menu-title">De la brasa<br /><em>a la sobremesa.</em></h2>
					</div>
					<p>Una selección orientativa de platos y propuestas mencionados en perfiles públicos y publicaciones gastronómicas. Carta, precios, alérgenos y disponibilidad: consúltalos directamente con el restaurante.</p>
				</div>
				<div class="menu-grid">
					{specialties.map((dish, index) => (
						<article class="menu-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<p class="menu-note">Los platos pueden variar según temporada y servicio. <a href={phoneHref}>Llama al 692 60 51 83</a> para consultar.</p>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<p class="section-label"><span aria-hidden="true"></span> El Nido en imágenes</p>
				<h2 id="gallery-title">Mira el local<br /><em>y sus platos.</em></h2>
				<p class="gallery-copy">Fotografías compartidas en el perfil público de Instagram de Restaurante El Nido. Explora algunos de sus platos, la terraza y la brasa.</p>
				<div class="gallery-grid">
					{galleryPhotos.map((photo, index) => (
						<a class="gallery-photo" href={photo.href} target="_blank" rel="noreferrer" aria-label={`${photo.alt} · Instagram`}>
							<Image src={photo.src} alt={photo.alt} widths={[320, 480, 640]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw" format="avif" quality={65} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
						</a>
					))}
				</div>
				<p class="gallery-note">Fotos del perfil público <a href={instagramUrl} target="_blank" rel="noreferrer">@restauranteelnidoaguilar ↗</a>. Las imágenes pertenecen a sus autores.</p>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14920 · Aguilar de la Frontera</p>
					<h2 id="visit-title">Ven a la mesa<br /><em>de El Nido.</em></h2>
					<address>{business.streetAddress}<br />{business.locality}, {business.postalCode}<br />{business.province}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Contacto y reservas</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Ubicación</small><a href={mapsUrl} target="_blank" rel="noreferrer">Abrir ficha de Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Redes oficiales</small><a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a> · <a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a></div></div>
					</div>
					<div class="hero-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar para reservar</a>
					</div>
					<p class="menu-note">Los horarios pueden cambiar. Llama para confirmar apertura y servicio antes de venir.</p>
				</div>
				<div class="map-card">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Restaurante El Nido en Aguilar de la Frontera, Córdoba" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<div class="map-label"><div><strong>Restaurante El Nido</strong><small>Aguilar de la Frontera · Córdoba</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="Restaurante El Nido, volver al inicio">
				<span class="brand-mark" aria-hidden="true">N</span><span class="brand-copy">Restaurante El Nido <small>Aguilar de la Frontera · Córdoba</small></span>
			</a>
			<nav class="footer-nav" aria-label="Perfiles y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Restaurante El Nido · Aguilar de la Frontera, Córdoba. Confirma horarios y carta por teléfono.</small>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
		<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
	</footer>
		<a class="mobile-call" href={phoneHref}>Llamar para reservar <span>692 60 51 83</span></a>

						<WhatsappFab phone={datos.phoneHref} name={datos.business?.name} />
						</body>
</html>


