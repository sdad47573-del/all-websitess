---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/restaurante-anubo-apaisada-04.jpg';
import comedor from '../assets/fotos/restaurante-anubo-apaisada-01.jpg';
import caldoso from '../assets/fotos/restaurante-anubo-apaisada-02.jpg';
import horno from '../assets/fotos/restaurante-anubo-apaisada-07.jpg';
import caldosoGambas from '../assets/fotos/restaurante-anubo-apaisada-09.jpg';
import pescado from '../assets/fotos/restaurante-anubo-vertical-03.jpg';
import paellaCigalas from '../assets/fotos/restaurante-anubo-vertical-05.jpg';
import arrozBrasa from '../assets/fotos/restaurante-anubo-vertical-06.jpg';
import arrozNegro from '../assets/fotos/restaurante-anubo-vertical-08.jpg';
import postre from '../assets/fotos/restaurante-anubo-vista-10-10.jpg';

const business = {
	name: 'Restaurante Anubo',
	brand: 'Anubo',
	tagline: 'Arrocería de productos de Castellón en Oropesa del Mar',
	street: 'Carrer de Goya, 36',
	city: 'Oropesa del Mar',
	region: 'Comunitat Valenciana',
	postalCode: '12594',
	phone: '964 31 12 56',
	latitude: 40.0916644,
	longitude: 0.136477,
	rating: 4.8,
	reviewsCount: 619,
	site: 'https://restaurante-anubo.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0x12a005871a0b0173:0xdecfe7a1cf8652ed';
const cidDecimal = '16055305878756545261';
const placeId = 'ChIJcwELGocFoBIR7VKGz6Hnz94';

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+ANUBO/@40.0916644,0.136477,17z/data=!3m1!4b1!4m6!3m5!1s0x12a005871a0b0173:0xdecfe7a1cf8652ed!8m2!3d40.0916644!4d0.136477!16s%2Fg%2F11kmbh_n4h?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&q=Restaurante+Anubo&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34964311256';

const description =
	'Arrocería en Carrer de Goya 36 (Oropesa del Mar): más de 20 variedades de arroz, paellas para llevar y marisco de Castellón. Mediodías de miércoles a domingo.';

const servicios = [
	'Arrocería',
	'Arroces y paellas',
	'Más de 20 variedades de arroz',
	'Paellas para llevar',
	'Pescado y marisco',
	'Productos de Castellón',
	'Carnes a la brasa',
	'Postres caseros',
	'Se admiten perros',
	'Local para pocos comensales',
];

const grupos = [
	{
		title: 'Arroces y paellas',
		items: [
			{
				name: 'Paella de marisco',
				note: 'con gambas, cigalas y almejas, servida en la paellera',
			},
			{
				name: 'Arroz negro',
				note: 'con tinta de calamar y marisco',
			},
			{
				name: 'Arroz caldoso con gambas',
				note: 'en cazuela de hierro, con caldo de pescado',
			},
			{
				name: 'Arroz con secreto a la brasa y pistacho',
				note: 'uno de los arroces de la casa',
			},
			{
				name: 'Paella de oreja, boletus y cigalas',
				note: 'la que más sorprende en las reseñas de Google',
			},
			{
				name: 'Arroz al horno',
				note: 'con morcilla, patata y tomate, al estilo valenciano',
			},
		],
	},
	{
		title: 'Del mar',
		items: [
			{ name: 'Pulpo a la gallega', note: 'con pimentón y aceite de oliva' },
			{ name: 'Calamar frito', note: 'a la andaluza, con limón' },
			{ name: 'Pescado del día', note: 'con crujiente de ajo y hierbas' },
			{ name: 'Gambas y cigalas de la lonja', note: 'según temporada' },
		],
	},
	{
		title: 'De la brasa',
		items: [
			{ name: 'Solomillo', note: 'a la parrilla, al punto que pidas' },
			{ name: 'Entrecot', note: 'de vacuno, con guarnición' },
			{ name: 'Carnes para compartir', note: 'se sirven sobre tabla o en la misma paella' },
		],
	},
	{
		title: 'Postres y para llevar',
		items: [
			{
				name: 'Postre casero con helado',
				note: 'bizcocho templado, caramelo y helado de nata',
			},
			{ name: 'Paellas para llevar', note: 'se encargan por teléfono en el local' },
		],
	},
];

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de Restaurante Anubo con mesas de madera, el acuario y fotografías en blanco y negro, Oropesa del Mar',
	},
	{
		src: paellaCigalas,
		alt: 'Paella de marisco con cigalas, gambas y mejillones de Restaurante Anubo, Oropesa del Mar',
	},
	{
		src: caldoso,
		alt: 'Arroz caldoso con gambas en cazuela de hierro de Restaurante Anubo, Oropesa del Mar',
	},
	{
		src: arrozNegro,
		alt: 'Arroz negro servido en la paellera en Restaurante Anubo, Oropesa del Mar',
	},
	{
		src: horno,
		alt: 'Arroz al horno con morcilla, patata y tomate de Restaurante Anubo, Oropesa del Mar',
	},
	{
		src: arrozBrasa,
		alt: 'Arroz con secreto a la brasa y pistachos de Restaurante Anubo, Oropesa del Mar',
	},
	{
		src: caldosoGambas,
		alt: 'Arroz caldoso de gambas de Restaurante Anubo, arrocería en Oropesa del Mar',
	},
	{
		src: pescado,
		alt: 'Pescado con crujiente de ajo y hierbas de Restaurante Anubo, Oropesa del Mar',
	},
	{
		src: postre,
		alt: 'Postre casero con helado y caramelo de Restaurante Anubo, Oropesa del Mar',
	},
];

const faqs = [
	{
		q: '¿Dónde está Restaurante Anubo?',
		a: 'En el Carrer de Goya, 36, 12594 Oropesa del Mar (Castellón). Desde esta página puedes abrir Google Maps y trazar la ruta hasta la puerta con el botón «Cómo llegar».',
	},
	{
		q: '¿Qué tipo de cocina hace Anubo?',
		a: 'Es una arrocería: arroces, pescados, mariscos y productos de Castellón. En la carta hay más de veinte variedades de arroz, desde paellas de marisco y arroz negro hasta arroces caldosos, al horno o con carne a la brasa. La ficha del local también anuncia paellas para llevar.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Abre solo en el servicio de mediodía, de 11:00 a 15:30, de miércoles a domingo. Los lunes y los martes permanece cerrado. Al ser un horario corto y de temporada, conviene confirmarlo por teléfono antes de desplazarse.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'Sí, es recomendable. El propio local se describe como acogedor e íntimo, con pocas mesas, así que en fin de semana y en temporada alta se llena. El teléfono publicado en su ficha de Google es el 964 31 12 56; no hay reserva online en esta web.',
	},
	{
		q: '¿Se puede pedir paella para llevar?',
		a: 'La ficha de Google del restaurante anuncia «paellas para llevar». Lo mejor es llamar al 964 31 12 56 con antelación para encargarla y confirmar el horario de recogida.',
	},
	{
		q: '¿Se admiten perros y es accesible?',
		a: 'La ficha de Google indica que se admiten perros y que el local tiene acceso para sillas de ruedas, aseo adaptado y asientos adaptados. Si vas con perro o necesitas una mesa concreta, avisa al reservar por teléfono.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: 'Restaurante Anubo',
	alternateName: ['Anubo', 'Restaurante ANUBO Oropesa'],
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 964 31 12 56',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Arrocería', 'Arroces', 'Paellas', 'Marisco', 'Cocina valenciana'],
	areaServed: [
		{ '@type': 'City', name: 'Oropesa del Mar' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '11:00',
			closes: '15:30',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Se admiten perros', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Paellas para llevar', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Arroces', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Restaurante Anubo · Arrocería en Oropesa del Mar</title>
		<meta name="theme-color" content="#1d4e63" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,600&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Restaurante Anubo, Anubo Oropesa del Mar, arrocería Oropesa, paellas Orpesa, arroz negro Castellón, paella para llevar Oropesa, Carrer de Goya 36, restaurante Plana Alta, comer arroz Castellón, arrocería Oropesa del Mar"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Restaurante Anubo · Arrocería en Oropesa del Mar"
			ogDescription="Más de 20 variedades de arroz, paellas para llevar y marisco de Castellón en Carrer de Goya, 36. Mediodías de miércoles a domingo. 4,8 en Google con 619 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Paella de marisco con gambas y almejas de Restaurante Anubo, Oropesa del Mar"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#1d4e63"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Oropesa del Mar, Castellón"
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="A"
			name={business.brand}
			subtitle="Arrocería · Oropesa del Mar"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer de Goya · Oropesa del Mar"
				title="Arroces,<br />marisco y brasa<br /><em>en Oropesa.</em>"
				lede="Restaurante Anubo es una arrocería en el Carrer de Goya, 36, en Oropesa del Mar. Más de veinte variedades de arroz en la carta, pescados y mariscos de la lonja de Castellón, carnes a la brasa y paellas para llevar, en un comedor pequeño y tranquilo que abre solo a mediodía."
				image={heroImage}
				imageAlt="Paella de marisco con gambas y almejas servida en la paellera en Restaurante Anubo, Oropesa del Mar"
				primaryCta={{ label: 'Llamar 964 31 12 56', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,8</b> en Google (619 reseñas)' },
					{ label: 'Carta', html: 'Más de 20 variedades de arroz' },
					{ label: 'Horario', html: 'Mediodías, miércoles a domingo' },
					{ label: 'Extra', html: 'Paellas para llevar' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Restaurante Anubo" items={servicios} />

			<LocalAbout
				label="Arrocería de productos de Castellón"
				title="El arroz,<br />la lonja<br /><em>y la brasa.</em>"
				paragraphs={[
					'Restaurante Anubo está en el Carrer de Goya, 36, en Oropesa del Mar, a un paso de la playa y del paseo. El comedor es pequeño e íntimo, con pocas mesas, paredes blancas, madera oscura y un acuario que preside la sala: se viene a comer con calma, no a hacer turnos.',
					'La cocina gira alrededor del arroz y del producto de Castellón. En la carta hay más de veinte variedades: paellas de marisco con gambas, cigalas y almejas, arroz negro con tinta de calamar, arroces caldosos en cazuela de hierro, arroz al horno con morcilla y patata, y arroces con carne a la brasa rematados con pistacho.',
					'Antes o después, el mar: pulpo a la gallega, calamar frito, pescado del día con un crujiente de ajo y hierbas y gambas de la lonja. Y para terminar, postres caseros como el bizcocho templado con helado y caramelo. La ficha del local anuncia además paellas para llevar, para quien prefiera comerlas en casa.',
				]}
				note="La ficha de Google reúne 619 opiniones con una nota media de 4,8. Los clientes destacan la paella de oreja, boletus y cigalas («sorprendente y deliciosa»), el trato del chef y la camarera, y platos como el pulpo, el calamar frito, el solomillo y el entrecot. También figura que se admiten perros."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Más de veinte<br /><em>arroces.</em>"
				description="Selección hecha a partir de la descripción de la propia casa en Google («arroces, pescados, mariscos y productos de Castellón; más de 20 variedades de arroz»), de los platos de sus fotos y de los que citan los clientes en las reseñas."
				cta={{ label: 'Reservar por teléfono', href: phoneHref }}
				groups={grupos}
				note="Esta web no publica precios: no hay carta oficial publicada y no se inventan importes. La carta del día, el arroz disponible y el precio se confirman en el local o por teléfono."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Arroces<br /><em>y comedor.</em>"
				description="Estas fotografías proceden del perfil de Restaurante Anubo en Google Maps, con imágenes de la ficha y de sus clientes: la paella de marisco, el arroz negro, el arroz al horno, el arroz con secreto a la brasa, el caldoso de gambas, el pescado y el postre de la casa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer de Goya, 36 · 12594 Oropesa del Mar"
				title="Nos vemos<br /><em>en Anubo.</em>"
				addressLines={[
					business.street,
					`${business.postalCode} ${business.city}`,
					'Castellón, España',
				]}
				hours={[
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: 'Cerrado', closed: true },
					{ day: 'Miércoles', value: '11:00 – 15:30' },
					{ day: 'Jueves', value: '11:00 – 15:30' },
					{ day: 'Viernes', value: '11:00 – 15:30' },
					{ day: 'Sábado', value: '11:00 – 15:30' },
					{ day: 'Domingo', value: '11:00 – 15:30' },
				]}
				hoursNote="Horario publicado en la ficha de Google: solo servicio de mediodía, de 11:00 a 15:30, de miércoles a domingo. Lunes y martes cierra. En temporada alta y festivos puede cambiar, así que llama al 964 31 12 56 antes de ir."
				mapTitle="Mapa de Restaurante Anubo en el Carrer de Goya, 36, Oropesa del Mar"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Restaurante Anubo · Oropesa del Mar"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Reservas y encargos de paellas para llevar por teléfono, en el 964 31 12 56. No hay reserva online ni formulario en esta web. El local es pequeño, así que conviene reservar con antelación; se admiten perros y la ficha indica acceso, aseo y asientos adaptados para sillas de ruedas."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="A"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Anubo"
		/>
	</body>
</html>
