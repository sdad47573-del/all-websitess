---
import { BUSINESS, REVIEWS } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
const media = Math.floor(BUSINESS.rating * 2) / 2;
---

<section id="opiniones" class="trama-posada bg-base-200 border-base-300 border-y py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
			<div>
				<p class="text-secondary text-xs font-semibold tracking-[0.22em] uppercase">Opiniones</p>
				<h2 class="font-display mt-3 text-3xl leading-tight font-bold sm:text-4xl">
					Lo que dicen en Google
				</h2>

				<div class="border-base-300 bg-base-100 mt-7 rounded-2xl border p-6">
					<div class="flex items-end gap-4">
						<span class="font-display text-6xl leading-none font-bold">
							{BUSINESS.rating.toString().replace('.', ',')}
						</span>
						<div class="pb-1">
							<div class="text-secondary text-lg tracking-tight" aria-hidden="true">
								{
									estrellas.map((n) => (
										<i
											class={
												n <= media
													? 'ri-star-fill'
													: n - media === 0.5
														? 'ri-star-half-fill'
														: 'ri-star-line'
											}
										/>
									))
								}
							</div>
							<p class="text-base-content/60 mt-1 text-xs">
								{BUSINESS.reviewCount.toLocaleString('es-ES')} reseñas en Google Maps
							</p>
						</div>
					</div>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline btn-sm mt-5 w-full gap-2 rounded-full"
					>
						<i class="ri-google-fill"></i> Leer todas las reseñas
					</a>
					<p class="text-base-content/45 mt-3 text-center text-[0.65rem]">
						Valoración de la ficha de Google en octubre de 2026.
					</p>
				</div>
			</div>

			<div class="grid gap-4 sm:grid-cols-2">
				{
					REVIEWS.map((resena, index) => (
						<blockquote
							class={`border-base-300 bg-base-100 flex flex-col rounded-2xl border p-6 ${
								index === 0 ? 'sm:col-span-2' : ''
							}`}
						>
							<div class="text-secondary text-sm tracking-tight" aria-label={`${resena.rating} de 5 estrellas`}>
								{Array.from({ length: resena.rating }).map(() => (
									<i class="ri-star-fill" />
								))}
							</div>
							<p class="mt-3 flex-1 text-sm leading-relaxed">«{resena.text}»</p>
							<footer class="mt-4 flex items-center gap-3">
								<span class="bg-primary text-primary-content flex size-8 items-center justify-center rounded-full text-xs font-bold">
									LP
								</span>
								<span class="text-xs font-semibold">{resena.author}</span>
								<span class="text-base-content/45 ml-auto text-[0.65rem]">Google</span>
							</footer>
						</blockquote>
					))
				}
				<blockquote
					class="border-base-300 bg-base-100/60 flex flex-col justify-center rounded-2xl border border-dashed p-6"
				>
					<p class="text-base-content/60 text-sm leading-relaxed">
						La ficha reúne 315 valoraciones con una media de 4,6 sobre 5. Las reseñas
						visibles destacan la comida, el trato y el servicio.
					</p>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="text-secondary mt-3 inline-flex items-center gap-1 text-xs font-bold hover:underline"
					>
						Ver la ficha completa <i class="ri-arrow-right-line"></i>
					</a>
				</blockquote>
			</div>
		</div>
	</div>
</section>
