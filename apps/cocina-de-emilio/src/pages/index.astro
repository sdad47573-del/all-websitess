---
import f01 from '../assets/fotos/cocina-de-emilio-apaisada-01.jpg';
import f02 from '../assets/fotos/cocina-de-emilio-apaisada-02.jpg';
import f03 from '../assets/fotos/cocina-de-emilio-vertical-03.jpg';
import f04 from '../assets/fotos/cocina-de-emilio-vertical-04.jpg';
import f05 from '../assets/fotos/cocina-de-emilio-vertical-05.jpg';
import f06 from '../assets/fotos/cocina-de-emilio-cuadrada-06.jpg';
import f07 from '../assets/fotos/cocina-de-emilio-vertical-07.jpg';
import f08 from '../assets/fotos/cocina-de-emilio-vista-8-08.jpg';
import f09 from '../assets/fotos/cocina-de-emilio-vertical-09.jpg';

const fotos = [f01, f02, f03, f04, f05, f06, f07, f08, f09];

const MAPS_URL =
	'https://www.google.com/maps/place/Cocina+De+Emilio/@37.9779289,-1.1282832,17z/data=!3m1!4b1!4m6!3m5!1s0xd63820684f46c41:0x23deace13383f124!8m2!3d37.9779289!4d-1.1282832!16s%2Fg%2F11b7gpybqm?authuser=0&hl=es&entry=ttu';
const CREDIT_URL = 'https://sur-digital.vercel.app/';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Cocina De Emilio</title>
		<meta name="description" content="Cocina De Emilio." />
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"@id": "https://cocina-de-emilio.vercel.app/#negocio",
	"name": "Cocina de emilio",
	"url": "https://cocina-de-emilio.vercel.app/",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 37.9779289,
		"longitude": -1.1282832
	},
	"hasMap": "https://www.google.com/maps/place/Cocina+De+Emilio/@37.9779289,-1.1282832,17z/data=!3m1!4b1!4m6!3m5!1s0xd63820684f46c41:0x23deace13383f124!8m2!3d37.9779289!4d-1.1282832!16s%2Fg%2F11b7gpybqm?authuser=0&hl=es&entry=ttu"
}
</script>
</head>
	<body>
		<header>
			<h1 set:html={piezas.portada.titulo} />
			<a href={MAPS_URL} rel="noopener" target="_blank">Ver en Google Maps</a>
		</header>

		<main>
			<section>
				{fotos.map((foto) => (
					<img src={foto.src} width={foto.width} height={foto.height} alt="Cocina De Emilio" loading="lazy" />
				))}
			</section>
		</main>

		<footer>
			<p>
				Creado por <a href={CREDIT_URL} rel="noopener">Sur Digital</a> · sur-digital.vercel.app
			</p>
		</footer>
	</body>
</html>
