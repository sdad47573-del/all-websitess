---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import horno from '../assets/fotos/panaderia-tradicion-cordobesa-apaisada-01.jpg';
import hogazas from '../assets/fotos/panaderia-tradicion-cordobesa-vertical-02.jpg';
import semillas from '../assets/fotos/panaderia-tradicion-cordobesa-apaisada-03.jpg';
import enrollados from '../assets/fotos/panaderia-tradicion-cordobesa-apaisada-05.jpg';
import estrella from '../assets/fotos/panaderia-tradicion-cordobesa-cuadrada-06.jpg';
import rebanadas from '../assets/fotos/panaderia-tradicion-cordobesa-cuadrada-08.jpg';
import sal from '../assets/fotos/panaderia-tradicion-cordobesa-apaisada-09.jpg';
import avena from '../assets/fotos/panaderia-tradicion-cordobesa-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería Tradición Cordobesa · Obrador de pan artesano en Córdoba';
const description = BUSINESS.description;

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#tradicion-cordobesa`,
	name: BUSINESS.name,
	legalName: BUSINESS.legalName,
	alternateName: [
		'Tradición Cordobesa',
		'Panadería Tradición Cordobesa',
		'Obrador Tradición Cordobesa Córdoba',
	],
	description:
		'Obrador de pan artesano en la calle Simón Carpintero, 13 (14014 Córdoba): pan candeal, telera y bollo cocidos en horno de solera, especialidades de lino, semillas e integral, y pan para supermercados, tiendas y hostelería.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 957 32 63 74',
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	slogan: BUSINESS.lema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '10:00',
			closes: '13:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El obrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: hogazas,
		alt: 'Hogazas enharinadas recién hechas, alineadas en una bandeja de horno',
	},
	{
		src: semillas,
		alt: 'Hogaza rectangular con semillas de lino y sésamo en la corteza',
	},
	{
		src: enrollados,
		alt: 'Bollos enrollados y piezas de pan en una bandeja de horno',
	},
	{
		src: estrella,
		alt: 'Pan en forma de estrella con varios bollos unidos',
	},
	{
		src: rebanadas,
		alt: 'Barra de pan cortada en rebanadas, con la miga a la vista',
	},
	{
		src: sal,
		alt: 'Tres bollos planos con sal gruesa por encima',
	},
	{
		src: avena,
		alt: 'Hogaza con semillas de avena en la corteza, recién cortada',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f3a2a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Karla:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Tradición Cordobesa Córdoba, panadería Simón Carpintero, obrador de pan artesano Córdoba, pan candeal Córdoba, telera horno de solera, pan de semillas Córdoba, panadería 14014"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Obrador de pan artesano en la calle Simón Carpintero, 13 (14014 Córdoba). Pan candeal, telera y bollo de horno de solera, especialidades de semillas e integral, y servicio a supermercados, tiendas y hostelería. De 10:00 a 13:30; domingo cerrado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Interior del horno de solera de Tradición Cordobesa con las piezas de pan recién cocidas"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2f3a2a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[horno]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Obrador de pan"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="14014 · Simón Carpintero, 13"
				title="Pan de horno <br /><em>de solera.</em>"
				lede={`Obrador de pan artesano en la calle Simón Carpintero, 13. Tradición Cordobesa amasa pan candeal, telera y bollo, y especialidades de lino, semillas e integral mejorado; sirve a supermercados, tiendas y hostelería. Abre todos los días de 10:00 a 13:30 y el domingo cierra. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google y teléfono propio: ${BUSINESS.phone}.`}
				image={horno}
				imageAlt="Interior del horno de solera con decenas de piezas de pan recién cocidas sobre la piedra"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> en Google · 18 reseñas' },
					{ label: 'Horario', html: '<b>L–S</b> 10:00–13:30' },
					{ label: 'Teléfono', html: '<b>957 32 63 74</b>' },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Obrador artesano"
			/>

			<LocalChips label="Lo que hace el obrador" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Harina, solera <br /><em>y oficio.</em>"
				paragraphs={[
					'Panadería Tradición Cordobesa S L está en la calle Simón Carpintero, 13, en el 14014 de Córdoba. Es un obrador de pan artesano, no una tienda de barrio al uso: su ficha cuenta que sirve tanto a supermercados como a tiendas y que es especialista en hostelería.',
					'El catálogo que describe el propio negocio va del aperitivo al comensal: pan aperitivo, desayunos y pan de mesa. En la línea de candeal elabora panes, telera y bollo, y la telera se trata artesanalmente y se cuece en horno de solera.',
					'Sus especialidades son el lino, la mezcla de semillas (amapola, lino marrón, avena y pipa de girasol) y el integral mejorado. En las fotos se ven hogazas enharinadas, barras cortadas, bollos enrollados y piezas con semillas en la corteza.',
					'La ficha publica 4,6 sobre 5 con 18 reseñas. Entre las destacadas: «Buen surtido de dulces y pan recién hecho» y «Una gran variedad de sabores». El horario es de mañana, de 10:00 a 13:30 todos los días, con el domingo cerrado.',
				]}
				note="La descripción del obrador, los panes y el lema «Calidad y servicio» son los que publica el propio negocio en su ficha de Google. La ficha no incluye carta con precios, web propia, correo, redes, datos de accesibilidad ni métodos de pago; esta web no los inventa."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<section class="lema" aria-label="Lema del obrador">
				<div class="wrap">
					<p>«{BUSINESS.lema}»</p>
					<span>El lema de la casa</span>
				</div>
			</section>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas del obrador
						</p>
						<h2 id="three-title">
							Solera, formatos <br />
							<em>y semillas.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El obrador"
				title="Lo que sale <br /><em>del horno.</em>"
				description="Sin precios publicados: este es el catálogo que describe el propio negocio en su ficha de Google, del pan de cada día a las especialidades."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={MENU_GROUPS}
				note="La ficha no publica carta ni precios, así que esta web no indica importes. Los pedidos se consultan por teléfono; aquí no se puede comprar."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="El horno, <br /><em>por dentro.</em>"
				description="Siete fotos de la galería de Google Maps: las hogazas, la corteza con semillas, los bollos y la miga."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow="14014 · Córdoba"
				title="En Simón <br /><em>Carpintero.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de Panadería Tradición Cordobesa en la calle Simón Carpintero, 13"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Tradición Cordobesa · Simón Carpintero, 13"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Abrir en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{
					label: `Llamar al ${BUSINESS.phone}`,
					href: BUSINESS.phoneHref,
					external: true,
				}}
				reserveNote="La ficha no publica datos de accesibilidad, métodos de pago ni reparto, así que esta página no los afirma. Tampoco aclara las condiciones de venta al particular: el obrador sirve a supermercados, tiendas y hostelería, y lo mejor es llamar antes de ir."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>llamar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, descripción y fotos de la ficha pública de Google Maps, consultados en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Tradición Cordobesa"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
