---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/la-taberna-de-gaby-apaisada-01.jpg';
import cortina from '../assets/fotos/la-taberna-de-gaby-vertical-02.jpg';
import barra from '../assets/fotos/la-taberna-de-gaby-vertical-03.jpg';
import almuerzo from '../assets/fotos/la-taberna-de-gaby-vertical-04.jpg';
import vaso from '../assets/fotos/la-taberna-de-gaby-vista-5-05.jpg';
import postre from '../assets/fotos/la-taberna-de-gaby-apaisada-06.jpg';
import brasas from '../assets/fotos/la-taberna-de-gaby-vertical-07.jpg';
import quemadillo from '../assets/fotos/la-taberna-de-gaby-vertical-08.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const title = "La Taberna de Gaby · Taberna en la Vall d'Alba, Castellón";
const description = BUSINESS.description;

const galeria = [
	{
		src: fachada,
		alt: 'Fachada amarilla de La Taberna de Gaby en la plaça la Concordia, con el rótulo negro de letras blancas sobre la puerta, el zócalo de ladrillo visto y la acera en primer término',
	},
	{
		src: barra,
		alt: 'Interior de La Taberna de Gaby visto desde la puerta: barra con frente de mármol, taburetes de madera, mesas y sillas de respaldo alto, suelo de gres y una clienta tras la barra',
	},
	{
		src: almuerzo,
		alt: 'Cuatro platos de almuerzo servidos a la vez en La Taberna de Gaby, con huevos fritos, patatas fritas, longaniza y carne',
	},
	{
		src: brasas,
		alt: 'Brasas de leña encendidas en la chimenea de ladrillo de La Taberna de Gaby, con la parrilla al lado y un vaso sobre la barra de hierro',
	},
	{
		src: cortina,
		alt: 'Cortina de cuentas de madera recogida en el marco de la puerta de La Taberna de Gaby, con la pared amarilla y el zócalo de ladrillo al fondo',
	},
	{
		src: postre,
		alt: 'Postre en copa de cristal cubierto de nata montada y salsa de chocolate, servido sobre la mesa de mármol de La Taberna de Gaby',
	},
	{
		src: quemadillo,
		alt: 'Vaso de cristal en la barra de La Taberna de Gaby, con la bebida encendida en llamas y una cucharilla larga, delante de la cafetera',
	},
	{
		src: vaso,
		alt: 'Primer plano de un vaso servido en su plato en La Taberna de Gaby, con la bebida en dos tonos y una piel de limón en la superficie',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-taberna-de-gaby`,
	name: BUSINESS.name,
	alternateName: ['Taberna de Gaby', "La Taberna de Gaby la Vall d'Alba"],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'De mercado'],
	areaServed: [
		{ '@type': 'City', name: "la Vall d'Alba" },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:00',
			closes: '14:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '18:00',
			closes: '00:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#26201b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Taberna de Gaby, taberna la Vall d'Alba, bar la Vall d'Alba, almuerzos la Vall d'Alba, desayunos la Vall d'Alba, brasa Castellón, dónde comer en la Vall d'Alba, plaça la Concordia 11"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Desayunos desde las 8:00, almuerzos y brasa de leña los viernes y sábados por la noche. Plaça la Concordia 11, la Vall d'Alba (Castellón)."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Fachada de La Taberna de Gaby en la Vall d'Alba"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#26201b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion={BUSINESS.geoRegion}
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="la Vall d'Alba, Castellón"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Taberna de Gaby"
			subtitle="la Vall d'Alba · Castellón"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.district}`}
				title="Café a las ocho, <br /><em>brasa de noche.</em>"
				lede="La Taberna de Gaby está en el número 11 de la plaça la Concordia, en la Vall d'Alba (Castellón). Abre a las 8:00 de lunes a sábado con desayunos y almuerzos, y los viernes y sábados alarga el día de 18:00 a 24:00. La ficha de Google le da 4,5 sobre 5 con 56 reseñas."
				image={fachada}
				imageAlt="Fachada amarilla de La Taberna de Gaby, con el rótulo negro de letras blancas sobre la puerta y el zócalo de ladrillo visto"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5</b> en Google · 56 reseñas' },
					{ label: 'Horario', html: '<b>8–14</b> de lunes a sábado' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> contacto publicado` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Lo que encuentras en La Taberna de Gaby" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="La taberna <br /><em>del pueblo.</em>"
				paragraphs={[
					"La Taberna de Gaby está en el número 11 de la plaça la Concordia, en la Vall d'Alba (12194, Castellón), con la puerta a pie de calle. Google clasifica el local como taberna, le da 4,5 sobre 5 con 56 reseñas y publica el teléfono +34 642 87 62 40 como único contacto.",
					"La fachada está pintada de amarillo y el rótulo negro de letras blancas cuelga justo encima de la entrada, con el zócalo de ladrillo visto recorriendo la pared. Dentro, la barra tiene el frente de mármol, con taburetes y mesas de madera de respaldo alto, y al fondo la chimenea de leña donde se enciende la brasa.",
					"La jornada empieza pronto: la ficha marca las 8:00 de lunes a sábado. Las reseñas destacadas hablan de «unos desayunos increíbles», de «almuerzos muy buenos» y de «una brasa espectacular», que es lo que se sirve los viernes y los sábados por la noche.",
					"La ficha no publica carta, precios ni web propia: muestra la opción de añadir un sitio web, lo que confirma que no hay ninguno. Así que aquí no vas a encontrar una carta inventada. Lo que sí está es todo lo público: dirección, teléfono, horario, valoración y las fotografías del perfil.",
				]}
				note="La información de esta página viene de la ficha pública de Google Maps y de las fotografías del perfil del establecimiento. La ficha no publica carta, precios ni web propia, así que ninguna de esas cosas aparece aquí."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La mesa"
				title="Desayuno, almuerzo <br /><em>y brasa.</em>"
				description="La ficha de Google no publica carta ni precios, y el local no tiene web propia. Lo que sigue son los platos que mencionan las reseñas destacadas de la ficha: desayunos de primera hora, almuerzos y la brasa de la noche."
				cta={{ label: 'Ver fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="No hay carta publicada ni precios conocidos. Para saber el menú del día, la disponibilidad o para reservar, el teléfono de la ficha es el único canal publicado."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Ocho fotografías <br /><em>del local.</em>"
				description="Las fotografías del perfil de La Taberna de Gaby en Google Maps: la fachada de la plaça la Concordia, la barra, la chimenea con las brasas, los almuerzos y los cafés de después."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y procedentes del perfil del establecimiento en Google Maps. Si eres titular de alguna y quieres que la retiremos, escríbenos y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Pásate por <br /><em>la plaza.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Castellón · Comunitat Valenciana',
					'España',
				]}
				hours={HOURS}
				hoursCaption="Horario publicado"
				hoursNote="Horario de la ficha de Google: de 8:00 a 14:00 de lunes a sábado y, los viernes y sábados, también de 18:00 a 24:00. El domingo aparece como cerrado y la ficha avisa de que en festivos el horario podría ser diferente, así que conviene confirmarlo antes de ir."
				mapTitle="Mapa de La Taberna de Gaby en la plaça la Concordia 11, la Vall d'Alba"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Taberna de Gaby · la Vall d'Alba"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="El teléfono es el único canal de contacto que publica la ficha. No hay reservas ni pedidos en línea: el local no tiene web propia ni plataforma asociada. La ficha no indica tampoco información sobre terraza o accesibilidad."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y oferta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de La Taberna de Gaby"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
