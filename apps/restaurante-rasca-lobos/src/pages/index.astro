---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/restaurante-rasca-lobos-apaisada-01.jpg';
import verduras from '../assets/fotos/restaurante-rasca-lobos-vertical-02.jpg';
import milanesa from '../assets/fotos/restaurante-rasca-lobos-vertical-03.jpg';
import salon from '../assets/fotos/restaurante-rasca-lobos-apaisada-04.jpg';
import entrada from '../assets/fotos/restaurante-rasca-lobos-vertical-05.jpg';
import jardin from '../assets/fotos/restaurante-rasca-lobos-apaisada-06.jpg';
import patatas from '../assets/fotos/restaurante-rasca-lobos-vista-7-07.jpg';
import platano from '../assets/fotos/restaurante-rasca-lobos-vertical-08.jpg';
import tarta from '../assets/fotos/restaurante-rasca-lobos-vertical-09.jpg';
import ensalada from '../assets/fotos/restaurante-rasca-lobos-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Restaurante Rasca Lobos, mesón de cocina tradicional en Avinguda de Vicent Serra, 25 (Sant Jordi de ses Salines, Ibiza). Jardín, brasa y postres caseros. Tel. 971 39 58 60.';

const galeria = [
	{
		src: fachada,
		alt: 'Rótulo de neón verde de Mesón Restaurante Rasca Lobos sobre la fachada, con los dos lobos y el horario pintado en el cristal',
	},
	{
		src: entrada,
		alt: 'Entrada de noche al jardín de Rasca Lobos, con el cartel iluminado «Cocina Tradicional de Calidad» sobre dos pilares de obra',
	},
	{
		src: jardin,
		alt: 'Jardín de Rasca Lobos con suelo de guijarros, árboles y mesas blancas a la sombra',
	},
	{
		src: salon,
		alt: 'Salón de Rasca Lobos con paredes color terracota, estantería de botellas y mesas con mantel blanco',
	},
	{
		src: patatas,
		alt: 'Patatas Oviedo sobre patatas chips con la cruz de pimiento y aceitunas, junto a un plato de champis con jamón',
	},
	{
		src: verduras,
		alt: 'Salteado de verduras con jamón, pimiento rojo y hierbas frescas en una fuente honda',
	},
	{
		src: milanesa,
		alt: 'Milanesa de pollo con patatas fritas, ensalada y limón junto a un entrecot con pimientos de Padrón',
	},
	{
		src: ensalada,
		alt: 'Ensalada con langostinos, aguacate, tomate y brotes verdes en un plato de borde azul',
	},
	{
		src: tarta,
		alt: 'Tarta de queso con helado de vainilla, nata y salsa de frutos rojos',
	},
	{
		src: platano,
		alt: 'Plátano frito con helado, nata y miel servido en un plato acanalado',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#rasca-lobos`,
	name: BUSINESS.name,
	alternateName: ['Rasca Lobos', 'Mesón Rasca Lobos', 'Rasca Lobos Ibiza', 'Rasca Lobos Sant Jordi'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 971 39 58 60',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Tradicional'],
	areaServed: [
		{ '@type': 'City', name: 'Sant Jordi de ses Salines' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Rasca Lobos · Mesón de cocina tradicional en Ibiza';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-rasca-lobos-apaisada-01.jpg": fachada,
	"restaurante-rasca-lobos-vertical-05.jpg": entrada,
	"restaurante-rasca-lobos-apaisada-06.jpg": jardin,
	"restaurante-rasca-lobos-apaisada-04.jpg": salon,
	"restaurante-rasca-lobos-vista-7-07.jpg": patatas,
	"restaurante-rasca-lobos-vertical-02.jpg": verduras,
	"restaurante-rasca-lobos-vertical-03.jpg": milanesa,
	"restaurante-rasca-lobos-vertical-10.jpg": ensalada,
	"restaurante-rasca-lobos-vertical-09.jpg": tarta,
	"restaurante-rasca-lobos-vertical-08.jpg": platano,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f5d3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Nunito+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Rasca Lobos, Mesón Rasca Lobos, restaurante Sant Jordi de ses Salines, comer en Sant Jordi Ibiza, cocina tradicional Ibiza, fabada Ibiza, patatas Oviedo, restaurante con jardín Ibiza"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Rasca Lobos · Mesón de cocina tradicional en Ibiza"
			ogDescription="Mesón con jardín en Sant Jordi de ses Salines (Ibiza): cocina tradicional, brasa, fabada y postres caseros. Avinguda de Vicent Serra, 25. Tel. 971 39 58 60."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo de neón de Mesón Restaurante Rasca Lobos en su fachada"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2f5d3a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			phone="+34971395860"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Rasca Lobos"
			subtitle="Mesón de cocina tradicional · Sant Jordi"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
				reviews={REVIEWS}
				googleMaps={MAPS.place}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Rasca Lobos"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34971395860?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Sant%20Jordi%20de%20ses%20Salines." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Sant Jordi de ses Salines"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
