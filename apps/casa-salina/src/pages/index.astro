---
const business = {
	name: 'Casa Salina',
	street: 'Calle Santa Florentina, 20',
	city: 'Cartagena',
	region: 'Murcia',
	postalCode: '30202',
	country: 'ES',
	latitude: 37.6037837,
	longitude: -0.9873359,
	site: 'https://casa-salina.netlify.app',
};

const mapsUrl = 'https://www.google.com/maps/place/CASA+SALINA/@37.6037837,-0.9873359,17z/data=!3m1!4b1!4m6!3m5!1s0xd6343c771a2f42f:0x5b0e4781946f460!8m2!3d37.6037837!4d-0.9873359!16s%2Fg%2F11ntp6rj9f?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const siteUrl = `${business.site}/`;
const description = 'Casa Salina, nueva enoteca gourmet en Calle Santa Florentina, 20 (Cartagena). Quesos, embutidos, salazones, vinos y vermuts de autor. Consulta ubicación y fotos.';

const faqs = [
	{
		question: '¿Dónde está Casa Salina?',
		answer: 'Casa Salina se encuentra en Calle Santa Florentina, 20, 30202 Cartagena (Murcia), en pleno eje comercial del centro. Abre las indicaciones de Google Maps para consultar el trayecto.',
	},
	{
		question: '¿Tienen teléfono publicado?',
		answer: 'De momento no hay un teléfono publicado del establecimiento. Consulta la ficha de Google Maps, que suele actualizarse con el contacto y el horario.',
	},
	{
		question: '¿Qué sirven en Casa Salina?',
		answer: 'Casa Salina se presenta como enoteca: quesos, embutidos, salazones, vinos y vermuts de autor, con producto de tradición y homenaje a la cocina de Cartagena. La carta puede cambiar; consúltala en la ficha o en el local.',
	},
	{
		question: '¿Cuál es el horario de apertura?',
		answer: 'Es un proyecto de reciente apertura y el horario puede variar. Revisa la ficha de Google Maps antes de ir para confirmar la apertura del día.',
	},
	{
		question: '¿Dónde puedo ver fotos del local?',
		answer: 'En esta página tienes una galería con fotos de la ficha de Casa Salina en Google Maps, y puedes abrir la ficha completa para ver más fotos y las reseñas.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${siteUrl}#restaurant`,
	name: business.name,
	description,
	url: siteUrl,
	servesCuisine: ['Enoteca', 'Salazones', 'Quesos', 'Vinos'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: business.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

import { Image } from 'astro:assets';
import Galeria from '../components/Galeria.astro';
import heroImage from '../assets/fotos/casa-salina-apaisada-01.jpg';---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#211a13" />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" />
		<title>Casa Salina en Cartagena | Enoteca gourmet en Santa Florentina</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Casa Salina · Enoteca gourmet en Cartagena" />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${business.site}/og.svg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Casa Salina, enoteca gourmet en Cartagena" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.region" content="ES-MU" />
		<meta name="geo.placename" content="Cartagena" />
		<meta name="geo.position" content="37.6037837;-0.9873359" />
		<meta name="ICBM" content="37.6037837, -0.9873359" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Casa Salina, inicio"><span class="brand-mark" aria-hidden="true">S</span><span>Salina<small>Enoteca · Cartagena</small></span></a>
			<nav aria-label="Navegación principal"><a href="#restaurante">La enoteca</a><a href="#fotos">Fotos</a><a href="#visita">Cómo llegar</a></nav>
			<a class="header-call" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver ficha</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span>Santa Florentina · Cartagena</span><i aria-hidden="true"></i> Enoteca gourmet</p>
					<h1>La enoteca<br />de <em>Santa Florentina.</em></h1>
					<p class="lede">Casa Salina es la nueva enoteca gourmet del centro de Cartagena. Quesos, embutidos, salazones, vinos y vermuts de autor en Calle Santa Florentina, 20.</p>
					<div class="actions"><a class="button button-gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver ficha en Maps <span aria-hidden="true">↗</span></a><a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-details"><span>⌖ Santa Florentina, 20</span><span>✦ Vinos · salazones · quesos</span></div>
				</div>
				<figure class="hero-photo">
					<Image src={heroImage} alt="Fotografía de Casa Salina en Cartagena, publicada en su ficha de Google Maps" widths={[640, 960, 1280]} sizes="(max-width: 720px) 100vw, 47vw" format="avif" quality={70} loading="eager" fetchpriority="high" decoding="async" />
					<figcaption>Casa Salina · Cartagena</figcaption>
				</figure>
			</section>

			<div class="ticker" aria-label="Casa Salina en Cartagena"><span>Casa Salina</span><b>✳</b><span>Enoteca gourmet</span><b>✳</b><span>Santa Florentina</span><b>✳</b><span>Vinos y salazones</span></div>

			<section class="intro section-wrap" id="restaurante"><div><p class="eyebrow eyebrow-dark">Nueva en el centro de Cartagena</p><h2>Vino, salazón<br /><em>y producto de autor.</em></h2></div><div class="intro-copy"><p>Casa Salina ocupa el antiguo local textil de Calle Santa Florentina, 20, renovado con fachada negra y madera. La prensa local la describe como una enoteca de alta gastronomía con quesos, embutidos, salazones, vinos y vermuts selectos, y homenaje a la cocina de Cartagena.</p><p>¿Vas a acercarte? Es un proyecto recién abierto: revisa la ficha de Maps para confirmar horario y carta antes de ir.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Consultar la ficha y reseñas en Google Maps ↗</a></div></section>

			<section class="specialties section-wrap" aria-labelledby="specialties-title"><div class="section-heading"><p class="eyebrow eyebrow-dark">El plan: picar y brindar</p><h2 id="specialties-title">Una mesa para<br /><em>maridar.</em></h2><p>Una forma sencilla de disfrutar del producto gourmet en el centro. Consulta la selección y disponibilidad directamente en Casa Salina.</p></div>
				<div class="special-grid">
					<article class="special-card"><span class="special-icon" aria-hidden="true">❋</span><span class="card-kicker">DE AUTOR</span><h3>Quesos y embutidos</h3><p>Selección cuidada de quesos y embutidos para picar y compartir.</p></article>
					<article class="special-card card-olive"><span class="special-icon" aria-hidden="true">◉</span><span class="card-kicker">DEL LITORAL</span><h3>Salazones</h3><p>Salazones de tradición, homenaje al litoral y a la cocina cartagenera.</p></article>
					<article class="special-card card-terracotta"><span class="special-icon" aria-hidden="true">♨</span><span class="card-kicker">COPA A COPA</span><h3>Vinos y vermuts</h3><p>Vinos selectos y vermut para brindar en Santa Florentina.</p></article>
				</div><p class="menu-note">Esta descripción se basa en guías públicas del establecimiento; no sustituye a la carta vigente. Consulta platos, alérgenos y precios directamente en el local.</p>
			</section>

			<section class="photo-section" id="fotos"><div class="photo-copy"><p class="eyebrow">Casa Salina en Google Maps</p><h2>Abre la ficha.<br />Mira sus <em>fotos.</em></h2><p>Descubre las imágenes de la enoteca en Google Maps y consulta las reseñas y datos publicados por el establecimiento y sus visitantes.</p><a class="button button-gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a><p class="photo-note">Una selección de esas fotos, servida optimizada, en la galería de abajo.</p></div>
				<div class="map-photo"><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Google de Casa Salina, Calle Santa Florentina, Cartagena" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
					<noscript>
						<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
					</noscript>
				</div><a class="map-caption" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">⌖</span><span><b>Casa Salina</b><small>Santa Florentina, 20 · Ver ficha y fotos ↗</small></span></a></div>
			</section>

			<section class="visit section-wrap" id="visita"><div class="visit-copy"><p class="eyebrow eyebrow-dark">En Santa Florentina</p><h2>Nos encontramos<br /><em>en Casa Salina.</em></h2><p>La enoteca está en el eje comercial de Santa Florentina, en el antiguo local textil renovado en negro y madera. Abre indicaciones para calcular la ruta.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button button-dark" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver ficha en Maps</a></div></div>
				<div class="visit-card"><div class="visit-title"><span class="visit-icon" aria-hidden="true">⌖</span><div><p class="eyebrow eyebrow-dark">Ubicación y contacto</p><h3>Santa Florentina</h3></div></div><dl><div><dt>Dirección</dt><dd>Calle Santa Florentina, 20<br />30202 Cartagena</dd></div><div><dt>Contacto</dt><dd>Sin teléfono publicado:<br />consulta la ficha de Maps</dd></div><div><dt>Horario</dt><dd>De próxima apertura:<br />confirma en la ficha</dd></div></dl><p class="visit-note">Proyecto recién inaugurado: los horarios y la carta pueden variar en estas primeras semanas.</p><a class="visit-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Abrir ficha de Google Maps ↗</a></div>
			</section>

			<section class="faq-section section-wrap" id="preguntas"><p class="eyebrow eyebrow-dark">Preguntas frecuentes</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
			<Galeria nombre="Casa Salina" mapsUrl={mapsUrl} />
		</main>

		<footer class="footer"><div class="footer-top"><a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">S</span><span>Salina<small>Enoteca · Cartagena</small></span></a><p>Vinos y salazones<br />en Santa Florentina.</p><nav aria-label="Enlaces de Casa Salina"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Casa Salina · Cartagena</span><a href="/aviso-legal/">Aviso legal y privacidad</a> <a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a> <span>Confirma horario y carta con el establecimiento.</span></div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>
		<a class="mobile-call" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span>Santa Florentina, 20</span></a>
	</body>
</html>

<style is:global>
	:root{font-family:'DM Sans',sans-serif;color:#2c2620;background:#f6f3ea;font-synthesis:none;text-rendering:optimizeLegibility;--wine:#211a13;--wine-light:#4a3a28;--gold:#d9a960;--cream:#f6f3ea;--ink:#2c2620;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid #d9a960;outline-offset:4px}.skip-link{position:absolute;z-index:99;top:-60px;left:16px;padding:12px 16px;background:var(--gold);color:var(--wine)}.skip-link:focus{top:12px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:22px;background:var(--wine);color:#fcf8ef}.brand{display:flex;align-items:center;gap:11px;font-size:15px;font-weight:700}.brand small{display:block;margin-top:4px;color:#e1d4c5;font-size:9px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--gold);border-radius:50%;color:#e5c98c;font:700 23px var(--display)}.topbar nav{display:flex;gap:clamp(14px,2.5vw,32px);color:#f0e6dc;font-size:12px}.topbar nav a:hover,.footer a:hover{color:#e5c98c}.header-call{padding:11px 17px;border:1px solid #ffffff55;border-radius:99px;font-size:11px;font-weight:700}.hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:560px;background:var(--wine);color:#fcf8ef;overflow:hidden}.hero-copy{padding:73px 4vw 64px 9vw;align-self:center}.eyebrow{margin:0 0 19px;color:#e0c78c;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase}.eyebrow i{display:inline-block;width:22px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.section-heading h2,.photo-copy h2,.visit h2,.faq-section h2{margin:0;font:600 clamp(39px,4.8vw,64px)/1.08 var(--display);letter-spacing:-1.2px}.hero h1 em,.intro h2 em,.section-heading h2 em,.photo-copy h2 em,.visit h2 em,.faq-section h2 em{color:var(--gold);font-style:italic}.lede{max-width:475px;margin:24px 0 0;color:#e9ded3;font-size:14px;line-height:1.85}.actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:27px}.button{display:inline-flex;min-height:47px;align-items:center;justify-content:center;gap:14px;padding:0 20px;border-radius:99px;font-size:12px;font-weight:700;transition:transform .18s ease}.button:hover{transform:translateY(-2px)}.button-gold{background:var(--gold);color:var(--wine)}.button-outline{border:1px solid #ffffff65;color:#fcf8ef}.hero-details{display:flex;flex-wrap:wrap;gap:12px 22px;margin-top:27px;padding-top:20px;border-top:1px solid #ffffff2a;color:#e1d3c5;font-size:10px}.hero-details span:first-child{color:#e8cc91}.hero-photo{position:relative;margin:0;min-height:560px;overflow:hidden;background:#100c0a}.hero-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-photo figcaption{position:absolute;right:12px;bottom:12px;padding:8px 14px;border-radius:99px;background:#000000aa;color:#fcf8ef;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase}.ticker{display:flex;min-height:54px;align-items:center;justify-content:center;gap:clamp(12px,4vw,52px);padding:10px 5vw;background:var(--gold);color:var(--wine);font:600 13px var(--display)}.ticker b{font-size:12px}.section-wrap{padding:88px 9vw}.intro{display:grid;grid-template-columns:1fr .85fr;gap:9%;align-items:center;background:var(--cream)}.eyebrow-dark{margin-bottom:16px;color:#8a7355}.intro h2,.section-heading h2,.visit h2,.faq-section h2{font-size:clamp(34px,4vw,50px);color:var(--wine)}.intro h2 em,.section-heading h2 em,.visit h2 em,.faq-section h2 em{color:#b07a3f}.intro-copy p,.section-heading>p,.visit-copy>p:not(.eyebrow){color:#716760;font-size:14px;line-height:1.85}.intro-copy p{margin:0 0 14px}.text-link{display:inline-block;padding-bottom:4px;border-bottom:1px solid #b07a3f;color:#4a3826;font-size:12px;font-weight:700}.specialt