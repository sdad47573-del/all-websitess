---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import paella from '../assets/fotos/a-comer-sevilla-panoramica-06.jpg';
import fachada from '../assets/fotos/a-comer-sevilla-vertical-01.jpg';
import vitrinaGuisos from '../assets/fotos/a-comer-sevilla-vertical-02.jpg';
import vitrinaBandejas from '../assets/fotos/a-comer-sevilla-vertical-04.jpg';
import tortilla from '../assets/fotos/a-comer-sevilla-vertical-07.jpg';
import ensaladilla from '../assets/fotos/a-comer-sevilla-vertical-08.jpg';
import ensaladillaMarisco from '../assets/fotos/a-comer-sevilla-vista-5-05.jpg';
import garbanzos from '../assets/fotos/a-comer-sevilla-vista-9-09.jpg';
import bacalao from '../assets/fotos/a-comer-sevilla-cuadrada-10.jpg';
import arroz from '../assets/fotos/a-comer-sevilla-panoramica-03.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'A Comer Sevilla · Comida casera diaria para llevar';
const description =
	'A Comer Sevilla, comida casera diaria en C. Padre Damián, 15, Loc C (41011 Sevilla). Cocina tradicional de abuelos a nietos. Fotos, horario, teléfono y reseñas.';

const galeria = [
	{ src: fachada, alt: 'Fachada de A Comer Sevilla con el rótulo blanco y las macetas en la puerta' },
	{ src: vitrinaGuisos, alt: 'Vitrina de A Comer con bandejas de albóndigas en salsa, potaje y ensaladilla' },
	{ src: vitrinaBandejas, alt: 'Bandejas de carnes y guisos preparados en la vitrina del local' },
	{ src: ensaladillaMarisco, alt: 'Ensaladilla de marisco con gambas, mejillones y palitos de cangrejo' },
	{ src: garbanzos, alt: 'Garbanzos guisados con carne y morcilla en un plato' },
	{ src: bacalao, alt: 'Lomos de bacalao con guisantes en una bandeja de horno' },
	{ src: tortilla, alt: 'Tortilla de patata cuajada sobre un plato' },
	{ src: ensaladilla, alt: 'Ensaladilla rusa y otra bandeja de picadillo en la vitrina' },
	{ src: arroz, alt: 'Primer plano de arroz con carne, guisantes y pimiento' },
	{ src: paella, alt: 'Paella con limones en la paellera, recién hecha' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Oferta de A Comer Sevilla',
	inLanguage: 'es-ES',
	description: 'Selección orientativa basada en la presentación del negocio y las fotografías públicas; no es una carta oficial.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#a-comer-sevilla`,
	name: BUSINESS.name,
	alternateName: ['A Comer', 'A Comer Sevilla comida para llevar'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34954037594',
	servesCuisine: ['Comida casera', 'Cocina tradicional', 'Comida para llevar'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Oferta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&family=Sora:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="A Comer Sevilla, comida casera Sevilla, comida para llevar Sevilla, Padre Damián 15, menú del día Sevilla"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera diaria para llevar en C. Padre Damián, 15, Loc C, Sevilla. De 11:00 a 15:00 de lunes a sábado. Consulta el menú por teléfono."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Paella de A Comer Sevilla con limones en la paellera"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#2f6b4f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Sevilla"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[paella]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="A Comer"
			subtitle="Comida casera · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Comida casera, <br /><em>de siempre.</em>"
				lede={`A Comer Sevilla cocina a diario recetas que «han pasado de abuelos a nietos». La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas. Llama para saber el menú del día.`}
				image={paella}
				imageAlt="Paella con limones en la paellera, preparada en A Comer Sevilla"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver ficha en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Tipo', html: '<b>Comida para llevar</b>' },
					{ label: 'Valoración', html: `<b>${RATING.label}</b> · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '11:00–15:00, <b>L a S</b>' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver fotos y ficha"
				tag="Comida para llevar"
			/>

			<LocalChips label="Servicios y oferta de A Comer Sevilla" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="De abuelos <br /><em>a nietos.</em>"
				paragraphs={[
					'En la calle Padre Damián, 15 (local C), A Comer Sevilla prepara cada día comida casera para llevar. El negocio se presenta en Google como cocina tradicional que ha pasado «de abuelos a nietos», con la idea de no perder las costumbres de siempre.',
					'La ficha no publica carta ni precios, pero las fotografías del perfil muestran la vitrina del local: guisos de cuchara, ensaladillas, albóndigas en salsa, tortilla de patata, bacalao con guisantes y arroces. La oferta cambia según el día.',
					'Las reseñas insisten en tres cosas: el sabor casero, las raciones generosas y unos precios económicos. Es comida pensada para llevar a casa o al trabajo.',
				]}
				note="La ficha de Google no incluye carta ni lista de precios. Los platos que se citan en esta página son los que aparecen en las fotografías del propio establecimiento y en su presentación; confirma disponibilidad y precios por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotografías', href: '#galeria' },
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<ul class="highlights">
				{
					HIGHLIGHTS.map((item) => (
						<li>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</li>
					))
				}
			</ul>

			<LocalMenu
				eyebrow="Lo que se ve en la vitrina"
				title="Guisos, arroces <br /><em>y ensaladillas.</em>"
				description="La ficha no trae carta, así que esta selección se basa en las fotografías del perfil del local y en cómo se presenta el negocio en Google. No sustituye al menú del día."
				cta={{ label: `Consultar el menú · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Los platos de las fotografías pueden no estar todos los días. No se publican precios porque la ficha no los indica; pregunta por teléfono antes de ir."
			/>

			<LocalGallery
				eyebrow="Fotos del perfil de Google Maps"
				title="Así se ve <br /><em>A Comer.</em>"
				description="La fachada, la vitrina y diez platos caseros fotografiados en el propio establecimiento."
				images={galeria}
				cta={{ label: 'Abrir la ficha en Google Maps', href: MAPS.place }}
				note="Imágenes descargadas del perfil público de A Comer Sevilla en Google Maps y servidas desde esta página."
			/>

			<section class="notas" aria-labelledby="notas-title">
				<div class="wrap notas-grid">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="notas-title">Lo que cuentan <em>las reseñas.</em></h2>
						<p class="notas-score">
							<strong>{RATING.label}</strong>
							<span>
								<b>★★★★★</b>
								{RATING.count} reseñas<br />en Google
							</span>
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer reseñas en Google ↗
						</a>
					</div>

					<div class="notas-copy">
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>{resena.texto}</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Opinión en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<p class="notas-foot">
							La valoración y el número de reseñas corresponden a la ficha consultada en octubre
							de 2026 y pueden variar. <a href={MAPS.reviews} target="_blank" rel="noreferrer"
								>Consulta las opiniones actualizadas en Google ↗</a
							>.
						</p>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Padre <br /><em>Damián.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO}
				hoursCaption="Horario de la ficha"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de A Comer Sevilla en C. Padre Damián, 15, Sevilla"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. Padre Damián, 15 · Sevilla"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="La ficha no ofrece reservas ni pedidos en línea: el encargo se hace por teléfono. Es un local de comida para llevar, así que confirma también si el día que vas a ir hay menú."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>encargar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma horario, menú y disponibilidad con el establecimiento."
			ctaLabel="Llamar a A Comer"
			navAriaLabel="Enlaces de A Comer Sevilla"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
