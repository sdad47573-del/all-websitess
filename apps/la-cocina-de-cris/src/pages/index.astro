---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/la-cocina-de-cris-cuadrada-01.jpg';
import bacalao from '../assets/fotos/la-cocina-de-cris-apaisada-02.jpg';
import ensalada from '../assets/fotos/la-cocina-de-cris-apaisada-03.jpg';
import arrozNegro from '../assets/fotos/la-cocina-de-cris-apaisada-04.jpg';
import brocoli from '../assets/fotos/la-cocina-de-cris-cuadrada-05.jpg';
import fideua from '../assets/fotos/la-cocina-de-cris-apaisada-06.jpg';
import calle from '../assets/fotos/la-cocina-de-cris-apaisada-07.jpg';
import paella from '../assets/fotos/la-cocina-de-cris-apaisada-08.jpg';
import croquetas from '../assets/fotos/la-cocina-de-cris-apaisada-09.jpg';
import empanadas from '../assets/fotos/la-cocina-de-cris-apaisada-10.jpg';

import { BUSINESS, ENCARGOS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'La Cocina de Cris · Comida casera para llevar en Málaga';
const description =
	'La Cocina de Cris, en C. Ntra. Sra. de las Candelas, 24 (29004 Málaga). Comida casera para llevar, paellas y empanadas por encargo. De martes a domingo, mediodía.';

const galeria = [
	{
		src: calle,
		alt: 'La fachada de La Cocina de Cris en la calle, con el rótulo amarillo, el toldo de comida casera y el escaparate del local',
	},
	{
		src: paella,
		alt: 'Paella amarilla con verduras y tiras de pimiento rojo, rodeada de gajos de limón',
	},
	{
		src: empanadas,
		alt: 'Bandeja de empanadas gallegas recién hechas, con una pinza de servir',
	},
	{
		src: croquetas,
		alt: 'Croquetas caseras apiladas en un plato blanco sobre una mesa de madera',
	},
	{
		src: arrozNegro,
		alt: 'Arroz negro con pimientos rojos asados y limón en la paellera',
	},
	{
		src: fideua,
		alt: 'Fideuá de fideos finos con gambas y trozos de verdura',
	},
	{
		src: bacalao,
		alt: 'Lomos de bacalao en salsa de tomate con láminas de ajo doradas',
	},
	{
		src: ensalada,
		alt: 'Ensalada de brotes verdes con mango, queso feta y nueces en una fuente blanca',
	},
	{
		src: brocoli,
		alt: 'Brócoli salteado con láminas de ajo crujiente',
	},
	{
		src: fachada,
		alt: 'La entrada de La Cocina de Cris con la pizarra de tiza y la vitrina de comida casera al fondo',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de La Cocina de Cris',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-cocina-de-cris`,
	name: BUSINESS.name,
	alternateName: ['La Cocina de Cris Food', 'Cocina de Cris Málaga'],
	description:
		'Comida casera para llevar y encargos para eventos en la calle Ntra. Sra. de las Candelas, 24, local 4 (Carretera de Cádiz, 29004 Málaga). Paellas, empanadas y platos elaborados por encargo.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, MAPS.facebook],
	telephone: '+34951080918',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Paellas', 'Empanadas'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Tuesday',
			opens: '11:30',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday'],
			opens: '11:00',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '11:00',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Encargos', href: '#encargos' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#232e1e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Karla:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Cocina de Cris, comida casera Málaga, comida para llevar Málaga, paellas por encargo Málaga, empanadas Málaga, catering Málaga, Carretera de Cádiz, Candelas 24"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar y encargos para eventos en Carretera de Cádiz, Málaga. Paellas, empanadas y platos elaborados por encargo."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Paella amarilla con verduras y pimientos de La Cocina de Cris, en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#232e1e"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Cocina de Cris"
			subtitle="Comida casera · Carretera de Cádiz"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Ntra. Sra. de las Candelas, 24 · Málaga"
				title="Comida casera, <br /><em>para llevar.</em>"
				lede={`En La Cocina de Cris se cocina lo de casa y se sirve para llevar, en la Carretera de Cádiz. Hay comida del día, empanadas, paellas por encargo y platos para eventos. Abre de martes a domingo, a mediodía, y tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={fachada}
				imageAlt="Fachada de La Cocina de Cris con el rótulo amarillo, el toldo de comida casera para llevar y la pizarra en la puerta"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>Mediodía</b> · lunes cerrado' },
					{ label: 'Encargos', html: '<b>48 h</b> para tu receta' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Comida casera & por encargo"
			/>

			<LocalChips label="Lo que ofrece La Cocina de Cris" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="La cocina de casa, <br /><em>en la Carretera de Cádiz.</em>"
				paragraphs={[
					'La Cocina de Cris está en la calle Ntra. Sra. de las Candelas, 24, local 4, en la zona de Carretera de Cádiz. La fachada de madera y el rótulo amarillo anuncian lo mismo que el toldo: comida casera para llevar y por encargo.',
					'Detrás del mostrador hay una vitrina con los platos del día y una cocina que trabaja por encargo. La ficha del negocio lo resume así: «preparamos una gran cantidad de recetas distintas, pero si tu preferida no está entre ellas puedes llamarnos con 48 h y te la preparamos».',
					'La casa también cocina para eventos: paellas, empanadas y platos elaborados salen del local para celebraciones y comidas de grupo. Las reseñas de Google lo confirman: «ricas empanadas y paellas por encargo», «platos muy elaborados y sabrosos».',
					'Google la clasifica como restaurante de comida para llevar y reúne 163 opiniones con una media de 4,7 sobre 5. Todo se consulta y se encarga por teléfono.',
				]}
				note="La ficha no publica carta ni precios. Esta web solo cita las preparaciones que nombran la descripción del negocio y las reseñas, y enlaza el teléfono y el Facebook que aparecen en la propia ficha."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Facebook de La Cocina de Cris', href: MAPS.facebook, external: true },
				]}
			/>

			<section class="encargos" id="encargos" aria-labelledby="encargos-title">
				<div class="wrap">
					<div class="encargos-head">
						<div>
							<p class="section-label section-label-light"><span aria-hidden="true"></span> Encargos</p>
							<h2 id="encargos-title">Se encarga <br /><em>por teléfono.</em></h2>
						</div>
						<p>
							No hay tienda online ni reservas por la web. La ficha publica un teléfono y una
							antelación para las recetas que no están en el día a día.
						</p>
					</div>

					<ol class="encargos-grid">
						{
							ENCARGOS.map((paso, index) => (
								<li class="encargo-card">
									<span aria-hidden="true">0{index + 1}</span>
									<h3>{paso.title}</h3>
									<p>{paso.text}</p>
								</li>
							))
						}
					</ol>

					<p class="encargos-foot">
						Las recetas, los precios y la disponibilidad se consultan en el{' '}
						<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>. La web no publica una carta porque
						la ficha no la incluye.
					</p>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Lo que sale <br /><em>de la cocina.</em>"
				description="Sin carta publicada: esto es lo que nombran la descripción del negocio y las reseñas de Google. El resto cambia cada día."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La ficha de Google no incluye carta ni precios, así que esta página no inventa valores. Para saber qué hay hoy, qué incluye cada ración y cuánto cuesta, hay que llamar al teléfono del local."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La fachada <br /><em>y los platos.</em>"
				description="Diez fotografías del perfil de La Cocina de Cris en Google Maps: la fachada con el rótulo amarillo, las paellas, el arroz negro, la fideuá, las empanadas, las croquetas y los platos caseros."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="opiniones" aria-labelledby="opiniones-title">
				<div class="wrap opiniones-grid">
					<div>
						<p class="section-label section-label-light"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="opiniones-title">Buen trato <br /><em>y buena mesa.</em></h2>
						<p class="opiniones-score">
							<strong>{RATING.label}</strong>
							<span>
								<b>★★★★★</b>
								{RATING.count} reseñas<br />en Google
							</span>
						</p>
						<p class="opiniones-link">
							<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
								Ver todas las reseñas ↗
							</a>
						</p>
					</div>

					<ul class="reviews">
						{
							RESENAS.map((resena) => (
								<li>
									<p>«{resena.texto}»</p>
									<span aria-label={`${resena.valor} de 5 estrellas`}>
										{'★'.repeat(resena.valor)}
										{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
									</span>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Carretera <br /><em>de Cádiz.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: martes de 11:30 a 15:30; miércoles a viernes de 11:00 a 15:30; sábado y domingo de 11:00 a 16:00; lunes cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de La Cocina de Cris en la calle Ntra. Sra. de las Candelas, 24, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Candelas, 24 · local 4"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Facebook', href: MAPS.facebook, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Encargos y consultas por teléfono: la ficha no publica reservas online. Google marca el acceso para sillas de ruedas, pero no hay aparcamiento adaptado ni asientos adaptados."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>encargar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Facebook ↗', href: MAPS.facebook, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma disponibilidad, precios y horario antes de la visita."
			ctaLabel="Llamar a La Cocina de Cris"
			navAriaLabel="Enlaces de La Cocina de Cris"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
