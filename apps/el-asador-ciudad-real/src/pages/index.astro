---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import asador from '../assets/fotos/el-asador-ciudad-real-apaisada-01.jpg';
import bandejaPollo from '../assets/fotos/el-asador-ciudad-real-apaisada-02.jpg';
import cartelPrecios from '../assets/fotos/el-asador-ciudad-real-apaisada-03.jpg';
import padron from '../assets/fotos/el-asador-ciudad-real-apaisada-04.jpg';
import tapa from '../assets/fotos/el-asador-ciudad-real-apaisada-05.jpg';
import fachada from '../assets/fotos/el-asador-ciudad-real-apaisada-06.jpg';
import rotulo from '../assets/fotos/el-asador-ciudad-real-apaisada-07.jpg';
import croquetas from '../assets/fotos/el-asador-ciudad-real-apaisada-08.jpg';
import patatas from '../assets/fotos/el-asador-ciudad-real-apaisada-09.jpg';
import elaboracion from '../assets/fotos/el-asador-ciudad-real-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'El Asador · Pollos asados, croquetas y patatas en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: asador,
		alt: 'Asador de El Asador con hileras de pollos dorándose, unos dentro y otros en la vitrina caliente',
	},
	{
		src: bandejaPollo,
		alt: 'Bandeja de aluminio con patatas fritas y un cuarto de pollo asado, recién servida en el mostrador',
	},
	{
		src: padron,
		alt: 'Ración de pimientos de Padrón fritos con sal gruesa en una bandeja blanca',
	},
	{
		src: croquetas,
		alt: 'Bandeja de aluminio con croquetas caseras recién fritas sobre la mesa de acero',
	},
	{
		src: patatas,
		alt: 'Fuente grande de patatas fritas con sal, recién hechas',
	},
	{
		src: cartelPrecios,
		alt: 'Cartel de precios de El Asador II: pollo 9 €, medio pollo 4,70 €, patatas, pimientos, croquetas, tortillas, pan y salsa',
	},
	{
		src: fachada,
		alt: 'Escaparate de El Asador en la calle Pedrera Alta, con la puerta de cristal y las cortinas amarillas',
	},
	{
		src: rotulo,
		alt: 'Fachada de la esquina del local, con el toldo a rayas y el rótulo de El Asador II sobre la entrada de cortinas de tiras',
	},
	{
		src: tapa,
		alt: 'Tapa de aluminio de un envase de El Asador con la foto de un pollo asado y la palabra ENDAL',
	},
	{
		src: elaboracion,
		alt: 'Tortilla de patatas entera, redonda y dorada, recién hecha sobre una bandeja metálica en la cocina',
	},
];

const carta = [
	{
		title: 'Pollo asado',
		items: [
			{ name: 'Pollo', note: 'entero, recién sacado del asador', price: '9,00 €' },
			{ name: '½ pollo', note: 'medio pollo por raciones', price: '4,70 €' },
			{ name: 'Pollo + pan', note: 'precio de fines de semana y fiestas', price: '9,80 €' },
		],
	},
	{
		title: 'Para acompañar',
		items: [
			{ name: 'Patatas', note: 'ración', price: '3,00 €' },
			{ name: '½ patatas', note: 'media ración', price: '1,50 €' },
			{ name: 'Pimientos', note: 'fritos y con sal', price: '1,50 €' },
			{ name: 'Croquetas', note: 'ración', price: '5,00 €' },
			{ name: '½ croquetas', note: 'media ración', price: '2,60 €' },
			{ name: 'Tortillas', note: 'de la casa, fines de semana y fiestas', price: '2,50 €' },
			{ name: 'Pan', note: 'por unidad', price: '1,00 €' },
			{ name: 'Salsa', note: 'para el pollo', price: '0,50 €' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-asador`,
	name: BUSINESS.name,
	alternateName: ['El Asador II', 'El Asador Ciudad Real', 'Pollería El Asador'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Pollería'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Ciudad Real' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Código', value: '/g/12qfzg443' },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '11:00',
			closes: '14:30',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '11:00', closes: '15:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '11:00', closes: '15:00' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Entrada adaptada', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"el-asador-ciudad-real-apaisada-01.jpg": asador,
	"el-asador-ciudad-real-apaisada-02.jpg": bandejaPollo,
	"el-asador-ciudad-real-apaisada-04.jpg": padron,
	"el-asador-ciudad-real-apaisada-08.jpg": croquetas,
	"el-asador-ciudad-real-apaisada-09.jpg": patatas,
	"el-asador-ciudad-real-apaisada-03.jpg": cartelPrecios,
	"el-asador-ciudad-real-apaisada-06.jpg": fachada,
	"el-asador-ciudad-real-apaisada-07.jpg": rotulo,
	"el-asador-ciudad-real-apaisada-05.jpg": tapa,
	"el-asador-ciudad-real-vertical-10.jpg": elaboracion,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1a1410" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,700&family=Nunito+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Asador Ciudad Real, pollos asados Ciudad Real, pollería Pedrera Alta, croquetas caseras Ciudad Real, pollo para llevar 13003, El Asador II, asador de pollos Ciudad Real, Pedrera Alta 38"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollos asados, croquetas caseras y patatas fritas en la calle Pedrera Alta, 38, ciudad Real. De 11:00 a 14:30, sábados hasta las 15:30 y domingos hasta las 15:00; lunes cerrado. Pedidos en el 926 25 09 26."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="El Asador, pollería con pollos asados en Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1a1410"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CR"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[asador]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Asador"
			subtitle="Pollería · Ciudad Real"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="El Asador"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos, horario y fotografías tomados de la ficha y del perfil públicos del local en Google Maps, consultados en noviembre de 2026. Sin carta ni precios publicados: confirma horario y disponibilidad antes de ir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de El Asador"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34926250926?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Pollo." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Pollo"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
