---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import asador from '../assets/fotos/el-asador-ciudad-real-apaisada-01.jpg';
import bandejaPollo from '../assets/fotos/el-asador-ciudad-real-apaisada-02.jpg';
import cartelPrecios from '../assets/fotos/el-asador-ciudad-real-apaisada-03.jpg';
import padron from '../assets/fotos/el-asador-ciudad-real-apaisada-04.jpg';
import tapa from '../assets/fotos/el-asador-ciudad-real-apaisada-05.jpg';
import fachada from '../assets/fotos/el-asador-ciudad-real-apaisada-06.jpg';
import rotulo from '../assets/fotos/el-asador-ciudad-real-apaisada-07.jpg';
import croquetas from '../assets/fotos/el-asador-ciudad-real-apaisada-08.jpg';
import patatas from '../assets/fotos/el-asador-ciudad-real-apaisada-09.jpg';
import elaboracion from '../assets/fotos/el-asador-ciudad-real-vertical-10.jpg';

import { BUSINESS, FAQ, HORARIO, HORARIO_AVISO, MAPS, RESENAS, SERVICIOS } from '../data/site';

const title = 'El Asador · Pollos asados, croquetas y patatas en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: asador,
		alt: 'Asador de El Asador con hileras de pollos dorándose, unos dentro y otros en la vitrina caliente',
	},
	{
		src: bandejaPollo,
		alt: 'Bandeja de aluminio con patatas fritas y un cuarto de pollo asado, recién servida en el mostrador',
	},
	{
		src: padron,
		alt: 'Ración de pimientos de Padrón fritos con sal gruesa en una bandeja blanca',
	},
	{
		src: croquetas,
		alt: 'Bandeja de aluminio con croquetas caseras recién fritas sobre la mesa de acero',
	},
	{
		src: patatas,
		alt: 'Fuente grande de patatas fritas con sal, recién hechas',
	},
	{
		src: cartelPrecios,
		alt: 'Cartel de precios de El Asador II: pollo 9 €, medio pollo 4,70 €, patatas, pimientos, croquetas, tortillas, pan y salsa',
	},
	{
		src: fachada,
		alt: 'Escaparate de El Asador en la calle Pedrera Alta, con la puerta de cristal y las cortinas amarillas',
	},
	{
		src: rotulo,
		alt: 'Fachada de la esquina del local, con el toldo a rayas y el rótulo de El Asador II sobre la entrada de cortinas de tiras',
	},
	{
		src: tapa,
		alt: 'Tapa de aluminio de un envase de El Asador con la foto de un pollo asado y la palabra ENDAL',
	},
	{
		src: elaboracion,
		alt: 'Tortilla de patatas entera, redonda y dorada, recién hecha sobre una bandeja metálica en la cocina',
	},
];

const carta = [
	{
		title: 'Pollo asado',
		items: [
			{ name: 'Pollo', note: 'entero, recién sacado del asador', price: '9,00 €' },
			{ name: '½ pollo', note: 'medio pollo por raciones', price: '4,70 €' },
			{ name: 'Pollo + pan', note: 'precio de fines de semana y fiestas', price: '9,80 €' },
		],
	},
	{
		title: 'Para acompañar',
		items: [
			{ name: 'Patatas', note: 'ración', price: '3,00 €' },
			{ name: '½ patatas', note: 'media ración', price: '1,50 €' },
			{ name: 'Pimientos', note: 'fritos y con sal', price: '1,50 €' },
			{ name: 'Croquetas', note: 'ración', price: '5,00 €' },
			{ name: '½ croquetas', note: 'media ración', price: '2,60 €' },
			{ name: 'Tortillas', note: 'de la casa, fines de semana y fiestas', price: '2,50 €' },
			{ name: 'Pan', note: 'por unidad', price: '1,00 €' },
			{ name: 'Salsa', note: 'para el pollo', price: '0,50 €' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-asador`,
	name: BUSINESS.name,
	alternateName: ['El Asador II', 'El Asador Ciudad Real', 'Pollería El Asador'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Pollería'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Ciudad Real' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Código', value: '/g/12qfzg443' },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '11:00',
			closes: '14:30',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '11:00', closes: '15:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '11:00', closes: '15:00' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Entrada adaptada', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1a1410" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,700&family=Nunito+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Asador Ciudad Real, pollos asados Ciudad Real, pollería Pedrera Alta, croquetas caseras Ciudad Real, pollo para llevar 13003, El Asador II, asador de pollos Ciudad Real, Pedrera Alta 38"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollos asados, croquetas caseras y patatas fritas en la calle Pedrera Alta, 38, ciudad Real. De 11:00 a 14:30, sábados hasta las 15:30 y domingos hasta las 15:00; lunes cerrado. Pedidos en el 926 25 09 26."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="El Asador, pollería con pollos asados en Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1a1410"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CR"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[asador]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Asador"
			subtitle="Pollería · Ciudad Real"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="Pollos asados <br /><em>de barrio.</em>"
				lede="El Asador es una pollería de toda la vida en la calle Pedrera Alta, 38, bajo, en Ciudad Real. Pollos dorándose en el asador, croquetas caseras, patatas y pimientos de Padrón, para recoger y llevar. Abre de 11:00 a 14:30, sábados hasta las 15:30 y domingos hasta las 15:00, con el lunes cerrado. Pedidos en el 926 25 09 26."
				image={asador}
				imageAlt="Asador de El Asador con hileras de pollos dorándose, unos dentro y otros en la vitrina caliente"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,2</b> en Google · 153 reseñas' },
					{ label: 'Horario', html: '<b>11:00–14:30</b><br />Lunes cerrado · solo mediodía' },
					{ label: 'Pedidos', html: `<b>${BUSINESS.phone}</b> para llevar y por encargo` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de El Asador" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="El asador <br /><em>de la esquina.</em>"
				paragraphs={[
					'El local está en la calle Pedrera Alta, 38, bajo, en el barrio de Ciudad Real, con el rótulo rojo de El Asador II en la esquina y un toldo a rayas sobre la puerta. Dentro, el asador manda: hileras de pollos dorándose a la vista y la vitrina caliente al lado, para que el pollo salga del fuego y se envuelva sin espera.',
					'La ficha de Google lo clasifica como pollería. En las fotos de su perfil aparecen los pollos del asador, la bandeja de aluminio con pollo y patatas, las croquetas caseras recién fritas, las fuentes de patatas, los pimientos fritos con sal y el cartel de la casa: pollo entero a 9 €, medio pollo a 4,70 €, patatas a 3 €, croquetas a 5 € y tortillas a 2,50 € los fines de semana y fiestas.',
					'El horario es de mediodía: de 11:00 a 14:30 de martes a viernes, sábados hasta las 15:30 y domingos hasta las 15:00. Los lunes cierra, y la propia ficha avisa de que en el Día de Todos los Santos el horario podría ser distinto.',
					'La ficha tiene 153 reseñas y una media de 4,2. Las tres que Google destaca son de cinco estrellas: elogian el pollo, las croquetas, la atención en el mostrador y la relación entre calidad y servicio.',
				]}
				note="La ficha de Google no publica carta en su texto, pero en el perfil hay una foto del cartel del propio local con los precios: son los que figuran en esta página. Si cambian, manda el mostrador."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Pollo, croquetas <br /><em>y patatas.</em>"
				description="La carta del cartel de la casa: el pollo entero a 9 €, el medio a 4,70 €, y las patatas, pimientos, croquetas y tortillas que salen de la freidora."
				cta={{ label: 'Ver la carta en Google Maps', href: MAPS.place }}
				groups={carta}
				note="Precios copiados del cartel de El Asador II que aparece en las fotos del perfil de Google Maps del local: pollo 9 €, medio pollo 4,70 €, patatas 3 €, croquetas 5 €, tortillas 2,50 €, pan 1 € y salsa 0,50 €. Pueden cambiar; se confirman en el mostrador o en el 926 25 09 26."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
					<div class="reviews-head">
						<h2 id="resenas-title">Muy ricos, <br /><em>y bien fritos.</em></h2>
						<p>
							La ficha tiene 153 reseñas y una media de 4,2. Estas son las tres que Google destaca, todas
							de cinco estrellas, con la puntuación que les dio su autor.
						</p>
					</div>
					<div class="review-grid">
						{
							RESENAS.map((review) => (
								<figure class="review-card">
									<p class="review-stars" aria-label={`${review.rating} sobre 5`}>
										{'★'.repeat(review.rating)}
										<span aria-hidden="true">{'★'.repeat(5 - review.rating)}</span>
									</p>
									<blockquote>{review.quote}</blockquote>
									<figcaption>Reseña publicada en Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="review-note">
						Citas de las reseñas públicas del local, con la puntuación del autor. En la ficha de Google
						están todas, incluidas las que puntúan por debajo.
					</p>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Del asador <br /><em>a la bandeja.</em>"
				description="Diez fotos del perfil del local: los pollos en el asador, la bandeja con patatas, las croquetas, los pimientos de Padrón, las patatas fritas y la fachada de la calle Pedrera Alta."
				images={galeria}
				cta={{ label: 'Ver todas en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="A la hora <br /><em>de comer.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Ciudad Real · España']}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de El Asador en la calle Pedrera Alta, 38, Ciudad Real"
				mapEmbedUrl={MAPS.embed}
				mapLabel="El Asador"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Pedidos: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="Se pide en el mostrador o por teléfono y se recoge: es pollería, para llevar. Para encargar varios pollos conviene llamar con antelación al 926 25 09 26. La ficha marca entrada adaptada, pero no aparcamiento ni asientos adaptados. Esta página no tramita pedidos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="El Asador"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos, horario y fotografías tomados de la ficha y del perfil públicos del local en Google Maps, consultados en noviembre de 2026. Sin carta ni precios publicados: confirma horario y disponibilidad antes de ir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de El Asador"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
