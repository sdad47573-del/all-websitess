---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import terraza from '../assets/fotos/restaurante-la-cabana-del-jerte-apaisada-01.jpg';
import migas from '../assets/fotos/restaurante-la-cabana-del-jerte-vertical-05.jpg';
import quesoFrito from '../assets/fotos/restaurante-la-cabana-del-jerte-vertical-03.jpg';
import carne from '../assets/fotos/restaurante-la-cabana-del-jerte-vertical-04.jpg';
import pulpo from '../assets/fotos/restaurante-la-cabana-del-jerte-apaisada-06.jpg';
import plaza from '../assets/fotos/restaurante-la-cabana-del-jerte-apaisada-07.jpg';
import torta from '../assets/fotos/restaurante-la-cabana-del-jerte-vertical-09.jpg';
import carnes from '../assets/fotos/restaurante-la-cabana-del-jerte-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const reviews = BUSINESS.reviewsCount.toLocaleString('es-ES');

const description =
	'Restaurante La Cabaña del Jerte, cocina extremeña en la Avenida Ramón y Cajal, 17 (Jerte, Cáceres). Migas con huevo, torta del Casar, ensaladas y carnes a la plancha. Comidas y cenas de jueves a martes. Reservas en el 645 23 39 53.';

const galeria = [
	{ src: migas, alt: 'Migas extremeñas con huevo frito y pimentón en La Cabaña del Jerte' },
	{ src: torta, alt: 'Torta del Casar fundida con pimentón y tostadas en La Cabaña del Jerte' },
	{ src: quesoFrito, alt: 'Queso frito con salsa dulce en La Cabaña del Jerte, Cáceres' },
	{ src: carne, alt: 'Carne a la plancha con patatas y ensalada en La Cabaña del Jerte' },
	{ src: carnes, alt: 'Chuletón y pinchos a la plancha con patatas y tomate en La Cabaña del Jerte' },
	{ src: pulpo, alt: 'Ensalada de pulpo con tomate de La Cabaña del Jerte' },
	{ src: plaza, alt: 'Plaza de Jerte al anochecer, junto a La Cabaña del Jerte' },
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['La Cabaña del Jerte', 'La Cabaña Jerte', 'Restaurante La Cabaña del Jerte'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 645 23 39 53',
	priceRange: BUSINESS.priceRange,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Extremeña', 'Española', 'Cocina casera'],
	areaServed: [
		{ '@type': 'AdministrativeArea', name: 'Valle del Jerte' },
		{ '@type': 'City', name: 'Jerte' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId }],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:30',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '22:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza cubierta', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Reserva por teléfono', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El restaurante', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'La Cabaña del Jerte · Cocina extremeña en el Valle del Jerte (Cáceres)';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#35503a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.shortName}
			description={description}
			keywords="La Cabaña del Jerte, restaurante Jerte, comer en Jerte, Valle del Jerte restaurante, cocina extremeña, migas Jerte, torta del Casar, chuletón Valle del Jerte, Avenida Ramón y Cajal Jerte"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="La Cabaña del Jerte · Cocina extremeña en el Valle del Jerte"
			ogDescription="Migas con huevo, torta del Casar, ensaladas y carnes a la plancha en la avenida de Jerte. Terraza cubierta. 4,4 en Google con 2.158 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Terraza con mesas de La Cabaña del Jerte, en el Valle del Jerte"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.shortName}
			themeColor="#35503a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			postalCode={BUSINESS.postalCode}
			phone="+34645233953"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[terraza]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Cabaña del Jerte"
			subtitle="Cocina extremeña · Jerte"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. Ramón y Cajal · Jerte"
				title="Migas y brasa<br /><em>en el Valle del Jerte.</em>"
				lede={`Migas con huevo, torta del Casar fundida, ensaladas y carnes a la plancha en la avenida de Jerte, con terraza cubierta. Comidas y cenas de jueves a martes. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={terraza}
				imageAlt="Terraza cubierta con mesas y toldos de La Cabaña del Jerte, en Jerte"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${reviews} reseñas)` },
					{ label: 'Horario', html: 'Jue–Mar · 13:30 y 20:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phoneDisplay}</b>` },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece La Cabaña del Jerte" items={SERVICIOS} />

			<LocalAbout
				label="El restaurante"
				title="Migas, quesos<br /><em>y valle.</em>"
				paragraphs={[
					`La Cabaña del Jerte está en la Avenida Ramón y Cajal, 17, en Jerte (${BUSINESS.postalCode}, Cáceres), a pie de la carretera que sube al valle. Terraza cubierta con toldos y mesas de mantel, y comedor dentro.`,
					'La cocina es extremeña y sin prisas: migas con huevo y pimentón, torta del Casar fundida, queso frito con salsa dulce, croquetas y ensaladas —la gourmet y la de naranja salen en las reseñas—. De la plancha, chuletón, chuletas y pinchos con patatas.',
					'La ficha de Google no publica carta ni precios, así que aquí no se inventan: esta web resume lo que se ve en sus fotos y lo que cuentan sus clientes. Para precios y disponibilidad se llama al restaurante.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${reviews} opiniones en Google. Se repiten las migas, el queso frito, el chuletón y la ensalada de naranja, y el servicio «rápido y amigable».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.cid, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Migas, quesos<br /><em>y carnes a la plancha.</em>"
				description="Resumen de lo que se sirve, sacado de las fotos de la ficha de Google Maps y de las reseñas. No es la carta completa ni tiene precios: se consultan en el restaurante."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La carta cambia con el mercado y la temporada —en época de cerezas hay más gente—. Si vas por un plato concreto, llama antes: no publicamos precios porque el restaurante no los tiene publicados."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La terraza<br /><em>y la mesa.</em>"
				description="Estas fotografías proceden del perfil de La Cabaña del Jerte en Google Maps: la terraza, las migas, la torta del Casar, las carnes y una vista de la plaza de Jerte."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Nos vemos<br /><em>en la avenida.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: dos servicios, comidas de 13:30 a 15:30 y cenas de 20:00 a 22:00, de jueves a martes. El miércoles cierra."
				mapTitle="Mapa de La Cabaña del Jerte en la Avenida Ramón y Cajal, 17, Jerte (Cáceres)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Cabaña del Jerte"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva llamando al restaurante. La ficha de Google marca acceso, aseo y asientos adaptados, y las fotos muestran terraza cubierta; para grupos grandes conviene avisar con tiempo."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="La Cabaña del Jerte"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.cid, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a La Cabaña del Jerte"
		/>
	</body>
</html>
