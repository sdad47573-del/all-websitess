---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import terraza from '../assets/fotos/bar-restaurant-la-cabaneta-terraza.jpg';
import coca from '../assets/fotos/bar-restaurant-la-cabaneta-coca.jpg';
import parrilladaPlato from '../assets/fotos/bar-restaurant-la-cabaneta-parrillada-plato.jpg';
import pollo from '../assets/fotos/bar-restaurant-la-cabaneta-pollo.jpg';
import hamburguesa from '../assets/fotos/bar-restaurant-la-cabaneta-hamburguesa.jpg';
import parrilladaSarten from '../assets/fotos/bar-restaurant-la-cabaneta-parrillada-sarten.jpg';
import calcots from '../assets/fotos/bar-restaurant-la-cabaneta-calcots.jpg';
import bocadillo from '../assets/fotos/bar-restaurant-la-cabaneta-bocadillo.jpg';
import calamares from '../assets/fotos/bar-restaurant-la-cabaneta-calamares.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Bar Restaurant La Cabaneta · Parrilla y menú diario en Canillo';
const description =
	'Bar Restaurant La Cabaneta, Carretera General 2, 75 (AD100 Canillo). Parrilla con pollo, costillas y calçots, y menú diario, bocadillos y tapas. Terraza de madera. 4,3 sobre 5 con 660 reseñas. Todos los días, 12:00–24:00.';

const galeria = [
	{
		src: coca,
		alt: 'Coca de fruta confitada y piñones sobre una bandeja dorada, con el cartel de madera de La Cabaneta detrás',
	},
	{
		src: parrilladaPlato,
		alt: 'Plato de parrillada con costillas, pollo, butifarra, ensalada rusa, patata al horno y verduras',
	},
	{
		src: pollo,
		alt: 'Medio pollo a la brasa con patatas fritas y pimientos de Padrón en un plato azul',
	},
	{
		src: hamburguesa,
		alt: 'Hamburguesa con patatas gajo sobre una tabla de madera, servida en papel de periódico',
	},
	{
		src: parrilladaSarten,
		alt: 'Costillas y pollo a la brasa en una sartén de hierro con patatas y cebolla asada',
	},
	{
		src: calcots,
		alt: 'Calçots asándose sobre la parrilla con llama viva',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo de bacon y queso partido por la mitad en un plato, con un refresco al lado',
	},
	{
		src: calamares,
		alt: 'Calamares a la romana recién fritos con dos gajos de limón',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que se cocina en La Cabaneta',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-cabaneta`,
	name: BUSINESS.name,
	alternateName: ['La Cabaneta', 'Bar La Cabaneta', 'La Cabaneta Canillo'],
	description:
		'Bar y restaurante de parrilla en Canillo: pollo y costillas a la brasa, calçots de temporada, menú diario, bocadillos y tapas, con terraza de madera al pie de la CG-2.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376727999',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Parrilla', 'Cocina de montaña', 'Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Canillo' },
		{ '@type': 'AdministrativeArea', name: 'Andorra' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '23:59',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La parrilla', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"bar-restaurant-la-cabaneta-terraza.jpg": terraza,
	"bar-restaurant-la-cabaneta-coca.jpg": coca,
	"bar-restaurant-la-cabaneta-parrillada-plato.jpg": parrilladaPlato,
	"bar-restaurant-la-cabaneta-pollo.jpg": pollo,
	"bar-restaurant-la-cabaneta-hamburguesa.jpg": hamburguesa,
	"bar-restaurant-la-cabaneta-parrillada-sarten.jpg": parrilladaSarten,
	"bar-restaurant-la-cabaneta-calcots.jpg": calcots,
	"bar-restaurant-la-cabaneta-bocadillo.jpg": bocadillo,
	"bar-restaurant-la-cabaneta-calamares.jpg": calamares,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#24382f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Barlow:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Bar Restaurant La Cabaneta, La Cabaneta Canillo, parrilla Canillo, pollo a la brasa Andorra, menú diario Canillo, bocadillos Canillo, terraza Canillo, Carretera General 2 Canillo"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Parrilla de brasa en Canillo: pollo, costillas, calçots de temporada, menú diario, bocadillos y tapas. Terraza de madera y 4,3 en Google con 660 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Costillas y pollo a la brasa con patatas de Bar Restaurant La Cabaneta"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#24382f"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-03"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[terraza]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Cabaneta"
			subtitle="Bar restaurant · Canillo"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma menú, precios y horario antes de ir."
			ctaLabel="Llamar a La Cabaneta"
			navAriaLabel="Enlaces de Bar Restaurant La Cabaneta"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
