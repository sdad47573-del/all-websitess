---
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	emailHref,
	facebookPhotosUrl,
	facebookUrl,
	faqSchema,
	faqs,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	specialties,
	tripadvisorPhotosUrl,
	tripadvisorUrl,
} from '../lib/business';

const title = 'Mesón Balcón de Chema | Cocina de la Subbética en Castil de Campos';
const description =
	'Mesón Restaurante Balcón de Chema, en Castil de Campos (Priego de Córdoba): cocina tradicional, carnes y vistas a los olivares de la Subbética. Llama para consultar y reservar.';
const keywords =
	'Mesón Balcón de Chema, restaurante Castil de Campos, dónde comer Subbética Córdoba, restaurante Priego de Córdoba, cocina tradicional cordobesa, vistas olivares Córdoba, Calle Carrera Castil de Campos';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#29362b" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Castil de Campos, Priego de Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración vectorial original del paisaje de olivares de la Subbética; no es una foto del mesón" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Mesón Balcón de Chema, inicio">
				<span class="brand-mark" aria-hidden="true">C</span>
				<span class="brand-copy">Balcón de Chema <small>Mesón · Castil de Campos</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cocina">La cocina</a>
				<a href="#paisaje">El entorno</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 957 70 52 98</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="kicker"><span aria-hidden="true"></span> Castil de Campos · Subbética cordobesa</p>
					<h1 id="hero-title">Una mesa<br />con vistas al <em>olivar.</em></h1>
					<p class="hero-intro">Cocina tradicional de la Subbética, platos para compartir y un mirador que se abre al paisaje de olivos y sierras. Haz una pausa en el camino y disfruta sin prisas.</p>
					<div class="hero-actions">
						<a class="button button-rust" href={phoneHref}>Llamar al mesón <span aria-hidden="true">↗</span></a>
						<a class="button button-light-outline" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Estamos en</small><address>{business.locality}<br />{business.postalCode} · Córdoba</address></div>
						<div><small>Reservas e información</small><a href={phoneHref}>{business.phone}</a></div>
					</div>
				</div>
				<div class="landscape" role="img" aria-label="Ilustración original de olivares y sierras de la Subbética al atardecer">
					<span class="sun" aria-hidden="true"></span><span class="ridge" aria-hidden="true"></span>
					<span class="olive-tree" aria-hidden="true"></span><span class="olive-tree tree-two" aria-hidden="true"></span><span class="olive-tree tree-three" aria-hidden="true"></span>
					<span class="landscape-frame" aria-hidden="true"></span>
					<span class="landscape-caption"><strong>La Subbética, a tu mesa</strong>Olivares · cocina de siempre</span>
				</div>
			</section>

			<div class="promise-strip" aria-label="Lo que encontrarás en el Balcón de Chema">
				<span>Cocina tradicional</span><span>Sabores de la Subbética</span><span>Mirador panorámico</span><span>Junto al parque</span>
			</div>

			<section class="section intro" id="paisaje" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Un alto en Castil de Campos</p>
					<h2 class="section-title" id="intro-title">El paisaje también<br />se <em>disfruta.</em></h2>
				</div>
				<div class="intro-copy">
					<p>El Mesón Restaurante Balcón de Chema está junto al parque de Castil de Campos, en plena Subbética cordobesa. Su mirador ofrece vistas abiertas a los olivares y a las sierras que rodean la localidad: un rincón para alargar la sobremesa y contemplar el entorno.</p>
					<p>La propuesta combina recetas de siempre, productos de la comarca y una carta amplia que va del tapeo a los platos principales. La información gastronómica de esta página es orientativa; pregunta por la carta y disponibilidad del día.</p>
					<p class="source-note">El teléfono y el correo se contrastaron con la página oficial de Facebook. Las fuentes públicas presentan variaciones de dirección y horario; confirma estos datos antes de desplazarte.</p>
				</div>
			</section>

			<section class="section specialties" id="cocina" aria-labelledby="menu-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Cocina de la Subbética</p>
						<h2 class="section-title" id="menu-title">Recetas de siempre,<br /><em>producto de aquí.</em></h2>
					</div>
					<p>Entre las recomendaciones publicadas aparecen guisos, carnes, pescado y tapas para compartir. Consulta con el mesón la carta vigente, precios y alérgenos.</p>
				</div>
				<div class="menu-grid">
					{specialties.map((dish, index) => (
						<article class="menu-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<p class="menu-note">Platos citados en publicaciones gastronómicas, sujetos a cambios y disponibilidad. <a href={phoneHref}>Llama para consultar</a>.</p>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<p class="section-label"><span aria-hidden="true"></span> El mesón en imágenes</p>
				<h2 class="section-title" id="gallery-title">Asómate al<br /><em>Balcón de Chema.</em></h2>
				<p class="gallery-intro">El enlace de Maps facilitado abre la ficha del lugar, pero no contiene direcciones directas a los archivos de foto. Accede a las galerías para ver imágenes auténticas compartidas del restaurante y su entorno.</p>
				<div class="photo-links">
					<a class="photo-card" href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Mesón Balcón de Chema en Google Maps">
						<span class="photo-card-tag">Galería de la ficha</span><span class="photo-card-title">Fotos en Google Maps <span aria-hidden="true">↗</span></span>
					</a>
					<a class="photo-card" href={facebookPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver álbum de fotos oficial en Facebook">
						<span class="photo-card-tag">Página oficial</span><span class="photo-card-title">Álbum de Facebook <span aria-hidden="true">↗</span></span>
					</a>
					<a class="photo-card" href={tripadvisorPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos del restaurante en Tripadvisor">
						<span class="photo-card-tag">Fotos de visitantes</span><span class="photo-card-title">Galería Tripadvisor <span aria-hidden="true">↗</span></span>
					</a>
				</div>
				<p class="photo-disclaimer">Los fondos de estas tarjetas y la ilustración panorámica son gráficos vectoriales originales, no fotografías del local. Las fotos reales se consultan en los enlaces externos.</p>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Castil de Campos · 14815 Córdoba</p>
					<h2 class="section-title" id="visit-title">Te esperamos<br /><em>en la Subbética.</em></h2>
					<address>{business.streetAddress}, 23<br />{business.locality} · {business.postalCode}<br />{business.city}, {business.province}</address>
					<div class="contact-list">
						<div class="contact-item"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Teléfono publicado por el negocio</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-item"><span class="contact-icon" aria-hidden="true">✉</span><div><small>Correo</small><a href={emailHref}>{business.email}</a></div></div>
						<div class="contact-item"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Ubicación</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha y ubicación en Google Maps ↗</a></div></div>
					</div>
					<div class="button-row contact-actions">
						<a class="button button-olive" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar para reservar</a>
					</div>
					<p class="menu-note">Los horarios no se muestran porque las publicaciones consultadas ofrecen información dispar. Llama para confirmar apertura y servicio.</p>
				</div>
				<div class="map-card">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Mesón Restaurante Balcón de Chema en Castil de Campos, Córdoba" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<div class="map-caption"><div><strong>{business.name}</strong><small>{business.locality} · Subbética cordobesa</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Información práctica</p>
				<h2 class="section-title" id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
			<Galeria nombre="Mesón Restaurante Balcón de Chema" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="Balcón de Chema, volver al inicio">
				<span class="brand-mark" aria-hidden="true">C</span><span class="brand-copy">Balcón de Chema <small>Mesón · Castil de Campos</small></span>
			</a>
			<nav class="footer-links" aria-label="Contacto y perfiles oficiales">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Mesón Restaurante Balcón de Chema · Castil de Campos, Córdoba. Confirma carta y horarios con el establecimiento.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar al mesón <span>957 70 52 98</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>


