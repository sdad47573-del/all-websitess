---
import '../styles/global.css';

const business = {
	name: 'Restaurante Camping La Rosaleda',
	short: 'La Rosaleda',
	street: 'Ctra. del Pradillo km 1,3',
	city: 'Conil de la Frontera',
	postalCode: '11140',
	phone: '+34 956 44 33 27',
	email: 'info@campinglarosaleda.com',
	latitude: 36.2947791,
	longitude: -6.0915935,
	site: 'https://restaurante-camping-la-rosaleda.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+Camping+La+Rosaleda/@36.2947791,-6.0915935,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c3792e206841d:0x9a79704c6939319a!8m2!3d36.2947791!4d-6.0915935!16s%2Fg%2F11c6pldj9m?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const phoneHref = 'tel:+34956443327';
const webUrl = 'https://campinglarosaleda.com/';

const specialties = [
	{
		kicker: 'Del camping',
		title: 'Restaurante del camping',
		text: 'El restaurante del Camping La Rosaleda, abierto todo el año junto a su recepción.',
	},
	{
		kicker: 'Para el día a día',
		title: 'Cocina casera',
		text: 'Cocina de camping para huéspedes y visitantes: confirma la carta del día en el local.',
	},
	{
		kicker: 'Entre pinos',
		title: 'Terraza',
		text: 'Comer a la sombra en la Ctra. del Pradillo, a un paso de Conil y sus playas.',
	},
	{
		kicker: 'Todo el año',
		title: 'Abierto todo el año',
		text: 'El camping abre todo el año; recepción de 8:00 a 21:00.',
	},
	{
		kicker: 'Contacto directo',
		title: '956 44 33 27',
		text: 'Llama para confirmar el horario del restaurante antes de venir.',
	},
	{
		kicker: 'Aviso',
		title: 'Sin carta publicada',
		text: 'No publicamos platos ni precios por falta de fuente verificable.',
	},
];

const gallery = [
	{ src: '/fotos/camping.svg', alt: 'Ilustración del camping — sustituye por foto propia' },
	{ src: '/fotos/restaurante.svg', alt: 'Ilustración del restaurante — sustituye por foto propia' },
	{ src: '/fotos/terraza.svg', alt: 'Ilustración de la terraza — sustituye por foto propia' },
	{ src: '/fotos/plato.svg', alt: 'Ilustración de plato casero — sustituye por foto propia' },
	{ src: '/fotos/pinos.svg', alt: 'Ilustración del pinar — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está el Restaurante Camping La Rosaleda?',
		a: 'En Ctra. del Pradillo km 1,3, 11140 Conil de la Frontera (Cádiz), dentro del Camping La Rosaleda.',
	},
	{
		q: '¿Cuál es el horario del restaurante?',
		a: 'El camping abre todo el año con recepción de 8:00 a 21:00. El horario propio del restaurante no está publicado: confirma en el 956 44 33 27.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Restaurante de camping con cocina casera. Confirma la carta del día en el propio local.',
	},
	{
		q: '¿Tienen web?',
		a: 'Sí: campinglarosaleda.com, además de su ficha en Google Maps.',
	},
	{
		q: '¿Cómo llego?',
		a: 'Por la Ctra. del Pradillo: desde la A-48 salida 26 Conil Sur Playas. Usa el botón «Cómo llegar» para abrir la ruta en Google Maps.',
	},
];

const description =
	'Restaurante Camping La Rosaleda en Ctra. del Pradillo km 1,3, Conil de la Frontera. Restaurante del camping, abierto todo el año. Tel. 956 44 33 27.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 956 44 33 27',
	email: business.email,
	image: [`${business.site}/fotos/camping.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Andaluza'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [webUrl],
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '08:00',
			closes: '21:00',
			description: 'Horario de recepción del camping (el del restaurante se confirma por teléfono)',
		},
	],
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="Restaurante Camping La Rosaleda: restaurante del camping en Ctra. del Pradillo km 1,3, Conil. Abierto todo el año. 956 44 33 27." />
		<meta name="keywords" content="Restaurante Camping La Rosaleda, comer Conil, Ctra Pradillo Conil, camping La Rosaleda restaurante" />
		<meta name="author" content="Restaurante Camping La Rosaleda" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>La Rosaleda | Restaurante del camping en Conil</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="La Rosaleda · Restaurante del camping en Conil" />
		<meta property="og:description" content="Restaurante del Camping La Rosaleda, Ctra. del Pradillo km 1,3. Abierto todo el año." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/camping.svg`} />
		<meta property="og:image:alt" content="Restaurante Camping La Rosaleda, Conil" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="La Rosaleda · Restaurante del camping en Conil" />
		<meta name="twitter:description" content="Ctra. del Pradillo km 1,3: cocina casera todo el año." />
		<meta name="twitter:image" content={`${business.site}/fotos/camping.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Conil de la Frontera" />
		<meta name="geo.position" content="36.2947791;-6.0915935" />
		<meta name="ICBM" content="36.2947791, -6.0915935" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="La Rosaleda, inicio">
				<span class="brand-mark" aria-hidden="true">LR</span>
				<span class="brand-name">La Rosaleda <small>Conil · Pradillo</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">El restaurante</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>956 44 33 27</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Pradillo km 1,3 · Conil</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante del Camping La Rosaleda: cocina casera de camping,
						abierto todo el año junto a la recepción, a un paso de Conil y sus playas.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 956 44 33 27</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>8–21</b> recepción</li>
						<li><b>Todo</b> el año</li>
						<li>Ctra. Pradillo</li>
						<li>Conil</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/fotos/camping.svg" alt="Ilustración del Camping La Rosaleda, Conil" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Pradillo km 1,3 · Conil</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>8–21</b><span>Recepción</span></div>
					<div><b>Todo</b><span>El año</span></div>
					<div><b>km 1,3</b><span>Pradillo</span></div>
				</div>
				<ul class="services">
					<li>Restaurante</li>
					<li>Camping</li>
					<li>Terraza</li>
					<li>Casera</li>
					<li>Recepción</li>
					<li>Playas cerca</li>
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> El restaurante</p>
				<div class="about-grid">
					<h2>Comer en<br />el <em>camping.</em></h2>
					<div class="about-copy">
						<p>
							Restaurante Camping La Rosaleda está en Ctra. del Pradillo km 1,3
							(11140 Conil de la Frontera), con coordenadas 36.2947791, -6.0915935,
							y web en campinglarosaleda.com.
						</p>
						<p>
							Es el restaurante del camping: cocina casera para huéspedes y visitantes,
							con recepción abierta de 8:00 a 21:00 todos los días del año.
						</p>
						<p class="about-note">
							El horario propio del restaurante no está publicado. Confirma en el
							956 44 33 27 o en info@campinglarosaleda.com antes de venir.
						</p>
						<div class="about-links">
							<a class="simple-link" href={webUrl} target="_blank" rel="noreferrer">campinglarosaleda.com <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales de restaurante de camping. Confirma la carta del día
						en el propio local.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El camping<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del restaurante.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Ctra. del Pradillo km 1,3</p>
					<h2>Ven al camping<br /><em>a comer.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Recepción (lun–dom)</th>
								<td>8:00 – 21:00</td>
							</tr>
							<tr>
								<th scope="row">Restaurante</th>
								<td>A confirmar: 956 44 33 27</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Camping abierto todo el año. Confirma el horario del restaurante antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al restaurante ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 956 44 33 27</a>
					<br />
					<a class="phone-link" href="mailto:info@campinglarosaleda.com">info@campinglarosaleda.com</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de Restaurante Camping La Rosaleda en Pradillo km 1,3, Conil" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> La Rosaleda · Conil</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">LR</span>
				<p>La Rosaleda<small>{business.street} · Conil</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={webUrl} target="_blank" rel="noreferrer">Camping ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} La Rosaleda · Conil. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>956 44 33 27</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34956443327?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Restaurante%20Camping%20La%20Rosaleda." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Restaurante Camping La Rosaleda"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
