---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	facebookUrl,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHrefs,
	structuredData,
} from '../lib/business';

const title = 'Restaurante Baluarte | Cocina andaluza en Rincón de la Victoria';
const description =
	'Restaurante Baluarte, cocina andaluza y mediterránea en Calle Poeta Manuel Alcántara, 6, Rincón de la Victoria (Málaga). Menú del día, carnes maduradas y vinos. Reserva: 679 52 27 33.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#26301f" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="Rincón de la Victoria" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Marcellus&family=Mulish:wght@400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://restaurante-baluarte-malaga.vercel.app/og.png" />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante Baluarte, inicio"><span class="brand-mark" aria-hidden="true">B</span><span class="brand-label">BALUARTE <small>RESTAURANTE · RINCÓN DE LA VICTORIA</small></span></a>
			<nav aria-label="Navegación principal"><a href="#carta">La carta</a><a href="#contacto">Contacto</a></nav>
			<a class="header-phone" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> {business.phones[0]}</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<span class="hero-rail" aria-hidden="true">RESTAURANTE · 29730 RINCÓN DE LA VICTORIA</span>
				<div class="hero-content">
					<p class="eyebrow"><span></span> COCINA ANDALUZA · MEDITERRÁNEA</p>
					<h1 id="hero-title">Baluarte</h1>
					<p class="hero-sub">Restaurante · Rincón de la Victoria</p>
					<p class="hero-intro">Cocina andaluza y mediterránea con producto de temporada, carnes maduradas y una buena carta de vinos. Un restaurante para comer y cenar sin prisa en el Rincón de la Victoria.</p>
					<div class="hero-actions"><a class="button button-copper" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Llamar y reservar</a><a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-meta">
						<div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div>
						<div><small>TELÉFONO</small><a href={phoneHrefs[0]}>{business.phones[0]}</a></div>
					</div>
				</div>
			</section>

			<section class="carta-section" id="carta" aria-labelledby="carta-title">
				<p class="section-label"><span>01 /</span> LA CARTA</p>
				<h2 class="carta-heading" id="carta-title">Qué vas a<br /><em>encontrar.</em></h2>
				<div class="carta-grid">
					<article class="carta-card"><span class="carta-num" aria-hidden="true">01</span><h3>Cocina andaluza</h3><p>Platos de siempre con un punto actual, elaborados con producto de temporada.</p></article>
					<article class="carta-card"><span class="carta-num" aria-hidden="true">02</span><h3>Menú del día</h3><p>Una propuesta de mediodía que cambia para comer bien sin complicarte.</p></article>
					<article class="carta-card"><span class="carta-num" aria-hidden="true">03</span><h3>Carnes maduradas</h3><p>Selección de carnes con la maduración cuidada al detalle.</p></article>
					<article class="carta-card"><span class="carta-num" aria-hidden="true">04</span><h3>Vinos</h3><p>Carta de vinos pensada para acompañar cada plato de la mesa.</p></article>
				</div>
			</section>

			<section class="about-section" aria-labelledby="about-title">
				<p class="section-label"><span>02 /</span> BALUARTE · RINCÓN DE LA VICTORIA</p>
				<div class="about-content"><h2 id="about-title">Cocina andaluza<br /><em>con rollazo.</em></h2><div><p>En Baluarte cocinamos lo de aquí, con guiños mediterráneos y una carta que se disfruta tanto al mediodía como de noche. Buen producto, platos cuidados y una selección de vinos para redondear la mesa. Reserva tu mesa y ven a probarlo.</p><a class="social-link" href={instagramUrl} target="_blank" rel="noreferrer">Síguenos en Instagram <span aria-hidden="true">↗</span></a></div></div>
				<div class="about-footer"><span>ANDALUZA · MEDITERRÁNEA</span><span>29730 RINCÓN DE LA VICTORIA</span><span>✦</span></div>
			</section>

			<section class="contact-section" id="contacto" aria-labelledby="contact-title">
				<p class="section-label"><span>03 /</span> VISÍTANOS</p>
				<div class="contact-layout">
					<div class="contact-copy"><p class="contact-kicker">RESERVAS Y UBICACIÓN</p><h2 id="contact-title">Reserva<br /><em>tu mesa.</em></h2>
						<div class="contact-card">
							<div class="contact-row"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div></div>
							<div class="contact-row"><span aria-hidden="true">☎</span><div><small>RESERVAS</small><a href={phoneHrefs[0]}>{business.phones[0]}</a></div></div>
						</div>
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-card"><div class="map-header"><span><i></i> POETA MANUEL ALCÁNTARA · RINCÓN</span><a href={mapsUrl} target="_blank" rel="noreferrer">ABRIR MAPS ↗</a></div><div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<button type="button" data-cargar-mapa aria-label="Cargar mapa interactivo" style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
							<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
							<strong style="font-size:1rem;">Cargar mapa interactivo</strong>
							<small style="opacity:0.65;">Se carga solo al pulsar</small>
						</button>
<iframe title="Mapa de Restaurante Baluarte en Calle Poeta Manuel Alcántara, Rincón de la Victoria" data-src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div><div class="map-footer"><span aria-hidden="true">⌖</span><div><strong>{business.name}</strong><small>{business.streetAddress} · {business.city}</small></div><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar a Restaurante Baluarte">↗</a></div></div>
				</div>
				<div class="social-row"><span>ENCUÉNTRANOS TAMBIÉN EN</span><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a><a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a></div>
			</section>
			<Galeria nombre="Restaurante Baluarte" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer"><a class="brand footer-brand" href="#inicio" aria-label="Restaurante Baluarte, volver al inicio"><span class="brand-mark">B</span><span class="brand-label">BALUARTE <small>RESTAURANTE · RINCÓN DE LA VICTORIA</small></span></a><p>{business.streetAddress}, {business.postalCode} {business.city}<br /><a href={phoneHrefs[0]}>{business.phones[0]}</a></p><a class="footer-social" href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a><small>© {new Date().getFullYear()} Restaurante Baluarte · Rincón de la Victoria &nbsp;·&nbsp; Consulta la carta y los horarios en el local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
</footer>
		<a class="phone-cta" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Reservar en Baluarte <strong>{business.phones[0]}</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						<WhatsappFab phone={datos.phoneHrefs[0]} name={datos.business?.name} />
						</body>
</html>

<script>
// mapa-fachada: la URL del iframe vive en data-src y solo se asigna al pulsar (ahorra ~1MB de JS).
document.addEventListener('click', function (e) {
	var t = e.target && e.target.closest ? e.target.closest('[data-cargar-mapa]') : null;
	if (!t) return;
	var w = t.closest('[data-mapa-fachada]');
	if (!w || w.dataset.cargado) return;
	var f = w.querySelector('iframe');
	if (!f || !f.dataset.src || f.getAttribute('src')) return;
	w.dataset.cargado = '1';
	f.setAttribute('src', f.dataset.src);
	t.remove();
});
</script>
