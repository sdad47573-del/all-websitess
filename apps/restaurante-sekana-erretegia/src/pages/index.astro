---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import bogavantes from '../assets/fotos/restaurante-sekana-erretegia-cuadrada-01.jpg';
import chuleton from '../assets/fotos/restaurante-sekana-erretegia-apaisada-02.jpg';
import cochinillo from '../assets/fotos/restaurante-sekana-erretegia-apaisada-03.jpg';
import pescado from '../assets/fotos/restaurante-sekana-erretegia-apaisada-04.jpg';
import chuletonPatatas from '../assets/fotos/restaurante-sekana-erretegia-apaisada-05.jpg';
import croquetas from '../assets/fotos/restaurante-sekana-erretegia-vertical-06.jpg';
import rodaballo from '../assets/fotos/restaurante-sekana-erretegia-vertical-07.jpg';
import gambas from '../assets/fotos/restaurante-sekana-erretegia-vertical-08.jpg';
import postre from '../assets/fotos/restaurante-sekana-erretegia-vertical-09.jpg';
import jamon from '../assets/fotos/restaurante-sekana-erretegia-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Restaurante Sekaña Erretegia, parrilla en Lugar Barrio Aginaga, 20 (20170 Aginaga, Gipuzkoa). Chuleta, costilla y cochinillo por encargo, con 4,6 sobre 5 en Google y 242 reseñas. Teléfono 943 36 27 73.';

const galeria = [
	{
		src: cochinillo,
		alt: 'Cochinillo asado entero en una bandeja, con una ensalada al lado',
	},
	{
		src: bogavantes,
		alt: 'Tres bogavantes sobre la parrilla, encima de las brasas',
	},
	{
		src: chuletonPatatas,
		alt: 'Chuletón con patatas paja y ensalada',
	},
	{
		src: pescado,
		alt: 'Pescado al horno con ajos laminados y un poco de guindilla',
	},
	{
		src: rodaballo,
		alt: 'Rodaballo al horno con ajos y salsa',
	},
	{
		src: gambas,
		alt: 'Gambas a la plancha con limón y mayonesa',
	},
	{
		src: croquetas,
		alt: 'Cuatro croquetas caseras en un plato rectangular',
	},
	{
		src: jamon,
		alt: 'Jamón ibérico cortado en lonchas en un plato rectangular',
	},
	{
		src: postre,
		alt: 'Postre con nata montada, café y virutas de chocolate',
	},
	{
		src: chuleton,
		alt: 'Chuletón a la parrilla con sal gruesa en un plato blanco',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#sekana-erretegia`,
	name: BUSINESS.name,
	alternateName: [
		BUSINESS.alternateName,
		'Restaurante Sekaña',
		'Erretegia Sekaña',
		'Parrilla Sekaña Aginaga',
	],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: `+34 ${BUSINESS.phone}`,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Parrilla', 'Asados'],
	knowsLanguage: [
		{ '@type': 'Language', name: 'Español' },
		{ '@type': 'Language', name: 'Euskera' },
	],
	areaServed: [
		{ '@type': 'City', name: 'Aginaga' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Las reseñas', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Restaurante Sekaña Erretegia · Parrilla en Aginaga';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-sekana-erretegia-apaisada-02.jpg": chuleton,
	"restaurante-sekana-erretegia-apaisada-03.jpg": cochinillo,
	"restaurante-sekana-erretegia-cuadrada-01.jpg": bogavantes,
	"restaurante-sekana-erretegia-apaisada-05.jpg": chuletonPatatas,
	"restaurante-sekana-erretegia-apaisada-04.jpg": pescado,
	"restaurante-sekana-erretegia-vertical-07.jpg": rodaballo,
	"restaurante-sekana-erretegia-vertical-08.jpg": gambas,
	"restaurante-sekana-erretegia-vertical-06.jpg": croquetas,
	"restaurante-sekana-erretegia-vertical-10.jpg": jamon,
	"restaurante-sekana-erretegia-vertical-09.jpg": postre,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2b2320" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@300..700&family=Bitter:wght@400..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Sekaña Erretegia, Sekaña Erretegia, parrilla Aginaga, asador Aginaga, comer en Aginaga, chuleta Aginaga, cochinillo por encargo, restaurante Gipuzkoa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Parrilla en Lugar Barrio Aginaga, 20. Chuleta, costilla, cochinillo por encargo y postres caseros, con 4,6 sobre 5 en Google y 242 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Chuletón a la parrilla con sal gruesa en un plato blanco"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2b2320"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Aginaga, Gipuzkoa"
			preload={[chuleton]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Sekaña Erretegia"
			subtitle="Parrilla · Aginaga"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Sekaña Erretegia"
		/>
	</body>
</html>
