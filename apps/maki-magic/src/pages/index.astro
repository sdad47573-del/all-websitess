---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import hotRolls from '../assets/fotos/maki-magic-apaisada-10.jpg';
import combinado from '../assets/fotos/maki-magic-apaisada-07.jpg';
import bandeja from '../assets/fotos/maki-magic-vertical-02.jpg';
import sashimi from '../assets/fotos/maki-magic-vertical-03.jpg';
import sashimiAbanico from '../assets/fotos/maki-magic-vertical-05.jpg';
import nigiri from '../assets/fotos/maki-magic-vertical-06.jpg';
import rollsDetalle from '../assets/fotos/maki-magic-vertical-04.jpg';
import hotRollsPicante from '../assets/fotos/maki-magic-vertical-08.jpg';
import sashimiAzul from '../assets/fotos/maki-magic-vertical-09.jpg';
import comedor from '../assets/fotos/maki-magic-panoramica-01.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Maki Magic, restaurante de sushi y bar en la R. Garcia da Orta 545 r/c (2975-275 Quinta do Conde, Sesimbra): combinados, sashimi, nigiri y hot rolls. 4,5 en Google con 457 reseñas. Tel. 21 015 0807.';

const galeria = [
	{
		src: combinado,
		alt: 'Combinado redondo de uramaki con plato central de sashimi, sostenido por un cocinero de Maki Magic',
	},
	{
		src: bandeja,
		alt: 'Bandeja grande de sushi con abanico de aguacate, sashimi, nigiri, maki y rolls en Maki Magic',
	},
	{
		src: sashimi,
		alt: 'Sashimi de salmón, atún y pescado blanco con limón en plato turquesa, en Maki Magic',
	},
	{
		src: sashimiAbanico,
		alt: 'Abanico de sashimi con pepino, salmón, atún y pescado blanco con limón',
	},
	{
		src: sashimiAzul,
		alt: 'Surtido de sashimi y nigiri en plato azul con forma de concha sobre mantel de rayas',
	},
	{
		src: nigiri,
		alt: 'Nigiri de salmón con crema y topping dulce, y rolls a la brasa con sésamo y cebollino',
	},
	{
		src: hotRolls,
		alt: 'Cuatro hot rolls con salsa de anguila, sésamo y cebollino en plato rectangular',
	},
	{
		src: rollsDetalle,
		alt: 'Detalle de rolls con salmón, copos crujientes, sésamo y salsa de anguila',
	},
	{
		src: hotRollsPicante,
		alt: 'Rolls rebozados con mayonesa picante, chile y cebollino sobre plato rosa',
	},
	{
		src: comedor,
		alt: 'Comedor de Maki Magic con mesas de mármol, sillas negras y suelo de baldosa',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.fullName,
	alternateName: [BUSINESS.name, 'Maki Magic Sushi', 'Maki Magic Quinta do Conde'],
	slogan: 'Sushi con frescura, creatividad y originalidad',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 21 015 0807',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Japonesa', 'Sushi', 'Asiática'],
	areaServed: [
		{ '@type': 'City', name: 'Sesimbra' },
		{ '@type': 'City', name: 'Quinta do Conde' },
		{ '@type': 'AdministrativeArea', name: 'Área Metropolitana de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '19:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Maki Magic · Sushi y bar en la Quinta do Conde (Sesimbra)';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0f3b3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Sora:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Maki Magic, Maki Magic Sushi, sushi Quinta do Conde, restaurante japonês Sesimbra, sushi Sesimbra, takeaway sushi Quinta do Conde, R. Garcia da Orta 545, sushi Setúbal, combinado sushi Sesimbra"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Maki Magic · Sushi y bar en la Quinta do Conde"
			ogDescription="Combinados, sashimi, nigiri y hot rolls, con dos turnos de martes a domingo. 4,5 en Google con 457 reseñas. Tel. 21 015 0807."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Hot rolls con salsa de anguila de Maki Magic"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#0f3b3a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-15"
			postalCode={BUSINESS.postalCode}
			phone="+351210150807"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.municipality}`}
			countryName="Portugal"
			contact={{
				street: BUSINESS.street,
				locality: `${BUSINESS.city}, ${BUSINESS.municipality}`,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				phone: '+351 21 015 0807',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[hotRolls]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Sushi restaurante & bar"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="R. Garcia da Orta, 545 r/c · Quinta do Conde · Sesimbra"
				title="Sushi con<br /><em>magia propia.</em>"
				lede="Maki Magic es un restaurante de sushi y bar en la Quinta do Conde, al sur del Tajo: un comedor amplio de mesas de mármol y suelo de baldosa, con una barra de piedra al fondo, y una cocina que se define a sí misma como «sushi completo, con frescura, creatividad y originalidad». Combinados en bandeja, sashimi al corte, nigiri con crema y hot rolls con salsa de anguila."
				image={hotRolls}
				imageAlt="Hot rolls con salsa de anguila, sésamo y cebollino en Maki Magic, Quinta do Conde"
				primaryCta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Sushi y japonés"
				facts={[
					{ label: 'Nota', html: '<b>4,5 en Google</b> con 457 reseñas' },
					{ label: 'Mediodía', html: '<b>12:00 – 15:00</b>' },
					{ label: 'Cena', html: '<b>19:00 – 23:00</b>' },
					{ label: 'Lunes', html: '<b>Cerrado</b>' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Maki Magic" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un comedor amplio<br /><em>y una barra de piedra.</em>"
				paragraphs={[
					'El restaurante está en la R. Garcia da Orta, 545 (r/c), en la Quinta do Conde, el núcleo del municipio de Sesimbra que creció junto a la EN-10 al sur del Tajo. La sala es amplia y luminosa: paredes blancas, suelo de baldosa color teja, mesas de mármol con sillas negras y una barra de piedra al fondo bajo unas lámparas colgantes.',
					'La cocina se presenta como «um restaurante de sushi completo com frescura, criatividade e originalidade», y las fotos del perfil lo confirman: combinados montados en bandeja redonda, con anillos de uramaki alrededor y un plato central de sashimi; tablas grandes con abanico de aguacate, nigiri, maki y rolls para compartir; sashimi de salmón, atún y pescado blanco cortado fino y colocado como un abanico.',
					'Los rolls son la parte más personal: uramaki con sésamo negro, piezas altas de salmón con crema de queso y un topping dulce, hot rolls rebozados y acabados con mayonesa picante, copos crujientes, cebollino y esa salsa de anguila brillante que aparece en casi todas las fotos. De acompañamiento, gari (jengibre encurtido) y wasabi.',
				]}
				note="La ficha de Google no publica carta con precios ni web propia: solo el teléfono, el 21 015 0807. La valoración es de 4,5 sobre 5 con 457 reseñas, y la accesibilidad está detallada al completo (entrada, aparcamiento, aseo y asientos adaptados)."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Combinados,<br />sashimi<br /><em>y hot rolls.</em>"
				description="No hay carta publicada con precios: estos son los platos y las piezas que aparecen en las fotos del perfil del restaurante en Google Maps."
				cta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Maki Magic no publica su carta en Google y esta web no inventa nombres ni precios. En las fotos se ven combinados de varios tamaños, sashimi, nigiri, uramaki y hot rolls; la carta completa, con precios y menús para grupos, se pide al llamar al 21 015 0807 o directamente en el local."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El corte,<br />los rolls<br /><em>y la sala.</em>"
				description="Estas fotografías proceden del perfil de Maki Magic en Google Maps: el combinado redondo con el plato de sashimi en el centro, la bandeja grande para compartir, tres platos de sashimi, el nigiri con crema y topping dulce, tres detalles de rolls con salsa de anguila y mayonesa picante, y el comedor con la barra al fondo."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="R. Garcia da Orta, 545 r/c · 2975-275 Quinta do Conde"
				title="Al sur del Tajo,<br /><em>con dos turnos.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.municipality} · ${BUSINESS.region}`,
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="Los lunes cierra. De martes a domingo sirve dos turnos: mediodía de 12:00 a 15:00 y cena de 19:00 a 23:00. En festivos la ficha avisa de que el horario podría cambiar, así que llama antes si vas en una fecha señalada."
				mapTitle="Mapa de Maki Magic en la R. Garcia da Orta, 545, Quinta do Conde"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Maki Magic · Quinta do Conde"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 21 015 0807. La ficha marca acceso, aparcamiento, aseo y asientos adaptados para sillas de ruedas. El restaurante anuncia takeaway y aparece en plataformas de reparto con entrega y recogida; para pedir, lo directo es la llamada."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Maki Magic"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
