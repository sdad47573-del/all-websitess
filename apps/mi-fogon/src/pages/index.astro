---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/mi-fogon-vista-1-01.jpg';
import polloGuisado from '../assets/fotos/mi-fogon-vertical-02.jpg';
import fajitas from '../assets/fotos/mi-fogon-vertical-03.jpg';
import sardinas from '../assets/fotos/mi-fogon-vertical-04.jpg';
import hojaldres from '../assets/fotos/mi-fogon-vertical-05.jpg';
import berenjenas from '../assets/fotos/mi-fogon-vertical-06.jpg';
import tartaOreo from '../assets/fotos/mi-fogon-apaisada-07.jpg';
import arrozCarne from '../assets/fotos/mi-fogon-apaisada-08.jpg';
import fiambreras from '../assets/fotos/mi-fogon-vertical-09.jpg';
import fachadaCerrada from '../assets/fotos/mi-fogon-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'Mi Fogón · Comidas caseras para llevar en Fuente Álamo';
const description = BUSINESS.description;

const galeria = [
	{
		src: polloGuisado,
		alt: 'Pollo guisado con patatas, chorizo y laurel en una salsa de pimentón, con una lata de pimentón de Murcia al fondo',
	},
	{
		src: fiambreras,
		alt: 'Fiambreras preparadas con pollo asado troceado sobre ensaladilla, espolvoreadas con pimentón y perejil',
	},
	{
		src: arrozCarne,
		alt: 'Ración de arroz guisado con trozos de carne y patata, servida en un plato blanco',
	},
	{
		src: fajitas,
		alt: 'Fajitas dobladas y doradas, rellenas de carne, tomate y queso fundido, sobre papel de horno',
	},
	{
		src: berenjenas,
		alt: 'Berenjenas rellenas y gratinadas con queso, con perejil picado por encima, en una bandeja',
	},
	{
		src: hojaldres,
		alt: 'Empanadillas de hojaldre cuadradas, recién horneadas, decoradas con huevas negras y naranjas',
	},
	{
		src: sardinas,
		alt: 'Sardinas a la plancha con ajo, pimiento y perejil en un plato, junto a una copa y una botella de vino blanco',
	},
	{
		src: tartaOreo,
		alt: 'Tarta de galletas Oreo en una fiambrera, con la crema y las galletas enteras encima',
	},
	{
		src: fachadaCerrada,
		alt: 'Fachada de Mi Fogón con la persiana bajada y el rótulo de comidas para llevar, en la calle',
	},
];

const carta = [
	{
		title: 'Del fogón',
		items: [
			{ name: 'Pollo guisado con patatas', note: 'con chorizo y pimentón de Murcia, según la foto del local' },
			{ name: 'Arroz con carne', note: 'guisado, en raciones' },
			{ name: 'Sardinas a la plancha', note: 'con ajo y pimiento, el pescado que se ve en el perfil' },
			{ name: 'Berenjenas rellenas', note: 'gratinadas con queso' },
		],
	},
	{
		title: 'Para picar',
		items: [
			{ name: 'Ensaladilla rusa', note: 'la que una reseña destaca «como se hacía antiguamente»' },
			{ name: 'Pechuga empanada', note: 'en ración, según la reseña crítica' },
			{ name: 'Patatas', note: 'por raciones' },
			{ name: 'Fajitas', note: 'rellenas y doradas, tal y como aparecen en las fotos' },
			{ name: 'Empanadillas de hojaldre', note: 'recién horneadas' },
		],
	},
	{
		title: 'De postre',
		items: [{ name: 'Tarta de galletas Oreo', note: 'en fiambrera, tal y como se ve en el perfil' }],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#mifogon`,
	name: BUSINESS.name,
	alternateName: ['Mi Fogón', 'Mi Fogón Fuente Álamo', 'Mi Fogon comidas para llevar'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina casera', 'Cocina murciana', 'Comida para llevar'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Fuente Álamo, Murcia' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '08:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"mi-fogon-vista-1-01.jpg": fachada,
	"mi-fogon-vertical-02.jpg": polloGuisado,
	"mi-fogon-vertical-09.jpg": fiambreras,
	"mi-fogon-apaisada-08.jpg": arrozCarne,
	"mi-fogon-vertical-03.jpg": fajitas,
	"mi-fogon-vertical-06.jpg": berenjenas,
	"mi-fogon-vertical-05.jpg": hojaldres,
	"mi-fogon-vertical-04.jpg": sardinas,
	"mi-fogon-apaisada-07.jpg": tartaOreo,
	"mi-fogon-vertical-10.jpg": fachadaCerrada,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2a1114" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Mi Fogón Fuente Álamo, comidas para llevar Fuente Álamo, cocina casera Murcia, pollo guisado para llevar, arroz con carne, ensaladilla rusa, Rda. Pte. 7, comida para llevar 30320"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina casera y platos típicos para llevar en Rda. Pte. 7, Fuente Álamo. De 8:00 a 16:00, lunes y martes cerrado. Pedidos en el 641 23 67 43."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo de Mi Fogón comidas para llevar, con la olla humeante, en Fuente Álamo"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2a1114"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Fuente Álamo, Murcia"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Mi Fogón"
			subtitle="Comidas para llevar · Fuente Álamo"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Mi Fogón comidas para llevar"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías tomados de la ficha y del perfil públicos del local en Google Maps. Sin carta de precios publicada: confirma horario, disponibilidad y reparto antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Mi Fogón"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
