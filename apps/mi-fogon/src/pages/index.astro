---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/mi-fogon-vista-1-01.jpg';
import polloGuisado from '../assets/fotos/mi-fogon-vertical-02.jpg';
import fajitas from '../assets/fotos/mi-fogon-vertical-03.jpg';
import sardinas from '../assets/fotos/mi-fogon-vertical-04.jpg';
import hojaldres from '../assets/fotos/mi-fogon-vertical-05.jpg';
import berenjenas from '../assets/fotos/mi-fogon-vertical-06.jpg';
import tartaOreo from '../assets/fotos/mi-fogon-apaisada-07.jpg';
import arrozCarne from '../assets/fotos/mi-fogon-apaisada-08.jpg';
import fiambreras from '../assets/fotos/mi-fogon-vertical-09.jpg';
import fachadaCerrada from '../assets/fotos/mi-fogon-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, REVIEWS, SERVICIOS } from '../data/site';

const title = 'Mi Fogón · Comidas caseras para llevar en Fuente Álamo';
const description = BUSINESS.description;

const galeria = [
	{
		src: polloGuisado,
		alt: 'Pollo guisado con patatas, chorizo y laurel en una salsa de pimentón, con una lata de pimentón de Murcia al fondo',
	},
	{
		src: fiambreras,
		alt: 'Fiambreras preparadas con pollo asado troceado sobre ensaladilla, espolvoreadas con pimentón y perejil',
	},
	{
		src: arrozCarne,
		alt: 'Ración de arroz guisado con trozos de carne y patata, servida en un plato blanco',
	},
	{
		src: fajitas,
		alt: 'Fajitas dobladas y doradas, rellenas de carne, tomate y queso fundido, sobre papel de horno',
	},
	{
		src: berenjenas,
		alt: 'Berenjenas rellenas y gratinadas con queso, con perejil picado por encima, en una bandeja',
	},
	{
		src: hojaldres,
		alt: 'Empanadillas de hojaldre cuadradas, recién horneadas, decoradas con huevas negras y naranjas',
	},
	{
		src: sardinas,
		alt: 'Sardinas a la plancha con ajo, pimiento y perejil en un plato, junto a una copa y una botella de vino blanco',
	},
	{
		src: tartaOreo,
		alt: 'Tarta de galletas Oreo en una fiambrera, con la crema y las galletas enteras encima',
	},
	{
		src: fachadaCerrada,
		alt: 'Fachada de Mi Fogón con la persiana bajada y el rótulo de comidas para llevar, en la calle',
	},
];

const carta = [
	{
		title: 'Del fogón',
		items: [
			{ name: 'Pollo guisado con patatas', note: 'con chorizo y pimentón de Murcia, según la foto del local' },
			{ name: 'Arroz con carne', note: 'guisado, en raciones' },
			{ name: 'Sardinas a la plancha', note: 'con ajo y pimiento, el pescado que se ve en el perfil' },
			{ name: 'Berenjenas rellenas', note: 'gratinadas con queso' },
		],
	},
	{
		title: 'Para picar',
		items: [
			{ name: 'Ensaladilla rusa', note: 'la que una reseña destaca «como se hacía antiguamente»' },
			{ name: 'Pechuga empanada', note: 'en ración, según la reseña crítica' },
			{ name: 'Patatas', note: 'por raciones' },
			{ name: 'Fajitas', note: 'rellenas y doradas, tal y como aparecen en las fotos' },
			{ name: 'Empanadillas de hojaldre', note: 'recién horneadas' },
		],
	},
	{
		title: 'De postre',
		items: [{ name: 'Tarta de galletas Oreo', note: 'en fiambrera, tal y como se ve en el perfil' }],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#mifogon`,
	name: BUSINESS.name,
	alternateName: ['Mi Fogón', 'Mi Fogón Fuente Álamo', 'Mi Fogon comidas para llevar'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina casera', 'Cocina murciana', 'Comida para llevar'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Fuente Álamo, Murcia' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '08:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2a1114" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Mi Fogón Fuente Álamo, comidas para llevar Fuente Álamo, cocina casera Murcia, pollo guisado para llevar, arroz con carne, ensaladilla rusa, Rda. Pte. 7, comida para llevar 30320"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina casera y platos típicos para llevar en Rda. Pte. 7, Fuente Álamo. De 8:00 a 16:00, lunes y martes cerrado. Pedidos en el 641 23 67 43."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo de Mi Fogón comidas para llevar, con la olla humeante, en Fuente Álamo"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2a1114"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Fuente Álamo, Murcia"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Mi Fogón"
			subtitle="Comidas para llevar · Fuente Álamo"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Cocina casera, <br /><em>de fogón.</em>"
				lede="Mi Fogón hace comidas para llevar en Rda. Pte. 7, en Fuente Álamo. El negocio lo resume en su ficha: «Cocina casera, platos típicos con toques personales en algunas recetas». Abre de 8:00 a 16:00 de miércoles a domingo, cierra lunes y martes, y los pedidos se hacen en el 641 23 67 43."
				image={fachada}
				imageAlt="Fachada de Mi Fogón con el rótulo de olla humeante y el letrero de comidas para llevar, en Fuente Álamo"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>3,8</b> en Google · 12 reseñas' },
					{ label: 'Horario', html: '<b>8:00–16:00</b><br />Lunes y martes cerrado' },
					{ label: 'Pedidos', html: `<b>${BUSINESS.phone}</b> comida para llevar` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Mi Fogón" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="El fogón <br /><em>de Fuente Álamo.</em>"
				paragraphs={[
					'El local está en el número 7 de Rda. Pte., en Fuente Álamo, con la fachada blanca, el zócalo oscuro y un rótulo limpio: una olla humeante, «MI FOGÓN» y debajo, en rojo, «Comidas para llevar». El portal se ve a la derecha de la puerta.',
					'La ficha la clasifica como restaurante de comida para llevar y el negocio firma su cocina en una línea: «Cocina casera, platos típicos con toques personales en algunas recetas». Aquí no hay servicio de mesa: se pide por teléfono, se cocina y se recoge.',
					'Las fotos del perfil enseñan lo que sale del fogón: pollo guisado con patatas, chorizo y pimentón de Murcia; arroz con carne; sardinas a la plancha con ajo y pimiento; berenjenas rellenas gratinadas; fajitas y empanadillas de hojaldre para picar; y una tarta de galletas para el postre.',
					'El horario es de mañana y mediodía: de 8:00 a 16:00 de miércoles a domingo, con lunes y martes de descanso. La nota de Google es 3,8 con 12 reseñas, y aquí están las tres que la ficha destaca, también la que pone una estrella.',
				]}
				note="La ficha no publica carta con precios ni web propia. Los platos de esta página salen de la descripción del negocio, de las categorías de Google, de las fotos de su perfil y de las reseñas destacadas; no hay importes que mostrar sin inventarlos."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Guisos, tapas <br /><em>y postre.</em>"
				description="Sin precios publicados en la ficha, así que aquí va lo que el negocio declara, lo que se ve en sus fotos y lo que citan las reseñas."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={carta}
				note="Nombres de platos tomados de la descripción del negocio, de las fotografías del perfil y de las reseñas destacadas. No hay carta ni precios públicos: la disponibilidad del día se confirma en el 641 23 67 43."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
					<div class="reviews-head">
						<h2 id="resenas-title">Como en casa, <br /><em>con matices.</em></h2>
						<p>
							La ficha tiene 12 reseñas y una media de 3,8. Estas son las tres que Google destaca, con
							la puntuación que les dio su autor, incluida la de una estrella.
						</p>
					</div>
					<div class="review-grid">
						{
							REVIEWS.map((review) => (
								<figure class="review-card">
									<p class="review-stars" aria-label={`${review.rating} sobre 5`}>
										{'★'.repeat(review.rating)}
										<span aria-hidden="true">{'★'.repeat(5 - review.rating)}</span>
									</p>
									<blockquote>{review.quote}</blockquote>
									<figcaption>Reseña publicada en Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="review-note">
						Citas de las reseñas públicas del local, con la puntuación del autor. En la ficha de Google
						están todas, también las que no aparecen aquí.
					</p>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Nueve fotos <br /><em>del fogón.</em>"
				description="Del perfil del local: el pollo guisado, las fiambreras de pollo con ensaladilla, el arroz, las fajitas, las berenjenas gratinadas, los hojaldres, las sardinas, la tarta de galletas y la fachada con la persiana bajada."
				images={galeria}
				cta={{ label: 'Ver todas en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="De miércoles <br /><em>a domingo.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, `${BUSINESS.regionName}, España`]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: de 8:00 a 16:00 de miércoles a domingo, con lunes y martes cerrado. Es servicio de mañana y mediodía, sin cenas. En festivos puede cambiar; llama antes si vas en día señalado."
				mapTitle="Mapa de Mi Fogón comidas para llevar en Rda. Pte. 7, Fuente Álamo, Murcia"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Mi Fogón"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Pedidos: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="Aquí se pide por teléfono y se recoge en el local: es comida para llevar, sin servicio de mesa. La ficha no enlaza ninguna plataforma de reparto ni publica datos de accesibilidad. Esta página no tramita pedidos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>llamar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Mi Fogón comidas para llevar"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías tomados de la ficha y del perfil públicos del local en Google Maps. Sin carta de precios publicada: confirma horario, disponibilidad y reparto antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Mi Fogón"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
