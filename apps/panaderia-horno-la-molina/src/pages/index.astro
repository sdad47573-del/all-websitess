---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import mostrador from '../assets/fotos/panaderia-horno-la-molina-apaisada-10.jpg';
import fachada from '../assets/fotos/panaderia-horno-la-molina-vertical-01.jpg';
import vitrina from '../assets/fotos/panaderia-horno-la-molina-apaisada-04.jpg';
import tartas from '../assets/fotos/panaderia-horno-la-molina-vertical-08.jpg';
import cafe from '../assets/fotos/panaderia-horno-la-molina-vertical-05.jpg';
import smoothies from '../assets/fotos/panaderia-horno-la-molina-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería Horno La Molina · Levante, Córdoba';
const description =
	'Panadería Horno La Molina, en la Avenida del 28 de Febrero, 34 (Levante, 14007 Córdoba). Pan, bollos, pastelería, café y smoothies. Abierta todos los días de 7:00 a 19:00.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#lamolina`,
	name: BUSINESS.name,
	alternateName: ['Horno La Molina', 'La Molina', 'Panadería La Molina Córdoba'],
	description:
		'Obrador tradicional en Levante (14007 Córdoba). Pan, bollos, pastelería y dulces, con café y smoothies naturales.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34957433269',
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '07:00',
			closes: '19:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de Horno La Molina con el rótulo morado y el dibujo del molino, y bolsas de pan en el escaparate',
	},
	{
		src: vitrina,
		alt: 'Vitrina de La Molina con pasteles, bizcochos y bandejas de bollería',
	},
	{
		src: tartas,
		alt: 'Tartas de chocolate y de nata y bandejas de pasteles en la vitrina de La Molina',
	},
	{
		src: cafe,
		alt: 'Café con leche y un bollo espolvoreado con azúcar en una mesa de La Molina',
	},
	{
		src: smoothies,
		alt: 'Carta de smoothies naturales de La Molina, con combinaciones de fruta',
	},
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"panaderia-horno-la-molina-apaisada-10.jpg": mostrador,
	"panaderia-horno-la-molina-vertical-01.jpg": fachada,
	"panaderia-horno-la-molina-apaisada-04.jpg": vitrina,
	"panaderia-horno-la-molina-vertical-08.jpg": tartas,
	"panaderia-horno-la-molina-vertical-05.jpg": cafe,
	"panaderia-horno-la-molina-vertical-09.jpg": smoothies,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#4a2b52" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400..700;1,400..600&family=Source+Sans+3:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Horno La Molina, panadería Córdoba, obrador tradicional, pan de telera, pastelería Córdoba, Levante, 14007"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan, bollos, pastelería, café y smoothies en la Avenida del 28 de Febrero, 34 (14007 Córdoba). Abierta todos los días de 7:00 a 19:00. 4,5 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Mostrador de Horno La Molina con cestas de pan, bollos y panes en bolsas"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#4a2b52"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[mostrador]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Horno · Pastelería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Ver en Google Maps"
			navAriaLabel="Enlaces de Panadería Horno La Molina"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
