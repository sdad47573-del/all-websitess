---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import vitrina from '../assets/fotos/casa-carlos-comida-casera-apaisada-10.jpg';
import fachada from '../assets/fotos/casa-carlos-comida-casera-apaisada-01.jpg';
import albondigas from '../assets/fotos/casa-carlos-comida-casera-vertical-09.jpg';
import carne from '../assets/fotos/casa-carlos-comida-casera-vertical-08.jpg';
import pimientos from '../assets/fotos/casa-carlos-comida-casera-vertical-02.jpg';
import bocadillo from '../assets/fotos/casa-carlos-comida-casera-vertical-04.jpg';
import tortilla from '../assets/fotos/casa-carlos-comida-casera-vertical-05.jpg';
import ensalada from '../assets/fotos/casa-carlos-comida-casera-vertical-06.jpg';
import ensaladilla from '../assets/fotos/casa-carlos-comida-casera-vertical-07.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Casa Carlos · Comida casera en Puerto de la Torre, Málaga';
const description =
	'Casa Carlos, en C. Filigrana, 1 (Puerto de la Torre, 29591 Málaga). Comida casera para llevar con raciones abundantes: croquetas, tortilla, guisos y ensaladas. De lunes a viernes y domingos, de 11:00 a 16:00.';

const galeria = [
	{
		src: vitrina,
		alt: 'La vitrina de Casa Carlos con bandejas de croquetas, empanadillas y ensaladilla rusa',
	},
	{
		src: albondigas,
		alt: 'Cazuela de barro con albóndigas en salsa de tomate',
	},
	{
		src: carne,
		alt: 'Un plato de carne guisada en salsa con patatas fritas',
	},
	{
		src: pimientos,
		alt: 'Pimientos del piquillo rellenos con salsa amarilla y lechuga en un plato',
	},
	{
		src: ensaladilla,
		alt: 'Ensaladilla rusa con naranja, aceitunas y cebolleta en una bandeja',
	},
	{
		src: tortilla,
		alt: 'Una tortilla de patatas entera en un plato dorado',
	},
	{
		src: bocadillo,
		alt: 'Un bocadillo de tortilla con pimientos y atún cortado por la mitad',
	},
	{
		src: ensalada,
		alt: 'Ensalada mixta con atún, zanahoria rallada, huevo duro y tomate',
	},
	{
		src: fachada,
		alt: 'La fachada negra de Casa Carlos con el rótulo de comidas caseras para llevar y el teléfono',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Casa Carlos',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#casa-carlos`,
	name: BUSINESS.name,
	alternateName: ['Casa Carlos - Comida casera', 'Casa Carlos Puerto de la Torre', 'Casa Carlos Málaga'],
	description:
		'Restaurante de comida casera para llevar en la calle Filigrana, 1, Puerto de la Torre (29591 Málaga). Raciones abundantes y buena relación calidad/precio.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34633208161',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Puerto de la Torre' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Sunday'],
			opens: '11:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"casa-carlos-comida-casera-apaisada-10.jpg": vitrina,
	"casa-carlos-comida-casera-vertical-09.jpg": albondigas,
	"casa-carlos-comida-casera-vertical-08.jpg": carne,
	"casa-carlos-comida-casera-vertical-02.jpg": pimientos,
	"casa-carlos-comida-casera-vertical-07.jpg": ensaladilla,
	"casa-carlos-comida-casera-vertical-05.jpg": tortilla,
	"casa-carlos-comida-casera-vertical-04.jpg": bocadillo,
	"casa-carlos-comida-casera-vertical-06.jpg": ensalada,
	"casa-carlos-comida-casera-apaisada-01.jpg": fachada,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#191411" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Manrope:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Casa Carlos, comida casera Puerto de la Torre, comida casera para llevar Málaga, croquetas, tortilla de patatas, albóndigas, ensaladilla rusa, raciones abundantes, Filigrana"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera con raciones abundantes en la calle Filigrana, 1, Puerto de la Torre. De lunes a viernes y domingos, de 11:00 a 16:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La vitrina de Casa Carlos con croquetas, empanadillas y ensaladilla"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#191411"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Puerto de la Torre"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Casa Carlos"
			subtitle="Comida casera · Puerto de la Torre"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a Casa Carlos"
			navAriaLabel="Enlaces de Casa Carlos"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
