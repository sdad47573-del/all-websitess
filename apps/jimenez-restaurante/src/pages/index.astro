---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	business,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Jiménez Restaurante · Horario y dirección en La Cañada';
const description =
	'Restaurante en la Ctra. el Charco, s/n, 04120 La Cañada (Almería). Google le da 4,2 sobre 5 con 902 reseñas; de 12:00 a 16:00 y cerrado los martes.';
const keywords =
	'Jiménez Restaurante, restaurante La Cañada, restaurante Almería, Ctra. el Charco, comer en La Cañada Almería, Jiménez Restaurante teléfono, restaurante Costacabana';

/**
 * Texto alternativo de las fotos.
 *
 * Google no describe el contenido de ninguna de las diez que trae la galería de esta ficha ni
 * indica autora, así que no se inventa una descripción y todos los `alt` avisan solo de dónde
 * salen las fotos.
 */
const altFoto =
	'Fotografía publicada en la ficha de Google Maps del Jiménez Restaurante, en La Cañada (Almería)';
const altOg = 'Fotografía del Jiménez Restaurante publicada en su ficha de Google Maps';

/**
 * Galería completa: las diez fotografías de la ficha.
 *
 * El manifiesto de la descarga quedó sin autora, así que se publican sin pie y sin atribución: no
 * hay nada que citar.
 */
const galeria = [
	'jimenez-restaurante-apaisada-01.jpg',
	'jimenez-restaurante-vertical-02.jpg',
	'jimenez-restaurante-apaisada-03.jpg',
	'jimenez-restaurante-apaisada-04.jpg',
	'jimenez-restaurante-vista-5-05.jpg',
	'jimenez-restaurante-apaisada-06.jpg',
	'jimenez-restaurante-apaisada-07.jpg',
	'jimenez-restaurante-vertical-08.jpg',
	'jimenez-restaurante-vertical-09.jpg',
	'jimenez-restaurante-vertical-10.jpg',
];

/** Tres fotos de avance en el collage de la portada (también están en la galería). */
const collage = [
	{ name: galeria[0], clase: 'collage-item collage-item-a' },
	{ name: galeria[1], clase: 'collage-item collage-item-b' },
	{ name: galeria[8], clase: 'collage-item collage-item-c' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#8a2f11" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-AL" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">
					JR
				</span>
				<span class="brand-text">
					Jiménez Restaurante
					<small>La Cañada · Almería</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">El restaurante</a>
				<a href="#fotos">Las fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">La Cañada · Ctra. el Charco, s/n</p>
						<h1 id="hero-title">
							De 12:00 a 16:00,
							<br />
							<em>cerrado los martes.</em>
						</h1>
						<p class="hero-lede">
							El Jiménez Restaurante está en la Ctra. el Charco, s/n de La Cañada, con código postal
							04120, en la provincia de Almería. Google lo clasifica como restaurante y publica un
							único turno, de 12:00 a 16:00, con el martes marcado como cerrado. La ficha le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>
								Llamar al {business.phone}
							</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas
								</strong>
							</li>
						</ul>
					</div>

					<div class="hero-collage">
						{collage.map((item, index) => (
							<figure class={item.clase}>
								<Image
									src={foto(item.name)}
									alt={altFoto}
									widths={index === 0 ? [640, 900, 1200] : [320, 480, 640]}
									sizes={
										index === 0
											? '(max-width: 1080px) 92vw, 46vw'
											: '(max-width: 1080px) 45vw, 23vw'
									}
									format="avif"
									quality={68}
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : undefined}
									decoding="async"
								/>
							</figure>
						))}
					</div>
				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
					{business.reviewCount.toLocaleString('es-ES')} reseñas
				</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>{hoursSummary}</span>
				<span>Teléfono {business.phone}</span>
			</div>

			<section class="section" id="restaurante" aria-labelledby="restaurante-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">El restaurante</p>
						<h2 class="title" id="restaurante-title">
							Un solo turno de comida,
							<br />
							<em>y martes de descanso.</em>
						</h2>
						<p>
							Google lo clasifica como restaurante, sin declarar ningún tipo de cocina concreta, y
							le da {business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas. Está en la Ctra. el Charco,
							s/n, con código postal 04120, en el municipio de La Cañada (Almería).
						</p>
						<p>
							Su horario publicado es de 12:00 a 16:00 todos los días de la semana, incluido el
							lunes, y con el <strong>martes marcado como cerrado</strong>. Es el único turno que
							declara la ficha: no hay servicio de tarde ni de noche en ella.
						</p>
						<p class="bar-note">
							Esta web se ha preparado solo con lo que publica la ficha, consultada el{' '}
							{site.consultado}: nombre, dirección, teléfono, categoría, horario, valoración, las
							tres reseñas que destaca y sus propias fotografías. La ficha no publica la carta, los
							precios, la web propia ni perfiles de redes sociales, así que aquí no se reproduce ni
							se enlaza nada de eso.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>{business.reviewCount.toLocaleString('es-ES')} reseñas en Google Maps</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
								Ver todas ↗
							</a>
						</div>
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									<strong>{review.rating} sobre 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section cocina" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						Las fotos del <em>restaurante.</em>
					</h2>
					<p class="lead">
						Son las diez fotografías que el Jiménez Restaurante publica en su ficha de Google Maps.
						Google no describe el contenido de ninguna, así que no se inventa un contenido que no
						consta.
					</p>
					<div class="cocina-grid">
						{galeria.map((name) => (
							<figure class="cocina-item">
								<Image
									src={foto(name)}
									alt={altFoto}
									widths={[380, 560, 800]}
									sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
									format="avif"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))}
					</div>
					<p class="cocina-note">
						La ficha no publica la carta ni los precios, así que esta web no los reproduce. Para
						saber qué hay hoy, lo más rápido es <a href={phoneHref}>llamar al {business.phone}</a> o
						mirar las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos y reseñas de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Ctra. el Charco, s/n,
							<br />
							<em>04120 La Cañada.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr class:list={[{ 'is-closed': item.shifts.length === 0 }]}>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							El horario sale de la ficha consultada el {site.consultado}: el martes 6 de octubre
							aparecía cerrado y el lunes 12, Fiesta Nacional de España, mantenía su horario con el
							aviso de que podría ser diferente. Confirma por teléfono antes de salir.
						</p>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>llamar.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">
						JR
					</span>
					<span>
						Jiménez Restaurante
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del restaurante">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
						Cómo llegar ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Jiménez Restaurante · Ctra. el Charco, s/n (04120 La Cañada,
					Almería). Web informativa elaborada con los datos y las fotografías que el restaurante
					publica en su ficha de Google Maps, consultada el {site.consultado}. Confirma horario y
					disponibilidad por teléfono antes de salir.
				</small>
			</div>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a Jiménez Restaurante <span>{business.phone}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
