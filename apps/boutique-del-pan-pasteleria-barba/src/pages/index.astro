---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/boutique-del-pan-pasteleria-barba-apaisada-01.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HOURS, MAPS, REVIEWS, SERVICIOS } from '../data/site';

const title = 'Boutique Del Pan Pastelería Barba · Bailén-Miraflores';
const description =
	'Boutique Del Pan Pastelería Barba, en Av. Miraflores de los Ángeles, 9 (Bailén-Miraflores, 29011 Málaga). Pan y pastelería de barrio, todos los días de 8:00 a 14:30.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#barba`,
	name: BUSINESS.name,
	alternateName: ['Boutique del Pan Barba', 'Pastelería Barba', 'Panadería Barba Málaga'],
	description:
		'Panadería y pastelería en Av. Miraflores de los Ángeles, 9 (Bailén-Miraflores, 29011 Málaga). Abre todos los días de 8:00 a 14:30.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '08:00',
			closes: '14:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#4f5a3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Outfit:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Boutique Del Pan Pasteleria Barba, panadería Málaga, pastelería Bailén-Miraflores, pan de barrio Málaga, panadería Av. Miraflores de los Ángeles, pastelería 29011"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan y pastelería de barrio en Bailén-Miraflores, Málaga. Todos los días de 8:00 a 14:30. 4,3 sobre 5 con 12 reseñas en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de la Boutique Del Pan Pastelería Barba en la Avenida Miraflores de los Ángeles, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#4f5a3a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Barba"
			subtitle="Panadería · Pastelería"
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. Miraflores de los Ángeles, 9 · Bailén-Miraflores"
				title="Pan de barrio, <br /><em>pastelería de casa.</em>"
				lede={`La Boutique Del Pan Pastelería Barba está en la Avenida Miraflores de los Ángeles, 9, en Bailén-Miraflores. Pan y pastelería todos los días de 8:00 a 14:30. Tiene ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 en Google con ${BUSINESS.reviewsCount} reseñas.`}
				image={fachada}
				imageAlt="Fachada de la Boutique Del Pan Pastelería Barba en la esquina de la Avenida Miraflores de los Ángeles, con el rótulo de la tienda"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,3</b> en Google · 12 reseñas' },
					{ label: 'Horario', html: '<b>8:00–14:30</b> todos los días' },
					{ label: 'Barrio', html: '<b>Bailén-Miraflores</b>, Málaga' },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Imagen de Google Street View · julio de 2026"
				galleryLinkLabel="Abrir Street View"
				tag="Todos los días · 8:00–14:30"
			/>

			<LocalChips label="Lo que ofrece la Boutique Del Pan Pastelería Barba" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="El pan <br /><em>con apellido.</em>"
				paragraphs={[
					'La Boutique Del Pan Pastelería Barba está en la Avenida Miraflores de los Ángeles, 9, en Bailén-Miraflores. El rótulo de la esquina anuncia «Boutique del Pan · Pastelería Barba», y la ficha de Google la clasifica como panadería.',
					'Abre todos los días de 8:00 a 14:30. Es un horario de mañana: la ficha no recoge un tramo de tarde ni un día de cierre.',
					'La ficha no publica teléfono, web, carta ni precios, y tampoco fotos del perfil. Esta página no inventa ninguno de esos datos: reúne la dirección, el horario, la valoración y las reseñas, y usa una vista de Google Street View para enseñar la fachada.',
					'Las reseñas destacan el pan, la atención y los precios: «muy buen pan y te atienden con amabilidad a unos precios muy asequibles», dice una de ellas.',
				]}
				note="4,3 sobre 5 con 12 reseñas en Google. La media incluye opiniones de todo tipo; las dos que se citan en esta página son de cinco estrellas."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<section class="highlights section-pad" aria-labelledby="highlights-title">
				<div class="wrap">
					<div class="highlights-head">
						<p class="eyebrow"><span aria-hidden="true"></span> Tres detalles</p>
						<h2 id="highlights-title">Lo que se sabe <br /><em>de la casa.</em></h2>
					</div>
					<div class="highlight-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="highlight-card">
									<span class="highlight-num">{String(index + 1).padStart(2, '0')}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="reviews section-pad" id="resenas" aria-labelledby="reviews-title">
				<div class="wrap">
					<div class="reviews-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Lo que dicen</p>
							<h2 id="reviews-title">Dos reseñas <br /><em>de la ficha.</em></h2>
						</div>
						<p>
							La media es 4,3 sobre 5 con 12 reseñas. Estas son dos de las opiniones de
							cinco estrellas publicadas en Google; puedes leer el resto en la ficha.
						</p>
					</div>
					<div class="review-grid">
						{
							REVIEWS.map((review) => (
								<figure class="review-card">
									<span class="stars" role="img" aria-label={`${review.rating} de 5 estrellas`}>
										★★★★★
									</span>
									<blockquote>{review.text}</blockquote>
									<figcaption>Reseña de Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<a class="reviews-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
						Leer las 12 reseñas en Google ↗
					</a>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la avenida, <br /><em>por la mañana.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote="Todos los días de 8:00 a 14:30, según la ficha de Google. No hay teléfono ni web publicados: conviene confirmar el horario antes de ir, sobre todo en festivos."
				mapTitle="Mapa de Boutique Del Pan Pastelería Barba en la Avenida Miraflores de los Ángeles, 9, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Barba · Bailén-Miraflores"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Reseñas en Google', href: MAPS.reviews, external: true },
				]}
				contactLink={{ label: 'Abrir la ficha en Google Maps', href: MAPS.place, external: true }}
				reserveNote="Sin teléfono ni web publicados: la atención es en el propio establecimiento. La ficha indica acceso para sillas de ruedas."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pasar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone=""
			phoneHref=""
			legal="Datos y reseñas de la ficha pública de Google Maps e imagen de Google Street View (julio de 2026). Sin teléfono, carta ni precios publicados por el establecimiento."
			ctaLabel="Cómo llegar a Barba"
			navAriaLabel="Enlaces de Boutique Del Pan Pastelería Barba"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
