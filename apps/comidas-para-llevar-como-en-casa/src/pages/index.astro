---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/comidas-para-llevar-como-en-casa-apaisada-06.jpg';
import rotulo from '../assets/fotos/comidas-para-llevar-como-en-casa-vertical-08.jpg';
import mostrador from '../assets/fotos/comidas-para-llevar-como-en-casa-apaisada-01.jpg';
import bandejas from '../assets/fotos/comidas-para-llevar-como-en-casa-apaisada-04.jpg';
import interior from '../assets/fotos/comidas-para-llevar-como-en-casa-apaisada-07.jpg';
import vitrina from '../assets/fotos/comidas-para-llevar-como-en-casa-apaisada-03.jpg';
import paella from '../assets/fotos/comidas-para-llevar-como-en-casa-apaisada-05.jpg';
import arrozPollo from '../assets/fotos/comidas-para-llevar-como-en-casa-apaisada-09.jpg';
import filete from '../assets/fotos/comidas-para-llevar-como-en-casa-apaisada-02.jpg';
import pizarra from '../assets/fotos/comidas-para-llevar-como-en-casa-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Como en casa · Pollos asados y comida para llevar en Lorca';
const description =
	'Comidas Para Llevar Como en casa, en C. Asilo de San Diego, 1 (30800 Lorca). Pollos asados, pan y comida casera para llevar de martes a sábado, de 8:00 a 18:00.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de Comidas Para Llevar Como en casa, en la esquina de la calle Asilo de San Diego de Lorca, con el rótulo de pollos asados, pan y comidas',
	},
	{
		src: rotulo,
		alt: 'Detalle del rótulo del local: «Pollos asados · pan · Paqui · Comidas» sobre las cristaleras',
	},
	{
		src: mostrador,
		alt: 'El mostrador con bandejas de pollo empanado, huevos fritos y croquetas, y el asador de pollos al fondo',
	},
	{
		src: bandejas,
		alt: 'Bandejas de patatas con pollo, un gratinado, salsa de tomate y pollo guisado en el mostrador caliente',
	},
	{
		src: vitrina,
		alt: 'La vitrina de postres con tartas de queso y chocolate, flanes, natillas, ensaladas envasadas y tarrinas de flan',
	},
	{
		src: paella,
		alt: 'Una paella grande de marisco recién hecha en la cocina, junto a las ollas del fuego',
	},
	{
		src: pizarra,
		alt: 'La pizarra del menú del día con los platos y los precios escritos a mano: arroz de costillejas, cocido, tallarines, migas, pisto y guisos',
	},
	{
		src: arrozPollo,
		alt: 'Una paella de arroz amarillo con pollo, y una mano enguantada sirviendo una ración en una fiambrera',
	},
	{
		src: interior,
		alt: 'El interior del local con el mostrador de bandejas, el expositor de postres y el cartel de Estrella Galicia',
	},
	{
		src: filete,
		alt: 'Un filete a la plancha con patatas fritas en un plato oscuro',
	},
];

const precioNumerico = (price) => price?.replace(/[^\d,]/g, '').replace(',', '.');

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Comidas Para Llevar Como en casa',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: precioNumerico(item.price),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#como-en-casa-lorca`,
	name: BUSINESS.fullName,
	alternateName: [
		'Como en casa Lorca',
		'Comidas Para Llevar Como en casa',
		'Paqui Comidas',
		'Pollos asados Paqui',
	],
	description:
		'Pollos asados, pan y comida casera para llevar en la calle Asilo de San Diego, 1 (30800 Lorca). Pizarra diaria de guisos, raciones y postres de vitrina.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34618593334',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo; tarjeta a partir de 10 €, según el cartel del local',
	servesCuisine: ['Comida casera', 'Cocina murciana', 'Comida para llevar', 'Pollos asados'],
	hasMenu: menuSchema,
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Lorca' },
		{ '@type': 'AdministrativeArea', name: 'Región de Murcia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:00',
			closes: '18:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"comidas-para-llevar-como-en-casa-apaisada-06.jpg": fachada,
	"comidas-para-llevar-como-en-casa-vertical-08.jpg": rotulo,
	"comidas-para-llevar-como-en-casa-apaisada-01.jpg": mostrador,
	"comidas-para-llevar-como-en-casa-apaisada-04.jpg": bandejas,
	"comidas-para-llevar-como-en-casa-apaisada-03.jpg": vitrina,
	"comidas-para-llevar-como-en-casa-apaisada-05.jpg": paella,
	"comidas-para-llevar-como-en-casa-vertical-10.jpg": pizarra,
	"comidas-para-llevar-como-en-casa-apaisada-09.jpg": arrozPollo,
	"comidas-para-llevar-como-en-casa-apaisada-07.jpg": interior,
	"comidas-para-llevar-como-en-casa-apaisada-02.jpg": filete,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#8c3b1f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Nothing+You+Could+Do&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Comidas Para Llevar Como en casa Lorca, comida para llevar Lorca, pollos asados Lorca, Paqui comidas, menú del día Lorca, Asilo de San Diego comida, comida casera 30800"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollos asados, pan y comida casera para llevar en Asilo de San Diego, 1, Lorca. Pizarra diaria de guisos y raciones, de martes a sábado, 8:00–18:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="El rótulo de Paqui Comidas y Pollos asados en la fachada del local de Lorca"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#8c3b1f"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lorca"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Como en casa"
			subtitle="Comidas · Pollos asados · Lorca"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario, pizarra y fotografías de la ficha pública de Google Maps, consultadas en noviembre de 2026. Confirma platos, precios y horario antes de la visita."
			ctaLabel="Llamar a Como en casa"
			navAriaLabel="Enlaces de Comidas Para Llevar Como en casa"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
