---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/atalaya-catering-apaisada-04.jpg';
import comedor from '../assets/fotos/atalaya-catering-apaisada-01.jpg';
import gambas from '../assets/fotos/atalaya-catering-apaisada-02.jpg';
import comedorAmplio from '../assets/fotos/atalaya-catering-apaisada-03.jpg';
import bogavante from '../assets/fotos/atalaya-catering-apaisada-05.jpg';
import datiles from '../assets/fotos/atalaya-catering-apaisada-07.jpg';
import carne from '../assets/fotos/atalaya-catering-apaisada-09.jpg';
import evento from '../assets/fotos/atalaya-catering-apaisada-10.jpg';
import marisco from '../assets/fotos/atalaya-catering-vertical-06.jpg';
import edificio from '../assets/fotos/atalaya-catering-vertical-08.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Atalaya Catering · Paellas y tapas para llevar en Altea';
const description =
	'Atalaya Catering, Carrer Garganes (03590 Altea, Alicante). Paellas y tapas para llevar, servicio a domicilio, catering para eventos y sala con mesas. Abierto todos los días de 9:00 a 16:00.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de Atalaya Catering en Carrer Garganes, con el cartel de paellas y tapas para llevar',
	},
	{
		src: comedor,
		alt: 'El comedor de Atalaya Catering con mesas de mantel marrón y sillas negras',
	},
	{
		src: gambas,
		alt: 'Gambas cocidas con un poco de verdura en el plato',
	},
	{
		src: bogavante,
		alt: 'Ensalada de bogavante con tomate cherry y huevo rallado',
	},
	{
		src: datiles,
		alt: 'Dátiles envueltos en bacon con palillos y una ensalada de brotes',
	},
	{
		src: carne,
		alt: 'Carne a la brasa con patatas panadera y pimiento asado',
	},
	{
		src: evento,
		alt: 'La sala de Atalaya Catering llena de asistentes a una feria de eventos',
	},
	{
		src: marisco,
		alt: 'Bandeja de gambas y cigalas con perejil y limón',
	},
	{
		src: edificio,
		alt: 'El edificio de Atalaya Catering desde el jardín, con olivos y palmeras',
	},
	{
		src: comedorAmplio,
		alt: 'Vista amplia de la sala con las mesas preparadas y las cortinas blancas',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que prepara Atalaya Catering',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#atalaya-catering`,
	name: BUSINESS.fullName,
	alternateName: ['Atalaya Catering', 'Atalaya Catering Altea'],
	description:
		'Paellas y tapas para llevar, servicio a domicilio y catering para eventos en Carrer Garganes (03590 Altea, Alicante), con sala propia con mesas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, BUSINESS.web],
	telephone: '+34617840969',
	email: BUSINESS.email,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Tapas', 'Arroces', 'Marisco'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Altea' },
		{ '@type': 'AdministrativeArea', name: 'Marina Baixa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La cocina', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"atalaya-catering-apaisada-04.jpg": fachada,
	"atalaya-catering-apaisada-01.jpg": comedor,
	"atalaya-catering-apaisada-02.jpg": gambas,
	"atalaya-catering-apaisada-05.jpg": bogavante,
	"atalaya-catering-apaisada-07.jpg": datiles,
	"atalaya-catering-apaisada-09.jpg": carne,
	"atalaya-catering-apaisada-10.jpg": evento,
	"atalaya-catering-vertical-06.jpg": marisco,
	"atalaya-catering-vertical-08.jpg": edificio,
	"atalaya-catering-apaisada-03.jpg": comedorAmplio,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#12405c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Karla:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Atalaya Catering Altea, paellas para llevar Altea, tapas Altea, catering Altea, comida a domicilio Altea, Carrer Garganes, comedor para eventos Altea"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Paellas y tapas para llevar, servicio a domicilio y catering para eventos en Carrer Garganes (Altea). Todos los días de 9:00 a 16:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de Atalaya Catering en Carrer Garganes, Altea, con el cartel de paellas y tapas para llevar"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#12405c"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Atalaya Catering"
			subtitle="Paellas y tapas · Altea"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma platos, precios y horario antes de pedir."
			ctaLabel="Llamar a Atalaya Catering"
			navAriaLabel="Enlaces de Atalaya Catering"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
