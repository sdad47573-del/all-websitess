---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/atalaya-catering-apaisada-04.jpg';
import comedor from '../assets/fotos/atalaya-catering-apaisada-01.jpg';
import gambas from '../assets/fotos/atalaya-catering-apaisada-02.jpg';
import comedorAmplio from '../assets/fotos/atalaya-catering-apaisada-03.jpg';
import bogavante from '../assets/fotos/atalaya-catering-apaisada-05.jpg';
import datiles from '../assets/fotos/atalaya-catering-apaisada-07.jpg';
import carne from '../assets/fotos/atalaya-catering-apaisada-09.jpg';
import evento from '../assets/fotos/atalaya-catering-apaisada-10.jpg';
import marisco from '../assets/fotos/atalaya-catering-vertical-06.jpg';
import edificio from '../assets/fotos/atalaya-catering-vertical-08.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Atalaya Catering · Paellas y tapas para llevar en Altea';
const description =
	'Atalaya Catering, Carrer Garganes (03590 Altea, Alicante). Paellas y tapas para llevar, servicio a domicilio, catering para eventos y sala con mesas. Abierto todos los días de 9:00 a 16:00.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de Atalaya Catering en Carrer Garganes, con el cartel de paellas y tapas para llevar',
	},
	{
		src: comedor,
		alt: 'El comedor de Atalaya Catering con mesas de mantel marrón y sillas negras',
	},
	{
		src: gambas,
		alt: 'Gambas cocidas con un poco de verdura en el plato',
	},
	{
		src: bogavante,
		alt: 'Ensalada de bogavante con tomate cherry y huevo rallado',
	},
	{
		src: datiles,
		alt: 'Dátiles envueltos en bacon con palillos y una ensalada de brotes',
	},
	{
		src: carne,
		alt: 'Carne a la brasa con patatas panadera y pimiento asado',
	},
	{
		src: evento,
		alt: 'La sala de Atalaya Catering llena de asistentes a una feria de eventos',
	},
	{
		src: marisco,
		alt: 'Bandeja de gambas y cigalas con perejil y limón',
	},
	{
		src: edificio,
		alt: 'El edificio de Atalaya Catering desde el jardín, con olivos y palmeras',
	},
	{
		src: comedorAmplio,
		alt: 'Vista amplia de la sala con las mesas preparadas y las cortinas blancas',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que prepara Atalaya Catering',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#atalaya-catering`,
	name: BUSINESS.fullName,
	alternateName: ['Atalaya Catering', 'Atalaya Catering Altea'],
	description:
		'Paellas y tapas para llevar, servicio a domicilio y catering para eventos en Carrer Garganes (03590 Altea, Alicante), con sala propia con mesas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, BUSINESS.web],
	telephone: '+34617840969',
	email: BUSINESS.email,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Tapas', 'Arroces', 'Marisco'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Altea' },
		{ '@type': 'AdministrativeArea', name: 'Marina Baixa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La cocina', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#12405c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Karla:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Atalaya Catering Altea, paellas para llevar Altea, tapas Altea, catering Altea, comida a domicilio Altea, Carrer Garganes, comedor para eventos Altea"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Paellas y tapas para llevar, servicio a domicilio y catering para eventos en Carrer Garganes (Altea). Todos los días de 9:00 a 16:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de Atalaya Catering en Carrer Garganes, Altea, con el cartel de paellas y tapas para llevar"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#12405c"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Atalaya Catering"
			subtitle="Paellas y tapas · Altea"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer Garganes · Altea (Alicante)"
				title="Paellas y tapas, <br /><em>a tu mesa.</em>"
				lede={`Atalaya Catering es un local de Carrer Garganes, en Altea, con el cartel de «paellas y tapas para llevar» en la puerta y servicio a domicilio. Dentro hay un comedor amplio con mesas de mantel marrón, y la sala se usa también para jornadas y celebraciones. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas y abre todos los días de 9:00 a 16:00.`}
				image={fachada}
				imageAlt="La fachada de Atalaya Catering en Carrer Garganes, con el cartel del local y el de paellas y tapas para llevar"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>9:00–16:00</b> · todos los días' },
					{ label: 'Servicio', html: '<b>Para llevar</b> · y a domicilio' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Servicio a domicilio"
			/>

			<LocalChips label="Lo que ofrece Atalaya Catering" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Carrer Garganes. <br /><em>Un comedor y una cocina.</em>"
				paragraphs={[
					'Atalaya Catering está en el número de Carrer Garganes que la ficha de Google sitúa en las coordenadas 38.6030887, -0.0452091, en Altea. En la acera, la fachada blanca muestra el rótulo del local con el teléfono y el correo, el cartel de «Paellas y tapas para llevar» y, en el escaparate, la lista completa de platos pegada al cristal.',
					'Dentro hay una sala diáfana de techos altos, con pilares blancos, cortinas corridas y mesas vestidas de marrón con servilleta color crema y copas puestas. Esa misma sala aparece en las fotos del perfil ocupada por el público de una «Feria de Eventos», con sillas alineadas y una pantalla al fondo, así que el espacio sirve tanto de comedor como de lugar de celebraciones.',
					'La ficha la clasifica como «servicio de catering» y «restaurante mediterráneo». En las fotos del perfil hay bandejas de gambas y cigalas, una ensalada de bogavante, dátiles envueltos en bacon y carne a la brasa con patatas panadera: la cocina de mar y de brasa que se espera en la Marina Baixa.',
					`Las opiniones que se ven en Google hablan de «un variado desayuno» y de «buena comida casera», y destacan la relación calidad-precio. La media es de ${RATING.label} sobre 5 con ${RATING.count} reseñas (noviembre de 2026). El teléfono de la ficha es el ${BUSINESS.phone}; en el cartel de la fachada aparece además el ${BUSINESS.phoneSign} y el correo ${BUSINESS.email}.`,
				]}
				note="La ficha no publica carta con todos los platos ni precios. Lo que aparece en esta página es lo que anuncia el cartel de la fachada, lo que cuenta la propia ficha y los platos que se reconocen en las fotos del perfil; confirma disponibilidad, precios y encargos por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> De la cocina a la mesa</p>
					<h2 id="highlights-title">Para llevar, a domicilio <br /><em>o en la sala.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La cocina"
				title="Lo que sale <br /><em>de esta cocina.</em>"
				description="Sin carta publicada: esta lista reúne lo que anuncia el cartel de la fachada (paellas y tapas para llevar, servicio a domicilio) y los platos que se reconocen en las fotos del perfil de Google."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note={`Ni la ficha ni el escaparate publican precios. Llama al ${BUSINESS.phone} (o al ${BUSINESS.phoneSign}, el del cartel) para saber el menú del día, el precio de la paella y el plazo de encargo.`}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La fachada, el comedor <br /><em>y los platos.</em>"
				description="Diez fotografías del perfil de Atalaya Catering: la fachada con el cartel de paellas y tapas, el comedor de manteles marrones, la sala durante una feria de eventos, las bandejas de gambas y cigalas, la ensalada de bogavante, los dátiles con bacon, la carne a la brasa y el edificio desde el jardín."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,0 sobre 5, <em>con 104 reseñas.</em></h2>
						<p>
							Google publica una media de 4,0 con 104 opiniones (noviembre de 2026). Entre las
							reseñas que se ven en la ficha, las hay que elogian los desayunos variados, la
							comida casera, la atención y la relación calidad-precio.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,0</strong>
						<span>★★★★☆</span>
						<small>104 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Altea, <br /><em>calle Garganes.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city} (Alicante)`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: todos los días de 9:00 a 16:00. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Atalaya Catering en Carrer Garganes, Altea"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Carrer Garganes · Altea"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote={`Pedidos y encargos por teléfono. La ficha publica el ${BUSINESS.phone}; el cartel de la fachada muestra además el ${BUSINESS.phoneSign} y el correo ${BUSINESS.email}. El local enlaza en Google su propia página de pedidos, atalayacatering.readyme.app, y tiene pegatina de Just Eat en la puerta. No publica área de reparto ni horario de entrega.`}
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma platos, precios y horario antes de pedir."
			ctaLabel="Llamar a Atalaya Catering"
			navAriaLabel="Enlaces de Atalaya Catering"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
