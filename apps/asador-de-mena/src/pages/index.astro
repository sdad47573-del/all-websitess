---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/asador-de-mena-apaisada-01.jpg';
import pollos from '../assets/fotos/asador-de-mena-vertical-02.jpg';
import fachadaCarteles from '../assets/fotos/asador-de-mena-apaisada-03.jpg';
import albondigas from '../assets/fotos/asador-de-mena-apaisada-04.jpg';
import ensalada from '../assets/fotos/asador-de-mena-vertical-05.jpg';
import estofadoCerdo from '../assets/fotos/asador-de-mena-vertical-06.jpg';
import potaje from '../assets/fotos/asador-de-mena-vertical-07.jpg';
import bunuelos from '../assets/fotos/asador-de-mena-vertical-08.jpg';
import estofadoPatatas from '../assets/fotos/asador-de-mena-vertical-09.jpg';
import arrozPasas from '../assets/fotos/asador-de-mena-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
} from '../data/site';

const title = 'Asador de Mena · Pollo asado y comida casera en Málaga';
const description = BUSINESS.description;

const galeria = [
	{
		src: pollos,
		alt: 'Pollos enteros asándose en las bandejas del horno del asador, con la piel dorada',
	},
	{
		src: albondigas,
		alt: 'Dos albóndigas grandes en salsa amarilla con tomate y verdura, en un plato de borde azul y dorado',
	},
	{
		src: potaje,
		alt: 'Potaje de garbanzos con patata, chorizo y morcilla en un plato hondo de borde azul',
	},
	{
		src: estofadoPatatas,
		alt: 'Estofado de cerdo en salsa sobre una cama de patatas fritas, en un plato blanco',
	},
	{
		src: ensalada,
		alt: 'Ensalada de papas con atún, tomate, aceitunas y cebolla en un plato blanco',
	},
	{
		src: arrozPasas,
		alt: 'Arroz con pasas y huevo revuelto en un plato hondo con borde azul',
	},
	{
		src: bunuelos,
		alt: 'Buñuelos fritos espolvoreados con azúcar glas en un plato blanco',
	},
	{
		src: estofadoCerdo,
		alt: 'Estofado de cerdo con ajos en salsa marrón, servido en un plato hondo con borde azul',
	},
	{
		src: fachadaCarteles,
		alt: 'Fachada del Asador de Mena con el letrero artesanal y los carteles de cinta de lomo y estofado de cerdo en el escaparate',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#asador-de-mena`,
	name: BUSINESS.name,
	alternateName: ['Asador Mena', 'Asador de Mena Málaga', 'Pollo asado Mena'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Comida casera', 'Andaluza'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Distrito Centro' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:30',
			closes: '15:45',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"asador-de-mena-apaisada-01.jpg": fachada,
	"asador-de-mena-vertical-02.jpg": pollos,
	"asador-de-mena-apaisada-04.jpg": albondigas,
	"asador-de-mena-vertical-07.jpg": potaje,
	"asador-de-mena-vertical-09.jpg": estofadoPatatas,
	"asador-de-mena-vertical-05.jpg": ensalada,
	"asador-de-mena-vertical-10.jpg": arrozPasas,
	"asador-de-mena-vertical-08.jpg": bunuelos,
	"asador-de-mena-vertical-06.jpg": estofadoCerdo,
	"asador-de-mena-apaisada-03.jpg": fachadaCarteles,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17120f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador de Mena, pollo asado Málaga, comida casera Málaga, C. Huerta del Obispo 25, asador Distrito Centro, pollo asado para llevar Málaga, menú del día Málaga, albóndigas Málaga, estofado de cerdo Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado y comida casera en la calle Huerta del Obispo 25, Distrito Centro. De martes a domingo, de 13:30 a 15:45. 4,6 sobre 5 con 105 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada del Asador de Mena con el letrero artesanal en la calle Huerta del Obispo"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#17120f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Distrito Centro, Málaga"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Asador de Mena"
			subtitle="Pollo asado · comida casera"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces del Asador de Mena"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
