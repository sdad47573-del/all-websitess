---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/mapa-verde-apaisada-01.jpg';
import bao from '../assets/fotos/mapa-verde-vertical-02.jpg';
import mesa from '../assets/fotos/mapa-verde-apaisada-03.jpg';
import hamburguesa from '../assets/fotos/mapa-verde-apaisada-04.jpg';
import bol from '../assets/fotos/mapa-verde-apaisada-05.jpg';
import guacamole from '../assets/fotos/mapa-verde-apaisada-06.jpg';
import ensalada from '../assets/fotos/mapa-verde-vertical-07.jpg';
import falafel from '../assets/fotos/mapa-verde-vertical-08.jpg';
import couscous from '../assets/fotos/mapa-verde-vista-9-09.jpg';
import postre from '../assets/fotos/mapa-verde-cuadrada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Mapa Verde, restaurante vegano en Trueba Kalea, 4, Gros (Donostia). Cocina consciente y comida real, con 4,7 sobre 5 en Google. Abre al mediodía y cierra los domingos. Teléfono 943 84 18 62.';

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de Mapa Verde con pared de piedra, muebles de madera y sillas verdes',
	},
	{
		src: bao,
		alt: 'Bao buns rellenos junto a una ensalada de algas en Mapa Verde',
	},
	{
		src: mesa,
		alt: 'Mesa de Mapa Verde con tres platos de bowl, pan, vino blanco y cerveza',
	},
	{
		src: hamburguesa,
		alt: 'Hamburguesa vegana con ensalada y sopa en Mapa Verde',
	},
	{
		src: bol,
		alt: 'Bol de couscous con aguacate, col morada, pimientos asados y verduras',
	},
	{
		src: guacamole,
		alt: 'Guacamole con chips de verduras en una tabla de madera',
	},
	{
		src: ensalada,
		alt: 'Ensalada de fresas con una bola de queso vegano y semillas sobre un plato rosa',
	},
	{
		src: falafel,
		alt: 'Bol con bolitas vegetales fritas, coliflor, aguacate y zanahoria',
	},
	{
		src: couscous,
		alt: 'Bol de couscous con garbanzos, calabacín, calabaza y coliflor',
	},
	{
		src: postre,
		alt: 'Postre vegano en vaso con crema, frutos rojos y crumble',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#mapa-verde`,
	name: BUSINESS.name,
	alternateName: ['Mapa Verde Donostia', 'Mapa Verde Gros', 'Restaurante Mapa Verde'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: `+34 ${BUSINESS.phone}`,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Vegana', 'Vegetariana'],
	areaServed: [
		{ '@type': 'City', name: 'Donostia / San Sebastián' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '12:30',
			closes: '15:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Mapa Verde · Restaurante vegano en Gros, Donostia';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f4b38" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700&family=Gloock&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Mapa Verde, restaurante vegano Donostia, comer vegano Gros, restaurante vegano San Sebastián, comida vegana Donostia, Mapa Verde Trueba Kalea, restaurante saludable Donostia"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Restaurante vegano en Trueba Kalea, 4 (Gros, Donostia). Cocina consciente y comida real, con 4,7 sobre 5 en Google. Abre al mediodía y cierra los domingos."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Mesa de Mapa Verde con tres platos de bowl, pan y vino"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1f4b38"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Gros, Donostia"
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Mapa Verde"
			subtitle="Vegano · Gros"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Trueba Kalea, 4 · Gros, Donostia"
				title="Cocina consciente <br /><em>en Gros.</em>"
				lede={`Mapa Verde es un pequeño restaurante vegano en Trueba Kalea, 4, en el barrio de Gros de Donostia. Cocina consciente y comida real, 100% libre de crueldad animal, con 4,7 sobre 5 en Google y 893 reseñas. Abre al mediodía de lunes a sábado y cierra los domingos: para venir, llama al ${BUSINESS.phone}.`}
				image={comedor}
				imageAlt="Comedor de Mapa Verde con pared de piedra, muebles de madera y sillas verdes"
				primaryCta={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,7</b> en Google · 893 reseñas' },
					{ label: 'Cocina', html: '<b>100%</b> vegetal' },
					{ label: 'Horario', html: '<b>12:30–15:30</b> · domingo cerrado' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Mapa Verde" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Pequeño, verde <br /><em>y consciente.</em>"
				paragraphs={[
					'Mapa Verde está en Trueba Kalea, 4, en pleno barrio de Gros de Donostia: un comedor pequeño y cálido, con paredes de piedra, madera, papel de árboles y sillas verdes.',
					'Google lo clasifica como restaurante vegano y le da 4,7 sobre 5 con 893 reseñas. Su ficha publica el teléfono y el horario, pero no carta, precios, correo ni web propia, así que esta web no inventa nada de eso.',
					'El propio restaurante se describe como cocina consciente y comida real, «100% libre de crueldad animal». Sus reseñas destacan la burrata, el guacamole, las patatas, la sopa thai, el tiramisú y la tarta de queso vegana, además de las «raciones generosas».',
					'Abre solo al mediodía, de lunes a sábado de 12:30 a 15:30, y cierra los domingos. Conviene llamar antes para confirmar mesa y horario.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «La burrata, guacamole, patatas, sopa thai y el tiramisú TODO INCREÍBLE».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La mesa"
				title="Verde, variado <br /><em>y real.</em>"
				description="La ficha de Google no publica carta ni precios y el restaurante no tiene web propia. Esto es lo que citan sus reseñas y la descripción del propio local."
				cta={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados ni carta en la ficha. Para saber qué hay hoy, lo más directo es llamar al 943 84 18 62."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Diez fotos <br /><em>de la mesa.</em>"
				description="Las diez fotografías publicadas en el perfil de Mapa Verde en Google Maps: el comedor y sus platos."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a Gros <br /><em>a comer.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, `${BUSINESS.regionName}, España`]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario de la ficha de Google: de lunes a sábado, de 12:30 a 15:30. Los domingos cierra. Conviene confirmarlo por teléfono antes de ir."
				mapTitle="Mapa de Mapa Verde en Trueba Kalea, 4, Gros (Donostia)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Mapa Verde · Gros, Donostia"
				mapHref={MAPS.cid}
				links={[
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref, variant: 'primary' },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="El teléfono 943 84 18 62 es el único canal de contacto que publica la ficha de Google: no hay correo ni web propia. La ficha marca aparcamiento adaptado para sillas de ruedas."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Mapa Verde"
		/>
	</body>
</html>
