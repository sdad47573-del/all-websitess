---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import bandeja from '../assets/fotos/fry-apaisada-01.jpg';
import logo from '../assets/fotos/fry-panoramica-06.jpg';
import cartelArte from '../assets/fotos/fry-vertical-02.jpg';
import mesas from '../assets/fotos/fry-vertical-03.jpg';
import bandejas from '../assets/fotos/fry-vertical-04.jpg';
import pedido from '../assets/fotos/fry-vertical-05.jpg';
import cartaPoster from '../assets/fotos/fry-vertical-07.jpg';
import burgerMano from '../assets/fotos/fry-vertical-08.jpg';
import burgerPapel from '../assets/fotos/fry-vertical-09.jpg';
import cono from '../assets/fotos/fry-vertical-10.jpg';

import {
	ALERGENOS,
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	RESENAS,
	SERVICIOS,
	SOCIALS,
} from '../data/site';

const title = 'FRY. · Pollo frito picante a domicilio en Madrid';
const description = BUSINESS.description;

const galeria = [
	{
		src: logo,
		alt: 'Logotipo de FRY. en blanco y rojo sobre fondo negro',
	},
	{
		src: cartelArte,
		alt: 'Cartel de FRY. con una hamburguesa de pollo, salsa y el lema «El pollo también es un arte»',
	},
	{
		src: pedido,
		alt: 'Pedido completo de FRY. con envases, salsas, hamburguesas, alitas, patatas y maíz',
	},
	{
		src: cono,
		alt: 'Hamburguesa de pollo, cono de patatas y tarrinas de salsa sobre papel de cuadros',
	},
	{
		src: mesas,
		alt: 'Varias hamburguesas de pollo y bandejas de patatas y maíz sobre la mesa',
	},
	{
		src: bandejas,
		alt: 'Bandejas de aluminio con patatas, pollo frito y hamburguesas',
	},
	{
		src: burgerMano,
		alt: 'Hamburguesa de pollo con salsa FRY. sostenida con la mano',
	},
	{
		src: burgerPapel,
		alt: 'Hamburguesa de pollo en pan brioche sobre papel de cuadros rojo y blanco',
	},
	{
		src: cartaPoster,
		alt: 'Cartel de la carta completa de FRY. con precios de pollo, hamburguesas, patatas, salsas y bebidas',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de FRY.',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: Number(item.price.match(/[\d,]+/)?.[0]?.replace(',', '.') ?? 0),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#fry`,
	name: BUSINESS.name,
	alternateName: ['FRY Madrid', 'FRY Villaverde', 'FRY pollo frito'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, MAPS.website, SOCIALS.instagram, SOCIALS.tiktok],
	telephone: '+34669765785',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo frito', 'Hamburguesas', 'Comida a domicilio'],
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Villaverde' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	hasDelivery: true,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '19:30',
			closes: '23:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reparto', href: '#reparto' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"fry-apaisada-01.jpg": bandeja,
	"fry-panoramica-06.jpg": logo,
	"fry-vertical-02.jpg": cartelArte,
	"fry-vertical-05.jpg": pedido,
	"fry-vertical-10.jpg": cono,
	"fry-vertical-03.jpg": mesas,
	"fry-vertical-04.jpg": bandejas,
	"fry-vertical-08.jpg": burgerMano,
	"fry-vertical-09.jpg": burgerPapel,
	"fry-vertical-07.jpg": cartaPoster,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#111111" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="FRY Madrid, FRY pollo frito, pollo frito picante Villaverde, pollo frito a domicilio Madrid, hamburguesa de pollo Madrid, FRY BITES, salsa FRY, reparto pollo frito Villaverde"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo frito picante con doble rebozado, hamburguesas de pollo entero, tiras, FRY BITES y salsas caseras. Solo a domicilio en Madrid. 5,0 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bandeja de pollo frito picante de FRY. con patatas y hamburguesa"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#111111"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Villaverde, Madrid"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[bandeja]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="FRY."
			subtitle="Pollo frito · Madrid"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="FRY."
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.neighbourhood}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Web oficial ↗', href: MAPS.website, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos, carta y fotografías de la ficha pública de Google Maps y de la web oficial del local, consultadas en octubre de 2026. Los precios pueden cambiar."
			ctaLabel="Pedir a FRY."
			navAriaLabel="Enlaces de FRY."
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34669765785?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carta%20de%20FRY.." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carta de FRY."><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>

<style>
	.reparto-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 1.5rem 2rem;
		margin: 2.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.reparto-grid li {
		padding-top: 1.1rem;
		border-top: 1px solid rgba(245, 208, 0, 0.35);
	}

	.reparto-grid h3 {
		margin-bottom: 0.5rem;
		font-size: 1.15rem;
		letter-spacing: -0.02em;
	}

	.reparto-grid p {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.7;
		color: rgba(255, 248, 231, 0.72);
	}

	.reparto-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 2.25rem;
	}

	.reparto-note {
		margin: 2rem 0 0;
		max-width: 42rem;
		font-size: 0.82rem;
		line-height: 1.7;
		color: rgba(255, 248, 231, 0.55);
	}
</style>
