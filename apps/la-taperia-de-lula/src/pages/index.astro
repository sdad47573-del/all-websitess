---
import '../styles/global.css';

const business = {
	name: 'La Tapería de Lula',
	altName: 'La Cocina de Lula',
	stand: 'Puesto nº 3 · Zona gastronómica',
	market: 'Mercado Central de Abastos',
	street: 'Pl. Libertad, 1',
	city: 'Cádiz',
	postalCode: '11005',
	phone: '+34 607 57 94 34',
	latitude: 36.5301094,
	longitude: -6.2985087,
	site: 'https://la-taperia-de-lula.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+La+Taperia+de+Lula+%2F+La+Cocina+de+Lula/@36.5301094,-6.2985087,17z/data=!3m1!4b1!4m6!3m5!1s0xd0dd161d3c45d0d:0xa79bd4a7590b467b!8m2!3d36.5301094!4d-6.2985087!16s%2Fg%2F11c2j2w_gn?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const phoneHref = 'tel:+34607579434';

const specialties = [
	{
		kicker: 'Cordobesa',
		title: 'Salmorejo',
		text: 'El plato insignia según las reseñas: salmorejo muy bueno, cremoso y con el punto justo de la tierra.',
	},
	{
		kicker: 'Hecho a mano',
		title: 'Flamenquines',
		text: 'Flamenquín generoso y totalmente artesano. Cocina típica cordobesa en pleno mercado gaditano.',
	},
	{
		kicker: 'Al perol',
		title: 'Paella y arroces',
		text: 'Paella mixta, arroz negro con alioli y arroz al perol en su punto. Raciones de 2,50 a 5 €.',
	},
	{
		kicker: 'Fresco',
		title: 'Gazpacho y patatas',
		text: 'Vasito de gazpacho para refrescar y patatas riquísimas. Ideal para picar paseando por el centro.',
	},
	{
		kicker: 'Verdura',
		title: 'Berenjena gratinada',
		text: 'Gratín de berenjena rellena de verduras. Hay opciones veganas y mucha carta apta para celíacos.',
	},
	{
		kicker: 'Sin gluten',
		title: 'Apta para celíacos',
		text: 'La dueña es celíaca: gran parte de la carta es sin gluten. Pregunta y te asesoran plato a plato.',
	},
];

const gallery = [
	{ src: '/fotos/mercado.svg', alt: 'Ilustración del puesto nº 3 en el Mercado Central — sustituye por foto propia' },
	{ src: '/fotos/paella.svg', alt: 'Ilustración de la paella mixta — sustituye por foto propia del puesto' },
	{ src: '/fotos/salmorejo.svg', alt: 'Ilustración del salmorejo cordobés — sustituye por foto propia' },
	{ src: '/fotos/flamenquin.svg', alt: 'Ilustración del flamenquín casero — sustituye por foto propia' },
	{ src: '/fotos/arroz-negro.svg', alt: 'Ilustración del arroz negro con alioli — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está La Tapería de Lula?',
		a: 'En el puesto nº 3 de la zona gastronómica del Mercado Central de Abastos, Pl. Libertad, 1, 11005 Cádiz, en pleno centro.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Lunes y domingo cerrado. Martes y miércoles de 10:30 a 16:00. Jueves de 10:30 a 16:00 y de 20:00 a 24:00. Viernes de 10:30 a 16:00 y de 20:00 a 0:30. Sábados de 10:30 a 17:00 y de 20:00 a 1:00. Depende de la afluencia del mercado: confirma en el 607 57 94 34.',
	},
	{
		q: '¿Se puede reservar?',
		a: 'Es un puesto de mercado con raciones para comer allí o llevar. Llama al 607 57 94 34 para consultar disponibilidad.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Cocina cordobesa y arroces: salmorejo, flamenquines caseros, paella mixta, arroz negro con alioli, arroz al perol, gazpacho y berenjena gratinada. Precios económicos, raciones de 2,50 a 5 €.',
	},
	{
		q: '¿Hay opciones sin gluten?',
		a: 'Sí, y es uno de sus puntos fuertes: la dueña es celíaca y gran parte de la carta es sin gluten, además de opciones veganas.',
	},
];

const description =
	'La Tapería de Lula / La Cocina de Lula: cocina cordobesa y arroces en el puesto nº 3 del Mercado Central, Pl. Libertad 1 (Cádiz). Salmorejo, flamenquines y paella. Llama al 607 57 94 34.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: business.altName,
	description,
	url: `${business.site}/`,
	telephone: '+34 607 57 94 34',
	image: [`${business.site}/fotos/mercado.svg`],
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cordobesa', 'Tapas', 'Arroces', 'Mediterránea'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: `${business.market}, ${business.stand} (${business.street})`,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'False',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday'],
			opens: '10:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Thursday',
			opens: '10:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Thursday',
			opens: '20:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Friday',
			opens: '10:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Friday',
			opens: '20:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '10:30',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '20:00',
			closes: '24:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Opciones sin gluten', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Opciones veganas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Comida para llevar', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.5,
		reviewCount: 57,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#4a2415" />
		<meta name="description" content="La Tapería de Lula / La Cocina de Lula: cocina cordobesa y arroces en el Mercado Central, Pl. Libertad 1 (Cádiz). Salmorejo, flamenquines y paella. 607 57 94 34." />
		<meta name="keywords" content="La Tapería de Lula Cádiz, La Cocina de Lula, Mercado Central Cádiz comer, salmorejo Cádiz, flamenquín Cádiz, paella mercado abastos, Pl. Libertad 1, puesto mercado Cádiz" />
		<meta name="author" content="La Tapería de Lula" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>La Tapería de Lula | Cocina cordobesa en el Mercado de Cádiz</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="La Tapería de Lula · Salmorejo y arroces en el Mercado Central" />
		<meta property="og:description" content="Salmorejo, flamenquines caseros y paella en el puesto nº 3 del Mercado Central, Pl. Libertad 1 (Cádiz). Bueno, bonito y barato." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/mercado.svg`} />
		<meta property="og:image:alt" content="La Tapería de Lula, puesto de comida en el Mercado Central de Cádiz" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="La Tapería de Lula · Cocina cordobesa en el Mercado de Cádiz" />
		<meta name="twitter:description" content="Salmorejo, flamenquines y arroces en el Mercado Central, Pl. Libertad 1, Cádiz." />
		<meta name="twitter:image" content={`${business.site}/fotos/mercado.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Cádiz" />
		<meta name="geo.position" content="36.5301094;-6.2985087" />
		<meta name="ICBM" content="36.5301094, -6.2985087" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="La Tapería de Lula, inicio">
				<span class="brand-mark" aria-hidden="true">L</span>
				<span class="brand-name">La Tapería de Lula <small>Mercado Central · Cádiz</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#puesto">El puesto</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>607 57 94 34</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Puesto nº 3 · Mercado Central</p>
					<h1 id="hero-title">Córdoba en Cádiz,<br />en el puesto <em>nº 3.</em></h1>
					<p class="hero-lede">
						Tapería en la zona gastronómica del Mercado Central: salmorejo, flamenquines caseros,
						paella y arroz negro. Raciones generosas de 2,50 a 5 €, con opciones sin gluten.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a class="button button-ghost" href={phoneHref}>Llamar 607 57 94 34</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,5</b> (57 reseñas)</li>
						<li>Mar–sáb</li>
						<li>Sin gluten</li>
						<li>Para llevar</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/fotos/mercado.svg" alt="Ilustración del puesto nº 3 de La Tapería de Lula en el Mercado Central de Cádiz" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Mercado Central · Cádiz</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>4,5</b><span>Valoración</span></div>
					<div><b>3 €</b><span>Ración desde</span></div>
					<div><b>SG</b><span>Sin gluten</span></div>
				</div>
				<ul class="services">
					<li>Mercado</li>
					<li>Tapas</li>
					<li>Arroces</li>
					<li>Sin gluten</li>
					<li>Vegano</li>
					<li>Para llevar</li>
				</ul>
			</section>

			<section class="about section-pad" id="puesto">
				<p class="section-label"><span aria-hidden="true"></span> Un puesto con duende</p>
				<div class="about-grid">
					<h2>Comida casera<br />para comer allí <em>o llevar.</em></h2>
					<div class="about-copy">
						<p>
							La Tapería de Lula —también conocida como La Cocina de Lula— es el puesto nº 3 de la zona
							gastronómica del Mercado Central de Abastos, en Pl. Libertad, 1. Raciones para comer allí,
							con tenedor y servilleta, o para llevar y seguir la ruta por la ciudad.
						</p>
						<p>
							Su especialidad es la cocina cordobesa: salmorejo, flamenquines hechos a mano y gazpacho,
							junto a arroces en su punto —paella mixta, arroz negro con alioli y arroz al perol— además
							de patatas y berenjena gratinada.
						</p>
						<p class="about-note">
							Abre de martes a sábado; lunes y domingo cierra. El horario depende de la afluencia del
							mercado, así que antes de ir confirma en el 607 57 94 34. Trato familiar y precio económico.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su carta</p>
						<h2>Lo que más<br />se pide <em>en el puesto.</em></h2>
					</div>
					<p>
						Platos citados en las reseñas de sus clientes. La oferta del día cambia según mercado:
						confirma disponibilidad al llamar.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El puesto<br /><em>y sus platos.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del puesto.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Mercado Central · Puesto nº 3</p>
					<h2>Ven al mercado<br /><em>a comer.</em></h2>
					<p class="address">
						{business.market}, {business.stand}<br />
						{business.street}, {business.postalCode} {business.city}
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Martes y miércoles</th>
								<td>10:30 – 16:00</td>
							</tr>
							<tr>
								<th scope="row">Jueves</th>
								<td>10:30 – 16:00 · 20:00 – 24:00</td>
							</tr>
							<tr>
								<th scope="row">Viernes</th>
								<td>10:30 – 16:00 · 20:00 – 0:30</td>
							</tr>
							<tr>
								<th scope="row">Sábado</th>
								<td>10:30 – 17:00 · 20:00 – 1:00</td>
							</tr>
							<tr>
								<th scope="row">Lunes y domingo</th>
								<td>Cerrado</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Horario según directorios públicos. Depende de la afluencia del mercado: llama antes de ir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al puesto ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 607 57 94 34</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de La Tapería de Lula en el Mercado Central, Pl. Libertad 1, Cádiz" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> La Tapería de Lula · Cádiz</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">L</span>
				<p>La Tapería de Lula<small>Mercado Central · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del puesto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} La Tapería de Lula · Cádiz. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al puesto <span>607 57 94 34</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
