---
import '../styles/global.css';

const business = {
	name: 'Wayu Garden',
	legalName: 'Restaurante Wayu Garden - The Healthy Alternative',
	tagline: 'The Healthy Alternative',
	street: 'Calle la Bohème, 4',
	district: 'Cruz de Humilladero',
	city: 'Málaga',
	postalCode: '29006',
	phone: '640 63 65 85',
	latitude: 36.7106182,
	longitude: -4.4682854,
	site: 'https://wayu-garden.vercel.app',
	web: 'https://wayugarden.es',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+Wayu+Garden+-+The+Healthy+Alternative/@36.7106182,-4.4682854,17z/data=!3m1!4b1!4m6!3m5!1s0xd72f74e121da101:0x398d476d3a3aaf67!8m2!3d36.7106182!4d-4.4682854!16s%2Fg%2F11htq99y83';
const reviewsUrl = 'https://search.google.com/local/reviews?placeid=ChIJAaEdEk73cg0RZ686Om1HjTk';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34640636585';
const instagramUrl = 'https://www.instagram.com/wayu.garden/';
const menuComidasUrl = 'https://wayugarden.es/carta-comidas/';
const menuDesayunosUrl = 'https://wayugarden.es/carta-desayunos/';

const photos = {
	hero: '/fotos/wayu-garden-malaga.jpg',
	foto1: '/fotos/wayu-garden-malaga-foto-1.jpg',
	foto2: '/fotos/wayu-garden-malaga-foto-2.jpg',
	foto3: '/fotos/wayu-garden-malaga-foto-3.jpg',
	foto4: '/fotos/wayu-garden-malaga-foto-4.jpg',
	foto5: '/fotos/wayu-garden-malaga-foto-5.jpg',
	foto6: '/fotos/wayu-garden-malaga-foto-6.jpg',
};

const servicios = [
	'Menú del día',
	'Desayunos desde las 8:00',
	'Café ecológico',
	'Poke bowls',
	'Hamburguesas gourmet',
	'Opción vegana',
	'Pan sin gluten',
	'Zumos naturales',
	'Local accesible',
];

const carta = [
	{
		title: 'Para empezar',
		items: [
			{ nombre: 'Patatas kimchi', precio: '6,90 €', nota: 'patatas con espuma kimchi' },
			{ nombre: 'Rusa Wayu', precio: '6,70 €', nota: 'la rusa de toda la vida' },
			{ nombre: 'Gyozas', precio: '7,00 €' },
			{ nombre: 'Croquetas de puchero', precio: '7,90 €' },
			{ nombre: 'Croquetas de rabo de toro', precio: '8,90 €' },
			{ nombre: 'Croquetas de gambas al pil-pil', precio: '8,90 €' },
			{ nombre: 'Revuelto de huevos', precio: '7,20 €', nota: 'con patatas, jamón serrano y pimientos' },
		],
	},
	{
		title: 'Ensaladas',
		items: [
			{ nombre: 'Cabrita', precio: '7,80 €', nota: 'lechugas, queso de cabra, cebolla caramelizada y nueces' },
			{ nombre: 'Basic', precio: '6,90 €', nota: 'lechuga, tomate, cebolla, aceituna, atún y huevo' },
			{ nombre: 'César', precio: '8,90 €', nota: 'pollo, parmesano, picatostes y tomate cherry' },
		],
	},
	{
		title: 'Poke bowls',
		items: [
			{ nombre: 'Sakaguchi', precio: '9,90 €', nota: 'arroz, edamame, salmón, mango, aguacate y salsa kimchi' },
			{ nombre: 'Mikami', precio: '9,90 €', nota: 'atún, aguacate, edamame, manzana y vinagreta de mostaza y miel' },
			{ nombre: 'Veggie', precio: '9,90 €', nota: 'base de arroz, aguacate, edamame, mango y vinagreta de miel y limón' },
			{ nombre: 'Kojima', precio: '9,90 €', nota: 'puntillita de solomillo, tomate y dos huevos camperos' },
		],
	},
	{
		title: 'Hamburguesas gourmet',
		items: [
			{ nombre: 'Vegana', precio: '7,90 €' },
			{ nombre: 'Cabrita', precio: '8,90 €', nota: 'pollo, queso de cabra, cebolla caramelizada y pimientos asados' },
			{ nombre: 'Ternerita', precio: '9,90 €', nota: 'vaca madurada, aguacate, queso manchego y salsa de trufa' },
			{ nombre: 'Trufa Eco', precio: '10,90 €' },
			{ nombre: 'Wayu', precio: '10,90 €', nota: 'vaca madurada, bacon, huevo, cheddar y kétchup' },
			{ nombre: 'Andaluza', precio: '11,40 €', nota: 'buey, jamón serrano, queso manchego y rúcula' },
		],
	},
	{
		title: 'Pizzas',
		items: [
			{ nombre: 'Margarita', precio: '8,00 €' },
			{ nombre: 'Barbacoa', precio: '8,00 €' },
			{ nombre: 'Prosciutto', precio: '8,50 €' },
			{ nombre: 'Prosciutto funghi', precio: '8,50 €' },
			{ nombre: 'Nórdica', precio: '10,40 €', nota: 'salmón, queso de cabra y cebolla' },
		],
	},
	{
		title: 'Para los peques',
		items: [
			{ nombre: 'Nuggets de pollo', precio: '7,00 €', nota: 'con guarnición de patatas' },
			{ nombre: 'Lágrimas de pollo', precio: '7,00 €' },
			{ nombre: 'Mini burguer', precio: '7,00 €', nota: 'lechuga, queso, tomate y kétchup' },
		],
	},
	{
		title: 'Postres',
		items: [
			{ nombre: 'Tarta de galletas', precio: '4,80 €' },
			{ nombre: 'Tarta de queso', precio: '4,80 €' },
			{ nombre: 'Flan casero', precio: '3,00 €' },
		],
	},
];

const desayunos = [
	{ nombre: 'Cafés ecológicos', precio: '1,60 €', nota: 'espresso, cortado, americano, cappuccino o bombón' },
	{ nombre: 'Pitufos', precio: 'desde 1,80 €', nota: 'aceite, mixto, catalana, bacon, vegetal y más' },
	{ nombre: 'Croissant mixto', precio: '2,00 €' },
	{ nombre: 'Yogur griego bowl', precio: '4,90 €', nota: 'fruta del día, miel y canela' },
	{ nombre: 'Zumo de naranja natural', precio: '2,00 € / 3,80 €', nota: 'pequeño o grande' },
	{ nombre: 'Mango Mambo', precio: '4,50 €', nota: 'batido de aguacate, mango, limón, miel y leche' },
];

const galeria = [
	{ src: photos.foto1, alt: 'Fotografía de Wayu Garden publicada en su ficha de Google Maps (Málaga)' },
	{ src: photos.foto2, alt: 'Imagen de Wayu Garden, restaurante healthy en la calle la Bohème, Málaga' },
	{ src: photos.foto3, alt: 'Foto de Wayu Garden en Cruz de Humilladero, Málaga, desde Google Maps' },
	{ src: photos.foto4, alt: 'Detalle de Wayu Garden (Málaga) según su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Fotografía de Wayu Garden, restaurante y cafetería en Málaga' },
	{ src: photos.foto6, alt: 'Imagen de Wayu Garden en la calle la Bohème, 4, Málaga' },
];

const faqs = [
	{
		q: '¿Dónde está el restaurante Wayu Garden?',
		a: 'En la calle la Bohème, 4, en el barrio de Cruz de Humilladero (29006 Málaga), muy cerca de la zona de Teatinos y del polígono Alameda.',
	},
	{
		q: '¿Cuál es el horario de Wayu Garden?',
		a: 'Abre de lunes a viernes de 8:00 a 19:00 y los sábados de 9:30 a 13:30. Los domingos permanece cerrado. En festivos o puentes conviene confirmar antes por teléfono.',
	},
	{
		q: '¿Tienen menú del día?',
		a: 'Sí. El menú del día incluye primer plato, segundo plato, una bebida y postre o café, por unos 11 €. El menú cambia a diario y se consulta en el establecimiento.',
	},
	{
		q: '¿Hay opciones veganas, vegetarianas o sin gluten?',
		a: 'Sí: hay hamburguesa vegana, poke bowl Veggie y ensaladas, y disponen de pan sin gluten (conviene pedirlo al personal). Es la propuesta «healthy» de la casa.',
	},
	{
		q: '¿Se puede desayunar allí?',
		a: 'Sí, es una de sus señas de identidad. Sirven desayunos desde las 8:00 con cafés 100 % ecológicos, pitufos, croissants, yogur griego con fruta y zumos naturales.',
	},
	{
		q: '¿Se puede reservar y pedir para llevar?',
		a: 'Se puede llamar por teléfono para reservar mesa, sobre todo para grupos. También preparan platos para llevar según disponibilidad.',
	},
	{
		q: '¿Dónde puedo ver la carta completa?',
		a: 'En la web oficial del restaurante, wayugarden.es, con la carta de desayunos y la carta de comidas actualizadas, además de esta página.',
	},
];

const description =
	'Restaurante healthy en Málaga (Cruz de Humilladero): menú del día, poke bowls, hamburguesas gourmet, pizzas, opción vegana, pan sin gluten y desayunos con café ecológico en la calle la Bohème, 4. Teléfono 640 63 65 85.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: business.legalName,
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 640 63 65 85',
	image: [
		`${business.site}${photos.hero}`,
		`${business.site}${photos.foto1}`,
		`${business.site}${photos.foto2}`,
		`${business.site}${photos.foto3}`,
	],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo, tarjeta de crédito',
	servesCuisine: ['Healthy', 'Poke bowl', 'Hamburguesas', 'Pizza', 'Desayunos'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [instagramUrl, business.web],
	hasMenu: menuComidasUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:00',
			closes: '19:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '09:30',
			closes: '13:30',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Opciones veganas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Pan sin gluten', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Menú del día', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.5,
		reviewCount: 100,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1f2a24" />
		<meta
			name="description"
			content="Wayu Garden, restaurante healthy en Málaga: menú del día por unos 11 €, poke bowls, hamburguesas gourmet, pizzas, opción vegana y pan sin gluten. Calle la Bohème, 4."
		/>
		<meta
			name="keywords"
			content="Wayu Garden Málaga, restaurante healthy Málaga, menú del día Cruz de Humilladero, poke bowl Málaga, hamburguesas gourmet Málaga, restaurante vegano Málaga, sin gluten Málaga, desayunos Málaga, café ecológico, Calle la Bohème 4"
		/>
		<meta name="author" content="Wayu Garden" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Sora:wght@600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Wayu Garden | Restaurante healthy con menú del día en Málaga</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Wayu Garden · Menú del día y comida healthy en Málaga" />
		<meta
			property="og:description"
			content="Menú del día, poke bowls, hamburguesas gourmet y desayunos con café ecológico. Calle la Bohème, 4 (Málaga)."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero}`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="801" />
		<meta property="og:image:alt" content="Wayu Garden, restaurante healthy en Málaga" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Wayu Garden · Comida healthy y menú del día en Málaga" />
		<meta
			name="twitter:description"
			content="Poke bowls, hamburguesas gourmet, opción vegana y desayunos con café ecológico en la calle la Bohème, 4 (Málaga)."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7106182;-4.4682854" />
		<meta name="ICBM" content="36.7106182, -4.4682854" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Wayu Garden, inicio">
				<span class="brand-mark" aria-hidden="true">W</span>
				<span class="brand-name">Wayu Garden <small>Málaga · The Healthy Alternative</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">Carta</a>
				<a href="#desayunos">Desayunos</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>640 63 65 85</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Cruz de Humilladero · Málaga</p>
					<h1 id="hero-title">Comer rico<br />y comer bien,<br /><em>sin renunciar a nada.</em></h1>
					<p class="hero-lede">
						Restaurante y cafetería en la calle la Bohème. Menú del día, poke bowls, hamburguesas
						gourmet, pizzas y desayunos con café ecológico. Tú eliges: carta o menú del día.
					</p>
					<div class="hero-actions">
						<a class="button button-citrus" href={phoneHref}>Llamar 640 63 65 85</a>
						<a class="button button-ghost" href={menuComidasUrl} target="_blank" rel="noreferrer">
							Ver la carta completa <span aria-hidden="true">↗</span>
						</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,5</b> en Google</li>
						<li>Menú del día por unos 11 €</li>
						<li>Poke bowls y veggie</li>
						<li>Desayunos desde las 8:00</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img
						src={photos.hero}
						width="1200"
						height="801"
						alt="Fotografía de Wayu Garden publicada en su ficha de Google Maps (Málaga)"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver la galería ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Servicios del restaurante">
				<ul class="chips">
					{servicios.map((servicio) => <li>{servicio}</li>)}
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> La alternativa saludable de Cruz de Humilladero</p>
				<div class="about-grid">
					<h2>Cocina de barrio<br />con la carta<br /><em>más verde.</em></h2>
					<div class="about-copy">
						<p>
							Wayu Garden es un restaurante y cafetería de la calle la Bohème, 4, en Cruz de
							Humilladero. Su propuesta es la de siempre pero con un giro healthy: platos de barra,
							brasas y pizzas conviven con poke bowls, ensaladas, opciones veganas y pan sin gluten.
						</p>
						<p>
							El local funciona de arriba abajo: por la mañana es cafetería de desayunos (con cafés 100 %
							ecológicos), a mediodía menú del día y carta, y por la tarde sigue sirviendo comidas y
							meriendas. Precios de barrio para una carta larga.
						</p>
						<p class="about-note">
							Lo que más se repite en las reseñas públicas: que todo está rico y que el equipo es
							amable y atento. Y un consejo práctico: en fin de semana conviene llamar, porque el
							aforo es limitado y el horario del sábado es más corto.
						</p>
						<div class="about-links">
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">
								Instagram del restaurante <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href={reviewsUrl} target="_blank" rel="noreferrer">
								Leer reseñas en Google <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="menu section-pad" id="carta">
				<div class="menu-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Carta de comidas</p>
						<h2>Qué pedir<br />en <em>Wayu Garden.</em></h2>
					</div>
					<div>
						<p>
							Selección de la carta de comidas publicada por el propio restaurante. Hay carta
							completa en su web y menú del día: primero, segundo, bebida y postre o café.
						</p>
						<a class="button button-green" href={menuComidasUrl} target="_blank" rel="noreferrer">
							Carta de comidas completa <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>

				<div class="menu-grid">
					{
						carta.map((bloque) => (
							<article class="menu-card">
								<h3>{bloque.title}</h3>
								<ul>
									{bloque.items.map((item) => (
										<li>
											<span class="dish">
												{item.nombre}
												{item.nota ? <em>{item.nota}</em> : null}
											</span>
											<span class="price">{item.precio}</span>
										</li>
									))}
								</ul>
							</article>
						))
					}
				</div>
				<p class="menu-note">
					Precios según la carta publicada por el establecimiento; pueden cambiar. El menú del día se
					consulta en el local y ronda los 11 € con bebida y postre o café.
				</p>
			</section>

			<section class="desayunos section-pad" id="desayunos">
				<div class="desayunos-grid">
					<div class="desayunos-copy">
						<p class="eyebrow dark"><span aria-hidden="true"></span> Keep it local</p>
						<h2>Desayunos<br />con café <em>ecológico.</em></h2>
						<p>
							Los desayunos son una de las señas de la casa: cafés 100 % ecológicos, pitufos de todo
							tipo, croissants, bollería y opciones fit como el yogur griego con fruta, miel y canela.
							También hay pan sin gluten si lo pides al personal.
						</p>
						<a class="button button-green" href={menuDesayunosUrl} target="_blank" rel="noreferrer">
							Carta de desayunos <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="desayunos-list">
						<ul>
							{
								desayunos.map((item) => (
									<li>
										<span class="dish">
											{item.nombre}
											<em>{item.nota}</em>
										</span>
										<span class="price">{item.precio}</span>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>El local,<br /><em>por dentro.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden del perfil de Google Maps de Wayu Garden. En la ficha está
							la galería completa, con las aportaciones de otros clientes.
						</p>
						<a class="button button-citrus" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver todo en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						galeria.map((foto) => (
							<figure class="shot">
								<img src={foto.src} alt={foto.alt} loading="lazy" decoding="async" width="960" height="960" />
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Imágenes alojadas en esta web procedentes de la ficha de Google Maps del restaurante. Si eres
					el titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow dark"><span aria-hidden="true"></span> Calle la Bohème, 4 · 29006 Málaga</p>
					<h2>Nos vemos<br /><em>en la Bohème.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.district}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr><th scope="row">Lunes a viernes</th><td>8:00 – 19:00</td></tr>
							<tr><th scope="row">Sábado</th><td>9:30 – 13:30</td></tr>
							<tr><th scope="row">Domingo</th><td>Cerrado</td></tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha pública del restaurante. En festivos y puentes, llama antes para
						confirmar.
					</p>

					<div class="visit-links">
						<a class="button button-citrus" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-outline" href={business.web} target="_blank" rel="noreferrer">
							Web oficial <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 {business.phone}</a>
					<p class="reserve-note">
						Reservas por teléfono, también para grupos. Si buscas comida para llevar, pregunta por la
						disponibilidad del día.
					</p>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Wayu Garden en la calle la Bohème, 4, Cruz de Humilladero, Málaga"
						src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Wayu Garden · Málaga
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">W</span>
				<p>
					Wayu Garden
					<small>{business.street} · {business.postalCode} {business.city}</small>
				</p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={business.web} target="_blank" rel="noreferrer">Web oficial ↗</a>
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={reviewsUrl} target="_blank" rel="noreferrer">Reseñas ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Wayu Garden · Málaga. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
</footer>

