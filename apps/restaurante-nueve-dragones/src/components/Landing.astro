---
import '../styles/global.css';
import { business, directionsUrl, mapEmbedUrl, mapsUrl, phoneHref, restaurantSchema } from '../lib/business';
import { content } from '../lib/content';
import Galeria from './Galeria.astro';

interface Props {
	locale: 'es' | 'en';
}

const { locale } = Astro.props;
const page = content[locale];
const canonical = `${business.site}${page.path}`;
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: page.faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang={page.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#183d36" />
		<meta name="description" content={page.description} />
		<meta name="keywords" content={page.keywords} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="La Cala de Mijas, Mijas" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="es" href={`${business.site}/`} />
		<link rel="alternate" hreflang="en" href={`${business.site}/en/`} />
		<link rel="alternate" hreflang="x-default" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap" rel="stylesheet" />
		<title>{page.title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content={page.locale} />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={page.title} />
		<meta property="og:description" content={page.description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={`${business.site}/social-card.svg`} />
		<meta property="og:image:alt" content="Ilustración vectorial original inspirada en Nueve Dragones; no es una fotografía del restaurante" />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.neighborhood} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="Spain" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={page.title} />
		<meta name="twitter:description" content={page.description} />
		<meta name="twitter:image" content={`${business.site}/social-card.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#main">{page.skip}</a>
		<header class="site-header">
			<a class="brand" href={page.path} aria-label={`${business.name} · ${page.navLabel}`}>
				<span class="brand-mark" aria-hidden="true">龍</span>
				<span class="brand-name">NUEVE DRAGONES<small>LA CALA DE MIJAS · MÁLAGA</small></span>
			</a>
			<nav aria-label={page.navLabel}>{page.nav.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
			<div class="header-actions"><a class="language" href={page.languageHref} lang={locale === 'es' ? 'en' : 'es'}>{page.languageLabel}</a><a class="header-call" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a></div>
		</header>

		<main id="main">
			<section class="hero" id={locale === 'es' ? 'restaurante' : 'restaurant'} aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true">✳</span>{page.eyebrow}</p>
					<h1 id="hero-title">{page.titleLines[0]}<br /><em>{page.titleLines[1]}</em><br />{page.titleLines[2]}</h1>
					<p class="hero-intro">{page.intro}</p>
					<div class="hero-actions"><a class="button button-primary" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a><a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">{page.directionsCta}<span aria-hidden="true">↗</span></a></div>
					<p class="hero-note">{page.heroNote}</p>
				</div>
				<div class="hero-art" aria-label={page.galleryCaption}>
					<div class="art-halo"></div><div class="art-dragon" aria-hidden="true">龍</div><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
					<span class="art-coordinates">36°30'05.9&quot;N<br />4°40'58.5&quot;W</span><span class="art-seal">九龍<br />ASIA</span>
					<a class="art-link" href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label={page.galleryCta}>↗</a>
					<p class="art-caption">{page.galleryCaption}<span>LA CALA DE MIJAS · 29649</span></p>
				</div>
				<div class="hero-vertical" aria-hidden="true">CHINESE CUISINE · LA CALA</div>
			</section>

			<section class="story section-wrap">
				<div class="story-kicker"><span>九</span><i></i>{page.storyLabel}</div>
				<div class="story-main"><h2>{page.storyTitle}</h2><div class="story-copy"><p>{page.storyText}</p><p>{page.storyDetail}</p></div></div>
				<div class="pillars">{page.pillars.map((item, index) => <article class="pillar"><span class="pillar-mark" aria-hidden="true">{['一', '二', '三'][index]}</span><h3>{item.title}</h3><p>{item.detail}</p></article>)}</div>
			</section>

			<section class="kitchen" id={locale === 'es' ? 'cocina' : 'food'}>
				<div class="kitchen-grid section-wrap">
					<div class="bowl-art" aria-hidden="true"><div class="bowl-rim"><div class="bowl-center"><span>九龍</span></div></div><i class="chopstick chopstick-one"></i><i class="chopstick chopstick-two"></i><span class="bowl-caption">SABORES DE ASIA</span></div>
					<div class="kitchen-copy"><p class="eyebrow eyebrow-dark"><span aria-hidden="true">✳</span>{page.foodEyebrow}</p><h2>{page.foodTitle}</h2><p>{page.foodText}</p><ul class="tags">{page.foodTags.map((tag) => <li>{tag}</li>)}</ul><a class="text-link" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a></div>
				</div>
			</section>

			<section class="gallery section-wrap" aria-labelledby="gallery-title">
				<div class="gallery-copy"><p class="eyebrow"><span aria-hidden="true">✳</span>{page.galleryEyebrow}</p><h2 id="gallery-title">{page.galleryTitle}</h2><p>{page.galleryText}</p><a class="button button-primary" href={mapsUrl} target="_blank" rel="noopener noreferrer">{page.galleryCta}<span aria-hidden="true">↗</span></a></div>
				<div class="gallery-card"><div class="gallery-pattern"><span class="gallery-symbol" aria-hidden="true">九龍</span><span class="gallery-address">PASEO COSTA DEL SOL, 5<br />LA CALA DE MIJAS<br />MÁLAGA · ESPAÑA</span><span class="gallery-seal">FICHA<br />MAPS</span></div><div class="gallery-bottom"><span>{page.galleryCaption}</span><a href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label={page.galleryCta}>↗</a></div></div>
			</section>
			<p class="photo-note section-wrap">{page.photoNote}</p>

			<section class="visit" id={locale === 'es' ? 'visita' : 'visit'}>
				<div class="visit-grid section-wrap">
					<div class="visit-copy"><p class="eyebrow"><span aria-hidden="true">✳</span>{page.visitEyebrow}</p><h2>{page.visitTitle}</h2>
						<div class="contact-details"><div><span class="contact-icon" aria-hidden="true">⌖</span><p><small>{page.addressLabel}</small>{business.streetAddress}<br />{business.postalCode} {business.neighborhood}<br />{business.region}</p></div><div><span class="contact-icon" aria-hidden="true">↗</span><p><small>{page.phoneLabel}</small><a href={phoneHref}>{business.phone}</a></p></div><div><span class="contact-icon" aria-hidden="true">◷</span><p><small>{page.hoursLabel}</small>{page.hoursText}</p></div></div>
						<a class="visit-call" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-panel"><div class="map-heading"><span><i></i>{page.mapArea}</span><a href={mapsUrl} target="_blank" rel="noopener noreferrer">{page.mapOpen} ↗</a></div><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title={page.mapTitle} src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">{locale === 'en' ? 'Directions in Google Maps ↗' : 'Cómo llegar en Google Maps ↗'}</a></p>
						</noscript>
					</div><a class="map-footer" href={directionsUrl} target="_blank" rel="noopener noreferrer"><span class="map-pin" aria-hidden="true">⌖</span><span><strong>{business.shortName}</strong><small>{business.streetAddress} · {business.neighborhood}</small></span><b>{page.mapDirections} ↗</b></a></div>
				</div>
			</section>

			<section class="faq section-wrap"><div class="faq-title"><p class="eyebrow eyebrow-dark"><span aria-hidden="true">✳</span>{page.faqEyebrow}</p><h2>{page.faqTitle}</h2></div><div class="faq-list">{page.faqs.map((faq) => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div></section>
			<Galeria nombre="Restaurante Nueve Dragones" mapsUrl={mapsUrl} locale={locale} />
		</main>

		<footer class="site-footer"><a class="brand" href={page.path} aria-label={`${business.name} · ${page.navLabel}`}><span class="brand-mark" aria-hidden="true">龍</span><span class="brand-name">NUEVE DRAGONES<small>LA CALA DE MIJAS · MÁLAGA</small></span></a><p>{page.footerNote}<br />{business.streetAddress}, {business.neighborhood}</p><div class="footer-links"><a href={page.languageHref}>{page.languageLabel}</a><a href="/aviso-legal">Aviso legal</a> <a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a> · <a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a> <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a></div><small class="footer-legal">© {new Date().getFullYear()} {business.name} · {business.city}</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>
		<a class="mobile-cta" href={phoneHref}><span aria-hidden="true">↗</span>{page.primaryCta}<strong>{business.phone}</strong></a>
	</body>
</html>


