---
const name = '3 I 4 I 5 Pizza Fusion Today';
const mapsUrl =
	'https://www.google.com/maps/place/3+I+4+I+5+Pizza+Fusion+Today/@38.5950463,-0.0520501,17z/data=!3m1!4b1!4m6!3m5!1s0xd620105a850b921:0x9751485d022331a9!8m2!3d38.5950463!4d-0.0520501!16s%2Fg%2F1tfnvblf';
const title = `${name} · Benidorm`;
const description = `${name} en Benidorm (Alicante). Encuentra el local en Google Maps.`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href="https://3-i-4-i-5-pizza-fusion-today.vercel.app/" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<style>
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
				color: #1f1f1f;
				background: #fbf7f0;
				line-height: 1.6;
			}
			main {
				flex: 1;
				display: grid;
				place-content: center;
				text-align: center;
				padding: 3rem 1.5rem;
				gap: 1rem;
			}
			h1 {
				margin: 0;
				font-size: clamp(2.2rem, 6vw, 3.6rem);
				color: #7a2e0e;
			}
			p {
				margin: 0 auto;
				max-width: 36rem;
			}
			a.button {
				display: inline-block;
				justify-self: center;
				margin-top: 0.5rem;
				padding: 0.8rem 1.5rem;
				background: #c2410c;
				color: #fff;
				text-decoration: none;
				border-radius: 6px;
				font-weight: 600;
			}
			a.button:hover {
				background: #9a3412;
			}
			footer {
				padding: 1.5rem;
				text-align: center;
				font-size: 0.9rem;
				background: #1f1f1f;
				color: rgba(255, 255, 255, 0.8);
			}
			footer a {
				color: #fdba74;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>{name}</h1>
			<p>Benidorm, Alicante. Consulta el local, las fotos y cómo llegar en Google Maps.</p>
			<a class="button" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver en Google Maps</a>
		</main>
		<footer>
			<p>
				Web creada por
				<a href="https://sur-digital.vercel.app/" target="_blank" rel="noopener noreferrer">Sur Digital</a>
				· sur-digital.vercel.app
			</p>
		</footer>
	</body>
</html>
