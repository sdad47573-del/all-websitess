---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	business,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las diez fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para
// servirlas con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Bar restaurante Natursur | Comer en Viator, Almería';
const description =
	'Bar restaurante Natursur, en el Paraje Pisaica de la Virgen de Viator (Almería): cocina española de 5:00 a 21:00. Llama al 641 07 66 72 para confirmar horario y menú.';
const keywords =
	'bar Viator, Natursur Viator, comer en Viator, bar restaurante Almería, menú del día Viator, Natursur teléfono';

/**
 * Texto alternativo de las fotos.
 *
 * Google no titula ninguna de las diez que publica este bar, así que no se describe su contenido:
 * solo consta que son fotografías del local publicadas en su propia ficha.
 */
const altFoto =
	'Fotografía publicada en la ficha de Google Maps de Bar restaurante Natursur, en Viator (Almería)';

/** Tres fotos de avance en el collage de la portada (también están en la galería). */
const collage = [
	{ src: foto('bar-restaurante-natursur-apaisada-01.jpg'), clase: 'collage-item collage-item-a' },
	{ src: foto('bar-restaurante-natursur-vertical-04.jpg'), clase: 'collage-item collage-item-b' },
	{ src: foto('bar-restaurante-natursur-cuadrada-05.jpg'), clase: 'collage-item collage-item-c' },
];

/** Galería completa: las diez fotografías de la ficha. */
const galeria = [
	foto('bar-restaurante-natursur-apaisada-01.jpg'),
	foto('bar-restaurante-natursur-apaisada-02.jpg'),
	foto('bar-restaurante-natursur-vertical-03.jpg'),
	foto('bar-restaurante-natursur-vertical-04.jpg'),
	foto('bar-restaurante-natursur-cuadrada-05.jpg'),
	foto('bar-restaurante-natursur-vertical-06.jpg'),
	foto('bar-restaurante-natursur-vertical-07.jpg'),
	foto('bar-restaurante-natursur-vertical-08.jpg'),
	foto('bar-restaurante-natursur-vertical-09.jpg'),
	foto('bar-restaurante-natursur-apaisada-10.jpg'),
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#29472f" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-AL" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700&family=Public+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Fotografía de Bar restaurante Natursur publicada en su ficha de Google Maps"
		/>
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta
			name="twitter:image:alt"
			content="Fotografía de Bar restaurante Natursur publicada en su ficha de Google Maps"
		/>
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">N</span>
				<span class="brand-text">
					Natursur
					<small>Viator · Almería</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#bar">El bar</a>
				<a href="#cocina">La cocina</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Paraje Pisaica de la Virgen · Viator</p>
						<h1 id="hero-title">Bar restaurante<br /><em>en el campo</em> de Viator.</h1>
						<p class="hero-lede">
							Natursur abre a las cinco de la mañana y sirve cocina española hasta las nueve de
							la noche. Un bar de carretera de los de toda la vida, a las afueras de Viator, con
							buena cocina y buen precio según sus propias reseñas.
						</p>
						<div class="hero-actions">
							<a class="btn btn-lime" href={phoneHref}>Llamar al {business.phone}</a>
							<a class="btn btn-ghost" href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>{business.streetAddress} · {business.postalCode} {business.city}</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con {business.reviewCount}
									{' '}reseñas
								</strong>
							</li>
						</ul>
					</div>

					<div class="hero-collage">
						{
							collage.map((item, index) => (
								<figure class={item.clase}>
									<Image
										src={item.src}
										alt={altFoto}
										widths={index === 0 ? [640, 900, 1200] : [320, 480, 640]}
										sizes={
											index === 0
												? '(max-width: 1080px) 92vw, 46vw'
												: '(max-width: 1080px) 45vw, 23vw'
										}
										format="avif"
										quality={68}
										loading={index === 0 ? 'eager' : 'lazy'}
										fetchpriority={index === 0 ? 'high' : undefined}
										decoding="async"
									/>
								</figure>
							))
						}
					</div>
				</div>
			</section>

			<div class="band">
				<span>{business.rating.toLocaleString('es-ES')} sobre 5 con {business.reviewCount} reseñas</span>
				<span>{business.streetAddress} · {business.postalCode} {business.city}</span>
				<span>{hoursSummary}</span>
				<span>Teléfono {business.phone}</span>
			</div>

			<section class="section" id="bar" aria-labelledby="bar-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">El bar</p>
						<h2 class="title" id="bar-title">
							Un bar de carretera<br /><em>con la cocina encendida.</em>
						</h2>
						<p>
							Natursur está en el Paraje Pisaica de la Virgen, en Viator (Almería). Google lo
							cataloga como restaurante y bar, dentro de la cocina española, y le da una
							valoración de {business.rating.toLocaleString('es-ES')} sobre 5 con
							{' '}{business.reviewCount} reseñas.
						</p>
						<p>
							El horario dice mucho del sitio: abre a las 5:00 de la mañana de lunes a viernes y
							cierra a las 21:00, el sábado solo hasta el mediodía y el domingo descansa. Es el
							horario de un bar que empieza con el desayuno y sigue con la comida del día.
						</p>
						<p class="bar-note">
							Esta web se ha preparado solo con lo que publica la ficha de Google Maps del bar,
							consultada el {site.consultado}: nombre, dirección, teléfono, categorías, horario,
							valoración, sus reseñas y sus propias fotografías. La ficha no publica carta ni
							precios, así que aquí no se reproduce ninguno.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>{business.reviewCount} reseñas en Google Maps</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver todas ↗</a>
						</div>
						{
							reviews.map((review) => (
								<blockquote class="quote">
									<p>{review.text}</p>
									<footer>{review.source}</footer>
								</blockquote>
							))
						}
					</div>
				</div>
			</section>

			<section class="section cocina" id="cocina" aria-labelledby="cocina-title">
				<div class="wrap">
					<p class="kicker">La cocina</p>
					<h2 class="title" id="cocina-title">
						Las fotos del <em>propio bar.</em>
					</h2>
					<p class="lead">
						Son las diez fotografías que Natursur publica en su ficha de Google Maps. Google no
						titula ninguna, así que no se describe un contenido que no consta.
					</p>
					<div class="cocina-grid">
						{
							galeria.map((src) => (
								<figure class="cocina-item">
									<Image
										src={src}
										alt={altFoto}
										widths={[380, 560, 800]}
										sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
										format="avif"
										quality={68}
										loading="lazy"
										decoding="async"
									/>
								</figure>
							))
						}
					</div>
					<p class="cocina-note">
						La ficha no publica la carta ni los precios, así que esta web no los reproduce. Para
						saber qué hay hoy, lo más rápido es <a href={phoneHref}>llamar al {business.phone}</a>
						{' '}o mirar las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos y reseñas de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Paraje Pisaica<br /><em>de la Virgen, s/n.</em>
						</h2>
						<address>
							{business.streetAddress}<br />
							{business.postalCode} {business.city}<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{
									hours.map((item) => (
										<tr class:list={[{ 'is-closed': !item.open }]}>
											<th scope="row">{item.day}</th>
											<td>{item.service}</td>
										</tr>
									))
								}
							</tbody>
						</table>
						<p class="hours-note">
							Al consultar la ficha, el lunes 12 de octubre de 2026 aparecía marcado como festivo
							nacional con el aviso de que el horario podía variar. Antes de desplazarte, llama y
							confirma el día.
						</p>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-lime"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
							<button type="button" data-cargar-mapa aria-label="Cargar mapa interactivo" style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
								<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
								<strong style="font-size:1rem;">Cargar mapa interactivo</strong>
								<small style="opacity:0.65;">Se carga solo al pulsar</small>
							</button>
<iframe
							title={`Mapa de ${business.name} en Viator, ${business.province}`}
						 data-src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-tag">
							<div>
								<strong>{business.name}</strong>
								<small>Paraje Pisaica de la Virgen, s/n · 04240 Viator</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">Antes de <em>venir.</em></h2>
					<div class="faq-list">
						{
							faqs.map((faq) => (
								<details>
									<summary>{faq.question}</summary>
									<p>{faq.answer}</p>
								</details>
							))
						}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">N</span>
					<span>
						Natursur
						<small>Paraje Pisaica de la Virgen, s/n · 04240 Viator</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del bar">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">Ficha en Google Maps ↗</a>
					<a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Reseñas en Google ↗</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Bar restaurante Natursur · Viator (Almería). Web
					informativa elaborada con los datos y las fotografías que el bar publica en su ficha de
					Google Maps, consultada el {site.consultado}. Confirma horario y menú por teléfono antes
					de venir.
				</small>
			</div>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a Natursur <span>{business.phone}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>

<script>
// mapa-fachada: la URL del iframe vive en data-src y solo se asigna al pulsar (ahorra ~1MB de JS).
document.addEventListener('click', function (e) {
	var t = e.target && e.target.closest ? e.target.closest('[data-cargar-mapa]') : null;
	if (!t) return;
	var w = t.closest('[data-mapa-fachada]');
	if (!w || w.dataset.cargado) return;
	var f = w.querySelector('iframe');
	if (!f || !f.dataset.src || f.getAttribute('src')) return;
	w.dataset.cargado = '1';
	f.setAttribute('src', f.dataset.src);
	t.remove();
});
</script>
