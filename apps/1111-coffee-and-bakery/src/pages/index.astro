---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/11-11-coffee-bakery-interior-barra-malaga.jpg';
import fachada from '../assets/fotos/11-11-coffee-bakery-fachada-teatinos-malaga.jpg';
import desayuno from '../assets/fotos/11-11-coffee-bakery-desayuno-cafe-zumo-malaga.jpg';
import tartaChocolate from '../assets/fotos/11-11-coffee-bakery-tarta-chocolate-malaga.jpg';
import interiorMesas from '../assets/fotos/11-11-coffee-bakery-interior-mesas-malaga.jpg';
import tartasPorEncargo from '../assets/fotos/11-11-coffee-bakery-tartas-por-encargo-malaga.jpg';
import rotulo from '../assets/fotos/11-11-coffee-bakery-rotulo-bienvenidos-malaga.jpg';
import fachadaCalle from '../assets/fotos/11-11-coffee-bakery-fachada-calle-malaga.jpg';
import vitrina from '../assets/fotos/11-11-coffee-bakery-vitrina-bolleria-malaga.jpg';
import bocadilloLomo from '../assets/fotos/11-11-coffee-bakery-bocadillo-lomo-malaga.jpg';
import bocadilloAtun from '../assets/fotos/11-11-coffee-bakery-bocadillo-atun-malaga.jpg';
import bocadilloTomate from '../assets/fotos/11-11-coffee-bakery-bocadillo-tomate-malaga.jpg';
import desayunosCompartir from '../assets/fotos/11-11-coffee-bakery-desayunos-compartir-malaga.jpg';
import cafeNapolitana from '../assets/fotos/11-11-coffee-bakery-cafe-napolitana-malaga.jpg';
import tartaCorte from '../assets/fotos/11-11-coffee-bakery-tarta-al-corte-malaga.jpg';
import batidos from '../assets/fotos/11-11-coffee-bakery-batidos-malaga.jpg';
import galletas from '../assets/fotos/11-11-coffee-bakery-galletas-caseras-malaga.jpg';
import ambiente from '../assets/fotos/11-11-coffee-bakery-ambiente-teatinos-malaga.jpg';

const business = {
	name: '11:11 Coffee and Bakery',
	brand: '11:11',
	tagline: 'Cafetería, bakery y tartas artesanales en Teatinos',
	street: 'C. Andrés Bernáldez, 13',
	district: 'Teatinos-Universidad',
	city: 'Málaga',
	postalCode: '29010',
	latitude: 36.7222306,
	longitude: -4.4665261,
	rating: 4.8,
	reviewsCount: 84,
	site: 'https://1111-coffee-and-bakery.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd72f766aef83e33:0x55aced55f2c488cd';
const cidDecimal = '6173570142619076813';
const instagram = 'https://www.instagram.com/11.11coffeebakery/';

const mapsUrl = `https://www.google.com/maps/place/11%3A11+Coffee+and+Bakery/@${business.latitude},${business.longitude},17z/data=!3m1!4b1!4m6!3m5!1s${cid}!8m2!3d${business.latitude}!4d${business.longitude}`;
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;

const description =
	'Cafetería y bakery en Teatinos (Málaga): desayunos y meriendas con pitufos, bocadillos, bollería y una gran variedad de pan, además de tartas artesanales por encargo. En C. Andrés Bernáldez, 13, de lunes a sábado de 8:00 a 13:30. 4,8 en Google.';

const servicios = [
	'Cafetería',
	'Bakery y panadería',
	'Desayunos',
	'Meriendas',
	'Bocadillos y pitufos',
	'Bollería y dulces',
	'Gran variedad de pan',
	'Tartas por encargo',
	'Tarta de cumpleaños',
	'Opciones con leche vegetal',
	'Para familias',
	'Rincón dulce en Teatinos',
];

const grupos = [
	{
		title: 'Desayunos y meriendas',
		items: [
			{ name: 'Pitufo', note: 'el clásico malagueño, aquí de tamaño generoso' },
			{ name: 'Pitufo mixto' },
			{ name: 'Café con leche' },
			{ name: 'Mollete', note: 'de los más recomendados en las reseñas' },
			{ name: 'Bocadillos y camperos', note: 'de atún con queso, queso blanco a la plancha, lomo…' },
		],
	},
	{
		title: 'Bollería y pan',
		items: [
			{ name: 'Gran variedad de pan', note: '«una gran variedad de pan y de carta», destacan los clientes' },
			{ name: 'Pitufo de pasas y nueces', note: 'el más recomendado en las reseñas' },
			{ name: 'Napolitanas y bollería', note: 'recién horneada, en la vitrina' },
			{ name: 'Galletas caseras', note: 'en tarro, para picar o llevar' },
		],
	},
	{
		title: 'Tartas y dulces',
		items: [
			{
				name: 'Tartas artesanales por encargo',
				note: 'la especialidad de la casa: la pizarra anuncia «tartas por encargo 11:11»',
			},
			{ name: 'Tarta de chocolate', note: 'con chocolates, sirope y nata' },
			{ name: 'Tarta de cumpleaños', note: 'personalizada y por encargo' },
			{ name: 'Dulces del día', note: 'pregunta por lo que hay en la vitrina' },
		],
	},
	{
		title: 'Café y bebidas',
		items: [
			{ name: 'Café con leche, expreso y especiales', note: 'con opción de leche vegetal' },
			{ name: 'Batidos y frappés', note: 'con nata y galleta' },
			{ name: 'Zumos naturales', note: 'al momento' },
		],
	},
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de 11:11 Coffee and Bakery con el rótulo redondo, cafetería y bakery en Teatinos, Málaga',
	},
	{
		src: desayuno,
		alt: 'Desayuno en 11:11 Coffee and Bakery: café con leche, zumo y bocadillo, en Teatinos, Málaga',
	},
	{
		src: tartaChocolate,
		alt: 'Tarta de chocolate artesanal con chocolates y sirope de 11:11 Coffee and Bakery, Málaga',
	},
	{
		src: interiorMesas,
		alt: 'Interior de 11:11 Coffee and Bakery con mesas y sillas, cafetería en Teatinos, Málaga',
	},
	{
		src: tartasPorEncargo,
		alt: 'Pizarra «tartas por encargo 11:11» y tarro de galletas caseras en 11:11 Coffee and Bakery, Málaga',
	},
	{
		src: rotulo,
		alt: 'Cartel de bienvenida de 11:11 Coffee and Bakery con una taza de café, Teatinos, Málaga',
	},
	{
		src: fachadaCalle,
		alt: 'Calle Andrés Bernáldez con el local de 11:11 Coffee and Bakery y su rótulo, Teatinos, Málaga',
	},
	{
		src: vitrina,
		alt: 'Vitrina de bollería y dulces de 11:11 Coffee and Bakery, bakery en Teatinos, Málaga',
	},
	{
		src: bocadilloLomo,
		alt: 'Bocadillo de lomo en 11:11 Coffee and Bakery, cafetería en Teatinos, Málaga',
	},
	{
		src: bocadilloAtun,
		alt: 'Bocadillo de atún con tomate y lechuga de 11:11 Coffee and Bakery, Málaga',
	},
	{
		src: bocadilloTomate,
		alt: 'Bocadillo con tomate en 11:11 Coffee and Bakery, cafetería y bakery en Teatinos, Málaga',
	},
	{
		src: desayunosCompartir,
		alt: 'Desayunos para compartir con cafés, zumos y bocadillos en 11:11 Coffee and Bakery, Málaga',
	},
	{
		src: cafeNapolitana,
		alt: 'Café con leche y napolitana de chocolate en 11:11 Coffee and Bakery, Teatinos, Málaga',
	},
	{
		src: tartaCorte,
		alt: 'Porción de tarta de chocolate artesanal de 11:11 Coffee and Bakery, Málaga',
	},
	{
		src: batidos,
		alt: 'Batidos y frappés con nata y galleta de 11:11 Coffee and Bakery, Teatinos, Málaga',
	},
	{
		src: galletas,
		alt: 'Galletas caseras en tarro de cristal en 11:11 Coffee and Bakery, cafetería en Málaga',
	},
	{
		src: ambiente,
		alt: 'Ambiente de 11:11 Coffee and Bakery un día lleno, cafetería y bakery en Teatinos, Málaga',
	},
];

const faqs = [
	{
		q: '¿Dónde está 11:11 Coffee and Bakery?',
		a: 'En la calle Andrés Bernáldez, 13, en el barrio de Teatinos-Universidad (29010 Málaga), junto al Centro de Salud Colonia Santa Inés. Es una cafetería-bakery de barrio tranquilo, con barra, mesas y vitrina de bollería.',
	},
	{
		q: '¿Cuál es el horario de 11:11 Coffee and Bakery?',
		a: 'Abre de lunes a sábado de 8:00 a 13:30 y cierra los domingos. Es un horario de mañana, así que lo normal es ir a desayunar o a media mañana. En festivos puede cambiar, así que confírmalo antes si vienes de lejos.',
	},
	{
		q: '¿Qué es un pitufo?',
		a: 'El pitufo es un bocadillo pequeño típico de Málaga, hecho con un pan redondo y suave. Aquí se prepara en versión generosa: los clientes destacan que es «de tamaño por encima de la media». Los más recomendados son el pitufo de pasas y nueces y el pitufo mixto.',
	},
	{
		q: '¿Hacen tartas por encargo?',
		a: 'Sí. Las tartas artesanales por encargo son la especialidad de la casa: la pizarra del local anuncia «tartas por encargo 11:11» y hay tarta de chocolate y tartas de cumpleaños personalizadas. Los pedidos y consultas se atienden por WhatsApp a través de su Instagram, @11.11coffeebakery.',
	},
	{
		q: '¿Hay opciones veganas o sin lactosa?',
		a: 'Sí, se puede pedir el café con leche vegetal, y la carta de bocadillos y bocadillos-pitufo admite cambios. Al ser una cocina de panadería y pan, lo mejor es preguntar en la barra qué se puede adaptar ese día.',
	},
	{
		q: '¿Se puede reservar?',
		a: 'No hay reserva en línea ni teléfono público: es una cafetería de barra y mesas por orden de llegada. Para encargar tartas o resolver dudas, el canal de contacto es su Instagram @11.11coffeebakery (solo WhatsApp).',
	},
	{
		q: '¿Es un sitio para ir en familia o con niños?',
		a: 'Sí. Es una cafetería-bakery de barrio familiar y tranquila, y en su ficha figura como un espacio amigable con la comunidad LGBTQ+. En las reseñas se repite el buen trato del equipo y el ambiente agradable para desayunar o merendar.',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': ['CafeOrCoffeeShop', 'Bakery'],
	'@id': `${business.site}/#negocio`,
	name: business.name,
	alternateName: ['11:11 Coffee & Bakery', '11:11 Bakery Teatinos', 'Once Once Coffee and Bakery'],
	slogan: 'Desayunos y meriendas con amor en Teatinos',
	description,
	url: `${business.site}/`,
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cafetería', 'Bakery', 'Panadería', 'Desayunos', 'Bollería', 'Tartas artesanales'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	image: `${business.site}/og.jpg`,
	sameAs: [mapsUrl, instagram],
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: cid }],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:00',
			closes: '13:30',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Desayunos y meriendas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Bakery y panadería', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Tartas por encargo', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Opciones con leche vegetal', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Para familias', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Espacio amigable LGBTQ+', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>11:11 Coffee and Bakery · Desayunos y tartas en Teatinos, Málaga</title>
		<meta name="theme-color" content="#b0465e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="11:11 Coffee and Bakery, 11:11 bakery Teatinos, cafetería Teatinos, desayunos Teatinos, meriendas Málaga, pitufo Málaga, bocadillos Teatinos, panadería Málaga, tartas por encargo Málaga, tarta de cumpleaños Málaga, bollería Teatinos, cafetería Andrés Bernáldez"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="11:11 Coffee and Bakery · Desayunos y tartas en Teatinos, Málaga"
			ogDescription="Cafetería y bakery en C. Andrés Bernáldez, 13 (Teatinos): desayunos con pitufos y bocadillos, bollería y tartas artesanales por encargo. 4,8 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Desayuno con café con leche, zumo y bocadillo en 11:11 Coffee and Bakery, Teatinos, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#b0465e"
			street={business.street}
			city={business.city}
			region="Andalucía"
			postalCode={business.postalCode}
			phone=""
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Teatinos-Universidad, Málaga"
			preload={[heroImage]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://1111-coffee-and-bakery.vercel.app/og.jpg" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7222306;-4.4665261" />
		<meta name="ICBM" content="36.7222306, -4.4665261" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="11:11"
			name="11:11 Bakery"
			subtitle="Coffee · Bakery · Teatinos"
			phone="Cómo llegar"
			phoneHref={directionsUrl}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Teatinos · Málaga"
				title="Desayunos, meriendas<br /><em>y tartas por encargo.</em>"
				lede="Cafetería y bakery en la calle Andrés Bernáldez, 13, en pleno Teatinos. Desayunos y meriendas con pitufos, bocadillos, bollería y una gran variedad de pan, además de tartas artesanales por encargo. Abierto de lunes a sábado, de 8:00 a 13:30."
				image={heroImage}
				imageAlt="Interior de 11:11 Coffee and Bakery con la barra y las lámparas, cafetería y bakery en Teatinos (Málaga)"
				primaryCta={{ label: 'Cómo llegar', href: directionsUrl }}
				secondaryCta={{ label: 'Seguir en Instagram', href: instagram, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,8</b> en Google (84 reseñas)' },
					{ label: 'Horario', html: 'Lunes a sábado, 8:00–13:30' },
					{ label: 'Especialidad', html: 'Tartas artesanales por encargo' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece 11:11 Coffee and Bakery" items={servicios} />

			<LocalAbout
				label="Un rincón dulce en Teatinos"
				title="Café, pan<br /><em>y dulces hechos aquí.</em>"
				paragraphs={[
					'11:11 Coffee and Bakery está en la calle Andrés Bernáldez, 13, en pleno Teatinos y junto al Centro de Salud Colonia Santa Inés. Es una cafetería-bakery de barrio tranquilo: barra, mesas y una vitrina de bollería y dulces que cambia cada día.',
					'Su fuerte son los desayunos y las meriendas, con el pan como protagonista. Las reseñas insisten en que el pitufo es «de tamaño por encima de la media» y en que hay «una gran variedad de pan y de carta», con clásicos como el pitufo de pasas y nueces, el mollete o el bocadillo de atún con queso.',
					'Y luego está lo dulce: tartas artesanales por encargo —la pizarra del local anuncia «tartas por encargo 11:11»—, tarta de chocolate, napolitanas y galletas caseras. Un sitio de barrio para desayunar, merendar o encargar la tarta de un cumpleaños.',
				]}
				note="La nota media en Google es 4,8 sobre 84 opiniones, una de las más altas del barrio. Lo que más se repite en los comentarios es el pan y los bocadillos, la calidad-precio y el trato del equipo («personal de 10»)."
				links={[
					{ label: 'Ficha y reseñas en Google', href: cidUrl, external: true },
					{ label: 'Instagram @11.11coffeebakery', href: instagram, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Desayunos, bollería<br /><em>y tartas.</em>"
				description="Resumen de lo que se sirve, tomado de la pizarra y del ticket que se ven en la ficha de Google y de los platos que repiten los clientes en las reseñas. La carta y la bollería cambian cada día, así que confírmala en el local."
				cta={{ label: 'Ver novedades en Instagram', href: instagram }}
				groups={grupos}
				note="La carta y la bollería cambian cada día, así que confírmalas en el local."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El local, el pan<br /><em>y lo dulce.</em>"
				description="Estas fotografías proceden del perfil de 11:11 Coffee and Bakery en Google Maps, con imágenes de la ficha y de sus clientes. En la ficha del local están todas las fotos y las reseñas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del local en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="C. Andrés Bernáldez, 13 · 29010 Málaga"
				title="Nos vemos<br /><em>en Teatinos.</em>"
				addressLines={[
					business.street,
					business.district,
					`${business.postalCode} ${business.city}, España`,
				]}
				hours={[
					{ day: 'Lunes', value: '8:00–13:30' },
					{ day: 'Martes', value: '8:00–13:30' },
					{ day: 'Miércoles', value: '8:00–13:30' },
					{ day: 'Jueves', value: '8:00–13:30' },
					{ day: 'Viernes', value: '8:00–13:30' },
					{ day: 'Sábado', value: '8:00–13:30' },
					{ day: 'Domingo', value: 'Cerrado', closed: true },
				]}
				hoursNote="Horario publicado en la ficha de Google. El local abre de lunes a sábado por la mañana y cierra los domingos, así que es un sitio de desayunos y meriendas. Puede variar en festivos: confírmalo antes si vienes de lejos."
				mapTitle="Mapa de 11:11 Coffee and Bakery en la calle Andrés Bernáldez, 13, Teatinos-Universidad, Málaga"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="11:11 Coffee and Bakery · Teatinos"
				mapHref={cidUrl}
				links={[{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' }]}
				contactLink={{ label: '@11.11coffeebakery', href: instagram, external: true }}
				reserveNote="No hay reserva online ni teléfono público: es una cafetería de barra y mesas por orden de llegada. Para encargar tartas o hacer cualquier consulta, el canal es su Instagram @11.11coffeebakery (solo WhatsApp)."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="11:11"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Instagram ↗', href: instagram, external: true },
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: cidUrl, external: true },
			]}
			phone="Andrés Bernáldez, 13"
			phoneHref={directionsUrl}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Cómo llegar a 11:11"
		/>


</body>
</html>
