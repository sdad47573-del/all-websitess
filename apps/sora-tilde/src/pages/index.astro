---
import { Image } from 'astro:assets';
import { BUSINESS, CARTA, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, NOTA_CARTA, RATING, RESENAS } from '../data/site';
import '../styles/global.css';

import fotoTerraza from '../assets/fotos/sora-tilde-apaisada-01.jpg';
import fotoMortadela from '../assets/fotos/sora-tilde-apaisada-06.jpg';
import fotoPasta from '../assets/fotos/sora-tilde-vertical-09.jpg';
import fotoSalami from '../assets/fotos/sora-tilde-vertical-02.jpg';
import fotoProsciutto from '../assets/fotos/sora-tilde-vertical-05.jpg';
import fotoSetas from '../assets/fotos/sora-tilde-vista-4-04.jpg';
import fotoCarbonara from '../assets/fotos/sora-tilde-vertical-07.jpg';
import fotoTabla from '../assets/fotos/sora-tilde-vertical-08.jpg';
import fotoTablaGrande from '../assets/fotos/sora-tilde-vertical-10.jpg';
import fotoMenu from '../assets/fotos/sora-tilde-cuadrada-03.jpg';

const fotosPlatos = [fotoMortadela, fotoProsciutto, fotoSetas, fotoSalami, fotoMenu, fotoCarbonara];

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Restaurant',
			'@id': `${BUSINESS.siteUrl}/#restaurante`,
			name: BUSINESS.fullName,
			description: BUSINESS.description,
			url: `${BUSINESS.siteUrl}/`,
			telephone: '+34685286203',
			image: `${BUSINESS.siteUrl}/og.jpg`,
			servesCuisine: ['Italiana', 'Romana', 'Pizza'],
			address: {
				'@type': 'PostalAddress',
				streetAddress: BUSINESS.street,
				addressLocality: BUSINESS.city,
				addressRegion: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				addressCountry: BUSINESS.country,
			},
			geo: {
				'@type': 'GeoCoordinates',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			},
			hasMap: MAPS.place,
			aggregateRating: {
				'@type': 'AggregateRating',
				ratingValue: RATING.value,
				reviewCount: RATING.count,
				bestRating: 5,
			},
			openingHoursSpecification: [
				{
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
					opens: '13:00',
					closes: '16:30',
				},
				{
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
					opens: '20:00',
					closes: '23:30',
				},
			],
			amenityFeature: [
				{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
				{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
				{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
				{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
			],
		},
		{
			'@type': 'FAQPage',
			'@id': `${BUSINESS.siteUrl}/#faq`,
			mainEntity: FAQ.map((item) => ({
				'@type': 'Question',
				name: item.q,
				acceptedAnswer: { '@type': 'Answer', text: item.a },
			})),
		},
	],
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Sora Tilde · Cocina romana y pizzas en el centro de Málaga</title>
		<meta name="description" content={BUSINESS.description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#1a1116" />
		<link rel="canonical" href={`${BUSINESS.siteUrl}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<meta property="og:type" content="restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={BUSINESS.name} />
		<meta property="og:title" content="Sora Tilde · Cocina romana y pizzas en el centro de Málaga" />
		<meta property="og:description" content={BUSINESS.description} />
		<meta property="og:url" content={`${BUSINESS.siteUrl}/`} />
		<meta property="og:image" content={`${BUSINESS.siteUrl}/og.jpg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Terraza de Sora Tilde de noche, con el neón rosa y las mesas en la calle" />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&display=swap"
			rel="stylesheet"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<a class="skip" href="#contenido">Saltar al contenido</a>

		<header class="top">
			<div class="wrap top__in">
				<a class="brand" href="/" aria-label="Sora Tilde, inicio">
					<span class="brand__mark" aria-hidden="true">ST</span>
					<span class="brand__name">
						<strong>Sora Tilde</strong>
						<small>Ristorante romano · Málaga</small>
					</span>
				</a>
				<nav class="nav" aria-label="Secciones">
					<a href="#casa">La casa</a>
					<a href="#mesa">A la mesa</a>
					<a href="#despensa">Despensa</a>
					<a href="#resenas">Reseñas</a>
					<a href="#visita">Visita</a>
				</nav>
				<a class="call" href={BUSINESS.phoneHref}>Llamar · {BUSINESS.phone}</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero">
				<div class="wrap hero__grid">
					<div>
						<p class="kicker">C. Huéscar, 2 · Distrito Centro</p>
						<h1 class="hero__title" set:html={piezas.portada.titulo} />
						<p class="hero__lede">
							Pizzas de masa fina, carbonara y cacio e pepe en un ristorante romano con la
							terraza encendida. Mediodía y noche, de lunes a sábado, en pleno Distrito Centro.
						</p>
						<div class="hero__actions">
							<a class="btn btn--neon" href={BUSINESS.phoneHref}>Llamar al {BUSINESS.phone}</a>
							<a class="btn btn--ghost" href="#mesa">Ver la mesa</a>
						</div>
						<div class="hero__meta">
							<span><b>{RATING.label}</b>sobre 5 · {RATING.count} reseñas</span>
							<span>Domingo cerrado</span>
							<span>Para llevar y a domicilio</span>
						</div>
					</div>

					<figure class="hero__media">
						<div class="hero__frame">
							<Image
								src={fotoTerraza}
								alt="Terraza de Sora Tilde de noche, con el neón rosa del rótulo y las mesas en la calle"
								widths={[480, 800, 1200]}
								sizes="(max-width: 1024px) 92vw, 34rem"
								loading="eager"
								fetchpriority="high"
							/>
						</div>
						<figcaption>
							<span>La terraza, con el neón de Sora Tilde</span>
							<span>Foto: ficha de Google</span>
						</figcaption>
						<div class="seal" aria-hidden="true">
							<span>Reseñas</span>
							<b>4,6</b>
							<span>en Google</span>
						</div>
					</figure>
				</div>
			</section>

			<div class="band">
				<div class="wrap band__in">
					<div class="band__item">
						<span>Mediodía</span>
						<strong>13:00 – 16:30</strong>
					</div>
					<div class="band__item">
						<span>Noche</span>
						<strong>20:00 – 23:30</strong>
					</div>
					<div class="band__item">
						<span>Domingo cerrado · reservas y pedidos</span>
						<strong><a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a></strong>
					</div>
				</div>
			</div>

			<section class="sec" id="casa">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">La casa</span>
							<h2>Un ristorante romano en Huéscar, 2</h2>
						</div>
						<p>
							Todo lo que cuenta esta página sale de la ficha pública del local en Google y de
							sus fotos: la dirección, el teléfono, la nota, el horario, la descripción que
							firma el propio restaurante y las reseñas.
						</p>
					</div>

					<div class="about">
						<figure class="about__fig">
							<Image
								src={fotoPasta}
								alt="Rigatoni con bacon y pecorino en un cuenco de cerámica azul"
								widths={[380, 640, 900]}
								sizes="(max-width: 1024px) 92vw, 28rem"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>Rigatoni con bacon y pecorino</figcaption>
						</figure>
						<div class="about__text">
							<p class="lead">
								«Ven a probar la verdadera cocina romana en el corazón de la ciudad», empieza
								la descripción que el local firma en su ficha.
							</p>
							<p>
								Se presenta como «Ristorante Romano y Pizzeria Tradizionale» y cita sus pizzas
								crujientes, la carbonara y la cacio e pepe como los platos que llevan a Roma
								sin salir de Málaga. Google lo clasifica en seis categorías, de restaurante
								italiano a pizzería a domicilio.
							</p>
							<p>
								La nota publicada es alta: 4,6 sobre 5 con 160 reseñas. Las que se ven hablan
								de masa fina y de combinaciones propias; una menciona la pizza Amorosa como «la
								mejor que me he tomado». La cocina abre mediodía y noche de lunes a sábado, y
								descansa el domingo.
							</p>
							<blockquote class="pull">
								«Las pizzas exquisitas, masa fina y combinaciones sorprendentes.»
								<cite>Reseña de cinco estrellas publicada en Google</cite>
							</blockquote>
						</div>
					</div>

					<div class="cards">
						{
							HIGHLIGHTS.map((item) => (
								<article class="card">
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="sec sec--ink" id="mesa">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">A la mesa</span>
							<h2>Lo que sale del horno y de la cocina</h2>
						</div>
						<p>
							Seis platos que aparecen en las fotos de la ficha. No son los nombres oficiales
							de la carta —que no está publicada— sino lo que se ve en el plato.
						</p>
					</div>

					<div class="dishes">
						{
							CARTA.map((plato, i) => (
								<figure class="dish">
									<div class="dish__media">
										<Image
											src={fotosPlatos[i]}
											alt={plato.name}
											widths={[380, 620, 900]}
											sizes="(max-width: 760px) 92vw, (max-width: 1024px) 46vw, 30vw"
											loading="lazy"
											decoding="async"
										/>
									</div>
									<figcaption>
										<h3>{plato.name}</h3>
										<p>{plato.note}</p>
										<span class="dish__tag">Según las fotos de la ficha</span>
									</figcaption>
								</figure>
							))
						}
					</div>
					<p class="nota">{NOTA_CARTA}</p>
				</div>
			</section>

			<section class="sec" id="despensa">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">La despensa</span>
							<h2>Embutidos y quesos para empezar</h2>
						</div>
						<p>
							Las tablas son otra de las cosas que más aparecen en la galería: prosciutto,
							salami, mortadela, provolone y burrata, con pan de focaccia al lado.
						</p>
					</div>

					<div class="pantry">
						<figure>
							<Image
								src={fotoTabla}
								alt="Tabla de embutidos con prosciutto, salami, mortadela y quesos"
								widths={[360, 600, 900]}
								sizes="(max-width: 760px) 92vw, (max-width: 1024px) 46vw, 24vw"
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<figure>
							<Image
								src={fotoTablaGrande}
								alt="Tabla grande con embutidos, provolone y burrata junto a pan de focaccia"
								widths={[360, 600, 900]}
								sizes="(max-width: 760px) 92vw, (max-width: 1024px) 46vw, 24vw"
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<div class="pantry__text">
							<h3>Para compartir antes de la pizza</h3>
							<p>
								En las fotos se ve la tabla montada para varios: lonchas de prosciutto y
								salami, mortadela, provolone en cuñas, burrata y pan de focaccia marcado en
								la plancha.
							</p>
							<p>
								No hay precio ni descripción publicada. Si quieres saber qué entra hoy en la
								tabla, lo mejor es preguntar al llegar o llamar antes.
							</p>
							<div class="pantry__list">
								<span>Prosciutto</span>
								<span>Salami</span>
								<span>Mortadela</span>
								<span>Provolone</span>
								<span>Burrata</span>
								<span>Focaccia</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="sec sec--paper" id="resenas">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">Lo que dicen</span>
							<h2>{RATING.label} sobre 5 en Google</h2>
						</div>
						<p>
							Las tres reseñas publicadas en la ficha son de cinco estrellas y hablan de lo
							mismo: la masa, las combinaciones y la pasta.
						</p>
					</div>

					<div class="reviews">
						<div class="reviews__score">
							<b>{RATING.label}</b>
							<span>{RATING.count} reseñas en Google</span>
							<a href={MAPS.reviews} target="_blank" rel="noreferrer">Leer todas ↗</a>
						</div>
						<div class="reviews__list">
							{
								RESENAS.map((resena) => (
									<blockquote class="quote">
										<span class="stars" aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)}
										</span>
										<p>«{resena.texto}»</p>
										<footer>Reseña publicada en Google</footer>
									</blockquote>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<section class="sec" id="visita">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">Cómo llegar</span>
							<h2>Huéscar, 2, Distrito Centro</h2>
						</div>
						<p>
							Una calle del centro de Málaga, a un paso del río. La ficha marca aparcamiento
							adaptado, aunque no detalla plazas propias.
						</p>
					</div>

					<div class="visit">
						<div class="visit__info">
							<p class="visit__address">
								<strong>{BUSINESS.name}</strong>
								{BUSINESS.street}<br />
								{BUSINESS.district} · {BUSINESS.postalCode} {BUSINESS.city}
							</p>
							<div class="visit__actions">
								<a class="btn btn--neon" href={BUSINESS.phoneHref}>Llamar al {BUSINESS.phone}</a>
								<a class="btn btn--dark" href={MAPS.directions} target="_blank" rel="noreferrer">
									Cómo llegar ↗
								</a>
							</div>

							<table class="hours">
								<caption>Horario publicado en la ficha</caption>
								<tbody>
									{
										HORARIO.map((dia) => (
											<tr class={dia.closed ? 'is-closed' : undefined}>
												<th scope="row">{dia.dia}</th>
												<td>{dia.horas}</td>
											</tr>
										))
									}
								</tbody>
							</table>
							<p class="hours__aviso">{HORARIO_AVISO}</p>
						</div>

						<div class="map">
							<iframe
								src={MAPS.embed}
								title={`Mapa de ${BUSINESS.name}, ${BUSINESS.street}, ${BUSINESS.city}`}
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
								allowfullscreen></iframe>
							<div class="map__foot">
								<span>{BUSINESS.street} · {BUSINESS.district}</span>
								<a href={MAPS.place} target="_blank" rel="noreferrer">Abrir la ficha en Google Maps ↗</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="sec sec--paper" id="preguntas">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">Antes de venir</span>
							<h2>Preguntas frecuentes</h2>
						</div>
						<p>
							Lo que la ficha permite responder. Para la carta, las reservas o el reparto, el
							teléfono del local: {BUSINESS.phone}.
						</p>
					</div>

					<div class="faq">
						{
							FAQ.map((item, i) => (
								<details open={i === 0}>
									<summary>{item.q}</summary>
									<p>{item.a}</p>
								</details>
							))
						}
					</div>
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="wrap">
				<div class="footer__top">
					<div class="footer__brand">
						<strong>Sora Tilde</strong>
						<p>{BUSINESS.street} · {BUSINESS.district} · {BUSINESS.postalCode} {BUSINESS.city}</p>
						<p>Ristorante romano y pizzería tradicional. Mediodía y noche, de lunes a sábado.</p>
					</div>
					<div class="footer__cols">
						<div class="footer__col">
							<span>Contacto</span>
							<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
							<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						</div>
						<div class="footer__col">
							<span>En esta página</span>
							<a href="#casa">La casa</a>
							<a href="#mesa">A la mesa</a>
							<a href="#despensa">La despensa</a>
							<a href="#preguntas">Preguntas</a>
						</div>
						<div class="footer__col">
							<span>Más</span>
							<a href={MAPS.place} target="_blank" rel="noreferrer">Ficha en Google Maps ↗</a>
							<a href="/aviso-legal/">Aviso legal y privacidad</a>
						</div>
					</div>
				</div>
				<div class="footer__bottom">
					<span>© {new Date().getFullYear()} {BUSINESS.fullName}. Sin carta publicada: precios y platos, por teléfono.</span>
					<span>
						Creado por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
						<a href="https://sur-digital.vercel.app/" rel="noopener">sur-digital.vercel.app</a>
					</span>
				</div>
			</div>
		</footer>
	</body>
</html>
