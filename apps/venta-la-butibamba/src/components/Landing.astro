---
import { Image } from 'astro:assets';
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import { business, directionsUrl, mapEmbedUrl, mapsUrl, phoneHref, restaurantSchema } from '../lib/business';
import { content } from '../lib/content';
import Galeria from './Galeria.astro';
import facadePhoto from '../assets/fotos/venta-la-butibamba-apaisada-01.jpg';
import sandwichPhoto from '../assets/fotos/venta-la-butibamba-apaisada-02.jpg';
import historicPhoto from '../assets/fotos/venta-la-butibamba-apaisada-04.jpg';

interface Props {
	locale: 'es' | 'en';
}

const { locale } = Astro.props;
const page = content[locale];
const canonical = `${business.site}${page.path}`;
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: page.faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang={page.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#253c31" />
		<meta name="description" content={page.description} />
		<meta name="keywords" content={page.keywords} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="La Cala de Mijas, Mijas" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="es" href={`${business.site}/`} />
		<link rel="alternate" hreflang="en" href={`${business.site}/en/`} />
		<link rel="alternate" hreflang="x-default" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://maps.googleapis.com" />
		<link rel="preconnect" href="https://maps.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
			rel="stylesheet"
		/>
		<title>{page.title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content={page.locale} />
		<meta property="og:site_name" content={business.shortName} />
		<meta property="og:title" content={page.title} />
		<meta property="og:description" content={page.description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={`${business.site}/social-card.svg`} />
		<meta property="og:image:alt" content="Venta La Butibamba, traditional restaurant in La Cala de Mijas" />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="Spain" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={page.title} />
		<meta name="twitter:description" content={page.description} />
		<meta name="twitter:image" content={`${business.site}/social-card.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#main">{page.skip}</a>
		<header class="topbar">
			<a class="brand" href={page.path} aria-label={`${business.shortName} · ${page.navLabel}`}>
				<span class="brand-mark" aria-hidden="true">B.</span>
				<span class="brand-name">La Butibamba<small>VENTA · LA CALA DE MIJAS</small></span>
			</a>
			<nav aria-label={page.navLabel}>
				{page.nav.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
			<div class="header-actions">
				<a class="language" href={page.languageHref} lang={locale === 'es' ? 'en' : 'es'}>{page.languageLabel}</a>
				<a class="header-book" href={phoneHref}><span aria-hidden="true">↗</span> {page.primaryCta}</a>
			</div>
		</header>

		<main id="main">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span class="eyebrow-dot"></span>{page.eyebrow}</p>
					<h1 id="hero-title">{page.titleLines[0]}<br /><em>{page.titleLines[1]}</em><br />{page.titleLines[2]}</h1>
					<p class="hero-lede">{page.intro}</p>
					<div class="hero-actions">
						<a class="button button-primary" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">{page.secondaryCta}<span aria-hidden="true">↗</span></a>
					</div>
					<p class="hero-footnote"><span aria-hidden="true">✳</span>{page.heroNote}</p>
				</div>
				<div class="hero-art" aria-label={page.photosCta}>
					<Image class="hero-photo" src={facadePhoto} alt={page.heroPhotoAlt} widths={[420, 640, 860]} sizes="(max-width: 900px) 92vw, 480px" format="avif" quality={72} loading="eager" decoding="async" />
					<span class="art-scrim" aria-hidden="true"></span>
					<span class="art-coordinates">36°30'06.1&quot;N<br />4°41'04.9&quot;W</span><span class="art-sign">VENTA<br />DESDE SIEMPRE</span>
					<a class="art-open" href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label={page.photosCta}><span aria-hidden="true">↗</span></a>
					<p class="art-caption">{page.photoCaption}<a href={mapsUrl} target="_blank" rel="noopener noreferrer">{page.photosCta} ↗</a></p>
				</div>
				<div class="hero-side-note" aria-hidden="true">TRADICIÓN · LA CALA DE MIJAS</div>
			</section>

			<section class="intro section-wrap" id="venta">
				<div class="intro-index"><span>01</span><i></i>{page.restaurantLabel}</div>
				<div class="intro-body"><h2>{page.restaurantTitle}</h2><div class="intro-copy"><p>{page.restaurantText}</p><p>{page.restaurantDetail}</p></div></div>
				<div class="values">
					{page.values.map((item) => <article class="value"><span>{item.number}</span><h3>{item.title}</h3><p>{item.detail}</p></article>)}
				</div>
			</section>

			<section class="food-section" id="cocina">
				<div class="food-grid section-wrap">
					<figure class="food-photo">
						<Image class="food-img" src={sandwichPhoto} alt={page.foodPhotoAlt} widths={[330, 480, 660]} sizes="(max-width: 900px) 80vw, 385px" format="avif" quality={72} loading="lazy" decoding="async" />
						<figcaption class="food-caption">CASERO · DE AQUÍ · DE SIEMPRE</figcaption>
					</figure>
					<div class="food-copy"><p class="eyebrow eyebrow-dark"><span class="eyebrow-dot"></span>{page.cuisineEyebrow}</p><h2>{page.cuisineTitle}</h2><p>{page.cuisineText}</p><ul class="cuisine-tags">{page.cuisineTags.map((tag) => <li>{tag}</li>)}</ul><a class="text-link" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a></div>
				</div>
			</section>

			<section class="gallery-section section-wrap">
				<div class="gallery-copy"><p class="eyebrow"><span class="eyebrow-dot"></span>{page.photosEyebrow}</p><h2>{page.photosTitle}</h2><p>{page.photosText}</p><a class="button button-primary" href={mapsUrl} target="_blank" rel="noopener noreferrer">{page.photosCta}<span aria-hidden="true">↗</span></a></div>
				<div class="gallery-card"><Image class="gallery-photo" src={historicPhoto} alt={page.historicPhotoAlt} widths={[420, 640, 860, 1100]} sizes="(max-width: 900px) 92vw, 46vw" format="avif" quality={72} loading="lazy" decoding="async" /><span class="gallery-scrim" aria-hidden="true"></span><span class="gallery-coordinate">LA CALA DE MIJAS<br />CARRETERA DE CÁDIZ<br />MÁLAGA · ESPAÑA</span><span class="gallery-stamp">DE TODA<br />LA VIDA</span><div class="gallery-card-footer"><span>{page.photoCaption}</span><a href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label={page.photosCta}>↗</a></div></div>
			</section>
			<p class="photo-credit section-wrap">{page.photoDisclaimer}</p>

			<section class="visit-section" id="visitanos">
				<div class="visit-grid section-wrap">
					<div class="visit-copy"><p class="eyebrow"><span class="eyebrow-dot"></span>{page.visitEyebrow}</p><h2>{page.visitTitle}</h2>
						<div class="visit-details"><div><span class="detail-icon" aria-hidden="true">⌖</span><p><small>{page.addressLabel}</small>{business.streetAddress}<br />{business.postalCode} {business.district}<br />{business.region}</p></div><div><span class="detail-icon" aria-hidden="true">↗</span><p><small>{page.phoneLabel}</small><a href={phoneHref}>{business.phone}</a><br /><a href={`tel:${business.alternatePhone.replace(/\s/g, '')}`}>{business.alternatePhone}</a></p></div><div><span class="detail-icon" aria-hidden="true">◷</span><p><small>{page.hoursLabel}</small>{page.hoursText}</p></div></div>
						<a class="social-link" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-panel"><div class="map-topline"><span><i></i> LA CALA DE MIJAS · MIJAS COSTA</span><a href={mapsUrl} target="_blank" rel="noopener noreferrer">{page.mapOpen} ↗</a></div><div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<button type="button" data-cargar-mapa aria-label={locale === 'en' ? 'Load interactive map' : 'Cargar mapa interactivo'} style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
							<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
							<strong style="font-size:1rem;">{locale === 'en' ? 'Load interactive map' : 'Cargar mapa interactivo'}</strong>
							<small style="opacity:0.65;">{locale === 'en' ? 'Loads only when tapped' : 'Se carga solo al pulsar'}</small>
						</button>
<iframe title={page.mapTitle} data-src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">{locale === 'en' ? 'Directions in Google Maps ↗' : 'Cómo llegar en Google Maps ↗'}</a></p>
						</noscript>
					</div><a class="map-bottom" href={directionsUrl} target="_blank" rel="noopener noreferrer"><span class="map-pin" aria-hidden="true">⌖</span><span><strong>{business.shortName}</strong><small>{business.streetAddress} · {business.district}</small></span><b>{page.mapDirections} ↗</b></a></div>
				</div>
			</section>

			<section class="faq-section section-wrap">
				<div class="faq-heading"><p class="eyebrow eyebrow-dark"><span class="eyebrow-dot"></span>{page.faqEyebrow}</p><h2>{page.faqTitle}</h2></div>
				<div class="faq-list">{page.faqs.map((faq) => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div>
			</section>
			<Galeria nombre="Venta Restaurante La Butibamba" mapsUrl={mapsUrl} locale={locale} />
		</main>

		<footer class="footer"><a class="brand" href={page.path} aria-label={`${business.shortName} · ${page.navLabel}`}><span class="brand-mark" aria-hidden="true">B.</span><span class="brand-name">La Butibamba<small>VENTA · LA CALA DE MIJAS</small></span></a><p>{page.footerNote}<br />{business.streetAddress}, {business.district}</p><div class="footer-links"><a href={business.facebook} target="_blank" rel="noopener noreferrer">{page.facebookLabel} ↗</a><a href={page.languageHref}>{page.languageLabel}</a><a href="/aviso-legal">Aviso legal</a></div><small class="footer-legal">© {new Date().getFullYear()} {business.shortName} · {business.district}</small></footer>
		<a class="mobile-cta" href={phoneHref}><span aria-hidden="true">↗</span>{page.primaryCta}<strong>{business.phone}</strong></a>
	<WhatsappFab phone={datos.phoneHref} name={datos.business?.name} />
	</body>
</html>

<script>
// mapa-fachada: la URL del iframe vive en data-src y solo se asigna al pulsar (ahorra ~1MB de JS).
document.addEventListener('click', function (e) {
	var t = e.target && e.target.closest ? e.target.closest('[data-cargar-mapa]') : null;
	if (!t) return;
	var w = t.closest('[data-mapa-fachada]');
	if (!w || w.dataset.cargado) return;
	var f = w.querySelector('iframe');
	if (!f || !f.dataset.src || f.getAttribute('src')) return;
	w.dataset.cargado = '1';
	f.setAttribute('src', f.dataset.src);
	t.remove();
});
</script>
