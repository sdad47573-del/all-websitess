---
import { Image } from 'astro:assets';
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import heroPhoto from '../assets/fotos/the-boss-restaurante-apaisada-01.jpg';
import {
	business,
	directionsUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHrefs,
	structuredData,
} from '../lib/business';

const title = 'The Boss Restaurante | Restaurante en La Cala del Moral, Málaga';
const description =
	'The Boss Restaurante, en Plaza Gloria Fuertes, 6, La Cala del Moral (Málaga). Pizza al horno de leña, pasta, carnes, desayunos y terraza. Llama al 656 40 40 30.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1a1a1a" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="La Cala del Moral" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700&family=Red+Hat+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://the-boss-restaurante-malaga.vercel.app/og.png" />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="The Boss Restaurante, inicio"><span class="brand-mark" aria-hidden="true">TB</span><span class="brand-label">THE BOSS <small>RESTAURANTE · LA CALA DEL MORAL</small></span></a>
			<nav aria-label="Navegación principal"><a href="#carta">La casa</a><a href="#contacto">Contacto</a></nav>
			<a class="header-phone" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> {business.phones[0]}</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<figure class="hero-media">
					<Image
						class="hero-photo"
						src={heroPhoto}
						alt="Salón interior de The Boss Restaurante con arcadas y vistas a la terraza, en la Plaza Gloria Fuertes, La Cala del Moral"
						widths={[720, 1080, 1440, 1920]}
						sizes="100vw"
						format="avif"
						quality={70}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					<span class="hero-scrim" aria-hidden="true"></span>
					<figcaption class="hero-credit">Foto de la ficha de Google Maps</figcaption>
				</figure>
				<div class="hero-content">
					<p class="eyebrow"><span></span> RESTAURANTE · PIZZA AL HORNO DE LEÑA</p>
					<h1 id="hero-title"><span class="h1-small">The</span> Boss</h1>
					<p class="hero-sub">Restaurante en La Cala del Moral</p>
					<p class="hero-intro">Pizza al horno de leña, pasta, carnes y desayunos. Un restaurante con terraza para comer sin prisas en La Cala del Moral, Málaga.</p>
					<div class="hero-actions"><a class="button button-tomato" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Llamar y reservar</a><a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
				</div>
				<div class="hero-info">
					<div class="info-cell"><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div>
					<div class="info-cell"><small>TELÉFONO</small><a href={phoneHrefs[0]}>{business.phones[0]}</a></div>
					<div class="info-cell"><small>DÓNDE ESTAMOS</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a></div>
				</div>
			</section>

			<section class="salon-strip" id="carta" aria-label="Qué puedes comer en The Boss Restaurante">
				<p class="strip-title"><span>01 /</span> LA CARTA</p>
				<div><span>01</span><strong>Pizza al horno de leña</strong></div>
				<div><span>02</span><strong>Pasta</strong></div>
				<div><span>03</span><strong>Carnes y hamburguesas</strong></div>
				<div><span>04</span><strong>Desayunos y terraza</strong></div>
			</section>

			<section class="about-section" aria-labelledby="about-title">
				<p class="section-label"><span>02 /</span> THE BOSS · LA CALA DEL MORAL</p>
				<div class="about-content"><h2 id="about-title">Ven a comer<br /><em>sin prisas.</em></h2><div><p>En The Boss Restaurante apostamos por una carta amplia para que todos encuentren su plato: pizza hecha al horno de leña, pasta, carnes, hamburguesas y desayunos. Un local con terraza en la Plaza Gloria Fuertes, en La Cala del Moral, ideal para compartir mesa con familia y amigos.</p><a class="social-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver la ficha y las opiniones en Google Maps <span aria-hidden="true">↗</span></a></div></div>
				<div class="about-footer"><span>PIZZA · PASTA · CARNES · DESAYUNOS</span><span>29720 LA CALA DEL MORAL</span><span>✦</span></div>
			</section>

			<section class="contact-section" id="contacto" aria-labelledby="contact-title">
				<p class="section-label"><span>03 /</span> VISÍTANOS</p>
				<div class="contact-layout">
					<div class="contact-copy"><p class="contact-kicker">ESTAMOS EN PLAZA GLORIA FUERTES</p><h2 id="contact-title">Reserva<br /><em>tu mesa.</em></h2>
						<div class="contact-card">
							<div class="contact-row"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div></div>
							<div class="contact-row"><span aria-hidden="true">☎</span><div><small>LLÁMANOS</small><a href={phoneHrefs[0]}>{business.phones[0]}</a></div></div>
						</div>
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-card"><div class="map-header"><span><i></i> PLAZA GLORIA FUERTES · LA CALA DEL MORAL</span><a href={mapsUrl} target="_blank" rel="noreferrer">ABRIR MAPS ↗</a></div><iframe title="Mapa de The Boss Restaurante en Plaza Gloria Fuertes, La Cala del Moral" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><div class="map-footer"><span aria-hidden="true">⌖</span><div><strong>{business.name}</strong><small>{business.streetAddress} · {business.city}</small></div><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar a The Boss Restaurante">↗</a></div></div>
				</div>
				<div class="social-row"><span>ENCUÉNTRANOS TAMBIÉN EN</span><a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><a href={phoneHrefs[0]}>{business.phones[0]} ↗</a></div>
			</section>
			<Galeria nombre="The Boss Restaurante" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer"><a class="brand footer-brand" href="#inicio" aria-label="The Boss Restaurante, volver al inicio"><span class="brand-mark">TB</span><span class="brand-label">THE BOSS <small>RESTAURANTE · LA CALA DEL MORAL</small></span></a><p>{business.streetAddress}, {business.postalCode} {business.city}<br /><a href={phoneHrefs[0]}>{business.phones[0]}</a></p><a class="footer-social" href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><small>© {new Date().getFullYear()} The Boss Restaurante · La Cala del Moral &nbsp;·&nbsp; Consulta la carta y los horarios en el local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
</footer>
		<a class="phone-cta" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Llamar a The Boss <strong>{business.phones[0]}</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						<WhatsappFab phone={datos.phoneHrefs[0]} name={datos.business?.name} />
						</body>
</html>
