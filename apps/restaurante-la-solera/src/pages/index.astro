---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import terrazaNoche from '../assets/fotos/restaurante-la-solera-apaisada-01.jpg';
import paellaLangostinos from '../assets/fotos/restaurante-la-solera-vertical-02.jpg';
import hamburguesa from '../assets/fotos/restaurante-la-solera-apaisada-03.jpg';
import fritura from '../assets/fotos/restaurante-la-solera-apaisada-04.jpg';
import fachada from '../assets/fotos/restaurante-la-solera-apaisada-05.jpg';
import tortilla from '../assets/fotos/restaurante-la-solera-apaisada-06.jpg';
import paella from '../assets/fotos/restaurante-la-solera-apaisada-07.jpg';
import pulpo from '../assets/fotos/restaurante-la-solera-vertical-08.jpg';
import sardinas from '../assets/fotos/restaurante-la-solera-cuadrada-09.jpg';
import calamares from '../assets/fotos/restaurante-la-solera-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Restaurante La Solera, marisquería y cocina mediterránea en Plaça sa Tertúlia, 8 (Eivissa). Paellas, pulpo, sardinas y calamares en terraza, junto al puerto. Tel. 971 31 62 50.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de La Solera con dos toldos blancos, uno rotulado «PAELLA» y otro «La Solera», y mesas en la plaza',
	},
	{
		src: terrazaNoche,
		alt: 'Terraza de La Solera de noche, con lámparas de mimbre, mesas de madera y clientes cenando',
	},
	{
		src: paella,
		alt: 'Paella de marisco en la paellera, con mejillones, langostinos y dos gajos de limón',
	},
	{
		src: paellaLangostinos,
		alt: 'Paella con langostinos y mejillones servida en plato hondo',
	},
	{
		src: pulpo,
		alt: 'Pulpo a la gallega con patata y pimentón en un plato blanco',
	},
	{
		src: sardinas,
		alt: 'Sardinas a la plancha con patatas fritas y un gajo de limón',
	},
	{
		src: calamares,
		alt: 'Calamares fritos con dos gajos de limón en un plato blanco',
	},
	{
		src: fritura,
		alt: 'Fritura de pescado con boquerones, calamares y langostinos, con limón',
	},
	{
		src: tortilla,
		alt: 'Tortilla de patatas con ensalada y calamares fritos delante',
	},
	{
		src: hamburguesa,
		alt: 'Hamburguesa con bacon y queso junto a un cestillo de patatas fritas',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-solera`,
	name: BUSINESS.name,
	alternateName: ['La Solera', 'La Solera Ibiza', 'Restaurante La Solera Ibiza', 'La Solera Eivissa'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 971 31 62 50',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Española', 'Marisco'],
	areaServed: [
		{ '@type': 'City', name: 'Eivissa' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '12:00',
			closes: '24:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'La Solera · Marisquería y paellas en el centro de Ibiza';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-la-solera-apaisada-05.jpg": fachada,
	"restaurante-la-solera-apaisada-01.jpg": terrazaNoche,
	"restaurante-la-solera-apaisada-07.jpg": paella,
	"restaurante-la-solera-vertical-02.jpg": paellaLangostinos,
	"restaurante-la-solera-vertical-08.jpg": pulpo,
	"restaurante-la-solera-cuadrada-09.jpg": sardinas,
	"restaurante-la-solera-apaisada-10.jpg": calamares,
	"restaurante-la-solera-apaisada-04.jpg": fritura,
	"restaurante-la-solera-apaisada-06.jpg": tortilla,
	"restaurante-la-solera-apaisada-03.jpg": hamburguesa,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f4a5a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Solera Ibiza, restaurante La Solera, marisquería Ibiza, paella Ibiza centro, comer paella Eivissa, Plaça sa Tertúlia, pulpo a la gallega Ibiza, restaurante junto al puerto Ibiza"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="La Solera · Marisquería y paellas en el centro de Ibiza"
			ogDescription="Paellas, pulpo a la gallega, sardinas y calamares en Plaça sa Tertúlia, 8 (Eivissa), con terraza junto al puerto. Tel. 971 31 62 50."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Terraza de La Solera en la plaza, con los toldos blancos y mesas de madera"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1f4a5a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			phone="+34971316250"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Solera"
			subtitle="Marisquería · Eivissa"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a La Solera"
		/>
	</body>
</html>
