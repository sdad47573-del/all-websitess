---
import WhatsappFab from '../components/WhatsappFab.astro';
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

const business = {
	name: 'Restaurante Puerta 14',
	tagline: 'Cocina casera · Tapas y raciones en el centro histórico',
	street: 'C. Puerta de Murcia, 14',
	district: 'Casco Antiguo',
	city: 'Cartagena',
	region: 'Región de Murcia',
	postalCode: '30201',
	phone: '968 50 25 33',
	latitude: 37.6022666,
	longitude: -0.9872786,
	site: 'https://restaurante-puerta-14.vercel.app',
};

const mapsUrl = `https://www.google.com/maps/place/Restaurante+Puerta+14/@${business.latitude},${business.longitude},17z/data=!3m1!4b1!4m6!3m5!1s0xd63422f4dda9cdf:0xaf340f0df7e1bb74!8m2!3d${business.latitude}!4d${business.longitude}!16s%2Fg%2F11c5s1w7q0`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34968502533';

const description =
	'Restaurante Puerta 14 en Puerta de Murcia 14, Cartagena: cocina casera mediterránea, marinera, pulpo a la cartagenera, croquetas y tarta de queso. Raciones enormes, ~20 € con bebida. 9:00–24:00, miércoles cerrado. Tel. 968 50 25 33.';

const servicios = [
	'Marinera cartagenera',
	'Pulpo a la cartagenera',
	'Croquetas caseras',
	'Raciones enormes',
	'Tarta de queso',
	'Café asiático',
	'Terraza peatonal',
	'Grupos y eventos',
	'Se admiten perros',
];

const platos = [
	{ name: 'Tapa marinera y calamares a la andaluza', note: 'los recomendados que más se repiten' },
	{ name: 'Pulpo a la cartagenera y crujiente de pulpo', note: 'pata de pulpo y versión crujiente' },
	{ name: 'Croquetas de jamón y champiñones', note: 'las perfectas según la clientela' },
	{ name: 'Cachopo y canelón de carrillera', note: 'raciones enormes: cuidado al pedir de más' },
	{ name: 'Ensalada de burrata con jamón, tomate con bonito', note: 'frescas para compartir' },
	{ name: 'Patatas bravas y tortilla de bacalao', note: 'clásicos bien ejecutados' },
	{ name: 'Tosta de solomillo con pimiento', note: 'bocado contundente' },
	{ name: 'Tarta de queso casera', note: 'la muy recomendable del final' },
	{ name: 'Café asiático', note: 'el cierre cartagenero que hay que probar' },
];

const fotos = [
	{ src: '/fotos/puerta-murcia-14.svg', alt: 'Ilustración placeholder del exterior en Puerta de Murcia 14 — sustituir por foto propia' },
	{ src: '/fotos/marinera-cartagenera.svg', alt: 'Ilustración placeholder de la tapa marinera — sustituir por foto propia' },
	{ src: '/fotos/pulpo-cartagenera.svg', alt: 'Ilustración placeholder del pulpo a la cartagenera — sustituir por foto propia' },
	{ src: '/fotos/croquetas-cachopo.svg', alt: 'Ilustración placeholder de croquetas y cachopo — sustituir por foto propia' },
	{ src: '/fotos/tarta-queso-asiatico.svg', alt: 'Ilustración placeholder de tarta de queso y café asiático — sustituir por foto propia' },
	{ src: '/fotos/terraza-casco-antiguo.svg', alt: 'Ilustración placeholder de la terraza en zona peatonal — sustituir por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Puerta 14?',
		a: 'En C. Puerta de Murcia 14, 30201 Cartagena, en la zona peatonal del centro histórico. Restaurante de cocina casera mediterránea con terraza.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De 9:00 a 24:00 todos los días excepto miércoles, que cierra (datos públicos 2026). Confirma en festivos en el 968 50 25 33.',
	},
	{
		q: '¿Qué se come en Puerta 14?',
		a: 'Tapas y raciones caseras: marinera, calamares a la andaluza, croquetas, cachopo, pulpo a la cartagenera, ensaladas, tosta de solomillo y postres caseros como la tarta de queso. Para beber, el café asiático es obligado.',
	},
	{
		q: '¿Cuánto cuesta?',
		a: 'Relación calidad-precio excelente: media de unos 20 € con bebida incluida. Ojo: las porciones son enormes, no pidas de más; el camarero te asesora para que no sobre ni falte.',
	},
	{
		q: '¿Hacen eventos y grupos?',
		a: 'Sí, es lugar habitual para grupos y eventos: bodas, comuniones y cumpleaños. Llama al 968 50 25 33 para organizarlo.',
	},
	{
		q: '¿Puedo ir con perro o niños?',
		a: 'Sí: en terraza no hay problema con perros, y el trato con niños es genial según las reseñas.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 968 50 25 33',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Española', 'Tapas'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'C. Puerta de Murcia, 14',
		addressLocality: business.city,
		addressRegion: 'Murcia',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: { '@type': 'GeoCoordinates', latitude: business.latitude, longitude: business.longitude },
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '09:00', closes: '24:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza en zona peatonal', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Grupos y eventos', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Admite perros en terraza', value: true },
	],
	aggregateRating: { '@type': 'AggregateRating', ratingValue: 4.3, reviewCount: 120, bestRating: 5 },
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Qué pedir', href: '#carta' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {

};

const horas = [
					{ day: 'Lunes', value: '9:00 – 24:00' },
					{ day: 'Martes', value: '9:00 – 24:00' },
					{ day: 'Miércoles', value: 'Cerrado', closed: true },
					{ day: 'Jueves', value: '9:00 – 24:00' },
					{ day: 'Viernes', value: '9:00 – 24:00' },
					{ day: 'Sábado', value: '9:00 – 24:00' },
					{ day: 'Domingo', value: '9:00 – 24:00' },
				];
const mapasPagina = {
	place: mapsUrl,
	directions: mapsUrl,
	streetView: mapsUrl,
	embed: mapEmbedUrl,
};---

<!doctype html>
<html lang="es">
	<head>
		<title>Restaurante Puerta 14 | Cocina casera en el centro de Cartagena</title>
		<meta name="theme-color" content="#191410" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Puerta 14, restaurante Cartagena centro, Puerta de Murcia 14 comer, marinera Cartagena, pulpo cartagenera, croquetas Cartagena, tarta queso Cartagena, café asiático"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Restaurante Puerta 14 · Cocina casera en Cartagena centro"
			ogDescription="Marinera, pulpo a la cartagenera, croquetas y tarta de queso en Puerta de Murcia 14. Raciones enormes, ~20 €. 9:00–24:00."
			ogImage={`${business.site}/og.svg`}
			ogImageAlt="Restaurante Puerta 14, cocina casera en Puerta de Murcia 14, Cartagena"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#191410"
			street={business.street}
			city={business.city}
			region="Murcia"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Casco Antiguo, Cartagena"
			preload={[]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<style>
			.hero-custom { display:grid; grid-template-columns: 1.05fr 0.95fr; gap:2.5rem; align-items:center; padding:4.5rem 0 2.5rem; }
			.hero-custom h1 { font-size: clamp(2.6rem, 5.4vw, 4.4rem); line-height:1.02; margin:0.6rem 0 1rem; }
			.hero-custom h1 em { color: var(--amber); font-style:normal; }
			.hero-custom img { width:100%; height:auto; border-radius: var(--radius); border:1px solid var(--line); }
			.fotos-grid { display:grid; grid-template-columns: repeat(3, 1fr); gap:1rem; margin-top:1.6rem; }
			.fotos-grid figure { margin:0; border:1px solid var(--line); border-radius:14px; overflow:hidden; background:var(--deep-2); }
			.fotos-grid img { width:100%; height:220px; object-fit:cover; display:block; }
			.fotos-grid figcaption { padding:0.6rem 0.8rem; font-size:0.85rem; color:var(--muted); }
			.aviso-fotos { border:1px dashed var(--amber); border-radius:14px; padding:1rem 1.2rem; background:rgba(224,168,62,0.08); font-size:0.95rem; }
			@media (max-width: 980px){ .hero-custom{grid-template-columns:1fr; padding-top:3rem;} .fotos-grid{grid-template-columns:1fr 1fr;} }
			@media (max-width: 640px){ .fotos-grid{grid-template-columns:1fr;} .fotos-grid img{height:200px;} }
		</style>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="14"
			name={business.name}
			subtitle="Centro histórico · Cartagena"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: business.name,
					street: business.street,
					district: business.district ?? '',
					postalCode: business.postalCode,
					city: business.city,
				}}
								horario={horas}
								mapas={mapasPagina}
			/>
		</main>

		<LocalFooter
			mark="14"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Cómo llegar ↗', href: directionsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Ilustraciones propias provisionales. Información elaborada a partir de fuentes públicas; confirma horarios y precios antes de la visita."
			ctaLabel="Llamar a Puerta 14"
		/>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
		<WhatsappFab phone={phoneHref} name={business.name} />
	</body>
</html>
