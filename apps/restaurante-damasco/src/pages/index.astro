---
import '../styles/global.css';
import {
	business,
	directionsUrl,
	facebookPhotosUrl,
	facebookUrl,
	faqSchema,
	faqs,
	hours,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	dishes,
} from '../lib/business';

const title = 'Restaurante Damasco | Cocina siria halal en Córdoba centro';
const description =
	'Restaurante Damasco en Córdoba: cocina siria y halal en Calle Romero, 4. Descubre hummus, falafel, kabsa y arayes. Consulta horarios y reserva en el 631 50 34 36.';
const keywordList =
	'Restaurante Damasco Córdoba, restaurante sirio Córdoba, comida halal Córdoba, comida árabe Córdoba, restaurante libanés Córdoba, hummus Córdoba, falafel Córdoba, kabsa, Calle Romero 4 Córdoba, restaurantes Córdoba centro';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#241e1a" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywordList} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Restaurante Damasco, cocina siria halal en Córdoba centro" />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<meta name="twitter:image:alt" content="Restaurante Damasco, cocina siria halal en Córdoba centro" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Restaurante Damasco, inicio">
				<span class="brand-mark" aria-hidden="true">د</span>
				<span class="brand-name">Restaurante Damasco <small>Cocina siria · Córdoba</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cocina">La cocina</a>
				<a href="#carta">Platos</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 631 50 34 36</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Cocina siria · Halal · Córdoba</p>
					<h1 id="hero-title">Sabores de Damasco,<br /><em>en el corazón de Córdoba.</em></h1>
					<p class="hero-intro">
						Viaja a Oriente Medio desde la mesa: hummus cremoso, falafel, arroz especiado y recetas sirias elaboradas para compartir en un restaurante halal del centro histórico.
					</p>
					<div class="hero-actions">
						<a class="button button-copper" href={phoneHref}>Llamar y reservar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={mapsUrl} target="_blank" rel="noreferrer">Ver Google Maps <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Dirección</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div>
						<div><small>Reservas</small><a href={phoneHref}>{business.phone}</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración original de un plato de comida siria con especias, pan y hierbas">
					<span class="plate-dot" aria-hidden="true"></span>
					<div class="plate" aria-hidden="true"><div class="food"></div></div>
					<div class="art-copy"><strong>De Oriente a tu mesa</strong><span>Tradición · Especias · Hospitalidad</span></div>
				</div>
			</section>

			<div class="facts" aria-label="Cocina y propuesta de Restaurante Damasco">
				<span>Cocina siria</span>
				<span>Restaurante halal</span>
				<span>Opciones vegetarianas</span>
				<span>En el centro histórico</span>
			</div>

			<section class="story section-pad" id="cocina" aria-labelledby="story-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Oriente Medio en Córdoba</p>
					<h2 id="story-title">Una mesa llena<br /><em>de tradición siria.</em></h2>
				</div>
				<div class="story-copy">
					<p>
						Restaurante Damasco está en Calle Romero, 4, en el centro histórico de Córdoba. Su propuesta acerca sabores de la cocina siria y de Oriente Medio a dos pasos de los principales recorridos de la ciudad.
					</p>
					<p>
						En las mesas se comparten mezze, cremas de garbanzo y berenjena, falafel, arroz especiado y platos al horno. La cocina es halal y hay opciones vegetarianas; pregunta por los ingredientes y los alérgenos de cada preparación.
					</p>
					<p class="story-note">
						Las fotografías y reseñas originales se consultan en Google Maps y los perfiles oficiales. Llama para reservar, confirmar los horarios y conocer la carta disponible ese día.
					</p>
				</div>
			</section>

			<section class="menu section-pad" id="carta" aria-labelledby="menu-title">
				<div class="section-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Cocina halal · Para compartir</p>
						<h2 id="menu-title">Empieza con un mezze,<br /><em>quédate por los sabores.</em></h2>
					</div>
					<p>Ideas de platos mencionados en reseñas y fuentes públicas sobre el restaurante. Consulta la carta directamente para conocer ingredientes, alérgenos y disponibilidad actuales.</p>
				</div>
				<div class="menu-grid">
					{dishes.map((dish, index) => (
						<article class="menu-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.text}</p>
						</article>
					))}
				</div>
				<p class="menu-note">Platos ilustrativos, no una carta completa. La disponibilidad y los ingredientes pueden variar; consulta en el restaurante. <a href={phoneHref}>Llama al 631 50 34 36</a>.</p>
			</section>

			<section class="gallery section-pad" id="fotos" aria-labelledby="gallery-title">
				<div>
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Restaurante Damasco · Córdoba</p>
					<h2 id="gallery-title">Mira sus fotos<br /><em>en sus galerías originales.</em></h2>
					<div class="gallery-copy">
						<p>El enlace de Maps facilitado identifica la ficha del restaurante pero no incluye enlaces directos a sus archivos de imagen. Consulta las fotos reales, platos y novedades en las galerías oficiales del negocio.</p>
						<div class="gallery-links">
							<a class="button button-copper" href={mapsUrl} target="_blank" rel="noreferrer">Fotos en Google Maps <span aria-hidden="true">↗</span></a>
							<a class="social-link" href={instagramUrl} target="_blank" rel="noreferrer">Instagram oficial ↗</a>
							<a class="social-link" href={facebookPhotosUrl} target="_blank" rel="noreferrer">Fotos en Facebook ↗</a>
						</div>
					</div>
				</div>
				<div class="map-preview">
					<iframe
						title="Mapa de Restaurante Damasco en Calle Romero, 4, Córdoba; abre Google Maps para ver sus fotos"
						src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<div class="map-caption"><span>Calle Romero, 4 · Córdoba</span><a href={mapsUrl} target="_blank" rel="noreferrer">Abrir ficha y fotos ↗</a></div>
				</div>
				<p class="gallery-note">La ilustración de portada es original y no representa una fotografía del restaurante. Las fotos reales se abren en Google Maps y en sus perfiles oficiales.</p>
			</section>

			<section class="visit section-pad" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Centro histórico · 14003</p>
					<h2 id="visit-title">Ven a descubrir<br /><em>la mesa de Damasco.</em></h2>
					<address>{business.streetAddress}<br />{business.district}, {business.postalCode} {business.city}, España</address>
					<table class="hours">
						<caption>Horario publicado</caption>
						<tbody>
							{hours.map((item) => (
								<tr><th scope="row">{item.day}</th><td>{item.open && item.close ? `${item.open} – ${item.close}` : 'Cerrado'}</td></tr>
							))}
						</tbody>
					</table>
					<p class="hours-note">Horario de fuentes públicas. Puede variar en festivos; confirma por teléfono antes de acudir. Miércoles cerrado.</p>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={mapsUrl} target="_blank" rel="noreferrer">Ficha de Google Maps</a>
					</div>
					<a class="visit-phone" href={phoneHref}>Reservas: {business.phone}</a>
				</div>
				<div class="map-card">
					<iframe
						title="Mapa de Restaurante Damasco en Calle Romero, 4, Centro de Córdoba"
						src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<div class="map-label"><div><strong>{business.name}</strong><small>{business.streetAddress} · Córdoba</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="footer-brand" href="#inicio" aria-label="Restaurante Damasco, volver al inicio">
				<span class="brand-mark" aria-hidden="true">د</span>
				<span>Restaurante Damasco<small>{business.streetAddress} · {business.postalCode} {business.city}</small></span>
			</a>
			<nav class="footer-nav" aria-label="Perfiles y contacto del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Restaurante Damasco · Córdoba. Consulta por teléfono los horarios, disponibilidad, carta y alérgenos.</small>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar y reservar <span>631 50 34 36</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>
