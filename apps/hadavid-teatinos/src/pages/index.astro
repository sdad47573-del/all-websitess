---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/hadavid-teatinos-apaisada-01.jpg';
import vitrina from '../assets/fotos/hadavid-teatinos-apaisada-04.jpg';
import tartas from '../assets/fotos/hadavid-teatinos-vertical-02.jpg';
import panes from '../assets/fotos/hadavid-teatinos-vertical-03.jpg';
import dulces from '../assets/fotos/hadavid-teatinos-vertical-05.jpg';
import tartaletas from '../assets/fotos/hadavid-teatinos-vertical-06.jpg';
import rosca from '../assets/fotos/hadavid-teatinos-vertical-08.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Hadavid Teatinos · Panadería de harinas, Málaga';
const description =
	'Hadavid Teatinos, en C. Franz Kafka, 15 (Teatinos-Universidad, 29010 Málaga). Panadería y pastelería especializada en diferentes tipos de harinas. Teléfono 672 53 37 79. 4,8 sobre 5 en Google.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#hadavid-teatinos`,
	name: BUSINESS.name,
	alternateName: ['Hadavid', 'Panadería Hadavid Teatinos', 'Hadavid Aromas y Sabores Teatinos'],
	description:
		'Panadería y pastelería especializada en diferentes tipos de harinas, en C. Franz Kafka, 15 (Teatinos-Universidad, 29010 Málaga). Panes de sarraceno, centeno y malta, tartas y bollería.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34672533779',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:30',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '08:30',
			closes: '15:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: vitrina,
		alt: 'Vitrina de Hadavid con donuts, napolitanas, cruasanes, cookies, tartas y bandejas de dulces',
	},
	{
		src: panes,
		alt: 'Panes de distintas harinas con carteles de malta, centeno, sarraceno, calabaza y arroz',
	},
	{
		src: tartas,
		alt: 'Tartas de chocolate, de zanahoria y con nata y fresa en la vitrina',
	},
	{
		src: rosca,
		alt: 'Rosca glaseada con chocolate blanco sobre papel de horno',
	},
	{
		src: dulces,
		alt: 'Surtido de dulces: tarta de chocolate, tarta de fresa, brownies y dulces de zanahoria',
	},
	{
		src: tartaletas,
		alt: 'Tartaletas de frutos rojos, limón y crema en la vitrina, con barritas de hojaldre',
	},
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"hadavid-teatinos-apaisada-01.jpg": fachada,
	"hadavid-teatinos-apaisada-04.jpg": vitrina,
	"hadavid-teatinos-vertical-03.jpg": panes,
	"hadavid-teatinos-vertical-02.jpg": tartas,
	"hadavid-teatinos-vertical-08.jpg": rosca,
	"hadavid-teatinos-vertical-05.jpg": dulces,
	"hadavid-teatinos-vertical-06.jpg": tartaletas,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2e1f15" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,300..700;1,300..600&family=Work+Sans:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Hadavid Teatinos, panadería Málaga, pastelería Teatinos, pan de sarraceno, harinas Málaga, Franz Kafka 15, 29010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería y pastelería especializada en harinas: sarraceno, centeno y malta. Tartas y bollería. En Franz Kafka, 15, Teatinos. 4,8 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Hadavid Teatinos, con el rótulo negro «Hadavid aromas y sabores»"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2e1f15"
			phone="+34672533779"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Panadería · Pastelería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar a Hadavid"
			navAriaLabel="Enlaces de Hadavid Teatinos"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
