---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/hadavid-teatinos-apaisada-01.jpg';
import vitrina from '../assets/fotos/hadavid-teatinos-apaisada-04.jpg';
import tartas from '../assets/fotos/hadavid-teatinos-vertical-02.jpg';
import panes from '../assets/fotos/hadavid-teatinos-vertical-03.jpg';
import dulces from '../assets/fotos/hadavid-teatinos-vertical-05.jpg';
import tartaletas from '../assets/fotos/hadavid-teatinos-vertical-06.jpg';
import rosca from '../assets/fotos/hadavid-teatinos-vertical-08.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Hadavid Teatinos · Panadería de harinas, Málaga';
const description =
	'Hadavid Teatinos, en C. Franz Kafka, 15 (Teatinos-Universidad, 29010 Málaga). Panadería y pastelería especializada en diferentes tipos de harinas. Teléfono 672 53 37 79. 4,8 sobre 5 en Google.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#hadavid-teatinos`,
	name: BUSINESS.name,
	alternateName: ['Hadavid', 'Panadería Hadavid Teatinos', 'Hadavid Aromas y Sabores Teatinos'],
	description:
		'Panadería y pastelería especializada en diferentes tipos de harinas, en C. Franz Kafka, 15 (Teatinos-Universidad, 29010 Málaga). Panes de sarraceno, centeno y malta, tartas y bollería.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34672533779',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:30',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '08:30',
			closes: '15:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: vitrina,
		alt: 'Vitrina de Hadavid con donuts, napolitanas, cruasanes, cookies, tartas y bandejas de dulces',
	},
	{
		src: panes,
		alt: 'Panes de distintas harinas con carteles de malta, centeno, sarraceno, calabaza y arroz',
	},
	{
		src: tartas,
		alt: 'Tartas de chocolate, de zanahoria y con nata y fresa en la vitrina',
	},
	{
		src: rosca,
		alt: 'Rosca glaseada con chocolate blanco sobre papel de horno',
	},
	{
		src: dulces,
		alt: 'Surtido de dulces: tarta de chocolate, tarta de fresa, brownies y dulces de zanahoria',
	},
	{
		src: tartaletas,
		alt: 'Tartaletas de frutos rojos, limón y crema en la vitrina, con barritas de hojaldre',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2e1f15" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,300..700;1,300..600&family=Work+Sans:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Hadavid Teatinos, panadería Málaga, pastelería Teatinos, pan de sarraceno, harinas Málaga, Franz Kafka 15, 29010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería y pastelería especializada en harinas: sarraceno, centeno y malta. Tartas y bollería. En Franz Kafka, 15, Teatinos. 4,8 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Hadavid Teatinos, con el rótulo negro «Hadavid aromas y sabores»"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2e1f15"
			phone="+34672533779"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Panadería · Pastelería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Franz Kafka, 15 · Teatinos-Universidad"
				title="Pan de harinas <br /><em>con nombre propio.</em>"
				lede={`Hadavid Teatinos está en la calle Franz Kafka, 15, con la fachada blanca, el rótulo negro de «Hadavid aromas y sabores» y el toldo a juego. Dentro, el pan se etiqueta por harina —malta con centeno y linaza, sarraceno con jengibre y cúrcuma, sarraceno con calabaza hervida— y la vitrina se llena de tartas, tartaletas y bollería. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={fachada}
				imageAlt="Fachada de Hadavid Teatinos, con el rótulo negro «Hadavid aromas y sabores» y el toldo"
				primaryCta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,8</b> en Google · 453 reseñas' },
					{ label: 'Horario', html: '<b>L–V 8:30–21:00</b> · S 8:30–15:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b>` },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Harinas · pan · pastelería"
			/>

			<LocalChips label="Lo que hay en Hadavid" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Harinas, horno <br /><em>y vitrina.</em>"
				paragraphs={[
					'Hadavid Teatinos está en la calle Franz Kafka, 15, en Teatinos-Universidad. La fachada es blanca, con un rótulo negro que dice «Hadavid aromas y sabores» y un toldo del mismo color sobre la puerta.',
					'La ficha lo define como «panadería pastelería especializada en diferentes tipos de harinas». En las fotos del perfil se ve el obrador con los panes etiquetados: malta con centeno y linaza, sarraceno con jengibre y cúrcuma, sarraceno con calabaza hervida y sarraceno con arroz.',
					'La vitrina mezcla pan y dulce: tartas de chocolate, de zanahoria y con nata y fresa, tartaletas de frutos rojos, limón y crema, roscas glaseadas, donuts, napolitanas, cruasanes, cookies y brownies.',
					'Abre de lunes a viernes de 8:30 a 21:00 y el sábado de 8:30 a 15:00; el domingo cierra. La ficha no publica carta, precios ni página web, así que aquí no encontrarás importes.',
				]}
				note="Sin carta ni precios publicados: el mostrador recoge solo lo que muestran las fotos del perfil —con los carteles de las harinas— y lo que cuentan las reseñas de Google."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Harinas, pan <br />
							<em>y pastelería.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que sale <br /><em>del obrador.</em>"
				description="Sin carta ni precios publicados: esto es lo que muestran las fotos del local y lo que cuentan las reseñas de Google."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU_GROUPS}
				note={`La ficha no recoge precios ni métodos de pago, así que esta web no publica importes. El surtido cambia a lo largo del día. Para saber qué hay hoy, llama al ${BUSINESS.phone}.`}
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La casa, <br /><em>por dentro.</em>"
				description="Seis fotos de la ficha de Google Maps: la vitrina, los panes etiquetados por harina, las tartas, la rosca glaseada, el surtido de dulces y las tartaletas."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Franz Kafka, <br /><em>número 15.</em>"
				addressLines={[
					BUSINESS.street,
					BUSINESS.district,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
				]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de Hadavid Teatinos en la calle Franz Kafka, 15, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Hadavid · Teatinos"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phone, href: BUSINESS.phoneHref }}
				reserveNote="La ficha de Google indica acceso para sillas de ruedas, pero no publica información sobre aparcamiento adaptado, el mostrador o el aseo. El contacto es en el local o por teléfono."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar a Hadavid"
			navAriaLabel="Enlaces de Hadavid Teatinos"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
