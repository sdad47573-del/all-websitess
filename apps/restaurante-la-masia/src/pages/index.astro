---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	business,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Restaurante La Masía · El Ejido, Almería';
const description =
	'Restaurante La Masía, cocina española y mediterránea en la calle Conde de Barcelona, 12, de El Ejido. 4,5 sobre 5 con 184 reseñas; cierra los lunes.';
const keywords =
	'Restaurante La Masía El Ejido, restaurante El Ejido, cocina española El Ejido, restaurante mediterráneo El Ejido, calle Conde de Barcelona, La Masía teléfono';

/**
 * Texto alternativo de las fotos.
 *
 * Google no describe el contenido de ninguna de las nueve que publica este restaurante. Una lleva
 * en la ficha el título «Restaurante la masia», que solo repite el nombre del negocio, así que no
 * sirve como descripción y no se usa: todos los `alt` avisan solo de dónde salen las fotos.
 */
const altFoto =
	'Fotografía publicada en la ficha de Google Maps de Restaurante La Masía, en El Ejido (Almería)';
const altOg = 'Fotografía de Restaurante La Masía publicada en su ficha de Google Maps';

/**
 * Galería completa: las nueve fotografías publicables de la ficha.
 *
 * La portada de la galería trae diez; una es un fotograma de vídeo, así que no se publica.
 */
const galeria = [
	foto('restaurante-la-masia-vertical-01.jpg'),
	foto('restaurante-la-masia-vertical-03.jpg'),
	foto('restaurante-la-masia-apaisada-04.jpg'),
	foto('restaurante-la-masia-vertical-05.jpg'),
	foto('restaurante-la-masia-apaisada-06.jpg'),
	foto('restaurante-la-masia-apaisada-07.jpg'),
	foto('restaurante-la-masia-apaisada-08.jpg'),
	foto('restaurante-la-masia-vertical-09.jpg'),
	foto('restaurante-la-masia-vertical-10.jpg'),
];

/** Tres fotos de avance en el collage de la portada (también están en la galería). */
const collage = [
	{ src: galeria[2], clase: 'collage-item collage-item-a' },
	{ src: galeria[0], clase: 'collage-item collage-item-b' },
	{ src: galeria[3], clase: 'collage-item collage-item-c' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1c3c34" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-AL" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Work+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">LM</span>
				<span class="brand-text">
					La Masía
					<small>El Ejido · Almería</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#bar">El restaurante</a>
				<a href="#cocina">Las fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">El Ejido · Almería</p>
						<h1 id="hero-title">
							Cocina española<br /><em>y mediterránea.</em>
						</h1>
						<p class="hero-lede">
							El Restaurante La Masía está en la calle Conde de Barcelona, 12, en El Ejido, y
							abre de martes a domingo cerrando los lunes. Google le da
							{' '}{business.rating.toLocaleString('es-ES')} sobre 5 con
							{' '}{business.reviewCount.toLocaleString('es-ES')} reseñas, y sus reseñas
							hablan de pisto con huevo, costillas, crema catalana y servicio excelente.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>Llamar al {business.phone}</a>
							<a class="btn btn-ghost" href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>{business.streetAddress} · {business.postalCode} {business.city}</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas
								</strong>
							</li>
						</ul>
					</div>

					<div class="hero-collage">
						{
							collage.map((item, index) => (
								<figure class={item.clase}>
									<Image
										src={item.src}
										alt={altFoto}
										widths={index === 0 ? [640, 900, 1200] : [320, 480, 640]}
										sizes={
											index === 0
												? '(max-width: 1080px) 92vw, 46vw'
												: '(max-width: 1080px) 45vw, 23vw'
										}
										format="avif"
										quality={68}
										loading={index === 0 ? 'eager' : 'lazy'}
										fetchpriority={index === 0 ? 'high' : undefined}
										decoding="async"
									/>
								</figure>
							))
						}
					</div>
				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
					{business.reviewCount.toLocaleString('es-ES')} reseñas
				</span>
				<span>{business.streetAddress} · {business.postalCode} {business.city}</span>
				<span>{hoursSummary}</span>
				<span>Teléfono {business.phone}</span>
			</div>

			<section class="section" id="bar" aria-labelledby="bar-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">El restaurante</p>
						<h2 class="title" id="bar-title">
							Mediodía todos los días<br /><em>y cena los fines de semana.</em>
						</h2>
						<p>
							La Masía está en la calle Conde de Barcelona, 12, en El Ejido. Google lo cataloga
							como restaurante, restaurante mediterráneo y restaurante de cocina española, y le
							da {business.rating.toLocaleString('es-ES')} sobre 5 con
							{' '}{business.reviewCount.toLocaleString('es-ES')} reseñas.
						</p>
						<p>
							Abre a mediodía de martes a domingo, con la cocina cerrando entre las 16:30 y las
							17:00 según el día, y solo añade el turno de noche los viernes y los sábados, de
							20:30 a 24:00. Los lunes cierra; el de la semana de la consulta coincidía con el
							festivo del 12 de octubre, y la ficha avisaba de que el horario podía ser
							diferente.
						</p>
						<p class="bar-note">
							La ficha escribe la dirección como «C. Conde de Barcelona, 12»: aquí se desarrolla
							la abreviatura a «Calle», como en el resto de webs del repositorio. Esta web se ha
							preparado solo con lo que publica esa ficha, consultada el {site.consultado}:
							nombre, dirección, teléfono, categorías, horario, valoración, sus reseñas y sus
							propias fotografías. La ficha no publica la carta, así que aquí no se reproduce.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>{business.reviewCount.toLocaleString('es-ES')} reseñas en Google Maps</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver todas ↗</a>
						</div>
						{
							reviews.map((review) => (
								<blockquote class="quote">
									<p>{review.text}</p>
									<footer>{review.source}</footer>
								</blockquote>
							))
						}
					</div>
				</div>
			</section>

			<section class="section cocina" id="cocina" aria-labelledby="cocina-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="cocina-title">
						Las fotos del <em>propio restaurante.</em>
					</h2>
					<p class="lead">
						Son las fotografías que La Masía publica en su ficha de Google Maps. De las diez que
						trae la portada de la galería, una es un fotograma de vídeo y no se publica aquí.
						Google no describe lo que se ve en ninguna, así que no se inventa un contenido que no
						consta.
					</p>
					<div class="cocina-grid">
						{
							galeria.map((src) => (
								<figure class="cocina-item">
									<Image
										src={src}
										alt={altFoto}
										widths={[380, 560, 800]}
										sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
										format="avif"
										quality={68}
										loading="lazy"
										decoding="async"
									/>
								</figure>
							))
						}
					</div>
					<p class="cocina-note">
						La ficha no publica la carta ni los precios, así que esta web no los reproduce. Para
						saber qué hay hoy, lo más rápido es <a href={phoneHref}>llamar al {business.phone}</a>
						{' '}o mirar las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos y reseñas de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Calle Conde de<br /><em>Barcelona, 12.</em>
						</h2>
						<address>
							{business.streetAddress}<br />
							{business.postalCode} {business.city}<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{
									hours.map((item) => (
										<tr class:list={[{ 'is-closed': item.shifts.length === 0 }]}>
											<th scope="row">{item.day}</th>
											<td>{item.service}</td>
										</tr>
									))
								}
							</tbody>
						</table>
						<p class="hours-note">
							El lunes 12 de octubre de 2026 la ficha lo marcaba como Fiesta Nacional de
							España, cerrado, con el aviso de que el horario podía ser diferente. Llama y
							confirma el día antes de desplazarte.
						</p>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
						 src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-tag">
							<div>
								<strong>{business.name}</strong>
								<small>Calle Conde de Barcelona, 12 · 04700 El Ejido</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">Antes de <em>venir.</em></h2>
					<div class="faq-list">
						{
							faqs.map((faq) => (
								<details>
									<summary>{faq.question}</summary>
									<p>{faq.answer}</p>
								</details>
							))
						}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">LM</span>
					<span>
						La Masía
						<small>Calle Conde de Barcelona, 12 · 04700 El Ejido</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del restaurante">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">Ficha en Google Maps ↗</a>
					<a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Reseñas en Google ↗</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Restaurante La Masía · El Ejido (Almería). Web informativa
					elaborada con los datos y las fotografías que el restaurante publica en su ficha de
					Google Maps, consultada el {site.consultado}. Confirma horario y disponibilidad por
					teléfono antes de venir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a La Masía <span>{business.phone}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>


