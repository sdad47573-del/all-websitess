---
const business = {
	name: 'La Fuente del Hervidero · Restaurante Casa Macareno',
	street: 'Fuente del Hervidero, s/n',
	city: 'La Zubia',
	region: 'Granada',
	postalCode: '18140',
	country: 'ES',
	phone: '+34 958 34 00 93',
	latitude: 37.0876576,
	longitude: -3.532414,
	site: 'https://la-fuente-del-hervidero-casa-macareno.vercel.app',
};

const mapsUrl = 'https://www.google.com/maps/place/La+Fuente+del+Hervidero.+Restaurante+Casa+Macareno/@37.0876576,-3.532414,17z/data=!3m1!4b1!4m6!3m5!1s0xd71e59bc318c789:0x2b620374d4cfdc5e!8m2!3d37.0876576!4d-3.532414!16s%2Fg%2F12qfb0srs?hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=15&hl=es&output=embed`;
const facebookUrl = 'https://www.facebook.com/fuentedelhervidero/';
const phoneHref = 'tel:+34958340093';
const siteUrl = `${business.site}/`;
const description = 'Descubre La Fuente del Hervidero · Restaurante Casa Macareno, en La Zubia, Granada. Cocina casera y tradicional en el entorno de Cumbres Verdes. Teléfono, mapa, indicaciones y acceso a sus fotos de Google Maps.';

const faqs = [
	{
		question: '¿Dónde está Casa Macareno?',
		answer: 'El restaurante figura en Fuente del Hervidero, s/n, 18140 La Zubia, Granada. Usa el mapa de esta página o abre las indicaciones de Google Maps para preparar el trayecto.',
	},
	{
		question: '¿Cuál es el teléfono del restaurante?',
		answer: 'El teléfono publicado para La Fuente del Hervidero · Restaurante Casa Macareno es el 958 34 00 93. Llama para consultar reservas, disponibilidad y cualquier detalle antes de ir.',
	},
	{
		question: '¿Qué tipo de cocina ofrece?',
		answer: 'Las fichas públicas describen el establecimiento como restaurante de cocina casera y tradicional. Para conocer la carta actual, los platos disponibles y sus precios, contacta directamente con el restaurante.',
	},
	{
		question: '¿Cuál es el horario de apertura?',
		answer: 'Los horarios que aparecen en directorios públicos no coinciden entre sí. Para evitar un viaje en balde, llama al 958 34 00 93 y confirma el horario del día, especialmente en festivos.',
	},
	{
		question: '¿Dónde puedo ver fotos del restaurante?',
		answer: 'Abre la ficha de Casa Macareno en Google Maps desde el botón de esta página. Allí puedes consultar las fotos publicadas en la ficha y revisar la información más reciente del establecimiento.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${siteUrl}#restaurant`,
	name: business.name,
	description,
	url: siteUrl,
	telephone: business.phone,
	servesCuisine: ['Cocina casera', 'Cocina tradicional'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: business.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [mapsUrl, facebookUrl],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

import Galeria from '../components/Galeria.astro';---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#213b32" />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" />
		<title>Casa Macareno en La Zubia | Restaurante Fuente del Hervidero</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Casa Macareno · Restaurante en Fuente del Hervidero" />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${business.site}/og.svg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="La Fuente del Hervidero · Restaurante Casa Macareno, La Zubia, Granada" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.region" content="ES-GR" />
		<meta name="geo.placename" content="La Zubia" />
		<meta name="geo.position" content="37.0876576;-3.532414" />
		<meta name="ICBM" content="37.0876576, -3.532414" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Casa Macareno, inicio"><span class="brand-mark" aria-hidden="true">M</span><span>Casa Macareno<small>Fuente del Hervidero · Granada</small></span></a>
			<nav aria-label="Navegación principal"><a href="#restaurante">El restaurante</a><a href="#fotos">Fotos</a><a href="#visita">Cómo llegar</a></nav>
			<a class="header-call" href={phoneHref}>Llamar · 958 34 00 93</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span>La Zubia · Granada</span><i aria-hidden="true"></i> En el entorno de Cumbres Verdes</p>
					<h1 id="hero-title">Una mesa con<br />sabor a <em>tradición.</em></h1>
					<p class="lede">La Fuente del Hervidero · Restaurante Casa Macareno es una casa de comidas de cocina casera y tradicional en La Zubia, Granada. Consulta su ficha, llama para preguntar por la carta y organiza tu visita.</p>
					<div class="actions"><a class="button button-gold" href={phoneHref}>Llamar al restaurante <span aria-hidden="true">↗</span></a><a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Ver indicaciones <span aria-hidden="true">↗</span></a></div>
					<div class="hero-details"><span>⌖ Fuente del Hervidero, s/n</span><span>✦ Cocina casera · cocina tradicional</span></div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración original de una mesa rústica en un paisaje de montaña granadino">
					<div class="sun"></div><div class="mountain mountain-back"></div><div class="mountain mountain-front"></div><div class="pine pine-one"></div><div class="pine pine-two"></div><div class="pine pine-three"></div><div class="pine pine-four"></div><div class="ground"></div><div class="table"></div><div class="table-top"></div><div class="plate"><span class="dish"></span><span class="greens"></span><span class="bread"></span></div><div class="glass"><span></span></div><div class="art-label">La Zubia<br /><b>Granada</b></div><span class="sparkle sparkle-one">✦</span><span class="sparkle sparkle-two">✧</span>
				</div>
			</section>

			<div class="ticker" aria-label="Información del Restaurante Casa Macareno"><span>La Fuente del Hervidero</span><b>✳</b><span>Casa Macareno</span><b>✳</b><span>La Zubia · Granada</span><b>✳</b><span>Cocina tradicional</span></div>

			<section class="intro section-wrap" id="restaurante"><div><p class="eyebrow eyebrow-dark">Una parada en la sierra granadina</p><h2>Cocina casera<br /><em>en La Zubia.</em></h2></div><div class="intro-copy"><p>En las fuentes públicas, Casa Macareno aparece como un restaurante de cocina casera y tradicional en el entorno de Fuente del Hervidero, en La Zubia. Si estás preparando una escapada por esta zona de Granada, aquí tienes su ubicación y contacto para confirmar los detalles directamente.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Abrir ficha y consultar reseñas en Google Maps ↗</a></div></section>

			<section class="features section-wrap" aria-labelledby="features-title"><div class="section-heading"><p class="eyebrow eyebrow-dark">Información para tu visita</p><h2 id="features-title">Todo a mano,<br /><em>antes de salir.</em></h2><p>Consulta los datos del restaurante y contacta directamente para conocer la carta, disponibilidad y horario actual.</p></div>
				<div class="feature-grid">
					<article class="feature-card"><span class="feature-icon" aria-hidden="true">⌂</span><span class="card-kicker">DÓNDE ENCONTRARLO</span><h3>Fuente del Hervidero</h3><p>La Zubia, Granada. Abre el mapa para situar el restaurante y preparar el recorrido.</p></article>
					<article class="feature-card"><span class="feature-icon feature-phone" aria-hidden="true">✆</span><span class="card-kicker">CONTACTO DIRECTO</span><h3>Una llamada resuelve dudas</h3><p>Pregunta por reservas, horario, platos del día o cualquier necesidad antes de desplazarte.</p></article>
					<article class="feature-card"><span class="feature-icon feature-food" aria-hidden="true">❋</span><span class="card-kicker">COCINA PUBLICADA</span><h3>Tradicional y casera</h3><p>Así se describe la cocina en directorios públicos. Confirma la carta y los precios con el establecimiento.</p></article>
			</div>
			</section>

			<section class="photo-section" id="fotos"><div class="photo-copy"><p class="eyebrow">La ficha de Casa Macareno</p><h2>Descubre sus fotos<br />en <em>Google Maps.</em></h2><p>Consulta las imágenes publicadas por el restaurante y sus visitantes directamente en Google Maps, junto con reseñas y datos actualizados de la ficha.</p><a class="button button-gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a><a class="social-link" href={facebookUrl} target="_blank" rel="noopener noreferrer">Facebook de El Hervidero, Casa Macareno ↗</a><p class="photo-note">Las fotografías se muestran en Google Maps; este sitio no las descarga ni las aloja.</p></div>
				<div class="map-photo"><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Google de La Fuente del Hervidero, Restaurante Casa Macareno, en La Zubia" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
					<noscript>
						<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
					</noscript>
				</div><a class="map-caption" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">⌖</span><span><b>Casa Macareno</b><small>Fuente del Hervidero · Ver ficha y fotos ↗</small></span></a></div>
			</section>

			<section class="visit section-wrap" id="visita"><div class="visit-copy"><p class="eyebrow eyebrow-dark">Prepara tu recorrido</p><h2>Cómo llegar<br /><em>a Casa Macareno.</em></h2><p>La ficha sitúa el restaurante en Fuente del Hervidero, en La Zubia. Como los horarios publicados en internet no coinciden, te recomendamos confirmar por teléfono antes de salir.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button button-dark" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Llamar · 958 34 00 93</a></div></div>
				<div class="visit-card"><div class="visit-title"><span class="visit-icon" aria-hidden="true">⌖</span><div><p class="eyebrow eyebrow-dark">Ubicación y contacto</p><h3>La Zubia · Granada</h3></div></div><dl><div><dt>Dirección</dt><dd>Fuente del Hervidero, s/n<br />18140 La Zubia (Granada)</dd></div><div><dt>Teléfono</dt><dd><a href={phoneHref}>958 34 00 93</a></dd></div><div><dt>Horario</dt><dd>Confirma por teléfono<br />antes de tu visita</dd></div></dl><p class="visit-note">Los directorios consultados muestran horarios distintos. Llama para comprobar la apertura del día y consultar reservas.</p><a class="visit-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Consultar ficha de Google Maps ↗</a></div>
			</section>

			<section class="faq-section section-wrap" id="preguntas"><p class="eyebrow eyebrow-dark">Preguntas frecuentes</p><h2>Antes de <em>visitarlo.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
			<Galeria nombre="La Fuente del Hervidero · Restaurante Casa Macareno" mapsUrl={mapsUrl} />
		</main>

		<footer class="footer"><div class="footer-top"><a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">M</span><span>Casa Macareno<small>Fuente del Hervidero · Granada</small></span></a><p>Cocina casera<br />en La Zubia.</p><nav aria-label="Enlaces de Casa Macareno"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={facebookUrl} target="_blank" rel="noopener noreferrer">Facebook ↗</a><a href={phoneHref}>958 34 00 93</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} La Fuente del Hervidero · Restaurante Casa Macareno</span><a href="/aviso-legal/">Aviso legal y privacidad</a> <a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a> <span>Confirma directamente horarios, carta y disponibilidad.</span></div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar <span>958 34 00 93</span></a>
	</body>
</html>

<style is:global>
	:root{font-family:'DM Sans',sans-serif;color:#2e3932;background:#f6f2e8;font-synthesis:none;text-rendering:optimizeLegibility;--forest:#213b32;--forest-light:#44664f;--gold:#d4b77b;--cream:#f6f2e8;--ink:#2e3932;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid #d4b77b;outline-offset:4px}.skip-link{position:absolute;z-index:99;top:-60px;left:16px;padding:12px 16px;background:var(--gold);color:var(--forest)}.skip-link:focus{top:12px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:22px;background:var(--forest);color:#fcf9f0}.brand{display:flex;align-items:center;gap:11px;font-size:14px;font-weight:700}.brand small{display:block;margin-top:4px;color:#d3dfd1;font-size:8px;font-weight:500;letter-spacing:1.25px;text-transform:uppercase}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--gold);border-radius:50%;color:#e0c78c;font:700 23px var(--display)}.topbar nav{display:flex;gap:clamp(14px,2.5vw,32px);color:#e4e9dd;font-size:12px}.topbar nav a:hover,.footer a:hover{color:#e0c78c}.header-call{padding:11px 17px;border:1px solid #ffffff55;border-radius:99px;font-size:11px;font-weight:700}.hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:560px;background:var(--forest);color:#fcf9f0;overflow:hidden}.hero-copy{padding:73px 4vw 64px 9vw;align-self:center}.eyebrow{margin:0 0 19px;color:#dfca91;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase}.eyebrow i{display:inline-block;width:22px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.section-heading h2,.photo-copy h2,.visit h2,.faq-section h2{margin:0;font:600 clamp(39px,4.8vw,64px)/1.08 var(--display);letter-spacing:-1.2px}.hero h1 em,.intro h2 em,.section-heading h2 em,.photo-copy h2 em