---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/las-columnas-apaisada-05.jpg';
import vitrina from '../assets/fotos/las-columnas-apaisada-01.jpg';
import guisos from '../assets/fotos/las-columnas-apaisada-02.jpg';
import vitrinaDos from '../assets/fotos/las-columnas-apaisada-04.jpg';
import tortilla from '../assets/fotos/las-columnas-vertical-03.jpg';
import cartaPicar from '../assets/fotos/las-columnas-vertical-06.jpg';
import cartaGuisos from '../assets/fotos/las-columnas-vertical-07.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	INSTAGRAM,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Las Columnas · Comida para llevar en el Casco Antiguo de Sevilla';
const description =
	'Las Columnas, comida para llevar en C. Conde de Barajas, 6, Sevilla. Pollo asado entero 12 €, guisos de cuchara, ensaladilla, tortillas y postres. Carta, precios, horario y teléfono.';

const galeria = [
	{ src: fachada, alt: 'Esquina del edificio amarillo con el rótulo verde de Las Columnas en Conde de Barajas' },
	{ src: vitrina, alt: 'Vitrina de Las Columnas con ensaladilla, patatas alioli, calamares y ensaladas' },
	{ src: guisos, alt: 'Bandejas de guisos del local con carne, pollo en salsa y verduras' },
	{ src: vitrinaDos, alt: 'Mostrador refrigerado con bandejas de guisos y conservas' },
	{ src: tortilla, alt: 'Tortilla de patata entera junto a botellas de zumo en el mostrador' },
	{ src: cartaPicar, alt: 'Carta de Las Columnas con los precios de para picar, pollo asado y postres' },
	{ src: cartaGuisos, alt: 'Segunda página de la carta con los guisos y varios y sus precios' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Las Columnas',
	inLanguage: 'es-ES',
	description:
		'Carta tomada de las fotografías que el establecimiento publica en su ficha de Google; los precios pueden cambiar.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#las-columnas`,
	name: BUSINESS.name,
	alternateName: ['Las Columnas Sevilla', 'Las Columnas Comidas para Llevar'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, INSTAGRAM],
	telephone: '+34955952614',
	servesCuisine: ['Comida casera', 'Comida para llevar', 'Pollo asado', 'Andaluza'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '22:00',
		},
	],
	priceRange: '€€',
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Las Columnas Sevilla, comida para llevar Casco Antiguo, pollo asado Sevilla, Conde de Barajas 6, guisos para llevar Sevilla, carta Las Columnas"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado, guisos de cuchara y raciones para llevar en Conde de Barajas, 6. Carta con precios, fotos y horario."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Esquina del local de Las Columnas en el Casco Antiguo de Sevilla"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#23303f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Casco Antiguo de Sevilla"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Las Columnas"
			subtitle="Comida para llevar · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Conde de Barajas, 6 · Casco Antiguo"
				title="Pollo asado y guisos, <br /><em>para llevar.</em>"
				lede={`Las Columnas está en la esquina de Conde de Barajas con Feria, en pleno Casco Antiguo. Su carta combina pollo asado, guisos de cuchara, raciones para picar, tortillas y postres caseros, con precios desde 2,75 €. La ficha de Google marca ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				image={fachada}
				imageAlt="Esquina del edificio amarillo con el rótulo verde de Las Columnas comidas para llevar"
				primaryCta={{ label: `Encargar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver ficha en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Pollo entero', html: '<b>12,00 €</b> en la carta' },
					{ label: 'Valoración', html: `<b>${RATING.label}</b> · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>9:00 – 22:00</b> todos los días' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver fotos y ficha"
				tag="Abierto todos los días"
			/>

			<LocalChips label="Servicios y oferta de Las Columnas" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Las Columnas, <br /><em>cuchara y brasa.</em>"
				paragraphs={[
					'Las Columnas abrió en la calle Conde de Barajas, 6, en la esquina con Feria, con un rótulo verde que lo dice claro: comidas para llevar. Google lo clasifica como restaurante de comida para llevar y abre de 9:00 a 22:00 todos los días.',
					'La carta se organiza en para picar, ensaladas, tortillas, pollo asado, guisos de cuchara, guisos y varios, y postres. Hay desde ensaladilla rusa o patatas alioli con langostinos hasta carrillada, cola de toro, solomillo al roquefort o paella de marisco.',
					'El pollo asado es una de las casas: entero por 12,00 €, medio por 6,50 € y contramuslo por 4,50 €. Las tortillas se venden enteras, de patatas (8,50 €) o de patatas y cebolla (9,00 €), y los postres van de 3,25 € a 5,50 €.',
				]}
				note="Los precios y platos proceden de la carta impresa que el local publica en su ficha de Google; pueden cambiar y no incluyen posibles suplementos. Confirma el importe y la disponibilidad al encargar."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotografías', href: '#galeria' },
					{ label: '@lascolumnasparallevar en Instagram', href: INSTAGRAM, external: true },
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<ul class="highlights">
				{
					HIGHLIGHTS.map((item) => (
						<li>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</li>
					))
				}
			</ul>

			<LocalMenu
				eyebrow="Carta del local"
				title="De la cuchara <br /><em>al pollo asado.</em>"
				description="Estos son los platos y precios que aparecen en la carta impresa del establecimiento: pollo asado, raciones para picar, guisos de cuchara, ensaladas, tortillas y postres."
				cta={{ label: `Pedir por teléfono · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Selección de la carta; hay más platos en el local. Las raciones marcadas como 1/4 corresponden a cuarto de bandeja. Precios de la carta fotografiada en octubre de 2026, sujetos a cambios."
			/>

			<LocalGallery
				eyebrow="Fotos del perfil de Google Maps"
				title="El local <br /><em>y la vitrina.</em>"
				description="La esquina de Conde de Barajas, la vitrina de guisos y las dos páginas de la carta tal como aparecen en las fotografías públicas del establecimiento."
				images={galeria}
				cta={{ label: 'Abrir la ficha en Google Maps', href: MAPS.place }}
				note="Imágenes descargadas del perfil público de Las Columnas en Google Maps y servidas desde esta página."
			/>

			<section class="notas" aria-labelledby="notas-title">
				<div class="wrap notas-grid">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="notas-title">La valoración <br /><em>en Google.</em></h2>
						<p class="notas-score">
							<strong>{RATING.label}</strong>
							<span>
								<b>★★★★★</b>
								{RATING.count} reseñas<br />en Google
							</span>
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer reseñas en Google ↗
						</a>
					</div>

					<div class="notas-copy">
						<p>
							La ficha de Google reúne {RATING.count} opiniones con una media de {RATING.label} sobre
							5 en el momento de consultarla. En esta página no se reproducen los comentarios: se
							leen directamente en la ficha oficial, donde aparecen actualizados.
						</p>
						<p class="notas-foot">
							Datos consultados en octubre de 2026. <a
								href={MAPS.reviews}
								target="_blank"
								rel="noreferrer">Consulta las opiniones actualizadas en Google ↗</a
							>.
						</p>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Conde <br /><em>de Barajas.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de Las Columnas en C. Conde de Barajas, 6, Sevilla"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Conde de Barajas, 6 · Sevilla"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote={`La carta impresa añade otro número para pedidos: ${BUSINESS.secondaryPhone}. Llama para encargar el pollo, reservar bandejas o preguntar por los guisos del día.`}
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Carta y fotografías de la ficha pública de Google Maps. Confirma precios y disponibilidad con el establecimiento."
			ctaLabel="Llamar a Las Columnas"
			navAriaLabel="Enlaces de Las Columnas"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
