---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/las-columnas-apaisada-05.jpg';
import vitrina from '../assets/fotos/las-columnas-apaisada-01.jpg';
import guisos from '../assets/fotos/las-columnas-apaisada-02.jpg';
import vitrinaDos from '../assets/fotos/las-columnas-apaisada-04.jpg';
import tortilla from '../assets/fotos/las-columnas-vertical-03.jpg';
import cartaPicar from '../assets/fotos/las-columnas-vertical-06.jpg';
import cartaGuisos from '../assets/fotos/las-columnas-vertical-07.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	INSTAGRAM,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Las Columnas · Comida para llevar en el Casco Antiguo de Sevilla';
const description =
	'Las Columnas, comida para llevar en C. Conde de Barajas, 6, Sevilla. Pollo asado entero 12 €, guisos de cuchara, ensaladilla, tortillas y postres. Carta, precios, horario y teléfono.';

const galeria = [
	{ src: fachada, alt: 'Esquina del edificio amarillo con el rótulo verde de Las Columnas en Conde de Barajas' },
	{ src: vitrina, alt: 'Vitrina de Las Columnas con ensaladilla, patatas alioli, calamares y ensaladas' },
	{ src: guisos, alt: 'Bandejas de guisos del local con carne, pollo en salsa y verduras' },
	{ src: vitrinaDos, alt: 'Mostrador refrigerado con bandejas de guisos y conservas' },
	{ src: tortilla, alt: 'Tortilla de patata entera junto a botellas de zumo en el mostrador' },
	{ src: cartaPicar, alt: 'Carta de Las Columnas con los precios de para picar, pollo asado y postres' },
	{ src: cartaGuisos, alt: 'Segunda página de la carta con los guisos y varios y sus precios' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Las Columnas',
	inLanguage: 'es-ES',
	description:
		'Carta tomada de las fotografías que el establecimiento publica en su ficha de Google; los precios pueden cambiar.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#las-columnas`,
	name: BUSINESS.name,
	alternateName: ['Las Columnas Sevilla', 'Las Columnas Comidas para Llevar'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, INSTAGRAM],
	telephone: '+34955952614',
	servesCuisine: ['Comida casera', 'Comida para llevar', 'Pollo asado', 'Andaluza'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '22:00',
		},
	],
	priceRange: '€€',
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"las-columnas-apaisada-05.jpg": fachada,
	"las-columnas-apaisada-01.jpg": vitrina,
	"las-columnas-apaisada-02.jpg": guisos,
	"las-columnas-apaisada-04.jpg": vitrinaDos,
	"las-columnas-vertical-03.jpg": tortilla,
	"las-columnas-vertical-06.jpg": cartaPicar,
	"las-columnas-vertical-07.jpg": cartaGuisos,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Las Columnas Sevilla, comida para llevar Casco Antiguo, pollo asado Sevilla, Conde de Barajas 6, guisos para llevar Sevilla, carta Las Columnas"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado, guisos de cuchara y raciones para llevar en Conde de Barajas, 6. Carta con precios, fotos y horario."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Esquina del local de Las Columnas en el Casco Antiguo de Sevilla"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#23303f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Casco Antiguo de Sevilla"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Las Columnas"
			subtitle="Comida para llevar · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Carta y fotografías de la ficha pública de Google Maps. Confirma precios y disponibilidad con el establecimiento."
			ctaLabel="Llamar a Las Columnas"
			navAriaLabel="Enlaces de Las Columnas"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
