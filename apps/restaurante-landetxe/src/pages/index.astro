---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/restaurante-landetxe-apaisada-01.jpg';
import pulpo from '../assets/fotos/restaurante-landetxe-vertical-02.jpg';
import tarta from '../assets/fotos/restaurante-landetxe-vertical-03.jpg';
import rodaballo from '../assets/fotos/restaurante-landetxe-apaisada-04.jpg';
import rodaballoClams from '../assets/fotos/restaurante-landetxe-apaisada-05.jpg';
import tostas from '../assets/fotos/restaurante-landetxe-apaisada-06.jpg';
import tartaleta from '../assets/fotos/restaurante-landetxe-vertical-07.jpg';
import bogavante from '../assets/fotos/restaurante-landetxe-vertical-08.jpg';
import ensalada from '../assets/fotos/restaurante-landetxe-apaisada-09.jpg';
import rodaballoAjo from '../assets/fotos/restaurante-landetxe-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Landetxe Jatetxea, restaurante y taberna en Mendiburu Kalea, Elizalde (Oiartzun). Pintxos, cocina de taberna y raciones generosas, con 4,5 sobre 5 en Google. Teléfono 666 69 34 66.';

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de Landetxe Jatetxea con barra de madera, ventanales y mesas grises',
	},
	{
		src: pulpo,
		alt: 'Pulpo a la plancha con patatas y puré sobre un plato azul',
	},
	{
		src: tarta,
		alt: 'Tarta de chocolate con nata, flores y crujiente en un plato blanco',
	},
	{
		src: rodaballo,
		alt: 'Rodaballo al horno con almejas, patatas y perejil en una fuente blanca',
	},
	{
		src: rodaballoClams,
		alt: 'Rodaballo con almejas y patatas servido en una fuente blanca',
	},
	{
		src: tostas,
		alt: 'Tostas con salmón, huevo y brotes verdes en Landetxe',
	},
	{
		src: tartaleta,
		alt: 'Tartaleta de marisco con gamba y mejillón sobre un plato azul',
	},
	{
		src: bogavante,
		alt: 'Arroz con bogavante en una cazuela de barro',
	},
	{
		src: ensalada,
		alt: 'Ensalada de tomate con ventresca de atún y pimientos verdes',
	},
	{
		src: rodaballoAjo,
		alt: 'Rodaballo entero con ajo laminado y perejil',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#landetxe`,
	name: BUSINESS.name,
	alternateName: ['Landetxe', 'Landetxe Jatetxea', 'Restaurante Landetxe', 'Landetxeko taberna'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: `+34 ${BUSINESS.phone}`,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina de taberna', 'Pintxos'],
	areaServed: [
		{ '@type': 'City', name: 'Oiartzun' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '09:00',
			closes: '22:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '09:00',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '09:30',
			closes: '22:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La barra', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Landetxe Jatetxea · Taberna y restaurante en Oiartzun';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f4a46" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700&family=Gloock&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Landetxe Jatetxea, Landetxe Oiartzun, restaurante Oiartzun, taberna Elizalde, comer en Oiartzun, pintxos Oiartzun, Mendiburu Kalea, Landetxeko taberna"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Restaurante y taberna en Mendiburu Kalea, Elizalde (Oiartzun). Pintxos, cocina de taberna y raciones generosas, con 4,5 sobre 5 en Google. Teléfono 666 69 34 66."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rodaballo con almejas y patatas de Landetxe Jatetxea"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2f4a46"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Elizalde, Oiartzun"
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Landetxe"
			subtitle="Jatetxea · Oiartzun"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Mendiburu Kalea · Elizalde, Oiartzun"
				title="Landetxeko <br /><em>taberna.</em>"
				lede={`Restaurante Landetxe Jatetxea es un restaurante, bar y taberna en Mendiburu Kalea, en Elizalde (Oiartzun). Cocina de taberna, pintxos y raciones generosas, con 4,5 sobre 5 en Google y 244 reseñas. Abre todos los días: para venir, llama al ${BUSINESS.phone}.`}
				image={comedor}
				imageAlt="Comedor de Landetxe Jatetxea con barra de madera, ventanales y mesas grises"
				primaryCta={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5</b> en Google · 244 reseñas' },
					{ label: 'Horario', html: '<b>Todos los días</b> abierto' },
					{ label: 'La casa', html: '<b>Raciones</b> generosas' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Landetxe Jatetxea" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Taberna, bar <br /><em>y buena mesa.</em>"
				paragraphs={[
					'Restaurante Landetxe Jatetxea está en Mendiburu Kalea, en Elizalde (Oiartzun): un local amplio y luminoso, con barra de madera, ventanales y mesas de madera con sillas grises.',
					'Google lo clasifica como restaurante, bar, cafetería, bar de tapas, bar deportivo y bar con música en directo, y le da 4,5 sobre 5 con 244 reseñas. Su ficha publica teléfono y horario, pero no carta, precios, correo ni web propia.',
					'El propio local lo resume como «Landetxeko taberna». Sus reseñas hablan de un pollo en salsa de cerveza, de un buen servicio «atento y rápido» y de «calidad de productos y raciones generosas».',
					'Las fotos de su perfil muestran pulpo, rodaballo con almejas, arroz con bogavante, tartaleta de marisco, tostas y postres. Abre todos los días.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «Buen servicio, atentos y rápidos. Calidad de productos y raciones generosas».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La barra"
				title="Pintxos <br /><em>y cocina de taberna.</em>"
				description="La ficha de Google no publica carta ni precios y el local no tiene web propia. Esto es lo que citan sus reseñas y la descripción del propio restaurante."
				cta={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados ni carta en la ficha. Para saber qué hay hoy, lo más directo es llamar al 666 69 34 66."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Diez fotos <br /><em>de la casa.</em>"
				description="Las diez fotografías publicadas en el perfil de Landetxe Jatetxea en Google Maps: el comedor y sus platos."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a Oiartzun <br /><em>a la taberna.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, `${BUSINESS.regionName}, España`]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario de la ficha de Google: de lunes a jueves de 9:00 a 22:00; viernes y sábado de 9:00 a 23:30; domingo de 9:30 a 22:00."
				mapTitle="Mapa de Landetxe Jatetxea en Mendiburu Kalea, Elizalde (Oiartzun)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Landetxe Jatetxea · Oiartzun"
				mapHref={MAPS.cid}
				links={[
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref, variant: 'primary' },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="El teléfono 666 69 34 66 es el único canal de contacto que publica la ficha de Google: no hay correo ni web propia. La ficha marca acceso, asientos, aseo y aparcamiento adaptados."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Landetxe"
		/>
	</body>
</html>
