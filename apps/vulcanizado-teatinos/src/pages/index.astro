---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import { business, directionsUrl, mapEmbedUrl, mapsUrl, phoneHref, photoUrl, structuredData } from '../lib/business';
import Galeria from '../components/Galeria.astro';

const title = 'Vulcanizado Teatinos | Taller en Málaga';
const description =
	'Vulcanizado Teatinos, taller de automoción en Málaga. Estamos en la avenida de Carlos Haya, 169. Llama al 646 65 48 37 o consulta cómo llegar en Google Maps.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#123d45" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={photoUrl} />
		<meta property="og:image:alt" content="Fotografía de Vulcanizado Teatinos en su ficha de Google Maps" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={photoUrl} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7256508;-4.4601228" />
		<meta name="ICBM" content="36.7256508, -4.4601228" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Vulcanizado Teatinos, inicio">
				<span class="brand-mark" aria-hidden="true"><span>VT</span><i></i></span>
				<span class="brand-name">Vulcanizado Teatinos <small>Taller · Málaga</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#taller">El taller</a>
				<a href="#ubicacion">Ubicación</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}><span aria-hidden="true">↗</span> 646 65 48 37</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span> Av. de Carlos Haya · Málaga</p>
					<h1 id="hero-title">Vulcanizado<br /><em>Teatinos.</em></h1>
					<p class="hero-lede">
						Taller en Málaga, en la avenida de Carlos Haya. Llámanos para consultar cualquier información
						y localizar el taller antes de venir.
					</p>
					<div class="hero-actions">
						<a class="button button-lime" href={phoneHref}><span aria-hidden="true">↗</span> Llamar al taller</a>
						<a class="button button-border" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="hero-address">
						<span class="address-pin" aria-hidden="true">⌖</span>
						<span><small>ENCUÉNTRANOS EN</small><strong>{business.streetAddress} · {business.city}</strong></span>
					</div>
				</div>

				<figure class="hero-photo">
					<div class="photo-frame">
						<img
							src={photoUrl}
							alt="Fotografía de Vulcanizado Teatinos compartida en su ficha de Google Maps, Málaga"
							width="1200"
							height="900"
							fetchpriority="high"
							decoding="async"
						/>
						<span class="photo-corner photo-corner-tl" aria-hidden="true"></span>
						<span class="photo-corner photo-corner-br" aria-hidden="true"></span>
					</div>
					<figcaption><span>Vulcanizado Teatinos · Málaga</span><a href={mapsUrl} target="_blank" rel="noreferrer">Fotos en Google Maps ↗</a></figcaption>
				</figure>
				<div class="tread tread-hero" aria-hidden="true"></div>
			</section>

			<section class="identity-strip" id="taller" aria-label="Datos del taller">
				<div class="identity-mark" aria-hidden="true">VT<span>.</span></div>
				<p><small>ACTIVIDAD</small><strong>Taller de automoción</strong></p>
				<span class="strip-rule" aria-hidden="true"></span>
				<p><small>DIRECCIÓN</small><strong>{business.streetAddress}</strong></p>
				<span class="strip-rule" aria-hidden="true"></span>
				<p><small>LOCALIDAD</small><strong>{business.city}, España</strong></p>
			</section>

			<section class="location section-pad" id="ubicacion" aria-labelledby="location-title">
				<div class="location-copy">
					<p class="eyebrow dark"><span class="eyebrow-mark" aria-hidden="true"></span> Ven a visitarnos</p>
					<h2 id="location-title">En Carlos Haya,<br /><em>en Teatinos.</em></h2>
					<p class="location-lede">
						Estamos en la avenida de Carlos Haya, 169, Málaga. Para consultar horarios o servicios,
						llámanos antes de desplazarte.
					</p>
					<address>
						<span class="address-icon" aria-hidden="true">⌖</span>
						<span><strong>{business.streetAddress}</strong><small>{business.city}, España</small></span>
					</address>
					<a class="phone-number" href={phoneHref}><small>TELÉFONO</small><strong>646 65 48 37</strong></a>
					<div class="location-actions">
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">
							Abrir indicaciones <span aria-hidden="true">↗</span>
						</a>
						<a class="text-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha y galería ↗</a>
					</div>
					<p class="verification-note">Consulta por teléfono los horarios y servicios disponibles.</p>
				</div>

				<div class="map-shell">
					<div class="map-head"><span><i aria-hidden="true"></i> UBICACIÓN DEL TALLER</span><span>MÁLAGA · ES</span></div>
					<div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<button type="button" data-cargar-mapa aria-label="Cargar mapa interactivo" style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
							<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
							<strong style="font-size:1rem;">Cargar mapa interactivo</strong>
							<small style="opacity:0.65;">Se carga solo al pulsar</small>
						</button>
<iframe
						title="Mapa de Vulcanizado Teatinos en avenida de Carlos Haya, 169, Málaga"
					 data-src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-tag" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Vulcanizado Teatinos</a>
					<div class="tread tread-map" aria-hidden="true"></div>
				</div>
			</section>
			<Galeria nombre="Vulcanizado Teatinos" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio" aria-label="Vulcanizado Teatinos, volver al inicio">
				<span class="brand-mark" aria-hidden="true"><span>VT</span><i></i></span>
				<span class="brand-name">Vulcanizado Teatinos <small>Taller · Málaga</small></span>
			</a>
			<p>{business.streetAddress} · {business.city}</p>
			<a class="footer-phone" href={phoneHref}>646 65 48 37 <span aria-hidden="true">↗</span></a>
			<small>© {new Date().getFullYear()} {business.name}. Información de contacto y ubicación.</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
</footer>

		<a class="mobile-call" href={phoneHref}><span aria-hidden="true">↗</span> Llamar al taller <strong>646 65 48 37</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						<WhatsappFab phone={datos.phoneHref} name={datos.business?.name} />
						</body>
</html>

<script>
// mapa-fachada: la URL del iframe vive en data-src y solo se asigna al pulsar (ahorra ~1MB de JS).
document.addEventListener('click', function (e) {
	var t = e.target && e.target.closest ? e.target.closest('[data-cargar-mapa]') : null;
	if (!t) return;
	var w = t.closest('[data-mapa-fachada]');
	if (!w || w.dataset.cargado) return;
	var f = w.querySelector('iframe');
	if (!f || !f.dataset.src || f.getAttribute('src')) return;
	w.dataset.cargado = '1';
	f.setAttribute('src', f.dataset.src);
	t.remove();
});
</script>
