---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import vitrina from '../assets/fotos/panificadora-la-catalana-1890-vertical-01.jpg';
import interior from '../assets/fotos/panificadora-la-catalana-1890-vertical-02.jpg';
import tartas from '../assets/fotos/panificadora-la-catalana-1890-apaisada-03.jpg';
import fachada from '../assets/fotos/panificadora-la-catalana-1890-apaisada-04.jpg';
import mostrador from '../assets/fotos/panificadora-la-catalana-1890-apaisada-05.jpg';
import rotulo from '../assets/fotos/panificadora-la-catalana-1890-apaisada-06.jpg';
import vitrinaDulces from '../assets/fotos/panificadora-la-catalana-1890-apaisada-07.jpg';
import estanteria from '../assets/fotos/panificadora-la-catalana-1890-vertical-08.jpg';
import entrada from '../assets/fotos/panificadora-la-catalana-1890-vertical-09.jpg';
import milhojas from '../assets/fotos/panificadora-la-catalana-1890-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Panificadora La Catalana 1890 · Panadería en Córdoba';
const description =
	'Panificadora La Catalana 1890, panadería y pastelería tradicional en la calle San Pablo, 16 (Centro, 14002 Córdoba). Pan, dulces y pasteles sin lactosa. De lunes a sábado de 8:30 a 14:30.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#la-catalana-1890`,
	name: BUSINESS.name,
	alternateName: ['La Catalana 1890', 'La Catalana', 'Panadería La Catalana Córdoba'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 957 47 25 38',
	currenciesAccepted: 'EUR',
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:30',
			closes: '14:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Buena acogida, bien situado, variedad justa pero buena calidad y precio.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 4, bestRating: 5 },
			reviewBody: 'Panadería tradicional con unos dulces y panes estupendos.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Gran calidad en sus panes y pasteles.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada blanca de La Catalana con el rótulo rojo «Panificadora desde 1890» y el sello de productos sin lactosa',
	},
	{
		src: estanteria,
		alt: 'Estanterías de La Catalana llenas de barras, hogazas y panecillos recién hechos',
	},
	{
		src: vitrina,
		alt: 'Vitrina con magdalenas, donuts, pasteles de chocolate y dulces sobre bandejas doradas',
	},
	{
		src: vitrinaDulces,
		alt: 'Mostrador acristalado con pasteles, tartas, flanes y dulces de crema',
	},
	{
		src: tartas,
		alt: 'Vitrina con tartas planas, empanadas dulces y pasteles grandes en bandejas',
	},
	{
		src: milhojas,
		alt: 'Porciones de pastel de hojaldre y crema sobre una bandeja dorada',
	},
	{
		src: mostrador,
		alt: 'Interior de La Catalana con el mostrador, las vitrinas y una empleada atendiendo',
	},
	{
		src: interior,
		alt: 'Estanterías de pan y rincón de caja del interior de la panadería',
	},
	{
		src: entrada,
		alt: 'Entrada de La Catalana en la calle San Pablo, con una mujer de pie en la puerta',
	},
	{
		src: rotulo,
		alt: 'Rótulo de madera «Panadería La Catalana · Desde 1890 · Pastelería» sobre las estanterías de pan',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#7c261d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..600&family=Jost:wght@400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panificadora La Catalana 1890, La Catalana Córdoba, panadería San Pablo, pastelería Córdoba, pan sin lactosa Córdoba, dulces tradicionales, panadería centenaria"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería y pastelería tradicional en la calle San Pablo, 16. Pan, dulces y pasteles sin lactosa. De lunes a sábado de 8:30 a 14:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo de La Catalana, panificadora desde 1890, en su fachada de Córdoba"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#7c261d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[rotulo]}
			schemas={[bizSchema, faqSchema]}
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Catalana"
			subtitle="Panadería · Desde 1890"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. San Pablo, 16 · Centro, Córdoba"
				title="Panadería y pastelería <br /><em>desde 1890.</em>"
				lede={`Panificadora La Catalana 1890 está en la calle San Pablo, 16, en el Centro de Córdoba. El rótulo de la fachada anuncia «Panificadora desde 1890» y un sello morado asegura que todos sus productos son sin lactosa y sin trazas de lactosa. Dentro hay pan, dulces y pasteles. Abre de lunes a sábado de 8:30 a 14:30. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={rotulo}
				imageAlt="Rótulo de madera de Panadería La Catalana, Desde 1890, Pastelería, sobre las estanterías de pan"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,7</b> en Google · 99 reseñas' },
					{ label: 'Horario', html: '<b>L–S 8:30–14:30</b> · domingo cerrado' },
					{ label: 'Sin lactosa', html: '<b>Todos los productos</b> según la fachada' },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Pan · pastelería · sin lactosa"
			/>

			<LocalChips label="Lo que hay en La Catalana" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una panadería <br /><em>de 1890.</em>"
				paragraphs={[
					'Panificadora La Catalana 1890 está en la calle San Pablo, 16, en el Centro de Córdoba (14002). En la fachada blanca, el rótulo rojo anuncia «La Catalana · Panificadora desde 1890», junto al sello morado que asegura que todos sus productos son sin lactosa y sin trazas de lactosa.',
					'Dentro, el rótulo de madera dice «Panadería La Catalana · Desde 1890 · Pastelería». Las estanterías se llenan de barras, hogazas y panecillos, y las vitrinas de magdalenas, donuts, pasteles de chocolate, tartas y dulces de crema.',
					'La ficha de Google la clasifica como panadería y le da 4,7 sobre 5 con 99 reseñas. Las reseñas hablan de una casa tradicional: «Panadería tradicional con unos dulces y panes estupendos», «Gran calidad en sus panes y pasteles», «Buena acogida, bien situado, variedad justa pero buena calidad y precio».',
					'La ficha publica el teléfono 957 47 25 38, pero no web, correo ni redes. Abre de lunes a sábado, solo por la mañana, y cierra los domingos.',
				]}
				note="La ficha de Google no publica carta ni precios. Esta página solo cuenta lo que muestran las fotos del perfil, lo que dicen los rótulos del local y lo que cuentan las reseñas."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Historia, horno <br />
							<em>y sin lactosa.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que sale <br /><em>del horno.</em>"
				description="Sin carta ni precios publicados: esto es lo que muestran las vitrinas del local y lo que cuentan las reseñas de Google."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU_GROUPS}
				note="La ficha no recoge precios ni métodos de pago, así que esta web no publica importes. El surtido cambia a lo largo de la mañana: la panadería cierra a las 14:30."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La casa, <br /><em>por dentro.</em>"
				description="Diez fotos de la ficha de Google Maps: la fachada, el rótulo interior, las estanterías de pan, las vitrinas de pastelería y la entrada."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En San Pablo, <br /><em>en el Centro.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`,
				]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de Panificadora La Catalana 1890 en la calle San Pablo, 16, Córdoba"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Catalana · San Pablo"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Street View', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="La ficha de Google indica acceso para sillas de ruedas, pero no aparcamiento adaptado; tampoco detalla el mostrador ni el aseo. Los encargos se hablan en el local o por teléfono."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar a La Catalana"
			navAriaLabel="Enlaces de Panificadora La Catalana 1890"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
