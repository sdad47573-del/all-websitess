---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import polloFrito from '../assets/fotos/asador-3-delicias-apaisada-03.jpg';
import polloAsado from '../assets/fotos/asador-3-delicias-cuadrada-01.jpg';
import racionPollo from '../assets/fotos/asador-3-delicias-vertical-05.jpg';
import arroz from '../assets/fotos/asador-3-delicias-apaisada-07.jpg';
import nachos from '../assets/fotos/asador-3-delicias-apaisada-06.jpg';
import hamburguesa from '../assets/fotos/asador-3-delicias-apaisada-09.jpg';
import polloTiras from '../assets/fotos/asador-3-delicias-apaisada-10.jpg';
import lomo from '../assets/fotos/asador-3-delicias-apaisada-04.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const title = 'Asador 3 Delicias · Pollo asado y tapas en Sevilla';
const description = BUSINESS.description;

const galeria = [
	{
		src: arroz,
		alt: 'Arroz 3 delicias emplatado con pimiento rojo y perejil, junto a la tarjeta de Asador 3 Delicias con la dirección y el teléfono',
	},
	{
		src: polloAsado,
		alt: 'Pollo asado entero dorado con ensalada, patatas fritas y salsas, sobre fondo de madera',
	},
	{
		src: racionPollo,
		alt: 'Ración de pollo asado con patatas fritas en un plato de rayas azules y blancas',
	},
	{
		src: nachos,
		alt: 'Plato de nachos con queso fundido, guacamole, pico de gallo y nata agria',
	},
	{
		src: hamburguesa,
		alt: 'Hamburguesa con bacon y queso en pan de sésamo, con patatas fritas alrededor',
	},
	{
		src: polloTiras,
		alt: 'Tiras de pollo frito crujiente con patatas fritas y un cuenco de ketchup',
	},
	{
		src: lomo,
		alt: 'Lomo a la plancha con pimientos, arroz blanco, huevo frito y patatas fritas',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#asador-3-delicias`,
	name: BUSINESS.fullName,
	alternateName: ['Asador Tres Delicias', 'Asador 3 Delicias Sevilla', 'Pollo asado López de Gómara'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Asador', 'Pollo frito', 'Tapas', 'Comida para llevar'],
	areaServed: [
		{ '@type': 'City', name: 'Sevilla' },
		{ '@type': 'AdministrativeArea', name: 'López de Gómara' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	hasMenu: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	acceptsReservations: false,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Monday', opens: '12:30', closes: '17:00' },
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday'],
			opens: '12:30',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday'],
			opens: '20:00',
			closes: '23:00',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '12:30', closes: '16:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '20:00', closes: '23:45' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '12:30', closes: '23:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '12:30', closes: '23:00' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1a1416" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Karla:wght@300..700&family=Marcellus&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Asador 3 Delicias, pollo asado Sevilla, pollo frito crujiente, asador López de Gómara, tapas Sevilla, serranitos, hamburguesas Sevilla, comida para llevar Sevilla"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado, pollo frito crujiente, tapas, serranitos y hamburguesas en López de Gómara 9, Sevilla. De lunes a domingo, martes cerrado. 4,4 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Pollo frito crujiente con patatas fritas de Asador 3 Delicias"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#1a1416"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="López de Gómara, Sevilla"
			preload={[polloFrito]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Asador 3 Delicias"
			subtitle="Pollos y tapas · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Pollo asado <br /><em>y mucho más.</em>"
				lede="En López de Gómara 9, un asador de elaboración propia: pollo asado, pollo frito crujiente, tapas, serranitos, hamburguesas, arroces y platos de la casa. Abre de lunes a domingo —los martes cierra— y la ficha de Google le da 4,4 sobre 5 con 89 reseñas."
				image={polloFrito}
				imageAlt="Pollo frito crujiente con patatas y patatas panadera en un plato de rayas azules"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4</b> en Google · 89 reseñas' },
					{ label: 'Horario', html: '<b>12:30–16:30</b><br />Y 20:00–23:00, de miércoles a viernes' },
					{ label: 'Teléfono', html: `<b>640 15 55 90</b> encargos y consultas` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Asador 3 Delicias" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="El asador <br /><em>de la esquina.</em>"
				paragraphs={[
					'Asador 3 Delicias está en la calle López de Gómara 9, con el mostrador de comida para llevar a un lado y la mesa al otro. La ficha de Google lo clasifica como restaurante especializado en pollo y lo describe como una empresa de elaboración propia con productos de primera calidad.',
					'La casa anuncia pollo asado, pollo frito crujiente, tapas variadas, hamburguesas, serranitos, postres y bebidas. En las fotos del perfil aparecen el pollo asado entero con ensalada y patatas, la ración de pollo con patatas, el arroz 3 delicias, el lomo a la plancha con arroz y huevo, los nachos y las hamburguesas con bacon y queso.',
					'Las reseñas repiten el pollo con patatas y el trato: «todo buenísimo, bien presentado y la atención buenísima, volveré»; «riquísimo el pollo con patatas que compramos pero sobre todo muy buena atención»; «pedimos también pollo, serranito, berenjena, platos grandes». El balance de Google es 4,4 sobre 5 con 89 reseñas.',
					'Hay servicio de mesa y también comida para llevar: el propio local anuncia «comidas para llevar» y ofertas para recoger. Abre de lunes a domingo, con el martes cerrado, y de miércoles a viernes tiene dos turnos, mediodía y noche.',
				]}
				note="La información sale de la ficha pública de Google Maps, de la descripción del propio negocio y de las fotos de su perfil. No hay web oficial ni carta con precios publicada: confirma platos, precios y disponibilidad por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver la casa en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Pollo, tapas <br /><em>y arroces.</em>"
				description="La ficha no publica carta con precios. Esta lista recoge lo que anuncia la propia casa y lo que aparece en las fotos del perfil: pollo asado y frito, arroces, hamburguesas y tapas."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="No hay carta oficial publicada ni precios del local, así que esta lista es orientativa: sirve para reconocer lo que se cocina aquí, no para cerrar una cuenta. Para saber qué hay ese día y cuánto cuesta, llama al asador."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La mesa <br /><em>completa.</em>"
				description="Las fotografías del perfil de Asador 3 Delicias: el arroz con su tarjeta, el pollo asado, la ración con patatas, los nachos, la hamburguesa, el pollo frito y el lomo a la plancha."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a <br /><em>López de Gómara.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Sevilla, España',
				]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: martes cerrado; miércoles y jueves con dos turnos, de 12:30 a 16:30 y de 20:00 a 23:00; viernes hasta las 23:45; sábado y domingo continuo; lunes de 12:30 a 17:00. En festivos puede cambiar."
				mapTitle="Mapa de Asador 3 Delicias en la calle López de Gómara 9, Sevilla"
				mapEmbedUrl={MAPS.embed}
				mapLabel="López de Gómara, 9 · Sevilla"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. Para encargar un pollo, una bandeja o una mesa para un grupo, llama al teléfono del asador: es el canal directo."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Asador 3 Delicias"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
