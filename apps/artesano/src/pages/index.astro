---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import encargo from '../assets/fotos/artesano-cuadrada-01.jpg';
import platos from '../assets/fotos/artesano-cuadrada-02.jpg';
import delicias from '../assets/fotos/artesano-cuadrada-04.jpg';
import pollos from '../assets/fotos/artesano-cuadrada-05.jpg';
import postres from '../assets/fotos/artesano-cuadrada-07.jpg';
import logo from '../assets/fotos/artesano-apaisada-06.jpg';
import cartaCompleta from '../assets/fotos/artesano-vertical-03.jpg';

import { BUSINESS, FAQ, HORARIO, HORARIO_AVISO, MAPS, RESENAS, SERVICIOS } from '../data/site';

const title = 'Artesano · Pollos asados y comida para llevar en Miguelturra';
const description = BUSINESS.description;

const galeria = [
	{
		src: pollos,
		alt: 'Cartel de azulejo de Artesano con los pollos asados: medio pollo, pollo entero, pollo con patatas y el combo con pan y dos postres',
	},
	{
		src: platos,
		alt: 'Cartel de azulejo con los platos principales: lasaña, pisto, asadillo, ensaladilla, patatas alioli, albóndigas, magro con tomate y pollo al ajillo',
	},
	{
		src: delicias,
		alt: 'Cartel de azulejo de las delicias: cachopo, cachopin, milanesa, pollo crujiente casero, empanada de pisto, empanada de atún y croquetas',
	},
	{
		src: postres,
		alt: 'Cartel de azulejo de los postres: flan, arroz con leche, natillas y tarta de queso',
	},
	{
		src: encargo,
		alt: 'Cartel de azulejo de la comida por encargo: paellas y fideuá, costillares, pierna, codillo, gachas, migas, tortilla de patatas y tarta de queso',
	},
	{
		src: cartaCompleta,
		alt: 'Carta completa de Artesano en un solo cartel, con todos los precios y el teléfono 660 18 20 21',
	},
	{
		src: logo,
		alt: 'Logotipo de Artesano: un molino manchego sobre un pollo asado en su fuente',
	},
];

const carta = [
	{
		title: 'Pollos asados',
		items: [
			{ name: 'Medio pollo', note: 'para uno o para picar', price: '6 €' },
			{ name: 'Pollo asado', note: 'entero, recién sacado del asador', price: '10 €' },
			{ name: 'Pollo + patatas', note: 'el clásico de domingo', price: '11,50 €' },
			{
				name: 'Combo',
				note: 'pollo + patatas + pan + 2 postres (no incluye tarta de queso)',
				price: '14,50 €',
			},
			{ name: 'Extra patatas o pimientos', note: 'para completar la bandeja', price: '1,50 €' },
		],
	},
	{
		title: 'Platos principales',
		items: [
			{ name: 'Lasaña', note: 'por ración', price: '5 €' },
			{ name: 'Pisto', note: 'de la casa', price: '3,90 €' },
			{ name: 'Asadillo', note: 'pimiento asado, tomate y comino', price: '4,90 €' },
			{ name: 'Ensaladilla', note: 'para llevar en fiambrera', price: '5 €' },
			{ name: 'Patatas alioli', note: 'con su salsa', price: '4 €' },
			{ name: 'Albóndigas', note: 'en salsa', price: '7 €' },
			{ name: 'Magro con tomate', note: 'guiso de cuchara', price: '7 €' },
			{ name: 'Pollo al ajillo', note: 'en su aceite', price: '7 €' },
		],
	},
	{
		title: 'Delicias',
		items: [
			{ name: 'Cachopo', note: 'el grande, para compartir', price: '11 €' },
			{ name: 'Cachopín', note: 'la versión pequeña', price: '6 €' },
			{ name: 'Milanesa', note: 'empanada y frita', price: '5 €' },
			{ name: 'Pollo crujiente casero', note: 'rebozado de la casa', price: '6,50 €' },
			{ name: 'Empanada de pisto', note: 'por ración', price: '4,50 €' },
			{ name: 'Empanada de atún', note: 'por ración', price: '5 €' },
			{
				name: 'Croquetas',
				note: 'media de 4 unidades · entera de 8 unidades',
				price: '3,50 € / 6 €',
			},
		],
	},
	{
		title: 'Postres',
		items: [
			{ name: 'Flan, arroz con leche o natillas', note: 'caseros', price: '2 €' },
			{ name: 'Tarta de queso', note: 'la que destaca una de las reseñas', price: '3 €' },
		],
	},
	{
		title: 'Comida por encargo',
		items: [
			{
				name: 'Paellas y fideuá',
				note: 'mixta, negra o de verduras · 6 raciones 35 € · 10 raciones 50 €',
				price: '35 € / 50 €',
			},
			{
				name: 'Marisco, secreto y setas',
				note: '6 raciones 40 € · 10 raciones 55 €',
				price: '40 € / 55 €',
			},
			{
				name: 'Costillares',
				note: 'BBQ, miel mostaza o tradicional',
				price: '16 €',
			},
			{ name: 'Pierna', note: 'asada, para encargar', price: '22 €' },
			{ name: 'Codillo', note: 'asado', price: '12 €' },
			{ name: 'Gachas', note: 'mínimo 2 raciones', price: '3,50 €' },
			{ name: 'Migas', note: 'mínimo 4 raciones', price: '4,50 €' },
			{ name: 'Tortilla de patatas', note: 'entera', price: '12 €' },
			{ name: 'Tarta de queso', note: 'clásica 25 € · especial 30 €', price: '25 € / 30 €' },
			{ name: 'Pan', note: 'por unidad', price: '1 €' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#artesano`,
	name: BUSINESS.name,
	alternateName: [
		'Artesano Miguelturra',
		'Artesano Ciudad Real',
		'Artesano pollos asados',
		'Pollos asados Artesano',
	],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Asador de pollos', 'Comida para llevar', 'Comida casera'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Miguelturra, Ciudad Real' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '15:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0e2a4d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,700&family=Nunito+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Artesano Miguelturra, pollos asados Miguelturra, comida para llevar Miguelturra, asador de pollos Ciudad Real, comida casera para llevar 13170, tarta de queso Artesano, paellas por encargo Miguelturra, Don José Mora 7, comida para llevar Ciudad Real"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollos asados y comida para llevar en la calle Don José Mora, 7, Miguelturra. Pollo con patatas, cachopo, croquetas caseras, tarta de queso y paellas por encargo. De 12:00 a 15:30; martes cerrado. Pedidos en el 660 18 20 21."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Artesano, pollos asados y comida para llevar en Miguelturra, Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#0e2a4d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CR"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Miguelturra, Ciudad Real"
			preload={[pollos]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Artesano"
			subtitle="Pollos asados · Miguelturra"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city} · Ciudad Real`}
				title="Pollos asados <br /><em>y comida para llevar.</em>"
				lede="Artesano está en la calle Don José Mora, 7, en Miguelturra, y se presenta así en su ficha de Google: «Restaurante de comida para llevar», «Asador de pollos y comida para llevar». Abre de 12:00 a 15:30 con el martes cerrado, y los encargos se hacen en el 660 18 20 21. Tiene 4,9 sobre 5 con 28 reseñas."
				image={pollos}
				imageAlt="Cartel de azulejo de Artesano con los pollos asados: medio pollo, pollo entero, pollo con patatas y el combo familiar"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,9</b> en Google · 28 reseñas' },
					{ label: 'Horario', html: '<b>12:00–15:30</b><br />Martes cerrado · solo mediodía' },
					{ label: 'Pedidos', html: `<b>${BUSINESS.phone}</b> para llevar y por encargo` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Artesano" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="El molino <br /><em>y el asador.</em>"
				paragraphs={[
					'El local está en la calle Don José Mora, 7, en Miguelturra, a un paso de Ciudad Real. La ficha de Google lo clasifica como restaurante de comida para llevar y como asador de pollos y comida para llevar, y el cartel del propio negocio lo deja claro: «Artesano. Pollos asados y comida para llevar», con un molino manchego y un pollo en su fuente.',
					'La carta está pintada en azulejos azules y blancos, como las cocinas de siempre: pollos asados por medio o enteros, pollo con patatas, platos de cuchara como el magro con tomate o las albóndigas, fritos y empanadas, y postres caseros. El combo de pollo, patatas, pan y dos postres sale a 14,50 €.',
					'Aquí no hay mesa: se pide en el mostrador o por teléfono y se recoge. El horario es de mediodía, de 12:00 a 15:30, y descansa el martes. Para días señalados, el cartel anuncia comida por encargo: paellas y fideuá, costillares, pierna, codillo, gachas, migas y tortilla de patatas entera.',
					'Las 28 reseñas de la ficha le dan 4,9 sobre 5. Google destaca tres, todas de cinco estrellas: «Uno de los mejores sitios de comida casera para llevar que he probado», «volveremos a repetir» y un elogio concreto a la tarta de queso, «casera y bien cremosa».',
				]}
				note="La ficha de Google no publica carta completa ni web propia. Los platos y los precios de esta página son los de los carteles de azulejo del propio local que aparecen en su perfil de Google Maps: pueden cambiar, así que se confirman en el mostrador o en el 660 18 20 21."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Pollo asado, <br /><em>cuchara y fritos.</em>"
				description="La carta es la de los azulejos del local: pollos asados, platos de siempre, fritos y empanadas, postres caseros y lo que se encarga por adelantado."
				cta={{ label: 'Ver la carta en Google Maps', href: MAPS.place }}
				groups={carta}
				note="Precios copiados de los carteles de azulejo del establecimiento que aparecen en su perfil de Google Maps. No hay carta con precios en la ficha. Los platos del día y la disponibilidad se confirman en el mostrador o en el 660 18 20 21."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
					<div class="reviews-head">
						<h2 id="resenas-title">Volver <br /><em>a repetir.</em></h2>
						<p>
							La ficha tiene 28 reseñas y una media de 4,9, una de las más altas del asador al que
							pertenece. Estas son tres de las que Google destaca, con la puntuación de su autor.
						</p>
					</div>
					<div class="review-grid">
						{
							RESENAS.map((review) => (
								<figure class="review-card">
									<p class="review-stars" aria-label={`${review.rating} sobre 5`}>
										{'★'.repeat(review.rating)}
										<span aria-hidden="true">{'★'.repeat(5 - review.rating)}</span>
									</p>
									<blockquote>{review.quote}</blockquote>
									<figcaption>Reseña publicada en Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="review-note">
						Citas de las reseñas públicas del local, con la puntuación del autor. En la ficha de Google
						están todas, incluidas las que puntúan por debajo.
					</p>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La carta, <br /><em>en azulejo.</em>"
				description="Los carteles del local, tal y como están colgados en el perfil de Google: los pollos asados, los platos principales, las delicias, los postres, la comida por encargo y la carta completa con el teléfono."
				images={galeria}
				cta={{ label: 'Ver todas en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="A la hora <br /><em>del almuerzo.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Ciudad Real · España']}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de Artesano en la calle Don José Mora, 7, Miguelturra"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Artesano"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Pedidos: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="Se pide en el mostrador o por teléfono y se recoge: es comida para llevar, no hay reserva de mesas. Para paellas, costillares, pierna o codillo conviene encargarlos con antelación en el 660 18 20 21. Esta página no tramita pedidos ni cobros."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>encargar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Artesano"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos, horario, precios y fotografías tomados de la ficha y del perfil públicos del local en Google Maps, consultados en noviembre de 2026. Los precios son los de los carteles del propio establecimiento y pueden cambiar."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Artesano"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
