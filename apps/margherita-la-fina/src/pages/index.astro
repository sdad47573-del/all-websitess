---
import '../styles/global.css';
import { BUSINESS, MAPS, RATING } from '../data/site';
import foto from '../assets/fotos/margherita-la-fina-01.jpg';

const title = `${BUSINESS.name} · ${BUSINESS.city}`;
const description = BUSINESS.description;
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Restaurant",
	"@id": "https://margherita-la-fina.vercel.app/#negocio",
	"name": "Margherita La Fina",
	"url": "https://margherita-la-fina.vercel.app/",
	"description": "Margherita La Fina, pizzería en Uribarri Kalea, 23 (Uribarri, 48007 Bilbao, Bizkaia). Según su ficha de Google Maps, pizzería.",
	"image": "https://margherita-la-fina.vercel.app/og.jpg",
	"telephone": "+34946420316",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 43.2679211,
		"longitude": -2.921916
	},
	"hasMap": "https://www.google.com/maps/place/Margherita+La+Fina/@43.2679211,-2.921916,17z/data=!3m1!4b1!4m6!3m5!1s0xd4e4fc6b280c07d:0x337d4f0974e590a!8m2!3d43.2679211!4d-2.921916!16s%2Fg%2F11c6vj34yg?authuser=0&hl=es&entry=ttu",
	"servesCuisine": [
		"Italiana"
	]
}
</script>
</head>
	<body>
		<header class="site-header">
			<h1 set:html={piezas.portada.titulo} />
			<p>{BUSINESS.tagline}</p>
		</header>
		<main>
			<img src={foto.src} width={foto.width} height={foto.height} alt={`Foto de ${BUSINESS.name}`} />
			<section>
				<h2>Dirección</h2>
				<p>{BUSINESS.street}, {BUSINESS.postalCode} {BUSINESS.city}</p>
				<p>Teléfono: <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a></p>
				<p>Valoración en Google Maps: {RATING.label}</p>
				<p><a href={MAPS.place} target="_blank" rel="noreferrer">Ver en Google Maps</a> · <a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar</a></p>
			</section>
		</main>
		<footer class="site-footer">
			<p>© {new Date().getFullYear()} {BUSINESS.fullName}</p>
			<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> · sur-digital.vercel.app</small>
		</footer>
	</body>
</html>
