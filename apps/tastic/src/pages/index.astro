---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import mostrador from '../assets/fotos/tastic-apaisada-01.jpg';
import pizzaMixta from '../assets/fotos/tastic-apaisada-04.jpg';
import interior from '../assets/fotos/tastic-apaisada-06.jpg';
import barra from '../assets/fotos/tastic-apaisada-07.jpg';
import vitrina from '../assets/fotos/tastic-apaisada-10.jpg';
import pizzaBurrata from '../assets/fotos/tastic-panoramica-03.jpg';
import pizzaVerdura from '../assets/fotos/tastic-vertical-02.jpg';
import mesa from '../assets/fotos/tastic-vertical-05.jpg';
import pizzaCarne from '../assets/fotos/tastic-vertical-08.jpg';
import empanadas from '../assets/fotos/tastic-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Tastic · Hot Pizza & Hot Stuff en Andorra la Vella';
const description =
	'Tastic (Hot Pizza & Hot Stuff), en el Carrer Dr. Vilanova, 13, de Andorra la Vella (AD500). Pizza al corte, empanadas, burgers, burritos y menús de desayuno. 4,2 sobre 5 con 149 reseñas. De 8:00 a 20:00 de lunes a viernes; sábado de 9:00 a 16:00 y domingo cerrado. Teléfono +376 845 578.';

const galeria = [
	{
		src: mostrador,
		alt: 'El mostrador de Tastic con las pizarras de precios de empanadas, burgers, burritos, pizza y cafés, y las vitrinas de bollería',
	},
	{
		src: barra,
		alt: 'La barra de Tastic con el toldo rojo, el cartel de Hot Pizza Hot Stuff y la pizarra de menús, junto a las cajas de A emportar',
	},
	{
		src: interior,
		alt: 'El interior del local con el jardín vertical, las mesas altas de madera, las sillas negras y el cartel de All you need today is coffee',
	},
	{
		src: pizzaMixta,
		alt: 'Una pizza mitad y mitad en su caja: una parte con queso azul y aceitunas negras y otra con pimiento, cebolla y carne',
	},
	{
		src: pizzaBurrata,
		alt: 'Una pizza con burrata, tomate cherry, rúcula y frutos secos, con el logotipo de Tastic sobre la imagen',
	},
	{
		src: pizzaCarne,
		alt: 'Detalle de una pizza con pepperoni, jamón cocido y carne picada sobre base de queso fundido',
	},
	{
		src: pizzaVerdura,
		alt: 'Una pizza con rodajas de calabacín, tiras de pimiento rojo y corazones de alcachofa',
	},
	{
		src: empanadas,
		alt: 'Dos empanadas de hojaldre dorado en un plato blanco',
	},
	{
		src: mesa,
		alt: 'Una mesa con porciones de pizza, medio bocadillo, una bebida y un café con hielo, con salseras al lado',
	},
	{
		src: vitrina,
		alt: 'La vitrina de bollería con croissants, napolitanas de chocolate, donuts y otras piezas recién horneadas',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Tastic',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#tastic`,
	name: BUSINESS.fullName,
	alternateName: ['Tastic', 'Tastic Andorra', 'Tastic Hot Pizza', 'Hot Pizza & Hot Stuff'],
	description:
		'Pizzería de pizza al corte, empanadas, burgers, burritos y desayunos en el Carrer Dr. Vilanova, 13, del centro de Andorra la Vella.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376845578',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pizza', 'Empanadas', 'Comida rápida', 'Desayunos'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:00',
			closes: '20:00',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '16:00' },
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"tastic-apaisada-01.jpg": mostrador,
	"tastic-apaisada-07.jpg": barra,
	"tastic-apaisada-06.jpg": interior,
	"tastic-apaisada-04.jpg": pizzaMixta,
	"tastic-panoramica-03.jpg": pizzaBurrata,
	"tastic-vertical-08.jpg": pizzaCarne,
	"tastic-vertical-02.jpg": pizzaVerdura,
	"tastic-vertical-09.jpg": empanadas,
	"tastic-vertical-05.jpg": mesa,
	"tastic-apaisada-10.jpg": vitrina,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#211a16" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Space+Grotesk:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Tastic Andorra, pizza al corte Andorra la Vella, Hot Pizza Hot Stuff, empanadas Andorra, burger Andorra la Vella, burritos Andorra, desayuno Andorra la Vella, Dr. Vilanova 13"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pizza al corte, empanadas, burgers y desayunos en el Carrer Dr. Vilanova, 13, Andorra la Vella. 4,2 sobre 5 con 149 reseñas. De 8:00 a 20:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="El mostrador de Tastic con las pizarras de precios y las vitrinas de bollería"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#211a16"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="AD-07"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.city}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[mostrador]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Tastic"
			subtitle="Hot pizza · Andorra la Vella"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Tastic"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario, valoración, carta y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Los precios son los de las pizarras del local: confírmalos por teléfono."
			ctaLabel="Llamar a Tastic"
			navAriaLabel="Enlaces de Tastic (Hot Pizza & Hot Stuff)"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
