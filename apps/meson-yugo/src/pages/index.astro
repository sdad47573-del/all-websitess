---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/meson-yugo-apaisada-01.jpg';
import carne from '../assets/fotos/meson-yugo-vertical-02.jpg';
import ensalada from '../assets/fotos/meson-yugo-vertical-03.jpg';
import arroz from '../assets/fotos/meson-yugo-vertical-04.jpg';
import sopa from '../assets/fotos/meson-yugo-vertical-05.jpg';
import comedor from '../assets/fotos/meson-yugo-apaisada-06.jpg';
import postre from '../assets/fotos/meson-yugo-vertical-07.jpg';
import calle from '../assets/fotos/meson-yugo-apaisada-08.jpg';
import plancha from '../assets/fotos/meson-yugo-vertical-09.jpg';
import lomo from '../assets/fotos/meson-yugo-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Mesón Yugo, cocina casera en la calle Santa María, 13, de Plasencia (Cáceres). Menú del día, raciones y platos de cuchara. Comidas de 13:00 a 15:15. Tel. 927 41 95 04.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de Mesón Yugo en la calle Santa María, 13, de noche, con el rótulo sobre la pizarra de la entrada',
	},
	{
		src: arroz,
		alt: 'Arroz con marisco en cazuela de barro servido en Mesón Yugo',
	},
	{
		src: carne,
		alt: 'Carne en salsa con patatas paja en un plato de Mesón Yugo',
	},
	{
		src: lomo,
		alt: 'Lomo a la plancha con patatas fritas en Mesón Yugo',
	},
	{
		src: comedor,
		alt: 'Comedor de Mesón Yugo con manteles azules, sillas de madera y estantería de vinos',
	},
	{
		src: ensalada,
		alt: 'Ensalada de patata, tomate, atún, aceitunas y huevo en Mesón Yugo',
	},
	{
		src: postre,
		alt: 'Porción de tarta de crema con capas de chocolate en Mesón Yugo',
	},
	{
		src: calle,
		alt: 'Calle Santa María de Plasencia, con la entrada de Mesón Yugo a la derecha y el rótulo iluminado',
	},
	{
		src: sopa,
		alt: 'Cuenco de barro con sopa de tomate y verduras picadas en Mesón Yugo',
	},
	{
		src: plancha,
		alt: 'Carne a la plancha con patatas fritas servida en Mesón Yugo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#meson-yugo`,
	name: BUSINESS.name,
	alternateName: ['Mesón Yugo Plasencia', 'Meson Yugo', 'Mesón Yugo Cáceres'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 927 41 95 04',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Mediterránea', 'Casera'],
	areaServed: [
		{ '@type': 'City', name: 'Plasencia' },
		{ '@type': 'AdministrativeArea', name: 'Cáceres' },
		{ '@type': 'AdministrativeArea', name: 'Extremadura' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday'],
			opens: '13:00',
			closes: '15:15',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '15:15',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '23:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Comida casera con menú del día los sábados muy rica y variada.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Un buen sitio para comer bien, con raciones generosas, y a buen precio.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Elegimos ensaladilla rusa, paella y judías de primero.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Mesón Yugo · Cocina casera en Plasencia';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#3d4a4f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Mesón Yugo Plasencia, comer en Plasencia, cocina casera Plasencia, menú del día Plasencia, restaurante calle Santa María Plasencia, paella Plasencia, judías Plasencia, restaurante centro Plasencia"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Mesón Yugo · Cocina casera en Plasencia"
			ogDescription="Menú del día, raciones y platos de cuchara en la calle Santa María, 13 (Plasencia). Comidas de 13:00 a 15:15 y cenas de jueves a domingo. Tel. 927 41 95 04."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Arroz con marisco en cazuela de barro de Mesón Yugo, en Plasencia"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#3d4a4f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-EX"
			postalCode={BUSINESS.postalCode}
			phone="+34927419504"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[arroz]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Mesón Yugo"
			subtitle="Cocina casera · Plasencia"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Calle Santa María, 13 · Plasencia"
				title="Comida casera<br /><em>en el mesón.</em>"
				lede={`Mesón Yugo es un restaurante de cocina española y mediterránea en la calle Santa María, 13, de Plasencia (Cáceres). Menú del día, raciones y platos de cuchara en un comedor con manteles azules y sillas de madera. Come todos los días de 13:00 a 15:15 y cena de jueves a domingo, de 20:00 a 23:30. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={arroz}
				imageAlt="Arroz con marisco en cazuela de barro servido en Mesón Yugo"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)`,
					},
					{ label: 'Comidas', html: 'Todos los días · 13:00–15:15' },
					{ label: 'Cenas', html: 'Jueves a domingo · 20:00–23:30' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Mesón Yugo" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un mesón<br /><em>de siempre.</em>"
				paragraphs={[
					'Mesón Yugo está en la calle Santa María, 13, de Plasencia (Cáceres), en una calle estrecha de pavimento de piedra. La fachada es de pizarra, con el rótulo «MESÓN YUGO» en blanco sobre negro y una puerta abierta a un zaguán de ladrillo.',
					'Dentro, el comedor es sencillo y luminoso: manteles azules, sillas de madera, una estantería de botellas, paredes de color y un pilar de piedra. Hay mesas grandes para grupos y mesas pequeñas, con servicio de mesa y pan.',
					'Google lo clasifica como restaurante de cocina española y restaurante mediterráneo. Su ficha reúne 236 reseñas y una nota media de 4,3 sobre 5.',
					'Sus reseñas hablan de comida casera «rica y variada», de raciones generosas y de buen precio, y citan el menú del día de los sábados, la ensaladilla rusa, la paella y las judías de primero.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «un buen sitio para comer bien, con raciones generosas, y a buen precio».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="De cuchara<br /><em>y de mesa.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que nombran sus reseñas y lo que aparece en las fotos de su perfil."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="El menú del día cambia cada jornada y el precio no está publicado en la ficha. Llama al 927 41 95 04 para saber qué hay hoy y si queda mesa."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La calle, la mesa<br /><em>y el arroz.</em>"
				description="Estas fotografías proceden del perfil de Mesón Yugo en Google Maps: la fachada de pizarra en la calle Santa María, el comedor de manteles azules, el arroz en cazuela de barro, la carne en salsa y los postres de la casa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Nos vemos<br /><em>a la mesa.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: comidas de 13:00 a 15:15 todos los días; cenas de 20:00 a 23:30 de jueves a domingo. Para grupos conviene llamar antes."
				mapTitle="Mapa de Mesón Yugo en la calle Santa María, 13, Plasencia (Cáceres)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Mesón Yugo · Plasencia"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva llamando al 927 41 95 04. La ficha de Google no marca servicios de accesibilidad, así que si necesitas acceso adaptado conviene preguntar por teléfono antes de ir."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Mesón Yugo"
		/>
	</body>
</html>
