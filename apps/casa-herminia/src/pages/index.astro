---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import terraza from '../assets/fotos/casa-herminia-apaisada-01.jpg';
import carajillo from '../assets/fotos/casa-herminia-vertical-04.jpg';
import almuerzo from '../assets/fotos/casa-herminia-vertical-06.jpg';
import llom from '../assets/fotos/casa-herminia-apaisada-08.jpg';
import longaniza from '../assets/fotos/casa-herminia-vertical-10.jpg';
import barra from '../assets/fotos/casa-herminia-apaisada-09.jpg';
import cartel from '../assets/fotos/casa-herminia-vertical-07.jpg';

import { cidUrl, mapsUrl, placeId, reviewsUrl } from '../maps';

const business = {
	name: 'Restaurant - Bar Casa Herminia',
	brand: 'Casa Herminia',
	street: 'Carrer Vilafamés, 4',
	city: 'La Pobla Tornesa',
	region: 'Castelló',
	postalCode: '12191',
	phone: '964 33 81 25',
	latitude: 40.102729,
	longitude: -0.0018279,
	rating: 4.5,
	reviewsCount: 983,
	site: 'https://casa-herminia.vercel.app',
};

const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34964338125';

const description =
	"Casa Herminia, bar de almuerzos en La Pobla Tornesa: bocadillos, platos de huevos y embutido, olivas y el carajillo palmero de la casa.";

const servicios = [
	'Almuerzos',
	'Bocadillos',
	'Plato de almuerzo',
	'Carajillo palmero',
	'Terraza',
	'Bar de pueblo',
	'Café y tapas',
	'Reservas por teléfono',
];

const grupos = [
	{
		title: 'El almuerzo',
		items: [
			{
				name: 'Plato de almuerzo',
				note: 'huevos fritos, embutido, tomate, patatas y pan de pueblo',
			},
			{
				name: 'Olivas y encurtidos',
				note: 'el plato que se pone en la mesa antes que nada',
			},
			{
				name: 'Cacahuetes',
				note: 'tostados, para picar mientras llega el bocadillo',
			},
			{
				name: 'Pan de pueblo',
				note: 'en cesta de papel, recién cortado',
			},
		],
	},
	{
		title: 'Bocadillos',
		items: [
			{
				name: 'Bocadillo de llom',
				note: 'con pimiento rojo asado, en pan de bocadillo',
			},
			{
				name: 'Bocadillo de longaniza',
				note: 'con huevo, de los que se piden a media mañana',
			},
			{
				name: 'Pinchos de tortilla',
				note: '«pedimos 2 pinchos de tortilla y 2 cafés», cuenta una reseña',
			},
		],
	},
	{
		title: 'El carajillo',
		items: [
			{
				name: 'Carajillo palmero',
				note: 'según el cartel de la casa, es original de este bar y se sirve en vaso de caña',
			},
			{
				name: 'Café solo y cortado',
				note: 'de máquina, a cualquier hora de la mañana',
			},
		],
	},
	{
		title: 'De la barra',
		items: [
			{
				name: 'Cerveza bien fría',
				note: 'de botella y de barril, con el almuerzo',
			},
			{
				name: 'Refrescos',
				note: 'en botella, para la terraza',
			},
		],
	},
];

const galeria = [
	{
		src: carajillo,
		alt: 'Carajillo palmero en vaso de caña de Casa Herminia, en La Pobla Tornesa',
	},
	{
		src: almuerzo,
		alt: 'Plato de almuerzo con huevo frito, embutido, tomate y patatas de Casa Herminia',
	},
	{
		src: llom,
		alt: 'Bocadillo de llom con pimiento de Casa Herminia',
	},
	{
		src: longaniza,
		alt: 'Bocadillo de longaniza con huevo y cerveza en Casa Herminia',
	},
	{
		src: barra,
		alt: 'Platos de olivas y cacahuetes en la mesa de Casa Herminia',
	},
	{
		src: cartel,
		alt: 'Cartel del carajillo palmero original de Casa Herminia, creado en 1998',
	},
];

const faqs = [
	{
		q: '¿Dónde está Casa Herminia?',
		a: 'En el número 4 de la calle Vilafamés, en La Pobla Tornesa (12191), en la carretera que sube hacia Vilafamés. Es un bar de fachada de piedra con el toldo azul de «CASA HERMINIA» y una terraza a la sombra de la morera, con mesas y sillas blancas. El botón «Cómo llegar» abre la ruta exacta en Google Maps.',
	},
	{
		q: '¿Qué horario tiene?',
		a: 'Abre solo por las mañanas: de lunes a viernes de 7:00 a 15:30 y el sábado de 7:00 a 13:30. Los domingos cierra. No hay servicio de cena ni de tarde-noche, así que el almuerzo y la comida se hacen antes de las 15:30. En fiestas del pueblo y en verano el horario cambia: llama antes al 964 33 81 25.',
	},
	{
		q: '¿Qué es el carajillo palmero?',
		a: 'Es el carajillo de la casa, servido en vaso de caña. Según el cartel que hay en el local, el palmero es original de este bar, se inventó en Casa Herminia en 1998 y desde entonces se sirve así. Las reseñas lo citan con nombre propio: «excelente carajillo palmero».',
	},
	{
		q: '¿Qué es un almuerzo?',
		a: 'El almuerzo es la comida de media mañana típica de la provincia: un plato con huevos fritos, embutido, tomate y patatas, pan de pueblo y bebida, o un bocadillo con lo mismo dentro. En Casa Herminia se sirve desde primera hora, con olivas y cacahuetes en la mesa, y las reseñas lo describen como «típico bar de almuerzos».',
	},
	{
		q: '¿Hay carta y precios?',
		a: 'La ficha de Google no publica carta ni precios, y esta web no inventa importes: los platos que aparecen aquí son los de sus propias fotos y los que citan las reseñas. Precios, raciones y disponibilidad se consultan llamando al 964 33 81 25 o directamente en la barra.',
	},
	{
		q: '¿Se puede reservar?',
		a: 'Por teléfono, en el 964 33 81 25. No hay reserva online ni formulario en esta web. La terraza no es muy grande y a la hora punta del almuerzo se llena, así que para grupos conviene llamar el día antes.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'La ficha de Google no marca atributos de accesibilidad para este local, así que no se puede confirmar desde aquí. La terraza está a pie de calle, al mismo nivel que la acera; para el interior y el aseo, lo mejor es llamar antes al 964 33 81 25 y preguntar directamente.',
	},
	{
		q: '¿Es una parada de ciclistas?',
		a: 'Sí, por lo que cuentan las reseñas: una de ellas lo define como «típico bar de almuerzos ciclistas», y en las fotos aparecen cascos y bicis junto a las mesas. La ficha no publica aparcamiento para bicicletas, pero la terraza y la calle permiten dejarlas a la vista mientras se almuerza.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': ['BarOrPub', 'Restaurant'],
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['Casa Herminia', 'Bar Casa Herminia', 'Casa Herminia La Pobla Tornesa'],
	slogan: 'El almuerzo de siempre y el carajillo palmero',
	description,
	url: `${business.site}/`,
	telephone: '+34 964 33 81 25',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Almuerzos', 'Bocadillos', 'Cocina de pueblo', 'Tapas', 'Cafetería'],
	areaServed: [
		{ '@type': 'City', name: 'La Pobla Tornesa' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: '0xd5ff88043460ea3:0x94b3a16339c50b38' },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '07:00',
			closes: '13:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El almuerzo', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Casa Herminia · Almuerzos y carajillo palmero en La Pobla Tornesa</title>
		<meta name="theme-color" content="#1d4e89" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Work+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Casa Herminia, bar La Pobla Tornesa, almuerzos La Pobla Tornesa, carajillo palmero, bocadillos, bar de pueblo, Carrer Vilafamés 4, Plana Alta, Castellón"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Casa Herminia · Almuerzos y carajillo palmero en La Pobla Tornesa"
			ogDescription="Huevos, embutido y bocadillos desde las 7:00, olivas y cacahuetes en la mesa y el carajillo palmero que se inventó aquí. 4,5 en Google con 983 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Plato de almuerzo con huevo frito, embutido y tomate de Casa Herminia"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#1d4e89"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="La Pobla Tornesa, Castelló"
			contact={{
				street: business.street,
				locality: business.city,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[terraza]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="CH"
			name={business.brand}
			subtitle="Bar · Almuerzos · La Pobla"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer Vilafamés, 4 · La Pobla Tornesa"
				title="El almuerzo<br />de siempre,<br /><em>en La Pobla.</em>"
				lede="Casa Herminia es bar y restaurante de almuerzos en La Pobla Tornesa: huevos, embutido y bocadillos desde las siete de la mañana, olivas y cacahuetes en la mesa, cerveza bien fría y el carajillo palmero que, según el cartel de la casa, se inventó aquí."
				image={terraza}
				imageAlt="Terraza de Casa Herminia bajo el toldo azul y la morera, en La Pobla Tornesa"
				primaryCta={{ label: 'Llamar 964 33 81 25', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5 en Google</b> con 983 reseñas' },
					{ label: 'De lunes a viernes', html: '<b>7:00 – 15:30</b>' },
					{ label: 'Sábado', html: '<b>7:00 – 13:30</b>' },
					{ label: 'Domingo', html: '<b>Cerrado</b>' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Casa Herminia" items={servicios} />

			<LocalAbout
				label="Bar de almuerzos en La Pobla"
				title="La mesa puesta<br />antes de las nueve<br /><em>y hasta las tres.</em>"
				paragraphs={[
					'En el número 4 de la calle Vilafamés, con la fachada de piedra, el toldo azul de «CASA HERMINIA» y una morera dando sombra a la terraza, Casa Herminia sirve el almuerzo del pueblo y de los que suben desde Castellón hacia Vilafamés. Las mesas de fuera, blancas y de plástico, se llenan en cuanto abre.',
					'La ficha lo clasifica como bar y restaurante. En sus fotos está el almuerzo completo: huevos fritos, embutido, tomate, patatas, pan de pueblo y cerveza, con olivas y cacahuetes de entrada. También los bocadillos de llom con pimiento y de longaniza con huevo, y el carajillo servido en vaso de caña.',
					'Abre solo por las mañanas: de lunes a viernes de 7:00 a 15:30 y el sábado hasta las 13:30, con el domingo cerrado. La ficha suma 983 opiniones con un 4,5, y las reseñas repiten el trato de las camareras y el carajillo palmero.',
				]}
				note="«Típico bar de almuerzos ciclistas, buen trato y excelente carajillo palmero», dice una reseña. Otra: «buen sitio para almorzar y trato exquisito por parte de las camareras»."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="El almuerzo"
				title="Huevos, pan<br /><em>y carajillo.</em>"
				description="La ficha de Google no publica carta con precios, así que esta selección sale de lo que aparece en sus fotos y de lo que citan sus reseñas: el plato de almuerzo, los bocadillos de la casa, la mesa de olivas y cacahuetes y el carajillo palmero."
				cta={{ label: 'Preguntar qué hay hoy', href: phoneHref }}
				groups={grupos}
				note="Sin precios: la ficha no los publica y esta web no los inventa. El almuerzo del día, las raciones y los importes se consultan por teléfono en el 964 33 81 25."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La terraza,<br />la mesa<br /><em>y el vaso de caña.</em>"
				description="Estas fotografías proceden del perfil de Restaurant - Bar Casa Herminia en Google Maps: el carajillo en vaso de caña, el plato de almuerzo con huevo y embutido, el bocadillo de llom, el de longaniza, la mesa de olivas y cacahuetes y el cartel del carajillo palmero."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del bar en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer Vilafamés, 4 · 12191 La Pobla Tornesa"
				title="Te esperamos<br /><em>bajo la morera.</em>"
				addressLines={[business.street, `${business.postalCode} ${business.city}`, 'Castelló, España']}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: '7:00 – 15:30' },
					{ day: 'Martes', value: '7:00 – 15:30' },
					{ day: 'Miércoles', value: '7:00 – 15:30' },
					{ day: 'Jueves', value: '7:00 – 15:30' },
					{ day: 'Viernes', value: '7:00 – 15:30' },
					{ day: 'Sábado', value: '7:00 – 13:30' },
					{ day: 'Domingo', value: 'Cerrado', closed: true },
				]}
				hoursNote="Horario publicado en la ficha de Google: solo mañanas, de lunes a viernes de 7:00 a 15:30 y el sábado hasta las 13:30. Domingo cerrado y sin servicio de cena. En fiestas del pueblo cambia: llama antes."
				mapTitle="Mapa de Casa Herminia en la calle Vilafamés, 4, La Pobla Tornesa"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Casa Herminia · La Pobla Tornesa"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Se reserva por teléfono, llamando al 964 33 81 25: no hay reserva online ni formulario en esta web. La terraza es pequeña y a la hora del almuerzo se llena, así que para grupos conviene avisar el día antes."
			/>

			<LocalFaq items={faqs} title="Antes de <em>sentarse.</em>" />
		</main>

		<LocalFooter
			mark="CH"
			name="Casa Herminia"
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del bar en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Casa Herminia"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
