---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import pan from '../assets/fotos/maype-obrador-apaisada-05.jpg';
import vitrina from '../assets/fotos/maype-obrador-apaisada-01.jpg';
import mostrador from '../assets/fotos/maype-obrador-cuadrada-07.jpg';
import bandeja from '../assets/fotos/maype-obrador-vertical-08.jpg';
import pasteles from '../assets/fotos/maype-obrador-vertical-09.jpg';
import tartaIsa from '../assets/fotos/maype-obrador-apaisada-06.jpg';
import tartaFelis from '../assets/fotos/maype-obrador-vista-3-03.jpg';
import tartaFoto from '../assets/fotos/maype-obrador-apaisada-10.jpg';
import calabazas from '../assets/fotos/maype-obrador-vertical-04.jpg';
import tartas from '../assets/fotos/maype-obrador-vertical-02.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	REVIEWS,
	REVIEWS_NOTE,
	SERVICIOS,
} from '../data/site';

const title = 'MayPe · Obrador panadería y confitería en Málaga';
const description =
	'Obrador panadería y confitería Martos y Pérez (MayPe), en Cam. San Rafael, 7, Málaga. Pan artesanal a diario, bollería, confitería y tartas por encargo.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#maype`,
	name: BUSINESS.name,
	alternateName: ['MayPe', 'Obrador MayPe', 'Martos y Pérez', 'Panadería MayPe Málaga'],
	description:
		'Obrador panadería y confitería en Cam. San Rafael, 7 (Carretera de Cádiz, 29006 Málaga). Pan 100% artesanal hecho a diario, bollería, confitería y tartas por encargo.',
	slogan: 'Pan 100% artesanal y dulces artesanales',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, BUSINESS.instagram],
	telephone: '+34951694703',
	servesCuisine: ['Panadería', 'Confitería'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '07:30',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '08:00',
			closes: '15:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: vitrina,
		alt: 'Vitrina de MayPe con tartas, pasteles, cañas y xuxos, junto a la pared de ladrillo y las garrafas de agua',
	},
	{
		src: mostrador,
		alt: 'Mostrador de MayPe con bandejas de torrijas, napolitanas, pasteles de nata y tartaletas de crema',
	},
	{
		src: bandeja,
		alt: 'Bandeja de pasteles glaseados de chocolate y tartaletas de crema con cereza y albaricoque',
	},
	{
		src: pasteles,
		alt: 'Pasteles rectangulares de chocolate cubiertos de nata y láminas de chocolate blanco',
	},
	{
		src: tartaFelis,
		alt: 'Tarta rectangular de cumpleaños con el texto «Felis Cumpleaños» escrito en azul',
	},
	{
		src: tartaIsa,
		alt: 'Tarta rectangular de cumpleaños con el texto «Felicidades Isa» y borde de crema de chocolate, fresas y piña',
	},
	{
		src: tartaFoto,
		alt: 'Tarta rosa con una imagen impresa de personajes en la superficie y el texto «Felicidades Ariadna Cristina»',
	},
	{
		src: calabazas,
		alt: 'Bollos glaseados con forma de calabaza y un tallo de chocolate, en una bandeja de horno',
	},
	{
		src: tartas,
		alt: 'Tartas y pasteles en la vitrina, con donuts glaseados, pasteles de chocolate y una tarta de queso',
	},
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"maype-obrador-apaisada-05.jpg": pan,
	"maype-obrador-apaisada-01.jpg": vitrina,
	"maype-obrador-cuadrada-07.jpg": mostrador,
	"maype-obrador-vertical-08.jpg": bandeja,
	"maype-obrador-vertical-09.jpg": pasteles,
	"maype-obrador-vista-3-03.jpg": tartaFelis,
	"maype-obrador-apaisada-06.jpg": tartaIsa,
	"maype-obrador-apaisada-10.jpg": tartaFoto,
	"maype-obrador-vertical-04.jpg": calabazas,
	"maype-obrador-vertical-02.jpg": tartas,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#fbf3e6" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Karla:ital,wght@0,300..600;1,300..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="MayPe, Martos y Pérez, obrador panadería Málaga, confitería Málaga, Camino San Rafael 7, Carretera de Cádiz, pan artesanal, tartas por encargo, torrijas"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="MayPe · Pan artesanal y dulces de encargo en Málaga"
			ogDescription="Obrador panadería y confitería en el Camino de San Rafael, 7. Pan hecho a diario, bollería, confitería y tartas por encargo. 4,7 sobre 5 con 64 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Cesta de barras, hogazas y panes con semillas del obrador MayPe"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#fbf3e6"
			phone="+34951694703"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[pan]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="MayPe"
			subtitle="Obrador · Confitería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Instagram ↗', href: BUSINESS.instagram, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, descripción, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y disponibilidad pueden cambiar; confírmalos antes de ir."
			ctaLabel="Llamar a MayPe"
			navAriaLabel="Enlaces de MayPe"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34951694703?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20M%C3%A1laga." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Málaga"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
