---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import pan from '../assets/fotos/maype-obrador-apaisada-05.jpg';
import vitrina from '../assets/fotos/maype-obrador-apaisada-01.jpg';
import mostrador from '../assets/fotos/maype-obrador-cuadrada-07.jpg';
import bandeja from '../assets/fotos/maype-obrador-vertical-08.jpg';
import pasteles from '../assets/fotos/maype-obrador-vertical-09.jpg';
import tartaIsa from '../assets/fotos/maype-obrador-apaisada-06.jpg';
import tartaFelis from '../assets/fotos/maype-obrador-vista-3-03.jpg';
import tartaFoto from '../assets/fotos/maype-obrador-apaisada-10.jpg';
import calabazas from '../assets/fotos/maype-obrador-vertical-04.jpg';
import tartas from '../assets/fotos/maype-obrador-vertical-02.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	REVIEWS,
	REVIEWS_NOTE,
	SERVICIOS,
} from '../data/site';

const title = 'MayPe · Obrador panadería y confitería en Málaga';
const description =
	'Obrador panadería y confitería Martos y Pérez (MayPe), en Cam. San Rafael, 7, Málaga. Pan artesanal a diario, bollería, confitería y tartas por encargo.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#maype`,
	name: BUSINESS.name,
	alternateName: ['MayPe', 'Obrador MayPe', 'Martos y Pérez', 'Panadería MayPe Málaga'],
	description:
		'Obrador panadería y confitería en Cam. San Rafael, 7 (Carretera de Cádiz, 29006 Málaga). Pan 100% artesanal hecho a diario, bollería, confitería y tartas por encargo.',
	slogan: 'Pan 100% artesanal y dulces artesanales',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, BUSINESS.instagram],
	telephone: '+34951694703',
	servesCuisine: ['Panadería', 'Confitería'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '07:30',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '08:00',
			closes: '15:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: vitrina,
		alt: 'Vitrina de MayPe con tartas, pasteles, cañas y xuxos, junto a la pared de ladrillo y las garrafas de agua',
	},
	{
		src: mostrador,
		alt: 'Mostrador de MayPe con bandejas de torrijas, napolitanas, pasteles de nata y tartaletas de crema',
	},
	{
		src: bandeja,
		alt: 'Bandeja de pasteles glaseados de chocolate y tartaletas de crema con cereza y albaricoque',
	},
	{
		src: pasteles,
		alt: 'Pasteles rectangulares de chocolate cubiertos de nata y láminas de chocolate blanco',
	},
	{
		src: tartaFelis,
		alt: 'Tarta rectangular de cumpleaños con el texto «Felis Cumpleaños» escrito en azul',
	},
	{
		src: tartaIsa,
		alt: 'Tarta rectangular de cumpleaños con el texto «Felicidades Isa» y borde de crema de chocolate, fresas y piña',
	},
	{
		src: tartaFoto,
		alt: 'Tarta rosa con una imagen impresa de personajes en la superficie y el texto «Felicidades Ariadna Cristina»',
	},
	{
		src: calabazas,
		alt: 'Bollos glaseados con forma de calabaza y un tallo de chocolate, en una bandeja de horno',
	},
	{
		src: tartas,
		alt: 'Tartas y pasteles en la vitrina, con donuts glaseados, pasteles de chocolate y una tarta de queso',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#fbf3e6" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Karla:ital,wght@0,300..600;1,300..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="MayPe, Martos y Pérez, obrador panadería Málaga, confitería Málaga, Camino San Rafael 7, Carretera de Cádiz, pan artesanal, tartas por encargo, torrijas"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="MayPe · Pan artesanal y dulces de encargo en Málaga"
			ogDescription="Obrador panadería y confitería en el Camino de San Rafael, 7. Pan hecho a diario, bollería, confitería y tartas por encargo. 4,7 sobre 5 con 64 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Cesta de barras, hogazas y panes con semillas del obrador MayPe"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#fbf3e6"
			phone="+34951694703"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[pan]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="MayPe"
			subtitle="Obrador · Confitería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Cam. San Rafael, 7 · Carretera de Cádiz"
				title="Pan del día, <br /><em>dulces de encargo.</em>"
				lede={`MayPe es el obrador de Martos y Pérez, en el Camino de San Rafael. La ficha del negocio lo resume en una línea: «pan 100% artesanal y hecho a diario; dulces artesanales». Del obrador salen barras y hogazas, bollería y confitería; en el mostrador hay tartas de cumpleaños con dedicatoria y tartas con una imagen impresa en la superficie. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={pan}
				imageAlt="Cesta de mimbre con barras, hogazas, panes con semillas y panes ovalados del obrador MayPe"
				primaryCta={{ label: 'Llamar · 951 69 47 03', href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,7</b> en Google · 64 reseñas' },
					{ label: 'Horario', html: '<b>L–V 7:00–21:00</b> · sáb. 7:30–20:30 · dom. 8:00–15:00' },
					{ label: 'Teléfono', html: '<b>951 69 47 03</b>' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver las fotos en Google"
				tag="Pan 100% artesanal"
			/>

			<LocalChips label="Lo que hay en el obrador" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un obrador <br /><em>de barrio.</em>"
				paragraphs={[
					'MayPe ocupa el número 7 del Camino de San Rafael, en la Carretera de Cádiz, junto a Primor. Es el obrador de Martos y Pérez: panadería y confitería en el mismo mostrador, con el horno al fondo y la vitrina delante.',
					'La ficha de Google recoge la idea del negocio en su propia descripción: «pan 100% artesanal y hecho a diario. Dulces artesanales». En las fotos del perfil se ven cestas de barras, hogazas y panes con semillas, y bandejas de bollería recién glaseada.',
					'La confitería trabaja las dos cosas: el dulce de todos los días —napolitanas, cañas, xuxos, torrijas, pasteles de nata y tartaletas de crema— y la tarta de encargo, con dedicatoria escrita a mano o con una imagen impresa en la superficie.',
					'El perfil del obrador anuncia tartas «con y sin encargo» y recuerda que está en el Camino de San Rafael, junto a Primor. Abre de lunes a viernes de 7:00 a 21:00, el sábado de 7:30 a 20:30 y el domingo de 8:00 a 15:00, según la ficha de Google.',
				]}
				note="4,7 sobre 5 con 64 reseñas en Google. La ficha indica acceso para sillas de ruedas y que no hay aparcamiento adaptado. No publica web propia, correo ni métodos de pago; el contacto es el teléfono y el perfil de Instagram del obrador."
				links={[
					{ label: 'Llamar · 951 69 47 03', href: BUSINESS.phoneHref },
					{ label: 'Instagram del obrador', href: BUSINESS.instagram, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow"><span aria-hidden="true"></span> Tres paradas en el mostrador</p>
						<h2 id="three-title">El pan, la vitrina <br /><em>y el encargo.</em></h2>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que sale <br /><em>cada día.</em>"
				description="Sin carta ni precios publicados: esto es lo que enumera la descripción del negocio y lo que muestran las fotos del perfil."
				cta={{ label: 'Llamar · 951 69 47 03', href: BUSINESS.phoneHref }}
				groups={MENU_GROUPS}
				note="La ficha no recoge precios ni métodos de pago, así que esta web no publica importes. Las tartas de las fotos llevan dedicatorias de clientes («Felicidades Isa», «Felicidades Ariadna Cristina»); se muestran como ejemplo del trabajo de encargo, no como productos con nombre propio. En la tarta con imagen impresa no se puede saber desde la foto si la impresión es comestible, así que la web no lo afirma. Para saber qué hay ese día o encargar una tarta, llama al 951 69 47 03."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="El obrador, <br /><em>por dentro.</em>"
				description="Nueve fotos de la ficha de Google Maps: la vitrina, el mostrador, la bollería, los pasteles y las tartas de encargo."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="reviews-title">
				<div class="wrap">
					<div class="reviews-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Lo que dicen</p>
							<h2 id="reviews-title">Dos reseñas <br /><em>de la ficha.</em></h2>
						</div>
						<p>
							4,7 sobre 5 con 64 reseñas. Estas dos están publicadas en Google y hablan
							de los dulces y del trato del equipo.
						</p>
					</div>
					<div class="review-grid">
						{
							REVIEWS.map((review) => (
								<figure class="review-card">
									<span class="stars" role="img" aria-label={`${review.rating} de 5 estrellas`}>
										★★★★★
									</span>
									<blockquote>{review.text}</blockquote>
									<figcaption>Reseña de Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="reviews-note">{REVIEWS_NOTE}</p>
					<a class="reviews-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
						Leer las 64 reseñas en Google ↗
					</a>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En el Camino <br /><em>de San Rafael.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de MayPe en el Camino de San Rafael, 7, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="MayPe · Carretera de Cádiz"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phone, href: BUSINESS.phoneHref }}
				reserveNote="La ficha de Google indica acceso para sillas de ruedas y que no hay aparcamiento adaptado. No publica web, correo ni canal de pedidos online: las tartas se encargan por teléfono o en el mostrador."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Instagram ↗', href: BUSINESS.instagram, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, descripción, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y disponibilidad pueden cambiar; confírmalos antes de ir."
			ctaLabel="Llamar a MayPe"
			navAriaLabel="Enlaces de MayPe"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
