---
import '../styles/global.css';

const business = {
	name: 'Restaurante El Faro',
	short: 'El Faro',
	street: 'Av. de la Mar 122',
	city: 'Barbate',
	postalCode: '11160',
	phone: '+34 956 43 09 48',
	latitude: 36.1869952,
	longitude: -5.9238869,
	site: 'https://restaurante-el-faro.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+El+Faro/@36.1869952,-5.9238869,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c436be3faa507:0x775abdfe6ada2693!8m2!3d36.1869952!4d-5.9238869!16s%2Fg%2F11cnrx9_s2?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const phoneHref = 'tel:+34956430948';

const specialties = [
	{
		kicker: 'De almadraba',
		title: 'Atún en varias formas',
		text: 'Tartar, tataki, encebollado y caldereta de atún rojo de Barbate.',
	},
	{
		kicker: 'De la costa',
		title: 'Arroces y fritura',
		text: 'Paella, arroz de marisco, fideuá, chocos y tortillitas de camarones.',
	},
	{
		kicker: 'Gaditanos',
		title: 'Clásicos barbateños',
		text: 'Ensalada barbateña, boquerones, gambas a la plancha y langostinos.',
	},
	{
		kicker: 'Frente al mar',
		title: 'Terraza con vistas',
		text: 'Terraza cubierta con brisa marina e interior acogedor.',
	},
	{
		kicker: 'Dulce',
		title: 'Tiramisú casero',
		text: 'Tiramisú de cocinero italiano, mousse de limón y tarta de queso.',
	},
	{
		kicker: 'Aviso',
		title: '10:00–18:00',
		text: 'Todos los días 10:00–18:00, según directorio. Confirma en el 956 43 09 48.',
	},
];

const gallery = [
	{ src: '/fotos/faro.svg', alt: 'Ilustración del faro — sustituye por foto propia' },
	{ src: '/fotos/mar.svg', alt: 'Ilustración del mar — sustituye por foto propia' },
	{ src: '/fotos/atun.svg', alt: 'Ilustración del atún — sustituye por foto propia' },
	{ src: '/fotos/arroz.svg', alt: 'Ilustración del arroz — sustituye por foto propia' },
	{ src: '/fotos/terraza.svg', alt: 'Ilustración de la terraza — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está El Faro?',
		a: 'En Av. de la Mar 122, 11160 Barbate (Cádiz), a pie de playa.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Todos los días de 10:00 a 18:00, según directorio. Sin servicio de cenas: confirma en el 956 43 09 48.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Atún de almadraba, arroces, fritura y clásicos gaditanos. Confirma la carta del día en el local.',
	},
	{
		q: '¿Aceptan reservas y mascotas?',
		a: 'Sí, según su ficha pública: acepta reservas y acceso con mascotas. Reserva en temporada alta.',
	},
	{
		q: '¿Cómo llego?',
		a: 'En primera línea de Barbate, en la Avenida de la Mar. Usa el botón «Cómo llegar» para abrir la ruta en Google Maps.',
	},
];

const description =
	'El Faro: restaurante a pie de playa en Av. de la Mar 122, Barbate. Atún de almadraba y vistas al mar. Todos los días 10:00–18:00. Tel. 956 43 09 48.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 956 43 09 48',
	image: [`${business.site}/fotos/faro.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Andaluza', 'Pescados'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:00',
			closes: '18:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza con vistas al mar', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso con mascotas', value: true },
	],
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="El Faro: restaurante a pie de playa en Av. de la Mar 122, Barbate. Atún y vistas al mar. 10:00–18:00. 956 43 09 48." />
		<meta name="keywords" content="El Faro Barbate, comer playa Barbate, atún Barbate, Av Mar Barbate" />
		<meta name="author" content="El Faro" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>El Faro | Atún frente al mar en Barbate</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="El Faro · Atún frente al mar en Barbate" />
		<meta property="og:description" content="Atún de almadraba con vistas al mar en Av. de la Mar 122." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/faro.svg`} />
		<meta property="og:image:alt" content="El Faro, Barbate" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="El Faro · Restaurante en Barbate" />
		<meta name="twitter:description" content="Av. de la Mar 122: atún frente al mar." />
		<meta name="twitter:image" content={`${business.site}/fotos/faro.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Barbate" />
		<meta name="geo.position" content="36.1869952;-5.9238869" />
		<meta name="ICBM" content="36.1869952, -5.9238869" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="El Faro, inicio">
				<span class="brand-mark" aria-hidden="true">EF</span>
				<span class="brand-name">El Faro <small>Barbate · Playa</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">El restaurante</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>956 43 09 48</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Av. de la Mar 122 · Barbate</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante a pie de playa en Barbate: atún de almadraba, arroces
						y terraza cubierta con brisa marina.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 956 43 09 48</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>10–18</b> todos los días</li>
						<li><b>Playa</b> primera línea</li>
						<li>Atún almadraba</li>
						<li>Mascotas OK</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/fotos/faro.svg" alt="Ilustración de El Faro, Barbate" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Av. de la Mar 122 · Barbate</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>10–18</b><span>Todos los días</span></div>
					<div><b>Playa</b><span>Primera línea</span></div>
					<div><b>7,2</b><span>Directorio local</span></div>
				</div>
				<ul class="services">
					<li>Atún</li>
					<li>Arroces</li>
					<li>Terraza</li>
					<li>Vistas</li>
					<li>Mascotas</li>
					<li>Reservas</li>
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> El restaurante</p>
				<div class="about-grid">
					<h2>A pie de playa,<br />con <em>brisa.</em></h2>
					<div class="about-copy">
						<p>
							El Faro está en Av. de la Mar 122 (11160 Barbate),
							con coordenadas 36.1869952, -5.9238869, en primera línea.
						</p>
						<p>
							Carta marina con atún de almadraba, arroces, fritura y clásicos
							gaditanos, con postres caseros como el tiramisú.
						</p>
						<p class="about-note">
							Todos los días 10:00–18:00, según directorio: sin cenas. Reserva
							en verano en el 956 43 09 48.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales según su ficha pública: mar y atún.
						Confirma la carta del día en el propio local.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El mar<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del restaurante.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Av. de la Mar 122</p>
					<h2>Ven frente al mar<br /><em>a comer.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes a domingo</th>
								<td>10:00 – 18:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Según directorio, sin cenas. Confirma en el 956 43 09 48 antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al restaurante ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 956 43 09 48</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de El Faro en Av. de la Mar 122, Barbate" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> El Faro · Barbate</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">EF</span>
				<p>El Faro<small>{business.street} · {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} El Faro · Barbate. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>956 43 09 48</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
