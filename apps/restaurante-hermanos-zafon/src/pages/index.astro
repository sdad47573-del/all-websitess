---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/restaurante-hermanos-zafon-apaisada-01.jpg';
import parrilla from '../assets/fotos/restaurante-hermanos-zafon-vista-4-04.jpg';
import brasas from '../assets/fotos/restaurante-hermanos-zafon-apaisada-07.jpg';
import plato from '../assets/fotos/restaurante-hermanos-zafon-vertical-06.jpg';
import bocadillo from '../assets/fotos/restaurante-hermanos-zafon-vertical-10.jpg';
import barra from '../assets/fotos/restaurante-hermanos-zafon-vertical-03.jpg';
import cafe from '../assets/fotos/restaurante-hermanos-zafon-vertical-05.jpg';

const business = {
	name: 'Restaurante Hermanos Zafón',
	brand: 'Hermanos Zafón',
	street: "Av. de l'Alcora, 101",
	city: 'Castellón de la Plana',
	region: 'Castelló',
	postalCode: '12006',
	phone: '964 24 02 43',
	latitude: 39.9867858,
	longitude: -0.0590794,
	rating: 4.2,
	reviewsCount: 1735,
	site: 'https://restaurante-hermanos-zafon.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd5ffe19304f0a99:0xe85233b89e7f0c21';
const cidDecimal = '16740499632915680289';
const placeId = 'ChIJmQpPMBn-Xw0RIQx_nrgzUug';

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+Hermanos+Zaf%C3%B3n/@39.9867858,-0.0590794,17z/data=!3m1!4b1!4m6!3m5!1s0xd5ffe19304f0a99:0xe85233b89e7f0c21!8m2!3d39.9867858!4d-0.0590794!16s%2Fg%2F1tmy6ctt?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34964240243';

const description =
	"Hermanos Zafón, bar restaurante con parrilla de leña en la Avenida de l'Alcora, 101, Castellón: desayunos desde las 6:00, menú diario y carnes a la brasa.";

const servicios = [
	'Bar restaurante',
	'Brasa de leña',
	'Barbacoa',
	'Desayunos',
	'Menú diario',
	'Tapas y raciones',
	'Brunch',
	'Terraza',
	'Aparcamiento adaptado',
	'Reservas por teléfono',
];

const grupos = [
	{
		title: 'De la parrilla',
		items: [
			{
				name: 'Parrillada de carnes',
				note: 'bacon, pollo y longaniza a la brasa con patatas y pimiento verde, como sale en sus fotos',
			},
			{
				name: 'Puntilla a la brasa',
				note: 'el corte de ternera que cita una reseña junto al jamón, las bravas y los chipirones',
			},
			{
				name: 'Pulpo a la gallega',
				note: 'sobre patata y con pimentón; la ficha lo tiene a 10 € la ración',
			},
		],
	},
	{
		title: 'Para empezar',
		items: [
			{
				name: 'Jamón y queso',
				note: 'la tabla con la que arranca la comida, según una reseña',
			},
			{
				name: 'Patatas bravas',
				note: 'de ración, con la salsa aparte',
			},
			{
				name: 'Sepia y chipirones en salsa',
				note: '«sepia y chipirones en salsa, excelente todo», dice una reseña',
			},
		],
	},
	{
		title: 'De barra y de postre',
		items: [
			{
				name: 'Bocadillo de longaniza',
				note: 'en pan de pueblo, con la longaniza recién hecha en la parrilla',
			},
			{
				name: 'Carajillo',
				note: 'el café de después de comer: «unos carajillos estupendos», según una reseña',
			},
		],
	},
];

const galeria = [
	{
		src: parrilla,
		alt: 'Parrilla de leña encendida en Restaurante Hermanos Zafón, en Castellón',
	},
	{
		src: plato,
		alt: 'Carne a la brasa con patatas y pimiento verde en Restaurante Hermanos Zafón',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo de longaniza a la brasa en Restaurante Hermanos Zafón',
	},
	{
		src: brasas,
		alt: 'Brasas y leña en la parrilla del comedor de Restaurante Hermanos Zafón',
	},
	{
		src: barra,
		alt: 'Mesa con aceitunas y ali oli delante de la parrilla de ladrillo de Hermanos Zafón',
	},
	{
		src: cafe,
		alt: 'Café en vaso servido en Restaurante Hermanos Zafón, en Castellón',
	},
];

const faqs = [
	{
		q: '¿Dónde está Hermanos Zafón?',
		a: "En la Avenida de l'Alcora, 101, 12006 Castellón de la Plana. Es un bajo de piedra con columnas, terraza en la acera y el rótulo verde de bar restaurante. La ficha de Google marca aparcamiento adaptado para sillas de ruedas. El botón «Cómo llegar» abre la ruta exacta en Google Maps.",
	},
	{
		q: '¿Qué horario tiene?',
		a: 'Abre todos los días a las 6:00. De domingo a jueves cierra a las 17:00, y los viernes y los sábados alarga hasta las 24:00. El horario publicado no marca cierre entre el desayuno y la comida, así que el local está abierto de forma corrida; el servicio de cocina de cada franja se confirma en el restaurante.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'La ficha lo clasifica como bar restaurante, restaurante especializado en barbacoa y de brunch. En sus fotos aparece la parrilla de leña y platos de brasa con patatas y pimiento verde; las reseñas hablan de jamón y queso, puntilla, bravas, sepia y chipirones en salsa, pulpo a la gallega y menú diario variado.',
	},
	{
		q: '¿Hay menú diario?',
		a: 'Sí, según las reseñas es variado y con brasa entre los segundos. La ficha de Google no publica su precio ni los platos de cada día, y esta web no los inventa: se consultan en el restaurante o llamando al 964 24 02 43.',
	},
	{
		q: '¿Se puede desayunar?',
		a: 'Sí. Abren a las 6:00 y la barra funciona desde primera hora con café, bocadillos y carajillos, que las reseñas citan expresamente. Es el desayuno de la zona antes del turno de trabajo.',
	},
	{
		q: '¿Tiene terraza?',
		a: 'Sí, en la misma acera de la Avenida de l\'Alcora, con mesas y sillas de exterior delante de la fachada de piedra. En las fotos de la ficha se ve el toldo desplegado sobre la entrada.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'No hay reserva online ni formulario en esta web: se reserva llamando al 964 24 02 43. Con 1.735 reseñas y terraza, en fin de semana conviene llamar con tiempo, sobre todo para grupos.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'La ficha de Google marca aseo, asientos y aparcamiento adaptados para sillas de ruedas. No marca la entrada como accesible, y sus fotos muestran unos escalones en el acceso, así que conviene avisar al reservar.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['Hermanos Zafón', 'Hnos. Zafón', 'Restaurante Hnos. Zafón Castellón'],
	slogan: 'Brasa de leña en la Avenida de l\'Alcora',
	description,
	url: `${business.site}/`,
	telephone: '+34 964 24 02 43',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Barbacoa', 'Brasa', 'Cocina española', 'Tapas', 'Brunch'],
	areaServed: [
		{ '@type': 'City', name: 'Castellón de la Plana' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '06:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '06:00',
			closes: '23:59',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La brasa', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Hermanos Zafón · Brasa de leña en Castellón</title>
		<meta name="theme-color" content="#231e19" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,wght@0,400;0,600;0,700;1,400&family=Oswald:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Hermanos Zafón, Hnos. Zafón, restaurante Castellón, brasa de leña, barbacoa Castellón, parrilla Castellón, menú diario Castellón, desayunos Castellón, tapas, carajillo, Avenida de l'Alcora, Plana Alta"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Hermanos Zafón · Brasa de leña en Castellón"
			ogDescription="Parrilla de leña, menú diario y carajillos en la Avenida de l'Alcora. Abre todos los días desde las 6:00. 4,2 en Google con 1.735 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Carne a la brasa con patatas y pimiento verde de Hermanos Zafón"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#231e19"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Castellón de la Plana, Castellón"
			contact={{
				street: business.street,
				locality: business.city,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[fachada]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="HZ"
			name={business.brand}
			subtitle="Bar restaurante · Castellón"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. de l'Alcora, 101 · Castellón"
				title="Brasa de leña,<br /><em>desde las 6.</em>"
				lede="Hermanos Zafón es bar restaurante con parrilla de leña en la Avenida de l'Alcora, en Castellón. Abre a las 6:00 para desayunar y echar el carajillo, pone menú diario a mediodía y saca la brasa hasta las 17:00; viernes y sábado, hasta medianoche."
				image={fachada}
				imageAlt="Fachada de piedra con el rótulo de bar restaurante Hermanos Zafón y su terraza en Castellón"
				primaryCta={{ label: 'Llamar 964 24 02 43', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,2</b> en Google (1.735 reseñas)' },
					{ label: 'Domingo a jueves', html: '<b>6:00 – 17:00</b>' },
					{ label: 'Viernes y sábado', html: '<b>Hasta las 24:00</b>' },
					{ label: 'La cocina', html: '<b>Brasa de leña</b>' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Hermanos Zafón" items={servicios} />

			<LocalAbout
				label="Brasa de leña en Castellón"
				title="Leña,<br />parrilla<br />y <em>barra.</em>"
				paragraphs={[
					'El restaurante ocupa un bajo de piedra con columnas en la Avenida de l\'Alcora, 101, con la terraza en la misma acera y el toldo sobre la entrada. Dentro, la chimenea de ladrillo con la parrilla de leña a la vista: es lo primero que se ve al pasar y lo que da nombre a la casa.',
					'La ficha lo clasifica como bar restaurante, restaurante especializado en barbacoa y de brunch, y las tres cosas caben en un mismo día: café y bocadillo a las 6:00, menú diario variado a la hora de comer, brasa de carnes con patatas y pimiento verde y, al final, carajillo en la barra.',
					'Abre todos los días a las 6:00. De domingo a jueves cierra a las 17:00 y los viernes y sábados alarga hasta las 24:00. La ficha suma 1.735 opiniones con un 4,2, y las reseñas repiten la brasa, las tapas de siempre y el trato.',
				]}
				note="«Menú diario variado, brasa para carne y unos carajillos estupendos», dice una reseña. Otra: «jamón y queso, puntilla, bravas, sepia y chipirones en salsa: excelente todo»."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La brasa"
				title="Parrilla<br /><em>de leña.</em>"
				description="La ficha de Google no tiene carta con precios, así que esta lista sale de lo que aparece en sus fotos y de lo que citan sus reseñas: carnes a la brasa, tapas de siempre, bocadillos y carajillos."
				cta={{ label: 'Preguntar el menú de hoy', href: phoneHref }}
				groups={grupos}
				note="El único precio que publica la ficha es el del pulpo a la gallega (10 € la ración). El menú diario, las raciones y el resto de importes se consultan en el restaurante o llamando al 964 24 02 43."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La parrilla,<br />el plato<br /><em>y la mesa.</em>"
				description="Estas fotografías proceden del perfil de Restaurante Hermanos Zafón en Google Maps: la parrilla de leña encendida, las brasas, la carne con patatas y pimiento, el bocadillo de longaniza, la mesa con aceitunas y ali oli delante del fuego y el café."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Av. de l'Alcora, 101 · 12006 Castellón"
				title="Te esperamos<br /><em>junto al fuego.</em>"
				addressLines={[business.street, `${business.postalCode} ${business.city}`, 'Castelló, España']}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: '6:00 – 17:00' },
					{ day: 'Martes', value: '6:00 – 17:00' },
					{ day: 'Miércoles', value: '6:00 – 17:00' },
					{ day: 'Jueves', value: '6:00 – 17:00' },
					{ day: 'Viernes', value: '6:00 – 24:00' },
					{ day: 'Sábado', value: '6:00 – 24:00' },
					{ day: 'Domingo', value: '6:00 – 17:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google: abre todos los días a las 6:00, cierra a las 17:00 de domingo a jueves y alarga hasta las 24:00 los viernes y sábados. En fiestas y en agosto suele cambiar: llama antes al 964 24 02 43."
				mapTitle="Mapa de Restaurante Hermanos Zafón en la Avenida de l'Alcora, 101, Castellón"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Hermanos Zafón · Castellón"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Las reservas se hacen por teléfono, llamando al 964 24 02 43: no hay reserva online ni formulario en esta web. La ficha marca aparcamiento adaptado, y para grupos conviene llamar con tiempo."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="HZ"
			name="Restaurante Hermanos Zafón"
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, menú y precios antes de la visita."
			ctaLabel="Llamar a Hermanos Zafón"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
