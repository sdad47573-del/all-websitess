---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import bife from '../assets/fotos/restaurante-costa-vicentina-apaisada-06.jpg';
import terraza from '../assets/fotos/restaurante-costa-vicentina-vertical-09.jpg';
import paella from '../assets/fotos/restaurante-costa-vicentina-vertical-05.jpg';
import polvo from '../assets/fotos/restaurante-costa-vicentina-vista-2-02.jpg';
import cataplana from '../assets/fotos/restaurante-costa-vicentina-vertical-10.jpg';
import copas from '../assets/fotos/restaurante-costa-vicentina-vertical-07.jpg';
import fachadaNoche from '../assets/fotos/restaurante-costa-vicentina-vertical-01.jpg';
import fachadaDia from '../assets/fotos/restaurante-costa-vicentina-vertical-03.jpg';
import calle from '../assets/fotos/restaurante-costa-vicentina-vertical-08.jpg';
import comedor from '../assets/fotos/restaurante-costa-vicentina-vertical-04.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description = BUSINESS.description;

const galeria = [
	{
		src: terraza,
		alt: 'Terraza de BonaVentura en la Rua dos Correeiros, con manteles estampados de azulejo y sombrilla azul',
	},
	{
		src: paella,
		alt: 'Arroz de marisco en paellera negra con limón, y detrás un plato de pulpo a la parrilla',
	},
	{
		src: polvo,
		alt: 'Polvo grelhado con patata cocida, cebolla y aceite de oliva en un plato blanco',
	},
	{
		src: cataplana,
		alt: 'Cataplana de cobre con patata, almejas y mejillones, con cilantro y pan al lado',
	},
	{
		src: copas,
		alt: 'Jarra de cerveza Super Bock y copa de vino blanco en una mesa de la terraza',
	},
	{
		src: fachadaNoche,
		alt: 'Fachada de BonaVentura Wine & Food de noche, en la Rua dos Correeiros, con el comedor al fondo',
	},
	{
		src: fachadaDia,
		alt: 'Terraza y escaparate de BonaVentura Wine & Food a la luz del día, con el cajero automático al lado',
	},
	{
		src: calle,
		alt: 'Pizarra de la casa en la Rua dos Correeiros con los platos a la brasa y mesas preparadas',
	},
	{
		src: comedor,
		alt: 'Comedor interior con azulejo, lámparas de cuerda y un gran reloj de pared sobre la pared de mosaico',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.fullName,
	alternateName: [
		BUSINESS.name,
		BUSINESS.alsoKnownAs,
		'Restaurante Costa Vicentina Lisboa',
		'BonaVentura Rua dos Correeiros',
	],
	slogan: 'Wine & food en la Baixa',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 21 346 0905',
	currenciesAccepted: 'EUR',
	priceRange: '€€',
	servesCuisine: ['Portuguesa', 'Marisco', 'Internacional'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Baixa pombalina' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:45',
			closes: '23:45',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Costa Vicentina · Marisco y brasa en la Baixa (Lisboa)';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#173a5e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Source+Sans+3:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Costa Vicentina, Restaurante Costa Vicentina, BonaVentura Wine & Food, restaurante Rua dos Correeiros, comer en la Baixa Lisboa, arroz de marisco Lisboa, polvo grelhado Lisboa, cataplana Lisboa, restaurante Baixa pombalina, Rua dos Correeiros 37, marisco Lisboa centro"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Costa Vicentina · Marisco y brasa en la Baixa"
			ogDescription="Arroz de marisco, polvo grelhado, cataplana y bifes a la brasa en la Rua dos Correeiros 37. De martes a domingo, de 11:45 a 23:45. Tel. 21 346 0905."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bife a la parrilla con patatas fritas y vino en Costa Vicentina, Rua dos Correeiros 37, Lisboa"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#173a5e"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone="+351213460905"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.municipality}`}
			countryName="Portugal"
			contact={{
				street: BUSINESS.street,
				locality: `${BUSINESS.city}, ${BUSINESS.municipality}`,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				phone: '+351 21 346 0905',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[bife]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Wine & food · Baixa"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="R. dos Correeiros, 37 · Baixa · Lisboa"
				title="Marisco y brasa<br /><em>en plena Baixa.</em>"
				lede="Costa Vicentina es el nombre de siempre de esta casa de la Rua dos Correeiros, hoy rotulada como BonaVentura Wine & Food: mesas de mantel estampado en la calle, un comedor de azulejo con lámparas de cuerda y una cocina de arroz de marisco, polvo grelhado, cataplana y bifes a la brasa. Abre de martes a domingo, de 11:45 a 23:45, sin cerrar al mediodía."
				image={bife}
				imageAlt="Bife a la parrilla con patatas fritas, ensalada y dos copas de vino en una mesa de Costa Vicentina, Lisboa"
				primaryCta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Wine & food"
				facts={[
					{ label: 'Nota', html: '<b>2,5 en Google</b> con 312 reseñas' },
					{ label: 'Martes a domingo', html: '<b>11:45 – 23:45</b>' },
					{ label: 'Precio medio', html: '<b>15 €</b>' },
					{ label: 'Lunes', html: '<b>Cerrado</b>' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Costa Vicentina" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Azulejo, mantel<br /><em>y brasa en la calle.</em>"
				paragraphs={[
					'El restaurante está en la R. dos Correeiros, 37, en la freguesia de São Nicolau, en plena Baixa pombalina: la calle que va de la Rua Augusta a la Praça da Figueira, a pocos minutos del Terreiro do Paço y del Elevador de Santa Justa. La casa tiene dos caras: la terraza de la calle, con manteles estampados de azulejo y sillas de plástico bajo una sombrilla azul, y el comedor interior, de suelo de baldosa, zócalo de azulejo y lámparas de cuerda colgando del techo.',
					'De la cocina salen los platos que se ven en las fotos del perfil: el arroz de marisco servido en paellera negra con su rodaja de limón, el polvo grelhado con patata cocida, cebolla y un buen chorro de aceite, la cataplana de cobre con patata, almejas y mejillones, y el bife a la parrilla con patatas fritas y ensalada. La pizarra de la calle anuncia además parrillada mixta y carnes a la brasa, y en la mesa no faltan las aceitunas, la mantequilla y el pan.',
					'El local se anuncia hoy como BonaVentura Wine & Food en el rótulo y en la pizarra, mientras Google mantiene el nombre histórico de Restaurante Costa Vicentina; son la misma casa y la misma dirección. La carta de vinos portugueses es una parte importante de la propuesta, y también hay cerveza, sangría y servicio para llevar y a domicilio.',
				]}
				note="La ficha de Google no publica carta con precios ni web propia: solo el teléfono, el 21 346 0905. El precio medio que manejan las guías locales ronda los 15 €. La valoración es de 2,5 sobre 5 con 312 reseñas, y de accesibilidad solo consta un dato, negativo: no hay aparcamiento adaptado."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Arroz de marisco,<br />polvo<br /><em>y brasa.</em>"
				description="No hay carta publicada con precios: estos son los platos que aparecen en las fotos del perfil de Google, los que cita la pizarra de la calle y los que repiten las reseñas."
				cta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Costa Vicentina no publica su carta en Google y esta web no inventa nombres ni precios. Las guías de la ciudad le dan un precio medio de unos 15 € por persona; para la carta del día y las sugerencias de la pizarra, lo más rápido es llamar al 21 346 0905 o preguntar al llegar."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La terraza,<br />el comedor<br /><em>y la mesa.</em>"
				description="Estas fotografías proceden del perfil de Costa Vicentina en Google Maps: la terraza con manteles de azulejo, el arroz de marisco en la paellera, el polvo grelhado, la cataplana de cobre, la jarra de cerveza y la copa de vino, la fachada de BonaVentura de noche y de día, la pizarra en la calle y el comedor con el gran reloj de pared."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="R. dos Correeiros, 37 · 1100-166 Lisboa"
				title="A dos pasos<br /><em>de la Rua Augusta.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'São Nicolau · Baixa pombalina',
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="Cierra los lunes. De martes a domingo abre de 11:45 a 23:45, sin pausa entre la comida y la cena. En festivos el horario puede cambiar: si vas en una fecha señalada, llama antes al 21 346 0905."
				mapTitle="Mapa de Costa Vicentina en la R. dos Correeiros, 37, Lisboa"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Costa Vicentina · Baixa, Lisboa"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 21 346 0905. El local ofrece servicio para llevar, reparto a domicilio y catering, tiene aire acondicionado, cobra con tarjeta y cuenta con zona de fumadores. De accesibilidad solo consta que no hay aparcamiento adaptado; en la Baixa lo práctico es llegar en metro hasta Baixa-Chiado y andar."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>sentarse.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Costa Vicentina"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
