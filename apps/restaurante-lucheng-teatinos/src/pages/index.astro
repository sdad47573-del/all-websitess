---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/restaurante-lucheng-teatinos-apaisada-02.jpg';
import fachada from '../assets/fotos/restaurante-lucheng-teatinos-apaisada-01.jpg';
import ensalada from '../assets/fotos/restaurante-lucheng-teatinos-vertical-03.jpg';
import polloVerduras from '../assets/fotos/restaurante-lucheng-teatinos-vertical-04.jpg';
import arroz from '../assets/fotos/restaurante-lucheng-teatinos-vertical-05.jpg';
import polloAlmendras from '../assets/fotos/restaurante-lucheng-teatinos-vertical-06.jpg';
import ternera from '../assets/fotos/restaurante-lucheng-teatinos-vertical-07.jpg';
import rollo from '../assets/fotos/restaurante-lucheng-teatinos-vertical-09.jpg';
import flan from '../assets/fotos/restaurante-lucheng-teatinos-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const title = 'Restaurante Lucheng Teatinos · Cocina china en Málaga';
const description = BUSINESS.description;

const galeria = [
	{
		src: fachada,
		alt: 'Fachada del Lucheng en la calle de Demóstenes, con el letrero rojo «Restaurante Chino Lu Cheng 鹿城酒家», el toldo amarillo con el teléfono y la puerta abierta',
	},
	{
		src: arroz,
		alt: 'Arroz frito tres delicias con huevo, jamón, zanahoria y guisantes, servido en un plato blanco',
	},
	{
		src: ternera,
		alt: 'Ternera con cebolla en salsa oscura, servida en un plato blanco con una cuchara de metal',
	},
	{
		src: polloAlmendras,
		alt: 'Pollo con almendras, setas y zanahoria en salsa, en un plato hondo blanco sobre mantel de encaje',
	},
	{
		src: rollo,
		alt: 'Rollo de primavera abierto por la mitad, con el relleno de col y zanahoria a la vista',
	},
	{
		src: ensalada,
		alt: 'Ensalada china de lechuga, zanahoria en tiras, cebolla y surimi en un bol blanco',
	},
	{
		src: polloVerduras,
		alt: 'Salteado de pollo con setas, zanahoria y pimiento verde en un plato hondo',
	},
	{
		src: flan,
		alt: 'Flan con nata y caramelo servido en una copa de metal sobre un plato decorado',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante-lucheng-teatinos`,
	name: BUSINESS.name,
	alternateName: ['Lucheng Teatinos', 'Lu Cheng Teatinos', 'Restaurante Lu Cheng Málaga'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['China', 'Asiática'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '13:00',
			closes: '16:15',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '20:00',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Tuesday',
			opens: '20:30',
			closes: '23:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17120f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Lucheng Teatinos, Lu Cheng Málaga, chino Teatinos, restaurante chino Málaga, C. de Demóstenes 15, comida china Teatinos, arroz tres delicias Málaga, pollo con almendras Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina china en la calle de Demóstenes 15, Teatinos-Universidad. Todos los días de 13:00 a 16:15 y de 20:00 a 23:30. 4,0 sobre 5 con 548 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Comedor del Restaurante Lucheng Teatinos con manteles blancos y sillas de madera con cojín rojo"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#17120f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Teatinos, Málaga"
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Lucheng"
			subtitle="Cocina china · Teatinos"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.neighbourhood}`}
				title="Cocina china <br /><em>de siempre.</em>"
				lede={`El Restaurante Lucheng Teatinos está en la calle de Demóstenes 15, en Teatinos-Universidad, a unos minutos del campus. Abre todos los días de 13:00 a 16:15 y de 20:00 a 23:30, y la ficha de Google le da 4,0 sobre 5 con 548 reseñas.`}
				image={comedor}
				imageAlt="Comedor del Restaurante Lucheng con manteles blancos de encaje, sillas de madera con cojín rojo y la barra iluminada al fondo"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,0</b> en Google · 548 reseñas' },
					{ label: 'Horario', html: '<b>13:00–16:15</b><br />20:00–23:30, todos los días' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> contacto publicado` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas del Restaurante Lucheng Teatinos" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Lu Cheng, <br /><em>en Teatinos.</em>"
				paragraphs={[
					'El Lucheng es un restaurante chino de barrio en la calle de Demóstenes 15, dentro de Teatinos-Universidad y a pocos minutos del campus de la Universidad de Málaga. Google lo clasifica como restaurante chino y le da 4,0 sobre 5 con 548 reseñas.',
					'La fachada es la de siempre: el letrero rojo «Restaurante Chino Lu Cheng» con los caracteres 鹿城酒家, el toldo amarillo con el teléfono y la puerta abierta a un comedor de manteles blancos de encaje, sillas de madera con cojín rojo y una barra al fondo.',
					'En las fotos del perfil aparecen la ensalada china de lechuga, zanahoria y surimi, el arroz frito tres delicias, la ternera con cebolla, el pollo con almendras y setas, el pollo con verduras, el rollo de primavera y el flan con nata. Es la cocina china de toda la vida, sin adornos.',
					'La ficha marca acceso para sillas de ruedas y asientos adaptados, aunque no aparcamiento adaptado. El restaurante no tiene web propia ni publica su carta en Google, así que aquí no se dan precios: lo que hay es lo que se ve en las fotos y lo que se pregunta por teléfono.',
				]}
				note="La información sale de la ficha pública de Google Maps y de las fotografías del perfil del restaurante. No hay web oficial ni carta publicada: si algo cambia, manda lo que digan en el local o por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver la casa en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La mesa"
				title="Wok, arroces <br /><em>y sobremesa.</em>"
				description="La ficha de Google no publica la carta de este Lucheng. Estos son los platos que aparecen en las fotografías del perfil y la familia de guisos que se repite en la cocina china de la casa."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="No hay carta oficial publicada ni precios del local, así que esta lista es orientativa: sirve para reconocer los platos de las fotos, no para cerrar una cuenta. Para saber qué hay ese día, llama al restaurante."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Ocho fotos <br /><em>de la casa.</em>"
				description="Las fotografías del perfil del Restaurante Lucheng Teatinos en Google Maps: la fachada, el comedor y los platos que salen de la cocina."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a <br /><em>Demóstenes.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.neighbourhood} · ${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Málaga, España',
				]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: comidas de 13:00 a 16:15 y cenas de 20:00 a 23:30. El martes la cena empieza a las 20:30. En festivos puede cambiar, así que llama antes si vas en día señalado."
				mapTitle="Mapa del Restaurante Lucheng Teatinos en la calle de Demóstenes 15, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Lucheng · Teatinos"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. La ficha no publica un sistema de reservas ni una web del restaurante, así que el teléfono es el canal directo para mesa, para recoger o para preguntar por la carta del día."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces del Restaurante Lucheng Teatinos"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
