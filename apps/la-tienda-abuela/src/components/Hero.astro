---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES } from '../data/site';
---

<section id="inicio" class="hero-abuela relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.googleMaps}
			alt="La Tienda de la Abuela, tienda de alimentación en Avenida Pepita Durán 17, Málaga"
			widths={[400, 540]}
			sizes="100vw"
			quality={78}
			loading="eager"
			format="webp"
			class="h-full w-full object-cover opacity-30"
		/>
		<div class="from-neutral/85 via-neutral/25 absolute inset-0 bg-gradient-to-r"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-32">
		<div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
			<div>
				<p
					class="text-accent inline-flex items-center gap-2 text-xs font-semibold tracking-[0.22em] uppercase"
				>
					<i class="ri-map-pin-line"></i>
					{BUSINESS.district} · {BUSINESS.city}
				</p>
				<h1
					class="font-display mt-4 text-4xl leading-[1.05] font-extrabold sm:text-5xl lg:text-6xl"
				>
					La Tienda de<br />
					<span class="text-accent">la Abuela</span>
				</h1>
				<p class="font-display mt-3 text-xl font-semibold text-white/85 sm:text-2xl">
					Tu tienda de barrio en Puerto de la Torre
				</p>
				<p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80">
					Alimentación, fruta y charcutería en Puerto de la Torre, Málaga; con bocadillos, café para
					llevar y atención cercana. Pásate por <strong class="text-white"
						>Avenida Pepita Durán, 17</strong
					>: te atendemos con la cercanía de siempre.
				</p>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-secondary btn-lg gap-2 rounded-full">
						<i class="ri-phone-line"></i>
						Llamar al {BUSINESS.phoneDisplay}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline btn-lg hover:text-neutral rounded-full border-white/40 bg-white/5 text-white hover:border-white hover:bg-white"
					>
						<i class="ri-map-pin-line"></i> Cómo llegar
					</a>
				</div>

				<dl class="mt-10 grid max-w-lg grid-cols-2 gap-x-6 gap-y-5">
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Lunes a viernes</dt>
						<dd class="font-display mt-1 text-xl font-bold">6:30 – 21:00</dd>
					</div>
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Fin de semana</dt>
						<dd class="font-display mt-1 text-xl font-bold">9:00 – 14:00</dd>
					</div>
				</dl>
				<p class="mt-4 text-xs text-white/55">
					Horario según directorios consultados; llama para confirmar.
				</p>
			</div>

			<figure class="relative hidden lg:block">
				<div
					class="etiqueta-abuela rounded-box rotate-2 overflow-hidden shadow-2xl ring-1 ring-white/15"
				>
					<Image
						src={IMAGES.googleMaps}
						alt="Foto de la ficha de Google Maps de La Tienda de la Abuela en Málaga"
						widths={[400, 540]}
						sizes="(min-width: 1024px) 34vw, 90vw"
						quality={86}
						loading="eager"
						class="aspect-[9/16] w-full object-cover"
					/>
				</div>
				<figcaption
					class="font-display text-accent rounded-box bg-neutral absolute -bottom-5 -left-4 px-5 py-3 text-lg font-bold shadow-xl"
				>
					Pepita Durán, 17
				</figcaption>
			</figure>
		</div>
	</div>
</section>
