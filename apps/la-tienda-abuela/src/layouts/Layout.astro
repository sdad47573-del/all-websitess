---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../data/site';
import 'remixicon/fonts/remixicon.css';
import '../styles/index.css';

import { BUSINESS, IMAGES, SCHEMA } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	/** Ruta para canonical y og:url. */
	path?: string;
	keywords?: string;
	schema?: unknown[];
	noIndex?: boolean;
}

const {
	title = `La Tienda de la Abuela · Tienda de alimentación en Puerto de la Torre, Málaga`,
	description = `Tienda de alimentación de barrio en Av. Pepita Durán 17, Puerto de la Torre (Málaga): fruta, charcutería, bocadillos, tablas de ibéricos y café para llevar. Tel. ${BUSINESS.phoneDisplay}.`,
	path = '/',
	keywords = 'La Tienda de la Abuela Málaga, tienda alimentación Puerto de la Torre, Avenida Pepita Durán 17, charcutería Málaga, fruta y verdura Málaga, tablas de ibéricos Málaga, bocadillos Málaga',
	schema = [],
	noIndex = false,
} = Astro.props;

const canonical = new URL(path, BUSINESS.siteUrl).toString();
const ogImage = new URL(IMAGES.googleMaps.src, BUSINESS.siteUrl).toString();
const datosEstructurados = [{ ...SCHEMA, image: ogImage }, ...schema];
const robots = noIndex
	? 'noindex, follow'
	: 'index, follow, max-image-preview:large, max-snippet:-1';
---

<!doctype html>
<html lang="es" data-theme="abuela" prefix="og: https://ogp.me/ns# place: https://ogp.me/ns/place#">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="La Tienda de la Abuela" />
		<meta name="robots" content={robots} />
		<meta name="theme-color" content="#28513B" />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={BUSINESS.name} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content={String(IMAGES.googleMaps.width)} />
		<meta property="og:image:height" content={String(IMAGES.googleMaps.height)} />
		<meta
			property="og:image:alt"
			content={`${BUSINESS.name}, tienda de alimentación en Puerto de la Torre, Málaga`}
		/>
		<meta property="og:locale" content="es_ES" />
		<meta property="og:street-address" content={BUSINESS.street} />
		<meta property="og:locality" content={BUSINESS.city} />
		<meta property="og:region" content={BUSINESS.region} />
		<meta property="og:postal-code" content={BUSINESS.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content="+34 669 73 12 51" />
		<meta property="place:location:latitude" content={String(BUSINESS.geo.lat)} />
		<meta property="place:location:longitude" content={String(BUSINESS.geo.lng)} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={`${BUSINESS.name}, tienda de barrio en Málaga`} />

		<meta name="geo.region" content="ES-AN" />
		<meta name="geo.placename" content={BUSINESS.city} />
		<meta name="geo.position" content={`${BUSINESS.geo.lat};${BUSINESS.geo.lng}`} />
		<meta name="ICBM" content={`${BUSINESS.geo.lat}, ${BUSINESS.geo.lng}`} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Outfit:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>

		{
			datosEstructurados.map((bloque) => (
				<script type="application/ld+json" is:inline set:html={JSON.stringify(bloque)} />
			))
		}
	</head>
	<body class="bg-base-100 text-base-content font-sans antialiased">
		<slot />
	<WhatsappFab phone={datos.BUSINESS.phoneHref} name={datos.BUSINESS?.name} />
	</body>
</html>
