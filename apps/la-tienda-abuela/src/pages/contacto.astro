---
import Contact from '../components/Contact.astro';
import Fab from '../components/Fab.astro';
import Footer from '../components/Footer.astro';
import Topbar from '../components/Topbar.astro';
import { breadcrumbs } from '../data/schema';
import { BUSINESS } from '../data/site';
import Layout from '../layouts/Layout.astro';

const contactSchema = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	'@id': `${BUSINESS.siteUrl}/contacto#contacto`,
	name: `Contacto y ubicación de ${BUSINESS.name} en ${BUSINESS.city}`,
	inLanguage: 'es',
	url: `${BUSINESS.siteUrl}/contacto`,
	mainEntity: { '@type': 'GroceryStore', '@id': `${BUSINESS.siteUrl}/` },
};
---

<Layout
	title={`Contacto y ubicación | ${BUSINESS.name} en ${BUSINESS.district}, Málaga`}
	description={`Encuentra La Tienda de la Abuela en Avenida Pepita Durán 17, Puerto de la Torre, Málaga. Teléfono ${BUSINESS.phoneDisplay}; abre la ubicación y consulta el horario.`}
	path="/contacto"
	schema={[
		contactSchema,
		breadcrumbs([
			{ name: 'Inicio', path: '/' },
			{ name: 'Contacto', path: '/contacto' },
		]),
	]}
>
	<Topbar base="/" />
	<main>
		<section class="hero-abuela text-white">
			<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
				<nav class="mb-6 text-xs text-white/60" aria-label="Migas de pan">
					<a href="/" class="hover:text-accent">Inicio</a><span class="mx-2">/</span><span
						class="text-white/90">Contacto</span
					>
				</nav>
				<span class="text-accent text-xs font-semibold tracking-[0.2em] uppercase"
					>Contacto y cómo llegar</span
				>
				<h1 class="font-display mt-3 text-4xl font-bold sm:text-5xl">
					Estamos en {BUSINESS.district}, Málaga
				</h1>
				<div class="abuela-divider mt-5 h-px w-32"></div>
				<p class="mt-6 max-w-3xl leading-relaxed text-white/75">
					Visita La Tienda de la Abuela en {BUSINESS.street}. Llama para consultar el horario y
					confirmar que encuentras lo que necesitas.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-secondary gap-2 rounded-full"
						><i class="ri-phone-line"></i>{BUSINESS.phoneDisplay}</a
					>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline rounded-full border-white/40 bg-white/5 text-white"
						><i class="ri-map-pin-line"></i>Abrir en Google Maps</a
					>
				</div>
			</div>
		</section>
		<Contact />
	</main>
	<Footer />
	<Fab />
</Layout>
