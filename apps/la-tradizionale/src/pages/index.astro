---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/la-tradizionale-apaisada-05.jpg';
import esquina from '../assets/fotos/la-tradizionale-apaisada-01.jpg';
import pizzas from '../assets/fotos/la-tradizionale-apaisada-04.jpg';
import porcion from '../assets/fotos/la-tradizionale-apaisada-02.jpg';
import obrador from '../assets/fotos/la-tradizionale-apaisada-06.jpg';
import noche from '../assets/fotos/la-tradizionale-apaisada-07.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const title = 'La Tradizionale · Pizzería italiana en la calle Feria';
const description = BUSINESS.description;

const galeria = [
	{
		src: pizzas,
		alt: 'Dos pizzas enteras sobre tablas de madera: una con tomate, aceitunas y pimientos y otra con pepperoni, pollo y bacon',
	},
	{
		src: porcion,
		alt: 'Porción de pizza de queso sobre papel kraft junto a dos rollos de pizza y servilletas',
	},
	{
		src: esquina,
		alt: 'Fachada de la pizzería en la calle Feria, con el cartel de porciones de pizza a 2 € y gente esperando en la puerta',
	},
	{
		src: obrador,
		alt: 'Pizzaiolo estirando la masa de una pizza en el obrador, con las cajas de La Tradizionale en las estanterías',
	},
	{
		src: noche,
		alt: 'Exterior de la pizzería de noche, con el rótulo iluminado y clientes comiendo de pie en las mesas altas',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-tradizionale`,
	name: BUSINESS.fullName,
	alternateName: ['Pizzería La Tradizionale', 'La Tradizionale Sevilla', 'Pizza al corte calle Feria'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Pizza', 'Italiana', 'Comida para llevar'],
	areaServed: [
		{ '@type': 'City', name: 'Sevilla' },
		{ '@type': 'AdministrativeArea', name: 'Casco Antiguo' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	hasMenu: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	acceptsReservations: false,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '02:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1a1512" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,600&family=Mulish:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="La Tradizionale Sevilla, pizzería calle Feria, pizza al corte Sevilla, porciones de pizza 2 euros, pizzería italiana Casco Antiguo, pizza para llevar Sevilla, pasteles helados"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pizza al corte y pizzas de dos tamaños con masa artesana en la calle Feria 96, Sevilla. Pasteles helados y café. Todos los días de 13:00 a 2:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de la Pizzería La Tradizionale en la calle Feria de Sevilla"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#1a1512"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Calle Feria, Sevilla"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Tradizionale"
			subtitle="Pizzería · Calle Feria"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.neighbourhood}`}
				title="Pizza al corte <br /><em>en la calle Feria.</em>"
				lede="En el número 96 de la calle Feria, la pizzería de los carteles de «porciones de pizza a 2 €». Pizza al corte y pizzas de dos tamaños con masa artesana, además de pasteles helados y café. Abre todos los días de 13:00 a 2:00 y tiene 4,6 sobre 5 con 3.125 reseñas."
				image={fachada}
				imageAlt="Fachada de cristaleras de La Tradizionale al atardecer, con el rótulo de pizzería y el teléfono para encargar pizzas"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> en Google · 3.125 reseñas' },
					{ label: 'Horario', html: '<b>13:00–2:00</b><br />Todos los días' },
					{ label: 'Teléfono', html: `<b>955 28 13 74</b> encarga tu pizza` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de La Tradizionale" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Al corte <br /><em>y a la italiana.</em>"
				paragraphs={[
					'La Tradizionale está en el número 96 de la calle Feria, en el Casco Antiguo, con el rótulo de «Pizzería La Tradizionale» y el cartel de porciones en la puerta. La ficha de Google la clasifica como pizzería, restaurante italiano y pizza para llevar.',
					'La casa trabaja la pizza al corte: la porción se sirve al momento y también se puede llevar. Hay además pizzas de dos tamaños con masa artesana. En las fotos del perfil aparecen las pizzas enteras sobre tabla, la porción junto a los rollos de pizza y el obrador donde se estira la masa.',
					'Las reseñas repiten las porciones, la masa y los postres: «porciones de pizza a 2 € enormes y muy ricas y elaboradas», «maravillosas pizzas y exquisitas y de dos tamaños, masa buenísima» y «buena variedad de pasteles helados y buen café a un precio razonable». Con 4,6 sobre 5 y 3.125 reseñas, es una de las pizzerías con más valoraciones de Sevilla.',
					'Abre todos los días de 13:00 a 2:00: se puede comer desde el mediodía y cerrar de madrugada, que es cuando la calle Feria se llena. En festivos el horario puede cambiar.',
				]}
				note="La información sale de la ficha pública de Google Maps y de las fotos del perfil del establecimiento. La ficha no publica carta ni precios: confirma platos y precios en el local o por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver la casa en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Porciones, pizzas <br /><em>y dolci.</em>"
				description="La ficha no publica carta con precios. La lista sale de las categorías de Google, de las fotos del perfil y de lo que destacan las reseñas: pizza al corte, pizzas de dos tamaños, pasteles helados y café."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="No hay carta oficial publicada ni precios en la ficha, así que esta lista es orientativa: sirve para reconocer lo que se sirve aquí, no para cerrar una cuenta. El precio de la porción que recuerda una reseña puede haber cambiado: confírmalo en el local."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La pizzería <br /><em>y la calle.</em>"
				description="Las fotografías del perfil de La Tradizionale: las pizzas enteras, la porción con los rollos, la fachada de día y de noche y el obrador donde se estira la masa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a <br /><em>la Feria, 96.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.neighbourhood} · ${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Sevilla, España',
				]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: todos los días de 13:00 a 2:00. En festivos puede cambiar; la ficha avisa, por ejemplo, del día de Todos los Santos."
				mapTitle="Mapa de La Tradizionale en la calle Feria 96, Sevilla"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Feria, 96 · Sevilla"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. Para encargar pizzas o preguntar por las porciones del día, llama al teléfono de la pizzería: es el canal directo. El local también anuncia «pizza para llevar»."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de La Tradizionale"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
