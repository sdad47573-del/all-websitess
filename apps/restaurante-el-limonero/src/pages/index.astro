---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/restaurante-el-limonero-apaisada-01.jpg';
import arroz from '../assets/fotos/restaurante-el-limonero-apaisada-02.jpg';
import paella from '../assets/fotos/restaurante-el-limonero-cuadrada-03.jpg';
import noche from '../assets/fotos/restaurante-el-limonero-apaisada-04.jpg';
import fideua from '../assets/fotos/restaurante-el-limonero-vertical-05.jpg';
import piscina from '../assets/fotos/restaurante-el-limonero-apaisada-06.jpg';
import desayuno from '../assets/fotos/restaurante-el-limonero-apaisada-07.jpg';
import terrazaPiscina from '../assets/fotos/restaurante-el-limonero-apaisada-08.jpg';
import bogavante from '../assets/fotos/restaurante-el-limonero-apaisada-09.jpg';
import brunch from '../assets/fotos/restaurante-el-limonero-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Restaurante El Limonero, café-bar y restaurante en Carrer les Argelagues, 15 (Sant Josep de sa Talaia, Ibiza). Cocina mediterránea, arroces, marisco y desayunos junto a la piscina. Tel. 971 30 04 66.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de El Limonero con el toldo «Café · Bar El Limonero Restaurante» y limones dibujados, con mesas en la terraza',
	},
	{
		src: noche,
		alt: 'Terraza de El Limonero de noche, con sombrillas blancas, limoneros en maceta y el rótulo iluminado',
	},
	{
		src: piscina,
		alt: 'Piscina del complejo con sombrillas blancas, tumbonas y palmeras alrededor',
	},
	{
		src: terrazaPiscina,
		alt: 'Terraza de El Limonero junto a la piscina, con mesas y sombrillas blancas sobre suelo de baldosa',
	},
	{
		src: paella,
		alt: 'Paella de marisco con mejillones, langostinos y gajos de limón servida en la paellera',
	},
	{
		src: arroz,
		alt: 'Arroz de marisco con langostinos, mejillones y almejas en una sartén',
	},
	{
		src: fideua,
		alt: 'Fideuá con langostinos y mejillones junto a la piscina, con una copa de sangría al lado',
	},
	{
		src: bogavante,
		alt: 'Bogavante con patatas, huevos fritos y pimiento en una sartén',
	},
	{
		src: desayuno,
		alt: 'Desayuno completo con huevos fritos, bacon, salchicha, alubias, hash brown, tostadas, tortitas y café',
	},
	{
		src: brunch,
		alt: 'Bagel con aguacate y salmón, crepes y huevos con salmón ahumado en la terraza',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-limonero`,
	name: BUSINESS.name,
	alternateName: ['El Limonero', 'Café Bar El Limonero', 'El Limonero Ibiza', 'El Limonero Sant Josep'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 971 30 04 66',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Española'],
	areaServed: [
		{ '@type': 'City', name: 'Sant Josep de sa Talaia' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'El Limonero · Café, bar y restaurante con piscina en Ibiza';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-el-limonero-apaisada-01.jpg": fachada,
	"restaurante-el-limonero-apaisada-04.jpg": noche,
	"restaurante-el-limonero-apaisada-06.jpg": piscina,
	"restaurante-el-limonero-apaisada-08.jpg": terrazaPiscina,
	"restaurante-el-limonero-cuadrada-03.jpg": paella,
	"restaurante-el-limonero-apaisada-02.jpg": arroz,
	"restaurante-el-limonero-vertical-05.jpg": fideua,
	"restaurante-el-limonero-apaisada-09.jpg": bogavante,
	"restaurante-el-limonero-apaisada-07.jpg": desayuno,
	"restaurante-el-limonero-vertical-10.jpg": brunch,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#5d6b3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Literata:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Public+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Limonero Ibiza, restaurante El Limonero, café bar Sant Josep de sa Talaia, comer junto a la piscina Ibiza, paella Ibiza, desayunos Ibiza, Carrer les Argelagues"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="El Limonero · Café, bar y restaurante con piscina en Ibiza"
			ogDescription="Cocina mediterránea, arroces de marisco, bogavante y desayunos en la terraza junto a la piscina. Carrer les Argelagues, 15 (Ibiza). Tel. 971 30 04 66."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Terraza de El Limonero con sombrillas blancas junto a la piscina"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#5d6b3a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			phone="+34971300466"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Limonero"
			subtitle="Café · bar · restaurante · Ibiza"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a El Limonero"
		/>
	</body>
</html>
