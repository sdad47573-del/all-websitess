---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import terraza from '../assets/fotos/restaurante-vista-al-puerto-apaisada-01.jpg';
import entrecot from '../assets/fotos/restaurante-vista-al-puerto-apaisada-02.jpg';
import pastaMarisco from '../assets/fotos/restaurante-vista-al-puerto-vertical-03.jpg';
import parrillada from '../assets/fotos/restaurante-vista-al-puerto-vertical-04.jpg';
import paella from '../assets/fotos/restaurante-vista-al-puerto-vertical-05.jpg';
import terrazaSol from '../assets/fotos/restaurante-vista-al-puerto-apaisada-06.jpg';
import salon from '../assets/fotos/restaurante-vista-al-puerto-apaisada-07.jpg';
import pescado from '../assets/fotos/restaurante-vista-al-puerto-vertical-09.jpg';
import ensalada from '../assets/fotos/restaurante-vista-al-puerto-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Restaurante Vista Al Puerto, en Carrer des Caló, 66 (Sant Agustí, Sant Josep de sa Talaia, Ibiza). Paellas, pescado a la plancha, carnes a la brasa y terraza bajo la parra. Tel. 871 11 02 79.';

const galeria = [
	{
		src: terraza,
		alt: 'Terraza de Vista Al Puerto bajo una pérgola cubierta de parra, con mesas de mantel blanco y sillas de madera junto a pilares de piedra',
	},
	{
		src: salon,
		alt: 'Comedor cubierto de Vista Al Puerto con sillas de mimbre, barra de madera y el toldo naranja de la terraza al fondo',
	},
	{
		src: terrazaSol,
		alt: 'Terraza exterior de Vista Al Puerto con mesas redondas, sillas de mimbre y el toldo blanco sobre la calle',
	},
	{
		src: paella,
		alt: 'Paella de marisco con carabineros, mejillones, almejas y limón servida en plato hondo',
	},
	{
		src: pastaMarisco,
		alt: 'Espaguetis con mejillones y langostinos junto a una cazuela de mejillones y una de gambas al ajillo',
	},
	{
		src: pescado,
		alt: 'Pescado entero a la plancha sobre bandeja metálica con patatas paja y pimiento rojo',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la brasa cortado en tiras con patatas panadera, calabacín, champiñón y espárrago',
	},
	{
		src: parrillada,
		alt: 'Parrillada de carne para compartir con entrecot, costilla y patatas en una fuente blanca',
	},
	{
		src: ensalada,
		alt: 'Ensalada César con escarola, picatostes, lascas de queso y tiras de pollo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#vista-al-puerto`,
	name: BUSINESS.name,
	alternateName: ['Vista Al Puerto', 'Vista al Puerto Ibiza', 'Restaurante Vista Al Puerto Sant Agustí'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 871 11 02 79',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Mediterránea', 'Marisco'],
	areaServed: [
		{ '@type': 'City', name: 'Sant Josep de sa Talaia' },
		{ '@type': 'AdministrativeArea', name: 'Sant Agustí des Vedrà' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '23:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Vista Al Puerto · Cocina española con terraza en Ibiza';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-vista-al-puerto-apaisada-01.jpg": terraza,
	"restaurante-vista-al-puerto-apaisada-07.jpg": salon,
	"restaurante-vista-al-puerto-apaisada-06.jpg": terrazaSol,
	"restaurante-vista-al-puerto-vertical-05.jpg": paella,
	"restaurante-vista-al-puerto-vertical-03.jpg": pastaMarisco,
	"restaurante-vista-al-puerto-vertical-09.jpg": pescado,
	"restaurante-vista-al-puerto-apaisada-02.jpg": entrecot,
	"restaurante-vista-al-puerto-vertical-04.jpg": parrillada,
	"restaurante-vista-al-puerto-vertical-10.jpg": ensalada,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1c4f63" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Vista Al Puerto Ibiza, restaurante Sant Agustí, comer en Sant Agustí, paella Ibiza, restaurante con terraza Ibiza, Carrer des Caló, pescado a la plancha Ibiza, carnes a la brasa Ibiza, Sant Josep de sa Talaia"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Vista Al Puerto · Cocina española con terraza en Ibiza"
			ogDescription="Paellas, pescado a la plancha, carnes a la brasa y una terraza bajo la parra en Sant Agustí (Ibiza). Carrer des Caló, 66. Tel. 871 11 02 79."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Terraza de Restaurante Vista Al Puerto bajo la parra, con mesas de mantel blanco"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1c4f63"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			phone="+34871110279"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[terraza]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Vista Al Puerto"
			subtitle="Cocina española · Sant Agustí, Ibiza"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Vista Al Puerto"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34871110279?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Sant%20Josep%20de%20sa%20Talaia." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Sant Josep de sa Talaia"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
