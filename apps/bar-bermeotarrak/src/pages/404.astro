---
const title = 'Página no encontrada | Bar Bermeotarrak';
const description = 'Esta página no existe en la web de Bar Bermeotarrak. Vuelve a la portada.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, follow" />
		<link rel="canonical" href="https://bar-bermeotarrak.vercel.app/" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content="https://bar-bermeotarrak.vercel.app/" />
		<meta property="og:image" content="https://bar-bermeotarrak.vercel.app/og.jpg" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<main>
			<p class="kicker">Error 404</p>
			<h1>Aquí no hay nada</h1>
			<p>{description}</p>
			<a href="/">← Volver a Bar Bermeotarrak</a>
		</main>
		<style>
			body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 1.5rem; font: 16px/1.7 system-ui, sans-serif; color: #4a4438; background: #faf7f0; }
			main { max-width: 32rem; text-align: center; }
			.kicker { color: #7a7466; font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
			h1 { font-family: Georgia, serif; font-weight: 500; }
			a { color: inherit; font-weight: 700; }
		</style>
	</body>
</html>
