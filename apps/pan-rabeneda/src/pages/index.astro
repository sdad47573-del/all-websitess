---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import fachada from '../assets/fotos/pan-rabeneda-vertical-01.jpg';
import fachadaRecorte from '../assets/fotos/pan-rabeneda-vertical-10.jpg';
import dulcesEvento from '../assets/fotos/pan-rabeneda-apaisada-02.jpg';
import tartaFutbol from '../assets/fotos/pan-rabeneda-apaisada-09.jpg';
import barras from '../assets/fotos/pan-rabeneda-vertical-08.jpg';
import bolleria from '../assets/fotos/pan-rabeneda-vertical-04.jpg';
import bombones from '../assets/fotos/pan-rabeneda-vertical-05.jpg';
import cajaEncargo from '../assets/fotos/pan-rabeneda-vertical-06.jpg';
import salados from '../assets/fotos/pan-rabeneda-vertical-07.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	MAPS,
	MENU,
	REVIEW_QUOTE,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'Pan Rabaneda · Panadería artesanal en Cruz de Humilladero, Málaga';
const description = BUSINESS.description;
const ratingLabel = BUSINESS.rating.toFixed(1).replace('.', ',');

const galeria = [
	{
		src: bolleria,
		alt: 'Bandejas de donuts glaseados y con chocolate junto a napolitanas y hojaldres con semillas',
		caption: 'Donuts, napolitanas y hojaldres recién hechos',
	},
	{
		src: dulcesEvento,
		alt: 'Mesa de dulces con gofres, donuts, bombones bañados en chocolate y tartas sobre bandejas doradas',
		caption: 'Mesa de dulces para una celebración',
	},
	{
		src: tartaFutbol,
		alt: 'Tarta de cumpleaños con crema verde, balones de fútbol de chocolate y una banda que dice Felicidades Francis',
		caption: 'Una tarta de encargo, con el nombre puesto',
	},
	{
		src: barras,
		alt: 'Barras de pan de corteza dorada alineadas en la rejilla de la panadería',
		caption: 'Las barras, en la rejilla del obrador',
	},
	{
		src: bombones,
		alt: 'Bombones de chocolate rellenos, tartas de galleta y esferas de chocolate con virutas blancas',
		caption: 'Bombones y dulces de vitrina',
	},
	{
		src: cajaEncargo,
		alt: 'Caja de encargo con donuts, gofres, un croissant, tarrinas de chocolate y mermelada y dos bebidas',
		caption: 'Una caja de encargo, preparada para llevar',
	},
	{
		src: salados,
		alt: 'Bandejas de croquetas y empanadas fritas de distintos rellenos en una caja de cartón',
		caption: 'Croquetas y frituras para una mesa',
	},
	{
		src: fachadaRecorte,
		alt: 'Rótulo negro de Pan Rabaneda con el gorro de chef y el escaparate iluminado del local',
		caption: 'El rótulo de la fachada, de noche',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#pan-rabeneda`,
	name: BUSINESS.name,
	alternateName: ['Rabaneda', 'Panadería Pan Rabaneda', 'Pan Rabaneda Málaga'],
	description:
		'Panadería artesanal en C. Almogía, 12 (Cruz de Humilladero, 29007 Málaga): pan, pasteles, tartas, desayunos, productos salados y encargos personalizados.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 665 51 15 10',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '07:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '17:00',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '07:00',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '07:30',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '17:00',
			closes: '20:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	makesOffer: [
		{ '@type': 'Offer', itemOffered: { '@type': 'Product', name: 'Pan artesanal' } },
		{ '@type': 'Offer', itemOffered: { '@type': 'Product', name: 'Pasteles y tartas' } },
		{ '@type': 'Offer', itemOffered: { '@type': 'Product', name: 'Desayunos' } },
		{ '@type': 'Offer', itemOffered: { '@type': 'Product', name: 'Productos salados' } },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: REVIEW_QUOTE,
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#mostrador' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#131b21" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Pan Rabaneda, panadería Cruz de Humilladero, panadería artesanal Málaga, tartas de encargo Málaga, pasteles Almogía 12, desayunos Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería artesanal en la calle Almogía, 12, Cruz de Humilladero. Pan, pasteles, tartas, desayunos, salados y encargos personalizados. Teléfono 665 51 15 10."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo iluminado de Pan Rabaneda en la calle Almogía, 12, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#131b21"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Pan Rabaneda, inicio">
					<span class="brand-mark" aria-hidden="true">
						PR
					</span>
					<span class="brand-name">
						Pan Rabaneda
						<small>Panadería artesanal · Málaga</small>
					</span>
				</a>
				<nav class="nav" aria-label="Navegación principal">
					{nav.map((item) => (
						<a href={item.href}>{item.label}</a>
					))}
				</nav>
				<a class="topbar-phone" href={BUSINESS.phoneHref}>
					<span class="topbar-phone-label">Encargos</span> {BUSINESS.phone}
				</a>
			</div>
			<nav class="mobile-nav wrap" aria-label="Navegación principal en móvil">
				{nav.map((item) => (
					<a href={item.href}>{item.label}</a>
				))}
			</nav>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-glow" aria-hidden="true"></div>
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Cruz de Humilladero · Málaga
						</p>
						<h1 id="hero-title">
							Pan <em>Rabaneda</em>
							<small>Obrador artesanal · Pastelería · Encargos</small>
						</h1>
						<p class="hero-lede">
							Pan del día, pasteles, tartas, desayunos y salados en la calle Almogía, 12. Un obrador
							de barrio que también prepara encargos personalizados para cumpleaños y celebraciones.
						</p>
						<div class="hero-actions">
							<a
								class="button button-primary"
								href={MAPS.directions}
								target="_blank"
								rel="noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="button button-ghost" href={BUSINESS.phoneHref}>
								Encargar · {BUSINESS.phone}
							</a>
						</div>
						<div class="hero-facts">
							<div>
								<span>Google</span>
								<strong>{ratingLabel} / 5</strong>
								<small>{BUSINESS.reviewsCount} reseñas</small>
							</div>
							<div>
								<span>Horario</span>
								<strong>Desde las 7:00</strong>
								<small>de lunes a domingo</small>
							</div>
							<div>
								<span>La casa</span>
								<strong>Encargos</strong>
								<small>tartas y packs por teléfono</small>
							</div>
						</div>
					</div>

					<figure class="hero-photo">
						<Image
							src={fachada}
							alt="Fachada de Pan Rabaneda de noche: rótulo negro con letras blancas y gorro de chef, escaparate iluminado y clientes en el mostrador"
							widths={[420, 640, 900, 1320]}
							sizes="(max-width: 980px) 92vw, 38vw"
							format="avif"
							quality={74}
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>
						<span class="hero-plaque" aria-hidden="true">
							<span>Pan</span>
							<span>Pasteles</span>
							<span>Tartas</span>
							<span>Encargos</span>
						</span>
						<figcaption>
							<span>Foto del perfil de Google Maps</span>
							<a href={MAPS.place} target="_blank" rel="noreferrer">
								Ver la ficha ↗
							</a>
						</figcaption>
					</figure>
				</div>
			</section>

			<section class="facts" aria-label="Datos de la ficha">
				<div class="wrap facts-grid">
					<div class="fact">
						<span class="fact-kicker">La ficha</span>
						<strong>{ratingLabel} / 5</strong>
						<p>{BUSINESS.reviewsCount} reseñas en Google.</p>
					</div>
					<div class="fact">
						<span class="fact-kicker">El teléfono</span>
						<strong>
							<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
						</strong>
						<p>El número publicado en Google.</p>
					</div>
					<div class="fact">
						<span class="fact-kicker">El horario</span>
						<strong>7:00–20:30</strong>
						<p>Con cierre de mediodía de lunes a jueves.</p>
					</div>
					<div class="fact">
						<span class="fact-kicker">El mostrador</span>
						<strong>Pan y dulce</strong>
						<p>Pasteles, tartas, desayunos y salados.</p>
					</div>
				</div>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<div class="about-head">
					<p class="section-label">
						<span aria-hidden="true"></span> La casa
					</p>
					<h2 id="about-title">
						Un obrador de barrio <em>con nombre propio.</em>
					</h2>
					<p>						Pan Rabaneda está en la calle Almogía, 12, en pleno barrio de Cruz de
						Humilladero. La panadería describe así su propio oficio en la ficha de
						Google: pan artesanal, pasteles, tartas, desayunos y salados, con
						encargos a medida.
					</p>
				</div>

				<div class="about-body">
					<div class="highlights-grid">
						{HIGHLIGHTS.map((item) => (
							<article class="highlight">
								<span class="highlight-number">{item.number}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>

					<figure class="about-photo">
						<Image
							src={fachadaRecorte}
							alt="Escaparate de Pan Rabaneda con la vitrina de dulces y las estanterías de bollería al fondo"
							widths={[360, 540, 720]}
							sizes="(max-width: 980px) 92vw, 26vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>La vitrina y el mostrador, desde la calle.</figcaption>
					</figure>
				</div>

				<blockquote class="owner-quote">
					<p>{BUSINESS.ownerNote}</p>
					<cite>Descripción del establecimiento en su ficha de Google</cite>
				</blockquote>

				<ul class="chips" aria-label="Lo que ofrece Pan Rabaneda">
					{SERVICIOS.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			</section>

			<section class="counter" id="mostrador" aria-labelledby="counter-title">
				<div class="wrap">
					<div class="counter-head">
						<div>
							<p class="section-label">
								<span aria-hidden="true"></span> El mostrador
							</p>
							<h2 id="counter-title">
								Del horno <em>a la vitrina.</em>
							</h2>
						</div>
						<p>
							La ficha no publica carta ni precios. Esto es lo que la panadería declara en su
							descripción de Google y lo que citan las reseñas y las fotos del perfil.
						</p>
					</div>

					<div class="menu-grid">
						{MENU.map((group) => (
							<article class="menu-card">
								<span class="menu-kicker">{group.kicker}</span>
								<h3>{group.title}</h3>
								<ul>
									{group.items.map((item) => (
										<li>
											<strong>{item.name}</strong>
											<span>{item.note}</span>
										</li>
									))}
								</ul>
							</article>
						))}
					</div>

					<div class="counter-note">
						<p>
							<strong>Sin carta ni precios publicados.</strong> Para saber qué hay cada día o cerrar
							un encargo, llama al
							<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a> o pasa por el mostrador.
						</p>
						<a class="button button-primary" href={BUSINESS.phoneHref}>
							Llamar a Rabaneda
						</a>
					</div>
				</div>
			</section>

			<section class="gallery wrap" id="fotos" aria-labelledby="gallery-title">
				<div class="gallery-head">
					<div>
						<p class="section-label">
							<span aria-hidden="true"></span> La casa en fotos
						</p>
						<h2 id="gallery-title">
							Dulce, salado <em>y de encargo.</em>
						</h2>
					</div>
					<p>
						Ocho vistas del perfil de Google Maps: la fachada, la vitrina, las bandejas de bollería,
						los salados y dos tartas hechas por encargo. Son imágenes del establecimiento, no de un
						banco de fotos.
					</p>
				</div>

				<div class="gallery-grid">
					{galeria.map((photo) => (
						<figure>
							<Image
								src={photo.src}
								alt={photo.alt}
								widths={[420, 640, 960, 1200]}
								sizes="(max-width: 700px) 92vw, 46vw"
								format="avif"
								quality={72}
								loading="lazy"
								decoding="async"
							/>
							<figcaption>{photo.caption}</figcaption>
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes del perfil del establecimiento en Google Maps. Si eres titular de alguna y
					quieres retirarla, escríbenos y la borramos.
				</p>
			</section>

			<section class="reviews" aria-labelledby="reviews-title">
				<div class="wrap reviews-grid">
					<div class="reviews-score">
						<span class="score-number">{ratingLabel}</span>
						<span class="score-stars" role="img" aria-label="4 de 5 estrellas">
							★★★★☆
						</span>
						<span class="score-count">{BUSINESS.reviewsCount} reseñas en Google</span>
					</div>
					<div class="reviews-copy">
						<p class="section-label section-label-light">
							<span aria-hidden="true"></span> Lo que dicen
						</p>
						<h2 id="reviews-title">
							«El pan buenísimo, <em>y las palmeras increíbles</em>»
						</h2>
						<div class="review-list">
							{REVIEWS.map((item) => (
								<figure>
									<blockquote>«{item.text}»</blockquote>
									<figcaption>{item.note}</figcaption>
								</figure>
							))}
						</div>
						<a class="reviews-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer las 83 reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label">
						<span aria-hidden="true"></span> Visítanos
					</p>
					<h2 id="visit-title">
						En la calle <em>Almogía.</em>
					</h2>
					<p class="address">
						{BUSINESS.street}
						<br />
						{BUSINESS.district}
						<br />
						{BUSINESS.postalCode} {BUSINESS.city}
					</p>

					<table class="hours">
						<caption>Horario de la ficha de Google</caption>
						<tbody>
							{HOURS.map((row) => (
								<tr>
									<th scope="row">{row.day}</th>
									<td>{row.value}</td>
								</tr>
							))}
						</tbody>
					</table>
					<p class="hours-note">
						Horario publicado por el establecimiento en Google, consultado el 28 de octubre de 2026.
						En festivos puede cambiar: confirma antes de ir.
					</p>

					<div class="visit-phone">
						<span>Teléfono y encargos</span>
						<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
					</div>

					<div class="visit-links">
						<a class="button button-primary" href={BUSINESS.phoneHref}>
							Llamar ahora
						</a>
						<a class="button button-ghost" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<p class="visit-note">
						La ficha indica acceso para sillas de ruedas, pero no detalla si hay aparcamiento
						adaptado. No consta reparto a domicilio ni venta online.
					</p>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Pan Rabaneda en la calle Almogía, 12, Cruz de Humilladero, Málaga"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Almogía, 12
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label">
					<span aria-hidden="true"></span> Preguntas frecuentes
				</p>
				<h2 id="faq-title">
					Antes de <em>entrar.</em>
				</h2>
				<div class="faq-list">
					{FAQ.map((item) => (
						<details>
							<summary>{item.q}</summary>
							<p>{item.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">
							PR
						</span>
						<p>
							Pan Rabaneda
							<small>
								Panadería artesanal · Pastelería · Encargos
								<br />
								{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}
							</small>
						</p>
					</div>
					<nav aria-label="Enlaces de Pan Rabaneda">
						<a href={MAPS.place} target="_blank" rel="noreferrer">
							Google Maps ↗
						</a>
