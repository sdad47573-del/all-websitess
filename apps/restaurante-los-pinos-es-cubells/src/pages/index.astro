---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import terrazaNoche from '../assets/fotos/restaurante-los-pinos-es-cubells-apaisada-01.jpg';
import gambas from '../assets/fotos/restaurante-los-pinos-es-cubells-vertical-02.jpg';
import gambasDetalle from '../assets/fotos/restaurante-los-pinos-es-cubells-vertical-03.jpg';
import costa from '../assets/fotos/restaurante-los-pinos-es-cubells-apaisada-04.jpg';
import mesa from '../assets/fotos/restaurante-los-pinos-es-cubells-vertical-05.jpg';
import terrazaSombrillas from '../assets/fotos/restaurante-los-pinos-es-cubells-vertical-06.jpg';
import pescado from '../assets/fotos/restaurante-los-pinos-es-cubells-vertical-07.jpg';
import terrazaDia from '../assets/fotos/restaurante-los-pinos-es-cubells-vertical-08.jpg';
import cordero from '../assets/fotos/restaurante-los-pinos-es-cubells-apaisada-09.jpg';
import postres from '../assets/fotos/restaurante-los-pinos-es-cubells-vertical-10.jpg';

import {
	AVISO,
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Restaurante Los Pinos, en Carre des LLombi 31 (07839 Es Cubells, Ibiza). Cocina española y terraza entre pinos. Tel. 971 80 21 86. La ficha de Google lo marca como cerrado temporalmente: confirma antes de ir.';

const galeria = [
	{
		src: terrazaNoche,
		alt: 'Terraza de Los Pinos al atardecer, bajo una pérgola de madera, con mesas de mantel blanco y sillas de mimbre',
	},
	{
		src: terrazaDia,
		alt: 'Terraza de Los Pinos de día, con sombrillas blancas, mesas y sillas de mimbre sobre suelo de barro',
	},
	{
		src: terrazaSombrillas,
		alt: 'Terraza del restaurante con sombrillas blancas cerradas, sillas de mimbre y pinos alrededor',
	},
	{
		src: gambas,
		alt: 'Gambas al ajillo en una cazuela de barro sobre un plato decorado en azul',
	},
	{
		src: gambasDetalle,
		alt: 'Detalle de las gambas al ajillo con perejil en su cazuela de barro',
	},
	{
		src: mesa,
		alt: 'Mesa de Los Pinos con calamares a la plancha, carpaccio de aguacate y un plato de carne',
	},
	{
		src: pescado,
		alt: 'Filete de pescado a la plancha con ajos, guindilla y verduras',
	},
	{
		src: cordero,
		alt: 'Chuletillas de cordero con patatas chips y verduras en un plato blanco',
	},
	{
		src: postres,
		alt: 'Crema catalana en cazuela de barro junto a un cuenco de helado con chocolate',
	},
	{
		src: costa,
		alt: 'Vista de la costa de Es Cubells con pinos, calas y el mar al fondo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#los-pinos`,
	name: BUSINESS.name,
	alternateName: ['Los Pinos', 'Los Pinos Es Cubells', 'Restaurante Los Pinos Ibiza'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 971 80 21 86',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española'],
	areaServed: [
		{ '@type': 'City', name: 'Es Cubells' },
		{ '@type': 'AdministrativeArea', name: 'Sant Josep de sa Talaia' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday'],
			opens: '13:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '19:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Los Pinos · Cocina española en Es Cubells';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-los-pinos-es-cubells-apaisada-01.jpg": terrazaNoche,
	"restaurante-los-pinos-es-cubells-vertical-08.jpg": terrazaDia,
	"restaurante-los-pinos-es-cubells-vertical-06.jpg": terrazaSombrillas,
	"restaurante-los-pinos-es-cubells-vertical-02.jpg": gambas,
	"restaurante-los-pinos-es-cubells-vertical-03.jpg": gambasDetalle,
	"restaurante-los-pinos-es-cubells-vertical-05.jpg": mesa,
	"restaurante-los-pinos-es-cubells-vertical-07.jpg": pescado,
	"restaurante-los-pinos-es-cubells-apaisada-09.jpg": cordero,
	"restaurante-los-pinos-es-cubells-vertical-10.jpg": postres,
	"restaurante-los-pinos-es-cubells-apaisada-04.jpg": costa,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f5b6b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Los Pinos, Los Pinos Es Cubells, comer en Es Cubells, restaurante Sant Josep Ibiza, cocina española Ibiza, terraza Es Cubells, Los Pinos Ibiza"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Los Pinos · Cocina española en Es Cubells"
			ogDescription="Cocina española y terraza entre pinos en Carre des LLombi 31, Es Cubells (Ibiza). Tel. 971 80 21 86. Consulta el aviso de la ficha de Google antes de ir."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Terraza de Los Pinos en Es Cubells al atardecer, con mesas de mantel blanco y sillas de mimbre"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2f5b6b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			phone="+34971802186"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[terrazaNoche]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="LOS PINOS"
			subtitle="Cocina española · Es Cubells"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, apertura, carta y precios antes de la visita."
			ctaLabel="Llamar a Los Pinos"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34971802186?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Es%20Cubells." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Es Cubells"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
