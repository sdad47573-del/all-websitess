---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import terrazaNoche from '../assets/fotos/restaurante-los-pinos-es-cubells-apaisada-01.jpg';
import gambas from '../assets/fotos/restaurante-los-pinos-es-cubells-vertical-02.jpg';
import gambasDetalle from '../assets/fotos/restaurante-los-pinos-es-cubells-vertical-03.jpg';
import costa from '../assets/fotos/restaurante-los-pinos-es-cubells-apaisada-04.jpg';
import mesa from '../assets/fotos/restaurante-los-pinos-es-cubells-vertical-05.jpg';
import terrazaSombrillas from '../assets/fotos/restaurante-los-pinos-es-cubells-vertical-06.jpg';
import pescado from '../assets/fotos/restaurante-los-pinos-es-cubells-vertical-07.jpg';
import terrazaDia from '../assets/fotos/restaurante-los-pinos-es-cubells-vertical-08.jpg';
import cordero from '../assets/fotos/restaurante-los-pinos-es-cubells-apaisada-09.jpg';
import postres from '../assets/fotos/restaurante-los-pinos-es-cubells-vertical-10.jpg';

import { AVISO, BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Restaurante Los Pinos, en Carre des LLombi 31 (07839 Es Cubells, Ibiza). Cocina española y terraza entre pinos. Tel. 971 80 21 86. La ficha de Google lo marca como cerrado temporalmente: confirma antes de ir.';

const galeria = [
	{
		src: terrazaNoche,
		alt: 'Terraza de Los Pinos al atardecer, bajo una pérgola de madera, con mesas de mantel blanco y sillas de mimbre',
	},
	{
		src: terrazaDia,
		alt: 'Terraza de Los Pinos de día, con sombrillas blancas, mesas y sillas de mimbre sobre suelo de barro',
	},
	{
		src: terrazaSombrillas,
		alt: 'Terraza del restaurante con sombrillas blancas cerradas, sillas de mimbre y pinos alrededor',
	},
	{
		src: gambas,
		alt: 'Gambas al ajillo en una cazuela de barro sobre un plato decorado en azul',
	},
	{
		src: gambasDetalle,
		alt: 'Detalle de las gambas al ajillo con perejil en su cazuela de barro',
	},
	{
		src: mesa,
		alt: 'Mesa de Los Pinos con calamares a la plancha, carpaccio de aguacate y un plato de carne',
	},
	{
		src: pescado,
		alt: 'Filete de pescado a la plancha con ajos, guindilla y verduras',
	},
	{
		src: cordero,
		alt: 'Chuletillas de cordero con patatas chips y verduras en un plato blanco',
	},
	{
		src: postres,
		alt: 'Crema catalana en cazuela de barro junto a un cuenco de helado con chocolate',
	},
	{
		src: costa,
		alt: 'Vista de la costa de Es Cubells con pinos, calas y el mar al fondo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#los-pinos`,
	name: BUSINESS.name,
	alternateName: ['Los Pinos', 'Los Pinos Es Cubells', 'Restaurante Los Pinos Ibiza'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 971 80 21 86',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española'],
	areaServed: [
		{ '@type': 'City', name: 'Es Cubells' },
		{ '@type': 'AdministrativeArea', name: 'Sant Josep de sa Talaia' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday'],
			opens: '13:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '19:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Los Pinos · Cocina española en Es Cubells';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f5b6b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Los Pinos, Los Pinos Es Cubells, comer en Es Cubells, restaurante Sant Josep Ibiza, cocina española Ibiza, terraza Es Cubells, Los Pinos Ibiza"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Los Pinos · Cocina española en Es Cubells"
			ogDescription="Cocina española y terraza entre pinos en Carre des LLombi 31, Es Cubells (Ibiza). Tel. 971 80 21 86. Consulta el aviso de la ficha de Google antes de ir."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Terraza de Los Pinos en Es Cubells al atardecer, con mesas de mantel blanco y sillas de mimbre"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2f5b6b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			phone="+34971802186"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[terrazaNoche]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="LOS PINOS"
			subtitle="Cocina española · Es Cubells"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carre des LLombi, 31 · Es Cubells"
				title="Cocina española<br /><em>entre pinos.</em>"
				lede={`Restaurante Los Pinos está en Carre des LLombi, 31, en Es Cubells (Sant Josep de sa Talaia, Ibiza). Cocina española en una casa blanca con terraza de suelo de barro, mesas de mantel blanco, sillas de mimbre y pinos alrededor. Comidas de 13:00 a 15:30 y cenas de 19:00 a 23:00, con el miércoles cerrado. La ficha de Google lo marca como «cerrado temporalmente»: llama al ${BUSINESS.phoneDisplay} antes de ir.`}
				image={terrazaNoche}
				imageAlt="Terraza de Los Pinos al atardecer, bajo una pérgola de madera, con mesas de mantel blanco y sillas de mimbre"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)` },
					{ label: 'Cocina', html: 'Española · terraza entre pinos' },
					{ label: 'Horario', html: 'Comidas y cenas · miércoles cerrado' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Restaurante Los Pinos" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una terraza<br /><em>bajo los pinos.</em>"
				paragraphs={[
					'Los Pinos es un restaurante de cocina española en Carre des LLombi, 31, en Es Cubells, dentro del municipio de Sant Josep de sa Talaia (Ibiza). Google lo clasifica como restaurante y restaurante de cocina española. La casa es blanca, con contraventanas de madera, y la terraza ocupa el porche y el patio: suelo de barro, mesas de mantel blanco, sillas de mimbre y sombrillas, con los pinos alrededor.',
					'Según su ficha de Google, sirve comidas de 13:00 a 15:30 (los martes hasta las 15:00) y cenas de 19:00 a 23:00. El miércoles cierra y el jueves solo abre por la noche. La ficha no ofrece reserva online: se llama al 971 80 21 86.',
					'En las fotos del perfil aparecen las gambas al ajillo en cazuela de barro, los calamares a la plancha, el carpaccio de aguacate, el pescado a la plancha con verduras, las chuletillas de cordero con patatas y los postres, con la crema catalana y el helado con chocolate. También hay una vista de la costa de Es Cubells desde los pinos.',
					'Sus reseñas destacan la comida y el trato: «la comida muy buena: carpaccio de aguacate, ensalada de queso de cabra y paella», «buena comida, buen trato y servicio» y «muy buena atención y su comida exquisita». Google le da 4,7 sobre 5 con 295 reseñas.',
				]}
				note={`${AVISO.title}. ${AVISO.text}`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="De la plancha<br /><em>y de la casa.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que citan sus reseñas y lo que aparece en las fotos del perfil."
				cta={{ label: `Preguntar la carta: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. Llama al 971 80 21 86 para confirmar que el restaurante está abierto y preguntar por la carta del día."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La terraza,<br /><em>la mesa y el mar.</em>"
				description="Estas fotografías proceden del perfil de Restaurante Los Pinos en Google Maps: la terraza al atardecer y de día, las gambas al ajillo, los calamares, el pescado, las chuletillas de cordero, los postres y la costa de Es Cubells."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en Es Cubells.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: comidas de 13:00 a 15:30 (martes hasta las 15:00) y cenas de 19:00 a 23:00; miércoles cerrado y jueves solo por la noche. La descripción de la ficha dice «cerrado temporalmente»: confirma por teléfono antes de venir."
				mapTitle="Mapa de Restaurante Los Pinos en Carre des LLombi, 31, Es Cubells (Ibiza)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Los Pinos · Es Cubells"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 971 80 21 86. La ficha de Google marca acceso para sillas de ruedas y asientos adaptados, pero también advierte de que el local está «cerrado temporalmente»."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, apertura, carta y precios antes de la visita."
			ctaLabel="Llamar a Los Pinos"
		/>
	</body>
</html>
