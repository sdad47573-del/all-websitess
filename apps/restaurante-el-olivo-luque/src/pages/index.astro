---
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	facebookPhotosUrl,
	facebookUrl,
	faqSchema,
	faqs,
	instagramUrl,
	mapEmbedUrl,
	mapsPhotosUrl,
	mapsUrl,
	openingHours,
	phoneHref,
	restaurantSchema,
	specialties,
	tripadvisorUrl,
	websiteUrl,
} from '../lib/business';

const title = 'Restaurante El Olivo | Cocina de mercado en Luque, Córdoba';
const description =
	'Restaurante El Olivo en Luque (Córdoba), Sierras Subbéticas: cocina de mercado que reinterpreta la tradición cordobesa. Gyozas de gambas al ajillo, falso risotto de rabo de toro y bao de pollo crujiente. Terraza con vistas. Reservas: 655 97 55 25.';
const keywords =
	'Restaurante El Olivo Luque, El Olivo Luque Córdoba, comer en Luque, restaurante Subbética, cocina de mercado Córdoba, cocina cordobesa Luque, gyozas de gambas al ajillo, rabo de toro, bao de pollo crujiente, terraza Luque, Calle Cronista Vicente Estrada 21 Luque, restaurante Sierras Subbéticas';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#4b5f2b" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Luque" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Manrope:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración original de una rama de olivo para Restaurante El Olivo; no es una fotografía del establecimiento" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante El Olivo, inicio">
				<span class="brand-mark" aria-hidden="true">EO</span>
				<span class="brand-copy">El Olivo <small>Restaurante · Luque</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">La carta</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 655 97 55 25</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Luque · Sierras Subbéticas</p>
					<h1 id="hero-title">Sabores de siempre,<br /><em>mirada nueva.</em></h1>
					<p class="hero-intro">Restaurante El Olivo es la casa de la familia Barona en el corazón de la Subbética cordobesa: cocina de mercado que rescata los guisos de siempre y los reinventa con producto de temporada, bases de brasa y sugerencias que cambian cada día.</p>
					<div class="hero-actions">
						<a class="button button-ochre" href={phoneHref}>Reservar por teléfono <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Nos encontrarás en</small><address>{business.streetAddress}<br />{business.postalCode} · Luque</address></div>
						<div><small>Reservas</small><a href={phoneHref}>{business.phone}</a><br /><a href={mapsUrl} target="_blank" rel="noreferrer">Ficha en Google Maps ↗</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración original de un olivo de la Subbética; no es una fotografía del establecimiento">
					<span class="art-tile" aria-hidden="true"></span>
					<div class="olivo" aria-hidden="true">
						<span class="canopy c1"></span>
						<span class="canopy c2"></span>
						<span class="canopy c3"></span>
						<span class="trunk"></span>
					</div>
					<div class="olives" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
					<div class="menu-tag" aria-hidden="true"><small>Fuera de carta</small><strong>Sugerencias del día</strong><span>Producto de temporada</span></div>
					<div class="art-caption"><strong>El Olivo</strong>Cocina de mercado</div>
				</div>
			</section>

			<div class="promise" aria-label="Información de Restaurante El Olivo">
				<span>Cocina de mercado</span><span>Producto de temporada</span><span>Terraza con vistas</span><span>Salón con chimenea</span>
			</div>

			<section class="section intro" id="casa" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> La familia Barona</p>
					<h2 id="intro-title">Tradición e<br /><em>innovación.</em></h2>
				</div>
				<div class="intro-copy">
					<p>En pleno corazón de las Sierras Subbéticas, Restaurante El Olivo lleva años siendo un referente gastronómico de Luque y de la provincia. Lo lleva la familia Barona: Mateo y Eloísa Cañete en la cocina, y su hijo Kisko, formado en cocina y sala en Jaén, aportando una mirada joven a los platos de siempre.</p>
					<p>Su cocina es un viaje entre la tradición y la innovación: rescata sabores de antaño y los reinventa con creatividad y respeto. El local, con salón reformado y chimenea, suma una terraza con vistas a la sierra y a los olivos de la Subbética. Los fines de semana llegan comensales de otras localidades y de Córdoba capital.</p>
					<p class="source-note">La información de esta página procede de la web oficial del restaurante, de su ficha de Google Maps, de sus perfiles en redes y de guías gastronómicas y de prensa. La carta y los horarios pueden cambiar: confirma antes de tu visita.</p>
				</div>
			</section>

			<section class="section carta" id="carta" aria-labelledby="carta-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Cocina de mercado contemporánea</p>
						<h2 id="carta-title">Los platos que<br /><em>cuentan El Olivo.</em></h2>
					</div>
					<p>Una selección orientativa de platos presentes en la carta y en la prensa gastronómica. La carta fija se completa con sugerencias de temporada: no sustituye la oferta vigente.</p>
				</div>
				<div class="carta-grid">
					{specialties.map((dish, index) => (
						<article class="carta-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<div class="carta-extra">
					<p><strong>Carta y sugerencias:</strong> mantienen una carta fija y juegan con fuera de carta de temporada, como asados de cochinillo y cordero o tartar de solomillo.</p>
					<p><strong>Para compartir:</strong> croquetas de cochinillo y manzana, mazamorra, huevo a baja temperatura y entrantes pensados para la mesa.</p>
					<p class="menu-note">Consulta la carta, las sugerencias del día y los alérgenos con el restaurante. <a href={phoneHref}>Llama al 655 97 55 25</a>.</p>
				</div>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<div class="gallery-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Imágenes del restaurante</p>
						<h2 id="gallery-title">El Olivo,<br /><em>en fotos.</em></h2>
					</div>
					<p>Consulta fotos reales del local, de la terraza y de los platos en la ficha de Google Maps y en los perfiles oficiales del restaurante.</p>
				</div>
				<div class="gallery-grid">
					<a class="photo-card" href={mapsPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Restaurante El Olivo en Google Maps">
						<span class="photo-label">Fotos de la ficha</span><span class="photo-title">Google Maps <span aria-hidden="true">↗</span></span>
					</a>
					<a class="photo-card alt" href={instagramUrl} target="_blank" rel="noreferrer" aria-label="Ver el Instagram oficial de Restaurante El Olivo">
						<span class="photo-label">Perfil oficial</span><span class="photo-title">Instagram <span aria-hidden="true">↗</span></span>
					</a>
					<a class="photo-card alt2" href={facebookPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Restaurante El Olivo en Facebook">
						<span class="photo-label">Álbum del negocio</span><span class="photo-title">Facebook <span aria-hidden="true">↗</span></span>
					</a>
				</div>
				<p class="gallery-note">El enlace de Google Maps identifica la ficha, pero no expone URLs directas a los archivos de imagen, por lo que las fotos se consultan en las galerías enlazadas. Las ilustraciones de esta web son gráficos originales, no fotografías del establecimiento.</p>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14880 · Luque, Córdoba</p>
					<h2 id="visit-title">Ven a comer<br /><em>a la Subbética.</em></h2>
					<address>{business.streetAddress}<br />{business.postalCode} {business.locality}<br />{business.province}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Reservas y consultas</small><a href={phoneHref}>{business.phone}</a> · <a href="tel:+34605215175">605 21 51 75</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">✉</span><div><small>Correo</small><a href={`mailto:${business.email}`}>{business.email}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Ubicación</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Web y redes</small><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a> · <a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a> · <a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar y reservar</a>
						<a class="button button-outline" href={websiteUrl} target="_blank" rel="noreferrer">Web oficial <span aria-hidden="true">↗</span></a>
					</div>
					<p class="hours-note">Los horarios pueden variar en festivos y temporada alta. Llama antes de desplazarte para confirmarlo.</p>
				</div>
				<div class="visit-side">
					<div class="hours-card">
						<h3>Horario</h3>
						<ul>
							{openingHours.map((slot) => (
								<li><span>{slot.day}</span><strong>{slot.hours}</strong></li>
							))}
						</ul>
					</div>
					<div class="map-card">
						<iframe title="Mapa de Restaurante El Olivo en Calle Cronista Vicente Estrada, Luque" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<div class="map-label"><div><strong>Restaurante El Olivo</strong><small>Cronista Vicente Estrada, 21 · Luque</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
			<Galeria nombre="Restaurante El Olivo" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="Restaurante El Olivo, volver al inicio">
				<span class="brand-mark" aria-hidden="true">EO</span><span class="brand-copy">El Olivo <small>Restaurante · Luque</small></span>
			</a>
			<nav class="footer-nav" aria-label="Redes y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Restaurante El Olivo · Luque (Córdoba). Consulta horarios, carta y alérgenos directamente con el establecimiento.</small>
		</footer>
		<a class="mobile-call" href={phoneHref}>Reservar en El Olivo <span>655 97 55 25</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>
