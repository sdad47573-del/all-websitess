---
import '../styles/global.css';
import {
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import mostrador from '../assets/fotos/la-conchi-apaisada-01.jpg';
import burritos from '../assets/fotos/la-conchi-cuadrada-02.jpg';
import buffet from '../assets/fotos/la-conchi-vertical-03.jpg';
import pizzas from '../assets/fotos/la-conchi-apaisada-04.jpg';
import paella from '../assets/fotos/la-conchi-apaisada-06.jpg';
import macarrones from '../assets/fotos/la-conchi-vista-7-07.jpg';
import pescado from '../assets/fotos/la-conchi-cuadrada-08.jpg';
import pollo from '../assets/fotos/la-conchi-vista-9-09.jpg';
import tortilla from '../assets/fotos/la-conchi-cuadrada-10.jpg';

import { BUSINESS, FAQ, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING } from '../data/site';

const galeria = [
	{ src: burritos, alt: 'Burritos de carne y verduras gratinados en bandeja' },
	{ src: buffet, alt: 'Buffet con pasta gratinada, pescado y bandejas de comida' },
	{ src: pizzas, alt: 'Pizzas de jamón y queso recién hechas' },
	{ src: paella, alt: 'Paella de pollo en paellera' },
	{ src: macarrones, alt: 'Macarrones gratinados con carne y queso' },
	{ src: pescado, alt: 'Pescado con cebolla y pasas' },
	{ src: pollo, alt: 'Pollo al horno con patatas' },
	{ src: tortilla, alt: 'Tortilla de patata y tortilla de guisantes' },
];

const title = 'La Conchi · Comida para llevar en Mazarrón';
const description = `La Conchi, en C. Sta. Rosa, Nº 9 (30870 Mazarrón, Murcia). ${RATING.label} sobre 5 en Google Maps con ${RATING.count} reseñas.`;

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'La cocina', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1d5c3f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400..700;1,400&family=Assistant:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Conchi, comida para llevar Mazarrón, comida casera Murcia"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription={description}
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La Conchi en Mazarrón"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1d5c3f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.city}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[mostrador]}
			schemas={[]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Conchi"
			subtitle="Comida para llevar · Mazarrón"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Comida para llevar, <br /><em>en Mazarrón.</em>"
				lede={`La Conchi está en la C. Sta. Rosa, en Mazarrón. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				image={mostrador}
				imageAlt="Mostrador de La Conchi con bandejas de comida"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Servicio', html: '<b>Comida para llevar</b>' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalMenu
				eyebrow="La cocina"
				title="Lo que se ve <br /><em>en las fotos.</em>"
				description="La ficha no publica carta. Esta lista reúne los platos que aparecen en las fotografías del perfil de Google Maps."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Sin precios publicados. Llama para saber el menú del día y los precios."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Platos <br /><em>de la casa.</em>"
				description="Fotografías del perfil de La Conchi en Google Maps."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Mazarrón, <br /><em>en C. Sta. Rosa.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google. ${HORARIO_AVISO}`}
				mapTitle="Mapa de La Conchi en C. Sta. Rosa, Mazarrón"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. Sta. Rosa · Mazarrón"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos por teléfono: la ficha no enlaza una web propia ni un sistema de pedidos online."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>ir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos y fotografías de la ficha pública de Google Maps, consultada el 31 de octubre de 2026. Confirma platos y horario antes de la visita."
			ctaLabel="Llamar a La Conchi"
			navAriaLabel="Enlaces de La Conchi"
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
