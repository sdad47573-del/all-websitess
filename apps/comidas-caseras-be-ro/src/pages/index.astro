---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/comidas-caseras-be-ro-apaisada-05.jpg';
import interior from '../assets/fotos/comidas-caseras-be-ro-apaisada-01.jpg';
import vitrina from '../assets/fotos/comidas-caseras-be-ro-apaisada-03.jpg';
import garbanzos from '../assets/fotos/comidas-caseras-be-ro-apaisada-02.jpg';
import lomo from '../assets/fotos/comidas-caseras-be-ro-vertical-07.jpg';
import paella from '../assets/fotos/comidas-caseras-be-ro-vertical-08.jpg';
import tortilla from '../assets/fotos/comidas-caseras-be-ro-apaisada-09.jpg';
import guiso from '../assets/fotos/comidas-caseras-be-ro-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Comidas Caseras para llevar Be&Ro · Sevilla';
const description =
	'Comidas Caseras para llevar Be&Ro, cocina tradicional española en C. Conde de Halcón, 13, Sevilla. Un guiso distinto cada día, pollo asado, tortillas y raciones desde 2,50 €. Fotos, carta, horario y teléfono.';

const galeria = [
	{ src: fachada, alt: 'Fachada de Comidas Caseras para llevar Be&Ro en la calle Conde de Halcón, 13' },
	{ src: interior, alt: 'Interior del local Be&Ro con la pizarra de precios y los mostradores' },
	{ src: vitrina, alt: 'Mostrador de Be&Ro con bandejas de guisos, carne y albóndigas' },
	{ src: garbanzos, alt: 'Puchero de garbanzos con fideos en el mostrador de Be&Ro' },
	{ src: lomo, alt: 'Lomo de cerdo en aceite de ajo y perejil en una bandeja' },
	{ src: paella, alt: 'Paella con limón y perejil recién hecha, el plato de los sábados' },
	{ src: tortilla, alt: 'Tortilla de patatas entera cortada en porciones en el mostrador' },
	{ src: guiso, alt: 'Guiso de patatas en salsa de tomate con carne' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Comidas Caseras para llevar Be&Ro',
	inLanguage: 'es-ES',
	description:
		'Selección de la pizarra del local con los precios tal como aparecen en las fotografías del establecimiento.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			offers: item.price.includes('€')
				? {
						'@type': 'Offer',
						price: item.price.replace(' €', '').replace(',', '.'),
						priceCurrency: 'EUR',
					}
				: undefined,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#comidas-caseras-be-ro`,
	name: BUSINESS.name,
	alternateName: ['Be&Ro Sevilla', 'Comidas Caseras Be&Ro'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34691987863',
	priceRange: '€',
	servesCuisine: ['Comida casera', 'Cocina tradicional española', 'Comida para llevar'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '10:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Tuesday',
			opens: '10:00',
			closes: '15:00',
		},
	],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..600;1,400..500&family=Nunito+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Be&Ro Sevilla, comida casera para llevar Sevilla, Conde de Halcón, comida tradicional Sevilla, guisos para llevar, pollo asado Sevilla, paella sábados Sevilla"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina tradicional española para llevar en Conde de Halcón, 13. Un guiso distinto cada día, carta con precios, fotos y teléfono de encargos."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Comidas Caseras para llevar Be&Ro en Sevilla"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#2f4a35"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Sevilla"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Be&Ro"
			subtitle="Comida casera · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Conde de Halcón, 13 · Sevilla"
				title="Comida de casa, <br /><em>lista para llevar.</em>"
				lede={`Be&Ro es una casa de comidas para llevar en el barrio: cocina tradicional española, un guiso distinto cada día y raciones de 1/4 desde 2,50 €. En la ficha de Google suma ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				image={fachada}
				imageAlt="Fachada de Comidas Caseras para llevar Be&Ro con su rótulo en azul"
				primaryCta={{ label: `Encargar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver ficha en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Tipo', html: '<b>Comida casera</b> para llevar' },
					{ label: 'Valoración', html: `<b>${RATING.label}</b> · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>10:00 – 16:00</b> · domingo cerrado' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver fotos y ficha"
				tag="Guiso del día"
			/>

			<LocalChips label="Servicios de Comidas Caseras para llevar Be&Ro" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Cocina tradicional, <br /><em>sin complicaciones.</em>"
				paragraphs={[
					'Be&Ro es un local de comidas caseras para llevar en la calle Conde de Halcón, 13, en Sevilla. Su pizarra lo presenta como «cocina tradicional española»: platos de cuchara, carnes guisadas, pescados, verduras y aliños, preparados cada día para comer en casa.',
					'El cartel de la puerta anuncia pollo asado, platos combinados, guisos caseros, hamburguesas, serranitos, postres caseros y pan. La pizarra añade la promesa de la casa: «todos los días hacemos un guiso diferente».',
					'La atención es de mostrador: se elige en la vitrina, se pesa la ración y se lleva. Para pedir pollo asado, paella de los sábados o comida para varios, el propio cartel pide encargos en el 691 98 78 63.',
				]}
				note="Esta web no publica una carta oficial cerrada. Los platos y precios que aparecen más abajo se han copiado de la pizarra fotografiada en la ficha pública; la oferta cambia a diario, así que conviene confirmarla al llamar."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotografías', href: '#galeria' },
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<ul class="highlights">
				{
					HIGHLIGHTS.map((item) => (
						<li>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</li>
					))
				}
			</ul>

			<LocalMenu
				eyebrow="La pizarra del local"
				title="Guisos de siempre, <br /><em>precios de barrio.</em>"
				description="Una selección de la carta que Be&Ro tiene colgada en la pared, con los precios tal como aparecen. Carnes, pescados y aliños se sirven por raciones de 1/4."
				cta={{ label: `Preguntar el guiso de hoy · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Precios copiados de la pizarra fotografiada en la ficha pública (otoño de 2026) y sujetos a cambios. La pizarra completa incluye además hamburguesas, serranitos, tortillas con ingredientes, postres y bebidas. Llama al 691 98 78 63 para confirmar el guiso del día y encargar."
			/>

			<LocalGallery
				eyebrow="Fotos del perfil de Google Maps"
				title="El local <br /><em>y lo que sale del mostrador.</em>"
				description="La fachada en la calle Conde de Halcón, el interior con la pizarra y algunos de los guisos y platos que aparecen en las fotografías públicas del establecimiento."
				images={galeria}
				cta={{ label: 'Abrir la ficha en Google Maps', href: MAPS.place }}
				note="Imágenes descargadas del perfil público de Comidas Caseras para llevar Be&Ro en Google Maps y servidas desde esta página."
			/>

			<section class="notas" aria-labelledby="notas-title">
				<div class="wrap notas-grid">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="notas-title">Lo que dicen <em>las reseñas.</em></h2>
						<p class="notas-score">
							<strong>{RATING.label}</strong>
							<span>
								<b>★★★★★</b>
								{RATING.count} reseñas<br />en Google
							</span>
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer reseñas en Google ↗
						</a>
					</div>

					<div class="notas-copy">
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>{resena.texto}</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Opinión en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<p class="notas-foot">
							La valoración y el número de reseñas corresponden a la ficha consultada en octubre
							de 2026 y pueden variar. <a href={MAPS.reviews} target="_blank" rel="noreferrer"
								>Consulta las opiniones actualizadas en Google ↗</a
							>.
						</p>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Conde <br /><em>de Halcón.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de Comidas Caseras para llevar Be&Ro en C. Conde de Halcón, 13, Sevilla"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Conde de Halcón, 13 · Sevilla"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Encargar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="El local trabaja para llevar y las raciones se eligen en el mostrador. Para el pollo asado, la paella de los sábados o comida para varias personas, llama antes de ir."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma horario, platos y precios con el establecimiento."
			ctaLabel="Encargar en Be&Ro"
			navAriaLabel="Enlaces de Comidas Caseras para llevar Be&Ro"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
