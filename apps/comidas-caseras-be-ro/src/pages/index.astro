---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/comidas-caseras-be-ro-apaisada-05.jpg';
import interior from '../assets/fotos/comidas-caseras-be-ro-apaisada-01.jpg';
import vitrina from '../assets/fotos/comidas-caseras-be-ro-apaisada-03.jpg';
import garbanzos from '../assets/fotos/comidas-caseras-be-ro-apaisada-02.jpg';
import lomo from '../assets/fotos/comidas-caseras-be-ro-vertical-07.jpg';
import paella from '../assets/fotos/comidas-caseras-be-ro-vertical-08.jpg';
import tortilla from '../assets/fotos/comidas-caseras-be-ro-apaisada-09.jpg';
import guiso from '../assets/fotos/comidas-caseras-be-ro-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Comidas Caseras para llevar Be&Ro · Sevilla';
const description =
	'Comidas Caseras para llevar Be&Ro, cocina tradicional española en C. Conde de Halcón, 13, Sevilla. Un guiso distinto cada día, pollo asado, tortillas y raciones desde 2,50 €. Fotos, carta, horario y teléfono.';

const galeria = [
	{ src: fachada, alt: 'Fachada de Comidas Caseras para llevar Be&Ro en la calle Conde de Halcón, 13' },
	{ src: interior, alt: 'Interior del local Be&Ro con la pizarra de precios y los mostradores' },
	{ src: vitrina, alt: 'Mostrador de Be&Ro con bandejas de guisos, carne y albóndigas' },
	{ src: garbanzos, alt: 'Puchero de garbanzos con fideos en el mostrador de Be&Ro' },
	{ src: lomo, alt: 'Lomo de cerdo en aceite de ajo y perejil en una bandeja' },
	{ src: paella, alt: 'Paella con limón y perejil recién hecha, el plato de los sábados' },
	{ src: tortilla, alt: 'Tortilla de patatas entera cortada en porciones en el mostrador' },
	{ src: guiso, alt: 'Guiso de patatas en salsa de tomate con carne' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Comidas Caseras para llevar Be&Ro',
	inLanguage: 'es-ES',
	description:
		'Selección de la pizarra del local con los precios tal como aparecen en las fotografías del establecimiento.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			offers: item.price.includes('€')
				? {
						'@type': 'Offer',
						price: item.price.replace(' €', '').replace(',', '.'),
						priceCurrency: 'EUR',
					}
				: undefined,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#comidas-caseras-be-ro`,
	name: BUSINESS.name,
	alternateName: ['Be&Ro Sevilla', 'Comidas Caseras Be&Ro'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34691987863',
	priceRange: '€',
	servesCuisine: ['Comida casera', 'Cocina tradicional española', 'Comida para llevar'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '10:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Tuesday',
			opens: '10:00',
			closes: '15:00',
		},
	],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"comidas-caseras-be-ro-apaisada-05.jpg": fachada,
	"comidas-caseras-be-ro-apaisada-01.jpg": interior,
	"comidas-caseras-be-ro-apaisada-03.jpg": vitrina,
	"comidas-caseras-be-ro-apaisada-02.jpg": garbanzos,
	"comidas-caseras-be-ro-vertical-07.jpg": lomo,
	"comidas-caseras-be-ro-vertical-08.jpg": paella,
	"comidas-caseras-be-ro-apaisada-09.jpg": tortilla,
	"comidas-caseras-be-ro-apaisada-10.jpg": guiso,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..600;1,400..500&family=Nunito+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Be&Ro Sevilla, comida casera para llevar Sevilla, Conde de Halcón, comida tradicional Sevilla, guisos para llevar, pollo asado Sevilla, paella sábados Sevilla"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina tradicional española para llevar en Conde de Halcón, 13. Un guiso distinto cada día, carta con precios, fotos y teléfono de encargos."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Comidas Caseras para llevar Be&Ro en Sevilla"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#2f4a35"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Sevilla"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Be&Ro"
			subtitle="Comida casera · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma horario, platos y precios con el establecimiento."
			ctaLabel="Encargar en Be&Ro"
			navAriaLabel="Enlaces de Comidas Caseras para llevar Be&Ro"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
