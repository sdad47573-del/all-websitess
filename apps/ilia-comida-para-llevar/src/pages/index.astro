---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/ilia-comida-para-llevar-vertical-01.jpg';
import paella from '../assets/fotos/ilia-comida-para-llevar-apaisada-04.jpg';
import interior from '../assets/fotos/ilia-comida-para-llevar-apaisada-06.jpg';
import lentejas from '../assets/fotos/ilia-comida-para-llevar-apaisada-07.jpg';
import vitrina from '../assets/fotos/ilia-comida-para-llevar-apaisada-08.jpg';
import mostrador from '../assets/fotos/ilia-comida-para-llevar-apaisada-09.jpg';
import tartaQueso from '../assets/fotos/ilia-comida-para-llevar-vertical-02.jpg';
import arroz from '../assets/fotos/ilia-comida-para-llevar-vertical-03.jpg';
import tartaSofia from '../assets/fotos/ilia-comida-para-llevar-vertical-05.jpg';
import arrozOtra from '../assets/fotos/ilia-comida-para-llevar-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'ILIA Comida para Llevar · Cocina casera en Orihuela';
const description =
	'ILIA Comida para Llevar, Calle Aragón, 11 (03300 Orihuela, Alicante). Cocina casera en táper, arroces, guisos, postres caseros y tartas personalizadas. De 10:00 a 15:30; martes cerrado.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de ILIA con el rótulo de comidas para llevar, la pizarra en la acera y los carteles del escaparate',
	},
	{
		src: arroz,
		alt: 'Una tarrina de aluminio con arroz amarillo y un trozo de carne',
	},
	{
		src: lentejas,
		alt: 'Tarrina de plástico con lentejas con chorizo, recién servida',
	},
	{
		src: tartaQueso,
		alt: 'Tarta de queso cubierta de chocolate blanco y trozos de Kinder',
	},
	{
		src: vitrina,
		alt: 'El expositor de ILIA con tápers, bandejas y postres listos para llevar',
	},
	{
		src: interior,
		alt: 'La zona de espera del local, con pufs blancos, plantas y el ventanal a la calle',
	},
	{
		src: mostrador,
		alt: 'El mostrador de ILIA, con la planta seca, el datáfono y la pantalla encendida',
	},
	{
		src: tartaSofia,
		alt: 'Tarta personalizada con el nombre Sofía, letras de bebé y bolas de chocolate',
	},
	{
		src: arrozOtra,
		alt: 'Otra vista del arroz amarillo con carne en su tarrina, sobre el papel de la bolsa',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que se prepara en ILIA',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#ilia`,
	name: BUSINESS.fullName,
	alternateName: ['ILIA', 'ILIA Orihuela', 'ILIA comida para llevar Orihuela'],
	description:
		'Cocina casera para llevar en la Calle Aragón, 11 (03300 Orihuela, Alicante): arroces, guisos, postres caseros y tartas personalizadas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34621054978',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Comida para llevar', 'Arroces', 'Guisos'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Orihuela' },
		{ '@type': 'AdministrativeArea', name: 'Vega Baja del Segura' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:00',
			closes: '15:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"ilia-comida-para-llevar-apaisada-04.jpg": paella,
	"ilia-comida-para-llevar-vertical-01.jpg": fachada,
	"ilia-comida-para-llevar-vertical-03.jpg": arroz,
	"ilia-comida-para-llevar-apaisada-07.jpg": lentejas,
	"ilia-comida-para-llevar-vertical-02.jpg": tartaQueso,
	"ilia-comida-para-llevar-apaisada-08.jpg": vitrina,
	"ilia-comida-para-llevar-apaisada-06.jpg": interior,
	"ilia-comida-para-llevar-apaisada-09.jpg": mostrador,
	"ilia-comida-para-llevar-vertical-05.jpg": tartaSofia,
	"ilia-comida-para-llevar-vertical-10.jpg": arrozOtra,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#243a52" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="ILIA comida para llevar, comida casera Orihuela, comida para llevar Orihuela, tartas personalizadas Orihuela, lentejas con chorizo, arroz para llevar, Calle Aragón 11"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina casera en táper, arroces, postres caseros y tartas personalizadas en la Calle Aragón, 11 de Orihuela. De 10:00 a 15:30; martes cerrado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Una paella recién hecha en su paellera, en la cocina de ILIA"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#243a52"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[paella]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="ILIA"
			subtitle="Comida para llevar · Orihuela"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="ILIA Comida para Llevar"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma platos, precios y horario antes de pedir."
			ctaLabel="Llamar a ILIA"
			navAriaLabel="Enlaces de ILIA"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
