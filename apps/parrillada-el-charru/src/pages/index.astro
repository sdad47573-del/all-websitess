---
const business = {
	name: 'Parrillada El Charru',
	street: 'Paraje Media Legua, 3',
	city: 'Cartagena',
	region: 'Murcia',
	postalCode: '30392',
	country: 'ES',
	phone: '+34 616 35 72 26',
	latitude: 37.6078341,
	longitude: -0.9583106,
	site: 'https://parrillada-el-charru.netlify.app',
};

const mapsUrl = 'https://www.google.com/maps/place/Parrillada+El+Charru/@37.6078341,-0.9583106,17z/data=!3m1!4b1!4m6!3m5!1s0xd63418dc672a57d:0xf3f3fc5f8059dbb9!8m2!3d37.6078341!4d-0.9583106!16s%2Fg%2F11k8fz3mct?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34616357226';
const instagramUrl = 'https://www.instagram.com/elcharru1/';
const siteUrl = `${business.site}/`;
const description = 'Parrillada El Charru en Paraje Media Legua, 3 (Cartagena). Parrilla uruguaya a la leña: vacío, entraña, parrilladas para dos y arroces, con 4,6★ en Google. Teléfono 616 35 72 26 y fotos.';

const faqs = [
	{
		question: '¿Dónde está la Parrillada El Charru?',
		answer: 'La Parrillada El Charru se encuentra en Paraje Media Legua, 3, 30392 Cartagena (Murcia), frente al Parque de Bomberos. Abre las indicaciones de Google Maps para consultar el trayecto.',
	},
	{
		question: '¿Cuál es el teléfono de El Charru?',
		answer: 'El teléfono publicado de la Parrillada El Charru es el 616 35 72 26. Llama directamente para reservar mesa, consultar disponibilidad y horario actualizado.',
	},
	{
		question: '¿Qué tipo de comida sirven?',
		answer: 'Parrilla uruguaya a la leña: vacío, entraña, solomillo, chorizos criollos, morcilla, chivito uruguayo y arroces (caldero, marisco, negro), además de menú infantil. La carta puede cambiar; consúltala directamente con el establecimiento.',
	},
	{
		question: '¿Cuál es el horario de apertura?',
		answer: 'Los directorios indican cierre los lunes y servicio de mañanas a tardes el resto de días. Llama al 616 35 72 26 o revisa la ficha de Google Maps antes de ir para confirmar la apertura del día.',
	},
	{
		question: '¿Dónde puedo ver fotos del restaurante?',
		answer: 'En esta página tienes una galería con fotos de la ficha de El Charru en Google Maps, y puedes abrir la ficha completa para ver más fotos y las reseñas.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${siteUrl}#restaurant`,
	name: business.name,
	description,
	url: siteUrl,
	telephone: business.phone,
	servesCuisine: ['Uruguaya', 'Parrilla', 'Arroces'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: business.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

import { Image } from 'astro:assets';
import Galeria from '../components/Galeria.astro';
import heroImage from '../assets/fotos/parrillada-el-charru-apaisada-01.jpg';---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#2b1a12" />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" />
		<title>Parrillada El Charru en Cartagena | Parrilla uruguaya en Media Legua</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Parrillada El Charru · Brasa uruguaya en Cartagena" />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${business.site}/og.svg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Parrillada El Charru, brasa uruguaya en Cartagena" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.region" content="ES-MU" />
		<meta name="geo.placename" content="Cartagena" />
		<meta name="geo.position" content="37.6078341;-0.9583106" />
		<meta name="ICBM" content="37.6078341, -0.9583106" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Parrillada El Charru, inicio"><span class="brand-mark" aria-hidden="true">CH</span><span>El Charru<small>Parrilla · Cartagena</small></span></a>
			<nav aria-label="Navegación principal"><a href="#restaurante">La parrilla</a><a href="#fotos">Fotos</a><a href="#visita">Cómo llegar</a></nav>
			<a class="header-call" href={phoneHref}>Llamar · 616 35 72 26</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span>Media Legua · Cartagena</span><i aria-hidden="true"></i> Parrilla uruguaya a la leña</p>
					<h1>Del fuego<br />a <em>tu mesa.</em></h1>
					<p class="lede">El Charru es una parrillada uruguaya en Media Legua: vacío, entraña y solomillo a la brasa, parrilladas para dos, chivito y arroces. Con 4,6★ en Google Maps.</p>
					<div class="actions"><a class="button button-gold" href={phoneHref}>Llamar al restaurante <span aria-hidden="true">↗</span></a><a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-details"><span>⌖ Media Legua, 3 · Frente a Bomberos</span><span>✦ Brasa · arroces · chivito</span></div>
				</div>
				<figure class="hero-photo">
					<Image src={heroImage} alt="Fotografía de la Parrillada El Charru en Cartagena, publicada en su ficha de Google Maps" widths={[640, 960, 1280]} sizes="(max-width: 720px) 100vw, 47vw" format="avif" quality={70} loading="eager" fetchpriority="high" decoding="async" />
					<figcaption>El Charru · Cartagena</figcaption>
				</figure>
			</section>

			<div class="ticker" aria-label="Parrillada El Charru en Cartagena"><span>Parrillada El Charru</span><b>✳</b><span>Brasa uruguaya</span><b>✳</b><span>Media Legua</span><b>✳</b><span>Arroces a la leña</span></div>

			<section class="intro section-wrap" id="restaurante"><div><p class="eyebrow eyebrow-dark">Fuego lento en Media Legua</p><h2>Leña, brasa<br /><em>y sobremesa.</em></h2></div><div class="intro-copy"><p>La Parrillada El Charru está en Paraje Media Legua, 3, frente al Parque de Bomberos. Las reseñas destacan sus carnes a la brasa de corte uruguayo, las parrilladas para compartir y unos arroces que compiten con la brasa.</p><p>¿Vas a acercarte? Llama para reservar mesa y comprobar horario y carta. La información puede variar según el día.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Consultar la ficha y reseñas en Google Maps ↗</a></div></section>

			<section class="specialties section-wrap" aria-labelledby="specialties-title"><div class="section-heading"><p class="eyebrow eyebrow-dark">El plan: pedir al centro</p><h2 id="specialties-title">Una mesa para<br /><em>compartir brasa.</em></h2><p>Una forma sencilla de disfrutar de la parrilla uruguaya en Cartagena. Consulta la selección y disponibilidad directamente con El Charru.</p></div>
				<div class="special-grid">
					<article class="special-card"><span class="special-icon" aria-hidden="true">❋</span><span class="card-kicker">A LA BRASA</span><h3>Cortes uruguayos</h3><p>Vacío, entraña, solomillo y tira de asado a la leña, además de chorizo criollo y morcilla.</p></article>
					<article class="special-card card-olive"><span class="special-icon" aria-hidden="true">◉</span><span class="card-kicker">PARA DOS</span><h3>Parrilladas</h3><p>La parrillada normal y la especial El Charru: lo mejor de la brasa para compartir.</p></article>
					<article class="special-card card-terracotta"><span class="special-icon" aria-hidden="true">♨</span><span class="card-kicker">DE LA LEÑA</span><h3>Arroces y chivito</h3><p>Caldero, marisco y arroz negro, más el chivito uruguayo y menú infantil.</p></article>
				</div><p class="menu-note">Esta descripción se basa en guías públicas del establecimiento; no sustituye a la carta vigente. Consulta platos, alérgenos y precios directamente con el restaurante.</p>
			</section>

			<section class="photo-section" id="fotos"><div class="photo-copy"><p class="eyebrow">El Charru en Google Maps</p><h2>Abre la ficha.<br />Mira sus <em>fotos.</em></h2><p>Descubre las imágenes de la parrillada en Google Maps y consulta las reseñas y datos publicados por el establecimiento y sus visitantes.</p><a class="button button-gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a><p class="photo-note">Una selección de esas fotos, servida optimizada, en la galería de abajo.</p></div>
				<div class="map-photo"><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Google de la Parrillada El Charru, Media Legua, Cartagena" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
					<noscript>
						<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
					</noscript>
				</div><a class="map-caption" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">⌖</span><span><b>Parrillada El Charru</b><small>Media Legua, 3 · Ver ficha y fotos ↗</small></span></a></div>
			</section>

			<section class="visit section-wrap" id="visita"><div class="visit-copy"><p class="eyebrow eyebrow-dark">Frente al Parque de Bomberos</p><h2>Nos encontramos<br /><em>en El Charru.</em></h2><p>La parrillada está en Paraje Media Legua, a las afueras con aparcamiento fácil. Abre indicaciones para calcular la ruta y llama si necesitas confirmar el horario o reservar.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button button-dark" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Llamar · 616 35 72 26</a></div></div>
				<div class="visit-card"><div class="visit-title"><span class="visit-icon" aria-hidden="true">⌖</span><div><p class="eyebrow eyebrow-dark">Ubicación y contacto</p><h3>Media Legua</h3></div></div><dl><div><dt>Dirección</dt><dd>Paraje Media Legua, 3<br />30392 Cartagena</dd></div><div><dt>Teléfono</dt><dd><a href={phoneHref}>616 35 72 26</a></dd></div><div><dt>Horario</dt><dd>Consulta la ficha o<br />confirma por teléfono</dd></div></dl><p class="visit-note">Los directorios indican cierre los lunes. Llama antes de ir para confirmar la apertura.</p><a class="visit-link" href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram de El Charru ↗</a></div>
			</section>

			<section class="faq-section section-wrap" id="preguntas"><p class="eyebrow eyebrow-dark">Preguntas frecuentes</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
			<Galeria nombre="Parrillada El Charru" mapsUrl={mapsUrl} />
		</main>

		<footer class="footer"><div class="footer-top"><a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">CH</span><span>El Charru<small>Parrilla · Cartagena</small></span></a><p>Brasa uruguaya<br />en Media Legua.</p><nav aria-label="Enlaces de la Parrillada El Charru"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={phoneHref}>616 35 72 26</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Parrillada El Charru · Cartagena</span><a href="/aviso-legal/">Aviso legal y privacidad</a><span>Confirma horario, carta y disponibilidad con el establecimiento.</span></div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar <span>616 35 72 26</span></a>
	</body>
</html>

<style is:global>
	:root{font-family:'DM Sans',sans-serif;color:#2c231b;background:#f7f2e8;font-synthesis:none;text-rendering:optimizeLegibility;--wine:#2b1a12;--wine-light:#5a2f1c;--gold:#e0a458;--cream:#f7f2e8;--ink:#2c231b;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid #e0a458;outline-offset:4px}.skip-link{position:absolute;z-index:99;top:-60px;left:16px;padding:12px 16px;background:var(--gold);color:var(--wine)}.skip-link:focus{top:12px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:22px;background:var(--wine);color:#fcf8ef}.brand{display:flex;align-items:center;gap:11px;font-size:15px;font-weight:700}.brand small{display:block;margin-top:4px;color:#e1d4c5;font-size:9px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--gold);border-radius:50%;color:#e5c98c;font:700 19px var(--display)}.topbar nav{display:flex;gap:clamp(14px,2.5vw,32px);color:#f0e6dc;font-size:12px}.topbar nav a:hover,.footer a:hover{color:#e5c98c}.header-call{padding:11px 17px;border:1px solid #ffffff55;border-radius:99px;font-size:11px;font-weight:700}.hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:560px;background:var(--wine);color:#fcf8ef;overflow:hidden}.hero-copy{padding:73px 4vw 64px 9vw;align-self:center}.eyebrow{margin:0 0 19px;color:#e0c78c;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase}.eyebrow i{display:inline-block;width:22px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.section-heading h2,.photo-copy h2,.visit h2,.faq-section h2{margin:0;font:600 clamp(39px,4.8vw,64px)/1.08 var(--display);letter-spacing:-1.2px}.hero h1 em,.intro h2 em,.section-heading h2 em,.photo-copy h2 em,.visit h2 