---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/las-kalendas-apaisada-09.jpg';
import foto1 from '../assets/fotos/las-kalendas-apaisada-01.jpg';
import foto2 from '../assets/fotos/las-kalendas-apaisada-03.jpg';
import foto3 from '../assets/fotos/las-kalendas-apaisada-04.jpg';
import foto4 from '../assets/fotos/las-kalendas-vertical-02.jpg';
import foto5 from '../assets/fotos/las-kalendas-apaisada-08.jpg';

const business = {
	name: 'Restaurantes en Fortuna / Las Kalendas',
	short: 'Las Kalendas',
	street: 'Calle Cam. de Cieza',
	city: 'Fortuna',
	region: 'Región de Murcia',
	province: 'Murcia',
	postalCode: '30620',
	latitude: 38.2054812,
	longitude: -1.1248907,
	site: 'https://las-kalendas.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurantes+en+Fortuna+%2F+Las+Kalendas/@38.2054812,-1.1248907,17z/data=!3m1!4b1!4m6!3m5!1s0xd638f08b840f1bf:0x31b6788bbbf215d4!8m2!3d38.2054812!4d-1.1248907!16s%2Fg%2F11rf46fttw?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'El trato',
		title: 'Amable y profesional',
		text: '«Buen sitio donde comer con un trato amable y profesional», resume una de sus reseñas en Google Maps.',
	},
	{
		kicker: 'Para volver',
		title: 'Clientes que repiten',
		text: 'Salimos contentos, volveríamos sin duda; sin ninguna duda, volveré a comer aquí: así hablan quienes ya han venido.',
	},
	{
		kicker: 'Horario',
		title: 'De martes a sábado',
		text: 'Abre de 10:00 a 23:00 de martes a sábado. Los domingos y los lunes cierra, según su ficha de Google Maps.',
	},
	{
		kicker: 'Accesibilidad',
		title: 'Local adaptado',
		text: 'La ficha marca acceso, aparcamiento, aseo y asientos adaptados para sillas de ruedas.',
	},
	{
		kicker: 'Dónde está',
		title: 'En Fortuna',
		text: 'En la calle Camino de Cieza, 30620 Fortuna (Murcia). Ahí está la ficha y ahí lleva el botón de cómo llegar.',
	},
	{
		kicker: 'En Google',
		title: '4,7 sobre 5',
		text: 'Veinticinco reseñas y una media de 4,7: los comentarios destacan el trato y las ganas de volver a comer aquí.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de Las Kalendas publicada en su ficha de Google Maps (Fortuna)' },
	{ src: photos.foto2, alt: 'Imagen de Restaurantes en Fortuna / Las Kalendas tomada de su galería de Google Maps' },
	{ src: photos.foto3, alt: 'Fotografía del restaurante en la calle Camino de Cieza, Fortuna' },
	{ src: photos.foto4, alt: 'Imagen de Las Kalendas subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Vista de Las Kalendas según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está Las Kalendas?',
		a: 'En la calle Camino de Cieza, 30620 Fortuna (Murcia). Coordenadas 38.2054812, -1.1248907.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De martes a sábado, de 10:00 a 23:00. Domingos y lunes cierra, según su ficha de Google Maps.',
	},
	{
		q: '¿Cuál es el teléfono?',
		a: 'La ficha de Google Maps no publica teléfono. Para contactar, usa el enlace a la ficha de Google Maps o acércate al local.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso, aparcamiento, aseo y asientos adaptados para sillas de ruedas.',
	},
	{
		q: '¿Qué dicen sus clientes?',
		a: 'Tiene 4,7 sobre 5 con 25 reseñas. Los comentarios hablan de un trato amable y profesional y de clientes que volverían a comer aquí.',
	},
	{
		q: '¿Cómo se llega?',
		a: 'Con el botón «Cómo llegar» de esta web se abre la ruta en Google Maps hasta la calle Camino de Cieza, en Fortuna.',
	},
];

const images = [
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'Las Kalendas, restaurante en la calle Camino de Cieza, Fortuna (Murcia): 4,7 estrellas y trato amable. Abre de martes a sábado, de 10:00 a 23:00.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: business.short,
	description,
	url: `${business.site}/`,
	image: images,
	currenciesAccepted: 'EUR',
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '10:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.7,
		reviewCount: 25,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16211f" />
		<meta
			name="description"
			content="Las Kalendas, restaurante en la calle Camino de Cieza, Fortuna (Murcia): 4,7 estrellas y trato amable. Abre de martes a sábado, de 10:00 a 23:00."
		/>
		<meta
			name="keywords"
			content="Las Kalendas, restaurantes en Fortuna, restaurante Fortuna Murcia, camino de Cieza, comer en Fortuna, restaurante Vega Media"
		/>
		<meta name="author" content="Restaurantes en Fortuna / Las Kalendas" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Las Kalendas | Restaurante en Fortuna (Murcia)</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Las Kalendas · Restaurante en Fortuna" />
		<meta
			property="og:description"
			content="Restaurante en la calle Camino de Cieza, Fortuna (Murcia). 4,7 en Google y trato amable; abre de martes a sábado."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="Las Kalendas, restaurante en Fortuna (Murcia)" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Las Kalendas · Restaurante en Fortuna" />
		<meta
			name="twitter:description"
			content="Restaurante en Fortuna (Murcia), en la calle Camino de Cieza. Abre de martes a sábado."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Fortuna" />
		<meta name="geo.position" content="38.2054812;-1.1248907" />
		<meta name="ICBM" content="38.2054812, -1.1248907" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Las Kalendas, inicio">
				<span class="brand-mark" aria-hidden="true">K</span>
				<span class="brand-name">Las Kalendas <small>Restaurantes en Fortuna</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">El restaurante</a>
				<a href="#detalles">Detalles</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Calle Camino de Cieza · Fortuna</p>
					<h1 id="hero-title">Un restaurante<br />en Fortuna,<br /><em>Las Kalendas.</em></h1>
					<p class="hero-lede">
						Las Kalendas, en la calle Camino de Cieza de Fortuna (Murcia). Un restaurante con trato amable y
						profesional, abierto de martes a sábado, con clientes que repiten y una media de 4,7 en Google
						Maps.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar
						</a>
						<a class="button button-ghost" href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,7</b> en Google (25 reseñas)</li>
						<li>Martes a sábado</li>
						<li>10:00 – 23:00</li>
						<li>Fortuna · Murcia</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						alt="Las Kalendas, restaurante en Fortuna (Murcia)"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,7</b><span>Google</span></div>
					<div><b>25</b><span>Reseñas</span></div>
					<div><b>5/7</b><span>Días</span></div>
				</div>
				<ul class="services">
					<li>Trato amable</li>
					<li>Clientes que repiten</li>
					<li>Martes a sábado</li>
					<li>Local accesible</li>
					<li>Fortuna</li>
					<li>Google Maps</li>
				</ul>
			</section>

			<section class="about section-pad" id="restaurante">
				<p class="section-label"><span aria-hidden="true"></span> En Fortuna, Murcia</p>
				<div class="about-grid">
					<h2>Comer bien<br />y volver<br /><em>a Las Kalendas.</em></h2>
					<div class="about-copy">
						<p>
							Restaurantes en Fortuna / Las Kalendas está en la calle Camino de Cieza, en Fortuna (Murcia).
							Su ficha de Google Maps lo presenta con ese nombre completo, aunque en el día a día se le
							conoce como Las Kalendas.
						</p>
						<p>
							Con 25 reseñas y una nota media de 4,7, los comentarios coinciden en el trato amable y
							profesional y en que volverían a comer aquí. Es la señal de una casa que cuida a quien se
							sienta a la mesa.
						</p>
						<p class="about-note">
							Abre de martes a sábado, de 10:00 a 23:00. Domingos y lunes cierra. La ficha de Google Maps no
							publica teléfono: para contactar, usa la ficha o acércate al local.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="detalles">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Lo que dicen de la casa</p>
						<h2>Un sitio<br />para <em>volver.</em></h2>
					</div>
					<p>
						Sin carta publicada en la ficha, lo que sí cuentan sus clientes es el trato, la experiencia y las
						ganas de repetir. Estos son los detalles que recoge Google Maps.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>Las Kalendas<br /><em>en imágenes.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Las Kalendas. En la ficha encontrarás
							la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="avif"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres el
					titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Calle Camino de Cieza</p>
					<h2>Ven a Fortuna<br /><em>a comer.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Martes a sábado</th>
								<td>10:00 – 23:00</td>
							</tr>
							<tr>
								<th scope="row">Domingo y lunes</th>
								<td>Cerrado</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, consulta la ficha antes de venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar
						</a>
						<a class="button button-line" href={mapsUrl} target="_blank" rel="noreferrer">
							Abrir ficha de Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
					<p class="contact-note">
						La ficha de Google Maps no publica teléfono. Para contactar con el restaurante, usa la ficha o
						acércate al local.
					</p>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Las Kalendas en la calle Camino de Cieza, Fortuna"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Las Kalendas · Fortuna
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">K</span>
				<p>Las Kalendas<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Restaurantes en Fortuna / Las Kalendas · Fortuna, Murcia. Fotografías procedentes de
				la ficha del restaurante en Google Maps.
			</small>

			<p class="footer-credit">
				Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
				<a href="https://sur-digital.vercel.app/" rel="noopener">sur-digital.vercel.app</a>
			</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={directionsUrl} target="_blank" rel="noreferrer">
			Cómo llegar a Las Kalendas <span>Fortuna · Murcia</span>
		</a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
