---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import alubias from '../assets/fotos/restaurante-camping-jaizkibel-apaisada-04.jpg';
import entrecot from '../assets/fotos/restaurante-camping-jaizkibel-vertical-01.jpg';
import cachopo from '../assets/fotos/restaurante-camping-jaizkibel-vertical-03.jpg';
import postreRebozado from '../assets/fotos/restaurante-camping-jaizkibel-vertical-05.jpg';
import codillo from '../assets/fotos/restaurante-camping-jaizkibel-vertical-06.jpg';
import huevo from '../assets/fotos/restaurante-camping-jaizkibel-vertical-07.jpg';
import tartaQueso from '../assets/fotos/restaurante-camping-jaizkibel-vertical-09.jpg';
import carta from '../assets/fotos/restaurante-camping-jaizkibel-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Restaurante y bar en el Camping Jaizkibel, Ctra. de Guadalupe km 22 (Hondarribia). Menú del día 12 €, pinchos y raciones. Abierto todos los días de 9:00 a 23:00. Tel. 943 58 23 63.';

const galeria = [
	{
		src: alubias,
		alt: 'Alubia pinta con chorizo y morcilla en un cuenco, con un platito de guindillas al lado',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la plancha con patatas fritas, pimientos de Padrón, ensalada y huevo frito',
	},
	{
		src: cachopo,
		alt: 'Cachopo de ternera empanado con pimientos y cebolla, puré de patata y puntos de mayonesa',
	},
	{
		src: codillo,
		alt: 'Codillo de cerdo en salsa con puré de patata y guindillas en un plato de restaurante',
	},
	{
		src: tartaQueso,
		alt: 'Tarta de queso con mermelada de frutos rojos y nata montada',
	},
	{
		src: huevo,
		alt: 'Huevo frito sobre carne en salsa con una rodaja de berenjena frita',
	},
	{
		src: postreRebozado,
		alt: 'Postre de dos piezas rebozadas con salsa cremosa y ensalada',
	},
	{
		src: carta,
		alt: 'Carta del menú del día del Camping Jaizkibel con entrantes, principales y postres por 12 euros',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#jaizkibel`,
	name: BUSINESS.name,
	alternateName: [
		'Camping Jaizkibel',
		'Restaurante Camping Jaizkibel Hondarribia',
		'Bar Camping Jaizkibel',
	],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 943 58 23 63',
	currenciesAccepted: 'EUR',
	priceRange: '12 €',
	servesCuisine: ['Casera', 'Vasca', 'Española'],
	areaServed: [
		{ '@type': 'City', name: 'Hondarribia' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: `${BUSINESS.street} (Camping Jaizkibel)`,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Un trato excelente, camareros muy educados y amables, se agradece mucho.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 4, bestRating: 5 },
			reviewBody: 'Los macarrones bastante buenos, las albóndigas con arroz blanco delicioso.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 3, bestRating: 5 },
			reviewBody: 'Muy buena atención, los pinchos muy ricos.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Restaurante Camping Jaizkibel · Menú del día en Hondarribia';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f4a3d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Camping Jaizkibel, comer en Hondarribia, menú del día Hondarribia, restaurante Hondarribia, bar Camping Jaizkibel, carretera de Guadalupe Hondarribia, comer cerca de Jaizkibel, menú del día barato Gipuzkoa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Restaurante Camping Jaizkibel · Menú del día en Hondarribia"
			ogDescription="Menú del día por 12 € en el Camping Jaizkibel, carretera de Guadalupe km 22 (Hondarribia). Pinchos y raciones en la barra. Todos los días de 9:00 a 23:00. Tel. 943 58 23 63."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Alubia pinta con chorizo y morcilla del Restaurante Camping Jaizkibel"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1f4a3d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34943582363"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[alubias]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="CAMPING JAIZKIBEL"
			subtitle="Restaurante · Hondarribia"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Ctra. de Guadalupe, km 22 · Hondarribia"
				title={piezas.portada.titulo}
				lede={`Restaurante y bar en el kilómetro 22 de la carretera de Guadalupe, dentro del Camping Jaizkibel, en Hondarribia (Gipuzkoa). Menú del día de 12 € con entrante, principal y postre a elegir, además de pinchos y raciones en la barra. Abre todos los días de 9:00 a 23:00, sin cerrar a mediodía. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={alubias}
				imageAlt="Alubia pinta con chorizo y morcilla en un cuenco, con un platito de guindillas al lado"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)`,
					},
					{ label: 'Menú del día', html: 'Entrante, principal y postre · 12 €' },
					{ label: 'Horario', html: 'Todos los días · 9:00–23:00' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece el Restaurante Camping Jaizkibel" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Menú del día<br /><em>y barra abierta.</em>"
				paragraphs={[
					'El Restaurante Camping Jaizkibel está en el kilómetro 22 de la carretera de Guadalupe, dentro del Camping Jaizkibel, en Hondarribia (Gipuzkoa). Google lo clasifica a la vez como restaurante y como bar: abre a las 9:00 y no cierra a mediodía, así que sirve desde el café de la mañana hasta la cena, todos los días de la semana.',
					'Su menú del día está fotografiado en el propio perfil de Google: 12,00 € con IVA incluido, con entrante, principal y postre a elegir, y suplementos de 1 a 5 € en seis de los principales, entre ellos el cachopo, el codillo, el entrecot y las chuletillas de cordero. La bebida y el café se cobran aparte.',
					'En las fotos del perfil aparecen la alubia pinta con chorizo y morcilla, el entrecot con patatas y pimientos de Padrón, el cachopo de ternera, el codillo con puré de patata, el huevo frito con berenjena y postres como la tarta de queso o los rebozados con salsa cremosa.',
					'Google le da 4,5 sobre 5 con 176 reseñas. Las que se publican destacan el trato —«camareros muy educados y amables»— y platos como los macarrones, las albóndigas con arroz blanco o los pinchos.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «Un trato excelente, camareros muy educados y amables, se agradece mucho».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="El menú del día,<br /><em>plato a plato.</em>"
				description="Esta es la carta que aparece fotografiada en el perfil de Google del restaurante: un entrante, un principal y un postre a elegir, por 12,00 € con IVA incluido. La bebida y el café van aparte."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Los suplementos son los de la carta impresa: cachopo +1 €, codillo +2 €, manchón de pato y bacalao +3 €, entrecot +4 € y chuletillas de cordero +5 €. La carta cambia según la temporada; llama al 943 58 23 63 para saber el menú de hoy."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Los platos<br /><em>y la carta.</em>"
				description="Estas fotografías proceden del perfil de Restaurante Camping Jaizkibel en Google Maps: los guisos, las carnes, los postres y la carta impresa que se entrega en la mesa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en el camping.</em>"
				addressLines={[
					BUSINESS.street,
					'Camping Jaizkibel',
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: todos los días de 9:00 a 23:00, sin cerrar a mediodía. Para grupos conviene llamar antes."
				mapTitle="Mapa de Restaurante Camping Jaizkibel en la carretera de Guadalupe, km 22, Hondarribia (Gipuzkoa)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Restaurante Camping Jaizkibel · Hondarribia"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva llamando al 943 58 23 63. El restaurante está dentro del Camping Jaizkibel y la ficha de Google marca acceso para sillas de ruedas y asientos adaptados; no publica datos de aparcamiento adaptado."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar al Restaurante Camping Jaizkibel"
		/>
	</body>
</html>
