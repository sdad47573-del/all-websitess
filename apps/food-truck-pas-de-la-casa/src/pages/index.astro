---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import terraza from '../assets/fotos/food-truck-pas-de-la-casa-apaisada-09.jpg';
import telecabina from '../assets/fotos/food-truck-pas-de-la-casa-apaisada-10.jpg';
import atardecer from '../assets/fotos/food-truck-pas-de-la-casa-vertical-01.jpg';
import hamburguesas from '../assets/fotos/food-truck-pas-de-la-casa-vertical-02.jpg';
import camion from '../assets/fotos/food-truck-pas-de-la-casa-vertical-03.jpg';
import ensalada from '../assets/fotos/food-truck-pas-de-la-casa-vertical-04.jpg';
import plaza from '../assets/fotos/food-truck-pas-de-la-casa-vertical-05.jpg';
import cafeSilla from '../assets/fotos/food-truck-pas-de-la-casa-vertical-06.jpg';
import noche from '../assets/fotos/food-truck-pas-de-la-casa-vertical-07.jpg';
import cafeMesa from '../assets/fotos/food-truck-pas-de-la-casa-vertical-08.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Food Truck · Comida rápida en Pas de la Casa';
const description =
	'Food Truck, en Pas de la Casa (AD200), al pie de las pistas de Grandvalira. Restaurante de comida rápida abierto todos los días de 9:00 a 19:00. 3,4 sobre 5 con 12 reseñas en Google. La ficha no publica teléfono ni carta.';

const galeria = [
	{
		src: camion,
		alt: 'El food truck, una furgoneta plateada con la ventanilla de servicio abierta, junto al bar de contenedor de San Miguel y la terraza de mesas blancas sobre la nieve',
	},
	{
		src: noche,
		alt: 'La terraza del food truck de noche, con las guirnaldas encendidas, el contenedor de dos plantas y la gente sentada en las mesas sobre la nieve pisada',
	},
	{
		src: plaza,
		alt: 'La explanada con el food truck y la terraza llena de esquiadores, con las banderas de Grandvalira y el hotel Màgic Pas al fondo',
	},
	{
		src: terraza,
		alt: 'La terraza al sol, con decenas de mesas y sillas blancas ocupadas por esquiadores y el telecabina y las pistas detrás',
	},
	{
		src: atardecer,
		alt: 'Vista desde la terraza cubierta: mesas de madera, guirnaldas de bombillas y el atardecer naranja sobre las pistas de Grandvalira y el edificio del telecabina',
	},
	{
		src: hamburguesas,
		alt: 'Una bandeja con dos hamburguesas con bacon, queso y lechuga en platos de cartón, con raciones de patatas fritas, entre esquiadores en una mesa de la terraza',
	},
	{
		src: ensalada,
		alt: 'Un bol de cartón con ensalada de tomate, mozzarella, aceitunas negras y pesto, sostenido con las pistas de esquí y el telecabina al fondo',
	},
	{
		src: cafeSilla,
		alt: 'Una mesa de la terraza con un café en vaso de cartón de San Miguel, sillas blancas alrededor y las pistas nevadas detrás',
	},
	{
		src: cafeMesa,
		alt: 'Un café con leche en vaso de cartón sobre una mesa de madera de la terraza, con esquiadores desenfocados al fondo',
	},
	{
		src: telecabina,
		alt: 'Dentro de la cabina del telecabina, con un esquiador con sudadera de Coll Blanc Panoramic Session y la estación de Pas de la Casa al fondo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'FastFoodRestaurant',
	'@id': `${BUSINESS.siteUrl}/#food-truck`,
	name: BUSINESS.fullName,
	alternateName: ['Food Truck Pas de la Casa', 'Food Truck Grandvalira'],
	description:
		'Puesto de comida rápida con terraza en Pas de la Casa, al pie de las pistas de Grandvalira, abierto todos los días de 9:00 a 19:00.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	servesCuisine: ['Comida rápida'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.plusCode,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '19:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#161f2b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Work+Sans:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Food Truck Pas de la Casa, comida rápida Andorra, comer en Grandvalira, hamburguesas Pas de la Casa, terraza pistas Pas de la Casa, food truck Andorra"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida rápida con terraza al pie de las pistas de Grandvalira, en Pas de la Casa. Todos los días de 9:00 a 19:00. 3,4 sobre 5 con 12 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="El food truck de Pas de la Casa junto a la terraza de mesas blancas sobre la nieve"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#161f2b"
			street={BUSINESS.plusCode}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="AD-03"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.city}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.plusCode,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[camion]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Food Truck"
			subtitle="Pas de la Casa · Grandvalira"
			nav={nav}
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Pas de la Casa · AD200 · Grandvalira"
				title="Comida rápida<br /><em>al pie de las pistas.</em>"
				lede={`El food truck está en la explanada de Pas de la Casa, con la terraza sobre la nieve y el telecabina de Grandvalira a la espalda. Abre todos los días de 9:00 a 19:00: hamburguesas, bocadillos y café para hacer un alto entre bajada y bajada. Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				image={camion}
				imageAlt="El food truck, una furgoneta plateada con la ventanilla de servicio abierta, junto al bar de contenedor de San Miguel y la terraza de mesas blancas sobre la nieve"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha en Google Maps', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>9:00–19:00</b> · todos los días' },
					{ label: 'Dónde', html: '<b>Pas de la Casa</b> · Plus Code GPRM+F63' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Terraza · Pistas · Pas de la Casa"
			/>

			<LocalChips label="Lo que ofrece el Food Truck" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una furgoneta <br /><em>y una terraza.</em>"
				paragraphs={[
					'El puesto está en Pas de la Casa (AD200), en la parroquia de Encamp, en plena estación de esquí: la terraza queda al pie de las pistas y del telecabina de Grandvalira, con el edificio del hotel Màgic Pas y las banderas azules de la estación al fondo.',
					'Es una furgoneta plateada con la ventanilla de servicio abierta, aparcada junto a un bar de contenedor de dos plantas con el rótulo de San Miguel. Alrededor, mesas y sillas blancas de plástico sobre la nieve, guirnaldas de bombillas y, al atardecer, las montañas encendidas de naranja.',
					'En las fotos del perfil aparecen hamburguesas con bacon y queso servidas en platos de cartón con patatas fritas, boles de ensalada con tomate, mozzarella y aceitunas, y cafés en vaso de cartón. Son imágenes de lo que pasa por la barra, no una carta: la ficha no publica platos, precios ni horarios de cocina.',
					`El horario que publica Google es continuo de 9:00 a 19:00 los siete días de la semana, sin cierre a mediodía. La ficha no tiene teléfono, web ni descripción del negocio, y le da ${RATING.label} sobre 5 con ${RATING.count} reseñas (noviembre de 2026).`,
				]}
				note="La ficha de Google es mínima: no publica teléfono, web, carta ni precios, y esta web no los inventa. Aquí no hay botón de llamada porque no hay número al que llamar: la información sale de la propia ficha y de sus fotos."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> La casa</p>
					<h2 id="highlights-title">Nieve, terraza <br /><em>y bocadillo.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La furgoneta, <br /><em>la terraza y la nieve.</em>"
				description="Diez fotografías del perfil del Food Truck en Google Maps: la furgoneta y el contenedor del bar, la terraza de día y de noche, el atardecer sobre las pistas, dos hamburguesas con patatas, un bol de ensalada, dos cafés y una vista desde el telecabina."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">3,4 sobre 5, <em>con 12 reseñas.</em></h2>
						<p>
							Doce opiniones y una media de 3,4 sobre 5 (consultada el 1 de noviembre de 2026). Son
							pocas reseñas para un local con tanto público: cada opinión nueva mueve la media
							bastante, así que conviene leerlas antes de sacar conclusiones.
						</p>
						<p>
							Esta web no copia reseñas sueltas: para leerlas con sus fechas y sus respuestas, abre
							la ficha en Google.
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver las 12 reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>3,4</strong>
						<span>★★★☆☆</span>
						<small>12 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.plusCode} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la explanada, <br /><em>junto a las pistas.</em>"
				addressLines={[BUSINESS.plusCode, BUSINESS.city, `${BUSINESS.postalCode} · Andorra`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de 9:00 a 19:00 todos los días de la semana. ${HORARIO_AVISO}`}
				mapTitle="Mapa del Food Truck en Pas de la Casa"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Pas de la Casa · Plus Code GPRM+F63"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: 'Abrir la ficha en Google Maps', href: MAPS.place, external: true }}
				reserveNote="La ficha no publica teléfono, reservas ni pedidos online, así que no hay canal de contacto más que acudir al puesto. Google tampoco indica datos de accesibilidad ni de aparcamiento: el único dato de ubicación es el Plus Code GPRM+F63, con el código postal y la localidad."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>subir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Food Truck"
			address={`${BUSINESS.plusCode} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone=""
			phoneHref=""
			ctaLabel=""
			legal="Datos, horario, valoración y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. La ficha no publica teléfono, carta ni precios."
			navAriaLabel="Enlaces del Food Truck"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
