---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/la-cocina-de-fina-vista-1-01.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'La cocina de fina · Comidas caseras para llevar en Murcia';
const description =
	'La cocina de fina, Avenida San Ginés, 160 (30169 Murcia). Comida casera para llevar, con raciones bien puestas. La ficha de Google no publica horario: llama antes al 968 88 13 50.';

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que se sirve en La cocina de fina',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-cocina-de-fina`,
	name: BUSINESS.fullName,
	alternateName: ['La cocina de fina Murcia', 'Comidas para llevar La cocina de fina'],
	description:
		'Comida casera para llevar en la Avenida San Ginés, 160 (30169 Murcia). Local de comidas preparadas con raciones bien puestas; sin horario publicado en Google.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34968881350',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Murcia' },
		{ '@type': 'AdministrativeArea', name: 'Región de Murcia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#3f5c3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..600;1,400..600&family=Mulish:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La cocina de fina, comidas para llevar Murcia, comida casera Murcia, Avenida San Ginés 160, comida casera para llevar, tapers Murcia"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar en la Avenida San Ginés, 160 (Murcia), con raciones bien puestas. Llama al 968 88 13 50: la ficha no publica horario."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de La cocina de fina, con el cartel de comidas para llevar y el teléfono"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#3f5c3a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.city}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La cocina de fina"
			subtitle="Comidas para llevar · Murcia"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Avenida San Ginés, 160 · Murcia"
				title="Comidas para llevar, <br /><em>de cocina de casa.</em>"
				lede={`La cocina de fina es un local de comidas preparadas en la Avenida San Ginés. El rótulo de la fachada lo dice entero —«comidas para llevar»— con el teléfono pintado debajo, y no hay mesas en la acera: se entra, se recoge el táper y se vuelve a casa. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas, y no publica horario.`}
				image={fachada}
				imageAlt="La fachada ocre de La cocina de fina con el cartel de comidas para llevar y el teléfono 968 88 13 50"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>No publicado</b> · confirmar por teléfono' },
					{ label: 'Servicio', html: '<b>Solo para llevar</b> · sin mesas' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la ficha en Google"
				tag="Comidas para llevar"
			/>

			<LocalChips label="Lo que ofrece La cocina de fina" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Avenida San Ginés, 160. <br /><em>Se entra a por la comida.</em>"
				paragraphs={[
					'La cocina de fina está en la Avenida San Ginés, 160, 30169 Murcia. La ficha de Google sitúa el local en las coordenadas 37.9493079, -1.1761229. Es una fachada ocre con dos carteles: uno pintado bajo el toldo, con el nombre y el teléfono —968 88 13 50—, y otro colgado en vertical que repite «comidas para llevar».',
					'La puerta es una corredera de cristal que se abre de par en par, con una planta a un lado y el interior en penumbra al fondo. No hay mesas en la acera ni sillas de espera: el local está pensado para entrar, pedir y salir con la bolsa. La única imagen que la ficha pública devuelve del perfil es precisamente esa fachada; el resto de fotos se ven al abrir la galería de Google Maps.',
					'Google la describe con una sola categoría: restaurante de comida para llevar. No figura como bar, ni como restaurante con mesas, ni con servicio a domicilio, y tampoco enlaza una web propia. Es la definición de una casa de comidas de barrio: cocina casera que se sirve en táper.',
					`La reseña que se ve en la ficha lo confirma: «comida casera, buena, ración bien». Con ${RATING.count} opiniones, la media es de ${RATING.label} sobre 5 (noviembre de 2026). El teléfono es el ${BUSINESS.phone}, el mismo que aparece en el rótulo de la pared.`,
				]}
				note="La ficha no publica horario, ni carta, ni precios, y esta web no los inventa. Antes de ir, llama al 968 88 13 50 para saber si están abiertos y qué hay ese día."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Fotos en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que se sabe de la casa</p>
					<h2 id="highlights-title">Casero, bien servido <br /><em>y para llevar.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La comida"
				title="Lo que se puede <br /><em>esperar del táper.</em>"
				description="No hay carta publicada. Esta lista reúne solo lo que se puede afirmar: la categoría con la que Google describe el local, el cartel de la fachada y lo que cuenta la reseña de la ficha."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note={`Sin precios ni carta: el menú del día se pregunta por teléfono, en el ${BUSINESS.phone}. Si vas a por varias raciones o para un grupo, avisa con tiempo.`}
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,4 sobre 5, <em>con 41 reseñas.</em></h2>
						<p>
							Google publica una media de 4,4 con 41 opiniones (noviembre de 2026). La reseña
							visible en la ficha habla de comida casera, de buena ración y de trato con
							experiencia.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span>
											<small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,4</strong>
						<span>★★★★☆</span>
						<small>41 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Murcia, <br /><em>avenida San Ginés.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de La cocina de fina en la Avenida San Ginés, 160, Murcia"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Avenida San Ginés, 160 · Murcia"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Los pedidos se hacen por teléfono o en el propio mostrador: la ficha no enlaza una web del local ni un sistema de pedidos online, y tampoco anuncia reparto a domicilio. Si vas desde lejos, llama antes al 968 88 13 50 y confirma que están abiertos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>ir a por la comida.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="La cocina de fina"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotografía de la ficha pública de Google Maps, consultada en noviembre de 2026. El local no publica horario: confírmalo por teléfono antes de ir."
			ctaLabel="Llamar a La cocina de fina"
			navAriaLabel="Enlaces de La cocina de fina"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
