---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';
import terraza from '../assets/fotos/restaurante-olimpic-apaisada-01.jpg';
import carnePlancha from '../assets/fotos/restaurante-olimpic-apaisada-03.jpg';
import arrozCarne from '../assets/fotos/restaurante-olimpic-apaisada-04.jpg';
import ensalada from '../assets/fotos/restaurante-olimpic-apaisada-05.jpg';
import fachada from '../assets/fotos/restaurante-olimpic-apaisada-07.jpg';
import tablaEmbutido from '../assets/fotos/restaurante-olimpic-apaisada-10.jpg';
import cafe from '../assets/fotos/restaurante-olimpic-vertical-02.jpg';
import arrozCaldoso from '../assets/fotos/restaurante-olimpic-vertical-06.jpg';
import arrozVerduras from '../assets/fotos/restaurante-olimpic-vertical-08.jpg';
import habasJamon from '../assets/fotos/restaurante-olimpic-vertical-09.jpg';

const business = {
	name: 'Restaurante Olimpic',
	brand: 'Olimpic',
	street: 'Carretera N-340, km 1013,600',
	city: 'Torreblanca',
	region: 'Castellón',
	postalCode: '12596',
	phone: '964 42 01 28',
	latitude: 40.2331877,
	longitude: 0.2198536,
	rating: 4.1,
	reviewsCount: 1242,
	site: 'https://restaurante-olimpic.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0x12a01160dde49779:0x2c6a2de51051c905';
const cidDecimal = '3200420947044714757';
const placeId = 'ChIJeZfk3WARoBIRBclREOUtaiw';

const mapsUrl =
	'https://www.google.com/maps/place/RESTAURANTE+OLIMPIC+SL/@40.2331877,0.2198536,17z/data=!3m1!4b1!4m6!3m5!1s0x12a01160dde49779:0x2c6a2de51051c905!8m2!3d40.2331877!4d0.2198536!16s%2Fg%2F1tj4pzkt?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=16&hl=es&output=embed`;
const phoneHref = 'tel:+34964420128';

const description =
	'Restaurante de carretera en la N-340, km 1013,600 (Torreblanca, Castellón): desayunos, menú del día y platos a la plancha, abierto 24 horas.';

const servicios = [
	'Restaurante de carretera',
	'Abierto 24 horas',
	'Desayunos',
	'Menú del día',
	'Tortillas',
	'Platos a la plancha',
	'Guisos de cuchara',
	'Ensaladas y entrantes',
	'Café en vaso',
	'Terraza exterior',
	'Aparcamiento amplio',
	'Acceso adaptado',
];

const grupos = [
	{
		title: 'Desayunos',
		items: [
			{
				name: 'Tortillas',
				note: '«mucha variedad de tortillas», dicen en las reseñas; de patata y de jamón, entre otras',
			},
			{
				name: 'Café con leche',
				note: 'servido en vaso, como sale de la máquina en la barra',
			},
		],
	},
	{
		title: 'Menú del día',
		items: [
			{
				name: 'Menú del día',
				note: '«buenos menús variados», con primeros, segundos y postre o café; el precio se pregunta en el local',
			},
			{
				name: 'Primeros de cuchara',
				note: 'habas con jamón, arroces y guisos, de los que salen en las fotos de la ficha',
			},
		],
	},
	{
		title: 'A la carta',
		items: [
			{
				name: 'Carne a la plancha con patatas',
				note: 'chuletas de cerdo marcadas en la plancha, con patatas fritas y verduras',
			},
			{
				name: 'Arroz de la casa',
				note: 'arroz con carne servido en plato hondo, en su punto de caldo',
			},
			{
				name: 'Habas con jamón',
				note: 'habas verdes con taquitos de jamón y ajos, un guiso de temporada',
			},
			{
				name: 'Ensalada mixta',
				note: 'lechuga, tomate, zanahoria, aceitunas, huevo cocido y atún',
			},
			{
				name: 'Tabla de embutido y queso',
				note: 'salchichón, queso, endivias, huevo cocido y mayonesa, para compartir',
			},
		],
	},
	{
		title: 'Café y sobremesa',
		items: [
			{
				name: 'Café solo',
				note: 'corto, en vaso, para el último tramo de la carretera',
			},
			{
				name: 'Café con leche de después',
				note: 'el que se pide al terminar de comer, con la cuenta',
			},
		],
	},
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada rosa del Hotel Restaurante Olimpic junto a la N-340, en Torreblanca',
	},
	{
		src: terraza,
		alt: 'Terraza del Restaurante Olimpic con mesas bajo una pérgola de flores, junto a la N-340',
	},
	{
		src: carnePlancha,
		alt: 'Carne a la plancha con patatas fritas y verduras en el Restaurante Olimpic, Torreblanca',
	},
	{
		src: cafe,
		alt: 'Café con leche servido en vaso en el Restaurante Olimpic, Torreblanca',
	},
	{
		src: ensalada,
		alt: 'Ensalada mixta con tomate, zanahoria, aceitunas, huevo y atún en el Restaurante Olimpic',
	},
	{
		src: arrozCarne,
		alt: 'Arroz con carne servido en plato hondo en el Restaurante Olimpic, Torreblanca',
	},
	{
		src: arrozVerduras,
		alt: 'Arroz amarillo con verduras y carne en el Restaurante Olimpic, Torreblanca',
	},
	{
		src: tablaEmbutido,
		alt: 'Tabla de salchichón, queso, endivias, huevo cocido y mayonesa en el Restaurante Olimpic',
	},
	{
		src: habasJamon,
		alt: 'Habas verdes con jamón en el Restaurante Olimpic, Torreblanca',
	},
	{
		src: arrozCaldoso,
		alt: 'Arroz caldoso con carne en el Restaurante Olimpic, Torreblanca',
	},
];

const faqs = [
	{
		q: '¿Dónde está el Restaurante Olimpic?',
		a: 'En el kilómetro 1013,600 de la N-340, en término de Torreblanca (Castellón), 12596. Está a pie de la propia carretera, así que se entra y se sale sin desviarse, y el aparcamiento es amplio. Desde esta página puedes abrir el mapa y trazar la ruta con el botón «Cómo llegar».',
	},
	{
		q: '¿A qué hora abre el restaurante?',
		a: 'La ficha de Google lo marca como «Abierto 24 horas» los siete días de la semana. Eso es lo que figura publicado, pero el servicio de cocina y el desayuno pueden tener horarios propios según la temporada: si vienes de lejos, llama antes al 964 42 01 28 y te lo confirman.',
	},
	{
		q: '¿Se puede desayunar?',
		a: 'Sí. En las reseñas de Google se habla de un buen sitio «para comer y desayunar a buen precio» y de la mucha variedad de tortillas. En las fotos de la ficha aparece el café con leche servido en vaso, que es como se sirve en la barra.',
	},
	{
		q: '¿Hay menú del día?',
		a: 'Sí. Las opiniones repiten los «menús variados» y el buen precio. Esta web no publica precios porque la ficha de Google no incluye carta ni tarifas: el menú del día, los platos disponibles y su importe se confirman en el local o llamando al 964 42 01 28.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'La ficha de Google marca cuatro condiciones de accesibilidad: entrada, aseo, asientos y aparcamiento adaptados para sillas de ruedas. El acceso es desde el mismo aparcamiento de la N-340, sin escalones de por medio.',
	},
	{
		q: '¿Se puede parar con un camión?',
		a: 'Sí. El aparcamiento es amplio y está en la propia N-340; en las fotos de la ficha aparecen camiones estacionados junto a la terraza. No hay reserva de plaza: se aparca al llegar, y el restaurante está abierto a cualquier hora.',
	},
	{
		q: '¿El Olimpic también es hotel?',
		a: 'El edificio de la fachada rosa es el del Hotel Restaurante Olimpic, que tiene su propia ficha en Google. El restaurante es una ficha distinta, con su teléfono. Para dormir hay que consultar la ficha del hotel o preguntar en el mismo número.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: [
		'Restaurante Olimpic SL',
		'Olimpic Torreblanca',
		'Restaurante Olimpic N-340',
	],
	slogan: 'Restaurante de carretera abierto 24 horas en la N-340',
	description,
	url: `${business.site}/`,
	telephone: '+34 964 42 01 28',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina española', 'Cocina de carretera', 'Menú del día', 'Platos a la plancha'],
	areaServed: [
		{ '@type': 'City', name: 'Torreblanca' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '00:00',
			closes: '23:59',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-olimpic-apaisada-07.jpg": fachada,
	"restaurante-olimpic-apaisada-01.jpg": terraza,
	"restaurante-olimpic-apaisada-03.jpg": carnePlancha,
	"restaurante-olimpic-vertical-02.jpg": cafe,
	"restaurante-olimpic-apaisada-05.jpg": ensalada,
	"restaurante-olimpic-apaisada-04.jpg": arrozCarne,
	"restaurante-olimpic-vertical-08.jpg": arrozVerduras,
	"restaurante-olimpic-apaisada-10.jpg": tablaEmbutido,
	"restaurante-olimpic-vertical-09.jpg": habasJamon,
	"restaurante-olimpic-vertical-06.jpg": arrozCaldoso,
};

const horas = [
					{ day: 'Lunes', value: '24 horas' },
					{ day: 'Martes', value: '24 horas' },
					{ day: 'Miércoles', value: '24 horas' },
					{ day: 'Jueves', value: '24 horas' },
					{ day: 'Viernes', value: '24 horas' },
					{ day: 'Sábado', value: '24 horas' },
					{ day: 'Domingo', value: '24 horas' },
				];
const mapasPagina = {
	place: cidUrl,
	directions: cidUrl,
	streetView: cidUrl,
	embed: mapEmbedUrl,
};---

<!doctype html>
<html lang="es">
	<head>
		<title>Restaurante Olimpic · N-340, km 1013,600 (Torreblanca)</title>
		<meta name="theme-color" content="#151a1c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Restaurante Olimpic, Restaurante Olimpic SL, restaurante Torreblanca, comer en la N-340, restaurante de carretera Castellón, menú del día Torreblanca, desayunos N-340, restaurante 24 horas Castellón, Hotel Restaurante Olimpic, N-340 km 1013, restaurante Plana Alta"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Restaurante Olimpic · Abierto 24 h en la N-340"
			ogDescription="Desayunos, menú del día y platos a la plancha en la N-340, km 1013,600 (Torreblanca). 4,1 en Google con 1.242 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Fachada rosa del Hotel Restaurante Olimpic junto a la N-340, en Torreblanca"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#151a1c"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Torreblanca, Castellón"
			contact={{
				street: business.street,
				locality: business.city,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[fachada]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="O"
			name={business.name}
			subtitle="N-340, km 1013,600 · Torreblanca"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: business.name,
					street: business.street,
					district: business.district ?? '',
					postalCode: business.postalCode,
					city: business.city,
				}}
								horario={horas}
								mapas={mapasPagina}
			/>
		</main>

		<LocalFooter
			mark="O"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar al Olimpic"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34964420128?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Restaurante%20olimpic." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Restaurante olimpic"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
