---
const business = {
	name: 'Freiduría El Anzuelo',
	street: 'Calle Cenit, 19',
	district: 'Puerto de la Torre',
	city: 'Málaga',
	region: 'Andalucía',
	postalCode: '29190',
	country: 'ES',
	phone: '+34 951 80 22 48',
	latitude: 36.7434594,
	longitude: -4.4832293,
	site: 'https://freiduria-el-anzuelo.netlify.app',
};

const mapsUrl = 'https://www.google.com/maps/place/Freidur%C3%ADa+El+Anzuelo+puerto+de+la+torre/@36.7434594,-4.4832293,17z/data=!3m1!4b1!4m6!3m5!1s0xd72f76ad80efbd3:0x9f64ce7917c31412!8m2!3d36.7434594!4d-4.4832293!16s%2Fg%2F11t_shds31?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34951802248';
const siteUrl = `${business.site}/`;
const description = 'Freiduría El Anzuelo en Calle Cenit, 19 (Puerto de la Torre, Málaga). Pescaíto frito, croquetas y marisco de barrio. Teléfono 951 80 22 48 y fotos.';

const faqs = [
	{
		question: '¿Dónde está la Freiduría El Anzuelo?',
		answer: 'La Freiduría El Anzuelo se encuentra en Calle Cenit, 19, 29190 Málaga, en el barrio de Puerto de la Torre. Abre las indicaciones de Google Maps para consultar el trayecto.',
	},
	{
		question: '¿Cuál es el teléfono de El Anzuelo?',
		answer: 'El teléfono publicado de la Freiduría El Anzuelo es el 951 80 22 48. Llama directamente para encargar, consultar disponibilidad y horario actualizado.',
	},
	{
		question: '¿Qué tipo de comida sirven?',
		answer: 'Freiduría andaluza de barrio: pescaíto frito, croquetas, gambas cocidas y marisco con toque malagueño, para recoger o comer allí. La carta puede cambiar; consúltala directamente con el establecimiento.',
	},
	{
		question: '¿Cuál es el horario de apertura?',
		answer: 'El horario puede variar según el día y la temporada. Llama al 951 80 22 48 o revisa la ficha de Google Maps antes de ir para confirmar la apertura del día.',
	},
	{
		question: '¿Dónde puedo ver fotos de la freiduría?',
		answer: 'En esta página tienes una galería con fotos de la ficha de El Anzuelo en Google Maps, y puedes abrir la ficha completa para ver más fotos y las reseñas.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${siteUrl}#restaurant`,
	name: business.name,
	description,
	url: siteUrl,
	telephone: business.phone,
	servesCuisine: ['Andaluza', 'Pescaíto frito', 'Mariscos'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: business.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

import { Image } from 'astro:assets';
import Galeria from '../components/Galeria.astro';
import heroImage from '../assets/fotos/freiduria-el-anzuelo-apaisada-01.jpg';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#0e3a4a" />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" />
		<title>Freiduría El Anzuelo en Puerto de la Torre | Pescaíto frito en Málaga</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Freiduría El Anzuelo · Pescaíto frito en Puerto de la Torre" />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${business.site}/og.svg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Freiduría El Anzuelo, pescaíto frito en Puerto de la Torre" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.region" content="ES-AN" />
		<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7434594;-4.4832293" />
		<meta name="ICBM" content="36.7434594, -4.4832293" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Freiduría El Anzuelo, inicio"><span class="brand-mark" aria-hidden="true">A</span><span>El Anzuelo<small>Freiduría · Pto. de la Torre</small></span></a>
			<nav aria-label="Navegación principal"><a href="#freiduria">La freiduría</a><a href="#fotos">Fotos</a><a href="#visita">Cómo llegar</a></nav>
			<a class="header-call" href={phoneHref}>Llamar · 951 80 22 48</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span>Puerto de la Torre · Málaga</span><i aria-hidden="true"></i> Freiduría de barrio</p>
					<h1>Pescaíto<br />recién <em>frito.</em></h1>
					<p class="lede">El Anzuelo es una freiduría de barrio en Calle Cenit, 19 (Puerto de la Torre, Málaga). Pescaíto frito, croquetas y marisco con el toque malagueño, para recoger o comer allí.</p>
					<div class="actions"><a class="button button-gold" href={phoneHref}>Llamar a la freiduría <span aria-hidden="true">↗</span></a><a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-details"><span>⌖ Cenit, 19 · Puerto de la Torre</span><span>✦ Pescaíto · croquetas · marisco</span></div>
				</div>
				<figure class="hero-photo">
					<Image src={heroImage} alt="Fotografía de la Freiduría El Anzuelo en Puerto de la Torre, publicada en su ficha de Google Maps" widths={[640, 960, 1280]} sizes="(max-width: 720px) 100vw, 47vw" format="avif" quality={70} loading="eager" fetchpriority="high" decoding="async" />
					<figcaption>El Anzuelo · Puerto de la Torre</figcaption>
				</figure>
			</section>

			<div class="ticker" aria-label="Freiduría El Anzuelo en Puerto de la Torre"><span>Freiduría El Anzuelo</span><b>✳</b><span>Pescaíto frito</span><b>✳</b><span>Puerto de la Torre</span><b>✳</b><span>Croquetas y marisco</span></div>

			<section class="intro section-wrap" id="freiduria"><div><p class="eyebrow eyebrow-dark">De barrio, de Málaga</p><h2>Fritura<br /><em>como en casa.</em></h2></div><div class="intro-copy"><p>La Freiduría El Anzuelo está en Calle Cenit, 19, en Puerto de la Torre. Es una freiduría de barrio de las de siempre: frutos del mar con el inconfundible toque malagueño, raciones para compartir y trato cercano.</p><p>¿Vas a acercarte? Llama para encargar o comprobar horario y carta. La información puede variar según el día.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Consultar la ficha y reseñas en Google Maps ↗</a></div></section>

			<section class="specialties section-wrap" aria-labelledby="specialties-title"><div class="section-heading"><p class="eyebrow eyebrow-dark">El plan: cartucho en mano</p><h2 id="specialties-title">Una fritura para<br /><em>compartir al centro.</em></h2><p>Una forma sencilla de disfrutar de la freiduría malagueña en el barrio. Consulta la selección y disponibilidad directamente con El Anzuelo.</p></div>
				<div class="special-grid">
					<article class="special-card"><span class="special-icon" aria-hidden="true">❋</span><span class="card-kicker">DE LA FREIDORA</span><h3>Pescaíto frito</h3><p>Boquerones, calamares y fritura variada al estilo malagueño, recién hecha.</p></article>
					<article class="special-card card-olive"><span class="special-icon" aria-hidden="true">◉</span><span class="card-kicker">DE LA CASA</span><h3>Croquetas y gambas</h3><p>Croquetas cremosas y gambas cocidas, los fijos de la casa.</p></article>
					<article class="special-card card-terracotta"><span class="special-icon" aria-hidden="true">♨</span><span class="card-kicker">PARA COMPARTIR</span><h3>Raciones y marisco</h3><p>Raciones al centro y marisco de temporada para la mesa.</p></article>
				</div><p class="menu-note">Esta descripción se basa en guías públicas del establecimiento; no sustituye a la carta vigente. Consulta platos, alérgenos y precios directamente con la freiduría.</p>
			</section>

			<section class="photo-section" id="fotos"><div class="photo-copy"><p class="eyebrow">El Anzuelo en Google Maps</p><h2>Abre la ficha.<br />Mira sus <em>fotos.</em></h2><p>Descubre las imágenes de la freiduría en Google Maps y consulta las reseñas y datos publicados por el establecimiento y sus visitantes.</p><a class="button button-gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a><p class="photo-note">Una selección de esas fotos, servida optimizada, en la galería de abajo.</p></div>
				<div class="map-photo"><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Google de la Freiduría El Anzuelo, Calle Cenit, Puerto de la Torre" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
					<noscript>
						<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
					</noscript>
				</div><a class="map-caption" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">⌖</span><span><b>Freiduría El Anzuelo</b><small>Cenit, 19 · Ver ficha y fotos ↗</small></span></a></div>
			</section>

			<section class="visit section-wrap" id="visita"><div class="visit-copy"><p class="eyebrow eyebrow-dark">En el barrio</p><h2>Nos encontramos<br /><em>en El Anzuelo.</em></h2><p>La freiduría está en Calle Cenit, en pleno Puerto de la Torre. Abre indicaciones para calcular la ruta y llama si necesitas confirmar el horario o hacer un encargo.</p><address>{business.street}<br />{business.postalCode} {business.city} ({business.district})</address><div class="actions"><a class="button button-dark" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Llamar · 951 80 22 48</a></div></div>
				<div class="visit-card"><div class="visit-title"><span class="visit-icon" aria-hidden="true">⌖</span><div><p class="eyebrow eyebrow-dark">Ubicación y contacto</p><h3>Puerto de la Torre</h3></div></div><dl><div><dt>Dirección</dt><dd>Calle Cenit, 19<br />29190 Málaga</dd></div><div><dt>Teléfono</dt><dd><a href={phoneHref}>951 80 22 48</a></dd></div><div><dt>Horario</dt><dd>Consulta la ficha o<br />confirma por teléfono</dd></div></dl><p class="visit-note">Freiduría de barrio: llama antes de ir para confirmar la apertura y encargar.</p><a class="visit-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Abrir ficha de Google Maps ↗</a></div>
			</section>

			<section class="faq-section section-wrap" id="preguntas"><p class="eyebrow eyebrow-dark">Preguntas frecuentes</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
			<Galeria nombre="Freiduría El Anzuelo" mapsUrl={mapsUrl} />
		</main>

		<footer class="footer"><div class="footer-top"><a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">A</span><span>El Anzuelo<small>Freiduría · Pto. de la Torre</small></span></a><p>Pescaíto frito<br />de barrio.</p><nav aria-label="Enlaces de la Freiduría El Anzuelo"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={phoneHref}>951 80 22 48</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Freiduría El Anzuelo · Málaga</span><a href="/aviso-legal/">Aviso legal y privacidad</a><span>Confirma horario, carta y disponibilidad con el establecimiento.</span></div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar <span>951 80 22 48</span></a>
	</body>
</html>

<style is:global>
	:root{font-family:'DM Sans',sans-serif;color:#2c2622;background:#f6f4ec;font-synthesis:none;text-rendering:optimizeLegibility;--wine:#0e3a4a;--wine-light:#16617f;--gold:#e3b25f;--cream:#f6f4ec;--ink:#2c2622;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid #e3b25f;outline-offset:4px}.skip-link{position:absolute;z-index:99;top:-60px;left:16px;padding:12px 16px;background:var(--gold);color:var(--wine)}.skip-link:focus{top:12px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:22px;background:var(--wine);color:#fcf8ef}.brand{display:flex;align-items:center;gap:11px;font-size:15px;font-weight:700}.brand small{display:block;margin-top:4px;color:#e1d4c5;font-size:9px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--gold);border-radius:50%;color:#e5c98c;font:700 23px var(--display)}.topbar nav{display:flex;gap:clamp(14px,2.5vw,32px);color:#f0e6dc;font-size:12px}.topbar nav a:hover,.footer a:hover{color:#e5c98c}.header-call{padding:11px 17px;border:1px solid #ffffff55;border-radius:99px;font-size:11px;font-weight:700}.hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:560px;background:var(--wine);color:#fcf8ef;overflow:hidden}.hero-copy{padding:73px 4vw 64px 9vw;align-self:center}.eyebrow{margin:0 0 19px;color:#e0c78c;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase}.eyebrow i{display:inline-block;width:22px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.section-heading h2,.photo-copy h2,.visit h2,.faq-section h2{margin:0;font:600 clamp(39px,4.8vw,64px)/1.08 var(--display);letter-spacing:-1.2px}.hero h1 em,.intro h2 em,.section-heading h2 em,.photo-copy h2 em,.visit h2 