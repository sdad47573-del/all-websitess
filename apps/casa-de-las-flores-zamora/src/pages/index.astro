---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	business,
	directionsUrl,
	faqSchema,
	faqs,
	floristSchema,
	hours,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

/** Galería: las diez fotografías de la ficha, en el orden en que las devolvió la descarga. */
const galeria = Object.keys(fotos)
	.sort((a, b) => a.localeCompare(b))
	.map((path) => path.split('/').pop() as string);

/**
 * Texto alternativo de cada foto.
 *
 * Se describe solo lo que se ve en la imagen; la ficha no publica pies ni descripciones, así que no
 * se atribuye ninguna autoría ni se inventa el contexto.
 */
const altPorFoto: Record<string, string> = {
	'casa-de-las-flores-zamora-vertical-01.jpg':
		'Escaparate de Casa de las Flores Zamora en la Avenida de Oporto, con plantas y flores en la puerta',
	'casa-de-las-flores-zamora-vertical-02.jpg':
		'Manojos de hierba seca y ramas en cubos, junto a la pared blanca del local',
	'casa-de-las-flores-zamora-vertical-03.jpg':
		'Interior de la floristería con estanterías de plantas, macetas y material de trabajo',
	'casa-de-las-flores-zamora-vertical-04.jpg':
		'Planta verde en una cesta con un lazo rojo, delante de una pared rosa',
	'casa-de-las-flores-zamora-vertical-05.jpg':
		'Ramo de lilas rosas, rosas y paniculata envuelto en papel kraft, sostenido con las manos',
	'casa-de-las-flores-zamora-vertical-06.jpg':
		'Ramo de lilas, rosas rojas y cardos envuelto en papel, sostenido con las manos',
	'casa-de-las-flores-zamora-vertical-07.jpg':
		'Ramo de girasol y rosas rojas envuelto en papel oscuro',
	'casa-de-las-flores-zamora-vertical-08.jpg':
		'Ramo de lavanda y hierbas secas junto a un cuenco blanco',
	'casa-de-las-flores-zamora-vertical-09.jpg':
		'Ramo con un osito de peluche, rosas rojas, claveles y lilas',
	'casa-de-las-flores-zamora-vertical-10.jpg':
		'Ramo de flores en tonos pastel con rosas y claveles, sobre el mostrador',
};
const altFoto = (name: string) =>
	altPorFoto[name] ?? 'Fotografía publicada en la ficha de Google Maps de Casa de las Flores Zamora';

const heroFoto = 'casa-de-las-flores-zamora-vertical-01.jpg';
const interiorFoto = 'casa-de-las-flores-zamora-vertical-03.jpg';
const secasFoto = 'casa-de-las-flores-zamora-vertical-02.jpg';

const title = 'Casa de las Flores Zamora · Floristería en Carabanchel';
const description =
	'Casa de las Flores Zamora, diseñador de flores en Av. de Oporto, 30, Carabanchel, 28019 Madrid. 4,4 sobre 5 con 20 reseñas en Google Maps. Teléfono 616 95 75 51.';
const altOg =
	'Escaparate de Casa de las Flores Zamora en la Avenida de Oporto, Madrid, publicado en Google Maps';

const nota = business.rating.toLocaleString('es-ES');
const telefono = business.phoneDisplay;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#a63b2b" />
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="Casa de las Flores Zamora, floristería Carabanchel, diseñador de flores Madrid, flores Avenida de Oporto, ramos Madrid"
		/>
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-MD" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Instrument+Sans:ital,wght@0,400..700;1,400&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(floristSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">
					<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3">
						<ellipse cx="32" cy="19" rx="5" ry="8"></ellipse>
						<ellipse cx="32" cy="19" rx="5" ry="8" transform="rotate(60 32 32)"></ellipse>
						<ellipse cx="32" cy="19" rx="5" ry="8" transform="rotate(120 32 32)"></ellipse>
						<ellipse cx="32" cy="19" rx="5" ry="8" transform="rotate(180 32 32)"></ellipse>
						<ellipse cx="32" cy="19" rx="5" ry="8" transform="rotate(240 32 32)"></ellipse>
						<ellipse cx="32" cy="19" rx="5" ry="8" transform="rotate(300 32 32)"></ellipse>
					</svg>
				</span>
				<span class="brand-text">
					Casa de las Flores
					<small>Zamora · Carabanchel</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#fotos">Fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path
						d="M6.5 3.5h2.2l1.5 3.7-1.8 1.3a12 12 0 0 0 5.1 5.1l1.3-1.8 3.7 1.5v2.2a2.5 2.5 0 0 1-2.7 2.5A15.5 15.5 0 0 1 4 7.2 2.5 2.5 0 0 1 6.5 3.5Z"
					></path>
				</svg>
				{telefono}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow">Diseñador de flores · Carabanchel</p>
					<h1 id="hero-title">
						La casa de las flores
						<em>del barrio.</em>
					</h1>
					<p class="hero-lead">
						En el número 30 de la Avenida de Oporto hay un bajo con flores en la puerta, plantas
						dentro y ramos envueltos en papel. La ficha de Google lo clasifica como{' '}
						<strong>diseñador de flores</strong> y le da <strong>{nota} sobre 5</strong> con{' '}
						{business.reviewCount} reseñas.
					</p>
					<div class="hero-actions">
						<a class="btn btn-solid" href={phoneHref}>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<path
									d="M6.5 3.5h2.2l1.5 3.7-1.8 1.3a12 12 0 0 0 5.1 5.1l1.3-1.8 3.7 1.5v2.2a2.5 2.5 0 0 1-2.7 2.5A15.5 15.5 0 0 1 4 7.2 2.5 2.5 0 0 1 6.5 3.5Z"
								></path>
							</svg>
							Llamar al {telefono}
						</a>
						<a class="btn btn-ghost" href="#fotos">
							Ver las fotos
							<span aria-hidden="true">↓</span>
						</a>
					</div>
					<dl class="hero-facts">
						<div>
							<dt>Dirección</dt>
							<dd>
								<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
									Av. de Oporto, 30
								</a>
							</dd>
						</div>
						<div>
							<dt>Horario</dt>
							<dd>L–V 9:30–20:30</dd>
						</div>
						<div>
							<dt>Valoración</dt>
							<dd>
								<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
									{nota} / 5 · {business.reviewCount} reseñas
								</a>
							</dd>
						</div>
					</dl>
				</div>

				<div class="hero-media">
					<figure class="hero-photo">
						<Image
							src={foto(heroFoto)}
							alt={altFoto(heroFoto)}
							widths={[480, 720, 960]}
							sizes="(max-width: 1080px) 92vw, 46vw"
							format="avif"
							quality={58}
							priority
						/>
						<div class="hero-stamp" aria-hidden="true">
							<strong>{nota}</strong>
							<small>sobre 5</small>
							<small>{business.reviewCount} reseñas</small>
						</div>
						<figcaption class="hero-caption">
							Av. de Oporto, 30
							<span>Carabanchel · 28019 Madrid</span>
						</figcaption>
					</figure>
				</div>
			</section>

			<p class="band">
				<span>Av. de Oporto, 30</span>
				<span>Carabanchel · 28019</span>
				<span>Diseñador de flores</span>
				<span><a href={reviewsUrl} target="_blank" rel="noopener noreferrer">{nota} / 5 en Google</a></span>
				<span><a href={phoneHref}>{telefono}</a></span>
			</p>

			<section class="section casa" id="casa" aria-labelledby="casa-title">
				<div class="wrap casa-grid">
					<div class="casa-copy">
						<p class="kicker">La casa</p>
						<h2 class="title" id="casa-title">Un bajo con flores<br /><em>en la acera.</em></h2>
						<p>
							La ficha de Google Maps sitúa Casa de las Flores Zamora en la Avenida de Oporto, 30,
							en Carabanchel, y la clasifica como diseñador de flores. No publica una descripción
							del titular, así que esta página no añade servicios ni promesas que el propio
							negocio no haya publicado.
						</p>
						<p>
							Lo que sí se ve en sus diez fotos: el escaparate con las plantas en la acera, las
							estanterías del interior, manojos de hierba seca y ramos de lilas, rosas, girasoles
							y claveles envueltos en papel. Son las imágenes que el local publica en su ficha y
							las que se muestran aquí.
						</p>
						<p class="casa-note">
							Datos de la ficha consultada el {site.consultado}. El horario y la disponibilidad
							pueden cambiar: confírmalos por teléfono.
						</p>
					</div>

					<div class="casa-figures">
						<figure class="fig-main">
							<Image
								src={foto(heroFoto)}
								alt={altFoto(heroFoto)}
								widths={[380, 560, 760]}
								sizes="(max-width: 1080px) 55vw, 32vw"
								format="avif"
								quality={60}
								loading="lazy"
								decoding="async"
							/>
							<figcaption>
								<span>Escaparate</span>
								<span>01</span>
							</figcaption>
						</figure>
						<figure class="fig-small">
							<Image
								src={foto(interiorFoto)}
								alt={altFoto(interiorFoto)}
								widths={[260, 420, 560]}
								sizes="(max-width: 1080px) 38vw, 18vw"
								format="avif"
								quality={60}
								loading="lazy"
								decoding="async"
							/>
							<figcaption>
								<span>Dentro</span>
								<span>03</span>
							</figcaption>
						</figure>
						<figure class="fig-small">
							<Image
								src={foto(secasFoto)}
								alt={altFoto(secasFoto)}
								widths={[260, 420, 560]}
								sizes="(max-width: 1080px) 38vw, 18vw"
								format="avif"
								quality={60}
								loading="lazy"
								decoding="async"
							/>
							<figcaption>
								<span>Hierba seca</span>
								<span>02</span>
							</figcaption>
						</figure>
					</div>
				</div>
			</section>

			<section class="section fotos" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<div class="fotos-head">
						<div>
							<p class="kicker">Las fotos</p>
							<h2 class="title" id="fotos-title">El puesto, <em>en diez fotos.</em></h2>
						</div>
						<p>
							Las diez son verticales y salen de la ficha pública del negocio en Google Maps. La
							ficha no las describe ni las atribuye a un autor con nombre, así que se publican sin
							pie.
						</p>
					</div>

					<div class="fotos-grid">
						{galeria.map((name, index) => (
							<figure class="foto">
								<Image
									src={foto(name)}
									alt={`${altFoto(name)} (foto ${index + 1} de 10)`}
									widths={[260, 380, 560]}
									sizes="(max-width: 640px) 46vw, (max-width: 1080px) 23vw, 18vw"
									format="avif"
									quality={60}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>{String(index + 1).padStart(2, '0')}</figcaption>
							</figure>
						))}
					</div>

					<div class="fotos-foot">
						<span>Imágenes alojadas en esta web a partir de fotografías públicas del negocio.</span>
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							Ver la galería completa en Google Maps ↗
						</a>
					</div>
				</div>
			</section>

			<section class="section visita" id="horario" aria-labelledby="visita-title">
				<div class="wrap visita-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="visita-title">Avenida de Oporto, <em>número 30.</em></h2>
						<address>
							<strong>{business.name}</strong>
							Av. de Oporto, 30<br />
							Carabanchel · {business.postalCode} {business.city}<br />
							Plus code {business.plusCode}
						</address>

						<table class="hours">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="visita-note">
							Horario de la ficha consultada el {site.consultado}. La ficha no publica datos de
							accesibilidad, así que esta web no puede confirmarlos: pregunta por teléfono si los
							necesitas.
						</p>

						<div class="visita-actions">
							<a class="btn btn-solid" href={phoneHref}>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
									<path
										d="M6.5 3.5h2.2l1.5 3.7-1.8 1.3a12 12 0 0 0 5.1 5.1l1.3-1.8 3.7 1.5v2.2a2.5 2.5 0 0 1-2.7 2.5A15.5 15.5 0 0 1 4 7.2 2.5 2.5 0 0 1 6.5 3.5Z"
									></path>
								</svg>
								Llamar al {telefono}
							</a>
							<a class="btn btn-ghost" href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>

					<div class="map-card">
						<div class="map-frame">
							<iframe
								title={`Mapa de ${business.name} en ${business.city}`}
								src={mapEmbedUrl}
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
								allowfullscreen></iframe>
						</div>
						<div class="map-tag">
							<div>
								<strong>{business.name}</strong>
								<small>Av. de Oporto, 30 · {business.postalCode} {business.city}</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap faq-grid">
					<div class="faq-intro">
						<p class="kicker">Preguntas frecuentes</p>
						<h2 class="title" id="faq-title">Antes de <em>acercarte.</em></h2>
						<p>
							Estas respuestas salen solo de los datos publicados en Google Maps. Si algo no está
							en la ficha, aquí se dice.
						</p>
					</div>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap footer-grid">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">
						<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3">
							<ellipse cx="32" cy="19" rx="5" ry="8"></ellipse>
							<ellipse cx="32" cy="19" rx="5" ry="8" transform="rotate(60 32 32)"></ellipse>
							<ellipse cx="32" cy="19" rx="5" ry="8" transform="rotate(120 32 32)"></ellipse>
							<ellipse cx="32" cy="19" rx="5" ry="8" transform="rotate(180 32 32)"></ellipse>
							<ellipse cx="32" cy="19" rx="5" ry="8" transform="rotate(240 32 32)"></ellipse>
							<ellipse cx="32" cy="19" rx="5" ry="8" transform="rotate(300 32 32)"></ellipse>
						</svg>
					</span>
					<span>
						Casa de las Flores Zamora
						<small>Av. de Oporto, 30 · {business.postalCode} {business.city}</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {telefono}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">Ficha en Google Maps ↗</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Reseñas en Google Maps ↗</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Casa de las Flores Zamora · Av. de Oporto, 30, Carabanchel
					({business.postalCode} {business.city}). Web informativa elaborada con los datos y las
					fotografías que el local publica en su ficha de Google Maps, consultada el {site.consultado}.
					No es su web oficial y no vende nada. Confirma horario y disponibilidad por teléfono antes
					de salir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a Casa de las Flores <span>{telefono}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
