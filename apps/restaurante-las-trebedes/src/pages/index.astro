---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/restaurante-las-trebedes-vista-1-01.jpg';
import comedor from '../assets/fotos/restaurante-las-trebedes-apaisada-03.jpg';
import ensaladas from '../assets/fotos/restaurante-las-trebedes-vertical-02.jpg';
import escalopines from '../assets/fotos/restaurante-las-trebedes-vertical-04.jpg';
import chorizos from '../assets/fotos/restaurante-las-trebedes-apaisada-05.jpg';
import tosta from '../assets/fotos/restaurante-las-trebedes-vista-6-06.jpg';
import solomillo from '../assets/fotos/restaurante-las-trebedes-vertical-07.jpg';
import arroz from '../assets/fotos/restaurante-las-trebedes-apaisada-08.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Restaurante las Trebedes, taberna y cocina casera en la calle Pósito, 10 (Pozuelo de Zarzón, Cáceres). Desayunos desde las 7:30, raciones, bocadillos y menú de festivos. Tel. 927 44 81 65.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada amarilla con pared de piedra y toldo de Restaurante Las Trebedes en la calle Pósito de Pozuelo de Zarzón',
	},
	{
		src: comedor,
		alt: 'Comedor de Las Trebedes con vigas de madera, manteles amarillos de cuadros, chimenea de piedra y vitrina de vinos',
	},
	{
		src: ensaladas,
		alt: 'Ensaladas con huevo cocido, tomate, atún y espárragos blancos preparadas en la cocina de Las Trebedes',
	},
	{
		src: escalopines,
		alt: 'Escalopines de cerdo empanados en salsa con huevo frito, ensalada y patatas fritas en Restaurante las Trebedes',
	},
	{
		src: chorizos,
		alt: 'Chorizos a la brasa con dos huevos fritos y migas servidos en la taberna Las Trebedes',
	},
	{
		src: tosta,
		alt: 'Tosta de jamón ibérico con huevo frito y patatas fritas en Las Trebedes, Pozuelo de Zarzón',
	},
	{
		src: solomillo,
		alt: 'Dos filetes a la plancha con huevos fritos, patatas y pimientos rojos en Restaurante las Trebedes',
	},
	{
		src: arroz,
		alt: 'Arroz caldoso con bogavante servido en Restaurante las Trebedes, Pozuelo de Zarzón',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#las-trebedes`,
	name: BUSINESS.name,
	alternateName: [
		'Las Trebedes',
		'Taberna Las Trebedes',
		'Restaurante Las Trebedes Pozuelo de Zarzón',
	],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 927 44 81 65',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Casera', 'Mediterránea', 'Española'],
	areaServed: [
		{ '@type': 'City', name: 'Pozuelo de Zarzón' },
		{ '@type': 'AdministrativeArea', name: 'Valle del Alagón' },
		{ '@type': 'AdministrativeArea', name: 'Cáceres' },
		{ '@type': 'AdministrativeArea', name: 'Extremadura' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday'],
			opens: '07:30',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:30',
			closes: '17:45',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Buen lugar para desayunar o tomar una cerveza y tapitas.....cómodo .',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Muy contentos, muy buena comida y muy bien atendidos, volveremos',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Restaurante las Trebedes · Cocina casera en Pozuelo de Zarzón';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f4a37" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante las Trebedes, Las Trebedes Pozuelo de Zarzón, restaurante Pozuelo de Zarzón, taberna Pozuelo de Zarzón, comer Pozuelo de Zarzón, menú Valle del Alagón, bar Cáceres Pozuelo, C. Pósito Pozuelo de Zarzón"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Restaurante las Trebedes · Cocina casera en Pozuelo de Zarzón"
			ogDescription="Taberna y restaurante en la calle Pósito, 10 (Pozuelo de Zarzón). Desayunos desde las 7:30, raciones, bocadillos y menú de festivos. 4,2 en Google con 244 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Restaurante las Trebedes en la calle Pósito de Pozuelo de Zarzón"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2f4a37"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			postalCode={BUSINESS.postalCode}
			phone="+34927448165"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Restaurante las Trebedes"
			subtitle="Cocina casera · Pozuelo de Zarzón"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Pósito, 10 · Pozuelo de Zarzón"
				title="Cocina casera<br /><em>desde las 7:30.</em>"
				lede={`Las Trebedes es restaurante, cafetería y taberna en el número 10 de la calle Pósito de Pozuelo de Zarzón (Cáceres). Desayunos de primera hora, raciones de barra, bocadillos y el menú de festivos y días especiales. De lunes a viernes. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={comedor}
				imageAlt="Comedor de Restaurante las Trebedes con manteles amarillos de cuadros, vigas de madera y chimenea de piedra"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)`,
					},
					{ label: 'Horario', html: 'Lun–Vie · desde las 7:30' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phoneDisplay}</b>` },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Restaurante las Trebedes" items={SERVICIOS} />

			<LocalAbout
				label="El local"
				title="Taberna de piedra<br /><em>y mantel de cuadros.</em>"
				paragraphs={[
					'Restaurante las Trebedes —«Taberna Las Trebedes», como dice el rótulo verde de la puerta— ocupa el bajo de una casa de fachada amarilla y pared de piedra en la calle Pósito, 10, de Pozuelo de Zarzón (Cáceres), en el Valle del Alagón.',
					'Es un local de los de siempre: cafetería y taberna para el desayuno y la cerveza, y al fondo un comedor con vigas de madera, manteles amarillos de cuadros, chimenea de piedra y una vitrina con los vinos. Junto a la puerta quedan las mesas altas y las sillas apiladas de la terraza.',
					'La ficha de Google lo clasifica como restaurante, cafetería, taberna y cocina mediterránea. Abre de lunes a viernes desde las 7:30 —los lunes hasta las 17:00 y el resto de días hasta las 17:45— y descansa sábados y domingos. Su nombre es el del trébedes, el hierro de tres patas que se pone sobre las brasas, y la carta lo lleva dibujado.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Se repiten el desayuno, la cerveza con tapitas y la mano de los dueños: «prima la buena cocina y el buen hacer de los dueños», resume una de las reseñas.`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Raciones, bocadillos<br /><em>y menú de fiesta.</em>"
				description="Precios copiados de la carta de raciones y del menú que el propio restaurante tiene fotografiados en su ficha de Google. Son orientativos: la pizarra del día manda."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La carta publicada es de raciones y bocadillos, más un menú de fin de semana, festivos o especiales por 18 € con pan, postre, vino o agua y café (compartir menú cuesta 5 € más). El local abre de lunes a viernes: llama al 927 44 81 65 para confirmar qué hay ese día."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La puerta<br /><em>y los platos.</em>"
				description="Estas fotografías proceden del perfil de Restaurante las Trebedes en Google Maps: la fachada de piedra en la calle Pósito, el comedor de vigas y manteles amarillos y los platos que salen de su cocina."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Nos vemos<br /><em>en la calle Pósito.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google. De lunes a viernes desde las 7:30: los lunes hasta las 17:00 y de martes a viernes hasta las 17:45. Sábados y domingos, cerrado."
				mapTitle="Mapa de Restaurante las Trebedes en la calle Pósito, 10, Pozuelo de Zarzón (Cáceres)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Restaurante las Trebedes · Pozuelo de Zarzón"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva llamando al 927 44 81 65. La ficha de Google marca acceso para sillas de ruedas y asientos adaptados. Está en la calle Pósito, 10, de Pozuelo de Zarzón, en el Valle del Alagón."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Las Trebedes"
		/>
	</body>
</html>
