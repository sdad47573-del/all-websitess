---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import interior from '../assets/fotos/la-buena-vertical-01.jpg';
import tostas from '../assets/fotos/la-buena-apaisada-03.jpg';
import bowl from '../assets/fotos/la-buena-apaisada-10.jpg';
import salmon from '../assets/fotos/la-buena-vertical-04.jpg';
import bocadillo from '../assets/fotos/la-buena-vertical-05.jpg';
import carne from '../assets/fotos/la-buena-vertical-06.jpg';
import batatas from '../assets/fotos/la-buena-vertical-07.jpg';
import tostaJamon from '../assets/fotos/la-buena-vertical-08.jpg';
import mesa from '../assets/fotos/la-buena-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	MENU_NOTE,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'La Buena · Brunch y cocina non stop en Escaldes-Engordany';
const description = BUSINESS.description;

const galeria = [
	{
		src: tostas,
		alt: 'Tres tostas de La Buena con jamón, salmón y aguacate sobre platos de cerámica',
	},
	{
		src: bowl,
		alt: 'Bowl de La Buena con aguacate, queso a la plancha, espinacas, champiñones, zanahoria y remolacha',
	},
	{
		src: salmon,
		alt: 'Tosta de salmón ahumado con aguacate, queso crema y pipas de calabaza',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo tostado de La Buena con jamón, queso y espinacas servido en papel',
	},
	{
		src: carne,
		alt: 'Carne a la plancha de La Buena con arroz, ensalada de hojas y pan tostado',
	},
	{
		src: batatas,
		alt: 'Cesta de batatas fritas de La Buena con tres salsas en un plato de pizarra',
	},
	{
		src: tostaJamon,
		alt: 'Tosta de jamón curado con aguacate y cebolla confitada sobre pan de masa madre',
	},
	{
		src: mesa,
		alt: 'Mesa de La Buena con pollo y verduras, carne con huevo y ensalada, y el QR para pedir',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-buena`,
	name: BUSINESS.name,
	alternateName: ['LaBuena', 'La Buena Escaldes', 'La Buena Andorra', 'La Buena brunch'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Brunch', 'Cocina saludable', 'Desayunos', 'Platos para compartir'],
	hasMenu: {
		'@type': 'Menu',
		name: 'Carta de La Buena',
		inLanguage: 'es-ES',
		hasMenuSection: MENU.map((group) => ({
			'@type': 'MenuSection',
			name: group.title,
			hasMenuItem: group.items.map((item) => ({
				'@type': 'MenuItem',
				name: item.name,
				description: item.note,
			})),
		})),
	},
	areaServed: [
		{ '@type': 'City', name: 'Escaldes-Engordany' },
		{ '@type': 'AdministrativeArea', name: 'Parroquia de Escaldes-Engordany' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.parish,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google Maps feature ID', value: BUSINESS.featureId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '09:00',
			closes: '23:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Pedido por QR en la mesa', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Qué se come', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-buena-vertical-01.jpg": interior,
	"la-buena-apaisada-03.jpg": tostas,
	"la-buena-apaisada-10.jpg": bowl,
	"la-buena-vertical-04.jpg": salmon,
	"la-buena-vertical-05.jpg": bocadillo,
	"la-buena-vertical-06.jpg": carne,
	"la-buena-vertical-07.jpg": batatas,
	"la-buena-vertical-08.jpg": tostaJamon,
	"la-buena-vertical-09.jpg": mesa,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#fbf6ec" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Buena Escaldes, brunch Andorra, brunch Escaldes-Engordany, desayunos Andorra, cocina non stop Andorra, tostas aguacate Andorra, bowls saludables Andorra, comer en Escaldes, terraceo Andorra, Passatge Antònia Font Caminal"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Brunch y cocina non stop en el Passatge Antònia Font Caminal 7 de Escaldes-Engordany. Tostas, bowls, carnes a la plancha y terraza, todos los días de 9:00 a 23:00. 4,3 sobre 5 con 288 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Interior de La Buena con lámparas de mimbre, plantas y el rótulo Healthy is not boring"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#fbf6ec"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.parish}
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Escaldes-Engordany"
			countryName="Andorra"
			preload={[interior]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Buena"
			subtitle="Brunch · Non stop"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de La Buena"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
