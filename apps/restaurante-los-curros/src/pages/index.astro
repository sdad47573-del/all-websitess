---
import '../styles/global.css';
import {
	business,
	directionsUrl,
	facebookUrl,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHrefs,
	structuredData,
} from '../lib/business';

const title = 'Restaurante Los Curros | Cocina malagueña en Rincón de la Victoria';
const description =
	'Restaurante Los Curros, en el paseo marítimo de Rincón de la Victoria (Málaga): parrilla de carnes y pescados, espetos de sardinas y cocina tradicional malagueña. Reservas: 952 97 03 72.';

const carta = [
	{ num: '01', name: 'Carnes y pescados a la parrilla', note: 'Buen producto, elaborado a la brasa.' },
	{ num: '02', name: 'Espetos de sardinas', note: 'Un clásico malagueño en el paseo.' },
	{ num: '03', name: 'Cocina tradicional malagueña', note: 'Platos de siempre, con sabor de casa.' },
	{ num: '04', name: 'Salones para celebraciones', note: 'Comidas de grupo y despedidas.' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#12263a" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="Rincón de la Victoria" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Chivo+Mono:wght@400;500&family=Inter+Tight:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante Los Curros, inicio"><span class="brand-mark" aria-hidden="true">LC</span><span class="brand-label">LOS CURROS <small>RESTAURANTE · RINCÓN DE LA VICTORIA</small></span></a>
			<nav aria-label="Navegación principal"><a href="#carta">La carta</a><a href="#contacto">Contacto</a></nav>
			<a class="header-phone" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> {business.phones[0]}</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-content">
					<p class="eyebrow"><span></span> COCINA TRADICIONAL MALAGUEÑA · PASEO MARÍTIMO</p>
					<h1 id="hero-title">Los<br /><em>Curros</em></h1>
					<p class="hero-sub">Restaurante · Rincón de la Victoria</p>
					<p class="hero-intro">Más de 20 años de cocina tradicional malagueña en primera línea de playa: carnes y pescados a la parrilla, espetos de sardinas y platos de siempre, con trato familiar.</p>
					<div class="hero-actions"><a class="button button-navy" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Llamar y reservar</a><a class="button button-outline" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<dl class="hero-datos">
						<div><dt>DIRECCIÓN</dt><dd><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></dd></div>
						<div><dt>RESERVAS</dt><dd><a href={phoneHrefs[0]}>{business.phones[0]}</a></dd></div>
						<div><dt>MAPA</dt><dd><a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a></dd></div>
					</dl>
				</div>
			</section>

			<section class="carta-section" id="carta" aria-labelledby="carta-title">
				<p class="section-label"><span>01 /</span> LA CARTA</p>
				<div class="carta-head"><h2 id="carta-title">Del mar<br /><em>y de la brasa.</em></h2><p class="carta-lead">Parrilla, pescado y platos malagueños de toda la vida. Consulta la carta completa en el local.</p></div>
				<ol class="carta-index">
					{carta.map((item) => (
						<li class="carta-item"><span class="carta-num" aria-hidden="true">{item.num}</span><span class="carta-text"><strong>{item.name}</strong><small>{item.note}</small></span></li>
					))}
				</ol>
			</section>

			<section class="about-section" aria-labelledby="about-title">
				<p class="section-label"><span>02 /</span> LOS CURROS · RINCÓN DE LA VICTORIA</p>
				<div class="about-content"><h2 id="about-title">Cocina de siempre,<br /><em>a la orilla del mar.</em></h2><div><p>Somos un equipo de hostelería con más de 20 años de experiencia. En nuestro restaurante del paseo marítimo de Rincón de la Victoria vas a encontrar desde una comida rápida y económica hasta carnes y pescados que no tienen nada que envidiar a otros grandes restaurantes. Buena parrilla, servicio excelente y salones de construcción rústica para celebraciones y despedidas.</p><a class="social-link" href={instagramUrl} target="_blank" rel="noreferrer">Síguenos en Instagram <span aria-hidden="true">↗</span></a></div></div>
				<div class="about-footer"><span>PARRILLA · PESCADO · TRADICIÓN</span><span>29730 RINCÓN DE LA VICTORIA</span><span>✦</span></div>
			</section>

			<section class="contact-section" id="contacto" aria-labelledby="contact-title">
				<p class="section-label"><span>03 /</span> VISÍTANOS</p>
				<div class="contact-layout">
					<div class="contact-copy"><p class="contact-kicker">EN EL PASEO MARÍTIMO</p><h2 id="contact-title">Reserva<br /><em>tu mesa.</em></h2>
						<div class="contact-card">
							<div class="contact-row"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div></div>
							<div class="contact-row"><span aria-hidden="true">☎</span><div><small>RESERVAS</small><a href={phoneHrefs[0]}>{business.phones[0]}</a></div></div>
						</div>
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-card"><div class="map-header"><span><i></i> AV. DEL MEDITERRÁNEO · RINCÓN</span><a href={mapsUrl} target="_blank" rel="noreferrer">ABRIR MAPS ↗</a></div><iframe title="Mapa de Restaurante Los Curros en Avenida del Mediterráneo, Rincón de la Victoria" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><div class="map-footer"><span aria-hidden="true">⌖</span><div><strong>{business.name}</strong><small>{business.streetAddress} · {business.city}</small></div><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar a Restaurante Los Curros">↗</a></div></div>
				</div>
				<div class="social-row"><span>ENCUÉNTRANOS TAMBIÉN EN</span><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a><a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a></div>
			</section>
		</main>

		<footer class="site-footer"><a class="brand footer-brand" href="#inicio" aria-label="Restaurante Los Curros, volver al inicio"><span class="brand-mark">LC</span><span class="brand-label">LOS CURROS <small>RESTAURANTE · RINCÓN DE LA VICTORIA</small></span></a><p>{business.streetAddress}, {business.postalCode} {business.city}<br /><a href={phoneHrefs[0]}>{business.phones[0]}</a></p><a class="footer-social" href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a><small>© {new Date().getFullYear()} Restaurante Los Curros · Rincón de la Victoria &nbsp;·&nbsp; Consulta la carta y los horarios en el local.</small></footer>
		<a class="phone-cta" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Reservar en Los Curros <strong>{business.phones[0]}</strong></a>
	</body>
</html>
