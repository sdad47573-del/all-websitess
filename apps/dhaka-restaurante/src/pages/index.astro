---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachadaNoite from '../assets/fotos/dhaka-restaurante-apaisada-01.jpg';
import jalebi from '../assets/fotos/dhaka-restaurante-vertical-02.jpg';
import balcao from '../assets/fotos/dhaka-restaurante-cuadrada-03.jpg';
import mesaCaril from '../assets/fotos/dhaka-restaurante-apaisada-04.jpg';
import salaLaranja from '../assets/fotos/dhaka-restaurante-apaisada-05.jpg';
import mesaNaan from '../assets/fotos/dhaka-restaurante-vertical-06.jpg';
import portaNoite from '../assets/fotos/dhaka-restaurante-vertical-07.jpg';
import salaBranca from '../assets/fotos/dhaka-restaurante-apaisada-08.jpg';
import vitrina from '../assets/fotos/dhaka-restaurante-apaisada-09.jpg';
import mesaBiryani from '../assets/fotos/dhaka-restaurante-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICOS,
} from '../data/site';

const title = 'Dhaka Restaurante · Cozinha indiana e bangladeshiana em Lisboa';
const description = BUSINESS.description;

const galeria = [
	{
		src: portaNoite,
		alt: 'Entrada do Dhaka Restaurante iluminada à noite, com o letreiro «Dhaka Restaurante» e os selos halal, a porta aberta sobre a sala e a lista de preços afixada na parede à direita',
	},
	{
		src: salaBranca,
		alt: 'Sala do Dhaka com paredes brancas, faixa de azulejo cinzento, mesas de madeira com toalhas de plástico e cadeiras de espaldar alto',
	},
	{
		src: salaLaranja,
		alt: 'Sala do Dhaka com paredes cor de laranja, rodapé de azulejo, televisão, cortina e vitrina de bebidas e doces ao fundo',
	},
	{
		src: balcao,
		alt: 'Balcão do Dhaka com tabuleiros de frituras de frango, pão frito e um pote grande, com um funcionário de camisa florida atrás',
	},
	{
		src: mesaNaan,
		alt: 'Prato grande de naan cortado em triângulos numa mesa de plástico, com um prato de legumes com grão, uma samosa com molho vermelho e a lista da casa',
	},
	{
		src: mesaBiryani,
		alt: 'Prato de biryani de arroz amarelo com carne, ao lado de uma salada com lima e um molho branco, sobre uma mesa rosa',
	},
	{
		src: mesaCaril,
		alt: 'Mesa do Dhaka com um prato de caril de carne, arroz branco, naan cortado e uma caneca alta de bebida de leite com palhinha',
	},
	{
		src: vitrina,
		alt: 'Vitrina do Dhaka com um tabuleiro de jalebi sobre folha de alumínio e, na prateleira de baixo, quadrados de doce de leite',
	},
	{
		src: jalebi,
		alt: 'Travessa de metal cheia de jalebi, os doces em espiral cor de laranja da casa',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#dhaka-restaurante`,
	name: BUSINESS.name,
	alternateName: ['Dhaka', 'Dhaka Lisboa', 'Dhaka Restaurante Mouraria'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Bangladeshiana', 'Indiana', 'Sul-asiática'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Mouraria' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '09:00',
			closes: '24:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"dhaka-restaurante-apaisada-01.jpg": fachadaNoite,
	"dhaka-restaurante-vertical-07.jpg": portaNoite,
	"dhaka-restaurante-apaisada-08.jpg": salaBranca,
	"dhaka-restaurante-apaisada-05.jpg": salaLaranja,
	"dhaka-restaurante-cuadrada-03.jpg": balcao,
	"dhaka-restaurante-vertical-06.jpg": mesaNaan,
	"dhaka-restaurante-vertical-10.jpg": mesaBiryani,
	"dhaka-restaurante-apaisada-04.jpg": mesaCaril,
	"dhaka-restaurante-apaisada-09.jpg": vitrina,
	"dhaka-restaurante-vertical-02.jpg": jalebi,
};
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0f1526" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Karla:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Dhaka Restaurante, Dhaka Lisboa, restaurante bangladesí Lisboa, comida indiana Mouraria, R. do Benformoso 220, restaurante halal Lisboa, caril de camarão Lisboa, biryani Lisboa, comida indiana sem álcool"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cozinha indiana e bangladeshiana na R. do Benformoso 220, na Mouraria. Todos os dias das 9:00 às 24:00, halal e 0% álcool."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Letreiros iluminados do Dhaka Restaurante na R. do Benformoso, em Lisboa"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#0f1526"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Mouraria, Lisboa"
			locale="pt_PT"
			countryName="Portugal"
			preload={[fachadaNoite]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Dhaka Restaurante"
			subtitle="Indiana e bangladeshiana · Mouraria"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Informação elaborada a partir de fontes públicas; confirma horário e oferta antes da visita."
			ctaLabel="Ligar"
			navAriaLabel="Ligações do Dhaka Restaurante"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/351920492645?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Lisboa." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Lisboa"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
