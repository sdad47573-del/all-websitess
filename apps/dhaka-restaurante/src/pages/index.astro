---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachadaNoite from '../assets/fotos/dhaka-restaurante-apaisada-01.jpg';
import jalebi from '../assets/fotos/dhaka-restaurante-vertical-02.jpg';
import balcao from '../assets/fotos/dhaka-restaurante-cuadrada-03.jpg';
import mesaCaril from '../assets/fotos/dhaka-restaurante-apaisada-04.jpg';
import salaLaranja from '../assets/fotos/dhaka-restaurante-apaisada-05.jpg';
import mesaNaan from '../assets/fotos/dhaka-restaurante-vertical-06.jpg';
import portaNoite from '../assets/fotos/dhaka-restaurante-vertical-07.jpg';
import salaBranca from '../assets/fotos/dhaka-restaurante-apaisada-08.jpg';
import vitrina from '../assets/fotos/dhaka-restaurante-apaisada-09.jpg';
import mesaBiryani from '../assets/fotos/dhaka-restaurante-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICOS } from '../data/site';

const title = 'Dhaka Restaurante · Cozinha indiana e bangladeshiana em Lisboa';
const description = BUSINESS.description;

const galeria = [
	{
		src: portaNoite,
		alt: 'Entrada do Dhaka Restaurante iluminada à noite, com o letreiro «Dhaka Restaurante» e os selos halal, a porta aberta sobre a sala e a lista de preços afixada na parede à direita',
	},
	{
		src: salaBranca,
		alt: 'Sala do Dhaka com paredes brancas, faixa de azulejo cinzento, mesas de madeira com toalhas de plástico e cadeiras de espaldar alto',
	},
	{
		src: salaLaranja,
		alt: 'Sala do Dhaka com paredes cor de laranja, rodapé de azulejo, televisão, cortina e vitrina de bebidas e doces ao fundo',
	},
	{
		src: balcao,
		alt: 'Balcão do Dhaka com tabuleiros de frituras de frango, pão frito e um pote grande, com um funcionário de camisa florida atrás',
	},
	{
		src: mesaNaan,
		alt: 'Prato grande de naan cortado em triângulos numa mesa de plástico, com um prato de legumes com grão, uma samosa com molho vermelho e a lista da casa',
	},
	{
		src: mesaBiryani,
		alt: 'Prato de biryani de arroz amarelo com carne, ao lado de uma salada com lima e um molho branco, sobre uma mesa rosa',
	},
	{
		src: mesaCaril,
		alt: 'Mesa do Dhaka com um prato de caril de carne, arroz branco, naan cortado e uma caneca alta de bebida de leite com palhinha',
	},
	{
		src: vitrina,
		alt: 'Vitrina do Dhaka com um tabuleiro de jalebi sobre folha de alumínio e, na prateleira de baixo, quadrados de doce de leite',
	},
	{
		src: jalebi,
		alt: 'Travessa de metal cheia de jalebi, os doces em espiral cor de laranja da casa',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#dhaka-restaurante`,
	name: BUSINESS.name,
	alternateName: ['Dhaka', 'Dhaka Lisboa', 'Dhaka Restaurante Mouraria'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Bangladeshiana', 'Indiana', 'Sul-asiática'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Mouraria' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '09:00',
			closes: '24:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0f1526" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Karla:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Dhaka Restaurante, Dhaka Lisboa, restaurante bangladesí Lisboa, comida indiana Mouraria, R. do Benformoso 220, restaurante halal Lisboa, caril de camarão Lisboa, biryani Lisboa, comida indiana sem álcool"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cozinha indiana e bangladeshiana na R. do Benformoso 220, na Mouraria. Todos os dias das 9:00 às 24:00, halal e 0% álcool."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Letreiros iluminados do Dhaka Restaurante na R. do Benformoso, em Lisboa"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#0f1526"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Mouraria, Lisboa"
			locale="pt_PT"
			countryName="Portugal"
			preload={[fachadaNoite]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Dhaka Restaurante"
			subtitle="Indiana e bangladeshiana · Mouraria"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · Mouraria`}
				title="Cozinha indiana <br /><em>e bangladeshiana.</em>"
				lede={`O Dhaka Restaurante é uma casa de comida indiana e bangladeshiana na R. do Benformoso 220, na Mouraria, em Lisboa. Abre todos os dias às 9:00 e fecha às 24:00, anuncia «0% alcohol» e a ficha de Google dá-lhe 3,8 sobre 5 com 419 críticas.`}
				image={fachadaNoite}
				imageAlt="Os dois letreiros iluminados do Dhaka Restaurante na R. do Benformoso, nos números 222 e 220, com os selos halal e a inscrição «Comida Tradicional Indiana»"
				primaryCta={{ label: 'Como chegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha e críticas no Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>3,8</b> no Google · 419 críticas' },
					{ label: 'Horário', html: '<b>9:00–24:00</b> todos os dias' },
					{ label: 'Telefone', html: `<b>${BUSINESS.phone}</b> contacto publicado` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto do perfil de Google Maps"
				galleryLinkLabel="Ver a galeria"
			/>

			<LocalChips label="O que encontras no Dhaka Restaurante" items={SERVICOS} />

			<LocalAbout
				label="A casa"
				title="Halal, <br /><em>sem álcool.</em>"
				paragraphs={[
					'O Dhaka Restaurante fica na R. do Benformoso 220, na Mouraria, em Lisboa (1100-395). As fotografias do perfil mostram os letreiros iluminados de dois números contíguos, o 222 e o 220, com o nome da casa, o selo redondo «HALAL» e a inscrição «Comida Tradicional Indiana».',
					'Por baixo, o letreiro anuncia «comida tradicional indiana e bangladeshiana» e «0% alcohol». A Google classifica a casa como restaurante bangladesí e bengalí, e dá-lhe 3,8 sobre 5 com 419 críticas.',
					'Por dentro há duas salas: uma de paredes brancas com faixa de azulejo cinzento, e outra de paredes cor de laranja com rodapé de azulejo, televisão e vitrina de bebidas e doces. As mesas de madeira levam toalhas de plástico e há avisos nas paredes em bengali.',
					'As fotografias de mesa mostram biryani de carne, naan cortado, caril de carne com arroz, samosa com molho, salada com lima, jalebi e doces de leite. O horário é contínuo: todos os dias, das 9:00 às 24:00, e a ficha assinala que em feriados pode ser diferente.',
				]}
				note="A informação vem da ficha pública de Google Maps e das fotografias do perfil da casa. A lista de preços que aparece afixada à porta não está datada, por isso nenhum preço se apresenta como atual."
				links={[
					{ label: 'Ficha e críticas no Google', href: MAPS.reviews, external: true },
					{ label: 'Ver a casa no Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="A mesa"
				title="Biryani, caris <br /><em>e naan.</em>"
				description="A ficha de Google não publica carta nem preços, e a casa não tem site próprio. O que segue vem das fotografias do seu perfil e da lista que está afixada à porta do número 220."
				cta={{ label: 'Ver fotos no Google Maps', href: MAPS.place }}
				groups={MENU}
				note="Não há carta oficial publicada. A lista afixada à porta tem secções de camarão e de carne com preços na ordem dos 9 a 11 €, mas não está datada e pode estar desatualizada; confirma por telefone antes de contar com um prato ou um preço."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Nove fotografias <br /><em>da casa.</em>"
				description="As fotografias do perfil do Dhaka Restaurante em Google Maps: os letreiros à noite, as duas salas, o balcão, a vitrina dos doces e os pratos que se servem à mesa."
				images={galeria}
				cta={{ label: 'Ver tudo no Google Maps', href: MAPS.place }}
				note="Imagens alojadas nesta página e provenientes do perfil do estabelecimento em Google Maps. Se tens os direitos de alguma e queres retirá-la, diz-nos e apagamo-la."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Passa pelo <br /><em>Benformoso.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Lisboa, Portugal']}
				hours={HOURS}
				hoursCaption="Horário"
				hoursNote="Horário publicado na ficha de Google: todos os dias, das 9:00 às 24:00. A ficha assinala que em feriados o horário pode ser diferente, por isso convém confirmá-lo antes de ir."
				mapTitle="Mapa do Dhaka Restaurante na R. do Benformoso 220, Lisboa"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Dhaka · Mouraria"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Como chegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Ligar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="O telefone é o único canal de contacto que publica a ficha. Não há reservas nem encomendas em linha: a casa não tem site próprio nem plataforma de reservas associada. A ficha também não indica informação sobre esplanada, take-away ou acessibilidade."
			/>

			<LocalFaq items={FAQ} eyebrow="Perguntas frequentes" title="Antes de <em>vir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Informação elaborada a partir de fontes públicas; confirma horário e oferta antes da visita."
			ctaLabel="Ligar"
			navAriaLabel="Ligações do Dhaka Restaurante"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
