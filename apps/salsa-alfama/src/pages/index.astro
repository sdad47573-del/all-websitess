---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/salsa-alfama-apaisada-01.jpg';
import massa from '../assets/fotos/salsa-alfama-apaisada-03.jpg';
import salaJanela from '../assets/fotos/salsa-alfama-apaisada-05.jpg';
import rio from '../assets/fotos/salsa-alfama-apaisada-06.jpg';
import tramPorta from '../assets/fotos/salsa-alfama-apaisada-08.jpg';
import parede from '../assets/fotos/salsa-alfama-apaisada-10.jpg';
import janela from '../assets/fotos/salsa-alfama-vertical-02.jpg';
import menu from '../assets/fotos/salsa-alfama-vertical-04.jpg';
import porta from '../assets/fotos/salsa-alfama-vertical-07.jpg';
import rua from '../assets/fotos/salsa-alfama-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	PASSOS,
	REVIEWS,
	SERVICOS,
} from '../data/site';

const title = 'Salsa · restaurante e bar em Alfama, Lisboa';
const description =
	'Restaurante e bar na Rua das Escolas Gerais, 57, em Alfama: cozinha portuguesa, entradas para partilhar e vista sobre os telhados e o Tejo. Reservas 21 886 0883.';

const galeria = [
	{
		src: rio,
		alt: 'Vista sobre os telhados de Alfama e o Tejo, com um barco a atravessar o rio',
	},
	{
		src: menu,
		alt: 'Página de menu do Salsa com as entradas e os preços, em fundo escuro',
	},
	{
		src: tramPorta,
		alt: 'Elétrico amarelo da Carris a passar à porta do Salsa, na Rua das Escolas Gerais',
	},
	{
		src: massa,
		alt: 'Massa com camarão, amêijoa e mexilhão num prato branco',
	},
	{
		src: janela,
		alt: 'Copo de vinho branco e prato sobre a mesa, com a janela aberta para os telhados de Alfama',
	},
	{
		src: salaJanela,
		alt: 'Sala do Salsa com toalhas azuis, cadeiras de madeira e janelas abertas para os telhados',
	},
	{
		src: porta,
		alt: 'Interior do restaurante visto da sala, com a porta aberta e o elétrico na rua',
	},
	{
		src: rua,
		alt: 'Fachada de azulejo e a rua em calçada, com o elétrico amarelo ao fundo',
	},
	{
		src: parede,
		alt: 'Parede da sala com fotografias emolduradas de Alfama e mesas com toalhas azuis',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#salsa`,
	name: BUSINESS.name,
	alternateName: ['Salsa Restaurant & Bar', 'Salsa Alfama', 'Salsa Lisboa'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 21 886 0883',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cozinha portuguesa', 'Frutos do mar', 'Entradas para partilhar'],
	acceptsReservations: BUSINESS.phoneHref,
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Distrito de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '12:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Lugares para pessoas em cadeiras de rodas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Estacionamento acessível a pessoas em cadeiras de rodas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"salsa-alfama-apaisada-01.jpg": fachada,
	"salsa-alfama-apaisada-06.jpg": rio,
	"salsa-alfama-vertical-04.jpg": menu,
	"salsa-alfama-apaisada-08.jpg": tramPorta,
	"salsa-alfama-apaisada-03.jpg": massa,
	"salsa-alfama-vertical-02.jpg": janela,
	"salsa-alfama-apaisada-05.jpg": salaJanela,
	"salsa-alfama-vertical-07.jpg": porta,
	"salsa-alfama-vertical-09.jpg": rua,
	"salsa-alfama-apaisada-10.jpg": parede,
};
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#a6202b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Work+Sans:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Salsa Alfama, Salsa Restaurant Bar Lisboa, restaurante Alfama, Rua das Escolas Gerais, comer em Alfama, restaurante português Alfama, bar Alfama, elétrico 28"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cozinha portuguesa e entradas para partilhar na Rua das Escolas Gerais, 57 · Alfama. Reservas pelo 21 886 0883."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de azulejo do Salsa, com o letreiro vermelho por cima da porta"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#a6202b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lisboa"
			locale="pt_PT"
			countryName="Portugal"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Salsa"
			subtitle="Restaurante e bar · Alfama"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Como chegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Informação elaborada a partir de fontes públicas; confirma horário, carta e preços antes da visita."
			ctaLabel="Ligar ao Salsa"
			navAriaLabel="Ligações do Salsa"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
