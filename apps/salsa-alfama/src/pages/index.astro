---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/salsa-alfama-apaisada-01.jpg';
import massa from '../assets/fotos/salsa-alfama-apaisada-03.jpg';
import salaJanela from '../assets/fotos/salsa-alfama-apaisada-05.jpg';
import rio from '../assets/fotos/salsa-alfama-apaisada-06.jpg';
import tramPorta from '../assets/fotos/salsa-alfama-apaisada-08.jpg';
import parede from '../assets/fotos/salsa-alfama-apaisada-10.jpg';
import janela from '../assets/fotos/salsa-alfama-vertical-02.jpg';
import menu from '../assets/fotos/salsa-alfama-vertical-04.jpg';
import porta from '../assets/fotos/salsa-alfama-vertical-07.jpg';
import rua from '../assets/fotos/salsa-alfama-vertical-09.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, PASSOS, REVIEWS, SERVICOS } from '../data/site';

const title = 'Salsa · restaurante e bar em Alfama, Lisboa';
const description =
	'Restaurante e bar na Rua das Escolas Gerais, 57, em Alfama: cozinha portuguesa, entradas para partilhar e vista sobre os telhados e o Tejo. Reservas 21 886 0883.';

const galeria = [
	{
		src: rio,
		alt: 'Vista sobre os telhados de Alfama e o Tejo, com um barco a atravessar o rio',
	},
	{
		src: menu,
		alt: 'Página de menu do Salsa com as entradas e os preços, em fundo escuro',
	},
	{
		src: tramPorta,
		alt: 'Elétrico amarelo da Carris a passar à porta do Salsa, na Rua das Escolas Gerais',
	},
	{
		src: massa,
		alt: 'Massa com camarão, amêijoa e mexilhão num prato branco',
	},
	{
		src: janela,
		alt: 'Copo de vinho branco e prato sobre a mesa, com a janela aberta para os telhados de Alfama',
	},
	{
		src: salaJanela,
		alt: 'Sala do Salsa com toalhas azuis, cadeiras de madeira e janelas abertas para os telhados',
	},
	{
		src: porta,
		alt: 'Interior do restaurante visto da sala, com a porta aberta e o elétrico na rua',
	},
	{
		src: rua,
		alt: 'Fachada de azulejo e a rua em calçada, com o elétrico amarelo ao fundo',
	},
	{
		src: parede,
		alt: 'Parede da sala com fotografias emolduradas de Alfama e mesas com toalhas azuis',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#salsa`,
	name: BUSINESS.name,
	alternateName: ['Salsa Restaurant & Bar', 'Salsa Alfama', 'Salsa Lisboa'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 21 886 0883',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cozinha portuguesa', 'Frutos do mar', 'Entradas para partilhar'],
	acceptsReservations: BUSINESS.phoneHref,
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Distrito de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '12:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Lugares para pessoas em cadeiras de rodas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Estacionamento acessível a pessoas em cadeiras de rodas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#a6202b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Work+Sans:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Salsa Alfama, Salsa Restaurant Bar Lisboa, restaurante Alfama, Rua das Escolas Gerais, comer em Alfama, restaurante português Alfama, bar Alfama, elétrico 28"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cozinha portuguesa e entradas para partilhar na Rua das Escolas Gerais, 57 · Alfama. Reservas pelo 21 886 0883."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de azulejo do Salsa, com o letreiro vermelho por cima da porta"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#a6202b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lisboa"
			locale="pt_PT"
			countryName="Portugal"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Salsa"
			subtitle="Restaurante e bar · Alfama"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow="Rua das Escolas Gerais, 57 · Alfama"
				title="Salsa, <br /><em>em Alfama.</em>"
				lede="Um restaurante e bar numa casa forrada a azulejo, a dois passos das Portas do Sol. Cozinha portuguesa, entradas para partilhar e uma janela aberta sobre os telhados e o Tejo."
				image={fachada}
				imageAlt="Fachada de azulejo do Salsa com o letreiro vermelho, na Rua das Escolas Gerais"
				primaryCta={{ label: `Reservar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha e críticas no Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> no Google · 867 críticas' },
					{ label: 'Horário', html: '<b>12:00–23:00</b> de terça a domingo' },
					{ label: 'Onde', html: '<b>Alfama</b> · elétrico 28 à porta' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto do perfil de Google Maps"
				galleryLinkLabel="Ver a galeria"
				tag="Elétrico 28 à porta"
			/>

			<LocalChips label="O que se encontra no Salsa" items={SERVICOS} />

			<section class="passos" id="tasca" aria-labelledby="passos-title">
				<div class="wrap">
					<div class="passos-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Como funciona</p>
							<h2 id="passos-title">Entrar, partilhar, <br /><em>ficar.</em></h2>
						</div>
						<p>
							A casa é restaurante e bar ao mesmo tempo: come-se à mesa e bebe-se ao
							balcão, com a rua de Alfama a passar à janela.
						</p>
					</div>
					<div class="passos-grid">
						{
							PASSOS.map((item) => (
								<article class="passo">
									<span class="passo-num" aria-hidden="true">{item.icon}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<LocalAbout
				label="A casa"
				title="Azulejo, <br /><em>toalhas azuis.</em>"
				paragraphs={[
					'O Salsa ocupa um rés-do-chão na Rua das Escolas Gerais, 57, uma das ruas que sobem de Alfama para São Vicente. A fachada é toda de azulejo padrão e o letreiro vermelho, com folhas verdes, marca a entrada. Ao lado passa o elétrico 28.',
					'Lá dentro, a sala tem lambris de madeira escura e toalhas azuis; nas paredes estão fotografias emolduradas de Alfama, dos elétricos e do rio. Duas janelas grandes abrem-se sobre os telhados e o Tejo, e é por elas que entra a luz que se vê nas fotografias.',
					'A cozinha é portuguesa, com uma mão de entradas asiáticas: bacalhau à Brás, bacalhau assado, arroz de polvo, sopa de legumes e massa de marisco convivem com gyōza, edamame, karaage, chahan, chasu e sonomono. A descrição que a casa assina na ficha de Google resume tudo numa frase: «we serve tipical portugues food».',
					'É também bar, por isso serve-se vinho ao copo e cocktails, e a casa fica aberta das 12:00 às 23:00. A ficha de Google tem 4,6 sobre 5 com 867 críticas; as reservas fazem-se por telefone.',
				]}
				note="Uma crítica no Google diz: «Excelente restaurante, bom serviço e boa localização.» Outra descreve a escolha da mesa: «uma sopa de legumes, um bacalhau à Brás e um bacalhau assado»."
				links={[
					{ label: 'Ficha e críticas no Google', href: MAPS.place, external: true },
					{ label: `Reservar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="A carta"
				title="Entradas, <br /><em>peixe e marisco.</em>"
				description="Começa-se pelas entradas para partilhar e segue-se para a cozinha portuguesa: bacalhau, arroz de polvo e marisco. Os preços das entradas são os da página de menu da casa."
				cta={{ label: `Reservar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Preços das entradas copiados da página de menu publicada no perfil de Google Maps (outubro de 2026). Os pratos principais não têm preço publicado em linha e a carta muda com o mercado: confirma na mesa ou por telefone."
			/>

			<section class="voices" aria-labelledby="voices-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Quem já comeu aqui</p>
					<h2 id="voices-title">O que dizem <em>as críticas.</em></h2>
					<div class="voice-grid">
						{
							REVIEWS.map((review) => (
								<figure class="voice">
									<blockquote>{review.text}</blockquote>
									<figcaption>Crítica no Google · {review.rating}/5</figcaption>
								</figure>
							))
						}
					</div>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Nove fotografias <br /><em>da casa.</em>"
				description="As fotografias do perfil do Salsa em Google Maps: a fachada de azulejo, a sala com toalhas azuis, a vista sobre o Tejo, o elétrico à porta e os pratos."
				images={galeria}
				cta={{ label: 'Ver tudo no Google Maps', href: MAPS.place }}
				note="Imagens alojadas nesta página e provenientes do perfil do estabelecimento em Google Maps. Se tens os direitos de alguma e queres retirá-la, diz-nos e apagamo-la."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Encontrar o Salsa <br /><em>em Alfama.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Lisboa, Portugal']}
				hours={HOURS}
				hoursCaption="Horário da casa"
				hoursNote="Horário publicado na ficha de Google: de terça a domingo, das 12:00 às 23:00, sem fechar para o almoço. À segunda-feira encerra; em feriados convém confirmar."
				mapTitle="Mapa do Salsa na Rua das Escolas Gerais, 57, Alfama, Lisboa"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Salsa · Alfama"
				mapHref={MAPS.cid}
				links={[
					{ label: `Ligar ${BUSINESS.phone}`, href: BUSINESS.phoneHref, variant: 'primary' },
					{ label: 'Como chegar', href: MAPS.directions, external: true },
					{ label: 'Críticas no Google', href: MAPS.reviews, external: true },
				]}
				contactLink={{ label: `Reservar pelo ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="As reservas fazem-se por telefone. A casa tem lugares para pessoas em cadeiras de rodas, mas não estacionamento acessível; a rua é estreita e sobe, como quase todas em Alfama. O Miradouro das Portas do Sol e a Igreja de São Vicente de Fora ficam a poucos minutos a pé."
			/>

			<LocalFaq items={FAQ} eyebrow="Perguntas frequentes" title="Antes de <em>subir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Como chegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Informação elaborada a partir de fontes públicas; confirma horário, carta e preços antes da visita."
			ctaLabel="Ligar ao Salsa"
			navAriaLabel="Ligações do Salsa"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
