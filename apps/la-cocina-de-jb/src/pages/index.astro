---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/la-cocina-de-jb-vertical-01.jpg';
import guisos from '../assets/fotos/la-cocina-de-jb-apaisada-02.jpg';
import cartel from '../assets/fotos/la-cocina-de-jb-apaisada-03.jpg';
import baguette from '../assets/fotos/la-cocina-de-jb-cuadrada-04.jpg';
import ensaladillaGambas from '../assets/fotos/la-cocina-de-jb-apaisada-05.jpg';
import ensaladaGambas from '../assets/fotos/la-cocina-de-jb-apaisada-06.jpg';
import ensaladaPatata from '../assets/fotos/la-cocina-de-jb-apaisada-07.jpg';
import pan from '../assets/fotos/la-cocina-de-jb-apaisada-08.jpg';
import carta from '../assets/fotos/la-cocina-de-jb-apaisada-09.jpg';
import ensaladilla from '../assets/fotos/la-cocina-de-jb-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'La Cocina de JB · Comida casera para llevar en Sevilla';
const description = BUSINESS.description;

const galeria = [
	{
		src: guisos,
		alt: 'Bandejas de acero con los guisos del día: verduras, guisantes con jamón, callos y pollo en salsa',
	},
	{
		src: cartel,
		alt: 'Cartel de madera del local con el nombre, el teléfono de pedidos 646 59 41 55 y fotos de sus platos',
	},
	{
		src: baguette,
		alt: 'Baguette de pollo abierta sobre mármol, con la barra crujiente y el relleno a la vista',
	},
	{
		src: ensaladillaGambas,
		alt: 'Ensaladilla rusa con patata, zanahoria y mayonesa, junto a una bandeja de ensalada de gambas',
	},
	{
		src: ensaladaGambas,
		alt: 'Bandeja de ensalada de gambas con tomate, cebolla, pimiento verde y aceitunas',
	},
	{
		src: ensaladaPatata,
		alt: 'Ensalada de patata con huevo cocido, tomate y perejil en una bandeja de acero inoxidable',
	},
	{
		src: ensaladilla,
		alt: 'Ensaladilla rusa recién hecha en una bandeja grande, espolvoreada con perejil',
	},
	{
		src: pan,
		alt: 'Vitrina con barras de pan y panecillos recién horneados en el mostrador del local',
	},
	{
		src: carta,
		alt: 'Carta del local fotografiada en una mesa: serranitos, combos de pollo, baguettes, fritos y hamburguesas',
	},
];

const cartaGrupos = [
	{
		title: 'Del pollo asado',
		items: [
			{ name: 'Pollo asado', note: 'la primera especialidad que anuncia el rótulo' },
			{ name: 'Combos de pollo', note: 'con patatas fritas, ensalada o croquetas, según la carta' },
			{ name: 'Alitas de pollo', note: 'por kilos, en la carta del local' },
			{ name: 'Croquetas de pollo y nuggets', note: 'en la sección de fritos' },
		],
	},
	{
		title: 'Baguettes, serranitos y hamburguesas',
		items: [
			{ name: 'Serranitos', note: 'de lomo, de pollo, de lomo adobado y de pollo empanado' },
			{ name: 'Baguettes', note: 'de filete de pollo, calamares, lomo o bacon y queso' },
			{ name: 'Baguettes especiales', note: 'tortilla, pollo empanado y combinados' },
			{ name: 'Hamburguesas', note: 'de pollo, crispy, de ternera y de buey' },
		],
	},
	{
		title: 'Fritos, guisos y cuchara',
		items: [
			{ name: 'Arroz guiso', note: 'la segunda especialidad del rótulo' },
			{ name: 'Pescado y freiduría', note: 'chocos, boquerones, adobo, merluza y puntillitas' },
			{ name: 'Guisos del día', note: 'verduras, guisantes con jamón, callos y pollo en salsa' },
			{ name: 'Ensaladillas y ensaladas', note: 'rusa, de patata con huevo y de gambas' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#cocinajb`,
	name: BUSINESS.name,
	alternateName: ['La Cocina de JB', 'La Cocina de JB Sevilla', 'Cocina de JB 41020'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, BUSINESS.web],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Pollo asado', 'Freiduría'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-cocina-de-jb-vertical-01.jpg": fachada,
	"la-cocina-de-jb-apaisada-02.jpg": guisos,
	"la-cocina-de-jb-apaisada-03.jpg": cartel,
	"la-cocina-de-jb-cuadrada-04.jpg": baguette,
	"la-cocina-de-jb-apaisada-05.jpg": ensaladillaGambas,
	"la-cocina-de-jb-apaisada-06.jpg": ensaladaGambas,
	"la-cocina-de-jb-apaisada-07.jpg": ensaladaPatata,
	"la-cocina-de-jb-apaisada-10.jpg": ensaladilla,
	"la-cocina-de-jb-apaisada-08.jpg": pan,
	"la-cocina-de-jb-apaisada-09.jpg": carta,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#111a16" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Cocina de JB, comida para llevar Sevilla 41020, comida casera Sevilla, pollo asado Sevilla, arroz guiso para llevar, freiduría Sevilla, serranitos Sevilla, baguettes de pollo, hamburguesas para llevar, Manuel Clavero Arévalo"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado, arroz guiso, pescado, freiduría y guisos caseros para llevar en la calle Prof. Manuel Clavero Arévalo, 41020 Sevilla. Pedidos en el 646 59 41 55."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo de La Cocina de JB con el teléfono de pedidos y su bandeja de arroz guiso"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#111a16"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="41020 Sevilla"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Cocina de JB"
			subtitle="Comida casera · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="La Cocina de JB"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías tomados de la ficha y del perfil públicos del local en Google Maps. El horario y los precios no están publicados: confírmalos al llamar antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de La Cocina de JB"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34646594155?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Pollo%20asado." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Pollo asado"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
