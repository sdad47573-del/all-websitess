---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/la-cocina-de-jb-vertical-01.jpg';
import guisos from '../assets/fotos/la-cocina-de-jb-apaisada-02.jpg';
import cartel from '../assets/fotos/la-cocina-de-jb-apaisada-03.jpg';
import baguette from '../assets/fotos/la-cocina-de-jb-cuadrada-04.jpg';
import ensaladillaGambas from '../assets/fotos/la-cocina-de-jb-apaisada-05.jpg';
import ensaladaGambas from '../assets/fotos/la-cocina-de-jb-apaisada-06.jpg';
import ensaladaPatata from '../assets/fotos/la-cocina-de-jb-apaisada-07.jpg';
import pan from '../assets/fotos/la-cocina-de-jb-apaisada-08.jpg';
import carta from '../assets/fotos/la-cocina-de-jb-apaisada-09.jpg';
import ensaladilla from '../assets/fotos/la-cocina-de-jb-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, REVIEWS, SERVICIOS } from '../data/site';

const title = 'La Cocina de JB · Comida casera para llevar en Sevilla';
const description = BUSINESS.description;

const galeria = [
	{
		src: guisos,
		alt: 'Bandejas de acero con los guisos del día: verduras, guisantes con jamón, callos y pollo en salsa',
	},
	{
		src: cartel,
		alt: 'Cartel de madera del local con el nombre, el teléfono de pedidos 646 59 41 55 y fotos de sus platos',
	},
	{
		src: baguette,
		alt: 'Baguette de pollo abierta sobre mármol, con la barra crujiente y el relleno a la vista',
	},
	{
		src: ensaladillaGambas,
		alt: 'Ensaladilla rusa con patata, zanahoria y mayonesa, junto a una bandeja de ensalada de gambas',
	},
	{
		src: ensaladaGambas,
		alt: 'Bandeja de ensalada de gambas con tomate, cebolla, pimiento verde y aceitunas',
	},
	{
		src: ensaladaPatata,
		alt: 'Ensalada de patata con huevo cocido, tomate y perejil en una bandeja de acero inoxidable',
	},
	{
		src: ensaladilla,
		alt: 'Ensaladilla rusa recién hecha en una bandeja grande, espolvoreada con perejil',
	},
	{
		src: pan,
		alt: 'Vitrina con barras de pan y panecillos recién horneados en el mostrador del local',
	},
	{
		src: carta,
		alt: 'Carta del local fotografiada en una mesa: serranitos, combos de pollo, baguettes, fritos y hamburguesas',
	},
];

const cartaGrupos = [
	{
		title: 'Del pollo asado',
		items: [
			{ name: 'Pollo asado', note: 'la primera especialidad que anuncia el rótulo' },
			{ name: 'Combos de pollo', note: 'con patatas fritas, ensalada o croquetas, según la carta' },
			{ name: 'Alitas de pollo', note: 'por kilos, en la carta del local' },
			{ name: 'Croquetas de pollo y nuggets', note: 'en la sección de fritos' },
		],
	},
	{
		title: 'Baguettes, serranitos y hamburguesas',
		items: [
			{ name: 'Serranitos', note: 'de lomo, de pollo, de lomo adobado y de pollo empanado' },
			{ name: 'Baguettes', note: 'de filete de pollo, calamares, lomo o bacon y queso' },
			{ name: 'Baguettes especiales', note: 'tortilla, pollo empanado y combinados' },
			{ name: 'Hamburguesas', note: 'de pollo, crispy, de ternera y de buey' },
		],
	},
	{
		title: 'Fritos, guisos y cuchara',
		items: [
			{ name: 'Arroz guiso', note: 'la segunda especialidad del rótulo' },
			{ name: 'Pescado y freiduría', note: 'chocos, boquerones, adobo, merluza y puntillitas' },
			{ name: 'Guisos del día', note: 'verduras, guisantes con jamón, callos y pollo en salsa' },
			{ name: 'Ensaladillas y ensaladas', note: 'rusa, de patata con huevo y de gambas' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#cocinajb`,
	name: BUSINESS.name,
	alternateName: ['La Cocina de JB', 'La Cocina de JB Sevilla', 'Cocina de JB 41020'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, BUSINESS.web],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Pollo asado', 'Freiduría'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#111a16" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Cocina de JB, comida para llevar Sevilla 41020, comida casera Sevilla, pollo asado Sevilla, arroz guiso para llevar, freiduría Sevilla, serranitos Sevilla, baguettes de pollo, hamburguesas para llevar, Manuel Clavero Arévalo"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado, arroz guiso, pescado, freiduría y guisos caseros para llevar en la calle Prof. Manuel Clavero Arévalo, 41020 Sevilla. Pedidos en el 646 59 41 55."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo de La Cocina de JB con el teléfono de pedidos y su bandeja de arroz guiso"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#111a16"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="41020 Sevilla"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Cocina de JB"
			subtitle="Comida casera · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Pollo asado, guisos <br /><em>y freiduría.</em>"
				lede="La Cocina de JB está en la calle Prof. Manuel Clavero Arévalo, en el 41020 de Sevilla, y su rótulo lo resume: «Pollo Asado · Arroz Guiso · Comida Casera · Pescado · Freiduría». Se pide por teléfono, en el 646 59 41 55, y se recoge en el local. La ficha no publica horario, así que conviene llamar antes."
				image={fachada}
				imageAlt="Fachada de La Cocina de JB con el rótulo de pollo asado, arroz guiso y el teléfono de pedidos 646 59 41 55"
				primaryCta={{ label: 'Llamar al 646 59 41 55', href: `tel:${BUSINESS.phoneHref}` }}
				secondaryCta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>5,0</b> en Google · 10 reseñas' },
					{ label: 'Pedidos', html: `<b>${BUSINESS.phone}</b><br />el teléfono del rótulo` },
					{ label: 'Horario', html: '<b>Sin publicar</b><br />en la ficha de Google' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de La Cocina de JB" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una cocina <br /><em>de barrio.</em>"
				paragraphs={[
					'El negocio está en la calle Prof. Manuel Clavero Arévalo, en el 41020 de Sevilla, con la fachada de ladrillo, un toldo blanco y dos mesas altas en la puerta. El rótulo es largo y claro: «La Cocina de JB», la banda con las especialidades —pollo asado, arroz guiso, comida casera, pescado y freiduría— y el teléfono de pedidos en grande.',
					'Dentro, la vitrina hace las veces de carta: bandejas de acero con los guisos del día, ensaladillas y ensaladas, y cestas de pan recién hecho. En la foto del menú aparecen los serranitos, las baguettes, los combos de pollo, la sección de fritos y las hamburguesas, además de los guisos y el arroz.',
					'El local lo dice sin adornos: se cocina para llevar. Se llama al 646 59 41 55, se encarga lo que haya ese día y se recoge en el mostrador. La ficha de Google no publica horario, así que esta web tampoco lo anuncia: es la primera pregunta que conviene hacer al teléfono.',
					'La ficha es joven y la nota es alta: cinco sobre cinco con 10 reseñas. Las dos que Google destaca hablan de unas hamburguesas para llevar y de «comida deliciosa y trato exquisito». La web que enlaza la ficha, en Google Sites, está vacía de momento.',
				]}
				note="La ficha no publica horario, número de portal, precio ni descripción del negocio. El teléfono sale del rótulo de la fachada y del escaparate, en las fotos del propio local. Los platos vienen de ese rótulo, de la carta fotografiada y de las reseñas: aquí no hay importes ni horarios inventados."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Pollo, baguettes <br /><em>y guisos.</em>"
				description="La carta del local está fotografiada en su perfil de Google, y de ahí sale esta lista. Sin precios: un menú fotografiado puede quedar desfasado y preferimos que los confirmes al llamar."
				cta={{ label: 'Ver la carta en Google', href: MAPS.place }}
				groups={cartaGrupos}
				note="Nombres de platos tomados de la carta y del rótulo del local. No publicamos importes porque son los de una foto del perfil y pueden haber cambiado: se confirman en el 646 59 41 55."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
					<div class="reviews-head">
						<h2 id="resenas-title">Cinco sobre cinco <br /><em>con 10 reseñas.</em></h2>
						<p>
							La ficha es reciente y todas sus reseñas puntúan alto. Estas son las dos que Google
							destaca, con la puntuación que les dio su autor.
						</p>
					</div>
					<div class="review-grid">
						{
							REVIEWS.map((review) => (
								<figure class="review-card">
									<p class="review-stars" aria-label={`${review.rating} sobre 5`}>
										{'★'.repeat(review.rating)}
										<span aria-hidden="true">{'★'.repeat(5 - review.rating)}</span>
									</p>
									<blockquote>{review.quote}</blockquote>
									<figcaption>Reseña publicada en Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="review-note">
						Citas de las reseñas públicas del local, con la puntuación del autor. En la ficha de Google
						están todas las que hay y, si aparecen críticas, se leen ahí.
					</p>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Nueve fotos <br /><em>del mostrador.</em>"
				description="Del perfil del local: los guisos en bandeja, el cartel de la puerta, la baguette de pollo, las ensaladillas y ensaladas, el pan en la vitrina y la carta fotografiada."
				images={galeria}
				cta={{ label: 'Ver todas en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode}`}
				title="Se pide <br /><em>por teléfono.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'España']}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="La ficha de Google no publica horario: no aparece ningún bloque de días. Esta web no anuncia uno, así que llama al 646 59 41 55 antes de acercarte. La ficha tampoco publica el número de portal; el mapa apunta al punto exacto del local."
				mapTitle="Mapa de La Cocina de JB en la calle Prof. Manuel Clavero Arévalo, 41020 Sevilla"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Cocina de JB"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Pedidos: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="Aquí se cocina para llevar: se llama, se encarga y se recoge en el mostrador. El teléfono es el del rótulo de la fachada, porque la ficha de Google no publica ninguno. No consta reparto a domicilio ni plataforma de pedidos: confírmalo al llamar. Esta página no tramita pedidos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>llamar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="La Cocina de JB"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías tomados de la ficha y del perfil públicos del local en Google Maps. El horario y los precios no están publicados: confírmalos al llamar antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de La Cocina de JB"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
