---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import guisos from '../assets/fotos/la-cocina-de-jb-apaisada-02.jpg';
import fachada from '../assets/fotos/la-cocina-de-jb-vertical-01.jpg';
import carta from '../assets/fotos/la-cocina-de-jb-apaisada-09.jpg';
import pan from '../assets/fotos/la-cocina-de-jb-apaisada-08.jpg';
import ensaladilla from '../assets/fotos/la-cocina-de-jb-apaisada-05.jpg';
import langostinos from '../assets/fotos/la-cocina-de-jb-apaisada-06.jpg';
import patatas from '../assets/fotos/la-cocina-de-jb-apaisada-07.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO_NOTA, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'La Cocina de JB · Pollo asado y comida casera para llevar en Sevilla';
const description = BUSINESS.description;

const galeria = [
	{
		src: guisos,
		alt: 'Bandejas de guisos caseros en el mostrador de La Cocina de JB: lentejas con chorizo, guisantes con jamón, garbanzos y pollo al curry',
	},
	{
		src: fachada,
		alt: 'La fachada de La Cocina de JB con el rótulo de pollo asado, arroz, guiso, comida casera, pescado y freiduría, y el teléfono de pedidos',
	},
	{
		src: carta,
		alt: 'La carta de La Cocina de JB con los serranitos, los combos de pollo, las baguettes, los fritos y las hamburguesas',
	},
	{
		src: pan,
		alt: 'El mostrador de pan de La Cocina de JB con baguettes y panecillos',
	},
	{
		src: ensaladilla,
		alt: 'Dos bandejas de ensaladilla rusa y ensalada de langostinos en el mostrador',
	},
	{
		src: langostinos,
		alt: 'Una bandeja de ensalada de langostinos con tomate y cebolla',
	},
	{
		src: patatas,
		alt: 'Una bandeja de ensalada de patatas con huevo y tomate',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#lacocinadejb`,
	name: BUSINESS.name,
	alternateName: ['LA COCINA DE JB', 'La Cocina de JB Sevilla', 'Cocina de JB Pino Montano'],
	description:
		'Comida casera para llevar en la calle Prof. Manuel Clavero Arévalo, 41020 Sevilla. Pollo asado, arroces y guisos, pescado, freiduría, bocadillos y hamburguesas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34646594155',
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Pollo asado', 'Comida casera', 'Freiduría', 'Bocadillos'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Sevilla' },
		{ '@type': 'AdministrativeArea', name: 'Pino Montano' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: {
		'@type': 'Menu',
		name: 'Carta de La Cocina de JB',
		inLanguage: 'es-ES',
		hasMenuSection: MENU.map((group) => ({
			'@type': 'MenuSection',
			name: group.title,
			hasMenuItem: group.items.map((item) => ({
				'@type': 'MenuItem',
				name: item.name,
				description: item.note,
			})),
		})),
	},
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2e3a26" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Zilla+Slab:ital,wght@0,400..700;1,400..700&family=Rubik:ital,wght@0,400..800;1,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Cocina de JB, pollo asado Sevilla, comida casera para llevar, guisos, freiduría, bocadillos, hamburguesas, Pino Montano, Manuel Clavero Arévalo"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado, arroces y guisos caseros, pescado, freiduría, bocadillos y hamburguesas en la calle Prof. Manuel Clavero Arévalo (41020 Sevilla). Pedidos en el 646 59 41 55."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tarjeta de La Cocina de JB con su nombre sobre fondo verde oliva y madera"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2e3a26"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Pino Montano"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[guisos]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Cocina de JB"
			subtitle="Pollo asado y comida casera"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Pollo asado <br /><em>y comida casera.</em>"
				lede={`La Cocina de JB es la casa de comidas de Manuel Clavero Arévalo: pollo asado en combos, arroces y guisos caseros, pescado, freiduría, bocadillos y hamburguesas, todo para llevar. Tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={guisos}
				imageAlt="Bandejas de guisos caseros en el mostrador de La Cocina de JB: lentejas con chorizo, guisantes con jamón, garbanzos y pollo al curry"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Carta', html: '<b>Pollo asado</b> desde 10,00 €' },
					{ label: 'Pedidos', html: `<b>${BUSINESS.phone}</b> · para llevar` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Fotos de la ficha de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Pollo asado · guisos · freiduría"
			/>

			<LocalChips label="Lo que ofrece La Cocina de JB" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Cocina de barrio <br /><em>para llevar.</em>"
				paragraphs={[
					'La Cocina de JB está en la calle Prof. Manuel Clavero Arévalo, en Pino Montano. El rótulo de madera lo anuncia en una línea: pollo asado, arroz, guiso, comida casera, pescado y freiduría, con el teléfono de pedidos bien grande.',
					'Dentro manda el mostrador: bandejas de guisos del día (lentejas con chorizo, garbanzos, guisantes con jamón, pollo al curry), ensaladilla rusa, ensalada de langostinos, ensalada de patatas y pan recién hecho.',
					'La carta impresa suma serranitos, baguettes, hamburguesas y fritos por cuarto de kilo. El pollo asado se vende entero por 10 € y hay combos con patatas, ensalada o croquetas hasta 15 €.',
					'Google le da 5,0 sobre 5 con 10 reseñas. Las dos que muestra hablan de unas hamburguesas «muy buenas» para llevar y de «comida deliciosa y trato exquisito».',
				]}
				note="La ficha no publica horario, página web ni redes sociales. La carta y los precios salen de las fotos de la ficha de Google (octubre de 2026) y pueden haber cambiado; el horario y la disponibilidad se confirman por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> De la olla al mostrador</p>
					<h2 id="highlights-title">Pollo, guisos <br /><em>y freiduría.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Pollo asado, bocadillos <br /><em>y fritos.</em>"
				description="Precios de la carta que aparece en las fotos de la ficha de Google. Pueden haber cambiado."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Precios de la carta fotografiada en la ficha de Google (octubre de 2026); pueden haber cambiado. La disponibilidad, el reparto y el horario se confirman por teléfono."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El mostrador, la carta <br /><em>y la fachada.</em>"
				description="Siete fotografías del perfil de La Cocina de JB en Google Maps: los guisos del día, la fachada, la carta, el pan y las ensaladas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">5,0 sobre 5, <em>con 10 reseñas.</em></h2>
						<p>
							La valoración que publica Google en octubre de 2026 es de 5,0 con 10 opiniones. Las
							dos reseñas que muestra la ficha hablan de las hamburguesas para llevar, de la comida
							y del trato; aquí se reproducen tal cual.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>5,0</strong>
						<span>★★★★★</span>
						<small>10 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Pino Montano, <br /><em>Clavero Arévalo.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={[{ day: 'Horario', value: 'No publicado en Google' }]}
				hoursCaption="Horario"
				hoursNote={HORARIO_NOTA}
				mapTitle="Mapa de La Cocina de JB en la calle Prof. Manuel Clavero Arévalo, Sevilla"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Calle Prof. Manuel Clavero Arévalo"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Comida para llevar: la ficha no publica reparto a domicilio ni pedidos online. El canal que aparece es el teléfono del rótulo, el 646 59 41 55, y en el local se pide en el mostrador. La ficha tampoco publica datos de accesibilidad, así que conviene llamar antes si necesitas acceso para silla de ruedas."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="La Cocina de JB"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, carta y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a La Cocina de JB"
			navAriaLabel="Enlaces de La Cocina de JB"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
