---
const business = {
	name: 'Café-Bar Cuatro Caminos',
	street: 'Carretera de la Sierra, 73',
	city: 'Granada',
	region: 'Granada',
	postalCode: '18008',
	country: 'ES',
	phone: '+34 958 22 44 63',
	latitude: 37.1645244,
	longitude: -3.5779241,
	site: 'https://cuatro-caminos-granada.vercel.app',
};

const mapsUrl = 'https://www.google.com/maps/place/Cuatro+Caminos/@37.1645244,-3.5779241,17z/data=!3m1!4b1!4m6!3m5!1s0xd71e35324af0d71:0xdd715b9f5186a875!8m2!3d37.1645244!4d-3.5779241!16s%2Fg%2F119vxkfb_?hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(`${business.name}, ${business.street}, ${business.city}`)}&ll=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34958224463';
const facebookUrl = 'https://www.facebook.com/p/Caf%C3%A9-Bar-Cuatro-Caminos-100057396581718/';
const siteUrl = `${business.site}/`;
const description = 'Café-Bar Cuatro Caminos en Granada: desayunos, comida casera, menú del día, raciones y platos combinados en Carretera de la Sierra, 73. Llama, consulta el horario y cómo llegar.';

const hours = [
	{ day: 'Lunes', value: '07:00–17:00 · 20:00–00:00' },
	{ day: 'Martes', value: '07:00–17:00 · 20:00–00:00' },
	{ day: 'Miércoles', value: '07:00–17:00 · 20:00–00:00' },
	{ day: 'Jueves', value: '07:00–17:00 · 20:00–00:00' },
	{ day: 'Viernes', value: '07:00–17:00 · 20:00–00:00' },
	{ day: 'Sábado', value: 'Cerrado' },
	{ day: 'Domingo', value: 'Cerrado' },
];

const faqs = [
	{
		question: '¿Dónde está el Café-Bar Cuatro Caminos?',
		answer: 'Está en Carretera de la Sierra, 73, 18008 Granada, en el distrito Genil. Abre las indicaciones de Google Maps desde esta página para encontrar la ruta.',
	},
	{
		question: '¿Qué puedo comer en Cuatro Caminos?',
		answer: 'El bar ofrece desayunos, menús, raciones, platos combinados y comida casera. Entre los platos mencionados en directorios y reseñas aparecen la olla de San Antón, ensaladilla rusa, croquetas caseras, pollo a la brasa, huevos rotos y postres caseros.',
	},
	{
		question: '¿Tienen menú para llevar?',
		answer: 'La página pública del Café-Bar anuncia menú para llevar. Llama al +34 958 22 44 63 para consultar las opciones y hacer tu pedido.',
	},
	{
		question: '¿Cuál es el horario de apertura?',
		answer: 'El horario publicado en la página del bar indica de lunes a viernes de 07:00 a 17:00 y de 20:00 a 00:00, y cierre los sábados y domingos. Puede cambiar en festivos: confirma por teléfono antes de venir.',
	},
	{
		question: '¿Dónde puedo ver fotos del bar?',
		answer: 'Abre la ficha de Cuatro Caminos en Google Maps desde esta página para consultar las fotos del local y la comida, junto con las opiniones recientes.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': ['Restaurant', 'CafeOrCoffeeShop'],
	'@id': `${siteUrl}#business`,
	name: business.name,
	description,
	url: siteUrl,
	telephone: business.phone,
	priceRange: '10–20 €',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Casera', 'Mediterránea'],
	acceptsReservations: true,
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: business.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [mapsUrl, facebookUrl],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '20:00',
			closes: '23:59',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

import { Image } from 'astro:assets';
import Galeria from '../components/Galeria.astro';
import heroPhoto from '../assets/fotos/cuatro-caminos-granada-apaisada-02.jpg';---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#234539" />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" />
		<title>Café-Bar Cuatro Caminos en Granada | Desayunos y comida casera</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Café-Bar Cuatro Caminos · Comida casera en Granada" />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${business.site}/og.svg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Café-Bar Cuatro Caminos, desayunos y comida casera en Granada" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.region" content="ES-GR" />
		<meta name="geo.placename" content="Granada" />
		<meta name="geo.position" content="37.1645244;-3.5779241" />
		<meta name="ICBM" content="37.1645244, -3.5779241" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Café-Bar Cuatro Caminos, inicio"><span class="brand-mark" aria-hidden="true">4</span><span>Cuatro Caminos <small>Café-Bar · Granada</small></span></a>
			<nav aria-label="Navegación principal"><a href="#cocina">Qué ofrecemos</a><a href="#especialidades">La cocina</a><a href="#fotos">Fotos</a><a href="#visitanos">Cómo llegar</a></nav>
			<a class="header-call" href={phoneHref}>Llamar · 958 22 44 63</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span>Granada · Genil</span><i aria-hidden="true"></i> Café-Bar de barrio</p>
					<h1 id="hero-title">Empieza el día<br />con sabor <em>a casa.</em></h1>
					<p class="lede">Desayunos, menú del día, raciones y platos combinados en Café-Bar Cuatro Caminos. Cocina casera y trato cercano en Carretera de la Sierra, un punto de encuentro en Granada.</p>
					<div class="actions"><a class="button button-gold" href={phoneHref}>Llamar al bar <span aria-hidden="true">↗</span></a><a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-details"><span>⌖ Carretera de la Sierra, 73</span><span>☕ Desayunos · comida casera</span></div>
				</div>
				<div class="hero-art">
					<Image
						src={heroPhoto}
						alt="Fotografía de Café-Bar Cuatro Caminos publicada en su ficha de Google Maps"
						widths={[420, 640, 960]}
						sizes="(max-width: 720px) 100vw, 50vw"
						format="avif"
						quality={70}
						loading="eager"
						fetchpriority="high"
						class="hero-photo"
					/>
					<div class="art-note">Buenos días<br /><b>y buen provecho</b></div>
				</div>
			</section>

			<div class="ticker" aria-label="Servicios y cocina"><span>Desayunos</span><b>✳</b><span>Menú del día</span><b>✳</b><span>Comida casera</span><b>✳</b><span>Raciones</span><b>✳</b><span>Para llevar</span></div>

			<section class="intro section-wrap" id="cocina"><div><p class="eyebrow eyebrow-dark">Tu bar de cada día</p><h2>Lo cotidiano<br /><em>también sabe bien.</em></h2></div><div class="intro-copy"><p>Cuatro Caminos es un café-bar de Granada con una propuesta directa y casera: desayunos para empezar la mañana, menús para la pausa del mediodía, raciones y platos combinados. Un local de barrio donde sentarse, comer a gusto y seguir el día.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver opiniones y fotos en Google Maps ↗</a></div></section>

			<section class="specialties section-wrap" id="especialidades" aria-labelledby="specialties-title"><div class="section-heading"><p class="eyebrow eyebrow-dark">Sabor casero en Granada</p><h2 id="specialties-title">De la mañana<br /><em>a la hora de comer.</em></h2><p>Una cocina sencilla y abundante para desayunar, hacer una pausa o pedir algo para llevar.</p></div>
				<div class="special-grid">
					<article class="special-card special-breakfast"><span class="special-icon" aria-hidden="true">☀</span><span class="card-kicker">PARA EMPEZAR</span><h3>Desayunos</h3><p>Un café y algo rico para comenzar la jornada en el barrio de Genil.</p></article>
					<article class="special-card special-menu"><span class="special-icon" aria-hidden="true">♨</span><span class="card-kicker">A MEDIODÍA</span><h3>Menú del día</h3><p>Platos caseros y una opción práctica para comer bien durante la semana.</p></article>
					<article class="special-card special-rations"><span class="special-icon" aria-hidden="true">✿</span><span class="card-kicker">PARA COMPARTIR</span><h3>Raciones y tapas</h3><p>Ensaladilla, croquetas, guisos y raciones para disfrutar sin complicaciones.</p></article>
					<article class="special-card special-takeaway"><span class="special-icon" aria-hidden="true">⌂</span><span class="card-kicker">TAMBIÉN PARA LLEVAR</span><h3>Platos combinados</h3><p>Comida casera en el local o menú para llevar. Llama para consultar el día.</p></article>
				</div><p class="menu-note">Platos populares mencionados en fuentes públicas: olla de San Antón, ensaladilla rusa, croquetas caseras, pollo a la brasa y postres. La oferta varía: consulta la carta del día.</p>
			</section>

			<section class="photo-section" id="fotos"><div class="photo-copy"><p class="eyebrow">Cuatro Caminos en Google Maps</p><h2>Mira el local<br />y sus platos <em>aquí.</em></h2><p>Abre la ficha de Google Maps para explorar fotos del bar y de la comida, consultar reseñas recientes y tener a mano los datos del establecimiento.</p><a class="button button-gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a><a class="social-link" href={facebookUrl} target="_blank" rel="noopener noreferrer">Facebook del Café-Bar ↗</a></div>
				<div class="map-photo"><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Google Maps: Café-Bar Cuatro Caminos en Carretera de la Sierra, Granada" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
					<noscript>
						<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
					</noscript>
				</div><a class="map-caption" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span>⌖</span><span><b>Café-Bar Cuatro Caminos</b><small>Carretera de la Sierra, 73 · Ver fotos ↗</small></span></a></div>
			</section>

			<section class="visit section-wrap" id="visitanos"><div class="visit-copy"><p class="eyebrow eyebrow-dark">En el distrito Genil</p><h2>Te esperamos<br /><em>en Granada.</em></h2><p>Acércate a desayunar, comer o pedir algo para llevar en Café-Bar Cuatro Caminos.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button button-dark" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Llamar · 958 22 44 63</a></div></div>
				<div class="hours-card" id="horario"><div class="hours-title"><span class="clock" aria-hidden="true">◷</span><div><p class="eyebrow eyebrow-dark">Planifica tu visita</p><h3>Horario</h3></div></div><dl>{hours.map(({ day, value }) => <div class:list={[{ closed: value === 'Cerrado' }]}><dt>{day}</dt><dd>{value}</dd></div>)}</dl><p class="hours-note">Horario publicado por el Café-Bar en Facebook. Puede cambiar en festivos; llama para confirmar antes de venir.</p></div>
			</section>

			<section class="faq-section section-wrap" id="preguntas"><p class="eyebrow eyebrow-dark">Información útil</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
			<Galeria nombre="Café-Bar Cuatro Caminos" mapsUrl={mapsUrl} />
		</main>

		<footer class="footer"><div class="footer-top"><a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">4</span><span>Cuatro Caminos <small>Café-Bar · Granada</small></span></a><p>Un bar de barrio.<br />Comida hecha en casa.</p><nav aria-label="Enlaces del Café-Bar"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={facebookUrl} target="_blank" rel="noopener noreferrer">Facebook ↗</a><a href={phoneHref}>958 22 44 63</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Café-Bar Cuatro Caminos · Granada</span><a href="/aviso-legal/">Aviso legal y privacidad</a><span>Confirma horario, menú y disponibilidad directamente con el establecimiento.</span></div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar <span>958 22 44 63</span></a>
	</body>
</html>

<style is:global>
	:root{font-family:'DM Sans',sans-serif;color:#29342b;background:#f7f4e9;font-synthesis:none;text-rendering:optimizeLegibility;--green:#234539;--green2:#56765b;--yellow:#ecc35c;--cream:#f7f4e9;--ink:#29342b;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid #d5a848;outline-offset:4px}.skip-link{position:absolute;z-index:99;top:-60px;left:16px;padding:12px 16px;background:var(--yellow);color:var(--green)}.skip-link:focus{top:12px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:22px;background:#234539;color:#faf8ee}.brand{display:flex;align-items:center;gap:11px;font-size:15px;font-weight:700}.brand small{display:block;margin-top:4px;color:#d4dfcf;font-size:9px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--yellow);border-radius:50%;color:var(--yellow);font:700 23px var(--display)}.topbar nav{display:flex;gap:clamp(14px,2.5vw,32px);color:#e8eee3;font-size:12px}.topbar nav a:hover,.footer a:hover{color:var(--yellow)}.header-call{padding:11px 17px;border:1px solid #ffffff59;border-radius:99px;font-size:11px;font-weight:700}.hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:560px;background:#234539;color:#faf8ee;overflow:hidden}.hero-copy{padding:73px 4vw 64px 9vw;align-self:center}.eyebrow{margin:0 0 19px;color:#d6d9ac;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase}.eyebrow i{display:inline-block;width:22px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.section-heading h2,.photo-copy h2,.visit h2,.faq-section h2{margin:0;font:600 clamp(39px,4.8vw,64px)/1.08 var(--display);letter-spacing:-1.2px}.hero h1 em,.intro h2 em,.section-heading h2 em,.photo-copy h2 em,.v