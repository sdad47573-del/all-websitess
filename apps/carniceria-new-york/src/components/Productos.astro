---
import { BUSINESS, PRODUCTOS } from '../data/site';
---

<section id="productos" class="bg-base-200 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">Productos</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">Lo que sale del mostrador</h2>
			<div class="newyork-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/70 mt-6 leading-relaxed">
				Carne, embutidos, charcutería y elaborados. El género cambia cada día; llama y te decimos
				qué hay en el mostrador y qué ofertas hay esta semana.
			</p>
		</div>

		<div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{
				PRODUCTOS.map((producto) => (
					<article class="etiqueta-newyork rounded-box border-base-300 bg-base-100 group border p-6 transition-shadow hover:shadow-lg">
						<span class="bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-content flex size-12 items-center justify-center rounded-xl transition-colors">
							<i class={`${producto.icon} text-2xl`} />
						</span>
						<h3 class="font-display mt-5 text-xl font-bold">{producto.title}</h3>
						<p class="text-base-content/65 mt-2 text-sm leading-relaxed">{producto.text}</p>
					</article>
				))
			}
		</div>

		<div
			class="border-base-300 bg-base-100 rounded-box mt-14 grid gap-6 border p-8 lg:grid-cols-[1.4fr_1fr] lg:items-center"
		>
			<div>
				<h3 class="font-display text-2xl font-bold">Ofertas nuevas cada semana</h3>
				<p class="text-base-content/70 mt-3 text-sm leading-relaxed">
					Publican las ofertas de la semana con precio en Instagram y Facebook. Síguenos o llama al
					{BUSINESS.phoneDisplay} para preguntar por el producto del día.
				</p>
			</div>
			<div class="flex flex-wrap gap-3 lg:justify-end">
				<a
					href={BUSINESS.instagram}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-primary gap-2 rounded-full"
				>
					<i class="ri-instagram-line"></i> Ver en Instagram
				</a>
				<a href={BUSINESS.phoneHref} class="btn btn-outline gap-2 rounded-full">
					<i class="ri-phone-line"></i> Llamar
				</a>
			</div>
		</div>
	</div>
</section>
