---
import '../styles/global.css';

const business = {
	name: 'El Rincón de Joaquín',
	street: 'Calle Quasimodo, 16',
	district: 'Teatinos-Universidad',
	city: 'Málaga',
	postalCode: '29006',
	phone: '+34 951 49 86 82',
	latitude: 36.7107853,
	longitude: -4.4650339,
	site: 'https://el-rincon-de-joaquin.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/El+Rinc%C3%B3n+de+Joaqu%C3%ADn/@36.7204732,-4.4778905,14z/data=!4m7!3m6!1s0xd72f74499a5f669:0x3cdcbe3da3e31598!8m2!3d36.7107853!4d-4.4650339!15sCgxSZXN0YXVyYW50ZXNaDiIMcmVzdGF1cmFudGVzkgEKcmVzdGF1cmFudJoBI0NoWkRTVWhOTUc5blMwVkpRMEZuU1VSNExVNXFNVXBuRUFF4AEA-gEECAAQPg!16s%2Fg%2F11c2lb7wht?entry=tts&g_ep=EgoyMDI2MDkyOC4wIPu8ASoASAFQAw%3D%3D&skid=f4443e47-d8ba-419f-9941-a48943147da3';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34951498682';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurant`,
	name: business.name,
	description:
		'Bar restaurante de cocina casera, desayunos y tapas en Teatinos, Málaga. En Calle Quasimodo, 16.',
	url: `${business.site}/`,
	telephone: business.phone,
	servesCuisine: ['Cocina española', 'Tapas', 'Cocina casera'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#173d36" />
		<meta
			name="description"
			content="El Rincón de Joaquín: desayunos, tapas y cocina casera en Teatinos, Málaga. Estamos en Calle Quasimodo, 16. Consulta el teléfono, cómo llegar y las fotos de Google Maps."
		/>
		<meta
			name="keywords"
			content="El Rincón de Joaquín Málaga, restaurante Teatinos, bar en Teatinos, tapas en Teatinos, desayunos Málaga, comida casera Málaga, menú del día Teatinos, Calle Quasimodo 16"
		/>
		<meta name="author" content="El Rincón de Joaquín" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap"
			rel="stylesheet"
		/>
		<title>El Rincón de Joaquín | Tapas y desayunos en Teatinos, Málaga</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="El Rincón de Joaquín · Teatinos, Málaga" />
		<meta
			property="og:description"
			content="Un bar de barrio para desayunar, tapear y disfrutar de cocina casera en Teatinos. Calle Quasimodo, 16."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="El Rincón de Joaquín en Teatinos, Málaga" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="El Rincón de Joaquín · Teatinos, Málaga" />
		<meta
			name="twitter:description"
			content="Un bar de barrio para desayunar, tapear y disfrutar de cocina casera en Teatinos."
		/>
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7107853;-4.4650339" />
		<meta name="ICBM" content="36.7107853, -4.4650339" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="El Rincón de Joaquín, inicio">
				<span class="brand-mark" aria-hidden="true">J</span>
				<span class="brand-name">El Rincón <small>de Joaquín · Teatinos</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#rincon">El rincón</a>
				<a href="#sabores">Sabores</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Cómo llegar</a>
			</nav>
			<a class="header-phone" href={phoneHref}>951 49 86 82 <span>↗</span></a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> Teatinos · Málaga</p>
					<h1 id="hero-title">Un rincón<br />para <em>sentirse en casa.</em></h1>
					<p class="hero-lede">
						Desayunos, tapas y platos de cocina casera para disfrutar sin prisa, en pleno barrio de Teatinos.
					</p>
					<div class="hero-actions">
						<a class="button button-gold" href={phoneHref}>Llamar al restaurante <span aria-hidden="true">↗</span></a>
						<a class="text-link" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<p class="hero-address"><span aria-hidden="true">⌖</span> Calle Quasimodo, 16 · 29006 Málaga</p>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración de una mesa de bar con café, tostada y mantel a cuadros; no es una foto del local">
					<div class="art-wall"></div>
					<div class="art-window"><span class="window-light"></span><span class="window-cross"></span></div>
					<div class="art-poster"><span>BUENOS DÍAS</span><b>TEATINOS</b><i>CAFÉ · TAPA · CHARLA</i></div>
					<div class="art-table"></div>
					<div class="coffee-cup"><span></span><i></i></div>
					<div class="toast-plate"><span class="toast"></span></div>
					<div class="olive-bowl"><i></i><i></i><i></i></div>
					<span class="art-label">ILUSTRACIÓN DECORATIVA · NO ES FOTO DEL LOCAL</span>
				</div>
				<div class="hero-stamp" aria-hidden="true"><span>BUEN<br />PROVECHO</span><i>✳</i></div>
			</section>

			<section class="story section-pad" id="rincon">
				<p class="section-label"><span></span> Una casa de comidas en Teatinos</p>
				<div class="story-grid">
					<h2>La mesa<br />siempre tiene<br /><em>un sitio más.</em></h2>
					<div class="story-copy">
						<p>
							El Rincón de Joaquín es un bar restaurante en el barrio de Teatinos-Universidad, en Málaga. Un lugar para empezar el día con un desayuno, parar a comer o reunirse alrededor de unas tapas.
						</p>
						<p>
							Las reseñas públicas destacan las raciones generosas, la cocina casera y el trato cercano. Ven a conocerlo en Calle Quasimodo, 16.
						</p>
						<a class="simple-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver opiniones y novedades en Google Maps <span aria-hidden="true">↗</span></a>
					</div>
				</div>
				<div class="story-rule"><span>EL RINCÓN DE JOAQUÍN</span><i></i><span>TEATINOS · MÁLAGA</span></div>
			</section>

			<section class="offer section-pad" id="sabores">
				<div class="offer-heading">
					<div><p class="eyebrow dark"><span></span> Algo rico para cada momento</p><h2>Del primer café<br />a la <em>última tapa.</em></h2></div>
					<p>Un sitio de barrio para desayunar, almorzar y tapear. Consulta la disponibilidad y la carta del día directamente en el local.</p>
				</div>
				<div class="moments-grid">
					<article class="moment-card moment-breakfast"><span class="moment-kicker">Para empezar</span><div class="moment-art breakfast-art" aria-hidden="true"><span class="coffee-art"></span><span class="bread-art"></span><i></i></div><h3>Desayunos</h3><p>Un café, algo rico y a por el día.</p></article>
					<article class="moment-card moment-tapas"><span class="moment-kicker">Para compartir</span><div class="moment-art tapas-art" aria-hidden="true"><span></span><i></i><b></b></div><h3>Tapas y raciones</h3><p>Una mesa, buena conversación y una más.</p></article>
					<article class="moment-card moment-classic"><span class="moment-kicker">Cocina con memoria</span><div class="moment-art classic-art" aria-hidden="true"><span></span><i></i><b></b></div><h3>Clásicos de la casa</h3><p>La prensa local destacó su cóctel de gambas.</p></article>
				</div>
				<p class="menu-note">Imágenes ilustrativas. Los platos y precios pueden variar; consulta la carta actual en el restaurante.</p>
			</section>

			<section class="gallery section-pad" id="fotos">
				<div class="gallery-copy">
					<p class="eyebrow dark"><span></span> Fotos reales del restaurante</p>
					<h2>Asómate<br />a <em>nuestro rincón.</em></h2>
					<p>Entra en la ficha de Google Maps para ver el interior y los platos en fotos compartidas por visitantes.</p>
					<a class="button button-forest" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a>
				</div>
				<a class="gallery-art" href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Abrir Google Maps para ver las fotos reales de El Rincón de Joaquín">
					<div class="gallery-scene" aria-hidden="true"><span class="gallery-window"></span><span class="gallery-shelf"></span><span class="gallery-cup"></span><span class="gallery-badge">J</span></div>
					<span class="gallery-caption"><span>Ilustración decorativa · no es foto</span><b>Ver fotos reales ↗</b></span>
				</a>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span></span> Teatinos-Universidad</p>
					<h2>Por aquí<br />nos <em>encontramos.</em></h2>
					<p class="address">Calle Quasimodo, 16<br />29006 Málaga, España</p>
					<div class="visit-links"><a class="button button-gold" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a><a class="phone-link" href={phoneHref}>+34 951 49 86 82</a></div>
					<p class="hours-note">El horario puede cambiar; consulta la ficha de Google Maps o llama antes de venir.</p>
				</div>
				<div class="map-frame">
					<iframe
						title="Mapa de El Rincón de Joaquín en Calle Quasimodo, Teatinos, Málaga"
						src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span>⌖</span> El Rincón de Joaquín · Málaga</a>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">J</span><span class="brand-name">El Rincón <small>de Joaquín · Teatinos</small></span></a>
			<p>Desayunos, tapas y cocina casera</p>
			<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps <span aria-hidden="true">↗</span></a>
			<small>© {new Date().getFullYear()} El Rincón de Joaquín</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
</footer>
		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>951 49 86 82</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>
