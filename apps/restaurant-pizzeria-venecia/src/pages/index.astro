---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/restaurant-pizzeria-venecia-apaisada-01.jpg';
import ensalada from '../assets/fotos/restaurant-pizzeria-venecia-apaisada-04.jpg';
import costillas from '../assets/fotos/restaurant-pizzeria-venecia-cuadrada-02.jpg';
import pizzaJamon from '../assets/fotos/restaurant-pizzeria-venecia-vertical-03.jpg';
import comedor from '../assets/fotos/restaurant-pizzeria-venecia-vertical-05.jpg';
import lubina from '../assets/fotos/restaurant-pizzeria-venecia-vertical-06.jpg';
import pizzaMarisco from '../assets/fotos/restaurant-pizzeria-venecia-vertical-07.jpg';
import panTomate from '../assets/fotos/restaurant-pizzeria-venecia-vertical-08.jpg';
import arroz from '../assets/fotos/restaurant-pizzeria-venecia-vertical-09.jpg';
import canelones from '../assets/fotos/restaurant-pizzeria-venecia-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'RESTAURANT PIZZERIA VENÈCIA · Pizzería en Sant Julià de Lòria (Andorra)';
const description =
	'RESTAURANT PIZZERIA VENÈCIA, en la Av. Verge de Canòlich, 20, de Sant Julià de Lòria (AD600, Andorra). Pizzería con 4,4 sobre 5 y 622 reseñas en Google. Comidas de 13:00 a 15:30 y cenas de 20:00 a 23:30; martes cerrado. Teléfono +376 841 796.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de RESTAURANT PIZZERIA VENÈCIA en la Av. Verge de Canòlich, 20, con el toldo blanco, la pared de piedra y las macetas de la entrada',
	},
	{
		src: comedor,
		alt: 'El comedor de la pizzería, con el mural del puente de Rialto y las góndolas de Venecia, mesas con mantel y sillas moradas',
	},
	{
		src: panTomate,
		alt: 'Dos rebanadas de pan con tomate y anchoas sobre berenjena asada, con aceitunas negras y reducción de balsámico',
	},
	{
		src: pizzaJamon,
		alt: 'Una pizza de jamón cocido, champiñones y alcachofas recién salida del horno, servida en plato blanco',
	},
	{
		src: pizzaMarisco,
		alt: 'Una pizza de marisco con gambas, mejillones, calamar y queso gratinado, con una cerveza al lado',
	},
	{
		src: lubina,
		alt: 'Lubina a la plancha con arroz blanco, patatas fritas, pimientos de Padrón y medio limón',
	},
	{
		src: costillas,
		alt: 'Costillas de cerdo asadas en una sartén de hierro, con salsa de tomate picante y hierbas frescas',
	},
	{
		src: ensalada,
		alt: 'Ensalada de patata y tomate con aceitunas negras, lechuga y un chorro de balsámico',
	},
	{
		src: canelones,
		alt: 'Canelones gratinados con bechamel y queso fundido en un plato cuadrado, con una Coca-Cola al fondo',
	},
	{
		src: arroz,
		alt: 'Un plato de arroz con tomate y huevo, patatas fritas, y una pizza de queso en la mesa de al lado',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurant-pizzeria-venecia`,
	name: BUSINESS.fullName,
	alternateName: [
		'Restaurant Pizzeria Venecia',
		'Pizzeria Venècia',
		'Venècia Sant Julià de Lòria',
		'Pizzería Venecia Andorra',
	],
	description:
		'Pizzería y restaurante en la Av. Verge de Canòlich, 20, de Sant Julià de Lòria (Andorra). Comidas y cenas, con pizza al horno y platos de restaurante.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376841796',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pizza', 'Cocina italiana'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '23:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurant-pizzeria-venecia-apaisada-01.jpg": fachada,
	"restaurant-pizzeria-venecia-vertical-05.jpg": comedor,
	"restaurant-pizzeria-venecia-vertical-08.jpg": panTomate,
	"restaurant-pizzeria-venecia-vertical-03.jpg": pizzaJamon,
	"restaurant-pizzeria-venecia-vertical-07.jpg": pizzaMarisco,
	"restaurant-pizzeria-venecia-vertical-06.jpg": lubina,
	"restaurant-pizzeria-venecia-cuadrada-02.jpg": costillas,
	"restaurant-pizzeria-venecia-apaisada-04.jpg": ensalada,
	"restaurant-pizzeria-venecia-vertical-10.jpg": canelones,
	"restaurant-pizzeria-venecia-vertical-09.jpg": arroz,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#241a16" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Karla:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="pizzería Sant Julià de Lòria, RESTAURANT PIZZERIA VENÈCIA, pizzería Andorra, restaurante Andorra, pizza Av. Verge de Canòlich, comer en Sant Julià de Lòria"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pizzería en la Av. Verge de Canòlich, 20, de Sant Julià de Lòria. 4,4 sobre 5 con 622 reseñas en Google. Comidas de 13:00 a 15:30 y cenas de 20:00 a 23:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de RESTAURANT PIZZERIA VENÈCIA en Sant Julià de Lòria, con el toldo blanco y la pared de piedra"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#241a16"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-06"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Venècia"
			subtitle="Pizzería · Sant Julià de Lòria"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Venècia"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario, valoración y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. La ficha no publica carta ni precios: confírmalos por teléfono."
			ctaLabel="Llamar a Venècia"
			navAriaLabel="Enlaces de RESTAURANT PIZZERIA VENÈCIA"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34376841796?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Google%20CID." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Google CID"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
