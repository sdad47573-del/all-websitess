---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/restaurant-pizzeria-venecia-apaisada-01.jpg';
import ensalada from '../assets/fotos/restaurant-pizzeria-venecia-apaisada-04.jpg';
import costillas from '../assets/fotos/restaurant-pizzeria-venecia-cuadrada-02.jpg';
import pizzaJamon from '../assets/fotos/restaurant-pizzeria-venecia-vertical-03.jpg';
import comedor from '../assets/fotos/restaurant-pizzeria-venecia-vertical-05.jpg';
import lubina from '../assets/fotos/restaurant-pizzeria-venecia-vertical-06.jpg';
import pizzaMarisco from '../assets/fotos/restaurant-pizzeria-venecia-vertical-07.jpg';
import panTomate from '../assets/fotos/restaurant-pizzeria-venecia-vertical-08.jpg';
import arroz from '../assets/fotos/restaurant-pizzeria-venecia-vertical-09.jpg';
import canelones from '../assets/fotos/restaurant-pizzeria-venecia-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'RESTAURANT PIZZERIA VENÈCIA · Pizzería en Sant Julià de Lòria (Andorra)';
const description =
	'RESTAURANT PIZZERIA VENÈCIA, en la Av. Verge de Canòlich, 20, de Sant Julià de Lòria (AD600, Andorra). Pizzería con 4,4 sobre 5 y 622 reseñas en Google. Comidas de 13:00 a 15:30 y cenas de 20:00 a 23:30; martes cerrado. Teléfono +376 841 796.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de RESTAURANT PIZZERIA VENÈCIA en la Av. Verge de Canòlich, 20, con el toldo blanco, la pared de piedra y las macetas de la entrada',
	},
	{
		src: comedor,
		alt: 'El comedor de la pizzería, con el mural del puente de Rialto y las góndolas de Venecia, mesas con mantel y sillas moradas',
	},
	{
		src: panTomate,
		alt: 'Dos rebanadas de pan con tomate y anchoas sobre berenjena asada, con aceitunas negras y reducción de balsámico',
	},
	{
		src: pizzaJamon,
		alt: 'Una pizza de jamón cocido, champiñones y alcachofas recién salida del horno, servida en plato blanco',
	},
	{
		src: pizzaMarisco,
		alt: 'Una pizza de marisco con gambas, mejillones, calamar y queso gratinado, con una cerveza al lado',
	},
	{
		src: lubina,
		alt: 'Lubina a la plancha con arroz blanco, patatas fritas, pimientos de Padrón y medio limón',
	},
	{
		src: costillas,
		alt: 'Costillas de cerdo asadas en una sartén de hierro, con salsa de tomate picante y hierbas frescas',
	},
	{
		src: ensalada,
		alt: 'Ensalada de patata y tomate con aceitunas negras, lechuga y un chorro de balsámico',
	},
	{
		src: canelones,
		alt: 'Canelones gratinados con bechamel y queso fundido en un plato cuadrado, con una Coca-Cola al fondo',
	},
	{
		src: arroz,
		alt: 'Un plato de arroz con tomate y huevo, patatas fritas, y una pizza de queso en la mesa de al lado',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurant-pizzeria-venecia`,
	name: BUSINESS.fullName,
	alternateName: [
		'Restaurant Pizzeria Venecia',
		'Pizzeria Venècia',
		'Venècia Sant Julià de Lòria',
		'Pizzería Venecia Andorra',
	],
	description:
		'Pizzería y restaurante en la Av. Verge de Canòlich, 20, de Sant Julià de Lòria (Andorra). Comidas y cenas, con pizza al horno y platos de restaurante.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376841796',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pizza', 'Cocina italiana'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '23:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurant-pizzeria-venecia-apaisada-01.jpg": fachada,
	"restaurant-pizzeria-venecia-vertical-05.jpg": comedor,
	"restaurant-pizzeria-venecia-vertical-08.jpg": panTomate,
	"restaurant-pizzeria-venecia-vertical-03.jpg": pizzaJamon,
	"restaurant-pizzeria-venecia-vertical-07.jpg": pizzaMarisco,
	"restaurant-pizzeria-venecia-vertical-06.jpg": lubina,
	"restaurant-pizzeria-venecia-cuadrada-02.jpg": costillas,
	"restaurant-pizzeria-venecia-apaisada-04.jpg": ensalada,
	"restaurant-pizzeria-venecia-vertical-10.jpg": canelones,
	"restaurant-pizzeria-venecia-vertical-09.jpg": arroz,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#241a16" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Karla:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="pizzería Sant Julià de Lòria, RESTAURANT PIZZERIA VENÈCIA, pizzería Andorra, restaurante Andorra, pizza Av. Verge de Canòlich, comer en Sant Julià de Lòria"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pizzería en la Av. Verge de Canòlich, 20, de Sant Julià de Lòria. 4,4 sobre 5 con 622 reseñas en Google. Comidas de 13:00 a 15:30 y cenas de 20:00 a 23:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de RESTAURANT PIZZERIA VENÈCIA en Sant Julià de Lòria, con el toldo blanco y la pared de piedra"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#241a16"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-06"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Venècia"
			subtitle="Pizzería · Sant Julià de Lòria"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Venècia"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario, valoración y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. La ficha no publica carta ni precios: confírmalos por teléfono."
			ctaLabel="Llamar a Venècia"
			navAriaLabel="Enlaces de RESTAURANT PIZZERIA VENÈCIA"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
