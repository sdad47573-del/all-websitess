---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/restaurant-pizzeria-venecia-apaisada-01.jpg';
import ensalada from '../assets/fotos/restaurant-pizzeria-venecia-apaisada-04.jpg';
import costillas from '../assets/fotos/restaurant-pizzeria-venecia-cuadrada-02.jpg';
import pizzaJamon from '../assets/fotos/restaurant-pizzeria-venecia-vertical-03.jpg';
import comedor from '../assets/fotos/restaurant-pizzeria-venecia-vertical-05.jpg';
import lubina from '../assets/fotos/restaurant-pizzeria-venecia-vertical-06.jpg';
import pizzaMarisco from '../assets/fotos/restaurant-pizzeria-venecia-vertical-07.jpg';
import panTomate from '../assets/fotos/restaurant-pizzeria-venecia-vertical-08.jpg';
import arroz from '../assets/fotos/restaurant-pizzeria-venecia-vertical-09.jpg';
import canelones from '../assets/fotos/restaurant-pizzeria-venecia-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'RESTAURANT PIZZERIA VENÈCIA · Pizzería en Sant Julià de Lòria (Andorra)';
const description =
	'RESTAURANT PIZZERIA VENÈCIA, en la Av. Verge de Canòlich, 20, de Sant Julià de Lòria (AD600, Andorra). Pizzería con 4,4 sobre 5 y 622 reseñas en Google. Comidas de 13:00 a 15:30 y cenas de 20:00 a 23:30; martes cerrado. Teléfono +376 841 796.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de RESTAURANT PIZZERIA VENÈCIA en la Av. Verge de Canòlich, 20, con el toldo blanco, la pared de piedra y las macetas de la entrada',
	},
	{
		src: comedor,
		alt: 'El comedor de la pizzería, con el mural del puente de Rialto y las góndolas de Venecia, mesas con mantel y sillas moradas',
	},
	{
		src: panTomate,
		alt: 'Dos rebanadas de pan con tomate y anchoas sobre berenjena asada, con aceitunas negras y reducción de balsámico',
	},
	{
		src: pizzaJamon,
		alt: 'Una pizza de jamón cocido, champiñones y alcachofas recién salida del horno, servida en plato blanco',
	},
	{
		src: pizzaMarisco,
		alt: 'Una pizza de marisco con gambas, mejillones, calamar y queso gratinado, con una cerveza al lado',
	},
	{
		src: lubina,
		alt: 'Lubina a la plancha con arroz blanco, patatas fritas, pimientos de Padrón y medio limón',
	},
	{
		src: costillas,
		alt: 'Costillas de cerdo asadas en una sartén de hierro, con salsa de tomate picante y hierbas frescas',
	},
	{
		src: ensalada,
		alt: 'Ensalada de patata y tomate con aceitunas negras, lechuga y un chorro de balsámico',
	},
	{
		src: canelones,
		alt: 'Canelones gratinados con bechamel y queso fundido en un plato cuadrado, con una Coca-Cola al fondo',
	},
	{
		src: arroz,
		alt: 'Un plato de arroz con tomate y huevo, patatas fritas, y una pizza de queso en la mesa de al lado',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurant-pizzeria-venecia`,
	name: BUSINESS.fullName,
	alternateName: [
		'Restaurant Pizzeria Venecia',
		'Pizzeria Venècia',
		'Venècia Sant Julià de Lòria',
		'Pizzería Venecia Andorra',
	],
	description:
		'Pizzería y restaurante en la Av. Verge de Canòlich, 20, de Sant Julià de Lòria (Andorra). Comidas y cenas, con pizza al horno y platos de restaurante.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376841796',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pizza', 'Cocina italiana'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '23:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#241a16" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Karla:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="pizzería Sant Julià de Lòria, RESTAURANT PIZZERIA VENÈCIA, pizzería Andorra, restaurante Andorra, pizza Av. Verge de Canòlich, comer en Sant Julià de Lòria"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pizzería en la Av. Verge de Canòlich, 20, de Sant Julià de Lòria. 4,4 sobre 5 con 622 reseñas en Google. Comidas de 13:00 a 15:30 y cenas de 20:00 a 23:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de RESTAURANT PIZZERIA VENÈCIA en Sant Julià de Lòria, con el toldo blanco y la pared de piedra"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#241a16"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-06"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Venècia"
			subtitle="Pizzería · Sant Julià de Lòria"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. Verge de Canòlich, 20 · Sant Julià de Lòria"
				title="Pizza al horno <br /><em>en Sant Julià.</em>"
				lede={`Venècia es la pizzería-restaurante de la Av. Verge de Canòlich, 20, en plena parroquia de Sant Julià de Lòria. Sirve a mediodía y por la noche, con pizza al horno y platos de restaurante, y cierra los martes. Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas, una media amplia para un local de parroquia.`}
				image={fachada}
				imageAlt="La fachada de RESTAURANT PIZZERIA VENÈCIA en la Av. Verge de Canòlich, 20, con el toldo blanco, la pared de piedra y las macetas de la entrada"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>13:00–15:30</b> · y 20:00–23:30' },
					{ label: 'Cerrado', html: '<b>Martes</b> · todo el día' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Pizzería · Andorra"
			/>

			<LocalChips label="Lo que ofrece RESTAURANT PIZZERIA VENÈCIA" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Canòlich, 20. <br /><em>Pizza y mesa.</em>"
				paragraphs={[
					'Venècia está en la Av. Verge de Canòlich, 20, la avenida que atraviesa Sant Julià de Lòria, la parroquia andorrana por la que se entra al país desde la Seu d’Urgell. La fachada es de piedra, con un toldo blanco sobre la puerta y macetas en la acera.',
					'Dentro, el comedor está pintado con un mural de Venecia: el puente de Rialto, el Gran Canal y las góndolas. Las mesas van con mantel y las sillas son de madera con tapizado morado. Es un sitio de mantelería, no de mostrador.',
					'La ficha de Google lo clasifica como «Pizzería», y el nombre comercial dice «Restaurant Pizzeria»: en la mesa conviven las pizzas al horno —de jamón, champiñones y alcachofas, o de marisco— con platos de restaurante como la lubina a la plancha, las costillas asadas o los canelones gratinados.',
					`El horario son dos servicios: de 13:00 a 15:30 y de 20:00 a 23:30, de domingo a sábado. Los martes cierra todo el día, y la ficha avisa de que en festivos el horario puede cambiar. La valoración es de ${RATING.label} sobre 5 con ${RATING.count} reseñas (noviembre de 2026).`,
				]}
				note="La ficha de Google no publica la carta, los precios ni si hay terraza, reparto o menú del día. Esta web no los inventa: se preguntan en el +376 841 796."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> La pizarra</p>
					<h2 id="highlights-title">Dos servicios, <br /><em>una avenida.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La fachada, el comedor <br /><em>y la mesa.</em>"
				description="Diez fotografías del perfil de Venècia en Google Maps: la fachada con el toldo blanco, el comedor con el mural de Venecia, el pan con tomate y anchoas, las pizzas de jamón y de marisco, la lubina a la plancha, las costillas, la ensalada, los canelones y el arroz con tomate."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,4 sobre 5, <em>con 622 reseñas.</em></h2>
						<p>
							No es un 5 perfecto ni una ficha recién abierta: 622 opiniones dan para una media
							estable, con clientes contentos y alguno que no lo estuvo. La media publicada es
							4,4 sobre 5 (consultada el 1 de noviembre de 2026).
						</p>
						<p>
							Esta web no copia reseñas sueltas: para leerlas enteras, con sus fechas y sus
							respuestas, lo mejor es abrir la ficha en Google.
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver las 622 reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,4</strong>
						<span>★★★★☆</span>
						<small>622 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En la avenida <br /><em>de Canòlich.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} · Andorra`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: comidas de 13:00 a 15:30 y cenas de 20:00 a 23:30, de domingo a sábado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de RESTAURANT PIZZERIA VENÈCIA en la Av. Verge de Canòlich, 20, Sant Julià de Lòria"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Canòlich, 20 · Sant Julià de Lòria"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Reservas y consultas por teléfono, en el +376 841 796: la ficha no publica reservas online ni pedidos por la web, y tampoco dice si hay terraza, reparto o menú del día. Si vas en grupo o un día festivo, llama antes."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Venècia"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario, valoración y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. La ficha no publica carta ni precios: confírmalos por teléfono."
			ctaLabel="Llamar a Venècia"
			navAriaLabel="Enlaces de RESTAURANT PIZZERIA VENÈCIA"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
