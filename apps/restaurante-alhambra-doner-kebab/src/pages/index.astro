---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	directionsUrl,
	hours,
	mapEmbedUrl,
	mapsUrl,
	resenas,
	site,
} from '../data/site';

// Fotos descargadas de la ficha de Google Maps, en `src/assets/fotos`, servidas con `<Image>`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const listaFotos = Object.keys(fotos)
	.sort()
	.map((ruta) => fotos[ruta].default);

const title = 'Restaurante Alhambra Doner Kebab · Restaurante en Ciudad Real';
const description =
	'Restaurante Alhambra Doner Kebab en la Calle de la Mata, 8 de Ciudad Real. Abre cada día desde las 12:30.';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta name="robots" content="index, follow" />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:card" content="summary_large_image" />
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Restaurant",
	"@id": "https://restaurante-alhambra-doner-kebab.vercel.app/#negocio",
	"name": "Restaurante Alhambra Doner Kebab",
	"url": "https://restaurante-alhambra-doner-kebab.vercel.app/",
	"description": "Restaurante Alhambra Doner Kebab en la Calle de la Mata, 8 de Ciudad Real. Abre cada día desde las 12:30.",
	"image": "https://restaurante-alhambra-doner-kebab.vercel.app/og.jpg",
	"telephone": "+34624654116",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 38.985492,
		"longitude": -3.921948
	},
	"hasMap": "https://www.google.com/maps/place/Restaurante+Alhambra+Doner+Kebab/@38.985492,-3.921948,17z/data=!3m1!4b1!4m6!3m5!1s0xd6bc3c48c8ce991:0x952dda1f9341e214!8m2!3d38.985492!4d-3.921948!16s%2Fg%2F11tcwlffwq?hl=es"
}
</script>
</head>
	<body>
		<header class="hero" id="inicio">
			<div class="hero-grid">
				<div class="hero-copy">
					<p class="eyebrow">{business.category} · Ciudad Real</p>
					<h1 set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante en la Calle de la Mata, 8. {business.reviewCount} reseñas en Google.
					</p>
					<div class="hero-actions">
						<a class="button" href={mapsUrl} rel="noopener">Ver ficha en Google Maps</a>
						<a class="button secondary" href={directionsUrl} rel="noopener">Cómo llegar</a>
					</div>
				</div>
				{listaFotos[0] && (
					<Image src={listaFotos[0]} alt={`Fotografía de ${business.name} publicada en Google Maps`} widths={[640, 960]} sizes="(min-width: 800px) 50vw, 100vw" />
				)}
			</div>
		</header>

		<main>
			<section class="section" id="local" aria-labelledby="local-title">
				<h2 id="local-title">Dónde estamos</h2>
				<p>{business.streetAddress}, {business.postalCode} {business.city}. Teléfono: <a href={`tel:${business.phone.replace(/\s/g, '')}`}>{business.phone}</a>.</p>
				<p>
					<a href={mapsUrl} rel="noopener">Abrir en Google Maps</a> ·
					<a href={directionsUrl} rel="noopener">Cómo llegar</a>
				</p>
				<iframe
					title={`Mapa de ${business.name}`}
					src={mapEmbedUrl}
					width="100%"
					height="320"
					style="border:0"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
			</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<h2 id="horario-title">Horario</h2>
				<table>
					<tbody>
						{hours.map((item) => (
							<tr>
								<th scope="row">{item.day}</th>
								<td>{item.service}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>

			<section class="section" id="resenas" aria-labelledby="resenas-title">
				<h2 id="resenas-title">Lo que dicen</h2>
				<p>{business.reviewCount} reseñas en Google.</p>
				{resenas.map((r) => (
					<blockquote>« {r.texto} »</blockquote>
				))}
				<p>Accesibilidad publicada en la ficha: {accesibilidad.join('; ')}.</p>
			</section>

			{listaFotos.length > 1 && (
				<section class="section" id="fotos" aria-labelledby="fotos-title">
					<h2 id="fotos-title">Fotos</h2>
					<div class="galeria">
						{listaFotos.map((foto) => (
							<Image src={foto} alt={`Fotografía de ${business.name} publicada en Google Maps`} widths={[480, 800]} sizes="(min-width: 800px) 33vw, 50vw" />
						))}
					</div>
				</section>
			)}
		</main>

		<footer class="site-footer">
			<p>
				© {new Date().getFullYear()} {business.name}. Datos tomados de la ficha pública de Google Maps el {site.consultado}.
			</p>
			<p>
				<small>Creado por <a href="https://sur-digital.vercel.app" rel="noopener">Sur Digital</a> · sur-digital.vercel.app</small>
			</p>
		</footer>
	</body>
</html>
