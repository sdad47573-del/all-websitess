---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/la-hogaza-malaguena-apaisada-01.jpg';
import napolitanas from '../assets/fotos/la-hogaza-malaguena-apaisada-02.jpg';
import interior from '../assets/fotos/la-hogaza-malaguena-apaisada-03.jpg';
import hogazas from '../assets/fotos/la-hogaza-malaguena-vertical-04.jpg';
import semillas from '../assets/fotos/la-hogaza-malaguena-vertical-05.jpg';
import arcos from '../assets/fotos/la-hogaza-malaguena-apaisada-06.jpg';
import baguettes from '../assets/fotos/la-hogaza-malaguena-vertical-07.jpg';
import croissants from '../assets/fotos/la-hogaza-malaguena-apaisada-08.jpg';
import escaparate from '../assets/fotos/la-hogaza-malaguena-vertical-09.jpg';
import caracolas from '../assets/fotos/la-hogaza-malaguena-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'LA HOGAZA MALAGUEÑA · Panadería y pastelería en Carretera de Cádiz, Málaga';
const description =
	'LA HOGAZA MALAGUEÑA, panadería, pastelería y tienda de tartas en la calle Muñoz Degraín, 4 (Carretera de Cádiz, 29002 Málaga). Pan, bollería y tartas por encargo. Abierta todos los días de 7:00 a 15:00.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#la-hogaza-malaguena`,
	name: BUSINESS.name,
	alternateName: ['La Hogaza Malagueña', 'Pan La Hogaza Malagueña', 'Panadería La Hogaza Málaga'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '07:00',
			closes: '15:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de LA HOGAZA MALAGUEÑA en la calle Muñoz Degraín, con el rótulo azul «Pan La Hogaza Malagueña» sobre los cristales',
	},
	{
		src: interior,
		alt: 'Interior de la panadería con arcos de ladrillo, cestas de pan, estanterías de productos envasados y la báscula',
	},
	{
		src: napolitanas,
		alt: 'Napolitanas de crema cubiertas de azúcar glas en la bandeja de la vitrina',
	},
	{
		src: hogazas,
		alt: 'Hogazas rústicas de corteza marcada y harina en una cesta de mimbre',
	},
	{
		src: baguettes,
		alt: 'Baguettes recién hechas alineadas en la bandeja del obrador',
	},
	{
		src: semillas,
		alt: 'Panes redondos cubiertos de semillas junto a hogazas enharinadas',
	},
	{
		src: croissants,
		alt: 'Croissants de hojaldre en la bandeja del mostrador',
	},
	{
		src: caracolas,
		alt: 'Caracolas de hojaldre con crema y azúcar glas en la bandeja',
	},
	{
		src: arcos,
		alt: 'Mostrador de la panadería con arcos de ladrillo y cestas llenas de barras y panecillos',
	},
	{
		src: escaparate,
		alt: 'Escaparate de la panadería con la persiana de malla bajada y el rótulo sobre la puerta',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f3a5f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..600&family=Manrope:wght@400..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Hogaza Malagueña, panadería Carretera de Cádiz, panadería Málaga, pastelería Málaga, tartas personalizadas Málaga, empanadas por encargo, pan artesano Málaga, Muñoz Degraín"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería, pastelería y tienda de tartas en Muñoz Degraín, 4 (Carretera de Cádiz). Pan, bollería y encargos. Todos los días de 7:00 a 15:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo de LA HOGAZA MALAGUEÑA en la fachada de la panadería, en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1f3a5f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Hogaza"
			subtitle="Panadería · Pastelería"
			nav={nav}
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Muñoz Degraín, 4 · Carretera de Cádiz"
				title="El pan de cada mañana, <br /><em>en Carretera de Cádiz.</em>"
				lede={`LA HOGAZA MALAGUEÑA está en la calle Muñoz Degraín, 4, en Carretera de Cádiz. Es panadería, pastelería y tienda de tartas: hogazas, barras, pan con semillas, napolitanas, caracolas y croissants, además de tartas personalizadas y empanadas por encargo. Abre todos los días de 7:00 a 15:00. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={fachada}
				imageAlt="Fachada de LA HOGAZA MALAGUEÑA con el rótulo azul sobre los cristales, en la calle Muñoz Degraín"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5</b> en Google · 45 reseñas' },
					{ label: 'Horario', html: '<b>7:00–15:00</b> todos los días' },
					{ label: 'Encargos', html: '<b>Tartas</b> y empanadas' },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Pan · bollería · tartas"
			/>

			<LocalChips label="Lo que hay en La Hogaza" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una panadería <br /><em>de barrio.</em>"
				paragraphs={[
					'LA HOGAZA MALAGUEÑA está en la calle Muñoz Degraín, 4, en Carretera de Cádiz (29002 Málaga). El rótulo azul de la fachada anuncia «Pan La Hogaza Malagueña», y en la puerta un cartel avisa de que se hacen tartas personalizadas.',
					'Dentro, el local tiene arcos de ladrillo, estanterías de mimbre y una vitrina de cristal. En las fotos del perfil se ven hogazas rústicas enharinadas, barras y baguettes recién hechas, panes redondos con semillas y una balanza junto al mostrador.',
					'La bollería se muestra en bandejas: napolitanas y caracolas cubiertas de crema y azúcar glas, y croissants de hojaldre. En las estanterías hay también productos envasados, aperitivos y bebidas.',
					'En el interior, un cartel indica «Empanadas y salatitos por encargo». Google clasifica el negocio como panadería, pastelería y tienda de tartas, y le da 4,5 sobre 5 con 45 reseñas. La ficha no publica teléfono ni web, así que los encargos y las dudas se hablan en el mostrador.',
				]}
				note="La ficha de Google no publica teléfono, web ni precios. Esta página solo cuenta lo que muestran las fotos del perfil, lo que dicen los rótulos del local y lo que cuentan las reseñas."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Pan, bollería <br />
							<em>y encargos.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que hay <br /><em>en la vitrina.</em>"
				description="Sin carta ni precios publicados: esto es lo que muestran las fotos del local, los rótulos y las reseñas de Google."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={MENU_GROUPS}
				note="La ficha no recoge precios ni métodos de pago, así que esta web no publica importes. El surtido cambia a lo largo de la mañana: la panadería abre de 7:00 a 15:00."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La casa, <br /><em>por dentro.</em>"
				description="Diez fotos de la ficha de Google Maps: la fachada, el interior con los arcos de ladrillo, las hogazas, las barras, el pan con semillas y la bollería."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Muñoz Degraín, <br /><em>junto al mar.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de LA HOGAZA MALAGUEÑA en la calle Muñoz Degraín, 4, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Hogaza · Carretera de Cádiz"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Street View', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: 'Abrir en Google Maps ↗', href: MAPS.place, external: true }}
				reserveNote="La ficha de Google no publica teléfono ni web: los encargos de tartas personalizadas, empanadas y salatitos se hablan en el mostrador. Indica acceso para sillas de ruedas, pero no informa sobre el mostrador ni el aseo."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone=""
			phoneHref=""
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Ver en Google Maps"
			navAriaLabel="Enlaces de La Hogaza Malagueña"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
