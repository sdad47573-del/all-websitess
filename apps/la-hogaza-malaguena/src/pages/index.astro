---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/la-hogaza-malaguena-apaisada-01.jpg';
import napolitanas from '../assets/fotos/la-hogaza-malaguena-apaisada-02.jpg';
import interior from '../assets/fotos/la-hogaza-malaguena-apaisada-03.jpg';
import hogazas from '../assets/fotos/la-hogaza-malaguena-vertical-04.jpg';
import semillas from '../assets/fotos/la-hogaza-malaguena-vertical-05.jpg';
import arcos from '../assets/fotos/la-hogaza-malaguena-apaisada-06.jpg';
import baguettes from '../assets/fotos/la-hogaza-malaguena-vertical-07.jpg';
import croissants from '../assets/fotos/la-hogaza-malaguena-apaisada-08.jpg';
import escaparate from '../assets/fotos/la-hogaza-malaguena-vertical-09.jpg';
import caracolas from '../assets/fotos/la-hogaza-malaguena-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'LA HOGAZA MALAGUEÑA · Panadería y pastelería en Carretera de Cádiz, Málaga';
const description =
	'LA HOGAZA MALAGUEÑA, panadería, pastelería y tienda de tartas en la calle Muñoz Degraín, 4 (Carretera de Cádiz, 29002 Málaga). Pan, bollería y tartas por encargo. Abierta todos los días de 7:00 a 15:00.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#la-hogaza-malaguena`,
	name: BUSINESS.name,
	alternateName: ['La Hogaza Malagueña', 'Pan La Hogaza Malagueña', 'Panadería La Hogaza Málaga'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '07:00',
			closes: '15:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de LA HOGAZA MALAGUEÑA en la calle Muñoz Degraín, con el rótulo azul «Pan La Hogaza Malagueña» sobre los cristales',
	},
	{
		src: interior,
		alt: 'Interior de la panadería con arcos de ladrillo, cestas de pan, estanterías de productos envasados y la báscula',
	},
	{
		src: napolitanas,
		alt: 'Napolitanas de crema cubiertas de azúcar glas en la bandeja de la vitrina',
	},
	{
		src: hogazas,
		alt: 'Hogazas rústicas de corteza marcada y harina en una cesta de mimbre',
	},
	{
		src: baguettes,
		alt: 'Baguettes recién hechas alineadas en la bandeja del obrador',
	},
	{
		src: semillas,
		alt: 'Panes redondos cubiertos de semillas junto a hogazas enharinadas',
	},
	{
		src: croissants,
		alt: 'Croissants de hojaldre en la bandeja del mostrador',
	},
	{
		src: caracolas,
		alt: 'Caracolas de hojaldre con crema y azúcar glas en la bandeja',
	},
	{
		src: arcos,
		alt: 'Mostrador de la panadería con arcos de ladrillo y cestas llenas de barras y panecillos',
	},
	{
		src: escaparate,
		alt: 'Escaparate de la panadería con la persiana de malla bajada y el rótulo sobre la puerta',
	},
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-hogaza-malaguena-apaisada-01.jpg": fachada,
	"la-hogaza-malaguena-apaisada-03.jpg": interior,
	"la-hogaza-malaguena-apaisada-02.jpg": napolitanas,
	"la-hogaza-malaguena-vertical-04.jpg": hogazas,
	"la-hogaza-malaguena-vertical-07.jpg": baguettes,
	"la-hogaza-malaguena-vertical-05.jpg": semillas,
	"la-hogaza-malaguena-apaisada-08.jpg": croissants,
	"la-hogaza-malaguena-apaisada-10.jpg": caracolas,
	"la-hogaza-malaguena-apaisada-06.jpg": arcos,
	"la-hogaza-malaguena-vertical-09.jpg": escaparate,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f3a5f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..600&family=Manrope:wght@400..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Hogaza Malagueña, panadería Carretera de Cádiz, panadería Málaga, pastelería Málaga, tartas personalizadas Málaga, empanadas por encargo, pan artesano Málaga, Muñoz Degraín"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería, pastelería y tienda de tartas en Muñoz Degraín, 4 (Carretera de Cádiz). Pan, bollería y encargos. Todos los días de 7:00 a 15:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo de LA HOGAZA MALAGUEÑA en la fachada de la panadería, en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1f3a5f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Hogaza"
			subtitle="Panadería · Pastelería"
			nav={nav}
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone=""
			phoneHref=""
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Ver en Google Maps"
			navAriaLabel="Enlaces de La Hogaza Malagueña"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
