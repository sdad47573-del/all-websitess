---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import paellaMarisco from '../assets/fotos/restaurante-parasoles-apaisada-05.jpg';
import mesaArena from '../assets/fotos/restaurante-parasoles-apaisada-03.jpg';
import mariscada from '../assets/fotos/restaurante-parasoles-apaisada-10.jpg';
import fideua from '../assets/fotos/restaurante-parasoles-vertical-07.jpg';
import nachos from '../assets/fotos/restaurante-parasoles-apaisada-04.jpg';
import sangria from '../assets/fotos/restaurante-parasoles-vertical-09.jpg';
import postre from '../assets/fotos/restaurante-parasoles-vertical-06.jpg';
import comedor from '../assets/fotos/restaurante-parasoles-apaisada-01.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Restaurante Parasoles, cocina mediterránea y marisquería en primera línea de Platja d’en Bossa (Ibiza). Arroces, marisco y vistas al mar. Tel. 971 30 52 31.';

const galeria = [
	{
		src: paellaMarisco,
		alt: 'Paella de marisco y mariscada con mejillones, langostinos y pescado a la plancha sobre una mesa con vistas al mar',
	},
	{
		src: mesaArena,
		alt: 'Mesa en la arena de Platja d’en Bossa con arroz negro en la paellera, mariscada, vino y el mar al fondo',
	},
	{
		src: mariscada,
		alt: 'Mariscada con calamares, mejillones, almejas y langostinos servida en una fuente ovalada',
	},
	{
		src: fideua,
		alt: 'Fideuá de marisco con langostinos, mejillones y un gajo de limón en un plato blanco',
	},
	{
		src: nachos,
		alt: 'Nachos con guacamole, pico de gallo y jalapeños junto a una cazuela de gambas al ajillo',
	},
	{
		src: sangria,
		alt: 'Copas de sangría sobre una mesa blanca ante el mar, al atardecer, con lámpara de mesa encendida',
	},
	{
		src: postre,
		alt: 'Tarta de zanahoria con nata montada y salsa de caramelo en un plato azul',
	},
	{
		src: comedor,
		alt: 'Comedor de Parasoles por la noche, con mesas vestidas de blanco, sillas de madera y copas preparadas',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#parasoles`,
	name: BUSINESS.name,
	alternateName: [
		'Parasoles',
		'Los Parasoles',
		'Parasoles Ibiza',
		'Restaurante Parasoles Playa d’en Bossa',
	],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 971 30 52 31',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Marisco', 'Arroces', 'Pescado'],
	areaServed: [
		{ '@type': 'City', name: 'Sant Josep de sa Talaia' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '11:30',
			closes: '18:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Parasoles · Arroces y marisco en Playa d’en Bossa';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0d5f6b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Parasoles Ibiza, Parasoles Playa d'en Bossa, comer en Playa d'en Bossa, restaurante primera línea de playa Ibiza, arroces Playa d'en Bossa, paella Playa d'en Bossa, mariscada Ibiza, marisquería Ibiza, Ses Begonies"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Parasoles · Arroces y marisco en Playa d’en Bossa"
			ogDescription="Cocina mediterránea y marisquería en primera línea de Platja d’en Bossa: paellas, arroz negro, mariscada y pescado a la plancha con vistas al mar. Tel. 971 30 52 31."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Paella de marisco y mariscada en una mesa de Parasoles con el mar al fondo"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#0d5f6b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			phone="+34971305231"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[paellaMarisco]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Parasoles"
			subtitle="Arroces · Playa d’en Bossa"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Ses Begonies, 1-2 · Playa d’en Bossa"
				title="Arroces con<br /><em>el mar detrás.</em>"
				lede={`Parasoles es un restaurante mediterráneo y marisquería en primera línea de Platja d’en Bossa (Sant Josep de sa Talaia, Ibiza). En sus mesas, muchas de ellas en la arena, salen la paella de marisco, el arroz negro y la fideuá, la mariscada, el pescado a la plancha, la fritura, las gambas al ajillo y las ensaladas. El propio restaurante se define como «restaurante familiar con buena comida y buen ambiente, ideal para comidas familiares y bonitas vistas al mar». Abre todos los días de 11:30 a 18:00. Teléfono: ${BUSINESS.phoneDisplay}.`}
				image={paellaMarisco}
				imageAlt="Paella de marisco y mariscada con mejillones, langostinos y pescado a la plancha sobre una mesa con vistas al mar"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsLabel} reseñas)`,
					},
					{ label: 'Cocina', html: 'Mediterránea · arroces y marisco' },
					{ label: 'Horario', html: 'Todos los días · 11:30–18:00' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Restaurante Parasoles" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Sombrillas, mesa<br /><em>y agua cerca.</em>"
				paragraphs={[
					'Parasoles está en Ses Begonies, 1-2, en primera línea de Platja d’en Bossa, el arenal largo que va de Ibiza a Sant Josep de sa Talaia. La ficha de Google lo clasifica como restaurante mediterráneo y marisquería, y el propio negocio lo cuenta así: «restaurante familiar con buena comida y buen ambiente, ideal para comidas familiares y bonitas vistas al mar».',
					'La casa ocupa la arena y la terraza: mesas vestidas de blanco, sillas de madera, copas altas y el mar justo detrás. En las fotos del perfil hay mesas a pleno sol de mediodía y también mesas al atardecer, con las lámparas encendidas y la sangría servida. Dentro, el comedor repite el blanco en los manteles y los platos.',
					'La cocina es de arroces y pescado: paella de marisco, arroz negro en la paellera, fideuá con langostinos y mejillones, mariscada con almejas, calamares y gambas, pescado entero a la plancha y fritura de pescado. Para picar salen nachos con guacamole, patatas bravas y gambas al ajillo, y de postre, tarta de zanahoria con caramelo.',
					'Sus reseñas hablan de la mesa larga y del servicio: «a destacar el gazpacho, mejillones marinera, mariscada y el surtido de tartas», «buenísima paella y camareros muy buenos» y «ensaladas correctas (sencillas, grandes y frescas)». Google le da 4,4 sobre 5 con 1.155 reseñas.',
				]}
				note={`${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsLabel} reseñas en Google. Una de ellas: «${REVIEWS[0]}»`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Paellas, mariscada<br /><em>y pescado a la plancha.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que aparece en las fotos del perfil y lo que citan sus reseñas."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. Llama al 971 30 52 31 para reservar mesa o preguntar por los arroces y el pescado del día."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La mesa, la arena<br /><em>y la paellera.</em>"
				description="Estas fotografías proceden del perfil de Restaurante Parasoles en Google Maps: la paella de marisco y la mariscada con el mar al fondo, las mesas en la arena, la fideuá, las gambas al ajillo con nachos, la sangría del atardecer, la tarta de zanahoria y el comedor de noche."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en la orilla.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Sant Josep de sa Talaia · Islas Baleares',
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: todos los días de 11:30 a 18:00. Es un restaurante de mediodía, así que en temporada alta conviene llamar antes para mesa."
				mapTitle="Mapa de Restaurante Parasoles en Ses Begonies, Playa d’en Bossa"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Parasoles · Playa d’en Bossa"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 971 30 52 31. La ficha de Google marca acceso para sillas de ruedas, aseo adaptado y asientos adaptados."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Parasoles"
		/>
	</body>
</html>
