---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import paellaMarisco from '../assets/fotos/restaurante-parasoles-apaisada-05.jpg';
import mesaArena from '../assets/fotos/restaurante-parasoles-apaisada-03.jpg';
import mariscada from '../assets/fotos/restaurante-parasoles-apaisada-10.jpg';
import fideua from '../assets/fotos/restaurante-parasoles-vertical-07.jpg';
import nachos from '../assets/fotos/restaurante-parasoles-apaisada-04.jpg';
import sangria from '../assets/fotos/restaurante-parasoles-vertical-09.jpg';
import postre from '../assets/fotos/restaurante-parasoles-vertical-06.jpg';
import comedor from '../assets/fotos/restaurante-parasoles-apaisada-01.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Restaurante Parasoles, cocina mediterránea y marisquería en primera línea de Platja d’en Bossa (Ibiza). Arroces, marisco y vistas al mar. Tel. 971 30 52 31.';

const galeria = [
	{
		src: paellaMarisco,
		alt: 'Paella de marisco y mariscada con mejillones, langostinos y pescado a la plancha sobre una mesa con vistas al mar',
	},
	{
		src: mesaArena,
		alt: 'Mesa en la arena de Platja d’en Bossa con arroz negro en la paellera, mariscada, vino y el mar al fondo',
	},
	{
		src: mariscada,
		alt: 'Mariscada con calamares, mejillones, almejas y langostinos servida en una fuente ovalada',
	},
	{
		src: fideua,
		alt: 'Fideuá de marisco con langostinos, mejillones y un gajo de limón en un plato blanco',
	},
	{
		src: nachos,
		alt: 'Nachos con guacamole, pico de gallo y jalapeños junto a una cazuela de gambas al ajillo',
	},
	{
		src: sangria,
		alt: 'Copas de sangría sobre una mesa blanca ante el mar, al atardecer, con lámpara de mesa encendida',
	},
	{
		src: postre,
		alt: 'Tarta de zanahoria con nata montada y salsa de caramelo en un plato azul',
	},
	{
		src: comedor,
		alt: 'Comedor de Parasoles por la noche, con mesas vestidas de blanco, sillas de madera y copas preparadas',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#parasoles`,
	name: BUSINESS.name,
	alternateName: [
		'Parasoles',
		'Los Parasoles',
		'Parasoles Ibiza',
		'Restaurante Parasoles Playa d’en Bossa',
	],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 971 30 52 31',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Marisco', 'Arroces', 'Pescado'],
	areaServed: [
		{ '@type': 'City', name: 'Sant Josep de sa Talaia' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '11:30',
			closes: '18:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Parasoles · Arroces y marisco en Playa d’en Bossa';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-parasoles-apaisada-05.jpg": paellaMarisco,
	"restaurante-parasoles-apaisada-03.jpg": mesaArena,
	"restaurante-parasoles-apaisada-10.jpg": mariscada,
	"restaurante-parasoles-vertical-07.jpg": fideua,
	"restaurante-parasoles-apaisada-04.jpg": nachos,
	"restaurante-parasoles-vertical-09.jpg": sangria,
	"restaurante-parasoles-vertical-06.jpg": postre,
	"restaurante-parasoles-apaisada-01.jpg": comedor,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0d5f6b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Parasoles Ibiza, Parasoles Playa d'en Bossa, comer en Playa d'en Bossa, restaurante primera línea de playa Ibiza, arroces Playa d'en Bossa, paella Playa d'en Bossa, mariscada Ibiza, marisquería Ibiza, Ses Begonies"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Parasoles · Arroces y marisco en Playa d’en Bossa"
			ogDescription="Cocina mediterránea y marisquería en primera línea de Platja d’en Bossa: paellas, arroz negro, mariscada y pescado a la plancha con vistas al mar. Tel. 971 30 52 31."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Paella de marisco y mariscada en una mesa de Parasoles con el mar al fondo"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#0d5f6b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			phone="+34971305231"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[paellaMarisco]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Parasoles"
			subtitle="Arroces · Playa d’en Bossa"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Parasoles"
		/>
	</body>
</html>
