---
import '../styles/global.css';
import {
	business,
	directionsUrl,
	emailHref,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	services,
	structuredData,
	whatsappUrl,
} from '../lib/business';

const title = 'Taller Finca la Palma | Chapa, pintura y mecánica en Málaga';
const description =
	'Taller Finca la Palma en Teatinos, Málaga. Servicios de chapa, pintura y mecánica. Estamos en C. Francisco Barbin, 11. Llama al 952 28 55 40 o escríbenos por WhatsApp.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#173c3b" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Taller Finca la Palma, inicio">
				<span class="brand-mark" aria-hidden="true"><span>FP</span><i></i></span>
				<span class="brand-name">Finca la Palma <small>Taller · Teatinos · Málaga</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#servicios">Servicios</a>
				<a href="#ubicacion">Ubicación</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}><span aria-hidden="true">↗</span> 952 28 55 40</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span> Teatinos · Málaga</p>
					<h1 id="hero-title">Taller Finca<br /><em>la Palma.</em></h1>
					<p class="hero-lede">
						Chapa, pintura y mecánica en Teatinos. Estamos en la calle Francisco Barbin; contacta con el
						taller o consulta cómo llegar.
					</p>
					<div class="hero-actions">
						<a class="button button-leaf" href={phoneHref}><span aria-hidden="true">↗</span> Llamar al taller</a>
						<a class="button button-outline" href={whatsappUrl} target="_blank" rel="noreferrer">
							WhatsApp <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="hero-address">
						<span class="address-icon" aria-hidden="true">⌖</span>
						<span><small>ENCUÉNTRANOS EN</small><strong>{business.streetAddress} · {business.city}</strong></span>
					</div>
				</div>

				<div class="hero-art" aria-hidden="true">
					<div class="art-orbit orbit-one"></div>
					<div class="art-orbit orbit-two"></div>
					<div class="sun-disc"></div>
					<div class="palm palm-back"><span class="trunk"></span><i class="frond frond-a"></i><i class="frond frond-b"></i><i class="frond frond-c"></i><i class="frond frond-d"></i></div>
					<div class="palm palm-front"><span class="trunk"></span><i class="frond frond-a"></i><i class="frond frond-b"></i><i class="frond frond-c"></i><i class="frond frond-d"></i></div>
					<div class="art-caption"><span>CARROCERÍA · PINTURA · MECÁNICA</span><b>FP / 01</b></div>
					<div class="art-stamp">MÁLAGA<br /><strong>ES</strong></div>
				</div>
			</section>

			<section class="identity-strip" aria-label="Datos del taller">
				<div class="identity-mark" aria-hidden="true">FP<span>.</span></div>
				<p><small>ESPECIALIDADES</small><strong>Chapa · Pintura · Mecánica</strong></p>
				<span class="strip-rule" aria-hidden="true"></span>
				<p><small>DIRECCIÓN</small><strong>{business.streetAddress}</strong></p>
				<span class="strip-rule" aria-hidden="true"></span>
				<p><small>LOCALIDAD</small><strong>{business.district} · {business.city}</strong></p>
			</section>

			<section class="services section-pad" id="servicios" aria-labelledby="services-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow dark"><span class="eyebrow-mark" aria-hidden="true"></span> Qué hacemos</p>
						<h2 id="services-title">Cuidamos cada<br /><em>detalle.</em></h2>
					</div>
					<p class="section-intro">Servicios de taller en Teatinos, Málaga. Llámanos para consultar tu caso y pedir información.</p>
				</div>
				<div class="service-grid">
					{services.map((service, index) => (
						<article class:list={['service-card', index === 0 && 'service-feature']}>
							<span class="service-mark" aria-hidden="true">{index === 0 ? '01' : '02'}</span>
							<div><h3>{service.title}</h3><p>{service.detail}</p></div>
							<span class="service-arrow" aria-hidden="true">↗</span>
						</article>
					))}
				</div>
				<a class="service-cta" href={whatsappUrl} target="_blank" rel="noreferrer">Consultar por WhatsApp <span aria-hidden="true">↗</span></a>
			</section>

			<section class="location section-pad" id="ubicacion" aria-labelledby="location-title">
				<div class="location-copy">
					<p class="eyebrow dark"><span class="eyebrow-mark" aria-hidden="true"></span> Estamos en Teatinos</p>
					<h2 id="location-title">Ven a vernos<br /><em>a la Palma.</em></h2>
					<p class="location-lede">Nos encontrarás en la calle Francisco Barbin, en el distrito de Teatinos-Universidad, Málaga.</p>
					<address>
						<span class="address-pin" aria-hidden="true">⌖</span>
						<span><strong>{business.streetAddress}</strong><small>{business.postalCode} {business.city}, España</small></span>
					</address>
					<a class="contact-detail" href={phoneHref}><small>TELÉFONO</small><strong>952 28 55 40</strong></a>
					<a class="contact-detail email-detail" href={emailHref}><small>CORREO</small><strong>{business.email}</strong></a>
					<div class="contact-actions">
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="text-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Google Maps ↗</a>
					</div>
					<div class="social-links">
						<a href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp · 647 00 45 77 ↗</a>
						<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram del taller ↗</a>
					</div>
				</div>
				<div class="map-shell">
					<div class="map-head"><span><i aria-hidden="true"></i> UBICACIÓN DEL TALLER</span><span>TEATINOS · MÁLAGA</span></div>
					<iframe
						title="Mapa de Taller Finca la Palma en calle Francisco Barbin, 11, Málaga"
						src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-tag" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Finca la Palma · Málaga</a>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio" aria-label="Taller Finca la Palma, volver al inicio">
				<span class="brand-mark" aria-hidden="true"><span>FP</span><i></i></span>
				<span class="brand-name">Finca la Palma <small>Taller · Teatinos · Málaga</small></span>
			</a>
			<p>{business.streetAddress} · {business.postalCode} {business.city}</p>
			<a class="footer-phone" href={phoneHref}>952 28 55 40 <span aria-hidden="true">↗</span></a>
			<small>© {new Date().getFullYear()} {business.name}. Información de contacto y ubicación.</small>
		</footer>

		<a class="mobile-call" href={phoneHref}><span aria-hidden="true">↗</span> Llamar al taller <strong>952 28 55 40</strong></a>
	</body>
</html>
