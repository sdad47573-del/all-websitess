---
import { Image } from 'astro:assets';
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/panaderia-la-palmera-vertical-01.jpg';
import empanadillas from '../assets/fotos/panaderia-la-palmera-vertical-03.jpg';
import dulcesChocolate from '../assets/fotos/panaderia-la-palmera-apaisada-04.jpg';
import donuts from '../assets/fotos/panaderia-la-palmera-apaisada-05.jpg';
import tartaSesamo from '../assets/fotos/panaderia-la-palmera-vertical-08.jpg';
import galletas from '../assets/fotos/panaderia-la-palmera-apaisada-10.jpg';
import tartaPlana from '../assets/fotos/panaderia-la-palmera-vista-2-02.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HOURS, HOURS_NOTE, MAPS, SERVICIOS } from '../data/site';

const title = 'Panadería-Confitería La Palmera · C. Alfonso XIII, Centro, Córdoba';
const description =
	'Panadería-Confitería La Palmera, en C. Alfonso XIII (Centro, 14001 Córdoba). Pan, confitería, frutos secos y golosinas. De lunes a viernes de 9:15 a 15:00 y de 18:00 a 21:00. Teléfono 676 98 62 47. 3,7/5 con 12 reseñas.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': ['Bakery', 'GroceryStore'],
	'@id': `${BUSINESS.siteUrl}/#la-palmera`,
	name: BUSINESS.name,
	alternateName: ['La Palmera', 'Panadería La Palmera Córdoba', 'Confitería La Palmera'],
	description:
		'Panadería, confitería y tienda de alimentación en la calle Alfonso XIII, Centro (14001 Córdoba).',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34676986247',
	servesCuisine: ['Panadería', 'Pastelería', 'Confitería'],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:15',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '18:00',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '10:00',
			closes: '15:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Horario', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const galeria = [
	{
		src: empanadillas,
		alt: 'Vitrina con empanadillas de York y queso y de atún y tomate, etiquetadas a mano',
	},
	{
		src: dulcesChocolate,
		alt: 'Bandeja con dos piezas grandes de bollería bañadas en chocolate sobre la vitrina',
	},
	{
		src: donuts,
		alt: 'Bandeja con donuts glaseados, napolitanas y dulces de chocolate en la vitrina',
	},
	{
		src: tartaSesamo,
		alt: 'Tarta de crema cubierta de sésamo tostado, cortada en porciones sobre bandeja de horno',
	},
	{
		src: galletas,
		alt: 'Galletas de chocolate con nueces en una bandeja de la confitería',
	},
	{
		src: tartaPlana,
		alt: 'Torta plana de azúcar en porciones ante las estanterías de golosinas de la tienda',
	},
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#fbf8f3" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300..700&family=Marcellus&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Palmera Córdoba, panadería centro Córdoba, confitería Córdoba, frutos secos, Alfonso XIII, 14001, empanadillas, bollería"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan, confitería, frutos secos y golosinas en la calle Alfonso XIII. Abierta de lunes a viernes de 9:15 a 15:00 y de 18:00 a 21:00. 3,7 sobre 5 con 12 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Fachada de la Panadería-Confitería La Palmera en Córdoba"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#fbf8f3"
			phone="+34676986247"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Palmera"
			subtitle="Panadería · Confitería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<section class="hero wrap" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C. Alfonso XIII · Centro · 14001</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						La Palmera es la panadería-confitería de la calle Alfonso XIII, en el Centro
						de Córdoba, con el rótulo de frutos secos y golosinas en la fachada. Abre de
						lunes a viernes de 9:15 a 15:00 y de 18:00 a 21:00, y el sábado solo por la
						mañana. Su teléfono es el 676 98 62 47.
						{BUSINESS.rating.toString().replace('.', ',')} sobre 5 con {BUSINESS.reviewsCount} reseñas en Google.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href={BUSINESS.phoneHref}>
							Llamar al 676 98 62 47
						</a>
						<a class="button button-ghost" href={MAPS.directions}>
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<ul class="hero-facts">
						<li><b>{BUSINESS.street}</b> · {BUSINESS.district} · {BUSINESS.postalCode} {BUSINESS.city}</li>
						<li><b>L–V</b> 9:15–15:00 y 18:00–21:00 · <b>Sáb</b> 10:00–15:00 · <b>Dom</b> cerrado</li>
						<li><b>Acceso para sillas de ruedas</b> según la ficha de Google</li>
					</ul>
				</div>

				<figure class="hero-figure">
					<Image
						src={fachada}
						alt="Fachada amarilla de La Palmera con el rótulo de pan y frutos secos, el toldo de panadería y el escaparate"
						widths={[420, 640, 900]}
						sizes="(max-width: 980px) 92vw, 44vw"
						format="avif"
						quality={68}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					<span class="hero-badge"><span aria-hidden="true">10</span> fotos en la ficha</span>
					<figcaption class="hero-caption">
						La fachada en Alfonso XIII. Foto de la galería de Google Maps.
					</figcaption>
				</figure>
			</section>

			<LocalChips label="Lo que consta en la ficha" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una tienda de barrio <br /><em>con tres oficios.</em>"
				paragraphs={[
					'La fachada lo dice sin rodeos: «La Palmera · Pan» y «Frutos secos» en el rótulo grande, y un letrero lateral con panadería, confitería y golosinas. Google la clasifica con tres categorías a la vez: tienda de alimentación, panadería y pastelería.',
					'Está en la calle Alfonso XIII, en pleno Centro de Córdoba (14001), en un local amarillo con toldo y escaparate a la calle. La ficha no publica número de portal, así que esta web no lo inventa: el mapa abre el punto exacto que da Google.',
					'El horario es partido y de barrio: de lunes a viernes abre a las 9:15, cierra a las 15:00 y vuelve de 18:00 a 21:00; el sábado solo hay mañana y el domingo cierra. No es una panadería de madrugada, sino una tienda que acompaña el día.',
					'Las fotos de la ficha enseñan qué hay: empanadillas de York y queso y de atún y tomate, bollería bañada en chocolate, donuts, napolitanas, tartas de sésamo y galletas con nueces, además de las estanterías de snacks y bebidas. No hay carta ni precios publicados.',
				]}
				note="No hay web propia, carta ni precios en la ficha. Para saber qué queda a última hora, si hay encargos o si abren en festivo, lo más rápido es llamar al 676 98 62 47."
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas de la casa</p>
						<h2 id="three-title">El rótulo, la tarde <br /><em>y el Centro.</em></h2>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos"
				title="La vitrina <br /><em>y el dulce.</em>"
				description="Siete de las diez fotos de la ficha: la fachada en la portada y aquí seis de mostrador, con empanadillas, bollería de chocolate, donuts, tarta de sésamo, galletas y una torta plana."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026. La ficha tiene diez fotos; las otras tres se han dejado fuera por tener personas identificables en el encuadre."
			/>

			<section class="rating-band" aria-labelledby="rating-title">
				<div class="wrap rating-inner">
					<div class="rating-score">
						<strong>3,7</strong>
						<div>
							<span class="rating-stars" role="img" aria-label="3,7 de 5 estrellas">3,7 / 5</span>
							<p id="rating-title" style="margin:0;font-size:.75rem">12 reseñas en Google Maps</p>
						</div>
					</div>
					<p class="rating-copy">
						La media de la ficha es 3,7 sobre 5 con 12 reseñas, con opiniones variadas.
						Esta página no selecciona ni reproduce sus textos: se leen todas en Google.
					</p>
					<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
						Leer las 12 reseñas en Google ↗
					</a>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En el Centro <br /><em>de Córdoba.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de la Panadería-Confitería La Palmera en la calle Alfonso XIII, Córdoba"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Palmera · Centro"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phone, href: BUSINESS.phoneHref }}
				reserveNote="La ficha de Google no publica número de portal, carta ni precios, y de accesibilidad solo indica acceso para sillas de ruedas y ausencia de aparcamiento adaptado. Esta página no gestiona pedidos ni encargos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. La ficha no publica número de portal, carta ni precios. Horario y disponibilidad pueden cambiar; confírmalos por teléfono antes de ir."
			ctaLabel="Llamar a La Palmera"
			navAriaLabel="Enlaces de Panadería-Confitería La Palmera"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
