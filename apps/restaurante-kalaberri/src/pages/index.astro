---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/restaurante-kalaberri-apaisada-01.jpg';
import pescado from '../assets/fotos/restaurante-kalaberri-vertical-02.jpg';
import pintxos from '../assets/fotos/restaurante-kalaberri-apaisada-03.jpg';
import entrecot from '../assets/fotos/restaurante-kalaberri-apaisada-04.jpg';
import logo from '../assets/fotos/restaurante-kalaberri-apaisada-05.jpg';
import chuleton from '../assets/fotos/restaurante-kalaberri-apaisada-06.jpg';
import entrada from '../assets/fotos/restaurante-kalaberri-vertical-07.jpg';
import ensalada from '../assets/fotos/restaurante-kalaberri-vertical-08.jpg';
import revuelto from '../assets/fotos/restaurante-kalaberri-vertical-09.jpg';
import pulpo from '../assets/fotos/restaurante-kalaberri-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Restaurante Kalaberri, cocina vasca en Matia Kalea, 50, de Donostia: pintxos, raciones, pescado y brasa. Abierto todos los días desde las 11:00. Tel. 943 12 62 18.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de Restaurante Kalaberri en Matia Kalea, 50, con el toldo negro y el pez blanco del rótulo',
	},
	{
		src: pulpo,
		alt: 'Pulpo a la brasa sobre puré de patata con pimentón en Restaurante Kalaberri',
	},
	{
		src: pintxos,
		alt: 'Pintxos de pescado rebozado sobre pan con pimiento y perejil en Kalaberri',
	},
	{
		src: pescado,
		alt: 'Pescado al horno con patatas en rodajas, ajo y perejil en Restaurante Kalaberri',
	},
	{
		src: entrada,
		alt: 'Entrada de Kalaberri con el rótulo sobre la puerta de madera negra y clientes dentro',
	},
	{
		src: chuleton,
		alt: 'Chuletón a la brasa con patatas y pimientos asados en Restaurante Kalaberri',
	},
	{
		src: revuelto,
		alt: 'Revuelto de hongos con pan tostado y un plato de setas salteadas al fondo en Kalaberri',
	},
	{
		src: ensalada,
		alt: 'Ensalada con queso de cabra a la plancha, frutos secos y vinagre de Módena en Kalaberri',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la brasa con patatas fritas y ensalada en Restaurante Kalaberri',
	},
	{
		src: logo,
		alt: 'Tarjeta con el logotipo de Kalaberri, la dirección matia 50, antigua y el pez blanco',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#kalaberri`,
	name: BUSINESS.name,
	alternateName: ['Kalaberri', 'Kalaberri Donostia', 'Restaurante Kalaberri Donostia'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 943 12 62 18',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Vasca', 'Española', 'Pintxos'],
	areaServed: [
		{ '@type': 'City', name: 'Donostia / San Sebastián' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday'],
			opens: '11:00',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday'],
			opens: '11:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday'],
			opens: '11:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '11:00',
			closes: '01:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '11:00',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Los pintxos y raciones deliciosos, y los platos de pescado exquisitos.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Pedimos revuelto de hongos, pulpo, y cordero a la brasa.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Ensalada de burrata, carrilleras, entrecot y revuelto de setas.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Kalaberri · Restaurante vasco en Donostia';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f4e5f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Kalaberri Donostia, Restaurante Kalaberri, restaurante vasco Donostia, pintxos Donostia, comer en San Sebastián, Matia Kalea 50, raciones Donostia, pescado Donostia, Donostia Gros"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Kalaberri · Restaurante vasco en Donostia"
			ogDescription="Pintxos, raciones, bocadillos y platos de pescado en Matia Kalea, 50 (Donostia). Abierto todos los días desde las 11:00. Tel. 943 12 62 18."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Restaurante Kalaberri con el toldo negro en Matia Kalea, Donostia"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1f4e5f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34943126218"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Kalaberri"
			subtitle="Restaurante vasco · Donostia"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Matia Kalea, 50 · Donostia"
				title="Pintxos, pescado<br /><em>y brasa.</em>"
				lede={`Restaurante Kalaberri es un restaurante vasco en Matia Kalea, 50, de Donostia / San Sebastián (Gipuzkoa). Pintxos, raciones, bocadillos y platos de pescado, con brasa y guisos, en un local con puerta de madera negra y el pez blanco por bandera. Abre todos los días a las 11:00. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={fachada}
				imageAlt="Fachada de Restaurante Kalaberri en Matia Kalea con el toldo negro y el rótulo del pez"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)`,
					},
					{ label: 'Horario', html: 'Todos los días · desde las 11:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phoneDisplay}</b>` },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Restaurante Kalaberri" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un vasco<br /><em>en Matia.</em>"
				paragraphs={[
					'Restaurante Kalaberri está en Matia Kalea, 50, de Donostia / San Sebastián (Gipuzkoa). Google lo clasifica como restaurante vasco y lo describe así: «carta deliciosa: pintxos, raciones, bocadillos y buena música».',
					'La fachada es de piedra, con un toldo negro, el pez blanco de Kalaberri y el rótulo «KALABERRI antigua» sobre la puerta de madera negra con cristales. Delante, una calle con árboles; dentro, luz cálida y clientes junto a la entrada.',
					'Su ficha reúne 361 reseñas y una nota media de 4,7 sobre 5. Las reseñas hablan de pintxos y raciones, de platos de pescado «exquisitos», de pulpo, cordero a la brasa, carrilleras, entrecot, revuelto de hongos y ensalada de burrata.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «los pintxos y raciones deliciosos, y los platos de pescado exquisitos».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="De la barra<br /><em>y de la cocina.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que anuncia su descripción, lo que citan sus reseñas y lo que aparece en sus fotos."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La carta cambia a diario y los precios no están publicados en la ficha. Llama al 943 12 62 18 para saber qué hay hoy y si queda mesa."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El toldo,<br /><em>la barra y el pulpo.</em>"
				description="Estas fotografías proceden del perfil de Restaurante Kalaberri en Google Maps: la fachada con el toldo negro, la entrada, los pintxos de pescado, el pulpo, el pescado al horno, las carnes a la brasa, el revuelto de hongos y la ensalada con queso de cabra."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en la barra.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: todos los días desde las 11:00. Cierra a las 23:00 el martes, a las 23:30 el lunes, a las 24:00 miércoles y jueves, a la 1:30 viernes y sábado, y a las 16:00 el domingo."
				mapTitle="Mapa de Restaurante Kalaberri en Matia Kalea, 50, Donostia / San Sebastián (Gipuzkoa)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Restaurante Kalaberri · Donostia"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva llamando al 943 12 62 18. La ficha de Google marca acceso para sillas de ruedas y asientos adaptados; no marca aparcamiento adaptado. Está en Matia Kalea, 50, de Donostia."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Kalaberri"
		/>
	</body>
</html>
