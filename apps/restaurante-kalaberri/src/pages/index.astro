---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
	} from '@astro-components';

import fachada from '../assets/fotos/restaurante-kalaberri-apaisada-01.jpg';
import pescado from '../assets/fotos/restaurante-kalaberri-vertical-02.jpg';
import pintxos from '../assets/fotos/restaurante-kalaberri-apaisada-03.jpg';
import entrecot from '../assets/fotos/restaurante-kalaberri-apaisada-04.jpg';
import logo from '../assets/fotos/restaurante-kalaberri-apaisada-05.jpg';
import chuleton from '../assets/fotos/restaurante-kalaberri-apaisada-06.jpg';
import entrada from '../assets/fotos/restaurante-kalaberri-vertical-07.jpg';
import ensalada from '../assets/fotos/restaurante-kalaberri-vertical-08.jpg';
import revuelto from '../assets/fotos/restaurante-kalaberri-vertical-09.jpg';
import pulpo from '../assets/fotos/restaurante-kalaberri-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
	REVIEWS
} from '../data/site';

const description =
	'Restaurante Kalaberri, cocina vasca en Matia Kalea, 50, de Donostia: pintxos, raciones, pescado y brasa. Abierto todos los días desde las 11:00. Tel. 943 12 62 18.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de Restaurante Kalaberri en Matia Kalea, 50, con el toldo negro y el pez blanco del rótulo',
	},
	{
		src: pulpo,
		alt: 'Pulpo a la brasa sobre puré de patata con pimentón en Restaurante Kalaberri',
	},
	{
		src: pintxos,
		alt: 'Pintxos de pescado rebozado sobre pan con pimiento y perejil en Kalaberri',
	},
	{
		src: pescado,
		alt: 'Pescado al horno con patatas en rodajas, ajo y perejil en Restaurante Kalaberri',
	},
	{
		src: entrada,
		alt: 'Entrada de Kalaberri con el rótulo sobre la puerta de madera negra y clientes dentro',
	},
	{
		src: chuleton,
		alt: 'Chuletón a la brasa con patatas y pimientos asados en Restaurante Kalaberri',
	},
	{
		src: revuelto,
		alt: 'Revuelto de hongos con pan tostado y un plato de setas salteadas al fondo en Kalaberri',
	},
	{
		src: ensalada,
		alt: 'Ensalada con queso de cabra a la plancha, frutos secos y vinagre de Módena en Kalaberri',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la brasa con patatas fritas y ensalada en Restaurante Kalaberri',
	},
	{
		src: logo,
		alt: 'Tarjeta con el logotipo de Kalaberri, la dirección matia 50, antigua y el pez blanco',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#kalaberri`,
	name: BUSINESS.name,
	alternateName: ['Kalaberri', 'Kalaberri Donostia', 'Restaurante Kalaberri Donostia'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 943 12 62 18',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Vasca', 'Española', 'Pintxos'],
	areaServed: [
		{ '@type': 'City', name: 'Donostia / San Sebastián' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday'],
			opens: '11:00',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday'],
			opens: '11:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday'],
			opens: '11:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '11:00',
			closes: '01:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '11:00',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Los pintxos y raciones deliciosos, y los platos de pescado exquisitos.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Pedimos revuelto de hongos, pulpo, y cordero a la brasa.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Ensalada de burrata, carrilleras, entrecot y revuelto de setas.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Kalaberri · Restaurante vasco en Donostia';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-kalaberri-apaisada-01.jpg": fachada,
	"restaurante-kalaberri-vertical-10.jpg": pulpo,
	"restaurante-kalaberri-apaisada-03.jpg": pintxos,
	"restaurante-kalaberri-vertical-02.jpg": pescado,
	"restaurante-kalaberri-vertical-07.jpg": entrada,
	"restaurante-kalaberri-apaisada-06.jpg": chuleton,
	"restaurante-kalaberri-vertical-09.jpg": revuelto,
	"restaurante-kalaberri-vertical-08.jpg": ensalada,
	"restaurante-kalaberri-apaisada-04.jpg": entrecot,
	"restaurante-kalaberri-apaisada-05.jpg": logo,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f4e5f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Kalaberri Donostia, Restaurante Kalaberri, restaurante vasco Donostia, pintxos Donostia, comer en San Sebastián, Matia Kalea 50, raciones Donostia, pescado Donostia, Donostia Gros"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Kalaberri · Restaurante vasco en Donostia"
			ogDescription="Pintxos, raciones, bocadillos y platos de pescado en Matia Kalea, 50 (Donostia). Abierto todos los días desde las 11:00. Tel. 943 12 62 18."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Restaurante Kalaberri con el toldo negro en Matia Kalea, Donostia"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1f4e5f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34943126218"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Kalaberri"
			subtitle="Restaurante vasco · Donostia"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
				reviews={REVIEWS}
				googleMaps={MAPS.place}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Kalaberri"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34943126218?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Donostia%20%2F%20San%20Sebasti%C3%A1n." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Donostia / San Sebastián"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
