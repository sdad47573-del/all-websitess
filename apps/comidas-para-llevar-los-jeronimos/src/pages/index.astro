---
import { Image } from 'astro:assets';
import foto02 from '../assets/fotos/comidas-para-llevar-los-jeronimos-apaisada-02.jpg';
import foto03 from '../assets/fotos/comidas-para-llevar-los-jeronimos-apaisada-03.jpg';
import foto07 from '../assets/fotos/comidas-para-llevar-los-jeronimos-apaisada-07.jpg';
import foto09 from '../assets/fotos/comidas-para-llevar-los-jeronimos-apaisada-09.jpg';
import foto10 from '../assets/fotos/comidas-para-llevar-los-jeronimos-apaisada-10.jpg';
import foto04 from '../assets/fotos/comidas-para-llevar-los-jeronimos-vertical-04.jpg';
import foto05 from '../assets/fotos/comidas-para-llevar-los-jeronimos-vertical-05.jpg';
import foto06 from '../assets/fotos/comidas-para-llevar-los-jeronimos-vertical-06.jpg';
import foto08 from '../assets/fotos/comidas-para-llevar-los-jeronimos-vertical-08.jpg';
import foto01 from '../assets/fotos/comidas-para-llevar-los-jeronimos-vista-1-01.jpg';

const fotos = [foto01, foto02, foto03, foto04, foto05, foto06, foto07, foto08, foto09, foto10];

const MAPS_URL =
	'https://www.google.com/maps/place/Comidas+para+llevar+y+pollos+Asados+Los+Jer%C3%B3nimos/@37.9970224,-1.175743,17z/data=!3m1!4b1!4m6!3m5!1s0xd63804b0662f2af:0xdd280dc7a38de451!8m2!3d37.9970224!4d-1.175743!16s%2Fg%2F11g9fmqdpt?authuser=0&hl=es&entry=ttu';
const CREDIT_URL = 'https://sur-digital.vercel.app/';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Los Jerónimos</title>
		<meta name="description" content="Comidas para llevar y pollos asados Los Jerónimos." />
	</head>
	<body>
		<header>
			<h1 set:html={piezas.portada.titulo} />
			<p>Comidas para llevar y pollos asados</p>
			<a href={MAPS_URL} rel="noopener" target="_blank">Ver en Google Maps</a>
		</header>

		<main>
			<section class="galeria">
				{fotos.map((foto) => <Image src={foto} alt="Los Jerónimos" loading="lazy" />)}
			</section>
		</main>

		<footer>
			<p>
				Creado por <a href={CREDIT_URL} rel="noopener">Sur Digital</a> · sur-digital.vercel.app
			</p>
		</footer>
	</body>
</html>
