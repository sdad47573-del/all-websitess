---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES } from '../data/site';

const datos = [
	{ icon: 'ri-map-pin-line', label: 'Dirección', value: `${BUSINESS.street}, ${BUSINESS.postalCode} ${BUSINESS.city}` },
	{ icon: 'ri-time-line', label: 'Horario', value: 'Mar–sáb 11:30–16:30 y 19:30–23:30 · Dom hasta las 24:00' },
	{ icon: 'ri-phone-line', label: 'Teléfono', value: BUSINESS.phone },
	{ icon: 'ri-wheelchair-line', label: 'Accesibilidad', value: 'Entrada y asientos adaptados' },
];
---

<section id="casa" class="bg-base-100 scroll-mt-20 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid items-center gap-14 lg:grid-cols-[0.95fr_1.05fr]">
			<figure class="relative">
				<div class="overflow-hidden rounded-lg shadow-2xl">
					<Image
						src={IMAGES.fotoInterior}
						alt="Interior de Restaurante Dos Caridad"
						widths={[600, 1000]}
						sizes="(min-width: 1024px) 44vw, 92vw"
						quality={85}
						loading="lazy"
						class="foto-calida aspect-[4/5] w-full object-cover"
					/>
				</div>
				<div class="border-base-300 bg-base-100 absolute -right-3 -bottom-6 max-w-[14rem] rounded-lg border p-5 shadow-xl sm:-right-6">
					<p class="text-secondary text-[0.65rem] font-bold tracking-[0.18em] uppercase">La casa</p>
					<p class="font-display mt-1 text-2xl leading-tight font-semibold">
						Fritura, guisos y retinto
					</p>
				</div>
			</figure>

			<div>
				<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">La casa</span>
				<h2 class="font-display mt-3 text-4xl font-semibold sm:text-5xl">
					La cocina de siempre, con algún añadido
				</h2>
				<div class="bg-secondary mt-5 h-0.5 w-24"></div>
				<p class="text-base-content/75 mt-6 leading-relaxed">
					Dos Caridad es un restaurante de Sanlúcar de Barrameda con la fritura y el pescado
					como bandera. En su ficha, el propio local cuenta que a las frituras, los guisos de
					pescado y los pescados de piedra a la pancha se han sumado la carne de retinto D.O. y
					la presa de bellota.
				</p>
				<p class="text-base-content/75 mt-4 leading-relaxed">
					También hay elaboración propia: hamburguesa de corvina y langostinos, albóndigas de
					choco y gambas. La carta completa y los precios se consultan en el restaurante.
				</p>

				<ul class="mt-8 divide-y divide-base-300 border-y border-base-300">
					{
						datos.map((dato) => (
							<li class="flex gap-4 py-3.5">
								<span class="text-secondary mt-0.5 shrink-0">
									<i class={`${dato.icon} text-lg`} />
								</span>
								<div>
									<p class="text-base-content/50 text-[0.65rem] font-semibold tracking-[0.16em] uppercase">
										{dato.label}
									</p>
									<p class="mt-0.5 text-sm font-semibold">{dato.value}</p>
								</div>
							</li>
						))
					}
				</ul>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-primary gap-2 rounded-full">
						<i class="ri-phone-line"></i> Llamar al restaurante
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline gap-2 rounded-full"
					>
						<i class="ri-map-pin-line"></i> Cómo llegar
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
