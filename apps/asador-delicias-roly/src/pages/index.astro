---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/asador-delicias-roly-apaisada-01.jpg';
import asador from '../assets/fotos/asador-delicias-roly-vertical-02.jpg';
import albondigas from '../assets/fotos/asador-delicias-roly-vertical-04.jpg';
import paella from '../assets/fotos/asador-delicias-roly-vertical-05.jpg';
import vitrina from '../assets/fotos/asador-delicias-roly-vertical-06.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Asador Delicias roly · Pollo asado en Carabanchel';
const description =
	'Asador Delicias roly, en C. Baleares, 49 (Carabanchel, 28019 Madrid). Pollo asado, guisos y comida casera para llevar. Todos los días de 10:00 a 16:00.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada roja de Asador Delicias roly con ladrillos amarillos pintados y el toldo morado de comidas caseras',
	},
	{
		src: asador,
		alt: 'El asador de Asador Delicias roly con varias filas de pollos dorándose',
	},
	{
		src: albondigas,
		alt: 'Un plato de albóndigas en salsa con la tarjeta de Asador Delicias roly, calle Baleares 49',
	},
	{
		src: paella,
		alt: 'Una paella de marisco con gambas, mejillones y trozos de pollo en la paellera',
	},
	{
		src: vitrina,
		alt: 'La vitrina de Asador Delicias roly con bandejas de guisos, ensalada de pollo y etiquetas de precios',
	},
];

const precioNumerico = (price) => price?.replace(/[^\d,]/g, '').replace(',', '.');

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Asador Delicias roly',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: precioNumerico(item.price),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#asador-delicias-roly`,
	name: BUSINESS.fullName,
	alternateName: ['Delicias roly', 'Asador Delicias Roly Madrid', 'Comidas caseras Delicias Roly'],
	description:
		'Asador de pollos y comida casera para llevar en la calle Baleares, 49 (Carabanchel, 28019 Madrid). Pollo asado, guisos, arroces y ensaladas de la vitrina.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34915652434',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Comida casera', 'Guisos', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Carabanchel' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#3b1a2e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador Delicias roly, pollo asado Carabanchel, comida casera Baleares 49, asador de pollos Madrid, comida para llevar 28019, guisos Carabanchel"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado, guisos y comida casera para llevar en Baleares, 49, Carabanchel. Todos los días de 10:00 a 16:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="El asador de Asador Delicias roly con filas de pollos dorándose"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#3b1a2e"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Carabanchel"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Delicias roly"
			subtitle="Asador · Carabanchel"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Baleares, 49 · Carabanchel, Madrid"
				title="La casa roja <br /><em>del pollo asado.</em>"
				lede={`Asador Delicias roly es una casa de comidas en Baleares 49, en Carabanchel. En el asador se doran los pollos y en la vitrina esperan los guisos del día: callos, albóndigas, muslitos en pepitoria, macarrones y ensaladas. Abre todos los días de 10:00 a 16:00 y tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={fachada}
				imageAlt="La fachada roja de Asador Delicias roly con ladrillos amarillos pintados y el toldo morado de comidas caseras"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>10:00–16:00</b> · todos los días' },
					{ label: 'Servicio', html: '<b>Para llevar</b> · comida casera' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Pollo asado"
			/>

			<LocalChips label="Lo que ofrece Asador Delicias roly" items={SERVICIOS} />

			<LocalAbout
				label="El local"
				title="Rojo, amarillo <br /><em>y a la vista.</em>"
				paragraphs={[
					'Asador Delicias roly ocupa el bajo de la calle Baleares, 49, en Carabanchel. La fachada está pintada de rojo y salpicada de ladrillos amarillos; el toldo morado anuncia «Comidas caseras Delicias Roly» y la puerta abierta deja ver el asador y la vitrina.',
					'En el asador se apilan los pollos ensartados, dorándose a la vista. En la vitrina, las bandejas llevan etiquetas escritas a mano: crema de verdura, callos con garbanzos, albóndigas de ternera, muslitos en pepitoria, macarrones a la bolonesa, bacalao con tomate y ensalada de pollo.',
					'La ficha de Google lo describe como «asador de pollos y comida caseras» y explica que cocinan platos caseros a diario para llevar. No publica una carta, un menú del día ni una web propia: el teléfono 915 65 24 34 es el único canal que aparece.',
					`Los vecinos lo puntúan con ${RATING.label} sobre 5 en ${RATING.count} reseñas. «Pedimos un pollo y croquetas y nos encantó todo y además es económico», cuenta una; «tanto mis padres como yo llevamos años yendo y la comida siempre está exquisita», resume otra.`,
				]}
				note="La ficha no publica precios del asador, una carta completa ni las condiciones de ningún reparto. Los platos y precios de esta página son los de las etiquetas de la vitrina que aparecen en las fotos del perfil de Google, consultadas en octubre de 2026. El surtido cambia: confírmalo por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que sale del asador</p>
					<h2 id="highlights-title">El asador, la vitrina <br /><em>y la casa.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La comida"
				title="Lo que hay <br /><em>en la vitrina.</em>"
				description="La ficha de Google no publica una carta. Esta lista sale de las etiquetas de la vitrina y de las fotos del perfil: el asador, los guisos, los arroces y las ensaladas."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Precios vistos en las etiquetas de la vitrina en las fotos del perfil de Google (octubre de 2026). Las etiquetas no indican peso ni tamaño de ración. La ficha no publica el precio del pollo asado ni un menú del día. Confirma disponibilidad y precio por teléfono."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La fachada, el asador <br /><em>y la vitrina.</em>"
				description="Cinco de las fotografías del perfil de Asador Delicias roly en Google Maps: la fachada roja, los pollos en el asador, las albóndigas, la paella y la vitrina con sus etiquetas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,9 sobre 5, <em>con 167 reseñas.</em></h2>
						<p>
							Google publica una media de 4,9 con 167 opiniones (octubre de 2026). Las reseñas
							que se ven aquí elogian el pollo, las croquetas, el precio y la constancia de la
							casa. Son las que destaca la ficha; hay muchas más opiniones en Google.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,9</strong>
						<span>★★★★★</span>
						<small>167 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En Carabanchel, <br /><em>Baleares 49.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de 10:00 a 16:00 todos los días. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Asador Delicias roly en la calle Baleares, 49, Carabanchel, Madrid"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Baleares, 49 · Carabanchel"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos y consultas por teléfono: la ficha no publica reservas, pedidos online ni reparto a domicilio. Del local solo consta que no hay aparcamiento adaptado, así que no se puede confirmar la accesibilidad."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>llamar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma menú, precios y horario antes de la visita."
			ctaLabel="Llamar a Asador Delicias roly"
			navAriaLabel="Enlaces de Asador Delicias roly"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
