---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import fachada from '../assets/fotos/panaderia-pasteleria-suarez-vertical-01.jpg';
import entrada from '../assets/fotos/panaderia-pasteleria-suarez-vertical-03.jpg';
import bocadillos from '../assets/fotos/panaderia-pasteleria-suarez-vertical-04.jpg';
import cafes from '../assets/fotos/panaderia-pasteleria-suarez-apaisada-05.jpg';
import cafe from '../assets/fotos/panaderia-pasteleria-suarez-vertical-06.jpg';
import bocadillo from '../assets/fotos/panaderia-pasteleria-suarez-vertical-07.jpg';
import terraza from '../assets/fotos/panaderia-pasteleria-suarez-vertical-02.jpg';
import pizarra from '../assets/fotos/panaderia-pasteleria-suarez-vertical-08.jpg';
import interior from '../assets/fotos/panaderia-pasteleria-suarez-vertical-09.jpg';
import pizza from '../assets/fotos/panaderia-pasteleria-suarez-vertical-10.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HOURS, HOURS_NOTE, MAPS, MENU_GROUPS, RESENAS, SERVICIOS } from '../data/site';

const title = 'Panadería Pastelería Suárez · La Trinidad, Córdoba';
const description = BUSINESS.description;

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#suarez`,
	name: BUSINESS.name,
	alternateName: ['Panaderia Pasteleria Suarez', 'Suárez Córdoba', 'Panadería Suárez Trinidad'],
	description:
		'Panadería, pastelería y cafetería en la plaza de la Trinidad (14003 Córdoba): pan, bollería, dulces, paninis, pizzas, bocadillos y bebidas frías.',
	url: `${BUSINESS.siteUrl}/`,
	telephone: '+34664808751',
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Panadería', 'Pastelería', 'Cafetería'],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
		worstRating: 1,
	},
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:30',
			closes: '14:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '17:30',
			closes: '19:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '08:30',
			closes: '14:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#mostrador' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: entrada,
		alt: 'La entrada de Suárez con el toldo gris, el mural de fotos de bollería y la pizarra de precios junto a la puerta',
		caption: 'La entrada, con el mural de bollería',
		className: 'foto foto-wide',
		sizes: '(max-width: 900px) 92vw, 58vw',
		widths: [560, 800, 1120],
	},
	{
		src: bocadillos,
		alt: 'Dos mitades de bocadillo de jamón sobre un plato, con una lata de refresco y un bote de Catunambú al fondo',
		caption: 'Bocadillos recién hechos',
		className: 'foto',
		sizes: '(max-width: 900px) 92vw, 27vw',
		widths: [340, 520, 760],
	},
	{
		src: cafes,
		alt: 'Dos cafés con leche en tazas de Catunambú y dos platos con bocadillos tostados en una mesa blanca',
		caption: 'Café y bocadillos en la mesa',
		className: 'foto',
		sizes: '(max-width: 900px) 92vw, 27vw',
		widths: [340, 520, 760],
	},
	{
		src: cafe,
		alt: 'Un café solo en taza de Catunambú sobre la mesa de la terraza, a la luz del sol',
		caption: 'El café de Andalucía',
		className: 'foto',
		sizes: '(max-width: 900px) 92vw, 27vw',
		widths: [340, 520, 760],
	},
	{
		src: pizarra,
		alt: 'La terraza en la plaza con la sombrilla de Victoria y la pizarra de Catunambú con el desayuno de Suárez',
		caption: 'La terraza y la pizarra del desayuno',
		className: 'foto foto-wide',
		sizes: '(max-width: 900px) 92vw, 58vw',
		widths: [560, 800, 1120],
	},
	{
		src: bocadillo,
		alt: 'Un bocadillo tostado en un plato blanco sobre la mesa de la terraza',
		caption: 'Un bocadillo de la casa',
		className: 'foto',
		sizes: '(max-width: 900px) 92vw, 27vw',
		widths: [340, 520, 760],
	},
	{
		src: interior,
		alt: 'El interior del local con el cartel de Suárez en la pared, la vitrina de cristal y las cajas de pizza',
		caption: 'La vitrina y el cartel del local',
		className: 'foto',
		sizes: '(max-width: 900px) 92vw, 27vw',
		widths: [340, 520, 760],
	},
	{
		src: pizza,
		alt: 'Una porción de pizza con queso gratinado y tomate servida sobre un plato con servilleta',
		caption: 'Pizza por porciones',
		className: 'foto',
		sizes: '(max-width: 900px) 92vw, 27vw',
		widths: [340, 520, 760],
	},
	{
		src: terraza,
		alt: 'Mesas y sillas blancas del local junto al ventanal, con la zona de juegos al fondo',
		caption: 'Las mesas del local',
		className: 'foto',
		sizes: '(max-width: 900px) 92vw, 27vw',
		widths: [340, 520, 760],
	},
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#431a20" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Jost:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Pastelería Suárez Córdoba, panadería plaza de la Trinidad, cafetería Trinidad Córdoba, bocadillos Córdoba centro, paninis Trinidad, desayunos Córdoba 14003, panadería Suárez"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería, pastelería y cafetería en la plaza de la Trinidad. Bocadillos al momento, paninis, pizzas, dulces y bebidas frías. L–V 8:30–14:30 y 17:30–19:30; sábado mañana."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="El rótulo negro de Panadería Pastelería Suárez sobre la fachada de la plaza de la Trinidad"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#431a20"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Panadería Pastelería Suárez, inicio">
					<span class="brand-mark" aria-hidden="true">S</span>
					<span class="brand-name">
						Panadería Pastelería Suárez
						<small>La Trinidad · Córdoba</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-cta" href={BUSINESS.phoneHref}>
					{BUSINESS.phone} <span aria-hidden="true">↗</span>
				</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Plaza de la Trinidad · 14003 Córdoba</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-lede">
							Panadería, pastelería y cafetería en plena Trinidad. Bocadillos hechos al momento,
							paninis, pizzas, dulces y bebidas frías, con los precios de barrio que anuncia el
							propio local.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="button button-ghost" href="#mostrador">Ver el mostrador</a>
						</div>
						<dl class="hero-facts">
							<div>
								<dt>Abre</dt>
								<dd>8:30</dd>
							</div>
							<div>
								<dt>L–V hasta</dt>
								<dd>19:30</dd>
							</div>
							<div>
								<dt>Valoración</dt>
								<dd>3,8 · 20 reseñas</dd>
							</div>
						</dl>
					</div>

					<figure class="hero-media">
						<div class="hero-photo">
							<Image
								src={fachada}
								alt="La fachada de Panadería Pastelería Suárez en la plaza de la Trinidad, con el rótulo negro de panadería, croissantera y bocadillos y la pizarra de Catunambú en la puerta"
								widths={[480, 720, 1024, 1400]}
								sizes="(max-width: 900px) 92vw, 46vw"
								format="avif"
								quality={74}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</div>
						<figcaption>
							<span>Panadería, croissantera y bocadillos</span>
							<span>Foto de la ficha de Google</span>
						</figcaption>
						<span class="hero-seal" aria-hidden="true">
							<strong>3,8</strong>
							<small>20 reseñas<br />en Google</small>
						</span>
					</figure>
				</div>
			</section>

			<section class="chips-wrap wrap" aria-label="Lo que anuncia la casa">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<div class="about-grid">
					<div class="about-copy">
						<p class="section-label"><span aria-hidden="true"></span> La casa</p>
						<h2 id="about-title">Una panadería de plaza, <em>sin prisa.</em></h2>
						<p>
							Suárez está en la plaza de la Trinidad, en el Centro de Córdoba. El rótulo negro de
							la fachada anuncia lo que hay dentro: panadería, croissantera y bocadillos; la banda
							de arriba añade bebidas, paninis y dulces.
						</p>
						<p>
							En su ficha de Google el negocio se describe como «panadería, cafetería, bocadillos,
							dulces y bebidas frías (cerveza, vino, refrescos… etc)» y añade dos palabras:
							«Precios económicos». Es un local de barrio para desayunar, picar algo al mediodía o
							tomar un café con bollería.
						</p>
						<p>
							La galería enseña la fachada, la terraza con mesas y sombrilla, la vitrina del
							interior y los bocadillos recién hechos. También la pizarra con algunos precios, que
							es la única fuente de importes de esta página.
						</p>
						<div class="about-links">
							<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha en Google Maps <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href="#fotos">Ver las fotos</a>
						</div>
					</div>

					<figure class="about-media">
						<Image
							src={entrada}
							alt="La entrada del local con el toldo gris, el mural de fotos de croissants, donuts y bocadillos y la pizarra de precios junto a la puerta"
							widths={[400, 640, 900]}
							sizes="(max-width: 900px) 92vw, 40vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>La entrada y el mural de bollería</figcaption>
					</figure>
				</div>

				<ul class="highlights">
					{
						HIGHLIGHTS.map((item) => (
							<li>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section class="menu" id="mostrador" aria-labelledby="menu-title">
				<div class="wrap menu-grid">
					<div class="menu-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> El mostrador</p>
						<h2 id="menu-title">De la pizarra <em>al mostrador.</em></h2>
						<p class="menu-lede">
							La ficha no publica una carta oficial. Lo que sigue sale de su descripción, del
							rótulo, de la vitrina y de las pizarras que aparecen en las fotos de la galería.
						</p>

						<div class="menu-groups">
							{
								MENU_GROUPS.map((group) => (
									<div class="menu-group">
										<h3>{group.title}</h3>
										<ul>
											{group.items.map((item) => (
												<li>
													<strong>{item.name}</strong>
													<span>{item.note}</span>
												</li>
											))}
										</ul>
									</div>
								))
							}
						</div>

						<p class="menu-note">
							Los importes son los de las pizarras fotografiadas y pueden haber cambiado. Aquí no
							se puede comprar: los pedidos se hacen en el local o llamando al{' '}
							<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>.
						</p>
					</div>

					<figure class="menu-media">
						<Image
							src={cafes}
							alt="Dos cafés con leche en tazas de Catunambú y dos platos con bocadillos tostados sobre una mesa blanca"
							widths={[480, 720, 1000]}
							sizes="(max-width: 900px) 92vw, 45vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Café y bocadillos, en la mesa</figcaption>
					</figure>
				</div>
			</section>

			<section class="hours" id="horario" aria-labelledby="hours-title">
				<div class="wrap hours-grid">
					<div class="hours-copy">
						<p class="section-label"><span aria-hidden="true"></span> Horario</p>
						<h2 id="hours-title">Mañana y tarde, <em>de lunes a viernes.</em></h2>
						<p class="hours-lede">
							La ficha publica dos turnos entre semana, solo mañana el sábado y el domingo cerrado.
							Es el horario de una panadería de barrio: desayunos temprano y bollería por la tarde.
						</p>
						<p class="hours-note">
							<strong>Ojo con los festivos.</strong> {HOURS_NOTE}
						</p>
						<a class="hours-link" href={MAPS.place} target="_blank" rel="noreferrer">
							Comprobar en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>

					<div class="hours-table-wrap">
						<table class="hours-table">
							<caption class="visually-hidden">Horario publicado en la ficha de Google</caption>
							<tbody>
								{
									HOURS.map((row) => (
										<tr>
											<th scope="row">{row.day}</th>
											<td class:list={{ closed: 'closed' in row && row.closed }}>{row.value}</td>
										</tr>
									))
								}
							</tbody>
						</table>
						<p class="hours-foot">
							Horario publicado en la ficha pública de Google, consultada en octubre de 2026.
						</p>
					</div>
				</div>
			</section>

			<section class="fotos wrap" id="fotos" aria-labelledby="fotos-title">
				<div class="fotos-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Fotos</p>
						<h2 id="fotos-title">La Trinidad, <em>por dentro.</em></h2>
					</div>
					<p>
						Nueve fotos de la galería pública de Google Maps: la entrada, la terraza, el café, los
						bocadillos, la vitrina y la pizza por porciones.
					</p>
				</div>

				<div class="fotos-grid">
					{
						galeria.map((photo) => (
							<figure class={photo.className}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={photo.widths}
									sizes={photo.sizes}
									format="avif"
									quality={72}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>{photo.caption}</figcaption>
							</figure>
						))
					}
				</div>
			</section>

			<section class="rating" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">Tres y ocho, <em>con luces y sombras.</em></h2>
						<p>
							La ficha tiene 3,8 sobre 5 con 20 reseñas en el momento de consultarla (octubre de
							2026). Las opiniones buenas destacan los bocadillos hechos al momento y la variedad
							de bebidas; también hay alguna crítica con el cobro. Se reproducen las dos caras.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)}{' '}
											<small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<div class="rating-actions">
							<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
								Ver las reseñas en Google <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="rating-figure">
						<div class="rating-symbol" aria-hidden="true">
							<span class="rating-value">3,8</span>
							<span class="rating-stars">★★★☆☆</span>
						</div>
						<p class="rating-caption">
							valoración media<br />
							con 20 reseñas publicadas
						</p>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Dónde está</p>
					<h2 id="visit-title">En la plaza <em>de la Trinidad.</em></h2>
					<p class="address">
						{BUSINESS.street}<br />
						{BUSINESS.district}<br />
						{BUSINESS.postalCode} {BUSINESS.city}
					</p>

					<p class="visit-phone">
						<span>Teléfono</span>
						<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
					</p>

					<p class="hours-note">
						<strong>El teléfono es el que publica la ficha.</strong> No consta página web ni perfil
						social del negocio, así que esta página no enlaza ninguno.
					</p>

					<ul class="visit-list">
						<li>
							<span>Acceso</span>
							Google marca el acceso para sillas de ruedas.
						</li>
						<li>
							<span>Aparcamiento</span>
							La ficha indica que no hay aparcamiento adaptado.
						</li>
						<li>
							<span>Horario</span>
