---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import espetadas from '../assets/fotos/restaurante-das-marias-apaisada-02.jpg';
import carneGrelhada from '../assets/fotos/restaurante-das-marias-apaisada-03.jpg';
import sopa from '../assets/fotos/restaurante-das-marias-apaisada-07.jpg';
import peixe from '../assets/fotos/restaurante-das-marias-apaisada-09.jpg';
import sala from '../assets/fotos/restaurante-das-marias-vertical-01.jpg';
import chips from '../assets/fotos/restaurante-das-marias-vertical-04.jpg';
import carta from '../assets/fotos/restaurante-das-marias-vertical-08.jpg';
import sobremesas from '../assets/fotos/restaurante-das-marias-vista-5-05.jpg';
import edificio from '../assets/fotos/restaurante-das-marias-vista-6-06.jpg';
import carneBatata from '../assets/fotos/restaurante-das-marias-vista-10-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICOS,
} from '../data/site';

const title = 'Das Marias · Comida portuguesa perto do aeroporto, Lisboa';
const description =
	'Restaurante Das Marias, na Rua Cidade de Tete, 31, em Lisboa, perto do aeroporto. Prato do dia, grelhados, peixe e vegetariano, todos os dias ao almoço.';

const galeria = [
	{
		src: peixe,
		alt: 'Peixe grelhado com brócolos, batata a murro e limão num prato branco, sobre uma mesa posta',
	},
	{
		src: carta,
		alt: 'Carta verde do Restaurante Das Marias com o prato do dia, os grelhados, o peixe e os pratos vegetarianos',
	},
	{
		src: sala,
		alt: 'Sala do Das Marias com mesas de tampo escuro, cadeiras verdes, chão de mosaico e vitrine ao fundo',
	},
	{
		src: carneGrelhada,
		alt: 'Carne grelhada com batata frita, salada, limão e chouriço num prato de metal',
	},
	{
		src: sopa,
		alt: 'Tigela de sopa verde servida com azeitonas e um copo de vinho branco, sobre toalha de vime',
	},
	{
		src: carneBatata,
		alt: 'Carne de porco com batata e azeitonas pretas num prato branco, com coentros por cima',
	},
	{
		src: chips,
		alt: 'Travessa de metal com batata frita às rodelas e cebola caramelizada, com azeitonas e vinho ao lado',
	},
	{
		src: sobremesas,
		alt: 'Pudim com caramelo num prato e uma mousse de chocolate num copo de plástico',
	},
	{
		src: edificio,
		alt: 'Edifício branco e verde onde fica o Restaurante Das Marias, com o letreiro na fachada',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta do Restaurante Das Marias',
	inLanguage: 'pt-PT',
	url: `${BUSINESS.siteUrl}/#carta`,
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#das-marias`,
	name: 'Restaurante Das Marias',
	alternateName: ['Das Marias', 'Restaurante Das Marias Lisboa', 'Das Marias Encarnação'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 938 073 520',
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Cozinha portuguesa'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Distrito de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '09:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '18:00',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '15:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada acessível a pessoas em cadeiras de rodas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Lugares para pessoas em cadeiras de rodas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Estacionamento acessível a pessoas em cadeiras de rodas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-das-marias-apaisada-02.jpg": espetadas,
	"restaurante-das-marias-apaisada-09.jpg": peixe,
	"restaurante-das-marias-vertical-08.jpg": carta,
	"restaurante-das-marias-vertical-01.jpg": sala,
	"restaurante-das-marias-apaisada-03.jpg": carneGrelhada,
	"restaurante-das-marias-apaisada-07.jpg": sopa,
	"restaurante-das-marias-vista-10-10.jpg": carneBatata,
	"restaurante-das-marias-vertical-04.jpg": chips,
	"restaurante-das-marias-vista-5-05.jpg": sobremesas,
	"restaurante-das-marias-vista-6-06.jpg": edificio,
};
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#143b26" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name="Restaurante Das Marias"
			description={description}
			keywords="Restaurante Das Marias, Das Marias Lisboa, restaurante perto do aeroporto de Lisboa, comida portuguesa Encarnação, prato do dia Lisboa, grelhados Lisboa, Rua Cidade de Tete"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida tradicional portuguesa na Rua Cidade de Tete, 31, perto do aeroporto. Prato do dia por 9 €, grelhados, peixe e vegetariano."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Espetadas do Restaurante Das Marias com arroz e batata frita"
			ogImageWidth={1200}
			ogImageHeight={630}
			author="Restaurante Das Marias"
			themeColor="#143b26"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lisboa"
			locale="pt_PT"
			countryName="Portugal"
			preload={[espetadas]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Das Marias"
			subtitle="Comida portuguesa · Lisboa"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
				reviews={REVIEWS}
				googleMaps={MAPS.place}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Restaurante Das Marias"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografias do perfil do estabelecimento em Google Maps. Carta e preços da carta da casa; confirma horário e valores antes da visita."
			ctaLabel="Ligar ao Das Marias"
			navAriaLabel="Ligações do Das Marias"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/351938073520?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carta%20do%20Restaurante%20Das%20Marias." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carta do Restaurante Das Marias"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
