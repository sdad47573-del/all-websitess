---
import '../styles/global.css';
import { Image } from 'astro:assets';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import vitrina from '../assets/fotos/panaderia-confiteria-las-flores-apaisada-03.jpg';
import fachada from '../assets/fotos/panaderia-confiteria-las-flores-vertical-01.jpg';
import dulces from '../assets/fotos/panaderia-confiteria-las-flores-vertical-02.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const title = 'Panadería Confitería Las Flores · Dulces árabes en Málaga';
const description =
	'Panadería Confitería Las Flores, en la avenida de San Sebastián, 5 (Bailén-Miraflores, 29010 Málaga). Pan, confitería y dulces árabes todos los días, de 7:30 a 16:00 y de 17:00 a 21:15. Teléfono 952 61 20 89.';

const notas = [
	{
		src: fachada,
		alt: 'Fachada de Las Flores en la avenida de San Sebastián, con el rótulo negro de Panadería Confitería Dulces Árabes',
		caption: 'La fachada: el rótulo anuncia panadería, confitería y dulces árabes.',
	},
	{
		src: dulces,
		alt: 'Bandeja de dulces árabes en la vitrina, con medias lunas de almendra bañadas en miel y pastelillos verdes',
		caption: 'La bandeja de dulces árabes, en la vitrina del mostrador.',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#las-flores`,
	name: BUSINESS.name,
	alternateName: ['Las Flores', 'Panadería Las Flores Málaga', 'Confitería Las Flores'],
	description:
		'Panadería, confitería y dulces árabes en la avenida de San Sebastián, 5 (Bailén-Miraflores, 29010 Málaga). Abierta todos los días de 7:30 a 16:00 y de 17:00 a 21:15.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 952 61 20 89',
	currenciesAccepted: 'EUR',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '07:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '17:00',
			closes: '21:15',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'La vitrina', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#a3314b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400;1,9..144,600&family=Karla:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Confitería Las Flores Málaga, dulces árabes Bailén-Miraflores, pan avenida San Sebastián, confitería 29010, panadería abierta domingos Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan, confitería y dulces árabes en la avenida de San Sebastián, 5 (Bailén-Miraflores). Todos los días de 7:30 a 16:00 y de 17:00 a 21:15."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La vitrina de Las Flores, con bollería, pasteles y dulces árabes"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#a3314b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Las Flores"
			subtitle="Panadería · Confitería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<div class="band band-blush">
				<LocalHero
					eyebrow="Av. San Sebastián, 5 · Bailén-Miraflores, Málaga"
					title={piezas.portada.titulo}
					lede={`Las Flores está en la avenida de San Sebastián, 5, con un rótulo que anuncia «Panadería · Confitería · Dulces árabes». Abre los siete días, domingo incluido, de 7:30 a 16:00 y de 17:00 a 21:15. Tiene ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
					image={vitrina}
					imageAlt="La vitrina de Las Flores con bandejas de bollería, pasteles, tartaletas y dulces"
					primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
					facts={[
						{ label: 'Nota', html: '<b>3,9</b> en Google · 18 reseñas' },
						{ label: 'Horario', html: '<b>7:30–21:15</b> todos los días' },
						{ label: 'Barrio', html: '<b>Bailén-Miraflores</b>, Málaga' },
					]}
					galleryHref={MAPS.place}
					photoCredit="Foto del perfil de Google Maps"
					galleryLinkLabel="Ver la ficha"
					tag="Abierto también los domingos"
				/>

				<LocalChips label="Lo que ofrece Panadería Confitería Las Flores" items={SERVICIOS} />
			</div>

			<div class="band band-almond petal-top">
				<LocalAbout
					label="La casa"
					title="Una flor <br /><em>en San Sebastián.</em>"
					paragraphs={[
						'El local está en la avenida de San Sebastián, 5, en Bailén-Miraflores, con fachada de mármol claro y un rótulo negro en el que se lee «Panadería · Confitería · Dulces árabes» y, en grande, «Las Flores». Google la clasifica como panadería.',
						'La ficha de Google no incluye descripción del negocio ni web propia. Lo que sí publica es el horario: todos los días de la semana, domingo incluido, de 7:30 a 16:00 y de 17:00 a 21:15.',
						'Las reseñas hablan de pan y de dulces frescos. En la vitrina, las fotos del perfil enseñan bollería, porciones de tarta, tartaletas y una bandeja de dulces árabes de almendra bañados en miel.',
						'Esta página no publica carta ni precios: la ficha no los recoge. Solo se cuenta lo que consta en la ficha pública del establecimiento y en sus fotografías.',
					]}
					note="«Tiene el mejor pan del barrio y los dulces frescos», una reseña de 5 estrellas. La nota media es 3,9 sobre 5 con 18 reseñas: las opiniones completas, buenas y malas, están en la ficha."
					links={[
						{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
						{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					]}
				/>
			</div>

			<div class="band band-paper">
				<LocalMenu
					eyebrow="El mostrador"
					title="Pan, pasteles <br /><em>y almendra.</em>"
					description="La ficha no publica carta ni precios. Esto es lo que anuncian el rótulo del local, las reseñas de Google y la vitrina de las fotos."
					cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					groups={MENU}
					note="Sin precios publicados: el establecimiento no tiene web ni carta online en su ficha. Para saber qué hay cada día —y a qué precio—, lo mejor es llamar al 952 61 20 89 o pasarse por el mostrador."
				/>
			</div>

			<section class="band band-rose vitrina petal-top" id="galeria">
				<div class="wrap">
					<div class="vitrina-head">
						<div>
							<p class="section-label">
								<span aria-hidden="true"></span> La vitrina en Google Maps
							</p>
							<h2>
								La fachada <br />
								<em>y la bandeja.</em>
							</h2>
						</div>
						<div>
							<p>
								El perfil de Google tiene cinco fotos, pero tres son la misma imagen repetida con
								otro identificador. Quedan tres distintas: la vitrina que abre esta página, la
								fachada y esta bandeja de dulces árabes.
							</p>
							<a class="button button-primary" href={MAPS.place} target="_blank" rel="noreferrer">
								Ver la ficha en Google Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>

					<div class="vitrina-grid">
						{notas.map((nota) => (
							<figure class="vitrina-shot">
								<Image
									src={nota.src}
									alt={nota.alt}
									widths={[420, 640, 820, 1000]}
									sizes="(max-width: 780px) 92vw, 28rem"
									format="avif"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>{nota.caption}</figcaption>
							</figure>
						))}
					</div>

					<p class="vitrina-note">
						Imágenes alojadas en esta página y procedentes del perfil del establecimiento en Google
						Maps. Si el titular lo pide, se retiran.
					</p>
				</div>
			</section>

			<div class="band band-blush">
				<LocalVisit
					eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
					title="Todos los días, <br /><em>de sol a sol.</em>"
					addressLines={[
						BUSINESS.street,
						BUSINESS.district,
						`${BUSINESS.postalCode} ${BUSINESS.city}`,
					]}
					hours={HOURS}
					hoursCaption="Horario"
					hoursNote="Horario publicado en la ficha de Google: el mismo los siete días, con una pausa de una hora a mediodía. La propia ficha avisa de que el 1 de noviembre el horario podría ser diferente."
					mapTitle="Mapa de Panadería Confitería Las Flores en la avenida de San Sebastián, 5, Málaga"
					mapEmbedUrl={MAPS.embed}
					mapLabel="Las Flores · Bailén-Miraflores"
					mapHref={MAPS.place}
					links={[
						{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref, variant: 'primary' },
						{ label: 'Cómo llegar', href: MAPS.directions, external: true },
						{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					]}
					contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					reserveNote="No hay web propia ni pedidos online: se atiende en el mostrador y por teléfono. La ficha indica que el local tiene acceso para sillas de ruedas."
				/>
			</div>

			<div class="band band-almond">
				<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
			</div>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos y fotografías de la ficha pública de Google Maps. Sin carta ni precios publicados por el establecimiento."
			ctaLabel="Llamar a Las Flores"
			navAriaLabel="Enlaces de Panadería Confitería Las Flores"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
