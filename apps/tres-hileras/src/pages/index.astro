---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/tres-hileras-vertical-05.jpg';
import panes from '../assets/fotos/tres-hileras-apaisada-01.jpg';
import bolleria from '../assets/fotos/tres-hileras-vertical-02.jpg';
import pasteleria from '../assets/fotos/tres-hileras-vertical-03.jpg';
import mesa from '../assets/fotos/tres-hileras-vertical-06.jpg';
import terraza from '../assets/fotos/tres-hileras-vertical-08.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Tres Hileras · Panadería, pastelería y cafetería en Córdoba';
const description =
	'Tres Hileras, en la calle Manuel Cano «El Pireo», 1 (Poniente Sur, 14005 Córdoba). Panadería y pastelería artesanal con cafetería y amplia terraza. De lunes a viernes de 7:30 a 20:30 y fines de semana de 8:30 a 20:30.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#tres-hileras`,
	name: BUSINESS.name,
	alternateName: ['TresHileras', 'Panadería Tres Hileras', 'Pastelería Tres Hileras Córdoba'],
	description:
		'Panadería artesanal, pastelería artesanal y cafetería con amplia terraza en la calle Manuel Cano «El Pireo», 1 (Poniente Sur, 14005 Córdoba).',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34957914789',
	servesCuisine: ['Panadería', 'Pastelería', 'Cafetería'],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:30',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '08:30',
			closes: '20:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: panes,
		alt: 'Estanterías de Tres Hileras con panes artesanales de centeno, espelta, maíz y hogaza, con sus carteles',
	},
	{
		src: bolleria,
		alt: 'Vitrina de bollería con croissants, caracolas y napolitanas recién hechas',
	},
	{
		src: pasteleria,
		alt: 'Mostrador de pastelería con tartas, empanadas y napolitanas bañadas de chocolate',
	},
	{
		src: terraza,
		alt: 'Terraza de Tres Hileras con una tostada con aceite, café y zumo sobre la mesa al sol',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2b3a55" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..600;1,400..600&family=Source+Sans+3:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Tres Hileras, panadería Córdoba, pastelería Córdoba, cafetería Córdoba, terraza Córdoba, Manuel Cano El Pireo, Poniente Sur, 14005"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería y pastelería artesanal con cafetería y amplia terraza en Manuel Cano «El Pireo», 1 (14005 Córdoba). Abre todos los días de 7:30 a 20:30. 4,2 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Croissants y bollería recién hechos en la bandeja de Tres Hileras"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2b3a55"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Panadería · Pastelería · Cafetería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Poniente Sur · 14005 Córdoba"
				title="Tres Hileras, <br /><em>pan y terraza.</em>"
				lede={`En la esquina de la calle Manuel Cano «El Pireo», 1, hay un local con el rótulo «TresHileras» en la fachada y «PANADERÍA PASTELERÍA» sobre el escaparate. La ficha lo describe como «Panadería Artesanal, Pastelería Artesanal y Cafetería con amplia terraza». Abre todos los días de 7:30 a 20:30 —fines de semana desde las 8:30—, sin cerrar a mediodía. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={fachada}
				imageAlt="Fachada esquinera de Tres Hileras con el rótulo de la panadería y la placa de la calle Manuel Cano El Pireo"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,2</b> en Google · 246 reseñas' },
					{ label: 'Horario', html: '<b>Todos los días</b> hasta las 20:30' },
					{ label: 'Zona', html: '<b>Poniente Sur</b> · 14005' },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Pan · pastelería · cafetería"
			/>

			<LocalChips label="Lo que hay en Tres Hileras" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Del obrador <br /><em>a la terraza.</em>"
				paragraphs={[
					'Tres Hileras está en la esquina de la calle Manuel Cano «El Pireo», 1, en Poniente Sur (14005 Córdoba). La fachada de ladrillo y el rótulo de «TresHileras» con las tres espigas se ven desde la acera, y sobre el escaparate pone «PANADERÍA PASTELERÍA».',
					'Dentro hay estanterías de pan con carteles para cada pieza —centeno, espiga, maíz, hogaza artesana, integral con lino y avena—, una vitrina de bollería con croissants y caracolas, y un mostrador de pastelería con tartas, empanadas y napolitanas bañadas de chocolate.',
					'La ficha del negocio en Google lo resume así: «Panadería Artesanal, Pastelería Artesanal y Cafetería con amplia terraza». En las fotos del perfil se ven también las mesas del exterior, con tostadas con aceite, café y zumo.',
					'Las reseñas hablan del pan («deliciosos y variados panes artesanales, buen surtido de bollería») y del desayuno («pasamos ayer a desayunar y nos llevamos una grata sorpresa»). También hay alguna queja por el servicio: una clienta cuenta que estuvo más de 50 minutos sentada sin que le atendieran.',
				]}
				note="La ficha de Google publica la categoría, la dirección, el teléfono, el horario y la descripción del negocio, pero no carta, precios ni métodos de pago. El surtido que se describe aquí es el de esa descripción y el de las fotos del perfil."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Llamar al 957 91 47 89', href: BUSINESS.phoneHref },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Pan, pastelería <br />
							<em>y terraza.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Del pan <br /><em>al café.</em>"
				description="Sin precios publicados: esto es lo que anuncia la ficha del negocio y lo que muestran las fotos del perfil de Google."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={MENU_GROUPS}
				note="La ficha no publica carta ni precios, así que esta web no indica importes. Hay mostrador para llevar y mesas en el local y en la terraza."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La casa, <br /><em>por dentro.</em>"
				description="Cuatro fotos de la ficha de Google Maps: las estanterías de pan, la bollería, la pastelería y la terraza."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Manuel Cano <br /><em>«El Pireo».</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de Tres Hileras en la calle Manuel Cano El Pireo, Córdoba"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Tres Hileras · Poniente Sur"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
				]}
				contactLink={{ label: 'Abrir en Google Maps ↗', href: MAPS.place, external: true }}
				reserveNote="El teléfono de la ficha es el 957 91 47 89. No publica web propia ni redes. Indica acceso para sillas de ruedas, aseo adaptado y asientos adaptados; no hay aparcamiento accesible."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Ver en Google Maps"
			navAriaLabel="Enlaces de Tres Hileras"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
