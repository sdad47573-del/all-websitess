---
import '../styles/global.css';
import AvisoLegal from '../components/AvisoLegal.astro';
import { business, site } from '../data/site';
import { textos } from '../data/textos';

/** Aviso legal en español. La versión portuguesa vive en `/pt/aviso-legal/`. */
const lang = 'es' as const;
const t = textos[lang];

const url = `${site.siteUrl}/aviso-legal/`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#241a16" />
		<meta name="description" content={t.legal.description} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={url} />
		<link rel="alternate" hreflang="es" href={`${site.siteUrl}/aviso-legal/`} />
		<link rel="alternate" hreflang="pt" href={`${site.siteUrl}/pt/aviso-legal/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{t.legal.title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={t.locale} />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={t.legal.title} />
		<meta property="og:description" content={t.legal.description} />
		<meta property="og:url" content={url} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
	</head>
	<body>
		<AvisoLegal lang={lang} t={t} />
	</body>
</html>
