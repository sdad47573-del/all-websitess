---
/**
 * Cuerpo del aviso legal, escrito una sola vez para los dos idiomas.
 *
 * Las secciones (aviso legal, privacidad y cookies) y su texto vienen del diccionario del idioma; el
 * bloque del titular se compone aquí con los datos reales del negocio y con `LEGAL`, para que
 * rellenar el NIF o el correo en `site.ts` baste y no haya que tocar la plantilla.
 */
import { business, LEGAL, localeIntl, phoneHref, prefijo, site, type Idioma } from '../data/site';
import type { Textos } from '../data/textos';

type Props = { lang: Idioma; t: Textos };
const { lang, t } = Astro.props;

const actualizado = new Intl.DateTimeFormat(localeIntl(lang), { dateStyle: 'long' }).format(new Date());
const pendiente = [LEGAL.razonSocial, LEGAL.nif, LEGAL.email].some((valor) =>
	valor.includes('pendiente'),
);
const inicio = `${prefijo(lang)}/`;
const titular = [
	{ label: t.legal.titular.denominacion, valor: business.name },
	{ label: t.legal.titular.razonSocial, valor: LEGAL.razonSocial },
	{ label: t.legal.titular.nif, valor: LEGAL.nif },
	{ label: t.legal.titular.domicilio, valor: `${business.streetAddress}, ${business.city} (${business.countryName})` },
	{ label: t.legal.titular.telefono, valor: business.phone, enlace: phoneHref },
	{ label: t.legal.titular.email, valor: LEGAL.email },
];
---

<main class="legal">
	<nav aria-label={t.legal.migas}>
		<a href={inicio}>&larr; {t.legal.volver}</a>
	</nav>
	<h1>{t.legal.h1}</h1>
	<p class="sub">{t.legal.actualizado} {actualizado}</p>

	{pendiente && (
		<aside class="pendiente">
			<h2>{t.legal.pendienteTitulo}</h2>
			<p>{t.legal.pendiente}</p>
		</aside>
	)}

	{t.legal.secciones.map((seccion) => (
		<article id={seccion.id}>
			<h2>{seccion.titulo}</h2>
			{seccion.partes.map((parte) => (
				<>
					<h3>{parte.h3}</h3>
					{parte.titular && (
						<ul>
							{titular.map((dato) => (
								<li>
									<strong>{dato.label}:</strong>{' '}
									{dato.enlace ? <a href={dato.enlace}>{dato.valor}</a> : <em>{dato.valor}</em>}
								</li>
							))}
						</ul>
					)}
					{parte.titular && <p>{t.legal.titular.nota}</p>}
					{parte.p?.map((parrafo) => <p>{parrafo}</p>)}
					{parte.ul && (
						<ul>
							{parte.ul.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					)}
				</>
			))}
		</article>
	))}

	<p class="sub">
		{t.footer.nota} {site.consultado}.
	</p>
</main>
