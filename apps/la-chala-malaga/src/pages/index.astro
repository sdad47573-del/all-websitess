---
import '../styles/global.css';

const business = {
	name: 'La Chalá Málaga',
	legalName: 'LA CHALÁ MALAGA',
	street: 'Calle Edom, 4',
	district: 'Cruz de Humilladero',
	city: 'Málaga',
	postalCode: '29006',
	phone: '614 94 16 84',
	latitude: 36.7160728,
	longitude: -4.4390964,
	site: 'https://la-chala-malaga.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/LA+CHAL%C3%81+MALAGA/@36.7160728,-4.4390964,17z/data=!3m1!4b1!4m6!3m5!1s0xd72f72a9a9ce551:0xf45e83cfc8de32a9!8m2!3d36.7160728!4d-4.4390964!16s%2Fg%2F11l5m2lzr6';
const reviewsUrl = 'https://search.google.com/local/reviews?placeid=ChIJUeWcmir3cg0RqTLeyM-DXvQ';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34614941684';
const instagramUrl = 'https://www.instagram.com/la_chala_malaga/';

const photos = {
	principal: '/fotos/la-chala-malaga.jpg',
	calle: '/fotos/calle-edom-4-malaga-street-view.jpg',
};

const servicios = [
	'Desayunos desde las 8:00',
	'Menú del día',
	'Tapas y cocina fusión',
	'Copas y tardeo',
	'Pet friendly',
	'Aparcamiento gratis en la calle',
	'Apto para niños',
	'Eventos y celebraciones',
];

const carta = [
	{
		title: 'Picoteo y entrantes',
		text: 'Croquetas, ensaladilla rusa, quesadillas, gyozas, nachos gratinados y pulpo a la brasa para ir abriendo boca.',
	},
	{
		title: 'Fusión asiática y latina',
		text: 'Pan bao y bao de cochinita pibil, tacos mexicanos, tortilla de trufa y gazpachuelo de Fernando.',
	},
	{
		title: 'Desayunos',
		text: 'Café, zumos naturales, molletes y tostadas desde primera hora de la mañana, también para desayunar de forma económica.',
	},
	{
		title: 'Postres caseros',
		text: 'Coulant, tarta Lotus, tarta de queso con pistacho y tarta con piñones, entre los más pedidos.',
	},
];

const faqs = [
	{
		q: '¿Dónde está La Chalá Málaga?',
		a: 'En la calle Edom, 4, en el barrio de Cruz de Humilladero (29006 Málaga), junto a la zona de Carranque y a unos minutos en coche del centro histórico.',
	},
	{
		q: '¿Cuál es el horario de La Chalá?',
		a: 'Abre de martes a domingo y cierra los lunes. De martes a jueves y el domingo abre de 8:00 a 24:00; el viernes de 8:00 a 1:00 y el sábado de 9:00 a 1:00. El servicio es continuo, así que se puede desayunar, comer, cenar o tomar algo por la tarde.',
	},
	{
		q: '¿Hace falta reservar mesa?',
		a: 'No es obligatorio: se puede entrar sin reserva según disponibilidad. Si vais a ser un grupo o queréis mesa en fin de semana, lo más práctico es llamar antes al 614 94 16 84.',
	},
	{
		q: '¿Es un sitio pet friendly?',
		a: 'Sí, en La Chalá admiten mascotas, así que puedes venir con tu perro.',
	},
	{
		q: '¿Se puede ir con niños y aparcar?',
		a: 'Es un local familiar, con plaza amplia donde los peques pueden estar a su aire. Además hay aparcamiento gratuito en la calle y plazas libres con facilidad.',
	},
	{
		q: '¿Qué tipo de comida sirven?',
		a: 'Cocina fusión que mezcla recetas asiáticas y latinoamericanas con tapas clásicas: pan bao, tacos, gyozas, ensaladilla rusa, carnes y postres caseros. También tienen menú del día.',
	},
	{
		q: '¿Se puede celebrar un evento?',
		a: 'Sí, el local organiza celebraciones y eventos privados para grupos. Conviene contactar con antelación para organizar menú y espacio.',
	},
];

const description =
	'Bar restaurante en Cruz de Humilladero (Málaga): desayunos, menú del día, tapas de fusión asiática y latina, postres caseros y tardeo con música de los 80 y 90. En la calle Edom, 4. Teléfono 614 94 16 84.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: business.legalName,
	description,
	url: `${business.site}/`,
	telephone: '+34 614 94 16 84',
	image: [`${business.site}${photos.principal}`, `${business.site}${photos.calle}`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Fusión', 'Asiática', 'Latinoamericana', 'Tapas'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [instagramUrl],
	acceptsReservations: 'True',
	petsAllowed: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday'],
			opens: '08:00',
			closes: '00:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '08:00',
			closes: '01:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '09:00',
			closes: '01:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '09:00',
			closes: '00:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento gratuito en la calle', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Apto para niños', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Eventos y celebraciones', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Desayunos', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Menú del día', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#2b1b33" />
		<meta
			name="description"
			content="La Chalá Málaga: desayunos, menú del día, tapas de fusión y postres caseros en Cruz de Humilladero. C/ Edom, 4. Reservas: 614 94 16 84."
		/>
		<meta
			name="keywords"
			content="La Chalá Málaga, bar Cruz de Humilladero, restaurante C/ Edom Málaga, desayunos Málaga, menú del día Cruz de Humilladero, tapas fusión Málaga, pan bao Málaga, tardeo Málaga, copas Carranque, pet friendly Málaga"
		/>
		<meta name="author" content="La Chalá Málaga" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Outfit:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>La Chalá Málaga | Desayunos y menú del día en Cruz de Humilladero</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="La Chalá Málaga · Comer, tapear y tardeo en Cruz de Humilladero" />
		<meta
			property="og:description"
			content="Desayunos desde las 8:00, menú del día, tapas de fusión asiática y latina y postres caseros. Calle Edom, 4 (Málaga)."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.principal}`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="1600" />
		<meta property="og:image:alt" content="La Chalá Málaga, bar restaurante en Cruz de Humilladero" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="La Chalá Málaga · Comer, tapear y tardeo" />
		<meta
			name="twitter:description"
			content="Desayunos desde las 8:00, menú del día y tapas de fusión en la calle Edom, 4 (Málaga)."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.principal}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7160728;-4.4390964" />
		<meta name="ICBM" content="36.7160728, -4.4390964" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="La Chalá Málaga, inicio">
				<span class="brand-mark" aria-hidden="true">CH</span>
				<span class="brand-name">La Chalá <small>Málaga · Cruz de Humilladero</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">Carta</a>
				<a href="#ambiente">Ambiente</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>614 94 16 84</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Cruz de Humilladero · Málaga</p>
					<h1 id="hero-title">Asia, Latinoamérica<br />y música de los 80<br /><em>en la misma mesa.</em></h1>
					<p class="hero-lede">
						Bar restaurante en la calle Edom con desayunos desde las 8:00, menú del día, tapas de fusión,
						copas por la tarde y una decoración ecléctica que no deja indiferente. Pet friendly y con
						aparcamiento gratis en la calle.
					</p>
					<div class="hero-actions">
						<a class="button button-pink" href={phoneHref}>Llamar 614 94 16 84</a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<ul class="hero-facts">
						<li>Abierto de martes a domingo</li>
						<li>Desayunos, comidas y cenas</li>
						<li>Menú del día</li>
						<li>Tardeo y copas</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img
						src={photos.principal}
						width="1200"
						height="1600"
						alt="Fotografía de La Chalá Málaga publicada en su ficha de Google Maps"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Servicios del local">
				<ul class="chips">
					{servicios.map((servicio) => <li>{servicio}</li>)}
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> Un bar de barrio con carácter</p>
				<div class="about-grid">
					<h2>Desayuno, comida<br />y copa en<br /><em>el mismo sitio.</em></h2>
					<div class="about-copy">
						<p>
							La Chalá es un bar restaurante de la calle Edom, en Cruz de Humilladero, a un paso de
							Carranque. Abre de martes a domingo con servicio continuo: se puede empezar el día con un
							café, comer de menú, repetir por la tarde con unas tapas y quedarse cuando la música se
							enciende.
						</p>
						<p>
							Su cocina mezcla Asia y Latinoamérica con los clásicos de barra: pan bao, tacos, gyozas,
							ensaladilla rusa o pulpo a la brasa. Y de postre, caseros como el coulant o la tarta de
							queso con pistacho.
						</p>
						<p class="about-note">
							Lo que más se repite en las reseñas públicas: la decoración ecléctica, el ambiente festivo,
							el trato del equipo y las opciones de desayuno. También avisan de que, en las horas punta
							del tardeo, la música sube y el ritmo del servicio se resiente: si buscas una comida
							tranquila, mejor a mediodía.
						</p>
						<div class="about-links">
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">
								Instagram del local <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href={reviewsUrl} target="_blank" rel="noreferrer">
								Leer reseñas en Google <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="menu section-pad" id="carta">
				<div class="menu-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Para picar y compartir</p>
						<h2>Qué pedir<br />en <em>La Chalá.</em></h2>
					</div>
					<p>
						Platos que aparecen en la carta y en las reseñas públicas del local. La carta cambia y no se
						publican precios: confirma disponibilidad y sugerencias del día cuando llames o vayas.
					</p>
				</div>
				<div class="cards">
					{
						carta.map((bloque) => (
							<article class="card">
								<h3>{bloque.title}</h3>
								<p>{bloque.text}</p>
							</article>
						))
					}
				</div>
				<p class="menu-note">
					El local tiene menú del día y también sirve picoteo de bienvenida en algunas franjas, además de
					opciones para desayunar de forma económica.
				</p>
			</section>

			<section class="ambiente section-pad" id="ambiente">
				<div class="ambiente-grid">
					<div class="ambiente-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Decoración y música</p>
						<h2>Un sitio para<br /><em>quedarse un rato.</em></h2>
						<p>
							La decoración es lo más comentado por los clientes: un espacio ecléctico, con mezcla de
							vintage e industrial, detalles por todos lados, luz natural por los ventanales y una barra
							desde la que se ve trabajar a la cocina.
						</p>
						<p>
							Por la mañana y a mediodía el tono es tranquilo. Según avanza la tarde el local se
							transforma con música de los 70, 80 y 90 y se convierte en una parada del tardeo
							malagueño. También organiza eventos y celebraciones para grupos.
						</p>
						<p class="about-note">
							Para familias: las reseñas destacan la plaza amplia donde los niños pueden estar a su aire y
							la facilidad para aparcar en la calle.
						</p>
					</div>
					<figure class="ambiente-photo">
						<img
							src={photos.calle}
							width="1024"
							height="682"
							alt="Vista de la calle Edom, 4 en Málaga, donde se encuentra La Chalá (Google Street View)"
							loading="lazy"
							decoding="async"
						/>
						<figcaption>
							Vista de la calle Edom · Google Street View
							<a href={directionsUrl} target="_blank" rel="noreferrer">Abrir ruta ↗</a>
						</figcaption>
					</figure>
				</div>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow dark"><span aria-hidden="true"></span> Calle Edom, 4 · 29006 Málaga</p>
					<h2>Nos vemos<br /><em>en Cruz de Humilladero.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.district}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr><th scope="row">Martes a jueves</th><td>8:00 – 24:00</td></tr>
							<tr><th scope="row">Viernes</th><td>8:00 – 1:00</td></tr>
							<tr><th scope="row">Sábado</th><td>9:00 – 1:00</td></tr>
							<tr><th scope="row">Domingo</th><td>9:00 – 24:00</td></tr>
							<tr><th scope="row">Lunes</th><td>Cerrado</td></tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario orientativo según la ficha pública del local. Puede cambiar en festivos: una llamada
						evita sorpresas.
					</p>

					<div class="visit-links">
						<a class="button button-pink" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-outline" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 {business.phone}</a>
					<p class="reserve-note">
						Reservas por teléfono. No hace falta reservar para entrar, pero para grupos y fines de semana
						es lo más rápido.
					</p>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de La Chalá en la calle Edom, 4, Cruz de Humilladero, Málaga"
						src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> La Chalá Málaga
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">CH</span>
				<p>
					La Chalá Málaga
					<small>{business.street} · {business.postalCode} {business.city}</small>
				</p>
			</div>
			<nav aria-label="Enlaces del local">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={reviewsUrl} target="_blank" rel="noreferrer">Reseñas ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} La Chalá Málaga. Imágenes: ficha de Google Maps y Google Street View.
			</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
</footer>

		<a class="mobile-call" href={phoneHref}>Llamar a La Chalá <span>614 94 16 84</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>
