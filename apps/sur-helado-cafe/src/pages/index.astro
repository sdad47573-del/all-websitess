---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/sur-helado-cafe-interior-terraza-malaga.jpg';
import fachada from '../assets/fotos/sur-helado-cafe-fachada-pirandello-malaga.jpg';
import sala from '../assets/fotos/sur-helado-cafe-sala-rotulo-sur-malaga.jpg';
import vitrinaSabores from '../assets/fotos/sur-helado-cafe-vitrina-sabores-malaga.jpg';
import cubetasOreo from '../assets/fotos/sur-helado-cafe-cubetas-oreo-malaga.jpg';
import heladoFresa from '../assets/fotos/sur-helado-cafe-helado-fresa-vitrina-malaga.jpg';
import heladoChocolate from '../assets/fotos/sur-helado-cafe-helado-chocolate-nata-malaga.jpg';
import cucurucho from '../assets/fotos/sur-helado-cafe-cucurucho-galleta-malaga.jpg';
import heladoVaso from '../assets/fotos/sur-helado-cafe-helado-vaso-toppings-malaga.jpg';
import vasoCafe from '../assets/fotos/sur-helado-cafe-vaso-cafe-malaga.jpg';
import bocadillo from '../assets/fotos/sur-helado-cafe-bocadillo-zumo-malaga.jpg';

const business = {
	name: 'Sur',
	tagline: 'Helado café en Teatinos',
	street: 'C. Pirandello, 8',
	district: 'Teatinos-Universidad',
	city: 'Málaga',
	postalCode: '29010',
	latitude: 36.7171146,
	longitude: -4.4614703,
	rating: 4.9,
	reviewsCount: 228,
	site: 'https://sur-helado-cafe.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd72f73aa2c39bc7:0x107b341df85c6883';
const cidDecimal = '1187600230067759235';
const placeId = 'ChIJx5vDojr3cg0Rg2hc-B00exA';
const instagram = 'https://www.instagram.com/surheladocafe/';

const mapsUrl = `https://www.google.com/maps/place/?q=place_id:${placeId}&hl=es`;
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;

// El local no publica teléfono, así que el canal de contacto es Instagram y la
// llamada a la acción principal son las indicaciones.
const description =
	'Sur es un helado café en C. Pirandello, 8 (Teatinos, Málaga): helado artesanal, café, tartas y bocadillos, con terraza en la calle. 4,9 en Google con 228 reseñas. Abierto de martes a domingo.';

const servicios = [
	'Helado artesanal',
	'Helado italiano',
	'Sabores naturales',
	'Café',
	'Tartas',
	'Bocadillos',
	'Desayunos',
	'Meriendas',
	'Terraza en la calle',
	'Local familiar',
	'Cerca de la Universidad',
	'Barrio de Teatinos',
];

const grupos = [
	{
		title: 'Helado',
		items: [
			{ name: 'Helado artesanal', note: 'elaborado en el local, con sabor suave y natural' },
			{ name: 'Sabores de fruta', note: 'con mucho porcentaje de fruta y sin añadidos' },
			{ name: 'Helado italiano', note: 'la gama propia de la casa' },
			{ name: 'Pistacho', note: 'uno de los sabores que más se repiten en las reseñas' },
			{ name: 'Para llevar o para tomar ahí', note: 'en cucurucho con galleta o en vaso' },
		],
	},
	{
		title: 'Café y repostería',
		items: [
			{ name: 'Café', note: 'el resto del negocio es un café de verdad, no solo una heladería' },
			{ name: 'Tartas', note: 'para acompanhar el café o para merendar' },
			{ name: 'Volver a los sencillos', note: 'la idea con la que nacieron el local, según su fundador' },
			{ name: 'Comida para llevar', note: 'bocadillos y meriendas para el campus' },
		],
	},
	{
		title: 'Para comer y merendar',
		items: [
			{ name: 'Bocadillos', note: 'salados, para comer en el local o para llevar' },
			{ name: 'Desayunos', note: 'se abre por la mañana, desde las nueve' },
			{ name: 'Meriendas', note: 'con café, tarta o helado' },
			{ name: 'Terraza en la calle', note: 'con mesas y sombrillas en Pirandello' },
		],
	},
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de Sur Helado Café con la terraza en la calle Pirandello, Teatinos, Málaga',
	},
	{
		src: vitrinaSabores,
		alt: 'Vitrina de sabores de Sur Helado Café con los cartelitos de cada helado, Teatinos, Málaga',
	},
	{
		src: heladoFresa,
		alt: 'Helado de fresa en la cubeta de la vitrina de Sur, heladería de Teatinos, Málaga',
	},
	{
		src: heladoChocolate,
		alt: 'Bola de helado de chocolate con nata de Sur Helado Café, Teatinos, Málaga',
	},
	{
		src: cucurucho,
		alt: 'Cucurucho de helado con galleta servido en Sur, heladería de Teatinos, Málaga',
	},
	{
		src: heladoVaso,
		alt: 'Vaso de helado con toppings y azúcar de Sur Helado Café, Málaga',
	},
	{
		src: cubetasOreo,
		alt: 'Cubetas de helado con el sabor Oreo en la vitrina de Sur, Teatinos, Málaga',
	},
	{
		src: sala,
		alt: 'Sala de Sur Helado Café con el rótulo en la pared y las mesas, Teatinos, Málaga',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo con zumo de naranja servido en Sur Helado Café, Teatinos, Málaga',
	},
	{
		src: vasoCafe,
		alt: 'Vaso de café servido en Sur Helado Café, cafetería de Teatinos, Málaga',
	},
];

const faqs = [
	{
		q: '¿Dónde está Sur Helado Café?',
		a: 'En la calle Pirandello, 8, en el barrio de Teatinos-Universidad (29010 Málaga), a pocos minutos de la Universidad. Tiene terraza en la propia calle, con mesas y sombrillas.',
	},
	{
		q: '¿Cuál es el horario de Sur?',
		a: 'Los martes, miércoles, jueves y viernes abre de 9:00 a 22:00. El sábado de 11:00 a 23:00 y el domingo de 11:00 a 20:00. Los lunes está cerrado. En festivos puede cambiar.',
	},
	{
		q: '¿El helado es artesanal?',
		a: 'Sí. Es un helado café de toda la vida: la heladería es artesanal y se trabaja con sabores naturales, con mucho porcentaje de fruta y sin añadidos. Los clientes destacan que el sabor es «super auténtico y suave».',
	},
	{
		q: '¿Cuántos sabores hay?',
		a: 'La vitrina va cambiando y la casa no compite por tener el catálogo más largo: los clientes dicen que no hay demasiada variedad, pero que el sabor es espectacular. El pistacho es uno de los más pedidos.',
	},
	{
		q: '¿Es solo una heladería?',
		a: 'No. Es un helado café: además de helado hay café, tartas, bocadillos, desayunos y meriendas. Su propia descripción es «helados, cafecito, tartas, bocadillos y más».',
	},
	{
		q: '¿Es un sitio para niños y para la familia?',
		a: 'Sí. Las reseñas destacan el «muy buen trato con los niños» y lo describen como una heladería familiar. Es un lugar para compartir con familia o amigos, tanto en la sala como en la terraza.',
	},
	{
		q: '¿Cuánto cuesta ir?',
		a: 'El precio de referencia que se publica para el local es de unos 3 a 8 euros por persona. En esta web no se dan precios concretos: la carta cambia y conviene confirmarla al llegar.',
	},
	{
		q: '¿Cómo contacto o pido?',
		a: 'El local no publica teléfono en Google, así que la vía más directa es escribirle por Instagram desde su perfil @surheladocafe. Para ir, la forma más sencilla es abrir la ficha en Google Maps y seguir las indicaciones.',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': ['IceCreamShop', 'CafeOrCoffeeShop'],
	'@id': `${business.site}/#negocio`,
	name: 'Sur Helado Café',
	alternateName: ['Sur - Helado Cafe', 'Sur Helado Café', 'Sur Teatinos'],
	slogan: 'Helados, cafecito, tartas, bocadillos y más',
	description,
	url: `${business.site}/`,
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Heladería', 'Cafetería', 'Pastelería', 'Bocadillos'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	image: `${business.site}/og.jpg`,
	sameAs: [mapsUrl, instagram],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday'],
			opens: '00:00',
			closes: '00:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '22:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '11:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '11:00',
			closes: '20:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Helado artesanal', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Helado italiano', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Café', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Tartas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Bocadillos', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza en la calle', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Apto para familias', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Sur · Helado Café en Teatinos, Málaga</title>
		<meta name="theme-color" content="#2f5d50" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Karla:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name="Sur Helado Café"
			description={description}
			keywords="heladería Teatinos, helado café Málaga, Sur Helado Café, helado artesanal Teatinos, helado italiano Málaga, cafetería Teatinos, café Pirandello, tartas Teatinos, bocadillos Teatinos, terraza Teatinos, merienda Universidad Málaga, heladería 29010 Málaga"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Sur · Helado Café en Teatinos, Málaga"
			ogDescription="Helado artesanal, café, tartas y bocadillos con terraza en C. Pirandello, 8, Teatinos. 4,9 en Google con 228 reseñas. Abierto de martes a domingo."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Interior de Sur Helado Café con la vitrina de helado y la terraza, en Teatinos, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author="Sur Helado Café"
			themeColor="#2f5d50"
			street={business.street}
			city={business.city}
			region="Andalucía"
			postalCode={business.postalCode}
			phone=""
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Teatinos-Universidad, Málaga"
			preload={[heroImage]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="S"
			name="Sur"
			subtitle="Helado · Café"
			phone="@surheladocafe"
			phoneHref={instagram}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Teatinos · Málaga"
				title="Helado artesanal<br /><em>y café de verdad.</em>"
				lede="Sur es un helado café en la calle Pirandello, 8, en pleno Teatinos. Helado artesanal de sabor natural y suave, café, tartas y bocadillos, y una terraza en la misma calle para quedarse un rato. 4,9 en Google con más de 200 reseñas. Abierto de martes a domingo."
				image={heroImage}
				imageAlt="Interior de Sur Helado Café con la vitrina de helado y la terraza de la calle Pirandello"
				primaryCta={{ label: 'Cómo llegar', href: directionsUrl }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,9</b> en Google (228 reseñas)' },
					{ label: 'Horario', html: 'Martes a viernes, 9:00–22:00' },
					{ label: 'Sábado', html: 'De 11:00 a <b>23:00</b>' },
					{ label: 'Lunes', html: '<b>Cerrado</b> · domingo 11:00–20:00' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Sur Helado Café" items={servicios} />

			<LocalAbout
				label="El local"
				title="Un lugar para<br /><em>volver a lo sencillo.</em>"
				paragraphs={[
					'Sur está en la calle Pirandello, 8, en Teatinos-Universidad, a un paso del campus. Es un helado café de toda la vida: una vitrina de helado artesanal, una barra de café, tartas y bocadillos, y una terraza con mesas y sombrillas en la propia calle.',
					'La idea con la que nació el local, según cuenta quien lo fundó, fue esa: crear un sitio para volver a los sencillos. Buen café, tartas y helado artesanal, sin complicarse. De ahí el nombre corto y la estética de barrio, con el toldo verde y el rótulo en la pared.',
					'El helado es la seña de identidad. Se trabaja con sabores naturales, con mucho porcentaje de fruta y sin añadidos, y el resultado es un helado suave y auténtico. Como la casa no compite por tener el catálogo más largo, la vitrina va cambiando con lo que mejor funciona en cada momento.',
					'En Google se repite lo mismo: que los helados están «deliciosos, con sabores increíbles y naturales», que el trato con los niños es excelente y que es un sitio para volver. También es un lugar con nombre propio en Teatinos: «la heladería más linda de Málaga», según el propio local.',
				]}
				note="La nota media en Google es de 4,9 sobre 228 reseñas. Las palabras que más se repiten en las reseñas son «heladería», «sabores» y «pistacho», y lo que más se valora es que el helado esté muy bueno y que el trato sea cercano. También se repite, con cariño, que la variedad de sabores no es enorme."
				links={[
					{ label: 'Ficha y reseñas en Google', href: cidUrl, external: true },
					{ label: 'Instagram @surheladocafe', href: instagram, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Helado, café<br /><em>y cosas de picar.</em>"
				description="Lo que se sirve en Sur, ordenado por lo que más se le pide. La vitrina y la carta cambian con frecuencia, así que lo mejor es acercarse o escribir por Instagram antes de ir."
				cta={{ label: 'Ver cómo llegar', href: directionsUrl }}
				groups={grupos}
				note="No se publican precios concretos porque no hay ninguno verificado en fuentes públicas. Como referencia, el propio local difunde un precio medio de unos 3 a 8 euros por persona."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La vitrina,<br /><em>la sala y la terraza.</em>"
				description="Estas fotografías proceden del perfil de Sur en Google Maps, con imágenes de la ficha y de sus clientes. En la ficha del local están todas las fotos y las reseñas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del local en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="C. Pirandello, 8 · 29010 Málaga"
				title="Nos vemos<br /><em>en Teatinos.</em>"
				addressLines={[
					business.street,
					business.district,
					`${business.postalCode} ${business.city}, España`,
				]}
				hours={[
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: '9:00–22:00' },
					{ day: 'Miércoles', value: '9:00–22:00' },
					{ day: 'Jueves', value: '9:00–22:00' },
					{ day: 'Viernes', value: '9:00–22:00' },
					{ day: 'Sábado', value: '11:00–23:00' },
					{ day: 'Domingo', value: '11:00–20:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google. El fin de semana abre más tarde por la mañana: el sábado a las 11:00 y el domingo también. Puede variar en festivos."
				mapTitle="Mapa de Sur Helado Café en la calle Pirandello, 8, Teatinos-Universidad, Málaga"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Sur Helado Café · Teatinos"
				mapHref={cidUrl}
				links={[{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' }]}
				contactLink={{ label: '@surheladocafe', href: instagram, external: true }}
				reserveNote="El local no publica teléfono y no hay reserva en línea: es un sitio de barra, mesas y terraza por orden de llegada. Para cualquier consulta, lo más rápido es escribirle por Instagram."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="S"
			name="Sur Helado Café"
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Instagram ↗', href: instagram, external: true },
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: cidUrl, external: true },
			]}
			phone="@surheladocafe"
			phoneHref={instagram}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Cómo llegar"
		/>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>