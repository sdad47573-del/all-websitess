---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/global.css';

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}', { eager: true });
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const business = {
	name: 'IKIGAI IZAKAYA',
	street: 'Travesía Carlos Mackintosh, 3, Local 26',
	district: 'Centro',
	city: 'Marbella',
	postalCode: '29602',
	phone: '952 75 73 73',
	latitude: 36.5081659,
	longitude: -4.8856967,
	site: 'https://ikigai-izakaya.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/IKIGAI+IZAKAYA/@36.5081659,-4.8856967,17z/data=!3m1!4b1!4m6!3m5!1s0xd73276c8d3111d3:0x5f7067262c679b1!8m2!3d36.5081659!4d-4.8856967!16s%2Fg%2F11j542d3p1';
const reviewsUrl = 'https://search.google.com/local/reviews?placeid=ChIJ0xExjWwncw0RsXnGYnIG9wU';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34952757373';
const email = 'ikigai.izakaya@gmail.com';
const emailHref = 'mailto:ikigai.izakaya@gmail.com';
const instagramUrl = 'https://www.instagram.com/ikigaiizakaya/';
const facebookUrl = 'https://www.facebook.com/Ikigai.Izakaya/';

const photos = {
	principal: foto('ikigai-izakaya-marbella.jpg'),
	ambiente: foto('salon-ikigai-izakaya.jpg'),
};

const galeria = [
	{
		src: foto('ramen-ikigai-izakaya.jpg'),
		w: 817,
		h: 645,
		alt: 'Ramen del IKIGAI IZAKAYA en Marbella',
		caption: 'Ramen de la casa',
	},
	{
		src: foto('plato-ikigai-1.jpg'),
		w: 802,
		h: 645,
		alt: 'Plato japonés de la carta del IKIGAI IZAKAYA en Marbella',
		caption: 'Cocina japonesa de temporada',
	},
	{
		src: foto('plato-ikigai-3.jpg'),
		w: 552,
		h: 645,
		alt: 'Yakitori a la brasa del IKIGAI IZAKAYA',
		caption: 'Brochetas a la robata',
	},
	{
		src: foto('plato-ikigai-4.jpg'),
		w: 645,
		h: 645,
		alt: 'Plato para compartir del IKIGAI IZAKAYA en Marbella',
		caption: 'Platos para compartir',
	},
	{
		src: foto('tarta-queso-matcha.jpg'),
		w: 520,
		h: 645,
		alt: 'Tarta de queso de té matcha del IKIGAI IZAKAYA',
		caption: 'Tarta de queso matcha',
	},
	{
		src: foto('salon-ikigai-2.jpg'),
		w: 483,
		h: 645,
		alt: 'Interior del IKIGAI IZAKAYA con su decoración de taberna japonesa',
		caption: 'El salón',
	},
	{
		src: foto('comida-ikigai-8.jpg'),
		w: 491,
		h: 645,
		alt: 'Guiso japonés servido en el IKIGAI IZAKAYA de Marbella',
		caption: 'Guisos japoneses',
	},
	{
		src: foto('platos-ikigai-7.jpg'),
		w: 483,
		h: 645,
		alt: 'Detalle de los platos del IKIGAI IZAKAYA publicados en Google Maps',
		caption: 'Producto y detalle',
	},
];

const servicios = [
	'Robata al carbón',
	'Yakitori',
	'Curris y guisos japoneses',
	'Opciones vegetarianas',
	'Cervezas de Japón',
	'Terraza',
	'Para llevar y a domicilio',
	'Reservas',
	'Wifi',
	'Accesible',
];

const carta = [
	{
		title: 'Entrantes',
		intro: 'Para abrir boca, de la brasa y del wok.',
		platos: [
			{ nombre: 'Bimi a la brasa' },
			{ nombre: 'Setas shimeji a la brasa' },
			{ nombre: 'Ostras a la brasa (fuera de carta)' },
		],
	},
	{
		title: 'Robata y yakitori',
		intro: 'La parrilla japonesa al carbón, la especialidad de la casa.',
		platos: [
			{ nombre: 'Yakitori de presa ibérica' },
			{ nombre: 'Yakitori de pollo y puerro' },
			{ nombre: 'Brochetas de salchicha japonesa' },
		],
	},
	{
		title: 'Guisos y principales',
		intro: 'Cocina occidental japonesada: curris, estofados y pastas.',
		platos: [
			{ nombre: 'Wok de presa ibérica' },
			{ nombre: 'Curry japonés de carrillada' },
			{ nombre: 'Estofado de pluma con udon' },
		],
	},
	{
		title: 'Postres y bebidas',
		intro: 'Dulzor contenido, como manda la repostería japonesa.',
		platos: [
			{ nombre: 'Mochi' },
			{ nombre: 'Tarta de queso matcha' },
			{ nombre: 'Cerveza japonesa' },
		],
	},
];

const faqs = [
	{
		q: '¿Dónde está IKIGAI IZAKAYA?',
		a: 'En la travesía Carlos Mackintosh, 3, local 26, en el centro de Marbella (29602), en un pasaje entre la plaza de las estatuas de Dalí y la avenida Ricardo Soriano. Un callejón fácil de pasar por alto: el restaurante se esconde, pero se encuentra.',
	},
	{
		q: '¿Qué es una izakaya y qué se come aquí?',
		a: 'Una izakaya es una taberna japonesa informal donde se comparten platos junto a la bebida. Aquí la carta gira en torno a la robata (parrilla japonesa al carbón): yakitori de presa ibérica y de pollo, setas shimeji a la brasa, curris japoneses como el de carrillada de cerdo, estofados con udon y postres de dulzor contenido como la tarta de queso matcha.',
	},
	{
		q: '¿Tienen sushi?',
		a: 'No. Es su rasgo más curioso y lo anuncian con un cartel a la entrada: de las decenas de restaurantes japoneses de Marbella, este es el único sin sushi. Su cocina son guisos, brochetas y brasa; si buscas sushi, este no es tu sitio.',
	},
	{
		q: '¿Cuál es el horario de IKIGAI IZAKAYA?',
		a: 'Abre para cenas de 20:00 a 23:00 lunes, jueves, viernes, sábado y domingo. Cierra martes y miércoles todo el día. Solo servicio de cena: a mediodía no abren.',
	},
	{
		q: '¿Hace falta reservar mesa?',
		a: 'Muy recomendable: el local es pequeño, con pocas mesas atendidas por sus propios dueños, y se llena sobre todo los fines de semana. Reserva en el 952 75 73 73 o por email en ikigai.izakaya@gmail.com.',
	},
	{
		q: '¿Es apto para vegetarianos, celíacos o familias?',
		a: 'Hay opciones vegetarianas en carta y varios platos adaptables. La cocina es de producto y de guisos, así que conviene avisar de alergias al pedir: lo preparan al momento. El ambiente es tranquilo y acogedor, también apto para ir con niños.',
	},
	{
		q: '¿Se puede pedir para llevar o a domicilio?',
		a: 'Sí, ofrecen comida para llevar y entrega a domicilio. Lo más directo es llamar al 952 75 73 73 en horario de apertura (a partir de las 20:00) para encargar y recoger en el local.',
	},
];

const description =
	'Robata japonesa al carbón, yakitori, curris y guisos sin sushi en el centro de Marbella. Travesía Carlos Mackintosh, 3. Cenas de 20:00 a 23:00. Reservas: 952 75 73 73.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 952 75 73 73',
	email,
	image: [`${business.site}${photos.principal.src}`, `${business.site}${photos.ambiente.src}`],
	priceRange: '30 € – 50 €',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo, Tarjeta',
	servesCuisine: ['Japonesa', 'Asiática', 'Parrilla', 'Opciones vegetarianas'],
	acceptsReservations: 'True',
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [instagramUrl, facebookUrl],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: '4.8',
		bestRating: '5',
		ratingCount: '528',
	},
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Robata japonesa al carbón', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Opciones vegetarianas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos al aire libre', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Para llevar', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Wifi', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1c1a1d" />
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="IKIGAI IZAKAYA Marbella, restaurante japonés Marbella, robata Marbella, yakitori Marbella, izakaya Marbella, curry japonés Marbella, restaurante japonés sin sushi, cena japonesa centro Marbella, restaurante Carlos Mackintosh Marbella, comida japonesa auténtica Marbella"
		/>
		<meta name="author" content="IKIGAI IZAKAYA" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Outfit:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>IKIGAI IZAKAYA | Robata japonesa y yakitori en Marbella</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="IKIGAI IZAKAYA · Robata japonesa en el centro de Marbella" />
		<meta
			property="og:description"
			content="Yakitori, curris y guisos japoneses a la brasa, sin sushi, en un izakaya pequeño del centro de Marbella."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.principal.src}`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="1600" />
		<meta property="og:image:alt" content="IKIGAI IZAKAYA, restaurante japonés de robata en el centro de Marbella" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="IKIGAI IZAKAYA · Robata japonesa en Marbella" />
		<meta
			name="twitter:description"
			content="Yakitori, curris y guisos a la brasa en el único japonés de Marbella sin sushi."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.principal.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Marbella" />
		<meta name="geo.position" content="36.5081659;-4.8856967" />
		<meta name="ICBM" content="36.5081659, -4.8856967" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="IKIGAI IZAKAYA, inicio">
				<span class="brand-mark" aria-hidden="true">居</span>
				<span class="brand-name">IKIGAI <small>Izakaya · Marbella centro</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">Carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>952 75 73 73</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Centro de Marbella · Solo cenas</p>
					<h1 id="hero-title">Robata al carbón,<br />yakitori y guisos<br /><em>sin sushi.</em></h1>
					<p class="hero-lede">
						Un izakaya pequeño y escondido en un callejón del centro de Marbella. Aquí no hay sushi:
						hay carbón, brasa y guisos japoneses de mercado, cocinados y servidos por sus propios
						dueños para unas cuantas mesas.
					</p>
					<div class="hero-actions">
						<a class="button button-red" href={phoneHref}>Reservar 952 75 73 73</a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<p class="hero-rating">
						<span class="star" aria-hidden="true">★</span>
						<strong>4,8</strong> de valoración media · más de 500 reseñas en Google
					</p>
					<ul class="hero-facts">
						<li>Cenas de 20:00 a 23:00 (cierra martes y miércoles)</li>
						<li>Robata japonesa al carbón</li>
						<li>Curris y guisos de la casa</li>
						<li>Opciones vegetarianas y para llevar</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.principal}
						alt="Fotografía del interior del IKIGAI IZAKAYA publicada en su ficha de Google Maps"
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Servicios del local">
				<ul class="chips">
					{servicios.map((servicio) => <li>{servicio}</li>)}
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> Un japonés sin sushi</p>
				<div class="about-grid">
					<h2>El único japonés<br />de Marbella<br /><em>sin sushi.</em></h2>
					<div class="about-copy">
						<p>
							IKIGAI IZAKAYA se esconde en la travesía Carlos Mackintosh, entre la plaza de las
							estatuas de Dalí y la avenida Ricardo Soriano. Lo llevan sus dos dueños: él en la cocina,
							ella en sala. Un local diminuto, pocas mesas y una carta que huye del sushi para ir a lo
							suyo: la robata al carbón, los curris japoneses y los estofados que se comen a diario en
							los hogares de Japón.
						</p>
						<p>
							«No tenemos sushi», reza el cartel a la entrada. A cambio: yakitori de presa ibérica,
							setas shimeji a la brasa con alioli de chiles toban djan, curry japonés de carrillada
							estofada al estilo andaluz, wok de presa con udon y gochuyang, ostras a la brasa con
							mantequilla de miso y una tarta de queso de té matcha de dulzor contenido.
						</p>
						<p class="about-note">
							Lo que más se repite en las reseñas públicas: el trato personal de los dueños, la
							explosión de sabores y una calidad-precio excelente para el centro de Marbella. También
							avisan de que el local es pequeñito y el servicio, pausado: se viene a cenar sin prisa.
						</p>
						<div class="about-links">
							<a class="simple-link" href={reviewsUrl} target="_blank" rel="noreferrer">
								Leer reseñas en Google <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">
								Instagram del local <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="menu section-pad" id="carta">
				<div class="menu-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De la brasa y del wok</p>
						<h2>Qué pedir<br />en <em>el Ikigai.</em></h2>
					</div>
					<p>
						Una selección de la carta. La carta es corta y cambia con la temporada
						y el producto del día: hay más platos en el pizarón del local y sugerencias fuera de carta.
					</p>
				</div>
				<div class="menu-grid">
					{
						carta.map((bloque) => (
							<article class="menu-card">
								<h3>{bloque.title}</h3>
								<p>{bloque.intro}</p>
								<ul>
									{bloque.platos.map((plato) => (
										<li>
											<span>{plato.nombre}</span>
										</li>
									))}
								</ul>
							</article>
						))
					}
				</div>
				<p class="menu-note">
					La carta es breve y de producto: si tienes
					alergias o intolerancias, avisa al pedir, la cocina lo prepara al momento.
				</p>
			</section>

			<section class="galeria section-pad" id="galeria">
				<p class="section-label"><span aria-hidden="true"></span> Fotos de la ficha de Google Maps</p>
				<h2>Umami<br /><em>a la brasa.</em></h2>
				<div class="galeria-grid">
					{
						galeria.map((foto) => (
							<figure>
								<Image src={foto.src} alt={foto.alt} widths={[320, 480, 640]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw" format="avif" quality={65} loading="lazy" decoding="async" />
								<figcaption>{foto.caption}</figcaption>
							</figure>
						))
					}
				</div>
				<p class="galeria-note">
					Fotografías publicadas en la ficha de Google Maps del restaurante. La ficha completa reúne
					más de doscientas fotos de clientes.
				</p>
			</section>

			<section class="ambiente section-pad" id="ambiente">
				<div class="ambiente-grid">
					<div class="ambiente-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Taberna japonesa</p>
						<h2>Pocas mesas,<br /><em>mucho ikigai.</em></h2>
						<p>
							Diez mesitas sin manteles, decoración rústica y una cocina diminuta con una robata al
							carbón como corazón del local. El ambiente es acogedor y festivo, más cerca de una
							taberna de barrio de Tokio que de un restaurante de cita.
						</p>
						<p>
							Se viene a compartir platos, probar las cervezas japonesas de la carta y dejarse llevar
							por el ritmo tranquilo de la casa. Tras la cena, el centro de Marbella queda a un paso
							para una copa o un paseo por la avenida del Mar.
						</p>
						<p class="about-note">
							Consejo de las reseñas: reserva antes, sobre todo el fin de semana, porque entre lo
							pequeño del local y la demanda las mesas vuelan.
						</p>
					</div>
					<figure class="ambiente-photo">
						<Image
							src={photos.ambiente}
							alt="Mesas del IKIGAI IZAKAYA preparadas para el servicio de cena"
							widths={[320, 480, 640]}
							sizes="(max-width: 980px) 92vw, 40vw"
							format="avif"
							quality={65}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>
							El salón · foto de Google Maps
							<a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha ↗</a>
						</figcaption>
					</figure>
				</div>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow dark"><span aria-hidden="true"></span> Travesía Carlos Mackintosh, 3 · 29602 Marbella</p>
					<h2>Nos vemos<br /><em>en el callejón.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.district} de Marbella<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
