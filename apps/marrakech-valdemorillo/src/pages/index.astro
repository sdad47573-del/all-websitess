---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import cuscus from '../assets/fotos/marrakech-valdemorillo-vertical-01.jpg';
import dulces from '../assets/fotos/marrakech-valdemorillo-apaisada-04.jpg';
import te from '../assets/fotos/marrakech-valdemorillo-vista-9-09.jpg';
import garbanzos from '../assets/fotos/marrakech-valdemorillo-vertical-03.jpg';
import teDos from '../assets/fotos/marrakech-valdemorillo-vertical-06.jpg';
import ensalada from '../assets/fotos/marrakech-valdemorillo-vertical-07.jpg';
import durum from '../assets/fotos/marrakech-valdemorillo-vertical-08.jpg';
import dulcesFuente from '../assets/fotos/marrakech-valdemorillo-vertical-10.jpg';
import carta from '../assets/fotos/marrakech-valdemorillo-vertical-05.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Marrakech · Comida casera marroquí y kebab en Valdemorillo';
const description = BUSINESS.description;

const galeria = [
	{
		src: cuscus,
		alt: 'Cuscús con pollo, verduras y garbanzos servido en una fuente de barro en la terraza de Marrakech',
	},
	{
		src: dulces,
		alt: 'La vitrina de dulces marroquíes de Marrakech con bandejas de pastas de almendra, dátiles y miel',
	},
	{
		src: te,
		alt: 'Té con hierbabuena en un vaso decorado junto a una tetera de plata sobre una bandeja',
	},
	{
		src: garbanzos,
		alt: 'Fuente de barro con garbanzos, calabaza, zanahoria y carne, junto a otra ración',
	},
	{
		src: teDos,
		alt: 'Dos bandejas con teteras de plata y vasos de té con hierbabuena en la mesa del local',
	},
	{
		src: ensalada,
		alt: 'Ensalada de patata, zanahoria, remolacha, judía verde y maíz con mayonesa',
	},
	{
		src: durum,
		alt: 'Dürum de kebab envuelto en papel de la casa con patatas fritas, kétchup y salsa',
	},
	{
		src: dulcesFuente,
		alt: 'Bandeja de dulces marroquíes: chebakia, pastas de almendra y dulces de dátil y pistacho',
	},
	{
		src: carta,
		alt: 'La carta impresa de Marrakech Kebab con tacos, dürum, bocadillos, hamburguesas y platos',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#marrakech`,
	name: BUSINESS.name,
	alternateName: ['Marrakech Kebab', 'Marrakech Valdemorillo', 'Comida casera para llevar Marrakech'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34611533240',
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Marroquí', 'Casera', 'Kebab'],
	areaServed: [
		{ '@type': 'City', name: 'Valdemorillo' },
		{ '@type': 'AdministrativeArea', name: 'Comunidad de Madrid' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday'],
			opens: '09:30',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday'],
			opens: '19:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Saturday', 'Sunday'],
			opens: '10:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday'],
			opens: '18:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '19:00',
			closes: '23:59',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"marrakech-valdemorillo-vertical-01.jpg": cuscus,
	"marrakech-valdemorillo-apaisada-04.jpg": dulces,
	"marrakech-valdemorillo-vista-9-09.jpg": te,
	"marrakech-valdemorillo-vertical-03.jpg": garbanzos,
	"marrakech-valdemorillo-vertical-06.jpg": teDos,
	"marrakech-valdemorillo-vertical-07.jpg": ensalada,
	"marrakech-valdemorillo-vertical-08.jpg": durum,
	"marrakech-valdemorillo-vertical-10.jpg": dulcesFuente,
	"marrakech-valdemorillo-vertical-05.jpg": carta,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#123c36" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400..700;1,400..700&family=Mulish:ital,wght@0,400..700;1,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Marrakech Valdemorillo, comida casera marroquí, kebab Valdemorillo, Marrakech Kebab, Calle la Fuente 12, comida para llevar Sierra Oeste, dulces árabes"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina casera marroquí y kebab en C. la Fuente, 12 (Valdemorillo, 28210 Madrid). Para comer allí o para llevar, con raciones abundantes y dulces caseros."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tarjeta de Marrakech con su nombre sobre fondo verde esmeralda"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#123c36"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Valdemorillo"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[cuscus]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Marrakech"
			subtitle="Cocina marroquí · Valdemorillo"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Marrakech"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a Marrakech"
			navAriaLabel="Enlaces de Marrakech"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34611533240?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Valdemorillo." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Valdemorillo"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
