---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachadaNieve from '../assets/fotos/el-rosat-apaisada-10.jpg';
import terrazaVerano from '../assets/fotos/el-rosat-apaisada-04.jpg';
import entrada from '../assets/fotos/el-rosat-vertical-01.jpg';
import comedor from '../assets/fotos/el-rosat-vertical-02.jpg';
import barra from '../assets/fotos/el-rosat-vertical-05.jpg';
import chickenBurger from '../assets/fotos/el-rosat-vertical-06.jpg';
import wrap from '../assets/fotos/el-rosat-vertical-07.jpg';
import sandwichHuevo from '../assets/fotos/el-rosat-vertical-09.jpg';
import quiche from '../assets/fotos/el-rosat-apaisada-03.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, MENU_NOTE, SERVICIOS } from '../data/site';

const title = 'El Rosat · Snack bar y restaurante en Pas de la Casa';
const description = BUSINESS.description;

const galeria = [
	{
		src: entrada,
		alt: 'Entrada de El Rosat con el letrero de madera, las cartas iluminadas a los lados y la pizarra de zumos prensados',
	},
	{
		src: comedor,
		alt: 'Comedor de El Rosat con las letras ROSAT sobre las mesas y una camarera sirviendo',
	},
	{
		src: barra,
		alt: 'Barra de El Rosat con la cafetera, botellas, copas y el mural «Maman disait toujours…»',
	},
	{
		src: chickenBurger,
		alt: 'Chicken burger de El Rosat servido con patatas fritas y salsa en un plato blanco',
	},
	{
		src: wrap,
		alt: 'Wrap de El Rosat a la plancha, cortado por la mitad y acompañado de patatas fritas',
	},
	{
		src: sandwichHuevo,
		alt: 'Bocadillo de El Rosat con huevo frito, carne, lechuga y patatas, con el casco de esquí sobre la mesa',
	},
	{
		src: quiche,
		alt: 'Plato de El Rosat con quiche gratinada y un vaso de ensalada verde',
	},
	{
		src: terrazaVerano,
		alt: 'Terraza de El Rosat en verano, con la valla de madera y las mesas en la calle',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-rosat`,
	name: BUSINESS.name,
	alternateName: ['El Rosat', 'Restaurante El Rosat', 'Snack Bar El Rosat', 'El Rosat Pas de la Casa'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Snack bar', 'Bocadillos', 'Hamburguesas', 'Cocina francesa', 'Crêpes'],
	areaServed: [
		{ '@type': 'City', name: 'Pas de la Casa' },
		{ '@type': 'AdministrativeArea', name: 'Encamp' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google Maps feature ID', value: BUSINESS.featureId },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '08:00',
			closes: '19:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Se admiten perros', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0f1a16" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,500;0,600;0,700;1,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Rosat Pas de la Casa, snack bar Pas de la Casa, restaurante Pas de la Casa, comer en Pas de la Casa, Carrer Sant Jordi 1, burger Pas de la Casa, bocadillos Andorra, crêpes Pas de la Casa, galettes Andorra, restaurante Encamp"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Snack bar y restaurante en el Carrer Sant Jordi 1 de Pas de la Casa. Todos los días de 8:00 a 19:00, servicio non-stop. 4,4 sobre 5 con 440 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada nevada de El Rosat con el letrero de madera y la carta en la puerta"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#0f1a16"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Pas de la Casa, Encamp"
			countryName="Andorra"
			preload={[fachadaNieve]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Rosat"
			subtitle="Snack bar · restaurante"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="Comer bien <br /><em>en la montaña.</em>"
				lede={`El Rosat está en el Carrer Sant Jordi 1, a un paso del centro de Pas de la Casa y de las pistas. Abre todos los días de 8:00 a 19:00 con servicio non-stop: platos combinados, bocadillos, burgers, kebabs, galettes bretonas y crêpes. La ficha de Google le da 4,4 sobre 5 con 440 reseñas.`}
				image={fachadaNieve}
				imageAlt="Fachada de El Rosat nevada, con el letrero de madera «ROSAT.» y las cartas iluminadas a los lados de la puerta"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4</b> en Google · 440 reseñas' },
					{
						label: 'Horario',
						html: '<b>8:00–19:00</b><br />Todos los días · non-stop',
					},
					{
						label: 'Teléfono',
						html: `<b>${BUSINESS.phone}</b> consultas y encargos`,
					},
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de El Rosat" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un snack bar <br /><em>de montaña.</em>"
				paragraphs={[
					'El Rosat es un snack bar y restaurante en el Carrer Sant Jordi 1, en pleno Pas de la Casa, la localidad andorrana de la parroquia de Encamp pegada a la frontera con España. En la fachada, de piedra y madera, cuelga un letrero con el nombre y un gato dibujado que sostiene una cuchara de madera.',
					'Dentro hay dos ambientes: el comedor, con las letras «ROSAT» en blanco sobre las mesas y las paredes de madera, y la barra, con cafetera, cerveza de grifo, copas colgadas y un mural que empieza «Maman disait toujours… La vie, c\'est comme une boîte de chocolats». Al lado de la puerta, una pizarra anuncia zumos prensados del día: citron, orange y pamplemousse, solos o en dúo y trío.',
					'La carta está expuesta en la puerta, en francés, y se organiza en platos combinados con ensalada y patatas de la casa, bocadillos, americanos, burgers, kebabs, paninis, galettes de trigo sarraceno y crêpes dulces. Todo se sirve de forma continua mientras el local está abierto.',
					'El horario de la ficha es de 8:00 a 19:00 todos los días, de lunes a domingo. Delante hay una terraza cercada con valla de madera: en invierno aparece cubierta de nieve y en verano se abre como una extensión de la calle. La ficha marca además que se admiten perros.',
				]}
				note="La información sale de la ficha pública de Google Maps y de las fotografías del perfil del establecimiento, incluida la carta de la puerta. No hay web oficial: si algo cambia, manda lo que digan en el local o por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver El Rosat en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="La carta <br /><em>de la puerta.</em>"
				description="Los platos y precios son los de la carta que el local tiene expuesta junto a la entrada, escrita en francés. El IGI andorrano del 4,5 % ya está incluido."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note={MENU_NOTE}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Ocho fotos <br /><em>de El Rosat.</em>"
				description="La fachada con nieve, la terraza en verano, el comedor, la barra y algunos de sus platos: burgers, wraps, bocadillos y galettes."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a <br /><em>Sant Jordi, 1.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.parish}, Andorra`,
				]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: de 8:00 a 19:00 todos los días. La carta anuncia servicio non-stop, así que se puede comer a cualquier hora dentro de ese intervalo. En temporada alta de esquí puede ampliarse; llama antes si vas en día señalado."
				mapTitle="Mapa de El Rosat en el Carrer Sant Jordi 1, Pas de la Casa"
				mapEmbedUrl={MAPS.embed}
				mapLabel="El Rosat"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="No hay reservas ni pedidos en línea en esta página: la ficha no publica una web propia. El teléfono es el canal directo para preguntar por la mesa, el plato del día o el horario de la terraza en temporada de esquí."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de El Rosat"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
