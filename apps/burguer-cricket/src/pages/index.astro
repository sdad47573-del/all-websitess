---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachadaNoche from '../assets/fotos/burguer-cricket-apaisada-01.jpg';
import interior from '../assets/fotos/burguer-cricket-apaisada-03.jpg';
import escaparateNoche from '../assets/fotos/burguer-cricket-apaisada-05.jpg';
import fachadaDia from '../assets/fotos/burguer-cricket-apaisada-06.jpg';
import terraza from '../assets/fotos/burguer-cricket-apaisada-09.jpg';
import ensalada from '../assets/fotos/burguer-cricket-panoramica-07.jpg';
import combinado from '../assets/fotos/burguer-cricket-panoramica-10.jpg';
import hamburguesaHuevo from '../assets/fotos/burguer-cricket-vertical-02.jpg';
import hamburguesaBuey from '../assets/fotos/burguer-cricket-vertical-04.jpg';
import nachos from '../assets/fotos/burguer-cricket-vertical-08.jpg';

import { BUSINESS, FAQ, HOURS, HORARIO_AVISO, MAPS, MENU, RATING, SERVICIOS } from '../data/site';

const title = 'Burguer Cricket · hamburguesas y platos combinados en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: hamburguesaBuey,
		alt: 'Hamburguesa de buey en pan rústico con cebolla morada, tomate, chutney y lechuga',
	},
	{
		src: hamburguesaHuevo,
		alt: 'Hamburguesa con huevo frito, lechuga y tomate en pan con sésamo',
	},
	{
		src: combinado,
		alt: 'Plato combinado con patatas fritas, zanahoria rallada, pepinillos y mayonesa',
	},
	{
		src: nachos,
		alt: 'Nachos con queso fundido y tres salsas al lado en cuencos de cristal',
	},
	{
		src: ensalada,
		alt: 'Ensalada de atún con aceitunas, tomate y cebolla en plato azul',
	},
	{
		src: fachadaNoche,
		alt: 'Fachada de Burguer Cricket de noche, con el rótulo iluminado y gente en la puerta',
	},
	{
		src: escaparateNoche,
		alt: 'Escaparate nocturno del local con el cartel de platos combinados en el cristal',
	},
	{
		src: interior,
		alt: 'Interior de Burguer Cricket con mesas de madera, barra y panel de menú luminoso',
	},
	{
		src: fachadaDia,
		alt: 'Fachada de día de Burguer Cricket, con la puerta abierta y la pared de piedra negra',
	},
	{
		src: terraza,
		alt: 'Terraza cubierta con mesas y sillas rojas bajo el porche del edificio',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#burguer-cricket`,
	name: BUSINESS.name,
	alternateName: ['Burguer Cricket Ciudad Real', 'Burger Cricket Ciudad Real'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Hamburguesas', 'Comida americana', 'Comida rápida', 'Platos combinados'],
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.channel },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Entrada adaptada', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#12121a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Burguer Cricket Ciudad Real, hamburguesería Avenida Tablas de Daimiel, hamburguesa de buey Ciudad Real, platos combinados Ciudad Real, nachos Ciudad Real, terraza hamburguesas Ciudad Real, comida rápida 13004"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Hamburguesas de buey, platos combinados, nachos y ensaladas en la Avenida Tablas de Daimiel, 7, de Ciudad Real. Terraza cubierta. 3,9 sobre 5 con 669 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Hamburguesa de buey de Burguer Cricket"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#12121a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[hamburguesaBuey]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Hamburguesas en Tablas de Daimiel"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Hamburguesa <br /><em>de buey.</em>"
				lede={`Burguer Cricket está en la Avenida Tablas de Daimiel, 7, en Ciudad Real. Hamburguesería y restaurante americano con hamburguesa de buey en pan rústico, platos combinados, nachos, ensaladas y una terraza de mesas rojas bajo el porche. La ficha de Google le da 3,9 sobre 5 con 669 reseñas.`}
				image={hamburguesaBuey}
				imageAlt="Hamburguesa de buey en pan rústico con cebolla morada, tomate, chutney y lechuga"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>3,9</b> en Google · 669 reseñas' },
					{
						label: 'Horario',
						html: '<b>No publicado</b><br />La ficha no da horas: llama antes',
					},
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> mesa y encargos` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Burguer Cricket" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un cricket <br /><em>en la avenida.</em>"
				paragraphs={[
					'Burguer Cricket ocupa un bajo de la Avenida Tablas de Daimiel, 7, en Ciudad Real. Google lo clasifica como hamburguesería, restaurante americano y restaurante de comida rápida. La fachada es inconfundible: pared de piedra negra, escaparate largo y un rótulo con el nombre repetido en cursiva, encendido en naranja por la noche.',
					'Por dentro, las fotos del perfil enseñan mesas de madera con sillas marrones, una barra larga del mismo tono, la nevera de refrescos a un lado y el panel de menú luminoso colgado sobre el mostrador. Fuera, bajo el porche del edificio, hay una fila de mesas y sillas rojas de plástico que hace las veces de terraza cubierta.',
					'La hamburguesa de buey es lo que más se repite en las reseñas: «Su hamburguesa de buey está buenísima». En las fotos aparece en pan rústico, con cebolla morada, tomate, chutney y lechuga; la otra lleva huevo frito, lechuga y tomate en pan con sésamo. Y en el cristal de la fachada se anuncia «platos combinados», con patatas, zanahoria rallada, pepinillos y mayonesa.',
					'La media es 3,9 sobre 5 con 669 reseñas, y no todo son flores. Una reseña de tres estrellas dice que las hamburguesas están buenas pero que las ensaladas llevan demasiada salsa, y hay quejas por la espera en el servicio. Esta web recoge las dos caras, no solo la buena.',
				]}
				note="Los datos salen de la ficha pública de Google Maps y de las fotos y reseñas del perfil. La ficha no publica horario, carta ni precios: esta web no los inventa. Para horario y mesa, el teléfono es el 926 25 34 79."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Buey, huevo <br /><em>y combinados.</em>"
				description="Los platos que aparecen aquí son los que enseñan las fotos del perfil y los que nombran las reseñas. La casa no tiene carta publicada en Google ni web propia."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="Esta página no publica precios porque no hay carta oficial que copiar. El menú del día, las raciones y los importes se preguntan en el 926 25 34 79 o en la barra."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Diez fotos <br /><em>del local.</em>"
				description="Las fotografías del perfil de Burguer Cricket en Google Maps: las hamburguesas, el combinado, los nachos, la ensalada, la fachada de día y de noche, el interior y la terraza."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Nos vemos <br /><em>en la terraza.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Castilla-La Mancha, España']}
				hours={HOURS}
				hoursCaption="Horario y datos"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de Burguer Cricket en la Avenida Tablas de Daimiel 7, Ciudad Real"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Burguer Cricket"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. El local no publica web propia ni sistema de reservas, así que el teléfono es el canal directo para preguntar horario, encargar para llevar o reservar mesa."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Burguer Cricket"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
