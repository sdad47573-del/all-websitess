---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import paella from '../assets/fotos/el-pescadito-apaisada-03.jpg';
import gambas from '../assets/fotos/el-pescadito-apaisada-04.jpg';
import arroz from '../assets/fotos/el-pescadito-apaisada-05.jpg';
import fritura from '../assets/fotos/el-pescadito-apaisada-06.jpg';
import almejas from '../assets/fotos/el-pescadito-apaisada-07.jpg';
import comedor from '../assets/fotos/el-pescadito-panoramica-01.jpg';
import lenguado from '../assets/fotos/el-pescadito-vertical-02.jpg';
import crema from '../assets/fotos/el-pescadito-vertical-08.jpg';
import plancha from '../assets/fotos/el-pescadito-vertical-09.jpg';
import calamares from '../assets/fotos/el-pescadito-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'El Pescadito · Marisquería y arroces en Benidorm';
const description =
	'El Pescadito, Av. de Uruguay, 6 (03502 Benidorm, Alicante). Marisquería y restaurante mediterráneo: paellas, pescado a la plancha, fritura y marisco. 4,5 sobre 5 con 1.117 reseñas. Lunes cerrado.';

const galeria = [
	{
		src: paella,
		alt: 'Paella de mariscos en su paellera, con gambones, mejillones, calamar y limón',
	},
	{
		src: comedor,
		alt: 'El comedor de El Pescadito con mesas de mantel blanco, sillas de madera y la bodega en arco al fondo',
	},
	{
		src: gambas,
		alt: 'Bandeja de gambas rojas cocidas con un gajo de limón',
	},
	{
		src: arroz,
		alt: 'Paellera de arroz amarillo con anillas de calamar recién hecha',
	},
	{
		src: fritura,
		alt: 'Plato de El Pescadito con pescaditos fritos, calamares a la andaluza y gambas',
	},
	{
		src: almejas,
		alt: 'Fuente de almejas abiertas con gajos de limón',
	},
	{
		src: lenguado,
		alt: 'Lenguado a la plancha con patatas panadera y pisto de tomate y pimiento',
	},
	{
		src: plancha,
		alt: 'Pescado entero a la plancha con chipirones y mejillones en el mismo plato',
	},
	{
		src: calamares,
		alt: 'Calamares a la andaluza en rodajas con un gajo de limón',
	},
	{
		src: crema,
		alt: 'Crema catalana en cazuela de barro con la azúcar quemada y servilleta debajo',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que se reconoce en las fotos de El Pescadito',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-pescadito`,
	name: BUSINESS.name,
	alternateName: ['El Pescadito Benidorm', 'El Pescadito marisquería Benidorm'],
	description:
		'Marisquería y restaurante mediterráneo en la Avenida de Uruguay, 6 (03502 Benidorm, Alicante): paellas, pescado a la plancha, fritura y marisco, en un comedor con mantel blanco.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34965866003',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Marisquería', 'Arroces', 'Pescado'],
	areaServed: [
		{ '@type': 'City', name: 'Benidorm' },
		{ '@type': 'AdministrativeArea', name: 'Marina Baixa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Sunday'],
			opens: '10:30',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '10:30',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '20:00',
			closes: '00:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Monday',
			opens: '00:00',
			closes: '00:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0e3f4a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&family=Sora:wght@400;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Pescadito Benidorm, marisquería Benidorm, paella Benidorm, arroces Benidorm, pescado a la plancha Benidorm, Avenida de Uruguay, restaurante mediterráneo Benidorm"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Marisquería y arroces en la Avenida de Uruguay (Benidorm): paellas, pescado a la plancha, fritura y marisco. Martes a domingo de 10:30 a 17:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La paella de mariscos de El Pescadito en su paellera, con gambones y mejillones"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#0e3f4a"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[paella]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Pescadito"
			subtitle="Marisquería · Benidorm"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. de Uruguay, 6 · Benidorm (Alicante)"
				title="Marisco y arroz, <br /><em>a la mesa.</em>"
				lede={`El Pescadito es la marisquería de la Avenida de Uruguay, en Benidorm: paellas que llegan a la mesa en la paellera, pescado a la plancha con patatas panadera y fritura para compartir, en un comedor de mantel blanco. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas. Martes a domingo desde las 10:30; lunes cerrado.`}
				image={paella}
				imageAlt="Paella de mariscos de El Pescadito en la paellera, con gambones, mejillones, calamar y limón"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>10:30–17:00</b> · lunes cerrado' },
					{ label: 'Cocina', html: '<b>Marisquería</b> · mediterránea' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Paellas y marisco"
			/>

			<LocalChips label="Lo que ofrece El Pescadito" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Avenida de Uruguay. <br /><em>Mantel blanco y paellera.</em>"
				paragraphs={[
					'El Pescadito está en la Avenida de Uruguay, 6, en Benidorm. La ficha de Google sitúa el local en las coordenadas 38.5387628, -0.1400331. La dirección no deja dudas: una avenida ancha de la ciudad, con el restaurante a pie de calle.',
					'Dentro hay un comedor amplio de mesas vestidas de blanco, copas puestas y sillas de madera con el respaldo alto. Al fondo, la bodega ocupa un arco de ladrillo con las botellas alineadas, y en una de las paredes cuelga el mural de un barco de tres palos con las velas desplegadas. Las lámparas de techo y el suelo de mármol completan una sala de mantel, no de barra rápida.',
					'La ficha clasifica el negocio como «marisquería» y «restaurante mediterráneo». En las fotos del perfil aparecen la paella de mariscos en su paellera, un arroz amarillo con anillas de calamar, un lenguado a la plancha con patatas panadera y pisto, una pieza de pescado entera con chipirones y mejillones, calamares a la andaluza, una bandeja de gambas rojas, almejas con limón y una crema catalana en cazuela de barro.',
					`Las reseñas que se ven en Google hablan del trato, de las raciones y del arroz: «el trato espectacular, el arroz buenísimo», «raciones grandes, mucha variedad de platos y de buena calidad». Con ${RATING.count} opiniones, la media es de ${RATING.label} sobre 5 (noviembre de 2026). El teléfono de la ficha es el ${BUSINESS.phone}.`,
				]}
				note="La ficha no publica carta, precios ni web propia. Lo que aparece en esta página es lo que dice la ficha y lo que se reconoce en las fotos del perfil; para saber el menú del día, el precio de la paella o si hay mesa, hay que llamar al restaurante."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> En la mesa</p>
					<h2 id="highlights-title">Arroz, plancha <br /><em>y fritura.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Lo que se ve <br /><em>en los platos.</em>"
				description="Sin carta publicada: esta lista reúne los platos que se reconocen en las fotos del perfil de Google y lo que cuentan las reseñas. No hay precios en la ficha, así que aquí tampoco."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note={`El menú del día y los precios se preguntan por teléfono, en el ${BUSINESS.phone}. Las raciones son grandes según las reseñas, así que conviene preguntar cuánto trae cada plato antes de pedir de más.`}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La paella, el comedor <br /><em>y el pescado.</em>"
				description="Diez fotografías del perfil de El Pescadito: la paella de mariscos, el comedor con la bodega al fondo, las gambas rojas, el arroz con calamares, la fritura del plato del local, las almejas, el lenguado con patatas panadera, el pescado a la plancha con chipirones y mejillones, los calamares a la andaluza y la crema catalana."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,5 sobre 5, <em>con 1.117 reseñas.</em></h2>
						<p>
							Google publica una media de 4,5 con 1.117 opiniones (noviembre de 2026). Entre las
							reseñas que se ven en la ficha, las hay que elogian el trato, el arroz, las
							raciones generosas y la variedad de platos.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,5</strong>
						<span>★★★★☆</span>
						<small>1.117 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Benidorm, <br /><em>Avenida de Uruguay.</em>"
				addressLines={[BUSINESS.street, BUSINESS.city, `${BUSINESS.postalCode} ${BUSINESS.city} (Alicante)`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: martes a jueves y domingo de 10:30 a 17:00; viernes y sábado también de 20:00 a 24:00; lunes cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de El Pescadito en la Avenida de Uruguay, Benidorm"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Av. de Uruguay, 6 · Benidorm"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote={`Las mesas se piden por teléfono, en el ${BUSINESS.phone}: el local no tiene web propia ni reservas online. La ficha marca acceso para sillas de ruedas y asientos adaptados. Los viernes y sábados abre también por la noche.`}
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>sentarse.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma platos, precios y horario antes de ir."
			ctaLabel="Llamar a El Pescadito"
			navAriaLabel="Enlaces de El Pescadito"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
