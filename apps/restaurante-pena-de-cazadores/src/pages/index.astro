---
import '../styles/global.css';

const business = {
	name: 'Restaurante Peña de Cazadores',
	short: 'Peña de Cazadores',
	street: 'Av. de Buenavista, 30',
	city: 'Vejer de la Frontera',
	postalCode: '11150',
	phone: '+34 956 44 73 18',
	latitude: 36.2497443,
	longitude: -5.9684778,
	site: 'https://restaurante-pena-de-cazadores.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+Pe%C3%B1a+de+Cazadores/@36.2497443,-5.9684778,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c45cc2ef29acd:0x8d8dec16b432c6e6!8m2!3d36.2497443!4d-5.9684778!16s%2Fg%2F11hczj9dwx?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const phoneHref = 'tel:+34956447318';

const specialties = [
	{
		kicker: 'Desde por la mañana',
		title: 'Barra y desayunos',
		text: 'Café bar abierto desde las 8:00: desayunos y tapeo temprano en la avenida.',
	},
	{
		kicker: 'De la tierra',
		title: 'Cocina española',
		text: 'Mesón de cocina española para mediodía y noche, en pleno Vejer.',
	},
	{
		kicker: 'Para compartir',
		title: 'Tapas y raciones',
		text: 'Tapas y raciones de bar-restaurante de barrio, sin complicaciones.',
	},
	{
		kicker: 'Al aire libre',
		title: 'Terraza',
		text: 'Terraza en la avenida para el buen tiempo vejeriego.',
	},
	{
		kicker: 'Todo el día',
		title: 'De 8:00 a 24:00',
		text: 'Jornada larga de lunes y de miércoles a domingo: desayuno, comida, tardeo y cena.',
	},
	{
		kicker: 'De barrio',
		title: 'Trato cercano',
		text: 'Café bar de los de siempre en Buenavista, junto a otros mesones de la zona.',
	},
];

const gallery = [
	{ src: '/fotos/meson.svg', alt: 'Ilustración del mesón Peña de Cazadores — sustituye por foto propia' },
	{ src: '/fotos/barra.svg', alt: 'Ilustración de la barra y el café — sustituye por foto propia del local' },
	{ src: '/fotos/platos.svg', alt: 'Ilustración de platos de cocina española — sustituye por foto propia' },
	{ src: '/fotos/comedor.svg', alt: 'Ilustración del comedor — sustituye por foto propia' },
	{ src: '/fotos/terraza.svg', alt: 'Ilustración de la terraza — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Peña de Cazadores?',
		a: 'En Av. de Buenavista, 30, 11150 Vejer de la Frontera (Cádiz), en la zona de Buenavista.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Lunes y de miércoles a domingo de 8:00 a 24:00; los martes cierra. Conviene confirmar en el 956 44 73 18 en festivos.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'Es un café bar y mesón de barrio. Para grupos o fin de semana, llama al 956 44 73 18.',
	},
	{
		q: '¿Qué se puede tomar?',
		a: 'Café bar desde primera hora y mesón de cocina española para mediodía y noche: desayunos, tapas, raciones y platos.',
	},
	{
		q: '¿Tiene terraza?',
		a: 'Sí, terraza en la avenida para disfrutar del buen tiempo.',
	},
];

const description =
	'Restaurante Peña de Cazadores: café bar y mesón de cocina española en Av. de Buenavista, 30 (Vejer). De 8:00 a 24:00, martes cerrado. Tel. 956 44 73 18.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: 'Café Bar Peña de Cazadores',
	description,
	url: `${business.site}/`,
	telephone: '+34 956 44 73 18',
	image: [`${business.site}/fotos/meson.svg`],
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Tapas', 'Mediterránea'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '08:00',
			closes: '24:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Bar y cafetería', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="Restaurante Peña de Cazadores: café bar y mesón de cocina española en Av. de Buenavista, 30 (Vejer). De 8:00 a 24:00, martes cerrado. 956 44 73 18." />
		<meta name="keywords" content="Peña de Cazadores Vejer, mesón Vejer Frontera, café bar Buenavista Vejer, comer Vejer centro, Av Buenavista 30 restaurante, desayunos Vejer" />
		<meta name="author" content="Restaurante Peña de Cazadores" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>Peña de Cazadores | Mesón y café bar en Vejer</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Peña de Cazadores · Mesón español en Vejer de la Frontera" />
		<meta property="og:description" content="Café bar desde las 8:00 y mesón de cocina española en Av. de Buenavista, 30 (Vejer). Martes cerrado." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/meson.svg`} />
		<meta property="og:image:alt" content="Restaurante Peña de Cazadores, mesón en Vejer de la Frontera" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Peña de Cazadores · Mesón y café bar en Vejer" />
		<meta name="twitter:description" content="Cocina española en Av. de Buenavista, 30, Vejer. De 8:00 a 24:00." />
		<meta name="twitter:image" content={`${business.site}/fotos/meson.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Vejer de la Frontera" />
		<meta name="geo.position" content="36.2497443;-5.9684778" />
		<meta name="ICBM" content="36.2497443, -5.9684778" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Peña de Cazadores, inicio">
				<span class="brand-mark" aria-hidden="true">PC</span>
				<span class="brand-name">Peña de Cazadores <small>Vejer · Buenavista</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#meson">El mesón</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>956 44 73 18</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Av. de Buenavista, 30 · Vejer</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Café bar y mesón de cocina española en Buenavista: desayunos por la mañana, tapas al
						mediodía y platos por la noche. De lunes y miércoles a domingo, hasta las 24:00.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 956 44 73 18</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>8–24</b> todos los días*</li>
						<li>Martes cerrado</li>
						<li>Terraza</li>
						<li>Café bar</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/fotos/meson.svg" alt="Ilustración del mesón Peña de Cazadores en Vejer de la Frontera" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Av. Buenavista 30 · Vejer</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>16h</b><span>Jornada diaria</span></div>
					<div><b>6d</b><span>Días/semana</span></div>
					<div><b>Bar</b><span>Y mesón</span></div>
				</div>
				<ul class="services">
					<li>Café bar</li>
					<li>Desayunos</li>
					<li>Tapas</li>
					<li>Comedor</li>
					<li>Terraza</li>
					<li>Reservas</li>
				</ul>
			</section>

			<section class="about section-pad" id="meson">
				<p class="section-label"><span aria-hidden="true"></span> Un mesón en Buenavista</p>
				<div class="about-grid">
					<h2>Desayuno, tapeo<br />y cena <em>en el barrio.</em></h2>
					<div class="about-copy">
						<p>
							Peña de Cazadores es un café bar y restaurante de cocina española en Av. de Buenavista, 30,
							Vejer de la Frontera. Abre a las 8:00 y aguanta hasta las 24:00: desayunos, mediodía,
							tardeo y cena en el mismo sitio.
						</p>
						<p>
							Barra para el café de la mañana, comedor para mediodía y noche, y terraza en la avenida
							para el buen tiempo. Cocina española sin complicaciones.
						</p>
						<p class="about-note">
							Cierra los martes. El resto de la semana, jornada completa de 8:00 a 24:00. En festivos,
							llama antes al 956 44 73 18.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que hay<br /><em>en la barra.</em></h2>
					</div>
					<p>
						Familias genéricas de café bar y mesón español según su ficha pública. Confirma la carta
						del día en el propio local.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El mesón<br /><em>por dentro.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del local.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Av. de Buenavista, 30</p>
					<h2>Ven a desayunar<br /><em>y quédate.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes y mié–dom</th>
								<td>8:00 – 24:00</td>
							</tr>
							<tr>
								<th scope="row">Martes</th>
								<td>Cerrado</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Horario según directorios públicos (2026). En festivos, llama antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al mesón ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 956 44 73 18</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de Peña de Cazadores en Av. de Buenavista 30, Vejer de la Frontera" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Peña de Cazadores · Vejer</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">PC</span>
				<p>Peña de Cazadores<small>{business.street} · {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del mesón">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Peña de Cazadores · Vejer de la Frontera. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al mesón <span>956 44 73 18</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34956447318?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Restaurante%20Pe%C3%B1a%20de%20Cazadores." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Restaurante Peña de Cazadores"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
