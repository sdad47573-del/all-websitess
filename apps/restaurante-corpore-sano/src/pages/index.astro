---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/restaurante-corpore-sano-apaisada-01.jpg';
import arroz from '../assets/fotos/restaurante-corpore-sano-vertical-08.jpg';
import pulpo from '../assets/fotos/restaurante-corpore-sano-vertical-04.jpg';
import ensalada from '../assets/fotos/restaurante-corpore-sano-cuadrada-05.jpg';
import bonito from '../assets/fotos/restaurante-corpore-sano-vertical-09.jpg';
import angus from '../assets/fotos/restaurante-corpore-sano-cuadrada-10.jpg';
import sopa from '../assets/fotos/restaurante-corpore-sano-cuadrada-07.jpg';

import { cidUrl, mapsUrl, placeId, reviewsUrl } from '../maps';

const business = {
	name: 'RESTAURANTE CORPORE SANO',
	brand: 'Corpore Sano',
	street: "Carrer d'Onda, 36",
	city: 'Castelló de la Plana',
	region: 'Castelló',
	postalCode: '12006',
	phone: '651 40 50 59',
	latitude: 39.9792544,
	longitude: -0.0514062,
	rating: 4.4,
	reviewsCount: 1038,
	site: 'https://restaurante-corpore-sano.vercel.app',
};

const whatsappUrl = 'https://wa.me/+34651405059';
const whatsappText = 'https://wa.me/34651405059?text=Hola%2C%20quiero%20reservar%20en%20Corpore%20Sano';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34651405059';

const description =
	"Corpore Sano, restaurante de comida sin gluten y cocina mediterránea en la calle Onda, 36, Castellón: platos de temporada, terraza y reservas por WhatsApp.";

const servicios = [
	'Sin gluten',
	'Cocina mediterránea',
	'Comida saludable',
	'Terraza',
	'Acceso adaptado',
	'Aseo adaptado',
	'Asientos adaptados',
	'Reservas por WhatsApp',
];

const grupos = [
	{
		title: 'Para empezar',
		items: [
			{
				name: 'Ensalada de gambón',
				note: 'con mango, aguacate, fresa y vinagreta de módena',
			},
			{
				name: 'Sopa fría de sandía',
				note: 'con feta desmigado, hojas de albahaca y pipas',
			},
			{
				name: 'Picoteo de la casa',
				note: '«picoteo muy rico y cerveza bien fría», dice una reseña',
			},
		],
	},
	{
		title: 'Del mar y de la brasa',
		items: [
			{
				name: 'Arroz negro',
				note: 'con almejas y calamar, servido en la cazuela de barro',
			},
			{
				name: 'Pulpo con patata',
				note: 'sobre patata panadera, con pimentón y crema de hummus',
			},
			{
				name: 'Lomo de bonito con mojo verde',
				note: 'sobre pan tostado, con tomate asado',
			},
			{
				name: 'Aguja de black Angus',
				note: 'a la parrilla con patatas panadera y verduras',
			},
			{
				name: 'Salmón con costra almendrada',
				note: 'con arroz, algas y salsa dulce, según una reseña',
			},
		],
	},
];

const galeria = [
	{
		src: arroz,
		alt: 'Arroz negro con almejas y calamar en cazuela de barro de Corpore Sano',
	},
	{
		src: pulpo,
		alt: 'Pulpo sobre patata con hummus y pimentón en Corpore Sano, Castellón',
	},
	{
		src: ensalada,
		alt: 'Ensalada de gambón con mango, aguacate y fresa de Corpore Sano',
	},
	{
		src: bonito,
		alt: 'Lomo de bonito con mojo verde y tomate asado de Corpore Sano',
	},
	{
		src: angus,
		alt: 'Aguja de black Angus con patatas panadera de Corpore Sano',
	},
	{
		src: sopa,
		alt: 'Sopa fría de sandía con feta y albahaca de Corpore Sano',
	},
];

const faqs = [
	{
		q: '¿Dónde está Corpore Sano?',
		a: 'En el número 36 de la calle Onda, en Castellón de la Plana (12006). La fachada es de piedra blanca con un arco en la entrada y el letrero «Corpore Sano» sobre el toldo; la terraza ocupa la acera. El botón «Cómo llegar» abre la ruta exacta en Google Maps.',
	},
	{
		q: '¿Es un restaurante sin gluten?',
		a: 'Sí: la ficha de Google lo clasifica como «restaurante de comida sin gluten» y la primera reseña que destaca es «buen producto sin gluten». La cocina se plantea entera en clave mediterránea y sin gluten. Si eres celíaco o tienes otra alergia, dínoslo al reservar: conviene confirmar el protocolo de la cocina antes de la visita.',
	},
	{
		q: '¿Qué horario tiene?',
		a: 'De lunes a jueves abre de 9:30 a 17:00 y el miércoles descansa. Los viernes alarga hasta las 24:00, el sábado abre de 10:30 a 24:00 y el domingo, de 10:30 a 17:00. Son horarios publicados en Google y pueden cambiar en fiestas: el teléfono es el 651 40 50 59.',
	},
	{
		q: '¿Tienen menú del día?',
		a: 'La ficha de Google no publica ni la carta ni el precio del menú, y esta web no inventa importes. Los platos que aparecen aquí son los de sus propias fotos y los que citan las reseñas. Para saber qué hay hoy y cuánto cuesta, se pregunta por teléfono o por WhatsApp.',
	},
	{
		q: '¿Cómo se reserva?',
		a: 'Por teléfono, en el 651 40 50 59, o por WhatsApp en el mismo número, que es el canal que usa el restaurante en su ficha. Esta web no tiene formulario ni reserva online. Para grupos y fines de semana, mejor avisar con unos días.',
	},
	{
		q: '¿Hay terraza?',
		a: 'Sí. En la foto de la ficha se ven las mesas y sillas de exterior bajo una sombrilla, pegadas a la fachada de piedra de la calle Onda. Es terraza de acera, así que en verano conviene reservar la mesa de fuera.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'La ficha de Google marca acceso, aseo y asientos adaptados para sillas de ruedas. La terraza está al nivel de la acera, y si necesitas ayuda para entrar, avisa al reservar por teléfono o WhatsApp y se prepara la entrada.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['Corpore Sano', 'Corpore Sano Castellón', 'Restaurante Corpore Sano'],
	slogan: 'Cocina mediterránea sin gluten',
	description,
	url: `${business.site}/`,
	telephone: '+34 651 40 50 59',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Mediterránea', 'Sin gluten', 'Saludable', 'Cocina de temporada'],
	areaServed: [
		{ '@type': 'City', name: 'Castelló de la Plana' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl, whatsappUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: '0xd60009e783b0c8b:0x43eca4acb379bcac' },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday'],
			opens: '09:30',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '09:30',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '10:30',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '10:30',
			closes: '17:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Corpore Sano · Cocina mediterránea sin gluten en Castellón</title>
		<meta name="theme-color" content="#3c4732" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Karla:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Corpore Sano, restaurante sin gluten Castellón, comida saludable Castellón, restaurante mediterráneo Castellón, calle Onda 36, terraza, celiacos, menú sin gluten, Plana Alta"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Corpore Sano · Cocina mediterránea sin gluten en Castellón"
			ogDescription="Arroz negro, pulpo con hummus y aguja de Angus sin gluten, con terraza en la calle Onda. 4,4 en Google con 1.038 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Arroz negro con almejas y calamar de Corpore Sano"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#3c4732"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Castelló de la Plana, Castelló"
			contact={{
				street: business.street,
				locality: business.city,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[fachada]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="CS"
			name={business.brand}
			subtitle="Sin gluten · Mediterráneo"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer d'Onda, 36 · Castelló"
				title="Cocina mediterránea,<br /><em>sin gluten.</em>"
				lede="Corpore Sano es un restaurante de comida saludable en la calle Onda, en Castellón: arroces, pescado, brasa y verduras, todo en clave mediterránea y sin gluten, con terraza bajo el arco de piedra de su fachada."
				image={fachada}
				imageAlt="Fachada de piedra con el letrero Corpore Sano y la terraza en la calle Onda, Castellón"
				primaryCta={{ label: 'Reservar por WhatsApp', href: whatsappText }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4 en Google</b> con 1.038 reseñas' },
					{ label: 'Miércoles', html: '<b>Cerrado</b>' },
					{ label: 'Viernes y sábado', html: '<b>Hasta las 24:00</b>' },
					{ label: 'La cocina', html: '<b>Sin gluten</b>' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Corpore Sano" items={servicios} />

			<LocalAbout
				label="Mens sana in corpore sano"
				title="Comer bien,<br />sin gluten,<br /><em>en Castellón.</em>"
				paragraphs={[
					'El nombre viene de la frase latina completa, «mens sana in corpore sano», y resume la idea de la casa: comida que sienta bien, con el producto mediterráneo como base y sin que el gluten entre en la ecuación. La ficha de Google no lo describe como una carta con alternativas, sino como un restaurante de comida sin gluten.',
					'La cocina trabaja con arroces y pescado —el arroz negro con almejas y calamar, el pulpo sobre patata con hummus, el bonito con mojo verde—, con brasa para la aguja de Angus y con entrantes frescos como la ensalada de gambón con mango y aguacate o la sopa fría de sandía con feta.',
					'El local está en el número 36 de la calle Onda, en un bajo de piedra blanca con la terraza en la acera. Abre todos los días menos el miércoles, con mediodías de 9:30 a 17:00 y noches de viernes y sábado hasta medianoche. La ficha suma 1.038 opiniones con un 4,4.',
				]}
				note="«Buena cocina, buen trato, buen producto sin gluten además de un trato excelente», dice una de las reseñas. Otra: «super exquisito, salmón con costra almendrada, arroz, algas y salsa dulce»."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Del mar,<br /><em>de la huerta.</em>"
				description="La ficha de Google no publica la carta, así que esta selección sale de lo que aparece en sus fotos y de lo que citan sus reseñas: los platos de la casa, en clave mediterránea y sin gluten."
				cta={{ label: 'Preguntar el menú de hoy', href: whatsappText }}
				groups={grupos}
				note="Sin precios: la ficha no los publica y esta web no los inventa. El menú de cada día, las raciones y los importes se consultan por teléfono o WhatsApp en el 651 40 50 59, indicando si hay celiaquía o alguna alergia."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El plato,<br />el producto<br /><em>y el fuego.</em>"
				description="Estas fotografías proceden del perfil de RESTAURANTE CORPORE SANO en Google Maps: el arroz negro en su cazuela, el pulpo con hummus, la ensalada de gambón, el bonito con mojo verde, la aguja de Angus y la sopa fría de sandía."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer d'Onda, 36 · 12006 Castelló"
				title="Te esperamos<br /><em>en la calle Onda.</em>"
				addressLines={[business.street, `${business.postalCode} ${business.city}`, 'Castelló, España']}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: '9:30 – 17:00' },
					{ day: 'Martes', value: '9:30 – 17:00' },
					{ day: 'Miércoles', value: 'Cerrado', closed: true },
					{ day: 'Jueves', value: '9:30 – 17:00' },
					{ day: 'Viernes', value: '9:30 – 24:00' },
					{ day: 'Sábado', value: '10:30 – 24:00' },
					{ day: 'Domingo', value: '10:30 – 17:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google: cierra los miércoles y abre de 9:30 a 17:00 de lunes a jueves. En fiestas y en verano suele cambiar, así que conviene llamar antes."
				mapTitle="Mapa de Corpore Sano en la calle Onda, 36, Castellón"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Corpore Sano · Castellón"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Escribir por WhatsApp', href: whatsappText, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Se reserva por teléfono o por WhatsApp en el 651 40 50 59; no hay reserva online ni formulario en esta web. Si vienes por celiaquía o alergias, avísalo al reservar. La ficha marca acceso, aseo y asientos adaptados."
			/>

			<LocalFaq items={faqs} title="Antes de <em>sentarse.</em>" />
		</main>

		<LocalFooter
			mark="CS"
			name="Corpore Sano"
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: 'WhatsApp ↗', href: whatsappUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Corpore Sano"
		/>
	</body>
</html>
