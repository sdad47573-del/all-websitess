	},
	{
		src: vasoHelado,
		alt: 'Vaso de helado de Amorato con la marca del local, heladería artesanal en Málaga',
	},
	{
		src: tartaPistacho,
		alt: 'Tarta de pistacho con fresas de Amorato, pastelería artesanal en Teatinos, Málaga',
	},
	{
		src: tartaArtesanal,
		alt: 'Tarta de crema de Amorato, pastelería artesanal en el barrio de Teatinos, Málaga',
