	name: 'Amorato',
	tagline: 'Heladería, cafetería y pastelería artesanal en Teatinos',
	street: 'C. Escritora Carmen Conde, 3',
	district: 'Teatinos-Universidad',
	city: 'Málaga',
	postalCode: '29010',
	phone: '689 34 43 76',
	latitude: 36.725062,
	longitude: -4.473187,
	rating: 4.8,
	reviewsCount: 303,
	site: 'https://amorato-malaga.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd72f73840fb1717:0xfe8e67b154157664';
const cidDecimal = '18342712343644173924';
const placeId = 'ChIJFxf7QDj3cg0RZHYVVLFnjv4';
const instagram = 'https://www.instagram.com/amorato_malaga/';

const mapsUrl = `https://www.google.com/maps/place/?q=place_id:${placeId}&hl=es`;
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34689344376';

const description =
	'Amorato es heladería, cafetería y pastelería artesanal en C. Escritora Carmen Conde, 3 (Teatinos, Málaga). Helado artesanal con más de 20 sabores sin gluten, tartas, medialunas, alfajores y desayunos. 4,8 en Google. Tel. 689 34 43 76.';

const servicios = [
	'Helado artesanal',
	'Más de 20 sabores sin gluten',
	'Opciones sin azúcar',
	'Opciones sin lactosa',
	'Helados proteicos',
	'Pastelería artesanal',
	'Tartas por encargo',
	'Dulces argentinos',
	'Medialunas y alfajores',
	'Cafetería',
	'Desayunos',
	'Meriendas',
	'Bocadillos y sándwiches',
	'Cajas para regalo',
	'Terraza',
	'Barrio de Teatinos',
];

const grupos = [
	{
		title: 'Helado artesanal',
		items: [
			{
				name: 'Sabores clásicos y de temporada',
				note: 'pistacho, vainilla, chocolate, frutos rojos y otros ligados a tendencias',
			},
			{ name: 'Más de veinte sabores sin gluten', note: 'elaborados también a diario en el obrador' },
			{ name: 'Sin azúcar y sin lactosa', note: 'con versiones proteicas para un público deportivo' },
			{ name: 'El sabor Amorato', note: 'crema de fresa, bizcocho y salsa de fresa' },
			{ name: 'Franui y frambuesas con chocolate', note: 'sabores inspirados en lo que se viraliza' },
