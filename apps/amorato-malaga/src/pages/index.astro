			{ name: 'Vigilantes y facturas', note: 'dulces argentinos más airados y esponjosos' },
			{ name: 'Napoleana', note: 'la bollería clásica malagueña, junto al resto de la vitrina' },
			{ name: 'Tartas artesanales', note: 'para cumpleaños y celebraciones, también por encargo' },
		],
	},
	{
		title: 'Cafetería y desayunos',
		items: [
			{ name: 'Café y desayuno', note: 'con croissants, napolitanas y medialunas recién hechas' },
			{ name: 'Desayunos con pitufo', note: 'con pan de la panadería Serrano, de la propia zona' },
			{ name: 'Bocadillos y sándwiches', note: 'entre otros, el sándwich de miga argentino' },
			{ name: 'Brownies y cookies', note: 'y una selección de los dulces de la vitrina' },
			{ name: 'Meriendas', note: 'zumos naturales y café de especialidad' },
		],
	},
	{
		title: 'Regalos y encargos',
		items: [
			{ name: 'Cajas para regalo', note: 'con dulces variados, zumo natural y mensaje personalizado' },
			{ name: 'Tartas por encargo', note: 'para cumpleaños y celebraciones' },
			{ name: 'Encargos por teléfono', note: 'llama al 689 34 43 76 para preparar el pedido' },
		],
	},
];

const galeria = [
	{
		src: vitrinaTartas,
		alt: 'Vitrina de tartas y pasteles artesanales de Amorato, pastelería en Teatinos, Málaga',
	},
	{
		src: vitrinaHelados,
		alt: 'Vitrina de helados artesanales de Amorato, heladería en Teatinos, Málaga',
	},
	{
