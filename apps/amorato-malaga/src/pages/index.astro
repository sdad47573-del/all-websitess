	{
		src: alfajores,
		alt: 'Alfajores argentinos de maicena de Amorato, pastelería artesanal en Teatinos, Málaga',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo de desayuno servido en Amorato, cafetería en Teatinos, Málaga',
	},
	{
		src: sandwich,
		alt: 'Sándwich a la plancha servido en Amorato, cafetería en Teatinos, Málaga',
	},
	{
		src: desayuno,
		alt: 'Desayuno con bocadillo, café con leche y zumo de naranja en Amorato, Teatinos, Málaga',
	},
	{
		src: desayunoCroissant,
		alt: 'Mesa con desayuno, croissant y café en Amorato, cafetería de Teatinos, Málaga',
	},
	{
		src: cafeCroissant,
		alt: 'Café con leche junto a un croissant en Amorato, cafetería y pastelería en Málaga',
	},
	{
		src: cafeConLeche,
		alt: 'Café con leche servido en Amorato, cafetería artesanal en Teatinos, Málaga',
	},
	{
		src: terraza,
		alt: 'Terraza de Amorato con mesas en la calle Escritora Carmen Conde, Teatinos, Málaga',
	},
];

const faqs = [
	{
		q: '¿Dónde está Amorato?',
		a: 'En la calle Escritora Carmen Conde, 3, en el barrio de Teatinos-Universidad (29010 Málaga), muy cerca de la Universidad. Es un local renovado por completo que combina heladería, cafetería y pastelería.',
	},
	{
		q: '¿Cuál es el horario de Amorato?',
		a: 'Los martes, miércoles, jueves y domingo abre de 8:00 a 23:30. Los viernes y sábados, de 8:00 a 1:00 de la madrugada. Los lunes está cerrado. En festivos puede cambiar, así que llama antes si vienes de lejos.',
	},
	{
		q: '¿El helado es artesanal?',
		a: 'Sí. En el obrador de Teatinos se fabrica helado todos los días para conservar la frescura y la cremosidad. Hay sabores clásicos, otros ligados a tendencias actuales y creaciones propias, como el sabor Amorato, de crema de fresa, bizcocho y salsa de fresa.',
	},
	{
		q: '¿Hay helado sin gluten, sin azúcar o sin lactosa?',
		a: 'Sí. Amorato ofrece más de veinte sabores de helado sin gluten y también opciones sin azúcar, sin lactosa y versiones proteicas pensadas para un público más deportivo.',
	},
	{
		q: '¿Qué es una factura argentina?',
		a: 'Es el nombre con el que en Argentina se conoce a distintos dulces y piezas de bollería que en Amorato sirven: medialunas, vigilantes, alfajores y otras preparaciones. Son más airadas y esponjosas que la bollería convencional.',
	},
	{
		q: '¿Puedo pedir tartas o cajas para regalo?',
		a: 'Sí. Se preparan cajas con dulces variados, zumo natural y mensaje personalizado, y tartas artesanales por encargo para cumpleaños y celebraciones. Lo mejor es llamar al 689 34 43 76 con antelación para poder prepararlo.',
	},
	{
		q: '¿Sirven desayuno y merienda?',
		a: 'Sí. Abre desde las 8:00, así que se puede desayunar con pitufo, croissant o napolitana, tomar café o merendar con helado y dulce. También hay bocadillos, sándwiches y zumos naturales.',
	},
	{
		q: '¿Se puede comer dentro o hay terraza?',
		a: 'Cuenta con sala y mesas para tomar el café o el helado con calma, y con terraza en la calle. La iluminación cálida y los tonos claros del local se han pensado para que se pueda estar a cualquier hora.',
	},
	{
		q: '¿Por qué se llama Amorato?',
		a: 'Es un juego de palabras entre amor y gelato, según explican sus creadores. La marca resume la idea del local: una heladería artesanal que además ofrece pastelería, dulces argentinos y cafetería.',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': ['IceCreamShop', 'CafeOrCoffeeShop', 'Bakery'],
	'@id': `${business.site}/#negocio`,
	name: business.name,
	alternateName: [
		'Amorato Heladería',
		'Amorato cafetería',
		'Amorato pastelería',
		'Amorato Teatinos',
	],
	slogan: 'Sabor a primera vista',
	description,
	url: `${business.site}/`,
	telephone: '+34 689 34 43 76',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Heladería', 'Cafetería', 'Pastelería', 'Dulces argentinos', 'Desayunos'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	image: `${business.site}/og.jpg`,
	sameAs: [mapsUrl, instagram],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday'],
			opens: '00:00',
			closes: '00:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Sunday'],
			opens: '08:00',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '08:00',
			closes: '01:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Helado artesanal', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Sabores sin gluten', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Opciones sin azúcar y sin lactosa', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Pastelería artesanal', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Desayunos y meriendas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Amorato · Heladería y pastelería artesanal en Teatinos, Málaga</title>
		<meta name="theme-color" content="#157a72" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="heladería Teatinos, Amorato Málaga, helado artesanal Málaga, pastelería Teatinos, cafeteria Teatinos, medialunas Málaga, alfajores Málaga, dulces argentinos Málaga, tartas por encargo Teatinos, helado sin gluten Málaga, desayuno Teatinos, Escritora Carmen Conde 3, cafetería 29010 Málaga"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Amorato · Heladería, cafetería y pastelería artesanal en Teatinos, Málaga"
			ogDescription="Helado artesanal con más de 20 sabores sin gluten, tartas, medialunas, alfajores y desayunos en C. Escritora Carmen Conde, 3, Teatinos. 4,8 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Interior de Amorato, heladería, cafetería y pastelería artesanal en Teatinos, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#157a72"
			street={business.street}
			city={business.city}
			region="Andalucía"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Teatinos-Universidad, Málaga"
			contact={{
				street: business.street,
				locality: business.city,
				region: 'Andalucía',
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[heroImage]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://amorato-malaga.vercel.app/og.jpg" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.725062;-4.473187" />
		<meta name="ICBM" content="36.725062, -4.473187" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="A"
			name="Amorato"
			subtitle="Heladería · Pastelería"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Teatinos · Málaga"
				title="Helado artesanal,<br /><em>tartas y dolce.</em>"
				lede="Amorato es heladería, cafetería y pastelería artesanal en la calle Escritora Carmen Conde, 3, en pleno Teatinos. Más de veinte sabores de helado sin gluten, dulces argentinos como medialunas y alfajores, tartas, desayunos y café desde las ocho de la mañana. 4,8 en Google con más de 300 reseñas."
				image={heroImage}
				imageAlt="Interior de Amorato con las mesas y la vitrina del local en Teatinos, Málaga"
				primaryCta={{ label: 'Llamar 689 34 43 76', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,8</b> en Google (303 reseñas)' },
					{ label: 'Horario', html: 'Martes a jueves, 8:00–23:30' },
					{ label: 'Viernes y sábado', html: 'De 8:00 a <b>1:00</b> de la madrugada' },
					{ label: 'Especialidad', html: 'Helado <b>sin gluten</b> y dulces argentinos' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Amorato" items={servicios} />

			<LocalAbout
				label="Heladería y pastelería"
				title="Un obrador<br /><em>en Teatinos.</em>"
				paragraphs={[
					'Amorato ocupa la calle Escritora Carmen Conde, 3, un local de Teatinos-Universidad que se ha renovado por completo y que reúne en el mismo sitio una heladería, una cafetería y una pastelería. La idea es sencilla: no depender solo de la temporada del helado.',
					'El helado se fabrica cada día en el obrador para conservar la frescura y la cremosidad. Hay sabores clásicos y otros ligados a tendencias actuales, con más de veinte opciones sin gluten y también sin azúcar, sin lactosa y con proteína.',
					'El otro gran argumento son los dulces argentinos: medialunas rellenas de dulce de leche, crema pastelera o chocolate, alfajores de maicena o chocolate blanco y los llamados vigilantes: unas facturas más airadas y esponjosas que la bollería habitual.',
					'Y como se trata también de una cafetería, hay desayunos, meriendas, bocadillos, sándwiches, brownies y cookies, zumos naturales y cajas para regalo con mensaje personalizado. La sala es luminosa y hay terraza en la calle.',
				]}
				note="La nota media en Google es de 4,8 sobre 303 reseñas. Lo que más se repite es el helado, la calidad de los dulces y el trato del equipo, además de la limpieza del local y el ambiente acogedor."
				links={[
					{ label: 'Ficha y reseñas en Google', href: cidUrl, external: true },
					{ label: 'Instagram @amorato_malaga', href: instagram, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Helado, bollería<br /><em>y repostería.</em>"
				description="Selección de lo que se sirve en Amorato, tomada de la ficha de Google Maps y de la prensa local. La carta cambia con frecuencia, así que confírmala en el local o por teléfono."
				cta={{ label: 'Llamar para preguntar', href: phoneHref }}
				groups={grupos}
				note="Los precios y la disponibilidad cambian: el helado se fabrica a diario y los sabores rotan. Para encargos de tartas o cajas para regalo, llama al 689 34 43 76 con antelación."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La vitrina,<br /><em>la mesa y el local.</em>"
				description="Estas fotografías proceden del perfil de Amorato en Google Maps, con imágenes de la ficha y de sus clientes. En la ficha del local están todas las fotos y las reseñas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del local en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="C. Escritora Carmen Conde, 3 · 29010 Málaga"
				title="Nos vemos<br /><em>en Teatinos.</em>"
				addressLines={[
					business.street,
					business.district,
					`${business.postalCode} ${business.city}, España`,
				]}
				hours={[
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: '8:00–23:30' },
					{ day: 'Miércoles', value: '8:00–23:30' },
					{ day: 'Jueves', value: '8:00–23:30' },
					{ day: 'Viernes', value: '8:00–1:00' },
					{ day: 'Sábado', value: '8:00–1:00' },
					{ day: 'Domingo', value: '8:00–23:30' },
				]}
				hoursNote="Horario publicado en la ficha de Google. Los viernes y sábados cierra de madrugada, a la una. Puede variar en festivos, así que llama antes si vienes de lejos."
				mapTitle="Mapa de Amorato en la calle Escritora Carmen Conde, 3, Teatinos-Universidad, Málaga"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Amorato · Teatinos"
				mapHref={cidUrl}
				links={[{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' }]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="No hay reserva en línea: es un local de sala, mesas y terraza por orden de llegada. Para encargos de tartas, cajas para regalo o grupos, llama al 689 34 43 76."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="A"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Instagram ↗', href: instagram, external: true },
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: cidUrl, external: true },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Amorato"
		/>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>