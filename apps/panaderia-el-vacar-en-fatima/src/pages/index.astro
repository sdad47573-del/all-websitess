---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/panaderia-el-vacar-en-fatima-apaisada-01.jpg';
import tienda from '../assets/fotos/panaderia-el-vacar-en-fatima-vertical-07.jpg';
import tostada from '../assets/fotos/panaderia-el-vacar-en-fatima-vertical-02.jpg';
import sala from '../assets/fotos/panaderia-el-vacar-en-fatima-apaisada-09.jpg';
import desayuno from '../assets/fotos/panaderia-el-vacar-en-fatima-apaisada-03.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería el Vacar en Fátima · Masa madre, ibéricos y cafetería';
const description =
	'Panadería el Vacar en Fátima, en la calle Guaraní, 8 (Levante, 14014 Córdoba). Pan tradicional de masa madre, ibéricos de la tierra, dulces y cafetería. De lunes a viernes de 7:30 a 15:00 y de 17:00 a 21:00.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#el-vacar`,
	name: BUSINESS.name,
	alternateName: ['El Vacar en Fátima', 'Panadería El Vacar', 'Cafetería El Vacar Córdoba'],
	description:
		'Panadería y cafetería en la calle Guaraní, 8 (Levante, 14014 Córdoba), con pan de masa madre, ibéricos de la provincia, dulces tradicionales y tostados.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34957440254',
	servesCuisine: ['Panadería', 'Cafetería'],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:30',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '17:00',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '08:00',
			closes: '15:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: tienda,
		alt: 'Interior de la tienda con panes en bolsas de El Vacar y la vitrina de ibéricos y conservas',
	},
	{
		src: tostada,
		alt: 'Tostada de pan de masa madre con tomate rallado y jamón, con el aceite aparte',
	},
	{
		src: sala,
		alt: 'Sala de la cafetería con mesas de madera, vitrina de bollería y la barra al fondo',
	},
	{
		src: desayuno,
		alt: 'Desayuno en la terraza con café, tostada de tomate y jamón y la aceitera',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#4a2f22" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..600;1,400..600&family=Source+Sans+3:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería el Vacar en Fátima, pan de masa madre Córdoba, panadería Levante Córdoba, ibéricos Córdoba, cafetería Córdoba, 14014"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan de masa madre, ibéricos de la provincia, dulces tradicionales y cafetería en Guaraní, 8 (14014 Córdoba). Abre todos los días. 4,5 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Desayuno de El Vacar: café con leche, tostada de masa madre con tomate y jamón"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#4a2f22"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Panadería · Cafetería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Levante · 14014 Córdoba"
				title="El Vacar, <br /><em>en Fátima.</em>"
				lede={`En la calle Guaraní, 8, hay una panadería con el rótulo de «Maestros Panaderos desde 1862» y «MASA MADRE DE CULTIVO» bajo el toldo. Dentro hay pan de masa madre en varios modelos, una vitrina de ibéricos de la provincia, dulces tradicionales y cafetería con tostados. Abre todos los días por la mañana y, de lunes a viernes, también por la tarde. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={fachada}
				imageAlt="Fachada de Panadería el Vacar en Fátima con el rótulo El Vacar, Panadería Cafetería y Masa Madre de Cultivo"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5</b> en Google · 406 reseñas' },
					{ label: 'Horario', html: '<b>L–V</b> 7:30–15:00 y 17:00–21:00' },
					{ label: 'Zona', html: '<b>Levante</b> · 14014' },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Masa madre · ibéricos · cafetería"
			/>

			<LocalChips label="Lo que hay en El Vacar" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Pan de masa madre <br /><em>y productos de la tierra.</em>"
				paragraphs={[
					'Panadería el Vacar en Fátima está en la calle Guaraní, 8, en el distrito Levante de Córdoba (14014). La fachada lleva el rótulo de «El Vacar · Panadería Cafetería», con el sello de «Maestros Panaderos desde 1862» y el aviso de «masa madre de cultivo» bajo el toldo de rayas.',
					'La propia ficha del negocio explica de dónde sale todo: «nos dedicamos a la venta de productos artesanos de la tierra». Los ibéricos vienen de Fuente Obejuna, Zuheros, Villaviciosa y Espejo, y el pan se elabora con masa madre de cultivo en modelos integral, multsemillas, centeno, espelta y maíz, «y muchos más».',
					'En la parte dulce apuestan por «lo más tradicional y sabores de antaño»: bollería con la crema naranja de toda la vida y también sabores modernos como Kinder y Nocilla. Todo eso se sirve en la cafetería, con barra, mesas y terraza.',
					'Las reseñas lo confirman: «tienen también productos ibéricos de la zona y dulces muy buenos para merendar», «buen sitio para desayunar, tomar cerveza y tapitas» y «todo estaba buenísimo, cualquier tostado o pastelería».',
				]}
				note="La ficha de Google publica la categoría, la dirección, el teléfono, el horario y la descripción del negocio, pero no carta, precios ni métodos de pago. El surtido que se describe aquí es el de esa descripción, las fotos del perfil y las reseñas."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Llamar al 957 44 02 54', href: BUSINESS.phoneHref },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Masa madre, <br />
							<em>ibéricos y dulces.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Del obrador <br /><em>a la cafetería.</em>"
				description="Sin precios publicados: esto es lo que anuncia la ficha del negocio y lo que cuentan las reseñas de Google."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={MENU_GROUPS}
				note="La ficha no publica carta ni precios, así que esta web no indica importes. Hay tienda para llevar y cafetería con mesas y terraza."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La casa, <br /><em>por dentro.</em>"
				description="Cuatro fotos de la ficha de Google Maps: la tienda, la tostada, la sala y el desayuno."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la calle <br /><em>Guaraní.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de Panadería el Vacar en Fátima en la calle Guaraní, Córdoba"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Panadería el Vacar en Fátima · Levante"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
				]}
				contactLink={{ label: 'Abrir en Google Maps ↗', href: MAPS.place, external: true }}
				reserveNote="El teléfono de la ficha es el 957 44 02 54. No publica web propia ni redes. Indica acceso para sillas de ruedas y aseo adaptado; no hay aparcamiento accesible."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Ver en Google Maps"
			navAriaLabel="Enlaces de Panadería el Vacar en Fátima"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
