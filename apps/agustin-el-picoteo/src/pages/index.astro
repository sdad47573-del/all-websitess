import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/agustin-el-picoteo-malaga.jpg';
import foto1 from '../assets/fotos/agustin-el-picoteo-malaga-foto-1.jpg';
import foto2 from '../assets/fotos/agustin-el-picoteo-malaga-foto-2.jpg';
