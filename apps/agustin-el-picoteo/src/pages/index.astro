const business = {
	name: 'Agustín El Picoteo',
	tagline: 'Cocina española para picar en Teatinos',
	street: 'C. María de la Cruz, 3',
	district: 'Teatinos-Universidad (Colonia Santa Inés)',
	city: 'Málaga',
	postalCode: '29010',
	phone: '951 93 04 52',
	latitude: 36.7261752,
	longitude: -4.4689631,
	plusCode: 'PGGJ+FC Málaga',
	site: 'https://agustin-el-picoteo.vercel.app',
};

const cid = '0xd72f73a19dcc503:0xd7d1327f213afb76';
const placeId = 'ChIJA8XcGTr3cg0Rdvs6IX8y0dc';

const mapsUrl = `https://www.google.com/maps/place/Agust%C3%ADn+El+Picoteo/@${business.latitude},${business.longitude},17z/data=!3m1!4b1!4m6!3m5!1s${cid}!8m2!3d${business.latitude}!4d${business.longitude}!16s%2Fg%2F1tj22xhy`;
const cidUrl = `https://www.google.com/maps?cid=${cid}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&q=Agust%C3%ADn+El+Picoteo&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34951930452';
const instagramUrl = 'https://www.instagram.com/agustinelpicoteo/';

const description =
	'Agustín El Picoteo, cocina española y tapeo en la Colonia Santa Inés, Teatinos (Málaga): prensaíto, solomillo, revuelto de langostino y fabes con almejas. C. María de la Cruz 3. Tel. 951 93 04 52.';

const servicios = [
	'Cocina española',
	'Cocina mediterránea',
	'Tapas y raciones',
	'Producto ibérico',
	'Carta de vinos',
	'Opciones vegetarianas',
	'Para llevar',
	'Reservas',
	'Accesible por la entrada trasera',
];

const grupos = [
	{
		title: 'Para empezar',
		items: [
			{ name: 'Prensaítos y jamón ibérico', note: 'producto de bellota, de los más pedidos' },
			{
				name: 'Rebanadas de solomillo',
				note: 'carne madurada, servida con Pedro Ximénez',
			},
			{
				name: 'Revuelto de langostino y puerro',
				note: 'especialidad de la casa, muy recomendada',
			},
			{
				name: 'Aguacate con langostinos',
				note: 'ensalada de la carta más pedida',
			},
		],
	},
	{
		title: 'Platos y ibéricos',
		items: [
			{ name: 'Fabes con almejas', note: 'legumbre de guiso con almejas' },
			{ name: 'Bacalao al guiso', note: 'plato de cocina de interior' },
			{ name: 'Lomo de ibérico con foie', note: 'rebanada con foie de pato' },
			{ name: 'Solomillo y pollo en rulo', note: 'carnes elaboradas a la plancha' },
			{ name: 'Paté y patata', note: 'relleno de paté, entre los entrantes más citados' },
			{ name: 'Ensaladilla rusa y huevos de codorniz', note: 'ensaladas de la casa' },
		],
	},
	{
		title: 'Mar y postres',
		items: [
			{ name: 'Cangrejo al vodka', note: 'uno de los platos estrella' },
			{ name: 'Salmón y merluza al horno', note: 'pescado de temporada' },
			{ name: 'Profiteroles', note: 'el postre más citado de la casa' },
			{
				name: 'Postre mixto para dos',
				note: 'variedad de chocolates, milhojas y chantillies',
			},
			{
				name: 'Mermelada, buñuelos y café',
				note: 'para el cierre, con café de especialidad',
			},
		],
	},
];

const galeria = [
	{
		src: foto1,
		alt: 'Interior de Agustín El Picoteo en la calle María de la Cruz, Teatinos (Málaga)',
	},
	{
		src: foto2,
		alt: 'Platos de Agustín El Picoteo, cocina española para picar en Teatinos, Málaga',
	},
	{
		src: foto3,
		alt: 'Producto ibérico y embutidos en Agustín El Picoteo, Málaga',
	},
	{
		src: foto4,
		alt: 'Carta y tapeo de Agustín El Picoteo, restaurante en Teatinos-Universidad',
	},
	{
		src: foto5,
		alt: 'Detalle de los platos de Agustín El Picoteo, restaurante en la colonia Santa Inés, Málaga',
	},
	{
		src: foto6,
		alt: 'Raciones y tapeo de Agustín El Picoteo, Teatinos, Málaga',
	},
	{
		src: foto7,
		alt: 'Imagen de Agustín El Picoteo publicada en su ficha de Google Maps, Málaga',
	},
	{
		src: foto8,
		alt: 'Ambiente de Agustín El Picoteo, restaurante de cocina española en Teatinos',
	},
	{
		src: foto9,
		alt: 'Carnes y elaborados de Agustín El Picoteo, Málaga',
	},
	{ src: foto10, alt: 'Mesa de Agustín El Picoteo con prensaítos y embutidos' },
	{
		src: foto11,
		alt: 'Postre y café de Agustín El Picoteo, restaurante en Teatinos-Universidad, Málaga',
	},
	{
		src: foto12,
		alt: 'Servicio y sala de Agustín El Picoteo, cocina española en Málaga',
	},
	{
		src: foto13,
		alt: 'Platos de la carta de Agustín El Picoteo, restaurante de picoteo en Málaga',
	},
	{
		src: foto14,
		alt: 'Fachada y acceso de Agustín El Picoteo en María de la Cruz, 3, Málaga',
	},
	{ src: foto15, alt: 'Carta de vinos y tapeo de Agustín El Picoteo, Teatinos, Málaga' },
];

const faqs = [
	{
		q: '¿Dónde está Agustín El Picoteo?',
		a: 'En la calle María de la Cruz, 3, en el barrio de Teatinos-Universidad (29010 Málaga), en la Colonia Santa Inés, muy cerca del campus universitario y de la Ciudad de la Justicia. El local tiene dos entradas: la principal en la calle y una trasera accesible. El local no tiene terraza al aire libre.',
	},
	{
		q: '¿Cuál es el horario de El Picoteo?',
		a: 'Abre de lunes a domingo para el servicio de comida, de 13:00 a 16:30. La cena, de 20:30 a 23:30, se sirve de jueves a sábado. El martes permanece cerrado todo el día. En horario de cenas es muy habitual que se llene, así que conviene reservar con antelación.',
	},
	{
		q: '¿Qué se come en Agustín El Picoteo?',
		a: 'Es una cocina española con producto ibérico y un repertorio de picoteo elaborado. Los platos más citados en las reseñas son el prensaíto y el jamón de bellota, las rebanadas de solomillo, el revuelto de langostino y puerro, el aguacate con langostinos, las fabes con almejas, el bacalao al guiso, el cangrejo al vodka y el paté con patata. De postre, los profiteroles y un surtido de chocolates, milhojas y chantillies para compartir.',
	},
	{
		q: '¿Es cocina malagueña o de tapeo?',
		a: 'Es una cocina española con raíces, pero alejada del pescaíto frito y del marisco malagueño clásico. Aquí se viene a picar bien, con producto de calidad (ibérico, buey) y una carta de vinos cuidada. Los clientes lo suelen describir como una «cocina rica de interior».',
	},
	{
		q: '¿Hay carta de vinos y opciones sin gluten?',
		a: 'Sí, la carta de vinos es de las más destacadas del local: las reseñas mencionan un buen Rioja Crianza o un Ribera del Duero a precio contenido, y los vinos se sirven atemperados. También hay opciones vegetarianas, entre ellas la ensalada rusa y las fabes.',
	},
	{
		q: '¿Cuánto cuesta comer aquí?',
		a: 'Las reseñas sitúan la cuenta entre 15 € y 30 € por persona, según lo que se pida. El local está clasificado como cocina de precio medio-alto para su categoría, aunque los clientes destacan repetidamente que la relación calidad-precio es buena y que la carta de vinos es más amplia de lo que el precio sugiere.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'Sí, es muy recomendable, sobre todo para la cena de jueves a sábado, que es cuando el local se llena. Las reseñas insisten en que las mesas son altas y de tabureto, y que conviene llegar con tiempo. También se puede ir sin reservar y comer en barra.',
	},
	{
		q: '¿Se puede pagar con tarjeta o para llevar?',
		a: 'La ficha del negocio indica que se aceptan tarjetas de crédito y que hay servicio para llevar, aunque no hay reparto a domicilio. Es un local pensado para comer en barra, en las mesas altas o en las dos mesas bajas del fondo.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['El Picoteo', 'Mesón Agustín El Picoteo'],
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 951 93 04 52',
	priceRange: '€€€€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: [
		'Cocina española',
		'Cocina mediterránea',
		'Tapas',
		'Cocina de temporada',
		'Producto ibérico',
	],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [instagramUrl, cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: business.plusCode },
	],
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Wednesday', 'Sunday'], opens: '13:00', closes: '16:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Thursday', 'Friday', 'Saturday'], opens: '13:00', closes: '16:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Thursday', 'Friday', 'Saturday'], opens: '20:30', closes: '23:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday'], opens: '00:00', closes: '00:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Reservas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Servicio para llevar', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Tarjetas de crédito aceptadas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Opciones vegetarianas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Barra', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.6,
		reviewCount: 1682,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Qué pedir', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Agustín El Picoteo | Cocina española y tapeo en Teatinos (Málaga)</title>
		<meta name="theme-color" content="#1d1f16" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,600&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Agustín El Picoteo, picoteo Teatinos, cocina española Málaga, El Picoteo María de la Cruz, tapas Colonia Santa Inés, restaurante español 29010, cangrejo al vodka Málaga, prensaíto Málaga, comer en Teatinos, cena Teatinos, tapeo Málaga, bar español Teatinos"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Agustín El Picoteo · Cocina española para picar en Teatinos"
			ogDescription="Prensaíto, solomillo, revuelto de langostino y puerro, fabes con almejas y cangrejo al vodka en C. María de la Cruz, 3 (Colonia Santa Inés, Málaga). 4,6 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Agustín El Picoteo, cocina española en la calle María de la Cruz 3, Teatinos, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#1d1f16"
			street={business.street}
			city={business.city}
			region="Andalucía"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Teatinos-Universidad, Málaga"
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://agustin-el-picoteo.vercel.app/og.png" />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7261752;-4.4689631" />
		<meta name="ICBM" content="36.7261752, -4.4689631" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="A"
			name={business.name}
			subtitle="Cocina española · Teatinos, Málaga"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Colonia Santa Inés · Málaga"
				title="El picoteo<br />de Teatinos,<br /><em>con nombre propio.</em>"
				lede="Cocina española para picar en la calle María de la Cruz, 3, en la Colonia Santa Inés. Prensaíto ibérico, solomillo madurado, revuelto de langostino y puerro, fabes con almejas y una carta de vinos que no te esperas en un sitio tan de barrio."
				image={heroImage}
				imageAlt="Fotografía de Agustín El Picoteo publicada en su perfil de Google Maps (cocina española en Teatinos, Málaga)"
				primaryCta={{ label: 'Llamar 951 93 04 52', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> en Google (1.682 reseñas)' },
					{ label: 'Producto', html: 'Producto ibérico de bellota' },
					{ label: 'Cena', html: 'Cena de jueves a sábado' },
					{ label: 'Bodega', html: 'Carta de vinos amplia' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Agustín El Picoteo" items={servicios} />

			<LocalAbout
				label="Cocina española en la Colonia Santa Inés"
				title="De barrio,<br />con carta<br /><em>de picoteo fino.</em>"
				paragraphs={[
					'Agustín El Picoteo lleva años en la calle María de la Cruz, 3, a dos pasos del campus de Teatinos. No es un local de pescaíto frito ni de marisco malagueño: es un sitio de cocina española de picoteo, con producto ibérico de bellota y una cocina de raíces, pero de interior.',
					'La gracia está en la carta corta y bien elegida: prensaítos, jamón de bellota, rebanadas de solomillo madurado con Pedro Ximénez, revueltos, patés, fabes, bacalao al guiso y marisco. Y al lado, una bodega y una carta de vinos poco habituales para un bar de barrio, con referencias a precios contenidos.',
					'El ambiente es de barra y mesas altas, con dos mesas bajas al fondo para quien prefiera sentarse como en una casa. Te sirven una copa de licor de cortesía al sentarte y el café es de los buenos.',
				]}
				note="Lo que más se repite en 1.682 reseñas de Google: la calidad del producto, el trato cercano del personal y una relación calidad-precio que los clientes consideran contenida para lo que es Málaga hoy. La nota media es 4,6. La única pega que se repite: hay que reservar, porque se llena, y las mesas altas con tabureto no son para todo el mundo."
				links={[
					{ label: 'Instagram del restaurante', href: instagramUrl, external: true },
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="Lo más pedido"
				title="Qué pedir<br /><em>en El Picoteo.</em>"
				description="Selección hecha a partir de los platos que los clientes mencionan en las reseñas de Google y en las recomendaciones de la ficha. La carta cambia según la estación y la pesca, así que pregunta al reservar."
				cta={{ label: 'Reservar mesa', href: phoneHref }}
				groups={grupos}
				note="Precio orientativo según las reseñas: entre 15 € y 30 € por persona. No publicamos la carta completa con precios cerrados porque el producto de temporada y las referencias de la bodega varían. Confirma antes de venir."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El tapeo,<br /><em>servido.</em>"
				description="Estas fotografías proceden del perfil de Agustín El Picoteo en Google Maps, con la galería de clientes y las fotos de la casa. En la ficha están todas las imágenes y las reseñas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="C. María de la Cruz 3 · 29010 Málaga"
				title="Nos vemos<br /><em>en Teatinos.</em>"
				addressLines={[
					business.street,
					business.district,
					`${business.postalCode} ${business.city}, España`,
					`Plus Code: ${business.plusCode}`,
				]}
				hours={[
					{ day: 'Lunes', value: '13:00 – 16:30' },
					{ day: 'Martes', value: 'Cerrado', closed: true },
					{ day: 'Miércoles', value: '13:00 – 16:30' },
					{ day: 'Jueves', value: '13:00 – 16:30 · 20:30 – 23:30' },
					{ day: 'Viernes', value: '13:00 – 16:30 · 20:30 – 23:30' },
					{ day: 'Sábado', value: '13:00 – 16:30 · 20:30 – 23:30' },
					{ day: 'Domingo', value: '13:00 – 16:30' },
				]}
				hoursNote="Horario publicado en la ficha del restaurante. La cena solo se sirve de jueves a sábado, y el martes el local no abre. En cenas y fines de semana es habitual que se complete: reserva con antelación al 951 93 04 52."
				mapTitle="Mapa de Agustín El Picoteo en la calle María de la Cruz, 3, Teatinos-Universidad, Málaga"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Agustín El Picoteo · Teatinos, Málaga"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Instagram', href: instagramUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Reservas por teléfono. El local tiene dos entradas: la principal en María de la Cruz y una entrada trasera accesible para sillas de ruedas. Se aceptan tarjetas y hay servicio para llevar, aunque no hay reparto a domicilio. En la zona hay aparcamiento."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="A"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
