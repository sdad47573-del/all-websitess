---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/restaurante-casa-raul-apaisada-01.jpg';
import vitrina from '../assets/fotos/restaurante-casa-raul-apaisada-02.jpg';
import parrilla from '../assets/fotos/restaurante-casa-raul-vertical-03.jpg';
import comedor from '../assets/fotos/restaurante-casa-raul-apaisada-04.jpg';
import terraza from '../assets/fotos/restaurante-casa-raul-cuadrada-05.jpg';
import menuEspecial from '../assets/fotos/restaurante-casa-raul-vertical-06.jpg';
import sala from '../assets/fotos/restaurante-casa-raul-apaisada-07.jpg';
import rincon from '../assets/fotos/restaurante-casa-raul-vertical-08.jpg';
import mesa from '../assets/fotos/restaurante-casa-raul-vertical-09.jpg';
import chuletillas from '../assets/fotos/restaurante-casa-raul-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
} from '../data/site';

const description =
	'Restaurante Casa Raúl en Plasencia (Cáceres): menú diario, menú especial por 30 €, parrilla, raciones y terraza. Av. Martín Palomino, 88. Tel. 927 42 29 55.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de piedra de Restaurante Casa Raúl con el toldo amarillo y las palmeras de la avenida Martín Palomino',
	},
	{
		src: parrilla,
		alt: 'Dos bandejas de barro con carne a la parrilla, patatas y pimientos en Restaurante Casa Raúl',
	},
	{
		src: comedor,
		alt: 'Comedor de Casa Raúl con manteles naranjas, sillas granates y lámparas de pared',
	},
	{
		src: chuletillas,
		alt: 'Chuletillas de cordero a la brasa con patatas fritas en Restaurante Casa Raúl',
	},
	{
		src: terraza,
		alt: 'Terraza de Casa Raúl bajo los árboles, con mesas y sillas blancas junto a la fachada',
	},
	{
		src: menuEspecial,
		alt: 'Cartel del Menú Especial de Casa Raúl con primeros, segundos y el precio de 30,00 €',
	},
	{
		src: sala,
		alt: 'Sala de Casa Raúl con cortinas rojas, mesas vestidas y sillas de tapicería granate',
	},
	{
		src: mesa,
		alt: 'Mesa larga preparada en el comedor de Casa Raúl, con mantel de azulejos y trona',
	},
	{
		src: vitrina,
		alt: 'Vitrina de aperitivos de Casa Raúl con croquetas y tortilla',
	},
	{
		src: rincon,
		alt: 'Rincón del comedor de Casa Raúl con mesa de mantel granate y sillas blancas',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#casa-raul`,
	name: BUSINESS.name,
	alternateName: ['Casa Raúl', 'Casa Raul Plasencia', 'Restaurante Casa Raul'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 927 42 29 55',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Extremeña', 'Parrilla', 'Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Plasencia' },
		{ '@type': 'AdministrativeArea', name: 'Cáceres' },
		{ '@type': 'AdministrativeArea', name: 'Extremadura' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '07:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '07:00',
			closes: '01:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Comedor climatizado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
	],
	hasMenu: {
		'@type': 'Menu',
		name: 'Menú especial',
		description:
			'Primero, segundo, vino tinto o blanco, agua, cerveza o refresco, pan, postre de la casa y café.',
		hasMenuSection: MENU.filter((group) => group.title.startsWith('Menú especial')).map(
			(group) => ({
				'@type': 'MenuSection',
				name: group.title.replace('Menú especial · ', ''),
				hasMenuItem: group.items.map((item) => ({
					'@type': 'MenuItem',
					name: `${item.name}, ${item.note}`,
				})),
			}),
		),
	},
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 4, bestRating: 5 },
			reviewBody: 'Dispone de menú diario además de raciones, bocadillos, hamburguesas...',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 4, bestRating: 5 },
			reviewBody: 'Buen servicio , buenos precios y buena calidad de aperitivos y tostadas.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Cochinillo excelente y ensalada casa Raúl buenísima....para repetir.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Casa Raúl · Restaurante y parrilla en Plasencia';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-casa-raul-apaisada-01.jpg": fachada,
	"restaurante-casa-raul-vertical-03.jpg": parrilla,
	"restaurante-casa-raul-apaisada-04.jpg": comedor,
	"restaurante-casa-raul-apaisada-10.jpg": chuletillas,
	"restaurante-casa-raul-cuadrada-05.jpg": terraza,
	"restaurante-casa-raul-vertical-06.jpg": menuEspecial,
	"restaurante-casa-raul-apaisada-07.jpg": sala,
	"restaurante-casa-raul-vertical-09.jpg": mesa,
	"restaurante-casa-raul-apaisada-02.jpg": vitrina,
	"restaurante-casa-raul-vertical-08.jpg": rincon,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#8c3a24" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Casa Raúl Plasencia, Restaurante Casa Raúl, comer en Plasencia, menú del día Plasencia, menú especial Plasencia, parrilla Plasencia, terraza Plasencia, cochinillo Plasencia, restaurante Av. Martín Palomino, bar Plasencia"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Casa Raúl · Restaurante y parrilla en Plasencia"
			ogDescription="Menú diario, menú especial por 30 €, parrilla y raciones en la avenida Martín Palomino, 88 (Plasencia). Terraza de verano e invierno y comedor climatizado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Restaurante Casa Raúl con el toldo amarillo en Plasencia"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#8c3a24"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-EX"
			postalCode={BUSINESS.postalCode}
			phone="+34927422955"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Casa Raúl"
			subtitle="Restaurante y parrilla · Plasencia"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Casa Raúl"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34927422955?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Plasencia." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Plasencia"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
