---
import '../styles/global.css';
import { BUSINESS, MAPS, SERVICES, MENU, FAQ } from '../data/site';
import { Image } from 'astro:assets';
import ChickenPhoto from '../assets/fotos/pollos-a-domicilio-el-portugues-apaisada-01.jpg';

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: BUSINESS.name,
  description: BUSINESS.description,
  url: `${BUSINESS.siteUrl}/`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: BUSINESS.city,
    addressRegion: BUSINESS.region,
    addressCountry: BUSINESS.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: BUSINESS.geo.lat, longitude: BUSINESS.geo.lng },
  hasMap: MAPS.place,
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pollos El Portugués | Pollo asado y comida a domicilio en Sevilla</title>
    <meta name="description" content={BUSINESS.description} />
    <meta name="keywords" content="El Portugués Sevilla, pollo asado, pollos a domicilio, comida para llevar Sevilla" />
    <meta name="theme-color" content="#254334" />
    <link rel="canonical" href={`${BUSINESS.siteUrl}/`} />
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:title" content="Pollos El Portugués | Pollo asado y comida a domicilio en Sevilla" />
    <meta property="og:description" content={BUSINESS.description} />
    <meta property="og:url" content={`${BUSINESS.siteUrl}/`} />
    <meta property="og:image" content={`${BUSINESS.siteUrl}/og.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="topbar">
      <div class="topbar-inner wrap">
        <a class="brand" href="#inicio" aria-label="El Portugués, inicio"><span class="brand-mark" aria-hidden="true">EP</span><span class="brand-name">El Portugués<small>Pollo asado · Sevilla</small></span></a>
        <nav aria-label="Navegación principal"><a href="#especialidad">La especialidad</a><a href="#carta">Qué pedir</a><a href="#galeria">Galería</a><a href="#visitanos">Ubicación</a></nav>
        <a class="topbar-phone" href={MAPS.place} target="_blank" rel="noopener noreferrer">Ficha de Maps ↗</a>
      </div>
    </header>
    <main id="contenido">
      <section class="hero wrap" id="inicio">
        <div>
          <p class="eyebrow"><span aria-hidden="true"></span> Pollo asado · Sevilla</p>
          <h1 set:html={piezas.portada.titulo} />
          <p class="hero-lede">Pollos a Domicilio “El Portugués” es una opción sevillana para disfrutar de pollo asado y comida para llevar. Consulta la ubicación en Maps y confirma allí la carta, el reparto y el horario del establecimiento.</p>
          <div class="hero-actions"><a class="button button-primary" href={MAPS.directions} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a><a class="button button-ghost" href="#carta">Ver sugerencias</a></div>
          <ul class="hero-facts" aria-label="Información de El Portugués"><li><b>Pollo asado</b>Para disfrutar en casa</li><li><b>Comida para llevar</b>Consulta disponibilidad</li><li><b>Sevilla</b>Ubicación en Google Maps</li></ul>
        </div>
        <figure class="hero-photo"><span class="hero-tag">Sabor para compartir</span><Image src={ChickenPhoto} alt="Pollo asado con patatas en la foto pública de El Portugués en Google Maps" widths={[480,720,960]} sizes="(max-width: 899px) 100vw, 46vw" format="webp" quality={78} loading="eager" fetchpriority="high" /><figcaption><span>Pollo asado con patatas</span><a href={MAPS.place} target="_blank" rel="noopener noreferrer">Foto de Google Maps ↗</a></figcaption></figure>
      </section>

      <section class="wrap" aria-label="Servicios"><ul class="chips">{SERVICES.map((service) => <li>{service}</li>)}</ul></section>

      <section class="about section-pad wrap" id="especialidad"><p class="section-label"><span aria-hidden="true"></span> Una comida para disfrutar</p><div class="about-grid"><h2>Pollo asado, guarnición y mesa puesta.</h2><div class="about-copy"><p>El nombre de la ficha destaca el servicio a domicilio; la imagen pública muestra pollo asado con patatas. Una propuesta sencilla para resolver una comida y compartirla en casa.</p><p>Los perfiles con nombres parecidos no siempre apuntan al mismo establecimiento. Por eso, para esta web tomamos como referencia la ficha de Google Maps que compartiste y no atribuimos a este pin la dirección de calle o el teléfono de otros locales homónimos.</p><p class="about-note">Comprueba la ficha enlazada para confirmar la dirección exacta, el horario, el teléfono de pedidos y las zonas de reparto antes de hacer un pedido.</p><div class="about-links"><a class="simple-link" href={MAPS.place} target="_blank" rel="noopener noreferrer">Consultar ficha oficial en Google Maps ↗</a></div></div></div></section>

      <section class="wrap" aria-label="Propuesta de El Portugués"><div class="highlights"><article><h3>Pollo asado</h3><p>La foto disponible en la ficha muestra pollo asado dorado con patatas.</p></article><article><h3>Para compartir</h3><p>Consulta el tamaño de las raciones y las guarniciones disponibles ese día.</p></article><article><h3>A domicilio o para llevar</h3><p>El servicio depende de la ubicación y el horario; confírmalo con el establecimiento.</p></article></div></section>

      <section class="menu" id="carta"><div class="wrap"><div class="menu-head"><div><p class="eyebrow"><span aria-hidden="true"></span> Una propuesta sencilla</p><h2>Prepara la mesa,<br /><em>del resto se encargan.</em></h2></div><div><p>La información actual de platos, precios y acompañamientos puede variar. Consulta la ficha del negocio y confirma la disponibilidad antes de pedir.</p><a class="button button-primary" href={MAPS.place} target="_blank" rel="noopener noreferrer">Consultar datos y pedidos ↗</a></div></div><div class="menu-groups">{MENU.map((group) => <div class="menu-group"><h3>{group.title}</h3><ul class="dishes">{group.items.map((item) => <li><span class="dish">{item.name}<em>{item.note}</em></span></li>)}</ul></div>)}</div><p class="menu-note">No se publican precios ni un número de teléfono no confirmado para este pin. Comprueba los datos actuales en la ficha del establecimiento.</p></div></section>

      <section class="gallery section-pad wrap" id="galeria"><div class="gallery-head"><div><p class="eyebrow"><span aria-hidden="true"></span> Una imagen del local</p><h2>Recién hecho,<br /><em>para disfrutar.</em></h2></div><div><p>Esta es la fotografía disponible en la galería pública de la ficha de Google Maps.</p><a class="button button-primary" href={MAPS.place} target="_blank" rel="noopener noreferrer">Abrir Google Maps ↗</a></div></div><div class="gallery-grid"><figure class="shot"><Image src={ChickenPhoto} alt="Pollo asado con patatas mostrado en la ficha de El Portugués" widths={[320,480,640]} sizes="(max-width: 640px) 92vw, (max-width: 980px) 45vw, 23vw" format="avif" quality={65} loading="lazy" decoding="async" /></figure></div><p class="gallery-note">Foto descargada del perfil público de Pollos a Domicilio “El Portugués” en Google Maps.</p></section>

      <section class="visit section-pad" id="visitanos"><div class="wrap visit-grid"><div class="visit-copy"><p class="eyebrow"><span aria-hidden="true"></span> Encuentra el establecimiento</p><h2>Sevilla, a un <em>mapa de distancia.</em></h2><p class="address">Sevilla<br />Ubicación exacta indicada en Google Maps</p><p class="hours-note">No se ha podido confirmar el horario actual para este pin. Consulta la ficha antes de desplazarte.</p><div class="visit-links"><a class="button button-primary" href={MAPS.directions} target="_blank" rel="noopener noreferrer">Abrir ruta ↗</a><a class="button button-ghost" href={MAPS.place} target="_blank" rel="noopener noreferrer">Ver teléfono y horario ↗</a></div><p class="reserve-note">El teléfono encontrado en directorios públicos se asocia a otra dirección de Sevilla, por lo que no lo mostramos como contacto de esta ficha.</p></div><div class="map-frame"><iframe title="Mapa de Pollos a Domicilio El Portugués en Sevilla" src={MAPS.embed} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><a class="map-label" href={MAPS.directions} target="_blank" rel="noopener noreferrer">⌖ Abrir ruta</a></div></div></section>

      <section class="faq section-pad wrap" id="preguntas"><p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p><h2>Antes de <em>hacer tu pedido.</em></h2><div class="faq-list">{FAQ.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></section>
    </main>
    <footer class="site-footer"><div class="wrap"><div class="footer-grid"><div class="footer-brand"><span class="brand-mark" aria-hidden="true">EP</span><div><p>Pollos a Domicilio El Portugués</p><small>Sevilla · pollo asado</small></div></div><nav aria-label="Enlaces del pie"><a href="#inicio">Inicio</a><a href={MAPS.place} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href="/aviso-legal">Aviso legal</a></nav></div><span class="legal">Confirma directamente con el negocio el horario, la carta y el servicio a domicilio.</span><p class="credit">Creado por <a href="https://sur-digital.vercel.app" target="_blank" rel="noopener noreferrer">Sur Digital · sur-digital.vercel.app</a></p></div></footer>
    <a class="mobile-call" href={MAPS.place} target="_blank" rel="noopener noreferrer">Consultar ficha y llamar ↗</a>
  </body>
</html>
