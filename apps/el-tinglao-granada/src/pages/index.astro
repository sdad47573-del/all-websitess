---
const business = {
	name: 'Bar Restaurante El Tinglao',
	street: 'Calle Marqués de Mondéjar, 13',
	city: 'Granada',
	region: 'Granada',
	postalCode: '18005',
	country: 'ES',
	phone: '+34 661 71 23 23',
	latitude: 37.168292,
	longitude: -3.6019978,
	site: 'https://el-tinglao-granada.vercel.app',
};

const mapsUrl = 'https://www.google.com/maps/place/Bar+restaurante+El+Tinglao/data=!4m7!3m6!1s0xd71fc97fad79401:0xcce5ab7117feaee5!8m2!3d37.168292!4d-3.6019978!16s%2Fg%2F11bz0dvv2z!19sChIJAZTX-pf8cQ0R5a7-F3Gr5cw?hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(`${business.name}, ${business.street}, ${business.city}`)}&ll=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34661712323';
const instagramUrl = 'https://www.instagram.com/eltinglao.granada/';
const websiteUrl = 'https://el-tinglao.eatbu.com/?lang=es';
const siteUrl = `${business.site}/`;
const description = 'Bar Restaurante El Tinglao en Granada: tapas, jamón asado, comida casera, raciones y menú del día en Marqués de Mondéjar, 13. Consulta horario, reservas y fotos de Google Maps.';

const hours = [
	{ day: 'Lunes', value: 'Cerrado' },
	{ day: 'Martes', value: '13:00–16:00 · 20:00–00:00' },
	{ day: 'Miércoles', value: '13:00–16:00 · 20:00–00:00' },
	{ day: 'Jueves', value: '13:00–16:00 · 20:00–00:00' },
	{ day: 'Viernes', value: '13:00–16:00 · 20:00–00:30' },
	{ day: 'Sábado', value: '13:00–16:00 · 20:00–00:30' },
	{ day: 'Domingo', value: '13:00–16:00 · 20:00–00:00' },
];

const faqs = [
	{
		question: '¿Dónde está Bar Restaurante El Tinglao?',
		answer: 'Está en la calle Marqués de Mondéjar, 13, 18005 Granada, cerca de la calle Alhamar. Puedes abrir las indicaciones de Google Maps desde esta página.',
	},
	{
		question: '¿Cuál es el teléfono para reservar?',
		answer: 'El Tinglao publica el teléfono +34 661 71 23 23 para reservas y pedidos. Llama para consultar disponibilidad.',
	},
	{
		question: '¿Qué platos destacan en El Tinglao?',
		answer: 'El jamón asado es uno de sus platos más conocidos. También suelen mencionarse las patatas caseras, patatas con queso y bacon, croquetas de cocido, huevos rotos, cachopo y raciones de cocina casera. La carta puede cambiar según el día.',
	},
	{
		question: '¿Cuál es el horario de apertura?',
		answer: 'El horario publicado en la web del restaurante indica cierre los lunes. De martes a jueves abre de 13:00 a 16:00 y de 20:00 a 00:00; viernes y sábado de 13:00 a 17:00 y de 20:00 a 00:30; domingo de 13:00 a 16:00 y de 20:00 a 00:00. Confirma posibles cambios antes de ir.',
	},
	{
		question: '¿Se puede pedir para llevar?',
		answer: 'Sí, el establecimiento anuncia comida para llevar. Llama al +34 661 71 23 23 para consultar el menú, los pedidos y las opciones disponibles.',
	},
	{
		question: '¿Dónde puedo ver fotos del restaurante y sus tapas?',
		answer: 'Abre la ficha de El Tinglao en Google Maps desde esta página para consultar las fotos del local y de sus platos junto con las reseñas recientes.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${siteUrl}#restaurant`,
	name: business.name,
	description,
	url: siteUrl,
	telephone: business.phone,
	priceRange: '10–30 €',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Mediterránea', 'Casera', 'Tapas'],
	acceptsReservations: true,
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: business.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [mapsUrl, instagramUrl, websiteUrl],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday'],
			opens: '13:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday'],
			opens: '20:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '13:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '20:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '13:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '20:00',
			closes: '23:59',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

import Galeria from '../components/Galeria.astro';---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#3c2923" />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" />
		<title>Bar Restaurante El Tinglao en Granada | Tapas y jamón asado</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="El Tinglao · Tapas y cocina casera en Granada" />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${business.site}/og.svg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Bar Restaurante El Tinglao, tapas caseras en Granada" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Bar Restaurante El Tinglao, inicio"><span class="brand-mark" aria-hidden="true">T</span><span>El Tinglao <small>Mesón · Granada</small></span></a>
			<nav aria-label="Navegación principal"><a href="#casa">La casa</a><a href="#carta">Qué comer</a><a href="#fotos">Fotos</a><a href="#visitanos">Cómo llegar</a></nav>
			<a class="header-call" href={phoneHref}>Reservas · 661 71 23 23</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span>Granada · Barrio de Ronda</span><i aria-hidden="true"></i> Tapas de las de siempre</p>
					<h1>Jamón asado,<br />tapa y <em>buena mesa.</em></h1>
					<p class="lede">En El Tinglao, la cocina casera y el ambiente de barrio se encuentran en la calle Marqués de Mondéjar. Ven a por una tapa, quédate a comer y siéntete como en casa.</p>
					<div class="actions"><a class="button button-gold" href={phoneHref}>Llamar para reservar <span aria-hidden="true">↗</span></a><a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-details"><span>⌖ Marqués de Mondéjar, 13</span><span>✦ Tapas · raciones · comida casera</span></div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración original de tapas caseras y una copa en la barra de una tasca granadina">
					<div class="tile tile-one"></div><div class="tile tile-two"></div><div class="tile tile-three"></div><div class="shelf"><span></span><i></i></div><div class="wall-light"></div><div class="table"></div><div class="plate"><span class="ham ham-one"></span><span class="ham ham-two"></span><span class="ham ham-three"></span><span class="potato potato-one"></span><span class="potato potato-two"></span><span class="potato potato-three"></span></div><div class="drink"><span></span></div><div class="art-note">Tapa de la casa<br /><b>y otra ronda</b></div><span class="shine shine-one">✦</span><span class="shine shine-two">✧</span>
				</div>
			</section>

			<div class="ticker" aria-label="Platos y servicios de El Tinglao"><span>Jamón asado</span><b>✳</b><span>Tapas con cada consumición</span><b>✳</b><span>Croquetas</span><b>✳</b><span>Menú del día</span><b>✳</b><span>Terraza</span></div>

			<section class="intro section-wrap" id="casa"><div><p class="eyebrow eyebrow-dark">Un bar como los de antes</p><h2>De barrio,<br /><em>con mucho sabor.</em></h2></div><div class="intro-copy"><p>Bar Restaurante El Tinglao es un mesón acogedor en el barrio de Ronda, Granada. Alberto e Inma mantienen una cocina casera y un trato familiar, con tapas generosas, raciones para compartir y un ambiente de esos que invitan a volver.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver opiniones y fotos en Google Maps ↗</a></div></section>

			<section class="specialties section-wrap" id="carta" aria-labelledby="specialties-title"><div class="section-heading"><p class="eyebrow eyebrow-dark">Para tapear, compartir y repetir</p><h2 id="specialties-title">Platos con<br /><em>acento casero.</em></h2><p>Una selección de las especialidades que más destacan en reseñas públicas. Pregunta por la carta y el menú de hoy.</p></div>
				<div class="special-grid">
					<article class="special-card special-ham"><span class="special-icon" aria-hidden="true">✦</span><span class="card-kicker">EL MÁS FAMOSO</span><h3>Jamón asado</h3><p>La especialidad de la casa, con un aliño propio y sabor de cocina lenta.</p></article>
					<article class="special-card special-potatoes"><span class="special-icon" aria-hidden="true">◉</span><span class="card-kicker">HECHAS EN CASA</span><h3>Patatas y cheese bacon</h3><p>Patatas caseras, con opciones de queso y bacon para compartir.</p></article>
					<article class="special-card special-croquettes"><span class="special-icon" aria-hidden="true">❋</span><span class="card-kicker">DE LA COCINA</span><h3>Croquetas de cocido</h3><p>Una tapa cremosa y casera, perfecta para empezar la ronda.</p></article>
					<article class="special-card special-home"><span class="special-icon" aria-hidden="true">♨</span><span class="card-kicker">COCINA CASERA</span><h3>Huevos rotos y raciones</h3><p>Platos abundantes, recetas tradicionales y un menú para el día a día.</p></article>
				</div><p class="menu-note">También suelen aparecer en la carta cachopo, secreto ibérico, arroces y postres caseros. La disponibilidad, el menú y los precios pueden cambiar.</p>
			</section>

			<section class="photo-section" id="fotos"><div class="photo-copy"><p class="eyebrow">El Tinglao en Google Maps</p><h2>Entra a la tasca<br />desde <em>tu pantalla.</em></h2><p>Consulta las fotos del jamón asado, las tapas y el local en la ficha de Google Maps. También puedes leer las reseñas y comprobar los datos actualizados antes de venir.</p><a class="button button-gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a><a class="social-link" href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram del mesón ↗</a></div>
				<div class="map-photo"><iframe title="Google Maps: Bar Restaurante El Tinglao en la calle Marqués de Mondéjar, Granada" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><a class="map-caption" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span>⌖</span><span><b>Bar Restaurante El Tinglao</b><small>Marqués de Mondéjar, 13 · Ver fotos ↗</small></span></a></div>
			</section>

			<section class="visit section-wrap" id="visitanos"><div class="visit-copy"><p class="eyebrow eyebrow-dark">En el barrio de Ronda</p><h2>Nos vemos<br /><em>en El Tinglao.</em></h2><p>Ven a por una tapa, reserva para comer o pregunta por las opciones para llevar. Aquí te esperamos.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button button-dark" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Llamar · 661 71 23 23</a></div></div>
				<div class="hours-card" id="horario"><div class="hours-title"><span class="clock" aria-hidden="true">◷</span><div><p class="eyebrow eyebrow-dark">Organiza tu visita</p><h3>Horario</h3></div></div><dl>{hours.map(({ day, value }) => <div class:list={[{ closed: value === 'Cerrado' }]}><dt>{day}</dt><dd>{value}</dd></div>)}</dl><p class="hours-note">Horario publicado en el sitio del restaurante. Puede cambiar en festivos; llama para confirmar antes de desplazarte.</p><a class="hours-link" href={websiteUrl} target="_blank" rel="noopener noreferrer">Consultar sitio del restaurante ↗</a></div>
			</section>

			<section class="faq-section section-wrap" id="preguntas"><p class="eyebrow eyebrow-dark">Preguntas frecuentes</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
			<Galeria nombre="Bar Restaurante El Tinglao" mapsUrl={mapsUrl} />
		</main>

		<footer class="footer"><div class="footer-top"><a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">T</span><span>El Tinglao <small>Mesón · Granada</small></span></a><p>Tapa, ración<br />y trato de casa.</p><nav aria-label="Enlaces de El Tinglao"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={websiteUrl} target="_blank" rel="noopener noreferrer">Web ↗</a><a href={phoneHref}>661 71 23 23</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Bar Restaurante El Tinglao · Granada</span><a href="/aviso-legal/">Aviso legal y privacidad</a><span>Confirma horario, menú y disponibilidad directamente con el mesón.</span></div></footer>
		<a class="mobile-call" href={phoneHref}>Reservar <span>661 71 23 23</span></a>
	</body>
</html>

<style is:global>
	:root{font-family:'DM Sans',sans-serif;color:#382c27;background:#f9f4ea;font-synthesis:none;text-rendering:optimizeLegibility;--wine:#3c2923;--wine2:#704237;--gold:#d6ad62;--cream:#f9f4ea;--ink:#382c27;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid #d6ad62;outline-offset:4px}.skip-link{position:absolute;z-index:99;top:-60px;left:16px;padding:12px 16px;background:var(--gold);color:var(--wine)}.skip-link:focus{top:12px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:22px;background:var(--wine);color:#fcf8ee}.brand{display:flex;align-items:center;gap:11px;font-size:15px;font-weight:700}.brand small{display:block;margin-top:4px;color:#e2d5c4;font-size:9px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--gold);border-radius:50%;color:#e8cb8c;font:700 23px var(--display)}.topbar nav{display:flex;gap:clamp(14px,2.5vw,32px);color:#f0e7dc;font-size:12px}.topbar nav a:hover,.footer a:hover{color:#e8cb8c}.header-call{padding:11px 17px;border:1px solid #ffffff55;border-radius:99px;font-size:11px;font-weight:700}.hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:560px;background:var(--wine);color:#fcf8ee;overflow:hidden}.hero-copy{padding:73px 4vw 64px 9vw;align-self:center}.eyebrow{margin:0 0 19px;color:#dfc993;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase}.eyebrow i{display:inline-block;width:22px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.section-heading h2,.photo-copy h2,.visit h2,.faq-section h2{margin:0;font:600 clamp(39px,4.8vw,64px)/1.08 var(--display);letter-spacing:-1.2px}.hero h1 em,.intro h2 em,.section-heading h2 em,.photo-copy h2 em,.visit h2 em,.f