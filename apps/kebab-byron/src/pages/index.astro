---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import durumGratinado from '../assets/fotos/kebab-byron-vista-8-08.jpg';
import comedor from '../assets/fotos/kebab-byron-apaisada-04.jpg';
import barra from '../assets/fotos/kebab-byron-apaisada-07.jpg';
import flyer from '../assets/fotos/kebab-byron-apaisada-03.jpg';
import bandeja from '../assets/fotos/kebab-byron-vertical-09.jpg';
import fachada from '../assets/fotos/kebab-byron-vista-1-01.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Kebab Byron · Döner kebab, durum y pizzas turcas en Basauri';
const description =
	'Kebab Byron, Agirre Lehendakaria Kalea, 36 (Arizgoiti, 48970 Basauri, Bizkaia). Döner kebab halal de pollo o cordero, durum, pizzas turcas y menús con patatas y refresco. Servicio a domicilio. 3,5 sobre 5 con 63 reseñas.';

const galeria = [
	{
		src: durumGratinado,
		alt: 'Durum gratinado con queso fundido por encima, servido en el plato',
	},
	{
		src: fachada,
		alt: 'La fachada de Kebab Byron en Arizgoiti, con el rótulo rojo y las fotos de durum y hamburguesa',
	},
	{
		src: comedor,
		alt: 'El comedor de Kebab Byron con mesas de mármol, sillas de metal y paredes rojas',
	},
	{
		src: barra,
		alt: 'La barra de madera de Kebab Byron con la carta colgada encima y las lámparas',
	},
	{
		src: bandeja,
		alt: 'Bandeja con durums, sándwiches tostados y patatas fritas con salsa',
	},
	{
		src: flyer,
		alt: 'El flyer de Kebab Byron con la carta, los menús y el teléfono de reparto',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que sirve Kebab Byron',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#kebab-byron`,
	name: BUSINESS.name,
	alternateName: ['Kebab Byron Basauri', 'Byron Arizgoiti', 'Bar Baserri Kebab'],
	description:
		'Döner kebab halal, durum y pizzas turcas en Agirre Lehendakaria Kalea, 36 (Arizgoiti, 48970 Basauri, Bizkaia), con menús de patatas y refresco y servicio a domicilio.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34946076441',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Turca', 'Kebab', 'Halal'],
	hasTakeaway: true,
	hasDeliveryMethod: 'http://purl.org/goodrelations/v1#DeliveryModeOwnFleet',
	areaServed: [
		{ '@type': 'City', name: 'Basauri' },
		{ '@type': 'Place', name: 'Arizgoiti' },
		{ '@type': 'AdministrativeArea', name: 'Bizkaia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '12:00',
			closes: '00:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '12:00',
			closes: '01:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"kebab-byron-vista-8-08.jpg": durumGratinado,
	"kebab-byron-vista-1-01.jpg": fachada,
	"kebab-byron-apaisada-04.jpg": comedor,
	"kebab-byron-apaisada-07.jpg": barra,
	"kebab-byron-vertical-09.jpg": bandeja,
	"kebab-byron-apaisada-03.jpg": flyer,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f1e15" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Oswald:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Kebab Byron Basauri, kebab Arizgoiti, döner kebab Basauri, durum Basauri, pizza turca Basauri, kebab halal Bizkaia, kebab a domicilio Basauri"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Döner kebab halal, durum y pizzas turcas en Arizgoiti (Basauri), con menús de patatas y refresco y reparto a domicilio. Todos los días desde las 12:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Durum gratinado con queso fundido de Kebab Byron, en Basauri"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2f1e15"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.city}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[durumGratinado]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Kebab Byron"
			subtitle="Kebab y durum · Basauri"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma platos, precios y horario antes de pedir."
			ctaLabel="Llamar a Kebab Byron"
			navAriaLabel="Enlaces de Kebab Byron"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
