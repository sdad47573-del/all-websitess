---
import { Image } from 'astro:assets';
import { BUSINESS, IMAGES } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
const media = Math.round(BUSINESS.rating * 2) / 2;
---

<section id="inicio" class="hero-casa relative overflow-hidden text-white">
	<div
		class="pointer-events-none absolute -top-24 -right-20 size-80 rounded-full border border-white/10 sm:size-[28rem]"
		aria-hidden="true"
	></div>
	<div
		class="pointer-events-none absolute top-40 -left-32 size-72 rounded-full border border-white/10"
		aria-hidden="true"
	></div>

	<div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
		<div class="grid items-center gap-14 lg:grid-cols-[1.06fr_0.94fr]">
			<div>
				<p
					class="text-accent inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase"
				>
					<span><i class="ri-map-pin-line"></i> Beniaján · Murcia</span>
					<span class="text-white/50">Av. de San Javier, 22A</span>
				</p>

				<h1 class="font-display mt-5 text-6xl leading-[0.88] font-normal tracking-tight sm:text-7xl lg:text-8xl">
					Casa<br />
					<span class="text-accent italic">Laura</span>
				</h1>
				<p class="font-display text-accent mt-4 text-xl italic sm:text-2xl">
					La mesa de todos los días
				</p>

				<p class="mt-6 max-w-xl text-base leading-relaxed text-white/80 sm:text-lg">
					Café, bar y restaurante de cocina española en Beniaján. Desayunos desde las 8:00,
					menú del día, tapas, brasa y comida para llevar.
				</p>

				<div class="mt-7 flex flex-wrap items-center gap-3">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="badge badge-lg gap-2 border-white/20 bg-white/10 px-3 py-3 text-xs font-semibold whitespace-nowrap text-white sm:px-4 sm:text-sm"
					>
						<span class="text-accent tracking-tight" aria-hidden="true">
							{
								estrellas.map((n) => (
									<i
										class={
											n <= media
												? 'ri-star-fill'
												: n - media === 0.5
													? 'ri-star-half-fill'
													: 'ri-star-line'
										}
									/>
								))
							}
						</span>
						{BUSINESS.rating.toString().replace('.', ',')} · {BUSINESS.reviewCount} reseñas<span class="hidden sm:inline"> en Google</span>
					</a>
				</div>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-accent btn-lg gap-2 rounded-full">
						<i class="ri-phone-line text-xl"></i>
						{BUSINESS.phone}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-lg gap-2 rounded-full border-white/35 bg-transparent text-white hover:border-white hover:bg-white hover:text-neutral"
					>
						<i class="ri-route-line"></i>
						Cómo llegar
					</a>
				</div>

				<dl class="mt-10 grid grid-cols-3 gap-x-4 gap-y-5 border-t border-white/15 pt-7">
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Desayunos</dt>
						<dd class="font-display mt-1 text-xl font-semibold sm:text-2xl">8:00</dd>
						<dd class="text-xs text-white/55">Todos los días</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Mediodía</dt>
						<dd class="font-display mt-1 text-xl font-semibold sm:text-2xl">Menú</dd>
						<dd class="text-xs text-white/55">Cocina casera</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Brasa</dt>
						<dd class="font-display mt-1 text-xl font-semibold sm:text-2xl">Hasta 23:00</dd>
						<dd class="text-xs text-white/55">Mar–sáb</dd>
					</div>
				</dl>
			</div>

			<figure class="relative mx-auto w-full max-w-md lg:max-w-none">
				<div class="border-accent/35 absolute -inset-2 arco-casa border"></div>
				<div class="arco-casa relative overflow-hidden shadow-2xl">
					<Image
						src={IMAGES.fotoPulpo}
						alt="Pulpo roquero a la brasa de Restaurante Casa Laura"
						widths={[420, 700, 1000]}
						sizes="(min-width: 1024px) 42vw, 90vw"
						quality={85}
						loading="eager"
						fetchpriority="high"
						class="foto-calida aspect-[4/5] w-full object-cover"
					/>
					<div
						class="bg-neutral/65 absolute right-5 bottom-5 rounded-full px-4 py-2 backdrop-blur-sm"
					>
						<p class="text-[0.6rem] font-semibold tracking-[0.18em] text-white/65 uppercase">
							De la brasa
						</p>
						<p class="font-display text-lg leading-tight font-semibold">Pulpo roquero</p>
					</div>
				</div>

				<div
					class="border-base-100 absolute -bottom-7 -left-4 w-32 overflow-hidden rounded-2xl border-4 shadow-xl sm:-left-8 sm:w-44"
				>
					<Image
						src={IMAGES.fotoFachada}
						alt="Fachada de Casa Laura con su rótulo"
						widths={[180, 300]}
						sizes="11rem"
						quality={82}
						loading="lazy"
						class="foto-calida aspect-[4/3] w-full object-cover"
					/>
				</div>

				<div
					class="sello-casa bg-primary absolute -top-4 -right-3 flex size-24 rotate-6 flex-col items-center justify-center rounded-full text-center sm:-right-6 sm:size-28"
				>
					<i class="ri-leaf-line text-accent text-2xl" aria-hidden="true"></i>
					<span class="font-display text-accent mt-1 text-lg leading-none font-semibold">de casa</span>
					<span class="mt-1 text-[0.55rem] tracking-[0.12em] text-white/65 uppercase">
						desde la huerta
					</span>
				</div>
			</figure>
		</div>
	</div>

	<div class="cenefa-casa relative h-2 w-full"></div>
</section>
