---
import { Image } from 'astro:assets';
import { GALLERY } from '../data/site';

const disposicion = [
	'sm:col-span-2 sm:row-span-2',
	'sm:row-span-2',
	'',
	'',
	'',
	'sm:col-span-2',
	'',
	'',
	'',
	'sm:col-span-2',
];
---

<section id="galeria" class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="text-secondary text-xs font-semibold tracking-[0.22em] uppercase">Galería</p>
				<h2 class="font-display mt-3 text-3xl font-normal tracking-tight sm:text-4xl">
					La casa, la barra y la mesa
				</h2>
			</div>
			<p class="text-base-content/60 max-w-sm text-sm">
				Fotos reales del restaurante y de sus platos, publicadas en la ficha de Google.
			</p>
		</div>

		<div class="mt-10 grid auto-rows-[9.5rem] grid-cols-2 gap-3 sm:auto-rows-[10.5rem] sm:grid-cols-4 sm:gap-4">
			{
				GALLERY.map((foto, index) => (
					<figure
						class={`group relative overflow-hidden rounded-2xl ${disposicion[index] ?? ''}`}
					>
						<Image
							src={foto.src}
							alt={foto.alt}
							widths={index === 0 ? [520, 800, 1100] : [280, 460, 700]}
							sizes={index === 0 ? '(min-width: 1024px) 48vw, 92vw' : '(min-width: 1024px) 24vw, 46vw'}
							quality={80}
							loading="lazy"
							class="foto-calida h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
						/>
						<figcaption
							class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-4 pt-8 pb-3 text-xs font-semibold text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100"
						>
							{foto.alt}
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
