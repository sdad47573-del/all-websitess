---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import pastelasHorno from '../assets/fotos/la-canela-asador-vertical-01.jpg';
import pastelasAzucar from '../assets/fotos/la-canela-asador-vertical-02.jpg';
import fachada from '../assets/fotos/la-canela-asador-vertical-03.jpg';
import croquetas from '../assets/fotos/la-canela-asador-apaisada-04.jpg';
import vitrina from '../assets/fotos/la-canela-asador-apaisada-05.jpg';
import arroz from '../assets/fotos/la-canela-asador-vertical-06.jpg';
import arrozCanela from '../assets/fotos/la-canela-asador-vertical-07.jpg';
import couscousVerduras from '../assets/fotos/la-canela-asador-vertical-08.jpg';
import couscousPollo from '../assets/fotos/la-canela-asador-apaisada-09.jpg';
import pastelas from '../assets/fotos/la-canela-asador-vertical-10.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'La Canela · Asador y comida casera en Palma-Palmilla';
const description =
	'La Canela, asador y comida casera árabe y andaluza en Av. Jane Bowles, 1, local 14 (Palma-Palmilla, 29011 Málaga). Pollo asado, pastela y couscous, halal y para llevar.';

const galeria = [
	{
		src: vitrina,
		alt: 'La vitrina de La Canela con tarrinas de comida preparada, bandejas de pastela y platos caseros listos para llevar',
	},
	{
		src: pastelas,
		alt: 'Pastelas de pollo espolvoreadas con azúcar glas en una bandeja de aluminio',
	},
	{
		src: couscousPollo,
		alt: 'Tarrina de couscous con pollo, calabacín, zanahoria y cebolla caramelizada',
	},
	{
		src: pastelasHorno,
		alt: 'Una mano con guante sacando del horno una bandeja de pastelas recién hechas',
	},
	{
		src: fachada,
		alt: 'La fachada de La Canela en la avenida Jane Bowles, con el rótulo, la buganvilla y el cartel de halal',
	},
	{
		src: croquetas,
		alt: 'Croquetas caseras doradas en una bandeja de aluminio',
	},
	{
		src: arroz,
		alt: 'Fuente de arroz con verduras y limón, junto a otra de arroz con carne y naranja',
	},
	{
		src: arrozCanela,
		alt: 'Arroz con canela en rama, frutos secos picados y una flor de naranja en el centro',
	},
	{
		src: pastelasAzucar,
		alt: 'Pastelas de pollo con azúcar glas y canela servidas en una bandeja metálica',
	},
	{
		src: couscousVerduras,
		alt: 'Tarrina de calabacín y zanahoria con salsa de cebolla y frutos secos picados',
	},
];

const pasos = [
	{
		title: 'Llama y pregunta',
		text: 'El teléfono de la ficha es el 614 73 96 21. Allí se consulta el pollo del día, las raciones, los precios y la disponibilidad.',
	},
	{
		title: 'Recoge o pide a domicilio',
		text: 'Google la clasifica como comida para llevar y comida a domicilio. Al llamar se confirma la zona de reparto y el tiempo de espera.',
	},
	{
		title: 'Cocina árabe, andaluza y halal',
		text: 'La casa trabaja el asador andaluz y la cocina árabe, con categoría halal en la ficha. Todo se prepara en el local.',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de La Canela',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-canela`,
	name: BUSINESS.name,
	alternateName: ['La Canela Málaga', 'La Canela Asador', 'La Canela comida casera'],
	description:
		'Asador y comida casera árabe y andaluza en la avenida Jane Bowles, 1, local 14 (Palma-Palmilla, 29011 Málaga). Pollo asado, pastela, couscous y platos halal para llevar o a domicilio.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34614739621',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina árabe', 'Cocina andaluza', 'Comida casera', 'Halal'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Tuesday',
			opens: '11:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:00',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Pedir', href: '#pedir' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2b190f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Marcellus&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Canela Málaga, asador Málaga, pollo asado Palma-Palmilla, comida casera Málaga, cocina árabe Málaga, restaurante halal Málaga, pastela, couscous, comida a domicilio Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Asador y comida casera árabe y andaluza en Palma-Palmilla. Pollo asado, pastela y couscous, halal, para llevar o a domicilio."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Couscous con pollo y verduras de La Canela, asador y comida casera en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#2b190f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Canela"
			subtitle="Asador y comida casera · Málaga"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. Jane Bowles, 1, local 14 · Palma-Palmilla"
				title="Asador y <br /><em>comida casera.</em>"
				lede={`La Canela junta el asador andaluz y la cocina árabe en Palma-Palmilla: pollo asado con patatas, pastelas, couscous y platos halal. Todo se prepara en el local, para llevar o a domicilio. Tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={fachada}
				imageAlt="Fachada de La Canela con el rótulo script y la buganvilla sobre el toldo, junto a los carteles de halal y reparto"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>11:00–16:00</b> · lunes cerrado' },
					{ label: 'Cocina', html: '<b>Halal</b> · árabe y andaluza' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Para llevar y a domicilio"
			/>

			<LocalChips label="Lo que ofrece La Canela" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Asador andaluz, <br /><em>mesa árabe.</em>"
				paragraphs={[
					'La Canela está en la avenida Jane Bowles, 1, local 14, en Palma-Palmilla. El rótulo con la flor, el toldo y la buganvilla de la puerta anuncian una casa de barrio en la que el asador convive con los tajines y las pastelas.',
					'En el escaparate se lee «auténtica fusión árabe y andaluza» y el sello halal. La ficha de Google la clasifica a la vez como restaurante árabe, halal, mediterráneo, de comida para llevar y de comida a domicilio.',
					'La cocina trabaja a diario: pollo asado, patatas, arroces, couscous, pastelas, croquetas y tarrinas de comida preparada en la vitrina. Las reseñas lo cuentan con nombres propios: «pollos asado con patatas, pastela y couscous, todo buenísimo».',
					'La casa tiene 4,9 sobre 5 con 82 reseñas. La mejor tarjeta de presentación es la de siempre: buen trato, servicio rápido y precios justos.',
				]}
				note="La ficha no publica carta, precios, página web ni redes sociales. Esta web solo cita las preparaciones que nombran las categorías y las reseñas, y enlaza el teléfono que aparece en la propia ficha."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="pedir" id="pedir" aria-labelledby="pedir-title">
				<div class="wrap">
					<div class="pedir-head">
						<div>
							<p class="section-label section-label-light"><span aria-hidden="true"></span> Cómo pedir</p>
							<h2 id="pedir-title">Se encarga <br /><em>por teléfono.</em></h2>
						</div>
						<p>
							No hay tienda online ni reservas por la web. La ficha publica un teléfono para
							consultar el día, encargar y confirmar el reparto.
						</p>
					</div>

					<ol class="pedir-grid">
						{
							pasos.map((paso, index) => (
								<li class="pedir-card">
									<span aria-hidden="true">Paso 0{index + 1}</span>
									<h3>{paso.title}</h3>
									<p>{paso.text}</p>
								</li>
							))
						}
					</ol>

					<p class="pedir-foot">
						Pedidos y consultas en el <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>. La web no
						publica una carta porque la ficha no la incluye.
					</p>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Del asador <br /><em>y de la mesa árabe.</em>"
				description="Sin carta publicada: esto es lo que nombran las categorías y las reseñas de Google. El resto cambia cada día."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La ficha de Google no incluye carta ni precios, así que esta página no inventa valores. Para saber qué hay hoy, qué incluye cada ración y cuánto cuesta, hay que llamar al teléfono del local."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El asador <br /><em>y la vitrina.</em>"
				description="Diez fotografías del perfil de La Canela en Google Maps: la fachada, la vitrina de comida preparada, las pastelas recién hechas, el couscous, los arroces y las croquetas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="opiniones" aria-labelledby="opiniones-title">
				<div class="wrap opiniones-grid">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="opiniones-title">Casi <em>perfecto.</em></h2>
						<p class="opiniones-score">
							<strong>{RATING.label}</strong>
							<span>
								<b>★★★★★</b>
								{RATING.count} reseñas<br />en Google
							</span>
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas ↗
						</a>
					</div>

					<ul class="reviews">
						{
							RESENAS.map((resena) => (
								<li>
									<p>«{resena.texto}»</p>
									<span aria-label={`${resena.valor} de 5 estrellas`}>
										{'★'.repeat(resena.valor)}
										{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
									</span>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Palma-<br /><em>Palmilla.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: martes de 11:00 a 17:00; de miércoles a domingo de 11:00 a 16:00; lunes cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de La Canela Asador en la avenida Jane Bowles, 1, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Av. Jane Bowles, 1 · local 14"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos por teléfono: la ficha no publica reservas online. Google marca el acceso para sillas de ruedas, pero no publica datos sobre aparcamiento adaptado, asientos adaptados o aseos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>llamar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma disponibilidad, precios y horario antes de la visita."
			ctaLabel="Llamar a La Canela"
			navAriaLabel="Enlaces de La Canela"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
