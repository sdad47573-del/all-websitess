---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/panchos-restaurant-apaisada-01.jpg';
import paella from '../assets/fotos/panchos-restaurant-vertical-10.jpg';
import chocos from '../assets/fotos/panchos-restaurant-apaisada-03.jpg';
import cordero from '../assets/fotos/panchos-restaurant-vertical-06.jpg';
import bocadillo from '../assets/fotos/panchos-restaurant-vertical-07.jpg';
import sandwiches from '../assets/fotos/panchos-restaurant-vertical-09.jpg';
import carta from '../assets/fotos/panchos-restaurant-vertical-02.jpg';

import { cidUrl, mapsUrl, placeId, reviewsUrl } from '../maps';

const business = {
	name: "Pancho's Restaurant",
	brand: "Pancho's",
	street: 'Carrer Santa Maria Rosa Molas, 19',
	city: 'Castelló de la Plana',
	region: 'Castelló',
	postalCode: '12004',
	phone: '964 23 24 48',
	latitude: 39.9961313,
	longitude: -0.0352371,
	rating: 4.1,
	reviewsCount: 2597,
	site: 'https://panchos-restaurant.vercel.app',
};

const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34964232448';

const description =
	"Pancho's Restaurant, bar de tapas en la calle Santa Maria Rosa Molas, 19, Castellón: raciones, bocadillos, hamburguesas y paellas de 9:00 a 24:00.";

const servicios = [
	'Tapas y raciones',
	'Bocadillos',
	'Hamburguesas',
	'Arroces y paellas',
	'Desayunos',
	'Brunch',
	'Cafetería',
	'Cocina hasta medianoche',
	'Reservas por teléfono',
	'Acceso adaptado',
];

const grupos = [
	{
		title: 'Raciones y tapas',
		items: [
			{
				name: 'Chocos a la plancha',
				note: 'con ajo y perejil, de los que salen a la plancha todo el día',
			},
			{
				name: 'Chuletillas con patatas',
				note: 'a la plancha, con patatas fritas de guarnición',
			},
			{
				name: 'Patés y embutidos',
				note: '«muy buenas raciones, hamburguesas, ensalada y patés», dice una reseña',
			},
			{
				name: 'Ensaladas',
				note: 'de la carta de siempre, para acompañar las raciones',
			},
		],
	},
	{
		title: 'Bocadillos y bocatería',
		items: [
			{
				name: 'Bocadillo de jamón',
				note: '«pedimos uno de jamón recién cortado y otro de tortilla», cuenta una reseña',
			},
			{
				name: 'Bocadillo de tortilla',
				note: 'en pan de bocadillo, de los clásicos de la casa',
			},
			{
				name: 'Sándwiches con patatas',
				note: 'cuatro mitades con jamón, queso, lechuga y zanahoria aliñada',
			},
			{
				name: 'Hamburguesas',
				note: 'la otra ración que repiten las reseñas',
			},
		],
	},
	{
		title: 'De la paella',
		items: [
			{
				name: 'Paella de marisco',
				note: 'con gambas, mejillones, calamar y alcachofa, en paella de acero',
			},
			{
				name: 'Arroces por encargo',
				note: 'la disponibilidad cambia según el día; se pregunta al reservar',
			},
		],
	},
	{
		title: 'Desayunos y brunch',
		items: [
			{
				name: 'Café y tostadas',
				note: 'la barra abre a las 9:00 de lunes a sábado',
			},
			{
				name: 'Brunch de fin de semana',
				note: '«excelente lugar para desayunar, almorzar, brunch, comer, merendar y cenar»',
			},
		],
	},
];

const galeria = [
	{
		src: paella,
		alt: "Paella de marisco con gambas, mejillones y calamar de Pancho's Restaurant",
	},
	{
		src: chocos,
		alt: "Chocos a la plancha con ajo y perejil de Pancho's Restaurant, Castellón",
	},
	{
		src: cordero,
		alt: "Chuletillas a la plancha con patatas fritas de Pancho's Restaurant",
	},
	{
		src: bocadillo,
		alt: "Bocadillo de jamón y queso de Pancho's Restaurant",
	},
	{
		src: sandwiches,
		alt: "Sándwiches con patatas fritas de Pancho's Restaurant",
	},
	{
		src: carta,
		alt: "Carta amarilla con el logotipo de Pancho's en la mesa del restaurante",
	},
];

const faqs = [
	{
		q: "¿Dónde está Pancho's Restaurant?",
		a: 'En el número 19 de la calle Santa Maria Rosa Molas, en Castellón de la Plana (12004). Es un bajo de ladrillo con el escaparate de aluminio y el cartel redondo de Pancho\'s en la esquina, sobre la acera. La ficha de Google marca aparcamiento adaptado para sillas de ruedas. El botón «Cómo llegar» abre la ruta exacta en Google Maps.',
	},
	{
		q: '¿Qué horario tiene?',
		a: 'Abre todos los días. De lunes a sábado, de 9:00 a 24:00, y el domingo desde las 12:00 hasta medianoche. El horario publicado no marca cierre a mediodía, así que el local está abierto de forma corrida; en las horas valle conviene confirmar por teléfono qué hay de cocina.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'La ficha lo clasifica como restaurante especializado en tapas, cafetería y restaurante de comida rápida. En sus fotos y reseñas aparecen raciones como los chocos a la plancha o las chuletillas con patatas, bocadillos de jamón recién cortado y de tortilla, sándwiches, hamburguesas, ensaladas, patés y paellas de marisco.',
	},
	{
		q: '¿Se puede desayunar y hacer brunch?',
		a: 'Sí. La barra abre a las 9:00 de lunes a sábado (el domingo, a las 12:00), y las reseñas lo recomiendan expresamente para desayunar, almorzar, hacer brunch, merendar y cenar. Es el mismo local a cualquier hora del día, sin cambiar de carta.',
	},
	{
		q: '¿Hay paella?',
		a: 'Sí: en las fotos de la ficha aparece la paella de marisco, con gambas, mejillones, calamar y alcachofa, servida en paella de acero. No hay día fijo publicado para los arroces, así que conviene llamar al 964 23 24 48 y preguntar si hay paella ese día y para cuántos comensales.',
	},
	{
		q: '¿Cuánto cuesta y hay menú del día?',
		a: 'La ficha de Google no publica carta con precios ni un menú del día, y esta web no inventa importes: la selección de platos sale de sus fotos y de lo que citan sus reseñas. Precios, menú y raciones se consultan por teléfono en el 964 23 24 48 o directamente en el local.',
	},
	{
		q: '¿Cómo se reserva?',
		a: 'Por teléfono, en el 964 23 24 48. No hay reserva online ni formulario en esta web. Con 2.597 reseñas y un local que funciona de la mañana a la noche, para grupos y fines de semana conviene llamar con tiempo.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'La ficha marca acceso, aseo, asientos y aparcamiento adaptados para sillas de ruedas. El local está a pie de calle, con la puerta al mismo nivel de la acera; si necesitas una mesa concreta o ayuda para entrar, avisa al reservar por teléfono.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ["Pancho's", "Panchos Restaurant Castellón", "Pancho's Castellón"],
	slogan: 'Tapas, bocadillos y paellas de la mañana a la noche',
	description,
	url: `${business.site}/`,
	telephone: '+34 964 23 24 48',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Tapas', 'Cocina española', 'Arroces', 'Bocadillos', 'Hamburguesas', 'Cafetería'],
	areaServed: [
		{ '@type': 'City', name: 'Castelló de la Plana' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: '0xd5fffcc87bbe49d:0x3d3e684705e33fb2' },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '09:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '12:00',
			closes: '23:59',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Pancho's Restaurant · Tapas y cocina de 9 a 24 en Castellón</title>
		<meta name="theme-color" content="#c4172a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Pancho's Restaurant, Panchos Castellón, bar de tapas Castellón, bocadillos Castellón, hamburguesas Castellón, paella Castellón, desayunos Castellón, brunch, Santa Maria Rosa Molas, Plana Alta"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Pancho's Restaurant · Tapas y cocina de 9 a 24 en Castellón"
			ogDescription="Raciones, bocadillos, hamburguesas y paellas en la calle Santa Maria Rosa Molas. Abierto todos los días de 9:00 a 24:00. 4,1 en Google con 2.597 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Paella de marisco de Pancho's Restaurant en Castellón"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#c4172a"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Castelló de la Plana, Castelló"
			contact={{
				street: business.street,
				locality: business.city,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[fachada]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="V"
			name={business.brand}
			subtitle="Tapas · Bocadillos · Castellón"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer Santa Maria Rosa Molas, 19 · Castelló"
				title="De la mañana<br /><em>a la noche.</em>"
				lede="Pancho's es bar de tapas y restaurante en la calle Santa Maria Rosa Molas: raciones, bocadillos, hamburguesas, ensaladas y paellas, con la cocina funcionando desde las nueve de la mañana hasta medianoche, todos los días de la semana."
				image={fachada}
				imageAlt="Fachada de ladrillo y cartel redondo de Pancho's Restaurant en Castellón"
				primaryCta={{ label: 'Llamar 964 23 24 48', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,1 en Google</b> con 2.597 reseñas' },
					{ label: 'De lunes a sábado', html: '<b>9:00 – 24:00</b>' },
					{ label: 'Domingo', html: '<b>12:00 – 24:00</b>' },
					{ label: 'La casa', html: '<b>Tapas y raciones</b>' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Pancho's Restaurant" items={servicios} />

			<LocalAbout
				label="Bar de tapas, cocina todo el día"
				title="La misma barra<br />desde el café<br /><em>hasta la última ración.</em>"
				paragraphs={[
					'El local está en el número 19 de la calle Santa Maria Rosa Molas, con la fachada de ladrillo, el escaparate de aluminio y el cartel redondo de Pancho\'s en la esquina. Por la mañana funciona como cafetería y bar de tapas; a la noche, como restaurante. Es el mismo sitio, con la misma cocina y la misma carta.',
					'La ficha lo clasifica como restaurante especializado en tapas, cafetería y restaurante de comida rápida, y las reseñas dibujan lo que se pide en la mesa: raciones para compartir —chocos a la plancha, chuletillas con patatas—, bocadillos de jamón recién cortado y de tortilla, sándwiches, hamburguesas, ensaladas y patés. Cuando hay, también sale paella de marisco.',
					'Abre todos los días del año: de lunes a sábado de 9:00 a 24:00 y el domingo desde las 12:00. La ficha suma 2.597 opiniones con un 4,1, y las reseñas insisten en lo mismo: raciones generosas y un local al que se puede ir a cualquier hora.',
				]}
				note="«Excelente lugar para desayunar, almorzar, brunch, comer, merendar y cenar», resume una reseña. Otra: «muy buenas raciones, hamburguesas, ensalada y patés, todo muy rico»."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Tapas, bocatas<br /><em>y paella.</em>"
				description="La ficha de Google no publica la carta con precios, así que esta selección sale de lo que aparece en sus fotos y de lo que citan sus reseñas: las raciones de barra, los bocadillos, las hamburguesas y la paella de marisco."
				cta={{ label: 'Preguntar qué hay hoy', href: phoneHref }}
				groups={grupos}
				note="Sin precios: la ficha no los publica y esta web no los inventa. El menú del día, las raciones y los importes se consultan por teléfono en el 964 23 24 48."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La paella,<br />la barra<br /><em>y el bocata.</em>"
				description="Estas fotografías proceden del perfil de Pancho's Restaurant en Google Maps: la paella de marisco, los chocos a la plancha, las chuletillas con patatas, el bocadillo de jamón, la bandeja de sándwiches y la carta amarilla de la casa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer Santa Maria Rosa Molas, 19 · 12004 Castelló"
				title="Aquí se come<br /><em>a cualquier hora.</em>"
				addressLines={[business.street, `${business.postalCode} ${business.city}`, 'Castelló, España']}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: '9:00 – 24:00' },
					{ day: 'Martes', value: '9:00 – 24:00' },
					{ day: 'Miércoles', value: '9:00 – 24:00' },
					{ day: 'Jueves', value: '9:00 – 24:00' },
					{ day: 'Viernes', value: '9:00 – 24:00' },
					{ day: 'Sábado', value: '9:00 – 24:00' },
					{ day: 'Domingo', value: '12:00 – 24:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google: abierto los siete días, de 9:00 a 24:00 de lunes a sábado y desde las 12:00 el domingo, sin cierre a mediodía. En fiestas y en agosto suele cambiar: llama antes al 964 23 24 48."
				mapTitle="Mapa de Pancho's Restaurant en la calle Santa Maria Rosa Molas, 19, Castellón"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Pancho's · Castellón"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Las reservas se hacen por teléfono, llamando al 964 23 24 48: no hay reserva online ni formulario en esta web. La ficha marca acceso, aseo, asientos y aparcamiento adaptados."
			/>

			<LocalFaq items={faqs} title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark="V"
			name="Pancho's Restaurant"
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Pancho's"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
