---
import WhatsappFab from '../components/WhatsappFab.astro';
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

const business = {
	name: 'Mesón El Andén',
	tagline: 'Cocina casera mediterránea · Menú diario en Canteras',
	street: 'C. Monte San Juan, 13-15',
	district: 'Canteras',
	city: 'Cartagena',
	region: 'Región de Murcia',
	postalCode: '30394',
	phone: '968 51 67 27',
	latitude: 37.6135044,
	longitude: -1.0248441,
	site: 'https://meson-el-anden.vercel.app',
};

const mapsUrl = `https://www.google.com/maps/place/Mes%C3%B3n+El+And%C3%A9n/@${business.latitude},${business.longitude},17z/data=!3m1!4b1!4m6!3m5!1s0xd63428b54c1860f:0x5c29fc92e3c7e422!8m2!3d${business.latitude}!4d${business.longitude}!16s%2Fg%2F11y80xwzt`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34968516727';
const instagramUrl = 'https://www.instagram.com/mesonelandenct/';
const facebookUrl = 'https://www.facebook.com/mesonelanden/';

const description =
	'Mesón El Andén, bar de tapas y restaurante en C. Monte San Juan 13-15, Canteras (Cartagena): menú diario variado de cocina casera mediterránea, terraza, salón privado y parking. Lun–sáb 11:30–17:00. Tel. 968 51 67 27.';

const servicios = [
	'Menú diario variado',
	'Cocina casera',
	'Bar de tapas',
	'Terraza / jardín',
	'Salón privado',
	'Menú para grupos',
	'Parking',
	'Acceso discapacitados',
	'Wifi',
];

const platos = [
	{ name: 'Menú diario variado', note: 'mediterráneo casero, la razón para volver cada semana' },
	{ name: 'Tapas de bar', note: 'para el vermú antes de sentarse a la mesa' },
	{ name: 'Platos de cuchara', note: 'fondo casero de mediodía' },
	{ name: 'Carnes y pescados del día', note: 'producto de mercado según temporada' },
	{ name: 'Menú para grupos', note: 'salón privado para celebraciones' },
	{ name: 'Postres caseros', note: 'cierre dulce del menú' },
];

const fotos = [
	{ src: '/fotos/salon-meson.svg', alt: 'Ilustración placeholder del salón climatizado del mesón — sustituir por foto propia' },
	{ src: '/fotos/menu-diario.svg', alt: 'Ilustración placeholder del menú diario variado — sustituir por foto propia' },
	{ src: '/fotos/tapas-caseras.svg', alt: 'Ilustración placeholder de tapas y cocina casera — sustituir por foto propia' },
	{ src: '/fotos/terraza-jardin.svg', alt: 'Ilustración placeholder de la terraza jardín — sustituir por foto propia' },
	{ src: '/fotos/salon-privado.svg', alt: 'Ilustración placeholder del salón privado para grupos — sustituir por foto propia' },
	{ src: '/fotos/exterior-canteras.svg', alt: 'Ilustración placeholder del exterior en Canteras — sustituir por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Mesón El Andén?',
		a: 'En C. Monte San Juan 13-15, Canteras, 30394 Cartagena (Murcia). Bar de tapas y restaurante con salón climatizado, terraza/jardín, salón privado y parking.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De lunes a sábado de 11:30 a 17:00; domingos cerrado (ficha pública 2026). Es horario de mediodía, pensado para el menú diario. Confirma en festivos en el 968 51 67 27.',
	},
	{
		q: '¿Qué se come en El Andén?',
		a: 'Cocina casera mediterránea con menú diario variado: tapas de bar, platos de cuchara, carnes y pescados del día y postres caseros. También hay menú para grupos.',
	},
	{
		q: '¿Tienen sitio para grupos o celebraciones?',
		a: 'Sí: salón privado y menú para grupos. Para 6 o más, llama con al menos 24 h de antelación al 968 51 67 27.',
	},
	{
		q: '¿Es accesible y tiene parking?',
		a: 'Sí: acceso para discapacitados, terraza/jardín, wifi, aire acondicionado y parking. Acepta Visa, Mastercard y Diners Club.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'Aceptan sin reserva según disponibilidad, pero al ser horario concentrado de mediodía, mejor llamar antes, sobre todo en grupo.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 968 51 67 27',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Española', 'Cocina casera', 'Tapas'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'C. Monte San Juan, 13-15',
		addressLocality: business.city,
		addressRegion: 'Murcia',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: { '@type': 'GeoCoordinates', latitude: business.latitude, longitude: business.longitude },
	hasMap: mapsUrl,
	sameAs: [instagramUrl, facebookUrl, mapsUrl],
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '11:30', closes: '17:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza / jardín', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Salón privado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Parking', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso discapacitados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Menú para grupos', value: true },
	],
	aggregateRating: { '@type': 'AggregateRating', ratingValue: 4.6, reviewCount: 738, bestRating: 5 },
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Qué pedir', href: '#carta' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Mesón El Andén | Cocina casera y menú diario en Canteras, Cartagena</title>
		<meta name="theme-color" content="#201310" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Mesón El Andén, restaurante Canteras, Monte San Juan 13, menú diario Cartagena, cocina casera Cartagena, tapas Canteras, comer en Canteras"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Mesón El Andén · Menú diario casero en Canteras"
			ogDescription="Bar de tapas y restaurante en Monte San Juan 13-15, Cartagena: menú diario mediterráneo, terraza y salón privado. Lun–sáb 11:30–17:00."
			ogImage={`${business.site}/og.svg`}
			ogImageAlt="Mesón El Andén, cocina casera en Canteras, Cartagena"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#201310"
			street={business.street}
			city={business.city}
			region="Murcia"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Canteras, Cartagena"
			preload={[]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Cartagena" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<style>
			.hero-custom { display:grid; grid-template-columns: 1.05fr 0.95fr; gap:2.5rem; align-items:center; padding:4.5rem 0 2.5rem; }
			.hero-custom h1 { font-size: clamp(2.6rem, 5.4vw, 4.4rem); line-height:1.02; margin:0.6rem 0 1rem; }
			.hero-custom h1 em { color: var(--amber); font-style:normal; }
			.hero-custom img { width:100%; height:auto; border-radius: var(--radius); border:1px solid var(--line); }
			.fotos-grid { display:grid; grid-template-columns: repeat(3, 1fr); gap:1rem; margin-top:1.6rem; }
			.fotos-grid figure { margin:0; border:1px solid var(--line); border-radius:14px; overflow:hidden; background:var(--deep-2); }
			.fotos-grid img { width:100%; height:220px; object-fit:cover; display:block; }
			.fotos-grid figcaption { padding:0.6rem 0.8rem; font-size:0.85rem; color:var(--muted); }
			.aviso-fotos { border:1px dashed var(--amber); border-radius:14px; padding:1rem 1.2rem; background:rgba(232,161,61,0.08); font-size:0.95rem; }
			@media (max-width: 980px){ .hero-custom{grid-template-columns:1fr; padding-top:3rem;} .fotos-grid{grid-template-columns:1fr 1fr;} }
			@media (max-width: 640px){ .fotos-grid{grid-template-columns:1fr;} .fotos-grid img{height:200px;} }
		</style>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="A"
			name={business.name}
			subtitle="Canteras · Cartagena"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<section class="hero-custom wrap" id="inicio" aria-labelledby="hero-title">
				<div>
					<p class="eyebrow"><span aria-hidden="true"></span> Monte San Juan 13-15 · Canteras</p>
					<h1 id="hero-title">Cocina casera<br />de mediodía,<br /><em>como en casa.</em></h1>
					<p class="hero-lede">Bar de tapas y restaurante en Canteras: menú diario variado de gastronomía mediterránea, terraza, salón privado y parking. De lunes a sábado, de 11:30 a 17:00.</p>
					<div class="hero-actions">
						<a class="button button-primary" href={phoneHref}>Llamar 968 51 67 27</a>
						<a class="button button-ghost" href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,6</b> en Google (738 opiniones)</li>
						<li><b>Menú diario</b> variado</li>
						<li><b>Salón privado</b> + grupos</li>
						<li><b>Domingo</b> cerrado</li>
					</ul>
				</div>
				<figure style="margin:0">
					<img src="/fotos/salon-meson.svg" alt="Ilustración del salón de Mesón El Andén en Canteras" fetchpriority="high" />
					<figcaption style="color:var(--muted);font-size:0.85rem;margin-top:0.5rem">Imagen provisional — sustitúyela por fotos propias. <a href={mapsUrl} target="_blank" rel="noreferrer">Ver galería en Maps ↗</a></figcaption>
				</figure>
			</section>

			<LocalChips label="Servicios de Mesón El Andén" items={servicios} />

			<LocalAbout
				label="El mesón de Canteras"
				title="Menú diario,<br />producto mediterráneo<br /><em>y sobremesa tranquila.</em>"
				paragraphs={[
					'Mesón El Andén está en Monte San Juan 13-15, Canteras: restaurante con menú diario y variado donde se degusta cocina casera de gastronomía mediterránea, con bar de tapas a la entrada.',
					'Salón climatizado, terraza/jardín, salón privado para grupos, wifi, parking y acceso para discapacitados: pensado para el día a día —trabajadores, familias y celebraciones— más que para la noche.',
					'Con 4,6 sobre cientos de opiniones públicas, su regularidad es su fama: trato coherente y cocina sin sorpresas.',
				]}
				note="Horario concentrado de mediodía (11:30–17:00). Para grupos de 6 o más, llama con 24 h de antelación."
				links={[
					{ label: 'Instagram del mesón', href: instagramUrl, external: true },
					{ label: 'Facebook del mesón', href: facebookUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="Lo más pedido"
				title="Qué pedir<br /><em>en El Andén.</em>"
				description="El menú diario manda y cambia: estos son los fijos que nunca fallan. Pregunta por el plato del día al llegar."
				cta={{ label: 'Reservar por teléfono', href: phoneHref }}
				groups={[{ title: 'La carta', items: platos }]}
				note="Menú para grupos disponible. Acepta Visa, Mastercard y Diners Club."
			/>

			<section class="section-pad wrap" id="fotos" aria-labelledby="fotos-title">
				<p class="eyebrow"><span aria-hidden="true"></span> Fotos</p>
				<h2 id="fotos-title">El mesón, <em style="color:var(--amber);font-style:normal">en imágenes.</em></h2>
				<div class="aviso-fotos" role="note">
					<strong>⚠️ Sobre las fotos de Google Maps:</strong> no las he descargado ni copiado: las imágenes de la ficha de Google tienen derechos de sus autores y las condiciones de Google Maps no permiten extraerlas automáticamente. Esta web usa <strong>ilustraciones placeholder propias</strong> en <code>public/fotos/</code>. Sustitúyelas por fotos propias del local (mismo nombre de archivo) y se publicarán solas.
				</div>
				<div class="fotos-grid">
					{fotos.map((f) => (
						<figure>
							<img src={f.src} alt={f.alt} loading="lazy" decoding="async" />
							<figcaption>{f.alt.split('—')[0]}</figcaption>
						</figure>
					))}
				</div>
				<p style="margin-top:1rem"><a class="button button-ghost" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos reales en Google Maps ↗</a></p>
			</section>

			<LocalVisit
				eyebrow="Monte San Juan 13-15 · 30394 Cartagena"
				title="Nos vemos<br /><em>en Canteras.</em>"
				addressLines={[
					'C. Monte San Juan, 13-15',
					'Canteras',
					'30394 Cartagena (Murcia), España',
				]}
				hours={[
					{ day: 'Lunes', value: '11:30 – 17:00' },
					{ day: 'Martes', value: '11:30 – 17:00' },
					{ day: 'Miércoles', value: '11:30 – 17:00' },
					{ day: 'Jueves', value: '11:30 – 17:00' },
					{ day: 'Viernes', value: '11:30 – 17:00' },
					{ day: 'Sábado', value: '11:30 – 17:00' },
					{ day: 'Domingo', value: 'Cerrado', closed: true },
				]}
				hoursNote="Horario de ficha pública (2026). Confirma en festivos por teléfono."
				mapTitle="Mapa de Mesón El Andén en Monte San Juan 13-15, Canteras, Cartagena"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Mesón El Andén · Canteras"
				mapHref={mapsUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Instagram', href: instagramUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Grupos de 6 o más: llamar con 24 h de antelación al 968 51 67 27."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="A"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Cómo llegar ↗', href: directionsUrl, external: true },
				{ label: 'Instagram ↗', href: instagramUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Ilustraciones propias provisionales. Información elaborada a partir de fuentes públicas; confirma horarios y precios antes de la visita."
			ctaLabel="Llamar a El Andén"
		/>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
		<WhatsappFab phone={phoneHref} name={business.name} />
	</body>
</html>
