---
import { Image } from 'astro:assets';
import { BUSINESS, IMAGES } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
---

<section id="inicio" class="hero-encina relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.fotoApaisada1}
			alt="Asador Grimaldo, en Grimaldo (Cáceres)"
			widths={[640, 1100, 1600]}
			sizes="100vw"
			quality={68}
			loading="eager"
			fetchpriority="high"
			class="h-full w-full object-cover opacity-30"
		/>
		<div class="from-neutral/95 via-neutral/70 absolute inset-0 bg-gradient-to-r"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
		<div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
			<div>
				<p class="text-accent inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase">
					<span>
						<i class="ri-map-pin-line"></i> Grimaldo · Cáceres
					</span>
					<span class="text-white/50">Desde 2007</span>
				</p>

				<h1 class="font-display mt-4 text-5xl leading-[0.98] font-bold sm:text-6xl lg:text-7xl">
					Asador <span class="text-accent">Grimaldo</span>
				</h1>

				<p class="mt-6 max-w-xl text-base leading-relaxed text-white/80 sm:text-lg">
					Carne de buey a la brasa con carbón de encina, cochinillo y cabrito al horno, bacalao de
					la casa y postres caseros. Un asador familiar a pie de la N-630, en la Vía de la Plata.
				</p>

				<div class="mt-7 flex flex-wrap items-center gap-3">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="badge badge-lg gap-2 border-white/20 bg-white/10 px-4 py-3 text-sm font-semibold text-white"
					>
						<span class="text-accent tracking-tight" aria-hidden="true">
							{estrellas.map((n) => (
								<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
							))}
						</span>
						{BUSINESS.rating.toString().replace('.', ',')} · {BUSINESS.reviewCount} reseñas en
						Google
					</a>
				</div>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-secondary btn-lg gap-2 rounded-full">
						<i class="ri-phone-line text-xl"></i>
						{BUSINESS.phone}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-lg gap-2 rounded-full border-white/35 bg-transparent text-white hover:border-white hover:bg-white hover:text-neutral"
					>
						<i class="ri-google-fill"></i>
						Ver ficha de Google
					</a>
				</div>

				<dl class="mt-10 grid gap-x-6 gap-y-5 border-t border-white/15 pt-7 sm:grid-cols-3">
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Comidas</dt>
						<dd class="mt-1 text-base font-bold">13:00 – 18:00</dd>
						<dd class="text-xs text-white/55">Martes a domingo · lunes cerrado</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">El fuego</dt>
						<dd class="mt-1 text-base font-bold">Encina</dd>
						<dd class="text-xs text-white/55">Brasa, horno y cocina casera</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Dónde</dt>
						<dd class="mt-1 text-base font-bold">{BUSINESS.street}</dd>
						<dd class="text-xs text-white/55">
							{BUSINESS.postalCode} {BUSINESS.city}
						</dd>
					</div>
				</dl>
			</div>

			<figure class="relative mx-auto w-full max-w-md lg:max-w-none">
				<div class="border-accent/40 absolute -inset-2 rotate-2 rounded-3xl border"></div>
				<div class="relative grid grid-cols-5 items-end gap-3">
					<div class="col-span-3 overflow-hidden shadow-2xl arco">
						<Image
							src={IMAGES.fotoVertical3}
							alt="Interior de Asador Grimaldo"
							widths={[360, 620]}
							sizes="(min-width: 1024px) 22vw, 55vw"
							quality={85}
							loading="eager"
							class="foto-calida aspect-[3/4] w-full object-cover"
						/>
					</div>
					<div class="col-span-2 flex flex-col gap-3">
						<div class="overflow-hidden rounded-xl shadow-xl">
							<Image
								src={IMAGES.fotoApaisada6}
								alt="Ambiente de Asador Grimaldo"
								widths={[260, 440]}
								sizes="(min-width: 1024px) 15vw, 38vw"
								quality={85}
								loading="lazy"
								class="foto-calida aspect-square w-full object-cover"
							/>
						</div>
						<div class="sello-encina bg-secondary/90 flex flex-1 flex-col items-center justify-center rounded-full px-3 py-6 text-center">
							<i class="ri-fire-line text-accent text-2xl" aria-hidden="true"></i>
							<span class="mt-1 text-[0.6rem] leading-tight tracking-[0.14em] text-white/75 uppercase">
								brasa
								<br />
								de encina
							</span>
						</div>
					</div>
				</div>
				<figcaption class="text-accent-content bg-accent mt-5 inline-flex items-center gap-2 rounded-full px-4 py-2 text-xs font-bold shadow-lg">
					<i class="ri-award-line"></i> Una Flor de Jara
				</figcaption>
			</figure>
		</div>
	</div>

	<div class="cenefa-encina relative h-3 w-full"></div>
</section>
