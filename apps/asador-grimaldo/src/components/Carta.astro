---
import { BUSINESS, CARTA, VENTAJAS } from '../data/site';
---

<section id="carta" class="carta-encina relative overflow-hidden py-20 text-white sm:py-24">
	<div class="fuego-encina absolute inset-0 opacity-40" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
			<div>
				<p class="text-accent text-xs font-semibold tracking-[0.22em] uppercase">La carta</p>
				<h2 class="font-display mt-3 text-3xl leading-tight font-bold sm:text-4xl">
					De la brasa al horno
				</h2>
				<p class="mt-4 max-w-xl leading-relaxed text-white/70">
					Las especialidades de la casa y lo que más se repite en las reseñas. La carta cambia con
					la temporada y el mercado: pregunta qué hay hoy al sentarte.
				</p>
			</div>
			<a href={BUSINESS.phoneHref} class="btn btn-secondary shrink-0 gap-2 rounded-full">
				<i class="ri-phone-line"></i> Reservar por teléfono
			</a>
		</div>

		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{CARTA.map((plato, index) => (
				<article class="text-base-content border-base-300 relative flex flex-col rounded-xl border bg-base-100 p-6">
					<span class="font-display text-secondary/25 text-4xl leading-none font-bold">
						{String(index + 1).padStart(2, '0')}
					</span>
					<p class="text-secondary mt-4 text-[0.65rem] font-bold tracking-[0.18em] uppercase">
						{plato.kicker}
					</p>
					<h3 class="font-display mt-1 text-xl font-bold">{plato.title}</h3>
					<p class="text-base-content/65 mt-2 flex-1 text-sm leading-relaxed">{plato.text}</p>
					<span class="text-secondary bg-secondary/10 mt-5 inline-flex size-9 items-center justify-center rounded-full">
						<i class={`${plato.icon} text-lg`} />
					</span>
				</article>
			))}
		</div>

		<div class="relative mt-6 grid gap-6 rounded-xl border border-white/15 bg-white/5 px-6 py-7 sm:px-8 lg:grid-cols-[1fr_auto] lg:items-center">
			<div>
				<h3 class="font-display text-xl font-bold sm:text-2xl">Carta y precios, en el asador</h3>
				<p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/65">
					Esta web no publica importes sin confirmar. La carta del día, las raciones y la
					disponibilidad se consultan en el restaurante o llamando al {BUSINESS.phone}.
				</p>
			</div>
			<div class="flex flex-wrap gap-2">
				{VENTAJAS.map((v) => (
					<span class="badge gap-1.5 rounded-full border-white/20 bg-white/10 px-3 py-3 text-xs text-white">
						<i class={`${v.icon} text-accent`} /> {v.title}
					</span>
				))}
			</div>
		</div>
	</div>
</section>
