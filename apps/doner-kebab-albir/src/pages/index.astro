---
const name = 'Doner Kebab Albir';
const mapsUrl =
	'https://www.google.com/maps/place/Doner+Kebab+Albir/@38.5731292,-0.0749422,17z/data=!3m1!4b1!4m6!3m5!1s0xd6203fc1617e57b:0x2e5efc545fb96da0!8m2!3d38.5731292!4d-0.0749422!16s%2Fg%2F1q5bq209s';
const title = `${name} · Albir`;
const description = `${name} en Albir (Alicante). Encuentra el local en Google Maps.`;
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href="https://doner-kebab-albir.vercel.app/" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<style>
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
				color: #1f1f1f;
				background: #fbf7f0;
				line-height: 1.6;
			}
			main {
				flex: 1;
				display: grid;
				place-content: center;
				text-align: center;
				padding: 3rem 1.5rem;
				gap: 1rem;
			}
			h1 {
				margin: 0;
				font-size: clamp(2.2rem, 6vw, 3.6rem);
				color: #7a2e0e;
			}
			p {
				margin: 0 auto;
				max-width: 36rem;
			}
			a.button {
				display: inline-block;
				justify-self: center;
				margin-top: 0.5rem;
				padding: 0.8rem 1.5rem;
				background: #c2410c;
				color: #fff;
				text-decoration: none;
				border-radius: 6px;
				font-weight: 600;
			}
			a.button:hover {
				background: #9a3412;
			}
			footer {
				padding: 1.5rem;
				text-align: center;
				font-size: 0.9rem;
				background: #1f1f1f;
				color: rgba(255, 255, 255, 0.8);
			}
			footer a {
				color: #fdba74;
			}
		</style>
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Restaurant",
	"@id": "https://doner-kebab-albir.vercel.app/#negocio",
	"name": "Doner Kebab Albir",
	"url": "https://doner-kebab-albir.vercel.app/",
	"description": "${name} en Albir (Alicante). Encuentra el local en Google Maps.",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 38.5731292,
		"longitude": -0.0749422
	},
	"hasMap": "https://www.google.com/maps/place/Doner+Kebab+Albir/@38.5731292,-0.0749422,17z/data=!3m1!4b1!4m6!3m5!1s0xd6203fc1617e57b:0x2e5efc545fb96da0!8m2!3d38.5731292!4d-0.0749422!16s%2Fg%2F1q5bq209s"
}
</script>
		<meta property="og:image" content="https://doner-kebab-albir.vercel.app/og.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta property="og:url" content="https://doner-kebab-albir.vercel.app/" />
		<meta property="og:locale" content="es_ES" />
	</head>
	<body>
		<main>
			<h1 set:html={piezas.portada.titulo} />
			<p>Albir, Alicante. Consulta el local, las fotos y cómo llegar en Google Maps.</p>
			<a class="button" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver en Google Maps</a>
		</main>
		<footer>
			<p>
				Web creada por
				<a href="https://sur-digital.vercel.app/" target="_blank" rel="noopener noreferrer">Sur Digital</a>
				· sur-digital.vercel.app
			</p>
		</footer>
	</body>
</html>
