---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/horno-panaderia-confiteria-vertical-01.jpg';

import {
	BUSINESS,
	FAQ,
	FICHA,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	PIZARRA,
	SERVICIOS,
} from '../data/site';

const title = 'Horno panadería confitería · Hermano Juan Fernández, 29, Córdoba';
const description = BUSINESS.description;

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#horno-panaderia-confiteria`,
	name: BUSINESS.name,
	alternateName: ['Horno panadería confitería Levante', 'Horno panadería Córdoba 14014'],
	description:
		'Panadería y confitería en la calle Hermano Juan Fernández, 29 (Levante, 14014 Córdoba): barras, vienas, bollería, empanadas, tartas y pan 100% ecológico de centeno, integral y espelta.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La ficha', href: '#casa' },
	{ label: 'La pizarra', href: '#pizarra' },
	{ label: 'Datos', href: '#ficha' },
	{ label: 'Visítanos', href: '#visitanos' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f3d34" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Horno panadería confitería Córdoba, panadería Hermano Juan Fernández, panadería Levante Córdoba, pan ecológico centeno espelta Córdoba, confitería 14014, empanadas Córdoba"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería y confitería en la calle Hermano Juan Fernández, 29 (Levante, 14014 Córdoba). Barras, vienas, bollería, empanadas, tartas y pan 100% ecológico de centeno, integral y espelta, según la pizarra de la puerta. 4,6 sobre 5 con 5 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada del Horno panadería confitería en la calle Hermano Juan Fernández, 29"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1f3d34"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: '',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Panadería · Confitería"
			nav={nav}
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Levante · 14014 Córdoba"
				title="Pan y dulces <br /><em>de confitería.</em>"
				lede={`En la calle Hermano Juan Fernández, 29, en el Levante. Google la clasifica como panadería y el rótulo de la fachada reparte el negocio entre panadería y confitería. La pizarra de la puerta anuncia barras, vienas, bollería y pan 100% ecológico de centeno, integral y espelta; la ventana añade empanadas y tartas. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas. Google no publica teléfono ni horario: la web no los inventa.`}
				image={fachada}
				imageAlt="Fachada del Horno panadería confitería, con el rótulo, el toldo a rayas y la pizarra de ofertas en la acera"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> en Google · 5 reseñas' },
					{ label: 'Horario', html: '<b>No publicado</b> en la ficha' },
					{ label: 'Dirección', html: '<b>Levante</b> · 14014 Córdoba' },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Hermano Juan Fernández, 29"
			/>

			<LocalChips label="Lo que anuncia la casa" items={SERVICIOS} />

			<LocalAbout
				label="La ficha"
				title="Lo que se sabe <br /><em>del horno.</em>"
				paragraphs={[
					'Está en la calle Hermano Juan Fernández, 29, en el distrito Levante de Córdoba (14014). La ficha de Google lo clasifica como panadería y le da 4,6 sobre 5 con 5 reseñas.',
					'La única foto del perfil enseña la fachada: el rótulo de panadería y confitería, el toldo a rayas, la vitrina y una pizarra en la acera. En la pizarra se leen barras, vienas, croissants, donuts, napolitanas, pan 100% ecológico —centeno, integral y espelta— y pan para migas.',
					'Los carteles de la ventana añaden empanadas —«Empanadas Río Grande»—, tartas con «distintos sabores y diseños» y pan para migas. Son anuncios del propio local; la ficha de Google no publica carta ni precios.',
					'Google no publica teléfono, horario, web ni redes de este horno, y en esta consulta no muestra los textos de las reseñas. La web no rellena esos huecos: deja la dirección, el mapa y lo que se ve en la foto.',
				]}
				note="Ficha y foto consultadas en octubre de 2026. Al no haber horario ni teléfono publicados, confirma antes de ir. Si la ficha cambia, manda la ficha."
				links={[
					{ label: 'Ficha y foto en Google', href: MAPS.place, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la ficha
						</p>
						<h2 id="three-title">
							Pizarra, vitrina <br />
							<em>y huecos.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="pizarra" id="pizarra" aria-labelledby="pizarra-title">
				<div class="wrap">
					<div class="pizarra-head">
						<div>
							<p class="eyebrow">
								<span aria-hidden="true"></span> La pizarra de la puerta
							</p>
							<h2 id="pizarra-title">
								Lo que anuncia <br /><em>la acera.</em>
							</h2>
						</div>
						<p>
							Sin precios: el cartel de la pizarra cambia y esta web no repite sus importes. Esto es
							lo que se lee en la pizarra y en los carteles de la ventana.
						</p>
					</div>
					<div class="pizarra-grid">
						{PIZARRA.map((group) => (
							<div class="pizarra-group">
								<h3>{group.title}</h3>
								<ul class="pizarra-list">
									{group.items.map((item) => (
										<li>
											<b>{item.name}</b>
											<em>{item.note}</em>
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
					<p class="pizarra-note">
						La ficha de Google no publica catálogo, precios, métodos de pago ni reparto. Lo que aparece
						arriba son los productos que anuncian la pizarra y los carteles del propio establecimiento
						en la foto del perfil.
					</p>
				</div>
			</section>

			<section class="ficha section-pad" id="ficha" aria-labelledby="ficha-title">
				<div class="wrap">
					<div class="ficha-head">
						<div>
							<p class="eyebrow">
								<span aria-hidden="true"></span> Los datos publicados
							</p>
							<h2 id="ficha-title">
								La ficha, <br /><em>punto por punto.</em>
							</h2>
						</div>
						<p>
							Lo que Google publica de este horno, y lo que no. Los huecos se dejan a la vista en vez
							de rellenarlos con suposiciones.
						</p>
					</div>
					<dl class="ficha-list">
						{FICHA.map((row) => (
							<div class="ficha-row">
								<dt>{row.label}</dt>
								<dd>{row.value}</dd>
							</div>
						))}
					</dl>
				</div>
			</section>

			<LocalVisit
				eyebrow="Levante · 14014 Córdoba"
				title="Hermano <br /><em>Juan Fernández, 29.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa del Horno panadería confitería en la calle Hermano Juan Fernández, 29"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Horno panadería confitería · nº 29"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Abrir en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{
					label: 'Ver la ficha en Google',
					href: MAPS.place,
					external: true,
				}}
				reserveNote="La ficha no publica teléfono, horario, carta, precios ni métodos de pago. Solo indica que no hay aparcamiento accesible con silla de ruedas; no detalla el acceso al local ni el aseo. Conviene consultar la ficha o pasarse antes de ir."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>ir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.district}, ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone=""
			phoneHref=""
			legal="Datos, reseñas y foto de la ficha pública de Google Maps, consultados en octubre de 2026. El horario y el surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces del Horno panadería confitería"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
