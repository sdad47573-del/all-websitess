---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	addressLine,
	business,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Restaurante Braseria El Río · Rágol, Almería';
const description =
	'Restaurante Braseria El Río, bar restaurante en Rágol (Almería): 4,4 sobre 5 con 134 reseñas. De lunes a jueves 6:30–17:00 y de viernes a domingo 7:00–24:00.';
const keywords =
	'Restaurante Braseria El Río, braseria Rágol, bar restaurante Rágol, comer en Rágol, braseria Almería, El Río teléfono';

/**
 * Texto alternativo de las fotos.
 *
 * Google titula **una sola** de las ocho fotografías que publica este restaurante («Bacalao frito
 * patatas caseras»); esa usa su propio pie como `alt` y además lo muestra como pie de foto. Las
 * otras siete no vienen tituladas, así que su `alt` es solo el aviso genérico de dónde salen.
 */
const altGenerico =
	'Fotografía publicada en la ficha de Google Maps de Restaurante Braseria El Río, en Rágol (Almería)';
const altOg = 'Fotografía de Restaurante Braseria El Río publicada en su ficha de Google Maps';
const altDe = (pie?: string) => (pie ? `${pie}. ${altGenerico}` : altGenerico);

/**
 * Galería completa: las ocho fotografías publicables de la ficha.
 *
 * La portada de la galería trae diez; dos son fotogramas de vídeo, así que no se publican.
 */
const galeria = [
	{ src: foto('restaurante-braseria-el-rio-apaisada-01.jpg') },
	{ src: foto('restaurante-braseria-el-rio-vertical-03.jpg') },
	{ src: foto('restaurante-braseria-el-rio-apaisada-04.jpg') },
	{ src: foto('restaurante-braseria-el-rio-apaisada-05.jpg') },
	{ src: foto('restaurante-braseria-el-rio-apaisada-06.jpg') },
	{ src: foto('restaurante-braseria-el-rio-vertical-07.jpg'), pie: 'Bacalao frito patatas caseras' },
	{ src: foto('restaurante-braseria-el-rio-apaisada-09.jpg') },
	{ src: foto('restaurante-braseria-el-rio-vertical-10.jpg') },
];

/** Tres fotos de avance en el collage de la portada (también están en la galería). */
const collage = [
	{ src: galeria[0].src, clase: 'collage-item collage-item-a' },
	{ src: galeria[3].src, clase: 'collage-item collage-item-b' },
	{ src: galeria[4].src, clase: 'collage-item collage-item-c' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#26221d" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-AL" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,400;0,600;0,700;1,400&family=Figtree:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">ER</span>
				<span class="brand-text">
					Braseria El Río
					<small>Rágol · Almería</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#bar">El restaurante</a>
				<a href="#cocina">Las fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Rágol · Almería · 04440</p>
						<h1 id="hero-title">
							Brasa y raciones generosas<br /><em>en Rágol.</em>
						</h1>
						<p class="hero-lede">
							El Restaurante Braseria El Río está en Rágol, en la comarca del Andarax, y abre
							de 6:30 a 17:00 de lunes a jueves y de 7:00 a 24:00 de viernes a domingo.
							Google le da {business.rating.toLocaleString('es-ES')} sobre 5 con
							{' '}{business.reviewCount.toLocaleString('es-ES')} reseñas, y sus reseñas
							hablan de comida contundente, raciones generosas y buenos precios.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>Llamar al {business.phone}</a>
							<a class="btn btn-ghost" href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dónde</small>
								<strong>{addressLine} · {business.province}</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas
								</strong>
							</li>
						</ul>
					</div>

					<div class="hero-collage">
						{
							collage.map((item, index) => (
								<figure class={item.clase}>
									<Image
										src={item.src}
										alt={altGenerico}
										widths={index === 0 ? [640, 900, 1200] : [320, 480, 640]}
										sizes={
											index === 0
												? '(max-width: 1080px) 92vw, 46vw'
												: '(max-width: 1080px) 45vw, 23vw'
										}
										format="avif"
										quality={68}
										loading={index === 0 ? 'eager' : 'lazy'}
										fetchpriority={index === 0 ? 'high' : undefined}
										decoding="async"
									/>
								</figure>
							))
						}
					</div>
				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
					{business.reviewCount.toLocaleString('es-ES')} reseñas
				</span>
				<span>{addressLine} · {business.province}</span>
				<span>{hoursSummary}</span>
				<span>Teléfono {business.phone}</span>
			</div>

			<section class="section" id="bar" aria-labelledby="bar-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">El restaurante</p>
						<h2 class="title" id="bar-title">
							Brasa, menú<br /><em>y mantel de diario.</em>
						</h2>
						<p>
							La Braseria El Río está en Rágol, un municipio del valle del Andarax, en la
							provincia de Almería. Google lo cataloga como bar restaurante y le da
							{' '}{business.rating.toLocaleString('es-ES')} sobre 5 con
							{' '}{business.reviewCount.toLocaleString('es-ES')} reseñas.
						</p>
						<p>
							Abre de 6:30 a 17:00 de lunes a jueves y alarga hasta la medianoche de viernes a
							domingo, de 7:00 a 24:00. En la semana de la consulta la ficha marcaba el lunes
							como Fiesta Nacional de España con el aviso de que el horario podía ser distinto,
							así que conviene confirmar los festivos por teléfono.
						</p>
						<p class="bar-note">
							La ficha de Google Maps <strong>no publica una dirección con calle</strong> para
							este negocio: su dirección es solo «04440 Rágol, Almería». Esta web no inventa
							calle ni número, y el dato estructurado se emite sin dirección postal. Todo lo
							demás sale de esa misma ficha, consultada el {site.consultado}: nombre,
							teléfono, categorías, horario, valoración, sus reseñas y sus propias
							fotografías. La ficha no publica la carta, así que aquí no se reproduce.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>{business.reviewCount.toLocaleString('es-ES')} reseñas en Google Maps</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver todas ↗</a>
						</div>
						{
							reviews.map((review) => (
								<blockquote class="quote">
									<p>{review.text}</p>
									<footer>{review.source}</footer>
								</blockquote>
							))
						}
					</div>
				</div>
			</section>

			<section class="section cocina" id="cocina" aria-labelledby="cocina-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="cocina-title">
						Las fotos del <em>propio restaurante.</em>
					</h2>
					<p class="lead">
						Son las fotografías que la Braseria El Río publica en su ficha de Google Maps. De
						las diez que trae la portada de la galería, dos son fotogramas de vídeo y no se
						publican aquí. Solo una viene titulada en la ficha —«Bacalao frito patatas
						caseras»— y ese pie se muestra con la foto; de las demás no se describe un
						contenido que no consta.
					</p>
					<div class="cocina-grid">
						{
							galeria.map((item) => (
								<figure class="cocina-item">
									<Image
										src={item.src}
										alt={altDe(item.pie)}
										widths={[380, 560, 800]}
										sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
										format="avif"
										quality={68}
										loading="lazy"
										decoding="async"
									/>
									{item.pie && <figcaption>{item.pie}</figcaption>}
								</figure>
							))
						}
					</div>
					<p class="cocina-note">
						La ficha no publica la carta ni los precios, así que esta web no los reproduce. Para
						saber qué hay hoy, lo más rápido es <a href={phoneHref}>llamar al {business.phone}</a>
						{' '}o mirar las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos y reseñas de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							En Rágol,<br /><em>valle del Andarax.</em>
						</h2>
						<address>
							{addressLine}<br />
							{business.province} · España
						</address>
						<p class="hours-note">
							La ficha de Google Maps no publica una dirección con calle: solo el municipio y
							el código postal. Usa el mapa para llegar.
						</p>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{
									hours.map((item) => (
										<tr class:list={[{ 'is-closed': item.shifts.length === 0 }]}>
											<th scope="row">{item.day}</th>
											<td>{item.service}</td>
										</tr>
									))
								}
							</tbody>
						</table>
						<p class="hours-note">
							El lunes 12 de octubre de 2026 la ficha lo marcaba como Fiesta Nacional de
							España, con el horario de 6:30 a 17:00 y el aviso de que podía ser diferente.
							Llama y confirma el día antes de desplazarte.
						</p>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
							<button type="button" data-cargar-mapa aria-label="Cargar mapa interactivo" style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
								<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
								<strong style="font-size:1rem;">Cargar mapa interactivo</strong>
								<small style="opacity:0.65;">Se carga solo al pulsar</small>
							</button>
<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
						 data-src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-tag">
							<div>
								<strong>{business.name}</strong>
								<small>{addressLine} · {business.province}</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">Antes de <em>venir.</em></h2>
					<div class="faq-list">
						{
							faqs.map((faq) => (
								<details>
									<summary>{faq.question}</summary>
									<p>{faq.answer}</p>
								</details>
							))
						}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">ER</span>
					<span>
						Braseria El Río
						<small>{addressLine} · {business.province}</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del restaurante">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">Ficha en Google Maps ↗</a>
					<a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Reseñas en Google ↗</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Restaurante Braseria El Río · Rágol (Almería). Web
					informativa elaborada con los datos y las fotografías que el restaurante publica en su
					ficha de Google Maps, consultada el {site.consultado}. Confirma horario y
					disponibilidad por teléfono antes de venir.
				</small>
			</div>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a El Río <span>{business.phone}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>

<script>
// mapa-fachada: la URL del iframe vive en data-src y solo se asigna al pulsar (ahorra ~1MB de JS).
document.addEventListener('click', function (e) {
	var t = e.target && e.target.closest ? e.target.closest('[data-cargar-mapa]') : null;
	if (!t) return;
	var w = t.closest('[data-mapa-fachada]');
	if (!w || w.dataset.cargado) return;
	var f = w.querySelector('iframe');
	if (!f || !f.dataset.src || f.getAttribute('src')) return;
	w.dataset.cargado = '1';
	f.setAttribute('src', f.dataset.src);
	t.remove();
});
</script>
