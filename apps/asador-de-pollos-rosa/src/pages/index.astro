---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import pollos from '../assets/fotos/asador-de-pollos-rosa-apaisada-04.jpg';
import fachada from '../assets/fotos/asador-de-pollos-rosa-apaisada-03.jpg';
import horno from '../assets/fotos/asador-de-pollos-rosa-apaisada-05.jpg';
import vitrina from '../assets/fotos/asador-de-pollos-rosa-apaisada-07.jpg';
import fachadaCalle from '../assets/fotos/asador-de-pollos-rosa-vertical-01.jpg';
import pincho from '../assets/fotos/asador-de-pollos-rosa-vertical-02.jpg';
import ofertas from '../assets/fotos/asador-de-pollos-rosa-vertical-06.jpg';
import plato from '../assets/fotos/asador-de-pollos-rosa-vertical-08.jpg';
import interior from '../assets/fotos/asador-de-pollos-rosa-vertical-09.jpg';
import bandeja from '../assets/fotos/asador-de-pollos-rosa-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Asador de Pollos Rosa · Pollos asados en Teatinos, Málaga';
const description =
	'Asador de Pollos Rosa, en C. Navarro Ledesma, 90 (Teatinos-Universidad, 29010 Málaga). Pollos asados tradicionales, patatas, croquetas y pimientos fritos. Menús desde 8 €.';

const galeria = [
	{
		src: pollos,
		alt: 'Bandeja metálica con varios pollos asados enteros recién salidos del horno',
	},
	{
		src: horno,
		alt: 'El asador giratorio del local con decenas de pollos ensartados en los pinchos',
	},
	{
		src: ofertas,
		alt: 'El cartel de ofertas de Asador Rosa con los menús normal, ensalada, súper e individual y sus precios',
	},
	{
		src: fachada,
		alt: 'La fachada de ladrillo de Asador Rosa con el rótulo de La Colonia Santa Inés y los dos teléfonos',
	},
	{
		src: vitrina,
		alt: 'La vitrina del local con tarrinas de ensaladilla, guisos, tortilla de patatas, ensaladas y botellas de ajoblanco y gazpacho',
	},
	{
		src: plato,
		alt: 'Un plato de pollo asado con patatas panadera y hierbas',
	},
	{
		src: pincho,
		alt: 'Un pollo asado ensartado en el pincho del asador, dorado y con hierbas',
	},
	{
		src: bandeja,
		alt: 'Bandeja de aluminio con pollo asado troceado y hierbas',
	},
	{
		src: interior,
		alt: 'El interior del local con el horno asador abierto y los pollos en los pinchos',
	},
	{
		src: fachadaCalle,
		alt: 'Vista de la fachada de Asador Rosa desde la calle, junto a un paso de peatones y el número 90',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Asador de Pollos Rosa',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#rosa`,
	name: BUSINESS.name,
	alternateName: [
		'Asador De Pollos Rosa La Colonia Santa Inés.',
		'Asador Rosa Teatinos',
		'Asador de Pollos Rosa Málaga',
	],
	description:
		'Asador de pollos tradicional en la calle Navarro Ledesma, 90, Teatinos-Universidad (29010 Málaga). Pollos asados, patatas, pimientos, croquetas y menús para llevar.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34951463266',
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Pollo asado', 'Comida tradicional', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',				name: 'Aparcamiento adaptado para sillas de ruedas',
				value: true,
			},
			{
				'@type': 'LocationFeatureSpecification',
				name: 'Aseo adaptado para sillas de ruedas',
				value: true,
			},
			{
				'@type': 'LocationFeatureSpecification',
				name: 'Bucle magnético asistencial',
				value: true,
			},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"asador-de-pollos-rosa-apaisada-04.jpg": pollos,
	"asador-de-pollos-rosa-apaisada-05.jpg": horno,
	"asador-de-pollos-rosa-vertical-06.jpg": ofertas,
	"asador-de-pollos-rosa-apaisada-03.jpg": fachada,
	"asador-de-pollos-rosa-apaisada-07.jpg": vitrina,
	"asador-de-pollos-rosa-vertical-08.jpg": plato,
	"asador-de-pollos-rosa-vertical-02.jpg": pincho,
	"asador-de-pollos-rosa-vertical-10.jpg": bandeja,
	"asador-de-pollos-rosa-vertical-09.jpg": interior,
	"asador-de-pollos-rosa-vertical-01.jpg": fachadaCalle,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#191411" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Manrope:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador de Pollos Rosa, pollos asados Teatinos, pollo asado Málaga, La Colonia Santa Inés, comida para llevar Teatinos, Navarro Ledesma, croquetas, pimientos fritos, menú pollo asado"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollos asados tradicionales, patatas, croquetas y pimientos fritos en la calle Navarro Ledesma, 90, Teatinos. Menús desde 8 €."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bandeja de pollos asados de Asador de Pollos Rosa"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#191411"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Teatinos"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[pollos]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Asador Rosa"
			subtitle="Pollos asados · Teatinos"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a Asador Rosa"
			navAriaLabel="Enlaces de Asador de Pollos Rosa"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34951463266?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carta%20de%20Asador%20de%20Pollos%20Rosa." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carta de Asador de Pollos Rosa"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
