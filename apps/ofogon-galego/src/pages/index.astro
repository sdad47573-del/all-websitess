---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/ofogon-galego-apaisada-01.jpg';
import empanadaPulpo from '../assets/fotos/ofogon-galego-vertical-02.jpg';
import tortilla from '../assets/fotos/ofogon-galego-vista-3-03.jpg';
import tartaQueso from '../assets/fotos/ofogon-galego-apaisada-04.jpg';
import empanada from '../assets/fotos/ofogon-galego-vista-5-05.jpg';
import empanadillas from '../assets/fotos/ofogon-galego-vista-6-06.jpg';
import tartaQuesoHorno from '../assets/fotos/ofogon-galego-apaisada-07.jpg';
import tartaChocolate from '../assets/fotos/ofogon-galego-vista-8-08.jpg';
import paella from '../assets/fotos/ofogon-galego-vista-9-09.jpg';
import vitrina from '../assets/fotos/ofogon-galego-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
} from '../data/site';

const title = 'Ofogón Galego · Comida gallega casera para llevar en Leganés';
const description = BUSINESS.description;

const galeria = [
	{
		src: empanada,
		alt: 'Empanada gallega artesana entera, recién horneada, con la masa trenzada en el borde',
	},
	{
		src: paella,
		alt: 'Paella de marisco con bogavante y cigalas en la paellera',
	},
	{
		src: tortilla,
		alt: 'Tortilla de patata gratinada con calabacín, cortada en porciones',
	},
	{
		src: vitrina,
		alt: 'Vitrina del local con bandejas de pisto, pasta y bacalao con tomate',
	},
	{
		src: empanadillas,
		alt: 'Bandeja de empanadillas gallegas individuales recién hechas',
	},
	{
		src: tartaQueso,
		alt: 'Tarta de queso quemada al estilo gallego, con la superficie tostada',
	},
	{
		src: empanadaPulpo,
		alt: 'Empanada de pulpo artesana con la masa dorada en el horno',
	},
	{
		src: tartaChocolate,
		alt: 'Tarta de chocolate cubierta con nata montada y lacasitos',
	},
	{
		src: tartaQuesoHorno,
		alt: 'Tarta de queso al horno con el centro hundido',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Ofogón Galego',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: Number(item.price.replace(' €', '').replace(',', '.')),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#ofogon-galego`,
	name: BUSINESS.name,
	alternateName: ['O Fogón Galego', 'Ofogón Galego Leganés', 'Ofogón Galego Comida para llevar'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, MAPS.delivery],
	telephone: '+34652838143',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Gallega', 'Española', 'Comida para llevar'],
	areaServed: [
		{ '@type': 'City', name: 'Leganés' },
		{ '@type': 'AdministrativeArea', name: 'Comunidad de Madrid' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	hasTakeaway: true,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:30',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"ofogon-galego-apaisada-01.jpg": fachada,
	"ofogon-galego-vista-5-05.jpg": empanada,
	"ofogon-galego-vista-9-09.jpg": paella,
	"ofogon-galego-vista-3-03.jpg": tortilla,
	"ofogon-galego-apaisada-10.jpg": vitrina,
	"ofogon-galego-vista-6-06.jpg": empanadillas,
	"ofogon-galego-apaisada-04.jpg": tartaQueso,
	"ofogon-galego-vertical-02.jpg": empanadaPulpo,
	"ofogon-galego-vista-8-08.jpg": tartaChocolate,
	"ofogon-galego-apaisada-07.jpg": tartaQuesoHorno,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0e1a17" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Ofogón Galego, O Fogón Galego, comida gallega para llevar Leganés, empanada gallega Leganés, pollo asado Leganés, paella por encargo Leganés, comida casera Solagua, C. Anita Martínez 12"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Empanada gallega artesana, tortilla de patata, croquetas caseras, pollo asado al pimentón y paellas por encargo en la calle Anita Martínez 12, Solagua, Leganés. 4,7 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de Ofogón Galego en la calle Anita Martínez, Leganés"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#0e1a17"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Solagua, Leganés"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Ofogón Galego"
			subtitle="Comida gallega · Leganés"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.neighbourhood}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos, carta y fotografías de la ficha pública de Google Maps y del menú publicado en Uber Eats, consultados en octubre de 2026. Los precios pueden cambiar."
			ctaLabel="Llamar a Ofogón Galego"
			navAriaLabel="Enlaces de Ofogón Galego"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
