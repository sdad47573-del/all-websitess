---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/horno-de-la-cruz-norte-apaisada-01.jpg';
import cartel from '../assets/fotos/horno-de-la-cruz-norte-panoramica-02.jpg';
import rotulo from '../assets/fotos/horno-de-la-cruz-norte-cuadrada-03.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HOURS, HOURS_NOTE, MAPS, SERVICIOS } from '../data/site';

const title = 'Horno de la Cruz · Despacho de venta al público en la Nave 7c, Córdoba';
const description = BUSINESS.description;

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#horno-de-la-cruz-norte`,
	name: BUSINESS.name,
	alternateName: [
		'Horno de la Cruz Agrupación Córdoba',
		'Horno de la Cruz Nave 7c',
		'Horno de la Cruz 14013',
	],
	description:
		'Despacho de venta al público de Horno de la Cruz en la Av. Agrupación Córdoba, 19, nave 7c (14013 Córdoba): panadería con especialidad en empanadas y magdalenas según su cartel.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, BUSINESS.website],
	telephone: '+34 957 48 02 03',
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Friday'],
			opens: '07:00',
			closes: '14:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday'],
			opens: '07:00',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '07:00',
			closes: '11:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const galeria = [
	{
		src: cartel,
		alt: 'Cartel de «despacho de venta público Horno de la Cruz» en el polígono, con una flecha roja hacia la nave',
	},
	{
		src: rotulo,
		alt: 'Rótulo del Horno de la Cruz con las letras rojas sobre fondo amarillo',
	},
	{
		src: fachada,
		alt: 'Fachada de la nave 7c del Horno de la Cruz, con el rótulo rojo, la puerta y la persiana metálica',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#33383b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Horno de la Cruz Córdoba, panadería Agrupación Córdoba, despacho de venta al público Córdoba, empanadas y magdalenas Córdoba, panadería 14013, Horno de la Cruz Nave 7c"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Despacho de venta al público en la Av. Agrupación Córdoba, 19, nave 7c (14013 Córdoba). Casa fundada en 1880 y especialidad en empanadas y magdalenas según su cartel. De lunes a sábado por la mañana, jueves hasta las 21:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de la nave 7c del Horno de la Cruz, con su rótulo rojo"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#33383b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Panadería · Nave 7c"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="14013 · Av. Agrupación Córdoba"
				title="El horno <br /><em>de la nave 7c.</em>"
				lede={`En la Avenida Agrupación Córdoba, 19, nave 7c, al norte de Córdoba. El cartel de la casa anuncia «despacho de venta público», «casa fundada en 1880» y «especialidad en empanadas y magdalenas». Abre de lunes a miércoles y el viernes de 7:00 a 14:00, el jueves hasta las 21:00 y el sábado hasta las 11:00; el domingo cierra. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google y teléfono propio: ${BUSINESS.phone}.`}
				image={fachada}
				imageAlt="Fachada del Horno de la Cruz en la nave 7c, con el rótulo rojo sobre la pared crema, la puerta de entrada y la persiana metálica"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>5,0</b> en Google · 5 reseñas' },
					{ label: 'Horario', html: '<b>L–X y V</b> 7:00–14:00' },
					{ label: 'Teléfono', html: '<b>957 48 02 03</b>' },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Nave 7c · 14013"
			/>

			<LocalChips label="Lo que anuncia la casa" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un despacho <br /><em>de nave.</em>"
				paragraphs={[
					'Este Horno de la Cruz está en la Avenida Agrupación Córdoba, 19, nave 7c, en el 14013. Es una ficha distinta de la del horno del mismo nombre en la calle Góngora, 2, en el Centro: cada una tiene su teléfono y su horario.',
					'La foto de la fachada enseña la nave tal cual: el rótulo rojo «Horno de la Cruz» sobre la pared crema y amarilla, la puerta de entrada con el número 7C y una persiana metálica con una furgoneta aparcada debajo.',
					'En el cartel del polígono, el negocio se anuncia como «despacho de venta público», «casa fundada en 1880» y «especialidad en empanadas y magdalenas». Son los datos que da la propia casa en su cartelería; la ficha de Google solo la clasifica como panadería.',
					'El horario es de mañana: de 7:00 a 14:00 de lunes a miércoles y el viernes, el jueves hasta las 21:00 y el sábado solo hasta las 11:00. El domingo cierra. El teléfono es el 957 48 02 03 y la ficha enlaza una página web propia.',
				]}
				note="La ficha de Google no publica los textos de las reseñas, ni carta, ni precios, ni correo, ni redes. Las fotos son de su galería pública. Las empanadas y magdalenas se citan porque las anuncia el cartel del establecimiento, no porque exista una carta publicada."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Web del horno', href: BUSINESS.website, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Rótulo, cartel <br />
							<em>y horario.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos"
				title="La nave, <br /><em>por fuera.</em>"
				description="Tres fotos del perfil de Google Maps: el cartel de venta al público en el polígono, el rótulo de la casa y la fachada de la nave 7c."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow="14013 · Córdoba"
				title="En la Agrupación <br /><em>Córdoba.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa del Horno de la Cruz en la Avenida Agrupación Córdoba, 19, nave 7c"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Horno de la Cruz · Av. Agrupación Córdoba, 19"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Abrir en Google Maps', href: MAPS.place, external: true },
					{ label: 'Web del horno', href: BUSINESS.website, external: true },
				]}
				contactLink={{
					label: `Llamar al ${BUSINESS.phone}`,
					href: BUSINESS.phoneHref,
					external: true,
				}}
				reserveNote="La ficha de Google solo marca que no hay aparcamiento accesible para sillas de ruedas; no publica datos del acceso al obrador ni del aseo. Tampoco detalla métodos de pago ni reparto, así que conviene llamar antes de ir."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>llegar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Web del horno ↗', href: BUSINESS.website, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, fotos y reseñas de la ficha pública de Google Maps y de la cartelería del establecimiento, consultados en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces del Horno de la Cruz"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
