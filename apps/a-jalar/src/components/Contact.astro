---
import { BUSINESS, HOURS } from '../data/site';
---

<section id="contacto" class="bg-base-200 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-secondary text-xs font-semibold tracking-[0.2em] uppercase">Visítanos</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">Te esperamos en Teatinos</h2>
			<div class="ajalar-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/70 mt-6">
				En la Av. de Lope de Vega 23, a unos metros de la Ciudad de la Justicia. Se atiende en
				mostrador, sin reserva previa.
			</p>
		</div>

		<div class="mt-14 grid gap-8 lg:grid-cols-2">
			<div class="space-y-6">
				<div class="rounded-box border-base-300 bg-base-100 border p-7">
					<h3 class="font-display text-xl font-semibold">Datos del local</h3>
					<ul class="mt-5 space-y-5 text-sm">
						<li class="flex items-start gap-4">
							<span
								class="bg-secondary/15 text-secondary flex size-11 shrink-0 items-center justify-center rounded-xl"
							>
								<i class="ri-map-pin-line text-xl"></i>
							</span>
							<div>
								<p class="font-semibold">Dirección</p>
								<p class="text-base-content/70">
									{BUSINESS.street}<br />
									{BUSINESS.postalCode}
									{BUSINESS.district}, {BUSINESS.city}
								</p>
							</div>
						</li>
						<li class="flex items-start gap-4">
							<span
								class="bg-secondary/15 text-secondary flex size-11 shrink-0 items-center justify-center rounded-xl"
							>
								<i class="ri-phone-line text-xl"></i>
							</span>
							<div>
								<p class="font-semibold">Teléfono</p>
								<a href={BUSINESS.phoneHref} class="text-base-content/70 hover:text-secondary">
									{BUSINESS.phoneDisplay}
								</a>
							</div>
						</li>
						<li class="flex items-start gap-4">
							<span
								class="bg-secondary/15 text-secondary flex size-11 shrink-0 items-center justify-center rounded-xl"
							>
								<i class="ri-time-line text-xl"></i>
							</span>
							<div>
								<p class="font-semibold">Horario</p>
								{
									HOURS.map((dia) => (
										<p class="text-base-content/70">
											{dia.days}: {dia.hours}
										</p>
									))
								}
							</div>
						</li>
						<li class="flex items-start gap-4">
							<span
								class="bg-secondary/15 text-secondary flex size-11 shrink-0 items-center justify-center rounded-xl"
							>
								<i class="ri-bike-line text-xl"></i>
							</span>
							<div>
								<p class="font-semibold">A domicilio</p>
								<p class="text-base-content/70">
									Reparto con {BUSINESS.delivery} y disponible en Uber Eats.
								</p>
							</div>
						</li>
					</ul>

					<div class="mt-7 flex flex-wrap gap-3">
						<a href={BUSINESS.phoneHref} class="btn btn-secondary gap-2 rounded-full">
							<i class="ri-phone-line"></i>
							Llamar
						</a>
						<a href="/carta" class="btn btn-outline gap-2 rounded-full">
							<i class="ri-menu-line"></i>
							Ver la carta
						</a>
						<a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline gap-2 rounded-full"
						>
							<i class="ri-map-pin-line"></i>
							Google Maps
						</a>
					</div>
				</div>

				<div class="rounded-box border-base-300 bg-base-100 border p-7">
					<h3 class="font-display text-xl font-semibold">Síguenos</h3>
					<div class="mt-4 flex flex-wrap gap-3">
						<a
							href={BUSINESS.instagram}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline btn-sm gap-2 rounded-full"
						>
							<i class="ri-instagram-line text-lg"></i>
							Instagram
						</a>
						<a
							href={BUSINESS.facebook}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline btn-sm gap-2 rounded-full"
						>
							<i class="ri-facebook-circle-line text-lg"></i>
							Facebook
						</a>
						<a
							href={BUSINESS.uberEatsUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline btn-sm gap-2 rounded-full"
						>
							<i class="ri-shopping-bag-line text-lg"></i>
							Uber Eats
						</a>
					</div>
				</div>
			</div>

			<div class="rounded-box border-base-300 bg-base-100 min-h-[420px] overflow-hidden border">
				<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
				 src={BUSINESS.googleMapsEmbed}
					title={`Ubicación de ${BUSINESS.name}, ${BUSINESS.street}, ${BUSINESS.city}`}
					width="100%"
					height="100%"
					style="border: 0; min-height: 420px;"
					loading="lazy"
					allowfullscreen
					referrerpolicy="no-referrer-when-downgrade"></iframe>
				</div>
			</div>
		</div>
	</div>
</section>


