---
import { Image } from '@astro-components';
import { BUSINESS, HOURS, IMAGES } from '../data/site';

const hoyAbierto = HOURS.find((dia) => dia.hours !== 'Cerrado');
---

<section id="inicio" class="hero-kebab relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.portada}
			alt="A JALAR, kebab artesanal en la Avenida de Lope de Vega 23, Málaga"
			widths={[800, 1200, 1600]}
			sizes="100vw"
			quality={70}
			loading="eager"
			format="webp"
			class="h-full w-full object-cover opacity-30"
		/>
		<div class="from-base-100/85 absolute inset-0 via-transparent"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-36">
		<div class="grid items-center gap-12 lg:grid-cols-[1.15fr_0.85fr]">
			<div>
				<p
					class="text-secondary inline-flex items-center gap-2 text-xs font-semibold tracking-[0.22em] uppercase"
				>
					<i class="ri-map-pin-line"></i>
					{BUSINESS.district} · {BUSINESS.city}
				</p>

				<h1
					class="font-display mt-4 text-4xl leading-[1.05] font-extrabold sm:text-5xl lg:text-6xl"
				>
					Kebab artesanal<br />
					<span class="text-accent">hecho cada día</span><br />
					en Teatinos
				</h1>

				<p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80">
					Rollos, media lunas, campers y bandejas con <strong class="text-white"
						>carne fresca preparada a diario</strong
					>, verduras frescas y pan casero. Sin salir de casa, también a domicilio.
				</p>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-secondary btn-lg gap-2 rounded-full">
						<i class="ri-phone-line"></i>
						Llamar al {BUSINESS.phoneDisplay}
					</a>
					<a
						href={BUSINESS.deliveryUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline btn-lg hover:text-neutral rounded-full border-white/40 bg-white/5 text-white hover:border-white hover:bg-white"
					>
						<i class="ri-bike-line"></i>
						Pedir a domicilio
					</a>
				</div>

				<dl class="mt-10 grid max-w-lg grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3">
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Valoración</dt>
						<dd class="font-display mt-1 flex items-center gap-1 text-xl font-bold">
							{BUSINESS.rating.value}
							<i class="ri-star-fill text-accent text-lg"></i>
							<span class="text-sm font-normal text-white/50">
								({BUSINESS.rating.count})
							</span>
						</dd>
					</div>
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Precio</dt>
						<dd class="font-display mt-1 text-xl font-bold">{BUSINESS.priceRange}</dd>
					</div>
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Horario</dt>
						<dd class="font-display mt-1 text-xl font-bold">
							{hoyAbierto?.days ?? 'Mar. a dom.'}
							<span class="block text-sm font-normal">{hoyAbierto?.hours}</span>
						</dd>
					</div>
				</dl>
			</div>

			<figure class="relative hidden lg:block">
				<div class="rounded-box rotate-2 overflow-hidden shadow-2xl ring-1 ring-white/15">
					<Image
						src={IMAGES.rolloPollo}
						alt="Rollo de pollo de A Jalar, kebab artesanal en Málaga"
						widths={[500, 800]}
						sizes="(min-width: 1024px) 34vw, 90vw"
						quality={85}
						loading="eager"
						class="aspect-square w-full object-cover"
					/>
				</div>
				<figcaption
					class="font-display text-accent rounded-box bg-neutral absolute -bottom-4 -left-4 px-5 py-3 text-lg font-bold shadow-xl"
				>
					100 % casero
				</figcaption>
			</figure>
		</div>
	</div>
</section>
