---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES, NAV } from '../data/site';

interface Props {
	/** Prefijo de los enlaces a las anclas de la home (por ejemplo, '/' desde /carta). */
	base?: string;
}

const { base = '' } = Astro.props;
---

<div class="border-base-300/70 bg-base-100/85 sticky top-0 z-50 border-b backdrop-blur-md">
	<header
		class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
	>
		<a href={`${base}#inicio`} class="flex shrink-0 items-center" aria-label={BUSINESS.name}>
			<Image
				src={IMAGES.logoOscuro}
				alt="A JALAR, kebab artesanal"
				widths={[160, 240, 320]}
				sizes="(min-width: 1024px) 200px, 160px"
				quality={90}
				loading="eager"
				class="h-9 w-auto sm:h-10"
			/>
		</a>

		<nav class="hidden items-center gap-6 lg:flex" aria-label="Navegación principal">
			{
				NAV.map((item) => (
					<a
						href={`${base}${item.href}`}
						class="text-base-content/75 hover:text-secondary text-sm font-medium transition-colors"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2">
			<a href="/carta" class="btn btn-ghost btn-sm hidden rounded-full sm:inline-flex"> Carta </a>
			<a href={BUSINESS.phoneHref} class="btn btn-secondary btn-sm gap-2 rounded-full px-4">
				<i class="ri-phone-line text-base"></i>
				<span class="hidden sm:inline">{BUSINESS.phoneDisplay}</span>
				<span class="sm:hidden">Llamar</span>
			</a>

			<details class="dropdown dropdown-end lg:hidden">
				<summary class="btn btn-ghost btn-sm list-none" aria-label="Abrir menú">
					<i class="ri-menu-line text-xl"></i>
				</summary>
				<ul
					class="menu dropdown-content rounded-box border-base-300 bg-base-100 z-50 mt-2 w-56 border p-2 shadow-xl"
				>
					{
						NAV.map((item) => (
							<li>
								<a href={`${base}${item.href}`}>{item.label}</a>
							</li>
						))
					}
					<li>
						<a href="/carta">Carta completa</a>
					</li>
					<li>
						<a href="/aviso-legal" class="text-primary font-semibold"> Aviso legal y privacidad </a>
					</li>
				</ul>
			</details>
		</div>
	</header>
</div>
