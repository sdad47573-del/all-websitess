---
import { BUSINESS, TESTIMONIOS } from '../data/site';

// Estrellas filled = valoración completa, half = media.
const estrellasLlenas = Math.floor(BUSINESS.rating.value);
const hayMedia = BUSINESS.rating.value % 1 >= 0.25;
---

<section id="opiniones" class="bg-neutral text-neutral-content py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-secondary text-xs font-semibold tracking-[0.2em] uppercase">
				Opiniones
			</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">Lo que dicen de A Jalar</h2>
			<div class="ajalar-divider mx-auto mt-5 h-px w-32"></div>
		</div>

		<div
			class="rounded-box mx-auto mt-12 flex max-w-xl flex-col items-center gap-3 bg-white/5 p-8 text-center"
		>
			<p class="font-display text-accent text-5xl font-extrabold">{BUSINESS.rating.value}</p>
			<p class="flex gap-1 text-xl" aria-hidden="true">
				{
					Array.from({ length: 5 }).map((_, i) => (
						<i
							class={
								i < estrellasLlenas
									? 'ri-star-fill text-accent'
									: i === estrellasLlenas && hayMedia
										? 'ri-star-half-fill text-accent'
										: 'ri-star-line text-white/30'
							}
						/>
					))
				}
			</p>
			<p class="text-sm text-white/60">
				{BUSINESS.rating.count} reseñas en Google
			</p>
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-sm btn-secondary mt-2 gap-2 rounded-full"
			>
				<i class="ri-map-pin-2-fill"></i>
				Leer todas las reseñas
			</a>
		</div>

		<div class="mt-12 grid gap-6 md:grid-cols-3">
			{
				TESTIMONIOS.map((testimonio) => (
					<figure class="rounded-box border border-white/10 bg-white/5 p-7">
						<i class="ri-double-quotes-l text-secondary text-3xl" aria-hidden="true" />
						<blockquote class="mt-3 leading-relaxed text-white/85">«{testimonio.text}»</blockquote>
						<figcaption class="mt-5 flex items-center gap-3 border-t border-white/10 pt-4">
							<span class="bg-secondary/20 text-secondary flex size-10 items-center justify-center rounded-full">
								<i class={`${testimonio.icon} text-lg`} />
							</span>
							<span>
								<span class="block text-sm font-semibold text-white">{testimonio.author}</span>
								<span class="block text-xs text-white/50">{testimonio.role}</span>
							</span>
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
