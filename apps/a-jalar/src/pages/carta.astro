---
import Carta from '../components/Carta.astro';
import Fab from '../components/Fab.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Topbar from '../components/Topbar.astro';
import { breadcrumbs, menuSchema } from '../data/schema';
import { BUSINESS } from '../data/site';
import Layout from '../layouts/Layout.astro';
---

<Layout
	title={`Carta y precios · A JALAR kebab en ${BUSINESS.district}, ${BUSINESS.city}`}
	description={`Carta de A JALAR en Málaga: rollos, media lunas, camperos, bandejas, baguettes y complementos con precios. Kebab artesanal en la Av. de Lope de Vega 23.`}
	path="/carta"
	keywords="carta A Jalar, precios kebab Málaga, rollo de pollo Málaga, media luna kebab Málaga, kebab artesanal Teatinos, menú kebab Lope de Vega"
	schema={[
		menuSchema,
		breadcrumbs([
			{ name: 'Inicio', path: '/' },
			{ name: 'Carta', path: '/carta' },
		]),
	]}
>
	<Topbar base="/" />

	<main>
		<Carta completa />
		<Faq />
	</main>

	<Footer />
	<Fab />
</Layout>
