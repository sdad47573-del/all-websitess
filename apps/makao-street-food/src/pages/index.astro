---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/makao-street-food-vertical-01.jpg';
import udon from '../assets/fotos/makao-street-food-vertical-02.jpg';
import hamburguesa from '../assets/fotos/makao-street-food-vertical-03.jpg';
import quesadillas from '../assets/fotos/makao-street-food-vertical-04.jpg';
import tarta from '../assets/fotos/makao-street-food-apaisada-05.jpg';
import comedor from '../assets/fotos/makao-street-food-vertical-06.jpg';
import fideos from '../assets/fotos/makao-street-food-vertical-07.jpg';
import curry from '../assets/fotos/makao-street-food-vertical-08.jpg';
import bao from '../assets/fotos/makao-street-food-vertical-09.jpg';
import patatas from '../assets/fotos/makao-street-food-vista-10-10.jpg';

import { BUSINESS, FAQ, HORARIO, HORARIO_AVISO, MAPS, RESENAS, RESERVAS, SERVICIOS } from '../data/site';

const title = 'Makao Street Food · Comida callejera del mundo en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: patatas,
		alt: 'Patatas cargadas con queso fundido, chili, cebolla roja, jalapeños y cilantro, en un plato negro con papel de estraza',
	},
	{
		src: quesadillas,
		alt: 'Quesadillas cortadas en triángulos con salsa cremosa, sobre un plato de cerámica verde',
	},
	{
		src: hamburguesa,
		alt: 'Hamburguesa con doble queso y bacon en pan brioche, con patatas gajo al lado',
	},
	{
		src: bao,
		alt: 'Bollos al vapor rellenos de panceta glaseada en una cesta de bambú',
	},
	{
		src: udon,
		alt: 'Cuenco negro de udon con berenjena, pimiento rojo y sésamo',
	},
	{
		src: fideos,
		alt: 'Fideos salteados con setas, guindilla y sésamo en un cuenco de rayas, con el neón del local al fondo',
	},
	{
		src: curry,
		alt: 'Pollo al curry con sésamo negro en cuenco de rayas, con un cuenco de arroz y una bebida con limón al fondo',
	},
	{
		src: tarta,
		alt: 'Tarta de chocolate con helado de vainilla, nata montada y migas de galleta',
	},
	{
		src: comedor,
		alt: 'Comedor de Makao con pared de ladrillo, letrero de neón con el nombre y butacas azules',
	},
	{
		src: fachada,
		alt: 'Fachada naranja del local con el rótulo de Makao Street Food y el mural de un cocinero con un cuenco de fideos',
	},
];

const carta = [
	{
		title: 'Street food',
		items: [
			{
				name: 'Quesadillas con panceta',
				note: 'las que destaca una de las reseñas de Google',
			},
			{ name: 'Hamburguesa con queso y bacon', note: 'en pan brioche, con patatas gajo' },
			{ name: 'Patatas cargadas', note: 'con queso fundido, chili, cebolla y jalapeños' },
			{ name: 'Bao de panceta', note: 'bollos al vapor en cesta de bambú' },
		],
	},
	{
		title: 'Del wok',
		items: [
			{ name: 'Udon con berenjena', note: 'con pimiento y sésamo' },
			{ name: 'Fideos salteados', note: 'con setas y guindilla' },
			{ name: 'Pollo al curry', note: 'con arroz blanco y sésamo negro' },
		],
	},
	{
		title: 'Dulce',
		items: [
			{ name: 'Tarta de chocolate', note: 'con helado de vainilla y nata montada' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#makao`,
	name: BUSINESS.name,
	alternateName: ['Makao', 'Makao Ciudad Real', 'Makao Street Food Ciudad Real'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Street food', 'Comida ecléctica', 'Cocina asiática', 'Hamburguesas'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Ciudad Real' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Código', value: '/g/11tdrgcqbw' },
	],
	acceptsReservations: RESERVAS,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Monday',
			opens: '13:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday'],
			opens: '13:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday'],
			opens: '20:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '13:00',
			closes: '01:30',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '13:00', closes: '01:00' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Entrada adaptada', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17181c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,700&family=Nunito+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Makao Street Food Ciudad Real, comida callejera Ciudad Real, quesadillas Ciudad Real, hamburguesas Camino de los Mártires, bao panceta Ciudad Real, udon Ciudad Real, reservar Makao Ciudad Real, comida ecléctica 13005"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida callejera de cada rincón del mundo en el Camino de los Mártires, Ciudad Real: quesadillas con panceta, hamburguesas, bao, udon y patatas cargadas. Reservas online; martes cerrado."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Makao Street Food, comida callejera del mundo en Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#17181c"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CR"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[patatas]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Makao"
			subtitle="Street food · Ciudad Real"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="Comida callejera <br /><em>de medio mundo.</em>"
				lede="Makao - Street Food está en el Camino de los Mártires, en Ciudad Real, y lo cuenta así en su ficha: «La mejor comida callejera de cada rincón del mundo en pleno centro de Ciudad Real». Quesadillas con panceta, hamburguesas, bao, udon y patatas cargadas, con neones y música de fondo. Abre a mediodía y de noche; los martes cierra. Pedidos y reservas en el 683 30 73 81."
				image={patatas}
				imageAlt="Patatas cargadas con queso fundido, chili, cebolla roja y jalapeños en un plato negro de Makao"
				primaryCta={{ label: 'Reservar', href: RESERVAS }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,3</b> en Google · 841 reseñas' },
					{ label: 'Horario', html: '<b>13:00–17:00</b><br />y cenas hasta la 1:30 · martes cerrado' },
					{ label: 'Pedidos', html: `<b>${BUSINESS.phone}</b> y reservas online` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Makao" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Neón, ladrillo <br /><em>y papel de estraza.</em>"
				paragraphs={[
					'El local está en el Camino de los Mártires, 13005 Ciudad Real, en una esquina pintada de naranja con el rótulo de Makao Street Food y un mural enorme de un cocinero sirviendo un cuenco de fideos. Dentro, pared de ladrillo, letreros de neón con el nombre y el «slow cooking», butacas azules y mesas de madera.',
					'El negocio lo resume en su ficha: «La mejor comida callejera de cada rincón del mundo en pleno centro de Ciudad Real». En las fotos de su perfil pasan las quesadillas cortadas en triángulos, la hamburguesa con doble queso y bacon con patatas gajo, las patatas cargadas con chili y jalapeños, los bollos al vapor de panceta en cesta de bambú, el udon con berenjena, los fideos salteados con setas y el pollo al curry con arroz.',
					'El horario parte el día: de 13:00 a 17:00 los lunes; de 13:00 a 17:00 y de 20:00 a 24:00 miércoles y jueves; viernes y sábado hasta la 1:30 y domingo hasta la 1:00. Los martes cierra, y la propia ficha avisa de que en el Día de Todos los Santos el horario podría ser distinto.',
					'La ficha tiene 841 reseñas y una media de 4,3. Las tres que Google destaca son de cinco estrellas: las quesadillas con panceta y las hamburguesas, el ambiente con camareros atentos y el local «muy guay».',
				]}
				note="La ficha de Google no publica carta ni precios, así que esta página no inventa importes: nombra los platos que aparecen en las fotos del perfil y en las reseñas destacadas."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Quesadillas, <br /><em>bao y patatas.</em>"
				description="Lo que se ve en las mesas y en el perfil del local: street food de aquí y de allá, del wok y del horno. Sin precios publicados."
				cta={{ label: 'Ver la carta en Google Maps', href: MAPS.place }}
				groups={carta}
				note="Esta lista sale de las fotografías del perfil del establecimiento en Google Maps y de las reseñas que Google destaca. No hay carta con precios publicada: el surtido del día se pregunta en el local o en el 683 30 73 81."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
					<div class="reviews-head">
						<h2 id="resenas-title">Buen ambiente <br /><em>y mejores quesadillas.</em></h2>
						<p>
							La ficha tiene 841 reseñas y una media de 4,3. Estas son las tres que Google destaca, todas
							de cinco estrellas, con la puntuación que les dio su autor.
						</p>
					</div>
					<div class="review-grid">
						{
							RESENAS.map((review) => (
								<figure class="review-card">
									<p class="review-stars" aria-label={`${review.rating} sobre 5`}>
										{'★'.repeat(review.rating)}
										<span aria-hidden="true">{'★'.repeat(5 - review.rating)}</span>
									</p>
									<blockquote>{review.quote}</blockquote>
									<figcaption>Reseña publicada en Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="review-note">
						Citas de las reseñas públicas del local, con la puntuación del autor. En la ficha de Google
						están todas, incluidas las que puntúan por debajo.
					</p>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Del mural <br /><em>al cuenco.</em>"
				description="Diez fotos del perfil del local: las patatas cargadas, las quesadillas, la hamburguesa, el bao de panceta, el udon, los fideos, el curry, la tarta de chocolate, el comedor y la fachada con su mural."
				images={galeria}
				cta={{ label: 'Ver todas en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="Comida <br /><em>y cena.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Ciudad Real · España']}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de Makao Street Food en el Camino de los Mártires, Ciudad Real"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Makao Street Food"
				mapHref={MAPS.place}
				links={[
					{ label: 'Reservar', href: RESERVAS, external: true, variant: 'primary' },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="Las reservas se hacen en el calendario online que enlaza la ficha de Google del restaurante o por teléfono, en el 683 30 73 81; esta página no tramita reservas ni pedidos. La ficha marca entrada, aseo y asientos accesibles para sillas de ruedas, y los martes cierra todo el día."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Makao - Street Food"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Reservar ↗', href: RESERVAS, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos, horario y fotografías tomados de la ficha y del perfil públicos del local en Google Maps, consultados en noviembre de 2026. Sin carta ni precios publicados: confirma horario y disponibilidad antes de ir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Makao Street Food"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
