---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import { business, directionsUrl, mapEmbedUrl, mapsUrl, phoneHref, restaurantSchema } from '../lib/business';
import { content } from '../lib/content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	locale: 'es' | 'en';
}

const { locale } = Astro.props;
const page = content[locale];
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}', { eager: true });
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;
const restaurantPhotos = Array.from({ length: 6 }, (_, index) => ({
	src: foto(`autana-${String(index + 2).padStart(2, '0')}.jpg`),
	alt: `${locale === 'es' ? 'Foto' : 'Photo'} ${index + 1} · Autana Restaurant, Mijas Costa`,
}));
const heroPhotoAlt = `${locale === 'es' ? 'Autana Restaurant en Mijas Costa' : 'Autana Restaurant in Mijas Costa'} · ${locale === 'es' ? 'foto' : 'photo'} 1`;
const canonical = `${business.site}${page.path}`;
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: page.faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang={page.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#153d36" />
		<meta name="description" content={page.description} />
		<meta name="keywords" content={page.keywords} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="Mijas Costa, Mijas" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="es" href={`${business.site}/`} />
		<link rel="alternate" hreflang="en" href={`${business.site}/en/`} />
		<link rel="alternate" hreflang="x-default" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
			rel="stylesheet"
		/>
		<title>{page.title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content={page.locale} />
		<meta property="og:site_name" content={business.shortName} />
		<meta property="og:title" content={page.title} />
		<meta property="og:description" content={page.description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={`${business.site}${foto('autana-01.jpg').src}`} />
		<meta property="og:image:alt" content={heroPhotoAlt} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="676" />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="Spain" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={page.title} />
		<meta name="twitter:description" content={page.description} />
		<meta name="twitter:image" content={`${business.site}${foto('autana-01.jpg').src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#main">{page.skip}</a>
		<header class="site-header">
			<a class="brand" href={page.path} aria-label={`${business.shortName} · ${page.navLabel}`}>
				<span class="brand-mark" aria-hidden="true">A</span>
				<span class="brand-name">Autana<small>COCINA VENEZOLANA · MIJAS</small></span>
			</a>
			<nav aria-label={page.navLabel}>
				{page.nav.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
			<div class="header-actions">
				<a class="language" href={page.languageHref} lang={locale === 'es' ? 'en' : 'es'}>{page.languageLabel}</a>
				<a class="header-call" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a>
			</div>
		</header>

		<main id="main">
			<section class="hero" id="autana" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true">✳</span>{page.eyebrow}</p>
					<h1 id="hero-title">{page.titleLines[0]}<br /><em>{page.titleLines[1]}</em><br />{page.titleLines[2]}</h1>
					<p class="hero-intro">{page.intro}</p>
					<div class="hero-actions">
						<a class="button button-primary" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a>
						<a class="button button-light" href={directionsUrl} target="_blank" rel="noopener noreferrer">{page.secondaryCta}<span aria-hidden="true">↗</span></a>
					</div>
					<p class="hero-note">{page.heroNote}</p>
				</div>
				<div class="hero-art">
					<Image class="hero-image" src={foto('autana-01.jpg')} alt={heroPhotoAlt} widths={[480, 720, 960, 1200]} sizes="(max-width: 980px) 92vw, 46vw" format="avif" quality={70} fetchpriority="high" decoding="async" />
					<span class="art-coordinate">36°30'22.5&quot;N<br />4°40'04.9&quot;W</span>
					<span class="art-stamp">SABOR<br />Y ORIGEN</span>
					<a class="art-link" href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label={page.photosCta}>↗</a>
					<p class="art-caption">{page.photoCaption}<span>MIJAS COSTA · MÁLAGA</span></p>
				</div>
				<div class="hero-side-label" aria-hidden="true">VENEZUELA · ANDALUCÍA</div>
			</section>

			<section class="story section-wrap" id="experiencia">
				<div class="story-kicker"><span>01</span><i></i>{page.restaurantLabel}</div>
				<div class="story-main"><h2>{page.restaurantTitle}</h2><div class="story-copy"><p>{page.restaurantText}</p><p>{page.restaurantDetail}</p></div></div>
				<div class="values">
					{page.values.map((item) => <article class="value"><span>{item.number}</span><h3>{item.title}</h3><p>{item.detail}</p></article>)}
				</div>
			</section>

			<section class="flavours">
				<div class="flavours-grid section-wrap">
					<div class="flavour-art"><Image class="flavour-image" src={foto('autana-04.jpg')} alt={locale === 'es' ? 'Plato de Autana Restaurant en Mijas Costa' : 'A dish at Autana Restaurant in Mijas Costa'} widths={[320, 480, 640]} sizes="(max-width: 980px) 46vw, 23vw" format="avif" quality={65} loading="lazy" decoding="async" /></div>
					<div class="flavour-copy"><p class="eyebrow eyebrow-dark"><span class="eyebrow-mark" aria-hidden="true">✳</span>{page.experienceEyebrow}</p><h2>{page.experienceTitle}</h2><p>{page.experienceText}</p><p>{page.experienceDetail}</p><ul class="tags">{page.experienceTags.map((tag) => <li>{tag}</li>)}</ul><a class="text-link" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a></div>
				</div>
			</section>

			<section class="gallery section-wrap" aria-labelledby="gallery-title">
				<div class="gallery-copy"><p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true">✳</span>{page.photosEyebrow}</p><h2 id="gallery-title">{page.photosTitle}</h2><p>{page.photosText}</p><a class="button button-primary" href={mapsUrl} target="_blank" rel="noopener noreferrer">{page.photosCta}<span aria-hidden="true">↗</span></a></div>
				<div class="gallery-panel"><div class="gallery-grid">{restaurantPhotos.map((photo) => <figure class="gallery-photo"><Image src={photo.src} alt={photo.alt} widths={[320, 480, 640]} sizes="(max-width: 980px) 46vw, 23vw" format="avif" quality={65} loading="lazy" decoding="async" /></figure>)}</div><div class="gallery-bottom"><span>{page.photoCaption}</span><a href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label={page.photosCta}>↗</a></div></div>
			</section>
			<p class="photo-note section-wrap">{page.photoDisclaimer} <a href="https://www.thefork.com/restaurant/autana-restaurant-r869833" target="_blank" rel="noopener noreferrer">{page.photoSource}</a></p>

			<section class="visit" id="ubicacion">
				<div class="visit-grid section-wrap">
					<div class="visit-copy"><p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true">✳</span>{page.visitEyebrow}</p><h2>{page.visitTitle}</h2>
						<div class="contact-details"><div><span class="contact-icon" aria-hidden="true">⌖</span><p><small>{page.addressLabel}</small>{business.streetAddress}<br />{business.postalCode} {business.city}<br />{business.region}</p></div><div><span class="contact-icon" aria-hidden="true">↗</span><p><small>{page.phoneLabel}</small><a href={phoneHref}>{business.phone}</a></p></div><div><span class="contact-icon" aria-hidden="true">◷</span><p><small>{page.hoursLabel}</small>{page.hoursText}</p></div></div>
						<a class="visit-call" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-panel"><div class="map-heading"><span><i></i>{page.mapArea}</span><a href={mapsUrl} target="_blank" rel="noopener noreferrer">{page.mapOpen} ↗</a></div><iframe title={page.mapTitle} src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><a class="map-footer" href={directionsUrl} target="_blank" rel="noopener noreferrer"><span class="map-pin" aria-hidden="true">⌖</span><span><strong>{business.shortName}</strong><small>{business.streetAddress} · {business.city}</small></span><b>{page.mapDirections} ↗</b></a></div>
				</div>
			</section>

			<section class="faq section-wrap">
				<div class="faq-title"><p class="eyebrow eyebrow-dark"><span class="eyebrow-mark" aria-hidden="true">✳</span>{page.faqEyebrow}</p><h2>{page.faqTitle}</h2></div>
				<div class="faq-list">{page.faqs.map((faq) => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div>
			</section>
		</main>

		<footer class="site-footer"><a class="brand" href={page.path} aria-label={`${business.shortName} · ${page.navLabel}`}><span class="brand-mark" aria-hidden="true">A</span><span class="brand-name">Autana<small>COCINA VENEZOLANA · MIJAS</small></span></a><p>{page.footerNote}<br />{business.streetAddress}, {business.city}</p><div class="footer-links"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={page.languageHref}>{page.languageLabel}</a><a href="/aviso-legal">Aviso legal</a></div><small class="footer-legal">© {new Date().getFullYear()} {business.shortName} · {business.city}</small></footer>
		<a class="mobile-cta" href={phoneHref}><span aria-hidden="true">↗</span>{page.primaryCta}<strong>{business.phone}</strong></a>
	<WhatsappFab phone={datos.phoneHref} name={datos.business?.name} />
	</body>
</html>
