---
import '../styles/global.css';
import {
	accesibilidad,
	business,
	directionsUrl,
	faqSchema,
	faqs,
	floristSchema,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	reviewsUrl,
	site,
} from '../data/site';


const title = 'Itálica de Flores S.L. · Flores en Sevilla';
const description =
	'Floristería en la Calle Metalurgia, 53 (Sevilla). La ficha enlaza 18 reseñas en Google Maps. Teléfono 954 35 71 07.';
const keywords =
	'Itálica de Flores, floristería Sevilla, flores Sevilla, Calle Metalurgia, Distrito Norte';

/**
 * La ficha no publica fotografías: la portada usa una tarjeta tipográfica
 * propia (public/og.svg) y el alt lo dice sin inventar ninguna foto.
 */
const altOg =
	'Tarjeta con el nombre, la dirección y el teléfono de Itálica de Flores S.L.';



/**
 * Recuento de reseñas que publica la ficha.
 *
 * La ficha enlaza 18 reseñas pero no publica nota media ni deja ver los textos,
 * así que la portada solo reproduce el recuento, sin media ni citas.
 */
const textoResenas = '18 reseñas';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#5c2e3e" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-SE" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(floristSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">IF</span>
				<span class="brand-text">
					Itálica de Flores S.L.
					<small>Calle Metalurgia · Sevilla</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#local">La tienda</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Sevilla · Distrito Norte · 41007</p>
						<h1 id="hero-title">
							Itálica de Flores S.L.,
							<br />
							<em>en Sevilla.</em>
						</h1>
						<p class="hero-lede">
							Itálica de Flores S.L. está en la Calle Metalurgia, 53, con código postal
							41007, en el Distrito Norte de Sevilla.
							Google la clasifica como floristería y la ficha enlaza {textoResenas}. De lunes a viernes abre de 7:00 a 15:00; el sábado abre de 8:00 a 11:00 y el domingo cierra.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>Llamar al {business.phone}</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode}
									{business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Reseñas</small>
								<strong>
									La ficha enlaza {textoResenas}
								</strong>
							</li>
						</ul>
					</div>

					<div class="hero-collage">
						<figure class="collage-item collage-item-a">
							<img
								src="/og.svg"
								alt={altOg}
								width="1200"
								height="630"
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</figure>
					</div>
				</div>
			</section>

			<div class="band">
				<span>
					La ficha enlaza {textoResenas}
				</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>{hoursSummary}</span>
				<span>Teléfono {business.phone}</span>
			</div>

			<section class="section" id="local" aria-labelledby="local-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">La tienda</p>
						<h2 class="title" id="local-title">
							Flores y plantas,
							<br />
							<em>en Sevilla.</em>
						</h2>
						<p>
							Google la clasifica como floristería. La ficha enlaza {textoResenas}, sin publicar nota media. Está en la
							Calle Metalurgia, 53, con código postal
							41007, en el Distrito Norte de Sevilla, y la ficha publica su plus
							code
							C26V+FQ Sevilla.
						</p>
						<p>
							La ficha no publica descripción del titular, así que esta web no
							reproduce ninguna. Tampoco deja ver los textos de las reseñas en su vista
							previa, así que aquí no se reproduce ningún extracto: el enlace de al lado abre
							el listado completo en Google Maps.
						</p>
						<p>
							Esta web se ha preparado solo con lo que publica la ficha, consultada
							el {site.consultado}: nombre, dirección, teléfono, categoría,
							horario, el recuento de reseñas, el servicio de accesibilidad
						y el mapa. La
							ficha no publica nota media, textos de reseñas, descripción del titular,
							fotografías, web, catálogo ni precios, así que aquí no se
							reproducen.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{textoResenas}</strong>
							<span>La ficha no publica nota media</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver todas ↗</a>
						</div>
					</div>
				</div>
			</section>

						<section class="section" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Calle Metalurgia, 53,
							<br />
							<em>41007 Sevilla.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr class:list={[{ 'is-closed': item.shifts.length === 0 }]}>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							La tienda abre <strong>de lunes a viernes</strong>, de 7:00 a 15:00. El <strong>sábado</strong> abre de 8:00 a 11:00 y el <strong>domingo</strong> cierra. Conviene confirmar
							por teléfono antes de ir.
						</p>
						{accesibilidad.length > 0 ? (
						<ul class="access-list">
							{accesibilidad.map((item) => (
								<li class:list={[{ 'is-no': !item.disponible }]}>{item.label}</li>
							))}
						</ul>
) : (
						<p class="hours-note">La ficha no publica datos de accesibilidad.</p>
)}
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
						 src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>llamar.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">IF</span>
					<span>
						Itálica de Flores S.L.
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Itálica de Flores S.L. · Calle Metalurgia, 53
					(41007 Sevilla). Web informativa elaborada con los datos que
					el local publica en su ficha de Google Maps, consultada el {site.consultado}.
					Confirma horario y disponibilidad por teléfono antes de salir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a Itálica de Flores S.L. <span>{business.phone}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
