---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/mesa-puesta-ii-apaisada-01.jpg';
import fachadaLado from '../assets/fotos/mesa-puesta-ii-apaisada-02.jpg';
import fachadaAcera from '../assets/fotos/mesa-puesta-ii-apaisada-03.jpg';
import pollo from '../assets/fotos/mesa-puesta-ii-apaisada-04.jpg';
import ensaladilla from '../assets/fotos/mesa-puesta-ii-apaisada-05.jpg';
import ternera from '../assets/fotos/mesa-puesta-ii-apaisada-06.jpg';
import costillas from '../assets/fotos/mesa-puesta-ii-apaisada-07.jpg';
import bacalao from '../assets/fotos/mesa-puesta-ii-apaisada-08.jpg';
import paella from '../assets/fotos/mesa-puesta-ii-vertical-09.jpg';
import canelones from '../assets/fotos/mesa-puesta-ii-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
} from '../data/site';

const title = 'Mesa Puesta II · Pollo asado y comida para llevar en Las Tablas, Madrid';
const description = BUSINESS.description;

const galeria = [
	{
		src: pollo,
		alt: 'Bandeja de aluminio con pollo asado y patatas de Mesa Puesta II',
	},
	{
		src: paella,
		alt: 'Paella con langostinos y mejillones en la paellera, recién hecha',
	},
	{
		src: ensaladilla,
		alt: 'Bandeja de ensaladilla rusa con atún, huevo cocido y pimiento',
	},
	{
		src: ternera,
		alt: 'Bandeja de ternera en salsa con patatas, guisantes y zanahoria',
	},
	{
		src: costillas,
		alt: 'Bandeja de costillas asadas con patatas',
	},
	{
		src: bacalao,
		alt: 'Bandeja de pescado en salsa de tomate con patatas',
	},
	{
		src: canelones,
		alt: 'Bandeja de canelones gratinados con salsa de tomate',
	},
	{
		src: fachadaLado,
		alt: 'Fachada de Mesa Puesta II con el toldo de asador de pollos y comida para llevar',
	},
	{
		src: fachadaAcera,
		alt: 'Vista de la acera con la fachada de Mesa Puesta II y los locales vecinos',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Mesa Puesta II',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: Number(item.price.replace(' €', '').replace(',', '.')),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#mesa-puesta-ii`,
	name: BUSINESS.name,
	alternateName: ['Mesa Puesta 2', 'La Mesa Puesta II', 'Mesa Puesta II Las Tablas'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34913446578',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Española', 'Comida para llevar'],
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Las Tablas' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	hasTakeaway: true,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '17:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"mesa-puesta-ii-apaisada-01.jpg": fachada,
	"mesa-puesta-ii-apaisada-04.jpg": pollo,
	"mesa-puesta-ii-vertical-09.jpg": paella,
	"mesa-puesta-ii-apaisada-05.jpg": ensaladilla,
	"mesa-puesta-ii-apaisada-06.jpg": ternera,
	"mesa-puesta-ii-apaisada-07.jpg": costillas,
	"mesa-puesta-ii-apaisada-08.jpg": bacalao,
	"mesa-puesta-ii-apaisada-10.jpg": canelones,
	"mesa-puesta-ii-apaisada-02.jpg": fachadaLado,
	"mesa-puesta-ii-apaisada-03.jpg": fachadaAcera,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#171310" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Mesa Puesta II, Mesa Puesta 2 Madrid, pollo asado Las Tablas, comida para llevar Las Tablas, asador de pollos Fuencarral, paellas por encargo Madrid, menú del día Las Tablas, Isabel Colbrand 18"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado de asador, menú del día, paellas por encargo y comida casera para llevar en Isabel Colbrand 18, Las Tablas. 4,6 sobre 5 en Google con 312 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de Mesa Puesta II en la calle Isabel Colbrand, Las Tablas"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#171310"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Las Tablas, Madrid"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Mesa Puesta II"
			subtitle="Asador de pollos · Las Tablas"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.neighbourhood}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías de la ficha pública de Google Maps, consultados en octubre de 2026. La carta no tiene precios publicados: confírmalos por teléfono."
			ctaLabel="Llamar a Mesa Puesta II"
			navAriaLabel="Enlaces de Mesa Puesta II"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
