---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/casa-ana-apaisada-01.jpg';
import parrillada from '../assets/fotos/casa-ana-apaisada-04.jpg';
import costillas from '../assets/fotos/casa-ana-apaisada-06.jpg';
import cafe from '../assets/fotos/casa-ana-vertical-02.jpg';
import embutido from '../assets/fotos/casa-ana-vertical-03.jpg';
import helado from '../assets/fotos/casa-ana-vertical-05.jpg';

const business = {
	name: 'Casa Ana',
	brand: 'Casa Ana',
	street: 'C. Quevedo, 10',
	city: 'El Monte Blanco',
	municipality: 'Onda',
	region: 'Castelló',
	postalCode: '12200',
	phone: '607 64 02 23',
	latitude: 39.9620054,
	longitude: -0.2448319,
	rating: 4.4,
	reviewsCount: 114,
	site: 'https://casa-ana.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd600b34387d343d:0x77010cf344cdb74c';
const cidDecimal = '8575149404461053772';
const placeId = 'ChIJPTR9ODQLYA0RTLfNRPMMAXc';

const mapsUrl =
	'https://www.google.com/maps/place/Casa+Ana/@39.9620054,-0.2448319,17z/data=!3m1!4b1!4m6!3m5!1s0xd600b34387d343d:0x77010cf344cdb74c!8m2!3d39.9620054!4d-0.2448319!16s%2Fg%2F11ghg2vbg0?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34607640223';

const description =
	'Casa Ana, bar restaurante en la urbanización El Monte Blanco (Onda, Castellón): brasa, bocadillos, tapas y café desde las 8:50. Abre de martes a domingo; lunes cerrado.';

const servicios = [
	'Bar restaurante',
	'Brasa y parrilla',
	'Bocadillos',
	'Tapas',
	'Café y desayunos',
	'Postres',
	'Comidas y cenas',
	'Aparcamiento en la calle',
	'Acceso adaptado',
	'Reservas por teléfono',
];

const grupos = [
	{
		title: 'De la brasa',
		items: [
			{
				name: 'Parrillada de la casa',
				note: 'costillas y panceta a la brasa con berenjena, calabacín y pimientos asados',
			},
			{
				name: 'Costillas con patatas y huevo',
				note: 'costillas de cerdo a la brasa con patatas fritas y huevo frito',
			},
			{
				name: 'Embutido a la brasa',
				note: 'panceta, chorizo, morcilla y salchicha recién hechos en la parrilla, con aceitunas',
			},
		],
	},
	{
		title: 'De barra',
		items: [
			{
				name: 'Bocadillo de chorizo a la brasa',
				note: 'el que cita una reseña: «el bocadillo de chorizo a la brasa, buenísimo»',
			},
			{
				name: 'Café solo',
				note: 'en vaso, el de primera hora y el de después de comer',
			},
		],
	},
	{
		title: 'De postre',
		items: [
			{
				name: 'Copa de helado',
				note: 'helado con sirope de fresa y barquillos, servido en copa',
			},
		],
	},
];

const galeria = [
	{
		src: parrillada,
		alt: 'Parrillada de la casa con costillas, panceta y verduras a la brasa en Casa Ana, El Monte Blanco',
	},
	{
		src: costillas,
		alt: 'Costillas a la brasa con patatas fritas y huevo frito en Casa Ana, El Monte Blanco',
	},
	{
		src: embutido,
		alt: 'Panceta, chorizo, morcilla y salchicha a la brasa en Casa Ana, El Monte Blanco',
	},
	{
		src: helado,
		alt: 'Copa de helado con sirope de fresa y barquillos en Casa Ana, El Monte Blanco',
	},
	{
		src: cafe,
		alt: 'Café solo servido en vaso en Casa Ana, El Monte Blanco',
	},
];

const faqs = [
	{
		q: '¿Dónde está Casa Ana?',
		a: "En el C. Quevedo, 10, en la urbanización El Monte Blanco, 12200 Onda (Castelló). Es un bar restaurante de fachada roja y rótulo verde, en una zona residencial a las afueras de Onda. Se aparca en la misma calle, junto al local. El botón «Cómo llegar» abre la ruta exacta en Google Maps.",
	},
	{
		q: '¿Qué horario tiene?',
		a: 'Abre de 8:50 a 22:50 de martes a domingo, sin cerrar a mediodía. Los viernes y los sábados alarga hasta las 23:50. El lunes está cerrado. La ficha de Google no marca descanso entre el servicio de comidas y el de cenas.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Lo que más sale en sus fotos es la brasa: costillas y panceta con patatas y huevo, parrillada con verduras asadas y embutido recién hecho en la parrilla. También hay bocadillos —una reseña habla del de chorizo a la brasa—, tapas, café y postres. No hay carta publicada con precios.',
	},
	{
		q: '¿Hay menú del día?',
		a: 'La ficha de Google no publica menú del día ni precios, y esta web no los inventa. Lo que haya cada jornada se pregunta en la barra o por teléfono, en el 607 64 02 23.',
	},
	{
		q: '¿Se puede desayunar o solo ir a comer?',
		a: 'Abre a las 8:50 y funciona como bar del barrio durante todo el día: café, bocadillos y tapas por la mañana, brasa a la hora de comer y cervezas por la tarde. Una reseña lo resume así: «perfecto para echar unas cervezas y comer algo».',
	},
	{
		q: '¿Hay que reservar?',
		a: 'No hay reserva online ni formulario en esta web: se reserva llamando al 607 64 02 23. Para grupos o fines de semana conviene llamar con tiempo.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'La ficha de Google marca entrada, aseo y asientos adaptados para sillas de ruedas. No marca plaza de aparcamiento adaptada; el aparcamiento es el de la calle.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['Bar Casa Ana', 'Bar restaurante Casa Ana', 'Casa Ana Onda'],
	slogan: 'Brasa, bocadillos y barra en El Monte Blanco',
	description,
	url: `${business.site}/`,
	telephone: '+34 607 64 02 23',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Carnes a la brasa', 'Tapas', 'Bocadillos', 'Cocina de bar'],
	areaServed: [
		{ '@type': 'City', name: 'Onda' },
		{ '@type': 'Place', name: 'Urbanización El Monte Blanco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: `${business.city} (${business.municipality})`,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Sunday'],
			opens: '08:50',
			closes: '22:50',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '08:50',
			closes: '23:50',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La brasa', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Casa Ana · Bar restaurante en El Monte Blanco (Onda)</title>
		<meta name="theme-color" content="#a63d2f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,500;0,600;0,700;1,600&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Casa Ana, bar Casa Ana, bar restaurante Casa Ana, El Monte Blanco, Onda, restaurante Onda, brasa Onda, bocadillos Onda, tapas El Monte Blanco, comer en Onda, Castellón"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Casa Ana · Bar restaurante en El Monte Blanco (Onda)"
			ogDescription="Brasa, bocadillos, tapas y café desde las 8:50 en El Monte Blanco. Abre de martes a domingo; lunes cerrado. 4,4 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Fachada roja de Casa Ana, bar restaurante en El Monte Blanco (Onda)"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#a63d2f"
			street={business.street}
			city={`${business.city} (${business.municipality})`}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="El Monte Blanco, Onda (Castellón)"
			contact={{
				street: business.street,
				locality: `${business.city} (${business.municipality})`,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[fachada]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="CA"
			name={business.brand}
			subtitle="Bar restaurante · El Monte Blanco"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Quevedo, 10 · El Monte Blanco (Onda)"
				title="Brasa, barra<br />y <em>sobremesa.</em>"
				lede="Casa Ana es el bar restaurante de la urbanización El Monte Blanco, en Onda. Abre a las 8:50 y no cierra a mediodía: café y bocadillos por la mañana, parrilla a la hora de comer y tapas hasta la noche. Los lunes descansa."
				image={fachada}
				imageAlt="Fachada roja con el rótulo verde de bar restaurante Casa Ana, en El Monte Blanco (Onda)"
				primaryCta={{ label: 'Llamar 607 64 02 23', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4</b> en Google (114 reseñas)' },
					{ label: 'Abierto', html: '<b>8:50 – 22:50</b>' },
					{ label: 'Viernes y sábado', html: '<b>Hasta las 23:50</b>' },
					{ label: 'Lunes', html: '<b>Cerrado</b>' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Casa Ana" items={servicios} />

			<LocalAbout
				label="El bar de El Monte Blanco"
				title="Fachada roja,<br /><em>brasa</em> dentro."
				paragraphs={[
					'Casa Ana está en el C. Quevedo, 10, en la urbanización El Monte Blanco, un núcleo residencial del municipio de Onda (Castelló). La fachada es roja y el rótulo, verde: bar restaurante Casa Ana, con el comedor dentro y sitio para aparcar en la misma calle.',
					'Funciona como el bar del barrio desde primera hora. A las 8:50 ya hay café en la barra y bocadillos; a mediodía sale la brasa —costillas, panceta, chorizo y morcilla con patatas y verduras asadas— y por la tarde sigue abierto para unas cervezas y algo de picar. No cierra entre comidas y cenas: el horario es corrido hasta las 22:50.',
					'Los viernes y los sábados alarga hasta las 23:50, y el lunes cierra. La ficha reúne 114 opiniones con un 4,4, y las reseñas se reparten entre la brasa, el trato del equipo —Ana, Iván y Marta aparecen por nombre— y lo bien que funciona para una parada rápida.',
				]}
				note="«El bocadillo de chorizo a la brasa, buenísimo», dice una reseña. Otra lo resume así: «perfecto para echar unas cervezas y comer algo»."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La brasa"
				title="Parrilla, pan<br />y <em>café.</em>"
				description="La ficha de Google no tiene carta ni precios, así que esta lista sale de las fotos del propio bar y de lo que cuentan sus reseñas: brasa, bocadillos y postres de barra."
				cta={{ label: 'Preguntar qué hay hoy', href: phoneHref }}
				groups={grupos}
				note="Esta web no publica precios: no hay carta ni menú con importes en la ficha de Google. Lo que se pone cada día en la parrilla, las raciones y su precio se consultan en la barra o llamando al 607 64 02 23."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La parrilla,<br />el plato<br /><em>y la barra.</em>"
				description="Estas fotografías proceden del perfil de Casa Ana en Google Maps: la fachada con el rótulo, la parrillada con verduras asadas, las costillas con patatas y huevo, el embutido a la brasa, la copa de helado y el café."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="C. Quevedo, 10 · 12200 El Monte Blanco"
				title="Ven a la brasa<br /><em>del barrio.</em>"
				addressLines={[
					business.street,
					`${business.postalCode} ${business.city} (${business.municipality})`,
					'Castelló, España',
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: '8:50 – 22:50' },
					{ day: 'Miércoles', value: '8:50 – 22:50' },
					{ day: 'Jueves', value: '8:50 – 22:50' },
					{ day: 'Viernes', value: '8:50 – 23:50' },
					{ day: 'Sábado', value: '8:50 – 23:50' },
					{ day: 'Domingo', value: '8:50 – 22:50' },
				]}
				hoursNote="Horario publicado en la ficha de Google: de 8:50 a 22:50 de martes a domingo, hasta las 23:50 los viernes y sábados, y cerrado los lunes. Es horario corrido, sin cierre a mediodía. En fiestas de la urbanización puede cambiar: llama antes al 607 64 02 23."
				mapTitle="Mapa de Casa Ana en el C. Quevedo, 10, El Monte Blanco (Onda)"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Casa Ana · El Monte Blanco"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Las reservas se hacen por teléfono, llamando al 607 64 02 23: no hay reserva online ni formulario en esta web. Hay aparcamiento en la calle, delante del local."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="CA"
			name="Casa Ana"
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, platos y precios antes de la visita."
			ctaLabel="Llamar a Casa Ana"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
