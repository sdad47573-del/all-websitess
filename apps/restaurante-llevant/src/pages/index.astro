---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import terraza from '../assets/fotos/restaurante-llevant-apaisada-01.jpg';
import cervezas from '../assets/fotos/restaurante-llevant-panoramica-02.jpg';
import costa from '../assets/fotos/restaurante-llevant-apaisada-03.jpg';
import mar from '../assets/fotos/restaurante-llevant-panoramica-04.jpg';
import vino from '../assets/fotos/restaurante-llevant-vertical-05.jpg';
import noche from '../assets/fotos/restaurante-llevant-panoramica-06.jpg';
import terrazaGente from '../assets/fotos/restaurante-llevant-apaisada-07.jpg';
import velero from '../assets/fotos/restaurante-llevant-panoramica-08.jpg';
import picoteo from '../assets/fotos/restaurante-llevant-panoramica-09.jpg';
import ibiza from '../assets/fotos/restaurante-llevant-panoramica-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Restaurante Llevant, en C. de Carles Roman Ferrer, 5 (Figueretes, Eivissa). Cocina catalana y terraza frente al mar con vistas a Ibiza y Dalt Vila. Atardeceres y picoteo.';

const galeria = [
	{
		src: terraza,
		alt: 'Terraza de Llevant bajo una lona blanca, con mesas y sillas verdes junto al mar y vistas a la costa de Ibiza',
	},
	{
		src: terrazaGente,
		alt: 'Terraza de Llevant al sol con clientes sentados, bombillas colgadas y la isla al fondo',
	},
	{
		src: picoteo,
		alt: 'Nachos con guacamole y nata agria, calamares a la romana, croquetas y ensaladilla sobre una mesa blanca',
	},
	{
		src: cervezas,
		alt: 'Tres copas de cerveza de barril Estrella Galicia sobre una mesa blanca frente al mar',
	},
	{
		src: vino,
		alt: 'Copa de vino blanco y gafas de sol en una mesa de la terraza, con el mar y la barandilla de cuerda al fondo',
	},
	{
		src: mar,
		alt: 'Mar de Figueretes con un velero y el islote del faro al fondo, visto desde la terraza',
	},
	{
		src: costa,
		alt: 'Agua turquesa sobre las rocas de la orilla con la ciudad de Ibiza al fondo',
	},
	{
		src: velero,
		alt: 'Vista del mar desde la barandilla de cuerda de la terraza, con veleros y el islote a lo lejos',
	},
	{
		src: noche,
		alt: 'Vista nocturna de la bahía de Ibiza desde la terraza, con las luces del paseo marítimo',
	},
	{
		src: ibiza,
		alt: 'Panorámica de Ibiza con Dalt Vila y el casco urbano desde la orilla de Figueretes',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#llevant`,
	name: BUSINESS.name,
	alternateName: ['Llevant', 'Llevant Ibiza', 'Restaurante Llevant Ibiza', 'Llevant Figueretes'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	currenciesAccepted: 'EUR',
	servesCuisine: ['Catalana', 'Mediterránea'],
	areaServed: [
		{ '@type': 'City', name: 'Eivissa' },
		{ '@type': 'AdministrativeArea', name: 'Figueretes' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Llevant · Terraza frente al mar en Figueretes, Ibiza';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1d6b7a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Llevant Ibiza, restaurante Llevant, terraza Figueretes, comer en Figueretes, tomar algo frente al mar Ibiza, puesta de sol Ibiza, cocina catalana Ibiza, Carles Roman Ferrer"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Llevant · Terraza frente al mar en Figueretes, Ibiza"
			ogDescription="Terraza sobre el mar en Figueretes (Ibiza), con vistas a Dalt Vila y al atardecer. Para picar y beber algo. C. de Carles Roman Ferrer, 5."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Terraza de Llevant bajo una lona blanca con vistas al mar en Figueretes"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1d6b7a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[terraza]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Restaurante Llevant"
			subtitle="Cocina catalana · Figueretes, Ibiza"
			phone="Ver ficha"
			phoneHref={MAPS.place}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. de Carles Roman Ferrer, 5 · Figueretes"
				title="Una terraza<br /><em>sobre el mar.</em>"
				lede={`Llevant es un restaurante de cocina catalana con terraza sobre el agua en C. de Carles Roman Ferrer, 5, en Figueretes (Eivissa, Ibiza). Mesas bajo una lona blanca, sillas verdes y una barandilla de cuerda frente al mar, con Ibiza, Dalt Vila y el islote del faro al fondo. Para picar y beber algo mientras cae el sol. La ficha de Google no publica horario ni teléfono: consulta su ficha para el horario actualizado. Calificación: ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas.`}
				image={terraza}
				imageAlt="Terraza de Llevant bajo una lona blanca, con mesas y sillas verdes junto al mar y vistas a la costa de Ibiza"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)` },
					{ label: 'Cocina', html: 'Catalana · picoteo y terraza' },
					{ label: 'Horario', html: 'No publicado en Google · consultar la ficha' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Restaurante Llevant" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Figueretes,<br /><em>a ras de agua.</em>"
				paragraphs={[
					'Llevant está en C. de Carles Roman Ferrer, 5, en Figueretes (Eivissa, Ibiza), en primera línea de mar. Google lo clasifica como restaurante de cocina catalana. La terraza ocupa una plataforma sobre las rocas, con una lona blanca sujeta con postes, bombillas colgadas, mesas y sillas verdes y una barandilla de cuerda que separa las mesas del agua.',
					'Desde la terraza se ve la bahía de Ibiza, el casco urbano con Dalt Vila al fondo y el islote del faro a la derecha. En las fotos del perfil aparecen el mar en calma, veleros fondeados, la puesta de sol y la vista nocturna del paseo marítimo iluminado.',
					'En la mesa se ven nachos con guacamole y nata agria, calamares a la romana, croquetas, ensaladilla y pan, además de cerveza de barril en copa y vino blanco. Sus reseñas lo describen como un lugar para picar o beber algo viendo el atardecer, tranquilo y con buen ambiente.',
					'Sobre el horario y el contacto, la web no inventa nada: la ficha de Google no publica horario ni teléfono, así que se remite a la ficha del restaurante en Google Maps para consultarlos. Google le da 4,5 sobre 5 con 121 reseñas.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google. Una de ellas: «${REVIEWS[1]}»`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Horario y contacto en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Para picar<br /><em>y ver caer el sol.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que aparece en las fotos del perfil y lo que citan sus reseñas."
				cta={{ label: 'Ver la ficha de Google', href: MAPS.place }}
				groups={MENU}
				note="No hay carta ni precios publicados en la ficha. Consulta la ficha de Google Maps para la oferta del día."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La terraza,<br /><em>el mar y la noche.</em>"
				description="Estas fotografías proceden del perfil de Restaurante Llevant en Google Maps: la terraza bajo la lona, las mesas junto al agua, las cervezas y el vino, el picoteo, el atardecer y la vista nocturna de Ibiza."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en Figueretes.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursCaption="Horario (no publicado en Google)"
				hoursNote="La ficha de Google de Llevant no publica horario: no inventamos uno. Consulta el horario actualizado y el contacto en su ficha de Google Maps antes de ir."
				mapTitle="Mapa de Restaurante Llevant en C. de Carles Roman Ferrer, Figueretes (Ibiza)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Llevant · Figueretes"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: 'Horario y contacto en Google Maps', href: MAPS.place, external: true }}
				reserveNote="No hay reserva online ni teléfono publicado en la ficha: las consultas se hacen a través de Google Maps. La ficha marca acceso para sillas de ruedas y asientos adaptados."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone="en Google Maps"
			phoneHref={MAPS.place}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; el horario y el contacto están en la ficha de Google."
			ctaLabel="Horario y contacto"
		/>
	</body>
</html>
