---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import fachada from '../assets/fotos/asador-pineda-vertical-09.jpg';
import interior from '../assets/fotos/asador-pineda-apaisada-01.jpg';
import pollo from '../assets/fotos/asador-pineda-apaisada-10.jpg';
import bandeja from '../assets/fotos/asador-pineda-vertical-03.jpg';
import trinchar from '../assets/fotos/asador-pineda-vertical-08.jpg';
import aceitunas from '../assets/fotos/asador-pineda-apaisada-02.jpg';
import vinos from '../assets/fotos/asador-pineda-vertical-05.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Asador Pineda · Pollos asados en el centro de Málaga';
const description =
	'Asador Pineda, en C. Manrique, 19 (Distrito Centro, 29013 Málaga). Pollos asados y comida casera para comer o para llevar. Abierto todos los días de 10:00 a 16:00.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#pineda`,
	name: BUSINESS.name,
	alternateName: ['Pineda', 'Asador Pineda Málaga', 'Pollos asados Pineda'],
	description:
		'Asador y restaurante de comida para llevar en la calle Manrique, 19, Distrito Centro (29013 Málaga). Pollos asados y comida casera.',
	url: `${BUSINESS.siteUrl}/`,
	telephone: '+34952654016',
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:00',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: false,
		},
	],
	servesCuisine: ['Pollo asado', 'Comida casera'],
	hasTakeaway: true,
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Del asador', href: '#carta' },
	{ label: 'Horario', href: '#horario' },
	{ label: 'Dónde está', href: '#visitanos' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#191612" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600&family=Source+Sans+3:ital,wght@0,300..700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador Pineda Málaga, pollos asados Málaga, comida casera Málaga, asador calle Manrique, comida para llevar Centro Málaga, pollo asado 29013"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollos asados y comida casera en la calle Manrique, 19. Abierto todos los días de 10:00 a 16:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="El toldo naranja y el rótulo de Asador Pineda en la calle Manrique"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#191612"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Asador Pineda, inicio">
					<span class="brand-mark" aria-hidden="true">AP</span>
					<span class="brand-name">
						Asador Pineda
						<small>Pollos asados · Centro de Málaga</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-cta" href={BUSINESS.phoneHref}>
					{BUSINESS.phone} <span aria-hidden="true">↗</span>
				</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Distrito Centro · 29013 Málaga</p>
						<h1 id="hero-title">Asador Pineda<em>Pollos asados y comida casera</em></h1>
						<p class="hero-lede">
							El toldo naranja de la calle Manrique lleva años anunciando lo mismo: pollos asados y
							comida casera. Se puede comer allí o encargar para llevar, todos los días de 10:00 a
							16:00.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="button button-ghost" href="#carta">Ver el mostrador</a>
						</div>
						<dl class="hero-facts">
							<div>
								<dt>Abre</dt>
								<dd>10:00</dd>
							</div>
							<div>
								<dt>Abierto</dt>
								<dd>Los 7 días</dd>
							</div>
							<div>
								<dt>Valoración</dt>
								<dd>4,5 · 324 reseñas</dd>
							</div>
						</dl>
					</div>

					<figure class="hero-media">
						<div class="hero-photo">
							<Image
								src={fachada}
								alt="La fachada de Asador Pineda en la calle Manrique, con el rótulo negro, el toldo naranja y el teléfono de encargo"
								widths={[480, 720, 1024, 1400]}
								sizes="(max-width: 900px) 92vw, 46vw"
								format="avif"
								quality={74}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</div>
						<figcaption>
							<span>El toldo de la calle Manrique</span>
							<span>Foto de la ficha de Google</span>
						</figcaption>
						<span class="hero-seal" aria-hidden="true">
							<strong>4,5</strong>
							<small>324 reseñas<br />en Google</small>
						</span>
					</figure>
				</div>
			</section>

			<section class="chips-wrap wrap" aria-label="Lo que publica la ficha de Google">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<div class="about-grid">
					<div class="about-copy">
						<p class="section-label"><span aria-hidden="true"></span> La casa</p>
						<h2 id="about-title">Un asador de barrio con <em>medio Málaga enfrente.</em></h2>
						<p>
							Asador Pineda está en la calle Manrique, 19, en el Distrito Centro. La fachada negra y
							el toldo naranja se ven desde la acera, con el teléfono de encargo bien grande.
						</p>
						<p>
							En su ficha de Google, el propio negocio se presenta como «los mejores pollos asados
							de Málaga y comida casera». Google lo clasifica a la vez como restaurante y como
							restaurante de comida para llevar.
						</p>
						<p>
							La galería enseña el mostrador: vitrinas de platos preparados, el asador con los
							pollos, las bandejas de patatas y las estanterías de vino y vermut. La foto del
							interior es la que mejor resume el local.
						</p>
						<div class="about-links">
							<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha en Google Maps <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href="#fotos">Ver las fotos</a>
						</div>
					</div>

					<figure class="about-media">
						<Image
							src={interior}
							alt="El interior del asador, con el mostrador de platos preparados, el asador de pollos y las estanterías de vino"
							widths={[400, 640, 900]}
							sizes="(max-width: 900px) 92vw, 40vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>El mostrador y el asador</figcaption>
					</figure>
				</div>

				<ul class="highlights">
					{
						HIGHLIGHTS.map((item) => (
							<li>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section class="menu" id="carta" aria-labelledby="menu-title">
				<div class="wrap menu-grid">
					<div class="menu-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> El mostrador</p>
						<h2 id="menu-title">Pollo asado <em>y cocina de casa.</em></h2>
						<p class="menu-lede">
							La ficha no publica carta ni precios. Lo que sí nombran la descripción del negocio y
							las reseñas es esto; el resto del surtido cambia según el día.
						</p>

						<div class="menu-groups">
							{
								MENU.map((group) => (
									<div class="menu-group">
										<h3>{group.title}</h3>
										<ul>
											{group.items.map((item) => (
												<li>
													<strong>{item.name}</strong>
													<span>{item.note}</span>
												</li>
											))}
										</ul>
									</div>
								))
							}
						</div>

						<p class="menu-note">
							Sin precios en la web: la ficha no los publica y cambian. Para encargar, llama al{' '}
							<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>.
						</p>
					</div>

					<figure class="menu-media">
						<Image
							src={pollo}
							alt="Una bandeja de pollo asado con pimientos verdes recién hechos"
							widths={[480, 720, 1000]}
							sizes="(max-width: 900px) 92vw, 45vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>El pollo, recién salido del asador</figcaption>
					</figure>
				</div>
			</section>

			<section class="hours" id="horario" aria-labelledby="hours-title">
				<div class="wrap hours-grid">
					<div class="hours-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> Horario</p>
						<h2 id="hours-title">De diez a cuatro, <em>todos los días.</em></h2>
						<p class="hours-lede">
							La ficha publica el mismo horario los siete días de la semana, de 10:00 a 16:00, sin
							ningún día de cierre. Es un servicio de mediodía.
						</p>
						<p class="hours-note">
							<strong>Ojo con los festivos.</strong> {HORARIO_AVISO}
						</p>
						<a class="hours-link" href={MAPS.place} target="_blank" rel="noreferrer">
							Comprobar en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>

					<div class="hours-table-wrap">
						<table class="hours-table">
							<caption class="visually-hidden">
								Horario publicado en la ficha de Google
							</caption>
							<tbody>
								{
									HORARIO.map((row) => (
										<tr>
											<th scope="row">{row.dia}</th>
											<td>{row.horas}</td>
										</tr>
									))
								}
							</tbody>
						</table>
						<p class="hours-foot">
							Horario publicado en la ficha pública de Google, consultada en octubre de 2026.
						</p>
					</div>
				</div>
			</section>

			<section class="fotos wrap" id="fotos" aria-labelledby="fotos-title">
				<div class="fotos-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Fotos</p>
						<h2 id="fotos-title">El asador <em>y el mostrador.</em></h2>
					</div>
					<p>
						Las imágenes salen de la galería de la ficha de Google: el pollo, las bandejas, el
						mostrador de aceitunas y el interior del local.
					</p>
				</div>

				<div class="fotos-grid">
					<figure class="foto foto-wide">
						<Image
							src={bandeja}
							alt="Una bandeja de aluminio con pollo asado, patatas y verduras"
							widths={[560, 800, 1120]}
							sizes="(max-width: 900px) 92vw, 58vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Pollo y patatas para llevar</figcaption>
					</figure>
					<figure class="foto">
						<Image
							src={trinchar}
							alt="Un pollo asado sobre la tabla, con una mano enguantada trinchándolo"
							widths={[360, 540, 800]}
							sizes="(max-width: 900px) 92vw, 34vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Trinchando el pollo</figcaption>
					</figure>
					<figure class="foto">
						<Image
							src={aceitunas}
							alt="Botes de aceitunas y banderillas alineados en el mostrador del asador"
							widths={[360, 540, 800]}
							sizes="(max-width: 900px) 92vw, 34vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Aceitunas del mostrador</figcaption>
					</figure>
					<figure class="foto foto-wide">
						<Image
							src={vinos}
							alt="El interior del local con la estantería de vinos, vermut y productos envasados"
							widths={[560, 800, 1120]}
							sizes="(max-width: 900px) 92vw, 58vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Vinos y despensa</figcaption>
					</figure>
				</div>
			</section>

			<section class="rating" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">Cuatro y medio, <em>con más de 300 reseñas.</em></h2>
						<p>
							La ficha de Google tiene una valoración de 4,5 sobre 5 con 324 reseñas en el momento
							de consultarla (octubre de 2026). Hay opiniones muy buenas sobre el pollo y los platos
							preparados, y también alguna crítica con los precios.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}{'☆'.repeat(5 - resena.valor)}{' '}
											<small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<div class="rating-actions">
							<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
								Ver las reseñas en Google <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="rating-figure">
						<div class="rating-symbol" aria-hidden="true">
							<span class="rating-value">4,5</span>
							<span class="rating-stars">★★★★☆</span>
						</div>
						<p class="rating-caption">
							valoración media<br />
							con 324 reseñas publicadas
						</p>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Dónde está</p>
					<h2 id="visit-title">En la calle <em>Manrique, 19.</em></h2>
					<p class="address">
						{BUSINESS.street}<br />
						{BUSINESS.district}<br />
						{BUSINESS.postalCode} {BUSINESS.city}
					</p>

					<p class="visit-phone">
						<span>Teléfono</span>
						<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
					</p>

					<p class="hours-note">
						<strong>El teléfono es el que publica la ficha.</strong> No consta página web ni perfil
						social del negocio, así que esta página no enlaza ninguno.
					</p>

					<ul class="visit-list">
						<li>
							<span>Acceso</span>
							Google marca el acceso para sillas de ruedas.
						</li>
						<li>
							<span>Aparcamiento</span>
							La ficha indica que no hay aparcamiento adaptado.
						</li>
						<li>
							<span>Asientos</span>
							Tampoco figuran asientos adaptados.
						</li>
						<li>
							<span>Plus Code</span>
							{BUSINESS.plusCode}
						</li>
					</ul>

					<div class="visit-links">
						<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
							Ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Asador Pineda en la calle Manrique, 19, Málaga"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> C. Manrique, 19
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>pedir.</em></h2>
				<div class="faq-list">
					{
						FAQ.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">AP</span>
						<p>
							Asador Pineda
							<small>
								Pollos asados y comida casera<br />
								{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}
							</small>
						</p>
					</div>
					<nav aria-label="Enlaces del establecimiento">
						<a href={BUSINESS.phoneHref}>Llamar</a>
						<a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
						<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a href="#horario">Horario</a>
						<a href="/aviso-legal">Aviso legal</a>
					</nav>
				</div>
				<small class="legal">
					© {new Date().getFullYear()} {BUSINESS.name} · Datos y fotografías de la ficha pública de
					Google Maps, consultada en octubre de 2026. La web no publica carta ni precios porque la
					ficha no los incluye.
				</small>
				<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
				<p class="credit">
					<small
						>Creado por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a>
						· sur-digital.vercel.app</small
					>
				</p>
			</div>
