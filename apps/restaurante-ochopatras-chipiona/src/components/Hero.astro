---
import { Image } from 'astro:assets';
import { BUSINESS, IMAGES } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
---

<section id="inicio" class="hero-ochopatras relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.fotoPortada}
			alt="Restaurante OchoPatas en Chipiona"
			widths={[640, 1100, 1600]}
			sizes="100vw"
			quality={72}
			loading="eager"
			fetchpriority="high"
			class="h-full w-full object-cover opacity-20"
		/>
		<div class="from-neutral/95 via-neutral/60 absolute inset-0 bg-gradient-to-r"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
		<div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
			<div>
				<p
					class="text-accent inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase"
				>
					<span><i class="ri-anchor-line"></i> Pulpería · Chipiona</span>
					<span class="text-white/50">Costa de la Luz</span>
				</p>

				<h1 class="font-display mt-4 text-6xl leading-[0.95] font-bold sm:text-7xl lg:text-8xl">
					Ocho<span class="text-secondary">Patas</span>
				</h1>

				<p class="mt-6 max-w-xl text-base leading-relaxed text-white/80 sm:text-lg">
					Pulpo a la brasa, arroces y paellas, fritura y guisos caseros. En el paseo de Chipiona,
					con la playa a un paso y comida para llevar.
				</p>

				<div class="mt-7 flex flex-wrap items-center gap-3">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="badge badge-lg gap-2 border-white/20 bg-white/10 px-4 py-3 text-sm font-semibold text-white"
					>
						<span class="text-accent tracking-tight" aria-hidden="true">
							{
								estrellas.map((n) => (
									<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
								))
							}
						</span>
						{BUSINESS.rating.toString().replace('.', ',')} · {BUSINESS.reviewCount} reseñas en Google
					</a>
				</div>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-secondary btn-lg gap-2 rounded-full">
						<i class="ri-phone-line text-xl"></i>
						{BUSINESS.phone}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-lg gap-2 rounded-full border-white/35 bg-transparent text-white hover:border-white hover:bg-white hover:text-neutral"
					>
						<i class="ri-google-fill"></i>
						Ver ficha de Google
					</a>
				</div>

				<dl class="mt-10 grid gap-x-6 gap-y-5 border-t border-white/15 pt-7 sm:grid-cols-3">
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Mediodía</dt>
						<dd class="mt-1 text-base font-bold">12:00 – 18:00</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Noche</dt>
						<dd class="mt-1 text-base font-bold">20:30 – 24:00</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Dónde</dt>
						<dd class="mt-1 text-base font-bold">P.º Costa de la Luz, 71</dd>
						<dd class="text-xs text-white/55">11550 Chipiona · todos los días</dd>
					</div>
				</dl>
			</div>

			<figure class="relative mx-auto w-full max-w-md lg:max-w-none">
				<div class="border-accent/40 absolute -inset-2 rotate-2 rounded-xl border"></div>
				<div class="relative grid grid-cols-5 gap-3">
					<div class="col-span-3 overflow-hidden rounded-xl shadow-2xl">
						<Image
							src={IMAGES.fotoVertical3}
							alt="Interior del restaurante OchoPatas en Chipiona"
							widths={[360, 620]}
							sizes="(min-width: 1024px) 22vw, 55vw"
							quality={85}
							loading="eager"
							class="foto-calida aspect-[3/4] w-full object-cover"
						/>
					</div>
					<div class="col-span-2 flex flex-col gap-3">
						<div class="overflow-hidden rounded-xl shadow-xl">
							<Image
								src={IMAGES.fotoApaisada2}
								alt="Mesa de OchoPatas Chipiona"
								widths={[260, 440]}
								sizes="(min-width: 1024px) 15vw, 38vw"
								quality={85}
								loading="lazy"
								class="foto-calida aspect-square w-full object-cover"
							/>
						</div>
						<div
							class="sello-ochopatras bg-primary/85 flex flex-1 flex-col items-center justify-center rounded-full px-3 py-6 text-center"
						>
							<i class="ri-anchor-line text-accent text-2xl" aria-hidden="true"></i>
							<span class="mt-1 text-[0.6rem] leading-tight tracking-[0.14em] text-white/70 uppercase">
								pulpo<br />a la brasa
							</span>
						</div>
					</div>
				</div>
				<figcaption
					class="text-accent-content bg-accent mt-5 inline-flex items-center gap-2 rounded-full px-4 py-2 text-xs font-bold shadow-lg"
				>
					<i class="ri-shopping-bag-3-line"></i> Comida para llevar a la playa
				</figcaption>
			</figure>
		</div>
	</div>

	<div class="ola-ochopatras relative h-3 w-full"></div>
</section>
