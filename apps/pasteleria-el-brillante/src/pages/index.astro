---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/pasteleria-el-brillante-panoramica-01.jpg';
import esquina from '../assets/fotos/pasteleria-el-brillante-vertical-03.jpg';
import napolitanas from '../assets/fotos/pasteleria-el-brillante-apaisada-02.jpg';
import mano from '../assets/fotos/pasteleria-el-brillante-vertical-04.jpg';
import migasTaper from '../assets/fotos/pasteleria-el-brillante-vertical-05.jpg';
import tarta from '../assets/fotos/pasteleria-el-brillante-apaisada-06.jpg';
import sarten from '../assets/fotos/pasteleria-el-brillante-vista-7-07.jpg';
import panecillos from '../assets/fotos/pasteleria-el-brillante-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	SERVICIOS,
} from '../data/site';

const title = 'Pastelería El Brillante · napolitanas, pan y tartas en Córdoba';
const description =
	'Pastelería El Brillante, en C. la Palmera, 17 (Norte Sierra, 14006 Córdoba). Pastelería y panadería de obrador: napolitanas de chocolate, panecillos, migas y tartas por encargo. Todos los días de 8:00 a 14:30. 4,5/5 en Google.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#brillante`,
	name: BUSINESS.name,
	alternateName: ['El Brillante', 'Pastelería El Brillante Córdoba', 'Panadería El Brillante'],
	description:
		'Pastelería y panadería en C. la Palmera, 17 (Norte Sierra, 14006 Córdoba). Napolitanas de chocolate, panecillos, migas y tartas por encargo, todos los días de 8:00 a 14:30.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34957271440',
	servesCuisine: ['Pastelería', 'Panadería', 'Bollería'],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '08:00',
			closes: '14:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Horario', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const galeria = [
	{
		src: esquina,
		alt: 'Esquina de la pastelería El Brillante en la calle La Palmera, con la fachada blanca y el rótulo de panadería',
	},
	{
		src: napolitanas,
		alt: 'Bandeja de napolitanas y barras de hojaldre cubiertas de chocolate sobre el papel de El Brillante',
	},
	{
		src: mano,
		alt: 'Una napolitana de chocolate en la mano delante del rótulo azul de El Brillante',
	},
	{
		src: tarta,
		alt: 'Tarta rectangular con merengue, fruta escarchada y guindas sobre papel de la pastelería',
	},
	{
		src: migasTaper,
		alt: 'Táper de migas con chorizo y ajos preparado para llevar',
	},
	{
		src: sarten,
		alt: 'Sartén grande llena de migas recién hechas con chorizo y ajos',
	},
	{
		src: panecillos,
		alt: 'Bandeja dorada de panecillos recién horneados con corte en cruz',
	},
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"pasteleria-el-brillante-panoramica-01.jpg": fachada,
	"pasteleria-el-brillante-vertical-03.jpg": esquina,
	"pasteleria-el-brillante-apaisada-02.jpg": napolitanas,
	"pasteleria-el-brillante-vertical-04.jpg": mano,
	"pasteleria-el-brillante-apaisada-06.jpg": tarta,
	"pasteleria-el-brillante-vertical-05.jpg": migasTaper,
	"pasteleria-el-brillante-vista-7-07.jpg": sarten,
	"pasteleria-el-brillante-vertical-09.jpg": panecillos,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#fbf6ec" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Jost:wght@300..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Pastelería El Brillante, pastelería Córdoba, panadería Córdoba, napolitanas de chocolate, migas, tartas nupciales, Norte Sierra, calle La Palmera, 14006"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Napolitanas de chocolate, panecillos, migas y tartas por encargo en C. la Palmera, 17, todos los días de 8:00 a 14:30. 4,5 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Fachada de la Pastelería El Brillante en la calle La Palmera, Córdoba"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#fbf6ec"
			phone="+34957271440"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Brillante"
			subtitle="Pastelería · Panadería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario, productos y precios pueden cambiar; confírmalos antes de ir."
			ctaLabel="Llamar a El Brillante"
			navAriaLabel="Enlaces de la Pastelería El Brillante"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34957271440?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20C%C3%B3rdoba." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Córdoba"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
