---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import churros from '../assets/fotos/churreria-juan-apaisada-02.jpg';
import porras from '../assets/fotos/churreria-juan-vertical-01.jpg';
import porrasDetalle from '../assets/fotos/churreria-juan-vertical-05.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	SERVICIOS,
} from '../data/site';

const title = 'Churrería Juan · churros, porras y café en Córdoba';
const description =
	'Churrería-confitería-panadería Juan, en el barrio Noroeste (14011 Córdoba). Churros, porras y café con leche, con terraza en la acera. Abre todos los días de 6:00 a 20:00. 3,9/5 con 39 reseñas en Google.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#juan`,
	name: BUSINESS.name,
	alternateName: ['Churrería Juan', 'Churrería Juan Córdoba', 'Confitería Juan'],
	description:
		'Churrería, confitería y panadería en el barrio Noroeste de Córdoba (14011). Churros, porras y café, con terraza en la acera.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	servesCuisine: ['Churrería', 'Panadería', 'Confitería'],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '06:00',
			closes: '20:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Dónde', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const galeria = [
	{
		src: porras,
		alt: 'Porras recién fritas sobre papel de estraza en la mesa de la churrería',
	},
	{
		src: porrasDetalle,
		alt: 'Detalle de una porra abierta, con la miga hueca y dorada por dentro',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#fdf6e9" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Sans:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Churrería Juan, churrería Córdoba, porras Córdoba, churros con café, confitería panadería Juan, barrio Noroeste, 14011"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Churros, porras y café con leche en el barrio Noroeste de Córdoba. Terraza en la acera y todos los días de 6:00 a 20:00. 3,9 sobre 5 con 39 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Churros y café con leche en la mesa de la Churrería Juan, Córdoba"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#fdf6e9"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[churros]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Juan"
			subtitle="Churrería · Confitería · Panadería"
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Barrio Noroeste · 14011 Córdoba"
				title="Churros, porras <br /><em>y café con leche.</em>"
				lede={`Juan es churrería, confitería y panadería en el barrio Noroeste. En sus fotos hay un plato de churros con un vaso de café con leche y porras recién hechas sobre papel, servidas en la mesa. Abre todos los días de 6:00 a 20:00, sin cerrar a mediodía. La ficha de Google no publica ni calle ni teléfono: aquí no vas a encontrar esos datos inventados. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas.`}
				image={churros}
				imageAlt="Plato de churros y vaso de café con leche sobre la mesa de la terraza"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Dónde', html: '<b>Noroeste</b> · 14011 Córdoba' },
					{ label: 'Horario', html: '<b>Todos los días</b> · 6:00–20:00' },
					{ label: 'Teléfono', html: '<b>No publicado</b> en Google' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver las fotos en Google"
				tag="Abierto de 6:00 a 20:00"
			/>

			<LocalChips label="Lo que hay en la churrería" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una churrería <br /><em>de acera y mesa.</em>"
				paragraphs={[
					'Juan se anuncia con las tres palabras del oficio: churrería, confitería y panadería. Está en el barrio Noroeste, en el 14011 de Córdoba, y su ficha de Google no publica una dirección de calle: solo la zona y el código postal. Aquí no se rellena ese hueco con una calle inventada.',
					'Las fotos de la ficha son de mesa: un plato de churros finos con la greña bien marcada y un vaso de café con leche, y dos imágenes de porras gruesas, doradas y con la miga hueca, recién sacadas del aceite y servidas sobre papel.',
					'El local tiene barra con vitrina y cafetera dentro, y fuera mesas y sombrillas en la acera. Es un sitio de parar un rato: el horario va de 6:00 a 20:00 todos los días, así que sirve tanto el desayuno temprano como la merienda.',
					'La ficha tampoco publica teléfono. En su información de accesibilidad Google indica acceso para sillas de ruedas y ausencia de aparcamiento adaptado; es lo único que consta, y la web lo dice tal cual.',
				]}
				note="No hay carta, precios ni web propia en la ficha, y no hay teléfono publicado. Si necesitas confirmar algo, lo más fiable es pasarte por el local o usar la ficha de Google Maps."
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas de la casa</p>
							<h2 id="three-title">Churros, porras <br /><em>y barra.</em></h2>
						</div>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos"
				title="Las porras <br /><em>y su miga.</em>"
				description="Dos imágenes de la ficha de Google Maps dedicadas a las porras: la ración servida sobre papel y un primer plano de la miga. La portada de esta página es la tercera foto que se usa, los churros con el café."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026. La ficha tiene cinco fotos; las otras dos son la terraza y el mostrador, con personas en el encuadre, y no se usan en esta página."
			/>

			<section class="rating-band" aria-labelledby="rating-title">
				<div class="wrap rating-inner">
					<div class="rating-score">
						<strong>3,9</strong>
						<div>
							<span class="rating-stars" role="img" aria-label="3,9 de 5 estrellas">3,9 / 5</span>
							<p id="rating-title" style="margin:0;font-size:.78rem">39 reseñas en Google Maps</p>
						</div>
					</div>
					<p class="rating-copy">
						La media de la ficha es 3,9 sobre 5 con 39 reseñas, con opiniones variadas.
						Esta página no selecciona ni reproduce sus textos: se leen todas en Google.
					</p>
					<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
						Leer las 39 reseñas en Google ↗
					</a>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En el Noroeste, <br /><em>sin calle publicada.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de la Churrería Juan en el barrio Noroeste, Córdoba"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Juan · barrio Noroeste"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Reseñas', href: MAPS.reviews, external: true },
				]}
				contactLink={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				reserveNote="La ficha de Google solo publica la zona (Noroeste) y el código postal, no la calle, y no publica teléfono ni web propia. El punto del mapa es el que da Google; esta página no gestiona pedidos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>acercarse.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone=""
			phoneHref=""
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. La ficha no publica calle, teléfono, carta ni precios. Horario y disponibilidad pueden cambiar; confírmalos antes de ir."
			ctaLabel="Cómo llegar"
			navAriaLabel="Enlaces de la Churrería Juan"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
