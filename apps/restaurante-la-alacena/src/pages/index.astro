---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import Hero from '../components/Hero.astro';
import Highlights from '../components/Highlights.astro';
import Casa from '../components/Casa.astro';
import Carta from '../components/Carta.astro';
import Galeria from '../components/Galeria.astro';
import Opiniones from '../components/Opiniones.astro';
import Visitanos from '../components/Visitanos.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Fab from '../components/Fab.astro';
import { breadcrumbs, faqSchema } from '../data/schema';
---

<Layout
	title="La Alacena · Bar restaurante en Onda | Menú del día, bocadillos y brasa"
	description="La Alacena, bar restaurante en el centro de Onda (Castellón). Desayunos desde las 8:00, almuerzos de mostrador, menú del día de lunes a viernes y carnes a la brasa. Carrer Isidoro Peris 18. Tel. 964 84 69 49."
	path="/"
	schema={[faqSchema, breadcrumbs([{ name: 'Inicio', path: '/' }])]}
>
	<Topbar />
	<main id="contenido">
		<Hero />
		<Highlights />
		<Casa />
		<Carta />
		<Galeria />
		<Opiniones />
		<Visitanos />
		<Faq />
	</main>
	<Footer />
	<Fab />
</Layout>
