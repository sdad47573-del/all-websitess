---
import { Image } from 'astro:assets';
import { BUSINESS, GALLERY } from '../data/site';
---

<section id="galeria" class="bg-base-100 relative overflow-hidden py-20 sm:py-24">
	<div class="shelves pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="label text-secondary">— Galería</p>
				<h2
					class="font-display mt-3 text-4xl leading-[0.98] font-semibold tracking-[-0.02em] sm:text-5xl"
				>
					La mesa, el comedor<br />
					<span class="text-primary italic">y la brasa</span>
				</h2>
			</div>
			<p class="text-base-content/60 max-w-xs text-sm leading-relaxed">
				Fotos de la ficha pública de Google Maps: el comedor, los bocadillos y lo que sale de
				la parrilla.
			</p>
		</div>

		<div class="mt-10 columns-2 gap-3 sm:gap-4 lg:columns-3">
			{GALLERY.map((foto, index) => (
				<figure class="group relative mb-3 break-inside-avoid overflow-hidden rounded-xl border border-base-300 bg-base-200 sm:mb-4">
					<Image
						src={foto.src}
						alt={foto.alt}
						widths={[360, 560, 820, 1100]}
						sizes="(min-width: 1024px) 31vw, (min-width: 640px) 48vw, 48vw"
						quality={80}
						loading="lazy"
						class="h-auto w-full transition-transform duration-700 group-hover:scale-[1.03]"
					/>
					<div
						class="from-neutral/80 pointer-events-none absolute inset-0 bg-gradient-to-t via-transparent to-transparent opacity-75 transition-opacity group-hover:opacity-90"
						aria-hidden="true"
					></div>
					<figcaption class="absolute right-3 bottom-3 left-3 flex items-end justify-between gap-3 text-white">
						<span class="text-[0.7rem] font-medium tracking-wide">{foto.caption}</span>
						<span class="font-display text-[0.65rem] text-white/50 italic">
							{String(index + 1).padStart(2, '0')}
						</span>
					</figcaption>
				</figure>
			))}
		</div>

		<p class="label text-base-content/40 mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.5rem]">
			<i class="ri-google-fill" aria-hidden="true"></i>
			Imágenes de la ficha de {BUSINESS.name}. Si eres el titular y quieres retirarlas, avísanos.
		</p>
	</div>
</section>
