---
import { BUSINESS } from '../data/site';
---

<section id="visitanos" class="bg-base-100 relative overflow-hidden py-20 sm:py-24">
	<div class="shelves pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
			<div>
				<p class="label text-secondary">— Visítanos</p>
				<h2
					class="font-display mt-3 text-4xl leading-[0.98] font-semibold tracking-[-0.02em] sm:text-5xl"
				>
					En el centro<br />
					<span class="text-primary italic">de Onda</span>
				</h2>
				<p class="text-base-content/65 mt-5 max-w-md leading-relaxed">
					En el Carrer Isidoro Peris, 18, a un paso del centro. Abrimos de lunes a sábado para
					desayunar, almorzar y comer; los domingos descansamos.
				</p>

				<div class="mt-8 grid gap-4 sm:grid-cols-2">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="border-base-300 bg-base-100 hover:border-primary rounded-box flex items-start gap-4 border p-4 transition-colors"
					>
						<span class="bg-primary/8 text-primary flex size-10 shrink-0 items-center justify-center rounded-full">
							<i class="ri-map-pin-2-line text-lg" aria-hidden="true"></i>
						</span>
						<span>
							<span class="label text-base-content/40 text-[0.5rem]">Dirección</span>
							<span class="mt-1 block text-sm font-semibold">{BUSINESS.street}</span>
							<span class="text-base-content/60 block text-xs">
								{BUSINESS.postalCode} {BUSINESS.city}
							</span>
							<span class="text-base-content/45 block text-xs">{BUSINESS.region}</span>
						</span>
					</a>

					<a
						href={BUSINESS.phoneHref}
						class="border-base-300 bg-base-100 hover:border-primary rounded-box flex items-start gap-4 border p-4 transition-colors"
					>
						<span class="bg-primary/8 text-primary flex size-10 shrink-0 items-center justify-center rounded-full">
							<i class="ri-phone-line text-lg" aria-hidden="true"></i>
						</span>
						<span>
							<span class="label text-base-content/40 text-[0.5rem]">Teléfono</span>
							<span class="mt-1 block text-sm font-semibold">{BUSINESS.phone}</span>
							<span class="text-base-content/60 block text-xs">Menú, mesas y grupos</span>
						</span>
					</a>

					<div class="border-base-300 bg-base-100 rounded-box flex items-start gap-4 border p-4 sm:col-span-2">
						<span class="bg-primary/8 text-primary flex size-10 shrink-0 items-center justify-center rounded-full">
							<i class="ri-wheelchair-line text-lg" aria-hidden="true"></i>
						</span>
						<span>
							<span class="label text-base-content/40 text-[0.5rem]">Accesibilidad</span>
							<span class="mt-1 block text-sm font-semibold">
								Acceso, aseo y asientos adaptados
							</span>
							<span class="text-base-content/45 block text-xs">Según la ficha de Google</span>
						</span>
					</div>
				</div>

				<div class="border-base-300 bg-base-100 rounded-box mt-4 border">
					<h3 class="border-base-300 flex items-center gap-2 border-b px-5 py-4">
						<i class="ri-time-line text-secondary text-lg" aria-hidden="true"></i>
						<span class="label text-[0.55rem]">Horario</span>
					</h3>
					<ul class="divide-base-200 divide-y px-5 py-1">
						{BUSINESS.hours.map((row) => (
							<li class="flex items-center justify-between gap-4 py-2.5 text-sm">
								<span class="font-medium">{row.days}</span>
								<span
									class={row.hours === 'Cerrado' ? 'text-base-content/35 text-sm' : 'text-base-content/70 text-sm'}
								>
									{row.hours}
								</span>
							</li>
						))}
					</ul>
					<p class="text-base-content/45 px-5 pt-1 pb-4 text-xs leading-relaxed">
						{BUSINESS.hoursNote}
					</p>
				</div>

				<a
					href={BUSINESS.googleMaps}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-primary btn-block mt-4 h-12 gap-2 rounded-full text-sm font-semibold"
				>
					<i class="ri-route-line text-lg" aria-hidden="true"></i> Abrir ruta en Google Maps
				</a>
			</div>

			<div class="flex flex-col gap-4">
				<div class="border-base-300 bg-base-200 min-h-[26rem] flex-1 overflow-hidden rounded-box border">
					<iframe
						title={`Mapa de ${BUSINESS.name} en ${BUSINESS.city}`}
						src={BUSINESS.googleMapsEmbed}
						width="100%"
						height="100%"
						class="min-h-[26rem] w-full"
						style="border:0"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
				</div>

				<div class="border-base-300 bg-base-100 rounded-box grid grid-cols-2 gap-px border">
					<div class="p-5">
						<p class="label text-base-content/40 text-[0.5rem]">Menú del día</p>
						<p class="font-display mt-1.5 text-xl font-semibold">Lunes a viernes</p>
						<p class="text-base-content/55 mt-1 text-xs leading-relaxed">
							El sábado, carta de la casa.
						</p>
					</div>
					<div class="border-base-300 border-l p-5">
						<p class="label text-base-content/40 text-[0.5rem]">Plus Code</p>
						<p class="font-display mt-1.5 text-xl font-semibold">{BUSINESS.plusCode}</p>
						<p class="text-base-content/55 mt-1 text-xs leading-relaxed">
							{BUSINESS.landmark}
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
