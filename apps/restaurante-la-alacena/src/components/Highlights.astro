---
import { HIGHLIGHTS } from '../data/site';
---

<section class="bg-base-200 border-base-300 border-y py-12 sm:py-16" aria-label="Lo que hay en La Alacena">
	<div class="mx-auto grid max-w-7xl gap-4 px-4 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">
		{HIGHLIGHTS.map((item) => (
			<article class="bg-base-100 border-base-300 rounded-box border p-6">
				<span class="bg-primary/8 text-primary flex size-11 items-center justify-center rounded-full">
					<i class={`${item.icon} text-xl`} aria-hidden="true" />
				</span>
				<h2 class="font-display mt-4 text-2xl font-semibold">{item.title}</h2>
				<p class="text-base-content/65 mt-2 text-sm leading-relaxed">{item.text}</p>
			</article>
		))}
	</div>
</section>
