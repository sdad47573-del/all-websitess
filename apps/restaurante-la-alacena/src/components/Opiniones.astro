---
import { BUSINESS, REVIEWS } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
---

<section id="opiniones" class="bg-base-200 border-base-300 border-y py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
			<div>
				<p class="label text-secondary">— Opiniones</p>
				<h2
					class="font-display mt-3 text-4xl leading-[0.98] font-semibold tracking-[-0.02em] sm:text-5xl"
				>
					Lo que se cuenta<br />
					<span class="text-primary italic">de La Alacena</span>
				</h2>
				<p class="text-base-content/60 mt-5 max-w-sm text-sm leading-relaxed">
					Los bocadillos, la brasa y el menú del día son los protagonistas de las reseñas.
				</p>

				<div class="border-base-300 bg-base-100 rounded-box mt-7 border p-6">
					<div class="flex items-end gap-4">
						<span class="font-display text-6xl leading-none font-semibold">
							{BUSINESS.rating.toString().replace('.', ',')}
						</span>
						<div class="pb-1">
							<div class="text-accent-content text-base tracking-tight" aria-hidden="true">
								{estrellas.map((n) => (
									<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
								))}
							</div>
							<p class="text-base-content/55 mt-1 text-xs">
								{BUSINESS.reviewCount} reseñas en Google Maps
							</p>
						</div>
					</div>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline btn-sm border-base-300 hover:border-primary hover:bg-primary hover:text-primary-content mt-5 h-10 w-full gap-2 rounded-full text-[0.68rem] font-semibold"
					>
						<i class="ri-google-fill" aria-hidden="true"></i> Leer todas las reseñas
					</a>
					<p class="label text-base-content/40 mt-3 text-center text-[0.5rem]">
						Valoración de Google · octubre de 2026
					</p>
				</div>
			</div>

			<div class="grid gap-4 sm:grid-cols-2">
				{REVIEWS.map((resena, index) => (
					<blockquote
						class={`border-base-300 bg-base-100 relative flex flex-col rounded-box border p-6 ${
							index === 0 ? 'sm:col-span-2 sm:p-8' : ''
						}`}
					>
						<span
							class="font-display text-base-300 pointer-events-none absolute top-2 right-6 text-7xl leading-none select-none"
							aria-hidden="true"
						>
							”
						</span>
						<div
							class="text-accent-content relative flex gap-1 text-[0.65rem] tracking-tight"
							role="img"
							aria-label={`${resena.rating} de 5 estrellas`}
						>
							{Array.from({ length: resena.rating }).map(() => (
								<i class="ri-star-fill" />
							))}
						</div>
						<p
							class={`font-display relative mt-3 flex-1 leading-snug ${
								index === 0 ? 'text-2xl sm:text-3xl' : 'text-xl'
							}`}
						>
							«{resena.text}»
						</p>
						<footer class="border-base-300 mt-5 flex items-center gap-3 border-t pt-3">
							<span class="bg-primary text-primary-content flex size-7 items-center justify-center rounded-full text-[0.62rem] font-bold">
								{resena.source === 'Google' ? 'G' : 'T'}
							</span>
							<span class="label text-base-content/55 text-[0.5rem]">Reseña en {resena.source}</span>
							<span class="label text-base-content/30 ml-auto text-[0.48rem]">{resena.source}</span>
						</footer>
					</blockquote>
				))}
			</div>
		</div>
	</div>
</section>
