---
import { BUSINESS, NAV } from '../data/site';

interface Props {
	base?: string;
}

const { base = '' } = Astro.props;
---

<div class="border-base-300 bg-base-100/95 sticky top-0 z-50 border-b backdrop-blur-md">
	<header
		class="mx-auto flex h-[4.75rem] max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
	>
		<a href={`${base}#inicio`} class="flex items-center gap-3" aria-label={BUSINESS.name}>
			<span
				class="bg-primary text-primary-content font-display flex size-11 shrink-0 items-center justify-center rounded-full text-2xl font-bold italic"
				aria-hidden="true"
			>
				A
			</span>
			<span class="leading-none">
				<span class="font-display block text-2xl font-semibold tracking-[-0.02em]">
					La Alacena
				</span>
				<span class="label text-base-content/50 mt-1.5 block text-[0.55rem]">
					Onda · Castellón
				</span>
			</span>
		</a>

		<nav class="hidden items-center gap-6 lg:flex" aria-label="Navegación principal">
			{NAV.map((item) => (
				<a
					href={`${base}${item.href}`}
					class="text-base-content/70 hover:text-secondary label text-[0.6rem] transition-colors"
				>
					{item.label}
				</a>
			))}
		</nav>

		<div class="flex items-center gap-2">
			<a
				href={BUSINESS.phoneHref}
				class="text-base-content/70 hover:text-primary hidden items-center gap-2 text-sm font-medium transition-colors sm:inline-flex"
			>
				<i class="ri-phone-line text-base" aria-hidden="true"></i>
				{BUSINESS.phone}
			</a>
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-primary btn-sm h-10 gap-2 rounded-full px-4 text-[0.7rem] font-semibold uppercase tracking-[0.08em]"
			>
				<i class="ri-route-line text-base" aria-hidden="true"></i>
				<span class="hidden sm:inline">Cómo llegar</span>
				<span class="sm:hidden">Ruta</span>
			</a>
			<details class="dropdown dropdown-end lg:hidden">
				<summary class="btn btn-ghost btn-sm h-10 rounded-full" aria-label="Abrir menú">
					<i class="ri-menu-line text-xl" aria-hidden="true"></i>
				</summary>
				<ul class="menu dropdown-content border-base-300 bg-base-100 rounded-box z-50 mt-2 w-64 border p-2 shadow-xl">
					{NAV.map((item) => (
						<li>
							<a href={`${base}${item.href}`}>{item.label}</a>
						</li>
					))}
					<li>
						<a href={`${base}aviso-legal`}>Aviso legal y privacidad</a>
					</li>
					<li>
						<a href={BUSINESS.phoneHref}>
							<i class="ri-phone-line" aria-hidden="true"></i> {BUSINESS.phone}
						</a>
					</li>
				</ul>
			</details>
		</div>
	</header>
</div>
