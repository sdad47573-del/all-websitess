---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import interior from '../assets/fotos/canadu-artesanos-apaisada-01.jpg';
import vitrina from '../assets/fotos/canadu-artesanos-vertical-02.jpg';
import bollos from '../assets/fotos/canadu-artesanos-vertical-03.jpg';
import tarta from '../assets/fotos/canadu-artesanos-vertical-05.jpg';
import fachada from '../assets/fotos/canadu-artesanos-vertical-06.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Cañadú Artesanos · Panadería en Poniente Sur, Córdoba';
const description =
	'Panadería Cañadú Artesanos en la Plaza Cardenal Cisneros, Poniente Sur (14005 Córdoba). Pan, bollería, pasteles y tartas. De lunes a viernes de 8:00 a 15:00.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#canadu`,
	name: BUSINESS.name,
	alternateName: ['Cañadú', 'Panadería Cañadú', 'Cañadú Artesanos Córdoba'],
	description:
		'Panadería en Poniente Sur (14005 Córdoba). Pan, bollería, pasteles y tartas, con encargos de tartas con dedicatoria.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34614281514',
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '08:30',
			closes: '14:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: vitrina,
		alt: 'Vitrina de Cañadú Artesanos con tartas, donuts bañados y bollos, con cartelitos escritos a mano',
	},
	{
		src: tarta,
		alt: 'Tarta con el nombre «Lauri» escrito a mano y una rosa de azúcar, en una bandeja de papel',
	},
	{
		src: bollos,
		alt: 'Bandeja de bollos rellenos de nata con trozos de fresa y kiwi, en la vitrina del local',
	},
	{
		src: fachada,
		alt: 'Fachada de Cañadú Artesanos en la Plaza Cardenal Cisneros, vista desde arriba',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#26424f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Source+Sans+3:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Cañadú Artesanos, panadería Córdoba, panadería Poniente Sur, pastelería Córdoba, tartas por encargo Córdoba, 14005"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan, bollería, pasteles y tartas en la Plaza Cardenal Cisneros, Poniente Sur (14005 Córdoba). De lunes a viernes de 8:00 a 15:00. 4,7 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Vitrina de Cañadú Artesanos con tartas y bollería"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#26424f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[interior]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Panadería · Pastelería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Poniente Sur · 14005 Córdoba"
				title="Pan, bollería <br /><em>y tartas con nombre.</em>"
				lede={`Cañadú Artesanos está en la Plaza Cardenal Cisneros, en Poniente Sur, con el rótulo «Cañadú artesanos» sobre la puerta. Dentro hay vitrinas con tartas, donuts bañados y bollos rellenos de nata, y bandejas de pan. Abre de lunes a viernes de 8:00 a 15:00 y los sábados de 8:30 a 14:30. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={interior}
				imageAlt="Mostrador de Cañadú Artesanos con la vitrina de bollería y tartas, el expositor de pan y las estanterías de productos envasados"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,7</b> en Google · 102 reseñas' },
					{ label: 'Horario', html: '<b>L–V</b> 8:00–15:00 · <b>S</b> 8:30–14:30' },
					{ label: 'Zona', html: '<b>Poniente Sur</b> · 14005' },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Pan · bollería · tartas"
			/>

			<LocalChips label="Lo que hay en Cañadú" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una panadería <br /><em>de barrio.</em>"
				paragraphs={[
					'Cañadú Artesanos está en la Plaza Cardenal Cisneros, en Poniente Sur, en el 14005 de Córdoba. El rótulo «Cañadú artesanos» preside la fachada, en la esquina del edificio amarillo.',
					'Dentro, el local es tienda y obrador: una vitrina larga con tartas, donuts bañados, bollos y bollería pequeña, un expositor con bandejas de pan y estanterías con productos envasados y bebidas.',
					'En las fotos del perfil se ven tartas de nata y de fruta, bollos coronados con nata y trozos de fresa y kiwi, y tartas escritas a mano con el nombre: «Felicidades Lauri», «¡Felicidades! mamá». Una reseña destaca «los pasteles y el pan», otra «la bollería pequeña» y otra cuenta que «atienden encargos con formalidad».',
					'Abre de lunes a viernes de 8:00 a 15:00 y los sábados de 8:30 a 14:30; los domingos cierra. La ficha publica el teléfono y la dirección, pero no web propia, redes, carta ni precios.',
				]}
				note="La ficha de Google solo publica la categoría «Panadería», un teléfono y la dirección. El mostrador de esta página recoge lo que muestran las fotos del perfil y lo que cuentan las reseñas, sin importes."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Llamar al 614 28 15 14', href: BUSINESS.phoneHref },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Pan, vitrina <br />
							<em>y encargos.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que hay <br /><em>en la vitrina.</em>"
				description="Sin carta ni precios publicados: esto es lo que muestran las fotos del local y lo que cuentan las reseñas de Google."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={MENU_GROUPS}
				note="Los cartelitos de la vitrina llevan precios escritos a mano, pero cambian: esta web no los repite. El surtido se agota a lo largo de la mañana, así que conviene ir temprano."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La casa, <br /><em>por dentro.</em>"
				description="Cuatro fotos de la ficha de Google Maps: la vitrina, dos de las tartas y la fachada del local."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la Plaza <br /><em>Cardenal Cisneros.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de Cañadú Artesanos en la Plaza Cardenal Cisneros, Córdoba"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Cañadú Artesanos · Poniente Sur"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
				]}
				contactLink={{ label: 'Abrir en Google Maps ↗', href: MAPS.place, external: true }}
				reserveNote="El teléfono de la ficha es el 614 28 15 14. No publica web propia ni redes. Indica acceso para sillas de ruedas y que no hay aparcamiento adaptado; no informa sobre el mostrador ni el aseo. Para encargos de tartas, conviene llamar con antelación."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Ver en Google Maps"
			navAriaLabel="Enlaces de Cañadú Artesanos"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
