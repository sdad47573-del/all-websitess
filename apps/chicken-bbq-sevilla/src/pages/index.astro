---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/chicken-bbq-sevilla-apaisada-01.jpg';
import parrilla from '../assets/fotos/chicken-bbq-sevilla-apaisada-03.jpg';
import pinchos from '../assets/fotos/chicken-bbq-sevilla-apaisada-04.jpg';
import brasas from '../assets/fotos/chicken-bbq-sevilla-cuadrada-02.jpg';
import polloTroceado from '../assets/fotos/chicken-bbq-sevilla-vertical-06.jpg';
import patatas from '../assets/fotos/chicken-bbq-sevilla-vertical-05.jpg';
import bandeja from '../assets/fotos/chicken-bbq-sevilla-vertical-09.jpg';
import arroz from '../assets/fotos/chicken-bbq-sevilla-vertical-10.jpg';
import interior from '../assets/fotos/chicken-bbq-sevilla-panoramica-07.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, REVIEWS, SERVICIOS } from '../data/site';

const title = 'Chicken BBQ Sevilla · Pollo a la brasa en Los Bermejales';
const description = BUSINESS.description;

const galeria = [
	{
		src: parrilla,
		alt: 'Primer plano de pollos dorándose en la parrilla metálica del asador',
	},
	{
		src: pinchos,
		alt: 'Cuatro pinchos de pollo en sus jaulas metálicas girando sobre la brasa, con humo',
	},
	{
		src: brasas,
		alt: 'Jaulas de pollos sobre las brasas encendidas de leña en la parrilla del local',
	},
	{
		src: polloTroceado,
		alt: 'Pollo asado troceado en un bol, con la piel tostada por el carbón',
	},
	{
		src: patatas,
		alt: 'Ración de patatas fritas servida en un cucurucho de papel de periódico',
	},
	{
		src: bandeja,
		alt: 'Bandeja de patatas con salsa aparte, una cerveza Cruzcampo y una servilleta sobre la mesa',
	},
	{
		src: arroz,
		alt: 'Arroz blanco con perejil recién hecho en la paella, con la cuchara de madera',
	},
	{
		src: interior,
		alt: 'Interior del local con la barra de madera, los taburetes rojos y la cocina al fondo',
	},
];

const carta = [
	{
		title: 'Del asador',
		items: [
			{ name: 'Pollo a la brasa', note: 'la especialidad, hecha a la leña de encinas' },
			{ name: 'Pollo al carbón', note: 'el nombre que anuncia el rótulo de la fachada' },
			{ name: 'Costillas y parrilla', note: 'Google lo clasifica como parrilla y barbacoa' },
		],
	},
	{
		title: 'Para acompañar',
		items: [
			{ name: 'Patatas', note: 'fritas en cucurucho o en bandeja con salsa aparte, según las fotos' },
			{ name: 'Arroz', note: 'blanco con perejil, recién hecho en la paella' },
			{ name: 'Salsa picante', note: 'la que una reseña destacada llama buenísima' },
		],
	},
	{
		title: 'Para llevar',
		items: [
			{ name: 'Recogida en el local', note: 'una reseña habla de recoger pedidos telefónicos' },
			{ name: 'Comida a domicilio', note: 'categoría que declara la ficha de Google' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#chicken-bbq`,
	name: BUSINESS.name,
	alternateName: ['Chicken BBQ Sevilla', 'Chicken BBQ Los Bermejales', 'Pollo a la Brasa Los Bermejales'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Barbacoa', 'Pollo asado', 'Parrilla'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Los Bermejales, Sevilla' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Monday',
			opens: '10:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#12100e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,500;0,700;0,800;1,700&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Chicken BBQ Sevilla, pollo a la brasa Los Bermejales, pollo al carbón Sevilla, avenida de Alemania 19, parrilla 41012, barbacoa Sevilla, pollo para llevar Bermejales, comida a domicilio 41012"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado a la leña de encinas en la avenida de Alemania 19, Los Bermejales. Todos los días de 11:00 a 16:00, lunes desde las 10:00. Pedidos en el 955 38 61 30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Chicken BBQ Sevilla con el rótulo de pollo al carbón y el teléfono de pedidos"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#12100e"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Los Bermejales, Sevilla"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Chicken BBQ"
			subtitle="Pollo a la brasa · Los Bermejales"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.neighbourhood} · ${BUSINESS.city}`}
				title="Pollo a la brasa, <br /><em>leña de encina.</em>"
				lede="Chicken BBQ Sevilla está en la avenida de Alemania 19, en Los Bermejales. El negocio lo resume en su ficha: «Pollo a la Brasa. Productos frescos hechos a la leña de encinas». Abre solo para comer, de 11:00 a 16:00 de martes a domingo y desde las 10:00 los lunes, y los pedidos se hacen en el 955 38 61 30."
				image={fachada}
				imageAlt="Fachada de Chicken BBQ Sevilla con el rótulo rojo de pollo al carbón y el teléfono de pedidos en la avenida de Alemania"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>3,8</b> en Google · 135 reseñas' },
					{ label: 'Horario', html: '<b>11:00–16:00</b><br />Lunes desde las 10:00 · sin cenas' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> pedidos y consultas` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Chicken BBQ Sevilla" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Carbón, encina <br /><em>y brasa viva.</em>"
				paragraphs={[
					'Chicken BBQ Sevilla está en la avenida de Alemania 19, en Los Bermejales, con el rótulo de pollo al carbón sobre la puerta y la cocina a la vista: barra de madera, taburetes rojos y el asador al fondo, según las fotos de su perfil.',
					'El negocio lo cuenta en una línea en su ficha: «Pollo a la Brasa. Productos frescos hechos a la leña de encinas». No es un horno eléctrico: los pollos van ensartados en jaulas metálicas girando sobre la brasa, como se ve en las fotografías del local.',
					'El horario es solo de comidas. De 11:00 a 16:00 de martes a domingo, y los lunes desde las 10:00. No hay cena ni cierre a mediodía, así que el pollo se sirve del mediodía a media tarde.',
					'Google lo clasifica además como parrilla, restaurante de barbacoa, pollería y especialista en costillas, y lo marca como comida a domicilio. Las reseñas que la ficha destaca hablan del pollo, las patatas, el arroz y la salsa picante, y de la formalidad al recoger pedidos por teléfono.',
				]}
				note="La ficha no publica carta con precios ni web propia, y el reparto se gestiona por teléfono. Los productos de esta página salen de la descripción del negocio, de las categorías de Google y de las reseñas; no hay importes que mostrar sin inventarlos."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Pollo, patatas <br /><em>y arroz.</em>"
				description="Sin precios publicados en la ficha, así que aquí va lo que el negocio declara y lo que repiten las reseñas que Google destaca."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={carta}
				note="Esta lista sale de la descripción del negocio, de las categorías con las que Google lo clasifica y de las reseñas destacadas. No hay carta ni precios públicos: se confirman en el mostrador o llamando al 955 38 61 30."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
					<div class="reviews-head">
						<h2 id="resenas-title">El pollo, las patatas <br /><em>y la salsa.</em></h2>
						<p>
							La ficha tiene 135 reseñas y una media de 3,8. Estas son tres de las que Google destaca, con
							la puntuación que les dio su autor.
						</p>
					</div>
					<div class="review-grid">
						{
							REVIEWS.map((review) => (
								<figure class="review-card">
									<p class="review-stars" aria-label={`${review.rating} sobre 5`}>
										{'★'.repeat(review.rating)}
										<span aria-hidden="true">{'★'.repeat(5 - review.rating)}</span>
									</p>
									<blockquote>{review.quote}</blockquote>
									<figcaption>Reseña publicada en Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="review-note">
						Citas de las reseñas públicas del local, con la puntuación del autor y la puntuación del
						texto normalizada. En la ficha de Google están todas, incluidas las críticas.
					</p>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Ocho fotos <br /><em>del asador.</em>"
				description="Del perfil del local: la parrilla con los pollos girando sobre la brasa, el pollo ya troceado, las patatas y el arroz, y el interior con la barra."
				images={galeria}
				cta={{ label: 'Ver todas en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.neighbourhood}`}
				title="Ven a <br /><em>Los Bermejales.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'España']}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: solo comidas, de 11:00 a 16:00 de martes a domingo y desde las 10:00 los lunes. No hay servicio de cenas. En festivos puede cambiar; llama antes si vas en día señalado."
				mapTitle="Mapa de Chicken BBQ Sevilla en la avenida de Alemania 19, Los Bermejales"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Chicken BBQ"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Pedidos: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="Los pedidos se hacen por teléfono, y una de las reseñas destaca la formalidad al recogerlos. La ficha también lo marca como comida a domicilio, pero no enlaza ninguna plataforma de reparto, así que confirma zona y horario al llamar. Esta página no tramita pedidos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Chicken BBQ Sevilla"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías tomados de la ficha y del perfil públicos del local en Google Maps. Sin carta de precios publicada: confirma horario, reparto y disponibilidad antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Chicken BBQ Sevilla"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
