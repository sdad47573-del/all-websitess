---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/chicken-bbq-sevilla-apaisada-01.jpg';
import parrilla from '../assets/fotos/chicken-bbq-sevilla-apaisada-03.jpg';
import pinchos from '../assets/fotos/chicken-bbq-sevilla-apaisada-04.jpg';
import brasas from '../assets/fotos/chicken-bbq-sevilla-cuadrada-02.jpg';
import polloTroceado from '../assets/fotos/chicken-bbq-sevilla-vertical-06.jpg';
import patatas from '../assets/fotos/chicken-bbq-sevilla-vertical-05.jpg';
import bandeja from '../assets/fotos/chicken-bbq-sevilla-vertical-09.jpg';
import arroz from '../assets/fotos/chicken-bbq-sevilla-vertical-10.jpg';
import interior from '../assets/fotos/chicken-bbq-sevilla-panoramica-07.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'Chicken BBQ Sevilla · Pollo a la brasa en Los Bermejales';
const description = BUSINESS.description;

const galeria = [
	{
		src: parrilla,
		alt: 'Primer plano de pollos dorándose en la parrilla metálica del asador',
	},
	{
		src: pinchos,
		alt: 'Cuatro pinchos de pollo en sus jaulas metálicas girando sobre la brasa, con humo',
	},
	{
		src: brasas,
		alt: 'Jaulas de pollos sobre las brasas encendidas de leña en la parrilla del local',
	},
	{
		src: polloTroceado,
		alt: 'Pollo asado troceado en un bol, con la piel tostada por el carbón',
	},
	{
		src: patatas,
		alt: 'Ración de patatas fritas servida en un cucurucho de papel de periódico',
	},
	{
		src: bandeja,
		alt: 'Bandeja de patatas con salsa aparte, una cerveza Cruzcampo y una servilleta sobre la mesa',
	},
	{
		src: arroz,
		alt: 'Arroz blanco con perejil recién hecho en la paella, con la cuchara de madera',
	},
	{
		src: interior,
		alt: 'Interior del local con la barra de madera, los taburetes rojos y la cocina al fondo',
	},
];

const carta = [
	{
		title: 'Del asador',
		items: [
			{ name: 'Pollo a la brasa', note: 'la especialidad, hecha a la leña de encinas' },
			{ name: 'Pollo al carbón', note: 'el nombre que anuncia el rótulo de la fachada' },
			{ name: 'Costillas y parrilla', note: 'Google lo clasifica como parrilla y barbacoa' },
		],
	},
	{
		title: 'Para acompañar',
		items: [
			{ name: 'Patatas', note: 'fritas en cucurucho o en bandeja con salsa aparte, según las fotos' },
			{ name: 'Arroz', note: 'blanco con perejil, recién hecho en la paella' },
			{ name: 'Salsa picante', note: 'la que una reseña destacada llama buenísima' },
		],
	},
	{
		title: 'Para llevar',
		items: [
			{ name: 'Recogida en el local', note: 'una reseña habla de recoger pedidos telefónicos' },
			{ name: 'Comida a domicilio', note: 'categoría que declara la ficha de Google' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#chicken-bbq`,
	name: BUSINESS.name,
	alternateName: ['Chicken BBQ Sevilla', 'Chicken BBQ Los Bermejales', 'Pollo a la Brasa Los Bermejales'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Barbacoa', 'Pollo asado', 'Parrilla'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Los Bermejales, Sevilla' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Monday',
			opens: '10:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"chicken-bbq-sevilla-apaisada-01.jpg": fachada,
	"chicken-bbq-sevilla-apaisada-03.jpg": parrilla,
	"chicken-bbq-sevilla-apaisada-04.jpg": pinchos,
	"chicken-bbq-sevilla-cuadrada-02.jpg": brasas,
	"chicken-bbq-sevilla-vertical-06.jpg": polloTroceado,
	"chicken-bbq-sevilla-vertical-05.jpg": patatas,
	"chicken-bbq-sevilla-vertical-09.jpg": bandeja,
	"chicken-bbq-sevilla-vertical-10.jpg": arroz,
	"chicken-bbq-sevilla-panoramica-07.jpg": interior,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#12100e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,500;0,700;0,800;1,700&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Chicken BBQ Sevilla, pollo a la brasa Los Bermejales, pollo al carbón Sevilla, avenida de Alemania 19, parrilla 41012, barbacoa Sevilla, pollo para llevar Bermejales, comida a domicilio 41012"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado a la leña de encinas en la avenida de Alemania 19, Los Bermejales. Todos los días de 11:00 a 16:00, lunes desde las 10:00. Pedidos en el 955 38 61 30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Chicken BBQ Sevilla con el rótulo de pollo al carbón y el teléfono de pedidos"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#12100e"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Los Bermejales, Sevilla"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Chicken BBQ"
			subtitle="Pollo a la brasa · Los Bermejales"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Chicken BBQ Sevilla"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías tomados de la ficha y del perfil públicos del local en Google Maps. Sin carta de precios publicada: confirma horario, reparto y disponibilidad antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Chicken BBQ Sevilla"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
