---
import { Image } from 'astro:assets';
import { GALLERY } from '../data/site';

const fotos = GALLERY.slice(0, 8);
---

<section id="galeria" class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="text-secondary text-xs font-semibold tracking-[0.22em] uppercase">Galería</p>
				<h2 class="font-display mt-3 text-4xl font-semibold text-primary sm:text-5xl">
					Así es el Mesón Emigrante
				</h2>
			</div>
			<p class="text-base-content/60 max-w-sm text-sm">
				Fotos de la casa y de la mesa, sacadas de la ficha de Google del restaurante.
			</p>
		</div>

		<div class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
			{
				fotos.map((foto) => (
					<figure class="overflow-hidden rounded-xl">
						<Image
							src={foto.src}
							alt={foto.alt}
							widths={[280, 460, 640]}
							sizes="(min-width: 1024px) 24vw, 46vw"
							quality={78}
							loading="lazy"
							class="foto-calida aspect-[3/4] w-full object-cover transition-transform duration-500 hover:scale-105"
						/>
					</figure>
				))
			}
		</div>
	</div>
</section>
