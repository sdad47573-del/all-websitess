---
import { BUSINESS, NAV, SUR_DIGITAL_URL } from '../data/site';

interface Props {
	base?: string;
}

const { base = '' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-neutral text-white">
	<div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
		<div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
			<div class="lg:col-span-2">
				<p class="font-display text-2xl font-semibold">Mesón Emigrante</p>
				<p class="text-accent mt-1 text-xs font-semibold tracking-[0.2em] uppercase">
					Cocina casera extremeña · Zarza de Granadilla
				</p>
				<p class="mt-4 max-w-sm text-sm leading-relaxed text-white/65">
					Menús diarios, raciones generosas y carnes a la parrilla en un mesón de los de siempre,
					en el Valle del Ambroz.
				</p>
				<div class="text-accent mt-5 flex items-center gap-2 text-sm">
					<i class="ri-star-fill"></i>
					<span class="font-bold text-white">{BUSINESS.rating.toString().replace('.', ',')}</span>
					<span class="text-white/50">
						· {BUSINESS.reviewCount.toLocaleString('es-ES')} reseñas en Google
					</span>
				</div>
				<div class="mt-4 flex items-center gap-3">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="text-white/60 transition-colors hover:text-white"
						aria-label="Ficha de Google del Mesón Emigrante"
					>
						<i class="ri-google-fill text-lg"></i>
					</a>
					<a
						href={BUSINESS.social.facebook}
						target="_blank"
						rel="noopener noreferrer"
						class="text-white/60 transition-colors hover:text-white"
						aria-label="Facebook del Mesón Emigrante"
					>
						<i class="ri-facebook-circle-fill text-lg"></i>
					</a>
					<a
						href={BUSINESS.phoneHref}
						class="text-white/60 transition-colors hover:text-white"
						aria-label="Llamar al Mesón Emigrante"
					>
						<i class="ri-phone-line text-lg"></i>
					</a>
				</div>
			</div>

			<div>
				<h2 class="text-xs font-semibold tracking-[0.2em] text-white/45 uppercase">La casa</h2>
				<ul class="mt-4 space-y-2 text-sm">
					{NAV.map((item) => (
						<li>
							<a
								href={`${base}${item.href}`}
								class="text-white/75 transition-colors hover:text-white"
							>
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<div>
				<h2 class="text-xs font-semibold tracking-[0.2em] text-white/45 uppercase">Contacto</h2>
				<ul class="mt-4 space-y-3 text-sm">
					<li class="flex gap-2">
						<i class="ri-map-pin-line text-accent mt-0.5"></i>
						<a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="text-white/75 transition-colors hover:text-white"
						>
							{BUSINESS.street}
							<br />
							{BUSINESS.postalCode} {BUSINESS.city}
						</a>
					</li>
					<li class="flex gap-2">
						<i class="ri-phone-line text-accent mt-0.5"></i>
						<a href={BUSINESS.phoneHref} class="text-white/75 transition-colors hover:text-white">
							{BUSINESS.phone}
						</a>
					</li>
					<li class="flex gap-2">
						<i class="ri-time-line text-accent mt-0.5"></i>
						<span class="text-white/75">
							Viernes a domingo · 13:00 – 23:30
							<br />
							Lunes a jueves · cerrado
						</span>
					</li>
				</ul>
			</div>
		</div>

		<div
			class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-white/45 sm:flex-row sm:items-center sm:justify-between"
		>
			<p>© {year} Mesón Emigrante · Zarza de Granadilla</p>
			<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
				<a href={`${base}aviso-legal`} class="transition-colors hover:text-white">
					Aviso legal y privacidad
				</a> <a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a> 
				<span class="hidden text-white/20 sm:inline">|</span>
				<p>
					Creado por Sur Digital ·
					<a
						href={SUR_DIGITAL_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-accent font-semibold text-white underline decoration-white/30 underline-offset-2 transition-colors"
					>
						sur-digital.vercel.app
					</a>
				</p>
			</div>
		</div>
	</div>
</footer>
