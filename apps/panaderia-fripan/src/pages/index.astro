---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import mesa from '../assets/fotos/panaderia-fripan-vertical-07.jpg';
import vitrina from '../assets/fotos/panaderia-fripan-vertical-01.jpg';
import rosas from '../assets/fotos/panaderia-fripan-vertical-02.jpg';
import croissants from '../assets/fotos/panaderia-fripan-vertical-04.jpg';
import donuts from '../assets/fotos/panaderia-fripan-vertical-05.jpg';
import bolsa from '../assets/fotos/panaderia-fripan-vertical-09.jpg';
import nave from '../assets/fotos/panaderia-fripan-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería Fripan · bollería y pan en C. Ing. Ribera, Córdoba';
const description =
	'Panadería Fripan, en C. Ing. Ribera, 10 (14013 Córdoba). Bollería y pan de obrador: muffins, croissants, donuts glaseados, panecillos, dulces de coco y pan envasado. 3,7/5 con 33 reseñas en Google.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#fripan`,
	name: BUSINESS.name,
	alternateName: ['Fripan', 'Panadería Fripan Córdoba'],
	description:
		'Panadería y bollería en C. Ing. Ribera, 10 (14013 Córdoba): muffins, croissants, donuts glaseados, panecillos, dulces de coco y pan envasado.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34957421713',
	servesCuisine: ['Panadería', 'Bollería'],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Dónde', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const galeria = [
	{
		src: vitrina,
		alt: 'Mesa con muffins de chocolate y frutos rojos, panecillos con semillas y bandejas de dulces de coco',
	},
	{
		src: rosas,
		alt: 'Bandeja de panecillos glaseados en rosa con virutas blancas y bollos de chocolate blanco con pepitas',
	},
	{
		src: croissants,
		alt: 'Croissants de hojaldre recién horneados junto a muffins y rosquillas azucaradas',
	},
	{
		src: donuts,
		alt: 'Donuts glaseados en amarillo con glaseado blanco en zigzag, empaquetados de dos en dos',
	},
	{
		src: bolsa,
		alt: 'Rosquillas rebozadas en azúcar dentro de una bolsa de papel',
	},
	{
		src: nave,
		alt: 'Entrada de la nave de la panadería con toldo azul, contenedor verde y un camión al fondo',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#f8f1e6" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300..700;1,300..600&family=Space+Grotesk:wght@300..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Fripan, Fripan Córdoba, panadería Córdoba, bollería Córdoba, muffins, croissants, donuts glaseados, panecillos, Ingeniero Ribera, 14013"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Bollería y pan de obrador en C. Ing. Ribera, 10: muffins, croissants, donuts glaseados, panecillos y pan envasado. 3,7 sobre 5 con 33 reseñas en Google."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Bandejas de bollería de la Panadería Fripan en Córdoba"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#f8f1e6"
			phone="+34957421713"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[mesa]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Fripan"
			subtitle="Panadería · Bollería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Ing. Ribera, 10 · Córdoba"
				title="Bollería de bandeja, <br /><em>pan de todos los días.</em>"
				lede={`Fripan es la panadería de la calle Ingeniero Ribera, 10. Sus fotos son una mesa llena de bollería: muffins de chocolate y arándanos, croissants, panecillos glaseados en rosa, donuts amarillos empaquetados de dos en dos y panecillos con semillas. La ficha de Google no publica horario, así que aquí no lo vas a encontrar inventado: se llama y se pregunta. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas.`}
				image={mesa}
				imageAlt="Mesa de la Panadería Fripan cubierta de bandejas de bollería, donuts y panecillos"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Dirección', html: `<b>${BUSINESS.street}</b>` },
					{ label: 'Horario', html: '<b>No publicado</b> · llama antes' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b>` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver las fotos en Google"
				tag="Sin horario en Google"
			/>

			<LocalChips label="Lo que hay en Fripan" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una mesa <br /><em>llena de bandejas.</em>"
				paragraphs={[
					'Fripan está en el número 10 de la calle Ingeniero Ribera, en Córdoba. La ficha de Google le da una sola categoría, «Panadería», y no publica ni una línea de descripción: todo lo que se sabe del negocio está en sus diez fotos.',
					'Y las fotos son generosas. Hay muffins de chocolate, de frutos rojos y de arándanos en cápsula de papel; croissants de hojaldre apilados; panecillos glaseados en rosa con virutas blancas; bollos de chocolate blanco cubiertos de pepitas; dulces de coco y rosquillas rebozadas en azúcar.',
					'Los donuts aparecen por todas partes: amarillos, con una línea de glaseado blanco en zigzag, empaquetados de dos en dos en bandejas y también en bolsas de papel. Junto a ellos, panecillos con semillas y bolsas de pan envasado con el logotipo de la casa.',
					'La última foto es la puerta de la nave: pared blanca, toldo azul, un contenedor verde y un camión al fondo. En el cartel de la pared se lee «Artesana del Horno · sabor y calidad a tu mesa». Es un negocio de obrador, no un escaparate de calle.',
				]}
				note="La ficha de Google no publica horario, carta, precios, web propia ni datos de accesibilidad, y no confirma si atiende al público. Esta página no lo inventa: para cualquier duda, llama al 957 42 17 13."
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas de la casa</p>
							<h2 id="three-title">Bandeja, bolsa <br /><em>y nave.</em></h2>
						</div>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos"
				title="La mesa <br /><em>y la entrada.</em>"
				description="Seis imágenes de la ficha de Google Maps: la mesa de bollería, los panecillos glaseados, los croissants, los donuts empaquetados, una bolsa de rosquillas y la puerta de la nave."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026. La galería de la ficha tiene diez fotos; aquí se usan seis."
			/>

			<section class="rating-band" aria-labelledby="rating-title">
				<div class="wrap rating-inner">
					<div class="rating-score">
						<strong>3,7</strong>
						<div>
							<span class="rating-stars" role="img" aria-label="3,7 de 5 estrellas">3,7 / 5</span>
							<p id="rating-title" style="margin:0;font-size:.78rem">33 reseñas en Google Maps</p>
						</div>
					</div>
					<p class="rating-copy">
						Es la media de la ficha, con opiniones variadas y 33 reseñas. Esta página no
						selecciona ni reproduce sus textos: se leen todas, con autor y fecha, en Google.
					</p>
					<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
						Leer las 33 reseñas en Google ↗
					</a>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Ing. Ribera, <br /><em>número 10.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario en la ficha de Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de la Panadería Fripan en la calle Ingeniero Ribera, 10, Córdoba"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Fripan · Ing. Ribera, 10"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phone, href: BUSINESS.phoneHref }}
				reserveNote="La ficha de Google no publica horario ni datos de accesibilidad, y no confirma atención al público ni reparto. El teléfono es el que figura en esa ficha. Esta página no gestiona pedidos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>llamar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario, productos y precios pueden cambiar; confírmalos antes de ir."
			ctaLabel="Llamar a Fripan"
			navAriaLabel="Enlaces de la Panadería Fripan"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
