{
	// Misma base que el resto de webs del monorepo: `astro/tsconfigs/strict` hereda `skipLibCheck`,
	// que el tsconfig compartido no activaba (y `tsc` acababa revisando los .d.ts de node_modules).
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"types": ["astro/client"]
	},
	"include": ["env.d.ts", ".astro/types.d.ts", "**/*"],
	"exclude": ["node_modules", "dist"]
}
