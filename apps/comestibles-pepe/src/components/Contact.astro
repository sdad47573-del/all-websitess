---
import { BUSINESS, HOURS } from '../data/site';
---

<section id="visitanos" class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">Visítanos</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">
				Te esperamos en la Plaza Pío XII
			</h2>
			<div class="pepe-divider mx-auto mt-5 h-px w-32"></div>
		</div>

		<div class="mt-14 grid gap-8 lg:grid-cols-2">
			<div class="space-y-6">
				<div class="etiqueta rounded-box border-base-300 bg-base-200 border p-7">
					<h3 class="font-display text-xl font-semibold">Horario</h3>
					<ul class="divide-base-300 mt-5 divide-y text-sm">
						{
							HOURS.map((dia) => (
								<li class="flex items-baseline justify-between gap-4 py-3">
									<span class="font-semibold">{dia.days}</span>
									<span class="text-base-content/70 text-right">
										{dia.morning && <span class="block">{dia.morning}</span>}
										{dia.evening && <span class="block">{dia.evening}</span>}
										{!dia.morning && !dia.evening && <span class="block">Cerrado</span>}
									</span>
								</li>
							))
						}
					</ul>
					<p class="text-base-content/55 mt-4 text-xs">
						Abrimos en dos tramos de lunes a viernes por la mañana y por la tarde. El domingo
						permanecemos cerrados.
					</p>
				</div>

				<div class="rounded-box border-base-300 bg-base-200 border p-7">
					<h3 class="font-display text-xl font-semibold">Datos del local</h3>
					<ul class="mt-5 space-y-5 text-sm">
						<li class="flex items-start gap-4">
							<span
								class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl"
							>
								<i class="ri-map-pin-line text-xl"></i>
							</span>
							<div>
								<p class="font-semibold">Dirección</p>
								<p class="text-base-content/70">
									{BUSINESS.street}<br />
									{BUSINESS.postalCode}
									{BUSINESS.district}, {BUSINESS.city}
								</p>
							</div>
						</li>
						<li class="flex items-start gap-4">
							<span
								class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl"
							>
								<i class="ri-phone-line text-xl"></i>
							</span>
							<div>
								<p class="font-semibold">Teléfono</p>
								<a href={BUSINESS.phoneHref} class="text-base-content/70 hover:text-primary">
									{BUSINESS.phoneDisplay}
								</a>
							</div>
						</li>
					</ul>

					<div class="mt-7 flex flex-wrap gap-3">
						<a href={BUSINESS.phoneHref} class="btn btn-primary gap-2 rounded-full">
							<i class="ri-phone-line"></i>
							Llamar
						</a>
						<a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline gap-2 rounded-full"
						>
							<i class="ri-map-pin-line"></i>
							Google Maps
						</a>
					</div>
				</div>
			</div>

			<div
				id="contacto"
				class="rounded-box border-base-300 bg-base-200 min-h-[420px] scroll-mt-24 overflow-hidden border"
			>
				<iframe
					src={BUSINESS.googleMapsEmbed}
					title={`Ubicación de ${BUSINESS.name}, ${BUSINESS.street}, ${BUSINESS.city}`}
					width="100%"
					height="100%"
					class="min-h-[420px] border-0"
					loading="lazy"
					allowfullscreen
					referrerpolicy="no-referrer-when-downgrade"></iframe>
			</div>
		</div>
	</div>
</section>
