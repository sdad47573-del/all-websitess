---
import { BUSINESS, HOURS, NAV, PAGE_NAV } from '../data/site';

const year = new Date().getFullYear();
const diasAbiertos = HOURS.filter((dia) => dia.morning || dia.evening);
---

<footer class="bg-neutral text-neutral-content">
	<div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
		<div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
			<div class="lg:col-span-2">
				<div class="flex items-center gap-3">
					<span
						class="bg-primary font-display text-primary-content flex size-11 items-center justify-center rounded-xl text-lg font-extrabold"
						>CP</span
					>
					<div>
						<p class="font-display text-xl font-bold text-white">Comestibles Pepe</p>
						<p class="text-xs tracking-[0.2em] text-white/50 uppercase">
							Charcutería · Tienda de alimentación
						</p>
					</div>
				</div>
				<p class="mt-5 max-w-md text-sm leading-relaxed text-white/70">{BUSINESS.summary}</p>
				<div class="mt-6 flex gap-3">
					<a
						href={BUSINESS.phoneHref}
						aria-label={`Llamar a Comestibles Pepe al ${BUSINESS.phoneDisplay}`}
						class="hover:bg-primary flex size-10 items-center justify-center rounded-full bg-white/10 transition-colors"
					>
						<i class="ri-phone-line text-lg"></i>
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Comestibles Pepe en Google Maps"
						class="hover:bg-primary flex size-10 items-center justify-center rounded-full bg-white/10 transition-colors"
					>
						<i class="ri-map-pin-line text-lg"></i>
					</a>
				</div>
			</div>

			<div>
				<h3 class="font-display text-lg font-semibold text-white">Secciones</h3>
				<ul class="mt-4 space-y-2 text-sm text-white/70">
					{
						NAV.map((item) => (
							<li>
								<a href={`/${item.href}`} class="hover:text-secondary transition-colors">
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
				<ul class="mt-4 space-y-2 border-t border-white/10 pt-4 text-sm text-white/70">
					{
						PAGE_NAV.map((item) => (
							<li>
								<a href={item.href} class="hover:text-secondary transition-colors">
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h3 class="font-display text-lg font-semibold text-white">Contacto</h3>
				<ul class="mt-4 space-y-3 text-sm text-white/70">
					<li class="flex items-start gap-2">
						<i class="ri-map-pin-line text-secondary mt-0.5"></i>
						<span>
							{BUSINESS.street}<br />
							{BUSINESS.postalCode}
							{BUSINESS.district}<br />
							{BUSINESS.city}
						</span>
					</li>
					<li class="flex items-center gap-2">
						<i class="ri-phone-line text-secondary"></i>
						<a href={BUSINESS.phoneHref} class="hover:text-secondary">{BUSINESS.phoneDisplay}</a>
					</li>
					{
						diasAbiertos.map((dia) => (
							<li class="flex items-start gap-2">
								<i class="ri-time-line text-secondary mt-0.5" />
								<span>
									{dia.days}: {[dia.morning, dia.evening].filter(Boolean).join(' y ')}
								</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div
			class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-xs text-white/50 sm:flex-row"
		>
			<p>© {year} Comestibles Pepe. Todos los derechos reservados.</p>
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="hover:text-secondary">Ver ficha en Google Maps</a
			>
		</div>
	</div>
</footer>
