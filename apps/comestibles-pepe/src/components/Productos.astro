---
import { BUSINESS, PRODUCTOS } from '../data/site';
---

<section id="productos" class="bg-base-200 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">Productos</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">
				Qué encontrarás en el mostrador
			</h2>
			<div class="pepe-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/70 mt-6 leading-relaxed">
				Del embutido del día al lote de Navidad, pasando por la despensa. Si buscas algo concreto,
				llámanos y te confirmamos si lo tenemos.
			</p>
		</div>

		<div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				PRODUCTOS.map((producto) => (
					<article class="etiqueta rounded-box border-base-300 bg-base-100 group border p-7 transition-shadow hover:shadow-lg">
						<span class="bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-content flex size-12 items-center justify-center rounded-xl transition-colors">
							<i class={`${producto.icon} text-2xl`} />
						</span>
						<h3 class="font-display mt-5 text-xl font-bold">{producto.title}</h3>
						<p class="text-base-content/65 mt-2 text-sm leading-relaxed">{producto.text}</p>
					</article>
				))
			}
		</div>

		<div class="border-base-300 bg-base-100 rounded-box mt-14 border p-8 text-center">
			<h3 class="font-display text-2xl font-bold">¿Buscas algo que no aparece aquí?</h3>
			<p class="text-base-content/70 mx-auto mt-3 max-w-xl text-sm leading-relaxed">
				El lineal cambia según la temporada y la compra. Una llamada al
				{BUSINESS.phoneDisplay} te ahorra el viaje.
			</p>
			<a href={BUSINESS.phoneHref} class="btn btn-primary mt-6 gap-2 rounded-full">
				<i class="ri-phone-line"></i>
				{BUSINESS.phoneDisplay}
			</a>
		</div>
	</div>
</section>
