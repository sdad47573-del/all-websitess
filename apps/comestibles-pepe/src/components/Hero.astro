---
import { Image } from '@astro-components';
import { BUSINESS, HOURS, IMAGES } from '../data/site';

// Días con al menos un tramo de apertura y días que quedan cerrados del todo.
const diasAbiertos = HOURS.filter((dia) => dia.morning || dia.evening);
const diasCerrados = HOURS.filter((dia) => !dia.morning && !dia.evening);

/**
 * «Todos los días» solo es cierto cuando no queda ningún día cerrado. El código anterior contaba
 * los tramos con apertura (`length === 2`) y, como el negocio abre de lunes a viernes y el sábado,
 * anunciaba «abierto todos los días» aunque el domingo está cerrado y así se ve unas líneas más
 * arriba y en los datos estructurados.
 */
const resumenApertura =
	diasCerrados.length === 0
		? 'todos los días'
		: diasCerrados.every((dia) => dia.schemaDays.every((d) => d === 'Sunday'))
			? 'de lunes a sábado'
			: `los ${diasAbiertos.map((dia) => dia.days.toLowerCase()).join(' y ')}`;
---

<section id="inicio" class="hero-pepe relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.heroFondo}
			alt="Comestibles Pepe, charcutería y tienda de alimentación en la Plaza Pío XII, Málaga"
			widths={[800, 1200, 1600]}
			sizes="100vw"
			quality={72}
			loading="eager"
			fetchpriority="high"
			format="webp"
			class="h-full w-full object-cover opacity-45"
		/>
		<div class="from-base-100/85 absolute inset-0 via-transparent"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-32">
		<div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
			<div>
				<p
					class="text-secondary inline-flex items-center gap-2 text-xs font-semibold tracking-[0.22em] uppercase"
				>
					<i class="ri-map-pin-line"></i>
					{BUSINESS.district} · {BUSINESS.city}
				</p>

				<h1
					class="font-display mt-4 text-4xl leading-[1.05] font-extrabold sm:text-5xl lg:text-6xl"
				>
					Comestibles<br />
					<span class="text-secondary">Pepe</span>
				</h1>

				<p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80">
					Charcutería y tienda de alimentación en la Plaza Pío XII. Embutidos que se cortan delante
					de ti, <strong class="text-white">lotes y cestas</strong> para regalo y para la empresa, y la
					despensa de la casa en la misma parada.
				</p>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-primary btn-lg gap-2 rounded-full">
						<i class="ri-phone-line"></i>
						Llamar al {BUSINESS.phoneDisplay}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline btn-lg hover:text-neutral rounded-full border-white/40 bg-white/5 text-white hover:border-white hover:bg-white"
					>
						<i class="ri-map-pin-line"></i>
						Ver en Google Maps
					</a>
				</div>

				<dl class="mt-10 grid max-w-lg grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3">
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Horario</dt>
						<dd class="font-display mt-1 text-xl font-bold">
							L–V
							<span class="block text-sm font-normal">6:30 – 14:30</span>
							<span class="block text-sm font-normal">17:30 – 20:30</span>
						</dd>
					</div>
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Sábado</dt>
						<dd class="font-display mt-1 text-xl font-bold">8:00 – 14:30</dd>
					</div>
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Domingo</dt>
						<dd class="font-display mt-1 text-xl font-bold">Cerrado</dd>
					</div>
				</dl>

				<p class="mt-8 text-sm text-white/55">Abierto {resumenApertura}.</p>
			</div>

			<figure class="relative hidden lg:block">
				<div class="etiqueta rounded-box rotate-2 overflow-hidden shadow-2xl ring-1 ring-white/15">
					<Image
						src={IMAGES.googleMaps}
						alt="Fachada y escaparate de Comestibles Pepe en la Plaza Pío XII, Málaga"
						widths={[500, 800]}
						sizes="(min-width: 1024px) 36vw, 90vw"
						quality={85}
						loading="eager"
						class="aspect-4/3 w-full object-cover"
					/>
				</div>
				<figcaption
					class="font-display text-secondary rounded-box bg-neutral absolute -bottom-5 -left-4 px-5 py-3 text-lg font-bold shadow-xl"
				>
					Plaza Pío XII, 5
				</figcaption>
			</figure>
		</div>
	</div>
</section>
