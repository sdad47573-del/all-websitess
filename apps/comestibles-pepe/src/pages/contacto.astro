---
import Contact from '../components/Contact.astro';
import Fab from '../components/Fab.astro';
import Footer from '../components/Footer.astro';
import Topbar from '../components/Topbar.astro';
import { breadcrumbs } from '../data/schema';
import { BUSINESS } from '../data/site';
import Layout from '../layouts/Layout.astro';

/**
 * `ContactPage` que referencia el `GroceryStore` del layout por su `@id`, sin volver a
 * declararlo: duplicar el mismo `@id` con menos propiedades haría que un validador se quedara
 * con la versión incompleta.
 */
const contactoSchema = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	'@id': `${BUSINESS.siteUrl}/contacto#contacto`,
	name: `Contacto y ubicación de Comestibles Pepe en ${BUSINESS.city}`,
	inLanguage: 'es',
	url: `${BUSINESS.siteUrl}/contacto`,
	mainEntity: { '@type': 'GroceryStore', '@id': `${BUSINESS.siteUrl}/` },
};
---

<Layout
	title={`Contacto y ubicación · Comestibles Pepe en ${BUSINESS.district}, ${BUSINESS.city}`}
	description={`Cómo llegar a Comestibles Pepe: Plaza Pío XII 5, Cruz de Humilladero (Málaga). Tel. ${BUSINESS.phoneDisplay}. Abierto de lunes a viernes de 6:30 a 14:30 y de 17:30 a 20:30.`}
	path="/contacto"
	keywords="Comestibles Pepe teléfono, charcutería Cruz de Humilladero, Plaza Pío XII Málaga, tienda de alimentación Universidad Málaga, embutidos cerca de la UMA"
	schema={[
		contactoSchema,
		breadcrumbs([
			{ name: 'Inicio', path: '/' },
			{ name: 'Contacto', path: '/contacto' },
		]),
	]}
>
	<Topbar base="/" />

	<main>
		<section class="hero-pepe text-white">
			<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
				<nav class="mb-6 text-xs text-white/60" aria-label="Migas de pan">
					<a href="/" class="hover:text-secondary">Inicio</a>
					<span class="mx-2">/</span>
					<span class="text-white/90">Contacto</span>
				</nav>
				<span class="text-secondary text-xs font-semibold tracking-[0.2em] uppercase">
					Contacto
				</span>
				<h1 class="font-display mt-3 text-4xl font-bold sm:text-5xl">
					Plaza Pío XII, 5 · Cruz de Humilladero
				</h1>
				<div class="pepe-divider mt-5 h-px w-32"></div>
				<p class="mt-6 max-w-3xl leading-relaxed text-white/75">
					Estamos en {BUSINESS.street}, en el barrio del {BUSINESS.district} ({BUSINESS.city}), a
					espaldas de la Universidad. Se atiende en el mostrador y no hace falta reservar.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-primary gap-2 rounded-full">
						<i class="ri-phone-line"></i>
						{BUSINESS.phoneDisplay}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline btn-lg hover:text-neutral rounded-full border-white/40 bg-white/5 text-white hover:border-white hover:bg-white"
					>
						<i class="ri-map-pin-line"></i>
						Abrir en Google Maps
					</a>
				</div>
			</div>
		</section>

		<Contact />
	</main>

	<Footer base="/" />
	<Fab />
</Layout>
