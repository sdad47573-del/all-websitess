---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../data/site';
import 'remixicon/fonts/remixicon.css';
import '../styles/index.css';

import { BUSINESS, SCHEMA } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	/** Ruta de la página, para el canonical y el og:url. */
	path?: string;
	/** Palabras clave propias de la página (por defecto, las de la portada). */
	keywords?: string;
	/** Datos estructurados extra de la página: migas de pan… */
	schema?: unknown[];
	noIndex?: boolean;
}

const {
	title = `Comestibles Pepe · Charcutería en ${BUSINESS.district}, ${BUSINESS.city}`,
	description = `Comestibles Pepe, charcutería y tienda de alimentación en la Plaza Pío XII 5, Málaga: embutidos, jamón, quesos y lotes y cestas. Tel. ${BUSINESS.phoneDisplay}.`,
	path = '/',
	keywords = 'Comestibles Pepe, charcutería Málaga, embutidos Málaga, tienda de alimentación Málaga, Plaza Pío XII Málaga, Cruz de Humilladero, embutidos halal Málaga, lotes y cestas Málaga',
	schema = [],
	noIndex = false,
} = Astro.props;

const canonical = new URL(path, BUSINESS.siteUrl).toString();
const ogImage = `${BUSINESS.siteUrl}/og.jpg`;

// `max-image-preview:large` habilita las miniaturas grandes en Google y `max-snippet:-1`
// permite descripciones largas.
const robots = noIndex
	? 'noindex, follow'
	: 'index, follow, max-image-preview:large, max-snippet:-1';

// El JSON-LD del negocio va en todas las páginas; cada página puede añadir el suyo.
const datosEstructurados = [SCHEMA, ...schema];
---

<!doctype html>
<html lang="es" data-theme="pepe" prefix="og: https://ogp.me/ns# place: https://ogp.me/ns/place#">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="Comestibles Pepe" />
		<meta name="robots" content={robots} />
		<meta name="theme-color" content="#4A1D22" />
		<link rel="canonical" href={canonical} />

		<!-- Open Graph (Facebook, WhatsApp, LinkedIn…) -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={BUSINESS.name} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content={`${BUSINESS.name}, charcutería en ${BUSINESS.district} (${BUSINESS.city})`}
		/>
		<meta property="og:locale" content="es_ES" />
		<meta property="og:street-address" content={BUSINESS.street} />
		<meta property="og:locality" content={BUSINESS.city} />
		<meta property="og:region" content={BUSINESS.region} />
		<meta property="og:postal-code" content={BUSINESS.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content="+34 697 65 50 93" />
		<meta property="place:location:latitude" content={String(BUSINESS.geo.lat)} />
		<meta property="place:location:longitude" content={String(BUSINESS.geo.lng)} />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta
			name="twitter:image:alt"
			content={`${BUSINESS.name}, charcutería en ${BUSINESS.district} (${BUSINESS.city})`}
		/>

		<!-- Datos de geolocalización: ayudan a Google a entender de qué negocio se trata -->
		<meta name="geo.region" content="ES-AN" />
		<meta name="geo.placename" content={BUSINESS.city} />
		<meta name="geo.position" content={`${BUSINESS.geo.lat};${BUSINESS.geo.lng}`} />
		<meta name="ICBM" content={`${BUSINESS.geo.lat}, ${BUSINESS.geo.lng}`} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Outfit:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>

		{
			datosEstructurados.map((bloque) => (
				<script type="application/ld+json" is:inline set:html={JSON.stringify(bloque)} />
			))
		}
	</head>
	<body class="bg-base-100 text-base-content font-sans antialiased">
		<slot />
	<WhatsappFab phone={datos.BUSINESS.phoneHref} name={datos.BUSINESS?.name} />
	</body>
</html>
