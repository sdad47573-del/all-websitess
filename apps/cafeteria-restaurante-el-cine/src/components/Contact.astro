---
import { BUSINESS } from '../data/site';
---

<section id="contacto" class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
			<div>
				<p class="text-secondary text-xs font-semibold tracking-[0.22em] uppercase">
					Dónde estamos
				</p>
				<h2 class="font-display mt-3 text-3xl leading-tight font-bold sm:text-4xl">
					En el centro de Santibáñez el Bajo
				</h2>
				<p class="text-base-content/70 mt-4 leading-relaxed">
					En la calle Santo Cristo, 34, en pleno Valle del Alagón. Llama si quieres reservar,
					preguntar por el menú del día o confirmar el horario y la terraza antes de acercarte.
				</p>

				<div class="mt-7 space-y-3">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="border-base-300 hover:border-secondary flex items-start gap-4 rounded-xl border p-4 transition-colors"
					>
						<span class="bg-primary/10 text-primary flex size-10 shrink-0 items-center justify-center rounded-full">
							<i class="ri-map-pin-2-line text-lg"></i>
						</span>
						<span>
							<span class="block text-sm font-bold">Dirección</span>
							<span class="text-base-content/65 block text-sm">{BUSINESS.street}</span>
							<span class="text-base-content/65 block text-sm">
								{BUSINESS.postalCode} {BUSINESS.city}
							</span>
							<span class="text-base-content/45 block text-xs">
								{BUSINESS.region} · {BUSINESS.plusCode}
							</span>
						</span>
					</a>

					<a
						href={BUSINESS.phoneHref}
						class="border-base-300 hover:border-secondary flex items-start gap-4 rounded-xl border p-4 transition-colors"
					>
						<span class="bg-primary/10 text-primary flex size-10 shrink-0 items-center justify-center rounded-full">
							<i class="ri-phone-line text-lg"></i>
						</span>
						<span>
							<span class="block text-sm font-bold">Teléfono</span>
							<span class="text-base-content/65 block text-sm">{BUSINESS.phone}</span>
							<span class="text-base-content/45 block text-xs">Reservas y consultas</span>
						</span>
					</a>

					<div class="border-base-300 flex items-start gap-4 rounded-xl border p-4">
						<span class="bg-primary/10 text-primary flex size-10 shrink-0 items-center justify-center rounded-full">
							<i class="ri-sun-line text-lg"></i>
						</span>
						<span>
							<span class="block text-sm font-bold">Terraza</span>
							<span class="text-base-content/65 block text-sm">
								Comedor interior y terraza exterior para el buen tiempo
							</span>
							<span class="text-base-content/45 block text-xs">Disponibilidad según temporada</span>
						</span>
					</div>

					<div class="border-base-300 flex items-start gap-4 rounded-xl border p-4">
						<span class="bg-primary/10 text-primary flex size-10 shrink-0 items-center justify-center rounded-full">
							<i class="ri-wheelchair-line text-lg"></i>
						</span>
						<span>
							<span class="block text-sm font-bold">Accesibilidad</span>
							<span class="text-base-content/65 block text-sm">
								Acceso, aseo y asientos adaptados para sillas de ruedas
							</span>
							<span class="text-base-content/45 block text-xs">Según la ficha de Google</span>
						</span>
					</div>
				</div>
			</div>

			<div class="flex flex-col gap-5">
				<div class="border-base-300 bg-base-100 overflow-hidden rounded-xl border">
					<h3 class="border-base-300 flex items-center gap-2 border-b px-6 py-4 text-sm font-bold">
						<i class="ri-time-line text-secondary text-lg"></i> Horario
					</h3>
					<ul class="divide-base-200 divide-y px-6 py-2">
						{BUSINESS.hours.map((row) => (
							<li class="flex items-center justify-between gap-4 py-3 text-sm">
								<span class="font-semibold">{row.days}</span>
								<span
									class={`text-right ${row.hours === 'Cerrado' ? 'text-base-content/45' : 'text-base-content/70'}`}
								>
									{row.hours}
								</span>
							</li>
						))}
					</ul>
					<p class="text-base-content/45 px-6 pt-2 pb-5 text-xs">{BUSINESS.hoursNote}</p>
				</div>

				<a
					href={BUSINESS.googleMaps}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-primary btn-block gap-2 rounded-full"
				>
					<i class="ri-route-line text-lg"></i> Abrir ruta en Google Maps
				</a>
				<a
					href={BUSINESS.social.facebook}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-outline btn-block gap-2 rounded-full"
				>
					<i class="ri-facebook-circle-line text-lg"></i> Ver Facebook
				</a>
			</div>
		</div>

		<div class="border-base-300 mt-12 overflow-hidden rounded-xl border">
			<iframe
				title="Mapa de Cafetería Restaurante El Cine en Santibáñez el Bajo"
				src={BUSINESS.googleMapsEmbed}
				width="100%"
				height="380"
				style="border:0"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				allowfullscreen
			></iframe>
		</div>
	</div>
</section>
