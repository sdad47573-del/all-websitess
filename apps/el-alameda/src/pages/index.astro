---
import '../styles/global.css';
import { BUSINESS, MAPS, RATING } from '../data/site';
import foto from '../assets/fotos/el-alameda-01.jpg';

const title = `${BUSINESS.name} · ${BUSINESS.city}`;
const description = BUSINESS.description;
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Restaurant",
	"@id": "https://el-alameda.vercel.app/#negocio",
	"name": "El Alameda",
	"url": "https://el-alameda.vercel.app/",
	"description": "El Alameda, bar en Urkixo Zumarkalea, 40 (Abando, 48011 Bilbao, Bizkaia). Clásico bar popular con barra de pintxos y cocina casera, según su ficha de Google Maps.",
	"image": "https://el-alameda.vercel.app/og.jpg",
	"telephone": "+34944435008",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 43.2605019,
		"longitude": -2.9378471
	},
	"hasMap": "https://www.google.com/maps/place/El+Alameda/@43.2605019,-2.9378471,16z/data=!3m1!4b1!4m6!3m5!1s0xd4e50282aac27b1:0x843c6130bcf8449!8m2!3d43.2605019!4d-2.9378471!16s%2Fg%2F1v_ndtsg?authuser=0&hl=es&entry=ttu",
	"servesCuisine": [
		"Española"
	]
}
</script>
</head>
	<body>
		<header class="site-header">
			<h1 set:html={piezas.portada.titulo} />
			<p>{BUSINESS.tagline}</p>
		</header>
		<main>
			<img src={foto.src} width={foto.width} height={foto.height} alt={`Foto de ${BUSINESS.name}`} />
			<section>
				<h2>Dirección</h2>
				<p>{BUSINESS.street}, {BUSINESS.postalCode} {BUSINESS.city}</p>
				<p>Teléfono: <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a></p>
				<p>Valoración en Google Maps: {RATING.label}</p>
				<p><a href={MAPS.place} target="_blank" rel="noreferrer">Ver en Google Maps</a> · <a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar</a></p>
			</section>
		</main>
		<footer class="site-footer">
			<p>© {new Date().getFullYear()} {BUSINESS.fullName}</p>
			<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> · sur-digital.vercel.app</small>
		</footer>
	</body>
</html>
