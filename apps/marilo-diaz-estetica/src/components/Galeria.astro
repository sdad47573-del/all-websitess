---
import { Image } from '@astro-components';
import { GALLERY } from '../data/site';
---

<section class="bg-base-200 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">El local</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">Así es el salón</h2>
			<div class="marilo-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/60 mt-6 text-xs">
				Fotografías de la ficha pública del negocio en Google Maps.
			</p>
		</div>

		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				GALLERY.map((foto) => (
					<figure class="etiqueta-marilo rounded-box overflow-hidden shadow-md">
						<Image
							src={foto.src}
							alt={foto.alt}
							widths={[400, 700]}
							sizes="(min-width: 1024px) 32vw, (min-width: 640px) 48vw, 92vw"
							quality={80}
							loading="lazy"
							class="aspect-square w-full object-cover transition-transform duration-500 hover:scale-105"
						/>
					</figure>
				))
			}
		</div>
	</div>
</section>
