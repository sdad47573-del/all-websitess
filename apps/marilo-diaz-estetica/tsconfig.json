{
	"extends": "@astro-config/tsconfig.json",
	"compilerOptions": {
		"types": ["astro/client"],
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"skipLibCheck": true,
		"paths": {
			"@assets/*": ["../../packages/@assets/*"],
			"@astro-components": ["../../packages/@astro-components"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.astro", "src/env.d.ts", ".astro/types.d.ts"],
	"exclude": ["node_modules", "dist"]
}