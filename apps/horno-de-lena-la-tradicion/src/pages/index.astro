---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import mostrador from '../assets/fotos/horno-de-lena-la-tradicion-panoramica-04.jpg';
import fachada from '../assets/fotos/horno-de-lena-la-tradicion-vertical-01.jpg';
import tarta from '../assets/fotos/horno-de-lena-la-tradicion-vertical-02.jpg';
import vitrina from '../assets/fotos/horno-de-lena-la-tradicion-panoramica-06.jpg';
import barras from '../assets/fotos/horno-de-lena-la-tradicion-vertical-08.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Horno de Leña La Tradición · Panadería en Córdoba';
const description =
	'Horno de Leña La Tradición, panadería en la Plaza de Vista Alegre, 4 (Poniente Sur, 14004 Córdoba). Pan de masa madre y harinas ecológicas, dulces y tartas. Desde 1913.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#latradicion`,
	name: BUSINESS.name,
	alternateName: ['La Tradición', 'Horno de Leña La Tradición Córdoba', 'Panadería La Tradición'],
	description:
		'Panadería de horno de leña en Poniente Sur (14004 Córdoba). Pan de masa madre y harinas ecológicas, bollería, dulces y tartas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34644204873',
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '14:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '16:30',
			closes: '20:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '09:00',
			closes: '14:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de La Tradición con el rótulo de horno de leña y los vinilos de masa madre en el escaparate',
	},
	{
		src: tarta,
		alt: 'Tarta redonda con crema, fruta confitada y frutos secos, sobre una bandeja dorada',
	},
	{
		src: vitrina,
		alt: 'Vitrina de La Tradición con bollería, dulces y panes en las bandejas',
	},
	{
		src: barras,
		alt: 'Dos barras de pan de corteza rústica y harina espolvoreada sobre una tabla de madera',
	},
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"horno-de-lena-la-tradicion-panoramica-04.jpg": mostrador,
	"horno-de-lena-la-tradicion-vertical-01.jpg": fachada,
	"horno-de-lena-la-tradicion-vertical-02.jpg": tarta,
	"horno-de-lena-la-tradicion-panoramica-06.jpg": vitrina,
	"horno-de-lena-la-tradicion-vertical-08.jpg": barras,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#6b2f24" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400..700;1,400..600&family=Source+Sans+3:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Horno de Leña La Tradición, panadería Córdoba, pan de masa madre Córdoba, horno de leña, harinas ecológicas, Vista Alegre, 14004"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan de masa madre y harinas ecológicas, bollería, dulces y tartas en la Plaza de Vista Alegre, 4 (14004 Córdoba). Horno de leña desde 1913. 4,6 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Mostrador de La Tradición con panes de masa madre y bollería"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#6b2f24"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[mostrador]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Horno de leña · Desde 1913"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Ver en Google Maps"
			navAriaLabel="Enlaces de Horno de Leña La Tradición"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
