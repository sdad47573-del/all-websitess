---
import { Image } from 'astro:assets';
import { BUSINESS, CARTA, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, NOTA_CARTA, RATING, RESENAS } from '../data/site';
import '../styles/global.css';

import fotoBrasa from '../assets/fotos/al-paladar-con-sabor-apaisada-03.jpg';
import fotoCochinillo from '../assets/fotos/al-paladar-con-sabor-apaisada-05.jpg';
import fotoMesa from '../assets/fotos/al-paladar-con-sabor-vertical-04.jpg';
import fotoPollo from '../assets/fotos/al-paladar-con-sabor-apaisada-07.jpg';
import fotoCostillas from '../assets/fotos/al-paladar-con-sabor-cuadrada-06.jpg';
import fotoTortilla from '../assets/fotos/al-paladar-con-sabor-vista-8-08.jpg';
import fotoCroquetas from '../assets/fotos/al-paladar-con-sabor-vertical-09.jpg';
import fotoFachada from '../assets/fotos/al-paladar-con-sabor-apaisada-01.jpg';
import fotoPolloCerca from '../assets/fotos/al-paladar-con-sabor-vertical-02.jpg';
import fotoCostillasCrudas from '../assets/fotos/al-paladar-con-sabor-vertical-10.jpg';

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Restaurant',
			'@id': `${BUSINESS.siteUrl}/#restaurante`,
			name: BUSINESS.fullName,
			description: BUSINESS.description,
			url: `${BUSINESS.siteUrl}/`,
			telephone: '+34691773764',
			image: `${BUSINESS.siteUrl}/og.jpg`,
			servesCuisine: ['Brasa', 'Casera', 'Pollo al carbón', 'Costillas'],
			address: {
				'@type': 'PostalAddress',
				streetAddress: BUSINESS.street,
				addressLocality: BUSINESS.city,
				addressRegion: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				addressCountry: BUSINESS.country,
			},
			geo: {
				'@type': 'GeoCoordinates',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			},
			hasMap: MAPS.place,
			aggregateRating: {
				'@type': 'AggregateRating',
				ratingValue: RATING.value,
				reviewCount: RATING.count,
				bestRating: 5,
			},
			openingHoursSpecification: [
				{
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
					opens: '10:00',
					closes: '15:30',
				},
				{
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
					opens: '19:00',
					closes: '22:00',
				},
			],
			amenityFeature: [
				{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
				{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
				{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
				{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: false },
			],
		},
		{
			'@type': 'FAQPage',
			'@id': `${BUSINESS.siteUrl}/#faq`,
			mainEntity: FAQ.map((item) => ({
				'@type': 'Question',
				name: item.q,
				acceptedAnswer: { '@type': 'Answer', text: item.a },
			})),
		},
	],
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Al paladar con sabor · Pollo al carbón y costillas para llevar en Madrid</title>
		<meta name="description" content={BUSINESS.description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#14120f" />
		<link rel="canonical" href={`${BUSINESS.siteUrl}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<meta property="og:type" content="restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={BUSINESS.name} />
		<meta property="og:title" content="Al paladar con sabor · Pollo al carbón y costillas para llevar" />
		<meta property="og:description" content={BUSINESS.description} />
		<meta property="og:url" content={`${BUSINESS.siteUrl}/`} />
		<meta property="og:image" content={`${BUSINESS.siteUrl}/og.jpg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Pollo asándose al carbón con pimientos rojos y amarillos en la parrilla" />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Public+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<a class="skip" href="#contenido">Saltar al contenido</a>

		<header class="top">
			<div class="wrap top__in">
				<a class="brand" href="/" aria-label="Al paladar con sabor, inicio">
					<span class="brand__mark" aria-hidden="true">A</span>
					<span class="brand__name">
						<strong>Al paladar</strong>
						<small>con sabor · Ciudad Lineal</small>
					</span>
				</a>
				<nav class="nav" aria-label="Secciones">
					<a href="#brasa">La brasa</a>
					<a href="#carta">La carta</a>
					<a href="#fotos">Fotos</a>
					<a href="#resenas">Reseñas</a>
					<a href="#visita">Visita</a>
				</nav>
				<a class="call" href={BUSINESS.phoneHref}>Pedir · {BUSINESS.phone}</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero">
				<div class="wrap hero__grid">
					<div>
						<p class="kicker">Hermanos García Noblejas, 182 · Madrid</p>
						<h1 class="hero__title" set:html={piezas.portada.titulo} />
						<p class="hero__lede">
							El auténtico sabor de la parrilla en Ciudad Lineal: pollo al carbón, costillas y
							platos caseros preparados con ingredientes frescos. Se pide, se recoge y se come
							donde quieras.
						</p>
						<div class="hero__actions">
							<a class="btn btn--ember" href={BUSINESS.phoneHref}>Llamar al {BUSINESS.phone}</a>
							<a class="btn btn--ghost" href="#carta">Ver la carta</a>
						</div>
						<div class="hero__meta">
							<span><b>{RATING.label}</b>sobre 5 · {RATING.count} reseñas</span>
							<span>Miércoles a domingo</span>
							<span>Comida para llevar</span>
						</div>
					</div>

					<figure class="hero__media">
						<div class="hero__frame">
							<Image
								src={fotoBrasa}
								alt="Pollo asándose al carbón con pimientos rojos y amarillos en la parrilla"
								widths={[480, 800, 1200]}
								sizes="(max-width: 1024px) 92vw, 34rem"
								loading="eager"
								fetchpriority="high"
							/>
						</div>
						<figcaption>
							<span>Pollo y pimientos, sobre la brasa</span>
							<span>Foto: ficha de Google</span>
						</figcaption>
						<div class="badge" aria-hidden="true">
							<span>Reseñas</span>
							<b>4,7</b>
							<span>en Google</span>
						</div>
					</figure>
				</div>
			</section>

			<div class="band">
				<div class="wrap band__in">
					<div class="band__item">
						<span>Mediodía</span>
						<strong>10:00 – 15:30</strong>
					</div>
					<div class="band__item">
						<span>Noche</span>
						<strong>19:00 – 22:00</strong>
					</div>
					<div class="band__item">
						<span>Lunes y martes cerrado · pedidos</span>
						<strong><a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a></strong>
					</div>
				</div>
			</div>

			<section class="sec" id="brasa">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">La brasa</span>
							<h2>Pollo al carbón, costillas y cochinillo</h2>
						</div>
						<p>
							Todo lo que cuenta esta página sale de la ficha pública del local en Google y de
							sus fotos: la dirección, el teléfono, la nota, el horario, la descripción que
							firma el asador y las reseñas.
						</p>
					</div>

					<div class="about">
						<figure class="about__fig">
							<Image
								src={fotoCochinillo}
								alt="Cocinera sosteniendo un cochinillo asado en la bandeja, junto al horno de carbón"
								widths={[420, 760, 1100]}
								sizes="(max-width: 1024px) 92vw, 32rem"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>El cochinillo, recién salido del horno de carbón</figcaption>
						</figure>
						<div class="about__text">
							<p class="lead">«El auténtico sabor a la brasa», dice el local en su ficha.</p>
							<p>
								Se presenta como especialista en pollo al carbón, costillas y comidas caseras,
								preparadas con ingredientes frescos y «un toque artesanal». Google lo clasifica
								como restaurante de comida para llevar, y en la fachada negra se lee «Comida
								para llevar» junto al rótulo amarillo.
							</p>
							<p>
								La nota publicada es 4,7 sobre 5 con 59 reseñas. Las que se ven hablan de
								raciones enormes, pollo grande y buen sabor; también de paella, empanadas,
								patatas y ensalada. Abre de miércoles a domingo, con dos turnos, y descansa
								lunes y martes.
							</p>
							<blockquote class="pull">
								«Las raciones son ENORMES, Pollo bastante grande, todo está buenísimo.»
								<cite>Reseña de cinco estrellas publicada en Google</cite>
							</blockquote>
						</div>
					</div>

					<div class="cards">
						{
							HIGHLIGHTS.map((item) => (
								<article class="card">
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="sec sec--paper" id="carta">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">La carta</span>
							<h2>Lo que sale de la parrilla y de la cocina</h2>
						</div>
						<p>
							La ficha no publica carta ni precios. Estos platos son los que aparecen en la
							descripción del local, en sus fotos y en las reseñas; para precios y menú del día,
							el teléfono.
						</p>
					</div>

					<div class="carta">
						<div>
							{
								CARTA.map((grupo) => (
									<div class="menu__group">
										<h3>{grupo.title}</h3>
										<p>{grupo.note}</p>
										{grupo.items.map((plato) => (
											<div class="menu__item">
												<h4>{plato.name}</h4>
												<p>{plato.note}</p>
											</div>
										))}
									</div>
								))
							}
							<p class="nota">{NOTA_CARTA}</p>
						</div>

						<aside class="side">
							<h3>Una mesa de casa</h3>
							<p>
								En una de las fotos, el pedido aparece servido en una mesa: pollo entero,
								costillas, una bandeja de patatas, sauces y una tarrina de croquetas.
							</p>
							<p>
								Es la mejor forma de ver cómo llega la comida: sin montajes, en platos de
								paper y tarrinas de aluminio.
							</p>
							<figure>
								<Image
									src={fotoMesa}
									alt="Mesa con pollo asado, costillas, bandeja de patatas, salsas y croquetas"
									widths={[360, 620, 900]}
									sizes="(max-width: 1024px) 46vw, 17rem"
									loading="lazy"
									decoding="async"
								/>
								<figcaption>El pedido, servido en la mesa</figcaption>
							</figure>
						</aside>
					</div>
				</div>
			</section>

			<section class="sec" id="fotos">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">La galería de la ficha</span>
							<h2>Brasa, platos y la fachada</h2>
						</div>
						<p>
							Las diez fotos públicas del local, repartidas entre la portada, la sección de la
							brasa, la carta y esta galería. Ninguna repetida.
						</p>
					</div>

					<div class="photos">
						<figure class="photo photo--wide">
							<Image
								src={fotoFachada}
								alt="Fachada negra de Al paladar con sabor, con el rótulo amarillo y el cartel de comida para llevar"
								widths={[480, 800, 1200]}
								sizes="(max-width: 760px) 92vw, 46vw"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>La fachada, en Hermanos García Noblejas</figcaption>
						</figure>
						<figure class="photo">
							<Image
								src={fotoPollo}
								alt="Dos pollos asándose en el asador giratorio, con costillas en la parrilla de arriba"
								widths={[380, 620, 900]}
								sizes="(max-width: 760px) 46vw, 24vw"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>Los pollos, girando en la brasa</figcaption>
						</figure>
						<figure class="photo photo--tall">
							<Image
								src={fotoPolloCerca}
								alt="Primer plano de un pollo dorado en el asador de carbón"
								widths={[380, 620, 900]}
								sizes="(max-width: 760px) 46vw, 24vw"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>El punto del pollo</figcaption>
						</figure>
						<figure class="photo">
							<Image
								src={fotoCostillas}
								alt="Costillas a la brasa con patatas, ensalada y salsa barbacoa"
								widths={[380, 620, 900]}
								sizes="(max-width: 760px) 46vw, 24vw"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>Costillas con patatas y ensalada</figcaption>
						</figure>
						<figure class="photo">
							<Image
								src={fotoTortilla}
								alt="Tortilla de patata entera en un plato de rayas"
								widths={[380, 620, 900]}
								sizes="(max-width: 760px) 46vw, 24vw"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>La tortilla de patata</figcaption>
						</figure>
						<figure class="photo">
							<Image
								src={fotoCroquetas}
								alt="Croquetas caseras doradas en una tarrina de aluminio"
								widths={[380, 620, 900]}
								sizes="(max-width: 760px) 46vw, 24vw"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>Croquetas caseras</figcaption>
						</figure>
						<figure class="photo photo--wide">
							<Image
								src={fotoCostillasCrudas}
								alt="Costillas adobadas en una bandeja de acero antes de pasar por la brasa"
								widths={[480, 800, 1200]}
								sizes="(max-width: 760px) 92vw, 46vw"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>Costillas adobadas, antes de la brasa</figcaption>
						</figure>
					</div>
				</div>
			</section>

			<section class="sec sec--ink" id="resenas">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">Lo que dicen</span>
							<h2>{RATING.label} sobre 5 en Google</h2>
						</div>
						<p>
							Tres reseñas de cinco estrellas que repiten lo mismo: raciones grandes, pollo en
							su punto y buen acompañamiento.
						</p>
					</div>

					<div class="reviews">
						<div class="reviews__score">
							<b>{RATING.label}</b>
							<span class="stars" aria-hidden="true">★★★★★</span>
							<span>{RATING.count} reseñas en Google</span>
							<a href={MAPS.reviews} target="_blank" rel="noreferrer">Leer todas ↗</a>
						</div>
						<div class="reviews__list">
							{
								RESENAS.map((resena) => (
									<blockquote class="quote">
										<p>«{resena.texto}»</p>
										<footer>Reseña publicada en Google · {resena.valor} de 5</footer>
									</blockquote>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<section class="sec" id="visita">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">Cómo llegar</span>
							<h2>Hermanos García Noblejas, 182</h2>
						</div>
						<p>
							Un bajo de fachada negra en Ciudad Lineal, con el cartel amarillo del asador. La
							ficha marca acceso adaptado, pero no aseo adaptado.
						</p>
					</div>

					<div class="visit">
						<div class="visit__info">
							<p class="visit__address">
								<strong>{BUSINESS.name}</strong>
								{BUSINESS.street}<br />
								{BUSINESS.district} · {BUSINESS.postalCode} {BUSINESS.city}
							</p>
							<div class="visit__actions">
								<a class="btn btn--ember" href={BUSINESS.phoneHref}>Pedir al {BUSINESS.phone}</a>
								<a class="btn btn--dark" href={MAPS.directions} target="_blank" rel="noreferrer">
									Cómo llegar ↗
								</a>
							</div>

							<table class="hours">
								<caption>Horario publicado en la ficha</caption>
								<tbody>
									{
										HORARIO.map((dia) => (
											<tr class={dia.closed ? 'is-closed' : undefined}>
												<th scope="row">{dia.dia}</th>
												<td>{dia.horas}</td>
											</tr>
										))
									}
								</tbody>
							</table>
							<p class="hours__aviso">{HORARIO_AVISO}</p>

							<div class="access">
								<strong>Accesibilidad</strong>
								La ficha marca acceso para sillas de ruedas, aparcamiento adaptado y asientos
								adaptados. No hay aseo adaptado. Si necesitas un acceso concreto, llama antes de
								ir.
							</div>
						</div>

						<div class="map">
							<iframe
								src={MAPS.embed}
								title={`Mapa de ${BUSINESS.name}, ${BUSINESS.street}, ${BUSINESS.city}`}
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
								allowfullscreen></iframe>
							<div class="map__foot">
								<span>{BUSINESS.street} · {BUSINESS.district}</span>
								<a href={MAPS.place} target="_blank" rel="noreferrer">Abrir la ficha en Google Maps ↗</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="sec sec--paper" id="preguntas">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">Antes de pedir</span>
							<h2>Preguntas frecuentes</h2>
						</div>
						<p>
							Lo que la ficha permite responder. Para la carta del día, los precios o un encargo,
							el teléfono del local: {BUSINESS.phone}.
						</p>
					</div>

					<div class="faq">
						{
							FAQ.map((item, i) => (
								<details open={i === 0}>
									<summary>{item.q}</summary>
									<p>{item.a}</p>
								</details>
							))
						}
					</div>
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="wrap">
				<div class="footer__top">
					<div class="footer__brand">
						<strong>Al paladar con sabor</strong>
						<p>{BUSINESS.street} · {BUSINESS.district} · {BUSINESS.postalCode} {BUSINESS.city}</p>
						<p>Pollo al carbón, costillas y comida casera para llevar. Miércoles a domingo.</p>
					</div>
					<div class="footer__cols">
						<div class="footer__col">
							<span>Contacto</span>
							<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
							<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						</div>
						<div class="footer__col">
							<span>En esta página</span>
							<a href="#brasa">La brasa</a>
							<a href="#carta">La carta</a>
							<a href="#fotos">Fotos</a>
							<a href="#preguntas">Preguntas</a>
						</div>
						<div class="footer__col">
							<span>Más</span>
							<a href={MAPS.place} target="_blank" rel="noreferrer">Ficha en Google Maps ↗</a>
							<a href="/aviso-legal/">Aviso legal y privacidad</a>
						</div>
					</div>
				</div>
				<div class="footer__bottom">
					<span>© {new Date().getFullYear()} {BUSINESS.fullName}. Sin carta publicada: platos y precios, por teléfono.</span>
					<span>
						Creado por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
						<a href="https://sur-digital.vercel.app/" rel="noopener">sur-digital.vercel.app</a>
					</span>
				</div>
			</div>
		</footer>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
