---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import exterior from '../assets/fotos/sagarzulo-jatetxea-vertical-06.jpg';
import comedor from '../assets/fotos/sagarzulo-jatetxea-panoramica-01.jpg';
import chuleton from '../assets/fotos/sagarzulo-jatetxea-vertical-02.jpg';
import rodaballoAjos from '../assets/fotos/sagarzulo-jatetxea-vertical-03.jpg';
import costillar from '../assets/fotos/sagarzulo-jatetxea-vertical-04.jpg';
import pescadoAlmejas from '../assets/fotos/sagarzulo-jatetxea-vertical-05.jpg';
import tortilla from '../assets/fotos/sagarzulo-jatetxea-vertical-07.jpg';
import rodaballoFuente from '../assets/fotos/sagarzulo-jatetxea-vertical-08.jpg';
import ensalada from '../assets/fotos/sagarzulo-jatetxea-vertical-09.jpg';
import jamon from '../assets/fotos/sagarzulo-jatetxea-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Sagarzulo Jatetxea, parrilla y restaurante en Herriondo Bailara, 8 (Calle Valle), Lezo (Gipuzkoa). Carne y pescado a la brasa, cocina de cuchara y raciones abundantes. Abre de 8:30 a 19:30. Tel. 675 70 15 83.';

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de Sagarzulo Jatetxea con mesas y sillas de madera, ventanales y el rótulo Sagarzulo en la pared',
	},
	{
		src: rodaballoAjos,
		alt: 'Rodaballo entero a la brasa con ajos y perejil, servido en una fuente ovalada',
	},
	{
		src: chuleton,
		alt: 'Chuletón a la brasa con patatas fritas, ensalada y pan en la mesa',
	},
	{
		src: pescadoAlmejas,
		alt: 'Pescado desespinado con almejas y patatas en una salsa con ajo y perejil',
	},
	{
		src: costillar,
		alt: 'Costillar a la brasa con patatas fritas en un plato blanco',
	},
	{
		src: jamon,
		alt: 'Jamón cortado en lonchas finas, servido en un plato blanco',
	},
	{
		src: tortilla,
		alt: 'Tortilla de bacalao jugosa, dorada por fuera, en un plato blanco',
	},
	{
		src: ensalada,
		alt: 'Ensalada de lechuga, tomate en rodajas y cebolla',
	},
	{
		src: rodaballoFuente,
		alt: 'Rodaballo a la brasa con láminas de ajo y aceite, en una fuente ovalada',
	},
	{
		src: exterior,
		alt: 'Fachada de Sagarzulo Jatetxea con el rótulo Sagar-Zulo y la terraza de sillas y mesas',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#sagarzulo`,
	name: BUSINESS.name,
	alternateName: ['Sagarzulo', 'Sagar Zulo Erretegia', 'Sagarzulo Lezo', 'Sagarzulo jatetxea'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 675 70 15 83',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Parrilla', 'Vasca', 'Tradicional'],
	areaServed: [
		{ '@type': 'City', name: 'Lezo' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: `${BUSINESS.street} (${BUSINESS.streetNote})`,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '08:30',
			closes: '19:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Pescado y carne a la brasa, sopas de cocido, jamon, todo riquisimo.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 4, bestRating: 5 },
			reviewBody: 'La comida muy rica , con raciones abundantes y el precio razonable.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody:
				'Croquetas, calamares, pimientos rellenos, tortilla de bacalao exquisito todo.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Sagarzulo Jatetxea · Parrilla en Lezo (Gipuzkoa)';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#14100e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;1,400&family=Oswald:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Sagarzulo Jatetxea, Sagar Zulo Erretegia, parrilla Lezo, asador Lezo, comer en Lezo, brasa Gipuzkoa, restaurante Herriondo, Sagarzulo Lezo"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Parrilla y restaurante en Herriondo Bailara, 8 (Lezo). Carne y pescado a la brasa, cocina de cuchara y raciones abundantes. De 8:30 a 19:30, miércoles cerrado. Tel. 675 70 15 83."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Comedor de Sagarzulo Jatetxea con mesas de madera y grandes ventanales"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#14100e"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34675701583"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lezo, Gipuzkoa"
			preload={[exterior]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Sagarzulo"
			subtitle="Jatetxea · Lezo"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Herriondo Bailara, 8 · Lezo, Gipuzkoa"
				title="A la brasa<br /><em>en Lezo.</em>"
				lede={`Sagarzulo Jatetxea es una parrilla con comedor amplio en Herriondo Bailara, 8 (Calle Valle), en el barrio de Herriondo de Lezo (Gipuzkoa). Carne y pescado a la brasa, cocina de cuchara y raciones abundantes, con terraza y aparcamiento. Abre de 8:30 a 19:30 de lunes a domingo, salvo el miércoles. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={exterior}
				imageAlt="Fachada de Sagarzulo Jatetxea con el rótulo Sagar-Zulo y la terraza de sillas y mesas"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5</b> en Google · 681 reseñas' },
					{ label: 'Horario', html: '<b>8:30–19:30</b> de lunes a domingo' },
					{ label: 'Cierre', html: '<b>Miércoles</b> descansa' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Sagarzulo Jatetxea" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="La parrilla<br /><em>de Herriondo.</em>"
				paragraphs={[
					'Sagarzulo Jatetxea está en Herriondo Bailara, 8 —la dirección que en Google aparece también como Calle Valle—, en el barrio de Herriondo, a las afueras del casco de Lezo (Gipuzkoa).',
					'Es una parrilla de mantel blanco y mesa larga: un comedor amplio con ventanales, mesas y sillas de madera y el rótulo de Sagar-Zulo en la pared. Fuera, terraza y aparcamiento.',
					'Google lo clasifica como parrilla y restaurante, lo marca como brunch y le da 4,5 sobre 5 con 681 reseñas. Su ficha no incluye descripción del local ni carta, así que esta web no inventa platos ni precios.',
					'Sus reseñas hablan de «pescado y carne a la brasa», «sopas de cocido», jamón, tortilla de bacalao, croquetas, calamares y pimientos rellenos, con «raciones abundantes» y «precio razonable».',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «Pescado y carne a la brasa, sopas de cocido, jamon, todo riquisimo».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="La brasa<br /><em>y la cuchara.</em>"
				description="La ficha de Google no publica carta ni precios y el local no tiene web propia. Esto es lo que citan sus reseñas, plato por plato."
				cta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. Llama al 675 70 15 83 para preguntar qué hay hoy y si queda mesa."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor<br /><em>y la brasa.</em>"
				description="Estas fotografías proceden del perfil de Sagarzulo Jatetxea en Google Maps: el comedor, la fachada con la terraza, el rodaballo y el chuletón a la brasa, el pescado con almejas, el jamón y la tortilla de bacalao."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a Lezo<br /><em>a comer.</em>"
				addressLines={[
					`${BUSINESS.street} (${BUSINESS.streetNote})`,
					`${BUSINESS.postalCode} Lezo · ${BUSINESS.district}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: de 8:30 a 19:30 de lunes a domingo, con el miércoles cerrado. La ficha no recoge servicio de cena; para grupos conviene llamar antes."
				mapTitle="Mapa de Sagarzulo Jatetxea en Herriondo Bailara, 8, Lezo (Gipuzkoa)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Sagarzulo Jatetxea · Lezo"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se atiende por teléfono en el 675 70 15 83. La ficha de Google marca acceso para sillas de ruedas, aparcamiento adaptado, aseo adaptado y asientos adaptados."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} Lezo`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Sagarzulo Jatetxea"
		/>
	</body>
</html>
