---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import exterior from '../assets/fotos/sagarzulo-jatetxea-vertical-06.jpg';
import comedor from '../assets/fotos/sagarzulo-jatetxea-panoramica-01.jpg';
import chuleton from '../assets/fotos/sagarzulo-jatetxea-vertical-02.jpg';
import rodaballoAjos from '../assets/fotos/sagarzulo-jatetxea-vertical-03.jpg';
import costillar from '../assets/fotos/sagarzulo-jatetxea-vertical-04.jpg';
import pescadoAlmejas from '../assets/fotos/sagarzulo-jatetxea-vertical-05.jpg';
import tortilla from '../assets/fotos/sagarzulo-jatetxea-vertical-07.jpg';
import rodaballoFuente from '../assets/fotos/sagarzulo-jatetxea-vertical-08.jpg';
import ensalada from '../assets/fotos/sagarzulo-jatetxea-vertical-09.jpg';
import jamon from '../assets/fotos/sagarzulo-jatetxea-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
} from '../data/site';

const description =
	'Sagarzulo Jatetxea, parrilla y restaurante en Herriondo Bailara, 8 (Calle Valle), Lezo (Gipuzkoa). Carne y pescado a la brasa, cocina de cuchara y raciones abundantes. Abre de 8:30 a 19:30. Tel. 675 70 15 83.';

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de Sagarzulo Jatetxea con mesas y sillas de madera, ventanales y el rótulo Sagarzulo en la pared',
	},
	{
		src: rodaballoAjos,
		alt: 'Rodaballo entero a la brasa con ajos y perejil, servido en una fuente ovalada',
	},
	{
		src: chuleton,
		alt: 'Chuletón a la brasa con patatas fritas, ensalada y pan en la mesa',
	},
	{
		src: pescadoAlmejas,
		alt: 'Pescado desespinado con almejas y patatas en una salsa con ajo y perejil',
	},
	{
		src: costillar,
		alt: 'Costillar a la brasa con patatas fritas en un plato blanco',
	},
	{
		src: jamon,
		alt: 'Jamón cortado en lonchas finas, servido en un plato blanco',
	},
	{
		src: tortilla,
		alt: 'Tortilla de bacalao jugosa, dorada por fuera, en un plato blanco',
	},
	{
		src: ensalada,
		alt: 'Ensalada de lechuga, tomate en rodajas y cebolla',
	},
	{
		src: rodaballoFuente,
		alt: 'Rodaballo a la brasa con láminas de ajo y aceite, en una fuente ovalada',
	},
	{
		src: exterior,
		alt: 'Fachada de Sagarzulo Jatetxea con el rótulo Sagar-Zulo y la terraza de sillas y mesas',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#sagarzulo`,
	name: BUSINESS.name,
	alternateName: ['Sagarzulo', 'Sagar Zulo Erretegia', 'Sagarzulo Lezo', 'Sagarzulo jatetxea'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 675 70 15 83',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Parrilla', 'Vasca', 'Tradicional'],
	areaServed: [
		{ '@type': 'City', name: 'Lezo' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: `${BUSINESS.street} (${BUSINESS.streetNote})`,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '08:30',
			closes: '19:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Pescado y carne a la brasa, sopas de cocido, jamon, todo riquisimo.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 4, bestRating: 5 },
			reviewBody: 'La comida muy rica , con raciones abundantes y el precio razonable.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody:
				'Croquetas, calamares, pimientos rellenos, tortilla de bacalao exquisito todo.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Sagarzulo Jatetxea · Parrilla en Lezo (Gipuzkoa)';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"sagarzulo-jatetxea-vertical-06.jpg": exterior,
	"sagarzulo-jatetxea-panoramica-01.jpg": comedor,
	"sagarzulo-jatetxea-vertical-03.jpg": rodaballoAjos,
	"sagarzulo-jatetxea-vertical-02.jpg": chuleton,
	"sagarzulo-jatetxea-vertical-05.jpg": pescadoAlmejas,
	"sagarzulo-jatetxea-vertical-04.jpg": costillar,
	"sagarzulo-jatetxea-vertical-10.jpg": jamon,
	"sagarzulo-jatetxea-vertical-07.jpg": tortilla,
	"sagarzulo-jatetxea-vertical-09.jpg": ensalada,
	"sagarzulo-jatetxea-vertical-08.jpg": rodaballoFuente,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#14100e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;1,400&family=Oswald:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Sagarzulo Jatetxea, Sagar Zulo Erretegia, parrilla Lezo, asador Lezo, comer en Lezo, brasa Gipuzkoa, restaurante Herriondo, Sagarzulo Lezo"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Parrilla y restaurante en Herriondo Bailara, 8 (Lezo). Carne y pescado a la brasa, cocina de cuchara y raciones abundantes. De 8:30 a 19:30, miércoles cerrado. Tel. 675 70 15 83."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Comedor de Sagarzulo Jatetxea con mesas de madera y grandes ventanales"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#14100e"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34675701583"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lezo, Gipuzkoa"
			preload={[exterior]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Sagarzulo"
			subtitle="Jatetxea · Lezo"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} Lezo`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Sagarzulo Jatetxea"
		/>
	</body>
</html>
