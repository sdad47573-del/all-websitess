---
const business = {
	name: 'Restaurante El Ladrillo II',
	street: 'Calle Panaderos, 35',
	city: 'Granada',
	region: 'Granada',
	postalCode: '18010',
	country: 'ES',
	phone: '+34 958 28 46 71',
	latitude: 37.1825541,
	longitude: -3.5919083,
	site: 'https://restaurante-el-ladrillo-ii-granada.vercel.app',
};
const mapsUrl = 'https://www.google.com/maps/place/Restaurante+El+Ladrillo+II/@37.1825541,-3.5919083,17z/data=!3m1!4b1!4m6!3m5!1s0xd71fcc63e8217b7:0xc4e2d0efde97de05!8m2!3d37.1825541!4d-3.5919083!16s%2Fg%2F1vvyzffz?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const instagramUrl = 'https://www.instagram.com/restladrillo2/';
const phoneHref = 'tel:+34958284671';
const siteUrl = `${business.site}/`;
const description = 'Restaurante El Ladrillo II, en el Albaicín de Granada: pescados, mariscos y cocina casera en Calle Panaderos, 35. Consulta teléfono, ubicación y fotos de Google Maps.';
const faqs = [
	{ question: '¿Dónde está El Ladrillo II?', answer: 'Restaurante El Ladrillo II está en Calle Panaderos, 35, Albaicín, 18010 Granada. Abre las indicaciones de Google Maps para planificar el trayecto.' },
	{ question: '¿Cuál es el teléfono del restaurante?', answer: 'El teléfono publicado es el 958 28 46 71. Llama para consultar reservas, horario actualizado y disponibilidad.' },
	{ question: '¿Qué tipo de cocina ofrece?', answer: 'El restaurante se presenta como especialista en pescados y mariscos, con comida casera. Consulta su carta y los platos disponibles directamente con el establecimiento.' },
	{ question: '¿Cuál es su horario?', answer: 'Los horarios publicados por distintas fuentes no coinciden. Comprueba la ficha de Google Maps o llama al 958 28 46 71 antes de acudir.' },
	{ question: '¿Dónde se pueden ver fotos del restaurante?', answer: 'Abre la ficha de El Ladrillo II en Google Maps desde esta página para ver las imágenes y reseñas publicadas allí.' },
];
const restaurantSchema = {
	'@context': 'https://schema.org', '@type': 'Restaurant', '@id': `${siteUrl}#restaurant`,
	name: business.name, description, url: siteUrl, telephone: business.phone,
	servesCuisine: ['Pescado', 'Marisco', 'Cocina española', 'Cocina casera'],
	address: { '@type': 'PostalAddress', streetAddress: business.street, addressLocality: business.city, addressRegion: business.region, postalCode: business.postalCode, addressCountry: business.country },
	geo: { '@type': 'GeoCoordinates', latitude: business.latitude, longitude: business.longitude },
	hasMap: mapsUrl, sameAs: [mapsUrl, instagramUrl],
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) };
---
<!doctype html>
<html lang="es">
<head>
	<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="description" content={description} /><meta name="robots" content="index, follow, max-image-preview:large" /><meta name="theme-color" content="#403027" />
	<link rel="canonical" href={siteUrl} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />
	<title>El Ladrillo II en el Albaicín | Pescados y mariscos</title>
	<meta property="og:type" content="restaurant.restaurant" /><meta property="og:locale" content="es_ES" /><meta property="og:site_name" content={business.name} />
	<meta property="og:title" content="El Ladrillo II · Pescados y mariscos en el Albaicín" /><meta property="og:description" content={description} /><meta property="og:url" content={siteUrl} />
	<meta property="og:image" content={`${business.site}/og.svg`} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Restaurante El Ladrillo II en el Albaicín de Granada" /><meta name="twitter:card" content="summary_large_image" />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} /><script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} /><link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
</head>
<body>
	<a class="skip" href="#contenido">Saltar al contenido</a>
	<header class="topbar"><a class="brand" href="#inicio"><span class="mark">L</span><span>El Ladrillo II<small>Albaicín · Granada</small></span></a><nav aria-label="Navegación principal"><a href="#restaurante">El restaurante</a><a href="#cocina">La cocina</a><a href="#fotos">Fotos</a><a href="#visita">Cómo llegar</a></nav><a class="call-top" href={phoneHref}>Reservas · 958 28 46 71</a></header>
	<main id="contenido">
		<section class="hero" id="inicio"><div class="hero-copy"><p class="eyebrow">Albaicín · Granada <i></i> Calle Panaderos</p><h1>Sabores del mar<br /><em>en el Albaicín.</em></h1><p class="lede">El Ladrillo II reúne pescados, mariscos y cocina casera en uno de los barrios con más historia de Granada. Consulta la carta, llama para reservar y disfruta de una mesa en Calle Panaderos.</p><div class="actions"><a class="button gold" href={phoneHref}>Llamar para reservar ↗</a><a class="button outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a></div><div class="details"><span>⌖ Calle Panaderos, 35</span><span>✦ Pescados · mariscos · cocina casera</span></div></div><div class="hero-art" role="img" aria-label="Ilustración original de una mesa de pescado y marisco bajo los tejados del Albaicín"><div class="sun"></div><div class="roofs roof-back"></div><div class="tower"><i></i><b></b></div><div class="roofs roof-front"></div><div class="arch"><span></span></div><div class="table"></div><div class="plate"><i class="fish fish-one"></i><i class="fish fish-two"></i><i class="lemon"></i><i class="greens"></i></div><div class="label">Granada<br /><b>mesa con sabor</b></div><span class="spark">✦</span></div></section>
		<div class="ticker"><span>Pescados y mariscos</span><b>✳</b><span>Cocina casera</span><b>✳</b><span>Albaicín granadino</span><b>✳</b><span>Platos para compartir</span></div>
		<section class="intro section" id="restaurante"><div><p class="eyebrow dark">Una mesa en el Albaicín</p><h2>Producto del mar,<br /><em>calor granadino.</em></h2></div><div class="intro-copy"><p>Restaurante El Ladrillo II está en Calle Panaderos, en el Albaicín de Granada. El propio restaurante se presenta como especialista en pescados y mariscos y ofrece cocina casera.</p><p>Consulta directamente la carta, los alérgenos y la disponibilidad de cada plato; la oferta puede variar.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver reseñas y fotos en Google Maps ↗</a></div></section>
		<section class="food section" id="cocina"><div class="heading"><p class="eyebrow dark">Sabores de la casa</p><h2>Del mar a la mesa,<br /><em>sin complicaciones.</em></h2><p>Una propuesta para disfrutar de los sabores del mar y de la cocina tradicional en el corazón del barrio.</p></div><div class="cards"><article><span>✦</span><small>ESPECIALIDAD</small><h3>Pescados</h3><p>Pescado en distintas preparaciones, con una fritura entre las opciones más comentadas.</p></article><article class="blue"><span>◉</span><small>PARA COMPARTIR</small><h3>Mariscos</h3><p>Opciones de marisco para disfrutar en una comida en compañía.</p></article><article class="clay"><span>♨</span><small>COCINA DE SIEMPRE</small><h3>Recetas caseras</h3><p>Platos y raciones de cocina española para completar la mesa.</p></article></div><p class="note">Descripción basada en información pública del restaurante. Confirma carta, disponibilidad, alérgenos y precios directamente con el establecimiento.</p></section>
		<section class="photo-section" id="fotos"><div class="photo-copy"><p class="eyebrow">El Ladrillo II en Google Maps</p><h2>Descubre sus fotos<br />y su <em>ambiente.</em></h2><p>Consulta imágenes del local y de los platos en la ficha de Google Maps, junto con las reseñas y los datos más recientes.</p><a class="button gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver fotos en Google Maps ↗</a><a class="social" href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram de El Ladrillo II ↗</a><p class="photo-note">Las imágenes se consultan en sus fichas originales; no se descargan ni se alojan aquí.</p></div><div class="map"><iframe title="Mapa de Google de Restaurante El Ladrillo II en Calle Panaderos, Granada" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><a class="map-card" href={mapsUrl} target="_blank" rel="noopener noreferrer"><b>Restaurante El Ladrillo II</b><small>Calle Panaderos, 35 · Ver fotos ↗</small></a></div></section>
		<section class="visit section" id="visita"><div class="visit-copy"><p class="eyebrow dark">Ven a descubrir el barrio</p><h2>Nos vemos<br /><em>en el Albaicín.</em></h2><p>El restaurante está en Calle Panaderos, en el Albaicín. Llama antes de ir para confirmar horario, disponibilidad y reservas.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button dark-button" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Llamar · 958 28 46 71</a></div></div><div class="info-card"><p class="eyebrow dark">Ubicación y contacto</p><h3>El Ladrillo II</h3><dl><div><dt>Dirección</dt><dd>Calle Panaderos, 35<br />18010 Granada</dd></div><div><dt>Teléfono</dt><dd><a href={phoneHref}>958 28 46 71</a></dd></div><div><dt>Horario</dt><dd>Confirma por teléfono<br />antes de tu visita</dd></div></dl><p class="note">Los directorios consultados muestran datos de horario distintos. Confirma la apertura llamando al restaurante.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Consultar ficha de Google Maps ↗</a></div></section>
		<section class="faq section" id="preguntas"><p class="eyebrow dark">Preguntas frecuentes</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
	</main>
	<footer class="footer"><div class="footer-top"><a class="brand" href="#inicio"><span class="mark">L</span><span>El Ladrillo II<small>Albaicín · Granada</small></span></a><p>Pescados y mariscos<br />en el Albaicín.</p><nav aria-label="Enlaces de El Ladrillo II"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={phoneHref}>958 28 46 71</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Restaurante El Ladrillo II · Granada</span><a href="/aviso-legal/">Aviso legal y privacidad</a><span>Confirma horarios y carta directamente con el restaurante.</span></div></footer><a class="mobile-call" href={phoneHref}>Reservar <span>958 28 46 71</span></a>
</body>
</html>
<style is:global>
:root{font-family:'DM Sans',sans-serif;color:#39312c;background:#f8f4eb;font-synthesis:none;text-rendering:optimizeLegibility;--brown:#403027;--gold:#d5b477;--cream:#f8f4eb;--sea:#4f6870;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid var(--gold);outline-offset:4px}.skip{position:absolute;top:-60px;left:16px;padding:12px;background:var(--gold)}.skip:focus{top:10px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:18px;background:var(--brown);color:#fcf8ef}.brand{display:flex;align-items:center;gap:11px;font-weight:700}.brand small{display:block;margin-top:4px;color:#ded3c5;font-size:9px;font-weight:500;letter-spacing:1.3px;text-transform:uppercase}.mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--gold);border-radius:50%;color:#ead19a;font:700 23px var(--display)}.topbar nav,.footer nav{display:flex;gap:clamp(10px,2vw,22px);font-size:11px}.topbar nav a:hover,.footer a:hover{color:#ead19a}.call-top{padding:10px 14px;border:1px solid #ffffff55;border-radius:99px;font-size:10px;font-weight:700}.hero{display:grid;grid-template-columns:1.06fr .94fr;min-height:540px;background:var(--brown);color:#fcf8ef;overflow:hidden}.hero-copy{align-self:center;padding:60px 4vw 55px 9vw}.eyebrow{margin:0 0 18px;color:#e4ca91;font-size:10px;font-weight:700;letter-spacing:1.7px;text-transform:uppercase}.eyebrow i{display:inline-block;width:20px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.heading h2,.photo-copy h2,.visit h2,.faq h2{margin:0;font:600 clamp(38px,4.8vw,62px)/1.08 var(--display);letter-spacing:-1px}.hero h1 em,.intro h2 em,.heading h2 em,.photo-copy h2 em,.visit h2 em,.faq h2 em{color:var(--gold);font-style:italic}.lede{max-width:470px;margin:22px 0 0;color:#e5dcd1;font-size:14px;line-height:1.85}.actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:24px}.button{display:inline-flex;min-height:45px;align-items:center;justify-content:center;gap:12px;padding:0 18px;border-radius:99px;font-size:11px;font-weight:700;transition:transform .18s}.button:hover{transform:translateY(-2px)}.gold{background:var(--gold);color:var(--brown)}.outline{border:1px solid #ffffff70}.dark-button{background:var(--brown);color:white}.details{display:flex;flex-wrap:wrap;gap:12px 20px;margin-top:24px;padding-top:17px;border-top:1px solid #ffffff2c;color:#e4d8c9;font-size:10px}.details span:first-child{color:#ead19a}.hero-art{position:relative;min-height:540px;overflow:hidden;background:linear-gradient(180deg,#d9b987 0%,#c49368 52%,#907158 53%,#5c5544 100%)}.sun{position:absolute;top:10%;right:18%;width:94px;height:94px;border-radius:50%;background:#f2d995;box-shadow:0 0 48px #f1d89088}.roofs{position:absolute;right:-7%;left:-7%;height:31%;clip-path:polygon(0 100%,0 48%,15% 48%,15% 24%,30% 24%,30% 60%,44% 60%,44% 5%,61% 5%,61% 49%,76% 49%,76% 28%,100% 28%,100% 100%)}.roof-back{top:30%;background:#a66c51}.tower{position:absolute;z-index:1;top:10%;left:46%;width:58px;height:240px;background:#d5a477}.tower:before{position:absolute;top:-34px;left:-9px;width:76px;height:40px;border-radius:50% 50% 0 0;background:#765344;content:''}.tower i{position:absolute;top:42px;left:20px;width:19px;height:35px;border-radius:12px 12px 0 0;background:#573f34;box-shadow:0 68px #573f34,0 136px #573f34}.tower b{position:absolute;top:-52px;left:28px;width:3px;height:20px;background:#765344}.roof-front{top:43%;height:23%;background:#815741;clip-path:polygon(0 100%,0 38%,20% 38%,20% 0,45% 0,45% 57%,68% 57%,68% 18%,100% 18%,100% 100%)}.arch{position:absolute;right:7%;bottom:23%;width:30%;height:35%;border:12px solid #ead2a9;border-bottom:0;border-radius:100px 100px 0 0;background:#987156}.arch span{position:absolute;right:10%;bottom:0;left:10%;height:65%;background:linear-gradient(140deg,#52483a,#273a3c)}.table{position:absolute;right:-12%;bottom:-16%;left:-12%;height:45%;border-radius:50% 50% 0 0;background:#614434;box-shadow:0 -9px 24px #2b211c66}.plate{position:absolute;z-index:2;bottom:12%;left:26%;width:min(260px,55%);aspect-ratio:1;border:13px solid #fff9ed;border-radius:50%;background:#e8dfcc;box-shadow:0 15px 30px #30251e77;transform:rotate(-8deg)}.fish{position:absolute;width:59%;height:20%;border-radius:50%;background:linear-gradient(140deg,#e1c89f,#aa7950)}.fish:after{position:absolute;top:0;right:-17%;width:0;height:0;border-top:14px solid transparent;border-bottom:14px solid transparent;border-left:24px solid #a16c46;content:''}.fish-one{top:28%;left:17%;transform:rotate(15deg)}.fish-two{top:52%;left:22%;background:linear-gradient(140deg,#d9bf96,#9a754e);transform:rotate(-13deg)}.lemon{position:absolute;top:18%;right:19%;width:21%;height:15%;border-radius:50%;background:#e1bd60;transform:rotate(-20deg)}.greens{position:absolute;right:20%;bottom:17%;width:25%;height:14%;border-radius:50%;background:#708557;box-shadow:8px 6px #93a062,-7px 4px #526e4b}.label{position:absolute;top:14%;left:9%;padding:13px 16px;background:#fff5df;color:#49392d;font:13px/1.45 var(--display);transform:rotate(-5deg)}.label b{font-size:16px}.spark{position:absolute;top:43%;right:10%;color:#fff0c4;font-size:25px}.ticker{display:flex;min-height:54px;align-items:center;justify-content:center;gap:clamp(12px,4vw,46px);padding:10px 4vw;background:var(--gold);color:var(--brown);font:600 13px var(--display)}.ticker b{font-size:12px}.section{padding:78px 9vw}.intro{display:grid;grid-template-columns:1fr .9fr;gap:9%;align-items:center;background:var(--cream)}.dark{color:#907447}.intro h2,.heading h2,.visit h2,.faq h2{font-size:clamp(34px,4vw,49px);color:var(--brown)}.intro h2 em,.heading h2 em,.visit h2 em,.faq h2 em{color:#9a6747}.intro-copy p,.heading>p,.visit-copy>p:not(.eyebrow){color:#6c6961;font-size:14px;line-height:1.85}.intro-copy p{margin:0 0 1