---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import tajinPollo from '../assets/fotos/maison-tanger-vertical-02.jpg';
import dosTajines from '../assets/fotos/maison-tanger-vista-4-04.jpg';
import cuscus from '../assets/fotos/maison-tanger-vertical-10.jpg';
import desayuno from '../assets/fotos/maison-tanger-vertical-09.jpg';
import bandejaDulces from '../assets/fotos/maison-tanger-vertical-03.jpg';
import pastas from '../assets/fotos/maison-tanger-apaisada-06.jpg';
import fachada from '../assets/fotos/maison-tanger-vertical-01.jpg';
import fachadaDos from '../assets/fotos/maison-tanger-vertical-05.jpg';
import comedor from '../assets/fotos/maison-tanger-vertical-08.jpg';
import rotulo from '../assets/fotos/maison-tanger-vertical-07.jpg';

import { BUSINESS, FAQ, HORARIO, HORARIO_AVISO, MAPS, RESENAS, SERVICIOS } from '../data/site';

const title = 'Maison Tánger · Restaurante marroquí en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: tajinPollo,
		alt: 'Tajín de pollo con patatas y zanahoria en cazuela de barro, con la tapa levantada y la tetera al fondo',
	},
	{
		src: dosTajines,
		alt: 'Dos tajines de barro sobre la mesa, con pan casero en sus cestas: uno de pollo con limón y aceitunas y otro con almendras y sésamo',
	},
	{
		src: cuscus,
		alt: 'Cuscús en bandeja de aluminio con carne, zanahoria, calabacín, garbanzos y pasas',
	},
	{
		src: desayuno,
		alt: 'Cuatro platos con crepes, buñuelos en forma de donut, una tortita de miel y vasitos de crema de cacao',
	},
	{
		src: bandejaDulces,
		alt: 'Bandeja de dos pisos con pastas marroquíes: cuernos de gacela, galletas de sésamo y dulces glaseados',
	},
	{
		src: pastas,
		alt: 'Bandejas de pastas marroquíes y dátiles rellenos cubiertos de sésamo sobre el mostrador de acero',
	},
	{
		src: fachada,
		alt: 'Fachada de Maison Tánger con el rótulo negro y dorado y las puertas de cristal, en la calle Quevedo',
	},
	{
		src: fachadaDos,
		alt: 'Otra vista de la entrada del restaurante, con el zócalo de piedra y el cartel de Cafetería & Restaurante',
	},
	{
		src: comedor,
		alt: 'Comedor del restaurante con mesas de madera, sillas negras y los servilleteros con la carta de Tánger',
	},
	{
		src: rotulo,
		alt: 'Detalle del rótulo de Maison Tánger en el cristal de la puerta, con el reflejo del cielo',
	},
];

const carta = [
	{
		title: 'Del tajín',
		items: [
			{ name: 'Tajín de pollo', note: 'con patatas y zanahoria, cocción lenta en barro' },
			{ name: 'Tajín de kofta', note: 'el que piden para llevar en una de las reseñas' },
			{
				name: 'Pollo con limón y aceitunas',
				note: 'el tajín de la foto, servido con pan casero',
			},
		],
	},
	{
		title: 'De la casa',
		items: [
			{ name: 'Pastela de pollo', note: 'la que destaca una de las reseñas de Google' },
			{ name: 'Cuscús', note: 'con carne, zanahoria, calabacín, garbanzos y pasas' },
			{ name: 'Pan casero', note: 'en cesta, para mojar la salsa' },
		],
	},
	{
		title: 'Dulces y merienda',
		items: [
			{ name: 'Pastas marroquíes', note: 'cuernos de gacela, galletas de sésamo y dulces glaseados' },
			{ name: 'Dátiles rellenos', note: 'con sésamo, en el mostrador' },
			{ name: 'Crepes y buñuelos', note: 'con crema de cacao, de la carta de cafetería' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#maison-tanger`,
	name: BUSINESS.name,
	alternateName: ['Maison Tanger', 'Maison Tánger Ciudad Real', 'Restaurante marroquí Ciudad Real'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Marroquí', 'Cocina del Magreb'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Ciudad Real' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Código', value: '/g/11nc8v3rn1' },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '09:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '19:00',
			closes: '23:00',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '09:00', closes: '16:00' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#12263d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,700&family=Nunito+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Maison Tánger Ciudad Real, restaurante marroquí Ciudad Real, tajín Ciudad Real, pastela de pollo Ciudad Real, cuscús Ciudad Real, comida marroquí para llevar 13004, C. Quevedo 18, dulces marroquíes Ciudad Real"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina marroquí en la calle Quevedo, 18, Ciudad Real: tajines de pollo y kofta, pastela, cuscús, pan casero y dulces. De 9:00 a 16:00 y de 19:00 a 23:00; domingos solo mediodía. Teléfono 926 72 20 22."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Maison Tánger, restaurante marroquí en Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#12263d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CR"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[tajinPollo]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Maison Tánger"
			subtitle="Cocina marroquí · Ciudad Real"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="La cocina <br /><em>de Tánger.</em>"
				lede="Maison Tánger es un restaurante marroquí en la calle Quevedo, 18, en Ciudad Real: tajines de barro cocidos despacio, pastela de pollo, cuscús con pasas y garbanzos, pan casero y dulces de la casa. Abre de 9:00 a 16:00 y de 19:00 a 23:00, con los domingos solo de mediodía. Pedidos y consultas en el 926 72 20 22."
				image={tajinPollo}
				imageAlt="Tajín de pollo con patatas y zanahoria en cazuela de barro, con la tapa levantada y la tetera al fondo"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>5,0</b> en Google · 21 reseñas' },
					{ label: 'Horario', html: '<b>9:00–16:00</b><br />y 19:00–23:00 · domingo solo mediodía' },
					{ label: 'Pedidos', html: `<b>${BUSINESS.phone}</b> para comer allí o llevar` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Maison Tánger" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Barro, azafrán <br /><em>y pan caliente.</em>"
				paragraphs={[
					'El local está en la calle Quevedo, 18, en Ciudad Real, con un rótulo negro y dorado que anuncia «Maison Tánger · Cafetería & Restaurante» sobre una fachada de cal y zócalo de piedra. Dentro, mesas de madera, sillas negras y un comedor sencillo donde el olor sale de los tajines.',
					'La ficha de Google lo clasifica como restaurante marroquí. En las fotos de su perfil aparecen los tajines de barro con patatas y zanahoria, el cuscús con garbanzos y pasas, el pan casero en cestas, los cuernos de gacela y demás pastas de sésamo, y los crepes y buñuelos de la parte de cafetería.',
					'Abre de 9:00 a 16:00 y de 19:00 a 23:00 de lunes a sábado; los domingos solo de 9:00 a 16:00. La propia ficha avisa de que en el Día de Todos los Santos el horario podría ser distinto.',
					'La ficha tiene 21 reseñas y una media de 5 sobre 5. Las tres que Google destaca elogian la pastela de pollo, los precios y los tajines de pollo y de kofta, que una de ellas pide para llevar.',
				]}
				note="La ficha de Google no publica carta ni precios y esta web no inventa importes: los platos que se nombran salen de las reseñas destacadas y de las fotos del propio perfil del local."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Tajín, pastela <br /><em>y cuscús.</em>"
				description="Lo que se ve en la mesa y en el mostrador del local: los tajines de barro, la pastela de pollo, el cuscús y los dulces de sésamo. Sin precios publicados."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={carta}
				note="Esta lista sale de las reseñas que Google destaca y de las fotografías del perfil del establecimiento. No hay carta con precios publicada: el surtido del día se pregunta en el local o en el 926 72 20 22."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
					<div class="reviews-head">
						<h2 id="resenas-title">Cinco sobre <br /><em>cinco.</em></h2>
						<p>
							La ficha tiene 21 reseñas y una media de 5. Estas son las tres que Google destaca, todas
							de cinco estrellas, con la puntuación que les dio su autor.
						</p>
					</div>
					<div class="review-grid">
						{
							RESENAS.map((review) => (
								<figure class="review-card">
									<p class="review-stars" aria-label={`${review.rating} sobre 5`}>
										{'★'.repeat(review.rating)}
										<span aria-hidden="true">{'★'.repeat(5 - review.rating)}</span>
									</p>
									<blockquote>{review.quote}</blockquote>
									<figcaption>Reseña publicada en Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="review-note">
						Citas de las reseñas públicas del local, con la puntuación del autor. En la ficha de Google
						están todas, incluidas las que puntúan por debajo.
					</p>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="De la mesa <br /><em>al mostrador.</em>"
				description="Diez fotos del perfil del local: el tajín de pollo, dos tajines con pan casero, el cuscús, los crepes del desayuno, las bandejas de pastas marroquíes, la fachada y el comedor."
				images={galeria}
				cta={{ label: 'Ver todas en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="Comida <br /><em>y cena.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Ciudad Real · España']}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de Maison Tánger en la calle Quevedo, 18, Ciudad Real"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Maison Tánger"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Pedidos: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="Se puede comer en el local o pedir para llevar: una de las reseñas destacadas cuenta que encargaron tajín de pollo y de kofta para llevar. Las reservas y los encargos se hablan en el 926 72 20 22; esta página no tramita pedidos ni cobros."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Maison Tánger"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos, horario y fotografías tomados de la ficha y del perfil públicos del local en Google Maps, consultados en noviembre de 2026. Sin carta ni precios publicados: confirma horario y disponibilidad antes de ir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Maison Tánger"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
