---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import tajinPollo from '../assets/fotos/maison-tanger-vertical-02.jpg';
import dosTajines from '../assets/fotos/maison-tanger-vista-4-04.jpg';
import cuscus from '../assets/fotos/maison-tanger-vertical-10.jpg';
import desayuno from '../assets/fotos/maison-tanger-vertical-09.jpg';
import bandejaDulces from '../assets/fotos/maison-tanger-vertical-03.jpg';
import pastas from '../assets/fotos/maison-tanger-apaisada-06.jpg';
import fachada from '../assets/fotos/maison-tanger-vertical-01.jpg';
import fachadaDos from '../assets/fotos/maison-tanger-vertical-05.jpg';
import comedor from '../assets/fotos/maison-tanger-vertical-08.jpg';
import rotulo from '../assets/fotos/maison-tanger-vertical-07.jpg';

import {
	BUSINESS,
	FAQ,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Maison Tánger · Restaurante marroquí en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: tajinPollo,
		alt: 'Tajín de pollo con patatas y zanahoria en cazuela de barro, con la tapa levantada y la tetera al fondo',
	},
	{
		src: dosTajines,
		alt: 'Dos tajines de barro sobre la mesa, con pan casero en sus cestas: uno de pollo con limón y aceitunas y otro con almendras y sésamo',
	},
	{
		src: cuscus,
		alt: 'Cuscús en bandeja de aluminio con carne, zanahoria, calabacín, garbanzos y pasas',
	},
	{
		src: desayuno,
		alt: 'Cuatro platos con crepes, buñuelos en forma de donut, una tortita de miel y vasitos de crema de cacao',
	},
	{
		src: bandejaDulces,
		alt: 'Bandeja de dos pisos con pastas marroquíes: cuernos de gacela, galletas de sésamo y dulces glaseados',
	},
	{
		src: pastas,
		alt: 'Bandejas de pastas marroquíes y dátiles rellenos cubiertos de sésamo sobre el mostrador de acero',
	},
	{
		src: fachada,
		alt: 'Fachada de Maison Tánger con el rótulo negro y dorado y las puertas de cristal, en la calle Quevedo',
	},
	{
		src: fachadaDos,
		alt: 'Otra vista de la entrada del restaurante, con el zócalo de piedra y el cartel de Cafetería & Restaurante',
	},
	{
		src: comedor,
		alt: 'Comedor del restaurante con mesas de madera, sillas negras y los servilleteros con la carta de Tánger',
	},
	{
		src: rotulo,
		alt: 'Detalle del rótulo de Maison Tánger en el cristal de la puerta, con el reflejo del cielo',
	},
];

const carta = [
	{
		title: 'Del tajín',
		items: [
			{ name: 'Tajín de pollo', note: 'con patatas y zanahoria, cocción lenta en barro' },
			{ name: 'Tajín de kofta', note: 'el que piden para llevar en una de las reseñas' },
			{
				name: 'Pollo con limón y aceitunas',
				note: 'el tajín de la foto, servido con pan casero',
			},
		],
	},
	{
		title: 'De la casa',
		items: [
			{ name: 'Pastela de pollo', note: 'la que destaca una de las reseñas de Google' },
			{ name: 'Cuscús', note: 'con carne, zanahoria, calabacín, garbanzos y pasas' },
			{ name: 'Pan casero', note: 'en cesta, para mojar la salsa' },
		],
	},
	{
		title: 'Dulces y merienda',
		items: [
			{ name: 'Pastas marroquíes', note: 'cuernos de gacela, galletas de sésamo y dulces glaseados' },
			{ name: 'Dátiles rellenos', note: 'con sésamo, en el mostrador' },
			{ name: 'Crepes y buñuelos', note: 'con crema de cacao, de la carta de cafetería' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#maison-tanger`,
	name: BUSINESS.name,
	alternateName: ['Maison Tanger', 'Maison Tánger Ciudad Real', 'Restaurante marroquí Ciudad Real'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Marroquí', 'Cocina del Magreb'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Ciudad Real' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Código', value: '/g/11nc8v3rn1' },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '09:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '19:00',
			closes: '23:00',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '09:00', closes: '16:00' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"maison-tanger-vertical-02.jpg": tajinPollo,
	"maison-tanger-vista-4-04.jpg": dosTajines,
	"maison-tanger-vertical-10.jpg": cuscus,
	"maison-tanger-vertical-09.jpg": desayuno,
	"maison-tanger-vertical-03.jpg": bandejaDulces,
	"maison-tanger-apaisada-06.jpg": pastas,
	"maison-tanger-vertical-01.jpg": fachada,
	"maison-tanger-vertical-05.jpg": fachadaDos,
	"maison-tanger-vertical-08.jpg": comedor,
	"maison-tanger-vertical-07.jpg": rotulo,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#12263d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,700&family=Nunito+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Maison Tánger Ciudad Real, restaurante marroquí Ciudad Real, tajín Ciudad Real, pastela de pollo Ciudad Real, cuscús Ciudad Real, comida marroquí para llevar 13004, C. Quevedo 18, dulces marroquíes Ciudad Real"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina marroquí en la calle Quevedo, 18, Ciudad Real: tajines de pollo y kofta, pastela, cuscús, pan casero y dulces. De 9:00 a 16:00 y de 19:00 a 23:00; domingos solo mediodía. Teléfono 926 72 20 22."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Maison Tánger, restaurante marroquí en Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#12263d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CR"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[tajinPollo]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Maison Tánger"
			subtitle="Cocina marroquí · Ciudad Real"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Maison Tánger"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos, horario y fotografías tomados de la ficha y del perfil públicos del local en Google Maps, consultados en noviembre de 2026. Sin carta ni precios publicados: confirma horario y disponibilidad antes de ir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Maison Tánger"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34926722022?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Taj%C3%ADn%20de%20pollo." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Tajín de pollo"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
