---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/restaurante-la-fragua-apaisada-01.jpg';
import migas from '../assets/fotos/restaurante-la-fragua-apaisada-03.jpg';
import carneGuiso from '../assets/fotos/restaurante-la-fragua-apaisada-04.jpg';
import tarta from '../assets/fotos/restaurante-la-fragua-apaisada-05.jpg';
import ensalada from '../assets/fotos/restaurante-la-fragua-vertical-06.jpg';
import revuelto from '../assets/fotos/restaurante-la-fragua-apaisada-07.jpg';
import empanada from '../assets/fotos/restaurante-la-fragua-apaisada-09.jpg';
import carneTomate from '../assets/fotos/restaurante-la-fragua-apaisada-10.jpg';
import carrillada from '../assets/fotos/restaurante-la-fragua-vertical-02.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Restaurante la Fragua, cocina extremeña en una casa de piedra del casco antiguo de Garganta la Olla (Cáceres). Migas, carnes de guiso, menú del día y tarta de queso casera. Reservas en el 927 17 95 71.';

const galeria = [
	{ src: migas, alt: 'Migas extremeñas con huevo frito en Restaurante la Fragua, Garganta la Olla' },
	{ src: carneGuiso, alt: 'Carne guisada en salsa con patatas fritas en La Fragua, Cáceres' },
	{ src: tarta, alt: 'Tarta semifría de queso casera con salsa de frutos rojos de La Fragua' },
	{ src: ensalada, alt: 'Ensalada de tomate con aceitunas y pimientos de La Fragua' },
	{ src: revuelto, alt: 'Revuelto de judías verdes con huevo de Restaurante la Fragua' },
	{ src: empanada, alt: 'Carne empanada en salsa con patatas fritas en La Fragua' },
	{ src: carneTomate, alt: 'Carne en salsa de tomate con patatas y ensalada en La Fragua' },
	{ src: carrillada, alt: 'Carne guisada con patatas en su salsa de Restaurante la Fragua' },
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	acceptsReservations: true,
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['La Fragua', 'La Fragua Garganta la Olla', 'Restaurante La Fragua Cáceres'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 927 17 95 71',
	priceRange: BUSINESS.priceRange,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Extremeña', 'Española', 'Cocina tradicional'],
	areaServed: [
		{ '@type': 'AdministrativeArea', name: 'La Vera' },
		{ '@type': 'City', name: 'Garganta la Olla' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId }],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday'],
			opens: '13:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '13:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '13:00',
			closes: '15:30',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Reserva por teléfono', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El restaurante', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Restaurante la Fragua · Cocina extremeña en Garganta la Olla (Cáceres)';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#33474e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante la Fragua, La Fragua Garganta la Olla, comer en Garganta la Olla, restaurante La Vera, cocina extremeña, migas extremeñas, menú del día Garganta la Olla, Garganta la Olla Cáceres, restaurante casco antiguo Garganta la Olla"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Restaurante la Fragua · Cocina extremeña en Garganta la Olla"
			ogDescription="Migas con huevo, carnes de guiso, menú del día y tarta de queso casera en una casa de piedra de Garganta la Olla (Cáceres). 4,4 en Google con 660 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de piedra de Restaurante la Fragua, en Garganta la Olla (Cáceres)"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#33474e"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			postalCode={BUSINESS.postalCode}
			phone="+34927179571"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Fragua"
			subtitle="Cocina extremeña · La Vera"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Toril · Garganta la Olla"
				title="Cocina extremeña<br /><em>en La Vera.</em>"
				lede={`Migas con huevo, carnes de guiso y tarta de queso casera en una casa de piedra del casco antiguo de Garganta la Olla. Menú del día y cocina de siempre, todos los días desde la una. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={fachada}
				imageAlt="Fachada de piedra de Restaurante la Fragua, con su cartel de forja, en Garganta la Olla"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)` },
					{ label: 'Horario', html: 'Mar–Sáb 13:00–23:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phoneDisplay}</b>` },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece La Fragua" items={SERVICIOS} />

			<LocalAbout
				label="El restaurante"
				title="Piedra, fuego<br /><em>y mantel.</em>"
				paragraphs={[
					`La Fragua es una casa de piedra con el cartel de forja en la calle Toril, 4, en el casco antiguo de Garganta la Olla (${BUSINESS.postalCode}, Cáceres). Dentro, comedor de madera y mantel; fuera, unas mesas altas junto a la puerta.`,
					'La cocina es extremeña y sin aspavientos: migas con huevo, revueltos de la huerta, pimientos con ventresca, chipirones, secreto y carnes en salsa. De postre, la tarta semifría de queso casera, que es lo que más se repite en las reseñas.',
					'La ficha de Google no publica carta ni precios, así que aquí no se inventan: esta web resume lo que se ve en sus fotos y lo que cuentan sus clientes. Para precios, menú del día y disponibilidad se llama al restaurante.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Se repiten el menú «asequible y de buena calidad», las migas, los pimientos con ventresca y la tarta de queso.`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.cid, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Migas, guisos<br /><em>y tarta de queso.</em>"
				description="Resumen de lo que se sirve, sacado de las fotos de la ficha de Google Maps y de las reseñas. No es la carta completa ni tiene precios: se consultan en el restaurante."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La carta cambia con el mercado y la temporada. Si vas por un plato concreto, llama antes: no publicamos precios porque el restaurante no los tiene publicados."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La casa<br /><em>y la mesa.</em>"
				description="Estas fotografías proceden del perfil de Restaurante la Fragua en Google Maps: la fachada, los platos de cuchara, las carnes y los postres de la casa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Nos vemos<br /><em>en la calle Toril.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google. De martes a sábado el servicio es continuo de 13:00 a 23:00; el lunes solo abre a mediodía y el domingo cierra a las 15:30."
				mapTitle="Mapa de Restaurante la Fragua en la calle Toril, 4, Garganta la Olla (Cáceres)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Fragua · Garganta la Olla"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva llamando al restaurante. La ficha de Google solo marca asientos adaptados, así que si necesitas acceso o aseo adaptados conviene preguntar antes por teléfono."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.cid, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a La Fragua"
		/>
	</body>
</html>
