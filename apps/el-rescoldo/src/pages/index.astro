---
import '../styles/global.css';

const business = {
	name: 'El Rescoldo',
	street: 'Carretera Patria, s/n',
	area: 'La Muela',
	city: 'Vejer de la Frontera',
	postalCode: '11150',
	phone: '+34 634 19 88 15',
	latitude: 36.2692503,
	longitude: -6.0047947,
	site: 'https://el-rescoldo.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/El+Rescoldo/@36.2692503,-6.0047947,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c471249016029:0x67c85ee0280079ac!8m2!3d36.2692503!4d-6.0047947!16s%2Fg%2F11yl4drkh8?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=15&output=embed`;
const phoneHref = 'tel:+34634198815';

const specialties = [
	{
		kicker: 'De la brasa',
		title: 'Carnes asadas',
		text: 'Restaurante de carne y asador: brasa de verdad como protagonista, del desayuno a la cena.',
	},
	{
		kicker: 'Al aire libre',
		title: 'Barbacoa',
		text: 'Barbacoa y cocina mediterránea para compartir en el jardín, de día o al atardecer.',
	},
	{
		kicker: 'Para empezar',
		title: 'Tapas y café',
		text: 'Bar y cafetería además de restaurante: desayunos, bebidas y tapeo junto a la carretera.',
	},
	{
		kicker: 'El entorno',
		title: 'Jardín con vistas',
		text: 'Espacio amplio y agradable al aire libre, con vistas abiertas. Ideal en los meses buenos.',
	},
	{
		kicker: 'De siempre',
		title: 'Cocina mediterránea',
		text: 'Base mediterránea con comedor además de brasa: platos para todos los momentos del día.',
	},
	{
		kicker: 'En ruta',
		title: 'Parada en Patria',
		text: 'En la carretera de Patria, junto a La Muela: parada natural entre Vejer y la costa.',
	},
];

const gallery = [
	{ src: '/fotos/brasas.svg', alt: 'Ilustración de las brasas de El Rescoldo — sustituye por foto propia' },
	{ src: '/fotos/carnes.svg', alt: 'Ilustración de carnes a la brasa — sustituye por foto propia del asador' },
	{ src: '/fotos/jardin.svg', alt: 'Ilustración del jardín al atardecer — sustituye por foto propia' },
	{ src: '/fotos/barbacoa.svg', alt: 'Ilustración de la barbacoa — sustituye por foto propia' },
	{ src: '/fotos/desayuno.svg', alt: 'Ilustración del café y desayuno — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está El Rescoldo?',
		a: 'En Carretera Patria, s/n, 11150 Vejer de la Frontera (Cádiz), en la zona de La Muela, entre Vejer y la costa.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'El horario es de temporada y cambia a lo largo del año. Llama al 634 19 88 15 para confirmar el día y reservar.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'Sí, conviene reservar en el 634 19 88 15, sobre todo en fin de semana y temporada alta.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Asador y barbacoa con cocina mediterránea: carnes a la brasa como plato fuerte, además de bar y cafetería con desayunos, bebidas y comedor para mediodía y noche.',
	},
	{
		q: '¿Tiene terraza o jardín?',
		a: 'Sí: un jardín amplio y agradable con vistas, ideal para comer al aire libre de día o al atardecer.',
	},
];

const description =
	'El Rescoldo: asador y restaurante de carne en Ctra. Patria s/n, Vejer de la Frontera. Brasa, barbacoa y jardín con vistas. Reservas en el 634 19 88 15.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 634 19 88 15',
	image: [`${business.site}/fotos/brasas.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Asador', 'Barbacoa', 'Mediterránea', 'Carne'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Jardín con vistas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos al aire libre', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Bar y cafetería', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.2,
		reviewCount: 9,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#2b160c" />
		<meta name="description" content="El Rescoldo: asador y restaurante de carne en Ctra. Patria s/n, Vejer de la Frontera. Brasa, barbacoa y jardín con vistas. Reservas en el 634 19 88 15." />
		<meta name="keywords" content="El Rescoldo Vejer, asador Vejer Frontera, barbacoa Cádiz, restaurante carne Vejer, Ctra Patria restaurante, jardín Vejer cenar" />
		<meta name="author" content="El Rescoldo" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>El Rescoldo | Asador con jardín en Vejer de la Frontera</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="El Rescoldo · Brasa y jardín en Vejer de la Frontera" />
		<meta property="og:description" content="Carnes a la brasa, barbacoa mediterránea y jardín con vistas en Ctra. Patria s/n, Vejer. Reservas: 634 19 88 15." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/brasas.svg`} />
		<meta property="og:image:alt" content="El Rescoldo, asador en Vejer de la Frontera" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="El Rescoldo · Asador con jardín en Vejer de la Frontera" />
		<meta name="twitter:description" content="Brasa, barbacoa y jardín con vistas en Ctra. Patria s/n, Vejer." />
		<meta name="twitter:image" content={`${business.site}/fotos/brasas.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Vejer de la Frontera" />
		<meta name="geo.position" content="36.2692503;-6.0047947" />
		<meta name="ICBM" content="36.2692503, -6.0047947" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="El Rescoldo, inicio">
				<span class="brand-mark" aria-hidden="true">R</span>
				<span class="brand-name">El Rescoldo <small>Vejer · Ctra. Patria</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#asador">El asador</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>634 19 88 15</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Ctra. Patria, s/n · Vejer</p>
					<h1 id="hero-title">Brasa de verdad<br />con jardín <em>y vistas.</em></h1>
					<p class="hero-lede">
						Asador y restaurante de carne junto a La Muela: barbacoa, cocina mediterránea y un jardín
						amplio para comer al aire libre, de día o al atardecer.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Reservar 634 19 88 15</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,2</b> en Tripadvisor</li>
						<li>Asador · Barbacoa</li>
						<li>Jardín con vistas</li>
						<li>Mediodía y noche</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/fotos/brasas.svg" alt="Ilustración de las brasas de El Rescoldo en Vejer de la Frontera" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Ctra. Patria · Vejer</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>4,2</b><span>Tripadvisor</span></div>
					<div><b>Br</b><span>Brasa viva</span></div>
					<div><b>Jar</b><span>Jardín amplio</span></div>
				</div>
				<ul class="services">
					<li>Asador</li>
					<li>Barbacoa</li>
					<li>Jardín</li>
					<li>Bar y café</li>
					<li>Comedor</li>
					<li>Reservas</li>
				</ul>
			</section>

			<section class="about section-pad" id="asador">
				<p class="section-label"><span aria-hidden="true"></span> Un asador en La Muela</p>
				<div class="about-grid">
					<h2>La buena comida<br />empieza antes <em>de sentarse.</em></h2>
					<div class="about-copy">
						<p>
							El Rescoldo está en Carretera Patria, s/n, en la zona de La Muela de Vejer de la Frontera.
							Asador y restaurante de carne con barbacoa y base mediterránea, además de bar y cafetería
							para desayunos y bebidas.
						</p>
						<p>
							Su seña es el jardín: un espacio amplio y agradable al aire libre, con vistas abiertas,
							ideal tanto de día como al atardecer. Comedor para mediodía y noche.
						</p>
						<p class="about-note">
							El horario es de temporada y cambia a lo largo del año. Llama al 634 19 88 15 para confirmar
							el día y reservar, sobre todo en fin de semana.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de la brasa.</em></h2>
					</div>
					<p>
						Propuesta de asador según su ficha pública: carnes, barbacoa y mediterránea, con bar y
						comedor. Confirma la carta del día al reservar.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El asador<br /><em>y su jardín.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del local.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Ctra. Patria, s/n</p>
					<h2>Ven a la brasa<br /><em>a Vejer.</em></h2>
					<p class="address">
						{business.street} ({business.area})<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Temporada</th>
								<td>Horario variable · confirma por teléfono</td>
							</tr>
							<tr>
								<th scope="row">Reservas</th>
								<td>634 19 88 15</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">El local amplía o reduce horario según temporada. Llama antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Reservar mesa ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 634 19 88 15</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de El Rescoldo en Ctra. Patria s/n, Vejer de la Frontera" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> El Rescoldo · Vejer</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">R</span>
				<p>El Rescoldo<small>{business.street} · {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} El Rescoldo · Vejer de la Frontera. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>

		<a class="mobile-call" href={phoneHref}>Reservar mesa <span>634 19 88 15</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
