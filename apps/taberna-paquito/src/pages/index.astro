---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	descripcionTitular,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	mencionados,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Taberna Paquito | Brasa de carnes y pescados en Sanlúcar';
const description =
	'Taberna Paquito, en la calle Torre de Arena de Sanlúcar de Barrameda: carnes y pescados frescos a la brasa. 4,1 sobre 5 con 222 reseñas.';
const keywords =
	'Taberna Paquito, Paquito Sanlúcar, taberna Sanlúcar de Barrameda, carnes a la brasa Sanlúcar, pescado a la brasa Sanlúcar, Torre de Arena Sanlúcar, comer a la brasa Cádiz, Taberna Paquito teléfono';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas diez fotografías y el manifiesto de la descarga no
 * atribuye autor, así que no se inventa una descripción ni una atribución: los `alt` avisan solo
 * de dónde salen.
 */
const altFoto =
	'Fotografía publicada en la ficha de Google Maps de Taberna Paquito, en Sanlúcar de Barrameda';
const altOg = 'Fotografía de Taberna Paquito publicada en su ficha de Google Maps';

/** Galería completa: las diez fotografías de la ficha, en el orden en que se descargaron. */
const galeria = [
	'taberna-paquito-vertical-01.jpg',
	'taberna-paquito-apaisada-05.jpg',
	'taberna-paquito-vertical-02.jpg',
	'taberna-paquito-vertical-03.jpg',
	'taberna-paquito-apaisada-06.jpg',
	'taberna-paquito-vertical-04.jpg',
	'taberna-paquito-vertical-07.jpg',
	'taberna-paquito-vertical-08.jpg',
	'taberna-paquito-vertical-09.jpg',
	'taberna-paquito-vertical-10.jpg',
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#17130f" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CA" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<header class="topbar">
			<div class="topbar-row">
				<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
					<span class="brand-mark" aria-hidden="true">
						P
					</span>
					<span class="brand-text">
						Paquito
						<small>Taberna · Sanlúcar</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					<a href="#brasa">La brasa</a>
					<a href="#citas">Qué se cita</a>
					<a href="#fotos">Las fotos</a>
					<a href="#horario">Horario</a>
					<a href="#preguntas">Preguntas</a>
				</nav>
				<a class="topbar-phone" href={phoneHref}>
					<span aria-hidden="true">☎</span>
					{business.phone}
				</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<div class="hero-tags">
							<p class="eyebrow">Sanlúcar de Barrameda · Brasa</p>
							<span class="badge-pill">Carnes y pescados</span>
						</div>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<blockquote class="hero-owner">
							«{descripcionTitular}»<cite>Descripción del titular en Google Maps</cite>
						</blockquote>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>
								Llamar al {business.phone}
							</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas
								</strong>
							</li>
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
						</ul>
					</div>

					<div class="hero-media">
						<figure class="hero-shot hero-shot-a">
							<Image
								src={foto('taberna-paquito-vertical-01.jpg')}
								alt={altFoto}
								widths={[360, 540, 760]}
								sizes="(max-width: 1080px) 45vw, 22vw"
								format="avif"
								quality={68}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</figure>
						<figure class="hero-shot hero-shot-b">
							<Image
								src={foto('taberna-paquito-apaisada-05.jpg')}
								alt={altFoto}
								widths={[360, 540, 760]}
								sizes="(max-width: 1080px) 45vw, 22vw"
								format="avif"
								quality={68}
								loading="eager"
								decoding="async"
							/>
						</figure>
						<div class="hero-shot-c">
							<strong>A la brasa</strong>
							<small>Fotos de la ficha</small>
						</div>
						<p class="hero-caption">Imágenes publicadas por el local en su ficha de Google Maps.</p>
					</div>
				</div>
			</section>

			<div class="band">
				<span>Carnes a la brasa</span>
				<span>Pescado y sardinas</span>
				<span>Todos los días, dos turnos</span>
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 · {business.reviewCount} reseñas
				</span>
			</div>

			<section class="section" id="brasa" aria-labelledby="brasa-title">
				<div class="wrap brasa-grid">
					<figure class="brasa-photo">
						<Image
							src={foto('taberna-paquito-apaisada-06.jpg')}
							alt={altFoto}
							widths={[520, 800, 1100]}
							sizes="(max-width: 1080px) 92vw, 44vw"
							format="avif"
							quality={70}
							loading="lazy"
							decoding="async"
						/>
					</figure>

					<div class="brasa-text">
						<p class="kicker">La brasa</p>
						<h2 class="title" id="brasa-title">
							Carne y pescado,
							<br />
							<em>frescos y a la brasa.</em>
						</h2>
						<p>
							Taberna "Paquito" es una taberna de Sanlúcar de Barrameda en la calle Torre de Arena.
							Google la clasifica como <strong>taberna</strong> y le da{' '}
							<strong>{business.rating.toLocaleString('es-ES')} sobre 5</strong> con{' '}
							<strong>{business.reviewCount.toLocaleString('es-ES')} reseñas</strong>.
						</p>
						<p>
							La ficha no publica carta ni precios, pero sí una descripción escrita por el propio
							local. Es la que resume qué se hace aquí, y se recoge tal cual:
						</p>
						<blockquote class="brasa-quote">
							«{descripcionTitular}»<cite>Descripción del titular en Google Maps</cite>
						</blockquote>
						<p>
							Las reseñas que Google destaca apuntan a lo mismo: carnes a la brasa, sardinas y
							pescado a la brasa de carbón. No hay más detalle porque la ficha no publica una carta,
							así que esta web no inventa platos ni importes.
						</p>
						<ul class="tag-list" aria-label="Datos que publica la ficha">
							<li>{business.category}</li>
							<li>Brasa</li>
							<li>Dos turnos diarios</li>
							<li>Acceso adaptado</li>
							<li>Aseo adaptado</li>
							<li>Sin aparcamiento adaptado</li>
						</ul>
					</div>
				</div>
			</section>

			<section class="section citas" id="citas" aria-labelledby="citas-title">
				<div class="wrap">
					<p class="kicker">Lo que se cita</p>
					<h2 class="title" id="citas-title">
						Brasa, carbón
						<br />
						<em>y sardinas.</em>
					</h2>
					<p class="lead">
						Cuatro nombres que aparecen en la descripción del titular o en las reseñas que Google
						destaca. No es la carta del local: la ficha no la publica y aquí no se completa con
						platos ni precios que no estén escritos.
					</p>
					<div class="citas-grid">
						{mencionados.map((item, index) => (
							<article class="cita">
								<span class="cita-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<strong>{item.nombre}</strong>
								<span class="origen">{item.origen}</span>
								<p>{item.nota}</p>
							</article>
						))}
					</div>
					<p class="citas-note">
						Para saber qué hay hoy y cuánto cuesta, la ficha solo ofrece el teléfono del local:{' '}
						<a href={phoneHref}>{business.phone}</a>. También puedes leer las{' '}
						<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
							reseñas completas en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<div class="reviews-head">
						<div>
							<p class="kicker">Las reseñas</p>
							<h2 class="title" id="resenas-title">
								Lo que dicen
								<br />
								<em>en Google.</em>
							</h2>
						</div>
						<p class="score">
							<strong>{business.rating.toLocaleString('es-ES')}</strong>
							<span>{business.reviewCount.toLocaleString('es-ES')} reseñas</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
								Ver todas ↗
							</a>
						</p>
					</div>
					<div class="reviews-grid">
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>«{review.text}»</p>
								<footer>
									<strong>{review.rating} sobre 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
					<p class="reviews-note">
						Son las tres reseñas que la ficha destaca, copiadas tal cual (con su ortografía). No
						representan a todos los clientes: son una muestra de las{' '}
						{business.reviewCount.toLocaleString('es-ES')} opiniones publicadas.
					</p>
				</div>
			</section>

			<section class="section galeria" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						Taberna Paquito
						<br />
						<em>en diez imágenes.</em>
					</h2>
					<p class="lead">
						Son las diez fotografías que el local publica en su ficha de Google Maps. La ficha no
						describe su contenido y el manifiesto de la descarga no atribuye autor, así que se
						muestran sin pie de autor y sin una descripción inventada.
					</p>
					<div class="galeria-grid">
						{galeria.map((name, index) => (
							<figure class="galeria-item" data-n={`${String(index + 1).padStart(2, '0')} / 10`}>
								<Image
									src={foto(name)}
									alt={altFoto}
									widths={[380, 560, 800]}
									sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
									format="avif"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))}
					</div>
					<p class="galeria-note">
						La ficha no publica la carta ni los precios, así que esta web no los reproduce. Para
						saber qué hay hoy, llama al <a href={phoneHref}>{business.phone}</a> o mira las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos y reseñas de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section horario" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Torre de Arena,
							<br />
							<em>todos los días.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
							<br />
							Plus Code: {business.plusCode}
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							El horario es el mismo los siete días: dos turnos, de 11:00 a 16:00 y de 19:00 a
							24:00. Es el de la ficha consultada el {site.consultado}; conviene confirmarlo por
							teléfono antes de ir, sobre todo en festivos.
						</p>
						<p class="access-title">Accesibilidad publicada en la ficha</p>
						<ul class="access-list">
							{accesibilidad.map((item) => (
								<li class:list={[{ 'is-no': !item.disponible }]}>{item.label}</li>
							))}
						</ul>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<div class="map-tag">
							<div>
								<strong>Taberna Paquito</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap faq-grid">
					<div class="faq-intro">
						<p class="kicker">Preguntas frecuentes</p>
						<h2 class="title" id="faq-title">
							Antes de
							<br />
							<em>venir a la brasa.</em>
						</h2>
						<p>
							Todo lo que publica la ficha de Taberna Paquito, resumido sin añadir nada. Lo que la
							ficha no dice se responde diciendo que no lo dice.
						</p>
					</div>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">
						P
					</span>
					<span>
						Taberna Paquito
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Taberna "Paquito" · {business.streetAddress} (
					{business.postalCode}
					{business.city}). Web informativa elaborada con los datos y las fotografías que el local
					publica en su ficha de Google Maps, consultada el {site.consultado}. Confirma horario y
					disponibilidad por teléfono antes de salir.
				</small>
			</div>
			<a class="mobile-call" href={phoneHref}>
				Llamar a Paquito <span>{business.phone}</span>
			</a>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
