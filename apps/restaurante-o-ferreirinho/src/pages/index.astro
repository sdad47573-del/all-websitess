---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import bife from '../assets/fotos/restaurante-o-ferreirinho-vertical-07.jpg';
import cozido from '../assets/fotos/restaurante-o-ferreirinho-apaisada-09.jpg';
import peixe from '../assets/fotos/restaurante-o-ferreirinho-vertical-04.jpg';
import marisco from '../assets/fotos/restaurante-o-ferreirinho-apaisada-02.jpg';
import migas from '../assets/fotos/restaurante-o-ferreirinho-apaisada-03.jpg';
import sobremesa from '../assets/fotos/restaurante-o-ferreirinho-vertical-01.jpg';
import caracois from '../assets/fotos/restaurante-o-ferreirinho-apaisada-05.jpg';
import guisado from '../assets/fotos/restaurante-o-ferreirinho-vertical-10.jpg';
import pratosDoDia from '../assets/fotos/restaurante-o-ferreirinho-panoramica-08.jpg';
import sopa from '../assets/fotos/restaurante-o-ferreirinho-apaisada-06.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
} from '../data/site';

const description = BUSINESS.description;

const galeria = [
	{
		src: bife,
		alt: 'Bife a la parrilla con patatas fritas, ensalada y un vaso de vino tinto en O Ferreirinho',
	},
	{
		src: marisco,
		alt: 'Arroz de marisco con gambas y mejillones, con cilantro por encima, servido en la cazuela',
	},
	{
		src: migas,
		alt: 'Migas con trozos de cerdo, chouriço y jamón sobre una fuente blanca',
	},
	{
		src: sobremesa,
		alt: 'Tarta de chocolate con galleta Lotus en la base y cobertura brillante, sobre un pie de pastelería',
	},
	{
		src: guisado,
		alt: 'Carne guisada en salsa oscura con arroz blanco, grelos y salsa fresca de tomate',
	},
	{
		src: peixe,
		alt: 'Pescado entero a la brasa con patatas asadas y grelos en una fuente, en O Ferreirinho',
	},
	{
		src: caracois,
		alt: 'Ració de caracóis en plato blanco con el cuenco de salsa amarilla al lado',
	},
	{
		src: pratosDoDia,
		alt: 'Tres platos de pratos do dia: pollo y costilla guisados, puré y alubias en salsa',
	},
	{
		src: sopa,
		alt: 'Cuenco de sopa con rodajas de chouriço, morcilla y berza en O Ferreirinho',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.fullName,
	alternateName: [BUSINESS.name, 'Restaurante O Ferreirinho Bucelas', 'O Ferreirinho Loures'],
	slogan: 'Comida casera a pie de la EN-116',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 934 802 421',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Portuguesa', 'Casera', 'Parrilla'],
	areaServed: [
		{ '@type': 'City', name: 'Bucelas' },
		{ '@type': 'City', name: 'Loures' },
		{ '@type': 'AdministrativeArea', name: 'Área Metropolitana de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '07:30',
			closes: '21:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'O Ferreirinho · Comida casera en Bucelas (Loures)';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-o-ferreirinho-apaisada-09.jpg": cozido,
	"restaurante-o-ferreirinho-vertical-07.jpg": bife,
	"restaurante-o-ferreirinho-apaisada-02.jpg": marisco,
	"restaurante-o-ferreirinho-apaisada-03.jpg": migas,
	"restaurante-o-ferreirinho-vertical-01.jpg": sobremesa,
	"restaurante-o-ferreirinho-vertical-10.jpg": guisado,
	"restaurante-o-ferreirinho-vertical-04.jpg": peixe,
	"restaurante-o-ferreirinho-apaisada-05.jpg": caracois,
	"restaurante-o-ferreirinho-panoramica-08.jpg": pratosDoDia,
	"restaurante-o-ferreirinho-apaisada-06.jpg": sopa,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#6d1f24" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;500;600;700&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="O Ferreirinho, Restaurante O Ferreirinho, restaurante Bucelas, comer en Bucelas, pratos do dia Bucelas, restaurante Loures, comida caseira Loures, N116 Bucelas, grelhados Bucelas, caracóis Bucelas, arroz de marisco Bucelas"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="O Ferreirinho · Comida casera en Bucelas"
			ogDescription="Pratos do dia a 7,50 €, pescado a la brasa, bifes y arroz de marisco, de lunes a sábado. 4,3 en Google con 141 reseñas. Tel. 934 802 421."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bife a la parrilla con patatas fritas y vino tinto en O Ferreirinho, Bucelas"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#6d1f24"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone="+351934802421"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.municipality}`}
			countryName="Portugal"
			contact={{
				street: BUSINESS.street,
				locality: `${BUSINESS.city}, ${BUSINESS.municipality}`,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				phone: '+351 934 802 421',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[cozido]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Restaurante · Bucelas"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a O Ferreirinho"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
