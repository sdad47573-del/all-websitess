---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import mostrador from '../assets/fotos/boutique-del-pan-la-pelusa-vertical-01.jpg';
import fachada from '../assets/fotos/boutique-del-pan-la-pelusa-vertical-02.jpg';
import cartel from '../assets/fotos/boutique-del-pan-la-pelusa-vertical-03.jpg';
import precios from '../assets/fotos/boutique-del-pan-la-pelusa-vertical-04.jpg';
import bollo from '../assets/fotos/boutique-del-pan-la-pelusa-vista-5-05.jpg';
import roscon from '../assets/fotos/boutique-del-pan-la-pelusa-vertical-06.jpg';
import horario from '../assets/fotos/boutique-del-pan-la-pelusa-vertical-07.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Boutique del Pan la Pelusa · Panadería en Bailén-Miraflores, Málaga';
const description =
	'Boutique del Pan la Pelusa C.B., panadería en la Plaza Basconia, 1 (Bailén-Miraflores, 29010 Málaga). Pan, bollería, dulces y empanadas. De lunes a sábado de 8:30 a 14:30 y domingos de 8:30 a 14:00.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#la-pelusa`,
	name: BUSINESS.name,
	alternateName: [
		'La Pelusa',
		'Panificadora La Pelusa',
		'Boutique del Pan la Pelusa Málaga',
	],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 952 61 45 99',
	currenciesAccepted: 'EUR',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:30',
			closes: '14:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '08:30',
			closes: '14:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Pan exquisito y de buenísima calidad.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Muy buen trato y el pan buenísimo.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 4, bestRating: 5 },
			reviewBody: 'Probad sus estupendas empanadas.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de la Boutique del Pan la Pelusa con el rótulo verde y el logotipo de la panificadora en la Plaza Basconia',
	},
	{
		src: mostrador,
		alt: 'Mostrador de la panadería con bolsas de pan, vitrinas de bollería y el cartel verde «Panificadora La Pelusa»',
	},
	{
		src: precios,
		alt: 'Lista de precios del pan colgada en un panel de madera del interior del local',
	},
	{
		src: bollo,
		alt: 'Bollo redondo de pan de corteza dorada sobre un plato de mosaico',
	},
	{
		src: roscon,
		alt: 'Rosco de Reyes con frutas escarchadas verdes y rojas y azúcar perlado',
	},
	{
		src: horario,
		alt: 'Cartel del horario y aviso de aforo en el escaparate de la panadería',
	},
	{
		src: cartel,
		alt: 'Aviso de «Nuevo horario» y cartel de dos personas máximo en la puerta del local',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1d3c29" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Karla:wght@400..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Boutique del Pan la Pelusa, Panificadora La Pelusa, panadería Bailén-Miraflores, panadería Málaga, empanadas Málaga, Plaza Basconia, pan artesano 29010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería en la Plaza Basconia, 1 (Bailén-Miraflores). Pan, bollería, dulces y empanadas. De lunes a sábado de 8:30 a 14:30 y domingos de 8:30 a 14:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo verde de la Boutique del Pan la Pelusa en su fachada de Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1d3c29"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Pelusa"
			subtitle="Panadería · Bailén-Miraflores"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Plaza Basconia, 1 · Bailén-Miraflores"
				title="Pan de siempre, <br /><em>hecho cada mañana.</em>"
				lede={`La Boutique del Pan la Pelusa está en la Plaza Basconia, 1, en Bailén-Miraflores. Es una panadería de barrio con el rótulo verde de «Panificadora La Pelusa»: pan del día, bollería, dulces y empanadas. Abre de lunes a sábado de 8:30 a 14:30 y los domingos de 8:30 a 14:00. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={fachada}
				imageAlt="Rótulo verde de la Boutique del Pan la Pelusa sobre la fachada blanca, en la Plaza Basconia"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,3</b> en Google · 20 reseñas' },
					{ label: 'Horario', html: '<b>L–S 8:30–14:30</b> · dom 8:30–14:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> · encargos` },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Pan · empanadas · dulces"
			/>

			<LocalChips label="Lo que hay en La Pelusa" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una panadería <br /><em>de toda la vida.</em>"
				paragraphs={[
					'La Boutique del Pan la Pelusa C.B. está en la Plaza Basconia, 1, en Bailén-Miraflores (29010 Málaga). La fachada blanca lleva el rótulo verde con el nombre y el logotipo circular de «Panificadora La Pelusa».',
					'Dentro, el mostrador de acero comparte espacio con las vitrinas de bollería y dulces, las estanterías de madera y la zona del horno. En las fotos del perfil se ven bolsas de pan preparadas, bandejas de bollería y un cartel con los precios del pan.',
					'Las reseñas de Google destacan el pan y el trato: «Pan exquisito y de buenísima calidad», «Muy buen trato y el pan buenísimo». Otra deja una recomendación clara: «Probad sus estupendas empanadas».',
					'La ficha publica el teléfono 952 61 45 99 y clasifica el negocio como panadería. No indica página web, correo ni redes, así que las consultas se atienden en el mostrador o por teléfono.',
				]}
				note="La ficha de Google no publica carta ni precios. Esta página solo cuenta lo que muestran las fotos del perfil, lo que dicen sus rótulos y lo que cuentan las reseñas."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Pan, empanadas <br />
							<em>y domingo.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que sale <br /><em>del horno.</em>"
				description="Sin carta ni precios publicados: esto es lo que muestran las fotos del local y lo que cuentan las reseñas de Google."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU_GROUPS}
				note="La ficha no recoge precios ni métodos de pago, así que esta web no publica importes. El surtido cambia a lo largo de la mañana: la panadería cierra a las 14:30 de lunes a sábado."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La casa, <br /><em>por dentro.</em>"
				description="Siete fotos de la ficha de Google Maps: la fachada, el mostrador, la lista de precios del pan, un bollo, un roscón de Reyes y los carteles de la puerta."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la Plaza <br /><em>Basconia.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`,
				]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de la Boutique del Pan la Pelusa en la Plaza Basconia, 1, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Pelusa · Plaza Basconia"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Street View', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Las consultas se atienden en el mostrador o por teléfono. La ficha de Google indica acceso para sillas de ruedas, pero no aparcamiento adaptado; tampoco detalla el mostrador ni el aseo."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar a La Pelusa"
			navAriaLabel="Enlaces de la Boutique del Pan la Pelusa"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
