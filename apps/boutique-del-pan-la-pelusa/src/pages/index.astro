---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import fachada from '../assets/fotos/boutique-del-pan-la-pelusa-vertical-02.jpg';
import mostrador from '../assets/fotos/boutique-del-pan-la-pelusa-vertical-01.jpg';
import rosco from '../assets/fotos/boutique-del-pan-la-pelusa-vertical-06.jpg';
import pan from '../assets/fotos/boutique-del-pan-la-pelusa-vista-5-05.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Boutique del Pan la Pelusa · Bailén-Miraflores';
const description =
	'Boutique del Pan la Pelusa, en Plaza Basconia, 1 (Bailén-Miraflores, 29010 Málaga). Panadería de barrio con pan y empanadas. Abierta todos los días.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#la-pelusa`,
	name: BUSINESS.name,
	alternateName: ['La Pelusa', 'Panificadora La Pelusa', 'Boutique del Pan La Pelusa Málaga'],
	description:
		'Panadería de barrio en la Plaza Basconia, 1, Bailén-Miraflores (29010 Málaga). Pan y empanadas, según las reseñas de su ficha de Google.',
	url: `${BUSINESS.siteUrl}/`,
	telephone: '+34952614599',
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:30',
			closes: '14:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '08:30',
			closes: '14:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	servesCuisine: 'Panadería',
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Horario', href: '#horario' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Dónde está', href: '#visitanos' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f4d3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,600;1,400&family=Public+Sans:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Boutique del Pan la Pelusa, panadería Bailén-Miraflores, panadería Plaza Basconia, pan Málaga 29010, empanadas Málaga, panificadora La Pelusa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan de barrio y empanadas en la Plaza Basconia, 1. Abierta todos los días por la mañana."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="El rótulo verde de Boutique del Pan la Pelusa sobre la fachada blanca"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1f4d3a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Boutique del Pan la Pelusa, inicio">
					<span class="brand-mark" aria-hidden="true">P</span>
					<span class="brand-name">
						La Pelusa
						<small>Boutique del Pan · Bailén-Miraflores</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-cta" href={BUSINESS.phoneHref}>
					{BUSINESS.phone} <span aria-hidden="true">↗</span>
				</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Bailén-Miraflores · 29010 Málaga</p>
						<h1 id="hero-title">La Pelusa<em>Boutique del Pan · Panificadora</em></h1>
						<p class="hero-lede">
							Una panadería de barrio en la Plaza Basconia, con el rótulo verde de toda la vida y
							la paloma de la panificadora en la puerta. Pan del día y empanadas, de 8:30 a 14:30.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="button button-ghost" href="#horario">Ver el horario</a>
						</div>
						<dl class="hero-facts">
							<div>
								<dt>Abre</dt>
								<dd>8:30</dd>
							</div>
							<div>
								<dt>Abierta</dt>
								<dd>Los 7 días</dd>
							</div>
							<div>
								<dt>Valoración</dt>
								<dd>4,3 · 20 reseñas</dd>
							</div>
						</dl>
					</div>

					<figure class="hero-media">
						<div class="hero-photo">
							<Image
								src={fachada}
								alt="El rótulo verde de Boutique del Pan la Pelusa sobre la fachada blanca, con el cartel de la paloma en la ventana"
								widths={[480, 720, 1024, 1400]}
								sizes="(max-width: 900px) 92vw, 46vw"
								format="avif"
								quality={74}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</div>
						<figcaption>
							<span>El rótulo de la fachada</span>
							<span>Foto de la ficha de Google</span>
						</figcaption>
						<span class="hero-seal" aria-hidden="true">
							<strong>4,3</strong>
							<small>20 reseñas<br />en Google</small>
						</span>
					</figure>
				</div>
			</section>

			<section class="chips-wrap wrap" aria-label="Lo que publica la ficha de Google">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<div class="about-grid">
					<div class="about-copy">
						<p class="section-label"><span aria-hidden="true"></span> La casa</p>
						<h2 id="about-title">El pan de siempre, al otro lado de la <em>Plaza Basconia.</em></h2>
						<p>
							La Pelusa ocupa un bajo en la Plaza Basconia, en el barrio de Bailén-Miraflores. En la
							fachada, el rótulo verde anuncia «Boutique del Pan la Pelusa» y junto a la ventana
							sigue el cartel de la panificadora con la paloma.
						</p>
						<p>
							La ficha de Google la clasifica solo como panadería y no incluye descripción del
							negocio. Lo que sí dicen las reseñas es bueno: «pan exquisito y de buenísima
							calidad», «el pan buenísimo» y una recomendación de probar «sus estupendas
							empanadas».
						</p>
						<p>
							La foto del interior de la galería muestra el mostrador con las bolsas de pan, las
							estanterías de madera y las bandejas de bollería, con la panificadora trabajando al
							fondo.
						</p>
						<div class="about-links">
							<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha en Google Maps <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href="#fotos">Ver las fotos</a>
						</div>
					</div>

					<figure class="about-media">
						<Image
							src={mostrador}
							alt="El interior de la panadería, con bolsas de pan en el mostrador, la estantería de madera y la panificadora al fondo"
							widths={[400, 640, 900]}
							sizes="(max-width: 900px) 92vw, 40vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>El mostrador y la panificadora</figcaption>
					</figure>
				</div>

				<ul class="highlights">
					{
						HIGHLIGHTS.map((item) => (
							<li>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section class="hours" id="horario" aria-labelledby="hours-title">
				<div class="wrap hours-grid">
					<div class="hours-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> Horario</p>
						<h2 id="hours-title">De ocho y media <em>a media mañana.</em></h2>
						<p class="hours-lede">
							La ficha publica horario de lunes a domingo, sin ningún día de cierre ni turno de
							tarde: de 8:30 a 14:30 entre semana y el sábado, y hasta las 14:00 el domingo.
						</p>
						<p class="hours-note">
							<strong>Ojo con los festivos.</strong> {HORARIO_AVISO}
						</p>
						<a class="hours-link" href={MAPS.place} target="_blank" rel="noreferrer">
							Comprobar en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>

					<div class="hours-table-wrap">
						<table class="hours-table">
							<caption class="visually-hidden">
								Horario publicado en la ficha de Google
							</caption>
							<tbody>
								{
									HORARIO.map((row) => (
										<tr>
											<th scope="row">{row.dia}</th>
											<td>{row.horas}</td>
										</tr>
									))
								}
							</tbody>
						</table>
						<p class="hours-foot">
							Horario publicado en la ficha pública de Google, consultada en octubre de 2026.
						</p>
					</div>
				</div>
			</section>

			<section class="fotos wrap" id="fotos" aria-labelledby="fotos-title">
				<div class="fotos-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Fotos</p>
						<h2 id="fotos-title">El pan <em>y el rosco.</em></h2>
					</div>
					<p>
						Las imágenes salen de la galería de la ficha de Google: la fachada, el mostrador, un pan
						de cerca y un rosco de Reyes. El resto de la galería son carteles de la puerta.
					</p>
				</div>

				<div class="fotos-grid">
					<figure class="foto">
						<Image
							src={pan}
							alt="Un pan redondo con la corteza abierta sobre un plato de mosaico"
							widths={[360, 540, 800]}
							sizes="(max-width: 900px) 92vw, 34vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>El pan del día</figcaption>
					</figure>
					<figure class="foto">
						<Image
							src={rosco}
							alt="Un rosco de Reyes con frutas escarchadas verdes y rojas y azúcar en grano"
							widths={[360, 540, 800]}
							sizes="(max-width: 900px) 92vw, 34vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Rosco de Reyes</figcaption>
					</figure>
				</div>
			</section>

			<section class="rating" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">Cuatro y tres, <em>con veinte reseñas.</em></h2>
						<p>
							La ficha de Google tiene una valoración de 4,3 sobre 5 con 20 reseñas en el momento
							de consultarla (octubre de 2026). El estado actualizado y las opiniones completas se
							ven en Google Maps.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<div class="rating-actions">
							<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
								Ver las reseñas en Google <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="rating-figure">
						<div class="rating-symbol" aria-hidden="true">
							<span class="rating-value">4,3</span>
							<span class="rating-stars">★★★★☆</span>
						</div>
						<p class="rating-caption">
							valoración media<br />
							con 20 reseñas publicadas
						</p>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Dónde está</p>
					<h2 id="visit-title">En la Plaza <em>Basconia, 1.</em></h2>
					<p class="address">
						{BUSINESS.street}<br />
						{BUSINESS.district}<br />
						{BUSINESS.postalCode} {BUSINESS.city}
					</p>

					<p class="visit-phone">
						<span>Teléfono</span>
						<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
					</p>

					<p class="hours-note">
						<strong>El teléfono es el que publica la ficha.</strong> No consta página web ni perfil
						social del negocio, así que esta página no enlaza ninguno.
					</p>

					<ul class="visit-list">
						<li>
							<span>Acceso</span>
							Google marca el acceso para sillas de ruedas.
						</li>
						<li>
							<span>Aparcamiento</span>
							La ficha indica que no hay aparcamiento adaptado.
						</li>
						<li>
							<span>Plus Code</span>
							{BUSINESS.plusCode}
						</li>
					</ul>

					<div class="visit-links">
						<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
							Ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Boutique del Pan la Pelusa en la Plaza Basconia, 1, Málaga"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Plaza Basconia, 1
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>entrar.</em></h2>
				<div class="faq-list">
					{
						FAQ.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">P</span>
						<p>
							Boutique del Pan la Pelusa
							<small>
								Panadería y panificadora<br />
								{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}
							</small>
						</p>
					</div>
					<nav aria-label="Enlaces del establecimiento">
						<a href={BUSINESS.phoneHref}>Llamar</a>
						<a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
						<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a href="#horario">Horario</a>
						<a href="/aviso-legal">Aviso legal</a>
					</nav>
				</div>
				<small class="legal">
					© {new Date().getFullYear()} {BUSINESS.name} · Datos y fotografías de la ficha pública de
					Google Maps, consultada en octubre de 2026. La web no publica carta ni precios porque la
					ficha no los incluye.
				</small>
				<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
				<p class="credit">
					<small
						>Creado por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a>
						· sur-digital.vercel.app</small
					>
				</p>
			</div>
		</footer>
	</body>
</html>
