---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	directionsUrl,
	hours,
	mapEmbedUrl,
	mapsUrl,
	resenas,
	site,
} from '../data/site';

// Fotos descargadas de la ficha de Google Maps, en `src/assets/fotos`, servidas con `<Image>`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const listaFotos = Object.keys(fotos)
	.sort()
	.map((ruta) => fotos[ruta].default);

const title = 'Son y Arepas · Arepas en Ciudad Real';
const description = `Son y Arepas, ${business.category.toLowerCase()} en la Calle de Las Cañas, 31 de Ciudad Real. ${business.reviewCount} reseñas en Google.`;
const telefono = business.phone.replace(/\s/g, '');
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta name="robots" content="index, follow" />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:card" content="summary_large_image" />
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Restaurant",
	"@id": "https://son-y-arepas.vercel.app/#negocio",
	"name": "Son y Arepas",
	"url": "https://son-y-arepas.vercel.app/",
	"description": "Son y Arepas, ${business.category.toLowerCase()} en la Calle de Las Cañas, 31 de Ciudad Real. ${business.reviewCount} reseñas en Google.",
	"image": "https://son-y-arepas.vercel.app/og.jpg",
	"telephone": "+34614052198",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 38.988952,
		"longitude": -3.923731
	},
	"hasMap": "https://www.google.com/maps/place/Son+y+Arepas/@38.988952,-3.923731,17z/data=!3m1!4b1!4m6!3m5!1s0xd6bc3182c082529:0xb8953f3621a35c22!8m2!3d38.988952!4d-3.923731!16s%2Fg%2F11yy16yvqc?hl=es"
}
</script>
</head>
	<body>
		<header class="hero" id="inicio">
			<div class="hero-grid">
				<div class="hero-copy">
					<p class="eyebrow">{business.category} · Ciudad Real</p>
					<h1 set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Snack bar en la Calle de Las Cañas, 31. {business.reviewCount} reseñas en Google.
					</p>
					<div class="hero-actions">
						<a class="button" href={mapsUrl} rel="noopener">Ver ficha en Google Maps</a>
						<a class="button secondary" href={directionsUrl} rel="noopener">Cómo llegar</a>
					</div>
				</div>
				{listaFotos[0] && (
					<Image src={listaFotos[0]} alt={`Fotografía de ${business.name} publicada en Google Maps`} widths={[640, 960]} sizes="(min-width: 800px) 50vw, 100vw" />
				)}
			</div>
		</header>

		<main>
			<section class="section" id="local" aria-labelledby="local-title">
				<h2 id="local-title">Dónde estamos</h2>
				<p>{business.streetAddress}, {business.postalCode} {business.city}. Teléfono: <a href={`tel:${telefono}`}>{business.phone}</a>.</p>
				<p>
					<a href={mapsUrl} rel="noopener">Abrir en Google Maps</a> ·
					<a href={directionsUrl} rel="noopener">Cómo llegar</a>
				</p>
				<iframe
					title={`Mapa de ${business.name}`}
					src={mapEmbedUrl}
					width="100%"
					height="320"
					style="border:0"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
			</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<h2 id="horario-title">Horario</h2>
				<table>
					<tbody>
						{hours.map((item) => (
							<tr>
								<th scope="row">{item.day}</th>
								<td>{item.service}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>

			<section class="section" id="resenas" aria-labelledby="resenas-title">
				<h2 id="resenas-title">Lo que dicen</h2>
				<p>{business.reviewCount} reseñas en Google.</p>
				{resenas.map((r) => (
					<blockquote>« {r.texto} »</blockquote>
				))}
				{accesibilidad.length > 0 && <p>Accesibilidad publicada en la ficha: {accesibilidad.join('; ')}.</p>}
			</section>

			{listaFotos.length > 1 && (
				<section class="section" id="fotos" aria-labelledby="fotos-title">
					<h2 id="fotos-title">Fotos</h2>
					<div class="galeria">
						{listaFotos.map((foto) => (
							<Image src={foto} alt={`Fotografía de ${business.name} publicada en Google Maps`} widths={[480, 800]} sizes="(min-width: 800px) 33vw, 50vw" />
						))}
					</div>
				</section>
			)}
		</main>

		<footer class="site-footer">
			<p>
				© {new Date().getFullYear()} {business.name}. Datos tomados de la ficha pública de Google Maps el {site.consultado}.
			</p>
			<p>
				<small>Creado por <a href="https://sur-digital.vercel.app" rel="noopener">Sur Digital</a> · sur-digital.vercel.app</small>
			</p>
		</footer>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-call" href="tel:+34614052198" aria-label="Llamar a Son y Arepas al +34 614 05 21 98"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"/></svg></a>
	<a class="fab-wa" href="https://wa.me/34614052198?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Son%20y%20Arepas." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Son y Arepas"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
