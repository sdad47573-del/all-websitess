---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/restaurante-san-jaime-35-apaisada-04.jpg';
import bodega from '../assets/fotos/restaurante-san-jaime-35-apaisada-01.jpg';
import pulpoMesa from '../assets/fotos/restaurante-san-jaime-35-vertical-02.jpg';
import zamburinas from '../assets/fotos/restaurante-san-jaime-35-apaisada-07.jpg';
import croquetas from '../assets/fotos/restaurante-san-jaime-35-vertical-05.jpg';
import pizza from '../assets/fotos/restaurante-san-jaime-35-vertical-03.jpg';
import carrillada from '../assets/fotos/restaurante-san-jaime-35-vertical-06.jpg';
import codilloCazuela from '../assets/fotos/restaurante-san-jaime-35-vertical-08.jpg';
import codillo from '../assets/fotos/restaurante-san-jaime-35-vertical-09.jpg';
import postre from '../assets/fotos/restaurante-san-jaime-35-apaisada-10.jpg';

const business = {
	name: 'Restaurante San Jaime 35',
	brand: 'San Jaime 35',
	tagline: 'Cocina española y pizzas al horno en Montanejos',
	street: 'C. San Jaime, 35',
	city: 'Montanejos',
	region: 'Comunitat Valenciana',
	postalCode: '12448',
	phone: '964 13 12 92',
	latitude: 40.0673444,
	longitude: -0.523705,
	rating: 4.5,
	reviewsCount: 1382,
	site: 'https://restaurante-san-jaime-35.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd5fd189bc919aa1:0x709d318f47eda81a';
const cidDecimal = '8114696595048343578';
const placeId = 'ChIJoZqRvInRXw0RGqjtR48xnXA';

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+San+Jaime+35/@40.0673444,-0.523705,17z/data=!3m1!4b1!4m6!3m5!1s0xd5fd189bc919aa1:0x709d318f47eda81a!8m2!3d40.0673444!4d-0.523705!16s%2Fg%2F11fpgxpmxy?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&q=Restaurante+San+Jaime+35&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34964131292';

const description =
	'Restaurante de cocina española y pizzería en Montanejos (Castellón): pulpo, croquetas caseras, carrillada y pizzas al horno. Abre todos los días de 12:00 a 1:00.';

const servicios = [
	'Cocina española',
	'Pizzería',
	'Pizzas al horno',
	'Pulpo a la brasa',
	'Croquetas caseras de sepia y pulpo',
	'Zamburiñas',
	'Carrillada con setas',
	'Callos con oreja',
	'Codillo con patatas',
	'Postres caseros',
	'Bodega con vinos de la tierra',
	'En el centro de Montanejos',
];

const grupos = [
	{
		title: 'Para picar',
		items: [
			{
				name: 'Patatas bravas',
				note: 'con salsa brava; «sabrosas», dicen en las reseñas',
			},
			{
				name: 'Croquetas caseras de sepia y pulpo',
				note: 'la ración que más se repite en las opiniones de Google',
			},
			{
				name: 'Pulpo a la brasa',
				note: 'con aceite, pimentón y sal gorda, servido entero en la mesa',
			},
			{
				name: 'Zamburiñas al horno',
				note: 'con su coral, aceite de oliva y un toque de ajo',
			},
		],
	},
	{
		title: 'Guisos de la casa',
		items: [
			{
				name: 'Carrillada con setas',
				note: 'estofada despacio, con patatas fritas para mojar',
			},
			{
				name: 'Callos con oreja',
				note: 'de los platos de cuchara que citan los clientes',
			},
			{
				name: 'Codillo con patatas',
				note: 'asado hasta que se separa del hueso, en su salsa',
			},
		],
	},
	{
		title: 'Pizzas al horno',
		items: [
			{
				name: 'Pizza de jamón',
				note: 'con lonchas de jamón y orégano, recién salida del horno',
			},
			{
				name: 'Pizza de la casa',
				note: 'las que se preparan ese día; se preguntan en la mesa',
			},
		],
	},
	{
		title: 'Postres y café',
		items: [
			{
				name: 'Tarta de chocolate',
				note: 'con nata montada y sirope de chocolate',
			},
			{
				name: 'Carajillo',
				note: 'el café de después, como lo piden los de la casa',
			},
		],
	},
];

const galeria = [
	{
		src: bodega,
		alt: 'Pared de cajas de vino y botellas en la bodega de Restaurante San Jaime 35, Montanejos',
	},
	{
		src: pulpoMesa,
		alt: 'Pulpo a la brasa en un plato con una copa de vino blanco en San Jaime 35, Montanejos',
	},
	{
		src: zamburinas,
		alt: 'Zamburiñas al horno con aceite de oliva en Restaurante San Jaime 35, Montanejos',
	},
	{
		src: croquetas,
		alt: 'Croquetas caseras de sepia y pulpo con alioli en San Jaime 35, Montanejos',
	},
	{
		src: pizza,
		alt: 'Pizza de jamón recién horneada en Restaurante San Jaime 35, Montanejos',
	},
	{
		src: carrillada,
		alt: 'Carrillada estofada con patatas fritas en San Jaime 35, Montanejos',
	},
	{
		src: codilloCazuela,
		alt: 'Codillo con patatas en cazuela de hierro en Restaurante San Jaime 35, Montanejos',
	},
	{
		src: codillo,
		alt: 'Codillo asado con patatas y su salsa en San Jaime 35, Montanejos',
	},
	{
		src: postre,
		alt: 'Tarta de chocolate con nata y sirope en Restaurante San Jaime 35, Montanejos',
	},
];

const faqs = [
	{
		q: '¿Dónde está Restaurante San Jaime 35?',
		a: 'En la calle San Jaime, 35, 12448 Montanejos (Castellón), en el centro del pueblo y en pleno Alto Mijares. Desde esta página puedes abrir Google Maps y trazar la ruta con el botón «Cómo llegar».',
	},
	{
		q: '¿Qué tipo de comida sirven?',
		a: 'La ficha de Google lo clasifica como restaurante de cocina española y pizzería. En las mesas se ven el pulpo a la brasa, las croquetas caseras de sepia y pulpo, las zamburiñas, la carrillada con setas, los callos con oreja, el codillo con patatas y las pizzas recién horneadas, con postres caseros para terminar.',
	},
	{
		q: '¿Cuál es el horario de San Jaime 35?',
		a: 'Abre de 12:00 a 1:00 de la madrugada los domingos, lunes, jueves, viernes y sábados. Los martes y los miércoles permanece cerrado. Al ser un horario largo y de pueblo, conviene confirmarlo por teléfono antes de desplazarse, sobre todo en festivos.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'No hay reserva online ni formulario en esta web: se reserva llamando al 964 13 12 92. En fin de semana y en temporada de visitas a Montanejos conviene llamar con antelación, porque el comedor se llena.',
	},
	{
		q: '¿Tienen pizzas?',
		a: 'Sí. La ficha lo incluye como pizzería y en sus fotos aparece la pizza de jamón con orégano recién salida del horno. Además de las pizzas, la carta habitual es de cocina española, con guisos y pescado.',
	},
	{
		q: '¿Qué se puede visitar cerca?',
		a: 'Montanejos es conocido por la Fuente de los Baños y las pozas del río Mijares, además del embalse de Arenós y las rutas de la sierra. El restaurante está en el casco del pueblo, así que se puede ir andando desde el aparcamiento y volver a comer después del baño.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['San Jaime 35', 'Restaurante San Jaime 35 Montanejos', 'San Jaime 35 Montanejos'],
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 964 13 12 92',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Cocina española', 'Pizzería', 'Pizzas al horno', 'Cocina tradicional'],
	areaServed: [
		{ '@type': 'City', name: 'Montanejos' },
		{ '@type': 'AdministrativeArea', name: 'Alto Mijares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday', 'Monday', 'Thursday', 'Friday', 'Saturday'],
			opens: '12:00',
			closes: '01:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>San Jaime 35 · Cocina española en Montanejos</title>
		<meta name="theme-color" content="#2f4a34" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Restaurante San Jaime 35, San Jaime 35 Montanejos, restaurante Montanejos, comer en Montanejos, pizzería Montanejos, pulpo Montanejos, croquetas caseras Montanejos, cocina española Alto Mijares, C. San Jaime 35, restaurante Castellón interior, pizzas al horno Montanejos"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="San Jaime 35 · Cocina española en Montanejos"
			ogDescription="Pulpo a la brasa, croquetas caseras de sepia y pulpo, carrillada y pizzas al horno en el centro de Montanejos. 4,5 en Google con 1.382 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Pulpo a la brasa con pimentón y aceite de oliva de Restaurante San Jaime 35, Montanejos"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#2f4a34"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Montanejos, Castellón"
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="35"
			name={business.brand}
			subtitle="Cocina española · Montanejos"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. San Jaime, 35 · Montanejos"
				title="Cocina de pueblo,<br />pulpo a la brasa<br /><em>y pizzas al horno.</em>"
				lede="San Jaime 35 es el restaurante de la calle San Jaime, en el centro de Montanejos. Pulpo a la brasa, croquetas caseras de sepia y pulpo, zamburiñas, guisos de cuchara como la carrillada con setas o el codillo, y pizzas recién horneadas, con una bodega de vinos de la tierra y postres caseros."
				image={heroImage}
				imageAlt="Pulpo a la brasa con pimentón y aceite de oliva en Restaurante San Jaime 35, Montanejos"
				primaryCta={{ label: 'Llamar 964 13 12 92', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5</b> en Google (1.382 reseñas)' },
					{ label: 'Cocina', html: 'Española y pizzas al horno' },
					{ label: 'Horario', html: 'De 12:00 a 1:00' },
					{ label: 'Cierre', html: 'Martes y miércoles, cerrado' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece San Jaime 35" items={servicios} />

			<LocalAbout
				label="Cocina española en el Alto Mijares"
				title="La brasa,<br />la bodega<br /><em>y el guiso.</em>"
				paragraphs={[
					'San Jaime 35 está en la calle San Jaime, 35, en el casco de Montanejos, un pueblo del Alto Mijares que llena sus calles de visitantes en cuanto aprieta el calor. El comedor es de mantel y servicio de toda la vida, con una pared de cajas de vino y botellas a la vista que hace las veces de bodega.',
					'La cocina va de la brasa a la cazuela. El pulpo se sirve entero, con aceite, pimentón y sal gorda; las croquetas se hacen en casa con sepia y pulpo; las zamburiñas salen del horno con su coral. Después llegan los guisos: carrillada con setas, callos con oreja y codillo con patatas, de los que se comen despacio.',
					'Y a todo eso se suman las pizzas, porque la ficha lo clasifica también como pizzería: masa fina, horno y la de jamón con orégano que aparece en las fotos de los clientes. Para terminar, tarta de chocolate con nata y un carajillo. Abre de 12:00 a 1:00 y descansa martes y miércoles.',
				]}
				note="La ficha de Google reúne 1.382 opiniones con una nota media de 4,5. En las reseñas se repiten las bravas, las croquetas de sepia y pulpo, el pulpo, la carrillada con setas, los callos con oreja, el codillo y el carajillo."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="De la brasa<br /><em>a la cazuela.</em>"
				description="Selección hecha con los platos que aparecen en las fotos de la ficha de Google y con los que citan los clientes en las reseñas: bravas, croquetas de sepia y pulpo, pulpo, zamburiñas, carrillada, callos, codillo, pizzas y postres."
				cta={{ label: 'Reservar por teléfono', href: phoneHref }}
				groups={grupos}
				note="Esta web no publica precios: no hay carta oficial publicada y los importes cambian con el mercado. La carta del día, las pizzas disponibles y el precio se confirman en el local o por teléfono."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Pulpo, guisos<br /><em>y bodega.</em>"
				description="Estas fotografías proceden del perfil de San Jaime 35 en Google Maps: la bodega de cajas y botellas, el pulpo a la brasa servido en la mesa, las zamburiñas, las croquetas caseras, la pizza de jamón, la carrillada con patatas, el codillo en cazuela y la tarta de chocolate."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="C. San Jaime, 35 · 12448 Montanejos"
				title="Nos vemos<br /><em>en San Jaime 35.</em>"
				addressLines={[
					business.street,
					`${business.postalCode} ${business.city}`,
					'Castellón, España',
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: '12:00 – 1:00' },
					{ day: 'Martes', value: 'Cerrado', closed: true },
					{ day: 'Miércoles', value: 'Cerrado', closed: true },
					{ day: 'Jueves', value: '12:00 – 1:00' },
					{ day: 'Viernes', value: '12:00 – 1:00' },
					{ day: 'Sábado', value: '12:00 – 1:00' },
					{ day: 'Domingo', value: '12:00 – 1:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google: de 12:00 a 1:00 los domingos, lunes, jueves, viernes y sábados; martes y miércoles cierra. En festivos y en temporada alta puede cambiar, así que llama al 964 13 12 92 antes de ir."
				mapTitle="Mapa de Restaurante San Jaime 35 en la calle San Jaime, 35, Montanejos"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="San Jaime 35 · Montanejos"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Las reservas se hacen por teléfono, en el 964 13 12 92: no hay reserva online ni formulario en esta web. En fin de semana y en temporada de baños en el río conviene llamar con antelación. Si vais en grupo o alguien tiene alguna alergia, avisad al reservar."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="35"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a San Jaime 35"
		/>
	</body>
</html>
