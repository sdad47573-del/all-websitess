---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import cuatro from '../assets/fotos/la-romanica-andorra-cuatro-pinsas.jpg';
import prosciutto from '../assets/fotos/la-romanica-andorra-prosciutto-burrata.jpg';
import tomate from '../assets/fotos/la-romanica-andorra-tomate-burrata.jpg';
import atun from '../assets/fotos/la-romanica-andorra-atun-cebolla.jpg';
import salchicha from '../assets/fotos/la-romanica-andorra-salchicha.jpg';
import quesos from '../assets/fotos/la-romanica-andorra-quesos.jpg';
import pimientos from '../assets/fotos/la-romanica-andorra-pimientos.jpg';
import dulce from '../assets/fotos/la-romanica-andorra-pinsa-dulce.jpg';
import cajas from '../assets/fotos/la-romanica-andorra-cajas.jpg';

import {
	BUSINESS,
	CARTA,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'La Romànica Andorra · Pinsa romana a domicilio en Encamp';
const description =
	'La Romànica Andorra, Carrer del Solà, 3, Baixos (AD200 Encamp). Pinsa romana con burrata, prosciutto, rúcula o atún, y pinsa dulce de chocolate y pistacho. Para llevar y a domicilio. 4,9 sobre 5 con 72 reseñas. Viernes a domingo, 19:00–22:30.';

const galeria = [
	{
		src: prosciutto,
		alt: 'Pinsa con prosciutto, rúcula, lascas de parmesano y una burrata entera en el centro',
	},
	{
		src: tomate,
		alt: 'Pinsa con tomate cherry, burrata, pesto y chorro de crema balsámica',
	},
	{
		src: pimientos,
		alt: 'Pinsa con pimientos amarillos y rojos, cebolla y mozzarella en su caja',
	},
	{
		src: atun,
		alt: 'Pinsa con atún, cebolla y aceitunas negras recién salida del horno',
	},
	{
		src: salchicha,
		alt: 'Pinsa de masa oscura con salchicha, queso fundido y romero',
	},
	{
		src: quesos,
		alt: 'Pinsa blanca con quesos fundidos y láminas de parmesano',
	},
	{
		src: dulce,
		alt: 'Pinsa dulce con chocolate, crema y pistacho picado por encima',
	},
	{
		src: cajas,
		alt: 'Dos pinsas en caja sobre la mesa, con las cajas de cartón de la marca',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Las pinsas de La Romànica Andorra',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-romanica`,
	name: BUSINESS.name,
	alternateName: ['La Romànica', 'La Romanica Andorra', 'La Romànica Encamp'],
	description:
		'Pinsa romana para llevar y a domicilio en Encamp: masa alargada de fermentación larga, con burrata, prosciutto, rúcula, atún o pimientos, y pinsa dulce de chocolate y pistacho.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376851780',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pinsa romana', 'Pizza'],
	hasDelivery: true,
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Encamp' },
		{ '@type': 'AdministrativeArea', name: 'Andorra' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	menu: CARTA.href,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday', 'Sunday'],
			opens: '19:00',
			closes: '22:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Las pinsas', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2b2723" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Source+Sans+3:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Romànica Andorra, pinsa romana Encamp, pizza a domicilio Encamp, pinsa amb burrata Andorra, pizza para llevar Andorra, Carrer del Solà Encamp"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pinsa romana para llevar y a domicilio en Encamp: burrata, prosciutto, rúcula, atún y versión dulce. 4,9 en Google con 72 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Pinsa con prosciutto, rúcula y burrata de La Romànica Andorra"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2b2723"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-02"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[cuatro]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Romànica"
			subtitle="Pinsa romana · Encamp"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer del Solà, 3 · Encamp"
				title="Pinsa romana, <br /><em>hecha al momento.</em>"
				lede={`La Romànica es la pinseria de Encamp: masa alargada de fermentación larga, borde tostado y cajas que salen del horno para llevarse o para repartir. Burrata, prosciutto, rúcula, atún o pimientos, y una pinsa dulce de chocolate y pistacho. Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas. Abre solo las cenas de viernes, sábado y domingo.`}
				image={cuatro}
				imageAlt="Cuatro pinsas en sus cajas con una botella de vino y vasitos de tiramisú"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Carta con precios', href: CARTA.href, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>19:00–22:30</b> · viernes a domingo' },
					{ label: 'Servicio', html: '<b>A domicilio</b> · y para llevar' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Pinsa romana"
			/>

			<LocalChips label="Lo que ofrece La Romànica Andorra" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Solà, 3. <br /><em>Encamp.</em>"
				paragraphs={[
					'La Romànica Andorra está en el Carrer del Solà, 3, Baixos, en Encamp. La ficha de Google lo sitúa en las coordenadas 42.5350349, 1.5790739, en la planta baja. El teléfono es un fijo andorrano, el +376 851 780.',
					'La especialidad es la pinsa romana: masa alargada, de contorno irregular, con fermentación larga y un borde que sale tostado del horno. Se sirve en caja, cortada, y se come con las manos: es la versión romana de la pizza, más ligera y crujiente.',
					'En las fotos del perfil aparecen cuatro pinsas juntas sobre la mesa, con una botella de vino y tiramisú en vasitos: una con prosciutto, rúcula y burrata; otra con tomate cherry, burrata y pesto; otra con pimientos y cebolla; y una más con atún y aceitunas negras. También hay pinsa blanca de quesos y una de salchicha con romero.',
					`Google la clasifica como «Pizzería a domicilio» y «Pizza para llevar», y la ficha enlaza una carta propia en ${CARTA.domain}. Con ${RATING.count} reseñas y una media de ${RATING.label} sobre 5 (noviembre de 2026), el horario es corto y muy claro: solo cenas de viernes a domingo.`,
				]}
				note="La ficha no publica precios: la carta con importes está en el enlace a portalrest.com que aparece más abajo. Los platos que se citan son los que se ven en las fotos del perfil."
				links={[
					{ label: 'Carta con precios', href: CARTA.href, external: true },
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Del horno</p>
					<h2 id="highlights-title">Masa larga, <br /><em>borde tostado.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="Las pinsas"
				title="Burrata, prosciutto <br /><em>y pistacho.</em>"
				description="Lo que se ve en las fotos del perfil, ordenado en cuatro bloques. La carta completa, con precios, está en el enlace a portalrest.com que publica la ficha de Google."
				cta={{ label: 'Ver la carta con precios', href: CARTA.href }}
				groups={MENU}
				note={`Los encargos se hacen por teléfono, en el ${BUSINESS.phone}, o a través de la carta enlazada desde la ficha. Los importes no se copian aquí: están en esa carta y pueden cambiar.`}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Las pinsas, una a una."
				description="Ocho fotografías del perfil de La Romànica: la de prosciutto y burrata, la de tomate y pesto, la de pimientos, la de atún y aceitunas, la de salchicha, la de quesos, la dulce de chocolate y pistacho, y dos cajas sobre la mesa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,9 sobre 5, <em>con 72 reseñas.</em></h2>
						<p>
							Una de las notas más altas de la parroquia de Encamp, con un volumen de reseñas que ya
							permite tomársela en serio. La ficha la clasifica como pizzería a domicilio y pizza
							para llevar.
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer todas las reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,9</strong>
						<span>★★★★★</span>
						<small>72 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Encamp, <br /><em>solo por la noche.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city} (parroquia de Encamp)`,
					'Principado de Andorra',
				]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: viernes, sábado y domingo de 19:00 a 22:30; de lunes a jueves, cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de La Romànica Andorra en el Carrer del Solà, Encamp"
				mapEmbedUrl={MAPS.embed}
				mapLabel={`${BUSINESS.street} · Encamp`}
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Carta con precios', href: CARTA.href, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote={`Los encargos se hacen por teléfono, en el ${BUSINESS.phone}, o desde la carta enlazada en la ficha. Conviene llamar con tiempo: solo se cocina de 19:00 a 22:30 y únicamente los fines de semana.`}
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Carta ↗', href: CARTA.href, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma carta, precios y horario antes de pedir."
			ctaLabel="Llamar a La Romànica"
			navAriaLabel="Enlaces de La Romànica Andorra"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
