---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import cuatro from '../assets/fotos/la-romanica-andorra-cuatro-pinsas.jpg';
import prosciutto from '../assets/fotos/la-romanica-andorra-prosciutto-burrata.jpg';
import tomate from '../assets/fotos/la-romanica-andorra-tomate-burrata.jpg';
import atun from '../assets/fotos/la-romanica-andorra-atun-cebolla.jpg';
import salchicha from '../assets/fotos/la-romanica-andorra-salchicha.jpg';
import quesos from '../assets/fotos/la-romanica-andorra-quesos.jpg';
import pimientos from '../assets/fotos/la-romanica-andorra-pimientos.jpg';
import dulce from '../assets/fotos/la-romanica-andorra-pinsa-dulce.jpg';
import cajas from '../assets/fotos/la-romanica-andorra-cajas.jpg';

import {
	BUSINESS,
	CARTA,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'La Romànica Andorra · Pinsa romana a domicilio en Encamp';
const description =
	'La Romànica Andorra, Carrer del Solà, 3, Baixos (AD200 Encamp). Pinsa romana con burrata, prosciutto, rúcula o atún, y pinsa dulce de chocolate y pistacho. Para llevar y a domicilio. 4,9 sobre 5 con 72 reseñas. Viernes a domingo, 19:00–22:30.';

const galeria = [
	{
		src: prosciutto,
		alt: 'Pinsa con prosciutto, rúcula, lascas de parmesano y una burrata entera en el centro',
	},
	{
		src: tomate,
		alt: 'Pinsa con tomate cherry, burrata, pesto y chorro de crema balsámica',
	},
	{
		src: pimientos,
		alt: 'Pinsa con pimientos amarillos y rojos, cebolla y mozzarella en su caja',
	},
	{
		src: atun,
		alt: 'Pinsa con atún, cebolla y aceitunas negras recién salida del horno',
	},
	{
		src: salchicha,
		alt: 'Pinsa de masa oscura con salchicha, queso fundido y romero',
	},
	{
		src: quesos,
		alt: 'Pinsa blanca con quesos fundidos y láminas de parmesano',
	},
	{
		src: dulce,
		alt: 'Pinsa dulce con chocolate, crema y pistacho picado por encima',
	},
	{
		src: cajas,
		alt: 'Dos pinsas en caja sobre la mesa, con las cajas de cartón de la marca',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Las pinsas de La Romànica Andorra',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-romanica`,
	name: BUSINESS.name,
	alternateName: ['La Romànica', 'La Romanica Andorra', 'La Romànica Encamp'],
	description:
		'Pinsa romana para llevar y a domicilio en Encamp: masa alargada de fermentación larga, con burrata, prosciutto, rúcula, atún o pimientos, y pinsa dulce de chocolate y pistacho.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376851780',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pinsa romana', 'Pizza'],
	hasDelivery: true,
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Encamp' },
		{ '@type': 'AdministrativeArea', name: 'Andorra' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	menu: CARTA.href,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday', 'Sunday'],
			opens: '19:00',
			closes: '22:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Las pinsas', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-romanica-andorra-cuatro-pinsas.jpg": cuatro,
	"la-romanica-andorra-prosciutto-burrata.jpg": prosciutto,
	"la-romanica-andorra-tomate-burrata.jpg": tomate,
	"la-romanica-andorra-pimientos.jpg": pimientos,
	"la-romanica-andorra-atun-cebolla.jpg": atun,
	"la-romanica-andorra-salchicha.jpg": salchicha,
	"la-romanica-andorra-quesos.jpg": quesos,
	"la-romanica-andorra-pinsa-dulce.jpg": dulce,
	"la-romanica-andorra-cajas.jpg": cajas,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2b2723" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Source+Sans+3:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Romànica Andorra, pinsa romana Encamp, pizza a domicilio Encamp, pinsa amb burrata Andorra, pizza para llevar Andorra, Carrer del Solà Encamp"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pinsa romana para llevar y a domicilio en Encamp: burrata, prosciutto, rúcula, atún y versión dulce. 4,9 en Google con 72 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Pinsa con prosciutto, rúcula y burrata de La Romànica Andorra"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2b2723"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-02"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[cuatro]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Romànica"
			subtitle="Pinsa romana · Encamp"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Carta ↗', href: CARTA.href, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma carta, precios y horario antes de pedir."
			ctaLabel="Llamar a La Romànica"
			navAriaLabel="Enlaces de La Romànica Andorra"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
