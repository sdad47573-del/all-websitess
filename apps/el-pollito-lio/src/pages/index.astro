---
import '../styles/global.css';
import { Image } from 'astro:assets';
import heroPhoto from '../assets/fotos/el-pollito-lio-panoramica-07.jpg';
import Galeria from '../components/Galeria.astro';
import {
	business,
	deliveryAreas,
	directionsUrl,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneDisplay,
	phoneHrefs,
	specialties,
	structuredData,
	whatsappUrl,
} from '../lib/business';

const title = 'El Pollito Lio | Pollo asado y cocina argentina en Rincón de la Victoria';
const description =
	'El Pollito Lio, asador argentino en Avenida del Mediterráneo, 16, Rincón de la Victoria (Málaga). Milanesas, empanadas caseras y pollo asado al espiedo. Take away y delivery. Pide por teléfono o WhatsApp.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#17120f" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="Rincón de la Victoria" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://el-pollito-lio-malaga.vercel.app/og.png" />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="El Pollito Lio, inicio">
				<span class="brand-mark" aria-hidden="true">PL</span>
				<span class="brand-label">EL POLLITO LIO <small>ASADOR ARGENTINO · RINCÓN DE LA VICTORIA</small></span>
			</a>
			<nav aria-label="Navegación principal"><a href="#carta">La carta</a><a href="#contacto">Pedidos</a></nav>
			<a class="header-action" href={whatsappUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">✆</span> Pedir</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-bg">
					<Image
						src={heroPhoto}
						alt="Pollo al espiedo con patatas caseras, pan y salsas de El Pollito Lio"
						widths={[480, 720, 960, 1200, 1600]}
						sizes="100vw"
						format="avif"
						quality={70}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> ASADOR · COCINA ARGENTINA · TAKE AWAY</p>
						<h1 id="hero-title">Pollo asado<br /><em>de verdad.</em></h1>
						<p class="hero-intro">Milanesas enormes, empanadas caseras y pollo al espiedo con patatas que se acaban solas. En plena Avenida del Mediterráneo, en Rincón de la Victoria, para comer en casa o llevarte a la playa.</p>
						<div class="hero-actions">
							<a class="button button-ember" href={`tel:${phoneHrefs[0]}`}><span aria-hidden="true">☎</span> Llamar {phoneDisplay}</a>
							<a class="button button-celeste" href={whatsappUrl} target="_blank" rel="noreferrer">Pedir por WhatsApp <span aria-hidden="true">↗</span></a>
						</div>
					</div>
					<aside class="ticket" aria-label="Pedidos y reparto">
						<p class="ticket-head">PEDIDOS</p>
						<p class="ticket-phone"><a href={`tel:${phoneHrefs[0]}`}>{phoneDisplay}</a></p>
						<ul class="ticket-list">
							<li><span>Take away</span><span aria-hidden="true">✓</span></li>
							<li><span>Servicio a domicilio</span><span aria-hidden="true">✓</span></li>
							<li><span>Encargos y catering</span><span aria-hidden="true">✓</span></li>
						</ul>
						<p class="ticket-foot">Delivery en {deliveryAreas.join(' · ')}.</p>
					</aside>
				</div>
				<div class="hero-strip" aria-hidden="true">
					<span>MILANESAS</span><i></i><span>EMPANADAS</span><i></i><span>POLLO AL ESPIEDO</span><i></i><span>PATATAS CASERAS</span><i></i><span>ARGENTINA</span>
				</div>
			</section>

			<section class="carta-section" id="carta" aria-labelledby="carta-title">
				<p class="section-label"><span>01 /</span> LO QUE MÁS SE PIDE</p>
				<div class="carta-head">
					<h2 id="carta-title">La carta del<br /><em>asador.</em></h2>
					<p class="carta-lead">Cocina argentina generosa, hecha al momento. Estos son los platos que más repiten nuestros vecinos.</p>
				</div>
				<ol class="carta-list">
					{specialties.map((dish, index) => (
						<li class="carta-item">
							<span class="carta-num">{String(index + 1).padStart(2, '0')}</span>
							<strong>{dish.name}</strong>
							<i class="carta-dots" aria-hidden="true"></i>
							<small>{dish.note}</small>
						</li>
					))}
				</ol>
				<p class="carta-foot">Consulta las promos del día en nuestro Instagram. También preparamos encargos especiales.</p>
			</section>

			<section class="about-section" aria-labelledby="about-title">
				<p class="section-label"><span>02 /</span> EL POLLITO LIO</p>
				<div class="about-content">
					<h2 id="about-title">Sabor argentino<br /><em>en El Rincón.</em></h2>
					<div>
						<p>Somos un asador familiar de barrio. Aquí el pollo se hace al espiedo, las empanadas se rellenan a mano y las milanesas salen del tamaño que uno espera de verdad. Cocina casera, buena onda y raciones que llenan.</p>
						<p>Puedes pasar por el local a recoger tu pedido o pedirnos por WhatsApp: llevamos a domicilio en Rincón de la Victoria, Torre de Benagalbón y La Cala del Moral.</p>
						<a class="social-link" href={instagramUrl} target="_blank" rel="noreferrer">Síguenos en Instagram <span aria-hidden="true">↗</span></a>
					</div>
				</div>
				<ul class="zona-list">
					{deliveryAreas.map((area) => (
						<li>{area}</li>
					))}
				</ul>
			</section>

			<section class="contact-section" id="contacto" aria-labelledby="contact-title">
				<p class="section-label"><span>03 /</span> CÓMO PEDIR</p>
				<div class="contact-layout">
					<div class="contact-copy">
						<p class="contact-kicker">PIDE Y RECOGE, O TE LO LLEVAMOS</p>
						<h2 id="contact-title">Haz tu<br /><em>pedido.</em></h2>
						<div class="contact-card">
							<div class="contact-row"><span aria-hidden="true">☎</span><div><small>TELÉFONO Y WHATSAPP</small><a href={`tel:${phoneHrefs[0]}`}>{phoneDisplay}</a></div></div>
							<div class="contact-row"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div></div>
							<div class="contact-row"><span aria-hidden="true">↗</span><div><small>REDES</small><a href={instagramUrl} target="_blank" rel="noreferrer">@elpollitolio_rincon ↗</a></div></div>
						</div>
						<div class="contact-actions">
							<a class="button button-dark" href={whatsappUrl} target="_blank" rel="noreferrer">Pedir por WhatsApp <span aria-hidden="true">↗</span></a>
							<a class="button button-outline" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
						</div>
					</div>
					<div class="map-card">
						<div class="map-header"><span><i></i> AV. DEL MEDITERRÁNEO, 16</span><a href={mapsUrl} target="_blank" rel="noreferrer">ABRIR MAPS ↗</a></div>
						<div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
							<button type="button" data-cargar-mapa aria-label="Cargar mapa interactivo" style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
								<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
								<strong style="font-size:1rem;">Cargar mapa interactivo</strong>
								<small style="opacity:0.65;">Se carga solo al pulsar</small>
							</button>
<iframe title="Mapa de El Pollito Lio en Avenida del Mediterráneo, 16, Rincón de la Victoria" data-src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-footer"><span aria-hidden="true">⌖</span><div><strong>{business.name}</strong><small>{business.streetAddress} · {business.city}</small></div><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar a El Pollito Lio">↗</a></div>
					</div>
				</div>
				<div class="social-row"><span>ENCUÉNTRANOS TAMBIÉN EN</span><a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a></div>
			</section>
			<Galeria nombre="El Pollito Lio" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio" aria-label="El Pollito Lio, volver al inicio"><span class="brand-mark">PL</span><span class="brand-label">EL POLLITO LIO <small>ASADOR ARGENTINO · RINCÓN DE LA VICTORIA</small></span></a>
			<p>{business.streetAddress}<br />{business.postalCode} {business.city}<br /><a href={`tel:${phoneHrefs[0]}`}>{phoneDisplay}</a></p>
			<a class="footer-social" href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
			<small>© {new Date().getFullYear()} El Pollito Lio · Rincón de la Victoria &nbsp;·&nbsp; Consulta las promos del día en el local.</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
</footer>
		<a class="phone-cta" href={`tel:${phoneHrefs[0]}`}><span aria-hidden="true">☎</span> Pedir por teléfono <strong>{phoneDisplay}</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>

<script>
// mapa-fachada: la URL del iframe vive en data-src y solo se asigna al pulsar (ahorra ~1MB de JS).
document.addEventListener('click', function (e) {
	var t = e.target && e.target.closest ? e.target.closest('[data-cargar-mapa]') : null;
	if (!t) return;
	var w = t.closest('[data-mapa-fachada]');
	if (!w || w.dataset.cargado) return;
	var f = w.querySelector('iframe');
	if (!f || !f.dataset.src || f.getAttribute('src')) return;
	w.dataset.cargado = '1';
	f.setAttribute('src', f.dataset.src);
	t.remove();
});
</script>
