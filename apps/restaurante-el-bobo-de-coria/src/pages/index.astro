---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/restaurante-el-bobo-de-coria-apaisada-02.jpg';
import fachada from '../assets/fotos/restaurante-el-bobo-de-coria-panoramica-06.jpg';
import cartel from '../assets/fotos/restaurante-el-bobo-de-coria-panoramica-04.jpg';
import terraza from '../assets/fotos/restaurante-el-bobo-de-coria-apaisada-08.jpg';
import boletus from '../assets/fotos/restaurante-el-bobo-de-coria-apaisada-05.jpg';
import setas from '../assets/fotos/restaurante-el-bobo-de-coria-vertical-07.jpg';
import entrecot from '../assets/fotos/restaurante-el-bobo-de-coria-vertical-03.jpg';
import carneSalsa from '../assets/fotos/restaurante-el-bobo-de-coria-cuadrada-09.jpg';
import fideos from '../assets/fotos/restaurante-el-bobo-de-coria-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Restaurante El Bobo de Coria, mesón de cocina casera en el casco histórico de Coria (Cáceres). Setas de temporada, bacalao, carnes a la plancha y tarta de almendras. Comidas y cenas de martes a domingo. Reservas en el 927 50 07 95.';

const galeria = [
	{ src: fachada, alt: 'Fachada con puerta de arco de Restaurante El Bobo de Coria' },
	{ src: cartel, alt: 'Cartel de piedra de Mesón-Restaurante El Bobo de Coria' },
	{ src: terraza, alt: 'Jardín con mesas y sillas blancas de El Bobo de Coria, bajo los árboles' },
	{ src: boletus, alt: 'Boletus al ajillo en una fuente de El Bobo de Coria, Cáceres' },
	{ src: setas, alt: 'Setas de temporada con ajos laminados en El Bobo de Coria' },
	{ src: entrecot, alt: 'Entrecot a la plancha con patatas y pimiento verde en El Bobo de Coria' },
	{ src: carneSalsa, alt: 'Carne en salsa de la casa servida en El Bobo de Coria' },
	{ src: fideos, alt: 'Plato de fideos dorados de El Bobo de Coria, en Coria (Cáceres)' },
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	acceptsReservations: true,
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['El Bobo de Coria', 'Mesón El Bobo', 'Restaurante El Bobo Coria'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 927 50 07 95',
	priceRange: BUSINESS.priceRange,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Extremeña', 'Española', 'Cocina casera'],
	areaServed: [
		{ '@type': 'City', name: 'Coria' },
		{ '@type': 'AdministrativeArea', name: 'Cáceres' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId }],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '21:00',
			closes: '22:30',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Jardín con mesas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Reserva por teléfono', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El mesón', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Restaurante El Bobo de Coria · Cocina casera y setas en Coria (Cáceres)';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#6b2830" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante El Bobo de Coria, El Bobo de Coria, comer en Coria, restaurante Coria Cáceres, setas Coria, boletus Coria, cocina casera Coria, calle de las Monjas Coria, mesón Coria"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Restaurante El Bobo de Coria · Cocina casera y setas"
			ogDescription="Setas de temporada, bacalao, carnes a la plancha y tarta de almendras en un mesón con jardín del casco histórico de Coria. 4,4 en Google con 642 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Jardín con mesas de Restaurante El Bobo de Coria, en Coria (Cáceres)"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#6b2830"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			postalCode={BUSINESS.postalCode}
			phone="+34927500795"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Bobo de Coria"
			subtitle="Mesón · Coria"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. de las Monjas · Coria"
				title="Cocina casera<br /><em>en Coria.</em>"
				lede={`Setas de temporada, bacalao, carnes a la plancha y tarta de almendras en un mesón de paredes rojas con jardín, en el casco histórico de Coria. Comidas y cenas de martes a domingo. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={comedor}
				imageAlt="Comedor de paredes rojas y vigas de madera de El Bobo de Coria"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)` },
					{ label: 'Horario', html: 'Mar–Dom · 13:30 y 21:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phoneDisplay}</b>` },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece El Bobo de Coria" items={SERVICIOS} />

			<LocalAbout
				label="El mesón"
				title="Paredes rojas<br /><em>y jardín.</em>"
				paragraphs={[
					`El Bobo de Coria es un mesón de los de antes en la calle de las Monjas, 6, en el casco histórico de Coria (${BUSINESS.postalCode}, Cáceres). Puerta de arco, comedor de paredes rojas, vigas de madera y suelo de barro; detrás, un jardín con mesas bajo los árboles.`,
					'La cocina es casera y abundante. En temporada mandan las setas: boletus al ajillo y crema de boletus, que son lo que más se repite en las reseñas. También gazpacho, bacalao, pluma ibérica y carnes a la plancha, con la tarta de almendras de postre.',
					'La ficha de Google no publica carta ni precios, así que aquí no se inventan: esta web resume lo que se ve en sus fotos y lo que cuentan sus clientes. Para precios y disponibilidad se llama al restaurante.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Se repiten las setas de temporada, la crema de boletus, el bacalao y la tarta de almendras.`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.cid, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Setas, carnes<br /><em>y tarta de almendras.</em>"
				description="Resumen de lo que se sirve, sacado de las fotos de la ficha de Google Maps y de las reseñas. No es la carta completa ni tiene precios: se consultan en el restaurante."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La carta cambia con el mercado y la temporada. Si vas por un plato concreto, llama antes: no publicamos precios porque el restaurante no los tiene publicados."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor<br /><em>y el jardín.</em>"
				description="Estas fotografías proceden del perfil de El Bobo de Coria en Google Maps: la fachada de arco, el cartel de piedra, el jardín y los platos de setas y carne de la casa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Nos vemos<br /><em>en Las Monjas.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: dos servicios, comidas de 13:30 a 16:00 y cenas de 21:00 a 22:30, de martes a domingo. El lunes cierra."
				mapTitle="Mapa de Restaurante El Bobo de Coria en la calle de las Monjas, 6, Coria (Cáceres)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="El Bobo de Coria"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva llamando al restaurante. La ficha de Google marca aseo y asientos adaptados, pero no acceso adaptado, y la puerta es un arco de piedra; si necesitas accesibilidad, pregunta antes por teléfono."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.cid, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a El Bobo de Coria"
		/>
	</body>
</html>
