---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import lasana from '../assets/fotos/asador-el-laurel-vertical-02.jpg';
import fachada from '../assets/fotos/asador-el-laurel-apaisada-01.jpg';
import albondigas from '../assets/fotos/asador-el-laurel-apaisada-03.jpg';
import espaguetis from '../assets/fotos/asador-el-laurel-apaisada-04.jpg';
import arroz from '../assets/fotos/asador-el-laurel-apaisada-06.jpg';
import pescado from '../assets/fotos/asador-el-laurel-apaisada-07.jpg';
import vitrina from '../assets/fotos/asador-el-laurel-apaisada-08.jpg';
import ensaladilla from '../assets/fotos/asador-el-laurel-apaisada-10.jpg';
import empanadas from '../assets/fotos/asador-el-laurel-cuadrada-05.jpg';
import fiambreras from '../assets/fotos/asador-el-laurel-panoramica-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'El Laurel · Asador de pollos y comida para llevar en Málaga';
const description =
	'El Laurel, en la calle Almogía, 14 (Cruz de Humilladero, 29007 Málaga). Asador de pollos y comida casera para llevar, con raciones generosas, de miércoles a lunes de 12:30 a 16:00.';

const galeria = [
	{
		src: lasana,
		alt: 'Lasaña de pollo gratinada en una bandeja de aluminio, recién sacada del horno',
	},
	{
		src: vitrina,
		alt: 'Vitrina de El Laurel con bandejas de carne rebozada, pasta, ensaladilla y guisos',
	},
	{
		src: arroz,
		alt: 'Paella de arroz con gambas y pimientos en una paellera',
	},
	{
		src: albondigas,
		alt: 'Bandeja de albóndigas en salsa de tomate naranja',
	},
	{
		src: espaguetis,
		alt: 'Bandeja de espaguetis con gambas y salsa',
	},
	{
		src: pescado,
		alt: 'Pescado al horno con patatas, pimientos y cebolla en una bandeja',
	},
	{
		src: ensaladilla,
		alt: 'Ensaladilla rusa con gambas, palitos de cangrejo, tomate y huevo',
	},
	{
		src: empanadas,
		alt: 'Porciones cuadradas de masa horneada y dorada en una bandeja',
	},
	{
		src: fiambreras,
		alt: 'Comida para llevar en fiambreras: pollo en salsa, patatas fritas y pimientos asados',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de El Laurel',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-laurel`,
	name: BUSINESS.fullName,
	alternateName: ['El Laurel', 'Asador El Laurel Málaga', 'Asador de pollos El Laurel'],
	description:
		'Asador de pollos y comida casera para llevar en la calle Almogía, 14, Cruz de Humilladero (29007 Málaga).',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34615300263',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Pollo asado', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:30',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"asador-el-laurel-apaisada-01.jpg": fachada,
	"asador-el-laurel-vertical-02.jpg": lasana,
	"asador-el-laurel-apaisada-08.jpg": vitrina,
	"asador-el-laurel-apaisada-06.jpg": arroz,
	"asador-el-laurel-apaisada-03.jpg": albondigas,
	"asador-el-laurel-apaisada-04.jpg": espaguetis,
	"asador-el-laurel-apaisada-07.jpg": pescado,
	"asador-el-laurel-apaisada-10.jpg": ensaladilla,
	"asador-el-laurel-cuadrada-05.jpg": empanadas,
	"asador-el-laurel-panoramica-09.jpg": fiambreras,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#163b2d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Instrument+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Laurel Málaga, asador de pollos Málaga, comida para llevar Cruz de Humilladero, pollo asado Almogía, lasaña de pollo, migas, ensaladilla rusa, arroz con gambas"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Asador de pollos y comida casera para llevar en la calle Almogía, 14. De miércoles a lunes, de 12:30 a 16:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de El Laurel, asador de pollos y comida para llevar en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#163b2d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Laurel"
			subtitle="Asador de pollos · Para llevar"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a El Laurel"
			navAriaLabel="Enlaces de El Laurel"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
