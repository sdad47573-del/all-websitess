---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import envuelto from '../assets/fotos/a-boca-2-ciudad-real-vertical-01.jpg';
import abierto from '../assets/fotos/a-boca-2-ciudad-real-vertical-02.jpg';
import quemado from '../assets/fotos/a-boca-2-ciudad-real-vertical-03.jpg';
import interior from '../assets/fotos/a-boca-2-ciudad-real-vertical-04.jpg';

import { BUSINESS, FAQ, HOURS, HORARIO_AVISO, MAPS, MENU, RATING, SERVICIOS } from '../data/site';

const title = 'A boca2 Ciudad Real · bocadillos y patatas en la calle de los Hidalgos';
const description = BUSINESS.description;

const galeria = [
	{
		src: abierto,
		alt: 'Bocadillo de lomo con queso abierto sobre papel estampado, con lechuga, tomate y mayonesa',
	},
	{
		src: envuelto,
		alt: 'Bocadillo envuelto en papel de aluminio, sostenido en la mano en la acera',
	},
	{
		src: quemado,
		alt: 'Bocadillo con lechuga y pollo junto a la otra mitad del pan, tostada de más',
	},
	{
		src: interior,
		alt: 'Interior de A boca2: barra naranja, taburete alto, nevera de refrescos y el rótulo en la pared',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#a-boca2`,
	name: BUSINESS.name,
	alternateName: ['A boca2', 'A boca 2 Ciudad Real', 'Aboca2 Ciudad Real'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	currenciesAccepted: 'EUR',
	servesCuisine: ['Bocadillos', 'Bocatería', 'Comida para llevar'],
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.channel },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Entrada accesible', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Se admiten perros', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#15100d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="A boca2 Ciudad Real, bocatería Ciudad Real, bocadillos calle de los Hidalgos, bocadillo de lomo con queso Ciudad Real, patatas con kebab Ciudad Real, bocatería 13004, comida para llevar centro Ciudad Real"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Bocadillos de lomo, pollo y kebab, patatas y raciones en la calle de los Hidalgos, 3, de Ciudad Real. Para llevar o en la barra. 3,2 sobre 5 con 65 reseñas en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bocadillo de lomo con queso de A boca2 Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#15100d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[abierto]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Bocatería en Ciudad Real"
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Bocadillos <br /><em>de barra.</em>"
				lede={`A boca2 es una bocatería en la calle de los Hidalgos, 3, en el centro de Ciudad Real. Bocadillos de lomo con queso, pollo y kebab, patatas y raciones, para comer en la barra o llevar envueltos. La ficha de Google le da 3,2 sobre 5 con 65 reseñas.`}
				image={abierto}
				imageAlt="Bocadillo de lomo con queso abierto sobre papel estampado, con lechuga, tomate y mayonesa"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>3,2</b> en Google · 65 reseñas' },
					{
						label: 'Horario',
						html: '<b>No publicado</b><br />La ficha no da horas de apertura',
					},
					{ label: 'Contacto', html: '<b>Sin teléfono</b> en la ficha · se va al local' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de A boca2 Ciudad Real" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Barra naranja, <br /><em>papel de aluminio.</em>"
				paragraphs={[
					'A boca2 Ciudad Real es una bocatería en la calle de los Hidalgos, 3, en la zona del centro de Ciudad Real. Google la clasifica simplemente como bocatería, sin más etiquetas: no publica teléfono, ni horario, ni carta, ni web propia.',
					'Las fotos del perfil las suben los clientes y enseñan el producto tal cual: la barra de pan abierta a lo largo, el lomo a la plancha con queso fundido, lechuga, tomate y mayonesa; en otra, pollo y lechuga. También hay una foto del interior, con la barra naranja corrida, taburetes altos, la nevera de refrescos y el rótulo de ABOCA2 en la pared.',
					'Las reseñas añaden lo que no sale en las fotos: kebab, patatas fritas y patatas con carne de kebab. Y no todas son buenas. La media es 3,2 sobre 5 con 65 opiniones, con reseñas de cinco estrellas que alaban el trato —«Excelente servicio, la camarera súper simpática y amable»— junto a otras muy críticas con las patatas o con el punto del pan.',
					'En la ficha también constan dos detalles útiles: la entrada es accesible para sillas de ruedas y se admiten perros. Lo que no hay es teléfono ni franja de horario, así que para saber si está abierto hay que pasar por la calle de los Hidalgos.',
				]}
				note="Los datos salen de la ficha pública de Google Maps y de las fotos y reseñas del perfil. La ficha no publica teléfono, horario, carta ni precios: esta web no los inventa."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver la bocatería en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Lomo, pollo <br /><em>y kebab.</em>"
				description="Los productos que aparecen aquí son los que enseñan las fotos del perfil y los que nombran las reseñas. La casa no tiene carta publicada en Google ni web propia."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="Esta página no publica precios porque no hay carta oficial que copiar. Lo que haya ese día, las raciones y los importes se preguntan en el mostrador."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Cuatro fotos <br /><em>del perfil.</em>"
				description="Las cuatro fotografías que tiene el perfil de A boca2 en Google Maps: dos bocadillos de lomo, uno de pollo y el interior del local con la barra naranja."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Son fotos de clientes: si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Pasa por <br /><em>los Hidalgos.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Ciudad Real · Castilla-La Mancha',
				]}
				hours={HOURS}
				hoursCaption="Lo que consta en la ficha"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de A boca2 Ciudad Real en la calle de los Hidalgos 3, Ciudad Real"
				mapEmbedUrl={MAPS.embed}
				mapLabel="A boca2 Ciudad Real"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: 'Abrir la ficha en Google Maps', href: MAPS.place, external: true }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. La bocatería no publica teléfono ni web propia, así que el único canal es el mostrador: se pide allí y se come en la barra o se lleva."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pasar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta en el local."
			ctaLabel="Cómo llegar"
			navAriaLabel="Enlaces de A boca2 Ciudad Real"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
