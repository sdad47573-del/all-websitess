---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import vitrina from '../assets/fotos/la-tostona-apaisada-01.jpg';
import cartel from '../assets/fotos/la-tostona-vertical-04.jpg';
import berenjenaGarbanzos from '../assets/fotos/la-tostona-cuadrada-03.jpg';
import croquetasBacalao from '../assets/fotos/la-tostona-cuadrada-08.jpg';
import croquetaJamon from '../assets/fotos/la-tostona-cuadrada-07.jpg';
import empanada from '../assets/fotos/la-tostona-cuadrada-10.jpg';
import tuppers from '../assets/fotos/la-tostona-apaisada-05.jpg';
import rebozados from '../assets/fotos/la-tostona-vista-9-09.jpg';
import espaguetis from '../assets/fotos/la-tostona-vertical-02.jpg';
import berenjena from '../assets/fotos/la-tostona-vertical-06.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	INSTAGRAM,
	MAPS,
	MENU,
	MENU_DIA,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'La Tostona · Comida casera para llevar en el centro de Sevilla';
const description =
	'La Tostona, comida casera para llevar en C. Carlos Cañal, 10, Casco Antiguo de Sevilla. Menú del día por 11 €, guisos, fritos, brasa y bocadillos. Horario, fotos, teléfono y cómo llegar.';

const galeria = [
	{ src: vitrina, alt: 'Vitrina de La Tostona con ensaladillas, aliños, fruta y quesos' },
	{ src: cartel, alt: 'Cartel de pizarra de La Tostona en la calle con el menú del día por 11 €' },
	{ src: berenjenaGarbanzos, alt: 'Berenjena rellena gratinada y garbanzos con chorizo de La Tostona' },
	{ src: croquetasBacalao, alt: 'Croquetas de bacalao recién hechas en una bandeja dorada' },
	{ src: croquetaJamon, alt: 'Croquetas de jamón abiertas por la mitad sobre bandeja dorada' },
	{ src: empanada, alt: 'Porción de empanada de hojaldre recién cortada' },
	{ src: tuppers, alt: 'Tres tuppers de comida para llevar con una lata de bebida y pan envasado' },
	{ src: rebozados, alt: 'Bandejas de croquetas y empanadillas rebozadas antes de freír' },
	{ src: espaguetis, alt: 'Espaguetis con langostinos en un envase para llevar' },
	{ src: berenjena, alt: 'Berenjena rellena de carne gratinada sobre un plato de rayas' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Oferta de La Tostona',
	inLanguage: 'es-ES',
	description:
		'Selección basada en la descripción de la ficha de Google, el cartel de la puerta y las fotografías públicas; no es una carta oficial.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: '11.00',
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-tostona`,
	name: BUSINESS.name,
	alternateName: ['La Tostona Sevilla', 'La Tostona Comida para Llevar'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, INSTAGRAM],
	telephone: '+34955769517',
	servesCuisine: ['Comida casera', 'Comida para llevar', 'Andaluza'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:00',
			closes: '16:30',
		},
	],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Oferta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..500&family=Karla:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Tostona Sevilla, comida para llevar Sevilla, menú del día Sevilla centro, comida casera Carlos Cañal, La Tostona menú del día, comida casera para llevar Casco Antiguo"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar en C. Carlos Cañal, 10, Sevilla. Menú del día por 11 € y vitrina de platos fríos y calientes. Consulta fotos, horario y teléfono."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La Tostona, comida casera para llevar en el centro de Sevilla"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#2f3a2c"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Casco Antiguo de Sevilla"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Tostona"
			subtitle="Comida para llevar · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Carlos Cañal, 10 · Casco Antiguo"
				title="Comida casera <br /><em>para llevar.</em>"
				lede={`La Tostona es una tienda de comidas caseras en el centro de Sevilla. La ficha de Google muestra ${RATING.label} sobre 5 con ${RATING.count} reseñas. Se prepara todo para recoger en el local: guisos, fritos, brasa, marisco y bocadillos.`}
				image={vitrina}
				imageAlt="Vitrina de La Tostona con ensaladillas, aliños y bandejas de comida preparada"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver ficha en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Menú del día', html: `<b>${MENU_DIA.price}</b> en el cartel` },
					{ label: 'Valoración', html: `<b>${RATING.label}</b> · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>10:00 – 16:30</b> cada día' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver fotos y ficha"
				tag="Comida para recoger"
			/>

			<LocalChips label="Servicios y oferta de La Tostona" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="La Tostona, <br /><em>cocina de cada día.</em>"
				paragraphs={[
					'La Tostona ocupa el número 10 de la calle Carlos Cañal, en el Casco Antiguo de Sevilla, en el local del antiguo obrador Ambrosius. Google la clasifica como restaurante de comida para llevar y la describe como una tienda de comidas caseras.',
					'La oferta que anuncia la ficha es amplia y de cuchara: guisos, aliños, fritos, brasa, marisco cocido, pescado frito, bocadillos y bebidas. Todo se prepara para recoger en el local, sin servicio de mesa según la información disponible.',
					'En la puerta, el cartel de pizarra anuncia menú del día por 11 €: primero y segundo a elegir entre los platos fríos y calientes de la vitrina, con bebida, postre, pan, cubiertos y servilletas. También anuncia bocadillos calientes.',
				]}
				note="La ficha no publica una carta con precios. El precio del menú del día procede del cartel de la puerta que aparece en las fotografías; conviene confirmarlo al llamar, igual que los platos del día."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotografías', href: '#galeria' },
					{ label: '@latostonasevilla en Instagram', href: INSTAGRAM, external: true },
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<ul class="highlights">
				{
					HIGHLIGHTS.map((item) => (
						<li>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</li>
					))
				}
			</ul>

			<LocalMenu
				eyebrow="Lo que hay en la vitrina"
				title="Platos fríos y calientes <br /><em>para llevar.</em>"
				description="La ficha del local y su cartel de pizarra describen la oferta: menú del día, vitrina de platos fríos y calientes, brasa, marisco y bocadillos. Esta selección es orientativa y no sustituye a lo que haya ese día."
				cta={{ label: `Preguntar el menú · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No se publican precios salvo el menú del día del cartel (11 €). La disponibilidad cambia a diario: confirma los platos y el importe llamando al establecimiento."
			/>

			<LocalGallery
				eyebrow="Fotos del perfil de Google Maps"
				title="Así se ve <br /><em>La Tostona.</em>"
				description="La vitrina, el cartel de la calle y algunos de los platos que aparecen en las fotografías públicas del establecimiento."
				images={galeria}
				cta={{ label: 'Abrir la ficha en Google Maps', href: MAPS.place }}
				note="Imágenes descargadas del perfil público de La Tostona en Google Maps y servidas desde esta página."
			/>

			<section class="notas" aria-labelledby="notas-title">
				<div class="wrap notas-grid">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="notas-title">Lo que cuentan <em>las reseñas.</em></h2>
						<p class="notas-score">
							<strong>{RATING.label}</strong>
							<span>
								<b>★★★★★</b>
								{RATING.count} reseñas<br />en Google
							</span>
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer reseñas en Google ↗
						</a>
					</div>

					<div class="notas-copy">
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>{resena.texto}</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Opinión en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<p class="notas-foot">
							La valoración y el número de reseñas corresponden a la ficha consultada en octubre
							de 2026 y pueden variar. <a href={MAPS.reviews} target="_blank" rel="noreferrer"
								>Consulta las opiniones actualizadas en Google ↗</a
							>.
						</p>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En pleno <br /><em>Casco Antiguo.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de La Tostona en C. Carlos Cañal, 10, Sevilla"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. Carlos Cañal, 10 · Sevilla"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="El servicio es para recoger en el local. Llama antes para encargar, saber qué hay en la vitrina y confirmar el horario en festivos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>encargar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma horario, platos y precios con el establecimiento."
			ctaLabel="Llamar a La Tostona"
			navAriaLabel="Enlaces de La Tostona"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
