---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import vitrina from '../assets/fotos/la-tostona-apaisada-01.jpg';
import cartel from '../assets/fotos/la-tostona-vertical-04.jpg';
import berenjenaGarbanzos from '../assets/fotos/la-tostona-cuadrada-03.jpg';
import croquetasBacalao from '../assets/fotos/la-tostona-cuadrada-08.jpg';
import croquetaJamon from '../assets/fotos/la-tostona-cuadrada-07.jpg';
import empanada from '../assets/fotos/la-tostona-cuadrada-10.jpg';
import tuppers from '../assets/fotos/la-tostona-apaisada-05.jpg';
import rebozados from '../assets/fotos/la-tostona-vista-9-09.jpg';
import espaguetis from '../assets/fotos/la-tostona-vertical-02.jpg';
import berenjena from '../assets/fotos/la-tostona-vertical-06.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	INSTAGRAM,
	MAPS,
	MENU,
	MENU_DIA,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'La Tostona · Comida casera para llevar en el centro de Sevilla';
const description =
	'La Tostona, comida casera para llevar en C. Carlos Cañal, 10, Casco Antiguo de Sevilla. Menú del día por 11 €, guisos, fritos, brasa y bocadillos. Horario, fotos, teléfono y cómo llegar.';

const galeria = [
	{ src: vitrina, alt: 'Vitrina de La Tostona con ensaladillas, aliños, fruta y quesos' },
	{ src: cartel, alt: 'Cartel de pizarra de La Tostona en la calle con el menú del día por 11 €' },
	{ src: berenjenaGarbanzos, alt: 'Berenjena rellena gratinada y garbanzos con chorizo de La Tostona' },
	{ src: croquetasBacalao, alt: 'Croquetas de bacalao recién hechas en una bandeja dorada' },
	{ src: croquetaJamon, alt: 'Croquetas de jamón abiertas por la mitad sobre bandeja dorada' },
	{ src: empanada, alt: 'Porción de empanada de hojaldre recién cortada' },
	{ src: tuppers, alt: 'Tres tuppers de comida para llevar con una lata de bebida y pan envasado' },
	{ src: rebozados, alt: 'Bandejas de croquetas y empanadillas rebozadas antes de freír' },
	{ src: espaguetis, alt: 'Espaguetis con langostinos en un envase para llevar' },
	{ src: berenjena, alt: 'Berenjena rellena de carne gratinada sobre un plato de rayas' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Oferta de La Tostona',
	inLanguage: 'es-ES',
	description:
		'Selección basada en la descripción de la ficha de Google, el cartel de la puerta y las fotografías públicas; no es una carta oficial.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: '11.00',
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-tostona`,
	name: BUSINESS.name,
	alternateName: ['La Tostona Sevilla', 'La Tostona Comida para Llevar'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, INSTAGRAM],
	telephone: '+34955769517',
	servesCuisine: ['Comida casera', 'Comida para llevar', 'Andaluza'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:00',
			closes: '16:30',
		},
	],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Oferta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-tostona-apaisada-01.jpg": vitrina,
	"la-tostona-vertical-04.jpg": cartel,
	"la-tostona-cuadrada-03.jpg": berenjenaGarbanzos,
	"la-tostona-cuadrada-08.jpg": croquetasBacalao,
	"la-tostona-cuadrada-07.jpg": croquetaJamon,
	"la-tostona-cuadrada-10.jpg": empanada,
	"la-tostona-apaisada-05.jpg": tuppers,
	"la-tostona-vista-9-09.jpg": rebozados,
	"la-tostona-vertical-02.jpg": espaguetis,
	"la-tostona-vertical-06.jpg": berenjena,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..500&family=Karla:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Tostona Sevilla, comida para llevar Sevilla, menú del día Sevilla centro, comida casera Carlos Cañal, La Tostona menú del día, comida casera para llevar Casco Antiguo"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar en C. Carlos Cañal, 10, Sevilla. Menú del día por 11 € y vitrina de platos fríos y calientes. Consulta fotos, horario y teléfono."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La Tostona, comida casera para llevar en el centro de Sevilla"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#2f3a2c"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Casco Antiguo de Sevilla"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Tostona"
			subtitle="Comida para llevar · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma horario, platos y precios con el establecimiento."
			ctaLabel="Llamar a La Tostona"
			navAriaLabel="Enlaces de La Tostona"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
