const fotos = [foto01, foto05, foto02, foto04, foto06, foto07, foto08, foto10, foto03, foto09];

const MAPS_URL =
	'https://www.google.com/maps/place/Asador+de+Pollos+y+Comidas+Para+Llevar,+La+Cocina+de+Mam%C3%A1+%2F+Mommy%E2%80%99s+Kitchen/@37.7639587,-0.8450625,17z/data=!3m1!4b1!4m6!3m5!1s0xd6313b4d6550847:0xb755b0d1497de6bc!8m2!3d37.7639587!4d-0.8450625!16s%2Fg%2F11stjbg0md?authuser=0&hl=es&entry=ttu';
