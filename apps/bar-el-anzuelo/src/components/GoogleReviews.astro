---
import GoogleImage from '@assets/google.webp';
import UnnamedImage from '@assets/unnamed.png';
import VerifiedImage from '@assets/verified.png';
import { Image } from '@astro-components';
import { GoogleIcon } from '@astro-icons';

const a = {
	profile_photo: UnnamedImage,
	author_name: 'Beatriz Cornejo',
	rating: 5,

	text: 'Estoy muy contenta con el cambio del bombín de la puerta de mi casa, también me ha arreglado una persiana que tenía rota. Es muy económico y eficiente en su trabajo, y lo que más me ha gustado es que no he tenido que esperar para que venga a mi casa además me a arreglado las bisagras y me a desarmado la cerradura para limpiarla y engrasarla también me a instalado un cerrojo en la puerta de mi casa para tener mayor seguridad lo recomiendo totalmente muy rápido y amable me a cobrado un precio justo sin lugar a duda lo volveré a llamar en otra ocasión',
};

const b = {
	profile_photo: UnnamedImage,
	author_name: 'Juana Martin amador',
	rating: 5,

	text: 'Me cambio la cerradura de casa aquí en Málaga vino super rápido y me abrió y instalo una cerradura tesa con su bombín de seguridad y escudo lo recomiendo totalmente fue rápido y me le y me cobró un precio justo lo volveré a llamar sin dudarlo gran profesional aquí en Málaga capital',
};

const c = {
	profile_photo: UnnamedImage,
	author_name: 'Juana Martin amador',
	rating: 5,

	text: 'Me cambio la cerradura de casa aquí en Málaga vino super rápido y me abrió y instalo una cerradura tesa con su bombín de seguridad y escudo lo recomiendo totalmente fue rápido y me le y me cobró un precio justo lo volveré a llamar sin dudarlo gran profesional aquí en Málaga capital',
};

const reviews = [a, b];
const review_url =
	'https://www.google.com/maps/place/Cerrajero+M%C3%A1laga+barato/@36.7313716,-4.4291733,17z/data=!4m8!3m7!1s0xd72f78298284299:0x4cd387e477b60e15!8m2!3d36.7313716!4d-4.4291733!9m1!1b1!16s%2Fg%2F11s3cq_6qs?entry=ttu&g_ep=EgoyMDI1MTAxMy4wIKXMDSoASAFQAw%3D%3D';
---

<div class="container mx-auto flex flex-col gap-4 px-4 py-30">
	<div class="pb-8 text-center">
		<p class="text-primary font-title text-4xl">Opiniones de clientes</p>
		<p class="text-xl">Reseñas reales de Google</p>
	</div>
	<div class="flex flex-col-reverse items-center justify-center gap-20 md:flex-row">
		<div class="flex flex-col items-center">
			<p class="text-2xl font-bold">EXCELENTE</p>
			<div class="text-3xl">{'⭐'.repeat(5)}</div>
			<p class="pt-4 pb-2">
				A base de <span class="font-bold">131 reseñas</span>
			</p>
			<Image src={GoogleImage} alt="" class="mb-4 h-9 w-auto object-contain" />
			<a
				class="rounded-lg bg-teal-600 px-8 py-4 text-center text-lg font-semibold text-white transition duration-300 hover:bg-teal-700"
				href={review_url}
				target="_blank">Ver mas reseñas</a
			>
		</div>
		<div class="relative flex flex-col gap-4 md:flex-row">
			<a
				class="absolute top-1/3 -right-7 hidden rounded-full bg-teal-600 px-3 py-2 text-center text-lg font-semibold text-white transition duration-300 hover:bg-teal-700 md:flex"
				href={review_url}
			>
				<i class="ri-arrow-right-s-line"></i>
			</a>
			<a
				class="absolute top-1/2 -left-7 hidden rounded-full bg-teal-600 px-3 py-2 text-center text-lg font-semibold text-white transition duration-300 hover:bg-teal-700 md:flex"
				href={review_url}
			>
				<i class="ri-arrow-left-s-line"></i>
			</a>
			{
				reviews.slice(0, 2).map((r) => (
					<div class="w-full max-w-96 rounded-2xl border p-4">
						<div class="flex justify-between">
							<div class="flex">
								<Image src={r.profile_photo} alt={r.author_name} class="mr-3.5 size-10" />
								<p class="font-bold">{r.author_name}</p>
							</div>
							<GoogleIcon class="size-5" />
						</div>
						<div class="flex items-center gap-2 py-2.5">
							{'⭐'.repeat(r.rating)}

							<Image src={VerifiedImage} alt="" class="size-4" />
						</div>
						<p class="text line-clamp-7 overflow-hidden text-ellipsis">{r.text}</p>
					</div>
				))
			}
		</div>
	</div>
</div>
