---
import { PHONE } from "../data/data.astro";
---

<footer class="bg-gray-900 text-white py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-4 gap-8">
      <div>
        <h3
          class="text-xl font-bold mb-4"
          style="font-family: Pacifico, serif;"
        >
          Cerrajero Málaga 24h
        </h3><p class="text-gray-400 mb-4">
          Tu cerrajero de confianza en Málaga. Servicio profesional las 24 horas
          del día.
        </p><div class="flex space-x-4">
          <i
            class="ri-facebook-circle-line text-2xl text-gray-400 hover:text-white cursor-pointer"
          ></i><i
            class="ri-instagram-line text-2xl text-gray-400 hover:text-white cursor-pointer"
          ></i><i
            class="ri-twitter-line text-2xl text-gray-400 hover:text-white cursor-pointer"
          ></i>
        </div>
      </div><div>
        <h4 class="text-lg font-semibold mb-4">Servicios</h4><ul
          class="space-y-2 text-gray-400"
        >
          <li class="hover:text-white cursor-pointer">
            Apertura de puertas
          </li><li class="hover:text-white cursor-pointer">
            Cambio de cerraduras
          </li><li class="hover:text-white cursor-pointer">
            Cerrajería del automóvil
          </li><li class="hover:text-white cursor-pointer">
            Sistemas de seguridad
          </li><li class="hover:text-white cursor-pointer">
            Duplicado de llaves
          </li>
        </ul>
      </div><div>
        <h4 class="text-lg font-semibold mb-4">Zonas</h4><ul
          class="space-y-2 text-gray-400"
        >
          <li class="hover:text-white cursor-pointer">Málaga Centro</li><li
            class="hover:text-white cursor-pointer"
          >
            Marbella
          </li><li class="hover:text-white cursor-pointer">Fuengirola</li><li
            class="hover:text-white cursor-pointer"
          >
            Torremolinos
          </li><li class="hover:text-white cursor-pointer">Todas las zonas</li>
        </ul>
      </div><div>
        <h4 class="text-lg font-semibold mb-4">Contacto</h4><div
          class="space-y-3 text-gray-400"
        >
          <div class="flex items-center space-x-2">
            <i class="ri-phone-line"></i><span>{PHONE}</span>
          </div><div class="flex items-center space-x-2">
            <i class="ri-whatsapp-line"></i><span>+34 {PHONE}</span>
          </div><div class="flex items-center space-x-2">
            <i class="ri-map-pin-line"></i><span>Málaga, España</span>
          </div><div class="flex items-center space-x-2">
            <i class="ri-time-line"></i><span>24/7 Disponible</span>
          </div>
        </div>
      </div>
    </div><div
      class="border-t border-gray-800 mt-8 pt-8 text-center text-gray-400"
    >
      <p>© 2025 Cerrajero Málaga 24h. Todos los derechos reservados.</p><a
        href="https://www.linkedin.com/in/jose-antonio-aguilar-granados/"
        class="hover:text-white cursor-pointer link">Creada por Jose Aguilar</a
      >
    </div>
  </div>
</footer>
