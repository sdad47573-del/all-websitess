---
import {
	NAME,
	PHONE,
	PHONE_HREF,
	CITY_LOCALE,
	MAPS_URL,
	HOURS_LABEL,
} from '../data/business';
---

<footer class="bg-gray-900 py-12 text-white">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-8 md:grid-cols-4">
			<div>
				<h3 class="mb-4 text-xl font-bold" style="font-family: Pacifico, serif;">
					{NAME}
				</h3><p class="mb-4 text-gray-400">
					Restaurante de mariscos y pescados frescos en {CITY_LOCALE}. Cocina del mar en un ambiente
					acogedor y familiar.
				</p><div class="flex space-x-4">
					<i class="ri-facebook-circle-line cursor-pointer text-2xl text-gray-400 hover:text-white"
					></i><i class="ri-instagram-line cursor-pointer text-2xl text-gray-400 hover:text-white"
					></i><i class="ri-twitter-line cursor-pointer text-2xl text-gray-400 hover:text-white"
					></i>
				</div>
			</div><div>
				<h4 class="mb-4 text-lg font-semibold">Nuestra Carta</h4><ul class="space-y-2 text-gray-400">
					<li><a href="/#carta" class="cursor-pointer hover:text-white">Pescados frescos</a></li>
					<li><a href="/#carta" class="cursor-pointer hover:text-white">Mariscos</a></li>
					<li><a href="/#carta" class="cursor-pointer hover:text-white">Moluscos</a></li>
					<li>
						<a href="/#especialidades" class="cursor-pointer hover:text-white">Especialidades</a>
					</li>
				</ul>
			</div><div>
				<h4 class="mb-4 text-lg font-semibold">Enlaces</h4><ul class="space-y-2 text-gray-400">
					<li><a href="/#inicio" class="cursor-pointer hover:text-white">Inicio</a></li>
					<li><a href="/#contacto" class="cursor-pointer hover:text-white">Contacto</a></li>
					<li>
						<a href={MAPS_URL} target="_blank" rel="noopener" class="cursor-pointer hover:text-white"
							>Cómo llegar</a
						>
					</li>
				</ul>
			</div><div>
				<h4 class="mb-4 text-lg font-semibold">Contacto</h4><div class="space-y-3 text-gray-400">
					<div class="flex items-center space-x-2">
						<i class="ri-phone-line"></i><a href={PHONE_HREF} class="hover:text-white">{PHONE}</a>
					</div><div class="flex items-center space-x-2">
						<i class="ri-map-pin-line"></i><span>{CITY_LOCALE}</span>
					</div><div class="flex items-center space-x-2">							<i class="ri-time-line"></i><span>{HOURS_LABEL}</span>
					</div>
				</div>
			</div>
		</div><div class="mt-8 border-t border-gray-800 pt-8 text-center text-gray-400">
			<p>© {new Date().getFullYear()} {NAME}. Todos los derechos reservados.</p>
		</div>			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
			<nav class="legal-links" aria-label="Información legal">
				<a href="/aviso-legal">Aviso legal</a>
				<a href="/aviso-legal#privacidad">Privacidad</a>
				<a href="/aviso-legal#cookies">Cookies</a>
			</nav>
	</div>
</footer>
