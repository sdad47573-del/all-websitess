---
import { WhatsappIcon } from '@astro-icons';
import { WA_HREF } from '../data/business';

const {} = Astro.props;
---

<div class="fab z-40" transition:name="fab">
	<a
		target="_blank"
		rel="noopener noreferrer"
		href={WA_HREF}
		class="!visible !scale-none !opacity-100"
	>
		<WhatsappIcon />
	</a>
</div>
