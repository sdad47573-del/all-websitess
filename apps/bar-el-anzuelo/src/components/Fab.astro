---
import WhatsappIcon from "../icons/WhatsappIcon.astro";
import { PHONE } from "../data/data.astro";

const {} = Astro.props;
---

<div class="fab z-40" transition:name="fab">
  <a
    target="_blank"
    rel="noopener noreferrer"
    href={`https://wa.me/34${PHONE}`}
    class="!visible !opacity-100 !scale-none"
  >
    <WhatsappIcon />
  </a>
</div>
