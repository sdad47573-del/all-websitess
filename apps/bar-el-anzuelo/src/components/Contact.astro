---
import { PHONE } from "../data/data.astro";
---

<section id="contacto" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
        Contacta con Nosotros
      </h2><p class="text-xl text-gray-600 max-w-3xl mx-auto">
        ¿Necesitas ayuda con tu cerradura? Contacta con nuestro equipo de
        profesionales.
      </p>
    </div>
    <div class="grid lg:grid-cols-2 grid-cols-1 gap-8">
      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-4 gap-x-8 justify-self-center"
      >
        <div class="flex items-start space-x-4">
          <div class="bg-teal-600 text-white p-3 rounded-lg">
            <i class="ri-phone-line text-xl"></i>
          </div>
          <div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">
              Teléfono de Emergencia
            </h3><p class="text-lg text-teal-600 font-semibold">{PHONE}</p><p
              class="text-gray-600"
            >
              Disponible 24 horas, 7 días a la semana
            </p>
          </div>
        </div><div class="flex items-start gap-4">
          <div class="bg-teal-600 text-white p-3 rounded-lg">
            <i class="ri-whatsapp-line text-xl"></i>
          </div><div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">WhatsApp</h3><p
              class="text-lg text-teal-600 font-semibold"
            >
              +34 {PHONE}
            </p><p class="text-gray-600">Respuesta rápida por WhatsApp</p>
          </div>
        </div><div class="flex items-start gap-4">
          <div class="bg-teal-600 text-white p-3 rounded-lg">
            <i class="ri-map-pin-line text-xl"></i>
          </div><div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Ubicación</h3><p
              class="text-gray-600"
            >
              Calle Ejemplo 123<br />29001 Málaga, España
            </p>
          </div>
        </div><div class="flex items-start gap-4">
          <div class="bg-teal-600 text-white p-3 rounded-lg">
            <i class="ri-time-line text-xl"></i>
          </div><div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Horario</h3><p
              class="text-gray-600"
            >
              Servicio de emergencia: 24/7<br />Oficina: Lunes a Viernes
              8:00-20:00
            </p>
          </div>
        </div>
      </div>
      <div class="">
        <h3 class="text-2xl font-bold text-gray-900 mb-4">
          Nos encontramos en
        </h3><div class="aspect-video rounded-lg overflow-hidden">
          <!-- width="400"
            height="300" -->
          <!-- width="600"
            height="450" -->
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3197.6329393168057!2d-4.431753587949721!3d36.731375871459434!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd72f78298284299%3A0x4cd387e477b60e15!2sCerrajero%20M%C3%A1laga%20barato!5e0!3m2!1ses!2ses!4v1760707970974!5m2!1ses!2ses"
            width="100%"
            height="100%"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            style="border: 0px;"></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
