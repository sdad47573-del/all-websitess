---
import { Layout } from '@astro-components';
import Fab from '../components/Fab.astro';
import Favicon from './Favicon.astro';
import '../styles/index.css';

import 'remixicon/fonts/remixicon.css';
import QRImg from '@assets/QR/elAnzuelo.svg';
import Footer from '../components/Footer.astro';
import Topbar from '../components/Topbar.astro';

const { title, description } = Astro.props;
---

<Layout
	Favicon={Favicon}
	dataTheme="ceerrajero-malaga"
	QRProps={{
		src: QRImg,
		alt: 'Código QR para compartir el sitio web de Forja Francisco Javier e Hijos',
		label: 'Escanea para compartir',
	}}
	Fab={Fab}
	Topbar={Topbar}
	Footer={Footer}
	title={title}
	description={description}
	keywords="web, diseño web, presencia digital, SEO, página web"
	canonical='="https://cerrajeroeconomicomalaga.vercel.app/"'
	ogTitle="Sur Digital | Tu Presencia Digital Comienza Aquí"
	ogUrl="https://sur-digital.vercel.app/"
	ogImage="https://sur-digital.vercel.app/favicon.png"
	ogDescription="Empieza hoy desde 0€, crea tu presencia online en menos de 7 días."
	author="Jose Aguilar - linkedin.com/in/jose-antonio-aguilar-granados"><slot /></Layout
>
