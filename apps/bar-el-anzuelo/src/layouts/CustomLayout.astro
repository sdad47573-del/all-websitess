---
import { Layout } from '@astro-components';
import Fab from '../components/Fab.astro';
import Favicon from './Favicon.astro';
import '../styles/index.css';

import 'remixicon/fonts/remixicon.css';
import QRImg from '../assets/fotos/elAnzuelo.svg';
import Footer from '../components/Footer.astro';
import Topbar from '../components/Topbar.astro';

import {
	NAME,
	CITY,
	CITY_LOCALE,
	PHONE,
	PHONE_DIGITS,
	REGION_CODE,
	MAPS_URL,
	OPENING_HOURS,
} from '../data/business';

const { title, description } = Astro.props;

const SITE = Astro.site?.toString().replace(/\/$/, '') ?? 'https://elanzuelo.vercel.app';
// Canónica por página: con una sola ruta fija, aviso-legal se estaría declarando
// duplicado de la portada.
const canonical = new URL(Astro.url.pathname, `${SITE}/`).href;
const PAGE_TITLE =
	title ?? `${NAME} · Restaurante de mariscos y pescados frescos en ${CITY}`;
const PAGE_DESCRIPTION =
	description ??
	`${NAME} en ${CITY_LOCALE}. Cocina del mar: pescados frescos, mariscos y moluscos. Reservas en el ${PHONE}.`;
const OG_IMAGE = `${SITE}/og.png`;
const OG_IMAGE_ALT = `${NAME} · Restaurante de mariscos y pescados frescos en ${CITY}`;

// La dirección exacta no está confirmada, así que el schema se queda en los datos
// verificados (localidad y provincia) en lugar de inventar una calle.
const schemaData = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${SITE}/#restaurant`,
	name: NAME,
	description: PAGE_DESCRIPTION,
	url: canonical,
	image: OG_IMAGE,
	telephone: `+34${PHONE_DIGITS}`,
	inLanguage: 'es-ES',
	address: {
		'@type': 'PostalAddress',
		addressLocality: CITY,
		addressRegion: REGION_CODE,
		addressCountry: 'ES',
	},
	hasMap: MAPS_URL,
	openingHoursSpecification: OPENING_HOURS,
	servesCuisine: ['Pescados', 'Mariscos', 'Moluscos'],
};
---

<Layout
	Favicon={Favicon}
	dataTheme="elanzuelo"
	QRProps={{
		src: QRImg,
		alt: `Código QR para compartir el sitio web de ${NAME}`,
		label: 'Escanea para compartir',
	}}
	Fab={Fab}
	Topbar={Topbar}
	Footer={Footer}
	title={PAGE_TITLE}
	description={PAGE_DESCRIPTION}
	keywords={`restaurante ${CITY}, mariscos ${CITY}, pescado fresco ${CITY}, ${NAME}, menu mariscos`}
	canonical={canonical}
	ogTitle={PAGE_TITLE}
	ogUrl={canonical}
	ogImage={OG_IMAGE}
	ogImageAlt={OG_IMAGE_ALT}
	ogDescription={PAGE_DESCRIPTION}
	ogSitename={NAME}
	author={NAME}
	themeColor="#1d4ed8"
	schemaData={schemaData}><slot /></Layout
>
