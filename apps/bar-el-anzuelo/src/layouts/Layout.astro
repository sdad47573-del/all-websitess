---
import Fab from "../components/Fab.astro";
import "../styles/global.css";

import "remixicon/fonts/remixicon.css";

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="ceerrajero-malaga">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="keywords"
      content="web, diseño web, presencia digital, SEO, página web"
    />
    <meta
      name="author"
      content="Jose Aguilar - linkedin.com/in/jose-antonio-aguilar-granados"
    />
    <!-- SEO / indexación -->
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://cerrajeroeconomicomalaga.vercel.app/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Sur Digital | Tu Presencia Digital Comienza Aquí"
    />
    <meta
      property="og:description"
      content="Empieza hoy desde 0€, crea tu presencia online en menos de 7 días."
    />
    <meta
      property="og:url"
      content="https://cerrajeroeconomicomalaga.vercel.app/"
    />
    <meta
      property="og:image"
      content="https://cerrajeroeconomicomalaga.vercel.app/favicon.png"
    />
    <!--  -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Sur Digital | Tu Presencia Digital Comienza Aquí"
    />
    <meta
      name="twitter:description"
      content="Empieza hoy desde 0€, crea tu presencia online en menos de 7 días."
    />
    <meta
      name="twitter:image"
      content="https://cerrajeroeconomicomalaga.vercel.app/favicon.png"
    />
  </head>
  <body>
    <Fab />
    <slot />
  </body>
</html>
