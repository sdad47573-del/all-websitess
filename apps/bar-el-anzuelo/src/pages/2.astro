---
import { getImage } from 'astro:assets';
import Hero from '../assets/hero.jpg';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import { DATA, PHONE } from '../data/data.astro';
import CustomLayout from '../layouts/CustomLayout.astro';

const optimized = await getImage({ src: Hero, width: 700, format: 'webp' });
---

<CustomLayout>
	<div class="min-h-screen">
		<header class="sticky top-0 z-50 bg-white shadow-sm">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="flex items-center justify-between py-4">
					<div class="flex-shrink-0">
						<h1 class="text-2xl font-bold text-gray-800" style="font-family: Pacifico, serif;">
							logo
						</h1>
					</div><nav class="hidden space-x-8 md:flex">
						<a href="#inicio" class="text-gray-700 transition-colors hover:text-amber-600">Inicio</a
						><a href="#cocina" class="text-gray-700 transition-colors hover:text-amber-600"
							>Cocina Mediterránea</a
						><a href="#carta" class="text-gray-700 transition-colors hover:text-amber-600">Carta</a
						><a href="#nosotros" class="text-gray-700 transition-colors hover:text-amber-600"
							>Sobre Nosotros</a
						><a href="#contacto" class="text-gray-700 transition-colors hover:text-amber-600"
							>Contacto</a
						>
					</nav><div class="hidden md:block">
						<a
							href="tel:+34622415004"
							class="inline-flex cursor-pointer items-center justify-center bg-amber-600 px-6 py-3 text-base font-medium whitespace-nowrap text-white transition-all duration-200 hover:bg-amber-700"
							>LLAMAR</a
						>
					</div><div class="md:hidden">
						<button class="cursor-pointer text-gray-700 hover:text-amber-600"
							><i class="ri-menu-line text-2xl"></i></button
						>
					</div>
				</div>
			</div>
		</header><main>
			<section
				id="inicio"
				class="relative flex min-h-screen items-center justify-center bg-cover bg-center bg-no-repeat"
				style='background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url("https://readdy.ai/api/search-image?query=elegant%20mediterranean%20restaurant%20interior%20with%20warm%20lighting%2C%20modern%20rustic%20decor%2C%20wooden%20tables%2C%20ambient%20atmosphere%2C%20professional%20food%20photography%20style%2C%20high-end%20dining%20establishment%20with%20sophisticated%20design%20elements&width=1920&height=1080&seq=hero-bg&orientation=landscape");'
			>
				<div class="z-10 mx-auto max-w-4xl px-4 text-center text-white">
					<h1 class="mb-6 text-6xl font-bold md:text-8xl">
						MEDITERRÁ<span class="text-amber-500">N</span>EO
					</h1><h2 class="mb-8 text-2xl font-light md:text-3xl">Cocina Mediterránea</h2><a
						href="tel:+34622415004"
						class="inline-flex cursor-pointer items-center justify-center bg-amber-600 px-8 py-4 text-lg font-medium whitespace-nowrap text-white transition-all duration-200 hover:bg-amber-700"
						>LLAMAR</a
					>
				</div>
			</section><section class="bg-gray-50 py-20">
				<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
					<div class="mb-16 text-center">
						<img
							alt="Logo"
							class="mx-auto mb-8 h-20 object-contain"
							src="https://readdy.ai/api/search-image?query=elegant%20restaurant%20logo%20design%20with%20mediterranean%20elements%2C%20golden%20color%20scheme%2C%20minimalist%20style%2C%20professional%20branding%20for%20upscale%20dining%20establishment&width=400&height=120&seq=logo-intro&orientation=landscape"
						/><p class="mx-auto max-w-3xl text-lg text-gray-700">
							Nuestro restaurante se crea para personas de pico fino, buscadores de vinos con alma y
							disfrutones del buen comer y del mejor ambiente.
						</p>
					</div><div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-3">
						<div class="lg:col-span-1">
							<img
								alt="Chef preparando platos"
								class="h-96 w-full rounded-lg object-cover shadow-lg lg:h-[500px]"
								src="https://readdy.ai/api/search-image?query=professional%20chef%20preparing%20mediterranean%20dish%20in%20modern%20kitchen%2C%20culinary%20artistry%2C%20fresh%20ingredients%2C%20cooking%20process%2C%20restaurant%20kitchen%20atmosphere%2C%20high-quality%20food%20photography&width=600&height=800&seq=chef-cooking&orientation=portrait"
							/>
						</div><div class="text-center lg:col-span-1 lg:text-left">
							<p class="mb-2 font-semibold tracking-wide text-amber-600 uppercase">CARTA</p><h2
								class="mb-6 text-3xl font-bold text-gray-800 lg:text-4xl"
							>
								Restaurante Mediterrá<span class="text-amber-600">n</span>eo
							</h2><div class="space-y-4 text-gray-700">
								<p>
									Somos un <strong>restaurante</strong> situado en el entorno del puerto y La Malagueta.
									Un sitio imprescindible para disfrutar de los mejores platos de la <strong
										>cocina mediterránea</strong
									>junto a una buena copa de vino.
								</p><p>
									Nuestro restaurante lo forma un <strong>equipo cercano y desenfadado</strong>, de
									esos que te hacen sentir como en casa, y que te guiará en esta experiencia
									culinaria por el mundo de los sentidos.
								</p><p>
									Despierta tus sensaciones con una <strong
										>cocina española tradicional y moderna</strong
									>.
								</p><p class="font-semibold text-amber-600">Te atraerá y te atrapará.</p>
							</div><div class="mt-8">
								<a
									href="#carta"
									class="inline-flex cursor-pointer items-center justify-center bg-amber-600 px-6 py-3 text-base font-medium whitespace-nowrap text-white transition-all duration-200 hover:bg-amber-700"
									>VER LA CARTA</a
								>
							</div>
						</div><div class="lg:col-span-1">
							<img
								alt="Comedor del restaurante"
								class="h-96 w-full rounded-lg object-cover shadow-lg lg:h-[500px]"
								src="https://readdy.ai/api/search-image?query=beautiful%20mediterranean%20restaurant%20dining%20room%20with%20elegant%20table%20setting%2C%20warm%20ambient%20lighting%2C%20sophisticated%20interior%20design%2C%20upscale%20dining%20atmosphere%2C%20professional%20restaurant%20photography&width=600&height=800&seq=dining-room&orientation=portrait"
							/>
						</div>
					</div>
				</div>
			</section><section class="bg-white py-20">
				<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
					<div class="mb-16 text-center">
						<h2 class="mb-4 text-4xl font-bold text-gray-800">
							¿Qué te <span class="text-amber-600">ofrecemos</span>?
						</h2>
					</div><div class="grid grid-cols-1 gap-12 md:grid-cols-3">
						<div class="text-center">
							<div class="mb-6">
								<img
									alt="Comida mediterránea"
									class="mx-auto h-32 w-32 rounded-full object-cover shadow-lg"
									src="https://readdy.ai/api/search-image?query=fresh%20mediterranean%20ingredients%2C%20olive%20oil%2C%20vegetables%2C%20herbs%2C%20healthy%20cooking%20elements%2C%20clean%20white%20background%2C%20food%20styling%20photography%2C%20vibrant%20colors&width=300&height=300&seq=mediterranean-food&orientation=squarish"
								/>
							</div><h3 class="mb-4 text-xl font-bold text-gray-800">
								<span class="text-amber-600">Comida mediterránea</span>
							</h3><p class="leading-relaxed text-gray-600">
								Platos saludables y sabrosos con un claro punto de partida: la Dieta Mediterránea
							</p>
						</div><div class="text-center">
							<div class="mb-6">
								<img
									alt="Vinos"
									class="mx-auto h-32 w-32 rounded-full object-cover shadow-lg"
									src="https://readdy.ai/api/search-image?query=elegant%20wine%20glass%20with%20red%20wine%2C%20wine%20bottle%2C%20sophisticated%20wine%20selection%2C%20restaurant%20wine%20service%2C%20professional%20beverage%20photography%2C%20warm%20lighting&width=300&height=300&seq=wine-service&orientation=squarish"
								/>
							</div><h3 class="mb-4 text-xl font-bold text-gray-800">
								<span class="text-amber-600">Vinos</span>
							</h3><p class="leading-relaxed text-gray-600">
								Contamos con una amplia carta de vinos para los paladares más exquisitos.
							</p>
						</div><div class="text-center">
							<div class="mb-6">
								<img
									alt="Cócteles"
									class="mx-auto h-32 w-32 rounded-full object-cover shadow-lg"
									src="https://readdy.ai/api/search-image?query=artisanal%20cocktail%20with%20garnish%2C%20professional%20bartending%2C%20colorful%20mixed%20drinks%2C%20bar%20atmosphere%2C%20craft%20cocktails%2C%20elegant%20glassware%2C%20restaurant%20bar%20setting&width=300&height=300&seq=cocktails&orientation=squarish"
								/>
							</div><h3 class="mb-4 text-xl font-bold text-gray-800">
								<span class="text-amber-600">Cócteles</span>
							</h3><p class="leading-relaxed text-gray-600">
								¿Te apetece un cóctel con vistas al puerto? ¡Está hecho!
							</p>
						</div>
					</div>
				</div>
			</section><section
				class="relative bg-cover bg-fixed bg-center py-20"
				style='background-image: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url("https://readdy.ai/api/search-image?query=elegant%20restaurant%20terrace%20at%20sunset%2C%20mediterranean%20coastal%20view%2C%20warm%20golden%20lighting%2C%20outdoor%20dining%20atmosphere%2C%20romantic%20setting%2C%20professional%20restaurant%20photography&width=1920&height=1080&seq=testimonials-bg&orientation=landscape");'
			>
				<div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
					<div class="mb-12 text-white">
						<h2 class="mb-8 text-4xl font-bold">
							Fácil entrar, <span class="text-amber-500">imposible salir</span>
						</h2>
					</div><div class="relative">
						<div class="rounded-lg bg-white/10 p-8 text-white backdrop-blur-sm">
							<p class="mb-6 text-lg leading-relaxed italic">
								"Sitio tranquilo, decoración original, divertida y presentación de platos
								fantástica. Servicio estupendo, trato muy agradable y calidad en la materia prima.
								Buena relación calidad-precio. Si estás por la zona recomendable."
							</p><p class="font-semibold text-amber-400">Ana López</p>
						</div><div class="mt-8 flex justify-center space-x-2">
							<button class="h-3 w-3 cursor-pointer rounded-full bg-white/50 transition-colors"
							></button><button
								class="h-3 w-3 cursor-pointer rounded-full bg-white/50 transition-colors"
							></button><button
								class="h-3 w-3 cursor-pointer rounded-full bg-amber-500 transition-colors"
							></button><button
								class="h-3 w-3 cursor-pointer rounded-full bg-white/50 transition-colors"></button>
						</div><button
							class="absolute top-1/2 left-0 -translate-y-1/2 transform cursor-pointer text-white transition-colors hover:text-amber-500"
							><i class="ri-arrow-left-line text-2xl"></i></button
						><button
							class="absolute top-1/2 right-0 -translate-y-1/2 transform cursor-pointer text-white transition-colors hover:text-amber-500"
							><i class="ri-arrow-right-line text-2xl"></i></button
						>
					</div>
				</div>
			</section><section class="bg-gray-50 py-20">
				<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
					<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-3">
						<div class="lg:col-span-1">
							<img
								alt="Interior del restaurante"
								class="h-96 w-full rounded-lg object-cover shadow-lg lg:h-[600px]"
								src="https://readdy.ai/api/search-image?query=beautiful%20mediterranean%20restaurant%20interior%2C%20warm%20ambient%20lighting%2C%20elegant%20dining%20room%2C%20sophisticated%20decor%2C%20professional%20restaurant%20photography%2C%20inviting%20atmosphere&width=600&height=800&seq=restaurant-interior&orientation=portrait"
							/>
						</div><div class="lg:col-span-1">
							<div class="mb-8 text-center lg:text-left">
								<p class="mb-2 font-semibold tracking-wide text-amber-600 uppercase">SABOR</p><h2
									class="mb-6 text-3xl font-bold text-gray-800 lg:text-4xl"
								>
									<span class="text-amber-600">Restaurante</span> en el centro
								</h2><p class="leading-relaxed text-gray-700">
									Productos de nuestra tierra, cocina mediterránea, vanguardia, un servicio de
									calidad, postres caseros, opciones para vegetarianos y veganos… Tienes un sinfín
									de opciones para disfrutar en nuestro restaurante, y ninguna excusa para no venir.
								</p>
							</div><div class="space-y-6">
								<div class="flex items-start space-x-4">
									<div class="flex-shrink-0">
										<img
											alt="Terraza frente al puerto"
											class="h-16 w-16 rounded-full object-cover"
											src="https://readdy.ai/api/search-image?query=restaurant%20terrace%20overlooking%20harbor%2C%20outdoor%20dining%20with%20sea%20view%2C%20mediterranean%20coastal%20setting%2C%20elegant%20patio%20furniture%2C%20sunset%20lighting%2C%20professional%20restaurant%20photography&width=200&height=200&seq=terrace-icon&orientation=squarish"
										/>
									</div><div>
										<h3 class="mb-2 text-lg font-bold text-gray-800">
											<span class="text-amber-600">Terraza frente al puerto</span>
										</h3><p class="text-sm leading-relaxed text-gray-600">
											Disfruta de nuestros platos en nuestra acogedora terraza
										</p>
									</div>
								</div><div class="flex items-start space-x-4">
									<div class="flex-shrink-0">
										<img
											alt="Tradición y vanguardia"
											class="h-16 w-16 rounded-full object-cover"
											src="https://readdy.ai/api/search-image?query=modern%20culinary%20techniques%2C%20molecular%20gastronomy%2C%20innovative%20food%20presentation%2C%20chef%20artistry%2C%20contemporary%20cooking%20methods%2C%20professional%20kitchen%20photography&width=200&height=200&seq=innovation-icon&orientation=squarish"
										/>
									</div><div>
										<h3 class="mb-2 text-lg font-bold text-gray-800">
											<span class="text-amber-600">Tradición y vanguardia</span>
										</h3><p class="text-sm leading-relaxed text-gray-600">
											Nos gusta fusionar los platos de toda la vida con técnicas y sabores de
											vanguardia.
										</p>
									</div>
								</div><div class="flex items-start space-x-4">
									<div class="flex-shrink-0">
										<img
											alt="Eventos"
											class="h-16 w-16 rounded-full object-cover"
											src="https://readdy.ai/api/search-image?query=elegant%20restaurant%20event%20setup%2C%20private%20dining%20celebration%2C%20special%20occasion%20table%20setting%2C%20festive%20atmosphere%2C%20professional%20event%20photography&width=200&height=200&seq=events-icon&orientation=squarish"
										/>
									</div><div>
										<h3 class="mb-2 text-lg font-bold text-gray-800">
											<span class="text-amber-600">Eventos</span>
										</h3><p class="text-sm leading-relaxed text-gray-600">
											Celebra tu evento en nuestro restaurante
										</p>
									</div>
								</div>
							</div>
						</div><div class="lg:col-span-1">
							<img
								alt="Plato gourmet"
								class="h-96 w-full rounded-lg object-cover shadow-lg lg:h-[600px]"
								src="https://readdy.ai/api/search-image?query=gourmet%20mediterranean%20dish%20presentation%2C%20artistic%20food%20plating%2C%20fine%20dining%20cuisine%2C%20chef%20masterpiece%2C%20colorful%20fresh%20ingredients%2C%20professional%20food%20photography&width=600&height=800&seq=gourmet-dish&orientation=portrait"
							/>
						</div>
					</div>
				</div>
			</section><section class="bg-white py-20">
				<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
					<div class="mb-12 text-center">
						<img
							alt="Premio"
							class="mx-auto mb-8 h-20 object-contain"
							src="https://readdy.ai/api/search-image?query=elegant%20restaurant%20award%20icon%2C%20golden%20trophy%2C%20culinary%20excellence%20symbol%2C%20fine%20dining%20recognition%2C%20professional%20restaurant%20branding&width=140&height=155&seq=award-icon&orientation=portrait"
						/>
					</div><div class="grid grid-cols-1 gap-8 md:grid-cols-3">
						<div class="text-center">
							<div class="mb-2 text-5xl font-bold text-amber-600">2000</div><h3
								class="text-xl font-semibold text-gray-800"
							>
								Clientes
							</h3>
						</div><div class="text-center">
							<div class="mb-2 text-5xl font-bold text-amber-600">3</div><h3
								class="text-xl font-semibold text-gray-800"
							>
								Años de experiencia
							</h3>
						</div><div class="text-center">
							<div class="mb-2 text-5xl font-bold text-amber-600">+35</div><h3
								class="text-xl font-semibold text-gray-800"
							>
								Platos
							</h3>
						</div>
					</div>
				</div>
			</section><section class="bg-gray-50 py-20">
				<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
					<div class="mb-12 text-center">
						<h2 class="text-4xl font-bold text-gray-800">Galería de fotos</h2>
					</div><div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
						<div class="group relative cursor-pointer overflow-hidden rounded-lg shadow-lg">
							<img
								alt="Comedor elegante"
								class="h-64 w-full object-cover transition-transform duration-300 group-hover:scale-110"
								src="https://readdy.ai/api/search-image?query=elegant%20restaurant%20dining%20room%20with%20beautiful%20table%20setting%2C%20warm%20lighting%2C%20sophisticated%20interior%20design%2C%20fine%20dining%20atmosphere%2C%20professional%20restaurant%20photography&width=540&height=540&seq=gallery-1&orientation=squarish"
							/><div
								class="absolute inset-0 flex items-center justify-center bg-black/0 transition-colors duration-300 group-hover:bg-black/30"
							>
								<i
									class="ri-zoom-in-line text-2xl text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100"
								></i>
							</div>
						</div><div class="group relative cursor-pointer overflow-hidden rounded-lg shadow-lg">
							<img
								alt="Plato gourmet"
								class="h-64 w-full object-cover transition-transform duration-300 group-hover:scale-110"
								src="https://readdy.ai/api/search-image?query=gourmet%20mediterranean%20dish%20beautifully%20plated%2C%20artistic%20food%20presentation%2C%20colorful%20fresh%20ingredients%2C%20fine%20dining%20cuisine%2C%20professional%20food%20photography&width=540&height=540&seq=gallery-2&orientation=squarish"
							/><div
								class="absolute inset-0 flex items-center justify-center bg-black/0 transition-colors duration-300 group-hover:bg-black/30"
							>
								<i
									class="ri-zoom-in-line text-2xl text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100"
								></i>
							</div>
						</div><div class="group relative cursor-pointer overflow-hidden rounded-lg shadow-lg">
							<img
								alt="Cocina profesional"
								class="h-64 w-full object-cover transition-transform duration-300 group-hover:scale-110"
								src="https://readdy.ai/api/search-image?query=restaurant%20kitchen%20with%20chef%20cooking%2C%20professional%20culinary%20preparation%2C%20modern%20kitchen%20equipment%2C%20cooking%20in%20action%2C%20restaurant%20behind%20scenes&width=540&height=540&seq=gallery-3&orientation=squarish"
							/><div
								class="absolute inset-0 flex items-center justify-center bg-black/0 transition-colors duration-300 group-hover:bg-black/30"
							>
								<i
									class="ri-zoom-in-line text-2xl text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100"
								></i>
							</div>
						</div><div class="group relative cursor-pointer overflow-hidden rounded-lg shadow-lg">
							<img
								alt="Terraza al atardecer"
								class="h-64 w-full object-cover transition-transform duration-300 group-hover:scale-110"
								src="https://readdy.ai/api/search-image?query=restaurant%20terrace%20at%20sunset%20with%20harbor%20view%2C%20outdoor%20dining%20setup%2C%20romantic%20atmosphere%2C%20mediterranean%20coastal%20setting%2C%20golden%20hour%20lighting&width=540&height=540&seq=gallery-4&orientation=squarish"
							/><div
								class="absolute inset-0 flex items-center justify-center bg-black/0 transition-colors duration-300 group-hover:bg-black/30"
							>
								<i
									class="ri-zoom-in-line text-2xl text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100"
								></i>
							</div>
						</div>
					</div>
				</div>
			</section><section id="contacto" class="bg-white py-20">
				<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
					<div class="mb-12 text-center">
						<img
							alt="Reserva"
