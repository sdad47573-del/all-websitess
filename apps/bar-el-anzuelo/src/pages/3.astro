---
import CustomLayout from '../layouts/CustomLayout.astro';
---

<CustomLayout>
	<div class="min-h-screen bg-white">
		<header class="sticky top-0 z-40 bg-white shadow-sm">
			<nav class="px-6 py-4">
				<div class="flex items-center justify-between">
					<div class="flex items-center space-x-2">
						<div class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-600">
							<i class="ri-restaurant-line text-xl text-white"></i>
						</div><h1
							class="text-2xl font-bold text-blue-600"
							style="font-family: Pacifico, serif;"
						>
							El Pescaíto
						</h1>
					</div><div class="hidden items-center space-x-8 md:flex">
						<a
							href="#inicio"
							class="cursor-pointer text-gray-700 transition-colors hover:text-blue-600">Inicio</a
						><a
							href="#carta"
							class="cursor-pointer text-gray-700 transition-colors hover:text-blue-600">Carta</a
						><a
							href="#local"
							class="cursor-pointer text-gray-700 transition-colors hover:text-blue-600"
							>Nuestro Local</a
						><a
							href="#contacto"
							class="cursor-pointer text-gray-700 transition-colors hover:text-blue-600">Contacto</a
						><button
							class="cursor-pointer rounded-full bg-blue-600 px-6 py-2 whitespace-nowrap text-white transition-colors hover:bg-blue-700"
							>Reservar Mesa</button
						>
					</div>
				</div>
			</nav>
		</header><section
			id="inicio"
			class="relative flex h-screen items-center justify-center overflow-hidden"
		>
			<div
				class="absolute inset-0 bg-cover bg-center"
				style='background-image: url("https://readdy.ai/api/search-image?query=Traditional%20Spanish%20seafood%20restaurant%20interior%20with%20fresh%20fried%20fish%20display%2C%20warm%20Mediterranean%20lighting%2C%20rustic%20wooden%20tables%2C%20authentic%20Andalusian%20atmosphere%2C%20fishing%20nets%20decoration%2C%20coastal%20ambiance%2C%20inviting%20and%20cozy%20dining%20space&width=1920&height=1080&seq=hero-bg&orientation=landscape");'
			>
				<div class="absolute inset-0 bg-black/40"></div>
			</div><div class="relative z-10 max-w-4xl px-6 text-center text-white">
				<h1 class="mb-6 text-5xl font-bold md:text-7xl" style="font-family: Pacifico, serif;">
					Marisquería El Pescaíto
				</h1><p class="mb-8 text-xl font-light md:text-2xl">
					Auténtico pescado frito fresco en el corazón de Málaga
				</p><p class="mx-auto mb-10 max-w-2xl text-lg">
					Desde 1985 sirviendo la mejor tradición culinaria andaluza con pescado fresco del día,
					preparado con técnicas que han pasado de generación en generación.
				</p><div class="flex flex-col justify-center gap-4 sm:flex-row">
					<button
						class="cursor-pointer rounded-full bg-blue-600 px-8 py-4 text-lg font-semibold whitespace-nowrap text-white transition-colors hover:bg-blue-700"
						>Reservar Mesa</button
					><a
						href="#carta"
						class="cursor-pointer rounded-full border-2 border-white px-8 py-4 text-lg font-semibold whitespace-nowrap text-white transition-colors hover:bg-white hover:text-blue-600"
						>Ver Carta</a
					>
				</div>
			</div>
		</section><section class="bg-blue-50 py-16">
			<div class="mx-auto max-w-6xl px-6">
				<div class="mb-12 text-center">
					<h2 class="mb-4 text-4xl font-bold text-gray-800">Horarios de Apertura</h2><p
						class="text-lg text-gray-600"
					>
						Ven a disfrutar de nuestras especialidades
					</p>
				</div><div class="mx-auto grid max-w-4xl gap-8 md:grid-cols-2">
					<div class="rounded-2xl bg-white p-8 shadow-lg">
						<div
							class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100"
						>
							<i class="ri-sun-line text-2xl text-blue-600"></i>
						</div><h3 class="mb-6 text-center text-2xl font-bold text-gray-800">Almuerzo</h3><div
							class="space-y-3"
						>
							<div class="flex items-center justify-between">
								<span class="font-semibold text-gray-700">Lunes - Viernes</span><span
									class="font-bold text-blue-600">12:00 - 16:00</span
								>
							</div><div class="flex items-center justify-between">
								<span class="font-semibold text-gray-700">Sábados - Domingos</span><span
									class="font-bold text-blue-600">12:00 - 16:30</span
								>
							</div>
						</div>
					</div><div class="rounded-2xl bg-white p-8 shadow-lg">
						<div
							class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-orange-100"
						>
							<i class="ri-moon-line text-2xl text-orange-600"></i>
						</div><h3 class="mb-6 text-center text-2xl font-bold text-gray-800">Cena</h3><div
							class="space-y-3"
						>
							<div class="flex items-center justify-between">
								<span class="font-semibold text-gray-700">Lunes - Jueves</span><span
									class="font-bold text-orange-600">20:00 - 23:30</span
								>
							</div><div class="flex items-center justify-between">
								<span class="font-semibold text-gray-700">Viernes - Sábados</span><span
									class="font-bold text-orange-600">20:00 - 00:30</span
								>
							</div><div class="flex items-center justify-between">
								<span class="font-semibold text-gray-700">Domingos</span><span
									class="font-bold text-orange-600">20:00 - 23:00</span
								>
							</div>
						</div>
					</div>
				</div><div class="mt-8 text-center">
					<p class="text-lg text-gray-600">
						<i class="ri-information-line mr-2 text-blue-600"></i>Cerramos los martes por descanso
						del personal
					</p>
				</div>
			</div>
		</section><section id="carta" class="bg-white py-20">
			<div class="mx-auto max-w-6xl px-6">
				<div class="mb-16 text-center">
					<h2 class="mb-4 text-4xl font-bold text-gray-800">Nuestra Carta</h2><p
						class="mx-auto max-w-2xl text-lg text-gray-600"
					>
						Pescado fresco del día, mariscos de la costa y especialidades tradicionales andaluzas
					</p>
				</div><div class="mb-12 flex flex-wrap justify-center gap-4">
					<button
						class="cursor-pointer rounded-full bg-blue-600 px-6 py-3 font-semibold whitespace-nowrap text-white transition-colors"
						>Pescado Frito</button
					><button
						class="cursor-pointer rounded-full bg-gray-100 px-6 py-3 font-semibold whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-200"
						>Mariscos</button
					><button
						class="cursor-pointer rounded-full bg-gray-100 px-6 py-3 font-semibold whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-200"
						>Arroces &amp; Paellas</button
					><button
						class="cursor-pointer rounded-full bg-gray-100 px-6 py-3 font-semibold whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-200"
						>Tapas</button
					>
				</div><div class="grid gap-6 md:grid-cols-2">
					<div class="rounded-xl bg-gray-50 p-6 transition-shadow hover:shadow-lg">
						<div class="mb-3 flex items-start justify-between">
							<h3 class="text-xl font-bold text-gray-800">Boquerones Fritos</h3><span
								class="text-2xl font-bold text-blue-600">8.50€</span
							>
						</div><p class="text-gray-600">Frescos del día, rebozados en harina de Cádiz</p>
					</div><div class="rounded-xl bg-gray-50 p-6 transition-shadow hover:shadow-lg">
						<div class="mb-3 flex items-start justify-between">
							<h3 class="text-xl font-bold text-gray-800">Sardinas a la Plancha</h3><span
								class="text-2xl font-bold text-blue-600">9.00€</span
							>
						</div><p class="text-gray-600">Con aceite de oliva virgen extra y sal marina</p>
					</div><div class="rounded-xl bg-gray-50 p-6 transition-shadow hover:shadow-lg">
						<div class="mb-3 flex items-start justify-between">
							<h3 class="text-xl font-bold text-gray-800">Salmonetes Fritos</h3><span
								class="text-2xl font-bold text-blue-600">12.50€</span
							>
						</div><p class="text-gray-600">Pescado local, crujiente por fuera, tierno por dentro</p>
					</div><div class="rounded-xl bg-gray-50 p-6 transition-shadow hover:shadow-lg">
						<div class="mb-3 flex items-start justify-between">
							<h3 class="text-xl font-bold text-gray-800">Chopitos Fritos</h3><span
								class="text-2xl font-bold text-blue-600">10.00€</span
							>
						</div><p class="text-gray-600">Calamares pequeños, especialidad de la casa</p>
					</div><div class="rounded-xl bg-gray-50 p-6 transition-shadow hover:shadow-lg">
						<div class="mb-3 flex items-start justify-between">
							<h3 class="text-xl font-bold text-gray-800">Pescaíto Frito Variado</h3><span
								class="text-2xl font-bold text-blue-600">15.00€</span
							>
						</div><p class="text-gray-600">Selección del día: boquerones, sardinas y salmonetes</p>
					</div><div class="rounded-xl bg-gray-50 p-6 transition-shadow hover:shadow-lg">
						<div class="mb-3 flex items-start justify-between">
							<h3 class="text-xl font-bold text-gray-800">Lenguado a la Plancha</h3><span
								class="text-2xl font-bold text-blue-600">18.00€</span
							>
						</div><p class="text-gray-600">Pescado noble con guarnición de verduras</p>
					</div>
				</div><div class="mt-12 text-center">
					<p class="mb-6 text-lg text-gray-600">
						<i class="ri-leaf-line mr-2 text-green-600"></i>Todos nuestros pescados son frescos del
						día, procedentes de la lonja de Málaga
					</p><button
						class="cursor-pointer rounded-full bg-blue-600 px-8 py-4 text-lg font-semibold whitespace-nowrap text-white transition-colors hover:bg-blue-700"
						>Reservar para Degustar</button
					>
				</div>
			</div>
		</section><section id="local" class="bg-blue-50 py-20">
			<div class="mx-auto max-w-6xl px-6">
				<div class="mb-16 text-center">
					<h2 class="mb-4 text-4xl font-bold text-gray-800">Nuestro Local</h2><p
						class="text-lg text-gray-600"
					>
						Un ambiente familiar en el corazón de Málaga
					</p>
				</div><div class="grid items-center gap-12 lg:grid-cols-2">
					<div>
						<img
							alt="Interior del restaurante"
							class="h-96 w-full rounded-2xl object-cover object-top shadow-lg"
							src="https://readdy.ai/api/search-image?query=Cozy%20traditional%20Spanish%20seafood%20restaurant%20interior%2C%20rustic%20wooden%20tables%2C%20maritime%20decorations%2C%20fishing%20nets%2C%20warm%20lighting%2C%20authentic%20Andalusian%20atmosphere%2C%20family-friendly%20dining%20space%2C%20coastal%20Mediterranean%20style&width=600&height=400&seq=restaurant-interior&orientation=landscape"
						/>
					</div><div class="space-y-6">
						<h3 class="text-3xl font-bold text-gray-800">Tradición y Autenticidad</h3><p
							class="text-lg text-gray-600"
						>
							Nuestro local conserva el encanto tradicional de las marisquerías andaluzas, con un
							ambiente familiar y acogedor que te hará sentir como en casa.
						</p><div class="space-y-4">
							<div class="flex items-center space-x-3">
								<div class="flex h-8 w-8 items-center justify-center rounded-full bg-blue-100">
									<i class="ri-group-line text-blue-600"></i>
								</div><span class="text-gray-700">Capacidad para 80 comensales</span>
							</div><div class="flex items-center space-x-3">
								<div class="flex h-8 w-8 items-center justify-center rounded-full bg-blue-100">
									<i class="ri-wheelchair-line text-blue-600"></i>
								</div><span class="text-gray-700"
									>Acceso adaptado para personas con movilidad reducida</span
								>
							</div><div class="flex items-center space-x-3">
								<div class="flex h-8 w-8 items-center justify-center rounded-full bg-blue-100">
									<i class="ri-air-conditioning-line text-blue-600"></i>
								</div><span class="text-gray-700">Aire acondicionado y terraza exterior</span>
							</div><div class="flex items-center space-x-3">
								<div class="flex h-8 w-8 items-center justify-center rounded-full bg-blue-100">
									<i class="ri-parking-line text-blue-600"></i>
								</div><span class="text-gray-700">Parking público cercano</span>
							</div>
						</div>
					</div>
				</div><div class="mt-16 grid gap-8 md:grid-cols-3">
					<div class="text-center">
						<img
							alt="Pescado fresco"
							class="mb-4 h-48 w-full rounded-xl object-cover object-top shadow-lg"
							src="https://readdy.ai/api/search-image?query=Fresh%20fish%20display%20case%20in%20Spanish%20seafood%20restaurant%2C%20variety%20of%20Mediterranean%20fish%20on%20ice%2C%20professional%20kitchen%20preparation%2C%20authentic%20market%20style%20presentation%2C%20appetizing%20seafood%20selection&width=400&height=300&seq=fish-display&orientation=landscape"
						/><h4 class="mb-2 text-xl font-bold text-gray-800">Pescado Fresco Diario</h4><p
							class="text-gray-600"
						>
							Seleccionamos el mejor pescado cada mañana en la lonja
						</p>
					</div><div class="text-center">
						<img
							alt="Cocina tradicional"
							class="mb-4 h-48 w-full rounded-xl object-cover object-top shadow-lg"
							src="https://readdy.ai/api/search-image?query=Traditional%20Spanish%20kitchen%20with%20chef%20preparing%20fried%20fish%2C%20authentic%20cooking%20techniques%2C%20professional%20seafood%20preparation%2C%20Mediterranean%20culinary%20tradition%2C%20skilled%20chef%20at%20work&width=400&height=300&seq=kitchen-chef&orientation=landscape"
						/><h4 class="mb-2 text-xl font-bold text-gray-800">Cocina Tradicional</h4><p
							class="text-gray-600"
						>
							Técnicas ancestrales transmitidas de generación en generación
						</p>
					</div><div class="text-center">
						<img
							alt="Ambiente familiar"
							class="mb-4 h-48 w-full rounded-xl object-cover object-top shadow-lg"
							src="https://readdy.ai/api/search-image?query=Happy%20family%20dining%20at%20Spanish%20seafood%20restaurant%2C%20warm%20atmosphere%2C%20traditional%20Andalusian%20hospitality%2C%20customers%20enjoying%20fresh%20fish%20meal%2C%20authentic%20local%20experience&width=400&height=300&seq=family-dining&orientation=landscape"
						/><h4 class="mb-2 text-xl font-bold text-gray-800">Ambiente Familiar</h4><p
							class="text-gray-600"
						>
							Un lugar donde las familias se reúnen para disfrutar
						</p>
					</div>
				</div>
			</div>
		</section><section id="contacto" class="bg-white py-20">
			<div class="mx-auto max-w-6xl px-6">
				<div class="mb-16 text-center">
					<h2 class="mb-4 text-4xl font-bold text-gray-800">Contacto y Ubicación</h2><p
						class="text-lg text-gray-600"
					>
						Estamos en el corazón de Málaga, esperándote
					</p>
				</div><div class="grid gap-12 lg:grid-cols-2">
					<div class="space-y-8">
						<div class="rounded-2xl bg-blue-50 p-8">
							<h3 class="mb-6 text-2xl font-bold text-gray-800">Información de Contacto</h3><div
								class="space-y-4"
							>
								<div class="flex items-center space-x-4">
									<div class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-100">
										<i class="ri-map-pin-line text-xl text-blue-600"></i>
									</div><div>
										<p class="font-semibold text-gray-800">Dirección</p><p class="text-gray-600">
											Calle del Mar 15, 29001 Málaga, España
										</p>
									</div>
								</div><div class="flex items-center space-x-4">
									<div class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-100">
										<i class="ri-phone-line text-xl text-blue-600"></i>
									</div><div>
										<p class="font-semibold text-gray-800">Teléfono</p><p class="text-gray-600">
											+34 952 123 456
										</p>
									</div>
								</div><div class="flex items-center space-x-4">
									<div class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-100">
										<i class="ri-mail-line text-xl text-blue-600"></i>
									</div><div>
										<p class="font-semibold text-gray-800">Email</p><p class="text-gray-600">
											info@elpescaito.com
										</p>
									</div>
								</div>
							</div>
						</div><div class="rounded-2xl bg-gray-50 p-8">
							<h3 class="mb-6 text-2xl font-bold text-gray-800">Cómo Llegar</h3><div
								class="space-y-3"
							>
								<div class="flex items-center space-x-3">
									<i class="ri-subway-line text-blue-600"></i><span class="text-gray-700"
										>Metro: Línea 1, parada Centro Histórico</span
									>
								</div><div class="flex items-center space-x-3">
									<i class="ri-bus-line text-blue-600"></i><span class="text-gray-700"
										>Autobús: Líneas 1, 3, 11 - Parada Plaza de la Marina</span
									>
								</div><div class="flex items-center space-x-3">
									<i class="ri-car-line text-blue-600"></i><span class="text-gray-700"
										>Parking público a 100m en Calle Larios</span
									>
								</div>
							</div>
						</div>
					</div><div class="overflow-hidden rounded-2xl bg-gray-100">
						<iframe
							src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3198.0!2d-4.4214!3d36.7213!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzbCsDQzJzE2LjciTiA0wrAyNScxNy4wIlc!5e0!3m2!1ses!2ses!4v1234567890"
							width="100%"
							height="400"
							allowfullscreen=""
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							title="Ubicación Marisquería El Pescaíto"
							style="border: 0px;"></iframe>
					</div>
				</div><div class="mt-12 text-center">
					<button
						class="cursor-pointer rounded-full bg-blue-600 px-8 py-4 text-lg font-semibold whitespace-nowrap text-white transition-colors hover:bg-blue-700"
						>Reservar Mesa Ahora</button
					>
				</div>
			</div>
		</section><footer class="bg-gray-800 py-12 text-white">
			<div class="mx-auto max-w-6xl px-6">
				<div class="grid gap-8 md:grid-cols-3">
					<div>
						<div class="mb-4 flex items-center space-x-2">
							<div class="flex h-8 w-8 items-center justify-center rounded-full bg-blue-600">
								<i class="ri-restaurant-line text-white"></i>
							</div><h3 class="text-xl font-bold" style="font-family: Pacifico, serif;">
								El Pescaíto
							</h3>
						</div><p class="mb-4 text-gray-300">
							Auténtica marisquería malagueña desde 1985. Pescado fresco, tradición y sabor en cada
							plato.
						</p><div class="flex space-x-4">
							<a
								href="#"
								class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-blue-600 transition-colors hover:bg-blue-700"
								><i class="ri-facebook-fill"></i></a
							><a
								href="#"
								class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-blue-600 transition-colors hover:bg-blue-700"
								><i class="ri-instagram-line"></i></a
							><a
								href="#"
								class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-blue-600 transition-colors hover:bg-blue-700"
								><i class="ri-tripadvisor-line"></i></a
							>
						</div>
					</div><div>
						<h4 class="mb-4 text-lg font-semibold">Enlaces Rápidos</h4><ul class="space-y-2">
							<li>
								<a
									href="#inicio"
									class="cursor-pointer text-gray-300 transition-colors hover:text-white">Inicio</a
								>
							</li><li>
								<a
									href="#carta"
									class="cursor-pointer text-gray-300 transition-colors hover:text-white">Carta</a
								>
							</li><li>
								<a
									href="#local"
									class="cursor-pointer text-gray-300 transition-colors hover:text-white"
									>Nuestro Local</a
								>
							</li><li>
								<a
									href="#contacto"
									class="cursor-pointer text-gray-300 transition-colors hover:text-white"
									>Contacto</a
								>
							</li><li>
								<button class="cursor-pointer text-gray-300 transition-colors hover:text-white"
									>Reservas</button
								>
							</li>
						</ul>
					</div><div>
						<h4 class="mb-4 text-lg font-semibold">Horarios</h4><div
							class="space-y-2 text-gray-300"
						>
							<p><strong>Almuerzo:</strong> 12:00 - 16:00</p><p>
								<strong>Cena:</strong> 20:00 - 23:30
							</p><p><strong>Cerrado:</strong> Martes</p><p class="mt-4">
								<i class="ri-phone-line mr-2"></i>+34 952 123 456
							</p>
						</div>
					</div>
				</div><div class="mt-8 border-t border-gray-700 pt-8 text-center">
					<p class="text-gray-300">
						© 2024 Marisquería El Pescaíto. Todos los derechos reservados. |<a
							href="https://readdy.ai/?origin=logo"
							class="ml-1 cursor-pointer text-blue-400 hover:text-blue-300">Powered by Readdy</a
						>
					</p>
				</div>
			</div>
		</footer>
	</div>
</CustomLayout>
