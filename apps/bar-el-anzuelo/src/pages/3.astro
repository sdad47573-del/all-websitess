---
import Layout from "../layouts/Layout.astro";

import GoogleReviews from "../components/GoogleReviews.astro";
import { DATA, PHONE } from "../data/data.astro";

import Hero from "../assets/hero.jpg";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

import { getImage } from "astro:assets";

const optimized = await getImage({ src: Hero, width: 700, format: "webp" });
---

<Layout
  title="Sur Digital Málaga | Tu Presencia Digital Comienza Aquí | Agencia de Marketing Web Online"
  description="Empieza hoy desde 0€, crea tu presencia online en menos de 7 días. Webs rápidas, modernas y optimizadas."
/>
<div id="root">
  <div class="min-h-screen bg-white">
    <header class="bg-white shadow-sm sticky top-0 z-40">
      <nav class="px-6 py-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <div
              class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center"
            >
              <i class="ri-restaurant-line text-white text-xl"></i>
            </div><h1
              class="text-2xl font-bold text-blue-600"
              style="font-family: Pacifico, serif;"
            >
              El Pescaíto
            </h1>
          </div><div class="hidden md:flex items-center space-x-8">
            <a
              href="#inicio"
              class="text-gray-700 hover:text-blue-600 transition-colors cursor-pointer"
              >Inicio</a
            ><a
              href="#carta"
              class="text-gray-700 hover:text-blue-600 transition-colors cursor-pointer"
              >Carta</a
            ><a
              href="#local"
              class="text-gray-700 hover:text-blue-600 transition-colors cursor-pointer"
              >Nuestro Local</a
            ><a
              href="#contacto"
              class="text-gray-700 hover:text-blue-600 transition-colors cursor-pointer"
              >Contacto</a
            ><button
              class="bg-blue-600 text-white px-6 py-2 rounded-full hover:bg-blue-700 transition-colors whitespace-nowrap cursor-pointer"
              >Reservar Mesa</button>
          </div>
        </div>
      </nav>
    </header><section
      id="inicio"
      class="relative h-screen flex items-center justify-center overflow-hidden"
    >
      <div
        class="absolute inset-0 bg-cover bg-center"
        style='background-image: url("https://readdy.ai/api/search-image?query=Traditional%20Spanish%20seafood%20restaurant%20interior%20with%20fresh%20fried%20fish%20display%2C%20warm%20Mediterranean%20lighting%2C%20rustic%20wooden%20tables%2C%20authentic%20Andalusian%20atmosphere%2C%20fishing%20nets%20decoration%2C%20coastal%20ambiance%2C%20inviting%20and%20cozy%20dining%20space&width=1920&height=1080&seq=hero-bg&orientation=landscape");'
      >
        <div class="absolute inset-0 bg-black/40"></div>
      </div><div class="relative z-10 text-center text-white px-6 max-w-4xl">
        <h1
          class="text-5xl md:text-7xl font-bold mb-6"
          style="font-family: Pacifico, serif;"
        >
          Marisquería El Pescaíto
        </h1><p class="text-xl md:text-2xl mb-8 font-light">
          Auténtico pescado frito fresco en el corazón de Málaga
        </p><p class="text-lg mb-10 max-w-2xl mx-auto">
          Desde 1985 sirviendo la mejor tradición culinaria andaluza con pescado
          fresco del día, preparado con técnicas que han pasado de generación en
          generación.
        </p><div class="flex flex-col sm:flex-row gap-4 justify-center">
          <button
            class="bg-blue-600 text-white px-8 py-4 rounded-full text-lg font-semibold hover:bg-blue-700 transition-colors whitespace-nowrap cursor-pointer"
            >Reservar Mesa</button
          ><a
            href="#carta"
            class="border-2 border-white text-white px-8 py-4 rounded-full text-lg font-semibold hover:bg-white hover:text-blue-600 transition-colors whitespace-nowrap cursor-pointer"
            >Ver Carta</a>
        </div>
      </div>
    </section><section class="py-16 bg-blue-50">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-gray-800 mb-4">
            Horarios de Apertura
          </h2><p class="text-lg text-gray-600">
            Ven a disfrutar de nuestras especialidades
          </p>
        </div><div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <div class="bg-white rounded-2xl p-8 shadow-lg">
            <div
              class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-6"
            >
              <i class="ri-sun-line text-blue-600 text-2xl"></i>
            </div><h3 class="text-2xl font-bold text-center mb-6 text-gray-800">
              Almuerzo
            </h3><div class="space-y-3">
              <div class="flex justify-between items-center">
                <span class="font-semibold text-gray-700">Lunes - Viernes</span
                ><span class="text-blue-600 font-bold">12:00 - 16:00</span>
              </div><div class="flex justify-between items-center">
                <span class="font-semibold text-gray-700"
                  >Sábados - Domingos</span
                ><span class="text-blue-600 font-bold">12:00 - 16:30</span>
              </div>
            </div>
          </div><div class="bg-white rounded-2xl p-8 shadow-lg">
            <div
              class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-6"
            >
              <i class="ri-moon-line text-orange-600 text-2xl"></i>
            </div><h3 class="text-2xl font-bold text-center mb-6 text-gray-800">
              Cena
            </h3><div class="space-y-3">
              <div class="flex justify-between items-center">
                <span class="font-semibold text-gray-700">Lunes - Jueves</span
                ><span class="text-orange-600 font-bold">20:00 - 23:30</span>
              </div><div class="flex justify-between items-center">
                <span class="font-semibold text-gray-700"
                  >Viernes - Sábados</span
                ><span class="text-orange-600 font-bold">20:00 - 00:30</span>
              </div><div class="flex justify-between items-center">
                <span class="font-semibold text-gray-700">Domingos</span><span
                  class="text-orange-600 font-bold">20:00 - 23:00</span>
              </div>
            </div>
          </div>
        </div><div class="text-center mt-8">
          <p class="text-gray-600 text-lg">
            <i class="ri-information-line text-blue-600 mr-2"></i>Cerramos los
            martes por descanso del personal
          </p>
        </div>
      </div>
    </section><section id="carta" class="py-20 bg-white">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-gray-800 mb-4">Nuestra Carta</h2><p
            class="text-lg text-gray-600 max-w-2xl mx-auto"
          >
            Pescado fresco del día, mariscos de la costa y especialidades
            tradicionales andaluzas
          </p>
        </div><div class="flex flex-wrap justify-center gap-4 mb-12">
          <button
            class="px-6 py-3 rounded-full font-semibold transition-colors whitespace-nowrap cursor-pointer bg-blue-600 text-white"
            >Pescado Frito</button
          ><button
            class="px-6 py-3 rounded-full font-semibold transition-colors whitespace-nowrap cursor-pointer bg-gray-100 text-gray-700 hover:bg-gray-200"
            >Mariscos</button
          ><button
            class="px-6 py-3 rounded-full font-semibold transition-colors whitespace-nowrap cursor-pointer bg-gray-100 text-gray-700 hover:bg-gray-200"
            >Arroces &amp; Paellas</button
          ><button
            class="px-6 py-3 rounded-full font-semibold transition-colors whitespace-nowrap cursor-pointer bg-gray-100 text-gray-700 hover:bg-gray-200"
            >Tapas</button>
        </div><div class="grid md:grid-cols-2 gap-6">
          <div
            class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow"
          >
            <div class="flex justify-between items-start mb-3">
              <h3 class="text-xl font-bold text-gray-800">
                Boquerones Fritos
              </h3><span class="text-2xl font-bold text-blue-600">8.50€</span>
            </div><p class="text-gray-600">
              Frescos del día, rebozados en harina de Cádiz
            </p>
          </div><div
            class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow"
          >
            <div class="flex justify-between items-start mb-3">
              <h3 class="text-xl font-bold text-gray-800">
                Sardinas a la Plancha
              </h3><span class="text-2xl font-bold text-blue-600">9.00€</span>
            </div><p class="text-gray-600">
              Con aceite de oliva virgen extra y sal marina
            </p>
          </div><div
            class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow"
          >
            <div class="flex justify-between items-start mb-3">
              <h3 class="text-xl font-bold text-gray-800">
                Salmonetes Fritos
              </h3><span class="text-2xl font-bold text-blue-600">12.50€</span>
            </div><p class="text-gray-600">
              Pescado local, crujiente por fuera, tierno por dentro
            </p>
          </div><div
            class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow"
          >
            <div class="flex justify-between items-start mb-3">
              <h3 class="text-xl font-bold text-gray-800">
                Chopitos Fritos
              </h3><span class="text-2xl font-bold text-blue-600">10.00€</span>
            </div><p class="text-gray-600">
              Calamares pequeños, especialidad de la casa
            </p>
          </div><div
            class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow"
          >
            <div class="flex justify-between items-start mb-3">
              <h3 class="text-xl font-bold text-gray-800">
                Pescaíto Frito Variado
              </h3><span class="text-2xl font-bold text-blue-600">15.00€</span>
            </div><p class="text-gray-600">
              Selección del día: boquerones, sardinas y salmonetes
            </p>
          </div><div
            class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition-shadow"
          >
            <div class="flex justify-between items-start mb-3">
              <h3 class="text-xl font-bold text-gray-800">
                Lenguado a la Plancha
              </h3><span class="text-2xl font-bold text-blue-600">18.00€</span>
            </div><p class="text-gray-600">
              Pescado noble con guarnición de verduras
            </p>
          </div>
        </div><div class="text-center mt-12">
          <p class="text-gray-600 text-lg mb-6">
            <i class="ri-leaf-line text-green-600 mr-2"></i>Todos nuestros
            pescados son frescos del día, procedentes de la lonja de Málaga
          </p><button
            class="bg-blue-600 text-white px-8 py-4 rounded-full text-lg font-semibold hover:bg-blue-700 transition-colors whitespace-nowrap cursor-pointer"
            >Reservar para Degustar</button>
        </div>
      </div>
    </section><section id="local" class="py-20 bg-blue-50">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-gray-800 mb-4">Nuestro Local</h2><p
            class="text-lg text-gray-600"
          >
            Un ambiente familiar en el corazón de Málaga
          </p>
        </div><div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <img
              alt="Interior del restaurante"
              class="rounded-2xl shadow-lg w-full h-96 object-cover object-top"
              src="https://readdy.ai/api/search-image?query=Cozy%20traditional%20Spanish%20seafood%20restaurant%20interior%2C%20rustic%20wooden%20tables%2C%20maritime%20decorations%2C%20fishing%20nets%2C%20warm%20lighting%2C%20authentic%20Andalusian%20atmosphere%2C%20family-friendly%20dining%20space%2C%20coastal%20Mediterranean%20style&width=600&height=400&seq=restaurant-interior&orientation=landscape"
            />
          </div><div class="space-y-6">
            <h3 class="text-3xl font-bold text-gray-800">
              Tradición y Autenticidad
            </h3><p class="text-lg text-gray-600">
              Nuestro local conserva el encanto tradicional de las marisquerías
              andaluzas, con un ambiente familiar y acogedor que te hará sentir
              como en casa.
            </p><div class="space-y-4">
              <div class="flex items-center space-x-3">
                <div
                  class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center"
                >
                  <i class="ri-group-line text-blue-600"></i>
                </div><span class="text-gray-700"
                  >Capacidad para 80 comensales</span>
              </div><div class="flex items-center space-x-3">
                <div
                  class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center"
                >
                  <i class="ri-wheelchair-line text-blue-600"></i>
                </div><span class="text-gray-700"
                  >Acceso adaptado para personas con movilidad reducida</span>
              </div><div class="flex items-center space-x-3">
                <div
                  class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center"
                >
                  <i class="ri-air-conditioning-line text-blue-600"></i>
                </div><span class="text-gray-700"
                  >Aire acondicionado y terraza exterior</span>
              </div><div class="flex items-center space-x-3">
                <div
                  class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center"
                >
                  <i class="ri-parking-line text-blue-600"></i>
                </div><span class="text-gray-700">Parking público cercano</span>
              </div>
            </div>
          </div>
        </div><div class="mt-16 grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <img
              alt="Pescado fresco"
              class="rounded-xl shadow-lg w-full h-48 object-cover object-top mb-4"
              src="https://readdy.ai/api/search-image?query=Fresh%20fish%20display%20case%20in%20Spanish%20seafood%20restaurant%2C%20variety%20of%20Mediterranean%20fish%20on%20ice%2C%20professional%20kitchen%20preparation%2C%20authentic%20market%20style%20presentation%2C%20appetizing%20seafood%20selection&width=400&height=300&seq=fish-display&orientation=landscape"
            /><h4 class="text-xl font-bold text-gray-800 mb-2">
              Pescado Fresco Diario
            </h4><p class="text-gray-600">
              Seleccionamos el mejor pescado cada mañana en la lonja
            </p>
          </div><div class="text-center">
            <img
              alt="Cocina tradicional"
              class="rounded-xl shadow-lg w-full h-48 object-cover object-top mb-4"
              src="https://readdy.ai/api/search-image?query=Traditional%20Spanish%20kitchen%20with%20chef%20preparing%20fried%20fish%2C%20authentic%20cooking%20techniques%2C%20professional%20seafood%20preparation%2C%20Mediterranean%20culinary%20tradition%2C%20skilled%20chef%20at%20work&width=400&height=300&seq=kitchen-chef&orientation=landscape"
            /><h4 class="text-xl font-bold text-gray-800 mb-2">
              Cocina Tradicional
            </h4><p class="text-gray-600">
              Técnicas ancestrales transmitidas de generación en generación
            </p>
          </div><div class="text-center">
            <img
              alt="Ambiente familiar"
              class="rounded-xl shadow-lg w-full h-48 object-cover object-top mb-4"
              src="https://readdy.ai/api/search-image?query=Happy%20family%20dining%20at%20Spanish%20seafood%20restaurant%2C%20warm%20atmosphere%2C%20traditional%20Andalusian%20hospitality%2C%20customers%20enjoying%20fresh%20fish%20meal%2C%20authentic%20local%20experience&width=400&height=300&seq=family-dining&orientation=landscape"
            /><h4 class="text-xl font-bold text-gray-800 mb-2">
              Ambiente Familiar
            </h4><p class="text-gray-600">
              Un lugar donde las familias se reúnen para disfrutar
            </p>
          </div>
        </div>
      </div>
    </section><section id="contacto" class="py-20 bg-white">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-gray-800 mb-4">
            Contacto y Ubicación
          </h2><p class="text-lg text-gray-600">
            Estamos en el corazón de Málaga, esperándote
          </p>
        </div><div class="grid lg:grid-cols-2 gap-12">
          <div class="space-y-8">
            <div class="bg-blue-50 rounded-2xl p-8">
              <h3 class="text-2xl font-bold text-gray-800 mb-6">
                Información de Contacto
              </h3><div class="space-y-4">
                <div class="flex items-center space-x-4">
                  <div
                    class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center"
                  >
                    <i class="ri-map-pin-line text-blue-600 text-xl"></i>
                  </div><div>
                    <p class="font-semibold text-gray-800">Dirección</p><p
                      class="text-gray-600"
                    >
                      Calle del Mar 15, 29001 Málaga, España
                    </p>
                  </div>
                </div><div class="flex items-center space-x-4">
                  <div
                    class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center"
                  >
                    <i class="ri-phone-line text-blue-600 text-xl"></i>
                  </div><div>
                    <p class="font-semibold text-gray-800">Teléfono</p><p
                      class="text-gray-600"
                    >
                      +34 952 123 456
                    </p>
                  </div>
                </div><div class="flex items-center space-x-4">
                  <div
                    class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center"
                  >
                    <i class="ri-mail-line text-blue-600 text-xl"></i>
                  </div><div>
                    <p class="font-semibold text-gray-800">Email</p><p
                      class="text-gray-600"
