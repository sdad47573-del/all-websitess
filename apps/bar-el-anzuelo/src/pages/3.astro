                  >Nuestro Local</a>
              </li><li>
                <a
                  href="#contacto"
                  class="text-gray-300 hover:text-white transition-colors cursor-pointer"
                  >Contacto</a>
              </li><li>
                <button
                  class="text-gray-300 hover:text-white transition-colors cursor-pointer"
                  >Reservas</button>
              </li>
            </ul>
          </div><div>
