---
import Layout from "../layouts/Layout.astro";

import GoogleReviews from "../components/GoogleReviews.astro";
import { DATA, PHONE } from "../data/data.astro";

import Hero from "../assets/hero.jpg";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

import { getImage } from "astro:assets";

const optimized = await getImage({ src: Hero, width: 700, format: "webp" });
---

<Layout
  title="Sur Digital Málaga | Tu Presencia Digital Comienza Aquí | Agencia de Marketing Web Online"
  description="Empieza hoy desde 0€, crea tu presencia online en menos de 7 días. Webs rápidas, modernas y optimizadas."
>
  <div id="root">
    <div class="min-h-screen">
      <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="container mx-auto px-4">
          <div class="flex items-center justify-between h-16">
            <div class="flex items-center">
              <div
                class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center mr-3"
              >
                <i class="ri-anchor-line text-white text-xl"></i>
              </div><span
                class="text-2xl font-bold text-blue-600"
                style="font-family: Pacifico, serif;">El Anzuelo</span
              >
            </div><nav class="hidden md:flex items-center space-x-8">
              <button
                class="text-gray-700 hover:text-blue-600 transition-colors cursor-pointer"
                >Inicio</button
              ><button
                class="text-gray-700 hover:text-blue-600 transition-colors cursor-pointer"
                >Nuestra Carta</button
              ><button
                class="text-gray-700 hover:text-blue-600 transition-colors cursor-pointer"
                >Especialidades</button
              ><button
                class="text-gray-700 hover:text-blue-600 transition-colors cursor-pointer"
                >Contacto</button
              ><button
                class="inline-flex items-center justify-center font-medium rounded-lg transition-colors cursor-pointer whitespace-nowrap bg-blue-600 text-white hover:bg-blue-700 px-3 py-2 text-sm"
                >Reservar Mesa</button
              >
            </nav><button
              class="md:hidden w-6 h-6 flex items-center justify-center cursor-pointer"
              ><i class="ri-menu-line text-xl"></i></button
            >
          </div>
        </div>
      </header><main>
        <section
          id="inicio"
          class="relative min-h-screen flex items-center justify-center bg-cover bg-center"
          style='background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url("");'
        >
          <div class="container mx-auto px-4 text-center text-white">
            <div class="max-w-4xl mx-auto">
              <div class="flex items-center justify-center mb-6">
                <div
                  class="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center mr-4"
                >
                  <i class="ri-anchor-line text-white text-3xl"></i>
                </div><h1
                  class="text-6xl md:text-7xl font-bold"
                  style="font-family: Pacifico, serif;"
                >
                  El Anzuelo
                </h1>
              </div><p class="text-xl md:text-2xl mb-8 text-gray-200">
                Restaurante especializado en mariscos y pescados frescos
              </p><p class="text-lg mb-12 text-gray-300 max-w-2xl mx-auto">
                Disfruta de la mejor cocina del mar en un ambiente acogedor.
                Pescados frescos, mariscos selectos y especialidades
                tradicionales que deleitarán tu paladar.
              </p><div class="flex flex-col sm:flex-row gap-4 justify-center">
                <button
                  class="inline-flex items-center justify-center font-medium rounded-lg transition-colors cursor-pointer whitespace-nowrap bg-blue-600 text-white hover:bg-blue-700 px-6 py-3 text-lg bg-blue-600 hover:bg-blue-700"
                  ><i class="ri-calendar-line mr-2"></i>Reservar Mesa</button
                ><button
                  class="inline-flex items-center justify-center font-medium rounded-lg transition-colors cursor-pointer whitespace-nowrap border border-blue-600 text-blue-600 hover:bg-blue-50 px-6 py-3 text-lg border-white text-white hover:bg-white hover:text-gray-900"
                  ><i class="ri-restaurant-line mr-2"></i>Ver Nuestra Carta</button
                >
              </div>
            </div>
          </div><div
            class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce"
          >
            <i class="ri-arrow-down-line text-white text-2xl"></i>
          </div>
        </section><section id="carta" class="py-20 bg-gray-50">
          <div class="container mx-auto px-4">
            <div class="text-center mb-16">
              <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
                Nuestra Carta
              </h2><p class="text-xl text-gray-600 max-w-2xl mx-auto">
                Descubre nuestra selección de pescados frescos, mariscos
                selectos y especialidades tradicionales
              </p>
            </div><div class="flex flex-wrap justify-center gap-2 mb-12">
              <button
                class="px-4 py-2 rounded-full transition-all cursor-pointer whitespace-nowrap bg-blue-600 text-white"
                ><i class="ri-restaurant-line mr-2"></i>Entrantes</button
              ><button
                class="px-4 py-2 rounded-full transition-all cursor-pointer whitespace-nowrap bg-white text-gray-700 hover:bg-blue-50"
                ><i class="ri-leaf-line mr-2"></i>Ensaladas</button
              ><button
                class="px-4 py-2 rounded-full transition-all cursor-pointer whitespace-nowrap bg-white text-gray-700 hover:bg-blue-50"
                ><i class="ri-anchor-line mr-2"></i>Mariscos</button
              ><button
                class="px-4 py-2 rounded-full transition-all cursor-pointer whitespace-nowrap bg-white text-gray-700 hover:bg-blue-50"
                ><i class="ri-star-line mr-2"></i>Especialidades</button
              ><button
                class="px-4 py-2 rounded-full transition-all cursor-pointer whitespace-nowrap bg-white text-gray-700 hover:bg-blue-50"
                ><i class="ri-fire-line mr-2"></i>Pescado Frito</button
              ><button
                class="px-4 py-2 rounded-full transition-all cursor-pointer whitespace-nowrap bg-white text-gray-700 hover:bg-blue-50"
                ><i class="ri-restaurant-2-line mr-2"></i>A la Plancha</button
              >
            </div><div class="max-w-4xl mx-auto">
              <div class="bg-white rounded-2xl shadow-lg p-8">
                <h3 class="text-2xl font-bold text-gray-900 mb-8 text-center">
                  Entrantes
                </h3><div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div
                    class="flex justify-between items-start border-b border-gray-100 pb-4"
                  >
                    <div class="flex-1">
                      <h4 class="font-semibold text-gray-900 mb-1">
                        Berenjenas con miel
                      </h4>
                    </div><span class="font-bold text-blue-600 ml-4">5,15€</span
                    >
                  </div><div
                    class="flex justify-between items-start border-b border-gray-100 pb-4"
                  >
                    <div class="flex-1">
                      <h4 class="font-semibold text-gray-900 mb-1">
                        Anchoas del cantábrico
                      </h4>
                    </div><span class="font-bold text-blue-600 ml-4"
                      >19,55€</span
                    >
                  </div><div
                    class="flex justify-between items-start border-b border-gray-100 pb-4"
                  >
                    <div class="flex-1">
                      <h4 class="font-semibold text-gray-900 mb-1">
                        Croquetas de choco
                      </h4>
                    </div><span class="font-bold text-blue-600 ml-4">9,85€</span
                    >
                  </div><div
                    class="flex justify-between items-start border-b border-gray-100 pb-4"
                  >
                    <div class="flex-1">
                      <h4 class="font-semibold text-gray-900 mb-1">
                        Jamón serrano Jabugo
                      </h4>
                    </div><span class="font-bold text-blue-600 ml-4">6,95€</span
                    >
                  </div><div
                    class="flex justify-between items-start border-b border-gray-100 pb-4"
                  >
                    <div class="flex-1">
                      <h4 class="font-semibold text-gray-900 mb-1">
                        Pimientos del padrón
                      </h4>
                    </div><span class="font-bold text-blue-600 ml-4">5,45€</span
                    >
                  </div><div
                    class="flex justify-between items-start border-b border-gray-100 pb-4"
                  >
                    <div class="flex-1">
                      <h4 class="font-semibold text-gray-900 mb-1">
                        Queso de pimentón
                      </h4>
                    </div><span class="font-bold text-blue-600 ml-4">4,10€</span
                    >
                  </div><div
                    class="flex justify-between items-start border-b border-gray-100 pb-4"
                  >
                    <div class="flex-1">
                      <h4 class="font-semibold text-gray-900 mb-1">
                        Salmón ahumado
                      </h4>
                    </div><span class="font-bold text-blue-600 ml-4">7,90€</span
                    >
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section><section id="especialidades" class="py-20 bg-white">
          <div class="container mx-auto px-4">
            <div class="text-center mb-16">
              <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
                Nuestras Especialidades
              </h2><p class="text-xl text-gray-600 max-w-2xl mx-auto">
                Platos únicos preparados con los mejores ingredientes del mar
              </p>
            </div><div
              class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto"
            >
              <div
                class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow"
              >
                <div class="aspect-video overflow-hidden">
                  <img
                    alt="Parrillada de Mariscos"
                    class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-300"
                    src=""
                  />
                </div><div class="p-6">
                  <div class="flex justify-between items-start mb-3">
                    <h3 class="text-xl font-bold text-gray-900">
                      Parrillada de Mariscos
                    </h3><span class="text-xl font-bold text-blue-600"
                      >25,00€</span
                    >
                  </div><p class="text-gray-600 leading-relaxed">
                    Para dos comensales. Una selección de los mejores mariscos
                    frescos a la parrilla
                  </p>
                </div>
              </div><div
                class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow"
              >
                <div class="aspect-video overflow-hidden">
                  <img
                    alt="Pulpo a la Gallega"
                    class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-300"
                    src=""
                  />
                </div><div class="p-6">
                  <div class="flex justify-between items-start mb-3">
                    <h3 class="text-xl font-bold text-gray-900">
                      Pulpo a la Gallega
                    </h3><span class="text-xl font-bold text-blue-600"
                      >12,70€</span
                    >
                  </div><p class="text-gray-600 leading-relaxed">
                    Tierno pulpo cocido con patatas, pimentón dulce y aceite de
                    oliva virgen
                  </p>
                </div>
              </div><div
                class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow"
              >
                <div class="aspect-video overflow-hidden">
                  <img
                    alt="Arroz con Bogavante"
                    class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-300"
                    src=""
                  />
                </div><div class="p-6">
                  <div class="flex justify-between items-start mb-3">
                    <h3 class="text-xl font-bold text-gray-900">
                      Arroz con Bogavante
                    </h3><span class="text-xl font-bold text-blue-600"
                      >15,70€</span
                    >
                  </div><p class="text-gray-600 leading-relaxed">
                    Arroz cremoso con bogavante fresco y un toque de azafrán
                  </p>
                </div>
              </div><div
                class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow"
              >
                <div class="aspect-video overflow-hidden">
                  <img
                    alt="Arroz Marinero"
                    class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-300"
                    src=""
                  />
                </div><div class="p-6">
                  <div class="flex justify-between items-start mb-3">
                    <h3 class="text-xl font-bold text-gray-900">
                      Arroz Marinero
                    </h3><span class="text-xl font-bold text-blue-600"
                      >18,00€</span
                    >
                  </div><p class="text-gray-600 leading-relaxed">
                    Para dos personas. Arroz con una variedad de mariscos y
                    pescados frescos
                  </p>
                </div>
              </div>
            </div><div class="text-center mt-12">
              <div
                class="inline-flex items-center bg-blue-50 rounded-lg px-6 py-3"
              >
                <i class="ri-information-line text-blue-600 mr-2"></i><span
                  class="text-blue-800"
                  >Todos nuestros pescados y mariscos son frescos del día</span
                >
              </div>
            </div>
          </div>
        </section><section id="reservas" class="py-20 bg-gray-50">
          <div class="container mx-auto px-4">
            <div class="text-center mb-16">
              <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
                Reserva tu Mesa
              </h2><p class="text-xl text-gray-600 max-w-2xl mx-auto">
                Asegura tu lugar en El Anzuelo y disfruta de una experiencia
                gastronómica única
              </p>
            </div><div class="max-w-2xl mx-auto">
              <div class="bg-white rounded-2xl shadow-lg p-8">
                <form id="reservas-form" class="space-y-6">
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                      <label
                        for="nombre"
                        class="block text-sm font-medium text-gray-700 mb-2"
                        >Nombre completo *</label
                      ><input
                        id="nombre"
                        required=""
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
                        placeholder="Tu nombre completo"
                        type="text"
                        value=""
                        name="nombre"
                      />
                    </div><div>
                      <label
                        for="telefono"
                        class="block text-sm font-medium text-gray-700 mb-2"
                        >Teléfono *</label
                      ><input
                        id="telefono"
                        required=""
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
                        placeholder="+34 123 456 789"
                        type="tel"
                        value=""
                        name="telefono"
                      />
                    </div>
                  </div><div>
                    <label
                      for="email"
                      class="block text-sm font-medium text-gray-700 mb-2"
                      >Email</label
                    ><input
                      id="email"
                      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
                      placeholder="tu@email.com"
                      type="email"
                      value=""
                      name="email"
                    />
                  </div><div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                      <label
                        for="fecha"
                        class="block text-sm font-medium text-gray-700 mb-2"
                        >Fecha *</label
                      ><input
                        id="fecha"
                        required=""
                        min="2025-10-18"
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
                        type="date"
                        value=""
                        name="fecha"
                      />
                    </div><div>
                      <label
                        for="hora"
                        class="block text-sm font-medium text-gray-700 mb-2"
                        >Hora *</label
                      ><div class="relative">
                        <select
                          id="hora"
                          name="hora"
                          required=""
                          class="w-full px-4 py-3 pr-8 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm appearance-none cursor-pointer"
                          ><option value="">Seleccionar hora</option><option
                            value="12:00">12:00</option
                          ><option value="12:30">12:30</option><option
                            value="13:00">13:00</option
                          ><option value="13:30">13:30</option><option
                            value="14:00">14:00</option
                          ><option value="14:30">14:30</option><option
                            value="15:00">15:00</option
                          ><option value="19:00">19:00</option><option
                            value="19:30">19:30</option
                          ><option value="20:00">20:00</option><option
                            value="20:30">20:30</option
                          ><option value="21:00">21:00</option><option
                            value="21:30">21:30</option
                          ><option value="22:00">22:00</option><option
                            value="22:30">22:30</option
                          ></select
                        ><i
                          class="ri-arrow-down-s-line absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 pointer-events-none"
                        ></i>
                      </div>
                    </div><div>
                      <label
                        for="personas"
                        class="block text-sm font-medium text-gray-700 mb-2"
                        >Personas</label
                      ><div class="relative">
                        <select
                          id="personas"
                          name="personas"
                          class="w-full px-4 py-3 pr-8 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm appearance-none cursor-pointer"
                          ><option value="1">1 persona</option><option value="2"
                            >2 personas</option
                          ><option value="3">3 personas</option><option
                            value="4">4 personas</option
                          ><option value="5">5 personas</option><option
                            value="6">6 personas</option
                          ><option value="7">7 personas</option><option
                            value="8">8 personas</option
                          ><option value="9">9 personas</option><option
                            value="10">10 personas</option
                          ></select
                        ><i
                          class="ri-arrow-down-s-line absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 pointer-events-none"
                        ></i>
                      </div>
                    </div>
                  </div><div>
                    <label
                      for="comentarios"
                      class="block text-sm font-medium text-gray-700 mb-2"
                      >Comentarios adicionales</label
                    ><textarea
                      id="comentarios"
                      name="comentarios"
                      maxlength="500"
                      rows="4"
                      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm resize-none"
                      placeholder="Alergias, preferencias de mesa, ocasión especial..."
                    ></textarea><p class="text-xs text-gray-500 mt-1">
                      0/500 caracteres
                    </p>
                  </div><button
                    class="inline-flex items-center justify-center font-medium rounded-lg transition-colors cursor-pointer whitespace-nowrap bg-blue-600 text-white hover:bg-blue-700 px-6 py-3 text-lg w-full"
                    type="submit"
                    ><i class="ri-calendar-check-line mr-2"></i>Confirmar
                    Reserva</button
                  >
                </form>
              </div>
            </div>
          </div>
        </section><section id="contacto" class="py-20 bg-white">
          <div class="container mx-auto px-4">
            <div class="text-center mb-16">
              <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
                Visítanos
              </h2><p class="text-xl text-gray-600 max-w-2xl mx-auto">
                Te esperamos en nuestro acogedor restaurante junto al puerto
              </p>
            </div><div
              class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-6xl mx-auto"
            >
              <div class="space-y-8">
                <div class="bg-gray-50 rounded-2xl p-8">
                  <h3 class="text-2xl font-bold text-gray-900 mb-6">
                    Información de Contacto
                  </h3><div class="space-y-6">
                    <div class="flex items-start">
                      <div
                        class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center mr-4 flex-shrink-0"
                      >
                        <i class="ri-map-pin-line text-white text-xl"></i>
                      </div><div>
                        <h4 class="font-semibold text-gray-900 mb-1">
                          Dirección
                        </h4><p class="text-gray-600">
                          Calle del Puerto, 123<br />Puerto Pesquero<br />España
                        </p>
                      </div>
                    </div><div class="flex items-start">
                      <div
                        class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center mr-4 flex-shrink-0"
                      >
                        <i class="ri-phone-line text-white text-xl"></i>
                      </div><div>
                        <h4 class="font-semibold text-gray-900 mb-1">
                          Teléfono
                        </h4><p class="text-gray-600">+34 123 456 789</p>
                      </div>
                    </div><div class="flex items-start">
                      <div
                        class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center mr-4 flex-shrink-0"
                      >
                        <i class="ri-mail-line text-white text-xl"></i>
                      </div><div>
                        <h4 class="font-semibold text-gray-900 mb-1">
                          Email
                        </h4><p class="text-gray-600">info@elanzuelo.com</p>
                      </div>
                    </div>
                  </div>
                </div><div class="bg-blue-50 rounded-2xl p-8">
                  <h3 class="text-2xl font-bold text-gray-900 mb-6">
                    Horarios de Apertura
                  </h3><div class="space-y-4">
                    <div class="flex justify-between items-center">
                      <span class="font-medium text-gray-900"
                        >Lunes - Viernes</span
                      ><div class="text-right">
                        <div class="text-gray-700">12:00 - 16:00</div><div
                          class="text-gray-700"
                        >
                          19:00 - 23:30
                        </div>
                      </div>
                    </div><div class="flex justify-between items-center">
                      <span class="font-medium text-gray-900"
                        >Sábados y Domingos</span
                      ><div class="text-gray-700">12:00 - 23:30</div>
                    </div>
                  </div><div class="mt-6 p-4 bg-white rounded-lg">
                    <div class="flex items-center text-blue-600">
                      <i class="ri-information-line mr-2"></i><span
                        class="text-sm font-medium"
                        >Recomendamos reservar mesa para garantizar
                        disponibilidad</span
                      >
                    </div>
                  </div>
                </div>
              </div><div class="lg:sticky lg:top-8">
                <div
                  class="bg-gray-100 rounded-2xl overflow-hidden h-96 lg:h-full min-h-[400px]"
                >
                  <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3037.8!2d-4.4214!3d36.7213!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzbCsDQzJzE2LjciTiA0wrAyNScxNy4wIlc!5e0!3m2!1ses!2ses!4v1234567890"
                    width="100%"
                    height="100%"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="Ubicación de El Anzuelo"
                    style="border: 0px;"></iframe>
                </div>
              </div>
            </div>
          </div>
        </section>
      </main><footer class="bg-gray-900 text-white">
        <div class="container mx-auto px-4 py-12">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <div class="md:col-span-2">
              <div class="flex items-center mb-4">
                <div
                  class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center mr-3"
                >
                  <i class="ri-anchor-line text-white text-xl"></i>
                </div><span
                  class="text-2xl font-bold text-blue-400"
                  style="font-family: Pacifico, serif;">El Anzuelo</span
                >
              </div><p class="text-gray-300 mb-4">
                Restaurante especializado en mariscos y pescados frescos.
                Disfruta de la mejor cocina del mar en un ambiente acogedor y
