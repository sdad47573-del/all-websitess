---
import CustomLayout from '../layouts/CustomLayout.astro';
import { NAME, PHONE, PHONE_HREF, CITY_LOCALE, MAPS_URL } from '../data/business';
---

<CustomLayout>
	<div class="min-h-screen">
		<main>
			<section
				id="inicio"
				class="relative flex min-h-screen items-center justify-center bg-cover bg-center"
				style='background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4));'
			>
				<div class="container mx-auto px-4 text-center text-white">
					<div class="mx-auto max-w-4xl">
						<div class="mb-6 flex items-center justify-center">
							<div class="mr-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-600">
								<i class="ri-anchor-line text-3xl text-white"></i>
							</div><h1
								class="text-6xl font-bold md:text-7xl"
								style="font-family: Pacifico, serif;"
							>
							{NAME}
						</h1>
						</div><p class="mb-8 text-xl text-gray-200 md:text-2xl">
							Restaurante especializado en mariscos y pescados frescos
						</p><p class="mx-auto mb-12 max-w-2xl text-lg text-gray-300">
							Disfruta de la mejor cocina del mar en un ambiente acogedor. Pescados frescos,
							mariscos selectos y especialidades tradicionales que deleitarán tu paladar.
						</p><div class="flex flex-col justify-center gap-4 sm:flex-row">
							<button
								class="inline-flex cursor-pointer items-center justify-center rounded-lg bg-blue-600 px-6 py-3 text-lg font-medium whitespace-nowrap text-white transition-colors hover:bg-blue-700"
								><i class="ri-calendar-line mr-2"></i>Reservar Mesa</button
							><button
								class="inline-flex cursor-pointer items-center justify-center rounded-lg border border-blue-600 border-white px-6 py-3 text-lg font-medium whitespace-nowrap text-blue-600 text-white transition-colors hover:bg-blue-50 hover:bg-white hover:text-gray-900"
								><i class="ri-restaurant-line mr-2"></i>Ver Nuestra Carta</button
							>
						</div>
					</div>
				</div><div class="absolute bottom-8 left-1/2 -translate-x-1/2 transform animate-bounce">
					<i class="ri-arrow-down-line text-2xl text-white"></i>
				</div>
			</section><section id="carta" class="bg-gray-50 py-20">
				<div class="container mx-auto px-4">
					<div class="mb-16 text-center">
						<h2 class="mb-4 text-4xl font-bold text-gray-900 md:text-5xl">Nuestra Carta</h2><p
							class="mx-auto max-w-2xl text-xl text-gray-600"
						>
							Descubre nuestra selección de pescados frescos, mariscos selectos y especialidades
							tradicionales
						</p>
					</div><div class="mb-12 flex flex-wrap justify-center gap-2">
						<button
							class="cursor-pointer rounded-full bg-blue-600 px-4 py-2 whitespace-nowrap text-white transition-all"
							><i class="ri-restaurant-line mr-2"></i>Entrantes</button
						><button
							class="cursor-pointer rounded-full bg-white px-4 py-2 whitespace-nowrap text-gray-700 transition-all hover:bg-blue-50"
							><i class="ri-leaf-line mr-2"></i>Ensaladas</button
						><button
							class="cursor-pointer rounded-full bg-white px-4 py-2 whitespace-nowrap text-gray-700 transition-all hover:bg-blue-50"
							><i class="ri-anchor-line mr-2"></i>Mariscos</button
						><button
							class="cursor-pointer rounded-full bg-white px-4 py-2 whitespace-nowrap text-gray-700 transition-all hover:bg-blue-50"
							><i class="ri-star-line mr-2"></i>Especialidades</button
						><button
							class="cursor-pointer rounded-full bg-white px-4 py-2 whitespace-nowrap text-gray-700 transition-all hover:bg-blue-50"
							><i class="ri-fire-line mr-2"></i>Pescado Frito</button
						><button
							class="cursor-pointer rounded-full bg-white px-4 py-2 whitespace-nowrap text-gray-700 transition-all hover:bg-blue-50"
							><i class="ri-restaurant-2-line mr-2"></i>A la Plancha</button
						>
					</div><div class="mx-auto max-w-4xl">
						<div class="rounded-2xl bg-white p-8 shadow-lg">
							<h3 class="mb-8 text-center text-2xl font-bold text-gray-900">Entrantes</h3><div
								class="grid grid-cols-1 gap-6 md:grid-cols-2"
							>
								<div class="flex items-start justify-between border-b border-gray-100 pb-4">
									<div class="flex-1">
										<h4 class="mb-1 font-semibold text-gray-900">Berenjenas con miel</h4>
									</div><span class="ml-4 font-bold text-blue-600">5,15€</span>
								</div><div class="flex items-start justify-between border-b border-gray-100 pb-4">
									<div class="flex-1">
										<h4 class="mb-1 font-semibold text-gray-900">Anchoas del cantábrico</h4>
									</div><span class="ml-4 font-bold text-blue-600">19,55€</span>
								</div><div class="flex items-start justify-between border-b border-gray-100 pb-4">
									<div class="flex-1">
										<h4 class="mb-1 font-semibold text-gray-900">Croquetas de choco</h4>
									</div><span class="ml-4 font-bold text-blue-600">9,85€</span>
								</div><div class="flex items-start justify-between border-b border-gray-100 pb-4">
									<div class="flex-1">
										<h4 class="mb-1 font-semibold text-gray-900">Jamón serrano Jabugo</h4>
									</div><span class="ml-4 font-bold text-blue-600">6,95€</span>
								</div><div class="flex items-start justify-between border-b border-gray-100 pb-4">
									<div class="flex-1">
										<h4 class="mb-1 font-semibold text-gray-900">Pimientos del padrón</h4>
									</div><span class="ml-4 font-bold text-blue-600">5,45€</span>
								</div><div class="flex items-start justify-between border-b border-gray-100 pb-4">
									<div class="flex-1">
										<h4 class="mb-1 font-semibold text-gray-900">Queso de pimentón</h4>
									</div><span class="ml-4 font-bold text-blue-600">4,10€</span>
								</div><div class="flex items-start justify-between border-b border-gray-100 pb-4">
									<div class="flex-1">
										<h4 class="mb-1 font-semibold text-gray-900">Salmón ahumado</h4>
									</div><span class="ml-4 font-bold text-blue-600">7,90€</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section><section id="especialidades" class="bg-white py-20">
				<div class="container mx-auto px-4">
					<div class="mb-16 text-center">
						<h2 class="mb-4 text-4xl font-bold text-gray-900 md:text-5xl">
							Nuestras Especialidades
						</h2><p class="mx-auto max-w-2xl text-xl text-gray-600">
							Platos únicos preparados con los mejores ingredientes del mar
						</p>
					</div><div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 md:grid-cols-2">
						<div
							class="overflow-hidden rounded-2xl bg-white shadow-lg transition-shadow hover:shadow-xl"
						>
							<div class="aspect-video overflow-hidden">
								<div
	class="flex h-full w-full items-center justify-center bg-gradient-to-br from-blue-100 to-blue-50"
	aria-hidden="true"
>
	<i class="ri-restaurant-2-line text-4xl text-blue-300"></i>
</div>
							</div><div class="p-6">
								<div class="mb-3 flex items-start justify-between">
									<h3 class="text-xl font-bold text-gray-900">Parrillada de Mariscos</h3><span
										class="text-xl font-bold text-blue-600">25,00€</span
									>
								</div><p class="leading-relaxed text-gray-600">
									Para dos comensales. Una selección de los mejores mariscos frescos a la parrilla
								</p>
							</div>
						</div><div
							class="overflow-hidden rounded-2xl bg-white shadow-lg transition-shadow hover:shadow-xl"
						>
							<div class="aspect-video overflow-hidden">
								<div
	class="flex h-full w-full items-center justify-center bg-gradient-to-br from-blue-100 to-blue-50"
	aria-hidden="true"
>
	<i class="ri-restaurant-2-line text-4xl text-blue-300"></i>
</div>
							</div><div class="p-6">
								<div class="mb-3 flex items-start justify-between">
									<h3 class="text-xl font-bold text-gray-900">Pulpo a la Gallega</h3><span
										class="text-xl font-bold text-blue-600">12,70€</span
									>
								</div><p class="leading-relaxed text-gray-600">
									Tierno pulpo cocido con patatas, pimentón dulce y aceite de oliva virgen
								</p>
							</div>
						</div><div
							class="overflow-hidden rounded-2xl bg-white shadow-lg transition-shadow hover:shadow-xl"
						>
							<div class="aspect-video overflow-hidden">
								<div
	class="flex h-full w-full items-center justify-center bg-gradient-to-br from-blue-100 to-blue-50"
	aria-hidden="true"
>
	<i class="ri-restaurant-2-line text-4xl text-blue-300"></i>
</div>
							</div><div class="p-6">
								<div class="mb-3 flex items-start justify-between">
									<h3 class="text-xl font-bold text-gray-900">Arroz con Bogavante</h3><span
										class="text-xl font-bold text-blue-600">15,70€</span
									>
								</div><p class="leading-relaxed text-gray-600">
									Arroz cremoso con bogavante fresco y un toque de azafrán
								</p>
							</div>
						</div><div
							class="overflow-hidden rounded-2xl bg-white shadow-lg transition-shadow hover:shadow-xl"
						>
							<div class="aspect-video overflow-hidden">
								<div
	class="flex h-full w-full items-center justify-center bg-gradient-to-br from-blue-100 to-blue-50"
	aria-hidden="true"
>
	<i class="ri-restaurant-2-line text-4xl text-blue-300"></i>
</div>
							</div><div class="p-6">
								<div class="mb-3 flex items-start justify-between">
									<h3 class="text-xl font-bold text-gray-900">Arroz Marinero</h3><span
										class="text-xl font-bold text-blue-600">18,00€</span
									>
								</div><p class="leading-relaxed text-gray-600">
									Para dos personas. Arroz con una variedad de mariscos y pescados frescos
								</p>
							</div>
						</div>
					</div><div class="mt-12 text-center">
						<div class="inline-flex items-center rounded-lg bg-blue-50 px-6 py-3">
							<i class="ri-information-line mr-2 text-blue-600"></i><span class="text-blue-800"
								>Todos nuestros pescados y mariscos son frescos del día</span
							>
						</div>
					</div>
				</div>
			</section><section id="reservas" class="bg-gray-50 py-20">
				<div class="container mx-auto px-4">
					<div class="mb-16 text-center">
						<h2 class="mb-4 text-4xl font-bold text-gray-900 md:text-5xl">Reserva tu Mesa</h2><p
							class="mx-auto max-w-2xl text-xl text-gray-600"
						>
							Asegura tu lugar en El Anzuelo y disfruta de una experiencia gastronómica única
						</p>
					</div><div class="mx-auto max-w-2xl">
						<div class="rounded-2xl bg-white p-8 shadow-lg">
							<form id="reservas-form" class="space-y-6">
								<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
									<div>
										<label for="nombre" class="mb-2 block text-sm font-medium text-gray-700"
											>Nombre completo *</label
										><input
											id="nombre"
											required=""
											class="w-full rounded-lg border border-gray-300 px-4 py-3 text-sm focus:border-transparent focus:ring-2 focus:ring-blue-500"
											placeholder="Tu nombre completo"
											type="text"
											value=""
											name="nombre"
										/>
									</div><div>
										<label for="telefono" class="mb-2 block text-sm font-medium text-gray-700"
											>Teléfono *</label
										><input
											id="telefono"
											required=""
											class="w-full rounded-lg border border-gray-300 px-4 py-3 text-sm focus:border-transparent focus:ring-2 focus:ring-blue-500"
											placeholder="Tu teléfono"
											type="tel"
											value=""
											name="telefono"
										/>
									</div>
								</div><div>
									<label for="email" class="mb-2 block text-sm font-medium text-gray-700"
										>Email</label
									><input
										id="email"
										class="w-full rounded-lg border border-gray-300 px-4 py-3 text-sm focus:border-transparent focus:ring-2 focus:ring-blue-500"
										placeholder="tu@email.com"
										type="email"
										value=""
										name="email"
									/>
								</div><div class="grid grid-cols-1 gap-6 md:grid-cols-3">
									<div>
										<label for="fecha" class="mb-2 block text-sm font-medium text-gray-700"
											>Fecha *</label
										><input
											id="fecha"
											required=""
											min="2025-10-18"
											class="w-full rounded-lg border border-gray-300 px-4 py-3 text-sm focus:border-transparent focus:ring-2 focus:ring-blue-500"
											type="date"
											value=""
											name="fecha"
										/>
									</div><div>
										<label for="hora" class="mb-2 block text-sm font-medium text-gray-700"
											>Hora *</label
										><div class="relative">
											<select
												id="hora"
												name="hora"
												required=""
												class="w-full cursor-pointer appearance-none rounded-lg border border-gray-300 px-4 py-3 pr-8 text-sm focus:border-transparent focus:ring-2 focus:ring-blue-500"
												><option value="">Seleccionar hora</option><option value="12:00"
													>12:00</option
												><option value="12:30">12:30</option><option value="13:00">13:00</option
												><option value="13:30">13:30</option><option value="14:00">14:00</option
												><option value="14:30">14:30</option><option value="15:00">15:00</option
												><option value="19:00">19:00</option><option value="19:30">19:30</option
												><option value="20:00">20:00</option><option value="20:30">20:30</option
												><option value="21:00">21:00</option><option value="21:30">21:30</option
												><option value="22:00">22:00</option><option value="22:30">22:30</option
												></select
											><i
												class="ri-arrow-down-s-line pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 transform text-gray-400"
											></i>
										</div>
									</div><div>
										<label for="personas" class="mb-2 block text-sm font-medium text-gray-700"
											>Personas</label
										><div class="relative">
											<select
												id="personas"
												name="personas"
												class="w-full cursor-pointer appearance-none rounded-lg border border-gray-300 px-4 py-3 pr-8 text-sm focus:border-transparent focus:ring-2 focus:ring-blue-500"
												><option value="1">1 persona</option><option value="2">2 personas</option
												><option value="3">3 personas</option><option value="4">4 personas</option
												><option value="5">5 personas</option><option value="6">6 personas</option
												><option value="7">7 personas</option><option value="8">8 personas</option
												><option value="9">9 personas</option><option value="10">10 personas</option
												></select
											><i
												class="ri-arrow-down-s-line pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 transform text-gray-400"
											></i>
										</div>
									</div>
								</div><div>
									<label for="comentarios" class="mb-2 block text-sm font-medium text-gray-700"
										>Comentarios adicionales</label
									><textarea
										id="comentarios"
										name="comentarios"
										maxlength="500"
										rows="4"
										class="w-full resize-none rounded-lg border border-gray-300 px-4 py-3 text-sm focus:border-transparent focus:ring-2 focus:ring-blue-500"
										placeholder="Alergias, preferencias de mesa, ocasión especial..."></textarea><p
										class="mt-1 text-xs text-gray-500"
									>
										0/500 caracteres
									</p>
								</div><button
									class="inline-flex w-full cursor-pointer items-center justify-center rounded-lg bg-blue-600 px-6 py-3 text-lg font-medium whitespace-nowrap text-white transition-colors hover:bg-blue-700"
									type="submit"><i class="ri-calendar-check-line mr-2"></i>Confirmar Reserva</button
								>
							</form>
						</div>
					</div>
				</div>
			</section><section id="contacto" class="bg-white py-20">
				<div class="container mx-auto px-4">
					<div class="mb-16 text-center">
						<h2 class="mb-4 text-4xl font-bold text-gray-900 md:text-5xl">Visítanos</h2><p
							class="mx-auto max-w-2xl text-xl text-gray-600"
						>
							Te esperamos en nuestro acogedor restaurante junto al puerto
						</p>
					</div><div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 lg:grid-cols-2">
						<div class="space-y-8">
							<div class="rounded-2xl bg-gray-50 p-8">
								<h3 class="mb-6 text-2xl font-bold text-gray-900">Información de Contacto</h3><div
									class="space-y-6"
								>
									<div class="flex items-start">
										<div
											class="mr-4 flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg bg-blue-600"
										>
											<i class="ri-map-pin-line text-xl text-white"></i>
										<h4 class="mb-1 font-semibold text-gray-900">Ubicación</h4>
										<p class="text-gray-600">
											{CITY_LOCALE}<br />
											<a href={MAPS_URL} target="_blank" rel="noopener" class="text-blue-600 underline">Ver en Google Maps</a>
										</p>
										</div>
									</div><div class="flex items-start">
										<div
											class="mr-4 flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg bg-blue-600"
										>
											<i class="ri-phone-line text-xl text-white"></i>
										<h4 class="mb-1 font-semibold text-gray-900">Teléfono</h4>
										<p class="text-gray-600">
											<a href={PHONE_HREF} class="hover:text-blue-700">{PHONE}</a>
										</p>
										</div>
								</div>
								</div>
							</div><div class="rounded-2xl bg-blue-50 p-8">
								<h3 class="mb-6 text-2xl font-bold text-gray-900">Horarios de Apertura</h3><div
									class="space-y-4"
								>
									<div class="flex items-center justify-between">
										<span class="font-medium text-gray-900">Lunes - Viernes</span><div
											class="text-right"
										>
											<div class="text-gray-700">12:00 - 16:00</div><div class="text-gray-700">
												19:00 - 23:30
											</div>
										</div>
									</div><div class="flex items-center justify-between">
										<span class="font-medium text-gray-900">Sábados y Domingos</span><div
											class="text-gray-700"
										>
											12:00 - 23:30
										</div>
									</div>
								</div><div class="mt-6 rounded-lg bg-white p-4">
									<div class="flex items-center text-blue-600">
										<i class="ri-information-line mr-2"></i><span class="text-sm font-medium"
											>Recomendamos reservar mesa para garantizar disponibilidad</span
										>
									</div>
								</div>
							</div>
						</div><div class="lg:sticky lg:top-8">
							<div class="h-96 min-h-[400px] overflow-hidden rounded-2xl bg-gray-100 lg:h-full">
								<a
									href={MAPS_URL}
									target="_blank"
									rel="noopener"
									class="flex h-full min-h-[300px] w-full flex-col items-center justify-center gap-2 rounded-2xl bg-gray-100 p-8 text-center transition-colors hover:bg-gray-200"
								>
									<i class="ri-map-pin-line text-3xl text-blue-600"></i>
									<p class="font-semibold text-gray-900">Ver ubicación en Google Maps</p>
									<p class="text-sm text-gray-600">{NAME} · {CITY_LOCALE}</p>
								</a>
							</div>
						</div>
					</div>
				</div>
			</section>
		</main><footer class="bg-gray-900 text-white">
			<div class="container mx-auto px-4 py-12">
				<div class="grid grid-cols-1 gap-8 md:grid-cols-4">
					<div class="md:col-span-2">
						<div class="mb-4 flex items-center">
							<div class="mr-3 flex h-10 w-10 items-center justify-center rounded-full bg-blue-600">
								<i class="ri-anchor-line text-xl text-white"></i>
							</div><span
								class="text-2xl font-bold text-blue-400"
								style="font-family: Pacifico, serif;">El Anzuelo</span
							>
						</div><p class="mb-4 text-gray-300">
							Restaurante especializado en mariscos y pescados frescos. Disfruta de la mejor cocina
							del mar en un ambiente acogedor y familiar.
						</p><div class="flex space-x-4">
							<div
								class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full bg-blue-600 transition-colors hover:bg-blue-700"
							>
								<i class="ri-facebook-fill text-white"></i>
							</div><div
								class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full bg-blue-600 transition-colors hover:bg-blue-700"
							>
								<i class="ri-instagram-line text-white"></i>
							</div><div
								class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full bg-blue-600 transition-colors hover:bg-blue-700"
							>
								<i class="ri-twitter-line text-white"></i>
							</div>
						</div>
					</div><div>
						<h3 class="mb-4 text-lg font-semibold">Horarios</h3><div
							class="space-y-2 text-gray-300"
						>
							<div>
								<p class="font-medium">Lunes - Viernes</p><p>12:00 - 16:00</p><p>19:00 - 23:30</p>
							</div><div>
								<p class="font-medium">Sábados y Domingos</p><p>12:00 - 23:30</p>
							</div>
						</div>
					</div><div>
						<h3 class="mb-4 text-lg font-semibold">Contacto</h3><div
							class="space-y-2 text-gray-300"
						>
										<div class="flex items-center">
