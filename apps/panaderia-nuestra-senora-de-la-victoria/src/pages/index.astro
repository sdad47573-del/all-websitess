---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/panaderia-nuestra-senora-de-la-victoria-apaisada-06.jpg';
import rotulo from '../assets/fotos/panaderia-nuestra-senora-de-la-victoria-apaisada-01.jpg';
import roscones from '../assets/fotos/panaderia-nuestra-senora-de-la-victoria-apaisada-02.jpg';
import bocadillo from '../assets/fotos/panaderia-nuestra-senora-de-la-victoria-apaisada-05.jpg';
import dulces from '../assets/fotos/panaderia-nuestra-senora-de-la-victoria-apaisada-10.jpg';
import desayuno from '../assets/fotos/panaderia-nuestra-senora-de-la-victoria-vertical-03.jpg';
import mostrador from '../assets/fotos/panaderia-nuestra-senora-de-la-victoria-vertical-04.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería Nuestra Señora de la Victoria · San Millán, Málaga';
const description =
	'Panadería Nuestra Señora de la Victoria, en C. San Millán, 3 (Distrito Centro, 29013 Málaga). Pan, dulces, bocadillos y desayunos. Teléfono 627 10 45 06. 4,9 sobre 5 en Google.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#la-victoria`,
	name: BUSINESS.name,
	alternateName: [
		'La Victoria',
		'Panadería La Victoria Málaga',
		'Ntra. Sra. de la Victoria Panadería y Pastelería',
	],
	description:
		'Panadería y pastelería con desayunos en C. San Millán, 3 (Distrito Centro, 29013 Málaga). Pan, dulces, bocadillos, café y roscones de Reyes.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34627104506',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '09:00',
			closes: '14:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: rotulo,
		alt: 'Rótulo redondo de Panadería Nuestra Señora de la Victoria sobre la fachada de ladrillo',
	},
	{
		src: roscones,
		alt: 'Dos cajas abiertas con roscones de Reyes de fruta escarchada',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo de jamón y queso partido por la mitad, envuelto en papel',
	},
	{
		src: dulces,
		alt: 'Bandeja de dulces cuadrados con azúcar y canela en la vitrina',
	},
	{
		src: mostrador,
		alt: 'Mostrador con vitrinas de bollería, torres de huevos y botellas de agua',
	},
	{
		src: desayuno,
		alt: 'Mesa del local con cafés, bocadillos y dulces para desayunar',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1b2f3d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,300..700;1,300..600&family=Source+Sans+3:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Nuestra Señora de la Victoria, panadería Málaga centro, pastelería San Millán, desayunos Málaga, bocadillos, roscones de Reyes, 29013"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería y pastelería con desayunos en San Millán, 3. Pan, dulces, bocadillos y café. 4,9 sobre 5 con 263 reseñas en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de ladrillo de Panadería Nuestra Señora de la Victoria en la calle San Millán, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1b2f3d"
			phone="+34627104506"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Panadería · Pastelería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. San Millán, 3 · Distrito Centro"
				title="El pan del barrio, <br /><em>y el café de la mañana.</em>"
				lede={`La panadería está en la calle San Millán, 3, con la fachada de ladrillo visto, el rótulo redondo de «Ntra. Sra. de la Victoria · Panadería y pastelería» y el toldo azul sobre la puerta. Dentro hay vitrinas de dulces y mesas para desayunar: café, bocadillos y zumo de naranja. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={fachada}
				imageAlt="Fachada de ladrillo de Panadería Nuestra Señora de la Victoria en la calle San Millán, 3, con toldo azul"
				primaryCta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,9</b> en Google · 263 reseñas' },
					{ label: 'Horario', html: '<b>L–V 8:00–15:00</b> · S 9:00–14:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b>` },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Pan · dulces · desayunos"
			/>

			<LocalChips label="Lo que hay en La Victoria" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Panadería, pastelería <br /><em>y mesa.</em>"
				paragraphs={[
					'Panadería Nuestra Señora de la Victoria está en la calle San Millán, 3, en el Distrito Centro de Málaga. La fachada es de ladrillo visto, con un rótulo redondo que anuncia «Ntra. Sra. de la Victoria · Panadería y pastelería» y un toldo azul sobre la puerta.',
					'Dentro, el local es panadería, pastelería y cafetería a la vez. En las fotos del perfil se ve el mostrador con vitrinas de bollería y dulces, torres de huevos y botellas de agua, y mesas con cafés, bocadillos y dulces para desayunar.',
					'Las reseñas de Google repiten lo mismo: el bocadillo de tortilla, los bocatas y el zumo de naranja recién hecho. También aparecen bandejas de dulces cuadrados con azúcar y canela, y roscones de Reyes en cajas durante la campaña.',
					'Abre de lunes a viernes de 8:00 a 15:00 y el sábado de 9:00 a 14:00; el domingo cierra. La ficha no publica carta, precios ni página web, así que aquí no encontrarás importes.',
				]}
				note="Sin carta ni precios publicados: el mostrador recoge solo lo que muestran las fotos del perfil y lo que cuentan las reseñas de Google."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Pan, dulces <br />
							<em>y desayuno.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que hay <br /><em>en la vitrina.</em>"
				description="Sin carta ni precios publicados: esto es lo que muestran las fotos del local y lo que cuentan las reseñas de Google."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU_GROUPS}
				note={`La ficha no recoge precios ni métodos de pago, así que esta web no publica importes. El surtido cambia a lo largo de la mañana. Para saber qué hay hoy, llama al ${BUSINESS.phone}.`}
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La casa, <br /><em>por dentro.</em>"
				description="Seis fotos de la ficha de Google Maps: el rótulo, los roscones, el bocadillo, los dulces de bandeja, el mostrador y una mesa de desayuno."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En San Millán, <br /><em>número 3.</em>"
				addressLines={[
					BUSINESS.street,
					BUSINESS.district,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
				]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de Panadería Nuestra Señora de la Victoria en la calle San Millán, 3, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Victoria · San Millán"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phone, href: BUSINESS.phoneHref }}
				reserveNote="La ficha de Google marca aparcamiento adaptado para sillas de ruedas, pero no publica información sobre el acceso, el mostrador o el aseo. Si necesitas un acceso concreto, llama antes. El contacto es en el local o por teléfono."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar a La Victoria"
			navAriaLabel="Enlaces de Panadería Nuestra Señora de la Victoria"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
