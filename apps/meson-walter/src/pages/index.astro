---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Meson Walter · Restaurante en Jaén';
const description =
	'Meson Walter, restaurante en el Paseo de la Estación, 33 de Jaén. 4,5 sobre 5 con 206 reseñas; mediodía de lunes a sábado y noches de martes a sábado, con el domingo cerrado.';
const keywords =
	'Meson Walter, Mesón Walter Jaén, restaurante Jaén, Paseo de la Estación Jaén, Meson Walter teléfono';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas diez fotografías, así que no se inventa una
 * descripción y todos los `alt` avisan solo de dónde salen.
 */
const altFoto = 'Fotografía publicada por Meson Walter en su ficha de Google Maps';
const altOg = 'Fotografía de Meson Walter publicada en su ficha de Google Maps';

/**
 * Autor que el manifiesto de la descarga atribuye a las diez fotos: el propio local.
 *
 * Como sí hay a quién citar, cada foto de la galería lleva su pie.
 */
const autorFoto = 'Meson Walter';

/** Galería completa: las diez fotografías de la ficha, en el orden en que se descargaron. */
const galeria = [
	'meson-walter-apaisada-01.jpg',
	'meson-walter-vertical-02.jpg',
	'meson-walter-vertical-03.jpg',
	'meson-walter-apaisada-04.jpg',
	'meson-walter-apaisada-05.jpg',
	'meson-walter-apaisada-06.jpg',
	'meson-walter-apaisada-07.jpg',
	'meson-walter-vertical-08.jpg',
	'meson-walter-apaisada-09.jpg',
	'meson-walter-apaisada-10.jpg',
];

/**
 * Tres fotos de avance en el collage de la portada (también están en la galería).
 *
 * Arriba va una foto apaisada y abajo dos verticales, con las proporciones por defecto del
 * repositorio (16/9 y 4/5).
 */
const collage = [
	{ name: 'meson-walter-apaisada-01.jpg', clase: 'collage-item collage-item-a' },
	{ name: 'meson-walter-vertical-02.jpg', clase: 'collage-item collage-item-b' },
	{ name: 'meson-walter-vertical-03.jpg', clase: 'collage-item collage-item-c' },
];

/**
 * Número de reseñas destacadas que publica la ficha.
 *
 * Aquí son tres, pero se cuenta en vez de escribirlo a mano para que el texto no se desincronice
 * si la ficha cambia.
 */
const numeroResenas = reviews.length;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1b2233" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-JA" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">MW</span>
				<span class="brand-text">
					Meson Walter
					<small>Paseo de la Estación · Jaén</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#local">La casa</a>
				<a href="#fotos">Las fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Jaén · Paseo de la Estación, 33</p>
						<h1 id="hero-title">
							Meson Walter,
							<br />
							<em>cocina en Jaén.</em>
						</h1>
						<p class="hero-lede">
							Meson Walter está en el Paseo de la Estación, 33, con código postal 23007,
							en Jaén. Google lo clasifica como restaurante y le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas. Abre al mediodía de
							lunes a sábado y por la noche de martes a sábado, y cierra los domingos.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>Llamar al {business.phone}</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas
								</strong>
							</li>
						</ul>
					</div>

					<div class="hero-collage">
						{collage.map((item, index) => (
							<figure class={item.clase}>
								<Image
									src={foto(item.name)}
									alt={altFoto}
									widths={index === 0 ? [640, 900, 1200] : [320, 480, 640]}
									sizes={
										index === 0
											? '(max-width: 1080px) 92vw, 46vw'
											: '(max-width: 1080px) 45vw, 23vw'
									}
									format="avif"
									quality={68}
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : undefined}
									decoding="async"
								/>
							</figure>
						))}
					</div>
				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
					{business.reviewCount.toLocaleString('es-ES')} reseñas
				</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>{hoursSummary}</span>
				<span>Teléfono {business.phone}</span>
			</div>

			<section class="section" id="local" aria-labelledby="local-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">La casa</p>
						<h2 class="title" id="local-title">
							Mediodía
							<br />
							<em>y noche.</em>
						</h2>
						<p>
							Google lo clasifica como restaurante, sin un tipo de cocina concreto: es la
							única categoría que publica la ficha. Le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas. Está en el Paseo de
							la Estación, 33, con código postal 23007, y la ficha publica su plus code
							Q6G6+26 Jaén.
						</p>
						<p>
							Abre al mediodía de lunes a sábado, de 13:30 a 16:30, y por la noche de
							martes a sábado, de 20:30 a 23:30, salvo el miércoles, que solo abre al
							mediodía como el lunes. El domingo cierra. En las tres reseñas que destaca
							la ficha se habla de la atención, de la buena cocina y de platos como el
							arroz o el jarrete.
						</p>
						<p>
							Esta web se ha preparado solo con lo que publica la ficha, consultada el{' '}
							{site.consultado}: nombre, dirección, teléfono, categoría, horario,
							valoración, las {numeroResenas} reseñas que destaca y sus propias
							fotografías. La ficha no publica descripción del local, distintivo, la carta
							ni los precios, así que aquí no se reproducen.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>{business.reviewCount.toLocaleString('es-ES')} reseñas en Google Maps</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver todas ↗</a>
						</div>
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									<strong>{review.rating} sobre 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section cocina" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						La casa <em>por dentro.</em>
					</h2>
					<p class="lead">
						Son las diez fotografías que Meson Walter publica en su ficha de Google Maps. El
						manifiesto de la descarga atribuye las diez al propio local, así que cada foto
						lleva su pie. La ficha no describe el contenido de las fotos y aquí no se
						inventa ninguna descripción.
					</p>
					<div class="cocina-grid">
						{galeria.map((name) => (
							<figure class="cocina-item">
								<Image
									src={foto(name)}
									alt={altFoto}
									widths={[380, 560, 800]}
									sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
									format="avif"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>Foto de {autorFoto}</figcaption>
							</figure>
						))}
					</div>
					<p class="cocina-note">
						La ficha no publica la carta ni los precios, así que esta web no los reproduce.
						Para saber qué hay hoy, lo más rápido es{' '}
						<a href={phoneHref}>llamar al {business.phone}</a> o mirar las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos y reseñas de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Paseo de la Estación, 33,
							<br />
							<em>23007 Jaén.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr class:list={[{ 'is-closed': item.shifts.length === 0 }]}>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							De <strong>lunes a sábado</strong> el local abre al mediodía, de 13:30 a
							16:30, y por la noche lo hace de <strong>martes a sábado</strong>, de 20:30 a
							23:30 (el <strong>miércoles</strong> solo abre al mediodía, como el lunes).
							El <strong>domingo</strong> cierra. Es el horario que publica la ficha
							consultada el {site.consultado}, con el aviso de que el lunes 12, Fiesta
							Nacional de España, podría ser diferente. Conviene confirmar por teléfono
							antes de ir.
						</p>
						{accesibilidad.length > 0 ? (
							<ul class="access-list">
								{accesibilidad.map((item) => (
									<li class:list={[{ 'is-no': !item.disponible }]}>{item.label}</li>
								))}
							</ul>
						) : (
							<p class="hours-note">
								La ficha consultada no publica ningún dato de accesibilidad.
							</p>
						)}
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>llamar.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">MW</span>
					<span>
						Meson Walter
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Meson Walter · Paseo de la Estación, 33 (23007 Jaén).
					Web informativa elaborada con los datos y las fotografías que el local publica en
					su ficha de Google Maps, consultada el {site.consultado}. Confirma horario y
					disponibilidad por teléfono antes de salir.
				</small>
			</div>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a Meson Walter <span>{business.phone}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
