---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/restaurante-da-se-apaisada-10.jpg';
import salaLuzes from '../assets/fotos/restaurante-da-se-vertical-01.jpg';
import sangriaPaella from '../assets/fotos/restaurante-da-se-vertical-02.jpg';
import interiorAzul from '../assets/fotos/restaurante-da-se-vertical-03.jpg';
import pratosMesa from '../assets/fotos/restaurante-da-se-apaisada-04.jpg';
import esplanadaSardinhas from '../assets/fotos/restaurante-da-se-vertical-05.jpg';
import salaAzulejo from '../assets/fotos/restaurante-da-se-apaisada-06.jpg';
import paella from '../assets/fotos/restaurante-da-se-vertical-07.jpg';
import sardinhas from '../assets/fotos/restaurante-da-se-vertical-08.jpg';
import sardinhasSalada from '../assets/fotos/restaurante-da-se-apaisada-09.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICOS,
} from '../data/site';

const title = 'Restaurante da Sé · Cozinha portuguesa em Alfama';
const description =
	'Restaurante da Sé, cozinha portuguesa na Cruzes da Sé, 31A, em Alfama, Lisboa. Aberto todos os dias das 10:30 às 23:30, com esplanada e reservas online.';

const galeria = [
	{
		src: esplanadaSardinhas,
		alt: 'Mesa de toalha de xadrez na esplanada com sardinhas grelhadas, salada, bacalhau gratinado e pastéis de bacalhau',
	},
	{
		src: paella,
		alt: 'Paella de marisco em travessa de ferro sobre toalha de xadrez azul, com uma jarra de sangria ao lado',
	},
	{
		src: salaLuzes,
		alt: 'Sala do Restaurante da Sé com candeeiros suspensos, prateleira de vinhos e mesas postas',
	},
	{
		src: sardinhasSalada,
		alt: 'Quatro sardinhas assadas com batata cozida, salada, cebola roxa e limão',
	},
	{
		src: salaAzulejo,
		alt: 'Sala do restaurante com parede de azulejo, garrafas de vinho ao fundo e candeeiros de vime',
	},
	{
		src: pratosMesa,
		alt: 'Conjunto de pratos da casa vistos de cima: peixe grelhado, camarões, esparguete, bife e saladas',
	},
	{
		src: sardinhas,
		alt: 'Sardinhas grelhadas com batata cozida, limão, azeitonas e salsa',
	},
	{
		src: interiorAzul,
		alt: 'Sala do restaurante iluminada de azul e laranja, com mesas de tampo amarelo e candeeiros esféricos',
	},
	{
		src: sangriaPaella,
		alt: 'Paella amarela em travessa de ferro, com um copo de sangria e uma jarra de água na mesa',
	},
	{
		src: fachada,
		alt: 'Fachada do Restaurante da Sé em Alfama, com os toldos de «Comida Portuguesa» e «Restaurante da Sé» e as mesas na calçada',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta do Restaurante da Sé',
	inLanguage: 'pt-PT',
	url: MAPS.menu,
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#da-se`,
	name: BUSINESS.name,
	alternateName: ['Restaurante da Se', 'da Sé Lisboa', 'Restaurante da Sé Alfama'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, MAPS.thefork],
	telephone: '+351 21 886 2886',
	currenciesAccepted: 'EUR',
	priceRange: '€€',
	servesCuisine: ['Cozinha portuguesa', 'Cozinha europeia', 'Peixe e marisco'],
	acceptsReservations: MAPS.reserve,
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Distrito de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:30',
			closes: '23:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Lugares para pessoas em cadeiras de rodas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-da-se-apaisada-10.jpg": fachada,
	"restaurante-da-se-vertical-05.jpg": esplanadaSardinhas,
	"restaurante-da-se-vertical-07.jpg": paella,
	"restaurante-da-se-vertical-01.jpg": salaLuzes,
	"restaurante-da-se-apaisada-09.jpg": sardinhasSalada,
	"restaurante-da-se-apaisada-06.jpg": salaAzulejo,
	"restaurante-da-se-apaisada-04.jpg": pratosMesa,
	"restaurante-da-se-vertical-08.jpg": sardinhas,
	"restaurante-da-se-vertical-03.jpg": interiorAzul,
	"restaurante-da-se-vertical-02.jpg": sangriaPaella,
};
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#16293f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante da Sé, restaurante Alfama, comer junto à Sé de Lisboa, comida portuguesa Lisboa, sardinhas assadas Alfama, arroz de marisco, paella Lisboa, Cruzes da Sé, reservar restaurante Alfama"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cozinha portuguesa na Cruzes da Sé, 31A, em Alfama. Sardinhas na grelha, arroz de marisco e esplanada junto à catedral. Aberto todos os dias, das 10:30 às 23:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Esplanada do Restaurante da Sé em Alfama, com os toldos da casa e as mesas na calçada"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#16293f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lisboa"
			locale="pt_PT"
			countryName="Portugal"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Restaurante da Sé"
			subtitle="Cozinha portuguesa · Alfama"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
				reviews={REVIEWS}
				googleMaps={MAPS.place}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Reservar ↗', href: MAPS.reserve, external: true },
				{ label: 'Carta ↗', href: MAPS.menu, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Carta e preços publicados pela casa no TheFork; confirma horário e valores antes da visita."
			ctaLabel="Ligar à Sé"
			navAriaLabel="Ligações do Restaurante da Sé"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/351218862886?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carta%20do%20Restaurante%20da%20S%C3%A9." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carta do Restaurante da Sé"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
