---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/restaurante-la-boheme-apaisada-08.jpg';
import foto1 from '../assets/fotos/restaurante-la-boheme-apaisada-01.jpg';
import foto2 from '../assets/fotos/restaurante-la-boheme-apaisada-03.jpg';
import foto3 from '../assets/fotos/restaurante-la-boheme-vertical-04.jpg';
import foto4 from '../assets/fotos/restaurante-la-boheme-apaisada-05.jpg';
import foto5 from '../assets/fotos/restaurante-la-boheme-apaisada-07.jpg';

const business = {
	name: 'Restaurante La Boheme',
	short: 'La Boheme',
	street: 'C. Alfonso X el Sabio, 36',
	city: 'Archena',
	region: 'Región de Murcia',
	province: 'Murcia',
	postalCode: '30600',
	phone: '+34 692 24 70 53',
	latitude: 38.1174983,
	longitude: -1.3077157,
	site: 'https://restaurante-la-boheme.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+La+Boheme/@38.1174983,-1.3077157,17z/data=!3m1!4b1!4m6!3m5!1s0xd647a3fbc0ee617:0xac62b40aa5671b52!8m2!3d38.1174983!4d-1.3077157!16s%2Fg%2F1v26ng47?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34692247053';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'De la carta',
		title: 'Pasta rellena de salmón',
		text: 'La pasta rellena con salmón y su salsa es uno de los platos que más se repite en las reseñas, por su sabor.',
	},
	{
		kicker: 'Al horno',
		title: 'Pizzas',
		text: '«Pasta y pizzas muy ricas», resumen los clientes. La base italiana de la carta, para compartir o para uno.',
	},
	{
		kicker: 'La cuenta',
		title: 'Buenos precios',
		text: 'Gran cocina italiana a buenos precios: lo que más se repite cuando los clientes valoran la relación calidad-precio.',
	},
	{
		kicker: 'El trato',
		title: 'Camarero y dueños',
		text: 'Un camarero súper amable y unos dueños muy buena gente: la atención es parte de lo que se destaca del restaurante.',
	},
	{
		kicker: 'Horario',
		title: 'Fin de semana italiano',
		text: 'Abre viernes y sábado de 12:00 a 24:00 y el domingo de 12:15 a 16:00. De lunes a jueves cierra.',
	},
	{
		kicker: 'El sitio',
		title: 'En Archena',
		text: 'En la calle Alfonso X el Sabio, 36, 30600 Archena (Murcia), con acceso adaptado para sillas de ruedas.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de Restaurante La Boheme publicada en su ficha de Google Maps' },
	{ src: photos.foto2, alt: 'Imagen de Restaurante La Boheme en Archena tomada de su galería de Google Maps' },
	{ src: photos.foto3, alt: 'Fotografía del restaurante en la calle Alfonso X el Sabio, 36, Archena' },
	{ src: photos.foto4, alt: 'Imagen de Restaurante La Boheme subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Vista de Restaurante La Boheme según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está Restaurante La Boheme?',
		a: 'En la calle Alfonso X el Sabio, 36, 30600 Archena (Murcia). Coordenadas 38.1174983, -1.3077157.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Viernes y sábado de 12:00 a 24:00 y domingo de 12:15 a 16:00. De lunes a jueves cierra, según su ficha de Google Maps.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Cocina italiana. Entre lo que citan las reseñas están la pasta, las pizzas y la pasta rellena de salmón con su salsa.',
	},
	{
		q: '¿Es caro?',
		a: 'Las reseñas hablan de gran cocina italiana a buenos precios. No publicamos una carta con importes porque puede cambiar; confirma al llamar.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso, aseo y asientos adaptados para sillas de ruedas. Para necesidades concretas, llama antes.',
	},
	{
		q: '¿Cómo se contacta?',
		a: 'Llamando al 692 24 70 53. Si vienes en festivo o quieres confirmar el horario, es mejor llamar antes.',
	},
];

const images = [
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'Restaurante La Boheme, cocina italiana en Archena (Murcia): pasta, pizzas y buenos precios. Abre viernes y sábado de 12:00 a 24:00. Llama al 692 24 70 53.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: business.phone,
	image: images,
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Italiana', 'Pasta', 'Pizzas'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '12:00',
			closes: '23:59',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '12:15', closes: '16:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.6,
		reviewCount: 388,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#241a1d" />
		<meta
			name="description"
			content="Restaurante La Boheme, cocina italiana en Archena (Murcia): pasta, pizzas y buenos precios. Abre viernes y sábado de 12:00 a 24:00. Llama al 692 24 70 53."
		/>
		<meta
			name="keywords"
			content="Restaurante La Boheme, restaurante italiano Archena, pasta Archena, pizzas Archena, Alfonso X el Sabio 36, restaurante Murcia"
		/>
		<meta name="author" content="Restaurante La Boheme" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Restaurante La Boheme | Cocina italiana en Archena</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="La Boheme · Cocina italiana en Archena" />
		<meta
			property="og:description"
			content="Pasta, pizzas y cocina italiana a buenos precios en la calle Alfonso X el Sabio, 36 (Archena)."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="Restaurante La Boheme, cocina italiana en Archena" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="La Boheme · Cocina italiana en Archena" />
		<meta
			name="twitter:description"
			content="Cocina italiana en Archena (Murcia), con pasta y pizzas. Llama al 692 24 70 53."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Archena" />
		<meta name="geo.position" content="38.1174983;-1.3077157" />
		<meta name="ICBM" content="38.1174983, -1.3077157" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Restaurante La Boheme, inicio">
				<span class="brand-mark" aria-hidden="true">B</span>
				<span class="brand-name">Restaurante La Boheme <small>Archena · Murcia</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">El restaurante</a>
				<a href="#cocina">La cocina</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>692 24 70 53</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C. Alfonso X el Sabio, 36 · Archena</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante La Boheme, cocina italiana en Archena (Murcia). Pasta, pizzas y platos con sabor, con
						el trato cercano de un camarero y unos dueños que sus clientes destacan en cada reseña.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 692 24 70 53</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,6</b> en Google (388 reseñas)</li>
						<li>Cocina italiana</li>
						<li>Pasta y pizzas</li>
						<li>Buenos precios</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						alt="Restaurante La Boheme, cocina italiana en Archena (Murcia)"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,6</b><span>Google</span></div>
					<div><b>388</b><span>Reseñas</span></div>
					<div><b>3/7</b><span>Días</span></div>
				</div>
				<ul class="services">
					<li>Cocina italiana</li>
					<li>Pasta</li>
					<li>Pizzas</li>
					<li>Buenos precios</li>
					<li>Trato cercano</li>
					<li>Local accesible</li>
				</ul>
			</section>

			<section class="about section-pad" id="restaurante">
				<p class="section-label"><span aria-hidden="true"></span> Cocina italiana en Archena</p>
				<div class="about-grid">
					<h2>Pasta, pizza<br />y sabor<br /><em>italiano.</em></h2>
					<div class="about-copy">
						<p>
							Restaurante La Boheme está en la calle Alfonso X el Sabio, 36, en Archena (Murcia). Cocina
							italiana en un local de trato cercano, con la pasta y las pizzas entre lo más citado por sus
							clientes.
						</p>
						<p>
							Las reseñas hablan de pasta y pizzas muy ricas y de la pasta rellena de salmón con su salsa.
							También de una gran cocina italiana a buenos precios y del servicio: un camarero súper amable y
							unos dueños muy buena gente.
						</p>
						<p class="about-note">
							Abre viernes y sábado de 12:00 a 24:00 y el domingo de 12:15 a 16:00. De lunes a jueves cierra,
							según su ficha de Google Maps. En festivos, llama antes al 692 24 70 53.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="cocina">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Lo que se pide</p>
						<h2>La carta<br />de la <em>casa.</em></h2>
					</div>
					<p>
						Pasta, pizzas y cocina italiana a buenos precios. Lo que más se repite en las reseñas es el
						sabor de la pasta, el trato del equipo y la relación entre calidad y cuenta.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>La Boheme<br /><em>en imágenes.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Restaurante La Boheme. En la ficha
							encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="avif"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres el
					titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C. Alfonso X el Sabio, 36</p>
					<h2>Ven a comer<br /><em>italiano.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes a jueves</th>
								<td>Cerrado</td>
							</tr>
							<tr>
								<th scope="row">Viernes y sábado</th>
								<td>12:00 – 24:00</td>
							</tr>
							<tr>
								<th scope="row">Domingo</th>
								<td>12:15 – 16:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, llama antes de venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar 692 24 70 53</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 692 24 70 53</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Restaurante La Boheme en la calle Alfonso X el Sabio, 36, Archena"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> La Boheme · Archena
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">B</span>
				<p>Restaurante La Boheme<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Restaurante La Boheme · Archena. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>

			<p class="footer-credit">
				Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
				<a href="https://sur-digital.vercel.app/" rel="noopener">sur-digital.vercel.app</a>
			</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>692 24 70 53</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
