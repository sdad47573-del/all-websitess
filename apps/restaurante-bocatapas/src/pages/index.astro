---
import '../styles/global.css';
import {
  business,
  directionsUrl,
  faqs,
  faqSchema,
  hours,
  hoursSummary,
  mapEmbedUrl,
  mapsUrl,
  phoneHref,
  restaurantSchema,
  reviewsUrl,
  site,
} from '../data/site';

const title = 'Restaurante Bocatapas · Alameda Carvia Bernal 5, Cádiz';
const description =
  'Restaurante Bocatapas en Alameda Hermanas Carvia Bernal 5, 11003 Cádiz. Terraza junto al mar, 624 43 77 44, mapa y preguntas. Web informativa no oficial.';
const keywords = 'Bocatapas, restaurante Cádiz, Alameda, Baluarte Candelaria, tapas Cádiz';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e4b57" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={business.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="geo.region" content="ES-CA" />
    <meta name="geo.placename" content={business.city} />
    <meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
    <meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
    <link rel="canonical" href={`${site.siteUrl}/`} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={business.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site.siteUrl}/`} />
    <meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
    <meta property="place:location:latitude" content={String(business.latitude)} />
    <meta property="place:location:longitude" content={String(business.longitude)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="topbar">
      <a class="brand" href="#inicio" aria-label={`${business.shortName}, inicio`}>
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
        <span class="brand-text">Bocatapas<small>Alameda 5 · Cádiz</small></span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="#local">El local</a>
        <a href="#fotos">Fotos</a>
        <a href="#horario">Horario</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
      <a class="topbar-phone" href={phoneHref}><span aria-hidden="true">☎</span>{business.phone}</a>
    </header>

    <main id="contenido">
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Cádiz · Baluarte de la Candelaria</p>
            <h1 id="hero-title">Boca<br /><em>tapas.</em></h1>
            <p class="hero-lede">
              {business.name} está en {business.streetAddress}, {business.postalCode} {business.city}.
              Terraza-jardín junto a la bahía. Web informativa no oficial:
              teléfono, horario orientativo, cómo llegar, mapa y preguntas.
              Las fotos de Google Maps no se copian aquí por derechos de autor.
            </p>
            <div class="hero-actions">
              <a class="btn btn-solid" href={phoneHref}>Reservar: {business.phone}</a>
              <a class="btn btn-ghost" href={directionsUrl} target="_blank" rel="noopener noreferrer">
                Cómo llegar <span aria-hidden="true">↗</span>
              </a>
            </div>
            <ul class="hero-facts">
              <li><small>Dirección</small><strong>{business.streetAddress} · {business.postalCode} {business.city}</strong></li>
              <li><small>Horario</small><strong>{hoursSummary}</strong></li>
              <li><small>Contacto</small><strong>{business.phone}</strong></li>
            </ul>
          </div>

          <div class="hero-media">
            <div class="hero-collage hero-collage--sin-fotos" role="img" aria-label="Ilustración de Bocatapas, sin fotografías">
              <div class="collage-item collage-item-main foto-ph">
                <span class="foto-ph-mark" aria-hidden="true">B</span>
                <span class="foto-ph-text">Foto propia pendiente</span>
                <small>Alameda 5</small>
              </div>
              <div class="collage-item collage-item-top foto-ph foto-ph--alt">
                <span class="foto-ph-text">Terraza jardín</span><small>pendiente</small>
              </div>
              <div class="collage-item collage-item-bottom foto-ph">
                <span class="foto-ph-text">Bahía</span><small>pendiente</small>
              </div>
            </div>
            <p class="hero-stamp" aria-hidden="true"><span>Terraza</span><strong>Bocatapas</strong><span>Cádiz</span></p>
          </div>
        </div>
      </section>

      <div class="band">
        <span>{business.streetAddress} · {business.postalCode} {business.city}</span>
        <span>{hoursSummary}</span>
        <span>Teléfono {business.phone}</span>
      </div>

      <section class="section local" id="local" aria-labelledby="local-title">
        <div class="wrap local-grid">
          <div class="local-text">
            <p class="kicker">El local</p>
            <h2 class="title" id="local-title">Junto al<br /><em>mar.</em></h2>
            <p>
              {business.name} está en {business.streetAddress} ({business.postalCode} {business.city},
              {business.region}), en las coordenadas {business.latitude}, {business.longitude}.
              Terraza entre árboles junto a la fuente, con vistas a Valdelagrana y Rota.
            </p>
            <ul class="category-list" aria-label="Categorías">
              {business.categories.map((c) => <li>{c}</li>)}
            </ul>
            <p class="local-note">
              Esta web no copia fotos, reseñas literales ni valoraciones de Google Maps.
              Para fotos y opiniones usa la <a href={mapsUrl} target="_blank" rel="noopener noreferrer">ficha en Google Maps ↗</a>.
            </p>
          </div>
          <div class="quote-row">
            <div class="quote-score">
              <strong>{business.phone}</strong>
              <span>Reserva en verano y fines de semana</span>
              <a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver en Maps ↗</a>
            </div>
            <blockquote class="quote">
              <p>Confirma si la cocina está operativa antes de ir.</p>
              <footer><strong>Aviso</strong><span>Web no oficial</span></footer>
            </blockquote>
          </div>
        </div>
      </section>

      <section class="section fotos" id="fotos" aria-labelledby="fotos-title">
        <div class="wrap">
          <p class="kicker">Las fotos</p>
          <h2 class="title" id="fotos-title">Fotos <em>propias.</em></h2>
          <p class="lead">
            De momento no hay galería: las imágenes de Google Maps pertenecen a sus autores y sus
            condiciones prohíben descargarlas automáticamente. Cuando tengas fotos propias (hechas por
            ti o con permiso escrito del autor), guárdalas en <code>src/assets/fotos/</code> y aparecerán aquí.
          </p>
          <div class="fotos-grid">
            {[1, 2, 3].map((n) => (
              <figure class="foto-item foto-ph foto-ph--galeria">
                <span class="foto-ph-text">Espacio para foto {n}</span>
                <small>1200 × 800 · JPG</small>
              </figure>
            ))}
          </div>
          <p class="fotos-note">
            ¿Quieres ver cómo es por dentro? Mira la
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer">ficha con fotos en Google Maps ↗</a>
            o <a href={phoneHref}>llama al {business.phone}</a>.
          </p>
        </div>
      </section>

      <section class="section horario" id="horario" aria-labelledby="horario-title">
        <div class="wrap horario-grid">
          <div>
            <p class="kicker">Horario y ubicación</p>
            <h2 class="title" id="horario-title">Alameda 5,<br /><em>11003 Cádiz.</em></h2>
            <address>{business.streetAddress}<br />{business.postalCode} {business.city}<br />{business.province} · España</address>
            <table class="hours-table">
              <caption>Orientativo · variable por temporada</caption>
              <tbody>
                {hours.map((item) => (
                  <tr><th scope="row">{item.day}</th><td>{item.service}</td></tr>
                ))}
              </tbody>
            </table>
            <p class="hours-note">Llama al {business.phone} para confirmar apertura y cocina.</p>
            <a class="contact-line" href={phoneHref}><small>Teléfono</small><strong>{business.phone}</strong></a>
            <div class="place-actions">
              <a class="btn btn-solid" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a>
              <a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver la ficha en Maps ↗</a>
            </div>
          </div>
          <div class="map-card">
            <iframe title={`Mapa de ${business.name} en ${business.city}`} src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
            <div class="map-tag">
              <div><strong>{business.shortName}</strong><small>{business.streetAddress} · {business.postalCode} {business.city}</small></div>
              <a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
            </div>
          </div>
        </div>
      </section>

      <section class="section faq" id="preguntas" aria-labelledby="faq-title">
        <div class="wrap">
          <p class="kicker">Preguntas frecuentes</p>
          <h2 class="title" id="faq-title">Antes de <em>venir.</em></h2>
          <div class="faq-list">
            {faqs.map((faq) => (
              <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-top">
        <a class="footer-brand" href="#inicio" aria-label={`${business.shortName}, volver al inicio`}>
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          <span>{business.name}<small>{business.streetAddress} · {business.postalCode} {business.city}</small></span>
        </a>
        <nav class="footer-nav" aria-label="Contacto y ficha del local">
          <a href={phoneHref}>Reservar: {business.phone}</a>
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Ficha en Google Maps ↗</a>
        </nav>
        <small class="footer-note">
          © {new Date().getFullYear()} {business.name} · {business.streetAddress} ({business.postalCode} {business.city}).
          Web informativa no oficial con datos públicos de ubicación y contacto.
        </small>
      </div>
      <p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
    </footer>

    <a class="mobile-call" href={phoneHref}>Reservar en Bocatapas <span>{business.phone}</span></a>

    <nav class="legal-links" aria-label="Información legal">
      <a href="/aviso-legal">Aviso legal</a>
      <a href="/aviso-legal#privacidad">Privacidad</a>
      <a href="/aviso-legal#cookies">Cookies</a>
    </nav>
  </body>
</html>
