---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/la-ribena-moratalaz-apaisada-01.jpg';
import vitrina from '../assets/fotos/la-ribena-moratalaz-apaisada-02.jpg';
import fachadaDos from '../assets/fotos/la-ribena-moratalaz-apaisada-05.jpg';
import pollo from '../assets/fotos/la-ribena-moratalaz-apaisada-06.jpg';
import tarta from '../assets/fotos/la-ribena-moratalaz-apaisada-07.jpg';
import croquetas from '../assets/fotos/la-ribena-moratalaz-apaisada-08.jpg';
import interior from '../assets/fotos/la-ribena-moratalaz-panoramica-04.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'La Ribereña · Pollo asado y comida casera para llevar en Moratalaz';
const description = BUSINESS.description;

const galeria = [
	{ src: fachada, alt: 'Fachada de La Ribereña en la calle Antonio Cumella, con los carteles de pollos asados y comidas caseras' },
	{ src: vitrina, alt: 'Vitrina con guisos, arroz y platos caseros de La Ribereña en fuentes de cristal' },
	{ src: fachadaDos, alt: 'Segunda vista de la fachada de La Ribereña con la carta de platos en el escaparate' },
	{ src: pollo, alt: 'Pollo asado dorado en una bandeja de horno del local' },
	{ src: tarta, alt: 'Tarta de manzana con una cereza en el centro, sobre una base de papel de blonda' },
	{ src: croquetas, alt: 'Croquetas caseras doradas en una bandeja de cristal' },
	{ src: interior, alt: 'Mostrador de panadería y cocina de La Ribereña con pan recién hecho' },
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-ribenera`,
	name: BUSINESS.name,
	alternateName: ['Churrería Asador de Pollos La Ribereña', 'La Ribereña Moratalaz'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34602415472',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Comida casera', 'Paella'],
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Comunidad de Madrid' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: { '@type': 'GeoCoordinates', latitude: BUSINESS.geo.lat, longitude: BUSINESS.geo.lng },
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Thursday', 'Friday'], opens: '10:00', closes: '15:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday', 'Sunday'], opens: '09:00', closes: '15:30' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-ribena-moratalaz-apaisada-01.jpg": fachada,
	"la-ribena-moratalaz-apaisada-02.jpg": vitrina,
	"la-ribena-moratalaz-apaisada-05.jpg": fachadaDos,
	"la-ribena-moratalaz-apaisada-06.jpg": pollo,
	"la-ribena-moratalaz-apaisada-07.jpg": tarta,
	"la-ribena-moratalaz-apaisada-08.jpg": croquetas,
	"la-ribena-moratalaz-panoramica-04.jpg": interior,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#123c36" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400..700;1,400..700&family=Mulish:ital,wght@0,400..700;1,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Ribereña, Moratalaz, asador de pollos Moratalaz, pollo asado para llevar, comida casera Antonio Cumella, paella para llevar"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado, paella y comida casera para llevar en C. Antonio Cumella, 10 (Moratalaz, Madrid)."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tarjeta de La Ribereña con su nombre sobre fondo verde esmeralda"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#123c36"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Moratalaz"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Ribereña"
			subtitle="Asador de pollos · Moratalaz"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="La Ribereña"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma horario antes de la visita."
			ctaLabel="Llamar a La Ribereña"
			navAriaLabel="Enlaces de La Ribereña"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
