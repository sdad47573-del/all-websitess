---
import Side from '../../components/Side.astro';
import CustomLayout from '../../layouts/CustomLayout.astro';
import { getAllCategories } from '../../services/categories.service';

const { categories } = await getAllCategories();
---

<CustomLayout>
	<div id="root">
		<div class="flex min-h-screen bg-gray-50">
			<Side />
			<main class="flex-1 p-8">
				<div>
					<div class="mb-6 flex items-center justify-between">
						<div>
							<h2 class="text-3xl font-bold text-gray-800">Gestión de Categorías</h2><p
								class="mt-1 text-gray-600"
							>
								Organiza tu menú por categorías
							</p>
						</div><button
							class="flex cursor-pointer items-center gap-2 rounded-lg bg-teal-500 px-6 py-3 whitespace-nowrap text-white transition-colors hover:bg-teal-600"
							><div class="flex h-5 w-5 items-center justify-center">
								<i class="ri-add-line text-xl"></i>
							</div><span class="font-medium">Añadir Categoría</span></button
						>
					</div><div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
						{
							categories?.map((category) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
									<>
										<div class="mb-4 flex items-start justify-between">
											<>
												<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-teal-100">
													<i class="ri-folder-line text-2xl text-teal-600" />
												</div>
												<div class="flex gap-2">
													<>
														<button
															class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-blue-600 transition-colors hover:bg-blue-50"
															title="Editar"
														>
															<i class="ri-edit-line text-lg" />
														</button>
														<button
															class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-red-600 transition-colors hover:bg-red-50"
															title="Eliminar"
														>
															<i class="ri-delete-bin-line text-lg" />
														</button>
													</>
												</div>
											</>
										</div>
										<h3 class="mb-2 text-xl font-bold text-gray-800">{category.name}</h3>
										<p class="mb-4 text-sm text-gray-600">{category.slug}</p>
										<div class="flex items-center justify-between border-t border-gray-200 pt-4">
											<>
												<span class="text-sm text-gray-500">Estado</span>
												<span
													class={`text-lg font-bold ${category.active ? 'text-teal-600' : 'text-red-600'}`}
												>
													{category.active ? 'Activo' : 'Inactivo'}
												</span>
											</>
										</div>
									</>
								</div>
							))
						}
					</div>
					<div
						class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
					>
						<div class="mb-4 flex items-start justify-between">
							<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-teal-100">
								<i class="ri-folder-line text-2xl text-teal-600"></i>
							</div><div class="flex gap-2">
								<button
									class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-blue-600 transition-colors hover:bg-blue-50"
									title="Editar"><i class="ri-edit-line text-lg"></i></button
								><button
									class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-red-600 transition-colors hover:bg-red-50"
									title="Eliminar"><i class="ri-delete-bin-line text-lg"></i></button
								>
							</div>
						</div><h3 class="mb-2 text-xl font-bold text-gray-800">Entrantes</h3><p
							class="mb-4 text-sm text-gray-600"
						>
							Aperitivos y primeros platos
						</p><div class="flex items-center justify-between border-t border-gray-200 pt-4">
							<span class="text-sm text-gray-500">Platos en categoría</span><span
								class="text-lg font-bold text-teal-600">8</span
							>
						</div>
					</div><div
						class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
					>
						<div class="mb-4 flex items-start justify-between">
							<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-teal-100">
								<i class="ri-folder-line text-2xl text-teal-600"></i>
							</div><div class="flex gap-2">
								<button
									class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-blue-600 transition-colors hover:bg-blue-50"
									title="Editar"><i class="ri-edit-line text-lg"></i></button
								><button
									class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-red-600 transition-colors hover:bg-red-50"
									title="Eliminar"><i class="ri-delete-bin-line text-lg"></i></button
								>
							</div>
						</div><h3 class="mb-2 text-xl font-bold text-gray-800">Platos Principales</h3><p
							class="mb-4 text-sm text-gray-600"
						>
							Platos principales y especialidades
						</p><div class="flex items-center justify-between border-t border-gray-200 pt-4">
							<span class="text-sm text-gray-500">Platos en categoría</span><span
								class="text-lg font-bold text-teal-600">12</span
							>
						</div>
					</div><div
						class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
					>
						<div class="mb-4 flex items-start justify-between">
							<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-teal-100">
								<i class="ri-folder-line text-2xl text-teal-600"></i>
							</div><div class="flex gap-2">
								<button
									class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-blue-600 transition-colors hover:bg-blue-50"
									title="Editar"><i class="ri-edit-line text-lg"></i></button
								><button
									class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-red-600 transition-colors hover:bg-red-50"
									title="Eliminar"><i class="ri-delete-bin-line text-lg"></i></button
								>
							</div>
						</div><h3 class="mb-2 text-xl font-bold text-gray-800">Postres</h3><p
							class="mb-4 text-sm text-gray-600"
						>
							Dulces y postres caseros
						</p><div class="flex items-center justify-between border-t border-gray-200 pt-4">
							<span class="text-sm text-gray-500">Platos en categoría</span><span
								class="text-lg font-bold text-teal-600">6</span
							>
						</div>
					</div><div
						class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
					>
						<div class="mb-4 flex items-start justify-between">
							<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-teal-100">
								<i class="ri-folder-line text-2xl text-teal-600"></i>
							</div><div class="flex gap-2">
								<button
									class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-blue-600 transition-colors hover:bg-blue-50"
									title="Editar"><i class="ri-edit-line text-lg"></i></button
								><button
									class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-red-600 transition-colors hover:bg-red-50"
									title="Eliminar"><i class="ri-delete-bin-line text-lg"></i></button
								>
							</div>
						</div><h3 class="mb-2 text-xl font-bold text-gray-800">Bebidas</h3><p
							class="mb-4 text-sm text-gray-600"
						>
							Refrescos, vinos y cervezas
						</p><div class="flex items-center justify-between border-t border-gray-200 pt-4">
							<span class="text-sm text-gray-500">Platos en categoría</span><span
								class="text-lg font-bold text-teal-600">15</span
							>
						</div>
					</div><div
						class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
					>
						<div class="mb-4 flex items-start justify-between">
							<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-teal-100">
								<i class="ri-folder-line text-2xl text-teal-600"></i>
							</div><div class="flex gap-2">
								<button
									class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-blue-600 transition-colors hover:bg-blue-50"
									title="Editar"><i class="ri-edit-line text-lg"></i></button
								><button
									class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-red-600 transition-colors hover:bg-red-50"
									title="Eliminar"><i class="ri-delete-bin-line text-lg"></i></button
								>
							</div>
						</div><h3 class="mb-2 text-xl font-bold text-gray-800">Menú Infantil</h3><p
							class="mb-4 text-sm text-gray-600"
						>
							Platos especiales para niños
						</p><div class="flex items-center justify-between border-t border-gray-200 pt-4">
							<span class="text-sm text-gray-500">Platos en categoría</span><span
								class="text-lg font-bold text-teal-600">5</span
							>
						</div>
					</div>
				</div>
			</main>
		</div>
	</div>
</CustomLayout>
