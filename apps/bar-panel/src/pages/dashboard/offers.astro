---
import Side from '../../components/Side.astro';
import CustomLayout from '../../layouts/CustomLayout.astro';
---

<CustomLayout>
	<div id="root">
		<div class="flex min-h-screen bg-gray-50">
			<Side />
			<main class="flex-1 p-8">
				<div>
					<div class="mb-6 flex items-center justify-between">
						<div>
							<h2 class="text-3xl font-bold text-gray-800">Ofertas Especiales</h2><p
								class="mt-1 text-gray-600"
							>
								Crea y gestiona promociones para tus clientes
							</p>
						</div><button
							class="flex cursor-pointer items-center gap-2 rounded-lg bg-teal-500 px-6 py-3 whitespace-nowrap text-white transition-colors hover:bg-teal-600"
							><div class="flex h-5 w-5 items-center justify-center">
								<i class="ri-add-line text-xl"></i>
							</div><span class="font-medium">Crear Oferta</span></button
						>
					</div><div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
						<div
							class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
						>
							<div class="mb-4 flex items-start justify-between">
								<div class="flex items-center gap-3">
									<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-orange-100">
										<i class="ri-price-tag-3-line text-2xl text-orange-600"></i>
									</div><div>
										<h3 class="text-xl font-bold text-gray-800">Menú del Día</h3><span
											class="text-2xl font-bold text-orange-600">20% OFF</span
										>
									</div>
								</div><div class="flex gap-2">
									<button
										class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-blue-600 transition-colors hover:bg-blue-50"
										title="Editar"><i class="ri-edit-line text-lg"></i></button
									><button
										class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-red-600 transition-colors hover:bg-red-50"
										title="Eliminar"><i class="ri-delete-bin-line text-lg"></i></button
									>
								</div>
							</div><p class="mb-4 text-gray-600">
								Primer plato, segundo plato, postre y bebida
							</p><div class="mb-4 space-y-2">
								<div class="flex items-center gap-2 text-sm text-gray-600">
									<div class="flex h-5 w-5 items-center justify-center">
										<i class="ri-calendar-line"></i>
									</div><span>Válido del 1/1/2024 al 31/12/2024</span>
								</div><div class="flex items-center gap-2 text-sm text-gray-600">
									<div class="flex h-5 w-5 items-center justify-center">
										<i class="ri-restaurant-line"></i>
									</div><span>Aplicable a: Menú del Día</span>
								</div>
							</div><div class="flex items-center justify-between border-t border-gray-200 pt-4">
								<button
									class="cursor-pointer rounded-lg bg-green-100 px-4 py-2 text-sm font-medium whitespace-nowrap text-green-700 transition-colors hover:bg-green-200"
									>Activa</button
								>
							</div>
						</div><div
							class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
						>
							<div class="mb-4 flex items-start justify-between">
								<div class="flex items-center gap-3">
									<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-orange-100">
										<i class="ri-price-tag-3-line text-2xl text-orange-600"></i>
									</div><div>
										<h3 class="text-xl font-bold text-gray-800">Happy Hour</h3><span
											class="text-2xl font-bold text-orange-600">50% OFF</span
										>
									</div>
								</div><div class="flex gap-2">
									<button
										class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-blue-600 transition-colors hover:bg-blue-50"
										title="Editar"><i class="ri-edit-line text-lg"></i></button
									><button
										class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-red-600 transition-colors hover:bg-red-50"
										title="Eliminar"><i class="ri-delete-bin-line text-lg"></i></button
									>
								</div>
							</div><p class="mb-4 text-gray-600">2x1 en bebidas seleccionadas</p><div
								class="mb-4 space-y-2"
							>
								<div class="flex items-center gap-2 text-sm text-gray-600">
									<div class="flex h-5 w-5 items-center justify-center">
										<i class="ri-calendar-line"></i>
									</div><span>Válido del 1/1/2024 al 31/12/2024</span>
								</div><div class="flex items-center gap-2 text-sm text-gray-600">
									<div class="flex h-5 w-5 items-center justify-center">
										<i class="ri-restaurant-line"></i>
									</div><span>Aplicable a: Bebidas</span>
								</div>
							</div><div class="flex items-center justify-between border-t border-gray-200 pt-4">
								<button
									class="cursor-pointer rounded-lg bg-green-100 px-4 py-2 text-sm font-medium whitespace-nowrap text-green-700 transition-colors hover:bg-green-200"
									>Activa</button
								>
							</div>
						</div><div
							class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
						>
							<div class="mb-4 flex items-start justify-between">
								<div class="flex items-center gap-3">
									<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-orange-100">
										<i class="ri-price-tag-3-line text-2xl text-orange-600"></i>
									</div><div>
										<h3 class="text-xl font-bold text-gray-800">Fin de Semana Especial</h3><span
											class="text-2xl font-bold text-orange-600">15% OFF</span
										>
									</div>
								</div><div class="flex gap-2">
									<button
										class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-blue-600 transition-colors hover:bg-blue-50"
										title="Editar"><i class="ri-edit-line text-lg"></i></button
									><button
										class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-red-600 transition-colors hover:bg-red-50"
										title="Eliminar"><i class="ri-delete-bin-line text-lg"></i></button
									>
								</div>
							</div><p class="mb-4 text-gray-600">15% de descuento en paellas</p><div
								class="mb-4 space-y-2"
							>
								<div class="flex items-center gap-2 text-sm text-gray-600">
									<div class="flex h-5 w-5 items-center justify-center">
										<i class="ri-calendar-line"></i>
									</div><span>Válido del 1/1/2024 al 31/12/2024</span>
								</div><div class="flex items-center gap-2 text-sm text-gray-600">
									<div class="flex h-5 w-5 items-center justify-center">
										<i class="ri-restaurant-line"></i>
									</div><span>Aplicable a: Paellas</span>
								</div>
							</div><div class="flex items-center justify-between border-t border-gray-200 pt-4">
								<button
									class="cursor-pointer rounded-lg bg-green-100 px-4 py-2 text-sm font-medium whitespace-nowrap text-green-700 transition-colors hover:bg-green-200"
									>Activa</button
								>
							</div>
						</div>
					</div>
				</div>
			</main>
		</div>
	</div>
</CustomLayout>
