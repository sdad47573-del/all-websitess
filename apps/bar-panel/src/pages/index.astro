---
import CustomLayout from '../layouts/CustomLayout.astro';
---

<CustomLayout>
	<div
		class="flex min-h-screen items-center justify-center bg-gradient-to-br from-teal-50 to-gray-50 p-8"
	>
		<div class="w-full max-w-2xl text-center">
			<div class="mb-8">
				<div
					class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-teal-500"
				>
					<i class="ri-restaurant-2-line text-4xl text-white"></i>
				</div><h1 class="mb-4 text-5xl font-bold text-gray-800">RestaurantPanel</h1><p
					class="text-xl text-gray-600"
				>
					Sistema de Gestión para Restaurantes
				</p>
			</div><div class="mb-8 rounded-lg border border-gray-200 bg-white p-8 shadow-lg">
				<h2 class="mb-4 text-2xl font-bold text-gray-800">Bienvenido</h2><p
					class="mb-6 text-gray-600"
				>
					Gestiona tu restaurante de manera eficiente con nuestro panel completo de administración
				</p>
				<a
					class="flex w-full cursor-pointer items-center justify-center gap-3 rounded-lg bg-teal-500 px-8 py-4 text-lg font-semibold whitespace-nowrap text-white transition-colors hover:bg-teal-600"
					href="/dashboard"
				>
					<span>Acceder al Panel</span><i class="ri-arrow-right-line text-xl"></i>
				</a>
			</div><div class="grid grid-cols-1 gap-4 md:grid-cols-3">
				<div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
					<div
						class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-teal-100"
					>
						<i class="ri-restaurant-line text-2xl text-teal-600"></i>
					</div><h3 class="mb-2 font-bold text-gray-800">Gestión de Menú</h3><p
						class="text-sm text-gray-600"
					>
						Administra platos, precios y disponibilidad
					</p>
				</div><div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
					<div
						class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-teal-100"
					>
						<i class="ri-time-line text-2xl text-teal-600"></i>
					</div><h3 class="mb-2 font-bold text-gray-800">Control de Horarios</h3><p
						class="text-sm text-gray-600"
					>
						Define horarios de apertura y descansos
					</p>
				</div><div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
					<div
						class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-teal-100"
					>
						<i class="ri-bar-chart-line text-2xl text-teal-600"></i>
					</div><h3 class="mb-2 font-bold text-gray-800">Estadísticas</h3><p
						class="text-sm text-gray-600"
					>
						Visualiza ventas en tiempo real
					</p>
				</div>
			</div>
		</div>
	</div>
</CustomLayout>
