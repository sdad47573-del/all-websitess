<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
	<div class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-lg bg-white">
		<div class="border-b border-gray-200 p-6">
			<h3 class="text-2xl font-bold text-gray-800">Editar Plato</h3>
		</div><form class="space-y-4 p-6">
			<div>
				<label class="mb-2 block text-sm font-medium text-gray-700">Nombre del Plato</label><input
					class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
					required=""
					type="text"
					value="Paella Valenciana"
				/>
			</div><div>
				<label class="mb-2 block text-sm font-medium text-gray-700">Descripción</label><textarea
					class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
					rows="3"
					required="">Arroz con mariscos frescos y azafrán</textarea>
			</div><div class="grid grid-cols-2 gap-4">
				<div>
					<label class="mb-2 block text-sm font-medium text-gray-700">Categoría</label><input
						class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
						required=""
						type="text"
						value="Platos Principales"
					/>
				</div><div>
					<label class="mb-2 block text-sm font-medium text-gray-700">Precio (€)</label><input
						step="0.01"
						class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
						required=""
						type="number"
						value="18.5"
					/>
				</div>
			</div><div>
				<label class="mb-2 block text-sm font-medium text-gray-700">Porciones</label><input
					class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
					placeholder="Ej: 1 persona, 2-3 personas, 6 unidades"
					required=""
					type="text"
					value="2-3 personas"
				/>
			</div><div class="flex items-center gap-3">
				<input
					id="available"
					class="h-4 w-4 cursor-pointer rounded border-gray-300 text-teal-500 focus:ring-teal-500"
					type="checkbox"
					checked=""
				/><label for="available" class="cursor-pointer text-sm font-medium text-gray-700"
					>Disponible para pedidos</label>
			</div><div class="flex gap-3 pt-4">
				<button
					type="button"
					class="flex-1 cursor-pointer rounded-lg border border-gray-300 px-6 py-3 font-medium whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-50"
					>Cancelar</button
				><button
					type="submit"
					class="flex-1 cursor-pointer rounded-lg bg-teal-500 px-6 py-3 font-medium whitespace-nowrap text-white transition-colors hover:bg-teal-600"
					>Guardar Cambios</button>
			</div>
		</form>
	</div>
</div>
