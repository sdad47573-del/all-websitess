<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
	<div class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-lg bg-white">
		<div class="border-b border-gray-200 p-4 sm:p-6">
			<h3 class="text-xl font-bold text-gray-800 sm:text-2xl">Editar Plato</h3>
		</div><form class="space-y-4 p-4 sm:p-6">
			<div>
				<label class="mb-2 block text-sm font-medium text-gray-700" for="CategoryModal-nombre-del-plato">Nombre del Plato</label><input id="CategoryModal-nombre-del-plato"
					class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
					required=""
					type="text"
					value="Paella Valenciana"
				/>
			</div><div>
				<label class="mb-2 block text-sm font-medium text-gray-700" for="CategoryModal-descripcion">Descripción</label><textarea id="CategoryModal-descripcion"
					class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
					rows="3"
					required="">Arroz con mariscos frescos y azafrán</textarea>
			</div><div>
				<label class="mb-2 block text-sm font-medium text-gray-700" for="CategoryModal-url-de-la-imagen">URL de la Imagen</label><input id="CategoryModal-url-de-la-imagen"
					class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
					placeholder="https://ejemplo.com/imagen.jpg"
					required=""
					type="url"
					value="/img/readdy-zdfwzi.avif"
				/><div class="mt-2 h-32 w-32">
					<img
						alt="Vista previa"
						class="h-full w-full rounded-lg object-cover"
						src="/img/readdy-zdfwzi.avif" decoding="async" loading="lazy"
					/>
				</div>
			</div><div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				<div>
					<label class="mb-2 block text-sm font-medium text-gray-700" for="CategoryModal-categoria">Categoría</label><input id="CategoryModal-categoria"
						class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
						required=""
						type="text"
						value="Platos Principales"
					/>
				</div><div>
					<label class="mb-2 block text-sm font-medium text-gray-700" for="CategoryModal-precio">Precio (€)</label><input id="CategoryModal-precio"
						step="0.01"
						class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
						required=""
						type="number"
						value="18.5"
					/>
				</div>
			</div><div>
				<label class="mb-2 block text-sm font-medium text-gray-700" for="CategoryModal-porciones">Porciones</label><input id="CategoryModal-porciones"
					class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
					placeholder="Ej: 1 persona, 2-3 personas, 6 unidades"
					required=""
					type="text"
					value="2-3 personas"
				/>
			</div><div class="flex items-center gap-3">
				<input
					id="category-available"
					class="h-4 w-4 cursor-pointer rounded border-gray-300 text-teal-500 focus:ring-teal-500"
					type="checkbox"
					checked=""
				/><label for="category-available" class="cursor-pointer text-sm font-medium text-gray-700"
					>Disponible para pedidos</label>
			</div><div class="flex flex-col gap-3 pt-4 sm:flex-row">
				<button
					type="button"
					class="flex-1 cursor-pointer rounded-lg border border-gray-300 px-6 py-3 text-sm font-medium whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-50 sm:text-base"
					>Cancelar</button
				><button
					type="submit"
					class="flex-1 cursor-pointer rounded-lg bg-teal-500 px-6 py-3 text-sm font-medium whitespace-nowrap text-white transition-colors hover:bg-teal-600 sm:text-base"
					>Guardar Cambios</button>
			</div>
		</form>
	</div>
</div>
