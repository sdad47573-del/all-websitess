<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
	<div class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-lg bg-white">
		<div class="border-b border-gray-200 p-6">
			<h3 class="text-2xl font-bold text-gray-800">Editar Oferta</h3>
		</div><form class="space-y-4 p-6">
			<div>
				<label
					class="mb-2 block text-sm font-medium text-gray-700"
					for="OffersModal-titulo-de-la-oferta">Título de la Oferta</label
				><input
					id="OffersModal-titulo-de-la-oferta"
					class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
					required=""
					type="text"
					value="Menú del Día"
				/>
			</div><div>
				<label class="mb-2 block text-sm font-medium text-gray-700" for="OffersModal-descripcion"
					>Descripción</label
				><textarea
					id="OffersModal-descripcion"
					class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
					rows="3"
					required="">Primer plato, segundo plato, postre y bebida</textarea
				>
			</div><div class="grid grid-cols-2 gap-4">
				<div>
					<label class="mb-2 block text-sm font-medium text-gray-700" for="OffersModal-descuento"
						>Descuento (%)</label
					><input
						id="OffersModal-descuento"
						min="0"
						max="100"
						class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
						required=""
						type="number"
						value="20"
					/>
				</div><div>
					<label class="mb-2 block text-sm font-medium text-gray-700" for="OffersModal-aplicable-a"
						>Aplicable a</label
					><input
						id="OffersModal-aplicable-a"
						class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
						placeholder="Ej: Todos los platos, Bebidas"
						required=""
						type="text"
						value="Menú del Día"
					/>
				</div>
			</div><div class="grid grid-cols-2 gap-4">
				<div>
					<label
						class="mb-2 block text-sm font-medium text-gray-700"
						for="OffersModal-fecha-de-inicio">Fecha de Inicio</label
					><input
						id="OffersModal-fecha-de-inicio"
						class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
						required=""
						type="date"
						value="2024-01-01"
					/>
				</div><div>
					<label class="mb-2 block text-sm font-medium text-gray-700" for="OffersModal-fecha-de-fin"
						>Fecha de Fin</label
					><input
						id="OffersModal-fecha-de-fin"
						class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-teal-500"
						required=""
						type="date"
						value="2024-12-31"
					/>
				</div>
			</div><div class="flex items-center gap-3">
				<input
					id="offer-active"
					class="h-4 w-4 cursor-pointer rounded border-gray-300 text-teal-500 focus:ring-teal-500"
					type="checkbox"
					checked=""
				/><label for="offer-active" class="cursor-pointer text-sm font-medium text-gray-700"
					>Activar oferta inmediatamente</label
				>
			</div><div class="flex gap-3 pt-4">
				<button
					type="button"
					class="flex-1 cursor-pointer rounded-lg border border-gray-300 px-6 py-3 font-medium whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-50"
					>Cancelar</button
				><button
					type="submit"
					class="flex-1 cursor-pointer rounded-lg bg-teal-500 px-6 py-3 font-medium whitespace-nowrap text-white transition-colors hover:bg-teal-600"
					>Guardar Cambios</button
				>
			</div>
		</form>
	</div>
</div>
