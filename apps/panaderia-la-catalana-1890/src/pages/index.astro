---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import vitrinas from '../assets/fotos/panaderia-la-catalana-1890-apaisada-01.jpg';
import dulces from '../assets/fotos/panaderia-la-catalana-1890-apaisada-02.jpg';
import interior from '../assets/fotos/panaderia-la-catalana-1890-apaisada-03.jpg';
import fachada from '../assets/fotos/panaderia-la-catalana-1890-panoramica-04.jpg';
import carta from '../assets/fotos/panaderia-la-catalana-1890-vertical-05.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería La Catalana, 1890 · Noroeste, Córdoba';
const description =
	'Panadería artesanal La Catalana, 1890, en la calle Atlántico, 11 (Noroeste, 14011 Córdoba). Pan, bollería, pastelería, empanadas y dulces sin lactosa. De lunes a sábado de 8:30 a 14:30.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#lacatalana1890`,
	name: BUSINESS.name,
	alternateName: ['La Catalana', 'Panadería La Catalana 1890', 'La Catalana Noroeste'],
	description:
		'Panadería artesanal en el barrio Noroeste (14011 Córdoba), con pan, bollería, pastelería, empanadas y dulces sin lactosa.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34957023345',
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:30',
			closes: '14:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de La Catalana con el rótulo «Panadería artesanal 1890» y el cartel de sin lactosa',
	},
	{
		src: dulces,
		alt: 'Vitrina de La Catalana con rosquillas, polvorones, tortas y una tarta con el letrero de inauguración de 1890',
	},
	{
		src: interior,
		alt: 'Interior de La Catalana con las vitrinas, las estanterías de botes y la zona de despacho',
	},
	{
		src: carta,
		alt: 'Carta de precios de La Catalana con la lista de bollería, dulces y tartas',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#8a2f2b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..600&family=Source+Sans+3:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería La Catalana 1890, panadería Córdoba, panadería artesanal, pastelería Córdoba, sin lactosa, Noroeste, 14011"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan, bollería, pastelería, empanadas y dulces sin lactosa en la calle Atlántico, 11 (14011 Córdoba). Panadería artesanal desde 1890. 4,6 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Vitrinas de La Catalana con las bandejas de pan, bollería y pasteles"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#8a2f2b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[vitrinas]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Panadería artesanal · 1890"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Noroeste · 14011 Córdoba"
				title="Panadería artesanal <br /><em>sin lactosa.</em>"
				lede={`La Catalana está en la calle Atlántico, 11, en el barrio Noroeste. El rótulo de la fachada dice «La Catalana · Panadería artesanal · 1890», y el cartel de la entrada lo anuncia: «todos nuestros productos sin lactosa y sin trazas de lactosa». Dentro hay vitrinas de pan, bollería y pastelería, y estanterías con botes y botellas. Abre de lunes a sábado de 8:30 a 14:30. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={vitrinas}
				imageAlt="Vitrinas de La Catalana con las bandejas de pan, bollería y pasteles y el cartel de sin lactosa"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> en Google · 35 reseñas' },
					{ label: 'Horario', html: '<b>L–S</b> 8:30–14:30 · <b>D</b> cerrado' },
					{ label: 'Zona', html: '<b>Noroeste</b> · 14011' },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Pan · pastelería · sin lactosa"
			/>

			<LocalChips label="Lo que hay en La Catalana" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un obrador <br /><em>desde 1890.</em>"
				paragraphs={[
					'La Catalana está en la calle Atlántico, 11, en el barrio Noroeste (14011 Córdoba). El rótulo de la fachada pone «La Catalana · Panadería artesanal · 1890», y en el cartel de la entrada se lee que todos sus productos son sin lactosa y sin trazas de lactosa.',
					'Dentro, el local es amplio y luminoso: vitrinas corridas con el pan, la bollería y la pastelería del día, una zona de despacho y estanterías con botes y botellas de despensa.',
					'En las fotos del perfil se ven bandejas de rosquillas, polvorones, tortas, bizcochos y empanadas, además de una tarta con el letrero de la inauguración del obrador en 1890. La carta del local lista bollería y dulces como el pastel cordobés, los pestiños, las magdalenas, las palmeras o los negritos.',
					'Las reseñas lo cuentan con cariño: «pan buenísimo y la señora que atiende súper amable», «bizcochos muy regaditos y deliciosos» y «servicio excelente, amable, educada y muy simpática». Abre de lunes a sábado de 8:30 a 14:30.',
				]}
				note="La ficha de Google publica la categoría, la dirección, el teléfono y el horario, pero no carta ni precios. La carta del local lleva importes, pero cambian, así que esta web no los repite. La ficha tampoco publica la lista de alérgenos: el «sin lactosa» es lo que anuncia el propio establecimiento."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Llamar al 957 02 33 45', href: BUSINESS.phoneHref },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Pan, bizcochos <br />
							<em>y sin lactosa.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que hay <br /><em>en la vitrina.</em>"
				description="Sin precios publicados: esto es lo que muestran las fotos y la carta del local, y lo que cuentan las reseñas de Google."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={MENU_GROUPS}
				note="La ficha no publica precios ni métodos de pago, así que esta web no indica importes. El obrador abre por la mañana y cierra a las 14:30: el surtido se agota a lo largo de la mañana."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La casa, <br /><em>por dentro.</em>"
				description="Cuatro fotos de la ficha de Google Maps: la fachada, la vitrina de dulces, el interior y la carta."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la calle <br /><em>Atlántico.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de Panadería La Catalana, 1890, en la calle Atlántico, Córdoba"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Catalana, 1890 · Noroeste"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
				]}
				contactLink={{ label: 'Abrir en Google Maps ↗', href: MAPS.place, external: true }}
				reserveNote="El teléfono de la ficha es el 957 02 33 45. No publica web propia ni redes, ni información de accesibilidad, así que esta página no la afirma. Para encargos de tartas o pasteles, conviene llamar con antelación."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Ver en Google Maps"
			navAriaLabel="Enlaces de Panadería La Catalana, 1890"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
