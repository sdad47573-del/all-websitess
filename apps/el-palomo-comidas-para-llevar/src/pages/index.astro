---
import f01 from '../assets/fotos/el-palomo-comidas-para-llevar-apaisada-01.jpg';
import f02 from '../assets/fotos/el-palomo-comidas-para-llevar-vertical-02.jpg';
import f03 from '../assets/fotos/el-palomo-comidas-para-llevar-apaisada-03.jpg';
import f04 from '../assets/fotos/el-palomo-comidas-para-llevar-apaisada-04.jpg';
import f05 from '../assets/fotos/el-palomo-comidas-para-llevar-vertical-05.jpg';
import f06 from '../assets/fotos/el-palomo-comidas-para-llevar-vertical-06.jpg';
import f07 from '../assets/fotos/el-palomo-comidas-para-llevar-apaisada-07.jpg';
import f08 from '../assets/fotos/el-palomo-comidas-para-llevar-vertical-08.jpg';
import f09 from '../assets/fotos/el-palomo-comidas-para-llevar-apaisada-09.jpg';
import f10 from '../assets/fotos/el-palomo-comidas-para-llevar-vertical-10.jpg';

const fotos = [f01, f02, f03, f04, f05, f06, f07, f08, f09, f10];

const MAPS_URL =
	'https://www.google.com/maps/place/El+Palomo+Comidas+Para+Llevar/@37.60887,-0.9934,17z/data=!3m1!4b1!4m6!3m5!1s0xd6343ee9a388d33:0x3a7d8e69b84e9224!8m2!3d37.60887!4d-0.9934!16s%2Fg%2F11sd3zdgxy?authuser=0&hl=es&entry=ttu';
const CREDIT_URL = 'https://sur-digital.vercel.app/';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>El Palomo Comidas Para Llevar</title>
		<meta name="description" content="El Palomo Comidas Para Llevar." />
	</head>
	<body>
		<header>
			<h1>El Palomo Comidas Para Llevar</h1>
			<a href={MAPS_URL} rel="noopener" target="_blank">Ver en Google Maps</a>
		</header>

		<main>
			<section>
				{fotos.map((foto) => (
					<img src={foto.src} width={foto.width} height={foto.height} alt="El Palomo Comidas Para Llevar" loading="lazy" />
				))}
			</section>
		</main>

		<footer>
			<p>
				Creado por <a href={CREDIT_URL} rel="noopener">Sur Digital</a> · sur-digital.vercel.app
			</p>
		</footer>
	</body>
</html>
