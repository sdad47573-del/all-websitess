---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/panaderia-pasteleria-remedios-fachada-01.jpg';
import cesta from '../assets/fotos/panaderia-pasteleria-remedios-vertical-02.jpg';
import charcuteria from '../assets/fotos/panaderia-pasteleria-remedios-vertical-03.jpg';
import vitrina from '../assets/fotos/panaderia-pasteleria-remedios-vertical-04.jpg';
import pan from '../assets/fotos/panaderia-pasteleria-remedios-vista-5-05.jpg';
import despensa from '../assets/fotos/panaderia-pasteleria-remedios-vertical-06.jpg';
import tortas from '../assets/fotos/panaderia-pasteleria-remedios-vertical-07.jpg';
import magdalenas from '../assets/fotos/panaderia-pasteleria-remedios-vertical-08.jpg';
import cartel from '../assets/fotos/panaderia-pasteleria-remedios-vista-9-09.jpg';
import estanteria from '../assets/fotos/panaderia-pasteleria-remedios-vista-10-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería Ntra. Señora de los Remedios · Bailén-Miraflores';
const description =
	'Panadería - Pastelería Ntra. Señora de los Remedios, en C. Magistrado Salvador Barbera, 11 (Bailén-Miraflores, 29010 Málaga). Pan recién hecho, dulces y bocadillos. 4,6/5 en Google. Teléfono 675 16 75 66.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#remedios`,
	name: BUSINESS.name,
	alternateName: [
		'Panadería Nuestra Señora de los Remedios',
		'Panadería Remedios Málaga',
		'Pastelería Remedios',
	],
	description:
		'Panadería y pastelería en C. Magistrado Salvador Barbera, 11 (Bailén-Miraflores, 29010 Málaga). Pan recién hecho, dulces artesanos, bocadillos preparados, charcutería y despensa.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34675167566',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '07:30',
			closes: '15:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{ src: cesta, alt: 'Cesta de dulces envasados con espigas de trigo, en el mostrador' },
	{ src: charcuteria, alt: 'Chorizo, morcilla de Ronda y salchichón sobre papel de periódico' },
	{ src: vitrina, alt: 'Bolsas de donuts, magdalenas y bollería envasada en la vitrina' },
	{ src: pan, alt: 'Pan apilado y espigas de trigo en el expositor de la panadería' },
	{ src: despensa, alt: 'Arroz, salsas y productos de despensa sobre el mostrador de cristal' },
	{ src: tortas, alt: 'Cajas de tortas de aceite Carmen Lupiáñez' },
	{ src: magdalenas, alt: 'Bolsas de magdalenas bizcochadas y perrunas' },
	{
		src: cartel,
		alt: 'Fachada verde con el cartel de pan recién hecho, dulces artesanos y bocadillos',
	},
	{ src: estanteria, alt: 'Estantería con galletas María, Gullón, conservas y anchoas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f3d2b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@300..700&family=Prata&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Ntra. Señora de los Remedios, panadería Málaga, pastelería Bailén-Miraflores, bocadillos Málaga, pan recién hecho, Magistrado Salvador Barbera, 29010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan recién hecho, dulces artesanos, bocadillos preparados y despensa en Bailén-Miraflores. 4,6 sobre 5 con 11 reseñas en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de la Panadería Ntra. Señora de los Remedios en la calle Magistrado Salvador Barbera, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1f3d2b"
			phone="+34675167566"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Remedios"
			subtitle="Panadería · Pastelería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Magistrado Salvador Barbera, 11 · Bailén-Miraflores"
				title="Pan recién hecho, <br /><em>bocadillos de barrio.</em>"
				lede={`En la calle Magistrado Salvador Barbera, 11, está la panadería-pastelería Ntra. Señora de los Remedios. El cartel de la puerta anuncia pan recién hecho, dulces artesanos y bocadillos recién preparados; dentro hay además charcutería y despensa. Abre de lunes a sábado por la mañana. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={fachada}
				imageAlt="Fachada de la Panadería Ntra. Señora de los Remedios con el rótulo de madera y la puerta abierta"
				primaryCta={{ label: 'Llamar · 675 16 75 66', href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> en Google · 11 reseñas' },
					{ label: 'Horario', html: '<b>L–S mañana</b> · domingo cerrado' },
					{ label: 'Teléfono', html: '<b>675 16 75 66</b>' },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Pan · dulces · bocadillos"
			/>

			<LocalChips label="Lo que hay en la panadería" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una panadería <br /><em>con despensa.</em>"
				paragraphs={[
					'La Panadería - Pastelería Ntra. Señora de los Remedios está en la calle Magistrado Salvador Barbera, 11, en Bailén-Miraflores. El rótulo de madera de la fachada lleva el nombre completo y, al lado, la imagen de la Virgen.',
					'En la puerta, un cartel lo dice sin rodeos: «pan recién hecho», «dulces artesanos» y «bocadillos recién preparados». Las reseñas van en la misma dirección: «buen pan, mucha variedad», «te prepara bocadillos», «trato muy amable, siempre con una sonrisa».',
					'Dentro no solo hay horno. Las fotos del perfil enseñan la vitrina con magdalenas, perrunas y bizcochos; una bandeja de chorizo, morcilla de Ronda y salchichón; cajas de tortas de aceite; y estanterías con galletas, arroz, conservas y anchoas.',
					'Abre de lunes a viernes de 7:00 a 15:00 y el sábado de 7:30 a 15:00. El domingo cierra. La ficha no publica más descripción que el nombre, ni carta, precios ni información de accesibilidad: lo que no está publicado, aquí no se inventa.',
				]}
				note="4,6 sobre 5 con 11 reseñas en Google. Las tres citadas son las destacadas de la ficha y todas son de cinco estrellas."
				links={[
					{ label: 'Llamar · 675 16 75 66', href: BUSINESS.phoneHref },
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas de la casa</p>
						<h2 id="three-title">Horno, vitrina <br /><em>y despensa.</em></h2>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que hay <br /><em>a la vista.</em>"
				description="Sin carta ni precios publicados: esto es lo que anuncian el cartel de la fachada, las reseñas y las fotos del perfil."
				cta={{ label: 'Llamar · 675 16 75 66', href: BUSINESS.phoneHref }}
				groups={MENU_GROUPS}
				note="La ficha no recoge precios ni métodos de pago, así que esta web no publica importes. Para saber qué hay ese día o encargar algo, llama al 675 16 75 66."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La casa, <br /><em>por dentro.</em>"
				description="Nueve fotos de la ficha de Google Maps: la fachada, el pan, la vitrina, la charcutería, la despensa y los dulces."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="reviews-title">
				<div class="wrap">
					<div class="reviews-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Lo que dicen</p>
							<h2 id="reviews-title">Tres reseñas <br /><em>de la ficha.</em></h2>
						</div>
						<p>
							4,6 sobre 5 con 11 reseñas. Estas tres están publicadas en Google y hablan
							del pan, de los bocadillos y del trato.
						</p>
					</div>
					<div class="review-grid">
						{
							REVIEWS.map((review) => (
								<figure class="review-card">
									<span class="stars" role="img" aria-label={`${review.rating} de 5 estrellas`}>
										★★★★★
									</span>
									<blockquote>{review.text}</blockquote>
									<figcaption>Reseña de Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<a class="reviews-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
						Leer las 11 reseñas en Google ↗
					</a>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Salvador <br /><em>Barbera, 11.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de la Panadería Ntra. Señora de los Remedios en la calle Magistrado Salvador Barbera, 11, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Remedios · Bailén-Miraflores"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: '675 16 75 66', href: BUSINESS.phoneHref }}
				reserveNote="La ficha no publica información sobre accesibilidad ni aparcamiento. No hay web ni correo: el contacto es en el local o por teléfono."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y disponibilidad pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar a Remedios"
			navAriaLabel="Enlaces de la Panadería Ntra. Señora de los Remedios"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
