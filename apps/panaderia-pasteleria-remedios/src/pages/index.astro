---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/panaderia-pasteleria-remedios-fachada-01.jpg';
import cesta from '../assets/fotos/panaderia-pasteleria-remedios-vertical-02.jpg';
import charcuteria from '../assets/fotos/panaderia-pasteleria-remedios-vertical-03.jpg';
import vitrina from '../assets/fotos/panaderia-pasteleria-remedios-vertical-04.jpg';
import pan from '../assets/fotos/panaderia-pasteleria-remedios-vista-5-05.jpg';
import despensa from '../assets/fotos/panaderia-pasteleria-remedios-vertical-06.jpg';
import tortas from '../assets/fotos/panaderia-pasteleria-remedios-vertical-07.jpg';
import magdalenas from '../assets/fotos/panaderia-pasteleria-remedios-vertical-08.jpg';
import cartel from '../assets/fotos/panaderia-pasteleria-remedios-vista-9-09.jpg';
import estanteria from '../assets/fotos/panaderia-pasteleria-remedios-vista-10-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería Ntra. Señora de los Remedios · Bailén-Miraflores';
const description =
	'Panadería - Pastelería Ntra. Señora de los Remedios, en C. Magistrado Salvador Barbera, 11 (Bailén-Miraflores, 29010 Málaga). Pan recién hecho, dulces y bocadillos. 4,6/5 en Google. Teléfono 675 16 75 66.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#remedios`,
	name: BUSINESS.name,
	alternateName: [
		'Panadería Nuestra Señora de los Remedios',
		'Panadería Remedios Málaga',
		'Pastelería Remedios',
	],
	description:
		'Panadería y pastelería en C. Magistrado Salvador Barbera, 11 (Bailén-Miraflores, 29010 Málaga). Pan recién hecho, dulces artesanos, bocadillos preparados, charcutería y despensa.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34675167566',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '07:30',
			closes: '15:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{ src: cesta, alt: 'Cesta de dulces envasados con espigas de trigo, en el mostrador' },
	{ src: charcuteria, alt: 'Chorizo, morcilla de Ronda y salchichón sobre papel de periódico' },
	{ src: vitrina, alt: 'Bolsas de donuts, magdalenas y bollería envasada en la vitrina' },
	{ src: pan, alt: 'Pan apilado y espigas de trigo en el expositor de la panadería' },
	{ src: despensa, alt: 'Arroz, salsas y productos de despensa sobre el mostrador de cristal' },
	{ src: tortas, alt: 'Cajas de tortas de aceite Carmen Lupiáñez' },
	{ src: magdalenas, alt: 'Bolsas de magdalenas bizcochadas y perrunas' },
	{
		src: cartel,
		alt: 'Fachada verde con el cartel de pan recién hecho, dulces artesanos y bocadillos',
	},
	{ src: estanteria, alt: 'Estantería con galletas María, Gullón, conservas y anchoas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"panaderia-pasteleria-remedios-fachada-01.jpg": fachada,
	"panaderia-pasteleria-remedios-vertical-02.jpg": cesta,
	"panaderia-pasteleria-remedios-vertical-03.jpg": charcuteria,
	"panaderia-pasteleria-remedios-vertical-04.jpg": vitrina,
	"panaderia-pasteleria-remedios-vista-5-05.jpg": pan,
	"panaderia-pasteleria-remedios-vertical-06.jpg": despensa,
	"panaderia-pasteleria-remedios-vertical-07.jpg": tortas,
	"panaderia-pasteleria-remedios-vertical-08.jpg": magdalenas,
	"panaderia-pasteleria-remedios-vista-9-09.jpg": cartel,
	"panaderia-pasteleria-remedios-vista-10-10.jpg": estanteria,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f3d2b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@300..700&family=Prata&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Ntra. Señora de los Remedios, panadería Málaga, pastelería Bailén-Miraflores, bocadillos Málaga, pan recién hecho, Magistrado Salvador Barbera, 29010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan recién hecho, dulces artesanos, bocadillos preparados y despensa en Bailén-Miraflores. 4,6 sobre 5 con 11 reseñas en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de la Panadería Ntra. Señora de los Remedios en la calle Magistrado Salvador Barbera, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1f3d2b"
			phone="+34675167566"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Remedios"
			subtitle="Panadería · Pastelería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y disponibilidad pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar a Remedios"
			navAriaLabel="Enlaces de la Panadería Ntra. Señora de los Remedios"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
