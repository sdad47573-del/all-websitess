---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/bunbun-chicken-apaisada-01.jpg';
import bandeja from '../assets/fotos/bunbun-chicken-apaisada-03.jpg';
import polloPatatas from '../assets/fotos/bunbun-chicken-apaisada-04.jpg';
import salon from '../assets/fotos/bunbun-chicken-apaisada-05.jpg';
import letrero from '../assets/fotos/bunbun-chicken-apaisada-06.jpg';
import arcos from '../assets/fotos/bunbun-chicken-apaisada-07.jpg';
import mostrador from '../assets/fotos/bunbun-chicken-apaisada-08.jpg';
import cartel from '../assets/fotos/bunbun-chicken-apaisada-09.jpg';
import pollitos from '../assets/fotos/bunbun-chicken-vertical-02.jpg';
import patatas from '../assets/fotos/bunbun-chicken-vertical-10.jpg';

import { BUSINESS, FAQ, HORARIO, HORARIO_AVISO, MAPS, RESENAS, SERVICIOS } from '../data/site';

const title = 'Bunbun Chicken · Pollo frito y hamburguesas en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de Bunbun Chicken de noche, en rojo, con el rótulo luminoso y los arcos iluminados de la calle Pozo Concejo',
	},
	{
		src: bandeja,
		alt: 'Dos hamburguesas de pollo crujiente y dos bandejas de pollo frito con salsa amarilla en una bandeja naranja',
	},
	{
		src: polloPatatas,
		alt: 'Bandeja de pollo frito recién hecho con patatas gajo al fondo, sobre una mesa del local',
	},
	{
		src: salon,
		alt: 'Salón de Bunbun Chicken: mesas de madera, sillas blancas, arcos de neón y una estantería con pollitos amarillos',
	},
	{
		src: letrero,
		alt: 'Letrero redondo iluminado con el pollo de dibujo animado y el nombre Bun Bun Chicken',
	},
	{
		src: arcos,
		alt: 'Ventanas arqueadas del local desde la acera, con neones naranjas y el dibujo del pollo en azul',
	},
	{
		src: mostrador,
		alt: 'Mostrador de Bunbun Chicken con el cartel de Cashier, las pantallas del menú y la máquina de refrescos',
	},
	{
		src: cartel,
		alt: 'Cartel de la carta de Bunbun Chicken con los precios de la hamburguesa, las patatas, la ensalada, el takoyaki, la salchicha, el pincho y las bebidas',
	},
	{
		src: pollitos,
		alt: 'Estantería del local con pollitos de peluche amarillos bajo un arco iluminado',
	},
	{
		src: patatas,
		alt: 'Ración de patatas fritas con sal en una bandeja naranja, con pollo frito al lado',
	},
];

const carta = [
	{
		title: 'Hamburguesas y pollo',
		items: [
			{
				name: 'Hamburguesa bunbun',
				note: 'pollo crujiente, queso y verduras en pan brioche',
				price: '4,95 €',
			},
			{
				name: 'Pollo frito en bandeja',
				note: 'para compartir, como el de las fotos del local',
			},
			{
				name: 'Alitas con salsa',
				note: 'con la salsa amarilla de la bandeja',
			},
		],
	},
	{
		title: 'Para picar',
		items: [
			{ name: 'Salchicha bunbun', note: 'en brocheta, con su salsa', price: '2,55 €' },
			{ name: 'Pincho de hotpot picante', note: 'el pincho largo de la carta', price: '3,55 €' },
			{ name: 'Takoyaki', note: '3 unidades', price: '3,95 €' },
			{ name: 'Bumbunato fritte', note: 'frito de la casa', price: '3,95 €' },
		],
	},
	{
		title: 'Patatas y ensalada',
		items: [
			{ name: 'Patatas fritas', note: 'ración para compartir', price: '2,95 €' },
			{ name: 'Ensalada bunbun', note: 'con pollo crujiente y salsa', price: '3,95 €' },
		],
	},
	{
		title: 'Bebidas y postres',
		items: [
			{ name: 'Burbuja con leche', note: 'bubble tea con perlas', price: '4,95 €' },
			{ name: 'Burbuja de maracuyá', note: 'bubble tea de fruta', price: '4,95 €' },
			{ name: 'Burbuja de pomelo', note: 'bubble tea de fruta', price: '4,95 €' },
			{ name: 'Bunbun arroz burbuja', note: 'postre de arroz', price: '4,55 €' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#bunbun-chicken`,
	name: BUSINESS.name,
	alternateName: ['Bun Bun Chicken', 'Bunbun Chicken Ciudad Real', 'Bunbun chicken pollo frito'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo frito', 'Hamburguesas', 'Comida para llevar'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Ciudad Real' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday'],
			opens: '12:00',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday'],
			opens: '19:30',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday', 'Sunday'],
			opens: '19:30',
			closes: '00:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1b1013" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,700&family=Nunito+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Bunbun chicken Ciudad Real, pollo frito Ciudad Real, hamburguesas Pozo Concejo, bubble tea Ciudad Real, takoyaki Ciudad Real, pollo frito para llevar 13004, restaurante pollo Ciudad Real, Bun Bun Chicken, C. Pozo Concejo"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo frito crujiente, hamburguesas bunbun, patatas, takoyaki y bubble tea en la calle Pozo Concejo, Ciudad Real. De 12:00 a 16:30 y desde las 19:30; martes cerrado."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Bunbun Chicken, pollo frito y hamburguesas en Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1b1013"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CR"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[bandeja]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Bunbun Chicken"
			subtitle="Pollo frito · Ciudad Real"
			nav={nav}
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="Pollo frito, <br /><em>neón y salsas.</em>"
				lede="Bunbun chicken está en la calle Pozo Concejo, en pleno centro de Ciudad Real, y su ficha de Google lo define como «Restaurante especializado en pollo». Bandejas de pollo frito crujiente, hamburguesas, patatas, takoyaki y bubble tea, de 12:00 a 16:30 y desde las 19:30. Tiene 4,6 sobre 5 con 73 reseñas."
				image={bandeja}
				imageAlt="Dos hamburguesas de pollo crujiente y dos bandejas de pollo frito con salsa amarilla en una bandeja naranja de Bunbun Chicken"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> en Google · 73 reseñas' },
					{ label: 'Horario', html: '<b>12:00–16:30</b><br />y desde las 19:30 · martes cerrado' },
					{ label: 'Contacto', html: '<b>Ficha de Google</b><br />sin teléfono publicado' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Bunbun Chicken" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Rojo, neón <br /><em>y pollo frito.</em>"
				paragraphs={[
					'El local está en la calle Pozo Concejo, 13004 Ciudad Real. Por fuera es una esquina roja con el rótulo luminoso de Bunbun Chicken y una fila de ventanas en arco con neón naranja; por dentro, madera clara, sillas blancas, azulejo rosa y una estantería con pollitos amarillos bajo un arco de luz. El dibujo de la casa es un pollo blanco con un copete de pollo frito.',
					'La ficha de Google lo clasifica como restaurante especializado en pollo. En las bandejas naranjas del local salen el pollo frito crujiente y las alitas con salsa, las hamburguesas de pollo con queso y verduras, las patatas fritas, la ensalada con pollo, el takoyaki y los bubble tea con perlas.',
					'El horario parte el día en dos: de 12:00 a 16:30 y desde las 19:30. De domingo a jueves la cocina aguanta hasta medianoche y los viernes y sábados hasta las 0:30. Descansa los martes, y la propia ficha avisa de que en el Día de Todos los Santos el horario podría ser distinto.',
					'Google recoge 73 reseñas con una media de 4,6. Destaca tres: una que cuenta que el menú daba para dos personas, otra que alaba el pollo, las salsas y las patatas, y una de una estrella con humor sobre un vasito de queso rallado. Aquí están las tres, con su puntuación.',
				]}
				note="La ficha de Google no publica carta ni teléfono, y esta web no inventa ninguno de los dos. Los precios de la página salen del cartel de la carta fotografiado en el propio perfil del local: pueden cambiar."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Hamburguesa, <br /><em>pollo y burbuja.</em>"
				description="Lo que se puede pedir, con los precios del cartel de la casa: hamburguesa bunbun, salchicha, pincho de hotpot, takoyaki, patatas, ensalada y bubble tea."
				cta={{ label: 'Ver la carta en Google Maps', href: MAPS.place }}
				groups={carta}
				note="Precios copiados del cartel de la carta que aparece en las fotos del perfil de Google Maps del local. El precio de las bandejas de pollo no se lee en esa foto, así que aquí no se pone. Pueden cambiar: se confirman en el mostrador."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
					<div class="reviews-head">
						<h2 id="resenas-title">Riquísimo, <br /><em>y con quejas.</em></h2>
						<p>
							La ficha tiene 73 reseñas y una media de 4,6. Estas son las tres que Google destaca, con
							la puntuación que les dio su autor: también la de una estrella.
						</p>
					</div>
					<div class="review-grid">
						{
							RESENAS.map((review) => (
								<figure class="review-card">
									<p class="review-stars" aria-label={`${review.rating} sobre 5`}>
										{'★'.repeat(review.rating)}
										<span aria-hidden="true">{'★'.repeat(5 - review.rating)}</span>
									</p>
									<blockquote>{review.quote}</blockquote>
									<figcaption>Reseña publicada en Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="review-note">
						Citas de las reseñas públicas del local, con la puntuación del autor. En la ficha de Google
						están todas, incluidas las que puntúan por debajo.
					</p>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Una esquina <br /><em>en rojo.</em>"
				description="Diez fotos del perfil del local: la fachada de noche, las bandejas de pollo y hamburguesas, el salón con los arcos de neón, el letrero del pollo, el mostrador y el cartel de la carta."
				images={galeria}
				cta={{ label: 'Ver todas en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="Mediodía <br /><em>y noche.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Ciudad Real · España']}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de Bunbun Chicken en la calle Pozo Concejo, Ciudad Real"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Bunbun Chicken"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: 'Datos de contacto en Google Maps ↗', href: MAPS.place, external: true }}
				reserveNote="La ficha de Google no publica teléfono y esta página no tramita pedidos ni reservas: los datos de contacto y el botón de pedido que Google tenga habilitados están en la propia ficha. En el local hay mesas y también se preparan bandejas para llevar."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Bunbun Chicken"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone=""
			phoneHref=""
			legal="Datos, horario, precios y fotografías tomados de la ficha y del perfil públicos del local en Google Maps, consultados en noviembre de 2026. Los precios son los del cartel del propio establecimiento y pueden cambiar."
			ctaLabel=""
			navAriaLabel="Enlaces de Bunbun Chicken"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
