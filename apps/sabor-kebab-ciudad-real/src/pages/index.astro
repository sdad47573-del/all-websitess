---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import durumPlato from '../assets/fotos/sabor-kebab-ciudad-real-apaisada-03.jpg';
import pinchos from '../assets/fotos/sabor-kebab-ciudad-real-apaisada-04.jpg';
import barra from '../assets/fotos/sabor-kebab-ciudad-real-vertical-01.jpg';
import pinchosCercanos from '../assets/fotos/sabor-kebab-ciudad-real-vertical-02.jpg';
import guiso from '../assets/fotos/sabor-kebab-ciudad-real-vertical-05.jpg';
import bandejaCarne from '../assets/fotos/sabor-kebab-ciudad-real-vertical-06.jpg';
import durumPlancha from '../assets/fotos/sabor-kebab-ciudad-real-vertical-07.jpg';
import comedor from '../assets/fotos/sabor-kebab-ciudad-real-vertical-08.jpg';
import fachadaNoche from '../assets/fotos/sabor-kebab-ciudad-real-vertical-09.jpg';
import fachadaDia from '../assets/fotos/sabor-kebab-ciudad-real-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, RATING, SERVICIOS } from '../data/site';

const title = 'Sabor Kebab Ciudad Real · dürüm, kebab y combos en el centro';
const description = BUSINESS.description;

const galeria = [
	{
		src: durumPlancha,
		alt: 'Dürüm marcado en la plancha sobre una bandeja, con patatas fritas, lechuga, tomate y pepinillos',
	},
	{
		src: pinchosCercanos,
		alt: 'Los dos pinchos de kebab girando en la máquina, con bandejas de lechuga y tomate en primer plano',
	},
	{
		src: pinchos,
		alt: 'Pinchos de pollo y de carne en el asador vertical del local, junto a la plancha',
	},
	{
		src: barra,
		alt: 'Barra del local con taburetes altos, la máquina de kebab y las campanas de la cocina al fondo',
	},
	{
		src: guiso,
		alt: 'Plato de carne turca guisada con tomate, pimiento verde y especias, con ensalada al lado',
	},
	{
		src: bandejaCarne,
		alt: 'Bandeja de carne especiada con cebolla en aros y caldo, recién hecha',
	},
	{
		src: comedor,
		alt: 'Comedor del local con mesas negras, sillones blancos y el mural de fotos de comida',
	},
	{
		src: fachadaNoche,
		alt: 'Rótulo luminoso de Sabor Kebab en la fachada, de noche, con el teléfono de pedidos',
	},
	{
		src: fachadaDia,
		alt: 'Fachada de día con el cartel de Sabor Kebab, el póster de la carta y el cartel de ofertas con precios',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#sabor-kebab-ciudad-real`,
	name: BUSINESS.name,
	alternateName: ['Sabor Kebab', 'Kebab Sabor Ciudad Real', 'Sabor Kebab Corazón de María'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Turca', 'Kebab', 'Dürüm'],
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.channel },
	],
	priceRange: '€',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '01:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17130f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Sabor Kebab Ciudad Real, kebab Ciudad Real centro, dürüm Ciudad Real, restaurante turco Ciudad Real, Corazón de María 3, kebab hasta la 1:00, combos kebab Ciudad Real, kebab 13003"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Dürums, kebab y combos con patatas y bebida en la calle Corazón de María, 3, de Ciudad Real. De 13:00 a 1:00 todos los días. 3,4 sobre 5 con 128 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Dürüm de Sabor Kebab Ciudad Real con patatas y verduras"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#17130f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[durumPlato]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Dürüm · kebab · combos"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Dürüm a la plancha <br /><em>hasta la una.</em>"
				lede={`Sabor Kebab está en la calle Corazón de María, 3, en el centro de Ciudad Real. Dos pinchos girando todo el día, dürüm marcado en la plancha, patatas y combos para compartir, de 13:00 a 1:00 de la madrugada. La ficha de Google le da 3,4 sobre 5 con 128 reseñas.`}
				image={durumPlato}
				imageAlt="Dürüm de Sabor Kebab Ciudad Real con patatas fritas, lechuga, tomate y pimientos"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>3,4</b> en Google · 128 reseñas' },
					{ label: 'Horario', html: '<b>13:00–1:00</b><br />Todos los días · sin día de cierre' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> pedidos y consultas` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Sabor Kebab" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Kebab <br /><em>de barrio.</em>"
				paragraphs={[
					'Sabor Kebab ocupa un bajo en la calle Corazón de María, 3, en el centro de Ciudad Real, con la barra de granito a la entrada, taburetes altos y la máquina de pinchos a la vista. Google lo clasifica como restaurante turco y bar.',
					'El local trabaja con dos pinchos, uno de pollo y otro de carne, que se van cortando al momento sobre la plancha. Las fotos del perfil enseñan el corte, las bandejas de lechuga y tomate, el dürüm marcado en la plancha y las patatas fritas al lado.',
					'La fachada anuncia «Teléfono pedidos» con dos números —el fijo 926 09 39 34 y el móvil 622 53 90 31— y un cartel de ofertas con los combos: dos dürüm con patatas y bebida de dos litros por 12,50 €, tres por 15,00 €, cinco por 25,00 € y dos platos por 13,50 €.',
					'El horario es el de un kebab de noche: abre a las 13:00 y cierra a la 1:00 de la madrugada los siete días de la semana, sin descanso. La ficha marca acceso para sillas de ruedas y no publica web propia.',
				]}
				note="Los datos salen de la ficha pública de Google Maps, de las reseñas y de las fotos del perfil, incluida la de la fachada con el cartel de precios. Los importes pueden haber cambiado: confírmalos al pedir."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Combos, dürüm <br /><em>y patatas.</em>"
				description="Los combos y sus precios son los del cartel de ofertas de la fachada, leídos en la foto del perfil. El resto —dürüm suelto, kebab en pan, platos y patatas— sale de las fotos y de las reseñas; la carta completa está en el póster del local."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="Los precios de los combos son los del cartel de la fachada en el momento de hacer esta página y pueden cambiar. La carta completa, con los precios del resto de platos, está en el póster de la pared y en el mostrador; también se pregunta en el 926 09 39 34 o en el 622 53 90 31."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Nueve fotos <br /><em>del local.</em>"
				description="Las fotografías del perfil de Sabor Kebab en Google Maps: el dürüm a la plancha, los dos pinchos, la barra, la carne guisada, el comedor y la fachada con sus carteles."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a Corazón <br /><em>de María.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Castilla-La Mancha, España',
				]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: de 13:00 a 1:00 de la madrugada todos los días, sin día de cierre. La 1:00 es ya la madrugada del día siguiente. En festivos puede cambiar; llama antes si vas a última hora."
				mapTitle="Mapa de Sabor Kebab Ciudad Real en la calle Corazón de María 3"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Sabor Kebab Ciudad Real"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote={`No hay pedidos ni reservas en línea en esta página. El local no publica web propia ni plataforma de reparto: se pide en el mostrador o por teléfono. Además del fijo ${BUSINESS.phone}, el rótulo de la fachada anuncia el móvil ${BUSINESS.ordersPhone} para pedidos.`}
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Precios del cartel de la fachada; pueden cambiar. Confirma carta y horario antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Sabor Kebab Ciudad Real"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
