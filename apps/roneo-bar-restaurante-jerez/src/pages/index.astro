---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/roneo-bar-restaurante-jerez-apaisada-09.jpg';
import foto1 from '../assets/fotos/roneo-bar-restaurante-jerez-apaisada-01.jpg';
import foto2 from '../assets/fotos/roneo-bar-restaurante-jerez-vertical-02.jpg';
import foto3 from '../assets/fotos/roneo-bar-restaurante-jerez-vertical-03.jpg';
import foto4 from '../assets/fotos/roneo-bar-restaurante-jerez-vertical-04.jpg';
import foto5 from '../assets/fotos/roneo-bar-restaurante-jerez-vertical-05.jpg';

const business = {
	name: 'Roneo bar y restaurante',
	street: 'C. Porvera, 9',
	city: 'Jerez de la Frontera',
	region: 'Andalucía',
	province: 'Cádiz',
	postalCode: '11403',
	phone: '+34 856 66 77 57',
	latitude: 36.6862279,
	longitude: -6.1381395,
	site: 'https://roneo-bar-restaurante-jerez.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Roneo+bar+y+restaurante/@36.6862279,-6.1381395,17z/data=!3m1!4b1!4m6!3m5!1s0xd0dc7308c7c988d:0xee78053e7b882b40!8m2!3d36.6862279!4d-6.1381395!16s%2Fg%2F11mwjt4sg1?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34856667757';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'El que recomiendan',
		title: 'Arroz de chuleta',
		text: 'Arroz de chuleta recomendado por sus clientes, junto a puntillitas y croquetas de puchero. Cocina para disfrutones.',
	},
	{
		kicker: 'Fritura',
		title: 'Puntillitas',
		text: 'Puntillitas entre lo más pedido: fritura andaluza bien hecha en pleno centro de Jerez.',
	},
	{
		kicker: 'De cuchara',
		title: 'Croquetas de puchero',
		text: 'Croquetas de puchero: el sabor del guiso de siempre en formato tapa. Las que citan quienes repiten.',
	},
	{
		kicker: 'Frescas',
		title: 'Ensaladilla y tomate',
		text: 'Ensaladilla de gambas y ensalada de tomate estupendas, según sus reseñas. Para abrir o para compartir.',
	},
	{
		kicker: 'La casa',
		title: 'Un local para disfrutones',
		text: 'Así se define el propio local: restaurante andaluz en la calle Porvera, con camareros amables y comida exquisita.',
	},
	{
		kicker: 'Aviso',
		title: 'Lunes cerrado',
		text: 'El lunes cierra y el domingo solo abre a mediodía (12:30–16:30). De martes a sábado, mediodía y noche. Llama en festivos.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de Roneo bar y restaurante publicada en su ficha de Google Maps (Jerez de la Frontera)' },
	{ src: photos.foto2, alt: 'Interior de Roneo bar y restaurante, en la calle Porvera, Jerez' },
	{ src: photos.foto3, alt: 'Fotografía de Roneo bar y restaurante en Jerez de la Frontera, desde Google Maps' },
	{ src: photos.foto4, alt: 'Imagen de Roneo bar y restaurante (Jerez) subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Detalle de Roneo bar y restaurante según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está Roneo bar y restaurante?',
		a: 'En la calle Porvera, 9, 11403 Jerez de la Frontera (Cádiz). Coordenadas 36.6862279, -6.1381395.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Lunes cerrado. Martes, miércoles y sábado de 12:30 a 16:30 y de 20:15 a 23:30; jueves y viernes de 12:15 a 16:30 y de 20:15 a 23:30; domingo solo de 12:30 a 16:30. Confirma festivos.',
	},
	{
		q: '¿Cómo reservo mesa?',
		a: 'Llamando al 856 66 77 57. Con 4,6 estrellas y más de 600 reseñas, para grupos conviene llamar con antelación.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Cocina andaluza: arroz de chuleta, puntillitas, croquetas de puchero, ensaladilla de gambas y ensalada de tomate.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso, aseo y asientos adaptados para sillas de ruedas. Para necesidades concretas, llama antes.',
	},
];

const images = [
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'Roneo bar y restaurante en Jerez (calle Porvera, 9): arroz de chuleta, puntillitas y croquetas de puchero. Reserva en el 856 66 77 57.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 856 66 77 57',
	image: images,
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo, tarjeta de crédito',
	servesCuisine: ['Andaluza', 'Española', 'Tapas', 'Mediterránea'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Saturday'],
			opens: '12:30',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday', 'Friday'],
			opens: '12:15',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '20:15',
			closes: '23:30',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '12:30', closes: '16:30' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Ideal para grupos', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.6,
		reviewCount: 619,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1b1714" />
		<meta
			name="description"
			content="Roneo bar y restaurante en Jerez: arroz de chuleta, puntillitas y croquetas de puchero en la calle Porvera, 9. Reserva en el 856 66 77 57."
		/>
		<meta
			name="keywords"
			content="Roneo Jerez, calle Porvera restaurante, arroz chuleta Jerez, puntillitas Jerez, croquetas puchero, ensaladilla gambas"
		/>
		<meta name="author" content="Roneo bar y restaurante" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Roneo bar y restaurante | Cocina andaluza en Jerez</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Roneo · Un local para disfrutones en Jerez" />
		<meta
			property="og:description"
			content="Arroz de chuleta, puntillitas y croquetas de puchero en la calle Porvera, 9 (Jerez de la Frontera)."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="Roneo bar y restaurante, en Jerez de la Frontera" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Roneo bar y restaurante · Cocina andaluza en Jerez" />
		<meta
			name="twitter:description"
			content="Arroz de chuleta y tapas andaluzas en la calle Porvera, 9 (Jerez)."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Jerez de la Frontera" />
		<meta name="geo.position" content="36.6862279;-6.1381395" />
		<meta name="ICBM" content="36.6862279, -6.1381395" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Roneo bar y restaurante, inicio">
				<span class="brand-mark" aria-hidden="true">R</span>
				<span class="brand-name">Roneo <small>Jerez · Porvera</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#roneo">Roneo</a>
				<a href="#especialidades">Especialidades</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>856 66 77 57</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Calle Porvera · Jerez</p>
					<h1 id="hero-title">Un local<br />para disfrutones<br /><em>en Jerez.</em></h1>
					<p class="hero-lede">
						Roneo bar y restaurante en la calle Porvera: arroz de chuleta, puntillitas, croquetas de puchero,
						ensaladilla de gambas y tomate. Restaurante andaluz con camareros amables y comida exquisita.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>
							Reservar 856 66 77 57
						</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,6</b> en Google (619 reseñas)</li>
						<li>Arroz chuleta</li>
						<li>Puntillitas</li>
						<li>Puchero</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						alt="Fotografía de Roneo bar y restaurante publicada en su ficha de Google Maps (Jerez de la Frontera)"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,6</b><span>Google</span></div>
					<div><b>619</b><span>Reseñas</span></div>
					<div><b>2×6</b><span>Turnos×días</span></div>
				</div>
				<ul class="services">
					<li>Andaluza</li>
					<li>Arroces</li>
					<li>Local accesible</li>
					<li>Grupos</li>
					<li>Reservas</li>
					<li>Bar</li>
				</ul>
			</section>

			<section class="about section-pad" id="roneo">
				<p class="section-label"><span aria-hidden="true"></span> Un restaurante en Jerez</p>
				<div class="about-grid">
					<h2>Cocina andaluza<br />a mediodía y noche<br /><em>para disfrutones.</em></h2>
					<div class="about-copy">
						<p>
							Roneo bar y restaurante está en la calle Porvera, 9, 11403 Jerez de la Frontera (Cádiz).
							Restaurante andaluz que se presenta como un local para disfrutones.
						</p>
						<p>
							Lo que más citan sus clientes: arroz de chuleta, puntillitas y croquetas de puchero, además de
							ensaladilla de gambas y ensalada de tomate estupendas, con buen servicio y camareros amables.
						</p>
						<p class="about-note">
							Sobre el horario: la ficha de Google Maps marca lunes cerrado y domingo solo mediodía (12:30–16:30).
							De martes a sábado abre mediodía y noche (desde las 12:15/12:30 hasta las 16:30 y de 20:15 a 23:30).
							Si vienes en festivo, llama antes.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="especialidades">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su carta</p>
						<h2>Lo que más<br />se pide <em>en la mesa.</em></h2>
					</div>
					<p>
						Platos citados en las reseñas de sus clientes. La carta cambia, así que confirma disponibilidad al
						reservar.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>Roneo<br /><em>por dentro.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Roneo bar y restaurante. En la ficha
							encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="avif"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres
					el titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C. Porvera, 9</p>
					<h2>Ven a ronear<br /><em>a Jerez.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes</th>
								<td>Cerrado</td>
							</tr>
							<tr>
								<th scope="row">Martes, miércoles y sábado</th>
								<td>12:30 – 16:30 · 20:15 – 23:30</td>
							</tr>
							<tr>
								<th scope="row">Jueves y viernes</th>
								<td>12:15 – 16:30 · 20:15 – 23:30</td>
							</tr>
							<tr>
								<th scope="row">Domingo</th>
								<td>12:30 – 16:30</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, llama antes de
						venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>
							Llamar 856 66 77 57
						</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 856 66 77 57</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Roneo bar y restaurante en la calle Porvera, 9, Jerez de la Frontera"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Roneo · Jerez
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">R</span>
				<p>Roneo bar y restaurante<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Roneo bar y restaurante · Jerez de la Frontera. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>

			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar a Roneo <span>856 66 77 57</span></a>
		<nav class="legal-links" aria-label="Información legal">
