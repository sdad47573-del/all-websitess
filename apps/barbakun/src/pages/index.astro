---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/barbakun-fachada.jpg';
import pizza from '../assets/fotos/barbakun-pizza.jpg';
import hamburguesa from '../assets/fotos/barbakun-hamburguesa.jpg';
import fritos from '../assets/fotos/barbakun-fritos.jpg';
import patatas from '../assets/fotos/barbakun-patatas-asadas.jpg';
import comedor from '../assets/fotos/barbakun-comedor.jpg';
import rellenas from '../assets/fotos/barbakun-patatas-rellenas.jpg';
import noche from '../assets/fotos/barbakun-fachada-noche.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Barbakun · Pizzas, hamburguesas y reparto en Escaldes-Engordany';
const description =
	'Barbakun, Av. Fiter i Rossell, 38 (AD700 Escaldes-Engordany). Pizzas al horno, hamburguesas, fritos y parrilla, con reparto a domicilio. 4,4 sobre 5 con 43 reseñas. Martes a domingo de 13:00 a 15:30 y de 19:30 a 23:00; lunes cerrado.';

const galeria = [
	{
		src: pizza,
		alt: 'Pizza entera en su caja, con jamón, carne picada, maíz y queso fundido',
	},
	{
		src: hamburguesa,
		alt: 'Hamburguesa en pan de sésamo envuelta en papel de cuadros rojos y blancos',
	},
	{
		src: fritos,
		alt: 'Bandeja de acero con empanadillas recién fritas',
	},
	{
		src: patatas,
		alt: 'Bandeja de patatas asadas en tandas, doradas y con sal',
	},
	{
		src: rellenas,
		alt: 'Bandeja de patatas rellenas fritas, doradas por fuera',
	},
	{
		src: comedor,
		alt: 'Comedor de Barbakun con mesa de madera, vitrina de bebidas y barra',
	},
	{
		src: noche,
		alt: 'Fachada de Barbakun de noche, con el rótulo iluminado en la avenida',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que se sirve en Barbakun',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#barbakun`,
	name: BUSINESS.name,
	alternateName: ['Barbakun Escaldes', 'Barbakun Andorra'],
	description:
		'Pizzas al horno, hamburguesas, fritos y parrilla en Escaldes-Engordany, con reparto a domicilio y servicio en mesa.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376727726',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pizza', 'Hamburguesas', 'Parrilla'],
	hasDelivery: true,
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Escaldes-Engordany' },
		{ '@type': 'City', name: 'Andorra la Vella' },
		{ '@type': 'AdministrativeArea', name: 'Andorra' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '19:30',
			closes: '23:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#171310" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Rubik:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Barbakun Andorra, pizza Escaldes-Engordany, hamburguesas Andorra, comida a domicilio Escaldes, Fiter i Rossell 38, reparto pizza Andorra"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pizzas al horno, hamburguesas, fritos y parrilla en Escaldes-Engordany, con reparto a domicilio. 4,4 en Google con 43 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Hamburguesa de Barbakun envuelta en papel de cuadros"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#171310"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-08"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Barbakun"
			subtitle="Pizzas y parrilla · Escaldes"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. Fiter i Rossell, 38 · Escaldes-Engordany"
				title="Pizza, hamburguesa <br /><em>y brasa.</em>"
				lede={`Barbakun es el local de la Avenida Fiter i Rossell, en Escaldes-Engordany, con el rótulo rojo en la puerta y la pizarra del día en la acera. Pizzas al horno, hamburguesas, fritos y parrilla, con servicio en mesa y reparto a domicilio. Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas. Abre de martes a domingo de 13:00 a 15:30 y de 19:30 a 23:00.`}
				image={fachada}
				imageAlt="Fachada de Barbakun con el rótulo negro y rojo y la pizarra del día"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>13:00–15:30</b> · y 19:30–23:00' },
					{ label: 'Servicio', html: '<b>A domicilio</b> · y en el local' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Pizza & grill"
			/>

			<LocalChips label="Lo que ofrece Barbakun" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Fiter i Rossell, 38. <br /><em>Pizza y brasa.</em>"
				paragraphs={[
					'Barbakun está en el número 38 de la Avenida Fiter i Rossell, la calle principal de Escaldes-Engordany. La ficha de Google lo sitúa en las coordenadas 42.5137845, 1.5337382. El teléfono es un fijo andorrano, el +376 727 726.',
					'La fachada es de piedra, con el rótulo negro de BARBAKUN letra a letra en amarillo, el marco rojo de la puerta y una pizarra en la acera que anuncia el plato del día. Dentro hay barra, vitrina de bebidas y una sala con mesas y sillas de madera junto a la parrilla.',
					'La cocina es de horno y plancha: pizza redonda con la masa fina que sale en caja, hamburguesas en pan de sésamo con la carne a la parrilla, y una parte de fritos con empanadillas, croquetas y patatas —asadas en tandas o rellenas y pasadas por la freidora— para picar mientras se espera.',
					`Google lo clasifica como «Comida a domicilio», así que el reparto por teléfono es parte del negocio, además del servicio en mesa. Con ${RATING.count} reseñas y una media de ${RATING.label} sobre 5 (noviembre de 2026), es una ficha pequeña, de barrio, sin web propia.`,
				]}
				note="La ficha no publica carta ni precios, y en el perfil no aparece la carta impresa. Los platos que se citan son los que se ven en las fotos y en la pizarra de la puerta; los nombres y los importes se confirman en el local."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> La cocina</p>
					<h2 id="highlights-title">Horno, plancha <br /><em>y freidora.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Pizzas, hamburguesas <br /><em>y fritos.</em>"
				description="Una selección de lo que aparece en las fotos del perfil y en la pizarra, en cuatro bloques. No es la carta completa: cambia con el día y no está publicada."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note={`Para pedir a domicilio o preguntar por la carta del día, el teléfono es el ${BUSINESS.phone}. Los precios no se copian aquí porque la ficha no los publica.`}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La pizza, la hamburguesa <br /><em>y el local.</em>"
				description="Siete fotografías del perfil de Barbakun: la pizza en su caja, la hamburguesa envuelta en papel de cuadros, las empanadillas recién fritas, las patatas asadas, las patatas rellenas, el comedor con la vitrina y la fachada de noche."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,4 sobre 5, <em>con 43 reseñas.</em></h2>
						<p>
							Una ficha pequeña, de barrio: 43 opiniones son pocas para sacar conclusiones firmes,
							pero suficientes para saber que el reparto y las pizzas funcionan. Google lo clasifica
							como comida a domicilio.
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver las reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,4</strong>
						<span>★★★★☆</span>
						<small>43 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la avenida <br /><em>de Escaldes.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Principado de Andorra',
				]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de 13:00 a 15:30 y de 19:30 a 23:00 de martes a domingo, con el lunes cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Barbakun en la Avenida Fiter i Rossell, Escaldes-Engordany"
				mapEmbedUrl={MAPS.embed}
				mapLabel={`${BUSINESS.street} · Escaldes-Engordany`}
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote={`Los pedidos y el reparto se gestionan por teléfono, en el ${BUSINESS.phone}: el local no tiene web propia ni pedidos online. La ficha no da datos de aparcamiento ni de accesibilidad, así que conviene preguntarlos en la misma llamada.`}
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma carta, precios y horario antes de pedir."
			ctaLabel="Llamar a Barbakun"
			navAriaLabel="Enlaces de Barbakun"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
