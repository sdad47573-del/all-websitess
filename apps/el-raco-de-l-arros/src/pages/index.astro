---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import paella from '../assets/fotos/el-raco-de-l-arros-apaisada-05.jpg';
import comedor from '../assets/fotos/el-raco-de-l-arros-apaisada-02.jpg';
import gambas from '../assets/fotos/el-raco-de-l-arros-apaisada-03.jpg';
import calamares from '../assets/fotos/el-raco-de-l-arros-apaisada-10.jpg';
import fachadaNoche from '../assets/fotos/el-raco-de-l-arros-vertical-04.jpg';
import senoret from '../assets/fotos/el-raco-de-l-arros-vertical-06.jpg';
import negro from '../assets/fotos/el-raco-de-l-arros-vertical-07.jpg';
import bogavante from '../assets/fotos/el-raco-de-l-arros-vertical-08.jpg';
import ensalada from '../assets/fotos/el-raco-de-l-arros-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = "El Racó de l'Arròs · Arroces y paellas en Moraira";
const description =
	"El Racó de l'Arròs, Av. Madrid, 3 (03724 Moraira, Alicante). Arroces y paellas de cocina valenciana y mediterránea, con terraza. 4,5 sobre 5 con 1.194 reseñas. Martes cerrado.";

const galeria = [
	{
		src: paella,
		alt: 'Paellera de arroz amarillo con trozos de pollo, judía verde y limón, en la mesa',
	},
	{
		src: fachadaNoche,
		alt: "La fachada azul de El Racó de l'Arròs al anochecer, con el toldo, la terraza y la puerta de madera",
	},
	{
		src: comedor,
		alt: "El comedor de El Racó de l'Arròs con azulejos verdes en la pared, manteles blancos y sillas de asiento azul",
	},
	{
		src: senoret,
		alt: 'Paella de pollo y judía verde en la paellera, con gajos de limón y la cuchara de servir',
	},
	{
		src: negro,
		alt: 'Arroz negro con sepia y gambas en la paellera, con dos gajos de limón',
	},
	{
		src: bogavante,
		alt: 'Arroz caldoso con medio bogavante en la cazuela, con el caparazón rojo asomando',
	},
	{
		src: gambas,
		alt: 'Gambas al ajillo en cazuela de barro con el aceite y el perejil',
	},
	{
		src: calamares,
		alt: 'Calamares a la romana rebozados, con limón y una rama de perejil',
	},
	{
		src: ensalada,
		alt: 'Ensalada mixta en fuente de cristal con atún, huevo, aceitunas, zanahoria y tomate',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: "Lo que se ve en las mesas de El Racó de l'Arròs",
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-raco-de-l-arros`,
	name: BUSINESS.name,
	alternateName: ["El Racó de l'Arròs Moraira", 'El Raco de l Arros', 'Racó de l’Arròs'],
	description:
		'Arroces y paellas de cocina valenciana y mediterránea en la Avenida de Madrid, 3 (03724 Moraira, Alicante), con terraza en la acera y comedor de mantel blanco.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34965744372',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Valenciana', 'Mediterránea', 'Española', 'Arroces'],
	areaServed: [
		{ '@type': 'City', name: 'Teulada' },
		{ '@type': 'Place', name: 'Moraira' },
		{ '@type': 'AdministrativeArea', name: 'Marina Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday', 'Friday', 'Saturday'],
			opens: '19:00',
			closes: '22:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Los arroces', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f3b34" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Marcellus&family=Mulish:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Racó de l'Arròs, arroces Moraira, paella Moraira, restaurante Moraira, cocina valenciana Moraira, arroz negro Moraira, Avenida de Madrid Moraira, Teulada Moraira"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Arroces y paellas de cocina valenciana en la Avenida de Madrid, 3 (Moraira), con terraza en la acera. Mediodía de miércoles a domingo, con cenas jueves, viernes y sábado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Paella de pollo y judía verde en la paellera de El Racó de l'Arròs, en Moraira"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1f3b34"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[paella]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Racó de l'Arròs"
			subtitle="Arroces · Moraira"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. Madrid, 3 · Moraira (Alicante)"
				title="Arroz y paella, <br /><em>en Moraira.</em>"
				lede={`El Racó de l'Arròs es el restaurante de arroces de la Avenida de Madrid, en Moraira: paelleras que llegan a la mesa con pollo y judía verde, arroz negro o bogavante, y entrantes de marisco para empezar. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas. Mediodía de miércoles a domingo y cenas de jueves a sábado; martes cerrado.`}
				image={paella}
				imageAlt="Paellera de arroz amarillo con pollo y judía verde en El Racó de l'Arròs, Moraira"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Mediodía', html: '<b>13:00–15:30</b> · martes cerrado' },
					{ label: 'Cocina', html: '<b>Valenciana</b> · arroces' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Arroces en paellera"
			/>

			<LocalChips label="Lo que ofrece El Racó de l'Arròs" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Avenida de Madrid. <br /><em>La paella y la terraza.</em>"
				paragraphs={[
					"El Racó de l'Arròs está en la Avenida de Madrid, 3, en Moraira, en la Marina Alta. La ficha de Google sitúa el restaurante en las coordenadas 38.6874808, 0.133785, a pocos minutos del puerto y de la playa. La fachada es azul, con un toldo de lona color crema en el que se lee «Racó de l'Arròs» y, encima, el rótulo de «Restaurante El Racó de l'Arròs» enmarcado en forja.",
					"Delante de la puerta hay mesas en la acera, con sillas de rejilla oscura y mantel blanco, y una sombrilla cerrada junto al escaparate. Dentro, el comedor mantiene los azulejos verdes y blancos de la pared, las sillas de madera con asiento azul y el mantel blanco con las copas puestas. Es un restaurante de mantel y servicio en mesa, no de barra.",
					'La ficha lo clasifica como restaurante mediterráneo, de cocina española y de cocina valenciana. En las fotos del perfil aparecen una paella de pollo con judía verde, un arroz negro con sepia y gambas, un arroz caldoso con bogavante, gambas al ajillo en cazuela de barro, calamares a la romana y una ensalada mixta con atún y huevo.',
					`Las reseñas que se ven en Google hablan del trato y del arroz: «excelente trato, muy rico arroz y unos mejillones al vapor sabrosos», «buena comida: entrantes pulpo, clochinas y calamares». Con ${RATING.count} opiniones, la media es de ${RATING.label} sobre 5 (noviembre de 2026). El teléfono de la ficha es el ${BUSINESS.phone}.`,
				]}
				note="La ficha no publica carta, precios ni web propia. Lo que aparece en esta página es lo que dice la ficha y lo que se reconoce en las fotos del perfil; para saber el arroz del día, el precio del bogavante o si hay mesa en la terraza, hay que llamar al restaurante."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> En la paellera</p>
					<h2 id="highlights-title">Arroz, marisco <br /><em>y sobremesa.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Lo que se ve <br /><em>en las mesas.</em>"
				description="Sin carta publicada: esta lista reúne los platos que se reconocen en las fotos del perfil de Google y los que citan las reseñas. No hay precios en la ficha, así que aquí tampoco."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note={`El arroz del día, el precio del bogavante y el menú se preguntan por teléfono, en el ${BUSINESS.phone}. Los arroces van por comensales y se hacen al momento, así que conviene reservar y preguntar el tiempo de espera.`}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La terraza, la paella <br /><em>y el comedor.</em>"
				description="Nueve fotografías del perfil de El Racó de l'Arròs: la paellera en la mesa, la fachada azul al anochecer con la terraza, el comedor de azulejos verdes, la paella de pollo y judía verde, el arroz negro, el arroz con bogavante, las gambas al ajillo, los calamares a la romana y la ensalada mixta."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,5 sobre 5, <em>con 1.194 reseñas.</em></h2>
						<p>
							Google publica una media de 4,5 con 1.194 opiniones (noviembre de 2026). Entre las
							reseñas que se ven en la ficha, las hay que elogian el trato, el arroz, el pollo de
							la paella, los mejillones al vapor y los entrantes de pulpo y clochinas.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,5</strong>
						<span>★★★★☆</span>
						<small>1.194 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Moraira, <br /><em>Avenida de Madrid.</em>"
				addressLines={[BUSINESS.street, BUSINESS.city, `${BUSINESS.postalCode} ${BUSINESS.city} (Alicante)`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: mediodía de 13:00 a 15:30 de miércoles a domingo y el lunes; cenas de 19:00 a 22:00 jueves, viernes y sábado; martes cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de El Racó de l'Arròs en la Avenida de Madrid, Moraira"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Av. Madrid, 3 · Moraira"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote={`Las mesas se piden por teléfono, en el ${BUSINESS.phone}: el restaurante no tiene web propia ni reservas online. La ficha marca acceso para sillas de ruedas y aseo adaptado. En verano, Moraira se llena: llama con tiempo si quieres comer o cenar en fin de semana.`}
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>reservar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma platos, precios y horario antes de ir."
			ctaLabel="Llamar a El Racó de l'Arròs"
			navAriaLabel="Enlaces de El Racó de l'Arròs"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
