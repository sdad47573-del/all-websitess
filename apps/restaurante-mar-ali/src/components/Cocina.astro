---
import { BUSINESS, PLATOS, VENTAJAS } from '../data/site';
---

<section id="cocina" class="bg-primary relative overflow-hidden py-20 text-white sm:py-24">
	<div class="absolute inset-0 opacity-25" aria-hidden="true">
		<div class="abanico-mar-ali h-full w-full"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
			<div>
				<p class="text-accent text-xs font-semibold tracking-[0.22em] uppercase">La cocina</p>
				<h2 class="font-display mt-3 text-3xl leading-tight font-bold sm:text-4xl">
					Lo que más se pide en Mar Ali
				</h2>
				<p class="mt-4 max-w-xl leading-relaxed text-white/70">
					Platos filipinos, chinos y asiáticos que sus clientes nombran en las reseñas. La carta
					completa y el menú se consultan en el local.
				</p>
			</div>
			<a href={BUSINESS.phoneHref} class="btn btn-accent shrink-0 gap-2 rounded-full">
				<i class="ri-phone-line"></i> Reservar mesa
			</a>
		</div>

		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				PLATOS.map((plato, index) => (
					<article class="text-base-content border-base-300 relative flex flex-col rounded-lg border bg-base-100 p-6">
						<div class="flex items-start justify-between gap-4">
							<h3 class="font-display text-xl font-bold">{plato.title}</h3>
							<span class="font-display text-primary/25 text-3xl leading-none font-bold">
								{String(index + 1).padStart(2, '0')}
							</span>
						</div>
						<p class="text-base-content/65 mt-2 flex-1 text-sm leading-relaxed">{plato.text}</p>
						<span class="text-primary mt-5 inline-flex size-9 items-center justify-center rounded-full bg-primary/10">
							<i class={`${plato.icon} text-lg`} />
						</span>
					</article>
				))
			}
		</div>

		<div class="relative mt-6 grid gap-6 rounded-lg border border-white/15 bg-white/5 px-6 py-7 sm:px-8 lg:grid-cols-[1fr_auto] lg:items-center">
			<div>
				<h3 class="font-display text-xl font-bold sm:text-2xl">Carta y precios, en el local</h3>
				<p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/65">
					Esta web no publica importes sin confirmar. La carta, el menú y la disponibilidad se
					consultan en el restaurante o llamando al {BUSINESS.phone}.
				</p>
			</div>
			<div class="flex flex-wrap gap-2">
				{
					VENTAJAS.map((v) => (
						<span class="badge gap-1.5 rounded-full border-white/20 bg-white/10 px-3 py-3 text-xs text-white">
							<i class={`${v.icon} text-accent`} /> {v.title}
						</span>
					))
				}
			</div>
		</div>
	</div>
</section>
