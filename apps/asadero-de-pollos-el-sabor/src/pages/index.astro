---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import polloHero from '../assets/fotos/asadero-de-pollos-el-sabor-apaisada-04.jpg';
import comedor from '../assets/fotos/asadero-de-pollos-el-sabor-apaisada-01.jpg';
import guisado from '../assets/fotos/asadero-de-pollos-el-sabor-apaisada-05.jpg';
import pulpo from '../assets/fotos/asadero-de-pollos-el-sabor-apaisada-08.jpg';
import asador from '../assets/fotos/asadero-de-pollos-el-sabor-vertical-07.jpg';
import croquetas from '../assets/fotos/asadero-de-pollos-el-sabor-vertical-06.jpg';
import arroz from '../assets/fotos/asadero-de-pollos-el-sabor-vertical-09.jpg';
import tostas from '../assets/fotos/asadero-de-pollos-el-sabor-vertical-10.jpg';
import polloAsador from '../assets/fotos/asadero-de-pollos-el-sabor-vista-3-03.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Asadero de pollos El Sabor · Pollo asado para llevar en Murcia';
const description =
	'Asadero de pollos El Sabor, Calle Mayor, 5 (30165 Rincón de Seca, Murcia). Pollos asados, croquetas de pollo, arroz para llevar y tartas caseras. De martes a domingo, con cenas viernes y sábado.';

const galeria = [
	{
		src: comedor,
		alt: 'El comedor del asadero con mesas de tablero negro, sillas de madera y pilares de ladrillo',
	},
	{
		src: asador,
		alt: 'El asador lleno de pollos dorados en sus brochetas, hilera tras hilera',
	},
	{
		src: croquetas,
		alt: 'Bandeja de croquetas de pollo asado recién hechas, con perejil por encima',
	},
	{
		src: polloAsador,
		alt: 'Un pollo asado dorado girando en la brocheta del asador',
	},
	{
		src: guisado,
		alt: 'Bandeja de pollo guisado con pimientos verdes en salsa de tomate',
	},
	{
		src: arroz,
		alt: 'Tarrinas de aluminio con arroz con pollo y chorizo listas para llevar',
	},
	{
		src: pulpo,
		alt: 'Bandeja de pulpo cocido con su aceite y pimentón en el mostrador',
	},
	{
		src: tostas,
		alt: 'Tostas de queso fresco con pepino y tomate cherry sobre pan tostado',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que sale del asadero El Sabor',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-sabor`,
	name: BUSINESS.fullName,
	alternateName: ['El Sabor', 'Asadero El Sabor', 'Asadero de pollos El Sabor Murcia'],
	description:
		'Asadero de pollos y comidas para llevar en la Calle Mayor, 5 (30165 Rincón de Seca, Murcia): pollos asados, croquetas, arroz para llevar, bocatas y tartas caseras.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34968260938',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Comida para llevar', 'Tapas', 'Bocatas'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Murcia' },
		{ '@type': 'AdministrativeArea', name: 'Región de Murcia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday'],
			opens: '09:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '09:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '20:30',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '10:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '20:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '10:00',
			closes: '17:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El asadero', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#8c2f16" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;700&family=Bitter:ital,wght@0,400..700;1,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asadero de pollos El Sabor, pollo asado Murcia, Rincón de Seca, comida para llevar Murcia, croquetas de pollo asado, tartas caseras Murcia, Calle Mayor 5"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollos asados, croquetas, arroz para llevar y tartas caseras en la Calle Mayor, 5 de Rincón de Seca (Murcia). De martes a domingo."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Un pollo asado dorado, recién salido del asador de El Sabor"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#8c2f16"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[polloHero]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Sabor"
			subtitle="Asadero de pollos · Murcia"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Calle Mayor, 5 · Rincón de Seca (Murcia)"
				title="Pollo asado, <br /><em>recién salido del asador.</em>"
				lede={`El Sabor es el asadero de la Calle Mayor, en Rincón de Seca: pollos que giran en el asador hasta dorarse y se van en su bolsa de papel, croquetas hechas con ese mismo pollo, arroz para llevar y tartas caseras de postre. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas, y abre de martes a domingo, con cenas los viernes y los sábados.`}
				image={polloHero}
				imageAlt="Un pollo asado entero, dorado y brillante, sobre la bandeja metálica recién sacado del asador"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>Martes a domingo</b> · lunes cerrado' },
					{ label: 'Servicio', html: '<b>Para llevar</b> · y comedor' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Asadero de pollos"
			/>

			<LocalChips label="Lo que ofrece el asadero El Sabor" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Calle Mayor, 5. <br /><em>El asador y el comedor.</em>"
				paragraphs={[
					'El Sabor está en la Calle Mayor, 5, en Rincón de Seca, a las afueras de Murcia. La ficha de Google lo sitúa en las coordenadas 37.9775182, -1.1656915. Es un local de barrio con dos mitades: el mostrador donde se despachan los pollos y el comedor donde se come, con mesas de tablero negro, sillas de madera y pilares de ladrillo vista.',
					'En las fotos del perfil se ve el asador cargado de brochetas, con los pollos alineados en filas y el dorado desigual de los que llevan más tiempo girando. También aparecen las bandejas del mostrador: croquetas de pollo asado espolvoreadas de perejil, pollo guisado con pimientos verdes en salsa, pulpo cocido, tarrinas de arroz con pollo y chorizo listas para llevar y tostas de queso fresco con pepino y tomate cherry.',
					'La ficha lo describe con muchas etiquetas: restaurante especializado en pollo, pollería, restaurante de comida para llevar, bocatería, hamburguesería, bar y restaurante de tapas. Todo eso cabe en un mismo local de pedanía, donde se pasa del pollo asado al bocata y del bocata a la tapa sin cambiar de mostrador.',
					`Las reseñas repiten dos cosas: que el pollo sale muy bueno y que las tartas caseras merecen el viaje. Con ${RATING.count} opiniones, la media es de ${RATING.label} sobre 5 (noviembre de 2026). Abre de martes a jueves de 9:00 a 15:00, viernes y sábado también por la noche y el domingo de 10:00 a 17:00; el lunes descansa. Se atiende en el ${BUSINESS.phone}.`,
				]}
				note="La ficha no publica carta ni precios. Lo que aparece en esta página es lo que dicen las categorías de Google, lo que cuentan las reseñas y los platos que se reconocen en las fotos del perfil; confirma disponibilidad, precios y encargos por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Del asador al táper</p>
					<h2 id="highlights-title">Pollo, croquetas <br /><em>y algo dulce.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="El asadero"
				title="Lo que sale <br /><em>del mostrador.</em>"
				description="Sin carta publicada: esta lista reúne lo que dicen las categorías de la ficha de Google (pollería, bocatería, tapas), lo que citan las reseñas (croquetas y tartas caseras) y los platos que se reconocen en las fotos del perfil."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note={`Sin precios publicados: ni la ficha ni las fotos los dejan claros. Llama al ${BUSINESS.phone} para saber cuánto cuesta el pollo, si quedan croquetas o si hay tarta el día que vas.`}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El asador, el comedor <br /><em>y el mostrador.</em>"
				description="Ocho fotografías del perfil de El Sabor: el comedor con sus mesas y pilares de ladrillo, el asador lleno de pollos, las croquetas de pollo asado, el pollo guisado con pimientos, las tarrinas de arroz para llevar, el pulpo y las tostas del mostrador."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,8 sobre 5, <em>con 212 reseñas.</em></h2>
						<p>
							Google publica una media de 4,8 con 212 opiniones (noviembre de 2026). Las reseñas
							que se ven en la ficha hablan del pollo, del trato y de las tartas caseras, y alguna
							se queda con las croquetas de pollo asado.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span>
											<small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,8</strong>
						<span>★★★★★</span>
						<small>212 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En Rincón de Seca, <br /><em>al sur de Murcia.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: martes a jueves de 9:00 a 15:00; viernes de 9:00 a 15:00 y de 20:30 a 23:00; sábado de 10:00 a 16:00 y de 20:00 a 23:00; domingo de 10:00 a 17:00; lunes cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa del asadero El Sabor en la Calle Mayor, 5, Rincón de Seca"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Calle Mayor, 5 · Rincón de Seca"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Los pedidos se hacen por teléfono o en el propio mostrador: la ficha no enlaza una web del local ni un sistema de pedidos online, y tampoco anuncia reparto a domicilio. Si vas a por varios pollos o una tarta entera, llama antes y reserva."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>ir a por el pollo.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Asadero de pollos El Sabor"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district} (${BUSINESS.city})`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma platos, precios y horario antes de ir."
			ctaLabel="Llamar a El Sabor"
			navAriaLabel="Enlaces de El Sabor"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
