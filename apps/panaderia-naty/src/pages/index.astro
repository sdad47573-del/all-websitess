---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import mostrador from '../assets/fotos/panaderia-naty-apaisada-01.jpg';
import estanterias from '../assets/fotos/panaderia-naty-apaisada-02.jpg';
import expositores from '../assets/fotos/panaderia-naty-vertical-04.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería Naty · Poniente Norte, Córdoba';
const description =
	'Panadería Naty, en la calle Centro de Salud (Poniente Norte, 14005 Córdoba). Mostrador de chucherías, snacks y chocolates, y panadería. Abierta todos los días desde las 7:30.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#naty`,
	name: BUSINESS.name,
	alternateName: ['Naty', 'Panadería Naty Córdoba'],
	description:
		'Panadería y tienda de chucherías en Poniente Norte (14005 Córdoba), con mostrador de golosinas, snacks y chocolates.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34633070694',
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '07:30',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '07:30',
			closes: '18:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: estanterias,
		alt: 'Estanterías de Panadería Naty con bolsas de snacks, aperitivos y chocolates',
	},
	{
		src: expositores,
		alt: 'Expositores de chocolates y golosinas en el mostrador de Panadería Naty',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#5c2a3d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400..700;1,400..600&family=Source+Sans+3:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Naty, panadería Córdoba, chucherías Córdoba, Poniente Norte, calle Centro de Salud, 14005"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Mostrador de chucherías, snacks y chocolates, y panadería, en la calle Centro de Salud (14005 Córdoba). Abierta todos los días desde las 7:30. 4,8 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Mostrador de chucherías y golosinas de Panadería Naty"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#5c2a3d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[mostrador]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Panadería · Chucherías"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Poniente Norte · 14005 Córdoba"
				title="Panadería <br /><em>y mostrador de chucherías.</em>"
				lede={`Panadería Naty está en la calle Centro de Salud, en Poniente Norte. La ficha de Google la clasifica como panadería, pero las fotos de su perfil enseñan sobre todo el mostrador: tarros de golosinas, expositores de chucherías y estanterías de snacks y chocolates. Abre todos los días desde las 7:30, con cierre a las 21:00 de lunes a sábado y a las 18:00 los domingos. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={mostrador}
				imageAlt="Mostrador de Panadería Naty con tarros y cajas de golosinas de colores y estanterías de chucherías"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,8</b> en Google · 12 reseñas' },
					{ label: 'Horario', html: '<b>L–S</b> 7:30–21:00 · <b>D</b> 7:30–18:00' },
					{ label: 'Zona', html: '<b>Poniente Norte</b> · 14005' },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Chucherías · snacks · panadería"
			/>

			<LocalChips label="Lo que hay en Naty" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una tienda <br /><em>de barrio.</em>"
				paragraphs={[
					'Panadería Naty está en la calle Centro de Salud, en Poniente Norte (14005 Córdoba). La ficha de Google la clasifica como panadería y publica su teléfono, pero no el número de la calle: el mapa de esta página abre el punto exacto.',
					'Las fotos del perfil enseñan el local por dentro: un mostrador corrido con tarros y cajas de golosinas de colores, expositores de chuches y estanterías con bolsas de snacks, aperitivos y chocolates. También hay vitrina y cajas de dulces junto al mostrador.',
					'La jornada es amplia y no cierra a mediodía: de lunes a sábado abre de 7:30 a 21:00, y los domingos de 7:30 a 18:00. Es de las pocas del barrio que abre todos los días.',
					'La ficha no publica web propia, redes, carta ni precios, así que aquí no encontrarás importes. Los carteles de las fotos llevan precios, pero cambian.',
				]}
				note="La ficha de Google no publica el número de la calle ni fotos de pan: las imágenes del perfil corresponden al mostrador de chucherías y a las estanterías de snacks y chocolates. Esta página solo recoge lo que aparece en la ficha y en esas fotos."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Llamar al 633 07 06 94', href: BUSINESS.phoneHref },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Mostrador, <br />
							<em>snacks y barrio.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que hay <br /><em>en la tienda.</em>"
				description="Sin carta ni precios publicados: esto es lo que muestran las fotos del perfil y lo que dice la ficha de Google."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={MENU_GROUPS}
				note="La ficha no publica precios ni métodos de pago, así que esta web no indica importes. Las fotos del perfil son del mostrador de chucherías y de las estanterías, no del pan."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La tienda, <br /><em>por dentro.</em>"
				description="Dos fotos de la ficha de Google Maps: las estanterías de snacks y los expositores de chocolates."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la calle <br /><em>Centro de Salud.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de Panadería Naty en la calle Centro de Salud, Córdoba"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Panadería Naty · Poniente Norte"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
				]}
				contactLink={{ label: 'Abrir en Google Maps ↗', href: MAPS.place, external: true }}
				reserveNote="El teléfono de la ficha es el 633 07 06 94. No publica web propia ni redes. Indica acceso para sillas de ruedas y que no hay aparcamiento adaptado; no informa sobre el mostrador ni el aseo. La ficha no publica el número de la calle, así que usa el mapa para llegar."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Ver en Google Maps"
			navAriaLabel="Enlaces de Panadería Naty"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
