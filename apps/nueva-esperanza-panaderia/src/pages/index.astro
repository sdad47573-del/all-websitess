---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/nueva-esperanza-panaderia-apaisada-01.jpg';
import cafe from '../assets/fotos/nueva-esperanza-panaderia-apaisada-02.jpg';
import pastel from '../assets/fotos/nueva-esperanza-panaderia-vertical-03.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Nueva Esperanza · Panadería y confitería en Málaga';
const description =
	'Nueva Esperanza, panadería y confitería en C. Magistrado Salvador Barbera, 5 (Nueva Málaga, 29010 Málaga). Pan de obrador, dulces, bollería y empanadas. Encargos por WhatsApp. Teléfono 662 47 27 68.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#nueva-esperanza`,
	name: BUSINESS.name,
	alternateName: [
		'Panadería Nueva Esperanza',
		'Panadería y Confitería Nueva Esperanza',
		'Nueva Esperanza Málaga',
	],
	description:
		'Panadería y confitería en C. Magistrado Salvador Barbera, 5, local 3 (Nueva Málaga, 29010 Málaga). Pan de obrador, dulces, bollería, empanadas y café, con encargos por WhatsApp y reparto en Uber Eats.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, MAPS.instagram, MAPS.ubereats],
	telephone: '+34662472768',
	servesCuisine: ['Panadería', 'Confitería', 'Empanadas'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '07:00',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Friday',
			opens: '07:30',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '08:00',
			closes: '20:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de la panadería Nueva Esperanza con el rótulo verde y naranja y la pizarra de panes en la puerta',
	},
	{
		src: pastel,
		alt: 'Pastel de varias capas con crema, galleta Lotus y huevos de chocolate sobre una bandeja dorada',
	},
	{
		src: cafe,
		alt: 'Café con leche con cacao espolvoreado y una tarta de merengue al limón sobre una mesa de cristal',
	},
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"nueva-esperanza-panaderia-apaisada-02.jpg": cafe,
	"nueva-esperanza-panaderia-apaisada-01.jpg": fachada,
	"nueva-esperanza-panaderia-vertical-03.jpg": pastel,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f5d3f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Nunito+Sans:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Nueva Esperanza panadería, panadería Málaga, confitería Nueva Málaga, pan sin gluten Málaga, empanadas Málaga, Magistrado Salvador Barbera, 29010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan de obrador, dulces, bollería y empanadas en Nueva Málaga. Pan sin gluten en la pizarra y encargos por WhatsApp. 4,1 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Café y tarta de merengue de Nueva Esperanza, panadería en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2f5d3f"
			phone="+34662472768"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[cafe]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Nueva Esperanza"
			subtitle="Panadería · Confitería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Uber Eats ↗', href: MAPS.ubereats, external: true },
				{ label: 'Instagram ↗', href: MAPS.instagram, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps y precios de la carta de Uber Eats, consultados en octubre de 2026. Horario, surtido y precios pueden cambiar; confirma antes de pedir."
			ctaLabel="Llamar a Nueva Esperanza"
			navAriaLabel="Enlaces de la panadería Nueva Esperanza"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
