---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/nueva-esperanza-panaderia-apaisada-01.jpg';
import cafe from '../assets/fotos/nueva-esperanza-panaderia-apaisada-02.jpg';
import pastel from '../assets/fotos/nueva-esperanza-panaderia-vertical-03.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Nueva Esperanza · Panadería y confitería en Málaga';
const description =
	'Nueva Esperanza, panadería y confitería en C. Magistrado Salvador Barbera, 5 (Nueva Málaga, 29010 Málaga). Pan de obrador, dulces, bollería y empanadas. Encargos por WhatsApp. Teléfono 662 47 27 68.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#nueva-esperanza`,
	name: BUSINESS.name,
	alternateName: [
		'Panadería Nueva Esperanza',
		'Panadería y Confitería Nueva Esperanza',
		'Nueva Esperanza Málaga',
	],
	description:
		'Panadería y confitería en C. Magistrado Salvador Barbera, 5, local 3 (Nueva Málaga, 29010 Málaga). Pan de obrador, dulces, bollería, empanadas y café, con encargos por WhatsApp y reparto en Uber Eats.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, MAPS.instagram, MAPS.ubereats],
	telephone: '+34662472768',
	servesCuisine: ['Panadería', 'Confitería', 'Empanadas'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '07:00',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Friday',
			opens: '07:30',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '08:00',
			closes: '20:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de la panadería Nueva Esperanza con el rótulo verde y naranja y la pizarra de panes en la puerta',
	},
	{
		src: pastel,
		alt: 'Pastel de varias capas con crema, galleta Lotus y huevos de chocolate sobre una bandeja dorada',
	},
	{
		src: cafe,
		alt: 'Café con leche con cacao espolvoreado y una tarta de merengue al limón sobre una mesa de cristal',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f5d3f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Nunito+Sans:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Nueva Esperanza panadería, panadería Málaga, confitería Nueva Málaga, pan sin gluten Málaga, empanadas Málaga, Magistrado Salvador Barbera, 29010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan de obrador, dulces, bollería y empanadas en Nueva Málaga. Pan sin gluten en la pizarra y encargos por WhatsApp. 4,1 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Café y tarta de merengue de Nueva Esperanza, panadería en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2f5d3f"
			phone="+34662472768"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[cafe]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Nueva Esperanza"
			subtitle="Panadería · Confitería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Magistrado Salvador Barbera, 5 · Nueva Málaga"
				title="Pan de barrio, <br /><em>dulces de obrador.</em>"
				lede={`Nueva Esperanza está en la calle Magistrado Salvador Barbera, 5, local 3, en Nueva Málaga. Es una panadería y confitería de barrio que elabora pan, dulces y bollería desde 1988. En la pizarra de la puerta anuncia pan de soja, olívica y sin gluten, y la carta de reparto suma empanadas, bollería y café. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={cafe}
				imageAlt="Café con leche con cacao espolvoreado y una tarta de merengue al limón sobre una mesa de cristal"
				primaryCta={{ label: `WhatsApp · ${BUSINESS.phone}`, href: BUSINESS.whatsapp }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,1</b> en Google · 23 reseñas' },
					{ label: 'Horario', html: '<b>7:00–21:00</b> de lunes a jueves' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b>` },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Pan · dulces · empanadas"
			/>

			<LocalChips label="Lo que hay en la panadería" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una panadería <br /><em>de toda la vida.</em>"
				paragraphs={[
					'La panadería Nueva Esperanza está en la calle Magistrado Salvador Barbera, 5, local 3, en plena Nueva Málaga. El rótulo verde y naranja de la fachada anuncia «Panadería - Confitería», y en la pizarra de la puerta se lee «Tenemos pan: soja, olívica, sin gluten».',
					'La casa elabora pan, dulces y bollería desde 1988. En su carta de reparto figuran panes como la malagueña, el cateto, el integral, el de centeno o el bollo, además de empanadas de jamón y queso, chorizo, cebolla, pollo o criolla, y bollería como el croissant, la caña y la napolitana.',
					'En las fotos del perfil aparece la parte de cafetería y pastelería: un café con leche con cacao y una tarta de merengue al limón, y un pastel de varias capas con crema y galleta Lotus. La ficha de Google la clasifica además como restaurante de comida rápida y comida a domicilio.',
					'Además de la tienda, la casa anuncia dulces caseros para eventos y encargos por WhatsApp, y reparte a través de Uber Eats. La ficha no publica página web propia ni métodos de pago: para encargar algo, lo más directo es el 662 47 27 68.',
				]}
				note="4,1 sobre 5 con 23 reseñas en Google. La ficha no publica una carta propia de tienda: los precios de esta web son los de la carta de Uber Eats."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Instagram de la casa', href: MAPS.instagram, external: true },
					{ label: `WhatsApp · ${BUSINESS.phone}`, href: BUSINESS.whatsapp, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Pan, vitrina <br />
							<em>y encargos.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Lo que hay <br /><em>en el mostrador.</em>"
				description="La carta de reparto de la casa en Uber Eats: pan de obrador, empanadas y bollería. Los precios son los de esa plataforma."
				cta={{ label: `WhatsApp · ${BUSINESS.phone}`, href: BUSINESS.whatsapp }}
				groups={MENU_GROUPS}
				note="Precios del menú de Uber Eats del establecimiento, consultado en octubre de 2026. En tienda pueden ser distintos y el surtido cambia a lo largo del día. Para encargos, llama o escribe al 662 47 27 68."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La casa, <br /><em>de cerca.</em>"
				description="Tres fotos de la ficha de Google Maps: la fachada con la pizarra de panes, un pastel de crema y galleta Lotus y un café con tarta de merengue."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Nueva Málaga, <br /><em>local 3.</em>"
				addressLines={[
					BUSINESS.street,
					BUSINESS.district,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
				]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de la panadería Nueva Esperanza en la calle Magistrado Salvador Barbera, 5, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Nueva Esperanza · Nueva Málaga"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Pedir en Uber Eats', href: MAPS.ubereats, external: true },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
				]}
				contactLink={{
					label: `WhatsApp · ${BUSINESS.phone}`,
					href: BUSINESS.whatsapp,
					external: true,
				}}
				reserveNote="La ficha indica que el local tiene acceso para sillas de ruedas y aseo adaptado, pero no asientos adaptados. No publica información sobre el mostrador. El reparto se hace a través de Uber Eats."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Uber Eats ↗', href: MAPS.ubereats, external: true },
				{ label: 'Instagram ↗', href: MAPS.instagram, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps y precios de la carta de Uber Eats, consultados en octubre de 2026. Horario, surtido y precios pueden cambiar; confirma antes de pedir."
			ctaLabel="Llamar a Nueva Esperanza"
			navAriaLabel="Enlaces de la panadería Nueva Esperanza"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
