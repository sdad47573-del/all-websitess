---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/nueva-esperanza-panaderia-fachada.jpg';
import merienda from '../assets/fotos/nueva-esperanza-panaderia-apaisada-02.jpg';
import tartaNata from '../assets/fotos/nueva-esperanza-panaderia-vertical-03.jpg';
import tartaCumple from '../assets/fotos/nueva-esperanza-panaderia-apaisada-04.jpg';
import bollosCacao from '../assets/fotos/nueva-esperanza-panaderia-vertical-05.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const title = 'Nueva Esperanza · Panadería en Málaga';
const description =
	'Panadería Nueva Esperanza, en la calle Magistrado Salvador Barberá, 5 (Bailén-Miraflores, 29010 Málaga). Pan artesanal, pan cateto, empanadas y dulces. Teléfono 662 47 27 68.';

const galeria = [
	{
		src: merienda,
		alt: 'Café con nata y una tartaleta de merengue sobre la mesa de la panadería',
	},
	{
		src: tartaNata,
		alt: 'Tarta de nata y galleta con chocolate servida en una bandeja dorada',
	},
	{
		src: tartaCumple,
		alt: 'Tarta de cumpleaños decorada con animales de la selva y el número 30',
	},
	{
		src: bollosCacao,
		alt: 'Bollos de cacao envasados en la panadería, apilados en una caja',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#nueva-esperanza`,
	name: BUSINESS.fullName,
	alternateName: [
		'Nueva Esperanza',
		'Panadería Nueva Esperanza Málaga',
		'Confitería Nueva Esperanza',
	],
	description:
		'Panadería y confitería en la calle Magistrado Salvador Barberá, 5, local 3 (Bailén-Miraflores, 29010 Málaga). Pan artesanal y pan cateto, empanadas caseras, dulces tradicionales y café.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 662 47 27 68',
	currenciesAccepted: 'EUR',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '07:00',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Friday',
			opens: '07:30',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '08:00',
			closes: '20:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0d1f16" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&family=Albert+Sans:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Panadería Nueva Esperanza Málaga, panadería Bailén-Miraflores, pan cateto Málaga, empanadas caseras Málaga, confitería Nueva Málaga, Magistrado Salvador Barberá, panadería 29010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan artesanal y pan cateto, empanadas caseras, dulces tradicionales y café en la calle Magistrado Salvador Barberá, 5, en Bailén-Miraflores (Málaga)."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo verde iluminado de la panadería Nueva Esperanza en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#0d1f16"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Nueva Esperanza"
			subtitle="Panadería · Confitería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<div class="band band-night">
				<LocalHero
					eyebrow="C. Magistrado Salvador Barberá, 5 · Bailén-Miraflores"
					title="Pan recién hecho, <br /><em>cada mañana.</em>"
					lede={`Nueva Esperanza es la panadería de la calle Magistrado Salvador Barberá, 5, en Bailén-Miraflores. Pan artesanal —con su pan cateto—, empanadas caseras, dulces tradicionales y café para desayunar o merendar. Tiene ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 en Google con ${BUSINESS.reviewsCount} reseñas.`}
					image={fachada}
					imageAlt="Fachada de la panadería Nueva Esperanza con el rótulo verde iluminado y el escaparate abierto"
					primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
					facts={[
						{ label: 'Nota', html: '<b>4,1</b> en Google · 23 reseñas' },
						{ label: 'Horario', html: '<b>7:00–21:00</b> de lunes a jueves' },
						{ label: 'Barrio', html: '<b>Bailén-Miraflores</b>, Málaga' },
					]}
					galleryHref={MAPS.place}
					photoCredit="Foto del perfil de Google Maps"
					galleryLinkLabel="Ver la galería"
					tag="Abierta todos los días"
				/>

				<div class="signstrip wrap" aria-hidden="true">
					<span class="signstrip-rule"></span>
					<span class="signplate">
						<span class="signplate-top">Panadería · Confitería</span>
						<span class="signplate-name">Nueva Esperanza</span>
					</span>
					<span class="signstrip-rule"></span>
				</div>
			</div>

			<div class="band band-cream">
				<LocalChips label="Lo que ofrece la panadería Nueva Esperanza" items={SERVICIOS} />

				<LocalAbout
					label="La casa"
					title="Una panadería <br /><em>de las de siempre.</em>"
					paragraphs={[
						'El local está en el número 5 de la calle Magistrado Salvador Barberá, en Bailén-Miraflores, con un rótulo verde iluminado que se ve desde la acera. Google la clasifica como panadería y confitería.',
						'El propio establecimiento describe así su obrador: pan artesanal horneado cada día, «nuestro famoso pan cateto», dulces tradicionales y «unas empanadas que ya son favoritas del barrio». En las fotos del perfil se ven el mostrador, la vitrina de dulces y una mesa para tomar café.',
						'La ficha indica acceso para sillas de ruedas y aseo adaptado, pero no asientos adaptados. El teléfono es el 662 47 27 68 y no consta web propia.',
						'Esta página no publica carta ni precios: la ficha de Google no los recoge. Lo que se cuenta aquí sale de la ficha pública del establecimiento y de las fotografías de su perfil.',
					]}
					note="4,1 sobre 5 con 23 reseñas en Google. Una de ellas: «Panes muy bien elaborados y super ricos los recomiendo»."
					links={[
						{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
						{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					]}
				/>
			</div>

			<div class="band band-sand">
				<LocalMenu
					eyebrow="El mostrador"
					title="Pan, dulces <br /><em>y empanadas.</em>"
					description="La ficha de Google no publica carta ni precios. Estos son los productos que citan la descripción del establecimiento, las reseñas y las fotografías del perfil."
					cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					groups={MENU}
					note="Sin precios publicados: la panadería no tiene web ni carta online en su ficha. Para saber qué hay cada día —y a qué precio—, lo mejor es llamar al 662 47 27 68 o pasarse por el mostrador."
				/>
			</div>

			<div class="band band-night">
				<LocalGallery
					eyebrow="Fotos del perfil de Google Maps"
					title="La merienda, <br /><em>las tartas y el pan.</em>"
					description="Cuatro fotografías del perfil de Nueva Esperanza en Google Maps: el café con su tartaleta, las tartas de la vitrina y los bollos de cacao del mostrador."
					images={galeria}
					cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
					note="Imágenes alojadas en esta página y procedentes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
				/>
			</div>

			<div class="band band-cream">
				<LocalVisit
					eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
					title="En la acera <br /><em>de Nueva Málaga.</em>"
					addressLines={[
						BUSINESS.street,
						BUSINESS.district,
						`${BUSINESS.postalCode} ${BUSINESS.city}`,
					]}
					hours={HOURS}
					hoursCaption="Horario"
					hoursNote="Horario publicado en la ficha de Google. Abre todos los días, pero en festivos puede cambiar: la propia ficha ya avisa de ello para el 1 de noviembre, así que conviene llamar antes."
					mapTitle="Mapa de la panadería Nueva Esperanza en la calle Magistrado Salvador Barberá, 5, Málaga"
					mapEmbedUrl={MAPS.embed}
					mapLabel="Nueva Esperanza · Bailén-Miraflores"
					mapHref={MAPS.place}
					links={[
						{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref, variant: 'primary' },
						{ label: 'Cómo llegar', href: MAPS.directions, external: true },
						{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					]}
					contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					reserveNote="No hay web propia ni pedidos online: se atiende en el mostrador y por teléfono. Acceso para sillas de ruedas y aseo adaptado; la ficha no indica asientos adaptados."
				/>
			</div>

			<div class="band band-sand">
				<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pasar.</em>" />
			</div>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Nueva Esperanza"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos y fotografías de la ficha pública de Google Maps. Sin carta ni precios publicados por el establecimiento."
			ctaLabel="Llamar a Nueva Esperanza"
			navAriaLabel="Enlaces de la panadería Nueva Esperanza"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
