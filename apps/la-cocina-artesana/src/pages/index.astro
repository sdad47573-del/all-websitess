---
import '../styles/global.css';
import {
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/la-cocina-artesana-apaisada-01.jpg';
import clams from '../assets/fotos/la-cocina-artesana-apaisada-02.jpg';
import bandejas from '../assets/fotos/la-cocina-artesana-apaisada-03.jpg';
import pescado from '../assets/fotos/la-cocina-artesana-apaisada-05.jpg';
import gratinado from '../assets/fotos/la-cocina-artesana-apaisada-06.jpg';
import ensaladilla from '../assets/fotos/la-cocina-artesana-apaisada-08.jpg';
import pimientos from '../assets/fotos/la-cocina-artesana-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
} from '../data/site';

const galeria = [
	{ src: clams, alt: 'Espaguetis con almejas en una bandeja blanca' },
	{ src: bandejas, alt: 'Bandejas de pasta, verduras, arroz y albóndigas en el mostrador' },
	{ src: pescado, alt: 'Pescado al horno con limón, pimiento y patata' },
	{ src: gratinado, alt: 'Pasta gratinada con taquitos de jamón y queso' },
	{ src: ensaladilla, alt: 'Ensaladilla con atún, huevo y pimiento' },
	{ src: pimientos, alt: 'Pimientos rellenos gratinados al horno' },
];

const title = 'La Cocina Artesana · Comida para llevar en Altorreal';
const description = `La Cocina Artesana, en Avenida Reino de Murcia, Bajo 3 A (30506 Altorreal, Molina de Segura, Murcia). ${RATING.label} sobre 5 en Google Maps con ${RATING.count} reseñas.`;

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'La cocina', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-cocina-artesana-apaisada-01.jpg": fachada,
	"la-cocina-artesana-apaisada-02.jpg": clams,
	"la-cocina-artesana-apaisada-03.jpg": bandejas,
	"la-cocina-artesana-apaisada-05.jpg": pescado,
	"la-cocina-artesana-apaisada-06.jpg": gratinado,
	"la-cocina-artesana-apaisada-08.jpg": ensaladilla,
	"la-cocina-artesana-apaisada-10.jpg": pimientos,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1d5c3f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400..700;1,400&family=Assistant:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Cocina Artesana, comida para llevar Altorreal, Molina de Segura, comida casera Murcia"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription={description}
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La Cocina Artesana en Altorreal"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1d5c3f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.city}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Cocina Artesana"
			subtitle="Comida para llevar · Altorreal"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos y fotografías de la ficha pública de Google Maps, consultada el 31 de octubre de 2026. Confirma platos y horario antes de la visita."
			ctaLabel="Llamar a La Cocina Artesana"
			navAriaLabel="Enlaces de La Cocina Artesana"
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
