---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/destello-fachada-terraza-pirandello.jpg';
import fachada from '../assets/fotos/destello-fachada-exterior-pirandello.jpg';
import vitrina from '../assets/fotos/destello-vitrina-reposteria-malaga.jpg';
import mostrador from '../assets/fotos/destello-mostrador-vitrina-interior.jpg';
import tartaQueso from '../assets/fotos/destello-tarta-queso-pistacho-malaga.jpg';
import tartaChocolate from '../assets/fotos/destello-tarta-chocolate-malaga.jpg';
import postres from '../assets/fotos/destello-pasteles-crema-malaga.jpg';
import croissant from '../assets/fotos/destello-croissant-chocolate-malaga.jpg';
