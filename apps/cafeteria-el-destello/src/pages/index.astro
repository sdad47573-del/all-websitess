import cafe from '../assets/fotos/destello-cafe-con-leche-malaga.jpg';
import batidoGofre from '../assets/fotos/destello-batido-gofre-malaga.jpg';
import batidoChocolate from '../assets/fotos/destello-batido-chocolate-gofre-malaga.jpg';
import copas from '../assets/fotos/destello-copas-brindis-teatinos.jpg';
import refresco from '../assets/fotos/destello-refresco-naranja-teatinos.jpg';
import zumos from '../assets/fotos/destello-zumos-frutales-malaga.jpg';
import barra from '../assets/fotos/destello-barra-interior-teatinos.jpg';
import sala from '../assets/fotos/destello-sala-interior-malaga.jpg';
import interiorClientes from '../assets/fotos/destello-interior-vitrina-clientes.jpg';

const business = {
	name: 'Cafetería El Destello',
	tagline: 'Cafetería con tartas caseras y tapes en Teatinos',
	street: 'C. Pirandello, 4',
	district: 'Teatinos-Universidad',
	city: 'Málaga',
	postalCode: '29010',
	phone: '677 16 53 76',
	latitude: 36.7175804,
	longitude: -4.4620663,
	rating: 4.6,
	reviewsCount: 167,
	site: 'https://cafeteria-el-destello.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd72f740fedbef9d:0xfea09befdeba7d2d';
const cidDecimal = '18347836336443653421';
const placeId = 'ChIJne_b_kD3cg0RLX263u-boP4';

const mapsUrl = `https://www.google.com/maps/place/?q=place_id:${placeId}&hl=es`;
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34677165376';

const description =
	'Cafetería El Destello en C. Pirandello, 4 (Teatinos, Málaga). Tartas caseras, gofres, café, copas y tapes para pasar la tarde. Abierto de martes a domingo hasta las 2:00. 4,6 en Google. Tel. 677 16 53 76.';

const servicios = [
	'Tartas caseras',
	'Gofres',
	'Café de especialidad',
	'Copas y cócteles',
	'Tapas y picoteo',
	'Comida para llevar',
	'Zumos naturales',
	'Pastelería propia',
	'Desayunos y meriendas',
	'Bocadillos y tostadas',
	'Terraza en la calle',
	'Local climatizado',
	'Servicio hasta las 2:00',
	'Barrio de Teatinos',
];

const grupos = [
	{
		title: 'Repostería y tartas',
		items: [
			{ name: 'Tarta de queso', note: 'la más recomendada de la carta, en varias versiones' },
			{ name: 'Tartas caseras', note: 'elaboradas en el local, con bizcocho esponjoso' },
			{ name: 'Tarta de chocolate', note: 'con capa de chocolate y bizcocho de cacao' },
			{ name: 'Pasteles de crema', note: 'tradicionales, rebozados y de crema' },
			{ name: 'Croissant de chocolate', note: 'recién hecho, de chocolate fundido' },
		],
	},
	{
		title: 'Cafetería y merienda',
		items: [
			{ name: 'Café y café con leche', note: 'servido en taza, con leche o con nata' },
			{ name: 'Gofres', note: 'dulces y salados, con todo tipo de toppings' },{ name: 'Batidos', note: 'de chocolate, fresa y otros sabores' },
			{ name: 'Zumos naturales', note: 'naranja y frutas de temporada' },
			{ name: 'Merienda para llevar', note: 'para el campus o para casa' },
		],
	},
	{
		title: 'Tardeo y tapes',
		items: [
			{ name: 'Cañas y cervezas', note: 'con tapa incluida en la consumición' },
			{ name: 'Copas y cócteles', note: 'vinos y combinados para la tarde' },
			{ name: 'Tapas y picoteo', note: 'platos combinados para compartir' },
			{ name: 'Bocadillos y tostadas', note: 'el clásico recurso entre horas de clase' },
			{ name: 'Comida para llevar', note: 'encarga y recoge en el mostrador' },
		],
	},
];

const galeria = [
	{
		src: fachada,
		alt: 'Entrada de Cafetería El Destello con velero en la calle Pirandello, Teatinos, Málaga',
	},
	{
		src: vitrina,
		alt: 'Vitrina de postres y tartas de Cafetería El Destello en Teatinos, Málaga',
	},
	{
		src: tartaQueso,
		alt: 'Tarta de queso casera de Cafetería El Destello, cafetería en Teatinos, Málaga',
	},
	{
		src: tartaChocolate,
		alt: 'Tarta de chocolate de Cafetería El Destello, pastelería en Teatinos, Málaga',
	},
	{
		src: postres,
		alt: 'Pasteles de crema y rebozados de Cafetería El Destello, Teatinos, Málaga',
	},
	{
		src: croissant,
		alt: 'Croissant relleno de chocolate de Cafetería El Destello, cafetería en Málaga',
	},
	{
		src: tradicional,
		alt: 'Postre tradicional servido en Cafetería El Destello, Teatinos, Málaga',
	},
	{
		src: cafe,
		alt: 'Café con leche servido en Cafetería El Destello, cafetería en Teatinos, Málaga',
	},
	{
		src: batidoGofre,
		alt: 'Batido con topping en Cafetería El Destello, cafetería en Teatinos, Málaga',
	},
	{
		src: batidoChocolate,
		alt: 'Batido de chocolate con chocolate y topping en Cafetería El Destello, Teatinos, Málaga',
	},
	{
		src: copas,
		alt: 'Copas de cóctel en Cafetería El Destello, bar y cafetería en Teatinos, Málaga',
	},
	{
		src: refresco,
		alt: 'Refresco con rodajas de naranja en Cafetería El Destello, Teatinos, Málaga',
	},
	{
		src: zumos,
		alt: 'Zumos naturales de fruta en Cafetería El Destello, cafetería en Teatinos, Málaga',
	},
	{
		src: sandwich,
		alt: 'Tostada con tomate y pavo en Cafetería El Destello, cafetería en Teatinos, Málaga',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo con papas en Cafetería El Destello, cafetería en Teatinos, Málaga',
	},
	{
		src: bocadilloBlanco,
		alt: 'Bocadillo de pan blanco relleno en Cafetería El Destello, Teatinos, Málaga',
	},
	{
		src: mesaPequenos,
		alt: 'Clientes merendando en la terraza de Cafetería El Destello, Teatinos, Málaga',
	},
	{
		src: mostrador,
		alt: 'Mostrador y vitrina de Cafetería El Destello en Teatinos, Málaga',
	},
	{
		src: interiorClientes,
		alt: 'Interior de Cafetería El Destello con clientes en Teatinos-Universidad, Málaga',
	},
];

const faqs = [
	{
		q: '¿Dónde está Cafetería El Destello?',
		a: 'En la calle Pirandello, 4, en el barrio de Teatinos-Universidad (29010 Málaga), a pocos metros de la Universidad. Tiene terraza en la propia acera, así que se puede tomar algo en la calle con buen tiempo.',
	},
	{
		q: '¿Cuál es el horario de Cafetería El Destello?',
		a: 'Abre de martes a domingo, de 12:00 a 2:00 de la madrugada. Los lunes está cerrado. Es un local de tardeo, así que por la noche cierra tarde: si vienes a cenar o a tomar copas, llegar antes de medianoche es buena idea.',
	},
	{
		q: '¿Qué se come en Cafetería El Destello?',
		a: 'Su especialidad son las tartas caseras, y dentro de ellas la tarta de queso, que aparece recomendada en casi todas las reseñas. También hay gofres, batidos, café, bocadillos, tostadas, zumos naturales y un surtido de pastelería propia elaboration diaria.',
	},
	{
		q: '¿Sirven cervezas y copas por la tarde?',
		a: 'Sí. Es una cafetería que también funciona como bar de tapes: hay cañas, cervezas, copas y cócteles para pasar la tarde o la noche. Además sirven picoteo para acompañar. Por eso muchas personas vienen también después de clase o de trabajar.',
	},
	{
		q: '¿Puedo pedir para llevar o comer aquí?',
		a: 'Sí, hay servicio de comida para llevar: se puede encargar en el mostrador y recoger en el local. También es habitual pedir tartas o postres para casa o para compartir con unos amigos.',
	},
	{
		q: '¿Cómo son las reseñas en Google?',
		a: 'La nota media es de 4,6 sobre 167 reseñas. Lo que más se repite es la calidad de las tartas, el trato cercano de los camareros y el ambiente acogedor del local. También se menciona la limpieza y la buena carta de cafés y chocolates.',
	},
	{q: '¿Es un local adecuado para estudiantes?',
		a: 'Sí. Está en pleno barrio universitario de Teatinos, a poca distancia de los edificios de la Universidad, y es un sitio conocido para merendar, estudiar y para el tardeo. Cuenta con terraza en la calle y con sala en el interior.',
	},
	{
		q: '¿Hay terraza o se puede fumar fuera?',
		a: 'Tiene mesas en la terraza de la calle Pirandello, donde puedes tomar el café, el vermut o las cervezas al aire libre. En días de calor es la opción más apreciada del local.',
	},
	{
		q: '¿Cómo puedo contactar con Cafetería El Destello?',a: 'Por teléfono en el 677 16 53 76, o a través de Google Maps desde esta misma web. El teléfono es la vía más rápida para confirmar carta, encargos y horarios en festivos.',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': ['CafeOrCoffeeShop', 'Bar', 'Bakery'],
	'@id': `${business.site}/#negocio`,
	name: business.name,
	alternateName: ['El Destello', 'Cafetería El Destello Málaga', 'Destello Teatinos', 'El Destello Pirandello'],
	slogan: 'Tartas caseras y tapes en Teatinos',
	description,
	url: `${business.site}/`,
	telephone: '+34 677 16 53 76',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cafetería', 'Repostería', 'Tapas', 'Desayunos', 'Bocadillos'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	image: `${business.site}/og.jpg`,
	sameAs: [mapsUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday'],
			opens: '00:00',
			closes: '00:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '02:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza en la calle', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Tartas caseras', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Gofres y batidos', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Cañas y copas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Comida para llevar', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>El Destello · Cafetería y tartas caseras en Teatinos, Málaga</title>
		<meta name="theme-color" content="#7a2e3e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="cafetería Teatinos, El Destello Málaga, cafeteria Pirandello 4, tartas Teatinos, gofres Málaga, bar Teatinos, cafetería 29010 Málaga, tapes Teatinos, cafetería Universidad Málaga, tarta de queso Teatinos, café con leche Teatinos, terraza Pirandello, Cafetería El Destello"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Cafetería El Destello · Tartas caseras y cafetería en Teatinos, Málaga"
			ogDescription="Tartas caseras, gofres, café, cañas y copas en C. Pirandello, 4, Teatinos. Abierto de martes a domingo hasta las 2:00. 4,6 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Exterior de Cafetería El Destello con terraza en la calle Pirandello, Teatinos, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#7a2e3e"
			street={business.street}
			city={business.city}
			region="Andalucía"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Teatinos-Universidad, Málaga"
			contact={{
				street: business.street,
				locality: business.city,
				region: 'Andalucía',
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[heroImage]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://cafeteria-el-destello.vercel.app/og.jpg" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7175804;-4.4620663" />
		<meta name="ICBM" content="36.7175804, -4.4620663" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="D"
			name="El Destello"
			subtitle="Cafetería · Tapas"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Teatinos · Málaga"
				title="Tartas caseras<br /><em>y tapes de tarde.</em>"
				lede="Cafetería El Destello está en la calle Pirandello, 4, a pocos metros de la Universidad. Un sitio de cafetería y bar para pasar la tarde: tarta de queso casera, gofres, café, cañas, copas y picoteo. Abre de martes a domingo hasta las dos de la madrugada. 4,6 en Google."
				image={heroImage}
				imageAlt="Fachada y terraza de Cafetería El Destello en la calle Pirandello, Teatinos, Málaga"
				primaryCta={{ label: 'Llamar 677 16 53 76', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> en Google (167 reseñas)' },
					{ label: 'Horario', html: 'Martes a domingo, <b>12:00–2:00</b>' },
					{ label: 'Lunes', html: 'Cerrado' },
					{ label: 'Especialidad', html: 'Tarta de queso <b>casera</b> y gofres' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece El Destello" items={servicios} />

			<LocalAbout
				label="Cafetería y bar de tapes"
				title="Un sitio para<br /><em>quedarse un rato.</em>"
				paragraphs={[
					'El Destello ocupa el número 4 de la calle Pirandello, en pleno Teatinos-Universidad, a muy poca distancia de los edificios de la Universidad. Es una cafetería que también funciona como bar de tapes: por la mañana se toma el café, a mediodía se merienda y por la noche se queda cualquiera a tomar cañas y copas.',
					'Lo más conocido del local es la repostería. Las tartas son caseras y la estrella es la tarta de queso, que los clientes recomiendan en casi todas las reseñas y en distintas versiones. También hay tarta de chocolate, pasteles de crema, croissants y otros dulces elaborados en el propio obrador.',
					'La carta se completa con gofres, batidos, café, zumos naturales, bocadillos y tostadas. Y por la tarde entran las cañas, las cervezas, las copas y el picoteo para compartir, que es lo que da al local su ambiente de tardeo.',
					'El ambiente es informal y acogedor, con personal que trata a los clientes por su nombre y una terraza en la propia acera que se llena en cuanto sale el buen tiempo. Es un bar al que se viene a ver a quien está al lado.',
				]}
				note="La nota media en Google es de 4,6 sobre 167 reseñas. Lo más citado: la calidad de las tartas, el trato del personal y el ambiente del local. También destacan la carta de tés y chocolates y la limpieza del local."
				links={[{ label: 'Ficha y reseñas en Google', href: cidUrl, external: true }]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Tarta, café<br /><em>y algo de picar.</em>"
				description="Selección de lo que se sirve en El Destello, recogida de la ficha de Google Maps, de las reseñas y de las fotos del perfil. La carta cambia con frecuencia, así que confírmala en el local o por teléfono."
				cta={{ label: 'Llamar para preguntar', href: phoneHref }}
				groups={grupos}
				note="Los precios y la disponibilidad pueden variar. La repostería se elabora a diario, así que las tartas disponibles cambian según el día. Para encargos o para confirmar carta, llama al 677 16 53 76."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El local,<br /><em>la vitrina y la terraza.</em>"
				description="Estas fotografías proceden del perfil de Cafetería El Destello en Google Maps, con imágenes del local, de su vitrina y de clientes. En la ficha están todas las fotos y las reseñas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del local en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="C. Pirandello, 4 · 29010 Málaga"
				title="Nos vemos<br /><em>en Teatinos.</em>"
				addressLines={[
					business.street,
					business.district,
					`${business.postalCode} ${business.city}, España`,
				]}
				hours={[
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: '12:00–2:00' },
					{ day: 'Miércoles', value: '12:00–2:00' },
					{ day: 'Jueves', value: '12:00–2:00' },
					{ day: 'Viernes', value: '12:00–2:00' },
					{ day: 'Sábado', value: '12:00–2:00' },
					{ day: 'Domingo', value: '12:00–2:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google: abre de martes a domingo de 12:00 a 2:00 de la madrugada, y los lunes cerrado. Puede variar en festivos, así que llama antes si vienes de lejos."
				mapTitle="Mapa de Cafetería El Destello en la calle Pirandello, 4, Teatinos-Universidad, Málaga"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="El Destello · Teatinos"
				mapHref={cidUrl}
				links={[{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' }]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="No hay reserva en línea: es un local de sala y terraza por orden de llegada. Para encargos o para grupos, llama al 677 16 53 76."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="D"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
