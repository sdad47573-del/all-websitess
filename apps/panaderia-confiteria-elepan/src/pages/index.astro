---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import vitrina from '../assets/fotos/panaderia-confiteria-elepan-apaisada-04.jpg';
import tronco from '../assets/fotos/panaderia-confiteria-elepan-vertical-06.jpg';
import fachada from '../assets/fotos/panaderia-confiteria-elepan-apaisada-01.jpg';
import roscos from '../assets/fotos/panaderia-confiteria-elepan-apaisada-02.jpg';
import interior from '../assets/fotos/panaderia-confiteria-elepan-apaisada-05.jpg';
import troncosVitrina from '../assets/fotos/panaderia-confiteria-elepan-apaisada-08.jpg';
import despensa from '../assets/fotos/panaderia-confiteria-elepan-apaisada-09.jpg';
import fachadaArbol from '../assets/fotos/panaderia-confiteria-elepan-apaisada-10.jpg';
import tartaRectangular from '../assets/fotos/panaderia-confiteria-elepan-vertical-03.jpg';
import troncoChocolate from '../assets/fotos/panaderia-confiteria-elepan-vertical-07.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	MAPS,
	MENU,
	REVIEW_QUOTE,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'Elepan · Panadería y confitería en Palma-Palmilla, Málaga';
const description = BUSINESS.description;
const ratingLabel = BUSINESS.rating.toFixed(1).replace('.', ',');

const galeria = [
	{
		src: roscos,
		alt: 'Bandeja de seis roscos glaseados rellenos de nata y adornados con fruta confitada',
		caption: 'Roscos de nata y fruta confitada',
		tag: 'Vitrina',
	},
	{
		src: interior,
		alt: 'Interior del local decorado en Navidad, con estanterías de dulces, snacks y bebidas y la vitrina de pastelería en primer plano',
		caption: 'El interior, en Navidad',
		tag: 'Despensa',
	},
	{
		src: troncosVitrina,
		alt: 'Tres troncos de Navidad en la vitrina, con etiquetas de precio y adornos de Papá Noel',
		caption: 'Troncos de Navidad, en la vitrina',
		tag: 'Por encargo',
	},
	{
		src: despensa,
		alt: 'Estanterías con turrones, snacks, cajas de galletas, bebidas y un cartel de oferta de bollería',
		caption: 'Turrones y despensa, al fondo',
		tag: null,
	},
	{
		src: fachadaArbol,
		alt: 'Fachada del local bajo un árbol, con el rótulo rojo de Panadería Confitería Elepan y el toldo azul',
		caption: 'La fachada, desde la acera',
		tag: null,
	},
	{
		src: tartaRectangular,
		alt: 'Tarta rectangular con láminas de chocolate y nata, decorada con un Papá Noel y una placa de Felices Fiestas',
		caption: 'Una tarta de encargo, con Papá Noel',
		tag: null,
	},
	{
		src: troncoChocolate,
		alt: 'Tronco de Navidad de chocolate con nata, avellanas y adornos navideños sobre bandeja dorada',
		caption: 'Tronco de chocolate y nata',
		tag: null,
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#elepan`,
	name: BUSINESS.name,
	alternateName: ['Elepan', 'Panadería Elepan', 'Confitería Elepan Málaga'],
	description:
		'Panadería y confitería en C. la Defensa, 4 (Palma-Palmilla, 29011 Málaga): pan del día, dulces de vitrina, tartas por encargo y despensa de barrio.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 627 84 42 51',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '08:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '17:00',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday', 'Sunday'],
			opens: '08:00',
			closes: '15:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	makesOffer: [
		{ '@type': 'Offer', itemOffered: { '@type': 'Product', name: 'Pan del día' } },
		{
			'@type': 'Offer',
			itemOffered: { '@type': 'Product', name: 'Dulces de confitería' },
		},
		{
			'@type': 'Offer',
			itemOffered: { '@type': 'Product', name: 'Tartas por encargo' },
		},
		{
			'@type': 'Offer',
			itemOffered: { '@type': 'Product', name: 'Troncos de Navidad' },
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: REVIEW_QUOTE,
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#mostrador' },
	{ label: 'El escaparate', href: '#fotos' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#b3221f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,500;0,600;1,400&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Elepan, panadería Palma-Palmilla, confitería Málaga, tartas por encargo Málaga, pan del día La Defensa, troncos de Navidad Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería y confitería en C. la Defensa, 4, Palma-Palmilla. Pan del día, dulces de vitrina, tartas por encargo y despensa. Teléfono 627 84 42 51."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo rojo de Panadería Confitería Elepan sobre la fachada del local"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#b3221f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Panadería confitería Elepan, inicio">
					<span class="brand-mark" aria-hidden="true">
						elepan
					</span>
					<span class="brand-name">
						Panadería · Confitería
						<small>C. la Defensa, 4 · Palma-Palmilla</small>
					</span>
				</a>
				<nav class="nav" aria-label="Navegación principal">
					{nav.map((item) => (
						<a href={item.href}>{item.label}</a>
					))}
				</nav>
				<a class="topbar-phone" href={BUSINESS.phoneHref}>
					<span class="topbar-phone-label">Encargos</span> {BUSINESS.phone}
				</a>
			</div>
			<nav class="mobile-nav wrap" aria-label="Navegación principal en móvil">
				{nav.map((item) => (
					<a href={item.href}>{item.label}</a>
				))}
			</nav>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Palma-Palmilla · Málaga
						</p>
						<h1 id="hero-title">
							elepan
							<small>Panadería · Confitería · C. la Defensa, 4</small>
						</h1>
						<p class="hero-lede">
							Pan del día, vitrina de dulces y tartas por encargo en la calle la Defensa, 4. Además
							del horno y la confitería, el local guarda una despensa con turrones, snacks y bebidas
							para la compra de cada día.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={BUSINESS.phoneHref}>
								Encargar · {BUSINESS.phone}
							</a>
							<a
								class="button button-ghost"
								href={MAPS.directions}
								target="_blank"
								rel="noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<div class="hero-facts">
							<div>
								<span>Google</span>
								<strong>{ratingLabel} / 5</strong>
								<small>{BUSINESS.reviewsCount} reseñas</small>
							</div>
							<div>
								<span>Horario</span>
								<strong>8:00–20:30</strong>
								<small>de lunes a jueves</small>
							</div>
							<div>
								<span>La casa</span>
								<strong>Tartas</strong>
								<small>por encargo</small>
							</div>
						</div>
					</div>

					<div class="hero-collage">
						<figure class="hero-main">
							<Image
								src={vitrina}
								alt="Vitrina de la confitería con tartaletas de fruta, pasteles de nata, brazos de gitano y una tarta de chocolate"
								widths={[520, 760, 1030]}
								sizes="(max-width: 980px) 92vw, 44vw"
								format="avif"
								quality={74}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
							<figcaption>
								<span>Fotos del perfil de Google Maps</span>
								<a href={MAPS.place} target="_blank" rel="noreferrer">
									Ver la ficha ↗
								</a>
							</figcaption>
						</figure>
						<figure class="hero-inset">
							<Image
								src={tronco}
								alt="Tronco de Navidad con nata, chocolate y adornos de Papá Noel sobre bandeja dorada"
								widths={[220, 320, 460]}
								sizes="(max-width: 700px) 32vw, 15vw"
								format="avif"
								quality={72}
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<span class="tag tag-hero">Dulces de vitrina</span>
						<span class="tag tag-hero-2">Troncos de Navidad</span>
					</div>
				</div>
			</section>

			<section class="facts" aria-label="Datos de la ficha">
				<div class="wrap facts-grid">
					<div class="fact">
						<span class="fact-kicker">La ficha</span>
						<strong>{ratingLabel} / 5</strong>
						<p>{BUSINESS.reviewsCount} reseñas en Google.</p>
					</div>
					<div class="fact">
						<span class="fact-kicker">El teléfono</span>
						<strong>
							<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
						</strong>
						<p>Para tartas y encargos.</p>
					</div>
					<div class="fact">
						<span class="fact-kicker">El horario</span>
						<strong>8:00–20:30</strong>
						<p>Viernes, sábado y domingo solo por la mañana.</p>
					</div>
					<div class="fact">
						<span class="fact-kicker">El mostrador</span>
						<strong>Pan y dulce</strong>
						<p>Confitería y despensa de barrio.</p>
					</div>
				</div>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<div class="about-head">
					<p class="section-label">
						<span aria-hidden="true"></span> La casa
					</p>
					<h2 id="about-title">
						Un escaparate <em>de barrio.</em>
					</h2>
					<p>
						Elepan es panadería y confitería en la calle la Defensa, 4. El rótulo rojo, el toldo
						azul y los carteles de oferta pegados en el cristal son lo primero que se ve al llegar a
						la esquina.
					</p>
				</div>

				<div class="about-body">
					<figure class="about-photo">
						<Image
							src={fachada}
							alt="Escaparate de Elepan con el rótulo rojo, el toldo azul y carteles de ofertas de pan y bollería pegados en el cristal"
							widths={[520, 820, 1200]}
							sizes="(max-width: 980px) 92vw, 46vw"
							format="avif"
							quality={74}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>El escaparate, con las ofertas del día.</figcaption>
						<span class="tag tag-photo">Tartas por encargo</span>
					</figure>

					<div class="highlights-grid">
						{HIGHLIGHTS.map((item) => (
							<article class="highlight">
								<span class="highlight-number">{item.number}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>

				<div class="about-foot">
					<blockquote class="owner-quote">
						<p>«{REVIEW_QUOTE}»</p>
						<cite>Reseña de 5 estrellas en la ficha de Google</cite>
					</blockquote>
					<ul class="chips" aria-label="Lo que ofrece Elepan">
						{SERVICIOS.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>
			</section>

			<section class="counter" id="mostrador" aria-labelledby="counter-title">
				<div class="wrap">
					<div class="counter-head">
						<div>
							<p class="section-label section-label-light">
								<span aria-hidden="true"></span> El mostrador
							</p>
							<h2 id="counter-title">
								Del horno <em>a la despensa.</em>
							</h2>
						</div>
						<p>
							La ficha no publica carta ni precios. Esto es lo que aparece en las fotografías del
							perfil y lo que citan las reseñas del establecimiento.
						</p>
					</div>

					<div class="menu-grid">
						{MENU.map((group) => (
							<article class="menu-card">
								<span class="menu-kicker">{group.kicker}</span>
								<h3>{group.title}</h3>
								<ul>
									{group.items.map((item) => (
										<li>
											<strong>{item.name}</strong>
											<span>{item.note}</span>
										</li>
									))}
								</ul>
							</article>
						))}
					</div>

					<div class="counter-note">
						<p>
							<strong>Sin carta ni precios publicados.</strong> Para una tarta o una bandeja de
							dulces, llama al
							<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a> y pregunta por el encargo.
						</p>
						<a class="button button-light" href={BUSINESS.phoneHref}>
							Llamar a Elepan
						</a>
					</div>
				</div>
			</section>

			<section class="gallery wrap" id="fotos" aria-labelledby="gallery-title">
				<div class="gallery-head">
					<div>
						<p class="section-label">
							<span aria-hidden="true"></span> El escaparate
						</p>
						<h2 id="gallery-title">
							Lo que se ve <em>desde la calle.</em>
						</h2>
					</div>
					<p>
						Siete imágenes del perfil de Google Maps: la vitrina, el interior en Navidad, los
						troncos, la despensa, la fachada y dos tartas de encargo. Son fotos del establecimiento,
						no de un banco de imágenes.
					</p>
				</div>

				<div class="gallery-grid">
					{galeria.map((photo) => (
						<figure>
							<Image
								src={photo.src}
								alt={photo.alt}
								widths={[420, 640, 960, 1200]}
								sizes="(max-width: 700px) 92vw, 31vw"
								format="avif"
								quality={72}
								loading="lazy"
								decoding="async"
							/>
							{photo.tag && <span class="tag tag-gallery">{photo.tag}</span>}
							<figcaption>{photo.caption}</figcaption>
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes del perfil del establecimiento en Google Maps. Si eres titular de alguna y
					quieres retirarla, escríbenos y la borramos.
				</p>
			</section>

			<section class="reviews" aria-labelledby="reviews-title">
				<div class="wrap reviews-grid">
					<div class="reviews-score">
						<span class="score-number">{ratingLabel}</span>
						<span class="score-stars" role="img" aria-label="4,2 de 5 estrellas">
							★★★★☆
						</span>
						<span class="score-count">{BUSINESS.reviewsCount} reseñas en Google</span>
					</div>
					<div class="reviews-copy">
						<p class="section-label">
							<span aria-hidden="true"></span> Lo que dicen
						</p>
						<h2 id="reviews-title">
							«Pan fresquito <em>del día</em>»
						</h2>
						<div class="review-list">
							{REVIEWS.map((item) => (
								<figure>
									<blockquote>«{item.text}»</blockquote>
									<figcaption>{item.note}</figcaption>
								</figure>
							))}
						</div>
						<a class="reviews-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer las 65 reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label">
						<span aria-hidden="true"></span> Visítanos
					</p>
					<h2 id="visit-title">
						En la calle <em>la Defensa.</em>
					</h2>
					<p class="address">
						{BUSINESS.street}
						<br />
						{BUSINESS.district}
						<br />
						{BUSINESS.postalCode} {BUSINESS.city}
					</p>

					<table class="hours">
						<caption>Horario de la ficha de Google</caption>
						<tbody>
							{HOURS.map((row) => (
								<tr>
									<th scope="row">{row.day}</th>
									<td>{row.value}</td>
								</tr>
							))}
						</tbody>
					</table>
					<p class="hours-note">
						Horario publicado por el establecimiento en Google, consultado el 28 de octubre de 2026.
						En festivos puede cambiar: confirma antes de ir.
					</p>

					<div class="visit-phone">
						<span>Teléfono y encargos</span>
						<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
					</div>

					<div class="visit-links">
						<a class="button button-primary" href={BUSINESS.phoneHref}>
							Llamar ahora
						</a>
						<a class="button button-ghost" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<p class="visit-note">
						La ficha solo detalla que no hay aparcamiento adaptado; no indica si la entrada es
						accesible. No consta reparto a domicilio ni venta online.
					</p>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Panadería confitería Elepan en la calle la Defensa, 4, Palma-Palmilla, Málaga"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> La Defensa, 4
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label">
					<span aria-hidden="true"></span> Preguntas frecuentes
				</p>
				<h2 id="faq-title">
					Antes de <em>entrar.</em>
				</h2>
				<div class="faq-list">
					{FAQ.map((item) => (
						<details>
							<summary>{item.q}</summary>
							<p>{item.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">
							elepan
						</span>
