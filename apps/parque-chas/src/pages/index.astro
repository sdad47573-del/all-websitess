---
import '../styles/global.css';

const business = {
	name: 'Parque Chas Restaurante',
	street: 'Avenida Arias de Velasco, 43',
	district: 'Miraflores',
	city: 'Marbella',
	postalCode: '29601',
	phone: '633 02 44 18',
	latitude: 36.5175884,
	longitude: -4.8889801,
	site: 'https://parque-chas.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Parque+Chas+Restaurante/@36.5175884,-4.8889801,17z/data=!3m1!4b1!4m6!3m5!1s0xd72d99f5c478b7f:0x66f8ea5d1d61ee25!8m2!3d36.5175884!4d-4.8889801!16s%2Fg%2F11ysh2ld_2';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34633024418';
const instagramUrl = 'https://www.instagram.com/parquechasmarbella/';

const photos = {
	principal: '/fotos/parque-chas-marbella.jpg',
	ambiente: '/fotos/carne-parrilla-parque-chas.jpg',
};

const servicios = [
	'Carne argentina a la parrilla',
	'Pasta casera',
	'Pizza de masa madre',
	'Empanadas criollas',
	'Menú de mediodía',
	'Terraza',
	'Accesible para sillas de ruedas',
	'Pet friendly',
];

const carta = [
	{
		title: 'De la parrilla',
		intro: 'Carne argentina de verdad: tierna como la mantequilla.',
		platos: [
			{ nombre: 'Tira de asado', precio: '' },
			{ nombre: 'Cortes de carne argentina', precio: '' },
			{ nombre: 'Chorizos y morcilla', precio: '' },
		],
	},
	{
		title: 'Pasta y clásicos',
		intro: 'Recetas tradicionales hechas en casa, como en Buenos Aires.',
		platos: [
			{ nombre: 'Pasta casera', precio: '' },
			{ nombre: 'Ñoquis del 29', precio: '' },
			{ nombre: 'Milanesa napolitana', precio: '' },
		],
	},
	{
		title: 'Entrantes',
		intro: 'Para compartir al centro, o no compartir.',
		platos: [
			{ nombre: 'Empanadas criollas', precio: '' },
			{ nombre: 'Provoleta', precio: '' },
			{ nombre: 'Croquetas de cocido y morcilla', precio: '' },
		],
	},
	{
		title: 'Postres caseros',
		intro: 'Con dulce de leche hecho en casa. Lo mejor para muchos.',
		platos: [
			{ nombre: 'Flan casero con dulce de leche', precio: '' },
			{ nombre: 'Panqueques', precio: '' },
			{ nombre: 'Repostería artesanal', precio: '' },
		],
	},
];

const faqs = [
	{
		q: '¿Dónde está Parque Chas Restaurante?',
		a: 'En la avenida Arias de Velasco, 43, en el barrio de Miraflores de Marbella (29601), a unos minutos andando del centro y del casco antiguo. Es un barrio tranquilo, con más ambiente local que turístico.',
	},
	{
		q: '¿Qué tipo de restaurante es Parque Chas?',
		a: 'Un restaurante argentino de cocina casera: carne a la parrilla, tira de asado, pasta casera, pizzas de masa madre, empanadas criollas, milanesas y postres con dulce de leche hecho en casa. Todo elaborado con recetas tradicionales.',
	},
	{
		q: '¿Cuál es el horario del restaurante?',
		a: 'Abre de miércoles a domingo con horario partido: de 12:00 a 16:00 para comer y de 20:00 a 24:00 para cenar. Cierra los lunes y los martes.',
	},
	{
		q: '¿Hace falta reservar mesa?',
		a: 'Los fines de semana, sí: el local se llena y reservar es lo más práctico. Puedes hacerlo llamando al 633 02 44 18 o por Instagram en @parquechasmarbella.',
	},
	{
		q: '¿Es caro comer en Parque Chas?',
		a: 'No, es de los restaurantes más asequibles de su nivel en Marbella: raciones generosas, producto de primera y precios contenidos. Las reseñas destacan repetidamente su relación calidad-precio.',
	},
	{
		q: '¿Tienen opciones vegetarianas o para niños?',
		a: 'Sí: hay pizzas de masa madre, pastas, provoleta, croquetas y varios platos fuera de la parrilla. Es un restaurante familiar, con terraza y ambiente acogedor, apto para ir con niños.',
	},
	{
		q: '¿Se puede ir en coche y es accesible?',
		a: 'Sí. El local tiene acceso adaptado para personas con movilidad reducida y hay aparcamiento en la avenida y en las calles cercanas del barrio de Miraflores.',
	},
];

const description =
	'Restaurante argentino en Marbella: carne a la parrilla, pasta casera, empanadas criollas y dulce de leche hecho en casa en Av. Arias de Velasco, 43. Reservas: 633 02 44 18.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 633 02 44 18',
	image: [`${business.site}${photos.principal}`, `${business.site}${photos.ambiente}`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo, Tarjeta',
	servesCuisine: ['Argentina', 'Parrilla', 'Pasta casera', 'Pizza'],
	acceptsReservations: 'True',
	petsAllowed: true,
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [instagramUrl],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: '5',
		bestRating: '5',
		ratingCount: '62',
	},
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '00:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Admite mascotas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Pasta casera y postres artesanales', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1e3a5f" />
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="Parque Chas Marbella, restaurante argentino Marbella, parrilla argentina Marbella, carne argentina Marbella, tira de asado Marbella, pasta casera Marbella, empanadas criollas Marbella, restaurante Av Arias de Velasco, restaurante Miraflores Marbella, comer barato y bien Marbella"
		/>
		<meta name="author" content="Parque Chas Restaurante" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Outfit:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Parque Chas | Restaurante argentino y parrilla en Marbella</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Parque Chas · Carne argentina y pasta casera en Marbella" />
		<meta
			property="og:description"
			content="Parrilla argentina, pasta casera, empanadas criollas y dulce de leche hecho en casa en el barrio de Miraflores, Marbella."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.principal}`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="800" />
		<meta property="og:image:alt" content="Parque Chas, restaurante argentino de parrilla en Marbella" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Parque Chas · Restaurante argentino en Marbella" />
		<meta
			name="twitter:description"
			content="Carne a la parrilla, pasta casera y postres con dulce de leche en Av. Arias de Velasco, Marbella."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.principal}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Marbella" />
		<meta name="geo.position" content="36.5175884;-4.8889801" />
		<meta name="ICBM" content="36.5175884, -4.8889801" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Parque Chas Restaurante, inicio">
				<span class="brand-mark" aria-hidden="true">PC</span>
				<span class="brand-name">Parque Chas <small>Marbella · Miraflores</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">La carta</a>
				<a href="#ambiente">Ambiente</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>633 02 44 18</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Marbella · Barrio de Miraflores</p>
					<h1 id="hero-title">Carne argentina,<br />pasta casera<br /><em>y postres con dulce<br />de leche.</em></h1>
					<p class="hero-lede">
						Cocina argentina de recetas tradicionales en la avenida Arias de Velasco: la carne tierna
						que recomiendan las reseñas, pastas y masas hechas en casa y un trato de los que hacen que
						vuelvas. Una joya de barrio a dos pasos del centro de Marbella.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Reservar 633 02 44 18</a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<p class="hero-rating">
						<span class="star" aria-hidden="true">★</span>
						<strong>5,0</strong> de valoración media en la ficha de Google Maps
					</p>
					<ul class="hero-facts">
						<li>Miércoles a domingo, comidas y cenas</li>
						<li>Carne a la parrilla y tira de asado</li>
						<li>Pasta, pizza de masa madre y empanadas</li>
						<li>Terraza y menús de sugerencia</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img
						src={photos.principal}
						width="1200"
						height="800"
						alt="Fotografía de la comida del Parque Chas Restaurante publicada en su ficha de Google Maps"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Servicios del local">
				<ul class="chips">
					{servicios.map((servicio) => <li>{servicio}</li>)}
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> Un rincón de Buenos Aires</p>
				<div class="about-grid">
					<h2>Cocina casera<br />argentina<br /><em>en Marbella.</em></h2>
					<div class="about-copy">
						<p>
							Parque Chas toma su nombre de un barrio de Buenos Aires y lo pone en práctica en la
							avenida Arias de Velasco: cocina de casa, de recetas que se heredan. Marcelo y su equipo
							atenden mesa a mesa, recomiendan según lo que te apetezca y hacen que entrar sea como
							llegar a casa de un amigo argentino.
						</p>
						<p>
							En la mesa, carne argentina a la parrilla que las reseñas describen como «mantequilla de
							tierna», tira de asado, empanadas criollas, provoleta, croquetas de cocido y morcilla,
							milanesas napolitanas, pastas y pizzas de masa madre. Y de postre, dulce de leche
							casero: en el flan, en los panqueques y en el recuerdo de quien prueba.
						</p>
						<p class="about-note">
							Lo que más se repite en las reseñas públicas: todo es casero, las raciones son generosas
							y los precios, asequibles para ser Marbella. También avisan de que los fines de semana
							se llena: reserva antes de venir.
						</p>
						<div class="about-links">
							<a class="simple-link" href={mapsUrl} target="_blank" rel="noreferrer">
								Leer reseñas en Google <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">
								Instagram del local <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="menu section-pad" id="carta">
				<div class="menu-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De la parrilla a la sobremesa</p>
						<h2>Qué pedir<br />en <em>Parque Chas.</em></h2>
					</div>
					<p>
						Los platos que aparecen en la carta y en las reseñas públicas. No se publican precios:
						hay menús de sugerencia que cambian a diario y conviene preguntarlos al llegar o llamar.
					</p>
				</div>
				<div class="menu-grid">
					{
						carta.map((bloque) => (
							<article class="menu-card">
								<h3>{bloque.title}</h3>
								<p>{bloque.intro}</p>
								<ul>
									{bloque.platos.map((plato) => (
										<li>
											<span>{plato.nombre}</span>
											{plato.precio && <span class="price">{plato.precio}</span>}
										</li>
									))}
								</ul>
							</article>
						))
					}
				</div>
				<p class="menu-note">
					El 29 de cada mes, como manda la tradición argentina, hay ñoquis. Y fuera de carta salen
					platos de sugerencia que, según los habituales, nunca fallan.
				</p>
			</section>

			<section class="ambiente section-pad" id="ambiente">
				<div class="ambiente-grid">
					<div class="ambiente-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Parrilla y sobremesa</p>
						<h2>Comer bien<br /><em>y a buen precio.</em></h2>
						<p>
							Dentro, un salón acogedor para comidas largas de familia y amigos; fuera, una terraza
							perfecta para cenar cuando el tiempo acompaña. El ambiente es de barrio: tranquilo,
							cercano y sin prisa, lejos del bullicio del centro turístico.
						</p>
						<p>
							La carta va rotando con las sugerencias del día y la materia prima de temporada. El
							vino de la casa de Ribera del Duero tiene una relación calidad-precio que las reseñas
							recomiendan sin rodeos.
						</p>
						<p class="about-note">
							Accesible para personas con movilidad reducida y apto para mascotas. Con la terraza
							llena los fines de semana, la reserva telefónica marca la diferencia.
						</p>
					</div>
					<figure class="ambiente-photo">
						<img
							src={photos.ambiente}
							width="1066"
							height="1600"
							alt="Corte de carne a la parrilla del Parque Chas Restaurante en Marbella"
							loading="lazy"
							decoding="async"
						/>
						<figcaption>
							Carne a la parrilla · foto de Google Maps
							<a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha ↗</a>
						</figcaption>
					</figure>
				</div>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow dark"><span aria-hidden="true"></span> Av. Arias de Velasco, 43 · 29601 Marbella</p>
					<h2>Nos vemos<br /><em>en Miraflores.</em></h2>
					<p class="address">
						{business.street}<br />
						Barrio de {business.district}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr><th scope="row">Miércoles a domingo</th><td>12:00 – 16:00</td></tr>
							<tr><th scope="row">Miércoles a domingo</th><td>20:00 – 24:00</td></tr>
							<tr><th scope="row">Lunes y martes</th><td>Cerrado</td></tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario orientativo según la ficha pública del local. Puede cambiar en festivos: una
						llamada evita sorpresas.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Reservar mesa</a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-outline" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 {business.phone}</a>
					<p class="reserve-note">
						Reservas por teléfono y por Instagram. Los fines de semana se llena: reserva y olvídate.
					</p>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa del Parque Chas Restaurante en la avenida Arias de Velasco, Marbella"
						src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Parque Chas
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">PC</span>
				<p>
					Parque Chas Restaurante
					<small>{business.street} · {business.postalCode} {business.city}</small>
				</p>
			</div>
			<nav aria-label="Enlaces del local">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Parque Chas Restaurante. Imágenes: ficha de Google Maps del establecimiento.
			</small>

			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar a Parque Chas <span>633 02 44 18</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
