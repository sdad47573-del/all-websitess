---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	credito,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	menciones,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Taberna El Pili · Sanlúcar de Barrameda';
const description =
	'Taberna El Pili, en el Callejón de Guía, 16 de Sanlúcar de Barrameda: abierta 24 horas según Google, 4,2 sobre 5 con 57 reseñas. Teléfono 695 41 18 63.';
const keywords =
	'Taberna El Pili, El Pili Sanlúcar, taberna Sanlúcar de Barrameda, Callejón de Guía, taberna 24 horas, restaurante Sanlúcar, teléfono Taberna El Pili';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas diez fotografías y el manifiesto de la descarga no
 * atribuye autor, así que no se inventa una descripción ni una atribución: los `alt` avisan solo
 * de dónde salen.
 */
const altFoto =
	'Fotografía publicada en la ficha de Google Maps de Taberna El Pili, en Sanlúcar de Barrameda';
const altOg = 'Fotografía de Taberna El Pili publicada en su ficha de Google Maps';

/** Galería completa: las diez fotografías de la ficha, en el orden en que se descargaron. */
const galeria = [
	'taberna-el-pili-apaisada-01.jpg',
	'taberna-el-pili-apaisada-02.jpg',
	'taberna-el-pili-vertical-04.jpg',
	'taberna-el-pili-apaisada-03.jpg',
	'taberna-el-pili-vertical-07.jpg',
	'taberna-el-pili-apaisada-05.jpg',
	'taberna-el-pili-vertical-08.jpg',
	'taberna-el-pili-vertical-09.jpg',
	'taberna-el-pili-apaisada-06.jpg',
	'taberna-el-pili-vertical-10.jpg',
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0f2928" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CA" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Work+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">
					EP
				</span>
				<span class="brand-text">
					Taberna El Pili
					<small>Sanlúcar de Barrameda</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#taberna">La taberna</a>
				<a href="#fotos">Fotos</a>
				<a href="#horario">Horario</a>
				<a href="#resenas">Reseñas</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="hero-eyebrow">Sanlúcar de Barrameda · Cjón. de Guía, 16</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-lede">
							Restaurante en el número 16 del Callejón de Guía, en Sanlúcar de Barrameda. La ficha
							de Google lo marca <strong>abierto 24 horas los siete días</strong> y le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>
								Llamar al {business.phone}
							</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>Abierto 24 h</strong>
							</li>
							<li>
								<small>Teléfono</small>
								<strong>{business.phone}</strong>
							</li>
						</ul>
					</div>

					<div class="hero-photos">
						<figure class="hero-figure hero-figure-principal">
							<Image
								src={foto('taberna-el-pili-apaisada-01.jpg')}
								alt={altFoto}
								widths={[560, 800, 1100]}
								sizes="(max-width: 1080px) 62vw, 34vw"
								format="avif"
								quality={70}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</figure>
						<figure class="hero-figure hero-figure-lateral">
							<Image
								src={foto('taberna-el-pili-vertical-04.jpg')}
								alt={altFoto}
								widths={[320, 480, 640]}
								sizes="(max-width: 1080px) 30vw, 16vw"
								format="avif"
								quality={70}
								loading="eager"
								decoding="async"
							/>
						</figure>
						<p class="hero-plate">
							<strong>24 h</strong>
							<span>Abierto todos los días</span>
						</p>
					</div>
				</div>
			</section>

			<div class="band">
				<span>Abierto 24 horas</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
					{business.reviewCount.toLocaleString('es-ES')} reseñas
				</span>
			</div>

			<section class="section" id="taberna" aria-labelledby="taberna-title">
				<div class="wrap taberna-grid">
					<div>
						<p class="kicker">La taberna</p>
						<h2 class="title" id="taberna-title">
							La ficha,
							<em>sin adornos.</em>
						</h2>
						<div class="aviso-ficha">
							<p>
								<strong>La ficha de Google no publica descripción del titular.</strong> En vez de
								rellenar ese hueco con texto inventado, aquí está lo que sí publica, dato por dato,
								con la fecha en la que se consultó.
							</p>
						</div>
						<ul class="datos-lista">
							<li>
								<span>Categoría</span>
								<strong>{business.category}</strong>
							</li>
							<li>
								<span>Dirección</span>
								<strong>{business.streetAddress}</strong>
							</li>
							<li>
								<span>Horario</span>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<span>Teléfono</span>
								<strong>{business.phone}</strong>
							</li>
							<li>
								<span>Valoración</span>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 ·{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas
								</strong>
							</li>
							<li>
								<span>Plus code</span>
								<strong>{business.plusCode}</strong>
							</li>
							<li>
								<span>Consultada</span>
								<strong>{site.consultado}</strong>
							</li>
						</ul>
					</div>
					<div>
						<p class="kicker">En las reseñas</p>
						<h2 class="title">
							Lo que <em>nombran.</em>
						</h2>
						<ul class="menciones">
							{menciones.map((item) => (
								<li>
									<h3>{item.nombre}</h3>
									<p>{item.detalle}</p>
								</li>
							))}
						</ul>
						<p class="menciones-note">
							Son menciones de tres clientes, no la carta del local: la ficha no publica carta,
							precios ni horario de cocina. Para saber qué hay hoy hay que{' '}
							<a href={phoneHref}>llamar al {business.phone}</a>.
						</p>
					</div>
				</div>
			</section>

			<section class="section galeria" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						Diez azulejos
						<em> de la ficha.</em>
					</h2>
					<p class="lead">
						Las diez fotografías que Taberna El Pili publica en su ficha de Google Maps. La ficha no
						las describe y el manifiesto de la descarga no atribuye autor, así que se muestran sin
						pie inventado.
					</p>
					<div class="azulejos">
						{galeria.map((name, index) => (
							<figure class="azulejo">
								<Image
									src={foto(name)}
									alt={altFoto}
									widths={[300, 460, 640]}
									sizes="(max-width: 760px) 46vw, (max-width: 1080px) 23vw, 18vw"
									format="avif"
									quality={66}
									loading="lazy"
									decoding="async"
								/>
								<span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
							</figure>
						))}
					</div>
					<p class="galeria-note">
						Fotos de la ficha consultada el {site.consultado}. Si eres el titular y prefieres que no
						aparezcan, se retiran: el teléfono de contacto es el{' '}
						<a href={phoneHref}>{business.phone}</a>.
					</p>
				</div>
			</section>

			<section class="section horario" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y llegada</p>
						<h2 class="title" id="horario-title">
							Abierta a todas
							<em> las horas.</em>
						</h2>
						<div class="reloj">
							<strong>24</strong>
							<span>
								horas
								<br />
								los siete días
							</span>
						</div>
						<ul class="dias">
							{hours.map((item) => (
								<li class:list={['dia', { 'is-cerrado': item.closed }]}>
									<small aria-hidden="true">{item.short}</small>
									<strong>{item.service}</strong>
									<span class="sr-only">{item.day}</span>
								</li>
							))}
						</ul>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<p class="hours-note">
							La ficha marca «Abierto 24 horas» de lunes a domingo. Es lo que publica Google el{' '}
							{site.consultado}; conviene confirmarlo por teléfono antes de ir, sobre todo en
							festivos.
						</p>
						<p class="access-title">Accesibilidad publicada en la ficha</p>
						<ul class="access-list">
							{accesibilidad.map((item) => (
								<li class:list={[{ 'is-no': !item.disponible }]}>{item.label}</li>
							))}
						</ul>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="resenas" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<div class="resenas-head">
						<div>
							<p class="kicker">Lo que dicen</p>
							<h2 class="title" id="resenas-title">
								Tres reseñas,
								<em> tal cual.</em>
							</h2>
						</div>
						<div class="score">
							<strong>{business.rating.toLocaleString('es-ES')}</strong>
							<span>
								sobre 5 · {business.reviewCount.toLocaleString('es-ES')} reseñas
								<br />
								<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
									Ver todas ↗
								</a>
							</span>
						</div>
					</div>
					<div class="quote-grid">
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									{review.rating} sobre 5<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de
						<em> ir.</em>
					</h2>
					<p class="lead">
						{business.reviewCount.toLocaleString('es-ES')} reseñas, tres destacadas y dos datos de
						accesibilidad: todo lo que publica la ficha, resumido sin añadir nada.
					</p>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">
						EP
					</span>
					<span>
						Taberna El Pili
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Taberna El Pili · Callejón de Guía, 16 (11540 Sanlúcar de
					Barrameda). Web informativa elaborada con los datos y las fotografías que el local publica
					en su ficha de Google Maps, consultada el {site.consultado}. Confirma horario y
					disponibilidad por teléfono antes de salir.
					<span class="credit">
						Web creada por{' '}
						<a href={credito.url} rel="noopener">
							{credito.nombre}
						</a>
					</span>
				</small>
			</div>

			<a class="mobile-call" href={phoneHref}>
				Llamar a El Pili <span>{business.phone}</span>
			</a>

			<nav class="legal-links" aria-label="Información legal">
				<a href="/aviso-legal">Aviso legal</a>
				<a href="/aviso-legal#privacidad">Privacidad</a>
				<a href="/aviso-legal#cookies">Cookies</a>
			</nav>
		</footer>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
