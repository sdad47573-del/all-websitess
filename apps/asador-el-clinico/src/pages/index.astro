---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import mostrador from '../assets/fotos/asador-el-clinico-vertical-01.jpg';
import ensaladilla from '../assets/fotos/asador-el-clinico-vertical-03.jpg';
import escaparate from '../assets/fotos/asador-el-clinico-apaisada-04.jpg';
import calientes from '../assets/fotos/asador-el-clinico-apaisada-05.jpg';
import pizarra from '../assets/fotos/asador-el-clinico-vertical-06.jpg';
import vitrina from '../assets/fotos/asador-el-clinico-apaisada-07.jpg';
import pollo from '../assets/fotos/asador-el-clinico-apaisada-08.jpg';
import ensaladas from '../assets/fotos/asador-el-clinico-apaisada-09.jpg';
import asador from '../assets/fotos/asador-el-clinico-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Asador de pollos El Clínico · Teatinos, Málaga';
const description =
	'Asador de pollos El Clínico, en C. de Antígona, 4, Teatinos (Málaga). Pollos asados, raciones de comida casera y menú del miércoles, de 9:00 a 16:00.';

const galeria = [
	{
		src: escaparate,
		alt: 'El escaparate de Asador de pollos El Clínico con el cartel de precios: menú de pollo con patatas por 13 euros, comidas caseras desde 4,5 euros y el teléfono de reservas',
	},
	{
		src: mostrador,
		alt: 'Mostrador del asador con bandejas de comida casera, el cartel de pollo asado a 9 euros y un empleado sujetando una paella',
	},
	{
		src: pollo,
		alt: 'Bandeja negra con pollo asado troceado, pimientos verdes asados y una fuente de patatas fritas al fondo',
	},
	{
		src: asador,
		alt: 'El asador giratorio con pollos dorados y el cartel del menú de 13 euros, con un empleado atendiendo tras el mostrador',
	},
	{
		src: calientes,
		alt: 'Bandejas de comida caliente con empanadillas, croquetas y flamenquines en la vitrina del local',
	},
	{
		src: ensaladas,
		alt: 'La vitrina con ensaladas, pasta y platos preparados en tarrinas, junto a bandejas de salmorejo',
	},
	{
		src: vitrina,
		alt: 'Tarrinas de flanes, arroz con leche y otros postres caseros alineadas en la vitrina',
	},
	{
		src: pizarra,
		alt: 'La pizarra de precios del local, con el pollo asado a 9 euros, las raciones de patatas y pimientos y el cartel de pan',
	},
	{
		src: ensaladilla,
		alt: 'Bandeja de ensaladilla rusa con langostinos, aceitunas, huevo y pimiento morrón',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de El Clínico',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-clinico`,
	name: BUSINESS.name,
	alternateName: [
		'Asador de pollos- El clínico. Agustín Pineda',
		'El Clínico Teatinos',
		'Asador de Pollos El Clínico Málaga',
	],
	description:
		'Asador de pollos familiar en la calle Antígona, 4, Teatinos (29010 Málaga), junto al Hospital Clínico. Pollos asados, raciones de comida casera y menú del miércoles para comer o llevar.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34952109307',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Comida casera', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"asador-el-clinico-apaisada-08.jpg": pollo,
	"asador-el-clinico-apaisada-04.jpg": escaparate,
	"asador-el-clinico-vertical-01.jpg": mostrador,
	"asador-el-clinico-vertical-10.jpg": asador,
	"asador-el-clinico-apaisada-05.jpg": calientes,
	"asador-el-clinico-apaisada-09.jpg": ensaladas,
	"asador-el-clinico-apaisada-07.jpg": vitrina,
	"asador-el-clinico-vertical-06.jpg": pizarra,
	"asador-el-clinico-vertical-03.jpg": ensaladilla,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#191411" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Manrope:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador de pollos El Clínico, pollos asados Málaga, pollos asados Teatinos, comida casera Teatinos, comida para llevar Málaga, asador Agustín Pineda, pollo asado junto al Clínico, menú del miércoles Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollos asados, raciones de comida casera y menú del miércoles en la calle Antígona, 4, Teatinos. De martes a domingo, de 9:00 a 16:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bandeja de pollo asado con pimientos verdes del Asador de pollos El Clínico, en Teatinos"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#191411"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[pollo]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Clínico"
			subtitle="Pollos asados · Teatinos"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a El Clínico"
			navAriaLabel="Enlaces de El Clínico"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
