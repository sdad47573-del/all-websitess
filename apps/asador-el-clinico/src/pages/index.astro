---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import mostrador from '../assets/fotos/asador-el-clinico-vertical-01.jpg';
import ensaladilla from '../assets/fotos/asador-el-clinico-vertical-03.jpg';
import escaparate from '../assets/fotos/asador-el-clinico-apaisada-04.jpg';
import calientes from '../assets/fotos/asador-el-clinico-apaisada-05.jpg';
import pizarra from '../assets/fotos/asador-el-clinico-vertical-06.jpg';
import vitrina from '../assets/fotos/asador-el-clinico-apaisada-07.jpg';
import pollo from '../assets/fotos/asador-el-clinico-apaisada-08.jpg';
import ensaladas from '../assets/fotos/asador-el-clinico-apaisada-09.jpg';
import asador from '../assets/fotos/asador-el-clinico-vertical-10.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Asador de pollos El Clínico · Teatinos, Málaga';
const description =
	'Asador de pollos El Clínico, en C. de Antígona, 4, Teatinos (Málaga). Pollos asados, raciones de comida casera y menú del miércoles, de 9:00 a 16:00.';

const galeria = [
	{
		src: escaparate,
		alt: 'El escaparate de Asador de pollos El Clínico con el cartel de precios: menú de pollo con patatas por 13 euros, comidas caseras desde 4,5 euros y el teléfono de reservas',
	},
	{
		src: mostrador,
		alt: 'Mostrador del asador con bandejas de comida casera, el cartel de pollo asado a 9 euros y un empleado sujetando una paella',
	},
	{
		src: pollo,
		alt: 'Bandeja negra con pollo asado troceado, pimientos verdes asados y una fuente de patatas fritas al fondo',
	},
	{
		src: asador,
		alt: 'El asador giratorio con pollos dorados y el cartel del menú de 13 euros, con un empleado atendiendo tras el mostrador',
	},
	{
		src: calientes,
		alt: 'Bandejas de comida caliente con empanadillas, croquetas y flamenquines en la vitrina del local',
	},
	{
		src: ensaladas,
		alt: 'La vitrina con ensaladas, pasta y platos preparados en tarrinas, junto a bandejas de salmorejo',
	},
	{
		src: vitrina,
		alt: 'Tarrinas de flanes, arroz con leche y otros postres caseros alineadas en la vitrina',
	},
	{
		src: pizarra,
		alt: 'La pizarra de precios del local, con el pollo asado a 9 euros, las raciones de patatas y pimientos y el cartel de pan',
	},
	{
		src: ensaladilla,
		alt: 'Bandeja de ensaladilla rusa con langostinos, aceitunas, huevo y pimiento morrón',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de El Clínico',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-clinico`,
	name: BUSINESS.name,
	alternateName: [
		'Asador de pollos- El clínico. Agustín Pineda',
		'El Clínico Teatinos',
		'Asador de Pollos El Clínico Málaga',
	],
	description:
		'Asador de pollos familiar en la calle Antígona, 4, Teatinos (29010 Málaga), junto al Hospital Clínico. Pollos asados, raciones de comida casera y menú del miércoles para comer o llevar.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34952109307',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Comida casera', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#191411" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Manrope:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador de pollos El Clínico, pollos asados Málaga, pollos asados Teatinos, comida casera Teatinos, comida para llevar Málaga, asador Agustín Pineda, pollo asado junto al Clínico, menú del miércoles Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollos asados, raciones de comida casera y menú del miércoles en la calle Antígona, 4, Teatinos. De martes a domingo, de 9:00 a 16:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bandeja de pollo asado con pimientos verdes del Asador de pollos El Clínico, en Teatinos"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#191411"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[pollo]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Clínico"
			subtitle="Pollos asados · Teatinos"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. de Antígona, 4 · Teatinos, Málaga"
				title="Pollo asado <br /><em>de Teatinos.</em>"
				lede={`El Clínico lleva años asando pollos junto al Hospital Clínico, en el corazón de Teatinos. En el mostrador, la comida casera se prepara cada día y las raciones salen listas para llevar. Abre de martes a domingo, de 9:00 a 16:00, y tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={pollo}
				imageAlt="Bandeja de pollo asado troceado con pimientos verdes, con una fuente de patatas fritas al fondo"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>9:00–16:00</b> · lunes cerrado' },
					{ label: 'Servicio', html: '<b>Para llevar</b> y mesas en el local' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Menú 13,00 € · cartel del local"
			/>

			<LocalChips label="Lo que ofrece El Clínico" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un asador familiar <br /><em>junto al Clínico.</em>"
				paragraphs={[
					'El Clínico está en la calle Antígona, 4, en Teatinos, a un paso del Hospital Clínico. La fachada de azulejos, el rótulo con el pollo y la vitrina de comidas caseras se ven desde la acera; dentro, el asador giratorio y el mostrador de tarrinas trabajan al mismo ritmo.',
					'En su ficha de Google, el negocio se presenta como un asador familiar de la zona del Clínico, Teatinos y El Consul: pollos asados y raciones de comida preparada «sana y elaborada por nosotros». Presume de clientela fiel y de precios económicos.',
					'Los miércoles la casa anuncia una oferta especial para llevarse el pollo. El cartel del local muestra el menú completo —pollo, patatas y un acompañamiento a elegir— por 13 euros, y la pizarra del interior detalla las raciones.',
					'Google lo clasifica como restaurante especializado en pollo y como restaurante de comida para llevar. La ficha reúne 402 reseñas con una media de 4,7 sobre 5: las mejores hablan del pollo, de la comida elaborada y de la limpieza del local.',
				]}
				note="La ficha no publica página web ni carta. Los precios que aparecen aquí son los que se leen en el cartel del propio local en las fotos de Google; conviene confirmarlos por teléfono antes de encargar."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que se cocina</p>
					<h2 id="highlights-title">Brasa, vitrina <br /><em>y comida de casa.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Del asador <br /><em>a la mesa.</em>"
				description="La ficha de Google no publica carta. Esto es lo que nombran la descripción del negocio y las reseñas, más el menú que se lee en el cartel del local."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="El menú de 13,00 € es el que aparece en el cartel del escaparate y del asador en las fotos del perfil de Google, consultadas en octubre de 2026. El resto de precios y la carta del día se consultan en el mostrador o por teléfono: cambian con frecuencia."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El mostrador <br /><em>y el asador.</em>"
				description="Nueve fotografías del perfil de El Clínico en Google Maps: el escaparate con los carteles, el asador giratorio, el pollo recién hecho y la vitrina de comida casera."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,7 sobre 5, <em>con 402 reseñas.</em></h2>
						<p>
							La valoración que publica Google en octubre de 2026 es de 4,7 con 402 opiniones. Las
							mejores destacan el pollo y la comida elaborada; también hay alguna crítica con el sabor
							y las guarniciones, que se reproduce aquí tal cual.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,7</strong>
						<span>★★★★★</span>
						<small>402 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Teatinos, <br /><em>junto al Clínico.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.district} · Teatinos-Universidad`, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de martes a domingo, de 9:00 a 16:00, con el lunes cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Asador de pollos El Clínico en la calle Antígona, 4, Teatinos, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. de Antígona, 4 · Teatinos"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Encargos y mesas por teléfono: la ficha no publica reservas online. Google marca el acceso para sillas de ruedas, pero no hay aparcamiento adaptado ni asientos adaptados. La boca del metro Universidad y las paradas de Teatinos quedan a pocos minutos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a El Clínico"
			navAriaLabel="Enlaces de El Clínico"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
