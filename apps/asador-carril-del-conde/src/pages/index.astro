---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import polloPastela from '../assets/fotos/asador-carril-del-conde-apaisada-07.jpg';
import gratinados from '../assets/fotos/asador-carril-del-conde-apaisada-05.jpg';
import calabacines from '../assets/fotos/asador-carril-del-conde-vertical-01.jpg';
import bandejaPollo from '../assets/fotos/asador-carril-del-conde-vertical-02.jpg';
import arroz from '../assets/fotos/asador-carril-del-conde-vertical-03.jpg';
import relleno from '../assets/fotos/asador-carril-del-conde-vertical-04.jpg';
import pasteles from '../assets/fotos/asador-carril-del-conde-vertical-06.jpg';
import pastelRedondo from '../assets/fotos/asador-carril-del-conde-vertical-09.jpg';
import guiso from '../assets/fotos/asador-carril-del-conde-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Asador Carril del Conde · Comida casera para llevar en Málaga';
const description =
	'Asador Carril del Conde, en la Ctra. Carril del Conde, Local 2 (29004 Málaga). Comida para llevar casera, con productos naturales y hecha al día, todos los días de 12:30 a 16:30.';

const galeria = [
	{
		src: bandejaPollo,
		alt: 'Bandeja de pollo frito con triángulos de pastela sobre una base de lechuga y zanahoria',
	},
	{
		src: pastelRedondo,
		alt: 'Pastel redondo de pasta fina cubierto de azúcar glass, canela y almendras enteras',
	},
	{
		src: guiso,
		alt: 'Pollo guisado en sartén con cilantro fresco y cebolla en rodajas',
	},
	{
		src: arroz,
		alt: 'Tarrinas de arroz con verduras y pollo preparadas para llevar',
	},
	{
		src: calabacines,
		alt: 'Calabacines rellenos en una bandeja con salsa cremosa y verduras ralladas por encima',
	},
	{
		src: pasteles,
		alt: 'Pasteles rectangulares de la casa espolvoreados con azúcar glass, canela y almendras',
	},
	{
		src: gratinados,
		alt: 'Bandejas de aluminio con pasta gratinada y queso dorado recién salidas del horno',
	},
	{
		src: polloPastela,
		alt: 'Una bandeja de pollo frito y pastelas triangulares junto a un pastel de pollo con canela y almendras',
	},
	{
		src: relleno,
		alt: 'Masa rellena cubierta con huevo rallado, zanahoria y perejil, cortada en porciones',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Asador Carril del Conde',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#carril-del-conde`,
	name: BUSINESS.name,
	alternateName: ['Asador carril del conde', 'Asador Carril del Conde Málaga'],
	description:
		'Asador de comida casera para llevar en la Ctra. Carril del Conde, Local 2, junto a la calle Antillas (29004 Málaga). Comida con productos naturales, hecha al día.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34656193844',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Cocina árabe', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:30',
			closes: '16:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"asador-carril-del-conde-apaisada-07.jpg": polloPastela,
	"asador-carril-del-conde-vertical-02.jpg": bandejaPollo,
	"asador-carril-del-conde-vertical-09.jpg": pastelRedondo,
	"asador-carril-del-conde-vertical-10.jpg": guiso,
	"asador-carril-del-conde-vertical-03.jpg": arroz,
	"asador-carril-del-conde-vertical-01.jpg": calabacines,
	"asador-carril-del-conde-vertical-06.jpg": pasteles,
	"asador-carril-del-conde-apaisada-05.jpg": gratinados,
	"asador-carril-del-conde-vertical-04.jpg": relleno,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#191411" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Manrope:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador Carril del Conde, comida casera para llevar Málaga, comida árabe Málaga, pastela de pollo, pollo frito, calabacines rellenos, comida hecha al día, Carril del Conde, Calle Antillas"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera con productos naturales y hecha al día en la Ctra. Carril del Conde, Local 2. Todos los días de 12:30 a 16:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bandeja de pollo frito y pastelas de Asador Carril del Conde"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#191411"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[polloPastela]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Carril del Conde"
			subtitle="Comida casera · Para llevar"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a Carril del Conde"
			navAriaLabel="Enlaces de Asador Carril del Conde"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
