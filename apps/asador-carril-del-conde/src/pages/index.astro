---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import polloPastela from '../assets/fotos/asador-carril-del-conde-apaisada-07.jpg';
import gratinados from '../assets/fotos/asador-carril-del-conde-apaisada-05.jpg';
import calabacines from '../assets/fotos/asador-carril-del-conde-vertical-01.jpg';
import bandejaPollo from '../assets/fotos/asador-carril-del-conde-vertical-02.jpg';
import arroz from '../assets/fotos/asador-carril-del-conde-vertical-03.jpg';
import relleno from '../assets/fotos/asador-carril-del-conde-vertical-04.jpg';
import pasteles from '../assets/fotos/asador-carril-del-conde-vertical-06.jpg';
import pastelRedondo from '../assets/fotos/asador-carril-del-conde-vertical-09.jpg';
import guiso from '../assets/fotos/asador-carril-del-conde-vertical-10.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Asador Carril del Conde · Comida casera para llevar en Málaga';
const description =
	'Asador Carril del Conde, en la Ctra. Carril del Conde, Local 2 (29004 Málaga). Comida para llevar casera, con productos naturales y hecha al día, todos los días de 12:30 a 16:30.';

const galeria = [
	{
		src: bandejaPollo,
		alt: 'Bandeja de pollo frito con triángulos de pastela sobre una base de lechuga y zanahoria',
	},
	{
		src: pastelRedondo,
		alt: 'Pastel redondo de pasta fina cubierto de azúcar glass, canela y almendras enteras',
	},
	{
		src: guiso,
		alt: 'Pollo guisado en sartén con cilantro fresco y cebolla en rodajas',
	},
	{
		src: arroz,
		alt: 'Tarrinas de arroz con verduras y pollo preparadas para llevar',
	},
	{
		src: calabacines,
		alt: 'Calabacines rellenos en una bandeja con salsa cremosa y verduras ralladas por encima',
	},
	{
		src: pasteles,
		alt: 'Pasteles rectangulares de la casa espolvoreados con azúcar glass, canela y almendras',
	},
	{
		src: gratinados,
		alt: 'Bandejas de aluminio con pasta gratinada y queso dorado recién salidas del horno',
	},
	{
		src: polloPastela,
		alt: 'Una bandeja de pollo frito y pastelas triangulares junto a un pastel de pollo con canela y almendras',
	},
	{
		src: relleno,
		alt: 'Masa rellena cubierta con huevo rallado, zanahoria y perejil, cortada en porciones',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Asador Carril del Conde',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#carril-del-conde`,
	name: BUSINESS.name,
	alternateName: ['Asador carril del conde', 'Asador Carril del Conde Málaga'],
	description:
		'Asador de comida casera para llevar en la Ctra. Carril del Conde, Local 2, junto a la calle Antillas (29004 Málaga). Comida con productos naturales, hecha al día.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34656193844',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Cocina árabe', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:30',
			closes: '16:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#191411" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Manrope:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador Carril del Conde, comida casera para llevar Málaga, comida árabe Málaga, pastela de pollo, pollo frito, calabacines rellenos, comida hecha al día, Carril del Conde, Calle Antillas"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera con productos naturales y hecha al día en la Ctra. Carril del Conde, Local 2. Todos los días de 12:30 a 16:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bandeja de pollo frito y pastelas de Asador Carril del Conde"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#191411"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[polloPastela]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Carril del Conde"
			subtitle="Comida casera · Para llevar"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Ctra. Carril del Conde, Local 2 · Málaga"
				title="Comida casera <br /><em>hecha al día.</em>"
				lede={`Asador Carril del Conde trabaja la comida para llevar con una idea sencilla: productos naturales y cocina del día. En sus bandejas aparecen el pollo frito, las pastelas, los calabacines rellenos y los guisos, y la ficha destaca su cocina «con sabor árabe, y muy variada». Abre todos los días de 12:30 a 16:30 y tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={polloPastela}
				imageAlt="Bandeja de pollo frito y pastelas triangulares junto a un pastel de pollo con canela y almendras"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>12:30–16:30</b> · todos los días' },
					{ label: 'Cocina', html: '<b>Casera y variada</b> · para llevar' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Hecha al día · para llevar"
			/>

			<LocalChips label="Lo que ofrece Asador Carril del Conde" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un asador de barrio <br /><em>con cocina del día.</em>"
				paragraphs={[
					'Asador Carril del Conde está en la Ctra. Carril del Conde, Local 2, junto a la calle Antillas. Es un local de comida para llevar con el nombre bien claro en la fachada y una cocina que trabaja el menú del día, sin carta publicada en Google.',
					'La ficha lo describe en una sola frase: «Comida para llevar casera con productos naturales y hecha al día». Esa es la promesa de la casa. Abre todos los días, de 12:30 a 16:30, y el teléfono que publica es el 656 19 38 44.',
					'En la galería del local se ven las bandejas de pollo frito y pastelas, los calabacines rellenos en salsa, el arroz con verduras, los pasteles de pollo con azúcar glass, canela y almendras y los guisos de pollo con cilantro. Es una cocina variada en la que la huella árabe se nota, como dice una de las reseñas.',
					'Google le da 4,7 sobre 5 con 37 reseñas. Una destaca los «buenos precios y un trato exquisito», otra la comida «con sabor árabe, y muy variada», y una tercera avisa de que el pollo asado se agota: «No les quedaba pollo asado pero volveremos sin duda».',
				]}
				note="La ficha no publica página web ni carta. Los platos que se citan aquí son los que aparecen en la galería del perfil de Google y en las reseñas; los precios y la comida del día se consultan por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que se cocina</p>
					<h2 id="highlights-title">Producto natural <br /><em>y cocina del día.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Lo que hay <br /><em>en la vitrina.</em>"
				description="La ficha de Google no publica carta ni precios. Esto es lo que nombran la descripción del negocio y las reseñas, más los platos que aparecen en las fotos del local."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La ficha no publica precios. Los platos de esta lista son los que aparecen en la galería del perfil de Google del local, consultada en octubre de 2026, y los que nombran la descripción y las reseñas. La comida del día cambia: confírmala por teléfono."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El pollo, las pastelas <br /><em>y los guisos.</em>"
				description="Nueve fotografías del perfil de Asador Carril del Conde en Google Maps: pollo frito, pastelas, calabacines rellenos, arroz, guisos y pasteles de la casa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,7 sobre 5, <em>con 37 reseñas.</em></h2>
						<p>
							La valoración que publica Google en octubre de 2026 es de 4,7 con 37 opiniones. Las
							reseñas destacadas hablan de la comida, de la variedad, del trato y del precio; aquí
							se reproducen tal como aparecen en la ficha.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,7</strong>
						<span>★★★★★</span>
						<small>37 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Carril del Conde, <br /><em>junto a Antillas.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: todos los días, de 12:30 a 16:30. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Asador Carril del Conde en la Ctra. Carril del Conde, Local 2, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Ctra. Carril del Conde, Local 2"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos y consultas por teléfono: la ficha no publica reservas ni pedidos online. Google marca el acceso para sillas de ruedas, pero no hay aparcamiento adaptado ni asientos adaptados."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a Carril del Conde"
			navAriaLabel="Enlaces de Asador Carril del Conde"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
