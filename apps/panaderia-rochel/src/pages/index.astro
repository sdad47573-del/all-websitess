---
import { Image } from 'astro:assets';
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import vitrina from '../assets/fotos/panaderia-rochel-vertical-02.jpg';
import rotulo from '../assets/fotos/panaderia-rochel-apaisada-07.jpg';
import tostadas from '../assets/fotos/panaderia-rochel-vertical-03.jpg';
import aceite from '../assets/fotos/panaderia-rochel-vertical-08.jpg';
import tomate from '../assets/fotos/panaderia-rochel-vertical-09.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HOURS, HOURS_NOTE, MAPS, SERVICIOS } from '../data/site';

const title = 'Rochel · confitería, panadería y heladería en el Poniente Sur, Córdoba';
const description =
	'Confitería Panadería Heladería Rochel, en C. Rafael Pérez de Guzmán, 1 (Poniente Sur, 14005 Córdoba). De 8:00 a 14:30 y de 16:00 a 20:00 de lunes a viernes. Teléfono 957 92 25 56. 4,0/5 con 41 reseñas en Google.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': ['Bakery', 'IceCreamShop'],
	'@id': `${BUSINESS.siteUrl}/#rochel`,
	name: BUSINESS.name,
	alternateName: ['Rochel', 'Cafetería Rochel', 'Pastelería Rochel Córdoba'],
	description:
		'Confitería, panadería y heladería en C. Rafael Pérez de Guzmán, 1 (Poniente Sur, 14005 Córdoba).',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34957922556',
	servesCuisine: ['Pastelería', 'Panadería', 'Heladería'],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:00',
			closes: '14:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '16:00',
			closes: '20:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '08:00',
			closes: '14:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '08:30',
			closes: '14:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Horario', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const galeria = [
	{
		src: rotulo,
		alt: 'Rótulo de Rochel sobre la entrada, con las palabras cafetería, pastelería y heladería y el escaparate de la calle',
	},
	{
		src: tostadas,
		alt: 'Dos tostadas con jamón y tomate, pan con aceite y vasos de café sobre la mesa del local',
	},
	{
		src: aceite,
		alt: 'Tostada con aceite y tomate junto a una botella de aceite de oliva virgen extra y una caja de pan La Mezquita',
	},
	{
		src: tomate,
		alt: 'Tostada de tomate y vaso de café con leche sobre un plato de rayas blancas y negras',
	},
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#fdf7ed" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Figtree:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Rochel Córdoba, confitería Córdoba, panadería Córdoba, heladería Córdoba, Poniente Sur, Rafael Pérez de Guzmán, 14005, desayunos"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Confitería, panadería y heladería en C. Rafael Pérez de Guzmán, 1. Abierta de 8:00 a 14:30 y de 16:00 a 20:00 de lunes a viernes. 4,0 sobre 5 con 41 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Vitrina de bollería y pastelería de Rochel, en Córdoba"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#fdf7ed"
			phone="+34957922556"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Rochel"
			subtitle="Confitería · Panadería · Heladería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<section class="hero wrap" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Rochel · Rafael Pérez de Guzmán, 1</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Rochel ocupa la esquina de la calle Rafael Pérez de Guzmán con el Poniente
						Sur, a dos pasos de la plaza de Vista Alegre. Despacha confitería, pan y
						helado, y sirve desayunos en la mesa. Abre de 8:00 a 14:30 y de 16:00 a 20:00
						de lunes a viernes. El teléfono es el 957 92 25 56.
						{BUSINESS.rating.toString().replace('.', ',')} sobre 5 con {BUSINESS.reviewsCount} reseñas en Google.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href={BUSINESS.phoneHref}>
							Llamar al 957 92 25 56
						</a>
						<a class="button button-ghost" href={MAPS.directions}>
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<ul class="hero-facts">
						<li><b>{BUSINESS.street}</b> · {BUSINESS.district} · {BUSINESS.postalCode}</li>
						<li><b>L–V</b> 8:00–14:30 y 16:00–20:00 · <b>Sáb</b> 8:00–14:30 · <b>Dom</b> 8:30–14:30</li>
						<li><b>Acceso para sillas de ruedas</b> según la ficha de Google</li>
					</ul>
				</div>

				<figure class="hero-figure">
					<Image
						src={vitrina}
						alt="Vitrina de Rochel con empanadas, napolitanas de chocolate, bollos y tartas pequeñas"
						widths={[420, 640, 900]}
						sizes="(max-width: 980px) 92vw, 44vw"
						format="avif"
						quality={68}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					<span class="hero-badge"><span aria-hidden="true">★</span> 10 fotos en la ficha</span>
					<figcaption class="hero-caption">La vitrina. Foto de la galería de Google Maps.</figcaption>
				</figure>
			</section>

			<LocalChips label="Lo que consta en la ficha" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Tres oficios <br /><em>en una esquina.</em>"
				paragraphs={[
					'El rótulo de Rochel lo dice todo: «Cafetería · Pastelería · Heladería» en la fachada y «Heladería» en el escaparate de al lado. Google, en cambio, la clasifica con una sola categoría, «Pastelería». El nombre completo de la ficha es Confitería Panadería Heladería Rochel.',
					'Está en el número 1 de la calle Rafael Pérez de Guzmán, en el Poniente Sur (14005 Córdoba), con terraza en la acera y varias mesas fuera. Es una esquina de barrio con mucho tránsito a la hora del desayuno.',
					'La ficha publica el horario partido: de 8:00 a 14:30 y de 16:00 a 20:00 de lunes a viernes, solo mañana el sábado (8:00–14:30) y el domingo de 8:30 a 14:30. No hay web propia, ni carta, ni precios publicados.',
					'De accesibilidad, la ficha solo dice dos cosas: que hay acceso para sillas de ruedas y que no hay aparcamiento adaptado. Es lo que se recoge aquí; no se añade nada más sobre el interior del local.',
				]}
				note="No hay carta ni precios publicados. Lo que haya en la vitrina ese día se ve allí; para encargos o para confirmar el horario en festivo, el teléfono es el 957 92 25 56."
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas de la casa</p>
						<h2 id="three-title">El rótulo, la tarde <br /><em>y el barrio.</em></h2>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos"
				title="La fachada, la mesa <br /><em>y la vitrina.</em>"
				description="Cinco de las diez fotos de la ficha: el rótulo de la entrada, dos vistas de las tostadas y el pan con aceite, y la vitrina de la portada."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026. La ficha tiene diez fotos; las otras cinco se han dejado fuera por tener personas en el encuadre, enseres personales o el local con la persiana bajada."
			/>

			<section class="rating-band" aria-labelledby="rating-title">
				<div class="wrap rating-inner">
					<div class="rating-score">
						<strong>4,0</strong>
						<div>
							<span class="rating-stars" role="img" aria-label="4 de 5 estrellas">4 / 5</span>
							<p id="rating-title" style="margin:0;font-size:.75rem">41 reseñas en Google Maps</p>
						</div>
					</div>
					<p class="rating-copy">
						La media de la ficha es 4,0 sobre 5 con 41 reseñas, con opiniones variadas.
						Esta página no selecciona ni reproduce sus textos: se leen todas en Google.
					</p>
					<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
						Leer las 41 reseñas en Google ↗
					</a>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En el Poniente <br /><em>Sur.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de Rochel en la calle Rafael Pérez de Guzmán, 1, Córdoba"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Rochel · Poniente Sur"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phone, href: BUSINESS.phoneHref }}
				reserveNote="La ficha de Google no publica carta, precios ni web propia, y de accesibilidad solo indica acceso para sillas de ruedas y ausencia de aparcamiento adaptado. Esta página no gestiona pedidos ni encargos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. La ficha no publica carta ni precios. Horario y disponibilidad pueden cambiar; confírmalos por teléfono antes de ir."
			ctaLabel="Llamar a Rochel"
			navAriaLabel="Enlaces de Rochel"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34957922556?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20C%C3%B3rdoba." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Córdoba"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
