---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES } from '../data/site';
---

<section id="salon" class="bg-base-100 scroll-mt-20 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid items-center gap-12 lg:grid-cols-2">
			<figure class="relative">
				<div class="overflow-hidden rounded-sm shadow-xl">
					<Image
						src={IMAGES.fotoInterior}
						alt="Vikings Barbershop en Calle Sondalezas, Málaga"
						widths={[600, 1000]}
						sizes="(min-width: 1024px) 46vw, 92vw"
						quality={85}
						loading="lazy"
						class="aspect-[4/5] w-full object-cover"
					/>
				</div>
				<figcaption class="text-base-content/50 mt-3 text-xs">
					Sustituye esta imagen por una foto real del salón (ver README_IMAGENES.md).
				</figcaption>
			</figure>

			<div>
				<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">El salón</span>
				<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">
					Barbería en Miraflores, Calle Sondalezas
				</h2>
				<div class="astyle-divider mt-5 h-px w-24"></div>
				<p class="text-base-content/70 mt-6 leading-relaxed">
					{BUSINESS.name} está en {BUSINESS.street} ({BUSINESS.district},
					{BUSINESS.postalCode} {BUSINESS.city}): corte con cejas, arreglo de barba
					barba spa con vaporizador y cejas, con precios publicados en Booksy.
				</p>
				<p class="text-base-content/70 mt-4 leading-relaxed">
					Equipo de Ouchen. {BUSINESS.ratingBooksy}/5 en Booksy con
					{BUSINESS.reviewsBooksy} reseñas: la atención profesional es lo que más destacan.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a
						href={BUSINESS.booksy}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-primary gap-2 rounded-full"
					>
						<i class="ri-calendar-check-line"></i> Reservar en Booksy
					</a>
					<a href="/servicios" class="btn btn-outline gap-2 rounded-full">
						<i class="ri-list-check"></i> Ver precios
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
