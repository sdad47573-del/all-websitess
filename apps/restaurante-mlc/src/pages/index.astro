---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import hotel from '../assets/fotos/restaurante-mlc-apaisada-03.jpg';
import vino from '../assets/fotos/restaurante-mlc-apaisada-01.jpg';
import sandwich from '../assets/fotos/restaurante-mlc-apaisada-02.jpg';
import pimiento from '../assets/fotos/restaurante-mlc-apaisada-04.jpg';
import burrata from '../assets/fotos/restaurante-mlc-apaisada-06.jpg';
import mejillones from '../assets/fotos/restaurante-mlc-apaisada-10.jpg';
import burgerBacon from '../assets/fotos/restaurante-mlc-vertical-05.jpg';
import burgerHuevo from '../assets/fotos/restaurante-mlc-vista-7-07.jpg';
import tostaSetas from '../assets/fotos/restaurante-mlc-vertical-09.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Restaurante del Hotel MLC en Urnieta (Gipuzkoa): hamburguesas artesanales, tostas gourmet, pintxos, desayuno buffet y brunch. Abre a las 7:00. Tel. 694 90 63 82.';

const galeria = [
	{
		src: hotel,
		alt: 'Fachada del Hotel MLC en Urnieta al atardecer, con el rótulo MLC Hotel iluminado',
	},
	{
		src: burgerBacon,
		alt: 'Hamburguesa con bacon, queso cheddar y huevo con patatas fritas en Restaurante MLC',
	},
	{
		src: burgerHuevo,
		alt: 'Hamburguesa en pan brioche con huevo frito y queso sobre la mesa del restaurante',
	},
	{
		src: sandwich,
		alt: 'Sándwich con bacon y huevo con patatas caseras en gajo',
	},
	{ src: mejillones, alt: 'Mejillones en salsa de tomate en un cuenco blanco' },
	{ src: burrata, alt: 'Burrata con pimientos asados, albahaca y aceite de oliva' },
	{ src: pimiento, alt: 'Pimiento relleno en salsa con una flor comestible en un plato blanco' },
	{ src: tostaSetas, alt: 'Tosta de setas con salsa cremosa sobre pan tostado' },
	{ src: vino, alt: 'Botella de vino tinto Remelluri Reserva con dos copas en la mesa' },
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#mlc`,
	name: BUSINESS.name,
	alternateName: ['MLC', 'MLC Hotel', 'Restaurante Hotel MLC', 'MLC Urnieta'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 694 90 63 82',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Vasca', 'Española', 'Hamburguesas', 'Brunch'],
	areaServed: [
		{ '@type': 'City', name: 'Urnieta' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday'],
			opens: '07:00',
			closes: '22:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '07:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '07:00',
			closes: '17:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Se admiten perros',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Amigable con la comunidad LGBTQ+',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Las mejores hamburguesas y sándwiches que hemos probado.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Además, muy buen servicio por parte de las camareras, atentas y agradables.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 1, bestRating: 5 },
			reviewBody: 'La camarera fue a consultar con cocina y tardó un buen rato en regresar.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Restaurante MLC · Cocina y brunch en Urnieta';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#244a5a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante MLC Urnieta, comer en Urnieta, brunch Urnieta, desayuno buffet Urnieta, hamburguesas Urnieta, restaurante Hotel MLC, restaurante vasco Gipuzkoa, cafetería Urnieta"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Restaurante MLC · Cocina y brunch en Urnieta"
			ogDescription="Restaurante del Hotel MLC en Urnieta: hamburguesas artesanales de txuleta madurada, tostas gourmet, pintxos y desayuno buffet. Abre a las 7:00. Tel. 694 90 63 82."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada del Hotel MLC en Urnieta al atardecer"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#244a5a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34694906382"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[hotel]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="RESTAURANTE MLC"
			subtitle="Cocina · Urnieta"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carr. Ergoyen, 18D · Urnieta"
				title="Cocina informal<br /><em>en el Hotel MLC.</em>"
				lede={`Restaurante del Hotel MLC en Urnieta (Gipuzkoa), en la carretera de Ergoyen. Carta informal y cuidada: hamburguesas artesanales de txuleta madurada, tostas gourmet, pintxos, patatas caseras y sándwiches, además de desayuno buffet y brunch. Abre a las 7:00 y el lunes descansa. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={hotel}
				imageAlt="Fachada del Hotel MLC en Urnieta al atardecer, con el rótulo MLC Hotel iluminado"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)`,
					},
					{ label: 'Desayuno', html: 'Buffet · desde las 7:00' },
					{ label: 'Lunes', html: 'Cerrado' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Restaurante MLC" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Del desayuno<br /><em>a la hamburguesa.</em>"
				paragraphs={[
					'Restaurante MLC es el restaurante del Hotel MLC en Urnieta (Gipuzkoa), en la carretera de Ergoyen, 18D. Google lo clasifica como restaurante vasco, bar, restaurante de brunch y cafetería: la misma carta sirve para un desayuno completo, un brunch tranquilo o una comida informal.',
					'Según la descripción del propio restaurante en su ficha, la propuesta es «informal y cuidada», con hamburguesas artesanales, patatas caseras y platos elaborados con productos frescos. En sus publicaciones de Google detalla la carta: hamburguesas artesanales de txuleta madurada, tostas gourmet, pintxos y un desayuno buffet.',
					'En las fotos de su perfil aparecen la hamburguesa con bacon, huevo y queso cheddar con patatas, el sándwich con bacon y huevo, la burrata con pimientos asados, el pimiento relleno en salsa, los mejillones, la tosta de setas y una botella de Remelluri Reserva sobre la mesa.',
					'Google le da 4,5 sobre 5 con 72 reseñas. Las que se publican destacan las hamburguesas y los sándwiches y el trato de las camareras, «atentas y agradables».',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «Las mejores hamburguesas y sándwiches que hemos probado».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Hamburguesas,<br /><em>tostas y brunch.</em>"
				description="La ficha de Google no publica precios: esto es lo que anuncian el propio restaurante en su ficha y sus publicaciones, y lo que aparece en las fotos del perfil."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. Llama al 694 90 63 82 para saber la carta del día y si hace falta reservar. El lunes el restaurante figura como cerrado en Google."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El edificio,<br /><em>los platos y la mesa.</em>"
				description="Estas fotografías proceden del perfil de Restaurante MLC en Google Maps: la fachada del hotel al atardecer, las hamburguesas, el sándwich, los platos y el vino."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en la mesa.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: de martes a jueves de 7:00 a 22:00, viernes y sábado hasta las 23:00, domingo hasta las 17:00 y lunes cerrado. El restaurante anunció en Google «abierto todos los días desde las 7:30», así que conviene llamar para confirmar."
				mapTitle="Mapa de Restaurante MLC en la carretera de Ergoyen, 18D, Urnieta (Gipuzkoa)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Restaurante MLC · Urnieta"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva llamando al 694 90 63 82. La ficha de Google marca acceso para sillas de ruedas, asientos adaptados y aparcamiento adaptado, y admite perros. El restaurante se presenta como amigable con la comunidad LGBTQ+."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Restaurante MLC"
		/>
	</body>
</html>
