---
import Fab from "../components/Fab.astro";
import "../styles/global.css";
import "remixicon/fonts/remixicon.css";

const { title, description, dataTheme = "malaga-light" } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme={dataTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta
      name="author"
      content="Jose Aguilar - linkedin.com/in/jose-antonio-aguilar-granados"
    />
    <!-- Título -->
    <title>
      Forja Francisco Javier e Hijos – Herrería y carpintería metálica en Cabra
      (Córdoba)
    </title>
    <!-- Descripción -->
    <meta
      name="description"
      content="Empresa familiar de herrería y carpintería metálica en Cabra (Córdoba). Más de 15 años de experiencia fabricando rejas, puertas, ventanas, escaleras y estructuras metálicas. Calidad garantizada, presupuestos ajustados y cumplimiento de plazos."
    />
    <!-- Palabras clave (opcional, ya poco usadas para SEO pero puede ayudar) -->
    <meta
      name="keywords"
      content="herrería, carpintería metálica, rejas de seguridad, puertas metálicas, ventanas de hierro, escaleras metálicas, estructuras metálicas, Cabra, Córdoba"
    />
    <!-- Open Graph (para redes sociales) -->
    <meta
      property="og:title"
      content="Forja Francisco Javier e Hijos – Herrería y carpintería metálica"
    />
    <meta
      property="og:description"
      content="Fabricamos e instalamos rejas, puertas, ventanas, escaleras y estructuras metálicas en Cabra (Córdoba). Empresa con más de 15 años de experiencia."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://franciscoforja.vercel.app/" />
    <meta
      property="og:image"
      content="https://franciscoforja.vercel.app/a5018e1d0e36bec5ba5773efca4c174f.jpg"
    />
    <!-- reemplazar con URL real de imagen -->
    <meta property="og:site_name" content="Forja Francisco Javier e Hijos" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Forja Francisco Javier e Hijos – Herrería y carpintería metálica"
    />
    <meta
      name="twitter:description"
      content="Empresa familiar en Cabra (Córdoba) especializada en rejas, puertas, ventanas y estructuras metálicas. Calidad, experiencia y garantía."
    />
    <meta
      name="twitter:image"
      content="https://franciscoforja.vercel.app/a5018e1d0e36bec5ba5773efca4c174f.jpg"
    />
    <!-- misma imagen o alguna destacada -->
  </head>
  <body>
    <Fab />
    <slot />
  </body>
</html>
