---
import QRImg from '@assets/QR/franciscoforja.svg';
import { Layout } from '@astro-components';
import Fab from '../components/Fab.astro';
import Favicon from '../components/Favicon.astro';
import Footer from '../components/Footer.astro';
import Topbar from '../components/Topbar.astro';

import '../styles/index.css';
import 'remixicon/fonts/remixicon.css';

const {
	title = 'Forja Francisco Javier e Hijos – Herrería y carpintería metálica en Cabra(Córdoba)',
	description = 'Empresa familiar de herrería y carpintería metálica en Cabra (Córdoba). Más de 15 años de experiencia fabricando rejas, puertas, ventanas, escaleras y estructuras metálicas. Calidad garantizada, presupuestos ajustados y cumplimiento de plazos.',
	dataTheme = 'malaga-light',
} = Astro.props;
---

<Layout
	QRProps={{
		src: QRImg,
		alt: 'Código QR para compartir el sitio web de Forja Francisco Javier e Hijos',
		label: 'Escanea para compartir',
	}}
	Fab={Fab}
	JSONLD
	dataTheme
	keywords="herrería, carpintería metálica, rejas de seguridad, puertas metálicas, ventanas de hierro, escaleras metálicas, estructuras metálicas, Cabra, Córdoba"
	canonical
	ogTitle="Forja Francisco Javier e Hijos – Herrería y carpintería metálica"
	ogUrl="https://franciscoforja.vercel.app/"
	ogSitename="Forja Francisco Javier e Hijos"
	ogImage="https://franciscoforja.vercel.app/a5018e1d0e36bec5ba5773efca4c174f.jpg"
	ogDescription="Fabricamos e instalamos rejas, puertas, ventanas, escaleras y estructuras metálicas en Cabra (Córdoba). Empresa con más de 15 años de experiencia."
	author="Jose Aguilar - linkedin.com/in/jose-antonio-aguilar-granados"
	themeColor
	title={title}
	description={description}
	dataTheme={dataTheme}
	Favicon={Favicon}
	Topbar={Topbar}
	Footer={Footer}
>
	<slot /></Layout
>
<!-- description="Empresa familiar en Cabra (Córdoba) especializada en rejas, puertas, ventanas y estructuras metálicas. Calidad, experiencia y garantía." -->
