										class="h-36 w-full rounded-lg object-cover shadow-lg"
										src="https://readdy.ai/api/search-image?query=Aluminum%20window%20frames%20installation%2C%20modern%20residential%20building%2C%20clean%20lines%2C%20professional%20glazing%20work%2C%20contemporary%20architecture%2C%20natural%20lighting%2C%20high%20quality%20aluminum%20finish&width=300&height=300&seq=window-1&orientation=squarish"
									/>
								</div><div class="mt-8 space-y-4">
									<img
										alt="Escalera metálica"
										class="h-36 w-full rounded-lg object-cover shadow-lg"
										src="https://readdy.ai/api/search-image?query=Steel%20staircase%20with%20modern%20railings%2C%20industrial%20design%2C%20professional%20metalwork%2C%20architectural%20structure%2C%20clean%20geometric%20lines%2C%20contemporary%20building%20interior%2C%20high%20quality%20steel%20fabrication&width=300&height=300&seq=stairs-1&orientation=squarish"
