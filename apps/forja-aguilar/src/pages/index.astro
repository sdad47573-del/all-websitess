<CustomLayout>
	<main>
		<section
			id="inicio"
			class="relative min-h-screen bg-cover bg-center bg-no-repeat"
			style='background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url("https://readdy.ai/api/search-image?query=Professional%20metalworking%20workshop%20with%20modern%20equipment%2C%20welding%20sparks%2C%20steel%20structures%2C%20industrial%20setting%20with%20clean%20organized%20workspace%2C%20dramatic%20lighting%20highlighting%20metal%20fabrication%20tools%20and%20finished%20metal%20products%2C%20professional%20photography%20style%20with%20dark%20industrial%20background&width=1920&height=1080&seq=hero-metallurgy&orientation=landscape");'
		>
			<div class="flex min-h-screen items-center bg-cover bg-center bg-no-repeat backdrop-blur-xs">
				<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
					<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
						<div class="text-white">
							<h1 class="mb-6 text-4xl leading-tight font-bold md:text-6xl">
								Expertos en<span class="text-primary block">Herrería y Metal</span>
							</h1><p class="mb-8 text-xl leading-relaxed text-gray-100 md:text-2xl">
								Fabricamos e instalamos estructuras metálicas, rejas de seguridad, puertas, ventanas
								de aluminio y todo tipo de trabajos en metal con la más alta calidad y durabilidad.
							</p><div class="flex flex-col gap-4 sm:flex-row">
								<a
									href={HREF_WHATSAPP}
									target="_blank"
									rel="noopener noreferrer"
									class="btn btn-primary btn-xl px-8 py-4 text-lg font-semibold transition-colors"
									>Solicitar presupuesto</a
								>
								<a
									href="/#proyectos"
									class="btn btn-outline btn-xl px-8 py-4 text-lg font-semibold transition-colors"
									>Ver Proyectos</a
								>
							</div>
						</div><div class="hidden lg:block">
							<div class="grid grid-cols-2 gap-4">
								<div class="space-y-4">
									<img
										alt="Reja de seguridad moderna"
										class="h-48 w-full rounded-lg object-cover shadow-lg"
										src="https://readdy.ai/api/search-image?query=Modern%20steel%20security%20gate%20with%20geometric%20patterns%2C%20professional%20installation%2C%20clean%20industrial%20design%2C%20high%20quality%20metalwork%20craftsmanship%2C%20residential%20setting%20with%20contemporary%20architecture%20background&width=300&height=400&seq=gate-1&orientation=portrait"
									/><img
