<Layout
  title="Forja y Carpintería metálica Francisco Javier"
  description="Empieza hoy desde 0€, crea tu presencia online en menos de 7 días. Webs rápidas, modernas y optimizadas."
>
  <div id="root">
    <div class="min-h-screen bg-white">
      <Topbar />
      <main>
        <section
          id="inicio"
          class="relative min-h-screen bg-cover bg-center bg-no-repeat"
          style='background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url("https://readdy.ai/api/search-image?query=Professional%20metalworking%20workshop%20with%20modern%20equipment%2C%20welding%20sparks%2C%20steel%20structures%2C%20industrial%20setting%20with%20clean%20organized%20workspace%2C%20dramatic%20lighting%20highlighting%20metal%20fabrication%20tools%20and%20finished%20metal%20products%2C%20professional%20photography%20style%20with%20dark%20industrial%20background&width=1920&height=1080&seq=hero-metallurgy&orientation=landscape");'
        >
          <div
            class="backdrop-blur-xs min-h-screen flex items-center bg-cover bg-center bg-no-repeat"
          >
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
