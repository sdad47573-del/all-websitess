---
import Footer from "../components/Footer.astro";
import Topbar from "../components/Topbar.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Sur Digital Málaga | Tu Presencia Digital Comienza Aquí | Agencia de Marketing Web Online"
  description="Empieza hoy desde 0€, crea tu presencia online en menos de 7 días. Webs rápidas, modernas y optimizadas."
>
  <div id="root">
    <div class="min-h-screen bg-white">
      <Topbar />
      <section
        class="bg-cover bg-center"
        style='background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.4)), url("https://readdy.ai/api/search-image?query=Master%20blacksmith%20with%20decades%20of%20experience%20working%20at%20traditional%20forge%20with%20glowing%20fire%2C%20weathered%20hands%20holding%20hammer%20and%20tongs%2C%20authentic%20workshop%20filled%20with%20handcrafted%20tools%2C%20warm%20orange%20glow%20from%20forge%20fire%2C%20portrait%20of%20skilled%20artisan%20with%20proud%20expression%20showing%20years%20of%20dedication%20to%20metalwork%20craftsmanship&width=1920&height=1080&seq=herrero-maestro&orientation=landscape");'
      >
        <div class="backdrop-blur-xs items-center py-24">
          <div class="flex items-center justify-center">
            <div class="text-center text-white max-w-4xl mx-auto px-4">
              <h1 class="text-5xl md:text-6xl font-bold mb-6">
                Maestro en el Arte del Hierro
              </h1><p class="text-xl md:text-2xl mb-8 leading-relaxed">
                Más de 30 años forjando tradición, calidad y excelencia en cada
                pieza
              </p><div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a
                  href="/trayectoria/#mi-historia"
                  class="btn btn-primary btn-xl px-8 py-4 text-lg font-semibold transition-colors"
                  >Conoce Mi Historia</a
                >
                <a
                  href="/#proyectos"
                  class="btn btn-outline btn-xl px-8 py-4 font-semibold text-lg transition-colors"
                  >Ver Proyectos</a
                >
              </div>
            </div>
            <div
              class="absolute bottom-2 left-1/2 transform -translate-x-1/2 text-white animate-bounce"
            >
              <i class="ri-arrow-down-line text-2xl"></i>
            </div>
          </div>
        </div>
      </section>
      <section class="py-20 bg-gray-50" id="mi-historia">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-900 mb-4">
              Mi Trayectoria Profesional
            </h2><p class="text-xl text-gray-600 max-w-3xl mx-auto">
              Un camino de dedicación, aprendizaje continuo y pasión por el arte
              del hierro
            </p>
          </div><div class="relative">
            <div
              class="absolute left-1/2 transform -translate-x-1/2 w-1 bg-primary h-full hidden md:block"
            >
            </div>
            <div class="relative mb-12 md:mb-16 md:pr-1/2">
              <div
                class="absolute left-1/2 transform -translate-x-1/2 -translate-y-1/3 w-12 h-12 badge badge-primary hidden md:flex"
              >
                <i class="ri-seedling-line text-xl"></i>
              </div><div
                class="bg-white rounded-xl shadow-lg overflow-hidden md:mr-2"
              >
                <div class="md:flex">
                  <div class="md:w-1/2 md:order-1">
                    <img
                      alt="Los Primeros Pasos"
                      class="w-full h-64 object-cover object-top"
                      src="https://readdy.ai/api/search-image?query=Young%20apprentice%20blacksmith%20learning%20traditional%20forging%20techniques%20from%20elderly%20master%20craftsman%20in%20rustic%20workshop%2C%20vintage%20tools%20and%20anvil%2C%20warm%20lighting%20from%20forge%20fire%2C%20passing%20down%20generations%20of%20metalwork%20knowledge%20and%20skills&width=500&height=300&seq=aprendiz-1992&orientation=landscape"
                    />
                  </div><div class="md:w-1/2 p-8 md:order-2">
                    <div class="flex items-center mb-4 md:hidden">
                      <div class="w-10 h-10 badge badge-primary mr-4">
                        <i class="ri-seedling-line text-lg"></i>
                      </div>
                      <span class="text-2xl font-bold text-primary">1992</span>
                    </div><span
                      class="text-2xl font-bold text-primary hidden md:block mb-4"
                      >1992</span
                    ><h3 class="text-2xl font-bold text-gray-900 mb-4">
                      Los Primeros Pasos
                    </h3><p class="text-gray-700 leading-relaxed">
                      Comencé mi aprendizaje en el taller de mi abuelo, donde
                      descubrí la pasión por el trabajo del hierro. Aprendí las
                      técnicas tradicionales de forja que han sido transmitidas
                      de generación en generación.
                    </p>
                  </div>
                </div>
              </div>
            </div>
            <div class="relative mb-12 md:mb-16 md:pl-1/2">
              <div
                class="absolute left-1/2 transform -translate-x-1/2 -translate-y-1/3 w-12 h-12 badge badge-primary hidden md:flex"
              >
                <i class="ri-graduation-cap-line text-xl"></i>
              </div><div
                class="bg-white rounded-xl shadow-lg overflow-hidden md:ml-2"
              >
                <div class="md:flex">
                  <div class="md:w-1/2 md:order-2">
                    <img
                      alt="Formación Profesional"
                      class="w-full h-64 object-cover object-top"
                      src="https://readdy.ai/api/search-image?query=Professional%20metalwork%20training%20workshop%20with%20students%20learning%20advanced%20welding%20and%20forging%20techniques%2C%20modern%20equipment%20combined%20with%20traditional%20methods%2C%20educational%20environment%20with%20safety%20gear%20and%20professional%20instruction&width=500&height=300&seq=formacion-1998&orientation=landscape"
                    />
                  </div><div class="md:w-1/2 p-8 md:order-1">
                    <div class="flex items-center mb-4 md:hidden">
                      <div class="w-10 h-10 badge badge-primary mr-4">
                        <i class="ri-graduation-cap-line text-lg"></i>
                      </div><span class="text-2xl font-bold text-primary"
                        >1998</span
                      >
                    </div><span
                      class="text-2xl font-bold text-primary hidden md:block mb-4"
                      >1998</span
                    ><h3 class="text-2xl font-bold text-gray-900 mb-4">
                      Formación Profesional
                    </h3><p class="text-gray-700 leading-relaxed">
                      Completé mi formación en la Escuela de Artes y Oficios,
                      especializándome en herrería artística y estructural.
                      Obtuve las certificaciones necesarias para trabajar en
                      proyectos de gran envergadura.
                    </p>
                  </div>
                </div>
              </div>
            </div><div class="relative mb-12 md:mb-16 md:pr-1/2">
              <div
                class="absolute left-1/2 transform -translate-x-1/2 -translate-y-1/3 w-12 h-12 badge badge-primary hidden md:flex"
              >
                <i class="ri-hammer-line text-xl"></i>
              </div><div
                class="bg-white rounded-xl shadow-lg overflow-hidden md:mr-2"
              >
                <div class="md:flex">
                  <div class="md:w-1/2 md:order-1">
                    <img
                      alt="Primer Taller Propio"
                      class="w-full h-64 object-cover object-top"
                      src="https://readdy.ai/api/search-image?query=Small%20independent%20blacksmith%20workshop%20with%20basic%20forge%20equipment%2C%20organized%20tools%20on%20walls%2C%20first%20custom%20metalwork%20projects%20displayed%2C%20humble%20beginning%20of%20professional%20metalworking%20business%20with%20personal%20touch&width=500&height=300&seq=taller-2003&orientation=landscape"
                    />
                  </div><div class="md:w-1/2 p-8 md:order-2">
                    <div class="flex items-center mb-4 md:hidden">
                      <div class="w-10 h-10 badge badge-primary mr-4">
                        <i class="ri-hammer-line text-lg"></i>
                      </div><span class="text-2xl font-bold text-primary"
                        >2003</span
                      >
                    </div><span
                      class="text-2xl font-bold text-primary hidden md:block mb-4"
                      >2003</span
                    ><h3 class="text-2xl font-bold text-gray-900 mb-4">
                      Primer Taller Propio
                    </h3><p class="text-gray-700 leading-relaxed">
                      Establecí mi primer taller independiente, comenzando con
                      proyectos residenciales. La calidad del trabajo y la
                      atención al detalle me permitieron ganar la confianza de
                      mis primeros clientes.
                    </p>
                  </div>
                </div>
              </div>
            </div><div class="relative mb-12 md:mb-16 md:pl-1/2">
              <div
                class="absolute left-1/2 transform -translate-x-1/2 -translate-y-1/3 w-12 h-12 badge-primary badge hidden md:flex"
              >
                <i class="ri-building-line text-xl"></i>
              </div><div
                class="bg-white rounded-xl shadow-lg overflow-hidden md:ml-2"
              >
                <div class="md:flex">
                  <div class="md:w-1/2 md:order-2">
                    <img
                      alt="Expansión del Negocio"
                      class="w-full h-64 object-cover object-top"
                      src="https://readdy.ai/api/search-image?query=Expanded%20metalwork%20workshop%20with%20modern%20equipment%20alongside%20traditional%20forge%2C%20larger%20workspace%20with%20multiple%20work%20stations%2C%20combination%20of%20advanced%20welding%20technology%20and%20classic%20blacksmith%20tools%2C%20professional%20business%20growth&width=500&height=300&seq=expansion-2008&orientation=landscape"
                    />
                  </div><div class="md:w-1/2 p-8 md:order-1">
                    <div class="flex items-center mb-4 md:hidden">
                      <div class="w-10 h-10 badge-primary badge mr-4">
                        <i class="ri-building-line text-lg"></i>
                      </div><span class="text-2xl font-bold text-primary"
                        >2008</span
                      >
                    </div><span
                      class="text-2xl font-bold text-primary hidden md:block mb-4"
                      >2008</span
                    ><h3 class="text-2xl font-bold text-gray-900 mb-4">
                      Expansión del Negocio
                    </h3><p class="text-gray-700 leading-relaxed">
                      Amplié el taller e incorporé nuevas tecnologías sin perder
                      la esencia artesanal. Comencé a trabajar en proyectos
                      comerciales e industriales de mayor complejidad.
                    </p>
                  </div>
                </div>
              </div>
            </div><div class="relative mb-12 md:mb-16 md:pr-1/2">
              <div
                class="absolute left-1/2 transform -translate-x-1/2 -translate-y-1/3 w-12 h-12 badge-primary badge hidden md:flex"
              >
                <i class="ri-award-line text-xl"></i>
              </div><div
                class="bg-white rounded-xl shadow-lg overflow-hidden md:mr-2"
              >
                <div class="md:flex">
                  <div class="md:w-1/2 md:order-1">
                    <img
                      alt="Reconocimiento Artístico"
                      class="w-full h-64 object-cover object-top"
                      src="https://readdy.ai/api/search-image?query=Artistic%20wrought%20iron%20exhibition%20displaying%20masterful%20decorative%20metalwork%20pieces%2C%20elegant%20gallery%20setting%20with%20spotlights%20highlighting%20intricate%20forged%20sculptures%20and%20functional%20art%2C%20recognition%20of%20artistic%20craftsmanship&width=500&height=300&seq=reconocimiento-2015&orientation=landscape"
                    />
                  </div><div class="md:w-1/2 p-8 md:order-2">
                    <div class="flex items-center mb-4 md:hidden">
                      <div class="w-10 h-10 badge-primary badge mr-4">
                        <i class="ri-award-line text-lg"></i>
                      </div><span class="text-2xl font-bold text-primary"
                        >2015</span
                      >
                    </div><span
                      class="text-2xl font-bold text-primary hidden md:block mb-4"
                      >2015</span
                    ><h3 class="text-2xl font-bold text-gray-900 mb-4">
                      Reconocimiento Artístico
                    </h3><p class="text-gray-700 leading-relaxed">
                      Mis trabajos de forja artística comenzaron a ser
                      reconocidos en exposiciones y concursos. Participé en la
                      restauración de edificios históricos, preservando técnicas
                      ancestrales.
                    </p>
                  </div>
                </div>
              </div>
            </div><div class="relative mb-12 md:mb-16 md:pl-1/2">
              <div
                class="absolute left-1/2 transform -translate-x-1/2 -translate-y-1/3 w-12 h-12 badge-primary badge hidden md:flex"
              >
                <i class="ri-medal-line text-xl"></i>
              </div><div
                class="bg-white rounded-xl shadow-lg overflow-hidden md:ml-2"
              >
                <div class="md:flex">
                  <div class="md:w-1/2 md:order-2">
                    <img
                      alt="Maestro Artesano"
                      class="w-full h-64 object-cover object-top"
                      src="https://readdy.ai/api/search-image?query=Master%20craftsman%20blacksmith%20teaching%20young%20apprentices%20traditional%20forging%20techniques%2C%20experienced%20hands%20guiding%20students%20at%20anvil%2C%20workshop%20filled%20with%20handcrafted%20tools%2C%20passing%20knowledge%20to%20next%20generation%20of%20metalworkers&width=500&height=300&seq=maestro-2020&orientation=landscape"
                    />
                  </div><div class="md:w-1/2 p-8 md:order-1">
                    <div class="flex items-center mb-4 md:hidden">
                      <div class="w-10 h-10 badge-primary badge mr-4">
                        <i class="ri-medal-line text-lg"></i>
                      </div><span class="text-2xl font-bold text-primary"
                        >2020</span
                      >
                    </div><span
                      class="text-2xl font-bold text-primary hidden md:block mb-4"
                      >2020</span
                    ><h3 class="text-2xl font-bold text-gray-900 mb-4">
                      Maestro Artesano
                    </h3><p class="text-gray-700 leading-relaxed">
                      Obtuve el título de Maestro Artesano, el máximo
                      reconocimiento en mi oficio. Ahora también me dedico a
                      enseñar las técnicas tradicionales a las nuevas
                      generaciones.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section><section class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-900 mb-4">
              Experiencia y Especialidades
            </h2><p class="text-xl text-gray-600 max-w-3xl mx-auto">
              Tres décadas perfeccionando el arte del hierro en todas sus formas
            </p>
          </div><div class="grid lg:grid-cols-2 gap-12 mb-16">
            <div>
              <h3
                class="text-2xl font-bold text-gray-900 mb-8 flex items-center"
              >
                <i class="ri-tools-line text-primary mr-3"></i>Habilidades
                Técnicas
              </h3><div class="space-y-6">
                <div>
                  <div class="flex justify-between items-center mb-2">
                    <span class="font-semibold text-gray-900"
                      >Forja Tradicional</span
                    ><span class="text-primary font-bold">95%</span>
                  </div><div class="w-full bg-gray-200 rounded-full h-3 mb-2">
                    <div
                      class="bg-primary h-3 rounded-full transition-all duration-1000"
                      style="width: 95%;"
                    >
                    </div>
                  </div><p class="text-sm text-gray-600">
                    Técnicas ancestrales transmitidas de generación en
                    generación
                  </p>
                </div><div>
                  <div class="flex justify-between items-center mb-2">
                    <span class="font-semibold text-gray-900"
                      >Soldadura Profesional</span
                    ><span class="text-primary font-bold">90%</span>
                  </div><div class="w-full bg-gray-200 rounded-full h-3 mb-2">
                    <div
                      class="bg-primary h-3 rounded-full transition-all duration-1000"
                      style="width: 90%;"
                    >
                    </div>
                  </div><p class="text-sm text-gray-600">
                    TIG, MIG y soldadura especializada en diversos materiales
                  </p>
                </div><div>
                  <div class="flex justify-between items-center mb-2">
                    <span class="font-semibold text-gray-900"
                      >Diseño Estructural</span
                    ><span class="text-primary font-bold">85%</span>
                  </div><div class="w-full bg-gray-200 rounded-full h-3 mb-2">
                    <div
                      class="bg-primary h-3 rounded-full transition-all duration-1000"
                      style="width: 85%;"
                    >
                    </div>
                  </div><p class="text-sm text-gray-600">
                    Cálculo y diseño de estructuras metálicas complejas
                  </p>
                </div><div>
                  <div class="flex justify-between items-center mb-2">
                    <span class="font-semibold text-gray-900"
                      >Restauración Histórica</span
                    ><span class="text-primary font-bold">88%</span>
                  </div><div class="w-full bg-gray-200 rounded-full h-3 mb-2">
                    <div
                      class="bg-primary h-3 rounded-full transition-all duration-1000"
                      style="width: 88%;"
                    >
                    </div>
                  </div><p class="text-sm text-gray-600">
                    Preservación y restauración de patrimonio metálico
                  </p>
                </div>
              </div>
            </div><div class="relative">
              <img
                alt="Maestro herrero trabajando"
                class="w-full h-full object-cover object-top rounded-xl shadow-lg"
                src="https://readdy.ai/api/search-image?query=Experienced%20master%20blacksmith%20working%20at%20forge%20with%20intense%20concentration%2C%20skilled%20hands%20shaping%20glowing%20hot%20metal%20with%20precision%2C%20workshop%20filled%20with%20traditional%20tools%2C%20decades%20of%20expertise%20visible%20in%20every%20movement%2C%20authentic%20craftsmanship%20in%20action&width=600&height=500&seq=maestro-trabajando&orientation=landscape"
              /><div
                class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent rounded-xl"
              >
              </div><div class="absolute bottom-6 left-6 text-white">
                <h4 class="text-xl font-bold mb-2">
                  30+ Años de Experiencia
                </h4><p class="text-sm opacity-90">
                  Perfeccionando cada técnica día a día
                </p>
              </div>
            </div>
          </div><div>
            <h3 class="text-2xl font-bold text-gray-900 mb-8 text-center">
              Áreas de Especialización
            </h3><div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
              <div
                class="bg-gray-50 rounded-xl p-6 text-center hover:shadow-lg transition-shadow"
              >
                <div
                  class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-4"
                >
                  <i class="ri-palette-line text-2xl text-white"></i>
                </div><h4 class="text-lg font-bold text-gray-900 mb-3">
                  Herrería Artística
                </h4><p class="text-gray-600 text-sm mb-4 leading-relaxed">
                  Creación de piezas únicas con técnicas tradicionales de forja
                </p><div
                  class="bg-orange-100 text-orange-700 px-3 py-1 rounded-full text-xs font-semibold"
                >
                  150+ proyectos
                </div>
              </div><div
                class="bg-gray-50 rounded-xl p-6 text-center hover:shadow-lg transition-shadow"
              >
                <div
                  class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-4"
                >
                  <i class="ri-building-2-line text-2xl text-white"></i>
                </div><h4 class="text-lg font-bold text-gray-900 mb-3">
                  Estructuras Metálicas
                </h4><p class="text-gray-600 text-sm mb-4 leading-relaxed">
                  Diseño y construcción de estructuras para edificación
                </p><div
                  class="bg-orange-100 text-orange-700 px-3 py-1 rounded-full text-xs font-semibold"
                >
                  80+ estructuras
                </div>
              </div><div
                class="bg-gray-50 rounded-xl p-6 text-center hover:shadow-lg transition-shadow"
              >
                <div
                  class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-4"
                >
                  <i class="ri-shield-check-line text-2xl text-white"></i>
                </div><h4 class="text-lg font-bold text-gray-900 mb-3">
                  Seguridad Residencial
                </h4><p class="text-gray-600 text-sm mb-4 leading-relaxed">
                  Rejas, puertas y elementos de protección personalizados
                </p><div
                  class="bg-orange-100 text-orange-700 px-3 py-1 rounded-full text-xs font-semibold"
                >
                  300+ instalaciones
                </div>
              </div><div
                class="bg-gray-50 rounded-xl p-6 text-center hover:shadow-lg transition-shadow"
              >
                <div
                  class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-4"
                >
                  <i class="ri-ancient-gate-line text-2xl text-white"></i>
                </div><h4 class="text-lg font-bold text-gray-900 mb-3">
                  Restauración Patrimonial
                </h4><p class="text-gray-600 text-sm mb-4 leading-relaxed">
                  Conservación de elementos metálicos históricos
                </p><div
                  class="bg-orange-100 text-orange-700 px-3 py-1 rounded-full text-xs font-semibold"
                >
                  25+ restauraciones
                </div>
              </div>
            </div>
          </div>
        </div>
      </section><section class="py-20 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-900 mb-4">
              Logros y Reconocimientos
            </h2><p class="text-xl text-gray-600 max-w-3xl mx-auto">
              Una trayectoria marcada por la excelencia y el reconocimiento
              profesional
            </p>
          </div><div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
            <div class="bg-white rounded-xl p-6 text-center shadow-lg">
              <div
                class="w-12 h-12 bg-primary rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <i class="ri-time-line text-xl text-white"></i>
              </div><div class="text-3xl font-bold text-gray-900 mb-2">
                30+
              </div><div class="text-gray-600 text-sm">Años de Experiencia</div>
            </div><div class="bg-white rounded-xl p-6 text-center shadow-lg">
              <div
                class="w-12 h-12 bg-primary rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <i class="ri-checkbox-circle-line text-xl text-white"></i>
              </div><div class="text-3xl font-bold text-gray-900 mb-2">
                500+
              </div><div class="text-gray-600 text-sm">
                Proyectos Completados
              </div>
            </div><div class="bg-white rounded-xl p-6 text-center shadow-lg">
              <div
                class="w-12 h-12 bg-primary rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <i class="ri-ancient-gate-line text-xl text-white"></i>
              </div><div class="text-3xl font-bold text-gray-900 mb-2">
                25+
              </div><div class="text-gray-600 text-sm">
                Restauraciones Históricas
              </div>
            </div><div class="bg-white rounded-xl p-6 text-center shadow-lg">
              <div
                class="w-12 h-12 bg-primary rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <i class="ri-award-line text-xl text-white"></i>
              </div><div class="text-3xl font-bold text-gray-900 mb-2">
                15+
              </div><div class="text-gray-600 text-sm">
                Premios y Reconocimientos
