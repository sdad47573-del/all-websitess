			style='background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url("https://readdy.ai/api/search-image?query=Professional%20blacksmith%20working%20with%20hot%20metal%20in%20traditional%20forge%20workshop%2C%20sparks%20flying%2C%20industrial%20metalworking%20scene%20with%20anvil%20and%20hammer%2C%20dramatic%20lighting%2C%20rustic%20workshop%20environment%20with%20metal%20tools%20and%20equipment%2C%20authentic%20craftsmanship%20atmosphere&width=1920&height=1080&seq=hero-forge-1&orientation=landscape");'
