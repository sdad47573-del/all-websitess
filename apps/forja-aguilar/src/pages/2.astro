---
import CustomLayout from '../layouts/CustomLayout.astro';
---

<CustomLayout>
	<div class="min-h-screen bg-white">
		<header class="fixed top-0 z-50 w-full bg-white shadow-lg">
			<div class="container mx-auto px-4 py-4">
				<div class="flex items-center justify-between">
					<div class="flex items-center space-x-3">
						<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-600">
							<i class="ri-hammer-line text-xl text-white"></i>
						</div><h1
							class="text-2xl font-bold text-gray-800"
							style="font-family: Pacifico, serif;"
						>
							Herrería Artesanal
						</h1>
					</div><nav class="hidden items-center space-x-8 md:flex">
						<button
							class="cursor-pointer font-medium whitespace-nowrap text-gray-700 transition-colors hover:text-amber-600"
							>Inicio</button
						><button
							class="cursor-pointer font-medium whitespace-nowrap text-gray-700 transition-colors hover:text-amber-600"
							>Servicios</button
						><button
							class="cursor-pointer font-medium whitespace-nowrap text-gray-700 transition-colors hover:text-amber-600"
							>Galería</button
						><button
							class="cursor-pointer font-medium whitespace-nowrap text-gray-700 transition-colors hover:text-amber-600"
							>Nosotros</button
						><button
							class="cursor-pointer rounded-lg bg-amber-600 px-6 py-2 whitespace-nowrap text-white transition-colors hover:bg-amber-700"
							>Contacto</button
						>
					</nav><button class="flex h-8 w-8 cursor-pointer items-center justify-center md:hidden"
						><i class="ri-menu-line text-2xl text-gray-700"></i></button
					>
				</div>
			</div>
		</header><section
			id="inicio"
			class="relative flex min-h-screen items-center justify-center bg-cover bg-center bg-no-repeat"
			style='background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url("https://readdy.ai/api/search-image?query=Professional%20blacksmith%20workshop%20with%20traditional%20forge%20fire%2C%20anvil%2C%20hammers%20and%20metal%20working%20tools%2C%20industrial%20atmosphere%20with%20warm%20orange%20glow%20from%20forge%20flames%2C%20dark%20background%20with%20sparks%20flying%2C%20authentic%20craftsmanship%20environment%2C%20high%20quality%20photography%2C%20dramatic%20lighting&width=1920&height=1080&seq=hero-blacksmith&orientation=landscape");'
		>
			<div class="container mx-auto mt-16 px-4 py-20">
				<div class="mx-auto w-full max-w-4xl text-center text-white">
					<h1 class="mb-6 text-5xl leading-tight font-bold md:text-7xl">
						Maestría en<span class="block text-amber-400">Hierro Forjado</span>
					</h1><p class="mx-auto mb-8 max-w-3xl text-xl leading-relaxed text-gray-200 md:text-2xl">
						Creamos obras únicas en metal con más de 15 años de experiencia. Desde rejas de
						seguridad hasta estructuras arquitectónicas personalizadas.
					</p><div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
						<button
							class="cursor-pointer rounded-lg bg-amber-600 px-8 py-4 text-lg font-semibold whitespace-nowrap text-white shadow-lg transition-colors hover:bg-amber-700"
							>Solicitar presupuesto</button
						><button
							class="cursor-pointer rounded-lg border-2 border-white px-8 py-4 text-lg font-semibold whitespace-nowrap text-white transition-colors hover:bg-white hover:text-gray-900"
							>Ver Servicios</button
						>
					</div><div class="mt-16 grid grid-cols-1 gap-8 text-center md:grid-cols-3">
						<div class="rounded-lg bg-white/10 p-6 backdrop-blur-sm">
							<div
								class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-amber-600"
							>
								<i class="ri-award-line text-2xl text-white"></i>
							</div><h3 class="mb-2 text-xl font-semibold">15+ Años</h3><p class="text-gray-300">
								de experiencia
							</p>
						</div><div class="rounded-lg bg-white/10 p-6 backdrop-blur-sm">
							<div
								class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-amber-600"
							>
								<i class="ri-tools-line text-2xl text-white"></i>
							</div><h3 class="mb-2 text-xl font-semibold">500+</h3><p class="text-gray-300">
								proyectos realizados
							</p>
						</div><div class="rounded-lg bg-white/10 p-6 backdrop-blur-sm">
							<div
								class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-amber-600"
							>
								<i class="ri-shield-check-line text-2xl text-white"></i>
							</div><h3 class="mb-2 text-xl font-semibold">Garantía</h3><p class="text-gray-300">
								en todos los trabajos
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="galeria" class="bg-white py-20">
			<div class="container mx-auto px-4">
				<div class="mb-16 text-center">
					<h2 class="mb-6 text-4xl font-bold text-gray-800 md:text-5xl">Galería de Trabajos</h2><p
						class="mx-auto mb-8 max-w-3xl text-xl text-gray-600"
					>
						Descubre algunos de nuestros proyectos más destacados. Cada pieza refleja nuestra
						dedicación a la excelencia y el detalle.
					</p><div class="mb-12 flex flex-wrap justify-center gap-3">
						<button
							class="cursor-pointer rounded-full bg-amber-600 px-6 py-2 font-medium whitespace-nowrap text-white transition-colors"
							>Todos</button
						><button
							class="cursor-pointer rounded-full bg-gray-200 px-6 py-2 font-medium whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-300"
							>Rejas</button
						><button
							class="cursor-pointer rounded-full bg-gray-200 px-6 py-2 font-medium whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-300"
							>Puertas</button
						><button
							class="cursor-pointer rounded-full bg-gray-200 px-6 py-2 font-medium whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-300"
							>Escaleras</button
						><button
							class="cursor-pointer rounded-full bg-gray-200 px-6 py-2 font-medium whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-300"
							>Estructuras</button
						><button
							class="cursor-pointer rounded-full bg-gray-200 px-6 py-2 font-medium whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-300"
							>Ventanas</button
						><button
							class="cursor-pointer rounded-full bg-gray-200 px-6 py-2 font-medium whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-300"
							>Mobiliario</button
						>
					</div>
				</div><div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
					<div
						class="group relative cursor-pointer overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover:shadow-xl"
					>
						<div class="relative h-64 overflow-hidden">
							<img
								alt="Reja Decorativa Residencial"
								class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-110"
								src="https://readdy.ai/api/search-image?query=Elegant%20decorative%20wrought%20iron%20window%20grille%20with%20intricate%20scrollwork%20patterns%2C%20black%20metal%20artistic%20design%2C%20residential%20building%20facade%2C%20professional%20craftsmanship%2C%20clean%20architectural%20background%2C%20high%20quality%20detailed%20photography&width=600&height=400&seq=gallery-1&orientation=landscape"
							/><div
								class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
							>
								<div class="flex h-12 w-12 items-center justify-center rounded-full bg-white">
									<i class="ri-eye-line text-xl text-gray-800"></i>
								</div>
							</div>
						</div><div
							class="absolute right-0 bottom-0 left-0 bg-gradient-to-t from-black/80 to-transparent p-6"
						>
							<span class="mb-2 inline-block rounded-full bg-amber-600 px-3 py-1 text-xs text-white"
								>Rejas</span
							><h3 class="text-lg font-semibold text-white">Reja Decorativa Residencial</h3>
						</div>
					</div><div
						class="group relative cursor-pointer overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover:shadow-xl"
					>
						<div class="relative h-64 overflow-hidden">
							<img
								alt="Puerta Principal de Hierro"
								class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-110"
								src="https://readdy.ai/api/search-image?query=Magnificent%20wrought%20iron%20entrance%20door%20with%20ornate%20decorative%20metalwork%2C%20black%20iron%20gate%20with%20artistic%20flourishes%2C%20luxury%20residential%20entrance%2C%20professional%20installation%2C%20clean%20background%2C%20high%20quality%20architectural%20photography&width=600&height=400&seq=gallery-2&orientation=landscape"
							/><div
								class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
							>
								<div class="flex h-12 w-12 items-center justify-center rounded-full bg-white">
									<i class="ri-eye-line text-xl text-gray-800"></i>
								</div>
							</div>
						</div><div
							class="absolute right-0 bottom-0 left-0 bg-gradient-to-t from-black/80 to-transparent p-6"
						>
							<span class="mb-2 inline-block rounded-full bg-amber-600 px-3 py-1 text-xs text-white"
								>Puertas</span
							><h3 class="text-lg font-semibold text-white">Puerta Principal de Hierro</h3>
						</div>
					</div><div
						class="group relative cursor-pointer overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover:shadow-xl"
					>
						<div class="relative h-64 overflow-hidden">
							<img
								alt="Escalera con Barandal Artístico"
								class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-110"
								src="https://readdy.ai/api/search-image?query=Beautiful%20curved%20metal%20staircase%20with%20artistic%20wrought%20iron%20railings%2C%20black%20iron%20handrails%20with%20decorative%20scrollwork%2C%20elegant%20interior%20design%2C%20professional%20craftsmanship%2C%20clean%20modern%20background%2C%20high%20quality%20architectural%20photography&width=600&height=400&seq=gallery-3&orientation=landscape"
							/><div
								class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
							>
								<div class="flex h-12 w-12 items-center justify-center rounded-full bg-white">
									<i class="ri-eye-line text-xl text-gray-800"></i>
								</div>
							</div>
						</div><div
							class="absolute right-0 bottom-0 left-0 bg-gradient-to-t from-black/80 to-transparent p-6"
						>
							<span class="mb-2 inline-block rounded-full bg-amber-600 px-3 py-1 text-xs text-white"
								>Escaleras</span
							><h3 class="text-lg font-semibold text-white">Escalera con Barandal Artístico</h3>
						</div>
					</div><div
						class="group relative cursor-pointer overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover:shadow-xl"
					>
						<div class="relative h-64 overflow-hidden">
							<img
								alt="Estructura Metálica Industrial"
								class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-110"
								src="https://readdy.ai/api/search-image?query=Large%20industrial%20metal%20structure%20framework%2C%20steel%20beam%20construction%2C%20architectural%20metalwork%2C%20professional%20engineering%20project%2C%20construction%20site%2C%20clean%20industrial%20background%2C%20high%20quality%20construction%20photography&width=600&height=400&seq=gallery-4&orientation=landscape"
							/><div
								class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
							>
								<div class="flex h-12 w-12 items-center justify-center rounded-full bg-white">
									<i class="ri-eye-line text-xl text-gray-800"></i>
								</div>
							</div>
						</div><div
							class="absolute right-0 bottom-0 left-0 bg-gradient-to-t from-black/80 to-transparent p-6"
						>
							<span class="mb-2 inline-block rounded-full bg-amber-600 px-3 py-1 text-xs text-white"
								>Estructuras</span
							><h3 class="text-lg font-semibold text-white">Estructura Metálica Industrial</h3>
						</div>
					</div><div
						class="group relative cursor-pointer overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover:shadow-xl"
					>
						<div class="relative h-64 overflow-hidden">
							<img
								alt="Ventana de Hierro Forjado"
								class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-110"
								src="https://readdy.ai/api/search-image?query=Traditional%20wrought%20iron%20window%20with%20decorative%20metalwork%2C%20black%20iron%20window%20frame%20with%20artistic%20patterns%2C%20classic%20architectural%20style%2C%20building%20facade%2C%20professional%20craftsmanship%2C%20clean%20background%2C%20high%20quality%20photography&width=600&height=400&seq=gallery-5&orientation=landscape"
							/><div
								class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
							>
								<div class="flex h-12 w-12 items-center justify-center rounded-full bg-white">
									<i class="ri-eye-line text-xl text-gray-800"></i>
								</div>
							</div>
						</div><div
							class="absolute right-0 bottom-0 left-0 bg-gradient-to-t from-black/80 to-transparent p-6"
						>
							<span class="mb-2 inline-block rounded-full bg-amber-600 px-3 py-1 text-xs text-white"
								>Ventanas</span
							><h3 class="text-lg font-semibold text-white">Ventana de Hierro Forjado</h3>
						</div>
					</div><div
						class="group relative cursor-pointer overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover:shadow-xl"
					>
						<div class="relative h-64 overflow-hidden">
							<img
								alt="Mobiliario Metálico Decorativo"
								class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-110"
								src="https://readdy.ai/api/search-image?query=Custom%20wrought%20iron%20decorative%20furniture%2C%20black%20metal%20artistic%20bench%20with%20scrollwork%20design%2C%20outdoor%20garden%20furniture%2C%20professional%20craftsmanship%2C%20clean%20simple%20background%2C%20high%20quality%20product%20photography&width=600&height=400&seq=gallery-6&orientation=landscape"
							/><div
								class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
							>
								<div class="flex h-12 w-12 items-center justify-center rounded-full bg-white">
									<i class="ri-eye-line text-xl text-gray-800"></i>
								</div>
							</div>
						</div><div
							class="absolute right-0 bottom-0 left-0 bg-gradient-to-t from-black/80 to-transparent p-6"
						>
							<span class="mb-2 inline-block rounded-full bg-amber-600 px-3 py-1 text-xs text-white"
								>Mobiliario</span
							><h3 class="text-lg font-semibold text-white">Mobiliario Metálico Decorativo</h3>
						</div>
					</div>
				</div>
			</div>
		</section><section id="nosotros" class="bg-gray-50 py-20">
			<div class="container mx-auto px-4">
				<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
					<div>
						<h2 class="mb-6 text-4xl font-bold text-gray-800 md:text-5xl">
							Tradición y Experiencia
						</h2><p class="mb-6 text-lg leading-relaxed text-gray-600">
							Con más de 15 años de experiencia en el arte de la herrería, nos especializamos en
							crear piezas únicas que combinan la tradición artesanal con las técnicas más modernas.
						</p><p class="mb-8 text-lg leading-relaxed text-gray-600">
							Nuestro compromiso es ofrecer productos de la más alta calidad, utilizando materiales
							premium y procesos que garantizan durabilidad y belleza en cada proyecto.
						</p><div class="mb-8 grid grid-cols-2 gap-6">
							<div class="text-center">
								<div
									class="mx-auto mb-3 flex h-16 w-16 items-center justify-center rounded-full bg-amber-600"
								>
									<i class="ri-hammer-line text-2xl text-white"></i>
								</div><h3 class="mb-1 font-semibold text-gray-800">Artesanía</h3><p
									class="text-sm text-gray-600"
								>
									Trabajo manual especializado
								</p>
							</div><div class="text-center">
								<div
									class="mx-auto mb-3 flex h-16 w-16 items-center justify-center rounded-full bg-amber-600"
								>
									<i class="ri-shield-check-line text-2xl text-white"></i>
								</div><h3 class="mb-1 font-semibold text-gray-800">Calidad</h3><p
									class="text-sm text-gray-600"
								>
									Materiales premium
								</p>
							</div>
						</div><div class="flex flex-col gap-4 sm:flex-row">
							<button
								class="cursor-pointer rounded-lg bg-amber-600 px-8 py-3 font-semibold whitespace-nowrap text-white transition-colors hover:bg-amber-700"
								>Conoce Más</button
							><button
								class="cursor-pointer rounded-lg border-2 border-amber-600 px-8 py-3 font-semibold whitespace-nowrap text-amber-600 transition-colors hover:bg-amber-600 hover:text-white"
								>Ver Trabajos</button
							>
						</div>
					</div><div class="relative">
						<div class="relative overflow-hidden rounded-2xl shadow-2xl">
							<img
								alt="Maestro herrero trabajando"
								class="h-96 w-full object-cover object-top lg:h-[500px]"
								src="https://readdy.ai/api/search-image?query=Master%20blacksmith%20working%20at%20traditional%20forge%20with%20hammer%20and%20anvil%2C%20skilled%20craftsman%20shaping%20hot%20metal%2C%20workshop%20with%20authentic%20tools%20and%20equipment%2C%20warm%20orange%20glow%20from%20forge%20fire%2C%20professional%20artisan%20at%20work%2C%20detailed%20craftsmanship%20scene%2C%20high%20quality%20documentary%20photography&width=600&height=700&seq=about-blacksmith&orientation=portrait"
							/><div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
						</div><div
							class="absolute -bottom-6 -left-6 max-w-xs rounded-xl bg-white p-6 shadow-xl"
						>
							<div class="flex items-center space-x-4">
								<div class="flex h-12 w-12 items-center justify-center rounded-full bg-amber-600">
									<i class="ri-award-line text-xl text-white"></i>
								</div><div>
									<h4 class="text-lg font-bold text-gray-800">500+</h4><p
										class="text-sm text-gray-600"
									>
										Proyectos Completados
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="mt-20">
					<h3 class="mb-12 text-center text-3xl font-bold text-gray-800">Nuestros Valores</h3><div
						class="grid grid-cols-1 gap-8 md:grid-cols-3"
					>
						<div class="text-center">
							<div
								class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-amber-600"
							>
								<i class="ri-star-line text-2xl text-white"></i>
							</div><h4 class="mb-3 text-xl font-semibold text-gray-800">Excelencia</h4><p
								class="text-gray-600"
							>
								Buscamos la perfección en cada detalle, desde el diseño hasta la instalación final.
							</p>
						</div><div class="text-center">
							<div
								class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-amber-600"
							>
								<i class="ri-time-line text-2xl text-white"></i>
							</div><h4 class="mb-3 text-xl font-semibold text-gray-800">Puntualidad</h4><p
								class="text-gray-600"
							>
								Cumplimos con los tiempos acordados sin comprometer la calidad del trabajo.
							</p>
						</div><div class="text-center">
							<div
								class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-amber-600"
							>
								<i class="ri-customer-service-line text-2xl text-white"></i>
							</div><h4 class="mb-3 text-xl font-semibold text-gray-800">Servicio</h4><p
								class="text-gray-600"
							>
								Atención personalizada y asesoría especializada en cada proyecto.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>
	</div>
</CustomLayout>
