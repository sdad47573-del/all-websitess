---
import { DATA } from "../data/data.astro";
---

<!-- class="pt-28 md:pt-56 pb-20 bg-gradient-to-br from-base-300 bg-bottom-right to-white bg-cover" -->
<section
  id="inicio"
  class="relative pt-40 pb-20 flex items-center bg-gradient-to-br from-base-300 bg-bottom-right to-white"
>
  <!-- style='background-image: url("/ea3b2cec2a9403f22fc900587b8aff60.jpg"); background-size: cover; background-position: center center; background-blend-mode: overlay;' -->
  <!-- style={`background-image: linear-gradient(to bottom right, oklch(0.93 0.03 255.59 / 0.5), rgb(255 255 255)), linear-gradient(to bottom left, oklch(0.93 0.03 255.59 / 0.51), oklch(0.93 0.03 255.59)), url(${optimized.src});`} -->
  <div class="container mx-auto px-6 text-center">
    <div class="">
      <p class="opacity-60 font-bold">Agencia de páginas web en Málaga</p>

      <h1 class="text-5xl md:text-6xl font-bold text-gray-900 mb-6">
        Tu <span class="text-wave">Presencia Digital</span> Comienza Aquí
      </h1>

      <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
        Empieza hoy desde <span
          class="font-bold text-secondary text-3xl transition-all md:text-2xl md:hover:text-3xl noise"
          >0€</span
        >, lanza tu web profesional en <span
          class="font-bold hover:text-3xl transition-all md:hover:text-2xl hover:noise"
          >menos de 7 días</span
        >.
      </p>
    </div>
    <div
      class="flex flex-col sm:flex-row gap-4 justify-center items-center mt-16"
    >
      <!-- class="bg-teal-600 text-white px-8 py-4 rounded-full text-lg font-semibold hover:bg-teal-700 transition-all duration-300 transform hover:scale-105 cursor-pointer whitespace-nowrap" -->
      <a
        href="https://wa.me/34614032511"
        rel="noopener noreferrer"
        target="_blank"
        class="btn btn-primary font-semibold transition-all duration-300 transform btn-xl rounded-full text-lg px-8 hover:scale-105"
        >Solicitar Consulta Gratuita</a
      >
      <a
        href="/#servicios"
        class="btn btn-outline rounded-full btn-xl text-lg transition-all hover:bg-white px-8 hover:border-white duration-300 cursor-pointer whitespace-nowrap"
        >Ver Servicios</a
      >
    </div>
    <div
      class="mt-16 place-self-center grid grid-cols-1 md:grid-cols-3 gap-8 max-w-2xl"
    >
      <div class="text-center">
        <div class="text-3xl md:text-4xl font-bold text-wave mb-2">
          150+
        </div><div class="">Empresas en Málaga</div>
      </div><div class="text-center">
        <div class="text-3xl md:text-4xl font-bold text-wave mb-2">
          300%
        </div><div class="">Aumento Promedio ROI</div>
      </div><div class="text-center">
        <div class="text-3xl md:text-4xl font-bold text-wave mb-2">
          5 años
        </div><div class="">Experiencia Local</div>
      </div>
    </div>
  </div>
</section>
<section id="servicios" class="py-20 bg-gradient-to-bl to-base-300 from-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="noise font-semibold text-lg mb-2">
        tu agencia de marketing digital Málaga
      </p><h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
        Servicios de marketing digital
      </h2><p class="text-gray-600 text-lg max-w-3xl mx-auto">
        En nuestra <strong>agencia de marketing online</strong> impulsamos la presencia
        en internet de nuestros clientes con estrategias efectivas de marketing digital.
        Diseñamos soluciones personalizadas para alcanzar tus objetivos y destacar
        frente a la competencia.
      </p>
    </div>
    <ul
      class="grid grid-cols-1 text-center lg:grid-cols-3 sm:grid-cols-2 justify-items-center justify-self-center mb-8"
    >
      {
        DATA.services.map(({ icon: Icon, title, label }) => (
          <li class="flex flex-col place-content-center items-center max-w-[290px] p-6 hover:noise border-2  border-transparent  hover:border-secondary transition-all rounded-sm ">
            <Icon class="size-12" />
            <p class="font-bold text-xl pt-4 pb-2 ">{title}</p>
            <p>{label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
