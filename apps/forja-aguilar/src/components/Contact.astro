---
import { MAIL, PHONE } from "../data/data.astro";
---

<!-- Soluciona tu negocio
      Nos encargamos de todo, te enseñamos cómo sin trampa ni cartón. -->
<section id="contacto" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
        Contacta con Nosotros
      </h2><p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Nos encargamos de todo, te enseñamos cómo sin trampa ni cartón.
      </p>
    </div>
    <div class="grid lg:grid-cols-2 grid-cols-1 gap-8">
      <div class="grid grid-cols-1 gap-4 gap-x-8 justify-self-center">
        <div class="flex items-start space-x-4">
          <div class="w-11 h-13 badge badge-soft badge-primary">
            <i class="ri-phone-line text-xl"></i>
          </div>
          <div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Teléfono</h3><p
              class="text-lg text-primary font-semibold"
            >
              {PHONE}
            </p><p class="text-gray-600">Respuesta rápida por WhatsApp</p>
          </div>
        </div><div class="flex items-start gap-4">
          <div class="w-11 h-13 badge badge-soft badge-primary">
            <i class="ri-mail-line text-xl"></i>
          </div><div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Email</h3><p
              class="text-lg text-primary font-semibold break-all"
            >
              {MAIL}
            </p><p class="text-gray-600">Detallaremos tu consulta por email</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-11 h-13 badge badge-soft badge-primary">
            <i class="ri-time-line text-xl"></i>
          </div><div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Horario</h3><p
              class="text-gray-600"
            >
              de Lunes a Viernes: 10:00-22:00
              <br />
              Servicio de soporte: 24/7
            </p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="w-11 h-13 badge badge-soft badge-primary">
            <i class="ri-map-pin-line text-xl"></i>
          </div>
          <div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Ubicación</h3><p
              class="text-gray-600"
            >
              C. Marqués de Larios, 11, Distrito Centro,<br /> 29005 Málaga
            </p>
          </div>
        </div>
      </div>
      <div class="">
        <h3 class="text-2xl font-bold text-gray-900 mb-4">
          Nos encontramos en
        </h3><div class="aspect-video rounded-lg overflow-hidden">
          <!-- width="400"
            height="300" -->
          <!-- width="600"
            height="450" -->
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d199.88412023618952!2d-4.4215969!3d36.7190565!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd72f71e5dfbf95b%3A0xf8f8308c4601e85e!2sSur%20Digital!5e0!3m2!1ses!2ses!4v1761476509728!5m2!1ses!2ses"
            width="100%"
            height="100%"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            style="border: 0px;"></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
