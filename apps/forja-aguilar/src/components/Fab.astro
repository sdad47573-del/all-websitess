---
import { HREF_WHATSAPP } from '../data/data.astro';
import WhatsappIcon from '../icons/WhatsappIcon.astro';
---

<div class="fab z-40" transition:name="fab">
	<a
		target="_blank"
		rel="noopener noreferrer"
		href={HREF_WHATSAPP}
		class="!visible !scale-none !opacity-100"
	>
		<WhatsappIcon />
	</a>
</div>
