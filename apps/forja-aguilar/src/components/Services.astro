---
import { DATA } from "../data/data.astro";
---

<section
  class="pt-14 pb-20 bg-gradient-to-bl to-base-300 from-white flex flex-col items-center"
>
  <div class="container mx-auto px-6 text-center">
    <p class="text-3xl md:text-4xl font-bold text-gray-900 mb-16">
      Servicios completos para crear tu <span
        class="font-bold text-secondary noise text-4xl md:text-5xl"
        >página web</span
      >.
    </p>

    <ul
      class="grid grid-cols-1 lg:grid-cols-3 md:grid-cols-2 justify-items-center gap-10"
    >
      {
        DATA.services.map(({ icon: Icon, title, label }) => (
          <li class="flex flex-col items-center max-w-[290px]">
            <Icon />
            <p class="font-bold text-lg pt-4 pb-2">{title}</p>
            <p>{label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
