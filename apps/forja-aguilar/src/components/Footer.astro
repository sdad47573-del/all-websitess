---
import { FACEBOOK, HREF_WHATSAPP, INSTAGRAM, MAIL, PHONE, TIKTOK } from '../data/data.astro';
---

<footer class="bg-gray-900 text-white">
	<div class="container mx-auto px-4 py-12">
		<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
			<div>
				<div class="mb-6 flex items-center space-x-3">
					<div class="badge badge-primary flex h-10 w-10 items-center justify-center">
						<i class="ri-hammer-line text-xl"></i>
					</div>
					<h3
						class="hidden text-xl leading-5 font-bold lg:block xl:hidden"
						style="font-family: Pacifico, serif;"
					>
						Forja<br />Francisco
					</h3>
					<!-- class="text-xl font-bold leading-5 " -->
					<h3
						style="font-family: Pacifico, serif;"
						class="text-xl leading-5 font-bold lg:hidden xl:block"
					>
						Francisco Javier e Hijos<br />
						Forja Carpintería Metálica
					</h3>
				</div>
				<p class="mb-6 leading-relaxed text-gray-400">
					Especialistas en trabajos de herrería con más de 15 años de experiencia. Calidad y
					tradición en cada proyecto.
				</p><div class="flex space-x-4">
					<a
						href={TIKTOK}
						rel="noopener"
						target="_blank"
						class="hover:bg-primary flex h-10 w-10 items-center justify-center rounded-full bg-gray-800 transition-colors"
						><i class="ri-tiktok-fill text-lg"></i></a
					><a
						href={INSTAGRAM}
						target="_blank"
						rel="noopener"
						class="hover:bg-primary flex h-10 w-10 items-center justify-center rounded-full bg-gray-800 transition-colors"
						><i class="ri-instagram-line text-lg"></i></a
					>
					<!-- <a
            href={FACEBOOK}
            target="_blank"
            rel="noopener"
            class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center hover:bg-primary transition-colors cursor-pointer"
            ><i class="ri-facebook-line text-lg"></i></a
          > -->
				</div>
			</div><div>
				<h4 class="mb-6 text-lg font-semibold">Servicios</h4><ul class="space-y-3">
					<li>
						<a
							href="/#servicios"
							class="cursor-pointer text-gray-400 transition-colors hover:text-white"
							>Rejas de Seguridad</a
						>
					</li><li>
						<a
							href="/#servicios"
							class="cursor-pointer text-gray-400 transition-colors hover:text-white"
							>Puertas Metálicas</a
						>
					</li><li>
						<a
							href="/#servicios"
							class="cursor-pointer text-gray-400 transition-colors hover:text-white"
							>Ventanas de Hierro</a
						>
					</li><li>
						<a
							href="/#servicios"
							class="cursor-pointer text-gray-400 transition-colors hover:text-white"
							>Escaleras y Barandales</a
						>
					</li><li>
						<a
							href="/#servicios"
							class="cursor-pointer text-gray-400 transition-colors hover:text-white"
							>Estructuras Metálicas</a
						>
					</li><li>
						<a
							href="/#servicios"
							class="cursor-pointer text-gray-400 transition-colors hover:text-white"
							>Soldadura Especializada</a
						>
					</li>
				</ul>
			</div><div>
				<h4 class="mb-6 text-lg font-semibold">Contacto</h4><div class="space-y-4">
					<div class="flex items-start space-x-3">
						<i class="ri-map-pin-line mt-1 text-lg text-amber-600"></i><div>
							<p class="text-sm text-gray-400">
								Pol Ind Atalaya, 27,<br />14940 Cabra, Córdoba
							</p>
						</div>
					</div><div class="flex items-center space-x-3">
						<i class="ri-phone-line text-lg text-amber-600"></i><p class="text-sm text-gray-400">
							{PHONE}
						</p>
					</div><div class="flex items-center space-x-3">
						<i class="ri-mail-line text-lg text-amber-600"></i><p class="text-sm text-gray-400">
							{MAIL}
						</p>
					</div>
				</div>
			</div><div>
				<h4 class="mb-6 text-lg font-semibold">Horarios</h4><div class="space-y-2">
					<div class="flex justify-between">
						<span class="text-sm text-gray-400">Lunes - Viernes</span><span
							class="text-sm text-white">8:00 AM - 2:00 PM</span
						><span class="text-sm text-white">4:00 PM - 6:30 PM</span>
					</div><div class="flex justify-between">
						<span class="text-sm text-gray-400">Sábados, Domingos y festivos</span><span
							class="text-sm text-white">Cerrado</span
						>
					</div><div class="flex justify-between">
						<span class="text-sm text-gray-400">Urgencias</span><span class="text-sm text-white"
							>24/7h</span
						>
					</div>
				</div><div class="mt-6 rounded-lg bg-amber-600 p-4">
					<h5 class="mb-2 font-semibold">¿Necesitas un presupuesto?</h5><p
						class="mb-3 text-sm text-amber-100"
					>
						Contáctanos para recibir un presupuesto gratuito
					</p><a
						href={HREF_WHATSAPP}
						target="_blank"
						rel="noopener noreferrer"
						class="cursor-pointer rounded bg-white px-4 py-2 text-sm font-medium whitespace-nowrap text-amber-600 transition-colors hover:bg-gray-100"
						>Solicitar presupuesto</a
					>
				</div>
			</div>
		</div><div class="mt-12 border-t border-gray-800 pt-8">
			<div class="flex flex-col items-center justify-between md:flex-row">
				<p class="mb-4 text-sm text-gray-400 md:mb-0">
					© 2025 Herrería Artesanal. Todos los derechos reservados.
				</p><div class="flex flex-wrap items-center gap-x-6 gap-y-2">
					<a href="" class="cursor-pointer text-sm text-gray-400 transition-colors hover:text-white"
						>Política de Privacidad</a
					><a
						href=""
						class="cursor-pointer text-sm text-gray-400 transition-colors hover:text-white"
						>Términos de Servicio</a
					><a
						href="https://www.linkedin.com/in/jose-antonio-aguilar-granados/"
						target="_blank"
						rel="noopener noreferrer"
						class="text-sm text-gray-400 transition-colors hover:text-white"
						>Creado por Jose Aguilar</a
					>
				</div>
			</div>
		</div>
	</div>
</footer>
