---
import { twJoin } from 'tailwind-merge';
import { FACEBOOK, HREF_PHONE, INSTAGRAM, PHONE, TIKTOK } from '../data/data.astro';

const currentPath = Astro.url.pathname;

const DATA = [
	{ href: '/', label: 'Inicio' },
	// { href: "/trayectoria/", label: "Trayectoria" },
	{ href: '/#servicios', label: 'Servicios' },
	// { href: "/servicios/", label: "Servicios" },
	{ href: '/#proyectos', label: 'Proyectos' },
	{ href: '/FAQ/', label: 'FAQ' },
];
---

<div class="bg-neutral text-neutral-content">
	<!-- <div class="max-w-7xl mx-auto px-4 flex justify-between items-center gap-4"> -->
	<div class="mx-auto flex items-center justify-between gap-4 px-4 py-2 sm:px-6 lg:px-8">
		<div class="flex items-center gap-2">
			<i class="ri-phone-fill"></i><span>Teléfono: </span><a
				href={HREF_PHONE}
				class="hover:text-primary transition-colors">{PHONE}</a
			>
		</div>
		<div class="flex gap-3">
			<a
				target="_blank"
				rel="noopener noreferrer"
				href={TIKTOK}
				class="hover:text-primary transition-colors"
				><i class="ri-tiktok-fill flex h-5 w-5 items-center justify-center"></i></a
			>
			<a
				target="_blank"
				rel="noopener noreferrer"
				href={INSTAGRAM}
				class="hover:text-primary transition-colors"
			>
				<i class="ri-instagram-line flex h-5 w-5 items-center justify-center"></i>
			</a>
			<!-- <a
        target="_blank"
        rel="noopener noreferrer"
        href={FACEBOOK}
        class="hover:text-primary transition-colors"
      >
        <i class="ri-facebook-fill w-5 h-5 flex items-center justify-center"
        ></i>
      </a> -->
		</div>
	</div>
</div>
<header class="bg-base-100/90 sticky top-0 z-50 shadow-lg backdrop-blur-xl">
	<nav class="mx-auto px-4 py-2 sm:px-6 lg:px-8">
		<div class="flex h-16 items-center justify-between">
			<a href="/" class="flex items-center space-x-3">
				<div class="badge badge-primary flex h-10 w-10 items-center justify-center">
					<i class="ri-hammer-line text-xl"></i>
				</div>
				<h3
					class="hidden text-xl leading-5 font-bold md:block xl:hidden"
					style="font-family: Pacifico, serif;"
				>
					Forja<br />Francisco
				</h3>
				<h3
					class="text-xl leading-5 font-bold md:hidden xl:block"
					style="font-family: Pacifico, serif;"
				>
					Francisco Javier e Hijos<br />
					Forja Carpintería Metálica
				</h3>
			</a>
			<div class="mr-2 ml-2 hidden overflow-x-auto md:block">
				<div class="flex items-baseline space-x-4">
					{
						DATA.map(({ href, label }) => {
							const isActive = currentPath === href;
							return (
								<a
									href={href}
									class={twJoin(
										'cursor-pointer rounded-md px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors',
										isActive
											? 'bg-primary text-primary-content'
											: 'hover:text-primary text-gray-700 hover:bg-blue-50',
									)}
								>
									{label}
								</a>
							);
						})
					}
				</div>
			</div>
			<div class="hidden whitespace-nowrap md:block">
				<!-- <div class="hidden lg:block"> -->
				<a
					class="btn btn-primary btn-sm px-4 py-0 text-sm font-medium transition-colors"
					href="tel:+34666329155"
					data-discover="true"
				>
					Consulta Gratuita</a
				>
			</div>
			<div class="md:hidden">
				<button
					id="menu-toggle"
					class="hover:text-primary inline-flex cursor-pointer items-center justify-center rounded-md p-2 text-gray-700 hover:bg-blue-50"
					><div class="flex h-6 w-6 items-center justify-center">
						<i class="ri-menu-line text-xl"></i>
					</div></button
				>
			</div>
		</div>
	</nav>
	<div
		id="mobile-menu"
		class="border-base-300 bg-base-100 pointer-events-none absolute z-40 hidden w-full -translate-y-4 border-t p-4 opacity-0 shadow-lg transition-all duration-300 ease-in-out md:hidden"
	>
		<div class="flex flex-col items-baseline">
			{
				DATA.map(({ href, label }) => {
					const isActive = currentPath === href;

					return (
						<a
							href={href}
							class={twJoin(
								'cursor-pointer rounded-md px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors',
								isActive
									? 'bg-primary text-primary-content'
									: 'hover:text-primary text-gray-700 hover:bg-blue-50',
							)}
						>
							{label}
						</a>
					);
				})
			}
		</div>
	</div>
</header>
<script>
	const toggleButton = document.getElementById('menu-toggle');
	const mobileMenu = document.getElementById('mobile-menu');

	const openMenu = () => {
		mobileMenu.classList.remove('hidden', 'pointer-events-none');
		setTimeout(() => {
			mobileMenu.classList.remove('opacity-0', '-translate-y-4');
		}, 10);
	};

	const closeMenu = () => {
		mobileMenu.classList.add('opacity-0', '-translate-y-4', 'pointer-events-none');
		setTimeout(() => {
			mobileMenu.classList.add('hidden');
		}, 300); // Igual a duration-300
	};

	toggleButton.addEventListener('click', (event) => {
		event.stopPropagation(); // Evita que el click cierre inmediatamente
		if (mobileMenu.classList.contains('hidden')) {
			openMenu();
		} else {
			closeMenu();
		}
	});

	// Cerrar menú si se hace click fuera
	document.addEventListener('click', (event) => {
		if (
			!mobileMenu.contains(event.target) &&
			!toggleButton.contains(event.target) &&
			!mobileMenu.classList.contains('hidden')
		) {
			closeMenu();
		}
	});
</script>
