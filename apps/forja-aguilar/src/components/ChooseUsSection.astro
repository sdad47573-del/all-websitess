---
import Francis from '@assets/FORJA/francis.png';
import { getImage, Image } from '@astro-components';

const FrancisOptimized = await getImage({ src: Francis, width: 1200, format: 'webp' });

// Somos una empresa especializada en herrería, carpintería metálica y trabajos en aluminio con más de 15 años de experiencia en el mercado. Nos dedicamos a crear soluciones duraderas y de alta calidad para nuestros clientes.
// Nuestro compromiso es brindar un servicio integral que incluye diseño, fabricación e instalación, utilizando tecnología de vanguardia y los mejores materiales del mercado.
---

<section class="bg-gray-50 py-20">
	<div class="container mx-auto px-4">
		<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
			<div>
				<h2 class="mb-8 text-4xl font-bold text-gray-900 md:text-5xl">¿Por qué elegirnos?</h2><p
					class="mb-8 text-lg text-gray-600"
				>
					Somos una empresa familiar especializada en herrería y carpintería metálica, comprometida
					con la excelencia y la satisfacción de nuestros clientes. Combinamos técnicas
					tradicionales con tecnología moderna para ofrecer resultados excepcionales.
				</p><div class="grid grid-cols-1 gap-6 md:grid-cols-2">
					<div class="flex items-start">
						<div
							class="badge badge-primary mr-4 flex h-10 w-10 flex-shrink-0 items-center justify-center"
						>
							<i class="ri-time-line text-lg"></i>
						</div><div>
							<h3 class="mb-2 font-semibold text-gray-900">Más de 15 años de experiencia</h3><p
								class="text-sm text-gray-600"
							>
								Amplia trayectoria en el sector de la herrería y carpintería metálica
							</p>
						</div>
					</div><div class="flex items-start">
						<div
							class="badge badge-primary mr-4 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg"
						>
							<i class="ri-award-line text-lg text-white"></i>
						</div><div>
							<h3 class="mb-2 font-semibold text-gray-900">Calidad garantizada</h3><p
								class="text-sm text-gray-600"
							>
								Utilizamos materiales de primera calidad y técnicas profesionales
							</p>
						</div>
					</div><div class="flex items-start">
						<div
							class="badge badge-primary mr-4 flex h-10 w-10 flex-shrink-0 items-center justify-center"
						>
							<i class="ri-user-line text-lg"></i>
						</div><div>
							<h3 class="mb-2 font-semibold text-gray-900">Personal cualificado</h3><p
								class="text-sm text-gray-600"
							>
								Equipo de herreros profesionales con formación especializada
							</p>
						</div>
					</div><div class="flex items-start">
						<div
							class="badge badge-primary mr-4 flex h-10 w-10 flex-shrink-0 items-center justify-center"
						>
							<i class="ri-price-tag-line text-lg"></i>
						</div><div>
							<h3 class="mb-2 font-semibold text-gray-900">Precios competitivos</h3><p
								class="text-sm text-gray-600"
							>
								Presupuestos ajustados sin comprometer la calidad del trabajo
							</p>
						</div>
					</div><div class="flex items-start">
						<div
							class="badge badge-primary mr-4 flex h-10 w-10 flex-shrink-0 items-center justify-center"
						>
							<i class="ri-calendar-line text-lg"></i>
						</div><div>
							<h3 class="mb-2 font-semibold text-gray-900">Cumplimiento de plazos</h3><p
								class="text-sm text-gray-600"
							>
								Respetamos los tiempos acordados en cada proyecto
							</p>
						</div>
					</div><div class="flex items-start">
						<div
							class="badge badge-primary mr-4 flex h-10 w-10 flex-shrink-0 items-center justify-center"
						>
							<i class="ri-shield-check-line text-lg"></i>
						</div><div>
							<h3 class="mb-2 font-semibold text-gray-900">2 años de garantía</h3><p
								class="text-sm text-gray-600"
							>
								Garantía completa en todos nuestros trabajos realizados
							</p>
						</div>
					</div>
				</div>
			</div>
			<div class="relative">
				<Image src={Francis} alt="Francis" />
				<div
					class="bg-primary text-primary-content absolute -right-2 -bottom-6 rounded-lg p-6 shadow-lg md:-right-6"
				>
					<div class="text-center">
						<div class="text-3xl font-bold">15+</div><div class="text-sm">Años de experiencia</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
