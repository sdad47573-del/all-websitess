---
import { DATA } from "../data/data.astro";
---

<section
  class="pt-14 pb-20 bg-gradient-to-bl to-base-300 from-white flex flex-col items-center"
>
  <div class="container mx-auto px-6 flex flex-col items-center">
    <p class="text-4xl md:text-5xl font-bold text-center text-gray-900">
      No uses el <span class="text-neutral"> Kit Digital </span>
    </p>
    <p class="mb-12 text-gray-600 text-center">
      Te contamos lo que nadie te cuenta sobre la subvención
    </p>

    <ul class="flex flex-col mb-8">
      <!-- <ul class="flex flex-col mb-8 max-w-3xl"> -->
      {
        DATA.kitDigital.map(({ icon: Icon, title, label }) => (
          <li class="flex flex-col md:flex-row items-center gap-4 px-2 py-4 ">
            <Icon class="size-12" />
            <div class="flex flex-col px-2">
              <p class="font-bold text-lg text-center md:text-start pb-2 ">
                {title}
              </p>
              <p class="max-w-2xl text-center md:text-start" set:html={label} />
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
