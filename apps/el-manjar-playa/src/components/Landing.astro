---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import { business, directionsUrl, mapEmbedUrl, mapsUrl, phoneHref, restaurantSchema } from '../lib/business';
import { content } from '../lib/content';

const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const instagramPhotoPosts = [
	'DJ_GCIhIDGx',
	'DJr0AA6IGeI',
	'DJpFZygo9Oi',
	'DJlXptGodxD',
	'DJbQ5k1ofon',
	'DJZE7j3IAM1',
	'DDz6-ejILJO',
	'DDuiBH7I959',
];
const galleryPhotos = instagramPhotoPosts.map((postId, index) => {
	const photoNumber = String(index + 1).padStart(2, '0');
	return {
		src: foto(`manjar-playa-${photoNumber}.jpg`),
		href: `https://www.instagram.com/p/${postId}/`,
		alt: `Foto ${index + 1} de El Manjar Playa, Torremolinos`,
	};
});

interface Props {
	locale: 'es' | 'en';
}

const { locale } = Astro.props;
const page = content[locale];
const canonical = `${business.site}${page.path}`;
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: page.faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang={page.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#103d48" />
		<meta name="description" content={page.description} />
		<meta name="keywords" content={page.keywords} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="La Carihuela, Torremolinos" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="es" href={`${business.site}/`} />
		<link rel="alternate" hreflang="en" href={`${business.site}/en/`} />
		<link rel="alternate" hreflang="x-default" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://maps.googleapis.com" />
		<link rel="preconnect" href="https://maps.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
			rel="stylesheet"
		/>
		<title>{page.title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content={page.locale} />
		<meta property="og:site_name" content={business.shortName} />
		<meta property="og:title" content={page.title} />
		<meta property="og:description" content={page.description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={`${business.site}/social-card.svg`} />
		<meta property="og:image:alt" content="El Manjar Playa, pescados y arroces en Torremolinos" />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="Spain" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={page.title} />
		<meta name="twitter:description" content={page.description} />
		<meta name="twitter:image" content={`${business.site}/social-card.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#main">{page.skip}</a>
		<header class="topbar">
			<a class="brand" href={page.path} aria-label={`${business.shortName} · ${page.navLabel}`}>
				<span class="brand-mark" aria-hidden="true">M.</span>
				<span class="brand-name">El Manjar<small>PLAYA · TORREMOLINOS</small></span>
			</a>
			<nav aria-label={page.navLabel}>
				{page.nav.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
			<div class="header-actions">
				<a class="language" href={page.languageHref} lang={locale === 'es' ? 'en' : 'es'}>{page.languageLabel}</a>
				<a class="header-book" href={phoneHref}><span aria-hidden="true">↗</span> {page.primaryCta}</a>
			</div>
		</header>

		<main id="main">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span class="eyebrow-dot"></span>{page.eyebrow}</p>
					<h1 id="hero-title">{page.titleLines[0]}<br /><em>{page.titleLines[1]}</em><br />{page.titleLines[2]}</h1>
					<p class="hero-lede">{page.intro}</p>
					<div class="hero-actions">
						<a class="button button-primary" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">{page.secondaryCta}<span aria-hidden="true">↗</span></a>
					</div>
					<p class="hero-footnote"><span aria-hidden="true">✳</span>{page.heroNote}</p>
				</div>
				<figure class="hero-art">
					<Image
						class="hero-image"
						src={foto('el-manjar-playa-apaisada-04.jpg')}
						alt={page.heroAlt}
						widths={[480, 720, 960]}
						sizes="(max-width: 980px) 92vw, 34vw"
						format="avif"
						quality={70}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					<span class="art-coordinates">36°36'16.0&quot;N<br />4°30'33.0&quot;W</span><span class="art-stamp">MAR<br />Y MESA</span>
					<a class="art-open" href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label={page.mapOpen}><span aria-hidden="true">↗</span></a>
					<figcaption class="art-caption">{page.photoCaption}<a href={business.instagram} target="_blank" rel="noopener noreferrer">{page.photosCta} ↗</a></figcaption>
				</figure>
				<div class="hero-side-note" aria-hidden="true">LA CARIHUELA · COSTA DEL SOL</div>
			</section>

			<section class="intro section-wrap" id={locale === 'es' ? 'restaurante' : 'restaurant'}>
				<div class="intro-index"><span>01</span><i></i>{page.restaurantLabel}</div>
				<div class="intro-body"><h2>{page.restaurantTitle}</h2><div class="intro-copy"><p>{page.restaurantText}</p><p>{page.restaurantDetail}</p></div></div>
				<div class="values">
					{page.values.map((item) => <article class="value"><span>{item.number}</span><h3>{item.title}</h3><p>{item.detail}</p></article>)}
				</div>
			</section>

			<section class="food-section" id={locale === 'es' ? 'cocina' : 'food'}>
				<div class="food-grid section-wrap">
					<figure class="food-art">
						<Image
							src={foto('el-manjar-playa-apaisada-09.jpg')}
							alt={page.cuisinePhotoAlt}
							widths={[360, 480, 720]}
							sizes="(max-width: 680px) 74vw, 385px"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<span class="food-art-scrim" aria-hidden="true"></span>
						<span class="food-art-note" aria-hidden="true">MAR<br />Y<br />TIERRA</span>
					</figure>
					<div class="food-copy"><p class="eyebrow eyebrow-dark"><span class="eyebrow-dot"></span>{page.cuisineEyebrow}</p><h2>{page.cuisineTitle}</h2><p>{page.cuisineText}</p><ul class="cuisine-tags">{page.cuisineTags.map((tag) => <li>{tag}</li>)}</ul><a class="text-link" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a></div>
				</div>
			</section>

			<section class="gallery-section section-wrap">
				<div class="gallery-copy"><p class="eyebrow"><span class="eyebrow-dot"></span>{page.photosEyebrow}</p><h2>{page.photosTitle}</h2><p>{page.photosText}</p><a class="button button-primary" href={business.instagram} target="_blank" rel="noopener noreferrer">{page.photosCta}<span aria-hidden="true">↗</span></a></div>
				<div class="gallery-grid">
					{galleryPhotos.map((photo, index) => (
						<a class="gallery-photo" href={photo.href} target="_blank" rel="noopener noreferrer" aria-label={`${photo.alt} · Instagram`}>
							<Image
								src={photo.src}
								alt={photo.alt}
								widths={[320, 480, 640]}
								sizes="(max-width: 980px) 46vw, 23vw"
								format="avif"
								quality={65}
								loading={index < 2 ? 'eager' : 'lazy'}
								decoding="async"
							/>
						</a>
					))}
				</div>
			</section>
			<p class="photo-credit section-wrap">{page.photoDisclaimer} <a href={business.instagram} target="_blank" rel="noopener noreferrer">@el_manjar_playa ↗</a></p>

			<section class="visit-section" id={locale === 'es' ? 'visitanos' : 'visit'}>
				<div class="visit-grid section-wrap">
					<div class="visit-copy"><p class="eyebrow"><span class="eyebrow-dot"></span>{page.visitEyebrow}</p><h2>{page.visitTitle}</h2>
						<div class="visit-details"><div><span class="detail-icon" aria-hidden="true">⌖</span><p><small>{page.addressLabel}</small>{business.streetAddress}<br />{business.postalCode} {business.city}<br />{business.region}</p></div><div><span class="detail-icon" aria-hidden="true">↗</span><p><small>{page.phoneLabel}</small><a href={phoneHref}>{business.phone}</a></p></div><div><span class="detail-icon" aria-hidden="true">◷</span><p><small>{page.hoursLabel}</small>{page.hoursText}</p></div></div>
						<a class="social-link" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-panel"><div class="map-topline"><span><i></i> LA CARIHUELA · TORREMOLINOS</span><a href={mapsUrl} target="_blank" rel="noopener noreferrer">{page.mapOpen} ↗</a></div><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title={page.mapTitle} src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">{locale === 'en' ? 'Directions in Google Maps ↗' : 'Cómo llegar en Google Maps ↗'}</a></p>
						</noscript>
					</div><a class="map-bottom" href={directionsUrl} target="_blank" rel="noopener noreferrer"><span class="map-pin" aria-hidden="true">⌖</span><span><strong>{business.shortName}</strong><small>{business.streetAddress} · {business.city}</small></span><b>{page.mapDirections} ↗</b></a></div>
				</div>
			</section>

			<section class="faq-section section-wrap">
				<div class="faq-heading"><p class="eyebrow eyebrow-dark"><span class="eyebrow-dot"></span>{page.faqEyebrow}</p><h2>{page.faqTitle}</h2></div>
				<div class="faq-list">{page.faqs.map((faq) => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div>
			</section>
		</main>

		<footer class="footer"><a class="brand" href={page.path} aria-label={`${business.shortName} · ${page.navLabel}`}><span class="brand-mark" aria-hidden="true">M.</span><span class="brand-name">El Manjar<small>PLAYA · TORREMOLINOS</small></span></a><p>{page.footerNote}<br />{business.streetAddress}, {business.city}</p><div class="footer-links"><a href={business.instagram} target="_blank" rel="noopener noreferrer">{page.instagramLabel} ↗</a><a href={page.languageHref}>{page.languageLabel}</a><a href="/aviso-legal">Aviso legal</a> <a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a> · <a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a> </div><small class="footer-legal">© {new Date().getFullYear()} {business.shortName} · {business.city}</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>
		<a class="mobile-cta" href={phoneHref}><span aria-hidden="true">↗</span>{page.primaryCta}<strong>{business.phone}</strong></a>
	</body>
</html>


