---
import f01 from '../assets/fotos/comidas-para-llevar-anton-apaisada-01.jpg';
import f02 from '../assets/fotos/comidas-para-llevar-anton-apaisada-02.jpg';
import f03 from '../assets/fotos/comidas-para-llevar-anton-apaisada-03.jpg';
import f04 from '../assets/fotos/comidas-para-llevar-anton-vertical-04.jpg';
import f05 from '../assets/fotos/comidas-para-llevar-anton-vertical-05.jpg';
import f06 from '../assets/fotos/comidas-para-llevar-anton-apaisada-06.jpg';
import f07 from '../assets/fotos/comidas-para-llevar-anton-vertical-07.jpg';
import f08 from '../assets/fotos/comidas-para-llevar-anton-vertical-08.jpg';
import f09 from '../assets/fotos/comidas-para-llevar-anton-vertical-09.jpg';
import f10 from '../assets/fotos/comidas-para-llevar-anton-vertical-10.jpg';

const fotos = [f01, f02, f03, f04, f05, f06, f07, f08, f09, f10];

const MAPS_URL =
	'https://www.google.com/maps/place/%C2%ABComidas+para+llevar%C2%BB+Ant%C3%B3n/@37.8061313,-0.8328009,17z/data=!3m1!4b1!4m6!3m5!1s0xd630dff66d4e659:0x5fdbc62484ab0c43!8m2!3d37.8061313!4d-0.8328009!16s%2Fg%2F11cmzr0ggx?authuser=0&hl=es&entry=ttu';
const CREDIT_URL = 'https://sur-digital.vercel.app/';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Comidas para llevar Antón</title>
		<meta name="description" content="Comidas para llevar Antón." />
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Restaurant",
	"@id": "https://comidas-para-llevar-anton.vercel.app/#negocio",
	"name": "Comidas para llevar anton",
	"url": "https://comidas-para-llevar-anton.vercel.app/",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 37.8061313,
		"longitude": -0.8328009
	},
	"hasMap": "https://www.google.com/maps/place/%C2%ABComidas+para+llevar%C2%BB+Ant%C3%B3n/@37.8061313,-0.8328009,17z/data=!3m1!4b1!4m6!3m5!1s0xd630dff66d4e659:0x5fdbc62484ab0c43!8m2!3d37.8061313!4d-0.8328009!16s%2Fg%2F11cmzr0ggx?authuser=0&hl=es&entry=ttu"
}
</script>
</head>
	<body>
		<header>
			<h1 set:html={piezas.portada.titulo} />
			<a href={MAPS_URL} rel="noopener" target="_blank">Ver en Google Maps</a>
		</header>

		<main>
			<section>
				{fotos.map((foto) => (
					<img src={foto.src} width={foto.width} height={foto.height} alt="Comidas para llevar Antón" loading="lazy" />
				))}
			</section>
		</main>

		<footer>
			<p>
				Creado por <a href={CREDIT_URL} rel="noopener">Sur Digital</a> · sur-digital.vercel.app
			</p>
		</footer>
	</body>
</html>
