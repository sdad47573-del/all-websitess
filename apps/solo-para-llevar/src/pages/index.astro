---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/solo-para-llevar-apaisada-03.jpg';
import vitrina from '../assets/fotos/solo-para-llevar-apaisada-05.jpg';
import interior from '../assets/fotos/solo-para-llevar-apaisada-04.jpg';
import mostrador from '../assets/fotos/solo-para-llevar-apaisada-01.jpg';
import tortilla from '../assets/fotos/solo-para-llevar-vertical-02.jpg';
import logo from '../assets/fotos/solo-para-llevar-cuadrada-08.jpg';
import lona from '../assets/fotos/solo-para-llevar-vertical-07.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Solo para llevar · Comida casera para llevar en Sevilla';
const description =
	'Solo para llevar, comidas caseras en C. Atenas, 26, Sevilla. Tortilla de patata, calamares en salsa, empanadas y platos del día para recoger. Fotos, horario, teléfono y opiniones.';

const galeria = [
	{ src: fachada, alt: 'Fachada de Solo para llevar con la lona de comidas caseras y el teléfono' },
	{ src: vitrina, alt: 'Vitrina de Solo para llevar con calamares en salsa, tomate y bandejas gratinadas' },
	{ src: interior, alt: 'Interior del local con la vitrina, el cesto de pan y el menú en la pared' },
	{ src: mostrador, alt: 'Mostrador con empanadas y la ventana abierta a la calle' },
	{ src: tortilla, alt: 'Tortilla de patata entera dentro de su caja de cartón para llevar' },
	{ src: logo, alt: 'Logotipo de Solo para llevar con la cocinera y su cuchara' },
	{ src: lona, alt: 'Lona vertical del local con el logotipo y el teléfono 954 62 90 61' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Oferta de Solo para llevar',
	inLanguage: 'es-ES',
	description:
		'Selección orientativa basada en las reseñas públicas y en las fotografías del perfil; la ficha no publica carta oficial ni precios.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#solo-para-llevar`,
	name: BUSINESS.name,
	alternateName: ['Solo para Llevar Sevilla', 'Comidas Caseras Solo para Llevar'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34954629061',
	servesCuisine: ['Comida casera', 'Comida para llevar', 'Andaluza'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '10:00',
			closes: '15:30',
		},
	],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Oferta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Solo para llevar Sevilla, comida para llevar Atenas 26, comidas caseras Sevilla, tortilla de patata para llevar, solomillo al roquefort Sevilla, comida sin gluten Sevilla"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comidas caseras para recoger en C. Atenas, 26. Tortilla, guisos y platos del día. Consulta fotos, horario y teléfono."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Solo para llevar, comidas caseras en Sevilla"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#1f3b3a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Sevilla"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Solo para llevar"
			subtitle="Comidas caseras · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Atenas, 26 · Sevilla"
				title="Comidas caseras, <br /><em>solo para llevar.</em>"
				lede={`Solo para llevar es un local de comidas caseras en la calle Atenas, 26. Prepara tortillas, guisos y platos del día para recoger. La ficha de Google muestra ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				image={fachada}
				imageAlt="Fachada de Solo para llevar con la lona de comidas caseras"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver ficha en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Tipo', html: '<b>Comida casera</b> para llevar' },
					{ label: 'Valoración', html: `<b>${RATING.label}</b> · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>10:00 – 15:30</b> de lunes a sábado' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver fotos y ficha"
				tag="Recién hecho"
			/>

			<LocalChips label="Servicios y oferta de Solo para llevar" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="El nombre lo dice <br /><em>todo.</em>"
				paragraphs={[
					'Solo para llevar está en la calle Atenas, 26, en Sevilla, con un rótulo que resume el concepto: comidas caseras para recoger. Google clasifica el negocio como restaurante y el servicio es de mediodía.',
					'En la vitrina y en las fotos de la ficha se ven tortillas de patata enteras, calamares en salsa, empanadas y bandejas gratinadas, además de pan y platos de cuchara. Todo se prepara para llevar en caja o fiambrera.',
					'Las reseñas hablan de «buena cocina y buen trato», de un local tranquilo y limpio y, en un caso, de comida sin gluten. El horario publicado es de 10:00 a 15:30 de lunes a sábado, con cierre los domingos.',
				]}
				note="La ficha no publica carta ni precios, y esta web no los inventa. Los platos citados son los que aparecen en las reseñas y en las fotografías del local; pregunta por la oferta del día y por los alérgenos al llamar."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotografías', href: '#galeria' },
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<ul class="highlights">
				{
					HIGHLIGHTS.map((item) => (
						<li>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</li>
					))
				}
			</ul>

			<LocalMenu
				eyebrow="De la vitrina a la caja"
				title="Guisos, tortillas <br /><em>y platos del día.</em>"
				description="La ficha no publica carta, pero las reseñas y las fotos del local permiten hacerse una idea: tortilla de patata, calamares en salsa, empanadas, bandejas gratinadas y algún plato sin gluten."
				cta={{ label: `Preguntar el menú de hoy · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Selección orientativa, sin precios: la ficha no publica carta oficial. Confirma los platos disponibles, el precio de las raciones y los alérgenos llamando al establecimiento."
			/>

			<LocalGallery
				eyebrow="Fotos del perfil de Google Maps"
				title="El local <br /><em>y la vitrina.</em>"
				description="La fachada, el interior con la vitrina y algunos de los platos que aparecen en las fotografías públicas del establecimiento."
				images={galeria}
				cta={{ label: 'Abrir la ficha en Google Maps', href: MAPS.place }}
				note="Imágenes descargadas del perfil público de Solo para llevar en Google Maps y servidas desde esta página."
			/>

			<section class="notas" aria-labelledby="notas-title">
				<div class="wrap notas-grid">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="notas-title">Lo que cuentan <em>las reseñas.</em></h2>
						<p class="notas-score">
							<strong>{RATING.label}</strong>
							<span>
								<b>★★★★★</b>
								{RATING.count} reseñas<br />en Google
							</span>
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer reseñas en Google ↗
						</a>
					</div>

					<div class="notas-copy">
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>{resena.texto}</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Opinión en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<p class="notas-foot">
							La valoración y el número de reseñas corresponden a la ficha consultada en octubre
							de 2026 y pueden variar. <a href={MAPS.reviews} target="_blank" rel="noreferrer"
								>Consulta las opiniones actualizadas en Google ↗</a
							>.
						</p>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la calle <br /><em>Atenas.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de Solo para llevar en C. Atenas, 26, Sevilla"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. Atenas, 26 · Sevilla"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="No hay pedidos en línea ni reparto anunciado en la ficha: se recoge en el local. Llama para encargar y confirmar qué hay ese día."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pasar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma horario, platos y precios con el establecimiento."
			ctaLabel="Llamar a Solo para llevar"
			navAriaLabel="Enlaces de Solo para llevar"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
