---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/panaderia-la-esquinita-apaisada-01.jpg';
import corazones from '../assets/fotos/panaderia-la-esquinita-apaisada-02.jpg';
import tartaGym from '../assets/fotos/panaderia-la-esquinita-vertical-03.jpg';
import tartaAzul from '../assets/fotos/panaderia-la-esquinita-apaisada-04.jpg';
import vitrina from '../assets/fotos/panaderia-la-esquinita-apaisada-05.jpg';
import tartaPeso from '../assets/fotos/panaderia-la-esquinita-vertical-06.jpg';
import pasteles from '../assets/fotos/panaderia-la-esquinita-vertical-07.jpg';
import tartaDia from '../assets/fotos/panaderia-la-esquinita-vertical-08.jpg';
import tartaOreo from '../assets/fotos/panaderia-la-esquinita-apaisada-09.jpg';
import tartaOreo2 from '../assets/fotos/panaderia-la-esquinita-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'La Esquinita · Panadería y confitería en Málaga';
const description =
	'Panadería y Confitería La Esquinita, en C. Eugenio Gross, 11 (Bailén-Miraflores, 29010 Málaga). Panes especiales, tartas personalizadas y dulces caseros.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#la-esquinita`,
	name: BUSINESS.name,
	alternateName: ['La Esquinita', 'Panadería La Esquinita', 'Confitería La Esquinita Málaga'],
	description:
		'Panadería y confitería en C. Eugenio Gross, 11 (Bailén-Miraflores, 29010 Málaga). Panes especiales, tartas personalizadas, cookies, saladitos y dulces caseros, también sin gluten, sin azúcar y sin lactosa.',
	slogan: 'Panes especiales y dulces caseros',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34951993781',
	servesCuisine: ['Panadería', 'Confitería'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:30',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '08:00',
			closes: '21:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: corazones,
		alt: 'Vitrina de La Esquinita con corazones de chocolate glaseados y dedicatorias, y tarros de caramelos encima',
	},
	{
		src: tartaGym,
		alt: 'Tarta de cumpleaños decorada con mancuernas y una figura de gimnasio',
	},
	{
		src: tartaAzul,
		alt: 'Tarta azul con borde ondulado, nata y bolas doradas sobre una mesa de acero',
	},
	{
		src: vitrina,
		alt: 'Vitrina con bandejas de bollería, porciones de tarta y rollos de chocolate',
	},
	{
		src: tartaPeso,
		alt: 'Tarta de galleta Oreo sobre una báscula, con tres galletas y chocolate',
	},
	{
		src: pasteles,
		alt: 'Pasteles individuales en la vitrina, uno cubierto de coco y otro de chocolate y virutas, con etiquetas de precio',
	},
	{
		src: tartaDia,
		alt: 'Tarta blanca con el texto «Felicidades en tu día» en chocolate y corazones de azúcar',
	},
	{
		src: tartaOreo,
		alt: 'Tarta entera de galleta Oreo en la vitrina, con nata y galletas',
	},
	{
		src: tartaOreo2,
		alt: 'Tarta de galleta Oreo con cuatro galletas y sirope de chocolate',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#fdf6e8" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=Outfit:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Esquinita, panadería Málaga, confitería Málaga, Eugenio Gross 11, Bailén-Miraflores, panes especiales, tartas personalizadas, sin gluten, sin azúcar, sin lactosa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="La Esquinita · Panadería y confitería en Bailén-Miraflores"
			ogDescription="Panes especiales, tartas personalizadas y dulces caseros en Eugenio Gross, 11. También sin gluten, sin azúcar y sin lactosa. 4,6 sobre 5 con 37 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de la Panadería y Confitería La Esquinita en la calle Eugenio Gross, 11"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#fdf6e8"
			phone="+34951993781"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Esquinita"
			subtitle="Panadería · Confitería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Eugenio Gross, 11 · Bailén-Miraflores"
				title="La esquina <br /><em>del pan y los dulces.</em>"
				lede={`La Esquinita es panadería y confitería en la esquina de Eugenio Gross con Bailén-Miraflores. La ficha del negocio lo cuenta así: «productos caseros», tartas personalizadas, cookies, galletitas, saladitos, dulces, bebidas y panes especiales. También hay opciones sin gluten, sin azúcar y sin lactosa. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={fachada}
				imageAlt="Fachada de La Esquinita en la esquina de la calle Eugenio Gross, con el rótulo de Panadería y Confitería y el escaparate"
				primaryCta={{ label: 'Llamar · 951 99 37 81', href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> en Google · 37 reseñas' },
					{ label: 'Horario', html: '<b>L–V 7:30–21:00</b> · S y D 8:00–21:00' },
					{ label: 'Teléfono', html: '<b>951 99 37 81</b>' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver las fotos en Google"
				tag="Eugenio Gross, 11"
			/>

			<LocalChips label="Lo que hay en la panadería" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Panadería, confitería <br /><em>y esquina.</em>"
				paragraphs={[
					'La Esquinita está en el número 11 de la calle Eugenio Gross, en Bailén-Miraflores, en un local que hace esquina. Es panadería y confitería: el pan y el dulce se compran en el mismo mostrador.',
					'La descripción del negocio habla de «variedad de productos caseros»: tartas personalizadas, cookies, galletitas y saladitos para celebraciones, además de dulces, bebidas y panes. En las fotos del perfil se ven tartas de encargo, corazones glaseados y una vitrina con pasteles individuales.',
					'El pan tiene su propia lista: centeno, soja, espelta, 100% integral, de semillas y de molde, blanco o integral. Son los panes especiales que anuncia la ficha, pensados para quien busca algo más que la barra de cada día.',
					'Y luego está la parte de las intolerancias: el negocio dice que trabaja productos «sin gluten, sin azúcar, sin lactosa, normal». Esta página lo recoge tal cual, sin prometer un protocolo de alérgenos que la ficha no detalla.',
				]}
				note="4,6 sobre 5 con 37 reseñas en Google. La ficha indica acceso para sillas de ruedas y que no hay aparcamiento adaptado. No publica página web, correo, redes sociales ni métodos de pago; el contacto es el teléfono y el propio local."
				links={[
					{ label: 'Llamar · 951 99 37 81', href: BUSINESS.phoneHref },
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas de la casa</p>
						<h2 id="three-title">Pan, dulce <br /><em>y opciones.</em></h2>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que se puede <br /><em>comprar.</em>"
				description="Sin carta publicada: esto es lo que enumera la descripción del negocio y lo que muestran las fotos del perfil."
				cta={{ label: 'Llamar · 951 99 37 81', href: BUSINESS.phoneHref }}
				groups={MENU_GROUPS}
				note="La ficha no publica una carta con precios, así que esta web no da importes: en la vitrina cada pieza lleva su etiqueta. Las tartas de las fotos son encargos de clientes y se muestran como ejemplo del trabajo de confitería. Para saber qué hay ese día, encargar una tarta o preguntar por los productos sin gluten, llama al 951 99 37 81."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="El obrador <br /><em>y la vitrina.</em>"
				description="Nueve fotos de la ficha de Google Maps: la vitrina, los corazones glaseados, las tartas de encargo y los pasteles individuales."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="reviews-title">
				<div class="wrap">
					<div class="reviews-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Lo que dicen</p>
							<h2 id="reviews-title">Tres reseñas <br /><em>de la ficha.</em></h2>
						</div>
						<p>
							4,6 sobre 5 con 37 reseñas. Estas tres están publicadas en Google y hablan
							de la variedad, del pan y de la clientela del barrio.
						</p>
					</div>
					<div class="review-grid">
						{
							REVIEWS.map((review) => (
								<figure class="review-card">
									<span class="stars" role="img" aria-label={`${review.rating} de 5 estrellas`}>
										★★★★★
									</span>
									<blockquote>{review.text}</blockquote>
									<figcaption>Reseña de Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<a class="reviews-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
						Leer las 37 reseñas en Google ↗
					</a>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la esquina <br /><em>de Eugenio Gross.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de La Esquinita en la calle Eugenio Gross, 11, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Esquinita · Bailén-Miraflores"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phone, href: BUSINESS.phoneHref }}
				reserveNote="La ficha de Google indica acceso para sillas de ruedas y que no hay aparcamiento adaptado. No publica web, correo ni canal de pedidos online: las tartas se encargan por teléfono o en el mostrador."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, descripción, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y disponibilidad pueden cambiar; confírmalos antes de ir."
			ctaLabel="Llamar a La Esquinita"
			navAriaLabel="Enlaces de La Esquinita"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
