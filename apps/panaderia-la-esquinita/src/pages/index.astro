---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/panaderia-la-esquinita-apaisada-01.jpg';
import corazones from '../assets/fotos/panaderia-la-esquinita-apaisada-02.jpg';
import tartaGym from '../assets/fotos/panaderia-la-esquinita-vertical-03.jpg';
import tartaAzul from '../assets/fotos/panaderia-la-esquinita-apaisada-04.jpg';
import vitrina from '../assets/fotos/panaderia-la-esquinita-apaisada-05.jpg';
import tartaPeso from '../assets/fotos/panaderia-la-esquinita-vertical-06.jpg';
import pasteles from '../assets/fotos/panaderia-la-esquinita-vertical-07.jpg';
import tartaDia from '../assets/fotos/panaderia-la-esquinita-vertical-08.jpg';
import tartaOreo from '../assets/fotos/panaderia-la-esquinita-apaisada-09.jpg';
import tartaOreo2 from '../assets/fotos/panaderia-la-esquinita-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'La Esquinita · Panadería y confitería en Málaga';
const description =
	'Panadería y Confitería La Esquinita, en C. Eugenio Gross, 11 (Bailén-Miraflores, 29010 Málaga). Panes especiales, tartas personalizadas y dulces caseros.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#la-esquinita`,
	name: BUSINESS.name,
	alternateName: ['La Esquinita', 'Panadería La Esquinita', 'Confitería La Esquinita Málaga'],
	description:
		'Panadería y confitería en C. Eugenio Gross, 11 (Bailén-Miraflores, 29010 Málaga). Panes especiales, tartas personalizadas, cookies, saladitos y dulces caseros, también sin gluten, sin azúcar y sin lactosa.',
	slogan: 'Panes especiales y dulces caseros',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34951993781',
	servesCuisine: ['Panadería', 'Confitería'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:30',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '08:00',
			closes: '21:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: corazones,
		alt: 'Vitrina de La Esquinita con corazones de chocolate glaseados y dedicatorias, y tarros de caramelos encima',
	},
	{
		src: tartaGym,
		alt: 'Tarta de cumpleaños decorada con mancuernas y una figura de gimnasio',
	},
	{
		src: tartaAzul,
		alt: 'Tarta azul con borde ondulado, nata y bolas doradas sobre una mesa de acero',
	},
	{
		src: vitrina,
		alt: 'Vitrina con bandejas de bollería, porciones de tarta y rollos de chocolate',
	},
	{
		src: tartaPeso,
		alt: 'Tarta de galleta Oreo sobre una báscula, con tres galletas y chocolate',
	},
	{
		src: pasteles,
		alt: 'Pasteles individuales en la vitrina, uno cubierto de coco y otro de chocolate y virutas, con etiquetas de precio',
	},
	{
		src: tartaDia,
		alt: 'Tarta blanca con el texto «Felicidades en tu día» en chocolate y corazones de azúcar',
	},
	{
		src: tartaOreo,
		alt: 'Tarta entera de galleta Oreo en la vitrina, con nata y galletas',
	},
	{
		src: tartaOreo2,
		alt: 'Tarta de galleta Oreo con cuatro galletas y sirope de chocolate',
	},
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"panaderia-la-esquinita-apaisada-01.jpg": fachada,
	"panaderia-la-esquinita-apaisada-02.jpg": corazones,
	"panaderia-la-esquinita-vertical-03.jpg": tartaGym,
	"panaderia-la-esquinita-apaisada-04.jpg": tartaAzul,
	"panaderia-la-esquinita-apaisada-05.jpg": vitrina,
	"panaderia-la-esquinita-vertical-06.jpg": tartaPeso,
	"panaderia-la-esquinita-vertical-07.jpg": pasteles,
	"panaderia-la-esquinita-vertical-08.jpg": tartaDia,
	"panaderia-la-esquinita-apaisada-09.jpg": tartaOreo,
	"panaderia-la-esquinita-vertical-10.jpg": tartaOreo2,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#fdf6e8" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=Outfit:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Esquinita, panadería Málaga, confitería Málaga, Eugenio Gross 11, Bailén-Miraflores, panes especiales, tartas personalizadas, sin gluten, sin azúcar, sin lactosa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="La Esquinita · Panadería y confitería en Bailén-Miraflores"
			ogDescription="Panes especiales, tartas personalizadas y dulces caseros en Eugenio Gross, 11. También sin gluten, sin azúcar y sin lactosa. 4,6 sobre 5 con 37 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de la Panadería y Confitería La Esquinita en la calle Eugenio Gross, 11"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#fdf6e8"
			phone="+34951993781"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Esquinita"
			subtitle="Panadería · Confitería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, descripción, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y disponibilidad pueden cambiar; confírmalos antes de ir."
			ctaLabel="Llamar a La Esquinita"
			navAriaLabel="Enlaces de La Esquinita"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
