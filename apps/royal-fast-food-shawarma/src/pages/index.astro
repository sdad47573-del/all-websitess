---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import tandoor from '../assets/fotos/royal-fast-food-shawarma-apaisada-05.jpg';
import pakoras from '../assets/fotos/royal-fast-food-shawarma-apaisada-08.jpg';
import fachada from '../assets/fotos/royal-fast-food-shawarma-apaisada-01.jpg';
import polloFrito from '../assets/fotos/royal-fast-food-shawarma-cuadrada-07.jpg';
import brocheta from '../assets/fotos/royal-fast-food-shawarma-vertical-02.jpg';
import empanadilla from '../assets/fotos/royal-fast-food-shawarma-vertical-06.jpg';
import kebab from '../assets/fotos/royal-fast-food-shawarma-vertical-09.jpg';
import tortitas from '../assets/fotos/royal-fast-food-shawarma-vertical-10.jpg';
import durum from '../assets/fotos/royal-fast-food-shawarma-vista-3-03.jpg';
import cartel from '../assets/fotos/royal-fast-food-shawarma-vertical-04.jpg';

import { BUSINESS, FAQ, HORARIO, HORARIO_AVISO, MAPS, RESENAS, SERVICIOS } from '../data/site';

const title = 'ROYAL FAST FOOD · Kebab, shawarma y pizza en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: tandoor,
		alt: 'Brochetas de pollo y carne dentro del horno tandoor de barro, con pan naan recién hecho alrededor',
	},
	{
		src: brocheta,
		alt: 'Brocheta de pollo tikka roja entrando al tandoor, sobre el acero de la cocina',
	},
	{
		src: durum,
		alt: 'Durum de pollo cortado por la mitad, con pimientos, queso y verduras dentro de la masa',
	},
	{
		src: kebab,
		alt: 'Kebab abierto con carne de pollo, lechuga, patatas, salsa blanca y salsa de tomate',
	},
	{
		src: empanadilla,
		alt: 'Empanadilla grande triangular rellena, con curry de garbanzos al lado y salsas blanca y barbacoa por encima',
	},
	{
		src: tortitas,
		alt: 'Tortitas de carne picada con cilantro, cebolla roja y lima, con salsa blanca al fondo',
	},
	{
		src: pakoras,
		alt: 'Pakoras de verdura fritas en una rejilla con un cuenco de salsa verde',
	},
	{
		src: polloFrito,
		alt: 'Bandeja de pollo frito con patatas y un refresco, con dos salsas en vasitos',
	},
	{
		src: fachada,
		alt: 'Fachada de Royal Fast Food de noche, con el rótulo morado y los vinilos de pizza, pollo frito, hamburguesa y kebab en el escaparate',
	},
	{
		src: cartel,
		alt: 'Cartel morado de próxima apertura de Royal Fast Food, con el logo de Royal Group y el teléfono de reservas',
	},
];

const carta = [
	{
		title: 'Kebab y durum',
		items: [
			{ name: 'Döner kebab', note: 'la especialidad de la casa, en pan o en plato' },
			{ name: 'Shawarma de pollo', note: 'recién cortado del asador vertical' },
			{ name: 'Durum de pollo', note: 'con pimientos, queso y verduras, como el de la foto' },
			{ name: 'Kebab con patatas', note: 'abierto con lechuga, patatas y doble salsa' },
		],
	},
	{
		title: 'Del tandoor',
		items: [
			{ name: 'Brochetas de pollo tikka', note: 'marinadas y hechas en el horno de barro' },
			{ name: 'Brochetas de carne', note: 'en el mismo tandoor, con pan naan' },
			{ name: 'Pan naan', note: 'recién hecho, pegado a la pared del horno' },
		],
	},
	{
		title: 'Fritos y pizza',
		items: [
			{ name: 'Pollo frito con patatas', note: 'en bandeja, con salsas' },
			{ name: 'Pakoras de verdura', note: 'fritas y con salsa verde' },
			{ name: 'Empanadilla rellena', note: 'con curry de garbanzos y salsas' },
			{ name: 'Pizza', note: 'la ficha lo clasifica también como pizzería' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'FastFoodRestaurant',
	'@id': `${BUSINESS.siteUrl}/#royal-fast-food`,
	name: BUSINESS.name,
	alternateName: ['Royal Fast Food', 'Royal Shawarma House', 'Royal Kebab Ciudad Real'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, BUSINESS.website],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Kebab', 'Shawarma', 'Pizza', 'Pollo frito', 'Comida turca'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Ciudad Real' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Código', value: '/g/11xm_4mwzp' },
	],
	hasMenu: BUSINESS.website,
	potentialAction: {
		'@type': 'OrderAction',
		target: {
			'@type': 'EntryPoint',
			urlTemplate: BUSINESS.website,
			inLanguage: 'es',
			actionPlatform: [
				'https://schema.org/DesktopWebPlatform',
				'https://schema.org/MobileWebPlatform',
			],
		},
	},
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '19:30',
			closes: '01:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '17:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1c1518" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,700&family=Nunito+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Royal Fast Food Ciudad Real, shawarma Ciudad Real, kebab Ciudad Real, döner kebab calle Feria, pizza Ciudad Real, pollo frito para llevar 13001, pedir kebab online Ciudad Real, Royal Kebab Ciudad Real"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Döner kebab, shawarma, durum, pollo frito y pizza en la calle Feria, 8, Ciudad Real. Cenas de 19:30 a 1:00 todos los días y mediodía de miércoles a domingo. Pedidos online y en el 613 39 41 91."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Royal Fast Food Shawarma House Kebab, en Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1c1518"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CR"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[tandoor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Royal Fast Food"
			subtitle="Kebab · Shawarma · Ciudad Real"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="Kebab, shawarma <br /><em>y horno de barro.</em>"
				lede="ROYAL FAST FOOD Shawarma House Kebab está en la calle Feria, 8, en pleno centro de Ciudad Real. Brochetas recién hechas en el tandoor, döner kebab y shawarma cortado al momento, durum, pollo frito y pizza, para tomar allí o pedir a domicilio en su web. Abre todas las noches de 19:30 a 1:00 y también a mediodía de miércoles a domingo. Teléfono 613 39 41 91."
				image={tandoor}
				imageAlt="Brochetas de pollo y carne dentro del horno tandoor de barro, con pan naan recién hecho alrededor"
				primaryCta={{ label: 'Pedir online', href: BUSINESS.website }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4</b> en Google · 172 reseñas' },
					{ label: 'Horario', html: '<b>19:30–1:00</b><br />mediodía de miércoles a domingo' },
					{ label: 'Pedidos', html: `<b>${BUSINESS.phone}</b> y en su web` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Royal Fast Food" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="El tandoor <br /><em>de la calle Feria.</em>"
				paragraphs={[
					'El local está en la calle Feria, 8, en el centro de Ciudad Real, con la fachada de ladrillo rojo y el rótulo morado de ROYAL FAST FOOD. En el escaparate se ven los vinilos con las cuatro familias de la casa: Royal Pizza, Royal Pollo Frito, Royal Hamburguesa y Royal Kebab.',
					'La ficha de Google lo clasifica como pizzería, restaurante especializado en döner kebab, restaurante de pollo frito para llevar y taquería. En las fotos de su perfil se ve el tandoor de barro con las brochetas de pollo tikka y de carne entrando y saliendo, el pan naan pegado a la pared del horno, el durum cortado con pimientos y queso, el kebab abierto con patatas y doble salsa, las pakoras de verdura y las tortitas de carne con cilantro.',
					'Todas las noches abre de 19:30 a 1:00, y de miércoles a domingo también a mediodía, de 13:00 a 17:00. Lunes y martes solo hay servicio de noche. La propia ficha avisa de que en el Día de Todos los Santos el horario podría ser distinto.',
					'La ficha tiene 172 reseñas y una media de 4,4. Google destaca tres: dos de cinco estrellas que hablan de la pizza, del kebab de pollo y del durum con masa fresca, y una de una estrella por un pedido equivocado. Aquí están las tres, con su puntuación.',
				]}
				note="La ficha de Google no publica carta ni precios, así que esta página no inventa importes: nombra los platos que aparecen en las fotos del perfil y en los tipos de cocina que declara el propio Google. Los pedidos online se hacen en la web del restaurante."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Web de pedidos del restaurante', href: BUSINESS.website, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Brocheta, durum <br /><em>y patatas.</em>"
				description="Lo que sale del tandoor y del asador vertical, con lo que se ve en las fotos y en la fachada del local. Sin precios publicados."
				cta={{ label: 'Ver la carta en Google Maps', href: MAPS.place }}
				groups={carta}
				note="Esta lista sale de las fotografías del perfil del establecimiento en Google Maps y de las categorías que publica Google. No hay carta con precios: el surtido del día se consulta en la web de pedidos o en el 613 39 41 91."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
					<div class="reviews-head">
						<h2 id="resenas-title">Pan crujiente <br /><em>y masa fresca.</em></h2>
						<p>
							La ficha tiene 172 reseñas y una media de 4,4. Estas son las tres que Google destaca, con
							la puntuación que les dio su autor: también la de una estrella.
						</p>
					</div>
					<div class="review-grid">
						{
							RESENAS.map((review) => (
								<figure class="review-card">
									<p class="review-stars" aria-label={`${review.rating} sobre 5`}>
										{'★'.repeat(review.rating)}
										<span aria-hidden="true">{'★'.repeat(5 - review.rating)}</span>
									</p>
									<blockquote>{review.quote}</blockquote>
									<figcaption>Reseña publicada en Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="review-note">
						Citas de las reseñas públicas del local, con la puntuación del autor. En la ficha de Google
						están todas, incluidas las que puntúan por debajo.
					</p>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Del horno <br /><em>al papel.</em>"
				description="Diez fotos del perfil del local: las brochetas en el tandoor, el durum, el kebab abierto, la empanadilla rellena, las tortitas de carne, las pakoras, el pollo frito con patatas, la fachada y el cartel de apertura."
				images={galeria}
				cta={{ label: 'Ver todas en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="Hasta <br /><em>la una.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Ciudad Real · España']}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de Royal Fast Food en la calle Feria, 8, Ciudad Real"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Royal Fast Food"
				mapHref={MAPS.place}
				links={[
					{ label: 'Pedir online', href: BUSINESS.website, external: true, variant: 'primary' },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="Los pedidos y el reparto se gestionan en la web del restaurante o por teléfono, en el 613 39 41 91; esta página no tramita pedidos ni cobra nada. La ficha no publica datos de accesibilidad, así que conviene llamar si necesitas confirmarlo."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Royal Fast Food"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Pedir online ↗', href: BUSINESS.website, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos, horario y fotografías tomados de la ficha y del perfil públicos del local en Google Maps, consultados en noviembre de 2026. Sin carta ni precios publicados: confirma horario, disponibilidad y reparto antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Royal Fast Food"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
