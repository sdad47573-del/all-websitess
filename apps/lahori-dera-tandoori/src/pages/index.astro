---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/lahori-dera-tandoori-apaisada-01.jpg';
import prato from '../assets/fotos/lahori-dera-tandoori-vertical-03.jpg';
import cartaEntradas from '../assets/fotos/lahori-dera-tandoori-vertical-04.jpg';
import cozinha from '../assets/fotos/lahori-dera-tandoori-panoramica-05.jpg';
import frangoTandoori from '../assets/fotos/lahori-dera-tandoori-vertical-06.jpg';
import capaCarta from '../assets/fotos/lahori-dera-tandoori-vertical-07.jpg';
import dal from '../assets/fotos/lahori-dera-tandoori-vertical-08.jpg';
import naanArroz from '../assets/fotos/lahori-dera-tandoori-apaisada-09.jpg';
import sala from '../assets/fotos/lahori-dera-tandoori-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICOS,
} from '../data/site';

const title = 'Lahori Dera Tandoori · Cozinha indiana em Almada';
const description = BUSINESS.description;

const galeria = [
	{
		src: sala,
		alt: 'Sala do Lahori Dera com paredes de azulejo, mesas de toalha branca e vermelha, cadeiras de madeira e candeeiros de braços',
	},
	{
		src: fachada,
		alt: 'Fachada do Lahori Dera com os letreiros vermelhos do restaurante tandoori e da pizzaria, e mesas na rua',
	},
	{
		src: prato,
		alt: 'Prato de arroz amarelo com legumes e uma tigela de caril ao lado',
	},
	{
		src: cartaEntradas,
		alt: 'Página de entradas da carta do Lahori Dera, com samosas, pakoras, tikka, seekh kebab, saladas e pães',
	},
	{
		src: cozinha,
		alt: 'Balcão e forno da casa, com um funcionário, o forno de tandoor e a carta luminosa de pizzas por cima',
	},
	{
		src: capaCarta,
		alt: 'Capa da carta do Lahori Dera com o selo 100% halal, os telefones e a morada no Laranjeiro',
	},
	{
		src: dal,
		alt: 'Tigela de dal com uma noz de manteiga e gengibre em juliana',
	},
	{
		src: naanArroz,
		alt: 'Cesto de naan cortado e prato de arroz amarelo numa mesa de toalha branca',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#lahori-dera`,
	name: BUSINESS.name,
	alternateName: ['Lahori Dera', 'Lahori Dera Almada', 'Lahori Dera Laranjeiro'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Indiana', 'Tandoori', 'Kebab', 'Pizza'],
	areaServed: [
		{ '@type': 'City', name: 'Almada' },
		{ '@type': 'AdministrativeArea', name: 'Laranjeiro e Feijó' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '11:00',
			closes: '23:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"lahori-dera-tandoori-vertical-06.jpg": frangoTandoori,
	"lahori-dera-tandoori-vertical-10.jpg": sala,
	"lahori-dera-tandoori-apaisada-01.jpg": fachada,
	"lahori-dera-tandoori-vertical-03.jpg": prato,
	"lahori-dera-tandoori-vertical-04.jpg": cartaEntradas,
	"lahori-dera-tandoori-panoramica-05.jpg": cozinha,
	"lahori-dera-tandoori-vertical-07.jpg": capaCarta,
	"lahori-dera-tandoori-vertical-08.jpg": dal,
	"lahori-dera-tandoori-apaisada-09.jpg": naanArroz,
};
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1c1412" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Mulish:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Lahori Dera Tandoori Restaurant Halal, Lahori Dera Almada, Lahori Dera Laranjeiro, restaurante indiano Almada, tandoori Almada, frango tandoori Laranjeiro, comer halal Almada, pizzaria Almada"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cozinha indiana e tandoori no Largo Francisco Sanches, loja 2A, no Laranjeiro, Almada. Todos os dias das 11:00 às 23:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tabuleiro de frango tandoori do Lahori Dera"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1c1412"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-15"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Laranjeiro, Almada"
			locale="pt_PT"
			countryName="Portugal"
			preload={[frangoTandoori]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Lahori Dera"
			subtitle="Tandoori · Laranjeiro"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Informação elaborada a partir de fontes públicas; confirma horário e oferta antes da visita."
			ctaLabel="Ligar"
			navAriaLabel="Ligações do Lahori Dera Tandoori Restaurant Halal"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/351214030626?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Almada." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Almada"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
