---
import Contact from '../components/Contact.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import Hero4 from '../components/Hero4.astro';
import Section1 from '../components/Section1.astro';
import Stepper from '../components/Stepper.astro';
import CustomLayout from '../layouts/CustomLayout.astro';
---

<CustomLayout
	title="Sur Digital Málaga | Tu Presencia Digital Comienza Aquí | Agencia de Marketing Web Online"
	description="Empieza hoy desde 0€, crea tu presencia online en menos de 7 días. Webs rápidas, modernas y optimizadas."
>
	<Hero4 />
	<Stepper />
	<Section1 />
	<section id="portfolio" class="to-base-300 bg-gradient-to-tl from-white py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mb-16 text-center">
				<h2 class="mb-4 text-4xl font-bold text-gray-900">Nuestro Portfolio</h2><p
					class="mx-auto max-w-3xl text-xl text-gray-600"
				>
					Algunos de los proyectos que hemos realizado para nuestros clientes
				</p>
			</div><div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
				<div
					class="group relative overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover:shadow-2xl"
				>
					<img
						alt="Restaurante Gourmet"
						class="h-64 w-full object-cover transition-transform duration-300 group-hover:scale-110"
						src="https://readdy.ai/api/search-image?query=modern%20elegant%20restaurant%20website%20design%20with%20dark%20background%2C%20professional%20layout%2C%20food%20photography%2C%20reservation%20system%2C%20clean%20typography%2C%20luxury%20aesthetic&width=400&height=300&seq=1&orientation=landscape"
					/><div
						class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
					>
						<div class="absolute right-4 bottom-4 left-4 text-white">
							<span class="rounded-full bg-blue-600 px-2 py-1 text-sm">Web Corporativa</span><h3
								class="mt-2 text-xl font-semibold"
							>
								Restaurante Gourmet
							</h3>
						</div>
					</div>
				</div><div
					class="group relative overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover:shadow-2xl"
				>
					<img
						alt="Tienda de Moda"
						class="h-64 w-full object-cover transition-transform duration-300 group-hover:scale-110"
						src="https://readdy.ai/api/search-image?query=fashion%20ecommerce%20website%20design%2C%20clothing%20store%20online%2C%20product%20catalog%2C%20shopping%20cart%2C%20modern%20minimalist%20design%2C%20white%20background&width=400&height=300&seq=2&orientation=landscape"
					/><div
						class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
					>
						<div class="absolute right-4 bottom-4 left-4 text-white">
							<span class="rounded-full bg-blue-600 px-2 py-1 text-sm">Ecommerce</span><h3
								class="mt-2 text-xl font-semibold"
							>
								Tienda de Moda
							</h3>
						</div>
					</div>
				</div><div
					class="group relative overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover:shadow-2xl"
				>
					<img
						alt="Clínica Médica"
						class="h-64 w-full object-cover transition-transform duration-300 group-hover:scale-110"
						src="https://readdy.ai/api/search-image?query=medical%20clinic%20website%20design%2C%20healthcare%20professional%20layout%2C%20appointment%20booking%2C%20clean%20white%20design%2C%20trust%20and%20credibility&width=400&height=300&seq=3&orientation=landscape"
					/><div
						class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
					>
						<div class="absolute right-4 bottom-4 left-4 text-white">
							<span class="rounded-full bg-blue-600 px-2 py-1 text-sm">Web Corporativa</span><h3
								class="mt-2 text-xl font-semibold"
							>
								Clínica Médica
							</h3>
						</div>
					</div>
				</div><div
					class="group relative overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover:shadow-2xl"
				>
					<img
						alt="Agencia Inmobiliaria"
						class="h-64 w-full object-cover transition-transform duration-300 group-hover:scale-110"
						src="https://readdy.ai/api/search-image?query=real%20estate%20website%20design%2C%20property%20listings%2C%20search%20filters%2C%20modern%20professional%20layout%2C%20blue%20and%20white%20colors&width=400&height=300&seq=4&orientation=landscape"
					/><div
						class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
					>
						<div class="absolute right-4 bottom-4 left-4 text-white">
							<span class="rounded-full bg-blue-600 px-2 py-1 text-sm">Portal Web</span><h3
								class="mt-2 text-xl font-semibold"
							>
								Agencia Inmobiliaria
							</h3>
						</div>
					</div>
				</div><div
					class="group relative overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover:shadow-2xl"
				>
					<img
						alt="Estudio de Arquitectura"
						class="h-64 w-full object-cover transition-transform duration-300 group-hover:scale-110"
						src="https://readdy.ai/api/search-image?query=architecture%20studio%20website%20design%2C%20portfolio%20showcase%2C%20project%20gallery%2C%20minimalist%20design%2C%20concrete%20and%20glass%20aesthetic&width=400&height=300&seq=5&orientation=landscape"
					/><div
						class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
					>
						<div class="absolute right-4 bottom-4 left-4 text-white">
							<span class="rounded-full bg-blue-600 px-2 py-1 text-sm">Portfolio</span><h3
								class="mt-2 text-xl font-semibold"
							>
								Estudio de Arquitectura
							</h3>
						</div>
					</div>
				</div><div
					class="group relative overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover:shadow-2xl"
				>
					<img
						alt="Tienda de Tecnología"
						class="h-64 w-full object-cover transition-transform duration-300 group-hover:scale-110"
						src="https://readdy.ai/api/search-image?query=technology%20store%20website%20design%2C%20electronics%20ecommerce%2C%20product%20showcase%2C%20modern%20tech%20aesthetic%2C%20dark%20theme%20with%20blue%20accents&width=400&height=300&seq=6&orientation=landscape"
					/><div
						class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
					>
						<div class="absolute right-4 bottom-4 left-4 text-white">
							<span class="rounded-full bg-blue-600 px-2 py-1 text-sm">Ecommerce</span><h3
								class="mt-2 text-xl font-semibold"
							>
								Tienda de Tecnología
							</h3>
						</div>
					</div>
				</div>
			</div>
			<div class="mt-12 text-center">
				<div
					class="mx-auto mb-8 max-w-3xl rounded-lg md:bg-white/90 md:p-6 md:shadow-sm md:backdrop-blur-sm"
				>
					<h3 class="mb-4 text-2xl font-bold text-gray-900">
						¿Quieres ser nuestro próximo caso de éxito?
					</h3><p class="mb-6 text-lg text-gray-600">
						Únete a más de 150 empresas malagueñas que ya están creciendo con nuestras estrategias
						digitales.
					</p><a
						href="https://wa.me/34614032511"
						class="btn btn-primary btn-xl rounded-full px-8 text-lg font-semibold transition-colors"
						>Empezar Ahora</a
					>
				</div>
			</div>
		</div>
	</section>
	<!-- <NotUseKit /> -->

	<section class="bg-wave text-primary-content w-full pt-14 pb-20">
		<div class="container mx-auto flex flex-col items-center px-6 text-center">
			<p class="pb-6 text-center text-4xl font-bold md:text-5xl">🧭 Nuestro enfoque</p>
			<p class="max-w-3xl text-lg">
				Creemos que la verdadera digitalización no debería depender de una subvención, sino de
				<span class="hover:noise font-bold underline">
					una estrategia bien pensada y ejecutada con profesionalidad
				</span>. Si buscas una transformación digital real, te acompañaremos paso a paso con
				<span class="hover:noise font-bold underline"> soluciones a largo plazo </span>.
			</p>
		</div>
	</section>
	<GoogleReviews />

	<Contact />
</CustomLayout>
