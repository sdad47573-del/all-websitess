---
import Layout from "../layouts/Layout.astro";

import Topbar from "../components/Topbar.astro";
import Hero4 from "../components/Hero4.astro";
import Stepper from "../components/Stepper.astro";
import Section1 from "../components/Section1.astro";
import Footer from "../components/Footer.astro";
import Contact from "../components/Contact.astro";
import Fab from "../components/Fab.astro";
import GoogleReviews from "../components/GoogleReviews.astro";
---

<Layout
  title="Sur Digital Málaga | Tu Presencia Digital Comienza Aquí | Agencia de Marketing Web Online"
  description="Empieza hoy desde 0€, crea tu presencia online en menos de 7 días. Webs rápidas, modernas y optimizadas."
>
  <Topbar />
  <Hero4 />
  <Stepper />
  <Section1 />
  <section
    id="portfolio"
    class="py-20 bg-gradient-to-tl to-base-300 from-white"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">
          Nuestro Portfolio
        </h2><p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Algunos de los proyectos que hemos realizado para nuestros clientes
        </p>
      </div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div
          class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300"
        >
          <img
            alt="Restaurante Gourmet"
            class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-300"
            src="https://readdy.ai/api/search-image?query=modern%20elegant%20restaurant%20website%20design%20with%20dark%20background%2C%20professional%20layout%2C%20food%20photography%2C%20reservation%20system%2C%20clean%20typography%2C%20luxury%20aesthetic&width=400&height=300&seq=1&orientation=landscape"
          /><div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          >
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <span class="text-sm bg-blue-600 px-2 py-1 rounded-full"
                >Web Corporativa</span
              ><h3 class="text-xl font-semibold mt-2">Restaurante Gourmet</h3>
            </div>
          </div>
        </div><div
          class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300"
        >
          <img
            alt="Tienda de Moda"
            class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-300"
            src="https://readdy.ai/api/search-image?query=fashion%20ecommerce%20website%20design%2C%20clothing%20store%20online%2C%20product%20catalog%2C%20shopping%20cart%2C%20modern%20minimalist%20design%2C%20white%20background&width=400&height=300&seq=2&orientation=landscape"
          /><div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          >
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <span class="text-sm bg-blue-600 px-2 py-1 rounded-full"
                >Ecommerce</span
              ><h3 class="text-xl font-semibold mt-2">Tienda de Moda</h3>
            </div>
          </div>
        </div><div
          class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300"
        >
          <img
            alt="Clínica Médica"
            class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-300"
            src="https://readdy.ai/api/search-image?query=medical%20clinic%20website%20design%2C%20healthcare%20professional%20layout%2C%20appointment%20booking%2C%20clean%20white%20design%2C%20trust%20and%20credibility&width=400&height=300&seq=3&orientation=landscape"
          /><div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          >
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <span class="text-sm bg-blue-600 px-2 py-1 rounded-full"
                >Web Corporativa</span
              ><h3 class="text-xl font-semibold mt-2">Clínica Médica</h3>
            </div>
          </div>
        </div><div
          class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300"
        >
          <img
            alt="Agencia Inmobiliaria"
            class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-300"
            src="https://readdy.ai/api/search-image?query=real%20estate%20website%20design%2C%20property%20listings%2C%20search%20filters%2C%20modern%20professional%20layout%2C%20blue%20and%20white%20colors&width=400&height=300&seq=4&orientation=landscape"
          /><div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          >
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <span class="text-sm bg-blue-600 px-2 py-1 rounded-full"
                >Portal Web</span
              ><h3 class="text-xl font-semibold mt-2">Agencia Inmobiliaria</h3>
            </div>
          </div>
        </div><div
          class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300"
        >
          <img
            alt="Estudio de Arquitectura"
            class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-300"
            src="https://readdy.ai/api/search-image?query=architecture%20studio%20website%20design%2C%20portfolio%20showcase%2C%20project%20gallery%2C%20minimalist%20design%2C%20concrete%20and%20glass%20aesthetic&width=400&height=300&seq=5&orientation=landscape"
          /><div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          >
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <span class="text-sm bg-blue-600 px-2 py-1 rounded-full"
                >Portfolio</span
              ><h3 class="text-xl font-semibold mt-2">
                Estudio de Arquitectura
              </h3>
            </div>
          </div>
        </div><div
          class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300"
        >
          <img
            alt="Tienda de Tecnología"
            class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-300"
            src="https://readdy.ai/api/search-image?query=technology%20store%20website%20design%2C%20electronics%20ecommerce%2C%20product%20showcase%2C%20modern%20tech%20aesthetic%2C%20dark%20theme%20with%20blue%20accents&width=400&height=300&seq=6&orientation=landscape"
          /><div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          >
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <span class="text-sm bg-blue-600 px-2 py-1 rounded-full"
                >Ecommerce</span
              ><h3 class="text-xl font-semibold mt-2">Tienda de Tecnología</h3>
            </div>
          </div>
        </div>
      </div>
      <div class="text-center mt-12">
        <div
          class="md:bg-white/90 md:backdrop-blur-sm md:p-6 rounded-lg md:shadow-sm mb-8 max-w-3xl mx-auto"
        >
          <h3 class="text-2xl font-bold text-gray-900 mb-4">
            ¿Quieres ser nuestro próximo caso de éxito?
          </h3><p class="text-lg text-gray-600 mb-6">
            Únete a más de 150 empresas malagueñas que ya están creciendo con
            nuestras estrategias digitales.
          </p><a
            href="https://wa.me/34614032511"
            class="btn btn-primary px-8 rounded-full text-lg font-semibold transition-colors btn-xl"
            >Empezar Ahora</a
          >
        </div>
      </div>
    </div>
  </section>
  <!-- <NotUseKit /> -->

  <section class="w-full bg-wave text-primary-content pt-14 pb-20">
    <div class="mx-auto container text-center flex flex-col items-center px-6">
      <p class="text-4xl md:text-5xl font-bold text-center pb-6">
        🧭 Nuestro enfoque
      </p>
      <p class="max-w-3xl text-lg">
        Creemos que la verdadera digitalización no debería depender de una
        subvención, sino de
        <span class="font-bold hover:noise underline">
          una estrategia bien pensada y ejecutada con profesionalidad
        </span>. Si buscas una transformación digital real, te acompañaremos
        paso a paso con
        <span class="font-bold hover:noise underline">
          soluciones a largo plazo
        </span>.
      </p>
    </div>
  </section>
  <GoogleReviews />

  <Contact />
  <Fab />

  <Footer />
</Layout>
