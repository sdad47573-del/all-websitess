---
import { Image } from 'astro:assets';
import { twJoin } from 'tailwind-merge';

import { DATA, PHONE, MAIL, STREET } from '../data/data.astro';

import Logo from '../assets/logoreverse.png';
---

<footer class="bg-gray-900 py-12 text-white">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 gap-8 md:grid-cols-4">
			<div>
				<Image src={Logo} alt="" class="mb-4 h-auto w-32 object-contain" />

				<p class="mb-4 text-gray-400">
					Tu agencia de confianza para el diseño web y marketing digital en España.
				</p><div class="flex space-x-4">
					<!-- <a
            href="#"
            class="text-gray-400 hover:text-white transition-colors cursor-pointer"
            ><i class="ri-facebook-fill text-xl"></i></a
          ><a
            href="#"
            class="text-gray-400 hover:text-white transition-colors cursor-pointer"
            ><i class="ri-twitter-fill text-xl"></i></a
          ><a
            href="#"
            class="text-gray-400 hover:text-white transition-colors cursor-pointer"
            ><i class="ri-instagram-fill text-xl"></i></a
          > -->
					<a
						href="https://www.linkedin.com/in/jose-antonio-aguilar-granados/"
						rel="noopener"
						target="_blank"
						class="cursor-pointer text-gray-400 transition-colors hover:text-white"
						><i class="ri-linkedin-fill text-xl"></i></a
					>
				</div>
			</div>
			<div>
				<h4 class="mb-4 text-lg font-semibold">Servicios</h4><ul class="space-y-2 text-gray-400">
					<li>
						<a href="#servicios" class="cursor-pointer transition-colors hover:text-white"
							>Diseño Web</a
						>
					</li><li>
						<a href="#servicios" class="cursor-pointer transition-colors hover:text-white"
							>Tiendas Online</a
						>
					</li><li>
						<a href="#servicios" class="cursor-pointer transition-colors hover:text-white">SEO</a>
					</li><li>
						<a href="#servicios" class="cursor-pointer transition-colors hover:text-white"
							>Marketing Digital</a
						>
					</li>
				</ul>
			</div>

			<div>
				<h4 class="mb-4 text-lg font-semibold">Contacto</h4><div class="space-y-2 text-gray-400">
					<div class="flex items-center">
						<i class="ri-phone-line mr-2"></i><span>{PHONE}</span>
					</div><div class="flex items-center">
						<i class="ri-mail-line mr-2"></i><span class="break-all">{MAIL}</span>
					</div><div class="flex items-center">
						<i class="ri-map-pin-line mr-2"></i><span>{STREET}</span>
					</div>
				</div>
			</div>
			<div>
				<h4 class="mb-4 text-lg font-semibold">Horario</h4>
				<ul class="space-y-2 text-gray-400">
					<li class="text-gray-300"><strong>de Lunes a Viernes</strong></li><li
						class="flex items-center"
					>
						<i class="ri-time-line mr-2"></i>10:00 a 22:00 horas
					</li><li class="text-gray-300"><strong>Soporte</strong></li><li class="flex items-center">
						<i class="ri-time-line mr-2"></i>24 horas
					</li>
				</ul>
			</div>
		</div>
		<div
			class="mt-8 flex flex-col items-center justify-between border-t border-gray-800 pt-8 md:flex-row"
		>
			<p class="text-sm text-gray-300">
				© {new Date().getFullYear()} Sur Digital - Todos los derechos reservados.
			</p>
			<!-- <div class="flex gap-6 flex-wrap mt-4 md:mt-0">
        <a
          href="#"
          class="text-gray-300 hover:text-white text-sm transition-colors"
          >Aviso Legal</a
        ><a
          href="#"
          class="text-gray-300 hover:text-white text-sm transition-colors"
          >Política de Cookies</a
        ><a
          href="#"
          class="text-gray-300 hover:text-white text-sm transition-colors"
          >Política de Privacidad</a
        >
      </div> -->
		</div>
	</div>
</footer>
