---
import DoneIcon from "../icons/DoneIcon.astro";
// * “¿Tu web actual no te convence? Te la mejoramos GRATIS o a bajo costo.”
//   * “Transformamos tu página web antigua en un sitio moderno y profesional.”
---

<section
  class="pt-14 pb-20 bg-gradient-to-bl to-base-300 from-white flex flex-col items-center"
>
  <div class="container mx-auto px-6 text-center">
    <p class="text-4xl md:text-5xl font-bold text-gray-900">
      ¿No estás satisfecho con tu web actual?
    </p>
    <p class="mb- text-gray-600">
      Muchas páginas se quedan atrás con el tiempo:
    </p><p class="mb-4 text-neutral font-bold">
      lentas, poco atractivas o difíciles de usar en móvil.
    </p>
    <p class="text-gray-600 text-lg mx-auto mb-6">
      <span class="font-bold text-wave text-xl"> Rediseñamos tu web </span>para
      que luzca

      <span class="font-bold text-wave text-xl">
        moderna, rápida y optimizada para móviles.
      </span>
    </p>
    <!-- class="bg-white/90 backdrop-blur-sm p-6 rounded-lg shadow-sm mb-8 max-w-3xl mx-auto" -->
    <div
      class="md:bg-white/90 md:backdrop-blur-sm md:p-6 rounded-lg md:shadow-sm mb-8 max-w-3xl mx-auto"
    >
      <p class="mb-4">
        Envíanos la <span class="font-bold">URL de tu sitio actual</span> y te daremos
        una <span class="font-bold text-secondary text-lg noise">
          propuesta de mejora gratuita:</span
        >
      </p><ul class="text-left max-w-md font-bold mx-auto space-y-2">
        <li class="flex items-center">
          <span class="mr-3">🔍</span> Análisis de diseño y usabilidad
        </li><li class="flex items-center">
          <span class="mr-3">🎨</span> Diseño actualizado y atractivo
        </li><li class="flex items-center">
          <span class="mr-3">⚡</span> Mejora de velocidad y experiencia de usuario
        </li><li class="flex items-center">
          <span class="mr-3">📱</span> Optimización para móviles
        </li><li class="flex items-center">
          <span class="mr-3">🧭</span> Optimización SEO
        </li>
      </ul>
    </div>
    <a
      href="https://wa.me/34614032511"
      target="_blank"
      rel="noopener"
      class="btn btn-secondary w-full sm:w-fit sm:btn-xl btn-lg mb-6"
      >Solicita tu revisión gratuita</a
    >
  </div>
</section>
