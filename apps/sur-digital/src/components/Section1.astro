---
import { DoneIcon } from '@astro-icons';

// * “¿Tu web actual no te convence? Te la mejoramos GRATIS o a bajo costo.”
//   * “Transformamos tu página web antigua en un sitio moderno y profesional.”
---

<section class="to-base-300 flex flex-col items-center bg-gradient-to-bl from-white pt-14 pb-20">
	<div class="container mx-auto px-6 text-center">
		<p class="text-4xl font-bold text-gray-900 md:text-5xl">
			¿No estás satisfecho con tu web actual?
		</p>
		<p class="mb- text-gray-600">Muchas páginas se quedan atrás con el tiempo:</p><p
			class="text-neutral mb-4 font-bold"
		>
			lentas, poco atractivas o difíciles de usar en móvil.
		</p>
		<p class="mx-auto mb-6 text-lg text-gray-600">
			<span class="text-wave text-xl font-bold"> Rediseñamos tu web </span>para que luzca

			<span class="text-wave text-xl font-bold"> moderna, rápida y optimizada para móviles. </span>
		</p>
		<!-- class="bg-white/90 backdrop-blur-sm p-6 rounded-lg shadow-sm mb-8 max-w-3xl mx-auto" -->
		<div
			class="mx-auto mb-8 max-w-3xl rounded-lg md:bg-white/90 md:p-6 md:shadow-sm md:backdrop-blur-sm"
		>
			<p class="mb-4">
				Envíanos la <span class="font-bold">URL de tu sitio actual</span> y te daremos una <span
					class="text-secondary noise text-lg font-bold"
				>
					propuesta de mejora gratuita:</span
				>
			</p><ul class="mx-auto max-w-md space-y-2 text-left font-bold">
				<li class="flex items-center">
					<span class="mr-3">🔍</span> Análisis de diseño y usabilidad
				</li><li class="flex items-center">
					<span class="mr-3">🎨</span> Diseño actualizado y atractivo
				</li><li class="flex items-center">
					<span class="mr-3">⚡</span> Mejora de velocidad y experiencia de usuario
				</li><li class="flex items-center">
					<span class="mr-3">📱</span> Optimización para móviles
				</li><li class="flex items-center">
					<span class="mr-3">🧭</span> Optimización SEO
				</li>
			</ul>
		</div>
		<a
			href="https://wa.me/34614032511"
			target="_blank"
			rel="noopener"
			class="btn btn-secondary sm:btn-xl btn-lg mb-6 w-full sm:w-fit"
			>Solicita tu revisión gratuita</a
		>
	</div>
</section>
