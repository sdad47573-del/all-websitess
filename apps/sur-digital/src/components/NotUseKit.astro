---
import { DATA } from '../data/data.astro';
---

<section class="to-base-300 flex flex-col items-center bg-gradient-to-bl from-white pt-14 pb-20">
	<div class="container mx-auto flex flex-col items-center px-6">
		<p class="text-center text-4xl font-bold text-gray-900 md:text-5xl">
			No uses el <span class="text-neutral"> Kit Digital </span>
		</p>
		<p class="mb-12 text-center text-gray-600">
			Te contamos lo que nadie te cuenta sobre la subvención
		</p>

		<ul class="mb-8 flex flex-col">
			<!-- <ul class="flex flex-col mb-8 max-w-3xl"> -->
			{
				DATA.kitDigital.map(({ icon: Icon, title, label }) => (
					<li class="flex flex-col items-center gap-4 px-2 py-4 md:flex-row">
						<Icon class="size-12" />
						<div class="flex flex-col px-2">
							<p class="pb-2 text-center text-lg font-bold md:text-start">{title}</p>
							<p class="max-w-2xl text-center md:text-start" set:html={label} />
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
