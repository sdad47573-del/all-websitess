---
import { DATA } from '../data/data.astro';
---

<section class="to-base-300 flex flex-col items-center bg-gradient-to-bl from-white pt-14 pb-20">
	<div class="container mx-auto px-6 text-center">
		<p class="mb-16 text-3xl font-bold text-gray-900 md:text-4xl">
			Servicios completos para crear tu <span
				class="text-secondary noise text-4xl font-bold md:text-5xl">página web</span
			>.
		</p>

		<ul class="grid grid-cols-1 justify-items-center gap-10 md:grid-cols-2 lg:grid-cols-3">
			{
				DATA.services.map(({ icon: Icon, title, label }) => (
					<li class="flex max-w-[290px] flex-col items-center">
						<Icon />
						<p class="pt-4 pb-2 text-lg font-bold">{title}</p>
						<p>{label}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
