---
import Banner from '@assets/banner.png';
import { getImage } from '@astro-components';
import { DATA } from '../data/data.astro';

const optimized = await getImage({ src: Banner, width: 700, format: 'webp' });
---

<!-- class="pt-28 md:pt-56 pb-20 bg-gradient-to-br from-base-300 bg-bottom-right to-white bg-cover" -->
<section
	id="inicio"
	class="from-base-300 relative flex items-center bg-gradient-to-br to-white bg-bottom-right pt-40 pb-20"
>
	<!-- style='background-image: url("/ea3b2cec2a9403f22fc900587b8aff60.jpg"); background-size: cover; background-position: center center; background-blend-mode: overlay;' -->
	<!-- style={`background-image: linear-gradient(to bottom right, oklch(0.93 0.03 255.59 / 0.5), rgb(255 255 255)), linear-gradient(to bottom left, oklch(0.93 0.03 255.59 / 0.51), oklch(0.93 0.03 255.59)), url(${optimized.src});`} -->
	<div class="container mx-auto px-6 text-center">
		<div class="">
			<p class="font-bold opacity-60">Agencia de páginas web en Málaga</p>

			<h1 class="mb-6 text-5xl font-bold text-gray-900 md:text-6xl">
				Tu <span class="text-wave">Presencia Digital</span> Comienza Aquí
			</h1>

			<p class="mx-auto mb-8 max-w-2xl text-xl text-gray-600">
				Empieza hoy desde <span
					class="text-secondary noise text-3xl font-bold transition-all md:text-2xl md:hover:text-3xl"
					>0€</span
				>, lanza tu web profesional en <span
					class="hover:noise font-bold transition-all hover:text-3xl md:hover:text-2xl"
					>menos de 7 días</span
				>.
			</p>
		</div>
		<div class="mt-16 flex flex-col items-center justify-center gap-4 sm:flex-row">
			<!-- class="bg-teal-600 text-white px-8 py-4 rounded-full text-lg font-semibold hover:bg-teal-700 transition-all duration-300 transform hover:scale-105 cursor-pointer whitespace-nowrap" -->
			<a
				href="https://wa.me/34614032511"
				rel="noopener noreferrer"
				target="_blank"
				class="btn btn-primary btn-xl transform rounded-full px-8 text-lg font-semibold transition-all duration-300 hover:scale-105"
				>Solicitar Consulta Gratuita</a
			>
			<a
				href="/#servicios"
				class="btn btn-outline btn-xl cursor-pointer rounded-full px-8 text-lg whitespace-nowrap transition-all duration-300 hover:border-white hover:bg-white"
				>Ver Servicios</a
			>
		</div>
		<div class="mt-16 grid max-w-2xl grid-cols-1 gap-8 place-self-center md:grid-cols-3">
			<div class="text-center">
				<div class="text-wave mb-2 text-3xl font-bold md:text-4xl">150+</div><div class="">
					Empresas en Málaga
				</div>
			</div><div class="text-center">
				<div class="text-wave mb-2 text-3xl font-bold md:text-4xl">300%</div><div class="">
					Aumento Promedio ROI
				</div>
			</div><div class="text-center">
				<div class="text-wave mb-2 text-3xl font-bold md:text-4xl">5 años</div><div class="">
					Experiencia Local
				</div>
			</div>
		</div>
	</div>
</section>
<section id="servicios" class="to-base-300 bg-gradient-to-bl from-white py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mb-16 text-center">
			<p class="noise mb-2 text-lg font-semibold">tu agencia de marketing digital Málaga</p><h2
				class="mb-6 text-3xl font-bold text-gray-900 md:text-4xl"
			>
				Servicios de marketing digital
			</h2><p class="mx-auto max-w-3xl text-lg text-gray-600">
				En nuestra <strong>agencia de marketing online</strong> impulsamos la presencia en internet de
				nuestros clientes con estrategias efectivas de marketing digital. Diseñamos soluciones personalizadas
				para alcanzar tus objetivos y destacar frente a la competencia.
			</p>
		</div>
		<ul
			class="mb-8 grid grid-cols-1 justify-items-center justify-self-center text-center sm:grid-cols-2 lg:grid-cols-3"
		>
			{
				DATA.services.map(({ icon: Icon, title, label }) => (
					<li class="hover:noise hover:border-secondary flex max-w-[290px] flex-col place-content-center items-center rounded-sm border-2 border-transparent p-6 transition-all">
						<Icon class="size-12" />
						<p class="pt-4 pb-2 text-xl font-bold">{title}</p>
						<p>{label}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
