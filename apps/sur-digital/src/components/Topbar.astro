---
import { Image } from 'astro:assets';
import Logo from '../assets/logo.png';
import { HREF_PHONE, PHONE } from '../data/data.astro';
---

<header class="fixed z-50 w-full bg-white/90 shadow-sm backdrop-blur-sm">
	<nav class="container mx-auto px-6 py-4">
		<div class="flex items-center justify-between">
			<div class="flex items-center space-x-2">
				<Image src={Logo} alt="" class="h-8 w-auto" />
			</div>
			<nav class="hidden items-center lg:flex">
				{
					[
						{ href: '#inicio', label: 'Inicio' },
						{ href: '#servicios', label: 'Servicios', badge: true },
						{ href: '#portfolio', label: 'Portfolio' },
						{ href: '#testimonios', label: 'Testimonios' },
						{ href: '#contacto', label: 'Contacto' },
					].map(({ href, label }) => (
						<a
							href={href}
							class="hover:badge hover:badge-soft badge-primary badge-xl hover:badge-xl cursor-pointer !text-base whitespace-nowrap transition-colors"
						>
							{label}
						</a>
					))
				}
			</nav>
			<!-- 
          <a
            href="#precios"
            class="text-gray-600 hover:text-blue-600 transition-colors"
            >Precios</a
          >
             -->

			<div class="flex items-center space-x-4">
				<a
					href={HREF_PHONE}
					target="_blank"
					rel="noopener"
					class="hover:text-primary hidden whitespace-nowrap transition-colors sm:inline-flex"
					><i class="ri-phone-fill mr-2"></i>{PHONE}</a
				>
				<a
					href={HREF_PHONE}
					target="_blank"
					rel="noopener"
					class="btn btn-primary flex items-center gap-2">Consulta Gratis</a
				>
			</div>
		</div>
	</nav>
</header>
