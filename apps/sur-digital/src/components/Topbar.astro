---
import { Image } from "astro:assets";
import Logo from "../assets/logo.png";
import { HREF_PHONE, PHONE } from "../data/data.astro";
---

<header class="fixed w-full bg-white/90 backdrop-blur-sm z-50 shadow-sm">
  <nav class="container mx-auto px-6 py-4">
    <div class="flex justify-between items-center">
      <div class="flex items-center space-x-2">
        <Image src={Logo} alt="" class="h-8 w-auto" />
      </div>
      <nav class="hidden lg:flex items-center">
        {
          [
            { href: "#inicio", label: "Inicio" },
            { href: "#servicios", label: "Servicios", badge: true },
            { href: "#portfolio", label: "Portfolio" },
            { href: "#testimonios", label: "Testimonios" },
            { href: "#contacto", label: "Contacto" },
          ].map(({ href, label }) => (
            <a
              href={href}
              class="hover:badge hover:badge-soft badge-primary badge-xl hover:badge-xl !text-base   transition-colors cursor-pointer whitespace-nowrap"
            >
              {label}
            </a>
          ))
        }
      </nav>
      <!-- 
          <a
            href="#precios"
            class="text-gray-600 hover:text-blue-600 transition-colors"
            >Precios</a
          >
             -->

      <div class="flex items-center space-x-4">
        <a
          href={HREF_PHONE}
          target="_blank"
          rel="noopener"
          class="hover:text-primary transition-colors whitespace-nowrap hidden sm:inline-flex"
          ><i class="ri-phone-fill mr-2"></i>{PHONE}</a
        >
        <a
          href={HREF_PHONE}
          target="_blank"
          rel="noopener"
          class="btn btn-primary items-center flex gap-2">Consulta Gratis</a
        >
      </div>
    </div>
  </nav>
</header>
