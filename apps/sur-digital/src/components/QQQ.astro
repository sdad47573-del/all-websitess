---
import { Image } from 'astro:assets';
import QRImg from '../assets/qr.svg';
---

<button
	class="group fixed bottom-4 left-4 z-50 flex flex-col transition-all hover:rounded-sm hover:bg-black/50 hover:p-2 hover:backdrop-blur-md focus:rounded-sm focus:bg-black/50 focus:p-2 focus:backdrop-blur-md"
>
	<p class="hidden font-bold transition-all group-hover:block group-focus:block">
		<span class="text-white"> Escanea para compartir </span>
	</p>
	<Image
		loading="eager"
		decoding="async"
		alt="Código QR para compartir el sitio web de abogados Sergio Cruz Chacon"
		src={QRImg}
		class="size-6 rounded-sm transition-all group-hover:size-60 group-focus:size-60"
	/>
</button>
