---
import Banner from '../assets/banner.png';
import { getImage } from 'astro:assets';
import { DATA } from '../data/data.astro';

const optimized = await getImage({ src: Banner, width: 700, format: 'webp' });
---

<section
	class="from-base-300 bg-gradient-to-br to-white bg-cover bg-bottom-right pt-28 pb-20 md:pt-56"
	style={`background-image: linear-gradient(to bottom right, oklch(0.93 0.03 255.59 / 0.5), rgb(255 255 255)), linear-gradient(to bottom left, oklch(0.93 0.03 255.59 / 0.51), oklch(0.93 0.03 255.59)), url(${optimized.src});`}
>
	<div class="container mx-auto px-6 text-center">
		<div class="">
			<p class="font-bold opacity-60">Agencia de páginas web en Málaga</p>

			<h1 class="mb-6 text-5xl font-bold text-gray-900 md:text-6xl">
				Tu <span class="text-wave">Presencia Digital</span> Comienza Aquí
			</h1>

			<p class="mx-auto mb-8 max-w-2xl text-xl text-gray-600">
				Empieza hoy desde <span
					class="text-secondary noise text-3xl font-bold transition-all md:text-2xl md:hover:text-3xl"
					>0€</span
				>, lanza tu web profesional en <span
					class="hover:noise font-bold transition-all hover:text-3xl md:hover:text-2xl"
					>menos de 7 días</span
				>.
			</p>
		</div>

		<div class="mb-12 flex justify-center px-5">
			<a href="https://wa.me/34614032511" class="btn btn-primary sm:btn-xl w-full sm:w-fit">
				Solicita tu web gratis
			</a>
		</div>

		<ul
			class="mb-8 grid grid-cols-1 justify-items-center justify-self-center text-center sm:grid-cols-2 lg:grid-cols-3"
		>
			{
				DATA.services.map(({ icon: Icon, title, label }) => (
					<li class="hover:noise hover:border-secondary flex max-w-[290px] flex-col items-center rounded-sm border-2 border-transparent p-2 transition-all">
						<Icon class="size-12" />
						<p class="pt-4 pb-2 text-lg font-bold">{title}</p>
						<p>{label}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
