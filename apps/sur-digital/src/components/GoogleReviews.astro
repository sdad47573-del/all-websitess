---
import { Image } from "astro:assets";

import UnnamedImg from "../assets/unnamed (1).webp";
import Unnamed2Img from "../assets/unnamed (2).webp";
import VerifiedImg from "../assets/verified.png";
import GoogleImg from "../assets/google.webp";
import GoogleIcon from "../icons/GoogleIcon.astro";

const a = {
  profile_photo: Unnamed2Img,
  author_name: "Beatriz Cornejo",
  rating: 5,

  text: "Un trato y comunicación excelentes. Entendió lo que quería a la primera y todo fue sobre ruedas, la verdad es que repetiría sin duda y por supuesto que lo recomiendo al 100%. Incluso cuando tienes alguna duda para gestionar tu mismo algo (en mi caso los productos de la tienda) graba un vídeo o dos... o los que sean necesarios para que no haya ninguna duda... eso si, los vídeos son personalizados. En definitiva, quien decida trabajar con ellos no se arrepentirá. Mandar un saludo a Jose por el gran trabajo que ha realizado y por la paciencia que ha tenido conmigo!",
};

const b = {
  profile_photo: UnnamedImg,
  author_name: "Juana Martin amador",
  rating: 5,

  text: "Después de deambular por diversas Agencias de Marketing Digital y sin obtener los resultados esperados, me recomendaron a Sur Digital. Anteriormente no había tenido acierto con las agencias contratadas, analizó mi caso y le confié todo el SEO de mi pagina Web y todo el SEO LOCAL. Sólo puedo tener palabras de agradecimiento a este gran profesional.... Todo el trato fue telefónico y en todo momento estuvo atento al proyecto…",
};

const reviews = [a, b];
const review_url =
  "https://www.google.com/maps/place/Sur+Digital/@36.719115,-4.421456,20z/data=!4m8!3m7!1s0xd72f71e5dfbf95b:0xf8f8308c4601e85e!8m2!3d36.7191151!4d-4.4214559!9m1!1b1!16s%2Fg%2F11zjbyg_cy?hl=es&entry=ttu&g_ep=EgoyMDI1MTAyMi4wIKXMDSoASAFQAw%3D%3D";
---

<!-- <section class="py-20 bg-gradient-to-bl to-base-300 from-white"> -->
<section id="testimonios">
  <div class="container mx-auto flex gap-4 px-4 py-30 flex-col text-gray-900">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
        Opiniones de clientes
      </h2><p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Reseñas reales de Google
      </p>
    </div>
    <div
      class="flex gap-20 flex-col-reverse md:flex-row justify-center items-center"
    >
      <div class="flex flex-col items-center">
        <p class="text-2xl font-bold">EXCELENTE</p>
        <div class="text-3xl">{"⭐".repeat(5)}</div>
        <p class="pb-2 pt-4">
          <!-- A base de <span class="font-bold">131 reseñas</span> -->
        </p>
        <Image src={GoogleImg} alt="" class="h-9 w-auto object-contain mb-4" />
        <a
          class="btn btn-primary btn-lg transition duration-300"
          href={review_url}
          target="_blank">Ver más reseñas</a
        >
      </div>
      <div class="flex gap-4 flex-col md:flex-row relative">
        <a
          target="_blank"
          class="btn btn-primary transition duration-300 absolute top-1/2 -right-7 hidden md:flex btn-circle"
          href={review_url}
        >
          <i class="ri-arrow-right-s-line"></i>
        </a>
        <a
          target="_blank"
          class="btn btn-primary transition duration-300 absolute top-1/2 -left-7 hidden md:flex btn-circle"
          href={review_url}
        >
          <i class="ri-arrow-left-s-line"></i>
        </a>
        {
          reviews.slice(0, 2).map((r) => (
            <div class="max-w-96  w-full p-4 border rounded-2xl bg-white  shadow-sm border-gray-200  hover:shadow-md transition duration-300 cursor-pointer">
              <div class="flex justify-between">
                <div class="flex">
                  <Image
                    src={r.profile_photo}
                    alt={r.author_name}
                    class="size-10 mr-3.5"
                  />
                  <p class="font-bold">{r.author_name}</p>
                </div>
                <GoogleIcon class="size-5" />
              </div>
              <div class="flex items-center gap-2 py-2.5">
                {"⭐".repeat(r.rating)}

                <Image src={VerifiedImg} alt="" class="size-4" />
              </div>
              <p class="text overflow-hidden text-ellipsis line-clamp-7">
                {r.text}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
