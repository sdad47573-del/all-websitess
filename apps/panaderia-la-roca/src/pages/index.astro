---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import bollos from '../assets/fotos/panaderia-la-roca-vertical-01.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const title = 'Panadería La Roca · Palma-Palmilla, Málaga';
const description =
	'Panadería La Roca, en el barrio de Palma-Palmilla (29011 Málaga). Pan hecho a mano, bollería y dulces según las reseñas de su ficha de Google. Abre de lunes a sábado. Teléfono 952 30 57 42.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#la-roca`,
	name: BUSINESS.name,
	alternateName: ['La Roca', 'Panadería La Roca Málaga', 'La Roca Palma-Palmilla'],
	description:
		'Panadería de barrio en Palma-Palmilla (29011 Málaga). Pan hecho a mano, bollería y dulces, según las reseñas de su ficha de Google.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 952 30 57 42',
	currenciesAccepted: 'EUR',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	/* Google no publica calle ni número para esta ficha: se declara solo el barrio. */
	address: {
		'@type': 'PostalAddress',
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '14:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '17:00',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '09:00',
			closes: '14:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Dónde está', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#c23a2c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..700&family=Instrument+Serif:ital@0;1&family=Instrument+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería La Roca Málaga, panadería Palma-Palmilla, pan hecho a mano Málaga, bollería Palma-Palmilla, dulces Málaga, panadería 29011"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan hecho a mano, bollería y un buen surtido de dulces en el barrio de Palma-Palmilla (Málaga). De lunes a sábado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bollería de la Panadería La Roca, en Palma-Palmilla, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#c23a2c"
			street={BUSINESS.district}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[bollos]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Roca"
			subtitle="Panadería · Palma-Palmilla"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<div class="band band-cream">
				<LocalHero
					eyebrow="Palma-Palmilla · 29011 Málaga"
					title="El pan de barrio, <br /><em>hecho a mano.</em>"
					lede={`La Roca es una panadería de Palma-Palmilla, en Málaga. Las reseñas de su ficha de Google hablan de pan hecho a mano, de bollería y de un buen surtido de dulces. Tiene ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas.`}
					image={bollos}
					imageAlt="Bollo azucarado y bollos bañados de chocolate en el envase de la panadería"
					primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
					facts={[
						{ label: 'Nota', html: '<b>4,5</b> en Google · 56 reseñas' },
						{
							label: 'Horario',
							html: '<b>9:00–14:30</b> y 17:00–20:30, de lunes a viernes',
						},
						{ label: 'Barrio', html: '<b>Palma-Palmilla</b>, Málaga' },
					]}
					galleryHref={MAPS.place}
					photoCredit="Foto del perfil de Google Maps"
					galleryLinkLabel="Ver la ficha"
					tag="Abierta de lunes a sábado"
				/>

				<LocalChips label="Lo que ofrece la Panadería La Roca" items={SERVICIOS} />
			</div>

			<div class="band band-stone">
				<LocalAbout
					label="La casa"
					title="Una panadería <br /><em>de Palma-Palmilla.</em>"
					paragraphs={[
						'La Roca es una panadería de barrio en Palma-Palmilla, en Málaga. Google la clasifica solo como panadería y no publica descripción del negocio, así que esta página no inventa una historia: cuenta lo que dicen su ficha y sus reseñas.',
						'Lo que más se repite en las reseñas es el pan: «Pan hecho a mano, bollería de 10», escribe un cliente; otro habla de «un buen surtido de dulces». La reseña más crítica valora el pan y echa de menos los bocadillos que antes se hacían.',
						'La ficha no publica calle ni número. El mapa de esta página marca el punto exacto del local y «Cómo llegar» lanza las indicaciones; si prefieres confirmar antes, el teléfono es el 952 30 57 42.',
						'Tampoco hay carta ni precios online: el surtido cambia según el día y se ve en el mostrador.',
					]}
					note="4,5 sobre 5 con 56 reseñas en Google. De accesibilidad, la ficha solo indica que no hay aparcamiento adaptado."
					links={[
						{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
						{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					]}
				/>
			</div>

			<div class="band band-clay">
				<LocalMenu
					eyebrow="El mostrador"
					title="Pan, bollería <br /><em>y dulces.</em>"
					description="La ficha de Google no publica carta ni precios. Estas tres familias son las que nombran las reseñas del establecimiento."
					cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					groups={MENU}
					note="Sin precios publicados: la panadería no tiene web ni carta online en su ficha. Para saber qué hay cada día —y a qué precio—, lo mejor es llamar al 952 30 57 42 o pasarse por el mostrador."
				/>
			</div>

			<div class="band band-cream">
				<LocalVisit
					eyebrow="Palma-Palmilla · 29011 Málaga"
					title="Dónde <br /><em>encontrarla.</em>"
					addressLines={['Palma-Palmilla', '29011 Málaga']}
					hours={HOURS}
					hoursCaption="Horario"
					hoursNote="Horario publicado en la ficha de Google: de lunes a viernes en dos tramos, sábado solo por la mañana y domingo cerrado. En festivos puede cambiar, y la propia ficha ya avisa de ello para el 1 de noviembre."
					mapTitle="Mapa de la Panadería La Roca en Palma-Palmilla, Málaga"
					mapEmbedUrl={MAPS.embed}
					mapLabel="La Roca · Palma-Palmilla"
					mapHref={MAPS.place}
					links={[
						{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref, variant: 'primary' },
						{ label: 'Cómo llegar', href: MAPS.directions, external: true },
						{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					]}
					contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					reserveNote="La ficha de Google no publica calle ni número: el mapa marca el punto exacto y las indicaciones llevan hasta la puerta. De accesibilidad solo consta que no hay aparcamiento adaptado."
				/>
			</div>

			<div class="band band-sand">
				<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>ir.</em>" />
			</div>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos y fotografía de la ficha pública de Google Maps. Sin dirección postal, carta ni precios publicados por el establecimiento."
			ctaLabel="Llamar a La Roca"
			navAriaLabel="Enlaces de la Panadería La Roca"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
