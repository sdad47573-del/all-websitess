---
import 'remixicon/fonts/remixicon.css';
import 'animate.css';

import '../styles/index.css';

const { title, description } = Astro.props;

const SITE = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = SITE ? `${SITE}/` : '/';
const ogImage = SITE ? `${SITE}/og.png` : '/og.png';

// Solo datos verificados del propio negocio. El teléfono no se publica
// hasta confirmarlo con el cliente: no se inventa.
const business = {
	name: 'Bar Deportivo',
	locality: 'Cabra',
	region: 'Córdoba',
	postalCode: '14940',
	country: 'ES',
	description:
		'Bar Deportivo en Cabra (Córdoba): comida casera de calidad a precios asequibles, en el centro de Cabra.',
};
---

<!doctype html>
<html lang="es" data-theme="bar-deportivo">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="bar deportivo Cabra, bar Cabra, restaurante Cabra, comida Casera Córdoba, barra de tapas Cabra, bar centro Cabra"
		/>
		<meta name="author" content={business.name} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={`${business.name} en ${business.locality}`} />
		<meta property="og:locale" content="es_ES" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- SEO local -->
		<meta name="geo.placename" content={`${business.name}, ${business.locality}, ${business.region}`} />
		<meta name="geo.region" content="ES-CO" />
		<meta name="ICBM" content="37.4719, -4.4397" />
		<meta name="robots" content="index, follow, max-image-preview:large" />

		<!-- Datos estructurados JSON-LD: solo datos verificados del negocio -->
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'BarOrPub',
			name: business.name,
			description: description,
			url: canonical || undefined,
			image: ogImage,
			address: {
				'@type': 'PostalAddress',
				addressLocality: business.locality,
				addressRegion: business.region,
				postalCode: business.postalCode,
				addressCountry: business.country,
			},
			areaServed: [business.locality, business.region],
			priceRange: '€€',
			servesCuisine: ['Comida casera', 'Bar de tapas'],
		})} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#1e293b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet" />
	</head>
	<body>
		<slot />
	</body>
</html>