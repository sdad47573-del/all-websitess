---
import "remixicon/fonts/remixicon.css";
import "animate.css";
import "../styles/app.css";

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="scruz">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="abogado Lucena, abogados Córdoba, despacho jurídico, asesoría legal, defensa legal, representación legal, derecho civil, derecho penal, derecho laboral, derecho familiar, derecho mercantil, derecho corporativo, contratos, litigios, servicios legales, consultoría jurídica"
    />
    <meta name="author" content="Jose Aguilar" />
    <link rel="canonical" href="https://scruzabogados.vercel.app/" />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Scruz Abogados | Despacho Jurídico en Lucena y Córdoba"
    />
    <meta
      property="og:description"
      content="Especialistas en Derecho Civil, Penal, Laboral y de Familia. Más de 20 años defendiendo tus derechos en Lucena y Córdoba."
    />
    <meta property="og:url" content="https://scruzabogados.vercel.app/" />
    <meta
      property="og:image"
      content="https://scruzabogados.vercel.app/_astro/Recurso-2@0.5x.DmAfa87E_2wstaX.webp"
    />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Scruz Abogados | Despacho Jurídico en Lucena y Córdoba"
    />
    <meta
      name="twitter:description"
      content="Abogados en Lucena y Córdoba con experiencia en Derecho Civil, Penal y Laboral."
    />
    <meta
      name="twitter:image"
      content="https://scruzabogados.vercel.app/_astro/Recurso-2@0.5x.DmAfa87E_2wstaX.webp"
    />

    <!-- Datos estructurados JSON-LD (SEO local / negocio jurídico) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LegalService",
        "name": "Jose Aguilar",
        "image": "https://scruzabogados.vercel.app/_astro/Recurso-2@0.5x.DmAfa87E_2wstaX.webp",
        "@id": "https://scruzabogados.vercel.app/",
        "url": "https://scruzabogados.vercel.app/",
        "telephone": "+34 600 000 000",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Calle Principal 123",
          "addressLocality": "Lucena",
          "addressRegion": "Córdoba",
          "postalCode": "14900",
          "addressCountry": "ES"
        },
        "openingHours": "Mo-Fr 09:00-18:00",
        "areaServed": ["Lucena", "Córdoba"],
        "sameAs": [
          "https://www.facebook.com/scruzabogados",
          "https://www.linkedin.com/company/scruzabogados"
        ]
      }
    </script>

    <!-- Fuente y estilos (si aplica) -->
    <!-- hacer esto con mis propias fuentes -->
    <!-- <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /> -->

    <!-- SEO técnico extra -->
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#1e293b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
