---
import '../styles/global.css';
import {
	business,
	directionsUrl,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	photoUrl,
	phoneHref,
	structuredData,
} from '../lib/business';

const title = 'The Haircut | Peluquería, barbería y bronceado en Teatinos, Málaga';
const description =
	'The Haircut en Calle Flaubert, 3, Teatinos, Málaga. Peluquería, barbería y centro de bronceado. Llama para contactar o consulta cómo llegar.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#171916" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.brandName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={photoUrl} />
		<meta property="og:image:alt" content="Fotografía de The Haircut publicada en su ficha de Google Maps" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={photoUrl} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="The Haircut, inicio">
				<span class="brand-symbol" aria-hidden="true">TH<span>.</span></span>
				<span class="brand-label">THE HAIRCUT <small>TEATINOS · MÁLAGA</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#estudio">El estudio</a>
				<a href="#ubicacion">Ubicación</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">↗</span> {business.phone}</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span class="live-dot" aria-hidden="true"></span> PELUQUERÍA · BARBERÍA · SUNBODY</p>
					<h1 id="hero-title">Tu estilo.<br /><span>Tu momento.</span></h1>
					<p class="hero-intro">
						Un espacio de peluquería, barbería y bronceado en Teatinos. The Haircut te ofrece
						asesoramiento personalizado en el corazón de Málaga.
					</p>
					<div class="hero-actions">
						<a class="button button-accent" href={phoneHref}><span aria-hidden="true">☎</span> Llamar ahora</a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<span class="meta-line" aria-hidden="true"></span>
						<p>En {business.district}<br /><strong>{business.city}, Andalucía</strong></p>
					</div>
				</div>

				<figure class="hero-visual">
					<div class="image-index"><span>01</span> THE HAIRCUT · MÁLAGA</div>
					<a class="photo-link" href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Ver esta foto y la galería de The Haircut en Google Maps">
						<img
							src={photoUrl}
							alt="Fotografía de The Haircut compartida en Google Maps"
							width="1200"
							height="1192"
							fetchpriority="high"
							decoding="async"
						/>
						<span class="image-corner" aria-hidden="true">↗</span>
					</a>
					<figcaption><span>FOTO DE LA FICHA DE GOOGLE MAPS</span><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha completa ↗</a></figcaption>
					<span class="visual-stamp" aria-hidden="true">CUT<br />&<br />CARE</span>
				</figure>
				<div class="hero-cross" aria-hidden="true">+</div>
			</section>

			<section class="service-strip" id="estudio" aria-label="Servicios de The Haircut">
				<p class="strip-heading"><span>01 /</span> ENCUENTRA TU ESTILO</p>
				<div class="service-item"><span class="service-number">01</span><strong>Peluquería</strong><span class="service-arrow" aria-hidden="true">↗</span></div>
				<div class="service-item"><span class="service-number">02</span><strong>Barbería</strong><span class="service-arrow" aria-hidden="true">↗</span></div>
				<div class="service-item"><span class="service-number">03</span><strong>Sunbody</strong><span class="service-arrow" aria-hidden="true">↗</span></div>
			</section>

			<section class="about section-wrap" aria-labelledby="about-title">
				<div class="section-kicker"><span>02 /</span> THE HAIRCUT &amp; SUNBODY</div>
				<div class="about-copy">
					<h2 id="about-title">Asesoramiento<br /><em>a tu medida.</em></h2>
					<div class="about-detail">
						<p>Peluquería, barbería y centro de bronceado en un mismo espacio. Acércate a The Haircut en Teatinos y encuentra un servicio pensado para ti.</p>
						<a class="underlined-link" href={instagramUrl} target="_blank" rel="noreferrer">Descubre The Haircut en Instagram <span aria-hidden="true">↗</span></a>
					</div>
				</div>
				<div class="about-rule"><span>TH</span><span>ESTILO PERSONAL · MÁLAGA</span><span>✳</span></div>
			</section>

			<section class="location section-wrap" id="ubicacion" aria-labelledby="location-title">
				<div class="section-kicker"><span>03 /</span> VEN A VISITARNOS</div>
				<div class="location-grid">
					<div class="location-copy">
						<h2 id="location-title">Estamos<br />en <em>Teatinos.</em></h2>
						<div class="contact-card">
							<div class="contact-row">
								<span class="contact-icon" aria-hidden="true">⌖</span>
								<div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div>
							</div>
							<div class="contact-row">
								<span class="contact-icon" aria-hidden="true">↗</span>
								<div><small>LLÁMANOS</small><a class="contact-phone" href={phoneHref}>{business.phone}</a></div>
							</div>
						</div>
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-panel">
						<div class="map-topline"><span><i aria-hidden="true"></i> TEATINOS-UNIVERSIDAD</span><a href={mapsUrl} target="_blank" rel="noreferrer">ABRIR MAPS ↗</a></div>
						<iframe
							title="Mapa de The Haircut en Calle Flaubert, Teatinos, Málaga"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
						<div class="map-address"><span class="pin" aria-hidden="true">⌖</span><span><strong>The Haircut</strong><small>{business.streetAddress} · {business.city}</small></span><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Obtener indicaciones">↗</a></div>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="footer-brand" href="#inicio" aria-label="The Haircut, volver al inicio"><span class="brand-symbol">TH<span>.</span></span><span class="brand-label">THE HAIRCUT <small>TEATINOS · MÁLAGA</small></span></a>
			<p>{business.streetAddress}, {business.city}<br /><a href={phoneHref}>{business.phone}</a></p>
			<a class="footer-maps" href={mapsUrl} target="_blank" rel="noreferrer">Google Maps <span aria-hidden="true">↗</span></a>
			<small>© {new Date().getFullYear()} The Haircut &amp; Sunbody · Málaga</small>
		</footer>

		<a class="phone-cta" href={phoneHref}><span aria-hidden="true">☎</span> Llamar a The Haircut <strong>{business.phone}</strong></a>
	</body>
</html>
