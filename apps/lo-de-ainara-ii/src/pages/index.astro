const faqs = [
	{
		q: '¿Dónde está Lo de Ainara II?',
		a: 'En la calle Juan Francés Bosca, 19, en el barrio de Teatinos-Universidad (29010 Málaga), a un paso de la Ciudad de la Justicia. Es un bar de barrio con comedor amplio y terraza en la calle.',
	},
	{
		q: '¿Cuál es el horario de Lo de Ainara II?',
		a: 'Cierra los lunes y los martes. De miércoles a domingo sirve comidas de 12:30 a 16:30, y los viernes y sábados también abre por la noche, de 20:30 a 23:30. Como puede cambiar en festivos, confirma antes si vienes de lejos.',
	},
	{
		q: '¿Qué se puede comer en Lo de Ainara II?',
		a: 'Es un bar de tapas y pescaíto frito. La carta gira en torno a las tapas de la casa (albóndigas de choco en salsa de almendra, bravas, boquerones en vinagre, calamares y jamón…), los cartuchos de fritura (gambas, boquerones, adobo, jibia, calamares), las raciones para compartir y platos como la pata de pulpo con puré de patata trufado, las croquetas caseras o los huevos rotos con gambas al ajillo.',
	},
	{
		q: '¿Qué significa «Boquerón, cazón y victoria»?',
		a: 'Es el lema que preside la barra del local: «Boquerón, cazón y victoria. Fritura con historia». Resume su apuesta por la fritura andaluza de siempre, con boquerones y cazón en adobo como protagonistas.',
	},
	{
		q: '¿Tiene terraza?',
		a: 'Sí. Tiene terraza en la calle, con mesas y toldos, además del comedor interior con barra de azulejos. En verano es la zona más solicitada, así que en fin de semana conviene llegar pronto.',
	},
	{
		q: '¿Se puede reservar?',
		a: 'No hay reserva online: lo habitual es llamar al 605 49 40 48 para consultar disponibilidad, sobre todo si vais un grupo grande o en fin de semana.',
	},
	{
		q: '¿Es un sitio para ir en familia o con niños?',
		a: 'Sí. Es un bar de barrio con mesas amplias y trato cercano: en las reseñas aparecen familias con niños y celebraciones de grupo. Las camareras suelen recomendar platos de la carta según lo que busques.',
	},
	{
		q: '¿Hay opciones vegetarianas o sin gluten?',
		a: 'Entre las tapas hay opciones sin carne, como el aguacate con queso de cabra o la tapa mediterránea de tomate y serrano (esta última se puede pedir sin jamón). Al ser una cocina de fritura y producto, lo mejor es avisar al personal y preguntar qué se puede adaptar ese día.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['Café-Bar Lo de Ainara II', 'Lo de Ainara 2', 'Lo de Ainara Teatinos'],
	slogan: '«Boquerón, cazón y victoria» — Fritura con historia',
	description,
	url: `${business.site}/`,
	telephone: '+34 605 49 40 48',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Tapas', 'Pescado frito', 'Cocina andaluza', 'Marisco', 'Bar de tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	image: `${business.site}/og.jpg`,
	sameAs: [mapsUrl],
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: cid }],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday'],
			opens: '12:30',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '12:30',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '20:30',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '12:30',
			closes: '16:30',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Barra y comedor interior', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Tapas y raciones para compartir', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Pescado frito', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Abierto los domingos', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Lo de Ainara II · Tapas y pescaíto frito en Teatinos, Málaga</title>
		<meta name="theme-color" content="#16262e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.fullName}
			description={description}
			keywords="Lo de Ainara II, Lo de Ainara Teatinos, bar de tapas Teatinos, pescaíto frito Málaga, fritura con historia, cartuchos de fritura, pata de pulpo Málaga, tapas Juan Francés Bosca, comer en Teatinos, bar de tapas Málaga 29010, cazón en adobo Málaga, terraza Teatinos"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Lo de Ainara II · Tapas y pescaíto frito en Teatinos, Málaga"
			ogDescription="Bar de tapas y pescaíto frito en C. Juan Francés Bosca, 19 (Teatinos): cartuchos de fritura, pata de pulpo con puré trufado y terraza. 4,1 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Barra de Lo de Ainara II con el cartel «Boquerón, cazón y victoria», bar de tapas en Teatinos, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.fullName}
			themeColor="#16262e"
			street={business.street}
			city={business.city}
			region="Andalucía"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Teatinos-Universidad, Málaga"
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://lo-de-ainara-ii.vercel.app/og.jpg" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7267217;-4.4664906" />
		<meta name="ICBM" content="36.7267217, -4.4664906" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="A"
			name="Lo de Ainara"
			subtitle="Café-Bar II · Teatinos"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Teatinos · Málaga"
				title="Tapas y pescaíto frito,<br /><em>fritura con historia.</em>"
				lede="Bar de tapas en la calle Juan Francés Bosca, 19, junto a la Ciudad de la Justicia. Tapas de la casa, cartuchos de fritura, pata de pulpo con puré trufado y una terraza para compartir en Teatinos. Comidas de miércoles a domingo y cenas los viernes y sábados."
				image={heroImage}
				imageAlt="Barra de Lo de Ainara II con el cartel «Boquerón, cazón y victoria», bar de tapas en Teatinos (Málaga)"
				primaryCta={{ label: 'Llamar 605 49 40 48', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,1</b> en Google (59 reseñas)' },
					{ label: 'Comidas', html: 'Miércoles a domingo, 12:30–16:30' },
					{ label: 'Cenas', html: 'Viernes y sábado hasta las 23:30' },
					{ label: 'Cartuchos', html: 'Fritura variada' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Lo de Ainara II" items={servicios} />

			<LocalAbout
				label="Un bar de tapas de barrio"
				title="Fritura de siempre,<br /><em>servida en Teatinos.</em>"
				paragraphs={[
					'Lo de Ainara II está en la calle Juan Francés Bosca, 19, en pleno Teatinos y a un paso de la Ciudad de la Justicia. Es un bar de tapas de los de siempre: barra de azulejos, comedor amplio, terraza en la calle y una carta que gira en torno al pescaíto frito.',
					'Su lema lo dice todo: «Boquerón, cazón y victoria. Fritura con historia». De ahí salen los cartuchos de fritura (gambas, boquerones, adobo, jibia, calamares) y las tapas de la casa, como las albóndigas de choco en salsa de almendra o la calamarzada. Las raciones se piden para compartir y los clientes insisten en que son abundantes.',
					'El plato que más se repite en las reseñas es la pata de pulpo con puré de patata trufado, y también salen muy bien paradas las croquetas caseras y los huevos rotos con gambas al ajillo. Para terminar, la tarta de queso con nutella. Todo con un trato cercano: las camareras recomiendan platos y el local está pensado para ir en familia o en grupo.',
				]}
				note="La nota media en Google es 4,1 sobre 59 opiniones. Lo que más se repite es la fritura (pulpo, pescado frito, cartuchos), los platos abundantes y los buenos precios. Hay algún comentario aislado de descontento —una clienta que vino por TikTok y no le convenció un plato—, y el local respondió ofreciendo cambiarlo, así que el tono general sigue siendo positivo."
				links={[
					{ label: 'Ficha y reseñas en Google', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Tapas, cartuchos<br /><em>y raciones.</em>"
				description="Selección tomada de la pizarra del propio local (fotografiada en su ficha de Google) y de los platos que mencionan los clientes en las reseñas. La carta del día cambia, así que confirma en el local."
				cta={{ label: 'Llamar para preguntar', href: phoneHref }}
				groups={grupos}
				note="La carta cambia con el producto del día: pregúntala al sentarte."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El bar, dentro<br /><em>y en la terraza.</em>"
				description="Estas fotografías proceden del perfil de Lo de Ainara II en Google Maps, con las imágenes de la ficha y de sus clientes. En la ficha del local están todas las fotos y las reseñas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del local en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="C. Juan Francés Bosca, 19 · 29010 Málaga"
				title="Nos vemos<br /><em>en Teatinos.</em>"
				addressLines={[
					business.street,
					business.district,
					`${business.postalCode} ${business.city}, España`,
				]}
				hours={[
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: 'Cerrado', closed: true },
					{ day: 'Miércoles', value: '12:30–16:30' },
					{ day: 'Jueves', value: '12:30–16:30' },
					{ day: 'Viernes', value: '12:30–16:30 · 20:30–23:30' },
