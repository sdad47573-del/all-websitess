---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	business,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Asador de Camilo · Parrilla en la Puerta del Sol de Jaén';
const description =
	'Asador de Camilo, parrilla en la calle Puerta del Sol, 4 de Jaén. 4,4 sobre 5 con 284 reseñas; comidas de martes a domingo y lunes cerrado.';
const keywords =
	'Asador de Camilo, parrilla Jaén, asador Jaén, Puerta del Sol Jaén, Asador de Camilo teléfono, parrilla Puerta del Sol';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas diez fotografías, así que no se inventa una
 * descripción y todos los `alt` avisan solo de dónde salen.
 */
const altFoto =
	'Fotografía publicada en la ficha de Google Maps del Asador de Camilo, en Jaén';
const altOg = 'Fotografía del Asador de Camilo publicada en su ficha de Google Maps';

/**
 * Autor que el manifiesto de la descarga atribuye a las diez fotos: el propio asador.
 * Como sí hay a quién citar, cada foto de la galería lleva su pie.
 */
const autorFoto = 'Asador de Camilo';

/**
 * Galería completa: las diez fotografías de la ficha.
 *
 * Seis son apaisadas (una de ellas panorámica), tres verticales y una casi cuadrada, así que la
 * galería va en tres columnas: con formatos mezclados el mosaico se lee mejor que en una rejilla
 * de recortes.
 */
const galeria = [
	'asador-de-camilo-apaisada-01.jpg',
	'asador-de-camilo-apaisada-02.jpg',
	'asador-de-camilo-vista-3-03.jpg',
	'asador-de-camilo-apaisada-04.jpg',
	'asador-de-camilo-panoramica-05.jpg',
	'asador-de-camilo-apaisada-06.jpg',
	'asador-de-camilo-vertical-07.jpg',
	'asador-de-camilo-vertical-08.jpg',
	'asador-de-camilo-vertical-09.jpg',
	'asador-de-camilo-apaisada-10.jpg',
];

/**
 * Tres fotos de avance en el collage de la portada (también están en la galería).
 *
 * La apaisada 04 es 16:9 exacto, así que encaja en el hueco superior; las verticales 07 y 09 van
 * en los dos huecos inferiores.
 */
const collage = [
	{ name: 'asador-de-camilo-apaisada-04.jpg', clase: 'collage-item collage-item-a' },
	{ name: 'asador-de-camilo-vertical-07.jpg', clase: 'collage-item collage-item-b' },
	{ name: 'asador-de-camilo-vertical-09.jpg', clase: 'collage-item collage-item-c' },
];

/**
 * Número de reseñas destacadas que publica la ficha.
 *
 * Aquí son tres, pero se cuenta en vez de escribirlo a mano para que el texto no se desincronice
 * si la ficha cambia.
 */
const numeroResenas = reviews.length;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#211c19" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-JA" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">A</span>
				<span class="brand-text">
					Asador de Camilo
					<small>Puerta del Sol · Jaén</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#local">La casa</a>
				<a href="#fotos">Las fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Jaén · Puerta del Sol, 4</p>
						<h1 id="hero-title">
							Parrilla de brasa
							<br />
							<em>en Puerta del Sol.</em>
						</h1>
						<p class="hero-lede">
							El Asador de Camilo está en la calle Puerta del Sol, 4, con código postal
							23007, en Jaén. Google lo clasifica como parrilla y le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas. Sirve comidas de
							martes a domingo desde las 11:30 y cierra los lunes.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>Llamar al {business.phone}</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas
								</strong>
							</li>
						</ul>
					</div>

					<div class="hero-collage">
						{collage.map((item, index) => (
							<figure class={item.clase}>
								<Image
									src={foto(item.name)}
									alt={altFoto}
									widths={index === 0 ? [640, 900, 1200] : [320, 480, 640]}
									sizes={
										index === 0
											? '(max-width: 1080px) 92vw, 46vw'
											: '(max-width: 1080px) 45vw, 23vw'
									}
									format="avif"
									quality={68}
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : undefined}
									decoding="async"
								/>
							</figure>
						))}
					</div>
				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
					{business.reviewCount.toLocaleString('es-ES')} reseñas
				</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>{hoursSummary}</span>
				<span>Teléfono {business.phone}</span>
			</div>

			<section class="section" id="local" aria-labelledby="local-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">La casa</p>
						<h2 class="title" id="local-title">
							Parrilla de barrio
							<br />
							<em>en el centro.</em>
						</h2>
						<p>
							Google lo clasifica como parrilla, y es la única categoría que publica la
							ficha. Le da {business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas. Está en la calle
							Puerta del Sol, 4, con código postal 23007, y la ficha publica su plus code
							Q6F5+33 Jaén.
						</p>
						<p>
							Sirve comidas de martes a domingo desde las 11:30: de martes a sábado hasta
							las 17:00 y el domingo hasta las 17:30. El lunes cierra.
						</p>
						<p class="bar-note">
							Esta web se ha preparado solo con lo que publica la ficha de Google Maps,
							consultada el {site.consultado}: nombre, dirección, teléfono, categoría,
							horario, valoración, las {numeroResenas} reseñas que destaca y sus propias
							fotografías. La ficha no publica la carta, los precios ni una descripción
							del local, ni tiene web propia, así que aquí no se reproduce ninguno.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>{business.reviewCount.toLocaleString('es-ES')} reseñas en Google Maps</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver todas ↗</a>
						</div>
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									<strong>{review.rating} sobre 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section cocina" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						El asador <em>por dentro.</em>
					</h2>
					<p class="lead">
						Son las diez fotografías que el Asador de Camilo publica en su ficha de Google
						Maps, todas atribuidas al propio asador. La ficha no trae una descripción del
						contenido de estas fotos, así que no se inventa ninguna y los textos
						alternativos solo avisan de dónde salen.
					</p>
					<div class="cocina-grid">
						{galeria.map((name) => (
							<figure class="cocina-item">
								<Image
									src={foto(name)}
									alt={altFoto}
									widths={[380, 560, 800]}
									sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
									format="avif"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>Foto de {autorFoto}</figcaption>
							</figure>
						))}
					</div>
					<p class="cocina-note">
						La ficha no publica la carta ni los precios, así que esta web no los reproduce.
						Para saber qué hay hoy, lo más rápido es{' '}
						<a href={phoneHref}>llamar al {business.phone}</a> o mirar las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos y reseñas de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Calle Puerta del Sol, 4,
							<br />
							<em>23007 Jaén.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							Solo hay un turno de mediodía: de martes a sábado de 11:30 a 17:00 y el
							domingo hasta las 17:30. Es el horario que publica la ficha consultada el{' '}
							{site.consultado}, con el aviso de que el lunes 12, Fiesta Nacional de
							España, podría ser diferente: ese día el local ya cierra por descanso
							semanal. Conviene confirmar por teléfono antes de ir.
						</p>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
							<button type="button" data-cargar-mapa aria-label="Cargar mapa interactivo" style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
								<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
								<strong style="font-size:1rem;">Cargar mapa interactivo</strong>
								<small style="opacity:0.65;">Se carga solo al pulsar</small>
							</button>
<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
						 data-src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>llamar.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">A</span>
					<span>
						Asador de Camilo
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Asador de Camilo · Calle Puerta del Sol, 4 (23007 Jaén).
					Web informativa elaborada con los datos y las fotografías que el local publica en su
					ficha de Google Maps, consultada el {site.consultado}. Confirma horario y
					disponibilidad por teléfono antes de salir.
				</small>
			</div>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar al Asador de Camilo <span>{business.phone}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>

<script>
// mapa-fachada: la URL del iframe vive en data-src y solo se asigna al pulsar (ahorra ~1MB de JS).
document.addEventListener('click', function (e) {
	var t = e.target && e.target.closest ? e.target.closest('[data-cargar-mapa]') : null;
	if (!t) return;
	var w = t.closest('[data-mapa-fachada]');
	if (!w || w.dataset.cargado) return;
	var f = w.querySelector('iframe');
	if (!f || !f.dataset.src || f.getAttribute('src')) return;
	w.dataset.cargado = '1';
	f.setAttribute('src', f.dataset.src);
	t.remove();
});
</script>
