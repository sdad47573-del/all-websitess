---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import arroces from '../assets/fotos/les-canyes-apaisada-04.jpg';
import salmorejo from '../assets/fotos/les-canyes-apaisada-05.jpg';
import patatasPimientos from '../assets/fotos/les-canyes-apaisada-06.jpg';
import comedor from '../assets/fotos/les-canyes-apaisada-09.jpg';
import carneBrasa from '../assets/fotos/les-canyes-apaisada-10.jpg';
import fachada from '../assets/fotos/les-canyes-vertical-01.jpg';
import arrozMejillon from '../assets/fotos/les-canyes-vertical-02.jpg';
import panAlioli from '../assets/fotos/les-canyes-vertical-07.jpg';
import postre from '../assets/fotos/les-canyes-vertical-08.jpg';
import arrozPanceta from '../assets/fotos/les-canyes-vista-3-03.jpg';

const business = {
	name: 'Les Canyes',
	brand: 'Les Canyes',
	street: 'Carrer de Lleida, 16',
	city: 'Castelló de la Plana',
	region: 'Castellón',
	postalCode: '12004',
	phone: '964 35 00 36',
	latitude: 39.9942814,
	longitude: -0.0345181,
	rating: 4.4,
	reviewsCount: 661,
	site: 'https://les-canyes.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd5fffcc5270e1a1:0x3eefd483ea873dfe';
const cidDecimal = '4535077012825914878';
const placeId = 'ChIJoeFwUsz_Xw0R_j2H6oPU7z4';

const mapsUrl =
	'https://www.google.com/maps/place/Les+Canyes/@39.9942814,-0.0345181,17z/data=!3m1!4b1!4m6!3m5!1s0xd5fffcc5270e1a1:0x3eefd483ea873dfe!8m2!3d39.9942814!4d-0.0345181!16s%2Fg%2F11c4df3ywf?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34964350036';

const description =
	'Bar restaurante Les Canyes, en Carrer de Lleida, 16 (Castelló de la Plana): arroces, arroz con bogavante y menú del día, de 8:30 a 17:00 de martes a domingo.';

const servicios = [
	'Bar restaurante',
	'Cocina mediterránea',
	'Cocina española',
	'Arroces',
	'Arroz con bogavante',
	'Menú del día',
	'Carnes a la brasa',
	'Raciones para compartir',
	'Cava',
	'Comedor para grupos',
	'Acceso adaptado',
	'Aparcamiento adaptado',
];

const grupos = [
	{
		title: 'Arroces',
		items: [
			{
				name: 'Arroz con bogavante',
				note: 'el plato que citan las reseñas: «comimos arroz con bogavante y una botella de cava, todo buenísimo»',
			},
			{
				name: 'Arroces de la casa',
				note: 'en las fotos de la ficha aparecen con mejillones, con langostinos y con panceta, en paella de hierro',
			},
		],
	},
	{
		title: 'Menú del día',
		items: [
			{
				name: 'Menú del día',
				note: '«muy adecuado con variedad de arroces», según las opiniones; se sirve al mediodía',
			},
			{
				name: 'Entrantes para empezar',
				note: 'salmorejo con jamón y huevo, patatas con pimientos y pan con alioli y tomate',
			},
			{
				name: 'Raciones para compartir',
				note: 'las reseñas hablan de «generosas raciones» y de un trato muy atento',
			},
		],
	},
	{
		title: 'A la brasa',
		items: [
			{
				name: 'Carne a la brasa con patatas',
				note: 'chuletas marcadas en la brasa, con patatas fritas, patata al horno y verduras',
			},
		],
	},
	{
		title: 'Postre y bodega',
		items: [
			{
				name: 'Postre de la casa',
				note: 'con nata montada y sirope de frutos rojos, como el que aparece en las fotos',
			},
			{
				name: 'Cava',
				note: 'la botella que se pide con el arroz en las reseñas; también hay vino de la casa',
			},
		],
	},
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de Bar Restaurant Les Canyes con el arco de piedra y las puertas de madera, en Castelló de la Plana',
	},
	{
		src: arrozMejillon,
		alt: 'Arroz con mejillón en su paella de hierro en Les Canyes, Castelló de la Plana',
	},
	{
		src: comedor,
		alt: 'Comedor de Les Canyes con las paredes naranjas, mesas de madera y sillas de enea',
	},
	{
		src: arrozPanceta,
		alt: 'Paella de arroz con panceta y pimiento verde servida en la mesa de Les Canyes',
	},
	{
		src: salmorejo,
		alt: 'Salmorejo con jamón y huevo rallado en Les Canyes, Castelló de la Plana',
	},
	{
		src: patatasPimientos,
		alt: 'Patatas con pimientos rojo y verde y pimentón en Les Canyes',
	},
	{
		src: panAlioli,
		alt: 'Cesta de pan con alioli y tomate rallado en Les Canyes',
	},
	{
		src: carneBrasa,
		alt: 'Chuletas a la brasa con patatas fritas y verduras en Les Canyes',
	},
	{
		src: postre,
		alt: 'Postre con nata montada y sirope de frutos rojos en Les Canyes',
	},
];

const faqs = [
	{
		q: '¿Dónde está Les Canyes?',
		a: 'En el Carrer de Lleida, 16, 12004 Castelló de la Plana (Castellón). Se entra por un arco de piedra con el rótulo encima, en la misma acera, y en la foto de la ficha se ven coches aparcados en la calle. Desde esta página puedes abrir el mapa y trazar la ruta con el botón «Cómo llegar».',
	},
	{
		q: '¿Qué horario tiene el restaurante?',
		a: 'Abre de martes a domingo, de 8:30 a 17:00. Los lunes permanece cerrado. Es un horario de servicio de mediodía, así que si vienes a comer conviene llegar con tiempo; en festivos puede cambiar y se confirma llamando al 964 35 00 36.',
	},
	{
		q: '¿Qué se come en Les Canyes?',
		a: 'Cocina mediterránea y española con el arroz como protagonista. En las fotos de la ficha aparecen arroces con mejillones, con langostinos y con panceta, además de salmorejo con jamón y huevo, patatas con pimientos, pan con alioli y tomate y carnes a la brasa con patatas. Las reseñas destacan el arroz con bogavante y la variedad de arroces del menú.',
	},
	{
		q: '¿Hay menú del día?',
		a: 'Sí, se sirve al mediodía. Una reseña de Google lo describe como «muy adecuado con variedad de arroces». Esta web no publica el menú ni los precios porque no hay carta oficial publicada: se piden en el local o por teléfono, en el 964 35 00 36.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'No hay reserva online ni formulario en esta web: se reserva llamando al 964 35 00 36. El comedor es amplio, con mesas grandes y de madera, así que para grupos conviene avisar con antelación, sobre todo los fines de semana.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'La ficha de Google marca entrada, aseo, asientos y aparcamiento adaptados para sillas de ruedas. El acceso es desde la misma acera, a pie de calle, sin escalones de por medio.',
	},
	{
		q: '¿Se puede aparcar por la zona?',
		a: 'La ficha marca aparcamiento adaptado para sillas de ruedas y en la foto de la fachada se ven plazas en la propia calle. No hay parking propio anunciado, así que se aparca en las calles del entorno.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['Bar Restaurant Les Canyes', 'Les Canyes Castelló', 'Bar Les Canyes'],
	slogan: 'Arroces y menú del día en Castelló de la Plana',
	description,
	url: `${business.site}/`,
	telephone: '+34 964 35 00 36',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Española', 'Arroces', 'Cocina de mercado'],
	areaServed: [
		{ '@type': 'City', name: 'Castelló de la Plana' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '08:30',
			closes: '17:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Les Canyes · Arroces y menú del día en Castelló</title>
		<meta name="theme-color" content="#26433a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,400..600&family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Les Canyes, Bar Restaurant Les Canyes, restaurante Castelló de la Plana, arroces Castellón, arroz con bogavante Castelló, menú del día Castellón, restaurante mediterráneo Castelló, Carrer de Lleida 16, bar restaurante Castellón, comer en Castelló, arroces Plana Alta"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Les Canyes · Arroces en Castelló de la Plana"
			ogDescription="Arroz con bogavante, arroces de la casa y menú del día en Carrer de Lleida, 16, Castelló. 4,4 en Google con 661 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Tres paellas de hierro con arroces de Les Canyes servidas en la mesa"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#26433a"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Castelló de la Plana, Castellón"
			contact={{
				street: business.street,
				locality: business.city,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[arroces]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="LC"
			name={business.name}
			subtitle="Arroces · Castelló de la Plana"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer de Lleida, 16 · Castelló de la Plana"
				title="Arroces<br />y menú del día<br /><em>en Castelló.</em>"
				lede="Les Canyes es el bar restaurante del Carrer de Lleida, 16, en Castelló de la Plana. Cocina mediterránea y española con el arroz como protagonista, menús variados y raciones generosas, de 8:30 a 17:00 de martes a domingo."
				image={arroces}
				imageAlt="Tres paellas de hierro con arroces de Les Canyes servidas en la mesa"
				primaryCta={{ label: 'Llamar 964 35 00 36', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4</b> en Google (661 reseñas)' },
					{ label: 'Horario', html: '<b>8:30 – 17:00</b> de martes a domingo' },
					{ label: 'Cocina', html: '<b>Arroces</b> y cocina mediterránea' },
					{ label: 'Cierre', html: '<b>Cerrado</b> los lunes' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Les Canyes" items={servicios} />

			<LocalAbout
				label="Bar restaurante en Castelló de la Plana"
				title="Arroces de los de antes<br />y menú<br /><em>del mediodía.</em>"
				paragraphs={[
					'Les Canyes está en el Carrer de Lleida, 16, en Castelló de la Plana. Se entra por un arco de piedra con el rótulo «Bar Restaurant Les Canyes» encima y las puertas de madera abiertas; en la puerta, un barril hace de mesa alta y una pizarra anuncia el menú. Dentro, el comedor es amplio, con mesas de madera, mantel y sillas de enea.',
					'La cocina es mediterránea y española, con el arroz como eje. En las fotos de la ficha aparecen arroces con mejillones, con langostinos y con panceta, servidos en paellas de hierro que van a la mesa. Las reseñas hablan de «variedad de arroces» en el menú y del arroz con bogavante, que se pide con una botella de cava.',
					'A la mesa llegan también el salmorejo con jamón y huevo, las patatas con pimientos, el pan con alioli y tomate y las carnes a la brasa con patatas. Se come de martes a domingo, de 8:30 a 17:00; los lunes el restaurante cierra.',
				]}
				note="La ficha de Google reúne 661 opiniones con una nota media de 4,4. Las reseñas destacan el trato, las «generosas raciones» y el menú, «muy adecuado con variedad de arroces»."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="Lo que sale de la cocina"
				title="Arroz, brasa<br /><em>y sobremesa.</em>"
				description="La ficha de Google no publica carta, así que esta selección se ha hecho con lo que aparece en sus fotos y con lo que citan las reseñas: arroces con mejillones, langostinos y panceta, arroz con bogavante, salmorejo, patatas con pimientos, carne a la brasa y postre con nata."
				cta={{ label: 'Preguntar el menú por teléfono', href: phoneHref }}
				groups={grupos}
				note="Esta web no publica precios: la ficha de Google no incluye carta ni tarifas. El menú del día, los arroces disponibles y su importe se confirman en el local o llamando al 964 35 00 36."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La fachada,<br /><em>el comedor y el arroz.</em>"
				description="Estas fotografías proceden del perfil de Les Canyes en Google Maps: la fachada con el arco de piedra, el comedor de paredes naranjas, los arroces en paella de hierro, el salmorejo, las patatas con pimientos, el pan con alioli, la carne a la brasa y el postre."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer de Lleida, 16 · 12004 Castelló de la Plana"
				title="Nos vemos<br /><em>en Les Canyes.</em>"
				addressLines={[
					business.street,
					`${business.postalCode} ${business.city}`,
					'Castellón, España',
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: '8:30 – 17:00' },
					{ day: 'Miércoles', value: '8:30 – 17:00' },
					{ day: 'Jueves', value: '8:30 – 17:00' },
					{ day: 'Viernes', value: '8:30 – 17:00' },
					{ day: 'Sábado', value: '8:30 – 17:00' },
					{ day: 'Domingo', value: '8:30 – 17:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google: de 8:30 a 17:00 de martes a domingo, con el lunes cerrado. En festivos puede cambiar, así que llama al 964 35 00 36 antes de desplazarte."
				mapTitle="Mapa de Les Canyes en el Carrer de Lleida, 16, Castelló de la Plana"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Les Canyes · Castelló"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Las reservas se hacen por teléfono, llamando al 964 35 00 36: no hay reserva online ni formulario en esta web. Para grupos y comidas familiares conviene llamar con antelación, y si alguien tiene una alergia o necesita acceso adaptado se puede indicar al reservar."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="LC"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Les Canyes"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
