---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import mariscada from '../assets/fotos/restaurante-a-nova-cepa-apaisada-03.jpg';
import fachada from '../assets/fotos/restaurante-a-nova-cepa-apaisada-01.jpg';
import paella from '../assets/fotos/restaurante-a-nova-cepa-apaisada-07.jpg';
import terraza from '../assets/fotos/restaurante-a-nova-cepa-apaisada-08.jpg';
import vistas from '../assets/fotos/restaurante-a-nova-cepa-apaisada-10.jpg';
import arrozBogavante from '../assets/fotos/restaurante-a-nova-cepa-vertical-02.jpg';
import zamburinas from '../assets/fotos/restaurante-a-nova-cepa-vertical-04.jpg';
import postre from '../assets/fotos/restaurante-a-nova-cepa-vertical-06.jpg';
import almejas from '../assets/fotos/restaurante-a-nova-cepa-vertical-09.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Restaurante A Nova Cepa, en Camiño do Penedo 4 (A Seara, Poio). Arroz con bogavante, marisco y pescado, con terraza sobre la ría. Tel. 986 77 09 13.';

const title = 'Restaurante A Nova Cepa · Marisco en Poio';

const galeria = [
	{
		src: mariscada,
		alt: 'Mariscada de cigalas, langostinos, percebes y buey de mar en una bandeja del Restaurante A Nova Cepa',
	},
	{
		src: arrozBogavante,
		alt: 'Arroz con bogavante en su paella, servido en el Restaurante A Nova Cepa',
	},
	{
		src: zamburinas,
		alt: 'Zamburiñas a la plancha con su salsa en un plato del Restaurante A Nova Cepa',
	},
	{
		src: almejas,
		alt: 'Almejas a la marinera en salsa en un plato del Restaurante A Nova Cepa',
	},
	{
		src: terraza,
		alt: 'Terraza cubierta del Restaurante A Nova Cepa con mesas vestidas y vistas a la ría de Pontevedra',
	},
	{
		src: fachada,
		alt: 'Fachada de granito del Restaurante A Nova Cepa con el toldo amarillo y la pizarra de la carta',
	},
	{
		src: paella,
		alt: 'Paella de marisco con mejillones, almejas y gambas en el Restaurante A Nova Cepa',
	},
	{
		src: postre,
		alt: 'Postre de la casa frito y espolvoreado con azúcar glas en un plato del Restaurante A Nova Cepa',
	},
	{
		src: vistas,
		alt: 'Vistas sobre la ría de Pontevedra desde la terraza del Restaurante A Nova Cepa en Poio',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#novacepa`,
	name: BUSINESS.name,
	alternateName: ['A Nova Cepa', 'Nueva Cepa', 'Bar Restaurante Nueva Cepa', 'A Nova Cepa Poio'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 986 77 09 13',
	currenciesAccepted: 'EUR',
	priceRange: '€€',
	servesCuisine: ['Gallega', 'Mediterránea', 'Marisco'],
	areaServed: [
		{ '@type': 'City', name: 'Poio' },
		{ '@type': 'AdministrativeArea', name: 'Pontevedra' },
		{ '@type': 'AdministrativeArea', name: 'Galicia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: `${BUSINESS.city}, ${BUSINESS.municipality}`,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '13:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '21:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '12:00',
			closes: '18:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const nota = BUSINESS.rating.toFixed(1).replace('.', ',');
const resenas = BUSINESS.reviewsCount.toLocaleString('es-ES');
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1d4a4a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante A Nova Cepa, A Nova Cepa Poio, Nueva Cepa Poio, marisquería Poio, arroz con bogavante Pontevedra, marisco A Seara, restaurante con terraza Poio, lacón con grelos Poio"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Restaurante A Nova Cepa · Marisco en Poio"
			ogDescription="Arroz con bogavante, mariscada, zamburiñas y pescado en Camiño do Penedo 4 (A Seara, Poio), con terraza sobre la ría. Tel. 986 77 09 13."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Mariscada de cigalas, percebes y buey de mar en el Restaurante A Nova Cepa"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1d4a4a"
			street={BUSINESS.street}
			city={`${BUSINESS.city}, ${BUSINESS.municipality}`}
			region={BUSINESS.region}
			geoRegion="ES-GA"
			postalCode={BUSINESS.postalCode}
			phone="+34986770913"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.municipality}`}
			preload={[mariscada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="RESTAURANTE A NOVA CEPA"
			subtitle="A Seara · Poio"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Camiño do Penedo, 4 · A Seara, Poio"
				title="Marisco y arroz<br /><em>con vistas a la ría.</em>"
				lede={`Restaurante A Nova Cepa es la marisquería de Camiño do Penedo, 4, en A Seara (Poio, Pontevedra). Arroz con bogavante, mariscada, zamburiñas, pescados y carnes, con terraza cubierta sobre la ría de Pontevedra. Cierra los lunes salvo festivos. ${nota} sobre 5 con ${resenas} reseñas en Google.`}
				image={mariscada}
				imageAlt="Mariscada de cigalas, langostinos, percebes y buey de mar en una bandeja del Restaurante A Nova Cepa"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${nota}</b> en Google (${resenas} reseñas)` },
					{ label: 'Cocina', html: 'Marisco · arroz con bogavante' },
					{ label: 'Horario', html: 'Ma–S comida y cena · Dom mediodía' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Restaurante A Nova Cepa" items={[...SERVICIOS]} />

			<LocalAbout
				label="La casa"
				title="Marisco gallego<br /><em>y mesa con vistas.</em>"
				paragraphs={[
					'Restaurante A Nova Cepa está en Camiño do Penedo, 4, en el 36995 A Seara (Poio, Pontevedra). Es una casa de granito con el toldo amarillo del «Bar Restaurante Nueva Cepa» y una pizarra en la puerta con la carta; Google lo clasifica como restaurante, restaurante mediterráneo y marisquería.',
					'Cierra los lunes salvo festivos. De martes a sábado sirve comida de 13:00 a 17:00 y cena de 21:00 a 24:00; el domingo abre solo a mediodía, de 12:00 a 18:00. Es el horario de su ficha de Google y del cartel de la entrada, y puede cambiar, así que conviene confirmarlo por teléfono.',
					'La pizarra de la fachada ordena la carta en entrantes y ricos (mejillones, chipirones, zamburiñas, almejas, gambas al ajillo, navajas, pulpo, paella de marisco y arroz con bogavante), pescados (rape, rodaballo, merluza, lenguado, caldeirada, mero, lubina y sargo), carnes (chuleta o filete, ternera asada, cordero y chuletillas) y mariscos (camarones, cigalas, percebes, nécora y centollo).',
					'También anuncia platos por encargo —lacón con grelos, caldo gallego, capón de casa y callos con garbanzos— y se presenta como salón social, cervecería, jamonería y vinoteca con local climatizado.',
					'En las fotos del perfil aparecen la mariscada de cigalas, percebes y buey de mar, el arroz con bogavante, la paella de marisco, las zamburiñas, las almejas y un postre de la casa, además de la terraza cubierta y las vistas sobre la ría de Pontevedra.',
					`Tiene ${nota} sobre 5 con ${resenas} reseñas en Google. Las publicadas destacan el arroz con bogavante, las zamburiñas, las raciones abundantes y la relación calidad-precio. La ficha marca acceso para sillas de ruedas, aparcamiento, aseo y asientos adaptados.`,
				]}
				note="La ficha de Google no publica la carta ni los precios: los platos de esta página son los que anuncia la pizarra del propio restaurante y los que aparecen en sus fotos. El precio del marisco y del arroz se consulta en el local."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="De la ría<br /><em>a la mesa.</em>"
				description="La ficha de Google no publica carta. Estos platos son los de la pizarra de la fachada y los que citan las reseñas del restaurante; la oferta cambia según el día y la lonja."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={[...MENU]}
				note="La pizarra no lleva precios: el importe de la mariscada, el arroz con bogavante y el resto de la carta se consulta llamando al 986 77 09 13. Los platos por encargo se reservan con antelación."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La mariscada,<br /><em>la terraza y la ría.</em>"
				description="Estas fotografías proceden del perfil del Restaurante A Nova Cepa en Google Maps: la mariscada, el arroz con bogavante, la paella, las zamburiñas, las almejas, el postre, la fachada, la terraza cubierta y las vistas sobre la ría."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Camiño do Penedo, 4,<br /><em>en A Seara.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city} · ${BUSINESS.municipality}`,
					'Pontevedra · Galicia',
				]}
				hours={[...HOURS]}
				hoursNote="Horario de la ficha de Google: cierra los lunes salvo festivos; de martes a sábado, comida de 13:00 a 17:00 y cena de 21:00 a 24:00, y el domingo, de 12:00 a 18:00. Puede cambiar, así que conviene llamar antes."
				mapTitle="Mapa de Restaurante A Nova Cepa en Camiño do Penedo, 4, A Seara (Poio)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Restaurante A Nova Cepa · Poio"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 986 77 09 13. La ficha de Google marca acceso para sillas de ruedas, aparcamiento adaptado, aseo adaptado y asientos adaptados. El restaurante tiene terraza cubierta y local climatizado."
			/>

			<LocalFaq items={[...FAQ]} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}, ${BUSINESS.municipality}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a A Nova Cepa"
		/>
	</body>
</html>
