---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import mariscada from '../assets/fotos/restaurante-a-nova-cepa-apaisada-03.jpg';
import fachada from '../assets/fotos/restaurante-a-nova-cepa-apaisada-01.jpg';
import paella from '../assets/fotos/restaurante-a-nova-cepa-apaisada-07.jpg';
import terraza from '../assets/fotos/restaurante-a-nova-cepa-apaisada-08.jpg';
import vistas from '../assets/fotos/restaurante-a-nova-cepa-apaisada-10.jpg';
import arrozBogavante from '../assets/fotos/restaurante-a-nova-cepa-vertical-02.jpg';
import zamburinas from '../assets/fotos/restaurante-a-nova-cepa-vertical-04.jpg';
import postre from '../assets/fotos/restaurante-a-nova-cepa-vertical-06.jpg';
import almejas from '../assets/fotos/restaurante-a-nova-cepa-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Restaurante A Nova Cepa, en Camiño do Penedo 4 (A Seara, Poio). Arroz con bogavante, marisco y pescado, con terraza sobre la ría. Tel. 986 77 09 13.';

const title = 'Restaurante A Nova Cepa · Marisco en Poio';

const galeria = [
	{
		src: mariscada,
		alt: 'Mariscada de cigalas, langostinos, percebes y buey de mar en una bandeja del Restaurante A Nova Cepa',
	},
	{
		src: arrozBogavante,
		alt: 'Arroz con bogavante en su paella, servido en el Restaurante A Nova Cepa',
	},
	{
		src: zamburinas,
		alt: 'Zamburiñas a la plancha con su salsa en un plato del Restaurante A Nova Cepa',
	},
	{
		src: almejas,
		alt: 'Almejas a la marinera en salsa en un plato del Restaurante A Nova Cepa',
	},
	{
		src: terraza,
		alt: 'Terraza cubierta del Restaurante A Nova Cepa con mesas vestidas y vistas a la ría de Pontevedra',
	},
	{
		src: fachada,
		alt: 'Fachada de granito del Restaurante A Nova Cepa con el toldo amarillo y la pizarra de la carta',
	},
	{
		src: paella,
		alt: 'Paella de marisco con mejillones, almejas y gambas en el Restaurante A Nova Cepa',
	},
	{
		src: postre,
		alt: 'Postre de la casa frito y espolvoreado con azúcar glas en un plato del Restaurante A Nova Cepa',
	},
	{
		src: vistas,
		alt: 'Vistas sobre la ría de Pontevedra desde la terraza del Restaurante A Nova Cepa en Poio',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#novacepa`,
	name: BUSINESS.name,
	alternateName: ['A Nova Cepa', 'Nueva Cepa', 'Bar Restaurante Nueva Cepa', 'A Nova Cepa Poio'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 986 77 09 13',
	currenciesAccepted: 'EUR',
	priceRange: '€€',
	servesCuisine: ['Gallega', 'Mediterránea', 'Marisco'],
	areaServed: [
		{ '@type': 'City', name: 'Poio' },
		{ '@type': 'AdministrativeArea', name: 'Pontevedra' },
		{ '@type': 'AdministrativeArea', name: 'Galicia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: `${BUSINESS.city}, ${BUSINESS.municipality}`,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '13:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '21:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '12:00',
			closes: '18:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const nota = BUSINESS.rating.toFixed(1).replace('.', ',');
const resenas = BUSINESS.reviewsCount.toLocaleString('es-ES');

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-a-nova-cepa-apaisada-03.jpg": mariscada,
	"restaurante-a-nova-cepa-vertical-02.jpg": arrozBogavante,
	"restaurante-a-nova-cepa-vertical-04.jpg": zamburinas,
	"restaurante-a-nova-cepa-vertical-09.jpg": almejas,
	"restaurante-a-nova-cepa-apaisada-08.jpg": terraza,
	"restaurante-a-nova-cepa-apaisada-01.jpg": fachada,
	"restaurante-a-nova-cepa-apaisada-07.jpg": paella,
	"restaurante-a-nova-cepa-vertical-06.jpg": postre,
	"restaurante-a-nova-cepa-apaisada-10.jpg": vistas,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1d4a4a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante A Nova Cepa, A Nova Cepa Poio, Nueva Cepa Poio, marisquería Poio, arroz con bogavante Pontevedra, marisco A Seara, restaurante con terraza Poio, lacón con grelos Poio"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Restaurante A Nova Cepa · Marisco en Poio"
			ogDescription="Arroz con bogavante, mariscada, zamburiñas y pescado en Camiño do Penedo 4 (A Seara, Poio), con terraza sobre la ría. Tel. 986 77 09 13."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Mariscada de cigalas, percebes y buey de mar en el Restaurante A Nova Cepa"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1d4a4a"
			street={BUSINESS.street}
			city={`${BUSINESS.city}, ${BUSINESS.municipality}`}
			region={BUSINESS.region}
			geoRegion="ES-GA"
			postalCode={BUSINESS.postalCode}
			phone="+34986770913"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.municipality}`}
			preload={[mariscada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="RESTAURANTE A NOVA CEPA"
			subtitle="A Seara · Poio"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}, ${BUSINESS.municipality}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a A Nova Cepa"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34986770913?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Poio." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Poio"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
