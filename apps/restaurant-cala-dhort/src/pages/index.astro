---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/restaurant-cala-dhort-vertical-01.jpg';
import pollo from '../assets/fotos/restaurant-cala-dhort-vertical-02.jpg';
import ensaladaMixta from '../assets/fotos/restaurant-cala-dhort-apaisada-03.jpg';
import gambas from '../assets/fotos/restaurant-cala-dhort-vertical-04.jpg';
import atardecer from '../assets/fotos/restaurant-cala-dhort-apaisada-05.jpg';
import paella from '../assets/fotos/restaurant-cala-dhort-apaisada-06.jpg';
import mesa from '../assets/fotos/restaurant-cala-dhort-apaisada-07.jpg';
import arroz from '../assets/fotos/restaurant-cala-dhort-vertical-08.jpg';
import mesaEsVedra from '../assets/fotos/restaurant-cala-dhort-vertical-09.jpg';
import arrozCarabineros from '../assets/fotos/restaurant-cala-dhort-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Restaurant Cala d’Hort, en la playa de Cala d’Hort (Sant Josep de sa Talaia, Ibiza), frente a Es Vedrà. Cocina mediterránea e ibicenca desde 1966: paellas, pescado al horno y guisat de peix. Tel. 971 93 50 36.';

const galeria = [
	{
		src: atardecer,
		alt: 'Puesta de sol sobre Es Vedrà vista desde la terraza de Cala d’Hort, con veleros fondeados en la cala',
	},
	{
		src: mesa,
		alt: 'Mesa de Cala d’Hort bajo un sombrajo de paja, con mantel blanco, pan y Es Vedrà al fondo',
	},
	{
		src: mesaEsVedra,
		alt: 'Mesa con sangría, vino, pan y agua bajo el sombrajo, con la isla de Es Vedrà al fondo del mar',
	},
	{
		src: fachada,
		alt: 'Fachada de Cala d’Hort con el rótulo azul «CALA D’HORT RESTAURANT», sombrajo de cañas y mesas de madera',
	},
	{
		src: paella,
		alt: 'Paella de marisco con langostinos, mejillones, almejas y gajos de limón en la paellera',
	},
	{
		src: arroz,
		alt: 'Arroz con langostinos y mejillones en primer plano sobre un plato blanco',
	},
	{
		src: arrozCarabineros,
		alt: 'Arroz con carabineros, mejillones y limón servido en plato hondo con mantel de papel de Cala d’Hort',
	},
	{
		src: gambas,
		alt: 'Gambas al ajillo con guindilla y perejil en una sartén metálica',
	},
	{
		src: pollo,
		alt: 'Medio pollo asado con ensalada y patatas junto al mar, con aceite y vinagre en la mesa',
	},
	{
		src: ensaladaMixta,
		alt: 'Ensalada mixta con atún, huevo cocido, aguacate, alcachofa, espárragos y tomate',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#cala-dhort`,
	name: BUSINESS.name,
	alternateName: ['Cala d’Hort', 'Cala d’Hort Restaurant', 'Restaurante Cala d’Hort', 'Cala d’Hort Ibiza'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 971 93 50 36',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Ibicenca', 'Marisco'],
	areaServed: [
		{ '@type': 'City', name: 'Sant Josep de sa Talaia' },
		{ '@type': 'AdministrativeArea', name: 'Cala d’Hort' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:00',
			closes: '21:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Cala d’Hort · Restaurante frente a Es Vedrà (Ibiza)';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#a94a2b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,500;0,600;0,700;1,500&family=Lato:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Cala d'Hort, restaurante Cala d'Hort, comer en Cala d'Hort, restaurante Es Vedrà, paella Ibiza, playa Cala d'Hort, restaurante Sant Josep de sa Talaia, guisat de peix"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Cala d’Hort · Restaurante frente a Es Vedrà (Ibiza)"
			ogDescription="Cocina mediterránea e ibicenca en la playa de Cala d’Hort desde 1966: paellas, pescado al horno y guisat de peix con vistas a Es Vedrà. Tel. 971 93 50 36."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Puesta de sol sobre Es Vedrà desde la terraza de Cala d’Hort"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#a94a2b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			phone="+34971935036"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[atardecer]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Cala d’Hort"
			subtitle="Cocina mediterránea · Ibiza"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Platja Cala d’Hort · Sant Josep de sa Talaia"
				title="Comer en la playa,<br /><em>frente a Es Vedrà.</em>"
				lede={`Cala d’Hort es un restaurante familiar de cocina mediterránea e ibicenca abierto en 1966, en la misma playa de Cala d’Hort (Sant Josep de sa Talaia, Ibiza), con Es Vedrà al frente. Paellas y arroces, pescado al horno, guisat de peix, gambas al ajillo, carnes y ensaladas, con las mesas bajo un sombrajo de paja y el mar al lado. Abre todos los días de 11:00 a 21:30, salvo el martes. Teléfono: ${BUSINESS.phoneDisplay}.`}
				image={atardecer}
				imageAlt="Puesta de sol sobre Es Vedrà vista desde la terraza de Cala d’Hort, con veleros fondeados en la cala"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)` },
					{ label: 'Cocina', html: 'Mediterránea e ibicenca · desde 1966' },
					{ label: 'Horario', html: 'Todos los días · 11:00–21:30 · martes cerrado' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Restaurant Cala d’Hort" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Sesenta años<br /><em>en la misma cala.</em>"
				paragraphs={[
					'Cala d’Hort está en la misma playa de Cala d’Hort, en Sant Josep de sa Talaia (Ibiza), con la isla de Es Vedrà al frente. Google lo clasifica como restaurante mediterráneo y restaurante familiar, y el propio negocio se presenta así: «restaurante familiar de cocina mediterránea e ibicenca abierto en 1966».',
					'La casa es blanca, con el rótulo azul «CALA D’HORT RESTAURANT» sobre la entrada, un sombrajo de cañas, mesas de madera y sillas de plástico blancas. La terraza da directamente al agua: en las fotos del perfil se ven las mesas bajo el sombrajo de paja con Es Vedrà al fondo y la puesta de sol sobre el islote.',
					'La carta sigue la descripción del negocio: paellas, pescado al horno, guisat de peix y una selección de platos de carne y ensaladas. En las fotos aparecen la paella de marisco, el arroz con carabineros, las gambas al ajillo, el pollo asado con ensalada, la ensalada mixta y la ensalada de tomate. Abre todos los días de 11:00 a 21:30; el martes cierra.',
					'Sus reseñas hablan de los arroces y las vistas: «pedimos arroz, moluscos vapor y marinera, boquerones y calamares» y «buena paella de pescado, muy buenas vistas y buena atención». Google le da 4,4 sobre 5 con 1.273 reseñas.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google. Una de ellas: «${REVIEWS[1]}»`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Arroces, pescado<br /><em>y mesa junto al mar.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que cuenta la descripción del negocio, lo que aparece en las fotos del perfil y lo que citan sus reseñas."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. Llama al 971 93 50 36 para reservar mesa o preguntar por el arroz y el pescado del día."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Es Vedrà,<br /><em>la paella y el sombrajo.</em>"
				description="Estas fotografías proceden del perfil de Restaurant Cala d’Hort en Google Maps: la puesta de sol sobre Es Vedrà, las mesas bajo el sombrajo de paja, la fachada, la paella de marisco, el arroz con carabineros, las gambas al ajillo, el pollo asado y la ensalada mixta."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en Cala d’Hort.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: todos los días de 11:00 a 21:30; martes cerrado. En temporada alta conviene llamar antes para mesa en la terraza."
				mapTitle="Mapa de Restaurant Cala d’Hort en Platja Cala d’Hort (Sant Josep de sa Talaia, Ibiza)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Cala d’Hort · Ibiza"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 971 93 50 36. La ficha de Google marca acceso para sillas de ruedas, aseo adaptado y asientos adaptados."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Cala d’Hort"
		/>
	</body>
</html>
