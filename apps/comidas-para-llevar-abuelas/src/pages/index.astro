import foto06 from '../assets/fotos/comidas-para-llevar-abuelas-vertical-06.jpg';
import foto07 from '../assets/fotos/comidas-para-llevar-abuelas-vertical-07.jpg';

const fotos = [foto01, foto08, foto05, foto02, foto03, foto04, foto06, foto07];

const MAPS_URL =
	'https://www.google.com/maps/place/Comidas+para+llevar+Abuelas/@37.6768571,-1.6988302,17z/data=!3m1!4b1!4m6!3m5!1s0xd64e7ffa23195ad:0x673d7cc1e5e0a96c!8m2!3d37.6768571!4d-1.6988302!16s%2Fg%2F11fn00h0y4?authuser=0&hl=es&entry=ttu';
const CREDIT_URL = 'https://sur-digital.vercel.app/';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
