---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import panadero from '../assets/fotos/panaderia-la-paz-horno-de-lena-vertical-01.jpg';
import mostrador from '../assets/fotos/panaderia-la-paz-horno-de-lena-apaisada-02.jpg';
import fachada from '../assets/fotos/panaderia-la-paz-horno-de-lena-vertical-03.jpg';
import pan from '../assets/fotos/panaderia-la-paz-horno-de-lena-apaisada-04.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HOURS, HOURS_NOTE, MAPS, PAN, RESENAS, RESENAS_NOTE, SERVICIOS } from '../data/site';

const title = 'Panadería La Paz · Horno de leña en Alcolea, Córdoba';
const metaDescription =
	'Panadería La Paz, horno de leña en la Ctra. de Madrid, 36 (Alcolea, 14610 Córdoba). Pan del día todos los días de 10:15 a 14:30. 5,0 con 4 reseñas. Tel. 655 51 04 27.';
const description = BUSINESS.description;

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#la-paz`,
	name: BUSINESS.name,
	alternateName: ['Panadería La Paz- Horno de leña', 'Panadería La Paz Alcolea', 'Horno de leña La Paz'],
	description:
		'Panadería con horno de leña en la carretera de Madrid, 36 (Alcolea, 14610 Córdoba). Pan del día, abierta todos los días de 10:15 a 14:30.',
	url: `${BUSINESS.siteUrl}/`,
	telephone: '+34655510427',
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Panadería', 'Pan artesano'],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
		worstRating: 1,
	},
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:15',
			closes: '14:30',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El horno', href: '#horno' },
	{ label: 'Horario', href: '#horario' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Dónde está', href: '#visitanos' },
];

const stats = [
	{ label: 'Todos los días', value: '10:15–14:30' },
	{ label: 'Valoración', value: '5,0 · 4 reseñas' },
	{ label: 'Teléfono', value: BUSINESS.phone },
];

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de la panadería con el toldo a rayas y la puerta abierta a la carretera',
		caption: 'La fachada, en la carretera de Madrid',
		className: 'foto foto-vertical',
	},
	{
		src: mostrador,
		alt: 'El mostrador del local con la vitrina, una cesta de pan y estanterías al fondo',
		caption: 'El mostrador',
		className: 'foto',
	},
	{
		src: pan,
		alt: 'Panes de corteza dorada apilados junto al escaparate, con barras y hogazas',
		caption: 'El pan en el escaparate',
		className: 'foto',
	},
	{
		src: panadero,
		alt: 'El panadero sosteniendo una pieza grande de pan recién hecha dentro del local',
		caption: 'El panadero, con una pieza grande',
		className: 'foto foto-vertical',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#241d19" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Epilogue:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={metaDescription}
			keywords="Panadería La Paz Córdoba, horno de leña Alcolea, panadería Alcolea, pan de leña Córdoba, carretera de Madrid panadería, pan artesano Córdoba"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan de horno de leña en la carretera de Madrid, 36 (Alcolea). Todos los días de 10:15 a 14:30. 5,0 con 4 reseñas. Tel. 655 51 04 27."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="El panadero de Panadería La Paz con una pieza grande de pan recién hecha"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#241d19"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Alcolea, Córdoba"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[panadero]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Panadería La Paz, inicio">
					<span class="brand-mark" aria-hidden="true">LP</span>
					<span class="brand-name">
						Panadería La Paz
						<small>Horno de leña · Alcolea, Córdoba</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-cta" href={BUSINESS.phoneHref}>
					{BUSINESS.phone} <span aria-hidden="true">↗</span>
				</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Ctra. de Madrid, 36 · Alcolea · 14610</p>
						<h1 id="hero-title">Pan de horno de leña,<br /><em>en Alcolea.</em></h1>
						<p class="hero-lede">
							La panadería de la carretera de Madrid, en la entrada este de Córdoba. Pan del
							día horneado con leña, abierta todas las mañanas, también sábados y domingos.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="button button-ghost" href={BUSINESS.phoneHref}>Llamar al {BUSINESS.phone}</a>
						</div>
						<dl class="hero-facts">
							{
								stats.map((stat) => (
									<div>
										<dt>{stat.label}</dt>
										<dd>{stat.value}</dd>
									</div>
								))
							}
						</dl>
					</div>

					<figure class="hero-media">
						<div class="hero-photo">
							<Image
								src={panadero}
								alt="El panadero de La Paz sosteniendo una pieza grande de pan recién hecha dentro del local"
								widths={[480, 720, 1024, 1400]}
								sizes="(max-width: 980px) 88vw, 38vw"
								format="avif"
								quality={74}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</div>
						<figcaption>
							<span>El panadero, con una pieza grande</span>
							<span>Foto de la ficha de Google</span>
						</figcaption>
						<span class="hero-seal" aria-hidden="true">
							<strong>Horno</strong>
							<small>de leña<br />todos los días</small>
						</span>
					</figure>
				</div>
			</section>

			<section class="chips-wrap wrap" aria-label="Lo que ofrece la casa">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<div class="about-grid">
					<figure class="about-media">
						<Image
							src={mostrador}
							alt="El mostrador del local con la vitrina, una cesta de pan y estanterías al fondo"
							widths={[480, 720, 1000]}
							sizes="(max-width: 980px) 88vw, 44vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>El mostrador y la vitrina</figcaption>
					</figure>

					<div class="about-copy">
						<p class="section-label"><span aria-hidden="true"></span> La casa</p>
						<h2 id="about-title">Una panadería <em>de carretera.</em></h2>
						<p>
							La Paz está en el número 36 de la carretera de Madrid, en Alcolea, el barrio de
							la entrada este de Córdoba. Un local sencillo, con su toldo a rayas, su vitrina y
							el pan a la vista desde la calle.
						</p>
						<p>
							El nombre lo dice todo: <strong>horno de leña</strong>. En la galería de la ficha
							se ve al panadero con una pieza grande recién sacada y el pan apilado en el
							escaparate, con la corteza bien dorada.
						</p>
						<p>
							Abre todas las mañanas, de 10:15 a 14:30, los siete días de la semana. Es una
							panadería de barrio para ir a por el pan del día, sin cartas ni precios
							publicados en la ficha.
						</p>
						<div class="about-links">
							<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha en Google Maps <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href="#fotos">Ver las fotos</a>
						</div>
					</div>
				</div>

				<ul class="highlights">
					{
						HIGHLIGHTS.map((item) => (
							<li>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section class="horno" id="horno" aria-labelledby="horno-title">
				<div class="wrap horno-grid">
					<figure class="horno-media">
						<Image
							src={pan}
							alt="Panes de corteza dorada apilados junto al escaparate, con barras y hogazas"
							widths={[480, 720, 1000]}
							sizes="(max-width: 980px) 88vw, 42vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>El pan, en el escaparate</figcaption>
					</figure>

					<div class="horno-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> El horno</p>
						<h2 id="horno-title">La leña manda <em>en el sabor.</em></h2>
						<p>
							No hace falta preguntar por qué el pan sabe distinto: está en el nombre del
							negocio. El horno de leña es la seña de identidad de La Paz, y el pan sale de ahí
							cada mañana.
						</p>

						<ol class="pan-list">
							{
								PAN.map((item) => (
									<li>
										<h3>{item.title}</h3>
										<p>{item.text}</p>
									</li>
								))
							}
						</ol>
					</div>
				</div>
			</section>

			<section class="hours" id="horario" aria-labelledby="hours-title">
				<div class="wrap hours-grid">
					<div class="hours-copy">
						<p class="section-label"><span aria-hidden="true"></span> Horario</p>
						<h2 id="hours-title">Todas las mañanas, <em>los siete días.</em></h2>
						<p>
							La ficha publica el mismo horario de lunes a domingo: de 10:15 a 14:30. Un solo
							turno, así que el pan se compra por la mañana.
						</p>
						<p class="hours-note">
							<strong>Ojo con el 1 de noviembre.</strong> {HOURS_NOTE}
						</p>
						<div class="hours-actions">
							<a class="button button-primary" href={BUSINESS.phoneHref}>
								Llamar al {BUSINESS.phone}
							</a>
							<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
								Ver en Google Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>

					<div class="hours-table-wrap">
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google</caption>
							<tbody>
								{
									HOURS.map((row) => (
										<tr>
											<th scope="row">{row.day}</th>
											<td>{row.value}</td>
										</tr>
									))
								}
							</tbody>
						</table>
						<p class="hours-foot">
							Horario de la ficha pública de Google, consultada en octubre de 2026. Puede
							cambiar en festivos.
						</p>
					</div>
				</div>
			</section>

			<section class="fotos wrap" id="fotos" aria-labelledby="fotos-title">
				<div class="fotos-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Fotos</p>
						<h2 id="fotos-title">La panadería, <em>sin filtros.</em></h2>
					</div>
					<p>
						Las cuatro fotos de la galería pública de Google Maps: la fachada, el mostrador, el
						pan en el escaparate y el panadero con una pieza grande.
					</p>
				</div>

				<div class="fotos-grid">
					{
						galeria.map((photo) => (
							<figure class={photo.className}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[420, 640, 900]}
									sizes="(max-width: 620px) 92vw, 46vw"
									format="avif"
									quality={70}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>{photo.caption}</figcaption>
							</figure>
						))
					}
				</div>
			</section>

			<section class="rating" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div>
						<span class="rating-value">5,0</span>
						<span class="rating-stars" aria-label="5 de 5 estrellas">★★★★★</span>
						<p class="rating-caption">
							valoración media<br />
							con 4 reseñas publicadas
						</p>
					</div>
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Lo que dicen</p>
						<h2 id="rating-title">El pan, <em>en dos frases.</em></h2>
						<ul class="quotes">
							{
								RESENAS.map((resena) => (
									<li>
										<blockquote>
											«{resena.texto}»
											<footer>Reseña de {resena.valor} estrellas en Google</footer>
										</blockquote>
									</li>
								))
							}
						</ul>
						<p class="rating-note">{RESENAS_NOTE}</p>
						<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver las reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Dónde está</p>
					<h2 id="visit-title">Carretera de Madrid, <em>36.</em></h2>
					<p class="address">
						{BUSINESS.street}<br />
						{BUSINESS.district} · {BUSINESS.postalCode} {BUSINESS.city}
					</p>

					<p class="visit-phone">
						<span>Teléfono</span>
						<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
					</p>

					<p class="visit-note">
						<strong>Accesibilidad:</strong> la ficha no publica si hay acceso para sillas de
						ruedas ni aparcamiento adaptado, así que esta página no lo afirma.
					</p>

					<ul class="visit-list">
						<li>
							<span>Horario</span>
							Todos los días, de 10:15 a 14:30.
						</li>
						<li>
							<span>Zona</span>
							Alcolea, en la entrada este de Córdoba por la carretera de Madrid.
						</li>
						<li>
							<span>Plus Code</span>
							{BUSINESS.plusCode}
						</li>
						<li>
							<span>Ficha</span>
							Google la clasifica como panadería, sin web ni redes.
						</li>
					</ul>

					<div class="visit-links">
						<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
							Ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Panadería La Paz en la carretera de Madrid, 36, Alcolea, Córdoba"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Ctra. de Madrid, 36 · Alcolea
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>ir.</em></h2>
				<div class="faq-list">
					{
						FAQ.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">LP</span>
						<p>
							Panadería La Paz
							<small>
								Horno de leña · pan del día<br />
								{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.district}, {BUSINESS.city}
							</small>
						</p>
					</div>
					<nav aria-label="Enlaces del establecimiento">
						<a href={BUSINESS.phoneHref}>Llamar</a>
						<a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
						<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a href="#horario">Horario</a>
						<a href="/aviso-legal">Aviso legal</a>
					</nav>
				</div>
				<small class="legal">
					© {new Date().getFullYear()}
					{BUSINESS.name} · Datos, reseñas y fotografías de la ficha pública de Google Maps,
					consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de
					desplazarte.
				</small>
				<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
				<p class="credit">
					<small>
						Creado por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
						sur-digital.vercel.app
					</small>
				</p>
			</div>
		</footer>
	</body>
</html>
