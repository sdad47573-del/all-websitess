---
import '../styles/global.css';

const business = {
	name: 'Restaurante Pinar San José',
	short: 'Pinar San José',
	street: 'Pago Zahora, 17',
	area: 'Los Caños de Meca',
	city: 'Barbate',
	postalCode: '11159',
	phone: '+34 609 44 68 27',
	latitude: 36.2011597,
	longitude: -6.0350153,
	site: 'https://restaurante-pinar-san-jose.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+Pinar+San+Jos%C3%A9/@36.2011597,-6.0350153,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c470fa6810765:0x12d6ba2301b47e68!8m2!3d36.2011597!4d-6.0350153!16s%2Fg%2F11s2351bjy?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=15&output=embed`;
const phoneHref = 'tel:+34609446827';
const campingUrl = 'https://www.campingpinarsanjose.com/';

const specialties = [
	{
		kicker: 'De la tierra',
		title: 'Productos gaditanos',
		text: 'Productos de la tierra como base de la carta, en un camping de primera categoría.',
	},
	{
		kicker: 'Del mar',
		title: 'Influencia marinera',
		text: 'La influencia del mar de Caños y Zahora en los platos del restaurante.',
	},
	{
		kicker: 'Jornada larga',
		title: 'De 9:00 a 24:00',
		text: 'De viernes a domingo, desayuno, comida y cena sin moverse del pinar.',
	},
	{
		kicker: 'Entre pinos',
		title: 'Sombra natural',
		text: 'Amplias zonas de sombra y equipamientos renovados alrededor del restaurante.',
	},
	{
		kicker: 'Cómodo',
		title: 'Pago con tarjeta',
		text: 'Aceptan Visa, Mastercard y American Express, además de efectivo.',
	},
	{
		kicker: 'En ruta',
		title: 'Caños y Trafalgar',
		text: 'Base perfecta para la playa de Caños de Meca, Zahora y el faro de Trafalgar.',
	},
];

const gallery = [
	{ src: '/fotos/pinar.svg', alt: 'Ilustración del pinar junto al restaurante — sustituye por foto propia' },
	{ src: '/fotos/tierra-mar.svg', alt: 'Ilustración de productos de la tierra y el mar — sustituye por foto propia' },
	{ src: '/fotos/pescado.svg', alt: 'Ilustración de pescado del día — sustituye por foto propia del restaurante' },
	{ src: '/fotos/terraza.svg', alt: 'Ilustración de la terraza — sustituye por foto propia' },
	{ src: '/fotos/camping.svg', alt: 'Ilustración del camping de primera categoría — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Pinar San José?',
		a: 'En Pago Zahora, 17, 11159 Barbate (Cádiz), dentro del Camping Pinar San José, entre Los Caños de Meca y Zahora.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De viernes a domingo de 9:00 a 24:00; de lunes a jueves cerrado. Es horario de temporada de camping: confirma en el 609 44 68 27.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'En temporada alta y fin de semana conviene reservar en el 609 44 68 27.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Bar restaurante con productos de la tierra y la influencia del mar de la zona de Caños y Zahora. Aceptan tarjeta.',
	},
	{
		q: '¿Hay que estar alojado para comer?',
		a: 'No: el restaurante atiende también a visitantes. Y si te quedas, el camping es de primera categoría con zonas de sombra.',
	},
];

const description =
	'Restaurante Pinar San José: bar restaurante entre pinos en Pago Zahora, 17 (Barbate, Caños de Meca). Productos de la tierra y del mar. Vie–dom 9:00–24:00. Tel. 609 44 68 27.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 609 44 68 27',
	image: [`${business.site}/fotos/pinar.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo, Visa, Mastercard, American Express',
	servesCuisine: ['Mediterránea', 'Andaluza', 'Pescados'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [campingUrl],
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '24:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza entre pinos', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Pago con tarjeta', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.4,
		reviewCount: 321,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="Restaurante Pinar San José: bar restaurante entre pinos en Pago Zahora, 17 (Barbate, Caños de Meca). Productos de la tierra y del mar. Vie–dom 9:00–24:00. 609 44 68 27." />
		<meta name="keywords" content="Pinar San José restaurante, comer Caños de Meca, restaurante Zahora Barbate, camping Pinar San José restaurante, Pago Zahora 17, Trafalgar comer" />
		<meta name="author" content="Restaurante Pinar San José" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>Pinar San José | Restaurante entre pinos en Caños de Meca</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Pinar San José · Tierra y mar en Caños de Meca" />
		<meta property="og:description" content="Bar restaurante entre pinos en Pago Zahora, 17 (Barbate). Productos de la tierra con influencia del mar. Vie–dom 9:00–24:00." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/pinar.svg`} />
		<meta property="og:image:alt" content="Restaurante Pinar San José entre pinos, Caños de Meca" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Pinar San José · Restaurante entre pinos en Caños de Meca" />
		<meta name="twitter:description" content="Tierra y mar en Pago Zahora, 17, Barbate. Vie–dom 9:00–24:00." />
		<meta name="twitter:image" content={`${business.site}/fotos/pinar.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Barbate" />
		<meta name="geo.position" content="36.2011597;-6.0350153" />
		<meta name="ICBM" content="36.2011597, -6.0350153" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Pinar San José, inicio">
				<span class="brand-mark" aria-hidden="true">PS</span>
				<span class="brand-name">Pinar San José <small>Caños de Meca · Barbate</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">El restaurante</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>609 44 68 27</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Pago Zahora, 17 · Barbate</p>
					<h1 id="hero-title">Tierra y mar<br />entre <em>pinos.</em></h1>
					<p class="hero-lede">
						Bar restaurante del Camping Pinar San José: productos de la tierra con la influencia del mar
						de Caños y Zahora, a la sombra del pinar y a un paso de la playa.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 609 44 68 27</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,4</b> (321 opiniones)</li>
						<li>Vie–dom 9–24</li>
						<li>Tarjeta OK</li>
						<li>Camping 1ª</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/fotos/pinar.svg" alt="Ilustración del pinar junto a Restaurante Pinar San José, Barbate" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Pago Zahora 17 · Barbate</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>4,4</b><span>Valoración</span></div>
					<div><b>9–24</b><span>Fin de semana</span></div>
					<div><b>1ª</b><span>Camping</span></div>
				</div>
				<ul class="services">
					<li>Terraza</li>
					<li>Tierra y mar</li>
					<li>Tarjeta</li>
					<li>Sombra</li>
					<li>Reservas</li>
					<li>Playa cerca</li>
				</ul>
			</section>

			<section class="about section-pad" id="restaurante">
				<p class="section-label"><span aria-hidden="true"></span> El restaurante del camping</p>
				<div class="about-grid">
					<h2>Comer bien<br />sin salir <em>del pinar.</em></h2>
					<div class="about-copy">
						<p>
							Restaurante Pinar San José es el bar restaurante del Camping Pinar San José, de primera
							categoría, en Pago Zahora, 17 (Barbate), entre Los Caños de Meca y Zahora.
						</p>
						<p>
							Su cocina une los productos de la tierra con la influencia del mar de la zona, en un entorno
							de amplias zonas de sombra con equipamientos renovados.
						</p>
						<p class="about-note">
							Abre de viernes a domingo de 9:00 a 24:00; de lunes a jueves cerrado. Es horario de
							temporada de camping: confirma en el 609 44 68 27, y reserva en temporada alta.
						</p>
						<div class="about-links">
							<a class="simple-link" href={campingUrl} target="_blank" rel="noreferrer">Web del camping <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales según su ficha pública: tierra y mar de la zona. Confirma la carta del día
						en el propio restaurante.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El pinar<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del restaurante.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Pago Zahora, 17</p>
					<h2>Ven al pinar<br /><em>a comer.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.area}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Viernes a domingo</th>
								<td>9:00 – 24:00</td>
							</tr>
							<tr>
								<th scope="row">Lunes a jueves</th>
								<td>Cerrado</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Horario de temporada de camping. Confirma en el 609 44 68 27 antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al restaurante ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 609 44 68 27</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de Restaurante Pinar San José en Pago Zahora 17, Barbate" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Pinar San José · Barbate</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">PS</span>
				<p>Pinar San José<small>{business.street} · {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={campingUrl} target="_blank" rel="noreferrer">Camping ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Pinar San José · Barbate. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>609 44 68 27</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
