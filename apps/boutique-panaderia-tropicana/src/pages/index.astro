---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import bolleria from '../assets/fotos/boutique-panaderia-tropicana-panoramica-02.jpg';
import interior from '../assets/fotos/boutique-panaderia-tropicana-vertical-01.jpg';
import fachada from '../assets/fotos/boutique-panaderia-tropicana-vertical-03.jpg';
import edificio from '../assets/fotos/boutique-panaderia-tropicana-vertical-04.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Boutique de La Panadería Tropicana · Bailén-Miraflores, Málaga';
const description =
	'Boutique de La Panadería Tropicana Pastelería, en Bailén-Miraflores (29010 Málaga). Pan, bollería y pastelería. Abierta todos los días de 7:30 a 20:30. 4,4 sobre 5 en Google.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#tropicana`,
	name: BUSINESS.name,
	alternateName: [
		'Tropicana',
		'Panadería Tropicana Málaga',
		'Pastelería Tropicana Bailén-Miraflores',
	],
	description:
		'Panadería y pastelería en Bailén-Miraflores (29010 Málaga). Pan, bollería, palmeras rellenas, dulces de vitrina y productos envasados.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '07:30',
			closes: '20:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de Tropicana Panadería Pastelería en Bailén-Miraflores, con el rótulo y el cartel vertical',
	},
	{
		src: interior,
		alt: 'Interior de la tienda con vitrinas de pan y dulces, torres de productos envasados y aperitivos',
	},
	{
		src: edificio,
		alt: 'Esquina del edificio donde está la panadería, con el rótulo sobre la puerta',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1d3b2f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..600&family=Source+Sans+3:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Boutique Panadería Tropicana, panadería Bailén-Miraflores, pastelería Málaga, palmeras rellenas, bollería Málaga, 29010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería y pastelería en Bailén-Miraflores. Pan, napolitanas, palmeras rellenas y dulces. Abierta todos los días de 7:30 a 20:30. 4,4 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bandeja de bollería de la Boutique de La Panadería Tropicana"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1d3b2f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[bolleria]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Panadería · Pastelería"
			nav={nav}
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Bailén-Miraflores · 29010 Málaga"
				title="Pan, bollería <br /><em>y dulces de vitrina.</em>"
				lede={`La Boutique de La Panadería Tropicana está en Bailén-Miraflores, con el rótulo «Tropicana · Panadería Pastelería» en la fachada. Dentro hay vitrinas de pan y dulces, una bandeja de napolitanas, palmeras y piezas de hojaldre, y estanterías con productos envasados. Abre todos los días de 7:30 a 20:30. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={bolleria}
				imageAlt="Bandeja de napolitanas de chocolate, palmeras, dulces de nata y una pieza Kinder"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4</b> en Google · 63 reseñas' },
					{ label: 'Horario', html: '<b>Todos los días</b> 7:30–20:30' },
					{ label: 'Zona', html: '<b>Bailén-Miraflores</b> · 29010' },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Pan · bollería · pastelería"
			/>

			<LocalChips label="Lo que hay en Tropicana" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una panadería <br /><em>de barrio.</em>"
				paragraphs={[
					'La Boutique de La Panadería Tropicana Pastelería está en Bailén-Miraflores, en el 29010 de Málaga. La fachada lleva el rótulo «Tropicana · Panadería Pastelería» sobre la puerta y un cartel vertical en la esquina.',
					'Dentro, el local es tienda y obrador: vitrinas con pan y dulces, una bandeja de bollería recién hecha y estanterías con productos envasados, aperitivos y bebidas.',
					'En las fotos del perfil se ven napolitanas de chocolate, palmeras, barras de hojaldre rellenas de nata y una pieza con etiqueta «Kinder». Las reseñas de Google destacan el pan, la variedad de dulces y las palmeras rellenas, «bastante grandes y baratas».',
					'Abre todos los días de 7:30 a 20:30, en jornada continua. La ficha no publica la calle ni el número, ni teléfono, web o precios, así que aquí no encontrarás ni dirección exacta ni importes: el mapa de esta página lleva al punto de Google Maps.',
				]}
				note="La ficha de Google no publica calle, número, teléfono ni precios. El mostrador recoge solo lo que muestran las fotos del perfil y lo que cuentan las reseñas."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Pan, bollería <br />
							<em>y tienda.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que hay <br /><em>en la vitrina.</em>"
				description="Sin carta ni precios publicados: esto es lo que muestran las fotos del local y lo que cuentan las reseñas de Google."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={MENU_GROUPS}
				note="La ficha no recoge precios ni métodos de pago, así que esta web no publica importes. El surtido cambia a lo largo del día: la panadería abre de 7:30 a 20:30."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La casa, <br /><em>por dentro.</em>"
				description="Tres fotos de la ficha de Google Maps: la fachada, el interior con las vitrinas y la esquina del edificio."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En pleno <br /><em>Bailén-Miraflores.</em>"
				addressLines={[BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de la Boutique de La Panadería Tropicana en Bailén-Miraflores, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Tropicana · Bailén-Miraflores"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: 'Abrir en Google Maps ↗', href: MAPS.place, external: true }}
				reserveNote="La ficha de Google no publica calle ni número, solo el barrio y el código postal: usa el mapa para llegar. Indica acceso para sillas de ruedas y aparcamiento adaptado, pero no informa sobre el mostrador ni el aseo. Tampoco publica teléfono, así que el contacto es en el local."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone=""
			phoneHref=""
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Ver en Google Maps"
			navAriaLabel="Enlaces de la Boutique de La Panadería Tropicana"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
