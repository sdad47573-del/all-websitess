---
import { Image } from 'astro:assets';
import foto01 from '../assets/fotos/el-cucharon-apaisada-01.jpg';
import foto04 from '../assets/fotos/el-cucharon-apaisada-04.jpg';
import foto10 from '../assets/fotos/el-cucharon-cuadrada-10.jpg';
import foto02 from '../assets/fotos/el-cucharon-vertical-02.jpg';
import foto03 from '../assets/fotos/el-cucharon-vertical-03.jpg';
import foto05 from '../assets/fotos/el-cucharon-vertical-05.jpg';
import foto06 from '../assets/fotos/el-cucharon-vertical-06.jpg';
import foto07 from '../assets/fotos/el-cucharon-vertical-07.jpg';
import foto08 from '../assets/fotos/el-cucharon-vertical-08.jpg';
import foto09 from '../assets/fotos/el-cucharon-vertical-09.jpg';

const fotos = [foto01, foto04, foto10, foto02, foto03, foto05, foto06, foto07, foto08, foto09];

const MAPS_URL =
	'https://www.google.com/maps/place/El+Cuchar%C3%B3n/@37.9412668,-1.1474164,17z/data=!3m1!4b1!4m6!3m5!1s0xd637f252a916af1:0x45797fb2b15f39fc!8m2!3d37.9412668!4d-1.1474164!16s%2Fg%2F11c5gbc2__?authuser=0&hl=es&entry=ttu';
const CREDIT_URL = 'https://sur-digital.vercel.app/';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>El Cucharón</title>
		<meta name="description" content="El Cucharón." />
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"@id": "https://el-cucharon.vercel.app/#negocio",
	"name": "El cucharon",
	"url": "https://el-cucharon.vercel.app/",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 37.9412668,
		"longitude": -1.1474164
	},
	"hasMap": "https://www.google.com/maps/place/El+Cuchar%C3%B3n/@37.9412668,-1.1474164,17z/data=!3m1!4b1!4m6!3m5!1s0xd637f252a916af1:0x45797fb2b15f39fc!8m2!3d37.9412668!4d-1.1474164!16s%2Fg%2F11c5gbc2__?authuser=0&hl=es&entry=ttu"
}
</script>
		<meta property="og:image" content="https://el-cucharon.vercel.app/og.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta property="og:url" content="https://el-cucharon.vercel.app/" />
		<meta property="og:locale" content="es_ES" />
			<meta property="og:title" content="El Cucharón" />
		<meta property="og:description" content="El Cucharón." />
	</head>
	<body>
		<header>
			<h1 set:html={piezas.portada.titulo} />
			<a href={MAPS_URL} rel="noopener" target="_blank">Ver en Google Maps</a>
		</header>

		<main>
			<section class="galeria">
				{fotos.map((foto) => <Image src={foto} alt="El Cucharón" loading="lazy" />)}
			</section>
		</main>

		<footer>
			<p>
				Creado por <a href={CREDIT_URL} rel="noopener">Sur Digital</a> · sur-digital.vercel.app
			</p>
		</footer>
	</body>
</html>
