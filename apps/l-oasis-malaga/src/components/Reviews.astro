---
import { BUSINESS, REVIEWS } from '../data/site';
---

<section class="bg-base-200">
	<div class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
		<header class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
			<div class="max-w-2xl">
				<p class="mb-3 text-sm font-semibold tracking-widest uppercase text-primary">Reseñas</p>
				<h2 class="font-display text-3xl font-semibold sm:text-4xl">Lo que dicen</h2>
			</div>

			<a
				href={BUSINESS.reviewsUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-outline gap-2"
			>
				<span class="flex items-center gap-1 text-secondary-content">
					<i class="ri-star-fill"></i>
					{BUSINESS.rating}
				</span>
				{BUSINESS.reviewsCount} reseñas en Google
			</a>
		</header>

		<div class="mt-10 grid gap-5 sm:grid-cols-2">
			{
				REVIEWS.map((review) => (
					<figure class="card card-border bg-base-100 shadow-sm">
						<div class="card-body">
							<div class="flex gap-0.5 text-accent" aria-label={`${review.rating} de 5`}>
								{Array.from({ length: review.rating }).map(() => (
									<i class="ri-star-fill" />
								))}
							</div>
							<blockquote class="mt-2 leading-relaxed">«{review.text}»</blockquote>
							<figcaption class="mt-3 text-xs opacity-60">{review.author}</figcaption>
						</div>
					</figure>
				))
			}
		</div>
	</div>
</section>
