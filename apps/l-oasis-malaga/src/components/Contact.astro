---
import { BUSINESS, HOURS } from '../data/site';
---

<section id="contacto" class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
	<div class="grid gap-12 lg:grid-cols-2">
		<div>
			<p class="mb-3 text-sm font-semibold tracking-widest uppercase text-primary">Contacto</p>
			<h2 class="font-display text-3xl font-semibold sm:text-4xl">Te esperamos</h2>
			<p class="mt-4 max-w-md leading-relaxed opacity-80">
				Estamos en el Paseo de los Tilos, a dos minutos andando de la estación de tren
				María Zambrano. Lo más fácil es llamarnos: contestamos de 8:00 a 00:30.
			</p>

			<address class="mt-8 space-y-4 not-italic">
				<div class="flex gap-3">
					<i class="ri-map-pin-2-line mt-0.5 text-lg text-primary"></i>
					<div>
						<p class="font-medium">{BUSINESS.street}</p>
						<p class="text-sm opacity-70">
							{BUSINESS.district} · {BUSINESS.postalCode} {BUSINESS.city}
						</p>
					</div>
				</div>
				<div class="flex gap-3">
					<i class="ri-phone-line mt-0.5 text-lg text-primary"></i>
					<div>
						<a class="font-medium hover:underline" href={BUSINESS.phoneHref}>
							{BUSINESS.phoneDisplay}
						</a>
						<p class="text-sm opacity-70">De 8:00 a 00:30, todos los días</p>
					</div>
				</div>
				<div class="flex gap-3">
					<i class="ri-train-line mt-0.5 text-lg text-primary"></i>
					<div>
						<p class="font-medium">Estación de {BUSINESS.nearby}</p>
						<p class="text-sm opacity-70">A unos dos minutos andando</p>
					</div>
				</div>
			</address>

			<div class="mt-8 flex flex-wrap gap-3">
				<a href={BUSINESS.phoneHref} class="btn btn-primary gap-2">
					<i class="ri-phone-line"></i>
					Llamar
				</a>
				<a
					href={BUSINESS.googleMaps}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-outline gap-2"
				>
					<i class="ri-map-pin-line"></i>
					Abrir en Maps
				</a>
				<a
					href={BUSINESS.instagram}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-ghost gap-2"
				>
					<i class="ri-instagram-line"></i>
					Instagram
				</a>
			</div>
		</div>

		<div>
			<div class="card card-border bg-base-200/50 shadow-sm">
				<div class="card-body">
					<h3 class="card-title font-display text-xl">
						<i class="ri-time-line text-primary"></i>
						Horarios
					</h3>
					<ul class="divide-y divide-base-300">
						{
							HOURS.map((row) => (
								<li class="flex items-center justify-between py-2.5 text-sm">
									<span class="opacity-75">{row.days}</span>
									<span class="font-medium tabular-nums">{row.hours}</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>

			<div class="card card-border mt-6 overflow-hidden shadow-sm">
				<div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
					<button type="button" data-cargar-mapa aria-label="Cargar mapa interactivo" style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
						<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
						<strong style="font-size:1rem;">Cargar mapa interactivo</strong>
						<small style="opacity:0.65;">Se carga solo al pulsar</small>
					</button>
<iframe
					title={`Mapa de ${BUSINESS.name}`}
				 data-src={BUSINESS.googleMapsEmbed}
					class="h-64 w-full border-0"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"></iframe>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
// mapa-fachada: la URL del iframe vive en data-src y solo se asigna al pulsar (ahorra ~1MB de JS).
document.addEventListener('click', function (e) {
	var t = e.target && e.target.closest ? e.target.closest('[data-cargar-mapa]') : null;
	if (!t) return;
	var w = t.closest('[data-mapa-fachada]');
	if (!w || w.dataset.cargado) return;
	var f = w.querySelector('iframe');
	if (!f || !f.dataset.src || f.getAttribute('src')) return;
	w.dataset.cargado = '1';
	f.setAttribute('src', f.dataset.src);
	t.remove();
});
</script>
