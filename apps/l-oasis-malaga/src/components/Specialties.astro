---
import { SPECIALTIES } from '../data/site';
---

<section class="bg-base-200">
	<div class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
		<header class="max-w-2xl">
			<p class="mb-3 text-sm font-semibold tracking-widest uppercase text-primary">Especialidades</p>
			<h2 class="font-display text-3xl font-semibold sm:text-4xl">Lo más pedido</h2>
		</header>

		<div class="mt-10 grid gap-5 sm:grid-cols-2">
			{
				SPECIALTIES.map((item) => (
					<article class="card card-border bg-base-100 shadow-sm transition-shadow hover:shadow-lg">
						<div class="card-body">
							<div class="flex items-start justify-between gap-3">
								<div class="flex size-11 items-center justify-center rounded-full bg-secondary/15 text-xl text-primary">
									<i class={item.icon} />
								</div>
								<span class="badge badge-outline badge-sm">{item.tag}</span>
							</div>
							<h3 class="card-title mt-2 font-display text-lg">{item.title}</h3>
							<p class="text-sm opacity-75">{item.text}</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
