---
import { BUSINESS, IMAGES } from '../data/site';
---

<section id="local" class="relative overflow-hidden pt-16">
	<div class="absolute inset-0">
		<img
			src={IMAGES.mapsPortada.src}
			alt=""
			aria-hidden="true"
			class="h-full w-full object-cover"
			loading="eager"
			fetchpriority="high" decoding="async"
		/>
		<div class="absolute inset-0 bg-gradient-to-b from-neutral/80 via-neutral/70 to-neutral/90"></div>
	</div>

	<div class="relative mx-auto max-w-6xl px-4 py-20 sm:py-28 lg:py-36">
		<div class="max-w-3xl">
			<p class="mb-4 inline-flex items-center gap-2 rounded-full bg-secondary/20 px-4 py-1.5 text-sm font-semibold text-secondary-content ring-1 ring-secondary/40">
				<i class="ri-shield-check-line"></i>
				Cocina halal · Abierto los 7 días
			</p>

			<h1 class="font-display text-4xl leading-tight font-semibold text-white text-shadow-soft sm:text-6xl">
				L'Oasis Restaurante & Cafetería
			</h1>

			<p class="mt-6 max-w-xl text-lg text-white/85 sm:text-xl">
				{BUSINESS.summary}
			</p>

			<div class="mt-8 flex flex-wrap items-center gap-3">
				<a href={BUSINESS.phoneHref} class="btn btn-primary btn-lg gap-2">
					<i class="ri-phone-line"></i>
					{BUSINESS.phoneDisplay}
				</a>
				<a href={BUSINESS.googleMaps} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-lg gap-2 border-white/60 text-white hover:border-white hover:bg-white/10">
					<i class="ri-map-pin-line"></i>
					Cómo llegar
				</a>
			</div>

			<dl class="mt-10 flex flex-wrap gap-x-8 gap-y-4 text-white/90">
				<div>
					<dt class="text-xs uppercase tracking-widest opacity-70">Valoración</dt>
					<dd class="mt-1 flex items-center gap-1.5 text-lg font-semibold">
						<i class="ri-star-fill text-accent"></i>
						{BUSINESS.rating}
						<span class="text-sm font-normal opacity-70">
							({BUSINESS.reviewsCount} reseñas)
						</span>
					</dd>
				</div>
				<div>
					<dt class="text-xs uppercase tracking-widest opacity-70">Horario</dt>
					<dd class="mt-1 text-lg font-semibold">08:00 – 00:30</dd>
				</div>
				<div>
					<dt class="text-xs uppercase tracking-widest opacity-70">Dirección</dt>
					<dd class="mt-1 text-lg font-semibold">
						{BUSINESS.street}, {BUSINESS.district}
					</dd>
				</div>
			</dl>
		</div>
	</div>

	<div class="h-3 w-full oasis-divider"></div>
</section>
