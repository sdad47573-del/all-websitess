---
import { BUSINESS, FAQS } from '../data/site';
---

<section id="faq" class="mx-auto max-w-4xl px-4 py-16 sm:py-24">
	<header class="max-w-2xl">
		<p class="mb-3 text-sm font-semibold tracking-widest uppercase text-primary">
			Preguntas frecuentes
		</p>
		<h2 class="font-display text-3xl font-semibold sm:text-4xl">Todo lo que suelen preguntarnos</h2>
		<p class="mt-4 leading-relaxed opacity-80">
			Horario, tipo de cocina y ubicación son las dudas más frecuentes. Si la tuya no está aquí,
			llámanos al <a href={BUSINESS.phoneHref} class="font-medium text-primary hover:underline">{BUSINESS.phoneDisplay}</a>
			contestamos de 8:00 a 00:30.
		</p>
	</header>

	<div class="mt-10">
		{
			FAQS.map((faq, index) => (
				<div class="collapse collapse-arrow border-base-300 border-b bg-transparent">
					<input
						type="radio"
						name="faq-accordion"
						aria-label={faq.question}
						checked={index === 0}
					/>
					<div class="collapse-title pr-12 font-display text-lg">{faq.question}</div>
					<div class="collapse-content">
						<p class="leading-relaxed opacity-80">{faq.answer}</p>
					</div>
				</div>
			))
		}
	</div>

	<div class="mt-10 flex flex-wrap items-center gap-3">
		<a href={BUSINESS.phoneHref} class="btn btn-primary gap-2">
			<i class="ri-phone-line"></i>
			{BUSINESS.phoneDisplay}
		</a>
		<a href={BUSINESS.googleMaps} target="_blank" rel="noopener noreferrer" class="btn btn-outline gap-2">
			<i class="ri-map-pin-line"></i>
			Ver ubicación
		</a>
	</div>
</section>
