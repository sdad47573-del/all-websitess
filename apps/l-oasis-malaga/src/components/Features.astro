---
import { FEATURES } from '../data/site';
---

<section class="border-y border-base-300 bg-base-100">
	<div class="mx-auto max-w-6xl px-4 py-10">
		<ul class="flex flex-wrap justify-center gap-x-8 gap-y-4">
			{
				FEATURES.map((feature) => (
					<li class="flex items-center gap-2 text-sm opacity-80">
						<i class={`${feature.icon} text-lg text-primary`} />
						{feature.label}
					</li>
				))
			}
		</ul>
	</div>
</section>
