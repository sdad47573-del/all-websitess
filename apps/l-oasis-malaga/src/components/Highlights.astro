---
import { HIGHLIGHTS } from '../data/site';
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
	<h2 class="sr-only">Lo mejor de L'Oasis</h2>
	<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
		{
			HIGHLIGHTS.map((item) => (
				<article class="card card-border bg-base-200/50 shadow-sm">
					<div class="card-body">
						<div class="mb-1 flex size-11 items-center justify-center rounded-full bg-primary/10 text-xl text-primary">
							<i class={`${item.icon}`}></i>
						</div>
						<h3 class="card-title font-display text-lg">{item.title}</h3>
						<p class="text-sm opacity-75">{item.text}</p>
					</div>
				</article>
			))
		}
	</div>
</section>
