---
import { BUSINESS, NAV, PAGE_NAV } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-neutral text-neutral-content">
	<div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
		<div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
			<div class="lg:col-span-2">
				<div class="flex items-center gap-3">
					<span
						class="bg-primary font-display text-primary-content flex size-11 items-center justify-center rounded-xl text-xl font-bold"
						>O</span
					>
					<div>
						<p class="font-display text-xl font-semibold text-white">{BUSINESS.fullName}</p>
						<p class="text-xs tracking-[0.2em] text-white/50 uppercase">
							Halal · Desayunos · Comida y cena
						</p>
					</div>
				</div>
				<p class="mt-5 max-w-md text-sm leading-relaxed text-white/70">
					{BUSINESS.summary}
				</p>
				<div class="mt-6 flex gap-3">
					<a
						href={BUSINESS.instagram}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Instagram de L’Oasis"
						class="hover:bg-primary flex size-10 items-center justify-center rounded-full bg-white/10 transition-colors"
					>
						<i class="ri-instagram-line text-lg"></i>
					</a>
					<a
						href={BUSINESS.tiktok}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="TikTok de L’Oasis"
						class="hover:bg-primary flex size-10 items-center justify-center rounded-full bg-white/10 transition-colors"
					>
						<i class="ri-tiktok-fill text-lg"></i>
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Ficha de L’Oasis en Google Maps"
						class="hover:bg-primary flex size-10 items-center justify-center rounded-full bg-white/10 transition-colors"
					>
						<i class="ri-map-pin-line text-lg"></i>
					</a>
				</div>
			</div>

			<div>
				<h3 class="font-display text-lg font-semibold text-white">Secciones</h3>
				<ul class="mt-4 space-y-2 text-sm text-white/70">
					{NAV.map((item) => <li><a href={`/${item.href}`} class="transition-colors hover:text-accent">{item.label}</a></li>)}
				</ul>
				<ul class="mt-4 space-y-2 border-t border-white/10 pt-4 text-sm text-white/70">
					{PAGE_NAV.map((item) => <li><a href={item.href} class="transition-colors hover:text-accent">{item.label}</a></li>)}
				</ul>
			</div>

			<div>
				<h3 class="font-display text-lg font-semibold text-white">Contacto</h3>
				<ul class="mt-4 space-y-3 text-sm text-white/70">
					<li class="flex items-start gap-2">
						<i class="ri-map-pin-line mt-0.5 text-accent"></i>
						<span>
							{BUSINESS.street}<br />
							{BUSINESS.postalCode} {BUSINESS.city}
						</span>
					</li>
					<li class="flex items-center gap-2">
						<i class="ri-phone-line text-accent"></i>
						<a href={BUSINESS.phoneHref} class="hover:text-accent">{BUSINESS.phoneDisplay}</a>
					</li>
					<li class="flex items-start gap-2">
						<i class="ri-time-line mt-0.5 text-accent"></i>
						<span>
							Lunes a sábado: 08:00 – 00:30
							<br />
							Domingo: 09:00 – 00:30
						</span>
					</li>
					<li class="flex items-start gap-2">
						<i class="ri-train-line mt-0.5 text-accent"></i>
						<span>{BUSINESS.nearby}</span>
					</li>
				</ul>
			</div>
		</div>

		<div
			class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-xs text-white/50 sm:flex-row"
		>
			<p>© {year} {BUSINESS.fullName}. Todos los derechos reservados.</p>
			<a href={BUSINESS.googleMaps} target="_blank" rel="noopener noreferrer" class="hover:text-accent"
				>Ver ficha en Google Maps</a
			>
		</div>
	</div>

			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
					</footer>
