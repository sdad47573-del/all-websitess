---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Fab from '../components/Fab.astro';
import Footer from '../components/Footer.astro';
import Menu from '../components/Menu.astro';
import Topbar from '../components/Topbar.astro';
import { BUSINESS, FAQ_SCHEMA, HALAL, MENU } from '../data/site';
import Layout from '../layouts/Layout.astro';

const totalPlatos = MENU.reduce((total, section) => total + section.items.length, 0);
---

<Layout
	title={`Carta completa | Cocina halal en Málaga | ${BUSINESS.name}`}
	description={`Carta de ${BUSINESS.name} en Málaga: desayunos, entrantes, arroces, pasta y platos de fondo con carne halal. Sin alcohol. Abierto los 7 días de 8:00 a 00:30.`}
	path="/carta"
	schema={[FAQ_SCHEMA]}
>
	<Topbar />

	<main>
		<section class="bg-neutral text-neutral-content">
			<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
				

				<div class="grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-end">
					<div>
						<span class="text-accent text-xs font-semibold tracking-[0.2em] uppercase">
							Carta {new Date().getFullYear()}
						</span>
						<Breadcrumbs path="/carta" label="Carta" inverse />

				<h1 class="font-display mt-3 text-4xl font-bold sm:text-5xl">Nuestra carta completa</h1>
						<div class="oasis-divider mt-5 h-px w-32"></div>
						<p class="mt-6 max-w-2xl leading-relaxed text-white/75">
							{totalPlatos} platos repartidos en {MENU.length} secciones: desayunos, entrantes para
							compartir, platos de fondo de cocina mediterránea y bebidas. Todo preparado con carne
							halal certificada y sin alcohol en ninguna mesa.
						</p>
					</div>

					<div class="rounded-box border border-white/15 bg-white/5 p-6 backdrop-blur-sm">
						<p class="text-xs tracking-widest text-white/60 uppercase">La carta</p>
						<p class="mt-3 text-sm text-white/70">
							Los platos cambian con el mercado y con la estación. Confirma la disponibilidad de
							un plato concreto llamándonos antes de venir.
						</p>
						<div class="mt-5 flex flex-wrap gap-3">
							<a href={BUSINESS.phoneHref} class="btn btn-primary btn-sm gap-2 rounded-full">
								<i class="ri-phone-line"></i>
								{BUSINESS.phoneDisplay}
							</a>
							<a
								href={BUSINESS.googleMaps}
								target="_blank"
								rel="noopener noreferrer"
								class="btn btn-sm rounded-full border-white/30 bg-white/10 text-white hover:border-white hover:bg-white hover:text-neutral"
							>
								<i class="ri-map-pin-line"></i>
								Cómo llegar
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<div class="border-b border-base-300 bg-base-200/60">
			<div class="mx-auto max-w-6xl px-4 py-4">
				<p class="text-sm opacity-75">
					<i class="ri-shield-check-line mr-1 text-primary"></i>
					{HALAL.text}
				</p>
			</div>
		</div>

		<Menu
			full
			title="Todo lo que servimos"
			description="Las cuatro secciones de la carta. Si tienes alguna alergia o duda sobre un ingrediente, llámanos y te lo confirmamos antes de que vengas."
		/>
	</main>

	<Footer />
	<Fab />
</Layout>
