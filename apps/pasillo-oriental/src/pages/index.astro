---
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	facebookUrl,
	faqSchema,
	faqs,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,		restaurantSchema,
	specialties,
	tripadvisorUrl,

} from '../lib/business';

const title = 'Pasillo Oriental | Cocina egipcia y halal en Córdoba';
const description =
	'Pasillo Oriental, restaurante halal de cocina egipcia y de Oriente Medio en C. Velázquez Bosco, Córdoba. Opciones vegetarianas y veganas. Reserva: 957 94 10 17.';
const keywords =
	'Pasillo Oriental Córdoba, restaurante halal Córdoba, comida egipcia Córdoba, cocina árabe Córdoba, shawarma Córdoba, falafel Córdoba, C. Velázquez Bosco 6, vegetariano vegano Córdoba';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#252321" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración original de cocina oriental para Pasillo Oriental; no es una foto del restaurante" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Pasillo Oriental, inicio">
				<span class="brand-mark" aria-hidden="true">P</span>
				<span class="brand-copy">Pasillo Oriental <small>Cocina egipcia · Córdoba</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cocina">La cocina</a>
				<a href="#historia">El espacio</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 957 94 10 17</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Sabores de Oriente · Centro de Córdoba</p>
					<h1 id="hero-title">Un viaje de sabor<br /><em>sin salir de Córdoba.</em></h1>
					<p class="hero-intro">En Pasillo Oriental se encuentran la cocina egipcia, las recetas de Oriente Medio y el sabor mediterráneo. Un rincón acogedor para compartir hummus, falafel, shawarma y mucho más.</p>
					<div class="hero-actions">
						<a class="button button-teal" href={phoneHref}>Llamar y reservar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Nos encontrarás en</small><address>{business.streetAddress}<br />{business.postalCode} · Córdoba</address></div>
						<div><small>Reservas</small><a href={phoneHref}>{business.phone}</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración vectorial original de una comida oriental, no es una fotografía del restaurante">
					<span class="plate-dot" aria-hidden="true"></span><div class="plate" aria-hidden="true"><div class="meal"></div></div>
					<div class="art-caption"><strong>Hecho para compartir</strong>Halal · mediterráneo · casero</div>
				</div>
			</section>

			<div class="promise" aria-label="Características de Pasillo Oriental">
				<span>Cocina halal</span><span>Recetas egipcias</span><span>Opciones vegetarianas</span><span>Alternativas veganas</span>
			</div>

			<section class="section intro" id="historia" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Cocina egipcia y mediterránea</p>
					<h2 id="intro-title">Tradición de Oriente,<br /><em>mesa cordobesa.</em></h2>
				</div>
				<div class="intro-copy">
					<p>En el centro de Córdoba, a pocos pasos de la Mezquita-Catedral, Pasillo Oriental invita a descubrir platos de cocina egipcia y de Oriente Medio en un ambiente cercano y acogedor. Su perfil oficial destaca la comida halal y ofrece opciones vegetarianas y veganas.</p>
					<p>La carta reúne entrantes para compartir, recetas de arroz y legumbres, shawarma y dulces tradicionales. Una propuesta sabrosa tanto para una comida rápida por el centro como para sentarse a disfrutar con calma.</p>
					<p class="source-note">Si tienes alergias, intolerancias o necesidades dietéticas, consulta ingredientes, trazas y preparación directamente con el equipo antes de pedir.</p>
				</div>
			</section>

			<section class="section menu-section" id="cocina" aria-labelledby="menu-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Para descubrir y compartir</p>
						<h2 id="menu-title">Pequeños bocados,<br /><em>grandes viajes.</em></h2>
					</div>
					<p>Una guía orientativa de platos que aparecen en el menú publicado para reparto y fuentes gastronómicas. La carta del local puede variar; consulta precios, alérgenos y disponibilidad.</p>
				</div>
				<div class="menu-grid">
					{specialties.map((dish, index) => (
						<article class="menu-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<p class="menu-note">Consulta qué platos se preparan hoy y qué opciones veganas hay disponibles. <a href={phoneHref}>Llama al restaurante</a>.</p>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<p class="section-label"><span aria-hidden="true"></span> Pasillo Oriental en imágenes</p>
				<h2 id="gallery-title">Entra por<br /><em>la galería.</em></h2>
				<p class="gallery-copy">El enlace de Maps identifica la ficha pero no proporciona URLs directas a los archivos de foto. Accede a las galerías para ver imágenes auténticas del restaurante y sus platos.</p>
				<div class="gallery-grid">
					<a class="gallery-card" href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Ver ficha y fotos de Pasillo Oriental en Google Maps">
						<span class="gallery-tag">Fotos de la ficha</span><span class="gallery-title">Google Maps <span aria-hidden="true">↗</span></span>
					</a>
					<a class="gallery-card" href={instagramUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos y publicaciones del Instagram oficial de Pasillo Oriental">
						<span class="gallery-tag">Platos y novedades</span><span class="gallery-title">Instagram <span aria-hidden="true">↗</span></span>
					</a>
					<a class="gallery-card" href={facebookUrl} target="_blank" rel="noreferrer" aria-label="Abrir la página de Facebook de Pasillo Oriental">
						<span class="gallery-tag">Página del negocio</span><span class="gallery-title">Facebook <span aria-hidden="true">↗</span></span>
					</a>
				</div>
				<p class="gallery-note">La ilustración de portada y los fondos son gráficos originales, no fotografías del restaurante. Las fotos reales se consultan en las galerías externas.</p>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14003 · Centro de Córdoba</p>
					<h2 id="visit-title">Tu próxima parada<br /><em>en el centro.</em></h2>
					<address>{business.streetAddress}<br />Centro histórico · {business.postalCode}<br />{business.city}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Reservas y consultas</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Indicaciones</small><a href={mapsUrl} target="_blank" rel="noreferrer">Abrir ficha de Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Redes sociales</small><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a> · <a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar para reservar</a>
					</div>
					<p class="menu-note">Los horarios de directorios no coinciden; llama antes de acercarte para confirmar apertura.</p>
				</div>
				<div class="map-card">
					<div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<button type="button" data-cargar-mapa aria-label="Cargar mapa interactivo" style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
							<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
							<strong style="font-size:1rem;">Cargar mapa interactivo</strong>
							<small style="opacity:0.65;">Se carga solo al pulsar</small>
						</button>
<iframe title="Mapa de Pasillo Oriental en Calle Velázquez Bosco, Córdoba" data-src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<div class="map-label"><div><strong>Pasillo Oriental</strong><small>C. Velázquez Bosco · Córdoba</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
			<Galeria nombre="Pasillo Oriental" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="Pasillo Oriental, volver al inicio">
				<span class="brand-mark" aria-hidden="true">P</span><span class="brand-copy">Pasillo Oriental <small>Cocina de Oriente · Córdoba</small></span>
			</a>
			<nav class="footer-nav" aria-label="Redes y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Pasillo Oriental · Córdoba. Consulta horarios, menú y alérgenos con el restaurante.</small>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar para reservar <span>957 94 10 17</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>

<script>
// mapa-fachada: la URL del iframe vive en data-src y solo se asigna al pulsar (ahorra ~1MB de JS).
document.addEventListener('click', function (e) {
	var t = e.target && e.target.closest ? e.target.closest('[data-cargar-mapa]') : null;
	if (!t) return;
	var w = t.closest('[data-mapa-fachada]');
	if (!w || w.dataset.cargado) return;
	var f = w.querySelector('iframe');
	if (!f || !f.dataset.src || f.getAttribute('src')) return;
	w.dataset.cargado = '1';
	f.setAttribute('src', f.dataset.src);
	t.remove();
});
</script>
