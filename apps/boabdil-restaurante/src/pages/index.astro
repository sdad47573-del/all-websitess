---
const business = {
	name: 'Boabdil Restaurante',
	street: 'Calle Hospital de los Peregrinos, 2',
	city: 'Granada',
	region: 'Granada',
	postalCode: '18010',
	country: 'ES',
	phone: '+34 958 22 81 36',
	latitude: 37.1774954,
	longitude: -3.597074,
	site: 'https://boabdil-restaurante-granada.vercel.app',
};

const mapsUrl = 'https://www.google.com/maps/place/Boabdil+Restaurante/@37.1774954,-3.597074,17z/data=!3m1!4b1!4m6!3m5!1s0xd71fcbf487ce643:0xf3b6f6278b359e42!8m2!3d37.1774954!4d-3.597074!16s%2Fg%2F1vzv4_zn?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34958228136';
const siteUrl = `${business.site}/`;
const description = 'Boabdil Restaurante en Granada, junto a la calle Elvira y Plaza Nueva. Tapas y cocina española tradicional en Calle Hospital de los Peregrinos, 2. Consulta ubicación, teléfono y fotos de Google Maps.';

const faqs = [
	{
		question: '¿Dónde está Boabdil Restaurante?',
		answer: 'Boabdil Restaurante se encuentra en Calle Hospital de los Peregrinos, 2, 18010 Granada, en el entorno de la calle Elvira y el Albaicín. Abre las indicaciones de Google Maps para consultar el trayecto.',
	},
	{
		question: '¿Cuál es el teléfono de Boabdil?',
		answer: 'El teléfono publicado para Boabdil Restaurante es el 958 22 81 36. Llama directamente para consultar reservas, disponibilidad y horario actualizado.',
	},
	{
		question: '¿Qué tipo de comida sirven?',
		answer: 'Las fuentes públicas describen Boabdil como un bar de tapas y restaurante de cocina española tradicional, con tapas y platos para compartir. La oferta y la carta pueden cambiar; consúltalas directamente con el establecimiento.',
	},
	{
		question: '¿Cuál es el horario de apertura?',
		answer: 'Los horarios publicados en directorios no coinciden. Llama al 958 22 81 36 o revisa la ficha de Google Maps antes de ir para confirmar la apertura del día.',
	},
	{
		question: '¿Dónde puedo ver fotos del restaurante?',
		answer: 'En esta página puedes abrir la ficha de Boabdil en Google Maps para ver sus fotos y consultar la información y reseñas publicadas allí.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${siteUrl}#restaurant`,
	name: business.name,
	description,
	url: siteUrl,
	telephone: business.phone,
	servesCuisine: ['Española', 'Tapas', 'Tradicional'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: business.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

import { Image } from 'astro:assets';
import Galeria from '../components/Galeria.astro';
import heroImage from '../assets/fotos/boabdil-restaurante-apaisada-01.jpg';---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#452c22" />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" />
		<title>Boabdil Restaurante en Granada | Tapas en el Albaicín</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Boabdil Restaurante · Tapas y cocina tradicional en Granada" />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${business.site}/og.svg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Boabdil Restaurante en el centro histórico de Granada" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.region" content="ES-GR" />
		<meta name="geo.placename" content="Granada" />
		<meta name="geo.position" content="37.1774954;-3.597074" />
		<meta name="ICBM" content="37.1774954, -3.597074" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Boabdil Restaurante, inicio"><span class="brand-mark" aria-hidden="true">B</span><span>Boabdil<small>Restaurante · Granada</small></span></a>
			<nav aria-label="Navegación principal"><a href="#restaurante">El restaurante</a><a href="#fotos">Fotos</a><a href="#visita">Cómo llegar</a></nav>
			<a class="header-call" href={phoneHref}>Llamar · 958 22 81 36</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span>Centro histórico · Granada</span><i aria-hidden="true"></i> Junto a calle Elvira</p>
					<h1>Granada se<br />saborea <em>de tapa.</em></h1>
					<p class="lede">Boabdil es un restaurante de tapas en el corazón de Granada. Cocina española tradicional, platos para compartir y una ubicación céntrica en la calle Hospital de los Peregrinos, a un paso de los rincones históricos de la ciudad.</p>
					<div class="actions"><a class="button button-gold" href={phoneHref}>Llamar al restaurante <span aria-hidden="true">↗</span></a><a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-details"><span>⌖ Hospital de los Peregrinos, 2</span><span>✦ Tapas · cocina española tradicional</span></div>
				</div>
				<figure class="hero-photo">
					<Image src={heroImage} alt="Fotografía de Boabdil Restaurante en Granada, publicada en su ficha de Google Maps" widths={[640, 960, 1280]} sizes="(max-width: 720px) 100vw, 47vw" format="avif" quality={70} loading="eager" fetchpriority="high" decoding="async" />
					<figcaption>Boabdil · Granada</figcaption>
				</figure>
			</section>

			<div class="ticker" aria-label="Boabdil Restaurante en Granada"><span>Boabdil Restaurante</span><b>✳</b><span>Tapas españolas</span><b>✳</b><span>Granada centro</span><b>✳</b><span>Cocina tradicional</span></div>

			<section class="intro section-wrap" id="restaurante"><div><p class="eyebrow eyebrow-dark">Una parada en el centro granadino</p><h2>Tapas y mesa<br /><em>con historia.</em></h2></div><div class="intro-copy"><p>Boabdil Restaurante está en Calle Hospital de los Peregrinos, cerca de la animada calle Elvira y del centro histórico de Granada. Las guías locales lo describen como un bar familiar de tapas y cocina española tradicional, con opciones para compartir.</p><p>¿Vas a acercarte? Llama para comprobar disponibilidad, horario y carta. La información puede variar según el día.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Consultar la ficha y reseñas en Google Maps ↗</a></div></section>

			<section class="specialties section-wrap" aria-labelledby="specialties-title"><div class="section-heading"><p class="eyebrow eyebrow-dark">El plan: pedir al centro</p><h2 id="specialties-title">Una mesa para<br /><em>abrir el apetito.</em></h2><p>Una forma sencilla de disfrutar de la cocina española en el centro. Consulta la selección y disponibilidad directamente con Boabdil.</p></div>
				<div class="special-grid">
					<article class="special-card"><span class="special-icon" aria-hidden="true">❋</span><span class="card-kicker">PARA EMPEZAR</span><h3>Tapas españolas</h3><p>Variedad de tapas tradicionales para acompañar la comida y compartir.</p></article>
					<article class="special-card card-olive"><span class="special-icon" aria-hidden="true">◉</span><span class="card-kicker">AL CENTRO</span><h3>Platos para compartir</h3><p>Raciones y platos para disfrutar en compañía. Pregunta por las opciones de hoy.</p></article>
					<article class="special-card card-terracotta"><span class="special-icon" aria-hidden="true">♨</span><span class="card-kicker">COCINA DE SIEMPRE</span><h3>Sabor tradicional</h3><p>Cocina española en un restaurante familiar del casco histórico granadino.</p></article>
				</div><p class="menu-note">Esta descripción se basa en guías públicas del establecimiento; no sustituye a la carta vigente. Consulta platos, alérgenos y precios directamente con el restaurante.</p>
			</section>

			<section class="photo-section" id="fotos"><div class="photo-copy"><p class="eyebrow">Boabdil en Google Maps</p><h2>Abre la ficha.<br />Mira sus <em>fotos.</em></h2><p>Descubre las imágenes del restaurante en Google Maps y consulta las reseñas y datos publicados por el establecimiento y sus visitantes.</p><a class="button button-gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a><p class="photo-note">Las fotos se consultan en Maps y no se copian ni alojan en esta web.</p></div>
				<div class="map-photo"><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Google de Boabdil Restaurante, Calle Hospital de los Peregrinos, Granada" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
					<noscript>
						<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
					</noscript>
				</div><a class="map-caption" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">⌖</span><span><b>Boabdil Restaurante</b><small>Hospital de los Peregrinos, 2 · Ver ficha y fotos ↗</small></span></a></div>
			</section>

			<section class="visit section-wrap" id="visita"><div class="visit-copy"><p class="eyebrow eyebrow-dark">En el corazón de Granada</p><h2>Nos encontramos<br /><em>en Boabdil.</em></h2><p>El restaurante está en una calle céntrica, junto a calle Elvira. Abre indicaciones para calcular la ruta y llama si necesitas confirmar el horario o reservar.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button button-dark" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Llamar · 958 22 81 36</a></div></div>
				<div class="visit-card"><div class="visit-title"><span class="visit-icon" aria-hidden="true">⌖</span><div><p class="eyebrow eyebrow-dark">Ubicación y contacto</p><h3>Granada centro</h3></div></div><dl><div><dt>Dirección</dt><dd>Calle Hospital de los Peregrinos, 2<br />18010 Granada</dd></div><div><dt>Teléfono</dt><dd><a href={phoneHref}>958 22 81 36</a></dd></div><div><dt>Horario</dt><dd>Consulta la ficha o<br />confirma por teléfono</dd></div></dl><p class="visit-note">Los directorios consultados publican horarios distintos. Llama antes de ir para confirmar la apertura.</p><a class="visit-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Abrir ficha de Google Maps ↗</a></div>
			</section>

			<section class="faq-section section-wrap" id="preguntas"><p class="eyebrow eyebrow-dark">Preguntas frecuentes</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
			<Galeria nombre="Boabdil Restaurante" mapsUrl={mapsUrl} />
		</main>

		<footer class="footer"><div class="footer-top"><a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">B</span><span>Boabdil<small>Restaurante · Granada</small></span></a><p>Tapas de siempre<br />en el centro.</p><nav aria-label="Enlaces de Boabdil Restaurante"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={phoneHref}>958 22 81 36</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Boabdil Restaurante · Granada</span><a href="/aviso-legal/">Aviso legal y privacidad</a><span>Confirma horario, carta y disponibilidad con el establecimiento.</span></div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar <span>958 22 81 36</span></a>
	</body>
</html>

<style is:global>
	:root{font-family:'DM Sans',sans-serif;color:#382d28;background:#f8f3e9;font-synthesis:none;text-rendering:optimizeLegibility;--wine:#452c22;--wine-light:#704638;--gold:#d4ad69;--cream:#f8f3e9;--ink:#382d28;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid #d4ad69;outline-offset:4px}.skip-link{position:absolute;z-index:99;top:-60px;left:16px;padding:12px 16px;background:var(--gold);color:var(--wine)}.skip-link:focus{top:12px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:22px;background:var(--wine);color:#fcf8ef}.brand{display:flex;align-items:center;gap:11px;font-size:15px;font-weight:700}.brand small{display:block;margin-top:4px;color:#e1d4c5;font-size:9px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--gold);border-radius:50%;color:#e5c98c;font:700 23px var(--display)}.topbar nav{display:flex;gap:clamp(14px,2.5vw,32px);color:#f0e6dc;font-size:12px}.topbar nav a:hover,.footer a:hover{color:#e5c98c}.header-call{padding:11px 17px;border:1px solid #ffffff55;border-radius:99px;font-size:11px;font-weight:700}.hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:560px;background:var(--wine);color:#fcf8ef;overflow:hidden}.hero-copy{padding:73px 4vw 64px 9vw;align-self:center}.eyebrow{margin:0 0 19px;color:#e0c78c;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase}.eyebrow i{display:inline-block;width:22px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.section-heading h2,.photo-copy h2,.visit h2,.faq-section h2{margin:0;font:600 clamp(39px,4.8vw,64px)/1.08 var(--display);letter-spacing:-1.2px}.hero h1 em,.intro h2 em,.section-heading h2 em,.photo-copy h2 em,.visit h2 em,.faq-section h2 em{color:var(--gold);font-style:italic}.lede{max-width:475px;margin:24px 0 0;color:#e9ded3;font-size:14px;line-height:1.85}.actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:27px}.button{display:inline-flex;min-height:47px;align-items:center;justify-content:center;gap:14px;padding:0 20px;border-radius:99px;font-size:12px;font-weight:700;transition:transform .18s ease}.button:hover{transform:translateY(-2px)}.button-gold{background:var(--gold);color:var(--wine)}.button-outline{border:1px solid #ffffff65;color:#fcf8ef}.hero-details{display:flex;flex-wrap:wrap;gap:12px 22px;margin-top:27px;padding-top:20px;border-top:1px solid #ffffff2a;color:#e1d3c5;font-size:10px}.hero-details span:first-child{color:#e8cc91}.hero-photo{position:relative;margin:0;min-height:560px;overflow:hidden;background:#2c1e17}.hero-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-photo figcaption{position:absolute;right:12px;bottom:12px;padding:8px 14px;border-radius:99px;background:#000000aa;color:#fcf8ef;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase}.ticker{display:flex;min-height:54px;align-items:center;justify-content:center;gap:clamp(12px,4vw,52px);padding:10px 5vw;background:var(--gold);color:var(--wine);font:600 13px var(--display)}.ticker b{font-size:12px}.section-wrap{padding:88px 9vw}.intro{display:grid;grid-template-columns:1fr .85fr;gap:9%;align-items:center;background:var(--cream)}.eyebrow-dark{margin-bottom:16px;color:#94764b}.intro h2,.section-heading h2,.visit h2,.faq-section h2{font-size:clamp(34px,4vw,50px);color:var(--wine)}.intro h2 em,.section-heading h2 em,.visit h2 em,.faq-section h2 em{color:#a26a4d}.intro-copy p,.section-heading>p,.visit-copy>p:not(.eyebrow){color:#716760;font-size:14px;line-height:1.85}.intro-copy p{margin:0 0 14px}.text-link{display:inline-block;padding-bottom:4px;border-bottom:1px solid #a26a4d;color:#543b30;font-size:12px;font-weight:700}.specialt