---
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	facebookPhotosUrl,
	facebookUrl,
	faqSchema,
	faqs,
	instagramUrl,
	mapEmbedUrl,
	mapsPhotosUrl,
	mapsUrl,
	openingNotes,
	phoneHref,
	restaurantSchema,
	specialties,
	tripadvisorUrl,
} from '../lib/business';

const title = 'Restaurante Brasería JM | Carnes a la brasa en San Sebastián de los Ballesteros';
const description =
	'Brasería JM en San Sebastián de los Ballesteros, Córdoba: carnes al horno de brasa, pescados de lonja y arroces en C. Nuevas Poblaciones. Terraza y comida para llevar. Reservas: 957 30 90 39.';
const keywords =
	'Brasería JM, Restaurante JM San Sebastián de los Ballesteros, carnes a la brasa Córdoba, comer en la Campiña Sur, restaurante San Sebastián de los Ballesteros, solomillo ibérico, arroz caldoso de marisco, Calle Nuevas Poblaciones, reservar brasería Córdoba';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1d1a17" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="San Sebastián de los Ballesteros, Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración original de una parrilla para Brasería JM; no es una fotografía del restaurante" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante Brasería JM, inicio">
				<span class="brand-mark" aria-hidden="true">JM</span>
				<span class="brand-copy">Brasería JM <small>Brasa y producto · Córdoba</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#brasa">La brasa</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 957 30 90 39</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Campiña Sur · San Sebastián de los Ballesteros</p>
					<h1 id="hero-title">El sabor de<br /><em>la brasa viva.</em></h1>
					<p class="hero-intro">En la Brasería JM, Joaquín y María José reciben en el centro del pueblo con carnes al horno de brasa, pescado fresco de lonja andaluza y producto de kilómetro cero. Una mesa de pueblo con cocina de gran restaurante.</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Reservar mesa <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Nos encontrarás en</small><address>{business.streetAddress}<br />{business.postalCode} · Córdoba</address></div>
						<div><small>Reservas</small><a href={phoneHref}>{business.phone}</a><br /><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración original de una parrilla encendida; no es una fotografía del restaurante">
					<span class="spark spark-1" aria-hidden="true"></span>
					<span class="spark spark-2" aria-hidden="true"></span>
					<div class="grill" aria-hidden="true">
						<span class="ember-glow"></span>
						<span class="grate"></span>
						<span class="steak"></span>
					</div>
					<div class="art-caption"><strong>Horno de brasa</strong>Carne · pescado · temporada</div>
				</div>
			</section>

			<div class="promise" aria-label="Información del Restaurante Brasería JM">
				<span>Horno de brasa</span><span>Producto de proximidad</span><span>Terraza exterior</span><span>Comida para llevar</span>
			</div>

			<section class="section intro" id="casa" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Restaurante en la Campiña Sur</p>
					<h2 id="intro-title">Cocina de pueblo,<br /><em>nivel de ciudad.</em></h2>
				</div>
				<div class="intro-copy">
					<p>En Calle Nuevas Poblaciones, el JM se ha convertido en uno de los atractivos gastronómicos de San Sebastián de los Ballesteros. Hasta aquí llegan comensales de la comarca y de localidades cercanas como Écija para sentarse a su mesa.</p>
					<p>El cocinero Joaquín Ansio trabaja con verdura de temporada, carnes del Valle de los Pedroches y pescado de las principales lonjas andaluzas. En sala, María José y su equipo cuidan un servicio cercano, con comedor amplio, barra y terraza.</p>
					<p class="source-note">Datos recogidos de la ficha de Google Maps, de los perfiles oficiales del restaurante, de la prensa gastronómica y de directorios. La carta y el horario cambian con la temporada: confírmalos antes de tu visita.</p>
				</div>
			</section>

			<section class="section brasa" id="brasa" aria-labelledby="brasa-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> De la brasa a la mesa</p>
						<h2 id="brasa-title">Platos de<br /><em>fuego lento.</em></h2>
					</div>
					<p>Una selección orientativa de las especialidades que mencionan la casa, la clientela y las guías gastronómicas. No sustituye la carta vigente.</p>
				</div>
				<div class="brasa-grid">
					{specialties.map((dish, index) => (
						<article class="brasa-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<div class="brasa-extra">
					<p><strong>Bodega:</strong> el Ribera del Duero de la casa, fino cordobés y una carta pensada para acompañar carnes y pescados.</p>
					<p><strong>Postres:</strong> tarta de queso, brownie casero o tarta de zanahoria, según temporada.</p>
					<p class="menu-note">¿Vienes en grupo o quieres arroz? Avísalo con tiempo al reservar. <a href={phoneHref}>Llama al restaurante</a>.</p>
				</div>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<div class="gallery-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Imágenes del restaurante</p>
						<h2 id="gallery-title">El JM,<br /><em>en fotos.</em></h2>
					</div>
					<p>Consulta fotos reales del local, de los platos y de la terraza en la ficha de Google Maps y en los perfiles oficiales del restaurante.</p>
				</div>
				<div class="gallery-grid">
					<a class="photo-card" href={mapsPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Restaurante Brasería JM en Google Maps">
						<span class="photo-label">Fotos de la ficha</span><span class="photo-title">Google Maps <span aria-hidden="true">↗</span></span>
					</a>
					<a class="photo-card alt" href={instagramUrl} target="_blank" rel="noreferrer" aria-label="Ver el Instagram oficial de Restaurante Brasería JM">
						<span class="photo-label">Perfil oficial</span><span class="photo-title">Instagram <span aria-hidden="true">↗</span></span>
					</a>
					<a class="photo-card alt2" href={facebookPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Restaurante Brasería JM en Facebook">
						<span class="photo-label">Álbum del negocio</span><span class="photo-title">Facebook <span aria-hidden="true">↗</span></span>
					</a>
				</div>
				<p class="gallery-note">El enlace de Google Maps identifica la ficha, pero no expone URLs directas a los archivos de imagen, por lo que las fotos se consultan en las galerías enlazadas. Las ilustraciones de esta web son gráficos originales, no fotografías del restaurante.</p>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14150 · Córdoba</p>
					<h2 id="visit-title">Te esperamos<br /><em>en el JM.</em></h2>
					<address>{business.streetAddress}<br />{business.postalCode} {business.locality}<br />{business.province}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Reservas y consultas</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Ubicación</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Redes sociales</small><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a> · <a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a> · <a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar y reservar</a>
					</div>
					<p class="hours-note">El horario cambia entre invierno y verano y en fechas festivas. Llama antes de desplazarte para confirmarlo.</p>
				</div>
				<div class="visit-side">
					<div class="hours-card">
						<h3>Horario orientativo</h3>
						<ul>
							{openingNotes.map((note) => (
								<li><span>{note.label}</span><strong>{note.detail}</strong></li>
							))}
						</ul>
					</div>
					<div class="map-card">
						<iframe title="Mapa de Restaurante Brasería JM en Calle Nuevas Poblaciones, San Sebastián de los Ballesteros" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<div class="map-label"><div><strong>Restaurante Brasería JM</strong><small>C. Nuevas Poblaciones · San Sebastián de los Ballesteros</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
			<Galeria nombre="Restaurante Brasería JM" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="Restaurante Brasería JM, volver al inicio">
				<span class="brand-mark" aria-hidden="true">JM</span><span class="brand-copy">Brasería JM <small>Brasa y producto · Córdoba</small></span>
			</a>
			<nav class="footer-nav" aria-label="Redes y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Restaurante Brasería JM · San Sebastián de los Ballesteros, Córdoba. Consulta horarios, carta y alérgenos directamente con el restaurante.</small>
		</footer>
		<a class="mobile-call" href={phoneHref}>Reservar en Brasería JM <span>957 30 90 39</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>
