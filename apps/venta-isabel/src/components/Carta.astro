---
import { BUSINESS, CARTA, VENTAJAS } from '../data/site';
---

<section id="carta" class="carta-venta relative overflow-hidden py-20 text-white sm:py-24">
	<div class="brasa-venta absolute inset-0 opacity-60" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
			<div>
				<p class="text-accent text-xs font-semibold tracking-[0.22em] uppercase">La carta</p>
				<h2 class="font-display mt-3 text-4xl leading-tight font-semibold sm:text-5xl">
					De la parrilla a la mesa
				</h2>
				<p class="mt-4 max-w-xl leading-relaxed text-white/70">
					Lo que la casa cocina y lo que más se repite en las reseñas. La carta cambia con la
					temporada: pregunta qué hay hoy al sentarte.
				</p>
			</div>
			<a href={BUSINESS.phoneHref} class="btn btn-secondary shrink-0 gap-2 rounded-full">
				<i class="ri-phone-line"></i> Reservar por teléfono
			</a>
		</div>

		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{CARTA.map((plato, index) => (
				<article class="relative flex flex-col rounded-2xl border border-white/15 bg-white/5 p-6">
					<span class="font-display text-accent/40 text-4xl leading-none">
						{String(index + 1).padStart(2, '0')}
					</span>
					<p class="text-accent mt-4 text-[0.65rem] font-bold tracking-[0.18em] uppercase">
						{plato.kicker}
					</p>
					<h3 class="font-display mt-1 text-2xl leading-tight">{plato.title}</h3>
					<p class="mt-2 flex-1 text-sm leading-relaxed text-white/65">{plato.text}</p>
					<span class="text-accent mt-5 inline-flex size-9 items-center justify-center rounded-full border border-white/20">
						<i class={`${plato.icon} text-lg`} />
					</span>
				</article>
			))}
		</div>

		<div
			class="relative mt-6 grid gap-6 rounded-2xl border border-white/15 bg-white/5 px-6 py-7 sm:px-8 lg:grid-cols-[1fr_auto] lg:items-center"
		>
			<div>
				<h3 class="font-display text-2xl">Carta y precios, en la mesa</h3>
				<p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/65">
					Esta web no publica importes sin confirmar. El menú del día, las hamburguesas, la comida
					para llevar y la disponibilidad se consultan llamando al {BUSINESS.phone}.
				</p>
			</div>
			<div class="flex flex-wrap gap-2">
				{VENTAJAS.map((v) => (
					<span class="badge gap-1.5 rounded-full border-white/20 bg-white/10 px-3 py-3 text-xs text-white">
						<i class={`${v.icon} text-accent`} /> {v.title}
					</span>
				))}
			</div>
		</div>
	</div>
</section>
