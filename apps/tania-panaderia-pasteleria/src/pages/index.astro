---
import '../styles/global.css';
import {
	LocalAbout,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/tania-panaderia-pasteleria-apaisada-01.jpg';
import vitrinaDulces from '../assets/fotos/tania-panaderia-pasteleria-apaisada-02.jpg';
import mostrador from '../assets/fotos/tania-panaderia-pasteleria-apaisada-03.jpg';
import charcuteria from '../assets/fotos/tania-panaderia-pasteleria-apaisada-04.jpg';
import esquina from '../assets/fotos/tania-panaderia-pasteleria-apaisada-05.jpg';
import rotulo from '../assets/fotos/tania-panaderia-pasteleria-apaisada-07.jpg';
import vitrinaTartas from '../assets/fotos/tania-panaderia-pasteleria-apaisada-08.jpg';
import estanteria from '../assets/fotos/tania-panaderia-pasteleria-apaisada-09.jpg';
import bandeja from '../assets/fotos/tania-panaderia-pasteleria-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	REVIEWS,
} from '../data/site';

const title = 'Tania Panadería Pastelería · Bailén-Miraflores, Málaga';
const description =
	'Panadería y pastelería Tania, en C. Poeta Ximénez Molina, 10 (Bailén-Miraflores, 29010 Málaga). Pan integral 100%, blanco y de soja hecho a mano, dulces, tartas por encargo y charcutería. 4,6/5 en Google.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#tania`,
	name: BUSINESS.name,
	alternateName: ['Panadería Tania', 'Pastelería Tania', 'Tania Málaga'],
	description:
		'Panadería y pastelería en C. Poeta Ximénez Molina, 10 (Bailén-Miraflores, 29010 Málaga). Pan integral 100%, blanco y de soja elaborado a mano, dulces, tartas por encargo, alimentación, bebidas y charcutería al corte.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34666929595',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:15',
			closes: '14:45',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '17:30',
			closes: '21:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '08:15',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '17:30',
			closes: '21:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '08:15',
			closes: '15:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El obrador', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const galeria = [
	{ src: fachada, alt: 'Fachada de la panadería Tania en la calle Poeta Ximénez Molina, con el rótulo PANADERIA TANIA sobre la puerta' },
	{ src: vitrinaDulces, alt: 'Vitrina de la pastelería con bandejas de galletas, pastas y dulces' },
	{ src: mostrador, alt: 'Mostrador con cestas de pan y bandejas de bollería con chocolate' },
	{ src: charcuteria, alt: 'Vitrina refrigerada con charcutería, quesos, lácteos y conservas' },
	{ src: esquina, alt: 'Esquina del local con los rótulos Panadería Pastelería Tania' },
	{ src: rotulo, alt: 'Rótulo de Panadería Pastelería Tania con el logo de la cesta de pan' },
	{ src: vitrinaTartas, alt: 'Vitrina con tartas, donuts, bollería y dulces variados' },
	{ src: estanteria, alt: 'Estantería con panes en bolsa y bandejas de pastas y galletas' },
	{ src: bandeja, alt: 'Bandeja de panes recién hechos en el obrador' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#5b1f2a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Work+Sans:ital,wght@0,300..600;1,300..500&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Tania Panadería Pastelería, panadería Málaga, pastelería Bailén-Miraflores, pan integral Málaga, tartas por encargo Málaga, panadería Poeta Ximénez Molina, charcutería 29010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan integral 100%, blanco y de soja hecho a mano, dulces, tartas por encargo y charcutería al corte en Bailén-Miraflores. 4,6 sobre 5 con 75 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Tania Panadería Pastelería en la calle Poeta Ximénez Molina, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#5b1f2a"
			phone="+34666929595"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Tania"
			subtitle="Panadería · Pastelería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Poeta Ximénez Molina, 10 · Bailén-Miraflores"
				title="Pan hecho a mano, <br /><em>dulces de barrio.</em>"
				lede={`Tania está en la calle Poeta Ximénez Molina, 10, en Bailén-Miraflores. Pan integral 100%, blanco y de soja —este solo lunes y jueves— elaborado a mano, dulces, tartas por encargo y una despensa con charcutería al corte. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={fachada}
				imageAlt="Fachada de la panadería Tania con el rótulo PANADERIA TANIA y la puerta abierta"
				primaryCta={{ label: 'Llamar al obrador · 666 92 95 95', href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> en Google · 75 reseñas' },
					{ label: 'Horario', html: '<b>Dos turnos</b> · mañana y tarde' },
					{ label: 'Teléfono', html: '<b>666 92 95 95</b> · encargos' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Fotos de la ficha de Google Maps"
				galleryLinkLabel="Ver todas las fotos"
				tag="L–V desde las 7:15"
			/>

			<section class="ticker" aria-label="Lo que hay en Tania">
				<div class="wrap ticker-inner">
					<span>Pan integral 100%</span>
					<span aria-hidden="true">·</span>
					<span>Pan de soja, lunes y jueves</span>
					<span aria-hidden="true">·</span>
					<span>Tartas por encargo</span>
					<span aria-hidden="true">·</span>
					<span>Charcutería al corte</span>
				</div>
			</section>

			<LocalAbout
				label="El obrador"
				title="Lo que se hace <br /><em>cada mañana.</em>"
				paragraphs={[
					'La panadería y confitería Tania está en la calle Poeta Ximénez Molina, 10, en Bailén-Miraflores. Es un local de barrio con obrador propio y una despensa al lado del mostrador.',
					'Según la descripción que el propio negocio publica en Google, el pan integral 100% y el pan blanco se elaboran a diario a mano; el de soja se hace solo lunes y jueves, así que conviene ir esos días si se busca.',
					'La casa anuncia también variedad de dulces y tartas por encargo al gusto. Para una tarta, lo directo es llamar al obrador y concretar el tipo y el día de recogida.',
					'Completan el local la alimentación, las bebidas y la charcutería al corte. Abre en dos turnos: por la mañana desde las 7:15 y, de lunes a sábado, también por la tarde desde las 17:30. El domingo solo hay turno de mañana.',
				]}
				note="4,6 sobre 5 con 75 reseñas en Google. Las tres reseñas citadas en esta página están publicadas en la ficha; la media incluye opiniones de todo tipo."
				links={[
					{ label: 'Llamar al obrador', href: BUSINESS.phoneHref },
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
				]}
			/>

			<section class="craft section-pad" aria-labelledby="craft-title">
				<div class="wrap">
					<div class="craft-head">
						<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas de la casa</p>
						<h2 id="craft-title">Pan, dulces <br /><em>y despensa.</em></h2>
					</div>
					<div class="craft-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="craft-card">
									<span class="craft-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que hay <br /><em>en la vitrina.</em>"
				description="Sin carta cerrada ni precios publicados: esto es lo que el negocio describe en su ficha y lo que las reseñas destacan. Para encargos, llama al obrador."
				cta={{ label: 'Llamar · 666 92 95 95', href: BUSINESS.phoneHref }}
				groups={MENU_GROUPS}
				note="La disponibilidad puede cambiar según el día. El pan de soja solo se elabora lunes y jueves. Las tartas se encargan por teléfono; esta web no publica importes porque la ficha no los recoge."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La casa, <br /><em>por dentro.</em>"
				description="Nueve fotos de la ficha de Google Maps: la fachada, las vitrinas de dulces, el mostrador, la charcutería y el pan recién hecho."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="reviews-title">
				<div class="wrap">
					<div class="reviews-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Lo que dicen</p>
							<h2 id="reviews-title">Tres reseñas <br /><em>de la ficha.</em></h2>
						</div>
						<p>
							La media es 4,6 sobre 5 con 75 reseñas. Estas tres están publicadas en
							Google; el resto se puede leer en la ficha.
						</p>
					</div>
					<div class="review-grid">
						{
							REVIEWS.map((review) => (
								<figure class="review-card">
									<span class="stars" role="img" aria-label={`${review.rating} de 5 estrellas`}>
										{'★'.repeat(review.rating)}
										<span class="stars-empty">{'★'.repeat(5 - review.rating)}</span>
									</span>
									<blockquote>{review.text}</blockquote>
									<figcaption>{review.author}</figcaption>
								</figure>
							))
						}
					</div>
					<a class="reviews-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
						Leer las 75 reseñas en Google ↗
					</a>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Bailén-Miraflores, <br /><em>mañana y tarde.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de Tania Panadería Pastelería en la calle Poeta Ximénez Molina, 10, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Tania · Bailén-Miraflores"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar al obrador', href: BUSINESS.phoneHref },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: '666 92 95 95', href: BUSINESS.phoneHref }}
				reserveNote="Para tartas y encargos, llama al obrador. La ficha indica acceso para sillas de ruedas; no publica información sobre aparcamiento adaptado."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y disponibilidad pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar a Tania"
			navAriaLabel="Enlaces de Tania Panadería Pastelería"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
