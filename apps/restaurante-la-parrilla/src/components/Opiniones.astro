---
import { BUSINESS, REVIEWS } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
---

<section id="opiniones" class="bg-base-200 border-base-300 border-y py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
			<div>
				<p class="text-secondary text-xs font-semibold tracking-[0.22em] uppercase">Opiniones</p>
				<h2 class="font-display mt-3 text-4xl leading-tight sm:text-5xl">Lo que dicen en Google</h2>
				<p class="text-base-content/65 mt-4 max-w-xl text-sm leading-relaxed">
					{BUSINESS.reviewCount} reseñas y una media de{' '}
					{BUSINESS.rating.toString().replace('.', ',')}
					estrellas. El cochinillo, el pulpo y el trato son lo que más se repite.
				</p>
			</div>

			<div class="border-base-300 bg-base-100 flex items-center gap-4 rounded-2xl border px-5 py-4">
				<span class="font-display text-5xl leading-none">
					{BUSINESS.rating.toString().replace('.', ',')}
				</span>
				<div>
					<div class="text-secondary text-base tracking-tight" aria-hidden="true">
						{estrellas.map((n) => (
							<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
						))}
					</div>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="text-base-content/60 hover:text-secondary mt-1 block text-xs underline underline-offset-2"
					>
						Ver las {BUSINESS.reviewCount} reseñas en Google
					</a>
				</div>
			</div>
		</div>

		<div class="mt-10 grid gap-4 md:grid-cols-3">
			{REVIEWS.map((resena) => (
				<blockquote class="border-base-300 bg-base-100 flex flex-col rounded-2xl border p-6">
					<div
						class="text-secondary text-sm tracking-tight"
						aria-label={`${resena.rating} de 5 estrellas`}
					>
						{Array.from({ length: resena.rating }).map(() => (
							<i class="ri-star-fill" />
						))}
					</div>
					<p class="mt-3 flex-1 text-sm leading-relaxed">«{resena.text}»</p>
					<footer class="mt-4 flex items-center gap-3">
						<span class="bg-primary text-primary-content flex size-8 items-center justify-center rounded-full text-xs font-bold">
							G
						</span>
						<span class="text-xs font-semibold">{resena.author}</span>
						<span class="text-base-content/45 ml-auto text-[0.65rem]">Google</span>
					</footer>
				</blockquote>
			))}
		</div>

		<p class="text-base-content/45 mt-5 text-xs">
			Valoración de la ficha de Google en octubre de 2026.
		</p>
	</div>
</section>
