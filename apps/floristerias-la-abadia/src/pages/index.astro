---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const business = {
	name: 'Floristerías La Abadia',
	city: 'Málaga',
	latitude: 36.7064268,
	longitude: -4.4368917,
	site: 'https://floristerias-la-abadia.vercel.app',
};
const mapsUrl =
	'https://www.google.com/maps/place/Florister%C3%ADas+La+Abadia/@36.7064268,-4.4368917,17z/data=!3m1!4b1!4m6!3m5!1s0xd72f78234dbb53b:0x32cffc99c455df58!8m2!3d36.7064268!4d-4.4368917!16s%2Fg%2F11bbx0kqn4';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const photos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const manifest = import.meta.glob<{ default: Record<string, { file: string; author?: string }> }>(
	'../assets/fotos/.maps-manifest.json',
	{ eager: true, import: 'default' },
);
const photoCredits = Object.values(manifest)[0] ?? {};
const gallery = Object.entries(photos)
	.map(([path, image]) => {
		const filename = path.split('/').at(-1) ?? '';
		const entry = Object.values(photoCredits).find((photo) => photo.file === filename);
		return {
			image: image.default,
			filename,
			author: entry?.author?.trim() || 'Autoría no indicada en Google Maps',
		};
	})
	.sort((a, b) => a.filename.localeCompare(b.filename));
const heroPhoto =
	gallery.find(({ filename }) => /apaisada|panoramica/i.test(filename)) ?? gallery[0];
const title = 'Floristerías La Abadia | Floristería en Málaga';
const description =
	'Floristerías La Abadia, floristería en Málaga. Consulta su ubicación, explora fotografías y visita la ficha del establecimiento en Google Maps.';
const schema = {
	'@context': 'https://schema.org',
	'@type': 'Florist',
	name: business.name,
	url: `${business.site}/`,
	image: gallery.slice(0, 4).map(({ image }) => new URL(image.src, business.site).toString()),
	address: { '@type': 'PostalAddress', addressLocality: business.city, addressCountry: 'ES' },
	geo: { '@type': 'GeoCoordinates', latitude: business.latitude, longitude: business.longitude },
	hasMap: mapsUrl,
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#20352b" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:image:alt" content={`Fotografías de ${business.name} en Málaga`} />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		{heroPhoto && (
			<meta property="og:image" content={new URL(heroPhoto.image.src, business.site).toString()} />
		)}
		<meta name="twitter:card" content={heroPhoto ? 'summary_large_image' : 'summary'} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">
					✳
				</span>
				<span>
					LA ABADIA<small>FLORISTERÍAS · MÁLAGA</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#flores">La floristería</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Ubicación</a>
			</nav>
			<a class="nav-cta" href={directionsUrl} target="_blank" rel="noopener noreferrer">
				Cómo llegar <span aria-hidden="true">↗</span>
			</a>
		</header>
		<main id="contenido">
			<section class="hero" id="inicio">
				<div class="hero-copy">
					<p class="eyebrow">
						<span></span> FLORES · DETALLES · MOMENTOS
					</p>
					<h1>
						Un detalle que
						<br />
						<em>lo dice todo.</em>
					</h1>
					<p class="hero-lede">
						Descubre Floristerías La Abadia en Málaga. Explora sus fotografías y encuentra la
						ubicación para acercarte a la tienda.
					</p>
					<div class="hero-actions">
						<a
							class="button button-light"
							href={directionsUrl}
							target="_blank"
							rel="noopener noreferrer"
						>
							Encuéntranos <span aria-hidden="true">↗</span>
						</a>
						<a class="text-link" href="#galeria">
							Ver fotografías <span aria-hidden="true">↓</span>
						</a>
					</div>
					<p class="hero-location">
						<span aria-hidden="true">⌖</span> Málaga, Andalucía
					</p>
				</div>
				<div class="hero-visual">
					{heroPhoto ? (
						<figure class="hero-image">
							<Image
								src={heroPhoto.image}
								alt={`Fotografía de ${business.name}, publicada en su ficha de Google Maps`}
								widths={[600, 900, 1200]}
								sizes="(min-width: 900px) 48vw, 100vw"
								quality={82}
								loading="eager"
								fetchpriority="high"
							/>
							<figcaption>
								Una mirada a nuestra floristería <span>✳</span>
							</figcaption>
						</figure>
					) : (
						<div class="hero-placeholder" aria-label="Fotografía de flores">
							<span class="placeholder-flower" aria-hidden="true">
								✿
							</span>
							<p>
								Flores que convierten
								<br />
								cualquier día en especial.
							</p>
							<span class="placeholder-note">FOTOGRAFÍAS DE LA FLORISTERÍA</span>
						</div>
					)}
					<span class="hero-stamp" aria-hidden="true">
						FLORES
						<br />
						CON
						<br />
						CARIÑO
					</span>
				</div>
				<div class="hero-bottom">
					<span>{business.latitude.toFixed(5)}° N</span>
					<span>·</span>
					<span>{Math.abs(business.longitude).toFixed(5)}° O</span>
					<span class="bottom-line"></span>
					<span>HECHO PARA REGALAR</span>
				</div>
			</section>
			<section class="intro section-wrap" id="flores">
				<div class="section-kicker">
					<span>01</span>
					<span class="kicker-line"></span>
					<span>UN LUGAR PARA FLORECER</span>
				</div>
				<div class="intro-grid">
					<h2>
						Las flores hacen
						<br />
						espacio para <em>sentir.</em>
					</h2>
					<div class="intro-body">
						<p>
							Hay regalos que se recuerdan por cómo hacen sentir. Las flores tienen esa forma
							sencilla y preciosa de acompañar, celebrar y decir lo que a veces cuesta poner en
							palabras.
						</p>
						<p>
							Visita Floristerías La Abadia en Málaga y descubre la selección y los detalles
							disponibles en tienda.
						</p>
						<a class="underlined-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">
							Conoce la floristería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>
			<section class="gallery-section" id="galeria">
				<div class="section-wrap gallery-heading">
					<div>
						<div class="section-kicker">
							<span>02</span>
							<span class="kicker-line"></span>
							<span>UN POCO DE INSPIRACIÓN</span>
						</div>
						<h2>
							Flores, formas
							<br />y <em>color.</em>
						</h2>
					</div>
					<p>Fotografías publicadas en la ficha de Google Maps de Floristerías La Abadia.</p>
				</div>
				{gallery.length ? (
					<div class="gallery-grid">
						{gallery.map(({ image, filename, author }, index) => (
							<figure class={`gallery-item gallery-item-${index % 5}`}>
								<Image
									src={image}
									alt={`Fotografía ${index + 1} de ${business.name}, publicada en Google Maps`}
									widths={[360, 600, 900]}
									sizes="(min-width: 1100px) 30vw, (min-width: 700px) 46vw, 92vw"
									quality={78}
									loading="lazy"
								/>
								<figcaption>
									<span>{business.name}</span>
									<small>{author}</small>
								</figcaption>
							</figure>
						))}
					</div>
				) : (
					<div class="gallery-empty section-wrap">
						<span aria-hidden="true">✿</span>
						<p>Pronto compartiremos una selección de fotografías de la floristería.</p>
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							Ver fotos en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				)}
				<p class="gallery-source">
					Imágenes obtenidas de la ficha pública de Google Maps ·{' '}
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ver ficha completa ↗
					</a>
				</p>
			</section>
			<section class="visit section-wrap" id="visitanos">
				<div class="visit-copy">
					<div class="section-kicker">
						<span>03</span>
						<span class="kicker-line"></span>
						<span>TE ESPERAMOS</span>
					</div>
					<h2>
						Encuentra tu
						<br />
						<em>camino a las flores.</em>
					</h2>
					<p>
						Consulta la ubicación y las indicaciones para llegar a Floristerías La Abadia en Málaga.
					</p>
					<a
						class="button button-dark"
						href={directionsUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cómo llegar <span aria-hidden="true">↗</span>
					</a>
					<a class="visit-map-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Abrir ficha de Google Maps
					</a>
				</div>
				<div class="map-card">
					<iframe
						title="Mapa de Floristerías La Abadia en Málaga"
						src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
					<span class="map-caption">MÁLAGA · ANDALUCÍA</span>
				</div>
			</section>
		</main>
		<footer>
			<a class="brand footer-brand" href="#inicio">
				<span class="brand-mark" aria-hidden="true">
					✳
				</span>
				<span>
					LA ABADIA<small>FLORISTERÍAS · MÁLAGA</small>
				</span>
			</a>
			<p>Flores para celebrar lo cotidiano.</p>
			<span>© {new Date().getFullYear()} Floristerías La Abadia</span>
		</footer>
	</body>
</html>
