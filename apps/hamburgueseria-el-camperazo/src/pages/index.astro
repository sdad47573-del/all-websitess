---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/hamburgueseria-el-camperazo-apaisada-01.jpg';
import campero from '../assets/fotos/hamburgueseria-el-camperazo-apaisada-02.jpg';
import patatas from '../assets/fotos/hamburgueseria-el-camperazo-apaisada-03.jpg';
import pizza from '../assets/fotos/hamburgueseria-el-camperazo-apaisada-04.jpg';
import cartaPizzas from '../assets/fotos/hamburgueseria-el-camperazo-vertical-05.jpg';
import tarjeta from '../assets/fotos/hamburgueseria-el-camperazo-vertical-06.jpg';
import tamano from '../assets/fotos/hamburgueseria-el-camperazo-vertical-07.jpg';
import hamburguesa from '../assets/fotos/hamburgueseria-el-camperazo-vertical-08.jpg';
import pizarra from '../assets/fotos/hamburgueseria-el-camperazo-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
} from '../data/site';

const title = 'Hamburguesería El Camperazo · Camperos y pizzas en Puerto de la Torre';
const description = BUSINESS.description;

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de El Camperazo en la esquina de Mora y Cabrera, con el rótulo naranja, la persiana metálica y el cartel de venta de hielo',
	},
	{
		src: pizza,
		alt: 'Pizza con gambas, anchoas, champiñones y rodajas de tomate en su caja, junto al cartel del Día del Camperazo',
	},
	{
		src: patatas,
		alt: 'Patatas fritas cubiertas de queso fundido y bacon en una bandeja de aluminio',
	},
	{
		src: tamano,
		alt: 'Campero sobre papel de estraza, tapado a medias por dos manos para mostrar lo que ocupa',
	},
	{
		src: hamburguesa,
		alt: 'Hamburguesa abierta sobre papel de periódico, con carne a la plancha, queso, huevo y bacon',
	},
	{
		src: pizarra,
		alt: 'Pizarra verde de El Camperazo con los supercamperos, superbocatas y superhamburguesas y el precio de cada uno',
	},
	{
		src: cartaPizzas,
		alt: 'Carta de pizzas y varios del local, con las quince pizzas, las raciones y las bebidas y sus precios',
	},
	{
		src: tarjeta,
		alt: 'Tarjeta de El Camperazo con el logo, los dos teléfonos de pedidos, el código QR y la dirección',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#hamburgueseria-el-camperazo`,
	name: BUSINESS.fullName,
	alternateName: ['El Camperazo', 'Hamburguesería El Camperazo Puerto de la Torre'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	priceRange: BUSINESS.priceRange,
	servesCuisine: ['Hamburguesas', 'Pizzas', 'Bocadillos', 'Camperos'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Puerto de la Torre' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '23:59',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: false },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"hamburgueseria-el-camperazo-apaisada-02.jpg": campero,
	"hamburgueseria-el-camperazo-apaisada-01.jpg": fachada,
	"hamburgueseria-el-camperazo-apaisada-04.jpg": pizza,
	"hamburgueseria-el-camperazo-apaisada-03.jpg": patatas,
	"hamburgueseria-el-camperazo-vertical-07.jpg": tamano,
	"hamburgueseria-el-camperazo-vertical-08.jpg": hamburguesa,
	"hamburgueseria-el-camperazo-vertical-09.jpg": pizarra,
	"hamburgueseria-el-camperazo-vertical-05.jpg": cartaPizzas,
	"hamburgueseria-el-camperazo-vertical-06.jpg": tarjeta,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#16120f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="El Camperazo, Hamburguesería El Camperazo, camperos Málaga, hamburguesas Puerto de la Torre, pizzas Puerto de la Torre, C. Mora y Cabrera 38, bocatas Málaga, patatas con queso Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Camperos desde 3,00 €, pizzas desde 9,00 € y raciones para compartir en Puerto de la Torre. De jueves a domingo, 20:00–24:00. 3,8 sobre 5 con 485 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Campero de El Camperazo cortado en dos sobre papel de estraza"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#16120f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Puerto de la Torre, Málaga"
			preload={[campero]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Camperazo"
			subtitle="Hamburguesería · Puerto de la Torre"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Hamburguesería El Camperazo"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34633130310?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20M%C3%A1laga." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Málaga"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
