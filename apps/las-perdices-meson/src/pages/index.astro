---
import '../styles/global.css';

const business = {
	name: 'Las Perdices Restaurante Mesón',
	short: 'Las Perdices',
	street: 'Avda. Buenavista, 12',
	city: 'Vejer de la Frontera',
	postalCode: '11150',
	phone: '+34 956 45 03 61',
	latitude: 36.2496328,
	longitude: -5.966519,
	site: 'https://las-perdices-meson.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Las+Perdices+Restaurante+Mes%C3%B3n/@36.2496328,-5.966519,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c45cbe43d7d8f:0xe0f89db3e59d32dc!8m2!3d36.2496328!4d-5.966519!16s%2Fg%2F1tctn140?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34956450361';

const specialties = [
	{
		kicker: 'De la casa',
		title: 'Perdiz con arroz',
		text: 'El plato más citado por la clientela: perdiz con arroz, el mejor arroz que han probado según reseñas.',
	},
	{
		kicker: 'A la parrilla',
		title: 'Atún a punto',
		text: 'Atún a la parrilla excelente, con la capacidad de asarlo a punto, según sus visitantes.',
	},
	{
		kicker: 'Para compartir',
		title: 'Almejas y tortillitas',
		text: 'Almejas, tortillitas de camarones y presa ibérica entre lo más recomendado.',
	},
	{
		kicker: 'Cocina',
		title: 'Española y mediterránea',
		text: 'Mesón de cocina española y mediterránea, trato cercano y servicio rápido.',
	},
	{
		kicker: 'En Vejer',
		title: 'Avda. Buenavista 12',
		text: 'En la avenida de entrada a Vejer, fácil de llegar y con ambiente de mesón.',
	},
	{
		kicker: 'Para reservar',
		title: 'Llama al 956 45 03 61',
		text: 'En fin de semana conviene reservar. Confirma el horario vigente por teléfono.',
	},
];

const gallery = [
	{ src: '/fotos/meson.svg', alt: 'Ilustración del mesón — sustituye por foto propia' },
	{ src: '/fotos/perdiz-arroz.svg', alt: 'Ilustración de perdiz con arroz — sustituye por foto propia' },
	{ src: '/fotos/atun.svg', alt: 'Ilustración de atún a la parrilla — sustituye por foto propia' },
	{ src: '/fotos/comedor.svg', alt: 'Ilustración del comedor — sustituye por foto propia' },
	{ src: '/fotos/tapas.svg', alt: 'Ilustración de tapas — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Las Perdices?',
		a: 'En Avda. Buenavista, 12, 11150 Vejer de la Frontera (Cádiz), según su página oficial.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'No hay horario verificado publicado: confirma el horario vigente en el 956 45 03 61 antes de venir.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'En fin de semana conviene reservar en el 956 45 03 61.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Mesón de cocina española: perdiz con arroz, atún a la parrilla, almejas, tortillitas de camarones y presa ibérica, según reseñas.',
	},
	{
		q: '¿Cómo llego?',
		a: 'Está en la Avda. Buenavista, vía de entrada a Vejer. Usa el botón «Cómo llegar» para abrir la ruta en Google Maps.',
	},
];

const description =
	'Las Perdices Restaurante Mesón: mesón de cocina española en Avda. Buenavista, 12, Vejer de la Frontera. Perdiz con arroz, atún a la parrilla y tortillitas. Tel. 956 45 03 61.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 956 45 03 61',
	image: [`${business.site}/fotos/meson.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Mediterránea'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="Las Perdices Restaurante Mesón: mesón de cocina española en Avda. Buenavista, 12, Vejer. Perdiz con arroz, atún a la parrilla. 956 45 03 61." />
		<meta name="keywords" content="Las Perdices Vejer, mesón Las Perdices, comer Vejer de la Frontera, Avda Buenavista 12, perdiz con arroz, atún parrilla" />
		<meta name="author" content="Las Perdices Restaurante Mesón" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>Las Perdices | Mesón en Vejer de la Frontera</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Las Perdices · Mesón en Vejer de la Frontera" />
		<meta property="og:description" content="Cocina española en Avda. Buenavista, 12: perdiz con arroz, atún a la parrilla, tortillitas." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/meson.svg`} />
		<meta property="og:image:alt" content="Las Perdices Restaurante Mesón, Vejer de la Frontera" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Las Perdices · Mesón en Vejer de la Frontera" />
		<meta name="twitter:description" content="Perdiz con arroz y atún a la parrilla en Avda. Buenavista, 12, Vejer." />
		<meta name="twitter:image" content={`${business.site}/fotos/meson.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Vejer de la Frontera" />
		<meta name="geo.position" content="36.2496328;-5.966519" />
		<meta name="ICBM" content="36.2496328, -5.966519" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Las Perdices, inicio">
				<span class="brand-mark" aria-hidden="true">LP</span>
				<span class="brand-name">Las Perdices <small>Vejer de la Frontera</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">El mesón</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>956 45 03 61</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Avda. Buenavista, 12 · Vejer</p>
					<h1 id="hero-title">El mesón<br />de <em>Vejer.</em></h1>
					<p class="hero-lede">
						Las Perdices Restaurante Mesón: cocina española y mediterránea en la avenida de
						Vejer. Perdiz con arroz, atún a la parrilla, almejas y tortillitas de camarones.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 956 45 03 61</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>Mesón</b> cocina española</li>
						<li>Perdiz con arroz</li>
						<li>Atún a la parrilla</li>
						<li>Reservas por teléfono</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/fotos/meson.svg" alt="Ilustración del mesón Las Perdices, Vejer de la Frontera" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Avda. Buenavista 12 · Vejer</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>LP</b><span>Mesón</span></div>
					<div><b>12</b><span>Buenavista</span></div>
					<div><b>Vejer</b><span>Cádiz</span></div>
				</div>
				<ul class="services">
					<li>Perdiz con arroz</li>
					<li>Atún</li>
					<li>Tortillitas</li>
					<li>Presa ibérica</li>
					<li>Reservas</li>
					<li>Mesón</li>
				</ul>
			</section>

			<section class="about section-pad" id="restaurante">
				<p class="section-label"><span aria-hidden="true"></span> El mesón</p>
				<div class="about-grid">
					<h2>Comer de mesón<br />en <em>Vejer.</em></h2>
					<div class="about-copy">
						<p>
							Las Perdices Restaurante Mesón está en Avda. Buenavista, 12 (11150 Vejer de la
							Frontera), según su página oficial, con coordenadas 36.2496328, -5.966519.
						</p>
						<p>
							Mesón muy frecuentado de cocina española: la clientela destaca la perdiz con arroz,
							el atún a la parrilla a punto, las almejas, las tortillitas de camarones y la presa
							ibérica, con atención cercana y servicio rápido.
						</p>
						<p class="about-note">
							No publicamos horario por falta de fuente verificable: confirma el horario vigente
							en el 956 45 03 61 antes de venir, y reserva en fin de semana.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales según reseñas públicas: cocina de mesón. Confirma la carta del día
						en el propio restaurante.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El mesón<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del mesón.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Avda. Buenavista, 12</p>
					<h2>Ven al mesón<br /><em>a comer.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<p class="hours-note">Horario sin fuente verificable. Confirma en el 956 45 03 61 antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al mesón ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 956 45 03 61</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de Las Perdices en Avda. Buenavista 12, Vejer" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Las Perdices · Vejer</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">LP</span>
				<p>Las Perdices<small>{business.street} · {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Las Perdices · Vejer de la Frontera. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al mesón <span>956 45 03 61</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
