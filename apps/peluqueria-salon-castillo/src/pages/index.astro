---
import '../styles/global.css';
import { business, directionsUrl, mapEmbedUrl, mapsUrl, photoUrl, structuredData } from '../lib/business';
import Galeria from '../components/Galeria.astro';

const title = 'Peluquería Salón Castillo | Peluquería en Málaga';
const description =
	'Peluquería Salón Castillo en Málaga. Consulta la ficha de Google Maps para ver su ubicación, indicaciones y galería de fotos.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#402333" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={photoUrl} />
		<meta property="og:image:alt" content="Fotografía de la ficha de Peluquería Salón Castillo en Google Maps" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={photoUrl} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7229506;-4.4528071" />
		<meta name="ICBM" content="36.7229506, -4.4528071" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Peluquería Salón Castillo, inicio">
				<span class="brand-mark" aria-hidden="true">SC</span>
				<span class="brand-name">Salón Castillo <small>Peluquería · Málaga</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#salon">El salón</a>
				<a href="#ubicacion">Ubicación</a>
			</nav>
			<a class="topbar-link" href={mapsUrl} target="_blank" rel="noreferrer">Ficha en Maps <span aria-hidden="true">↗</span></a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Málaga · Peluquería</p>
					<h1 id="hero-title">Salón<br /><em>Castillo.</em></h1>
					<p class="hero-lede">
						Conoce Peluquería Salón Castillo a través de su ficha de Google Maps. Consulta allí la dirección
						actualizada, cómo llegar y el resto de imágenes del salón.
					</p>
					<div class="hero-actions">
						<a class="button button-rose" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Abrir ficha de Maps</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-note"><span class="note-rule" aria-hidden="true"></span><p>La ubicación de esta página corresponde a la ficha enlazada por el negocio en Google Maps.</p></div>
				</div>

				<figure class="hero-photo">
					<div class="photo-frame">
						<img
							src={photoUrl}
							alt="Fotografía compartida en la ficha de Google Maps de Peluquería Salón Castillo"
							width="1200"
							height="675"
							fetchpriority="high"
							decoding="async"
						/>
						<span class="photo-caption">SALÓN CASTILLO <i>·</i> MÁLAGA</span>
					</div>
					<figcaption><span>Foto de la ficha de Google Maps</span><a href={mapsUrl} target="_blank" rel="noreferrer">Ver la galería ↗</a></figcaption>
				</figure>
				<div class="hero-orbit" aria-hidden="true"></div>
			</section>

			<section class="salon-band" id="salon" aria-label="Peluquería Salón Castillo">
				<div class="monogram" aria-hidden="true">SC</div>
				<p><small>TIPO DE NEGOCIO</small><strong>Peluquería</strong></p>
				<span class="band-divider" aria-hidden="true"></span>
				<p><small>LOCALIDAD</small><strong>{business.city}, España</strong></p>
				<span class="band-divider" aria-hidden="true"></span>
				<a href={mapsUrl} target="_blank" rel="noreferrer"><small>CONSULTA LA FICHA</small><strong>Google Maps ↗</strong></a>
			</section>

			<section class="location section-pad" id="ubicacion" aria-labelledby="location-title">
				<div class="location-copy">
					<p class="eyebrow dark"><span aria-hidden="true"></span> Ubicación de la ficha</p>
					<h2 id="location-title">Encuentra<br /><em>el salón.</em></h2>
					<p class="location-lede">
						La dirección postal y el contacto no se han podido confirmar de forma fiable para esta ficha.
						Abre Google Maps para consultar la información vigente directamente.
					</p>
					<div class="location-actions">
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="text-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha y fotos de Maps ↗</a>
					</div>
				</div>
				<div class="map-shell">
					<div class="map-label"><span><i aria-hidden="true"></i> UBICACIÓN DE LA FICHA</span><span>MÁLAGA · ES</span></div>
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
						title="Mapa de la ficha de Peluquería Salón Castillo en Málaga"
					 src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-tag" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Salón Castillo · Málaga</a>
				</div>
			</section>
			<Galeria nombre="Peluquería Salón Castillo" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio" aria-label="Peluquería Salón Castillo, volver al inicio">
				<span class="brand-mark" aria-hidden="true">SC</span>
				<span class="brand-name">Salón Castillo <small>Peluquería · Málaga</small></span>
			</a>
			<p>Peluquería · {business.city}, España</p>
			<a class="footer-link" href={mapsUrl} target="_blank" rel="noreferrer">Google Maps <span aria-hidden="true">↗</span></a>
			<small>© {new Date().getFullYear()} {business.name}. Ubicación según la ficha enlazada de Google Maps.</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
	<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
	<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
	<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
</nav>
</footer>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>


