---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import fachada from '../assets/fotos/panaderia-rocio-vertical-01.jpg';
import interior from '../assets/fotos/panaderia-rocio-vertical-02.jpg';
import escaparate from '../assets/fotos/panaderia-rocio-vertical-03.jpg';
import vitrina from '../assets/fotos/panaderia-rocio-vertical-04.jpg';
import precios from '../assets/fotos/panaderia-rocio-vertical-05.jpg';
import toldo from '../assets/fotos/panaderia-rocio-vertical-06.jpg';
import lateral from '../assets/fotos/panaderia-rocio-vertical-07.jpg';
import estanteria from '../assets/fotos/panaderia-rocio-vertical-08.jpg';
import fachadaCortina from '../assets/fotos/panaderia-rocio-vertical-09.jpg';

import { BUSINESS, FAQ, FICHA, HIGHLIGHTS, MAPS, PRECIOS, PRECIOS_NOTE, RESENAS_NOTE, SERVICIOS } from '../data/site';

const title = 'Panadería Rocío · Pan de barrio en Levante, Córdoba';
const metaDescription =
	'Panadería Rocío, Av. de Carlos III, 28 (Levante, 14014 Córdoba): pan, bollería, empanadas, tortas, aperitivos y bebidas. 5 sobre 5 con 5 reseñas en Google.';
const description = BUSINESS.description;

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#panaderia-rocio`,
	name: BUSINESS.name,
	alternateName: ['Panadería Rocío Córdoba', 'Panadería Rocío Levante', 'Panadería Carlos III'],
	description:
		'Panadería y tienda de barrio en la avenida de Carlos III, 28 (Levante, 14014 Córdoba): pan, bollería, empanadas, tortas, aperitivos y bebidas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Panadería', 'Bollería'],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
		worstRating: 1,
	},
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El escaparate', href: '#escaparate' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Dónde está', href: '#visitanos' },
];

const stats = [
	{ label: 'Valoración', value: '5,0' },
	{ label: 'Reseñas', value: '5' },
	{ label: 'Horario', value: 'Sin publicar' },
	{ label: 'Fotos', value: '9' },
];

const galeria = [
	{
		src: precios,
		alt: 'Detalle de los rótulos del escaparate con los precios del pan, las empanadas y las tortas',
		caption: 'Los precios, en el escaparate',
	},
	{
		src: vitrina,
		alt: 'La vitrina de bollería y la nevera de bebidas junto a las estanterías de aperitivos y snacks',
		caption: 'La tienda, por dentro',
	},
	{
		src: estanteria,
		alt: 'Estanterías interiores con aperitivos, snacks y bebidas, con la báscula del mostrador al fondo',
		caption: 'Aperitivos y bebidas',
	},
	{
		src: toldo,
		alt: 'La fachada con el toldo azul y las figuras de flamenca y flamenco junto a la puerta',
		caption: 'La fachada, con el toldo azul',
	},
	{
		src: lateral,
		alt: 'Vista lateral de la entrada con el rótulo Panadería Rocío y la máquina de chicles',
		caption: 'La entrada, de lado',
	},
	{
		src: fachadaCortina,
		alt: 'La fachada de la panadería con la cortina de lunares y el seto delante',
		caption: 'La puerta, con la cortina de lunares',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#5c1730" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400;1,6..96,500&family=Figtree:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={metaDescription}
			keywords="Panadería Rocío Córdoba, panadería Levante Córdoba, panadería Carlos III, pan Córdoba 14014, bollería Levante, empanadas Córdoba"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan, bollería, empanadas y tortas en la avenida de Carlos III, 28 (Levante). 5 sobre 5 con 5 reseñas en Google. Horario y teléfono no publicados en la ficha."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="El escaparate de Panadería Rocío, con panes, empanadas y los rótulos de precios"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#5c1730"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Panadería Rocío, inicio">
					<span class="brand-mark" aria-hidden="true">PR</span>
					<span class="brand-name">
						Panadería Rocío
						<small>Carlos III, 28 · Levante · Córdoba</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-cta" href={MAPS.directions} target="_blank" rel="noreferrer">
					Cómo llegar <span aria-hidden="true">↗</span>
				</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Av. de Carlos III, 28 · 14014 Córdoba</p>
						<h1 id="hero-title">Pan de barrio,<br /><em>también ultramarinos.</em></h1>
						<p class="hero-lede">
							Una panadería de toda la vida en la avenida de Carlos III, en Levante. Pan y
							bollería en el mostrador, y estanterías de aperitivos, snacks y bebidas para
							completar la compra.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="button button-ghost" href="#escaparate">Ver el escaparate</a>
						</div>
						<dl class="hero-facts">
							{
								stats.map((stat) => (
									<div>
										<dt>{stat.label}</dt>
										<dd>{stat.value}</dd>
									</div>
								))
							}
						</dl>
					</div>

					<figure class="hero-media">
						<div class="hero-photo">
							<Image
								src={fachada}
								alt="La fachada de Panadería Rocío en la avenida de Carlos III, con el rótulo sobre un escaparate lleno de fotos de pan"
								widths={[480, 720, 1024, 1400]}
								sizes="(max-width: 980px) 88vw, 40vw"
								format="avif"
								quality={74}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</div>
						<figcaption>
							<span>La fachada en Carlos III</span>
							<span>Foto de la ficha de Google</span>
						</figcaption>
						<span class="hero-seal" aria-hidden="true">
							<strong>5,0</strong>
							<small>5 reseñas<br />en Google</small>
						</span>
					</figure>
				</div>
			</section>

			<section class="chips-wrap wrap" aria-label="Lo que ofrece la casa">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<div class="about-grid">
					<figure class="about-media">
						<Image
							src={interior}
							alt="El interior del local: mostrador de bollería y estanterías llenas de aperitivos y bebidas"
							widths={[400, 640, 900]}
							sizes="(max-width: 980px) 88vw, 38vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>El mostrador y la tienda</figcaption>
					</figure>

					<div class="about-copy">
						<p class="section-label"><span aria-hidden="true"></span> La casa</p>
						<h2 id="about-title">Una panadería <em>que también es tienda.</em></h2>
						<p>
							Rocío abre en el número 28 de la avenida de Carlos III, en el barrio de Levante.
							El escaparate lo dice claro: pan, bollería, empanadas y tortas, con los precios
							rotulados en tablillas de madera para que se vean desde la calle.
						</p>
						<p>
							Dentro, junto al mostrador y la vitrina de bollería, hay estanterías de aperitivos,
							snacks y bebidas, y una nevera. Es esa clase de panadería de barrio en la que se
							entra por el pan y se sale con algo más.
						</p>
						<p>
							La ficha de Google no publica horario, teléfono ni página web. Esta web cuenta lo
							que la ficha y sus fotos muestran, sin rellenar los huecos con suposiciones.
						</p>
						<div class="about-links">
							<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha en Google Maps <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href="#fotos">Ver las fotos</a>
						</div>
					</div>
				</div>

				<ul class="highlights">
					{
						HIGHLIGHTS.map((item) => (
							<li>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section class="escaparate" id="escaparate" aria-labelledby="escaparate-title">
				<div class="wrap escaparate-grid">
					<div class="escaparate-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> El escaparate</p>
						<h2 id="escaparate-title">Precios a la vista, <em>como en el barrio.</em></h2>
						<p>
							Estos son los precios que se leen en los rótulos del escaparate en las fotos de la
							galería. No es una carta oficial: el surtido cambia cada día y los precios pueden
							haberse actualizado.
						</p>

						<div class="price-groups">
							{
								PRECIOS.map((group) => (
									<div>
										<h3>{group.title}</h3>
										<ul class="price-list">
											{group.items.map((item) => (
												<li>
													<span>{item.name}</span>
													<span class="dots" aria-hidden="true"></span>
													<span class="price">{item.price}</span>
												</li>
											))}
										</ul>
									</div>
								))
							}
						</div>

						<p class="price-note">{PRECIOS_NOTE}</p>
					</div>

					<figure class="escaparate-media">
						<Image
							src={escaparate}
							alt="El escaparate con panes, empanadas y tortas, y los rótulos de madera con los precios"
							widths={[480, 720, 1000]}
							sizes="(max-width: 980px) 88vw, 42vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>El escaparate, con los precios rotulados</figcaption>
					</figure>
				</div>
			</section>

			<section class="ficha" id="ficha" aria-labelledby="ficha-title">
				<div class="wrap">
					<div class="ficha-head">
						<div>
							<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
							<h2 id="ficha-title">Una ficha <em>a medias.</em></h2>
						</div>
						<p>
							El perfil de Google de Rocío no está reclamado por el negocio. Publica la
							dirección, la categoría, la valoración, la accesibilidad y las fotos, pero deja
							fuera lo que más se pregunta: horario, teléfono y web.
						</p>
					</div>

					<div class="ficha-grid">
						{
							FICHA.map((card, index) => (
								<div class="ficha-card">
									<h3>{card.title}</h3>
									<dl>
										{card.items.map((item) => (
											<>
												<dt>{item.name}</dt>
												<dd>{item.note}</dd>
											</>
										))}
									</dl>
									{index === 1 && <span class="pending">Pendiente de confirmar en el local</span>}
								</div>
							))
						}
					</div>
				</div>
			</section>

			<section class="fotos wrap" id="fotos" aria-labelledby="fotos-title">
				<div class="fotos-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Fotos</p>
						<h2 id="fotos-title">La tienda, <em>por dentro y por fuera.</em></h2>
					</div>
					<p>
						Las nueve fotos de la galería pública de Google Maps: la fachada, el mostrador, la
						vitrina, las estanterías y los rótulos de precios del escaparate.
					</p>
				</div>

				<div class="fotos-grid">
					{
						galeria.map((photo) => (
							<figure class="foto">
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 520, 760]}
									sizes="(max-width: 620px) 92vw, (max-width: 980px) 45vw, 30vw"
									format="avif"
									quality={70}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>{photo.caption}</figcaption>
							</figure>
						))
					}
				</div>
			</section>

			<section class="rating" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La valoración</p>
						<h2 id="rating-title">Cinco sobre cinco, <em>con cinco reseñas.</em></h2>
						<p>{RESENAS_NOTE}</p>
						<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver las reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-symbol">
						<span class="rating-value">5,0</span>
						<span class="rating-stars" aria-label="5 de 5 estrellas">★★★★★</span>
						<p class="rating-caption">
							valoración media<br />
							con 5 reseñas publicadas
						</p>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Dónde está</p>
					<h2 id="visit-title">En Carlos III, <em>28.</em></h2>
					<p class="address">
						{BUSINESS.street}<br />
						{BUSINESS.district} · {BUSINESS.postalCode} {BUSINESS.city}
					</p>

					<p class="visit-note">
						<strong>Antes de ir:</strong> la ficha no publica horario ni teléfono, así que no
						podemos confirmar a qué hora abre. Consulta la ficha actualizada o pásate por la
						tienda.
					</p>

					<ul class="visit-list">
						<li>
							<span>Acceso</span>
							Google marca el acceso para sillas de ruedas.
						</li>
						<li>
							<span>Aparcamiento</span>
							La ficha indica que no hay aparcamiento adaptado.
						</li>
						<li>
							<span>Horario</span>
							Sin publicar en la ficha de Google.
						</li>
						<li>
							<span>Plus Code</span>
							{BUSINESS.plusCode}
						</li>
					</ul>

					<div class="visit-links">
						<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
							Ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Panadería Rocío en la avenida de Carlos III, 28, Levante, Córdoba"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Carlos III, 28 · Levante
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>entrar.</em></h2>
				<div class="faq-list">
					{
						FAQ.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">PR</span>
						<p>
							Panadería Rocío
							<small>
								Pan, bollería y tienda de barrio<br />
								{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}
							</small>
						</p>
					</div>
					<nav aria-label="Enlaces del establecimiento">
						<a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
						<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a href="#fotos">Fotos</a>
						<a href="#preguntas">Preguntas</a>
						<a href="/aviso-legal">Aviso legal</a>
					</nav>
				</div>
				<small class="legal">
					© {new Date().getFullYear()}
					{BUSINESS.name} · Datos, valoración y fotografías de la ficha pública de Google Maps,
					consultada en octubre de 2026. Precios leídos en los rótulos del escaparate en esa
					galería. Horario, surtido y precios pueden cambiar; la ficha no publica horario ni
					teléfono.
				</small>
				<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
				<p class="credit">
					<small>
						Creado por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
						sur-digital.vercel.app
					</small>
				</p>
			</div>
		</footer>
	</body>
</html>
