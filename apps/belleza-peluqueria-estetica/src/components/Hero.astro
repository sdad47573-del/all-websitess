---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES } from '../data/site';
---

<section id="inicio" class="hero-astyle relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.fotoFachada}
			alt="Mi Belle Peluquería y Estética en Martínez de la Rosa, Málaga"
			widths={[600, 1000]}
			sizes="100vw"
			quality={78}
			loading="eager"
			fetchpriority="high"
			class="h-full w-full object-cover opacity-45"
		/>
		<div class="from-neutral/90 via-neutral/40 absolute inset-0 bg-gradient-to-r"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-32">
		<div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
			<div>
				<p
					class="text-accent inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase"
				>
					<span><i class="ri-map-pin-line"></i> Suárez · {BUSINESS.city}</span>
					<span class="text-white/60">Cita por WhatsApp</span>
				</p>
				<h1 class="font-display mt-4 text-5xl leading-[1.05] font-bold sm:text-6xl lg:text-7xl">
					Mi Belle<br />
					<span class="text-accent">Peluquería & Estética</span>
				</h1>
				<p class="mt-3 text-xl font-semibold text-white/85 sm:text-2xl">
					Tu belleza es nuestra pasión
				</p>
				<p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80">
					Peluquería, <strong class="text-white">manicura, pedicura</strong> y
					depilación en <strong class="text-white">Martínez de la Rosa, 43</strong>.
					Pide cita por WhatsApp al <strong class="text-white">{BUSINESS.phoneDisplay}</strong>.
				</p>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn-accent btn-lg gap-2 rounded-full">
						<i class="ri-whatsapp-line"></i>
						WhatsApp {BUSINESS.phoneDisplay}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline btn-lg hover:text-neutral rounded-full border-white/40 bg-white/5 text-white hover:border-white hover:bg-white"
					>
						<i class="ri-map-pin-line"></i> Cómo llegar
					</a>
				</div>

				<dl class="mt-10 grid max-w-lg grid-cols-3 gap-x-6 gap-y-5">
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Especialidad</dt>
						<dd class="mt-1 text-xl font-bold">Uñas + pelo</dd>
					</div>
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Reserva</dt>
						<dd class="mt-1 text-xl font-bold">WhatsApp</dd>
					</div>
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Teléfono</dt>
						<dd class="mt-1 text-xl font-bold">{BUSINESS.phoneDisplay}</dd>
					</div>
				</dl>
				<p class="mt-4 text-xs text-white/55">
					Martínez de la Rosa, 43 · 29010 Málaga · Confirma horario por WhatsApp
				</p>
			</div>

			<figure class="relative hidden lg:block">
				<div class="rotate-2 overflow-hidden rounded-sm shadow-2xl ring-1 ring-white/15">
					<Image
						src={IMAGES.fotoCejas}
						alt="Manicura y pedicura en Mi Belle (Málaga)"
						widths={[500, 900]}
						sizes="(min-width: 1024px) 36vw, 90vw"
						quality={86}
						loading="eager"
						class="aspect-[4/5] w-full object-cover"
					/>
				</div>
				<figcaption
					class="text-accent bg-neutral absolute -bottom-5 -left-4 rounded-sm px-5 py-3 text-lg font-bold shadow-xl"
				>
					Martínez de la Rosa, 43 · Suárez
				</figcaption>
			</figure>
		</div>
	</div>
</section>
