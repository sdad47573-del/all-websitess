---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/restaurante-sos-apaisada-01.jpg';
import pescadoSal from '../assets/fotos/restaurante-sos-apaisada-02.jpg';
import bogavantePasta from '../assets/fotos/restaurante-sos-vertical-03.jpg';
import arroz from '../assets/fotos/restaurante-sos-vertical-04.jpg';
import bogavanteGuiso from '../assets/fotos/restaurante-sos-cuadrada-05.jpg';
import arrozMesa from '../assets/fotos/restaurante-sos-vista-6-06.jpg';
import mariscada from '../assets/fotos/restaurante-sos-apaisada-07.jpg';
import entrecot from '../assets/fotos/restaurante-sos-vertical-08.jpg';
import chillout from '../assets/fotos/restaurante-sos-apaisada-09.jpg';
import comedor from '../assets/fotos/restaurante-sos-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Restaurante SOS, en Carrer des Munt Aconcagua (07849 Cala Llonga, Ibiza). Cocina mediterránea, pescado fresco, arroces y terraza frente al mar. Tel. 971 19 64 60.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada blanca de Restaurante SOS en Cala Llonga, con el rótulo RESTAURANTE, el logo SOS y palmeras alrededor',
	},
	{
		src: arroz,
		alt: 'Paella de marisco con carabineros, mejillones y bogavante en la sartén',
	},
	{
		src: arrozMesa,
		alt: 'Arroz de marisco en paellera sobre una mesa de madera, con limón y marisco',
	},
	{
		src: bogavantePasta,
		alt: 'Bogavante con espaguetis en salsa sobre una fuente blanca alargada',
	},
	{
		src: bogavanteGuiso,
		alt: 'Bogavante guisado con patatas y huevo frito en una cazuela',
	},
	{
		src: pescadoSal,
		alt: 'Pescado entero a la sal sobre una bandeja metálica, con verduras al lado',
	},
	{
		src: mariscada,
		alt: 'Mariscada con bogavante, langostinos, mejillones, pescado y patatas chips',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la brasa cortado y con sal gruesa',
	},
	{
		src: comedor,
		alt: 'Comedor de SOS con vigas de madera, plantas colgantes, sillas de mimbre y mesas de madera',
	},
	{
		src: chillout,
		alt: 'Rincón chill-out de la terraza con sofás, cojines amarillos y una silla colgante',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#sos`,
	name: BUSINESS.name,
	alternateName: ['SOS', 'SOS Restaurant', 'SOS Cala Llonga', 'Restaurante SOS Ibiza'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 971 19 64 60',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Española', 'Marisco'],
	areaServed: [
		{ '@type': 'City', name: 'Cala Llonga' },
		{ '@type': 'AdministrativeArea', name: 'Santa Eulària des Riu' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:30',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'SOS · Restaurante mediterráneo en Cala Llonga';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#126e78" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante SOS, SOS Cala Llonga, comer en Cala Llonga, restaurante con vistas al mar Ibiza, cocina mediterránea Ibiza, arroces Cala Llonga, pescado fresco Ibiza, restaurante Santa Eulària"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="SOS · Restaurante mediterráneo en Cala Llonga"
			ogDescription="Cocina mediterránea, pescado fresco del día y arroces en primera línea de playa de Cala Llonga (Ibiza). Terraza con vistas. Tel. 971 19 64 60."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada blanca de Restaurante SOS en Cala Llonga, con el logo SOS y palmeras"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#126e78"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			phone="+34971196460"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="SOS"
			subtitle="Restaurante mediterráneo · Cala Llonga"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer des Munt Aconcagua · Cala Llonga"
				title="Frente al mar<br /><em>de Cala Llonga.</em>"
				lede={`SOS es un restaurante mediterráneo en Carrer des Munt Aconcagua, en Cala Llonga (Santa Eulària des Riu, Ibiza), en primera línea de playa. Cocina saludable con productos locales, pescado fresco del día, arroces y opciones healthy, con terraza y vistas a la cala para desayunos, comidas, cenas y atardeceres. Abre todos los días de 12:30 a 23:00, salvo el martes. Teléfono: ${BUSINESS.phoneDisplay}.`}
				image={fachada}
				imageAlt="Fachada blanca de Restaurante SOS en Cala Llonga, con el rótulo RESTAURANTE, el logo SOS y palmeras alrededor"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)` },
					{ label: 'Cocina', html: 'Mediterránea · pescado fresco y arroces' },
					{ label: 'Horario', html: 'Todos los días · 12:30–23:00 · martes cerrado' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Restaurante SOS" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Mediterráneo<br /><em>en primera línea.</em>"
				paragraphs={[
					'SOS está en Carrer des Munt Aconcagua, en Cala Llonga (Santa Eulària des Riu, Ibiza), en primera línea de playa. Google lo clasifica como restaurante y restaurante mediterráneo. La casa es blanca y luminosa, con el rótulo «RESTAURANTE» sobre la fachada y el logo SOS en madera; alrededor, palmeras y el pinar de la cala.',
					'La ficha del negocio lo cuenta así: «ofrecemos cocina mediterránea saludable con productos locales, pescado fresco del día, arroces y opciones healthy». La terraza, con vistas a Cala Llonga, sirve desayunos, comidas, cenas y atardeceres. Abre todos los días de 12:30 a 23:00; el martes cierra.',
					'Dentro, el comedor tiene vigas de madera, plantas colgantes, mesas de madera y sillas de mimbre, con la barra al fondo. En las fotos del perfil aparecen la paella de marisco, el arroz de marisco, el bogavante con espaguetis, el bogavante guisado, la mariscada, el pescado a la sal y el entrecot, además de un rincón chill-out con sofás y silla colgante.',
					'Sus reseñas hablan de la comida y del trato: «los camareros amabilísimos, pedimos el arroz de marisco y riquísimo», «las mejores almejas que he comido hace tiempo, la sangría de cava buenísima» y «todo buenísimo, bien atendido y raciones contundentes». Google le da 4,7 sobre 5 con 900 reseñas.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google. Una de ellas: «${REVIEWS[2]}»`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Arroces, marisco<br /><em>y pescado del día.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que citan sus reseñas, lo que cuenta la descripción del negocio y lo que aparece en las fotos del perfil."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. Llama al 971 19 64 60 para reservar mesa o preguntar por el pescado del día y los arroces."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La terraza,<br /><em>la mesa y el mar.</em>"
				description="Estas fotografías proceden del perfil de Restaurante SOS en Google Maps: la fachada, el comedor, el rincón chill-out de la terraza, la paella y el arroz de marisco, el bogavante, la mariscada, el pescado a la sal y el entrecot."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en Cala Llonga.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: todos los días de 12:30 a 23:00; martes cerrado. Para mesas en la terraza conviene llamar antes."
				mapTitle="Mapa de Restaurante SOS en Carrer des Munt Aconcagua, Cala Llonga (Ibiza)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="SOS · Cala Llonga"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 971 19 64 60. La ficha de Google marca acceso para sillas de ruedas, aparcamiento adaptado, aseo adaptado y asientos adaptados."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a SOS"
		/>
	</body>
</html>
