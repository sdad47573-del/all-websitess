---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES, NAV, PAGE_NAV } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-neutral text-neutral-content">
	<div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
		<div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
			<div class="lg:col-span-2">
				<a href="/#inicio" class="flex items-center gap-3" aria-label={`${BUSINESS.name}, inicio`}>
					<Image
						src={IMAGES.logo}
						alt=""
						width={48}
						height={48}
						quality={90}
						class="size-11 shrink-0 rounded-lg object-cover"
					/>
					<span>
						<span class="font-display block text-xl font-bold text-white">{BUSINESS.name}</span>
						<span class="text-accent text-[0.6rem] tracking-[0.22em] uppercase">
							Sanlúcar de Barrameda · Cádiz
						</span>
					</span>
				</a>
				<p class="mt-5 max-w-md text-sm leading-relaxed text-white/70">{BUSINESS.summary}</p>
				<p class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-white/70">
					<a href={BUSINESS.phoneHref} class="hover:text-accent inline-flex items-center gap-2">
						<i class="ri-phone-line"></i> {BUSINESS.phone}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-accent inline-flex items-center gap-2"
					>
						<i class="ri-google-fill"></i> Google Maps
					</a>
				</p>
			</div>

			<div>
				<h2 class="text-sm font-semibold tracking-[0.12em] text-white uppercase">Secciones</h2>
				<ul class="mt-4 space-y-2 text-sm text-white/70">
					{
						NAV.map((item) => (
							<li>
								<a href={`/${item.href}`} class="hover:text-accent transition-colors">
									{item.label}
								</a>
							</li>
						))
					}
					{
						PAGE_NAV.map((item) => (
							<li>
								<a href={item.href} class="hover:text-accent transition-colors">
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h2 class="text-sm font-semibold tracking-[0.12em] text-white uppercase">Dónde estamos</h2>
				<address class="mt-4 space-y-3 text-sm text-white/70 not-italic">
					<p>
						{BUSINESS.street}<br />
						{BUSINESS.postalCode} {BUSINESS.city}<br />
						{BUSINESS.region}
					</p>
					<p>
						{BUSINESS.hours.map((tramo) => (
							<span class="block">
								{tramo.days}: {tramo.hours}
							</span>
						))}
					</p>
				</address>
			</div>
		</div>

		<div class="mt-12 border-t border-white/10 pt-7">
			<div class="flex flex-col items-center justify-between gap-4 text-xs text-white/55 sm:flex-row">
				<p>© {year} {BUSINESS.name}. Todos los derechos reservados.</p>
				<p class="text-sm">
					Creado por{' '}
					<a
						href="https://sur-digital.vercel.app/"
						target="_blank"
						rel="noopener noreferrer"
						class="text-accent font-semibold hover:underline"
					>
						Sur Digital
					</a>
					{' · '}
					<a
						href="https://sur-digital.vercel.app/"
						target="_blank"
						rel="noopener noreferrer"
						class="text-white/70 hover:text-white hover:underline"
					>
						sur-digital.vercel.app
					</a>
				</p>
			</div>
		</div>
	</div>
<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
	<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
	<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
	<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
</nav>
</footer>
