---
import '../styles/global.css';
import { Image } from 'astro:assets';
import g1 from '../assets/galeria/gal-01.jpg';
import g2 from '../assets/galeria/gal-02.jpg';
import g3 from '../assets/galeria/gal-03.jpg';
import g4 from '../assets/galeria/gal-04.jpg';
import g5 from '../assets/galeria/gal-05.jpg';
import g6 from '../assets/galeria/gal-06.jpg';
import {
	business,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	servicios,
	site,
} from '../data/site';
import heroA from '../assets/hero/hero-plato.jpg';
import heroB from '../assets/hero/hero-comedor.jpg';
import heroC from '../assets/hero/hero-emplatado.jpg';

const title = 'Mesón Leioa · Cocina casera en Portugalete';
const description =
	'Mesón Leioa, cocina vasca casera en Julio Gutiérrez Lumbreras 6, Portugalete. Menú del día y pintxos. Teléfono 944 62 08 79.';
const keywords =
	'Mesón Leioa, Meson Leioa Portugalete, restaurante Portugalete, menú del día Portugalete, pintxos Portugalete';

const galeria = [
	{ img: g1, alt: 'Comedor de restaurante (fotografía de archivo)', caption: 'El comedor' },
	{ img: g2, alt: 'Barra de taberna con taburetes (fotografía de archivo)', caption: 'La barra' },
	{ img: g3, alt: 'Guiso tradicional en olla (fotografía de archivo)', caption: 'De cuchara' },
	{ img: g4, alt: 'Carne asada al corte (fotografía de archivo)', caption: 'La carne' },
	{ img: g5, alt: 'Ensalada fresca (fotografía de archivo)', caption: 'Fresco' },
	{ img: g6, alt: 'Postre casero (fotografía de archivo)', caption: 'El postre' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#23301f" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-BI" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración propia de Mesón Leioa en Portugalete; no es una foto del local" />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content="Ilustración propia de Mesón Leioa en Portugalete; no es una foto del local" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">ML</span>
				<span class="brand-text">
					Mesón Leioa
					<small>Portugalete · Bizkaia</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#local">La casa</a>
				<a href="#fotos">Fotos</a>
				<a href="#visita">Visita</a>
				<a href="#carta">Carta</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Portugalete · La Florida</p>
						<h1 id="hero-title">
							Mesón Leioa,
							<br />
							<em>comida casera.</em>
						</h1>
						<p class="hero-lede">
							Mesón familiar de cocina vasca tradicional en Julio Gutiérrez Lumbreras,
							6 (48920 Portugalete): menú del día entre semana, pintxos premiados y
							carta con cachopo, chuletón y txipirones. {hoursSummary}.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>Llamar al {business.phone}</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 ·{' '}
									{business.reviewCount.toLocaleString('es-ES')} opiniones en Tripadvisor
								</strong>
							</li>
						</ul>
					</div>

										<div class="hero-collage">
					<figure class="collage-item collage-item-a">
						<Image
						src={heroA}
						alt="Plato de carne con guarnición (fotografía de archivo)"
						widths={[640, 900, 1200]}
						sizes="(max-width: 1080px) 92vw, 46vw"
						format="avif"
						quality={68}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					</figure>
					<figure class="collage-item collage-item-b">
						<Image
						src={heroB}
						alt="Comedor acogedor de restaurante (fotografía de archivo)"
						widths={[320, 480, 640]}
						sizes="(max-width: 1080px) 45vw, 23vw"
						format="avif"
						quality={68}
						loading="lazy"
						decoding="async"
					/>
					</figure>
					<figure class="collage-item collage-item-c">
						<Image
						src={heroC}
						alt="Emplatado de restaurante (fotografía de archivo)"
						widths={[320, 480, 640]}
						sizes="(max-width: 1080px) 45vw, 23vw"
						format="avif"
						quality={68}
						loading="lazy"
						decoding="async"
					/>
					</figure>
					</div>
					<p class="hero-photo-note">Fotos de portada: banco de imágenes (Unsplash).</p>
				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 en Tripadvisor
				</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>Teléfono {business.phone}</span>
			</div>

						<section class="section carta" id="carta" aria-labelledby="carta-title">
				<div class="wrap">
					<p class="kicker">La carta</p>
					<h2 class="title" id="carta-title">
						Lo típico <em>de la casa.</em>
					</h2>
					<ul class="carta-list">
						<li>Menú del día casero (unos 13 a 15 euros)</li>
						<li>Pintxos premiados</li>
						<li>Cachopo, chuletón y rabo de toro</li>
						<li>Flan de queso con caramelo</li>
					</ul>
					<p class="carta-note">La carta del día puede cambiar: confirma por teléfono antes de ir.</p>
				</div>
			</section>

<section class="section" id="local" aria-labelledby="local-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">La casa</p>
						<h2 class="title" id="local-title">
							Tradición familiar,
							<br />
							<em>platos generosos.</em>
						</h2>
						<p>
							Mesón Leioa es un negocio familiar con cocina 100 % tradicional: amplia
							barra de pintxos —ganadores de concursos locales en 2017 y 2018—,
							comedor pequeño y acogedor frente a cocina abierta, y terraza en la
							acera. Premio al mejor menú ejecutivo de la Margen Izquierda.
						</p>
						<p>
							Esta web se ha preparado con datos públicos consultados el{' '}
							{site.consultado}: ficha de Google Maps, callejero municipal y guías
							gastronómicas. La carta y los precios del día pueden cambiar, así que
							conviene confirmar por teléfono antes de ir.
						</p>
						<p class="bar-note">
							Nota sobre las fotos: las imágenes de la ficha de Google Maps tienen
							derechos de sus autores y no se pueden copiar aquí. Las ilustraciones
							de esta web son de archivo (Unsplash): haz tus propias fotos para sustituirlas (ver README). por fotos propias del local.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>{business.reviewCount.toLocaleString('es-ES')} opiniones en Tripadvisor</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver ficha ↗</a>
						</div>
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									<strong>{review.rating} sobre 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section cocina" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Fotos</p>
					<h2 class="title" id="fotos-title">
						La casa <em>en imágenes.</em>
					</h2>
					<p class="lead">
						Fotos de ambiente de archivo (Unsplash). Cuando tengas fotos propias del local
						y sus platos, sustitúyelas en <code>src/assets/galeria/</code> (ver README).
					</p>
					<div class="cocina-grid">
						{galeria.map((foto) => (
							<figure class="cocina-item">
								<Image
								src={foto.img}
								alt={foto.alt}
								widths={[380, 560, 800]}
								sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
								format="avif"
								quality={68}
								loading="lazy"
								decoding="async"
							/>
								<figcaption>{foto.caption}</figcaption>
							</figure>
						))}
					</div>
					<p class="cocina-note">
						Para saber qué hay hoy, lo más rápido es{' '}
						<a href={phoneHref}>llamar al {business.phone}</a> o mirar la{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="visita" aria-labelledby="visita-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="visita-title">
							Julio Gutiérrez Lumbreras, 6,
							<br />
							<em>48920 Portugalete.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city} ({business.zone})
							<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario orientativo publicado por guías (a confirmar)</caption>
							<tbody>
								{hours.map((item) => (
									<tr class:list={[{ 'is-closed': item.service === 'Cerrado' }]}>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							El <strong>lunes cierra</strong>; de martes a domingo abre en horario
							continuo de <strong>8:00 a 23:00</strong>, con desayunos, comidas y
							cenas. Confirma por teléfono en festivos.
						</p>
						<ul class="access-list">
							{servicios.map((item) => (
								<li>{item.label}</li>
							))}
						</ul>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="transport-list" aria-label="Cómo llegar">
							<li>En metro: parking del metro a menos de cinco minutos a pie.</li>
							<li>En coche: aparcamiento complicado en la zona.</li>
						</ul>
					</div>
					<div class="map-card">
						<div class="map-facade" data-map-src={mapEmbedUrl}>
							<svg viewBox="0 0 120 90" width="120" height="90" role="img" aria-label="Vista previa del mapa">
							<rect width="120" height="90" rx="10" fill="#e9dfc9" />
							<g stroke="#d3c5a3" stroke-width="5">
								<path d="M0 30 H120 M0 62 H120 M35 0 V90 M78 0 V90" />
							</g>
							<g stroke="#ffffff" stroke-width="2">
								<path d="M0 30 H120 M0 62 H120 M35 0 V90 M78 0 V90" />
							</g>
							<path d="M60 60 c-9 0 -15 -7 -15 -15 c0 -9 7 -16 15 -16 s15 7 15 16 c0 8 -6 15 -15 15 z" fill="#a83e4a" />
							<circle cx="60" cy="44" r="6" fill="#faf7f0" />
						</svg>
							<p>El mapa interactivo se carga solo si lo pides.</p>
							<button class="btn btn-solid map-load" type="button">Cargar mapa interactivo</button>
						</div>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>llamar.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">ML</span>
					<span>
						Mesón Leioa
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Mesón Leioa · {business.streetAddress} ({business.postalCode} {business.city}).
					Web informativa no oficial elaborada con datos públicos consultados el {site.consultado}. Las fotos son ilustraciones propias.
					Confirma horario y disponibilidad por teléfono antes de salir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a Mesón Leioa <span>{business.phone}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
			<button class="share-link" id="compartir" type="button">Compartir</button>
		</nav>
	
	<script is:inline>
		const shareBtn = document.getElementById("compartir");
		shareBtn?.addEventListener("click", async () => {
			const url = location.href;
			if (navigator.share) {
				try { await navigator.share({ title: document.title, url }); } catch (e) {}
			} else {
				try {
					await navigator.clipboard.writeText(url);
					shareBtn.textContent = "Enlace copiado";
					setTimeout(() => { shareBtn.textContent = "Compartir"; }, 2000);
				} catch (e) {}
			}
		});
	</script>
	<script is:inline>
		const load = document.querySelector('.map-load');
		if (load) {
			load.addEventListener('click', () => {
				const box = load.parentElement;
				const src = box.getAttribute('data-map-src');
				const frame = document.createElement('iframe');
				frame.src = src;
				frame.title = 'Mapa interactivo de Google Maps';
				frame.loading = 'lazy';
				frame.referrerPolicy = 'no-referrer-when-downgrade';
				frame.allowFullscreen = true;
				box.replaceChildren(frame);
			});
		}
	</script>
</body>
</html>
