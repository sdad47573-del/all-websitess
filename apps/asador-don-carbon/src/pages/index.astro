---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import surtido from '../assets/fotos/asador-don-carbon-cuadrada-02.jpg';
import polloPatatas from '../assets/fotos/asador-don-carbon-vertical-04.jpg';
import menuCompleto from '../assets/fotos/asador-don-carbon-vertical-06.jpg';
import polloExtras from '../assets/fotos/asador-don-carbon-vertical-07.jpg';
import costillas from '../assets/fotos/asador-don-carbon-apaisada-03.jpg';
import brasa from '../assets/fotos/asador-don-carbon-apaisada-10.jpg';
import cocina from '../assets/fotos/asador-don-carbon-apaisada-05.jpg';
import pimientos from '../assets/fotos/asador-don-carbon-cuadrada-08.jpg';
import vitrina from '../assets/fotos/asador-don-carbon-vertical-01.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Asador Don Carbón · Pollo asado al carbón en Puerto de la Torre';
const description =
	'Asador Don Carbón, en C. Cirilo Salinas, 7 (Puerto de la Torre, 29190 Málaga). Pollo asado al carbón vegetal, costillas y carnes a la brasa, de jueves a lunes de 11:00 a 15:30.';

const galeria = [
	{
		src: polloPatatas,
		alt: 'Pollo asado troceado en una bandeja de aluminio junto a una ración de patatas y una barra de pan',
	},
	{
		src: surtido,
		alt: 'Una mesa con pollo asado, costillas, salchichas, patatas fritas y varios vasos de salsa',
	},
	{
		src: polloExtras,
		alt: 'Bandeja de pollo asado con patatas, croquetas, ensaladilla, ensalada y pan de un pedido de Don Carbón',
	},
	{
		src: menuCompleto,
		alt: 'Un pedido para llevar con pollo asado, patatas, barra de pan, refresco de naranja y dos salsas',
	},
	{
		src: costillas,
		alt: 'Costillas de cerdo asándose sobre la parrilla con el carbón vegetal al fondo',
	},
	{
		src: brasa,
		alt: 'Una pieza de carne a la brasa sobre la parrilla, con las ascuas encendidas debajo',
	},
	{
		src: cocina,
		alt: 'La cocina del asador con la parrilla de carbón, la freidora y una bandeja de patatas fritas',
	},
	{
		src: pimientos,
		alt: 'Pimientos verdes asados en una bandeja blanca',
	},
	{
		src: vitrina,
		alt: 'La vitrina del local con tarrinas de postres, flanes y ensaladas preparadas',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Asador Don Carbón',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#don-carbon`,
	name: BUSINESS.name,
	alternateName: ['ASADOR DON CARBÓN', 'Don Carbón Puerto de la Torre', 'Asador Don Carbon Málaga'],
	description:
		'Asador de pollo al carbón vegetal y carnes a la brasa en la calle Cirilo Salinas, 7, Puerto de la Torre (29190 Málaga). Comida para llevar de jueves a lunes.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34625893357',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Carnes a la brasa', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Puerto de la Torre' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:00',
			closes: '15:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: false,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: false,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Bucle magnético asistencial',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"asador-don-carbon-cuadrada-02.jpg": surtido,
	"asador-don-carbon-vertical-04.jpg": polloPatatas,
	"asador-don-carbon-vertical-07.jpg": polloExtras,
	"asador-don-carbon-vertical-06.jpg": menuCompleto,
	"asador-don-carbon-apaisada-03.jpg": costillas,
	"asador-don-carbon-apaisada-10.jpg": brasa,
	"asador-don-carbon-apaisada-05.jpg": cocina,
	"asador-don-carbon-cuadrada-08.jpg": pimientos,
	"asador-don-carbon-vertical-01.jpg": vitrina,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#191411" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Manrope:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador Don Carbón, pollo asado al carbón Málaga, pollo asado Puerto de la Torre, costillas a la brasa, carnes a la brasa Málaga, comida para llevar Puerto de la Torre, Cirilo Salinas, asador Don Carbon"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado al carbón vegetal, costillas y carnes a la brasa en la calle Cirilo Salinas, 7, Puerto de la Torre. De jueves a lunes, de 11:00 a 15:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Costillas asándose sobre la parrilla de carbón de Asador Don Carbón"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#191411"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Puerto de la Torre"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[surtido]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Don Carbón"
			subtitle="Pollo al carbón · Puerto de la Torre"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a Don Carbón"
			navAriaLabel="Enlaces de Asador Don Carbón"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34625893357?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carta%20de%20Asador%20Don%20Carb%C3%B3n." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carta de Asador Don Carbón"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
