---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import vitrina from '../assets/fotos/asador-jope-panoramica-01.jpg';
import merluza from '../assets/fotos/asador-jope-panoramica-02.jpg';
import ensaladilla from '../assets/fotos/asador-jope-panoramica-03.jpg';
import carne from '../assets/fotos/asador-jope-panoramica-06.jpg';
import verduras from '../assets/fotos/asador-jope-panoramica-07.jpg';
import polloEnsalada from '../assets/fotos/asador-jope-panoramica-09.jpg';
import migas from '../assets/fotos/asador-jope-vertical-04.jpg';
import bacalao from '../assets/fotos/asador-jope-vertical-05.jpg';
import arroz from '../assets/fotos/asador-jope-vertical-08.jpg';
import ensalada from '../assets/fotos/asador-jope-vertical-10.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Asador Jope · Pollo asado y comida casera en Carretera de Cádiz';
const description =
	'Asador Jope, asador de pollos y comida casera en Pl. de la Luz, 8 (Carretera de Cádiz, 29004 Málaga). Guisos, pescado rebozado, ensaladas y platos de cuchara de miércoles a domingo.';

const galeria = [
	{
		src: vitrina,
		alt: 'La vitrina de Asador Jope con bandejas de crema de patata, carne guisada, salchichas y pollo con champiñones',
	},
	{
		src: merluza,
		alt: 'Bandeja de merluza con pimiento rojo, cebolla y guisantes recién sacada del horno',
	},
	{
		src: ensaladilla,
		alt: 'Cuatro bandejas de la vitrina: ensaladilla rusa, pollo guisado con tomate, arroz y ensalada con salsa',
	},
	{
		src: migas,
		alt: 'Bandeja de migas doradas con pimientos verdes fritos y trozos de chorizo',
	},
	{
		src: bacalao,
		alt: 'Lomos de bacalao rebozado apilados en una bandeja de acero',
	},
	{
		src: verduras,
		alt: 'Bandejas de judías verdes con zanahoria y guisantes, macarrones con tomate y pescado rebozado',
	},
	{
		src: arroz,
		alt: 'Arroz con surimi, huevo cocido, aceitunas y maíz, en una bandeja grande',
	},
	{
		src: ensalada,
		alt: 'Ensalada de tomate, cebolla y pimiento en trozos, aliñada',
	},
	{
		src: carne,
		alt: 'Bandeja de carne guisada en salsa clara con champiñones',
	},
	{
		src: polloEnsalada,
		alt: 'Dos bandejas de la vitrina: pollo con salsa y sésamo, y ensalada de tomate, cebolla y pimiento',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Asador Jope',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#asador-jope`,
	name: BUSINESS.name,
	alternateName: ['Asador Jope Málaga', 'Asador Jope Carretera de Cádiz', 'Comidas Jope'],
	description:
		'Asador de pollos y comida casera en la plaza de la Luz, 8 (Carretera de Cádiz, 29004 Málaga). Guisos de vitrina, pescado rebozado, ensaladas y platos de cuchara al mediodía.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34951155025',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Asador', 'Cocina andaluza'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:30',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2b1c12" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador Jope Málaga, asador de pollos Carretera de Cádiz, comida casera Málaga, platos del día Málaga, bacalao rebozado Málaga, migas Málaga, restaurante económico Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo de asador y comida casera en la plaza de la Luz, 8. Guisos de vitrina, pescado rebozado y ensaladas, de miércoles a domingo al mediodía."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Vitrina de Asador Jope con bandejas de guisos, salchichas y pollo con champiñones"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#2b1c12"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Asador Jope"
			subtitle="Pollo asado y comida casera · Málaga"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Pl. de la Luz, 8 · Carretera de Cádiz"
				title="Pollo de asador <br /><em>y comida de casa.</em>"
				lede={`Asador Jope es la casa de comidas de la plaza de la Luz: pollo asado, guisos de vitrina, pescado rebozado y platos de cuchara al mediodía. Tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={vitrina}
				imageAlt="La vitrina de Asador Jope con bandejas de guisos, salchichas y pollo con champiñones"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>11:30–16:00</b> · mediodía' },
					{ label: 'Cierra', html: '<b>Lunes y martes</b>' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Cocina casera"
			/>

			<LocalChips label="Lo que ofrece Asador Jope" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="La vitrina <br /><em>del mediodía.</em>"
				paragraphs={[
					'Asador Jope está en la plaza de la Luz, 8, en Carretera de Cádiz. Es una de esas casas de comidas de barrio que abren al mediodía, sirven rápido y se llenan de gente que quiere comer bien sin complicarse.',
					'Google lo clasifica como restaurante especializado en pollo, y el asador es la razón de ser de la casa. A su lado, la vitrina va cambiando: pollo guisado con champiñones, carne en salsa, salchichas, migas con pimientos verdes, merluza con guisantes y bacalao rebozado.',
					'Las fotos del local lo enseñan sin adornos: bandejas grandes de acero, cuchara de servir y platos de cuchara. La ensaladilla rusa, el arroz con surimi y huevo y la ensalada de tomate completan una barra en la que se come bien por poco dinero.',
					'Abre de miércoles a domingo, de 11:30 a 16:00, y cierra lunes y martes. Tiene 4,8 sobre 5 con 217 reseñas; las tres opiniones publicadas dan cinco estrellas y repiten las mismas palabras: casero, rápido y económico.',
				]}
				note="La ficha de Google no publica descripción, carta, precios, web ni redes sociales. Los platos que se citan son los que aparecen en las fotografías del local y en las reseñas; esta página no inventa precios."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
					{ label: 'Llamar al asador', href: BUSINESS.phoneHref },
				]}
			/>

			<ul class="highlights">
				{
					HIGHLIGHTS.map((item) => (
						<li>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</li>
					))
				}
			</ul>

			<LocalMenu
				eyebrow="La carta"
				title="Lo que hay <br /><em>en la vitrina.</em>"
				description="Los platos que se ven en las fotografías del local, sin precios ni carta inventada: el menú cambia cada día."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La ficha de Google no incluye carta ni precios. Para saber qué hay hoy, cuánto cuesta el plato y si queda pollo, lo mejor es llamar al 951 15 50 25 antes de ir."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La barra <br /><em>y las bandejas.</em>"
				description="Diez fotografías del perfil de Asador Jope: la vitrina con los guisos, la merluza con pimientos, el bacalao rebozado, las migas, el arroz y las ensaladas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="notas" aria-labelledby="notas-title">
				<div class="wrap notas-grid">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="notas-title">Casi <em>redondo.</em></h2>
						<p class="notas-score">
							<strong>{RATING.label}</strong>
							<span>
								<b>★★★★★</b>
								{RATING.count} reseñas<br />en Google
							</span>
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas ↗
						</a>
					</div>

					<div class="notas-copy">
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<p class="notas-foot">
							Las tres reseñas publicadas en la ficha dan cinco estrellas y coinciden en lo mismo:
							comida casera, servicio rápido y precios bajos. La media es 4,8 porque hay 217
							valoraciones: <a href={MAPS.reviews} target="_blank" rel="noreferrer"
								>el resto se lee en Google ↗</a
							>.
						</p>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la plaza <br /><em>de la Luz.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de miércoles a domingo, de 11:30 a 16:00; lunes y martes cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Asador Jope en la plaza de la Luz, 8, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Pl. de la Luz, 8 · Carretera de Cádiz"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Para mesa o encargos, llama al 951 15 50 25. Google marca acceso para sillas de ruedas y no publica asientos adaptados ni datos de aparcamiento."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma horario y disponibilidad antes de la visita."
			ctaLabel="Llamar a Asador Jope"
			navAriaLabel="Enlaces de Asador Jope"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
