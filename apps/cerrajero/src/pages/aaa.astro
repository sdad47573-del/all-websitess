                <div
                  class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mb-6"
                >
                  <i class="ri-key-line text-2xl text-red-600"></i>
                </div><h3 class="text-xl font-bold text-gray-900 mb-4">
                  Duplicado de Llaves
                </h3><p class="text-gray-600 mb-6 leading-relaxed">
