---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Cerrajero Barato Málaga 24h – Apertura puertas, cambio cerraduras y persianas"
  description="Servicio profesional de cerrajería y persianas en Málaga 24h. Apertura de puertas, cambio de cerraduras, sistemas de seguridad, duplicado de llaves. Teléfono 686 29 89 29."
>
  <div id="root">
    <div class="min-h-screen bg-white">
      <header class="bg-white shadow-lg sticky top-0 z-50">
        <nav class="px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between items-center h-16">
            <div class="flex items-center">
              <h1
                class="text-2xl font-bold text-red-600"
                style="font-family: Pacifico, serif;"
              >
                Cerrajería Pro
              </h1>
            </div><div class="hidden md:block">
              <div class="ml-10 flex items-baseline space-x-8">
                <a
                  href="#inicio"
                  class="text-gray-700 hover:text-red-600 px-3 py-2 text-sm font-medium transition-colors cursor-pointer"
                  >Inicio</a
