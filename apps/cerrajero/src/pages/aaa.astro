									</div>Piezas originales
								</li>
							</ul>
						</div>
					</div><div class="mt-12 text-center">
						<a
							href="#contacto"
							class="inline-flex cursor-pointer items-center gap-2 rounded-lg bg-red-600 px-8 py-4 text-lg font-semibold whitespace-nowrap text-white transition-colors hover:bg-red-700"
							><div class="flex h-5 w-5 items-center justify-center">
