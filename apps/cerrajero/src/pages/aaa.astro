                  href="tel:+34-XXX-XXX-XXX"
                  class="bg-red-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-red-700 transition-colors whitespace-nowrap cursor-pointer"
                  >Llamar Ahora</a
                >
              </div>
            </div><div class="md:hidden">
              <button
                class="text-gray-700 hover:text-red-600 p-2 cursor-pointer"
                ><div class="w-6 h-6 flex items-center justify-center">
                  <i class="ri-menu-line text-xl"></i>
                </div></button
              >
            </div>
          </div>
        </nav>
      </header><main>
        <section
          id="inicio"
          class="relative min-h-screen flex items-center justify-center bg-cover bg-center bg-no-repeat"
          style='background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url("https://readdy.ai/api/search-image?query=Professional%20locksmith%20working%20on%20a%20modern%20door%20lock%20with%20red%20and%20black%20tools%2C%20clean%20workshop%20background%20with%20security%20equipment%2C%20professional%20lighting%2C%20high-quality%20commercial%20photography%20style%2C%20red%20accents%20in%20the%20scene&width=1920&height=1080&seq=hero-locksmith&orientation=landscape");'
        >
          <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center text-white">
              <h2 class="text-4xl md:text-6xl font-bold mb-6 leading-tight">
                <strong>Cerrajería Profesional</strong><br /><span
                  class="text-red-400">Servicio 24 Horas</span
                >
              </h2><p
                class="text-xl md:text-2xl mb-8 max-w-3xl mx-auto leading-relaxed"
              >
                Expertos en <strong>apertura de puertas</strong>, <strong
                  >cambio de cerraduras</strong
                > y <strong>sistemas de seguridad</strong> en Madrid. Atención inmediata
                las 24 horas del día, los 365 días del año.
              </p><div
                class="flex flex-col sm:flex-row gap-4 justify-center items-center"
              >
