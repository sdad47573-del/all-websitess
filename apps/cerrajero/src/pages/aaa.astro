							</div><div class="text-center">
								<div
									class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-red-600"
								>
									<i class="ri-shield-check-line text-2xl text-white"></i>
								</div><h3 class="mb-2 text-lg font-semibold">Sin Daños</h3><p class="text-gray-200">
									Apertura profesional sin dañar
								</p>
							</div><div class="text-center">
								<div
									class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-red-600"
								>
									<i class="ri-speed-up-line text-2xl text-white"></i>
								</div><h3 class="mb-2 text-lg font-semibold">Rápido</h3><p class="text-gray-200">
									Llegamos en 15-30 minutos
								</p>
							</div>
						</div>
					</div>
				</div>
