								href="#contacto"
								class="flex cursor-pointer items-center gap-2 rounded-lg bg-white px-8 py-4 text-lg font-semibold whitespace-nowrap text-red-600 transition-colors hover:bg-gray-100"
								><div class="flex h-5 w-5 items-center justify-center">
									<i class="ri-message-3-fill"></i>
								</div>Solicitar Presupuesto</a
							>
						</div><div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-8 md:grid-cols-3">
