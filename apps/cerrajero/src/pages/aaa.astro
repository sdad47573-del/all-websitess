							<div class="mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-red-100">
								<i class="ri-key-line text-2xl text-red-600"></i>
							</div><h3 class="mb-4 text-xl font-bold text-gray-900">Duplicado de Llaves</h3><p
								class="mb-6 leading-relaxed text-gray-600"
							>
