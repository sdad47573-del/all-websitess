---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Cerrajero Barato Málaga 24h – Apertura puertas, cambio cerraduras y persianas"
	description="Servicio profesional de cerrajería y persianas en Málaga 24h. Apertura de puertas, cambio de cerraduras, sistemas de seguridad, duplicado de llaves. Teléfono 686 29 89 29."
>
	<div class="min-h-screen bg-white">
		<header class="sticky top-0 z-50 bg-white shadow-lg">
			<nav class="px-4 sm:px-6 lg:px-8">
				<div class="flex h-16 items-center justify-between">
					<div class="flex items-center">
						<h1 class="text-2xl font-bold text-red-600" style="font-family: Pacifico, serif;">
							Cerrajería Pro
						</h1>
					</div><div class="hidden md:block">
						<div class="ml-10 flex items-baseline space-x-8">
							<a
								href="#inicio"
								class="cursor-pointer px-3 py-2 text-sm font-medium text-gray-700 transition-colors hover:text-red-600"
								>Inicio</a
