							><a
								href="#contacto"
								class="cursor-pointer px-3 py-2 text-sm font-medium text-gray-700 transition-colors hover:text-red-600"
								>Contacto</a
							><a
								href="tel:+34-XXX-XXX-XXX"
								class="cursor-pointer rounded-lg bg-red-600 px-4 py-2 text-sm font-medium whitespace-nowrap text-white transition-colors hover:bg-red-700"
								>Llamar Ahora</a
							>
						</div>
					</div><div class="md:hidden">
						<button
							class="cursor-pointer p-2 text-gray-700 hover:text-red-600"
							type="button"
							aria-label="Abrir menú"
							><div class="flex h-6 w-6 items-center justify-center">
								<i aria-hidden="true" class="ri-menu-line text-xl"></i>
							</div></button
						>
					</div>
				</div>
			</nav>
		</header><main>
			<section
				id="inicio"
				class="relative flex min-h-screen items-center justify-center bg-cover bg-center bg-no-repeat"
				style='background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url("/img/readdy-rsiphm.avif");'
			>
				<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
					<div class="text-center text-white">
						<h2 class="mb-6 text-4xl leading-tight font-bold md:text-6xl">
							<strong>Cerrajería Profesional</strong><br /><span class="text-red-400"
								>Servicio 24 Horas</span
							>
						</h2><p class="mx-auto mb-8 max-w-3xl text-xl leading-relaxed md:text-2xl">
							Expertos en <strong>apertura de puertas</strong>, <strong>cambio de cerraduras</strong
							> y <strong>sistemas de seguridad</strong> en Madrid. Atención inmediata las 24 horas del
							día, los 365 días del año.
						</p><div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
							<a
								href="tel:+34-XXX-XXX-XXX"
								class="flex cursor-pointer items-center gap-2 rounded-lg bg-red-600 px-8 py-4 text-lg font-semibold whitespace-nowrap text-white transition-colors hover:bg-red-700"
