                class="bg-red-600 text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-red-700 transition-colors inline-flex items-center gap-2 whitespace-nowrap cursor-pointer"
                ><div class="w-5 h-5 flex items-center justify-center">
                  <i class="ri-phone-line"></i>
                </div>Solicitar Servicio</a
              >
            </div>
          </div>
        </section><section id="nosotros" class="py-20 bg-white">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
