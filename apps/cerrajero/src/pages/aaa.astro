									<div class="mr-3 flex h-4 w-4 items-center justify-center">
										<i class="ri-check-line text-red-600"></i>
									</div>Mantenimiento
								</li>
							</ul>
						</div><div class="rounded-xl bg-white p-8 shadow-lg transition-shadow hover:shadow-xl">
