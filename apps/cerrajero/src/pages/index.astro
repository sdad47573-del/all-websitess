---
import Apertura from '../assets/fotos/apertura-puerta.webp';
import Camara from '../assets/fotos/camara.jpg';
import Cambio from '../assets/fotos/cambiocerr.webp';
import Auto from '../assets/fotos/cerrajeria-para-vehiculos.jpg';
import Duplicado from '../assets/fotos/duplicado.jpg';
import Reparacion from '../assets/fotos/reparacion.jpg';
import { Image } from '@astro-components';
import GoogleReviews from '../components/GoogleReviews.astro';
import { MAIL, PHONE, WA_PHONE } from '../data/data.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Cerrajero Barato Málaga 24h – Apertura puertas, cambio cerraduras y persianas"
	description="Servicio profesional de cerrajería y persianas en Málaga 24h. Apertura de puertas, cambio de cerraduras, sistemas de seguridad, duplicado de llaves. Teléfono 686 29 89 29."
>
	<header class="sticky top-0 z-50 w-full bg-white/90 shadow-md backdrop-blur-sm">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="flex items-center justify-between py-4">
				<div class="flex items-center">
					<h1 class="text-2xl font-bold text-gray-900" style="font-family: Pacifico, serif;">
						Cerrajería
						<span class="text-red-600"> DILO </span>
					</h1>
				</div>
				<nav class="hidden space-x-8 lg:flex">
					<a href="#servicios" class="cursor-pointer font-medium text-gray-700 hover:text-red-600"
						>Servicios</a
					><a href="#zonas" class="cursor-pointer font-medium text-gray-700 hover:text-red-600"
						>Zonas</a
					><a href="#contacto" class="cursor-pointer font-medium text-gray-700 hover:text-red-600"
						>Contacto</a
					>
				</nav>
				<div class="flex items-center space-x-4">
					<div class="hidden text-right sm:block">
						<div class="text-lg font-bold text-red-600">
							{PHONE}
						</div><div class="text-sm text-gray-600">24 horas disponible</div>
					</div>
					<a
						href={`tel:${PHONE}`}
						target="_blank"
						class="cursor-pointer rounded-lg bg-red-600 px-6 py-2 font-semibold whitespace-nowrap text-white transition duration-300 hover:bg-red-700" rel="noopener noreferrer"
						>Llamar Ahora</a
					>
				</div>
			</div>
		</div>
	</header>
	<!-- class="relative bg-gradient-to-br from-red-50 to-blue-50 min-h-screen sm:min-h-[85vh] flex items-center" -->
	<section
		id="inicio"
		style='background-image:  url("/img/readdy-m6fa1v.avif");'
	>
		<div
			class="relative flex h-full min-h-screen w-full items-center backdrop-blur-xs sm:min-h-[85vh]"
		>
			<!-- style='background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url("/img/readdy-m6fa1v.avif");' -->
			<!-- style={`background-image: url(${optimized.src}); background-size: cover; background-position: center center;`} -->
			<div class="absolute inset-0 bg-black/40"></div><div
				class="relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8"
			>
				<div class="max-w-3xl">
					<h1 class="mb-6 text-5xl leading-tight font-bold text-white md:text-7xl">
						Cerrajero en Málaga<span class="block text-red-300">24 Horas</span>
					</h1><p class="mb-8 text-xl leading-relaxed text-gray-200 md:text-2xl">
						Servicio de cerrajería y persianas profesional las 24 horas del día. Apertura de
						puertas, cambio de cerraduras, instalación de sistemas de seguridad y mucho más.
					</p><div class="mb-8 flex flex-col gap-4 sm:flex-row">
						<a
							target="_blank"
							href={`tel:${PHONE}`}
							class="rounded-lg bg-red-600 px-8 py-4 text-center text-lg font-semibold text-white transition duration-300 hover:bg-red-700" rel="noopener noreferrer"
							><i class="ri-phone-line mr-2"></i>Llamar {PHONE}</a
						><a
							target="_blank"
							href={`https://wa.me/34${WA_PHONE}`}
							class="cursor-pointer rounded-lg border border-white/20 bg-white/10 px-8 py-4 text-lg font-semibold whitespace-nowrap text-white backdrop-blur-sm transition duration-300 hover:bg-white/20" rel="noopener noreferrer"
							><i class="ri-whatsapp-line mr-2"></i>WhatsApp</a
						>
					</div><div
						class="flex flex-col gap-6 text-white md:flex-row md:flex-wrap md:items-center"
					>
						<div class="flex items-center space-x-2">
							<i class="ri-time-line text-xl text-red-300"></i><span>Disponible urgencias 24/7</span
							>
						</div><div class="flex items-center space-x-2">
							<i class="ri-map-pin-line text-xl text-red-300"></i><span
								>Toda la provincia de Málaga</span
							>
						</div><div class="flex items-center space-x-2">
							<i class="ri-shield-check-line text-xl text-red-300"></i><span>Garantizado</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section id="servicios" class="bg-white py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mb-16 text-center">
				<h2 class="mb-6 text-4xl font-bold text-gray-900 md:text-5xl">Nuestros Servicios</h2><p
					class="mx-auto max-w-3xl text-xl text-gray-600"
				>
					Ofrecemos soluciones completas de cerrajería para hogares, oficinas y automóviles en
					Málaga y provincia.
				</p>
			</div><div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
				<div
					class="cursor-pointer rounded-xl bg-gray-50 p-8 transition duration-300 hover:shadow-lg"
				>
					<div class="relative mb-6">
						<Image
							alt="Apertura de Puertas"
							class="h-48 w-full rounded-lg object-cover object-top"
							src={Apertura}
						/><div class="absolute top-4 left-4 rounded-lg bg-red-600 p-3 text-white">
							<i class="ri-door-open-line text-xl"></i>
						</div>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Apertura de Puertas</h3><p
						class="leading-relaxed text-gray-600"
					>
						Apertura sin daños de todo tipo de puertas y cerraduras. Servicio rápido y profesional.
					</p>
				</div><div
					class="cursor-pointer rounded-xl bg-gray-50 p-8 transition duration-300 hover:shadow-lg"
				>
					<div class="relative mb-6">
						<Image
							alt="Cambio de Cerraduras"
							class="h-48 w-full rounded-lg object-cover object-top"
							src={Cambio}
						/><div class="absolute top-4 left-4 rounded-lg bg-red-600 p-3 text-white">
							<i class="ri-lock-line text-xl"></i>
						</div>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Cambio de Cerraduras</h3><p
						class="leading-relaxed text-gray-600"
					>
						Instalación y cambio de cerraduras de alta seguridad. Mejora la protección de tu hogar.
					</p>
				</div><div
					class="cursor-pointer rounded-xl bg-gray-50 p-8 transition duration-300 hover:shadow-lg"
				>
					<div class="relative mb-6">
						<Image
							alt="Cerrajería del Automóvil"
							class="h-48 w-full rounded-lg object-cover object-top"
							src={Auto}
						/><div class="absolute top-4 left-4 rounded-lg bg-red-600 p-3 text-white">
							<i class="ri-car-line text-xl"></i>
						</div>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Cerrajería del Automóvil</h3><p
						class="leading-relaxed text-gray-600"
					>
						Apertura de coches, programación de llaves, reparación de sistemas de arranque.
					</p>
				</div><div
					class="cursor-pointer rounded-xl bg-gray-50 p-8 transition duration-300 hover:shadow-lg"
				>
					<div class="relative mb-6">
						<Image
							alt="Sistemas de Seguridad"
							class="h-48 w-full rounded-lg object-cover object-top"
							src={Camara}
						/><div class="absolute top-4 left-4 rounded-lg bg-red-600 p-3 text-white">
							<i class="ri-shield-line text-xl"></i>
						</div>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Sistemas de Seguridad</h3><p
						class="leading-relaxed text-gray-600"
					>
						Instalación de sistemas de seguridad, cámaras, alarmas y control de acceso.
					</p>
				</div><div
					class="cursor-pointer rounded-xl bg-gray-50 p-8 transition duration-300 hover:shadow-lg"
				>
					<div class="relative mb-6">
						<Image
							alt="Reparaciones"
							class="h-48 w-full rounded-lg object-cover object-top"
							src={Reparacion}
						/><div class="absolute top-4 left-4 rounded-lg bg-red-600 p-3 text-white">
							<i class="ri-tools-line text-xl"></i>
						</div>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Reparaciones</h3><p
						class="leading-relaxed text-gray-600"
					>
						Reparación de cerraduras dañadas, mantenimiento preventivo y ajustes.
					</p>
				</div><div
					class="cursor-pointer rounded-xl bg-gray-50 p-8 transition duration-300 hover:shadow-lg"
				>
					<div class="relative mb-6">
						<Image
							alt="Duplicado de Llaves"
							class="h-48 w-full rounded-lg object-cover object-top"
							src={Duplicado}
						/><div class="absolute top-4 left-4 rounded-lg bg-red-600 p-3 text-white">
							<i class="ri-key-line text-xl"></i>
						</div>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Duplicado de Llaves</h3><p
						class="leading-relaxed text-gray-600"
					>
						Duplicado de llaves de todo tipo, llaves de seguridad y llaves especiales.
					</p>
				</div>
			</div>
		</div>
	</section>
	<section class="bg-gradient-to-br from-red-600 to-purple-600 py-20 text-white">
		<div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
			<div class="mx-auto max-w-4xl">
				<h2 class="mb-6 text-4xl font-bold md:text-5xl">¿Emergencia? Te Ayudamos</h2><p
					class="mb-8 text-xl opacity-90"
				>
					Nuestro equipo está disponible las 24 horas del día, los 7 días de la semana. No importa
					la hora, estamos aquí para resolver tu problema de cerrajería.
				</p><div class="mb-12 flex flex-col flex-wrap justify-center gap-6 sm:flex-row">
					<div class="flex items-center justify-center gap-3">
						<i class="ri-time-line text-2xl text-red-100"></i><span class="text-lg"
							>Respuesta en 30 minutos</span
						>
					</div><div class="flex items-center justify-center gap-3">
						<i class="ri-map-pin-line text-2xl text-red-100"></i><span class="text-lg"
							>Cobertura total Málaga</span
						>
					</div><div class="flex items-center justify-center gap-3">
						<i class="ri-shield-check-line text-2xl text-red-100"></i><span class="text-lg"
							>Trabajo garantizado</span
						>
					</div>
				</div><a
					target="_blank"
					href={`tel:${PHONE}`}
					class="flex w-fit cursor-pointer flex-wrap justify-center gap-2 justify-self-center rounded-lg bg-white px-12 py-4 text-xl font-bold text-red-600 transition duration-300 hover:bg-gray-100" rel="noopener noreferrer"
				>
					<span>
						<i class="ri-phone-line mr-3"></i>Llamar Ahora:
					</span>
					<span>
						{PHONE}
					</span>
				</a>
			</div>
		</div>
	</section>
	<GoogleReviews />

	<section id="zonas" class="bg-gray-50 py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mb-16 text-center">
				<h2 class="mb-6 text-4xl font-bold text-gray-900 md:text-5xl">Zonas de Cobertura</h2><p
					class="mx-auto max-w-3xl text-xl text-gray-600"
				>
					Ofrecemos nuestros servicios de cerrajería en toda la provincia de Málaga y alrededores.
				</p>
			</div>

			<div class="grid items-start gap-12 md:grid-cols-2">
				<div class="flex flex-wrap justify-center gap-4 pb-4 md:justify-end">
					<!-- <div class="grid grid-cols-1 md:grid-cols-1 gap-4"> -->
					{
						[
							'Centro',
							'Málaga Este',
							'Ciudad Jardín',
							'Bailén-Miraflores',
							'Palma-Palmilla',
							'Cruz de Humilladero',
							'Carretera de Cádiz',
							'Churriana',
							'Campanillas',
							'Puerto de la Torre',
							'Teatinos-Universidad',
						].map((c) => (
							<div class="flex cursor-pointer items-center gap-2 rounded-lg border border-gray-200 bg-white p-2 text-center shadow-sm transition duration-300 hover:shadow-md">
								<>
									<i class="ri-map-pin-line text-lg text-red-600" />
									<div class="font-semibold text-gray-900">{c}</div>
								</>
							</div>
						))
					}
				</div>
				<div class="flex flex-wrap justify-center gap-4 pb-4 md:justify-start">
					<!-- <div class="grid grid-cols-1 md:grid-cols-1 gap-4"> -->
					{
						[
							'Málaga Centro',
							'Marbella',
							'Fuengirola',
							'Torremolinos',
							'Benalmádena',
							'Mijas',
							'Estepona',
							'Ronda',
							'Antequera',
							'Vélez-Málaga',
							'Nerja',
							'Manilva',
							'Casares',
							'Coín',
							'Alhaurín',
							'Churriana',
						].map((c) => (
							<div class="flex cursor-pointer items-center gap-2 rounded-lg border border-gray-200 bg-white p-2 text-center shadow-sm transition duration-300 hover:shadow-md">
								<i class="ri-map-pin-line text-lg text-red-600" />
								<div class="font-semibold text-gray-900">{c}</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>
	<section id="contacto" class="bg-gray-50 py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mb-16 text-center">
				<h2 class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">
					<strong>Contacta</strong> con <span class="text-red-600">Nosotros</span>
				</h2><p class="mx-auto max-w-3xl text-xl text-gray-600">
					¿Necesitas un <strong>cerrajero en Madrid</strong>? Contáctanos ahora para recibir<strong>
						atención inmediata</strong
					> o solicita un
					<strong>presupuesto gratuito</strong>.
				</p>
			</div><div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
				<div>
					<h3 class="mb-8 text-2xl font-bold text-gray-900">Información de Contacto</h3><div
						class="mb-8 space-y-6"
					>
						<div class="flex items-start">
							<div
								class="mr-4 flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100"
							>
								<i class="ri-phone-line text-xl text-red-600"></i>
							</div><div>
								<h4 class="mb-1 font-semibold text-gray-900">Teléfono de Emergencia</h4><p
									class="text-gray-600"
								>
									{PHONE}
								</p><p class="text-sm text-red-600">Disponible 24/7</p>
							</div>
						</div><div class="flex items-start">
							<div
								class="mr-4 flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100"
							>
								<i class="ri-map-pin-line text-xl text-red-600"></i>
							</div><div>
								<h4 class="mb-1 font-semibold text-gray-900">Dirección</h4><p class="text-gray-600">
									C. Barón de les, Bailén-Miraflores,<br />29010 Málaga
								</p>
							</div>
						</div><div class="flex items-start">
							<div
								class="mr-4 flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100"
							>
								<i class="ri-mail-line text-xl text-red-600"></i>
							</div><div>
								<h4 class="mb-1 font-semibold text-gray-900">Email</h4><p class="text-gray-600">
									{MAIL}
								</p>
							</div>
						</div><div class="flex items-start">
							<div
								class="mr-4 flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100"
							>
								<i class="ri-time-line text-xl text-red-600"></i>
							</div><div>
								<h4 class="mb-1 font-semibold text-gray-900">Horario</h4><p class="text-gray-600">
									Lunes a viernes <br />Mañanas: 9:00 AM - 2:00 PM <br />Tardes: 4:00 PM - 8:00 PM
									<!-- 24 horas, 7 días a la semana -->
								</p><p class="text-sm text-red-600">Servicio de emergencia 24/7H</p>
							</div>
						</div>
					</div>
				</div>
				<div class="">
					<!-- <h3 class="text-2xl font-bold text-gray-900 mb-4">
              Nos encontramos en
            </h3> -->
					<div class="aspect-video overflow-hidden rounded-lg">
						<!-- width="400"
            height="300" -->
						<!-- width="600"
            height="450" -->
						<div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
							<button type="button" data-cargar-mapa aria-label="Cargar mapa interactivo" style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
								<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
								<strong style="font-size:1rem;">Cargar mapa interactivo</strong>
								<small style="opacity:0.65;">Se carga solo al pulsar</small>
							</button>
<iframe
						 data-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3197.7894200296087!2d-4.442662168867017!3d36.72761834831435!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd72f7a885879cbd%3A0xf705aeef156b1277!2sCerrajer%C3%ADa%20DILO!5e0!3m2!1ses!2ses!4v1762354894071!5m2!1ses!2ses"
							title="Mapa con la ubicación del negocio"
							width="100%"
							height="100%"
							allowfullscreen=""
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							style="border: 0px;"></iframe>
						</div>
					</div>
					<div class="rounded-lg bg-red-50 p-6">
						<h4 class="mb-2 font-semibold text-red-800">¿Emergencia?</h4><p
							class="mb-4 text-red-700"
						>
							Si estás bloqueado fuera de casa, llámanos directamente para atención inmediata.
						</p><a
							href="tel:+34-XXX-XXX-XXX"
							class="inline-flex cursor-pointer items-center gap-2 rounded-lg bg-red-600 px-6 py-3 font-semibold whitespace-nowrap text-white transition-colors hover:bg-red-700"
							><div class="flex h-5 w-5 items-center justify-center">
								<i class="ri-phone-fill"></i>
							</div>Llamar Ahora</a
						>
					</div>
				</div>

				<!-- <div class="bg-white rounded-xl shadow-lg p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-6">
              Solicitar Presupuesto
            </h3>
          </div> -->
			</div>
		</div>
	</section>
	<footer class="bg-gray-900 text-white">
		<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 gap-8 md:grid-cols-4">
				<div class="md:col-span-2">
					<h3 class="mb-4 text-2xl font-bold" style="font-family: Pacifico, serif;">
						Cerrajería DILO
					</h3><p class="mb-6 leading-relaxed text-gray-300">
						Somos tu empresa de confianza para todos los servicios de cerrajería en Madrid. Con más
						de 15 años de experiencia, ofrecemos soluciones profesionales las 24 horas del día.
					</p><div class="flex space-x-4">
						<a
							href="https://www.facebook.com/p/Cerrajeria-dilo-100066395478511/"
							class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-red-600 transition-colors hover:bg-red-700"
							aria-label="Facebook"><i aria-hidden="true" class="ri-facebook-fill"></i></a
						><a
							href="https://ucaseguridad.es/localiza-a-tu-cerrajero-ucas/cerrajeria-dilo/"
							aria-label="Cerrajeria Dilo en UCASeguridad"
							class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-red-600 transition-colors hover:bg-red-700"
							><i class="ri-shield-keyhole-line" aria-hidden="true"></i></a
						>
					</div>
				</div><div>
					<h4 class="mb-4 text-lg font-semibold">Servicios</h4><ul class="space-y-2 text-gray-300">
						<li>
							<a href="#servicios" class="cursor-pointer transition-colors hover:text-red-400"
								>Apertura de Puertas</a
							>
						</li><li>
							<a href="#servicios" class="cursor-pointer transition-colors hover:text-red-400"
								>Cambio de Cerraduras</a
