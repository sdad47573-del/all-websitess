                  <i class="ri-phone-line text-red-600 text-xl"></i>
                </div><div>
                  <h4 class="font-semibold text-gray-900 mb-1">
                    Teléfono de Emergencia
                  </h4><p class="text-gray-600">{PHONE}</p><p
                    class="text-sm text-red-600"
                  >
                    Disponible 24/7
                  </p>
                </div>
              </div><div class="flex items-start">
                <div
                  class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mr-4 flex-shrink-0"
                >
                  <i class="ri-map-pin-line text-red-600 text-xl"></i>
                </div><div>
                  <h4 class="font-semibold text-gray-900 mb-1">Dirección</h4><p
                    class="text-gray-600"
