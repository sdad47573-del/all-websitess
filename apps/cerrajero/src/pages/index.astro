---
import Layout from "../layouts/Layout.astro";

import GoogleReviews from "../components/GoogleReviews.astro";
import { MAIL, PHONE, WA_PHONE } from "../data/data.astro";

import Hero from "../assets/hero.jpg";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

import Camara from "../assets/camara.jpg";
import Apertura from "../assets/apertura-puerta.webp";
import Auto from "../assets/cerrajeria-para-vehiculos.jpg";
import Duplicado from "../assets/duplicado.jpg";
import Cambio from "../assets/cambiocerr.webp";
import Reparacion from "../assets/reparacion.jpg";

import { getImage } from "astro:assets";
import { Image } from "astro:assets";

const optimized = await getImage({ src: Hero, width: 1200, format: "webp" });
---

<Layout
  title="Cerrajero Barato Málaga 24h – Apertura puertas, cambio cerraduras y persianas"
  description="Servicio profesional de cerrajería y persianas en Málaga 24h. Apertura de puertas, cambio de cerraduras, sistemas de seguridad, duplicado de llaves. Teléfono 686 29 89 29."
>
  <div class="min-h-screen bg-white">
    <header
      class="bg-white/90 backdrop-blur-sm shadow-md sticky w-full top-0 z-50"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-4">
          <div class="flex items-center">
            <h1
              class="text-2xl font-bold text-gray-900"
              style="font-family: Pacifico, serif;"
            >
              Cerrajería
              <span class="text-red-600"> DILO </span>
            </h1>
          </div>
          <nav class="hidden lg:flex space-x-8">
            <a
              href="#servicios"
              class="text-gray-700 hover:text-red-600 font-medium cursor-pointer"
              >Servicios</a
            ><a
              href="#zonas"
              class="text-gray-700 hover:text-red-600 font-medium cursor-pointer"
              >Zonas</a
            ><a
              href="#contacto"
              class="text-gray-700 hover:text-red-600 font-medium cursor-pointer"
              >Contacto</a
            >
          </nav>
          <div class="flex items-center space-x-4">
            <div class="hidden sm:block text-right">
              <div class="text-red-600 font-bold text-lg">
                {PHONE}
              </div><div class="text-sm text-gray-600">24 horas disponible</div>
            </div>
            <a
              href={`tel:${PHONE}`}
              target="_blank"
              class="bg-red-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-red-700 transition duration-300 whitespace-nowrap cursor-pointer"
              >Llamar Ahora</a
            >
          </div>
        </div>
      </div>
    </header>
    <!-- class="relative bg-gradient-to-br from-red-50 to-blue-50 min-h-screen sm:min-h-[85vh] flex items-center" -->
    <section
      id="inicio"
      style='background-image:  url("https://readdy.ai/api/search-image?query=Professional%20locksmith%20workshop%20with%20modern%20security%20equipment%2C%20keys%20hanging%20on%20wall%2C%20professional%20tools%2C%20warm%20lighting%2C%20clean%20organized%20workspace%2C%20security%20locks%20and%20hardware%20displayed%2C%20industrial%20yet%20welcoming%20atmosphere%2C%20high%20quality%20professional%20photography&width=1920&height=1080&seq=hero-cerrajeria&orientation=landscape");'
    >
      <div
        class="relative backdrop-blur-xs flex items-center w-full h-full min-h-screen sm:min-h-[85vh]"
      >
        <!-- style='background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url("https://readdy.ai/api/search-image?query=Professional%20locksmith%20workshop%20with%20modern%20security%20equipment%2C%20keys%20hanging%20on%20wall%2C%20professional%20tools%2C%20warm%20lighting%2C%20clean%20organized%20workspace%2C%20security%20locks%20and%20hardware%20displayed%2C%20industrial%20yet%20welcoming%20atmosphere%2C%20high%20quality%20professional%20photography&width=1920&height=1080&seq=hero-cerrajeria&orientation=landscape");' -->
        <!-- style={`background-image: url(${optimized.src}); background-size: cover; background-position: center center;`} -->
        <div class="absolute inset-0 bg-black/40"></div><div
          class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full"
        >
          <div class="max-w-3xl">
            <h1
              class="text-5xl md:text-7xl font-bold text-white mb-6 leading-tight"
            >
              Cerrajero en Málaga<span class="block text-red-300">24 Horas</span
              >
            </h1><p
              class="text-xl md:text-2xl text-gray-200 mb-8 leading-relaxed"
            >
              Servicio de cerrajería y persianas profesional las 24 horas del
              día. Apertura de puertas, cambio de cerraduras, instalación de
              sistemas de seguridad y mucho más.
            </p><div class="flex flex-col sm:flex-row gap-4 mb-8">
              <a
                target="_blank"
                href={`tel:${PHONE}`}
                class="bg-red-600 text-white text-center px-8 py-4 rounded-lg text-lg font-semibold hover:bg-red-700 transition duration-300"
                ><i class="ri-phone-line mr-2"></i>Llamar {PHONE}</a
              ><a
                target="_blank"
                href={`https://wa.me/34${WA_PHONE}`}
                class="bg-white/10 backdrop-blur-sm text-white border border-white/20 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-white/20 transition duration-300 whitespace-nowrap cursor-pointer"
                ><i class="ri-whatsapp-line mr-2"></i>WhatsApp</a
              >
            </div><div
              class="flex flex-col md:flex-row md:flex-wrap md:items-center gap-6 text-white"
            >
              <div class="flex items-center space-x-2">
                <i class="ri-time-line text-red-300 text-xl"></i><span
                  >Disponible urgencias 24/7</span
                >
              </div><div class="flex items-center space-x-2">
                <i class="ri-map-pin-line text-red-300 text-xl"></i><span
                  >Toda la provincia de Málaga</span
                >
              </div><div class="flex items-center space-x-2">
                <i class="ri-shield-check-line text-red-300 text-xl"></i><span
                  >Garantizado</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section id="servicios" class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Nuestros Servicios
          </h2><p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Ofrecemos soluciones completas de cerrajería para hogares, oficinas
            y automóviles en Málaga y provincia.
          </p>
        </div><div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div
            class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition duration-300 cursor-pointer"
          >
            <div class="relative mb-6">
              <Image
                alt="Apertura de Puertas"
                class="w-full h-48 object-cover object-top rounded-lg"
                src={Apertura}
              /><div
                class="absolute top-4 left-4 bg-red-600 text-white p-3 rounded-lg"
              >
                <i class="ri-door-open-line text-xl"></i>
              </div>
            </div><h3 class="text-xl font-bold text-gray-900 mb-4">
              Apertura de Puertas
            </h3><p class="text-gray-600 leading-relaxed">
              Apertura sin daños de todo tipo de puertas y cerraduras. Servicio
              rápido y profesional.
            </p>
          </div><div
            class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition duration-300 cursor-pointer"
          >
            <div class="relative mb-6">
              <Image
                alt="Cambio de Cerraduras"
                class="w-full h-48 object-cover object-top rounded-lg"
                src={Cambio}
              /><div
                class="absolute top-4 left-4 bg-red-600 text-white p-3 rounded-lg"
              >
                <i class="ri-lock-line text-xl"></i>
              </div>
            </div><h3 class="text-xl font-bold text-gray-900 mb-4">
              Cambio de Cerraduras
            </h3><p class="text-gray-600 leading-relaxed">
              Instalación y cambio de cerraduras de alta seguridad. Mejora la
              protección de tu hogar.
            </p>
          </div><div
            class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition duration-300 cursor-pointer"
          >
            <div class="relative mb-6">
              <Image
                alt="Cerrajería del Automóvil"
                class="w-full h-48 object-cover object-top rounded-lg"
                src={Auto}
              /><div
                class="absolute top-4 left-4 bg-red-600 text-white p-3 rounded-lg"
              >
                <i class="ri-car-line text-xl"></i>
              </div>
            </div><h3 class="text-xl font-bold text-gray-900 mb-4">
              Cerrajería del Automóvil
            </h3><p class="text-gray-600 leading-relaxed">
              Apertura de coches, programación de llaves, reparación de sistemas
              de arranque.
            </p>
          </div><div
            class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition duration-300 cursor-pointer"
          >
            <div class="relative mb-6">
              <Image
                alt="Sistemas de Seguridad"
                class="w-full h-48 object-cover object-top rounded-lg"
                src={Camara}
              /><div
                class="absolute top-4 left-4 bg-red-600 text-white p-3 rounded-lg"
              >
                <i class="ri-shield-line text-xl"></i>
              </div>
            </div><h3 class="text-xl font-bold text-gray-900 mb-4">
              Sistemas de Seguridad
            </h3><p class="text-gray-600 leading-relaxed">
              Instalación de sistemas de seguridad, cámaras, alarmas y control
              de acceso.
            </p>
          </div><div
            class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition duration-300 cursor-pointer"
          >
            <div class="relative mb-6">
              <Image
                alt="Reparaciones"
                class="w-full h-48 object-cover object-top rounded-lg"
                src={Reparacion}
              /><div
                class="absolute top-4 left-4 bg-red-600 text-white p-3 rounded-lg"
              >
                <i class="ri-tools-line text-xl"></i>
              </div>
            </div><h3 class="text-xl font-bold text-gray-900 mb-4">
              Reparaciones
            </h3><p class="text-gray-600 leading-relaxed">
              Reparación de cerraduras dañadas, mantenimiento preventivo y
              ajustes.
            </p>
          </div><div
            class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition duration-300 cursor-pointer"
          >
            <div class="relative mb-6">
              <Image
                alt="Duplicado de Llaves"
                class="w-full h-48 object-cover object-top rounded-lg"
                src={Duplicado}
              /><div
                class="absolute top-4 left-4 bg-red-600 text-white p-3 rounded-lg"
              >
                <i class="ri-key-line text-xl"></i>
              </div>
            </div><h3 class="text-xl font-bold text-gray-900 mb-4">
              Duplicado de Llaves
            </h3><p class="text-gray-600 leading-relaxed">
              Duplicado de llaves de todo tipo, llaves de seguridad y llaves
              especiales.
            </p>
          </div>
        </div>
      </div>
    </section>
    <section
