---
import { Image } from "astro:assets";

import UnnamedImg from "../assets/unnamed (1).png";
import Unnamed2Img from "../assets/unnamed (2).png";
import VerifiedImg from "../assets/verified.png";
import GoogleImg from "../assets/google.webp";
import GoogleIcon from "../icons/GoogleIcon.astro";

const a = {
  profile_photo: Unnamed2Img,
  author_name: "Beatriz Cornejo",
  rating: 5,

  text: "Estoy muy contenta con el cambio del bombín de la puerta de mi casa, también me ha arreglado una persiana que tenía rota. Es muy económico y eficiente en su trabajo, y lo que más me ha gustado es que no he tenido que esperar para que venga a mi casa además me a arreglado las bisagras y me a desarmado la cerradura para limpiarla y engrasarla también me a instalado un cerrojo en la puerta de mi casa para tener mayor seguridad lo recomiendo totalmente muy rápido y amable me a cobrado un precio justo sin lugar a duda lo volveré a llamar en otra ocasión",
};

const b = {
  profile_photo: UnnamedImg,
  author_name: "Juana Martin amador",
  rating: 5,

  text: "Me cambio la cerradura de casa aquí en Málaga vino super rápido y me abrió y instalo una cerradura tesa con su bombín de seguridad y escudo lo recomiendo totalmente fue rápido y me le y me cobró un precio justo lo volveré a llamar sin dudarlo gran profesional aquí en Málaga capital",
};

const reviews = [a, b];
const review_url =
  "https://www.google.com/maps/place/Cerrajero+M%C3%A1laga+barato/@36.7313716,-4.4291733,17z/data=!4m8!3m7!1s0xd72f78298284299:0x4cd387e477b60e15!8m2!3d36.7313716!4d-4.4291733!9m1!1b1!16s%2Fg%2F11s3cq_6qs?entry=ttu&g_ep=EgoyMDI1MTAxMy4wIKXMDSoASAFQAw%3D%3D";
---

<div class="container mx-auto flex gap-4 px-4 py-30 flex-col text-gray-900">
  <div class="text-center mb-16">
    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
      Opiniones de clientes
    </h2><p class="text-xl text-gray-600 max-w-3xl mx-auto">
      Reseñas reales de Google
    </p>
  </div>
  <div
    class="flex gap-20 flex-col-reverse md:flex-row justify-center items-center"
  >
    <div class="flex flex-col items-center">
      <p class="text-2xl font-bold">EXCELENTE</p>
      <div class="text-3xl">{"⭐".repeat(5)}</div>
      <p class="pb-2 pt-4">
        A base de <span class="font-bold">131 reseñas</span>
      </p>
      <Image src={GoogleImg} alt="" class="h-9 w-auto object-contain mb-4" />
      <!-- class="btn btn-accent btn-sm btn-wide" -->
      <a
        class="bg-teal-600 text-white text-center px-8 md:px-6 py-4 rounded-lg text-lg font-semibold hover:bg-teal-700 transition duration-300"
        href={review_url}
        target="_blank">Ver más reseñas</a
      >
    </div>
    <div class="flex gap-4 flex-col md:flex-row relative">
      <a
        target="_blank"
        class="bg-teal-600 text-white rounded-full text-center px-3 py-2 text-lg font-semibold hover:bg-teal-700 transition duration-300 absolute top-1/2 -right-7 hidden md:flex"
        href={review_url}
      >
        <i class="ri-arrow-right-s-line"></i>
      </a>
      <a
        target="_blank"
        class="bg-teal-600 text-white rounded-full text-center px-3 py-2 text-lg font-semibold hover:bg-teal-700 transition duration-300 absolute top-1/2 -left-7 hidden md:flex"
        href={review_url}
      >
        <i class="ri-arrow-left-s-line"></i>
      </a>
      {
        reviews.slice(0, 2).map((r) => (
          <div class="max-w-96  w-full p-4 border rounded-2xl bg-white  shadow-sm border-gray-200  hover:shadow-md transition duration-300 cursor-pointer">
            <div class="flex justify-between">
              <div class="flex">
                <Image
                  src={r.profile_photo}
                  alt={r.author_name}
                  class="size-10 mr-3.5"
                />
                <p class="font-bold">{r.author_name}</p>
              </div>
              <GoogleIcon class="size-5" />
            </div>
            <div class="flex items-center gap-2 py-2.5">
              {"⭐".repeat(r.rating)}

              <Image src={VerifiedImg} alt="" class="size-4" />
            </div>
            <p class="text overflow-hidden text-ellipsis line-clamp-7">
              {r.text}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</div>
