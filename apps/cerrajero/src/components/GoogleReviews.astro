---
import { Image } from "astro:assets";

import Unnamed2Img from "../assets/unnamed (1).png";
import UnnamedImg from "../assets/unnamed (2).png";
import VerifiedImg from "../assets/verified.png";
import GoogleImg from "../assets/google.webp";
import GoogleIcon from "../icons/GoogleIcon.astro";

const a = {
  profile_photo: Unnamed2Img,
  author_name: "F. Miguel C. O.",
  rating: 5,

  text: "Excelente cerrajería, sin duda es una muy buena opción. Solucionaron mi problema en un momento y con una relación calidad precio inmejorable. Para cualquier problema de cerraduras y mandos a distancia, siempre volveré a ellos.",
};

const b = {
  profile_photo: UnnamedImg,
  author_name: "Alberto Navarro",
  rating: 5,

  text: "Muy recomendable, tanto por el trato recibido como por el servicio que prestan. Hice la copia de un mando del garaje y me funcionó a la primera. Sin duda lo recomiendo a todo el mundo.",
};

const reviews = [a, b];
const review_url =
  "https://www.google.com/maps/place/Cerrajer%C3%ADa+DILO/@36.7281186,-4.4435927,17.59z/data=!4m8!3m7!1s0xd72f7a885879cbd:0xf705aeef156b1277!8m2!3d36.7276155!4d-4.4409454!9m1!1b1!16s%2Fg%2F11x0qh9j12?entry=ttu&g_ep=EgoyMDI1MTAyOS4yIKXMDSoASAFQAw%3D%3D";
---

<div class="container mx-auto flex gap-4 px-4 py-30 flex-col text-gray-900">
  <div class="text-center mb-16">
    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
      Opiniones de clientes
    </h2><p class="text-xl text-gray-600 max-w-3xl mx-auto">
      Reseñas reales de Google
    </p>
  </div>
  <div
    class="flex gap-20 flex-col-reverse md:flex-row justify-center items-center"
  >
    <div class="flex flex-col items-center">
      <p class="text-2xl font-bold">EXCELENTE</p>
      <div class="text-3xl">{"⭐".repeat(5)}</div>
      <p class="pb-2 pt-4">
        A base de <span class="font-bold">45 reseñas</span>
      </p>
      <Image src={GoogleImg} alt="" class="h-9 w-auto object-contain mb-4" />
      <!-- class="btn btn-accent btn-sm btn-wide" -->
      <a
        class="bg-red-600 text-white text-center px-8 md:px-6 py-4 rounded-lg text-lg font-semibold hover:bg-red-700 transition duration-300"
        href={review_url}
        target="_blank">Ver más reseñas</a
      >
    </div>
    <div class="flex gap-4 flex-col md:flex-row relative">
      <a
        target="_blank"
        class="bg-red-600 text-white rounded-full text-center px-3 py-2 text-lg font-semibold hover:bg-red-700 transition duration-300 absolute top-1/2 -right-7 hidden md:flex"
        href={review_url}
      >
        <i class="ri-arrow-right-s-line"></i>
      </a>
      <a
        target="_blank"
        class="bg-red-600 text-white rounded-full text-center px-3 py-2 text-lg font-semibold hover:bg-red-700 transition duration-300 absolute top-1/2 -left-7 hidden md:flex"
        href={review_url}
      >
        <i class="ri-arrow-left-s-line"></i>
      </a>
      {
        reviews.slice(0, 2).map((r) => (
          <div class="max-w-96  w-full p-4 border rounded-2xl bg-white  shadow-sm border-gray-200  hover:shadow-md transition duration-300 cursor-pointer">
            <div class="flex justify-between">
              <div class="flex">
                <Image
                  src={r.profile_photo}
                  alt={r.author_name}
                  class="size-10 mr-3.5"
                />
                <p class="font-bold">{r.author_name}</p>
              </div>
              <GoogleIcon class="size-5" />
            </div>
            <div class="flex items-center gap-2 py-2.5">
              {"⭐".repeat(r.rating)}

              <Image src={VerifiedImg} alt="" class="size-4" />
            </div>
            <p class="text overflow-hidden text-ellipsis line-clamp-7">
              {r.text}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</div>
