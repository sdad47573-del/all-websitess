---
import { Image } from 'astro:assets';

import { GoogleIcon } from '@astro-icons';

import GoogleImg from '../assets/google.webp';
import Unnamed2Img from '../assets/unnamed (1).png';
import UnnamedImg from '../assets/unnamed (2).png';
import VerifiedImg from '../assets/verified.png';

const a = {
	profile_photo: Unnamed2Img,
	author_name: 'F. Miguel C. O.',
	rating: 5,

	text: 'Excelente cerrajería, sin duda es una muy buena opción. Solucionaron mi problema en un momento y con una relación calidad precio inmejorable. Para cualquier problema de cerraduras y mandos a distancia, siempre volveré a ellos.',
};

const b = {
	profile_photo: UnnamedImg,
	author_name: 'Alberto Navarro',
	rating: 5,

	text: 'Muy recomendable, tanto por el trato recibido como por el servicio que prestan. Hice la copia de un mando del garaje y me funcionó a la primera. Sin duda lo recomiendo a todo el mundo.',
};

const reviews = [a, b];
const review_url =
	'https://www.google.com/maps/place/Cerrajer%C3%ADa+DILO/@36.7281186,-4.4435927,17.59z/data=!4m8!3m7!1s0xd72f7a885879cbd:0xf705aeef156b1277!8m2!3d36.7276155!4d-4.4409454!9m1!1b1!16s%2Fg%2F11x0qh9j12?entry=ttu&g_ep=EgoyMDI1MTAyOS4yIKXMDSoASAFQAw%3D%3D';
---

<div class="container mx-auto flex flex-col gap-4 px-4 py-30 text-gray-900">
	<div class="mb-16 text-center">
		<h2 class="mb-6 text-4xl font-bold text-gray-900 md:text-5xl">Opiniones de clientes</h2><p
			class="mx-auto max-w-3xl text-xl text-gray-600"
		>
			Reseñas reales de Google
		</p>
	</div>
	<div class="flex flex-col-reverse items-center justify-center gap-20 md:flex-row">
		<div class="flex flex-col items-center">
			<p class="text-2xl font-bold">EXCELENTE</p>
			<div class="text-3xl">{'⭐'.repeat(5)}</div>
			<p class="pt-4 pb-2">
				A base de <span class="font-bold">45 reseñas</span>
			</p>
			<Image src={GoogleImg} alt="" class="mb-4 h-9 w-auto object-contain" />
			<!-- class="btn btn-accent btn-sm btn-wide" -->
			<a
				class="rounded-lg bg-red-600 px-8 py-4 text-center text-lg font-semibold text-white transition duration-300 hover:bg-red-700 md:px-6"
				href={review_url}
				target="_blank">Ver más reseñas</a
			>
		</div>
		<div class="relative flex flex-col gap-4 md:flex-row">
			<a
				target="_blank"
				class="absolute top-1/2 -right-7 hidden rounded-full bg-red-600 px-3 py-2 text-center text-lg font-semibold text-white transition duration-300 hover:bg-red-700 md:flex"
				href={review_url}
			>
				<i class="ri-arrow-right-s-line"></i>
			</a>
			<a
				target="_blank"
				class="absolute top-1/2 -left-7 hidden rounded-full bg-red-600 px-3 py-2 text-center text-lg font-semibold text-white transition duration-300 hover:bg-red-700 md:flex"
				href={review_url}
			>
				<i class="ri-arrow-left-s-line"></i>
			</a>
			{
				reviews.slice(0, 2).map((r) => (
					<div class="w-full max-w-96 cursor-pointer rounded-2xl border border-gray-200 bg-white p-4 shadow-sm transition duration-300 hover:shadow-md">
						<div class="flex justify-between">
							<div class="flex">
								<Image src={r.profile_photo} alt={r.author_name} class="mr-3.5 size-10" />
								<p class="font-bold">{r.author_name}</p>
							</div>
							<GoogleIcon class="size-5" />
						</div>
						<div class="flex items-center gap-2 py-2.5">
							{'⭐'.repeat(r.rating)}

							<Image src={VerifiedImg} alt="" class="size-4" />
						</div>
						<p class="text line-clamp-7 overflow-hidden text-ellipsis">{r.text}</p>
					</div>
				))
			}
		</div>
	</div>
</div>
