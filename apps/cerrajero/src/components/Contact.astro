---
import { PHONE } from '../data/data.astro';
---

<section id="contacto" class="bg-white py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mb-16 text-center">
			<h2 class="mb-6 text-4xl font-bold text-gray-900 md:text-5xl">Contacta con Nosotros</h2><p
				class="mx-auto max-w-3xl text-xl text-gray-600"
			>
				¿Necesitas ayuda con tu cerradura? Contacta con nuestro equipo de profesionales.
			</p>
		</div>
		<div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
			<div class="grid grid-cols-1 gap-4 gap-x-8 justify-self-center md:grid-cols-2">
				<div class="flex items-start space-x-4">
					<div class="rounded-lg bg-teal-600 p-3 text-white">
						<i class="ri-phone-line text-xl"></i>
					</div>
					<div>
						<h3 class="mb-2 text-xl font-bold text-gray-900">Teléfono de Emergencia</h3><p
							class="text-lg font-semibold text-teal-600"
						>
							{PHONE}
						</p><p class="text-gray-600">Disponible 24 horas, 7 días a la semana</p>
					</div>
				</div><div class="flex items-start gap-4">
					<div class="rounded-lg bg-teal-600 p-3 text-white">
						<i class="ri-whatsapp-line text-xl"></i>
					</div><div>
						<h3 class="mb-2 text-xl font-bold text-gray-900">WhatsApp</h3><p
							class="text-lg font-semibold text-teal-600"
						>
							+34 {PHONE}
						</p><p class="text-gray-600">Respuesta rápida por WhatsApp</p>
					</div>
				</div><div class="flex items-start gap-4">
					<div class="rounded-lg bg-teal-600 p-3 text-white">
						<i class="ri-map-pin-line text-xl"></i>
					</div><div>
						<h3 class="mb-2 text-xl font-bold text-gray-900">Ubicación</h3><p class="text-gray-600">
							Pl. Conde de Ferrería, 4, 2A,<br /> 29009 Málaga
						</p>
					</div>
				</div><div class="flex items-start gap-4">
					<div class="rounded-lg bg-teal-600 p-3 text-white">
						<i class="ri-time-line text-xl"></i>
					</div><div>
						<h3 class="mb-2 text-xl font-bold text-gray-900">Horario</h3><p class="text-gray-600">
							Servicio de emergencia: 24/7<br />Oficina: Lunes a Viernes 8:00-20:00
						</p>
					</div>
				</div>
			</div>
			<div class="">
				<h3 class="mb-4 text-2xl font-bold text-gray-900">Nos encontramos en</h3><div
					class="aspect-video overflow-hidden rounded-lg"
				>
					<!-- width="400"
            height="300" -->
					<!-- width="600"
            height="450" -->
					<div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<button type="button" data-cargar-mapa aria-label="Cargar mapa interactivo" style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
							<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
							<strong style="font-size:1rem;">Cargar mapa interactivo</strong>
							<small style="opacity:0.65;">Se carga solo al pulsar</small>
						</button>
<iframe
					 data-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3197.6329393168057!2d-4.431753587949721!3d36.731375871459434!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd72f78298284299%3A0x4cd387e477b60e15!2sCerrajero%20M%C3%A1laga%20barato!5e0!3m2!1ses!2ses!4v1760707970974!5m2!1ses!2ses"
						title="Mapa con la ubicación del negocio"
						width="100%"
						height="100%"
						allowfullscreen=""
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						style="border: 0px;"></iframe>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
// mapa-fachada: la URL del iframe vive en data-src y solo se asigna al pulsar (ahorra ~1MB de JS).
document.addEventListener('click', function (e) {
	var t = e.target && e.target.closest ? e.target.closest('[data-cargar-mapa]') : null;
	if (!t) return;
	var w = t.closest('[data-mapa-fachada]');
	if (!w || w.dataset.cargado) return;
	var f = w.querySelector('iframe');
	if (!f || !f.dataset.src || f.getAttribute('src')) return;
	w.dataset.cargado = '1';
	f.setAttribute('src', f.dataset.src);
	t.remove();
});
</script>
