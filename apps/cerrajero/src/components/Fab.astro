---
import { WhatsappIcon } from '@astro-icons';

import { WA_PHONE } from '../data/data.astro';

const {} = Astro.props;
---

<div class="fab z-40" transition:name="fab">
	<a
		target="_blank"
		rel="noopener noreferrer"
		href={`https://wa.me/34${WA_PHONE}`}
		class="!visible !scale-none !opacity-100"
	>
		<WhatsappIcon />
	</a>
</div>
