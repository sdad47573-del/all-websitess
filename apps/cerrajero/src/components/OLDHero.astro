---
import KeyImg from '../assets/key.png';
import QuickImg from '../assets/quick.png';
import TimeImg from '../assets/time.png';
import DefenseImg from '../assets/defense.png';
import { Image } from 'astro:assets';
---

<div class="bg-base-200 py-9">
	<div class="container mx-auto flex flex-col items-center px-4">
		<div>
			<p class="text-title text-5xl font-bold">Cerrajero económico en Málaga</p>
			<p class="text-primary text-title text-5xl font-bold">24 Horas</p>
		</div>
		<p>
			Servicio de cerrajería profesional las 24 horas del día. Apertura de puertas, cambio de
			cerraduras, instalación de sistemas de seguridad y mucho más.
		</p>
		<Image src={KeyImg} alt="" class="h-36 w-fit" />
		<button class="btn btn-accent btn-xl btn-wide"
			><i class="ri-phone-line mr-2"></i>Llama ahora</button
		>
		<!-- class="bg-white/10 backdrop-blur-sm text-white border border-white/20 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-white/20 transition duration-300 whitespace-nowrap cursor-pointer" -->
		<button
			class="cursor-pointer rounded-lg border border-white/20 bg-white/10 px-8 py-4 text-lg font-semibold whitespace-nowrap text-white backdrop-blur-sm transition duration-300 hover:bg-white/20"
			><i class="ri-whatsapp-line mr-2"></i>WhatsApp</button
		>
		<div class="text-neutral flex flex-col gap-2 pt-8 text-2xl font-bold md:flex-row">
			<p class="flex items-center gap-2">
				<Image src={TimeImg} alt="" class="h-9 w-fit" />
				Servicio 24/7
			</p>
			<p class="flex items-center gap-2">
				<Image src={QuickImg} alt="" class="h-9 w-fit" />
				Respuesta rapida
			</p>
			<p class="flex items-center gap-2">
				<Image src={DefenseImg} alt="" class="h-9 w-fit" />
				Gran calidad
			</p>
		</div>
	</div>
</div>
