---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHrefs,
	specialties,
	structuredData,
} from '../lib/business';

const title = 'Restaurante Hindú Moderno | Cocina india en Rincón de la Victoria';
const description =
	'Restaurante Hindú Moderno, cocina india casera en Plaza Nuestra Señora de la Victoria, Rincón de la Victoria (Málaga). Currys, biryani, naan y opciones vegetarianas. Reserva: 608 13 88 74.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1b1a2e" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="Rincón de la Victoria" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;500&family=Sora:wght@400;500;600;700&family=Yeseva+One&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://restaurante-hindu-moderno-malaga.vercel.app/og.png" />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante Hindú Moderno, inicio"><span class="brand-mark" aria-hidden="true">HM</span><span class="brand-label">HINDÚ MODERNO <small>COCINA INDIA · RINCÓN DE LA VICTORIA</small></span></a>
			<nav aria-label="Navegación principal"><a href="#carta">La carta</a><a href="#contacto">Contacto</a></nav>
			<a class="header-phone" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> {business.phones[0]}</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-content">
					<p class="eyebrow"><span></span> COCINA INDIA · CASERA</p>
					<h1 id="hero-title">Hindú<br /><em>Moderno</em></h1>
					<p class="hero-sub">Restaurante indio · Rincón de la Victoria</p>
					<p class="hero-intro">Cocina india auténtica y casera, con especias de verdad y el picante a tu gusto. Currys, biryani, naan recién hecho y opciones vegetarianas, junto a la plaza de la iglesia de Rincón de la Victoria.</p>
					<div class="hero-actions"><a class="button button-saffron" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Llamar y reservar</a><a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
				</div>
				<aside class="menu-board" aria-labelledby="menu-title">
					<p class="menu-kicker" id="menu-title">LOS MÁS PEDIDOS</p>
					<ul class="menu-list">
						{specialties.map((dish, index) => (
							<li><span class="menu-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span class="menu-name">{dish}</span><span class="menu-dots" aria-hidden="true"></span><span class="menu-mark" aria-hidden="true">✦</span></li>
						))}
					</ul>
					<p class="menu-note">Y el picante lo ponemos a tu gusto. Consulta la carta completa en el local.</p>
				</aside>
			</section>

			<section class="salon-strip" id="carta" aria-label="Qué ofrece Restaurante Hindú Moderno">
				<p class="strip-title"><span>01 /</span> LA CASA</p>
				<div><span>01</span><strong>Cocina india casera</strong></div>
				<div><span>02</span><strong>Opciones vegetarianas</strong></div>
				<div><span>03</span><strong>Picante a tu gusto</strong></div>
				<div><span>04</span><strong>Para llevar y a domicilio</strong></div>
			</section>

			<section class="about-section" aria-labelledby="about-title">
				<p class="section-label"><span>02 /</span> HINDÚ MODERNO · RINCÓN DE LA VICTORIA</p>
				<div class="about-content"><h2 id="about-title">Especias de verdad,<br /><em>cocina de casa.</em></h2><div><p>Somos un restaurante familiar en la Plaza Nuestra Señora de la Victoria, junto a la iglesia de Rincón de la Victoria. Cocinamos recetas indias auténticas, con especias y técnicas tradicionales, en raciones generosas y con la posibilidad de ajustar el picante a lo que te apetezca. Ven a probarlo o pídelo para llevar y a domicilio.</p><a class="social-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver la ficha y las opiniones en Google Maps <span aria-hidden="true">↗</span></a></div></div>
				<div class="about-footer"><span>CURRY · BIRYANI · NAAN</span><span>29730 RINCÓN DE LA VICTORIA</span><span>✦</span></div>
			</section>

			<section class="contact-section" id="contacto" aria-labelledby="contact-title">
				<p class="section-label"><span>03 /</span> VISÍTANOS</p>
				<div class="contact-layout">
					<div class="contact-copy"><p class="contact-kicker">ESTAMOS EN LA PLAZA DE LA IGLESIA</p><h2 id="contact-title">Reserva<br /><em>tu mesa.</em></h2>
						<div class="contact-card">
							<div class="contact-row"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div></div>
							<div class="contact-row"><span aria-hidden="true">☎</span><div><small>RESERVAS</small><a href={phoneHrefs[0]}>{business.phones[0]}</a></div></div>
						</div>
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-card"><div class="map-header"><span><i></i> PL. NTRAS. SRA. DE LA VICTORIA · RINCÓN</span><a href={mapsUrl} target="_blank" rel="noreferrer">ABRIR MAPS ↗</a></div><div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<button type="button" data-cargar-mapa aria-label="Cargar mapa interactivo" style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
							<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
							<strong style="font-size:1rem;">Cargar mapa interactivo</strong>
							<small style="opacity:0.65;">Se carga solo al pulsar</small>
						</button>
<iframe title="Mapa de Restaurante Hindú Moderno en Plaza Nuestra Señora de la Victoria, Rincón de la Victoria" data-src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div><div class="map-footer"><span aria-hidden="true">⌖</span><div><strong>{business.name}</strong><small>{business.streetAddress} · {business.city}</small></div><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar a Restaurante Hindú Moderno">↗</a></div></div>
				</div>
				<div class="social-row"><span>ENCUÉNTRANOS TAMBIÉN EN</span><a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><a href={phoneHrefs[0]}>{business.phones[0]} ↗</a></div>
			</section>
			<Galeria nombre="Restaurante Hindú Moderno" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer"><a class="brand footer-brand" href="#inicio" aria-label="Restaurante Hindú Moderno, volver al inicio"><span class="brand-mark">HM</span><span class="brand-label">HINDÚ MODERNO <small>COCINA INDIA · RINCÓN DE LA VICTORIA</small></span></a><p>{business.streetAddress}, {business.postalCode} {business.city}<br /><a href={phoneHrefs[0]}>{business.phones[0]}</a></p><a class="footer-social" href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><small>© {new Date().getFullYear()} Restaurante Hindú Moderno · Rincón de la Victoria &nbsp;·&nbsp; Consulta la carta y los horarios en el local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
</footer>
		<a class="phone-cta" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Reservar en Hindú Moderno <strong>{business.phones[0]}</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						<WhatsappFab phone={datos.phoneHrefs[0]} name={datos.business?.name} />
						</body>
</html>

<script>
// mapa-fachada: la URL del iframe vive en data-src y solo se asigna al pulsar (ahorra ~1MB de JS).
document.addEventListener('click', function (e) {
	var t = e.target && e.target.closest ? e.target.closest('[data-cargar-mapa]') : null;
	if (!t) return;
	var w = t.closest('[data-mapa-fachada]');
	if (!w || w.dataset.cargado) return;
	var f = w.querySelector('iframe');
	if (!f || !f.dataset.src || f.getAttribute('src')) return;
	w.dataset.cargado = '1';
	f.setAttribute('src', f.dataset.src);
	t.remove();
});
</script>
