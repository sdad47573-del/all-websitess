---
import { BUSINESS, PRODUCTOS } from '../data/site';
---

<section id="productos" class="bg-base-200 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase"
				>Qué encontrarás</span
			><h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">
				Frescura para llenar tu alacena
			</h2><div class="alacena-divider mx-auto mt-5 h-px w-32"></div><p
				class="text-base-content/70 mt-6 leading-relaxed"
			>
				Fruta, verdura y productos para completar la compra en Teatinos. La disponibilidad puede
				cambiar; consulta directamente con la tienda.
			</p>
		</div><div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				PRODUCTOS.map((product) => (
					<article class="rounded-box border-base-300 bg-base-100 group border p-6 transition-shadow hover:shadow-lg">
						<>
							<span class="bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-content flex size-12 items-center justify-center rounded-xl transition-colors">
								<i class={`${product.icon} text-2xl`} />
							</span>
							<h3 class="font-display mt-5 text-xl font-bold">{product.title}</h3>
							<p class="text-base-content/65 mt-2 text-sm leading-relaxed">{product.text}</p>
						</>
					</article>
				))
			}
		</div><div
			class="border-base-300 bg-base-100 rounded-box mt-12 grid gap-6 border p-7 sm:grid-cols-[1fr_auto] sm:items-center sm:p-9"
		>
			<div>
				<h3 class="font-display text-2xl font-bold">Pide por WhatsApp</h3><p
					class="text-base-content/70 mt-2 max-w-2xl text-sm leading-relaxed"
				>
					El perfil oficial ofrece pedidos por WhatsApp para recoger en tienda y consultar servicio
					a domicilio.
				</p>
			</div><div class="flex flex-wrap gap-3">
				<a
					href={`https://wa.me/34${BUSINESS.phoneDisplay.replaceAll(' ', '')}`}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-primary gap-2 rounded-full"
					><i class="ri-whatsapp-line"></i>Escribir por WhatsApp</a
				><a href={BUSINESS.phoneHref} class="btn btn-outline gap-2 rounded-full"
					><i class="ri-phone-line"></i>Llamar</a
				>
			</div>
		</div>
	</div>
</section>
