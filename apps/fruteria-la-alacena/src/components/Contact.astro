---
import { BUSINESS } from '../data/site';
---

<section id="ubicacion" class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">Visítanos</span
			><h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">
				La Alacena, en Calle Hermes
			</h2><div class="alacena-divider mx-auto mt-5 h-px w-32"></div><p
				class="text-base-content/70 mt-6"
			>
				Frutería La Alacena de Alhaurín está en Teatinos, Málaga. Llama para confirmar horario o
				disponibilidad.
			</p>
		</div><div class="mt-12 grid gap-8 lg:grid-cols-2">
			<div class="space-y-6">
				<div id="horario" class="rounded-box border-base-300 bg-base-200 scroll-mt-24 border p-7">
					<h3 class="font-display text-xl font-semibold">Horario orientativo</h3><ul
						class="divide-base-300 mt-4 divide-y text-sm"
					>
						{
							BUSINESS.hours.map((hours) => (
								<li class="flex items-baseline justify-between gap-4 py-3">
									<>
										<span class="font-semibold">{hours.days}</span>
										<span class="text-base-content/70 text-right">
											{hours.morning}
											{hours.evening && <span class="block">{hours.evening}</span>}
										</span>
									</>
								</li>
							))
						}
					</ul><p class="text-base-content/55 mt-3 text-xs leading-relaxed">
						Horario indicado en el perfil oficial de Instagram. Algunos directorios publican un
						cierre distinto por la tarde. Confirma por teléfono antes de venir.
					</p>
				</div><div class="rounded-box border-base-300 bg-base-200 border p-7">
					<h3 class="font-display text-xl font-semibold">Dirección y contacto</h3><ul
						class="mt-5 space-y-5 text-sm"
					>
						<li class="flex items-start gap-4">
							<span
								class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl"
								><i class="ri-map-pin-line text-xl"></i></span
							><div>
								<p class="font-semibold">Dirección</p><p class="text-base-content/70">
									{BUSINESS.street}<br />{BUSINESS.postalCode}
									{BUSINESS.district}, {BUSINESS.city}
								</p>
							</div>
						</li><li class="flex items-start gap-4">
							<span
								class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl"
								><i class="ri-phone-line text-xl"></i></span
							><div>
								<p class="font-semibold">Teléfono y WhatsApp</p><a
									href={BUSINESS.phoneHref}
									class="text-base-content/70 hover:text-primary">{BUSINESS.phoneDisplay}</a
								>
							</div>
						</li>
					</ul><div class="mt-6 flex flex-wrap gap-3">
						<a href={BUSINESS.phoneHref} class="btn btn-primary gap-2 rounded-full"
							><i class="ri-phone-line"></i>Llamar</a
						><a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline gap-2 rounded-full"
							><i class="ri-map-pin-line"></i>Google Maps</a
						>
					</div>
				</div><div class="rounded-box border-base-300 bg-base-200 border p-6">
					<h3 class="font-display font-semibold">Más información</h3><div
						class="mt-4 flex flex-wrap gap-3"
					>
						<a
							href={BUSINESS.instagram}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline btn-sm gap-2 rounded-full"
							><i class="ri-instagram-line"></i>Instagram</a
						><a
							href={BUSINESS.facebook}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline btn-sm gap-2 rounded-full"
							><i class="ri-facebook-circle-line"></i>Facebook</a
						><a
							href="https://wa.me/34696737353"
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline btn-sm gap-2 rounded-full"
							><i class="ri-whatsapp-line"></i>WhatsApp</a
						>
					</div>
				</div>
			</div><div
				class="rounded-box border-base-300 bg-base-200 min-h-[420px] overflow-hidden border"
			>
				<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
				 src={BUSINESS.googleMapsEmbed}
					title={`Mapa de ${BUSINESS.name}, ${BUSINESS.street}, Málaga`}
					width="100%"
					height="100%"
					style="border: 0; min-height: 420px;"
					loading="lazy"
					allowfullscreen
					referrerpolicy="no-referrer-when-downgrade"></iframe>
				</div>
			</div>
		</div>
	</div>
</section>


