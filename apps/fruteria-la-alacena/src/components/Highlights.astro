---
const features = [
	{ icon: 'ri-leaf-line', title: 'Fruta y verdura', text: 'Fresca para tu día a día' },
	{
		icon: 'ri-shopping-basket-2-line',
		title: 'A granel',
		text: 'Compra la cantidad que necesitas',
	},
	{ icon: 'ri-seedling-line', title: 'Cercano y local', text: 'Productos de proximidad' },
	{ icon: 'ri-map-pin-line', title: 'En Teatinos', text: 'Calle Hermes, 2 · Málaga' },
];
---

<section class="border-base-300 bg-base-200 border-b py-8">
	<div class="mx-auto grid max-w-7xl gap-6 px-4 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">
		{
			features.map((feature) => (
				<div class="flex items-center gap-4">
					<>
						<span class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl">
							<i class={`${feature.icon} text-xl`} />
						</span>
						<div>
							<>
								<h2 class="font-display font-bold">{feature.title}</h2>
								<p class="text-base-content/60 mt-1 text-xs">{feature.text}</p>
							</>
						</div>
					</>
				</div>
			))
		}
	</div>
</section>
