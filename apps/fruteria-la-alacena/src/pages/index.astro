---
import Contact from '../components/Contact.astro';
import Fab from '../components/Fab.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Highlights from '../components/Highlights.astro';
import Productos from '../components/Productos.astro';
import Reviews from '../components/Reviews.astro';
import Tienda from '../components/Tienda.astro';
import Topbar from '../components/Topbar.astro';
import { breadcrumbs } from '../data/schema';
import Layout from '../layouts/Layout.astro';
import Galeria from '../components/Galeria.astro';
---

<Layout schema={[breadcrumbs([{ name: 'Inicio', path: '/' }])]}
	><Topbar /><main>
		<Hero /><Highlights /><Tienda /><Productos /><Reviews /><Contact /><Faq />
		<Galeria nombre="Frutería La Alacena de Alhaurín" />
	</main><Footer /><Fab /></Layout
>
