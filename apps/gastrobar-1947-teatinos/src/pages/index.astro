import foto12 from '../assets/fotos/gastrobar-1947-teatinos-malaga-foto-12.jpg';
import foto13 from '../assets/fotos/gastrobar-1947-teatinos-malaga-foto-13.jpg';
import foto14 from '../assets/fotos/gastrobar-1947-teatinos-malaga-foto-14.jpg';
import foto15 from '../assets/fotos/gastrobar-1947-teatinos-malaga-foto-15.jpg';

const business = {
	name: 'Gastrobar 1947. Teatinos',
	tagline: 'Cocina argentino-española en Teatinos',
	street: 'C. Kandinsky, 8',
	district: 'Teatinos-Universidad (Ciudad de la Justicia)',
	city: 'Málaga',
	postalCode: '29010',
	phone: '665 04 96 60',
	latitude: 36.7153995,
	longitude: -4.4642127,
	site: 'https://gastrobar-1947-teatinos.vercel.app',
};

const cid = '0xd72f7c0ff71f6d7:0x1935e88d25291cff';
const placeId = 'ChIJ1_Zx_8D3cg0R_xwpJY3oNRk';

const mapsUrl = `https://www.google.com/maps/place/Gastrobar+1947.+Teatinos/@${business.latitude},${business.longitude},17z/data=!3m1!4b1!4m6!3m5!1s${cid}!8m2!3d${business.latitude}!4d${business.longitude}!16s%2Fg%2F11lp51s1yh`;
const cidUrl = `https://www.google.com/maps?cid=${cid}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&q=Gastrobar+1947+Teatinos&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34665049660';
const instagramUrl = 'https://www.instagram.com/1947gastrobarteatinos/';

const description =
	'Gastrobar 1947 Teatinos, cocina argentino-española en la calle Kandinsky 8, Málaga: milanesa, empanadas, tequeños y ensaladilla rusa. Terraza junto al parque infantil. Tel. 665 04 96 60.';

const servicios = [
	'Cocina argentino-española',
	'Milanesas y carnes',
	'Terraza junto al parque infantil',
	'Sala amplia decorada',
	'Abierto de mañana a tarde',
	'Comida casera',
	'Opciones vegetarianas',
	'Accesible para sillas de ruedas',
	'Grupos de 5 a 8 personas',
];

const grupos = [
	{
		title: 'Los clásicos',
		items: [
			{ name: 'Milanesas', note: 'tierna por dentro y con muchísimo sabor, la más pedida' },
			{ name: 'Carne en su punto', note: 'jugosa y bien templada, según el punto que pidas' },
			{ name: 'Empanadas', note: 'masa buena y relleno sabroso, de las más valoradas' },
			{ name: 'Empanadillas', note: 'la versión más pequeña, muy pedida para compartir' },
			{ name: 'Tequeños', note: 'de los que «no se olvidan», con muy buenos comentarios' },
		],
	},
	{
		title: 'Entrantes y vermut',
		items: [
			{ name: 'Ensaladilla rusa', note: 'una de las más recomendadas de la carta' },
			{
				name: 'Croquetas',
				note: 'caseras, aunque en la carta de referencia no todas las opiniones coinciden',
			},
			{ name: 'Bravas', note: 'plato de la casa, con opiniones para todos los gustos' },
		],
	},
	{
		title: 'Ir en familia',
		items: [
			{
				name: 'Terraza junto al parque infantil',
				note: 'el parque está justo en la entrada, ideal con niños',
			},
			{
				name: 'Comida casera de verdad',
				note: 'platos hechos cada día, no congelados ni procesados',
			},
			{ name: 'Mesas para grupos', note: 'recomendado para grupos de 5 a 8 personas' },
		],
	},
];

const galeria = [
	{
		src: foto1,
		alt: 'Interior de Gastrobar 1947 Teatinos, restaurante en la calle Kandinsky, 8, Málaga',
	},
	{
		src: foto2,
		alt: 'Ambiente y sala de Gastrobar 1947 en Teatinos, cocina argentino-española',
	},
	{
		src: foto3,
		alt: 'Platos de Gastrobar 1947 Teatinos, milanesas y comida argentina en Málaga',
	},
	{
		src: foto4,
		alt: 'Carnes y milanesa de Gastrobar 1947, restaurante en Teatinos-Universidad',
	},
	{
		src: foto5,
		alt: 'Detalle de la carta y emplatado de Gastrobar 1947 Teatinos, Málaga',
	},
	{
		src: foto6,
		alt: 'Empanadas y tequeños de Gastrobar 1947, gastrobar en Teatinos, Málaga',
	},
	{
		src: foto7,
		alt: 'Terraza de Gastrobar 1947 junto al parque infantil en Teatinos, Málaga',
	},
	{
		src: foto8,
		alt: 'Imagen de Gastrobar 1947 Teatinos publicada en su ficha de Google Maps',
	},
	{
		src: foto9,
		alt: 'Ensaladas y entrantes de Gastrobar 1947 Teatinos, restaurante en Málaga',
	},
	{
		src: foto10,
		alt: 'Cocina de Gastrobar 1947, platos de cocina argentino-española en Teatinos',
	},
	{
		src: foto11,
		alt: 'Comida de Gastrobar 1947 Teatinos, restaurante en la Ciudad de la Justicia, Málaga',
	},
	{
		src: foto12,
		alt: 'Servicio y sala de Gastrobar 1947 Teatinos, Málaga',
	},
	{
		src: foto13,
		alt: 'Platos de la carta de Gastrobar 1947 Teatinos, restaurante en Málaga',
	},
	{
		src: foto14,
		alt: 'Fachada y acceso de Gastrobar 1947 en la calle Kandinsky 8, Teatinos, Málaga',
	},
	{ src: foto15, alt: 'Cocina y emplatado de Gastrobar 1947 Teatinos, Málaga' },
];

const faqs = [
	{
		q: '¿Dónde está Gastrobar 1947?',
		a: 'En la calle Kandinsky, 8, en el barrio de Teatinos-Universidad (29010 Málaga), en la zona de la Ciudad de la Justicia. La terraza da a un parque infantil, algo que lo hace especialmente cómodo para ir en familia. Ten en cuenta que aparcar por la zona es complicado, aunque hay parking a unos diez minutos andando.',
	},
	{
		q: '¿Cuál es el horario de Gastrobar 1947?',
		a: 'El local abre de lunes a sábado en horario continuo, de 8:00 a 23:30, y permanece cerrado los domingos. Es un horario poco habitual para un restaurante y permite tanto comer como cenar cualquier día laborable o sábado, sin depender del turno de mediodía.',
	},
	{
		q: '¿Qué tipo de cocina sirve?',
		a: 'Gastrobar 1947 fusiona cocina argentina y española con un toque moderno. La carta combina las milanesas, las empanadas, los tequeños y los cortes de carne con entrantes más españoles como la ensaladilla rusa, las croquetas caseras o las bravas. En los datos de la ficha se destaca además que la comida es casera, hecha cada día.',
	},
	{
		q: '¿Cuál es el plato más recomendado?',
		a: 'Por lo que cuentan los clientes, la milanesa es el plato estrella: se describe como tierna por dentro, jugosa y con muchísimo sabor. También se repiten muy favorablemente las empanadas, las empanadillas y los tequeños, y la ensaladilla rusa aparece entre los entrantes más solicitados.',
	},
	{
		q: '¿Es adecuado para ir con niños?',
		a: 'Sí. La terraza está situada junto a un parque infantil, y las reseñas lo destacan como un punto fuerte del local para familias. Además, el horario amplio permite comer a cualquier hora. Es un sitio pensado también para grupos, y desde la ficha se recomienda para grupos de 5 a 8 personas.',
	},
	{
		q: '¿Cuánto cuesta comer aquí?',
		a: 'La ficha de Google sitúa el precio por persona entre 20 € y 30 €. Los clientes destacan que la relación calidad-precio es buena, teniendo en cuenta las raciones y el ambiente. No publicamos la carta completa con precios porque no hay una fuente pública fiable y los platos cambian.',
	},
	{
		q: '¿Tiene terraza, sala y opciones para sillas de ruedas?',
		a: 'Cuenta con zona de comedor interior, amplio y bien decorado, y con terraza o patio exterior. La ficha del negocio indica además que tiene asientos adaptados y acceso para sillas de ruedas. Para grupos, se recomienda reservar con antelación al 665 04 96 60.',
	},
	{
		q: '¿Hay opciones vegetarianas?',
		a: 'Sí. La ficha del negocio recoge que tiene ensaladas como opción vegetariana. Aun así, la carta es claramente de carne y croquetas, así que si vas con una dieta vegetariana estricta conviene consultarlo al reservar o llamar antes.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['1947 Gastrobar Teatinos', 'Gastrobar 1947'],
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 665 04 96 60',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Cocina argentina', 'Cocina española', 'Gastrobar', 'Cocina mediterránea'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [instagramUrl, cidUrl],
	identifier: [{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId }],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:00',
			closes: '23:30',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Sunday'], opens: '00:00', closes: '00:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza o patio exterior', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Zona de comedor interior', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Reservas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Opciones vegetarianas', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.8,
		reviewCount: 524,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Qué pedir', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Gastrobar 1947 Teatinos | Cocina argentino-española en Málaga</title>
		<meta name="theme-color" content="#1b1a2e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Marcellus&family=Outfit:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Gastrobar 1947, gastrobar Teatinos, cocina argentina Málaga, milanesa Teatinos, restaurante Kandinsky 8, comer en Teatinos, Ciudad de la Justicia restaurante, empanadas Málaga, tequeños Málaga, gastrobar Málaga, comida con niños Teatinos, cena Teatinos"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Gastrobar 1947 Teatinos · Cocina argentino-española en Málaga"
			ogDescription="Milanesas, empanadas, tequeños y ensaladilla rusa en C. Kandinsky, 8 (Ciudad de la Justicia, Teatinos). Terraza junto al parque. 4,8 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Gastrobar 1947 Teatinos, cocina argentino-española en la calle Kandinsky 8, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#1b1a2e"
			street={business.street}
			city={business.city}
			region="Andalucía"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Teatinos-Universidad, Málaga"
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="47"
			name="Gastrobar 1947"
			subtitle="Teatinos · Málaga"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Ciudad de la Justicia · Málaga"
				title="Argentina y España,<br />servidas en<br /><em>plato grande.</em>"
				lede="Gastrobar en la calle Kandinsky, 8, junto a la Ciudad de la Justicia. Milanesas tiernas, empanadas, tequeños, ensaladilla rusa y comida casera de verdad. Terraza con parque infantil justo al lado y abierto de 8:00 a 23:30 de lunes a sábado."
				image={heroImage}
				imageAlt="Fotografía de Gastrobar 1947 Teatinos publicada en su perfil de Google Maps (cocina argentino-española en Málaga)"
				primaryCta={{ label: 'Reservar 665 04 96 60', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,8</b> en Google (524 reseñas)' },
					{ label: 'Horario', html: 'Abierto 8:00 – 23:30' },
					{ label: 'Terraza', html: 'Terraza junto al parque infantil' },
					{ label: 'Cocina', html: 'Comida casera, hecha a diario' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Gastrobar 1947" items={servicios} />

			<LocalAbout
				label="Un gastrobar con identidad propia"
				title="No es<br />un chino más.<br /><em>Es un 1947.</em>"
				paragraphs={[
					'Gastrobar 1947 está en la calle Kandinsky, 8, en pleno barrio de Teatinos, al lado de la Ciudad de la Justicia. La idea es sencilla: cocinar argentino y español con un toque moderno, sin complicarse. Un sitio para comer bien, con gente y sin prisas.',
					'La carta combina lo de siempre de cada lado del Atlántico: milanesas, empanadas, tequeños y cortes de carne, y al otro lado ensaladilla rusa, croquetas caseras y bravas. La ficha del negocio destaca que la comida es casera, hecha cada día, y eso se nota.',
					'El local tiene un salón amplio y bien decorado, y una terraza que da directamente al parque infantil. Eso lo convierte en una opción muy cómoda para ir con niños, y también para grupos de hasta ocho personas.',
				]}
				note="Lo que se repite en las reseñas: la milanesa es el plato estrella, las empanadas y los tequeños son de lo mejor de la carta, y el personal se describe como excelente, con trato cercano y servicio rápido. La nota media es 4,8 sobre 524 opiniones. También hay alguna crítica puntual, como croquetas frías o un plato mejorable, pero el tono general es muy positivo."
				links={[
					{ label: 'Instagram del gastrobar', href: instagramUrl, external: true },
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="Lo más pedido"
				title="Qué pedir<br /><em>en el 1947.</em>"
				description="Selección hecha a partir de los platos que los clientes mencionan en las reseñas de Google. La carta puede variar según el producto del día, así que confirma al reservar."
				cta={{ label: 'Reservar mesa', href: phoneHref }}
				groups={grupos}
				note="Precio orientativo según la ficha de Google: entre 20 € y 30 € por persona. No publicamos la carta completa con precios cerrados porque no hay una fuente pública fiable y los platos cambian. Confirma antes de venir."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El gastrobar,<br /><em>por dentro.</em>"
				description="Estas fotografías proceden del perfil de Gastrobar 1947 Teatinos en Google Maps, con la galería de clientes y las fotos de la casa. En la ficha están todas las imágenes y las reseñas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="C. Kandinsky 8 · 29010 Málaga"
				title="Nos vemos<br /><em>en Teatinos.</em>"
				addressLines={[
					business.street,
					business.district,
					`${business.postalCode} ${business.city}, España`,
				]}
				hours={[
					{ day: 'Lunes', value: '8:00 – 23:30' },
					{ day: 'Martes', value: '8:00 – 23:30' },
					{ day: 'Miércoles', value: '8:00 – 23:30' },
					{ day: 'Jueves', value: '8:00 – 23:30' },
					{ day: 'Viernes', value: '8:00 – 23:30' },
					{ day: 'Sábado', value: '8:00 – 23:30' },
					{ day: 'Domingo', value: 'Cerrado', closed: true },
				]}
				hoursNote="Horario continuo publicado en la ficha de Google: el local abre a las 8:00 de la mañana y cierra a las 23:30, de lunes a sábado. El domingo permanece cerrado. Puede cambiar en festivos, así que llama antes si vienes el finde."
				mapTitle="Mapa de Gastrobar 1947 Teatinos en la calle Kandinsky, 8, Teatinos-Universidad, Málaga"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Gastrobar 1947 · Teatinos, Málaga"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Instagram', href: instagramUrl, external: true },
				]}
				phoneLink={`+34 ${business.phone}`}
				reserveNote="Reservas por teléfono, recomendables para grupos y fines de semana. Ojo con el aparcamiento: en la zona de la Ciudad de la Justicia es difícil aparcar, y lo habitual es dejar el coche en un parking a unos diez minutos andando."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="47"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: 'Instagram ↗', href: instagramUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Reservar en el 1947"
		/>
	</body>
</html>
