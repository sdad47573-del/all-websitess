---
import '../styles/global.css';
import { LocalSeo } from '@astro-components';
import { Image } from 'astro:assets';

import fachada from '../assets/fotos/la-posada-de-juanma-apaisada-08.jpg';
import mesa from '../assets/fotos/la-posada-de-juanma-apaisada-03.jpg';
import pollo from '../assets/fotos/la-posada-de-juanma-apaisada-02.jpg';
import gratinado from '../assets/fotos/la-posada-de-juanma-apaisada-01.jpg';
import ensalada from '../assets/fotos/la-posada-de-juanma-apaisada-04.jpg';
import ensaladaDetalle from '../assets/fotos/la-posada-de-juanma-vertical-05.jpg';
import patatas from '../assets/fotos/la-posada-de-juanma-vertical-06.jpg';
import salsa from '../assets/fotos/la-posada-de-juanma-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
} from '../data/site';

const title = 'La posada de Juanma · Pollo asado y comida casera en Carretera de Cádiz';
const description = BUSINESS.description;

const galeria = [
	{
		src: mesa,
		alt: 'Mesa con bandejas de pollo asado, patatas, ensalada en táper y pan sobre un mantel de cuadros',
		caption: 'La mesa completa',
		className: 'g1',
	},
	{
		src: pollo,
		alt: 'Trozos de pollo asado en su jugo dentro de una bandeja de aluminio',
		caption: 'Pollo asado',
		className: 'g2',
	},
	{
		src: patatas,
		alt: 'Bandeja de aluminio llena de patatas cocidas en trozos',
		caption: 'Patatas',
		className: 'g3',
	},
	{
		src: gratinado,
		alt: 'Plato gratinado con queso fundido en una bandeja de aluminio, junto a patatas fritas',
		caption: 'Gratinado de la casa',
		className: 'g4',
	},
	{
		src: ensalada,
		alt: 'Ensalada en táper de plástico con tomate, cebolla y aceitunas, junto a un pan',
		caption: 'Ensalada y pan',
		className: 'g5',
	},
	{
		src: ensaladaDetalle,
		alt: 'Detalle de la ensalada con mejillones, pimiento verde, tomate y cebolla',
		caption: 'Ensalada de la casa',
		className: 'g6',
	},
	{
		src: salsa,
		alt: 'Táper de plástico con salsa roja sobre una mesa de madera',
		caption: 'Salsa aparte',
		className: 'g7',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-posada-de-juanma`,
	name: BUSINESS.fullName,
	alternateName: ['La posada', 'Posada de Juanma', 'Asador de pollos La posada'],
	description:
		'Asador de pollos con comida casera en Av. de la Paloma, 41 (Carretera de Cádiz, 29003 Málaga). Pollo asado, patatas y comida para llevar, de 12:00 a 16:00; martes cerrado.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34633198632',
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Pollo asado', 'Comida casera', 'Comida para llevar'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: false,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((resena) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: resena.valor, bestRating: 5 },
		reviewBody: resena.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#22332b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Libre+Franklin:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La posada de Juanma Málaga, pollo asado Carretera de Cádiz, asador de pollos Av. de la Paloma, comida casera para llevar Málaga, pollo asado 29003, menú para llevar Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Asador de pollos con comida casera en Av. de la Paloma, 41. De 12:00 a 16:00, martes cerrado. 4,5 sobre 5 con 29 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de La posada de Juanma en Carretera de Cádiz, con el rótulo y el menú en la puerta"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#22332b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<div class="topline">
			<div class="wrap topline-inner">
				<p>Av. de la Paloma, 41 · Carretera de Cádiz</p>
				<p class="topline-hours">Martes cerrado · 12:00–16:00</p>
				<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
			</div>
		</div>

		<header class="site-header" id="inicio">
			<div class="wrap header-inner">
				<a class="brand" href="#inicio" aria-label="La posada de Juanma, inicio">
					<span class="brand-stamp" aria-hidden="true">PJ</span>
					<span class="brand-name">Asador de pollos <strong>La posada de Juanma</strong></span>
				</a>
				<nav class="site-nav" aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="header-call" href={BUSINESS.phoneHref}>
					<span aria-hidden="true">☎</span> {BUSINESS.phone}
				</a>
			</div>
			<nav class="mobile-nav wrap" aria-label="Navegación principal en móvil">
				{nav.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
		</header>

		<main id="contenido">
			<section class="hero" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Carretera de Cádiz · Málaga</p>
						<h1 id="hero-title">El pollo asado <em>de la esquina.</em></h1>
						<p class="hero-lede">
							En la avenida de la Paloma, 41, La posada de Juanma despacha <strong>pollo asado</strong>
							con comida casera para llevar: patatas, ensalada y guisos de los de siempre, de 12:00
							a 16:00.
						</p>
						<div class="hero-actions">
							<a class="btn btn-primary" href={BUSINESS.phoneHref}>Llamar · {BUSINESS.phone}</a>
							<a class="btn btn-ghost" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<strong>{RATING.label} / 5</strong>
								<span>{RATING.count} reseñas en Google</span>
							</li>
							<li>
								<strong>12:00–16:00</strong>
								<span>martes cerrado</span>
							</li>
							<li>
								<strong>Av. de la Paloma, 41</strong>
								<span>Carretera de Cádiz · 29003</span>
							</li>
						</ul>
					</div>

					<figure class="hero-figure">
						<Image
							src={fachada}
							alt="Fachada de La posada de Juanma en la avenida de la Paloma, con el rótulo blanco, el cartel rojo de asador de pollos y clientes entrando"
							widths={[480, 720, 1040]}
							sizes="(max-width: 880px) 92vw, 46vw"
							loading="eager"
							fetchpriority="high"
						/>
						<span class="hero-plaque" aria-hidden="true">
							<small>Asador de pollos</small>
							<strong>y comida casera</strong>
						</span>
						<figcaption class="hero-caption">
							La puerta del local <span>Foto del perfil de Google Maps</span>
						</figcaption>
					</figure>
				</div>
			</section>

			<div class="marquee" aria-hidden="true">
				<div class="marquee-track">
					<span>Pollo asado</span><span>·</span><span>Comida casera</span><span>·</span><span>Patatas</span><span>·</span><span>Ensalada</span><span>·</span><span>Para llevar</span><span>·</span><span>Carretera de Cádiz</span><span>·</span>
					<span>Pollo asado</span><span>·</span><span>Comida casera</span><span>·</span><span>Patatas</span><span>·</span><span>Ensalada</span><span>·</span><span>Para llevar</span><span>·</span><span>Carretera de Cádiz</span><span>·</span>
				</div>
			</div>

			<section class="about" id="casa" aria-labelledby="about-title">
				<div class="wrap">
					<div class="about-grid">
						<div class="about-intro">
							<p class="eyebrow">01 — La casa</p>
							<h2 id="about-title">Pollo, patatas <em>y pan.</em></h2>
							<div class="about-copy">
								<p>
									La posada de Juanma es un asador de barrio en la avenida de la Paloma. En su
									ficha de Google el negocio se describe en cuatro palabras: «Asador de pollos
									con comida casera».
								</p>
								<p>
									Las fotos del perfil lo enseñan tal cual: bandejas de aluminio con el pollo en
									su jugo, patatas en trozos, ensalada en táper, pan y alguna salsa aparte. Todo
									pensado para recoger y comer en casa o en el trabajo.
								</p>
								<p>
									Google lo clasifica como restaurante de comida para llevar y le da 4,5 sobre 5
									con 29 reseñas. La más repetida: «El mejor pollo asado que he probado en
									Málaga».
								</p>
							</div>
							<blockquote class="about-quote">
								<p>«El mejor pollo asado que he probado en Málaga!»</p>
								<cite>Reseña publicada en Google</cite>
							</blockquote>
						</div>

						<figure class="foto-local">
							<Image
								src={mesa}
								alt="Mesa con dos bandejas de pollo asado, una de patatas, un táper de ensalada y un pan sobre mantel de cuadros"
								widths={[420, 640, 900]}
								sizes="(max-width: 980px) 92vw, 42vw"
							/>
							<figcaption>
								<span>Lo que sale del asador</span>
								Pollo, patatas, ensalada y pan. La bandeja de aluminio forma parte del paisaje de
								cualquier pedido para llevar.
							</figcaption>
						</figure>
					</div>

					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<h3 data-index={`0${index + 1}`}>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<section class="carta" id="carta" aria-labelledby="carta-title">
				<div class="wrap">
					<header class="section-head">
						<div>
							<p class="eyebrow">02 — La carta</p>
							<h2 id="carta-title">Lo que llena <em>la bandeja.</em></h2>
						</div>
						<p>
							La ficha no publica carta ni precios. Esto es lo que nombran la descripción del
							negocio y las reseñas, sin inventar platos que la casa no anuncie.
						</p>
					</header>

					<div class="carta-grid">
						<div class="menu-groups">
							{
								MENU.map((group) => (
									<div class="menu-group">
										<h3>{group.title}</h3>
										<ul>
											{group.items.map((item) => (
												<li class="menu-item">
													<h4>{item.name}</h4>
													<p>{item.note}</p>
												</li>
											))}
										</ul>
									</div>
								))
							}
							<p class="menu-note">
								La ficha de Google no incluye carta ni importes. El menú concreto de cada día se
								consulta en el local o por teléfono.
							</p>
						</div>

						<aside class="carta-card" aria-labelledby="carta-card-title">
							<p class="card-kicker">Para pedir</p>
							<h3 id="carta-card-title">Se llama <em>y se recoge.</em></h3>
							<p>
								Es comida para llevar: llama, encarga el pollo y pasa a recogerlo. Si vas en
								grupo, mejor avisar con tiempo.
							</p>
							<a class="card-phone" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
							<p class="card-note">
								Av. de la Paloma, 41 · Carretera de Cádiz, Málaga. De 12:00 a 16:00; los martes
								cierra.
							</p>
						</aside>
					</div>
				</div>
			</section>

			<section class="gallery" id="galeria" aria-labelledby="gallery-title">
				<div class="wrap">
					<header class="section-head section-head-light">
						<div>
							<p class="eyebrow">03 — Las fotos</p>
							<h2 id="gallery-title">La bandeja <em>completa.</em></h2>
						</div>
						<p>
							Fotos del perfil público del local en Google Maps: el pollo, las patatas, la
							ensalada, el gratinado y la salsa. Lo que uno se encuentra al abrir el paquete.
						</p>
					</header>

					<div class="gallery-grid">
						{
							galeria.map((photo) => (
								<figure class={photo.className}>
									<Image
										src={photo.src}
										alt={photo.alt}
										widths={[420, 700, 1000, 1400]}
										sizes="(max-width: 640px) 92vw, (max-width: 980px) 46vw, 48vw"
									/>
									<figcaption>{photo.caption}</figcaption>
								</figure>
							))
						}
					</div>

					<p class="gallery-credit">
						Fotografías del perfil público de {BUSINESS.fullName} en Google Maps, consultado en
						octubre de 2026.
						<a href={MAPS.place} target="_blank" rel="noreferrer">
							Ver la ficha completa <span aria-hidden="true">↗</span>
						</a>
					</p>
				</div>
			</section>

			<section class="reviews" aria-labelledby="reviews-title">
				<div class="wrap reviews-grid">
					<div class="rating-block">
						<p class="eyebrow">04 — En Google</p>
						<p class="big-rating">{RATING.label}</p>
						<p class="stars" aria-label={`${RATING.label} de 5 estrellas`}>
							<span aria-hidden="true">★★★★☆</span>
						</p>
						<p class="rating-count">{RATING.count} reseñas en Google</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>

					<div class="review-list">
						<h2 id="reviews-title" class="visually-hidden">Reseñas de La posada de Juanma</h2>
						{
							RESENAS.map((resena, index) => (
								<blockquote class:list={['review', { 'review-lead': index === 0 }]}>
									<p>«{resena.texto}»</p>
									<footer>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
										</span>
										<cite>Reseña publicada en Google</cite>
									</footer>
								</blockquote>
							))
						}
					</div>
				</div>
			</section>

			<section class="visit" id="visitanos" aria-labelledby="visit-title">
				<div class="wrap">
					<header class="section-head">
						<div>
							<p class="eyebrow">05 — Visitar</p>
							<h2 id="visit-title">Av. de la Paloma, 41. <em>De 12 a 4.</em></h2>
						</div>
						<p>
							En Carretera de Cádiz, con la puerta a pie de calle. Abre al mediodía de lunes a
							domingo y cierra los martes.
						</p>
					</header>

					<div class="visit-grid">
						<div class="visit-info">
							<div class="visit-block">
								<h3>Horario</h3>
								<table>
									<caption class="visually-hidden">Horario de La posada de Juanma</caption>
									<tbody>
										{
											HORARIO.map((row) => (
												<tr class:list={{ closed: row.closed }}>
													<th scope="row">{row.dia}</th>
													<td>{row.horas}</td>
												</tr>
											))
										}
									</tbody>
								</table>
								<p class="notice">{HORARIO_AVISO}</p>
							</div>

							<div class="visit-block">
								<h3>Dónde</h3>
								<address>
									<strong>{BUSINESS.street}</strong><br />
									{BUSINESS.district}<br />
									{BUSINESS.postalCode} {BUSINESS.city}
								</address>
								<p class="visit-links">
									<a href={MAPS.directions} target="_blank" rel="noreferrer">
										Cómo llegar <span aria-hidden="true">↗</span>
									</a>
									<a href={MAPS.streetView} target="_blank" rel="noreferrer">
										Vista de la calle <span aria-hidden="true">↗</span>
									</a>
								</p>
							</div>

							<div class="visit-block">
								<h3>Contacto</h3>
								<p class="visit-phone">
									<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
								</p>
								<p>
									Es el único teléfono que publica la ficha de Google. No consta web ni perfiles
									sociales.
								</p>
							</div>

							<div class="visit-block">
								<h3>Accesibilidad</h3>
								<p>
									La ficha marca acceso para sillas de ruedas. Indica que no hay aparcamiento ni
									asientos adaptados.
								</p>
							</div>
						</div>

						<div class="map-column">
							<div class="map-frame">
								<iframe
									title="Mapa de La posada de Juanma en Av. de la Paloma, 41, Málaga"
									src={MAPS.embed}
									loading="lazy"
									referrerpolicy="no-referrer-when-downgrade"
									allowfullscreen
								></iframe>
							</div>
							<p class="map-caption">
								<span>Av. de la Paloma, 41 · 29003 Málaga</span>
								<a href={MAPS.place} target="_blank" rel="noreferrer">
									Abrir en Google Maps <span aria-hidden="true">↗</span>
								</a>
							</p>
						</div>
					</div>
				</div>
			</section>

			<section class="faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap faq-grid">
					<div class="faq-intro">
						<p class="eyebrow">06 — Preguntas</p>
						<h2 id="faq-title">Antes de <em>encargar.</em></h2>
						<p>
							Lo que la ficha pública permite responder y lo que conviene confirmar por teléfono.
							Sin cartas, precios ni accesibilidad inventados.
						</p>
						<a class="simple-link" href={BUSINESS.phoneHref}>
							Llamar al {BUSINESS.phone} <span aria-hidden="true">→</span>
						</a>
					</div>
					<div class="faq-list">
						{
							FAQ.map((item) => (
								<details>
									<summary>{item.q}</summary>
									<p>{item.a}</p>
								</details>
							))
						}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-top">
					<div class="footer-brand">
						<span class="brand-stamp" aria-hidden="true">PJ</span>
						<p>
							La posada de Juanma
							<small>Asador de pollos con comida casera<br />Carretera de Cádiz · Málaga</small>
						</p>
					</div>
					<nav aria-label="Enlaces del asador">
						<h2>La casa</h2>
						{nav.map((item) => <a href={item.href}>{item.label}</a>)}
						<a href="/aviso-legal">Aviso legal</a>
					</nav>
					<div class="footer-contact">
						<h2>Contacto</h2>
						<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
						<p>{BUSINESS.street}<br />{BUSINESS.postalCode} {BUSINESS.city}</p>
						<a class="footer-map" href={MAPS.place} target="_blank" rel="noreferrer">
							Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>

				<div class="footer-bottom">
					<p>
						© {year} {BUSINESS.name} · Datos, reseñas y fotografías de la ficha pública de Google
						Maps, consultada en octubre de 2026. Confirma horario y menú antes de pedir.
					</p>
					<nav class="footer-legal" aria-label="Información legal">
						<a href="/aviso-legal">Aviso legal</a>
						<a href="/aviso-legal#privacidad">Privacidad</a>
						<a href="/aviso-legal#cookies">Cookies</a>
					</nav>
					<p class="credit">
						Creado por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
						<a href="https://sur-digital.vercel.app/" rel="noopener">sur-digital.vercel.app</a>
					</p>
				</div>
			</div>
		</footer>

		<a class="mobile-call" href={BUSINESS.phoneHref}>
			Llamar a La posada <span>{BUSINESS.phone}</span>
		</a>
	</body>
</html>
