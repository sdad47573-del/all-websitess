import salon from '../assets/fotos/hornos-villanueva-salon-interior-malaga.jpg';
import barra from '../assets/fotos/hornos-villanueva-barra-cafeteria-malaga.jpg';
import hogaza from '../assets/fotos/hornos-villanueva-hogaza-pan-artesano-malaga.jpg';
import desayuno from '../assets/fotos/hornos-villanueva-desayuno-bocadillos-malaga.jpg';
import bocadilloPlancha from '../assets/fotos/hornos-villanueva-bocadillo-a-la-plancha-malaga.jpg';
import bocadillosNueces from '../assets/fotos/hornos-villanueva-bocadillos-pan-nueces-malaga.jpg';
import bocadilloJamon from '../assets/fotos/hornos-villanueva-bocadillo-jamon-malaga.jpg';
import mesa from '../assets/fotos/hornos-villanueva-mesa-bocadillos-cafe-malaga.jpg';
import capuchino from '../assets/fotos/hornos-villanueva-capuchino-malaga.jpg';
import cafeConLeche from '../assets/fotos/hornos-villanueva-cafe-con-leche-malaga.jpg';
import cafeVaso from '../assets/fotos/hornos-villanueva-cafe-en-vaso-malaga.jpg';
import porra from '../assets/fotos/hornos-villanueva-porra-malaga.jpg';
import bocadillos from '../assets/fotos/hornos-villanueva-bocadillos-desayuno-malaga.jpg';

const business = {
	name: 'Hornos Villanueva',
	tagline: 'Panadería, cafetería y terraza en Teatinos',
	street: 'C. Juan de Robles, 53',
	district: 'Teatinos-Universidad',
	city: 'Málaga',
	postalCode: '29010',
	phone: '952 10 33 87',
	latitude: 36.7218327,
	longitude: -4.4613918,
	rating: 4.2,
	reviewsCount: 634,
	site: 'https://hornos-villanueva.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd72f73fa30d6033:0xa91af5a4f89095a3';
const cidDecimal = '12185321830697964963';
const instagram = 'https://www.instagram.com/hornos_villanueva/';

const mapsUrl = `https://www.google.com/maps/place/Hornos+Villanueva/@${business.latitude},${business.longitude},17z/data=!3m1!4b1!4m6!3m5!1s${cid}!8m2!3d${business.latitude}!4d${business.longitude}`;
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = cidUrl;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34952103387';

const description =
	'Panadería y cafetería en Teatinos (Málaga): pan recién hecho, bollería y dulces, desayunos con pitufos y bocadillos, y una amplia terraza. En C. Juan de Robles, 53, de lunes a viernes hasta las 20:30. Tel. 952 10 33 87.';

const servicios = [
	'Panadería con obrador',
	'Pan recién hecho',
	'Bollería y dulces',
	'Cafetería',
	'Desayunos',
	'Meriendas',
	'Pitufos y bocadillos',
	'Tapas y raciones',
	'Platos de cuchara',
	'Amplia terraza',
	'Café para llevar',
	'Barrio de Teatinos',
];

const grupos = [
	{
		title: 'Panadería y bollería',
		items: [
			{ name: 'Pan recién hecho', note: 'barras y hogazas del obrador del propio local' },
			{ name: 'Pan de nueces y pipas', note: 'el que más se repite en las fotos de la ficha' },
			{ name: 'Bollería y dulces', note: '«gran variedad de dulces», destacan en las reseñas' },
			{ name: 'Productos de horno para llevar', note: 'para completar el desayuno en casa' },
		],
	},
	{
		title: 'Desayunos y meriendas',
		items: [
			{
				name: 'Pitufo mixto',
				note: 'con jamón a la plancha, queso fundido y mantequilla, según las reseñas',
			},
			{ name: 'Bocadillos a la plancha', note: 'de jamón, lomo, atún… a la plancha y con pan crujiente' },
			{ name: 'Café con leche y capuchino', note: 'el desayuno clásico de la barra' },
			{ name: 'Zumos naturales', note: 'al momento' },
		],
	},
	{
		title: 'Para comer y picar',
		items: [
			{ name: 'Bocadillos y camperos', note: 'con pan del día, para desayuno o media mañana' },
			{ name: 'Tapas y raciones', note: 'para compartir en el salón o en la terraza' },
			{ name: 'Platos de cuchara', note: 'como la porra o el salmorejo, bien fríos' },
			{ name: 'Platos caseros del día', note: 'según la pizarra del local' },
		],
	},
	{
		title: 'Bebidas',
		items: [
			{ name: 'Café e infusiones', note: 'barra de cafetería, también para llevar' },
			{ name: 'Cerveza y refrescos', note: '«una cerveza en su amplia terraza», dicen los clientes' },
			{ name: 'Batidos y zumos', note: 'para la merienda' },
		],
	},
];

const galeria = [
	{
		src: fachadaPanaderia,
		alt: 'Fachada de la panadería Hornos Villanueva con el rótulo azul, en la calle Juan de Robles, Teatinos, Málaga',
	},
	{
		src: fachadaEsquina,
		alt: 'Esquina de Hornos Villanueva con cafetería y panadería, en Teatinos-Universidad, Málaga',
	},
	{
		src: terraza,
		alt: 'Terraza de Hornos Villanueva con mesas y sillas, cafetería en Teatinos, Málaga',
	},
	{
		src: interiorRejeria,
		alt: 'Interior de Hornos Villanueva con la rejería artística y las cámaras, cafetería en Teatinos, Málaga',
	},
	{
		src: salon,
		alt: 'Salón interior de Hornos Villanueva con mesas, en la calle Juan de Robles, Málaga',
	},
	{
		src: barra,
		alt: 'Barra y cafetera de Hornos Villanueva, panadería y cafetería en Teatinos, Málaga',
	},
	{
		src: hogaza,
		alt: 'Hogaza de pan recién hecha de Hornos Villanueva, panadería en Teatinos, Málaga',
	},
	{
		src: desayuno,
		alt: 'Desayuno en Hornos Villanueva con café, bocadillos a la plancha y aceite de oliva, Málaga',
	},
	{
		src: bocadilloPlancha,
		alt: 'Bocadillo a la plancha con jamón en Hornos Villanueva, cafetería en Teatinos, Málaga',
	},
	{
		src: bocadillosNueces,
		alt: 'Bocadillos de pan de nueces y pipas con jamón en Hornos Villanueva, Málaga',
	},
	{
		src: bocadilloJamon,
		alt: 'Bocadillo de jamón en bandeja en Hornos Villanueva, cafetería en Teatinos, Málaga',
	},
	{
		src: mesa,
		alt: 'Mesa con bocadillos y café en Hornos Villanueva, panadería y cafetería en Málaga',
	},
	{
		src: capuchino,
		alt: 'Capuchino servido en taza en Hornos Villanueva, cafetería en Teatinos, Málaga',
	},
	{
		src: cafeConLeche,
		alt: 'Café con leche en vaso en Hornos Villanueva, desayuno en Teatinos, Málaga',
	},
	{
		src: cafeVaso,
		alt: 'Café servido en vaso con la servilleta de Hornos Villanueva, cafetería en Málaga',
	},
	{
		src: porra,
		alt: 'Porra o salmorejo con jamón, huevo y cebolla en Hornos Villanueva, Teatinos, Málaga',
	},
	{
		src: bocadillos,
		alt: 'Bocadillos y café con leche en la mesa de Hornos Villanueva, Teatinos, Málaga',
	},
];

const faqs = [
	{
		q: '¿Dónde está Hornos Villanueva?',
		a: 'En la calle Juan de Robles, 53, en el barrio de Teatinos-Universidad (29010 Málaga). Es un local de esquina con panadería y cafetería, y una amplia terraza en la calle.',
	},
	{
		q: '¿Cuál es el horario de Hornos Villanueva?',
		a: 'De lunes a viernes abre de 7:30 a 20:30, y los sábados y domingos de 8:00 a 14:30. Como es a la vez panadería y cafetería, por la mañana hay desayunos y por la tarde se puede seguir comprando pan. En festivos puede cambiar, así que confírmalo antes.',
	},
	{
		q: '¿Es panadería y cafetería a la vez?',
		a: 'Sí. En el mismo local conviven el obrador y el despacho de pan con una cafetería completa: barra, salón y terraza. Se puede desayunar, merendar o comer algo, además de comprar el pan y la bollería para llevar.',
	},
	{
		q: '¿Qué es un pitufo?',
		a: 'El pitufo es un bocadillo pequeño típico de Málaga, hecho con un pan redondo y suave. Aquí se prepara a la plancha: los clientes destacan el pitufo mixto con jamón a la plancha, queso fundido y mantequilla.',
	},
	{
		q: '¿Tiene terraza?',
		a: 'Sí, cuenta con una de las terrazas más amplias de la zona, con mesas y sillas en la calle. En las reseñas se repite que es un buen sitio para tomar el café o una cerveza al aire libre.',
	},
	{
		q: '¿Se puede comer, no solo desayunar?',
		a: 'Además de los desayunos y meriendas, hay una carta de tapas, raciones y platos de cuchara, como la porra o el salmorejo. La oferta del día cambia, así que lo mejor es preguntar en la barra.',
	},
	{
		q: '¿Se puede reservar?',
		a: 'No hay reserva en línea. Es un local de barra y mesas por orden de llegada, con terraza; para consultas o pedidos grandes, llama al 952 10 33 87.',
	},
	{
		q: '¿Es un sitio para ir en familia o con niños?',
		a: 'Sí. Es una panadería-cafetería de barrio con mucha clientela local y ambiente familiar, cómoda para desayunar o merendar en grupo.',
	},
	{
		q: '¿Hay pan sin gluten o sin lactosa?',
		a: 'La especialidad de la casa es el pan tradicional, con variedades como el pan de nueces y pipas, y la bollería. Para intolerancias o alergias, lo mejor es preguntar en el despacho de pan qué opciones hay ese día.',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': ['Bakery', 'CafeOrCoffeeShop'],
	'@id': `${business.site}/#negocio`,
	name: business.name,
	alternateName: ['Panadería Hornos Villanueva', 'Cafetería Hornos Villanueva', 'Hornos Villanueva Teatinos'],
	slogan: 'Pan recién hecho, cafetería y terraza en Teatinos',
	description,
	url: `${business.site}/`,
	telephone: '+34 952 10 33 87',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Panadería', 'Cafetería', 'Desayunos', 'Bollería', 'Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	image: `${business.site}/og.jpg`,
	sameAs: [mapsUrl, instagram],
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: cid }],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:30',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '08:00',
			closes: '14:30',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Panadería con obrador', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Desayunos y meriendas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Tapas y raciones', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Café para llevar', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Hornos Villanueva · Panadería y cafetería en Teatinos, Málaga</title>
		<meta name="theme-color" content="#9c5a24" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Hornos Villanueva, panadería Teatinos, cafetería Teatinos, pan recién hecho Málaga, bollería Teatinos, desayunos Teatinos, pitufo Málaga, bocadillos a la plancha Málaga, terraza Teatinos, panadería Juan de Robles, cafetería 29010 Málaga, dulces Málaga"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Hornos Villanueva · Panadería y cafetería en Teatinos, Málaga"
			ogDescription="Pan recién hecho, bollería y dulces, desayunos con pitufos y bocadillos, y amplia terraza en C. Juan de Robles, 53 (Teatinos). 4,2 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Fachada de la panadería y cafetería Hornos Villanueva en Teatinos, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#9c5a24"
			street={business.street}
			city={business.city}
			region="Andalucía"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Teatinos-Universidad, Málaga"
			contact={{
				street: business.street,
				locality: business.city,
				region: 'Andalucía',
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[heroImage]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://hornos-villanueva.vercel.app/og.jpg" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7218327;-4.4613918" />
		<meta name="ICBM" content="36.7218327, -4.4613918" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="HV"
			name="Hornos Villanueva"
			subtitle="Panadería · Cafetería"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Teatinos · Málaga"
				title="Pan recién hecho,<br /><em>desayunos y terraza.</em>"
				lede="Hornos Villanueva es panadería y cafetería en la calle Juan de Robles, 53, en pleno Teatinos. Pan recién horneado, bollería y dulces, desayunos con pitufos y bocadillos a la plancha, y una amplia terraza para el café. De lunes a viernes hasta las 20:30."
				image={heroImage}
				imageAlt="Fachada de Hornos Villanueva con los rótulos de panadería y cafetería, en Teatinos (Málaga)"
				primaryCta={{ label: 'Llamar 952 10 33 87', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,2</b> en Google (634 reseñas)' },
					{ label: 'Horario', html: 'Lunes a viernes, 7:30–20:30' },
					{ label: 'Fines de semana', html: 'Sábado y domingo, 8:00–14:30' },
					{ label: 'Especialidad', html: 'Pan, bollería y <b>terraza</b>' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Hornos Villanueva" items={servicios} />

			<LocalAbout
				label="Panadería y cafetería"
				title="Del horno<br /><em>a la mesa.</em>"
				paragraphs={[
					'Hornos Villanueva está en la calle Juan de Robles, 53, en el barrio de Teatinos-Universidad, con panadería y cafetería en el mismo local: por un lado el obrador y el despacho de pan, por el otro la barra, el salón y la terraza para desayunar, merendar o comer algo.',
					'El pan es el protagonista —barras y hogazas recién hechas, pan de nueces y pipas y bollería— y a su alrededor gira el resto: pitufos y bocadillos a la plancha, café con leche y capuchino, zumos y una carta de tapas, raciones y platos de cuchara. En las reseñas se repiten la «gran variedad de dulces» y el pitufo mixto con jamón a la plancha, queso fundido y mantequilla.',
					'Cuenta con una de las terrazas más amplias de la zona, donde también se puede tomar una cerveza o un refresco. Es un clásico de barrio con mucha clientela: más de 600 reseñas en Google, en su mayoría de vecinos que van a por el pan o a desayunar.',
				]}
				note="La nota media en Google es 4,2 sobre 634 opiniones. Lo que más se repite es el pan y la panadería, los bocadillos, la variedad de dulces y la terraza. Hay algún comentario aislado sobre el servicio o la limpieza de la terraza."
				links={[
					{ label: 'Ficha y reseñas en Google', href: cidUrl, external: true },
					{ label: 'Instagram @hornos_villanueva', href: instagram, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Pan, bollería<br /><em>y desayunos.</em>"
				description="Selección de lo que se sirve en el local, tomada de lo que repiten los clientes en las reseñas y de las fotos de su ficha de Google. La carta del día cambia, así que confírmala en el local."
				cta={{ label: 'Llamar para preguntar', href: phoneHref }}
				groups={grupos}
				note="Los precios y la disponibilidad cambian a diario. Muchos productos se pueden llevar, además de tomarlos en el local: pregunta por teléfono (952 10 33 87) o directamente en la barra."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El horno, la barra<br /><em>y la terraza.</em>"
				description="Estas fotografías proceden del perfil de Hornos Villanueva en Google Maps, con imágenes de la ficha y de sus clientes. En la ficha del local están todas las fotos y las reseñas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del local en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="C. Juan de Robles, 53 · 29010 Málaga"
				title="Nos vemos<br /><em>en Teatinos.</em>"
				addressLines={[
					business.street,
					business.district,
					`${business.postalCode} ${business.city}, España`,
				]}
				hours={[
					{ day: 'Lunes', value: '7:30–20:30' },
					{ day: 'Martes', value: '7:30–20:30' },
					{ day: 'Miércoles', value: '7:30–20:30' },
					{ day: 'Jueves', value: '7:30–20:30' },
					{ day: 'Viernes', value: '7:30–20:30' },
					{ day: 'Sábado', value: '8:00–14:30' },
					{ day: 'Domingo', value: '8:00–14:30' },
				]}
				hoursNote="Horario publicado en la ficha de Google. El local abre todos los días: de lunes a viernes hasta las 20:30 (panadería y cafetería) y los fines de semana solo por la mañana. Puede variar en festivos, así que llama antes si vienes de lejos."
				mapTitle="Mapa de Hornos Villanueva en la calle Juan de Robles, 53, Teatinos-Universidad, Málaga"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Hornos Villanueva · Teatinos"
				mapHref={cidUrl}
				links={[{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' }]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="No hay reserva en línea: es un local de barra, mesas y terraza por orden de llegada. Para consultas, encargos de pan o bollería, o grupos, llama al 952 10 33 87."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="HV"
			name={business.name}
