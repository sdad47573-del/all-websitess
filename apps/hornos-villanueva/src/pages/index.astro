---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/hornos-villanueva-fachada-cafeteria-panaderia-malaga.jpg';
import fachadaPanaderia from '../assets/fotos/hornos-villanueva-fachada-panaderia-malaga.jpg';
import fachadaEsquina from '../assets/fotos/hornos-villanueva-fachada-esquina-teatinos-malaga.jpg';
import terraza from '../assets/fotos/hornos-villanueva-terraza-malaga.jpg';
