---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	business,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las diez fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para
// servirlas con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Restaurante Casa Ricardo | Comida casera en El Ejido';
const description =
	'Restaurante Casa Ricardo, en la calle Tiziano 6 de El Ejido (Almería): cocina española casera, de 8:00 a 17:00. Llama al 950 48 58 89 para confirmar horario y menú.';
const keywords =
	'restaurante El Ejido, Casa Ricardo El Ejido, comer en El Ejido, calle Tiziano, comida casera Almería, Casa Ricardo teléfono';

/**
 * Tira de fotos de la portada: un avance de la galería.
 *
 * La leyenda solo se escribe cuando Google la publica en la ficha; en el resto se deja vacía en
 * lugar de describir una imagen que no se ha comprobado.
 */
const tiraHero = [
	{
		src: foto('restaurante-casa-ricardo-apaisada-04.jpg'),
		alt: 'Fotografía publicada en la ficha de Google Maps de Restaurante Casa Ricardo, en El Ejido (Almería)',
	},
	{
		src: foto('restaurante-casa-ricardo-apaisada-09.jpg'),
		alt: 'Fotografía publicada en la ficha de Google Maps de Restaurante Casa Ricardo, en El Ejido (Almería)',
	},
	{
		src: foto('restaurante-casa-ricardo-vertical-05.jpg'),
		alt: 'Fotografía publicada en la ficha de Google Maps de Restaurante Casa Ricardo, en El Ejido (Almería)',
	},
];

/** Mosaico de «La cocina»: todas las fotos del local menos el fotograma del vídeo. */
const mosaico = [
	{
		src: foto('restaurante-casa-ricardo-apaisada-03.jpg'),
		alt: 'Fotografía publicada en la ficha de Google Maps de Restaurante Casa Ricardo, en El Ejido (Almería)',
		caption: '',
	},
	{
		src: foto('restaurante-casa-ricardo-vertical-07.jpg'),
		alt: 'Paella mixta servida en Restaurante Casa Ricardo, en El Ejido (Almería)',
		caption: 'Paella mixta',
	},
	{
		src: foto('restaurante-casa-ricardo-vertical-06.jpg'),
		alt: 'Natilla de vainilla de postre en Restaurante Casa Ricardo, en El Ejido (Almería)',
		caption: 'Natilla de vainilla',
	},
	{
		src: foto('restaurante-casa-ricardo-apaisada-04.jpg'),
		alt: 'Fotografía publicada en la ficha de Google Maps de Restaurante Casa Ricardo, en El Ejido (Almería)',
		caption: '',
	},
	{
		src: foto('restaurante-casa-ricardo-vertical-08.jpg'),
		alt: 'Fotografía publicada en la ficha de Google Maps de Restaurante Casa Ricardo, en El Ejido (Almería)',
		caption: '',
	},
	{
		src: foto('restaurante-casa-ricardo-apaisada-10.jpg'),
		alt: 'Fotografía publicada en la ficha de Google Maps de Restaurante Casa Ricardo, en El Ejido (Almería)',
		caption: '',
	},
	{
		src: foto('restaurante-casa-ricardo-vertical-05.jpg'),
		alt: 'Fotografía publicada en la ficha de Google Maps de Restaurante Casa Ricardo, en El Ejido (Almería)',
		caption: '',
	},
	{
		src: foto('restaurante-casa-ricardo-apaisada-09.jpg'),
		alt: 'Fotografía publicada en la ficha de Google Maps de Restaurante Casa Ricardo, en El Ejido (Almería)',
		caption: '',
	},
	{
		src: foto('restaurante-casa-ricardo-apaisada-01.jpg'),
		alt: 'Fotografía publicada en la ficha de Google Maps de Restaurante Casa Ricardo, en El Ejido (Almería)',
		caption: '',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#2c2a24" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-AL" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Fotografía de Restaurante Casa Ricardo publicada en su ficha de Google Maps"
		/>
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta
			name="twitter:image:alt"
			content="Fotografía de Restaurante Casa Ricardo publicada en su ficha de Google Maps"
		/>
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">CR</span>
				<span class="brand-text">
					Casa Ricardo
					<small>El Ejido · Almería</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#opiniones">Opiniones</a>
				<a href="#cocina">La cocina</a>
				<a href="#visitanos">Visítanos</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-call" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-inner">
					<p class="hero-eyebrow">C. Tiziano, 6 · El Ejido</p>
					<h1 id="hero-title">Comida de casa<br /><em>en El Ejido.</em></h1>
					<p class="hero-lede">
						Restaurante Casa Ricardo, en pleno El Ejido. Cocina española de siempre, menús
						caseros y raciones generosas, con la mesa puesta desde las ocho de la mañana.
					</p>
					<div class="hero-actions">
						<a class="btn btn-ochre" href={phoneHref}>Llamar al {business.phone}</a>
						<a
							class="btn btn-outline"
							href={mapsUrl}
							target="_blank"
							rel="noopener noreferrer"
						>
							Ver en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="hero-meta">
						<div>
							<small>Dirección</small>
							<strong>{business.streetAddress} · {business.city}</strong>
						</div>
						<div>
							<small>Horario</small>
							<strong>{hoursSummary}</strong>
						</div>
						<div>
							<small>Valoración</small>
							<strong>
								<i aria-hidden="true">★</i>
								{business.rating.toLocaleString('es-ES')} en {business.reviewCount} reseñas
							</strong>
						</div>
					</div>
				</div>

				<div class="hero-strip">
					{
						tiraHero.map((item) => (
							<figure>
								<Image
									src={item.src}
									alt={item.alt}
									widths={[420, 640, 960]}
									sizes="(max-width: 760px) 48vw, 32vw"
									format="avif"
									quality={68}
									loading="eager"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
			</section>

			<div class="facts">
				<span>{business.rating.toLocaleString('es-ES')} sobre 5 con {business.reviewCount} reseñas</span>
				<span>{business.streetAddress} · {business.postalCode} {business.city}</span>
				<span>{hoursSummary}</span>
				<span>{business.category}</span>
			</div>

			<section class="section casa" id="casa" aria-labelledby="casa-title">
				<div class="section-inner casa-grid">
					<div class="casa-text">
						<p class="label">La casa</p>
						<h2 class="section-title" id="casa-title">
							Un restaurante<br /><em>de los de siempre.</em>
						</h2>
						<p>
							Casa Ricardo está en la calle Tiziano, 6, en El Ejido (Almería). Su ficha de
							Google Maps lo clasifica como restaurante de cocina española y le da una
							valoración de {business.rating.toLocaleString('es-ES')} sobre 5 con
							{business.reviewCount} reseñas escritas por personas que han comido aquí.
						</p>
						<p>
							En esas reseñas la palabra que más se repite es «casero»: menús caseros, comida
							casera y raciones generosas. Abre a las 8:00 y cierra a las 17:00, así que cubre
							desde el desayuno hasta la comida del mediodía.
						</p>
						<p class="casa-note">
							Esta web se ha preparado solo con lo que publica la ficha de Google Maps del
							restaurante, consultada el {site.consultado}: nombre, dirección, teléfono,
							categoría, horario, valoración, sus reseñas y sus propias fotografías. La ficha
							no publica carta, precios ni lista de servicios, así que aquí no se inventa
							ninguno.
						</p>
						<figure class="casa-quote">
							<blockquote>{reviews[0].text}</blockquote>
							<figcaption>Reseña de la ficha de Google Maps</figcaption>
						</figure>
					</div>
					<div class="casa-photos">
						<figure class="casa-photo-main">
							<Image
								src={foto('restaurante-casa-ricardo-vertical-08.jpg')}
								alt="Fotografía publicada en la ficha de Google Maps de Restaurante Casa Ricardo, en El Ejido (Almería)"
								widths={[420, 640, 900]}
								sizes="(max-width: 1080px) 94vw, 32vw"
								format="avif"
								quality={70}
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<figure class="casa-photo-small">
							<Image
								src={foto('restaurante-casa-ricardo-apaisada-01.jpg')}
								alt="Fotografía publicada en la ficha de Google Maps de Restaurante Casa Ricardo, en El Ejido (Almería)"
								widths={[240, 360, 480]}
								sizes="(max-width: 1080px) 40vw, 13vw"
								format="avif"
								quality={68}
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<p class="casa-photo-caption">Fotografías del restaurante en su ficha de Google Maps</p>
					</div>
				</div>
			</section>

			<section class="section opiniones" id="opiniones" aria-labelledby="opiniones-title">
				<div class="section-inner">
					<div class="opiniones-head">
						<div>
							<p class="label">Opiniones</p>
							<h2 class="section-title" id="opiniones-title">
								Lo que cuentan<br /><em>los clientes.</em>
							</h2>
						</div>
						<div class="score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>{business.reviewCount} reseñas en Google Maps</span>
						</div>
					</div>
					<div class="opiniones-grid">
						{
							reviews.map((review) => (
								<blockquote class="opinion">
									<p>{review.text}</p>
									<footer>{review.source}</footer>
								</blockquote>
							))
						}
					</div>
					<p class="opiniones-note">
						Son las tres reseñas que Google muestra destacadas en la ficha del restaurante. Puedes
						leerlas todas en el{' '}
						<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
							listado público de reseñas de Casa Ricardo ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section cocina" id="cocina" aria-labelledby="cocina-title">
				<div class="section-inner">
					<p class="label">La cocina</p>
					<h2 class="section-title" id="cocina-title">
						Lo que se sirve<br /><em>en estas mesas.</em>
					</h2>
					<p class="section-intro">
						Estas son las fotografías que el propio restaurante publica en su ficha de Google
						Maps: platos y rincones del local, no imágenes de catálogo. Cuando Google acompaña
						una foto con su nombre, se copia tal cual.
					</p>
					<div class="cocina-grid">
						{
							mosaico.map((item) => (
								<figure class="cocina-item">
									<Image
										src={item.src}
										alt={item.alt}
										widths={[380, 560, 800]}
										sizes="(max-width: 1080px) 46vw, 30vw"
										format="avif"
										quality={68}
										loading="lazy"
										decoding="async"
									/>
									{item.caption ? <figcaption>{item.caption}</figcaption> : null}
								</figure>
							))
						}
					</div>
					<p class="cocina-note">
						La ficha no publica carta ni precios, así que esta web no los reproduce. Para saber
						qué hay hoy, lo más rápido es{' '}
						<a href={phoneHref}>llamar al {business.phone}</a> o mirar las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section visita" id="visitanos" aria-labelledby="visita-title">
				<div class="section-inner visita-grid">
					<div>
						<p class="label">Visítanos</p>
						<h2 class="section-title" id="visita-title">
							Calle Tiziano, 6.<br /><em>{business.city}.</em>
						</h2>
						<address>
							{business.streetAddress}<br />
							{business.postalCode} {business.city}<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{
									hours.map((item) => (
										<tr class:list={[{ 'is-closed': !item.open }]}>
											<th scope="row">{item.day}</th>
											<td>{item.service}</td>
										</tr>
									))
								}
							</tbody>
						</table>
						<p class="hours-note">
							Al consultar la ficha, el lunes 12 de octubre de 2026 aparecía marcado como festivo
							nacional con el aviso de que el horario podía variar. Antes de desplazarte, llama
							y confirma el día.
						</p>
						<a class="phone-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="visita-actions">
							<a
								class="btn btn-ink"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ochre" href={phoneHref}>Llamar y preguntar</a>
						</div>
					</div>
					<div class="map-card">
						<iframe
							title={`Mapa de ${business.name} en la calle Tiziano, ${business.city}`}
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
						<div class="map-badge">
							<div>
								<strong>{business.name}</strong>
								<small>C. Tiziano, 6 · 04700 El Ejido</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section preguntas" id="preguntas" aria-labelledby="preguntas-title">
				<div class="section-inner">
					<p class="label">Preguntas frecuentes</p>
					<h2 class="section-title" id="preguntas-title">Antes de <em>venir.</em></h2>
					<div class="preguntas-list">
						{
							faqs.map((faq) => (
								<details>
									<summary>{faq.question}</summary>
									<p>{faq.answer}</p>
								</details>
							))
						}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-grid">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">CR</span>
					<span>
						Casa Ricardo
						<small>C. Tiziano, 6 · 04700 El Ejido</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del restaurante">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">Ficha en Google Maps ↗</a>
					<a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Reseñas en Google ↗</a>
				</nav>
				<small class="footer-legal">
					© {new Date().getFullYear()} Restaurante Casa Ricardo · El Ejido (Almería). Web
					informativa elaborada con los datos y las fotografías que el restaurante publica en su
					ficha de Google Maps, consultada el {site.consultado}. Confirma horario y menú por
					teléfono antes de venir.
				</small>
			</div>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a Casa Ricardo <span>{business.phone}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
