# Variables de entorno del proyecto (copia este archivo como ".env")

# ── Google Search Console (opcional) ────────────────────────────────────────
# Si verificas por "etiqueta HTML", pega aquí el contenido del content="..."
# de la etiqueta que te da Google y añade la variable también en Vercel.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Datos legales (obligatorios para publicar) ──────────────────────────────
# NIF/DNI del titular y email de contacto que aparecen en el aviso legal y la
# política de privacidad. Sin los dos, el sitio NO cumple el art. 10 de la
# LSSI-CE: las páginas legales muestran "[pendiente de completar]".
PUBLIC_LEGAL_NIF=
PUBLIC_LEGAL_EMAIL=

# ── Dominio del sitio ───────────────────────────────────────────────────────
# El dominio vive en astro.config.mjs (campo `site`). Si algún día cambias de
# dominio, actualiza ahí y en public/robots.txt.
