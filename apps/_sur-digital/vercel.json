{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs",
	"git": {
		"deploymentEnabled": false
	},
	"redirects": [
		{
			"source": "^/(en|de|fr|pt|ru)/(.*)$",
			"destination": "/$2",
			"permanent": true
		},
		{
			"source": "^/(en|de|fr|pt|ru)$",
			"destination": "/",
			"permanent": true
		}
	],
	"rewrites": [
		{
			"source": "^/$",
			"has": [{ "type": "cookie", "key": "lang", "value": "en" }],
			"destination": "/i18n/en/"
		},
		{
			"source": "^/(precios|contacto|faq|glosario)/?$",
			"has": [{ "type": "cookie", "key": "lang", "value": "en" }],
			"destination": "/i18n/en/$1/"
		},
		{
			"source": "^/$",
			"has": [{ "type": "cookie", "key": "lang", "value": "de" }],
			"destination": "/i18n/de/"
		},
		{
			"source": "^/(precios|contacto|faq|glosario)/?$",
			"has": [{ "type": "cookie", "key": "lang", "value": "de" }],
			"destination": "/i18n/de/$1/"
		},
		{
			"source": "^/$",
			"has": [{ "type": "cookie", "key": "lang", "value": "fr" }],
			"destination": "/i18n/fr/"
		},
		{
			"source": "^/(precios|contacto|faq|glosario)/?$",
			"has": [{ "type": "cookie", "key": "lang", "value": "fr" }],
			"destination": "/i18n/fr/$1/"
		},
		{
			"source": "^/$",
			"has": [{ "type": "cookie", "key": "lang", "value": "pt" }],
			"destination": "/i18n/pt/"
		},
		{
			"source": "^/(precios|contacto|faq|glosario)/?$",
			"has": [{ "type": "cookie", "key": "lang", "value": "pt" }],
			"destination": "/i18n/pt/$1/"
		},
		{
			"source": "^/$",
			"has": [{ "type": "cookie", "key": "lang", "value": "ru" }],
			"destination": "/i18n/ru/"
		},
		{
			"source": "^/(precios|contacto|faq|glosario)/?$",
			"has": [{ "type": "cookie", "key": "lang", "value": "ru" }],
			"destination": "/i18n/ru/$1/"
		},
		{
			"source": "^/$",
			"destination": "/i18n/es/"
		},
		{
			"source": "^/(precios|contacto|faq|glosario)/?$",
			"destination": "/i18n/es/$1/"
		}
	]
}
