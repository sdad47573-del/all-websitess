---
// Hero de la home con los modelos 3D de public/models. Mantiene el lenguaje
// visual del resto del sitio: superficies y textos de daisyUI (base-100/200,
// base-content), botones del tema y tarjeta con borde y sombra como el resto
// de secciones. Sin tipografías ni paleta propias.
//
// Three.js y el primer modelo se cargan en diferido, solo cuando el hero entra
// en pantalla; el resto se carga al pulsar su botón del selector. El modelo
// mira al cursor y da una vuelta completa al hacer clic. Con
// `prefers-reduced-motion` se apaga el movimiento ambiental, pero la mirada y
// el giro se mantienen porque los provoca el visitante.
import { CONTACT } from "../data/contact";
import LinkedInIcon from "../icons/LinkedInIcon.astro";

// Galería del hero: un botón por archivo. El formato decide el loader
// (GLTFLoader, OBJLoader o FBXLoader), que se importa solo al usarlo.
// Consejo: los GLB por encima de ~10 MB tardan en descargar y en parsear, así
// que primero van los ligeros.
type ModelFormat = "glb" | "obj" | "fbx";

// Texturas externas que sustituyen a las que trae el modelo incrustadas
// (ver applyMaps en el script).
interface ModelTextures {
  baseColor?: string;
  normal?: string;
  ao?: string;
  metallicRoughness?: string;
  // Los normales en DirectX llevan el canal verde invertido respecto a OpenGL.
  normalIsDirectX?: boolean;
}

interface ModelEntry {
  label: string;
  src: string;
  format: ModelFormat;
  textures?: ModelTextures;
}

const MODELS: ModelEntry[] = [
  { label: "Hero", src: "/models/hero-modelo.glb", format: "glb" },
  { label: "Planeta 19", src: "/models/planeta-19.glb", format: "glb" },
  { label: "Logo IE · OBJ", src: "/models/ie-logo.obj", format: "obj" },
  { label: "Logo IE · FBX", src: "/models/ie-logo.fbx", format: "fbx" },
  { label: "Stitch", src: "/models/stitch.glb", format: "glb" },
  { label: "Monster Store", src: "/models/monster-store.glb", format: "glb" },
  { label: "Modelo OBJ", src: "/models/objeto-2.obj", format: "obj" },
];
---

<!-- Sin data-reveal a propósito: el hero está siempre por encima del fold,
     así que la animación de entrada no aporta nada y sí retrasa el LCP. -->
<section
  class="relative overflow-hidden bg-gradient-to-br from-base-200 via-base-100 to-base-100 pt-28 pb-12 md:pt-32 md:pb-16"
>
  <div class="container mx-auto grid max-w-6xl items-center gap-10 px-6 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12">
    <div class="relative z-10 text-center lg:text-left">
      <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-base-100/80 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.12em] text-primary shadow-sm">
        <span class="size-2 rounded-full bg-secondary" aria-hidden="true"></span>
        Consultora web para negocios de Málaga
      </p>

      <h1 class="mb-5 text-balance text-4xl font-black leading-[1.08] tracking-tight text-base-content sm:text-5xl lg:text-6xl">
        Tu negocio merece una web que <span class="text-wave">traiga clientes.</span>
      </h1>

      <p class="mx-auto mb-6 max-w-xl text-lg leading-relaxed text-base-content/70 lg:mx-0">
        Diseñamos webs rápidas y a medida para negocios locales. Tu primera landing gratis y online en <strong class="text-base-content">menos de 7 días</strong>, con precio cerrado por escrito. <a href="/precios/" class="link link-primary font-bold underline decoration-primary/50 underline-offset-4">Ver precios →</a>
      </p>

      <div class="flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center lg:justify-start">
        <a
          href={CONTACT.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-lg shadow-lg shadow-primary/15"
        >
          <LinkedInIcon class="size-5" />
          Solicita tu landing gratis
        </a>
        <a href="#clientes" class="btn btn-ghost btn-lg">
          Ver clientes reales
          <span aria-hidden="true">↓</span>
        </a>
      </div>

      <p class="mt-4 text-sm font-bold text-base-content">
        🔥 Solo 5 webs gratis al mes · Respondemos en menos de 24h
      </p>

      <ul class="mt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm text-base-content/70 lg:justify-start">
        <li class="flex items-center gap-2">
          <span class="font-black text-success" aria-hidden="true">✓</span>
          Precio cerrado
        </li>
        <li class="flex items-center gap-2">
          <span class="font-black text-success" aria-hidden="true">✓</span>
          Dominio a tu nombre
        </li>
        <li class="flex items-center gap-2">
          <span class="font-black text-success" aria-hidden="true">✓</span>
          Sin permanencia
        </li>
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-lg lg:mx-0">
      <div
        data-model3d
        class="relative aspect-square"
        role="img"
        aria-label="Modelo 3D interactivo. Mira hacia el cursor y da una vuelta completa al hacer clic."
      >
        <canvas data-model3d-canvas class="block h-full w-full" aria-hidden="true"></canvas>

        <p
          data-model3d-loading
          class="pointer-events-none absolute inset-x-0 bottom-3 text-center text-[10px] font-bold uppercase tracking-[0.2em] text-base-content/40"
        >
          Cargando modelo…
        </p>

        <p
          data-model3d-error
          hidden
          class="pointer-events-none absolute inset-x-0 bottom-3 text-center text-[10px] font-bold uppercase tracking-[0.2em] text-base-content/40"
        >
          No se ha podido cargar el modelo 3D
        </p>
      </div>

      <!-- Selector: un botón por modelo de public/models. Va debajo del canvas
           y fuera de [data-model3d] para que pulsarlo no cuente como clic
           sobre el modelo (ese clic le da una vuelta completa). -->
      <div
        class="mt-4 flex flex-wrap justify-center gap-2"
        role="group"
        aria-label="Cambiar de modelo 3D"
      >
        {
          MODELS.map((model, index) => (
            <button
              type="button"
              data-model3d-option
              data-src={model.src}
              data-format={model.format}
              data-label={model.label}
              data-color-map={model.textures?.baseColor}
              data-normal-map={model.textures?.normal}
              data-ao-map={model.textures?.ao}
              data-metallic-roughness-map={model.textures?.metallicRoughness}
              data-normal-directx={model.textures?.normalIsDirectX ? "true" : undefined}
              aria-pressed={index === 0 ? "true" : "false"}
              class:list={[
                "btn btn-xs sm:btn-sm",
                index === 0 ? "btn-primary" : "btn-outline",
              ]}
            >
              {model.label}
            </button>
          ))
        }
      </div>

      <p class="mt-3 text-center text-sm text-base-content/60 lg:text-left">
        La web de tu negocio, pieza a pieza: estructura, contenido y
        posicionamiento local.
      </p>
    </div>
  </div>
</section>

<script>
  // Galería 3D del hero con Three.js. Se carga en diferido (Three.js + el
  // primer modelo) y se pausa fuera de pantalla o con la pestaña oculta. Los
  // modelos se cambian con los botones de debajo del canvas; el modelo mira al
  // cursor todo el rato y da una vuelta completa al hacer clic.
  import type { Mesh, MeshStandardMaterial, Object3D, Texture } from "three";

  const host = document.querySelector<HTMLElement>("[data-model3d]");
  const canvas = host?.querySelector<HTMLCanvasElement>("[data-model3d-canvas]");
  const optionButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-model3d-option]")
  );

  if (host && canvas) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let booted = false;
    let selectModel: ((button: HTMLButtonElement) => void) | null = null;

    // Marca visual del botón activo (daisyUI: primario = elegido).
    const setPressed = (button: HTMLButtonElement) => {
      for (const option of optionButtons) {
        const active = option === button;
        option.setAttribute("aria-pressed", active ? "true" : "false");
        option.classList.toggle("btn-primary", active);
        option.classList.toggle("btn-outline", !active);
      }
    };

    // Se puede pulsar antes de que el hero termine de arrancar: el botón queda
    // marcado y boot() carga ese modelo en cuanto termina de preparar la escena.
    for (const option of optionButtons) {
      option.addEventListener("click", () => {
        setPressed(option);
        selectModel?.(option);
        void boot();
      });
    }

    const boot = async () => {
      if (booted) return;
      booted = true;

      const loading = host.querySelector<HTMLElement>("[data-model3d-loading]");
      const errorLabel = host.querySelector<HTMLElement>("[data-model3d-error]");

      try {
        const THREE = await import("three");

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
          powerPreference: "high-performance",
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 50);
        camera.position.set(0, 0.25, 6.4);
        camera.lookAt(0, 0, 0);

        // Luz de estudio: relleno frío + clave + dos rim lights de marca.
        scene.add(new THREE.HemisphereLight(0xffffff, 0x16273a, 1.2));

        const key = new THREE.DirectionalLight(0xffffff, 2.6);
        key.position.set(3.2, 4.2, 4.8);
        scene.add(key);

        const rimWarm = new THREE.PointLight(0xffb066, 22, 24, 2);
        rimWarm.position.set(-3.2, 1.4, 3.2);
        scene.add(rimWarm);

        const rimCool = new THREE.PointLight(0x2b9bff, 16, 24, 2);
        rimCool.position.set(3.4, -1.4, 2.4);
        scene.add(rimCool);

        const BASE_X = 0;
        const BASE_Y = -0.35;
        const TAU = Math.PI * 2;

        const stage = new THREE.Group();
        stage.rotation.set(BASE_X, BASE_Y, 0);
        scene.add(stage);

        // --- Modelos del selector ---
        // Un loader por formato, importado solo cuando se usa: así el visitante
        // que no prueba los OBJ/FBX no descarga sus parsers.
        const loadObject = async (src: string, format: string): Promise<Object3D> => {
          if (format === "obj") {
            const { OBJLoader } = await import("three/examples/jsm/loaders/OBJLoader.js");
            return await new OBJLoader().loadAsync(src);
          }
          if (format === "fbx") {
            const { FBXLoader } = await import("three/examples/jsm/loaders/FBXLoader.js");
            return await new FBXLoader().loadAsync(src);
          }
          const { GLTFLoader } = await import("three/examples/jsm/loaders/GLTFLoader.js");
          return (await new GLTFLoader().loadAsync(src)).scene;
        };

        // Liberar geometría, materiales y texturas del modelo que se va: los
        // archivos son grandes y sin esto cada cambio dejaría memoria de GPU
        // retenida hasta recargar la página.
        const disposeObject = (object: Object3D) => {
          object.traverse((node) => {
            const mesh = node as Mesh;
            if (!mesh.isMesh) return;
            mesh.geometry.dispose();
            const materials = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
            for (const material of materials) {
              for (const value of Object.values(material as unknown as Record<string, unknown>)) {
                if (value && (value as Texture).isTexture) (value as Texture).dispose();
              }
              material.dispose();
            }
          });
        };

        // Texturas externas (pack del D_Rex): se aplican encima y sustituyen a
        // las que trae el modelo incrustadas. El normal del pack está en
        // DirectX, con el canal verde invertido respecto a OpenGL, que es lo
        // que espera three; el AO se lee de un segundo juego de UVs (uv1).
        type ExternalMaps = {
          baseColor?: string;
          normal?: string;
          ao?: string;
          metallicRoughness?: string;
          normalIsDirectX?: boolean;
        };

        const applyMaps = async (object: Object3D, maps: ExternalMaps) => {
          const loader = new THREE.TextureLoader();
          const [map, normalMap, aoMap, metalnessRoughnessMap] = await Promise.all([
            maps.baseColor ? loader.loadAsync(maps.baseColor) : null,
            maps.normal ? loader.loadAsync(maps.normal) : null,
            maps.ao ? loader.loadAsync(maps.ao) : null,
            maps.metallicRoughness ? loader.loadAsync(maps.metallicRoughness) : null,
          ]);
          if (map) map.colorSpace = THREE.SRGBColorSpace;
          if (normalMap) normalMap.colorSpace = THREE.NoColorSpace;
          if (aoMap) aoMap.colorSpace = THREE.NoColorSpace;
          if (metalnessRoughnessMap) metalnessRoughnessMap.colorSpace = THREE.NoColorSpace;

          // glTF usa flipY = false (lo pone GLTFLoader), pero TextureLoader deja
          // true: sin esto cada isla del atlas se muestrea volteada y el modelo
          // sale con manchas de otras partes de la textura.
          for (const texture of [map, normalMap, aoMap, metalnessRoughnessMap]) {
            if (texture) texture.flipY = false;
          }

          object.traverse((node) => {
            const mesh = node as Mesh;
            if (!mesh.isMesh) return;

            // Si el modelo solo trae uv0, se reutiliza para el AO.
            const uv = mesh.geometry.getAttribute("uv");
            if (aoMap && uv && !mesh.geometry.getAttribute("uv1")) {
              mesh.geometry.setAttribute("uv1", uv);
            }

            const materials = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
            for (const material of materials) {
              const standard = material as MeshStandardMaterial;
              if (map) {
                standard.map = map;
                standard.color.set(0xffffff);
              }
              if (metalnessRoughnessMap) {
                // Los mapas se multiplican por metalness/roughness: a 1 para que
                // mande la textura.
                standard.metalnessMap = metalnessRoughnessMap;
                standard.roughnessMap = metalnessRoughnessMap;
                standard.metalness = 1;
                standard.roughness = 1;
              } else if (map) {
                // Sin mapa de metal/rugosidad: material dieléctrico y mate.
                standard.metalnessMap = null;
                standard.roughnessMap = null;
                standard.metalness = 0;
                standard.roughness = 0.8;
              }
              if (normalMap) {
                standard.normalMap = normalMap;
                standard.normalScale.set(1, maps.normalIsDirectX ? -1 : 1);
              }
              if (aoMap) {
                standard.aoMap = aoMap;
                standard.aoMapIntensity = 1;
              }
              standard.needsUpdate = true;
            }
          });
        };

        let pivot: Object3D | null = null;
        let currentSrc = "";
        let loadToken = 0;

        const showModel = async (
          src: string,
          format: string,
          label: string,
          maps: ExternalMaps = {}
        ) => {
          if (src === currentSrc) return;

          const token = ++loadToken;
          if (errorLabel) errorLabel.hidden = true;
          if (loading) {
            loading.textContent = label ? `Cargando ${label}…` : "Cargando modelo…";
            loading.hidden = false;
          }

          let next: Object3D;
          try {
            next = await loadObject(src, format);
          } catch (error) {
            console.warn(`El modelo 3D ${src} no se ha podido cargar.`, error);
            if (token === loadToken) {
              if (loading) loading.hidden = true;
              if (errorLabel) errorLabel.hidden = false;
            }
            return; // se queda el modelo anterior
          }

          // Mientras cargaba se ha pedido otro modelo: se descarta este.
          if (token !== loadToken) {
            disposeObject(next);
            return;
          }

          if (maps.baseColor || maps.normal || maps.ao || maps.metallicRoughness) {
            try {
              await applyMaps(next, maps);
            } catch (error) {
              // Sin texturas externas el modelo se ve igual, con las suyas.
              console.warn(`No se han podido aplicar las texturas a ${src}.`, error);
            }
            if (token !== loadToken) {
              disposeObject(next);
              return;
            }
          }

          // Centrar y escalar a partir de su caja real: los modelos vienen en
          // unidades de Blender o de Rhino (a veces centímetros), así que sin
          // normalizar saldrían diminutos o gigantes.
          const bounds = new THREE.Box3().setFromObject(next);
          const size = bounds.getSize(new THREE.Vector3());
          const center = bounds.getCenter(new THREE.Vector3());
          next.position.sub(center);

          const group = new THREE.Group();
          group.add(next);
          group.scale.setScalar(2.8 / Math.max(size.x, size.y, size.z));

          if (pivot) {
            stage.remove(pivot);
            disposeObject(pivot);
          }
          pivot = group;
          stage.add(group);
          currentSrc = src;

          if (loading) loading.hidden = true;
          if (!raf) draw(0);
        };

        const mapsFrom = (button: HTMLButtonElement): ExternalMaps => ({
          baseColor: button.dataset.colorMap,
          normal: button.dataset.normalMap,
          ao: button.dataset.aoMap,
          metallicRoughness: button.dataset.metallicRoughnessMap,
          normalIsDirectX: button.dataset.normalDirectx === "true",
        });

        selectModel = (button) => {
          void showModel(
            button.dataset.src ?? "",
            button.dataset.format ?? "glb",
            button.dataset.label ?? "",
            mapsFrom(button)
          );
        };

        // --- Tamaño ---
        const resize = () => {
          const rect = host.getBoundingClientRect();
          const width = Math.max(1, Math.round(rect.width));
          const height = Math.max(1, Math.round(rect.height));
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        };

        resize();

        // El modelo mira siempre al cursor: se escucha en toda la ventana y el
        // ángulo se limita para que nunca llegue a girarse de espaldas.
        const pointer = { x: 0, y: 0 };
        const gaze = { x: 0, y: 0 };

        // El rectángulo se cachea: leerlo en cada pointermove fuerza un recálculo
        // de layout decenas de veces por segundo y el cursor se nota pegajoso.
        // Solo se refresca cuando la página se mueve o cambia de tamaño.
        let box = host.getBoundingClientRect();
        let boxStale = false;
        const clampGaze = (value: number) => Math.max(-1.6, Math.min(1.6, value)) / 1.6;

        const readPointer = (event: PointerEvent) => {
          if (boxStale) {
            box = host.getBoundingClientRect();
            boxStale = false;
          }
          pointer.x = clampGaze((event.clientX - (box.left + box.width / 2)) / (box.width * 0.5));
          pointer.y = clampGaze((event.clientY - (box.top + box.height / 2)) / (box.height * 0.5));
        };

        const lookAway = () => {
          pointer.x = 0;
          pointer.y = 0;
        };

        window.addEventListener("pointermove", readPointer, { passive: true });
        window.addEventListener(
          "scroll",
          () => {
            boxStale = true;
          },
          { passive: true }
        );
        document.addEventListener("pointerleave", lookAway);
        window.addEventListener("blur", lookAway);

        // Un clic sobre el modelo da una vuelta completa; después vuelve a
        // mirar al cursor, porque 2π y 0 son la misma orientación.
        let spin = 0;
        let spinTarget = 0;

        const spinOnce = () => {
          spinTarget += TAU;
        };

        host.addEventListener("click", spinOnce);

        let raf = 0;
        let elapsed = 0;
        const clock = new THREE.Clock();

        const draw = (delta: number) => {
          elapsed += delta;

          const ease = (current: number, target: number, speed: number) =>
            current + (target - current) * Math.min(1, delta * speed);

          gaze.x = ease(gaze.x, pointer.x, 10);
          gaze.y = ease(gaze.y, pointer.y, 10);

          if (spinTarget !== spin) {
            spin = ease(spin, spinTarget, 7);
            if (Math.abs(spinTarget - spin) < 0.015) {
              spin = 0;
              spinTarget = 0;
            }
          }

          // El flote y el balanceo son ambiente: con reduced-motion se apagan
          // (multiplicados por 0), pero la mirada y el giro del clic siguen.
          const ambient = reduceMotion.matches ? 0 : 1;

          stage.rotation.y = BASE_Y + spin + gaze.x * 0.5 + Math.sin(elapsed * 0.34) * 0.03 * ambient;
          stage.rotation.x = BASE_X + gaze.y * 0.22 + Math.cos(elapsed * 0.29) * 0.015 * ambient;
          stage.rotation.z = Math.sin(elapsed * 0.22) * 0.012 * ambient - gaze.x * 0.03;
          stage.position.x = gaze.x * 0.05;
          stage.position.y = Math.sin(elapsed * 0.62) * 0.04 * ambient - gaze.y * 0.04;

          renderer.render(scene, camera);
        };

        const loop = () => {
          raf = requestAnimationFrame(loop);
          if (document.hidden) {
            clock.getDelta();
            return;
          }
          draw(Math.min(clock.getDelta(), 0.05));
        };

        // setSize limpia el lienzo: cuando el bucle está parado (fuera de
        // pantalla) hay que repintar el frame estático a mano.
        new ResizeObserver(() => {
          resize();
          boxStale = true;
          if (!raf) draw(0);
        }).observe(host);

        const visibility = new IntersectionObserver(
          ([entry]) => {
            if (entry.isIntersecting) {
              if (!raf) loop();
            } else {
              cancelAnimationFrame(raf);
              raf = 0;
            }
          },
          { threshold: 0.05 }
        );
        visibility.observe(host);

        loop();

        reduceMotion.addEventListener("change", () => {
          if (!raf) loop();
        });

        draw(0);

        // Primer modelo: el botón marcado (o el primero del selector).
        const initial =
          optionButtons.find((option) => option.getAttribute("aria-pressed") === "true") ??
          optionButtons[0];
        if (initial) {
          void showModel(
            initial.dataset.src ?? "",
            initial.dataset.format ?? "glb",
            initial.dataset.label ?? "",
            mapsFrom(initial)
          );
        } else if (loading) {
          loading.hidden = true;
        }
      } catch (error) {
        console.warn("El modelo 3D del hero no se ha podido cargar.", error);
        if (loading) loading.hidden = true;
        if (errorLabel) errorLabel.hidden = false;
      }
    };

    if ("IntersectionObserver" in window) {
      const near = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            near.disconnect();
            boot();
          }
        },
        { rootMargin: "300px" }
      );
      near.observe(host);
    } else {
      boot();
    }
  }
</script>
