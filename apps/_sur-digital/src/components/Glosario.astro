---
import { TERMINOS } from "../data/glosario";

// Glosario "en cristiano": las palabras que se usan al vender una web,
// traducidas a una frase. La lista vive en src/data/glosario.ts porque también
// alimenta la página /glosario/ (aquí solo se pinta la rejilla).
const terminos = TERMINOS;
---

<section
  id="glosario"
  class="pt-14 pb-20 bg-gradient-to-b from-base-100 to-base-200 flex flex-col items-center"
>
  <div class="container mx-auto px-6 flex flex-col items-center">
    <div data-reveal class="flex flex-col items-center text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-base-content">
        El diccionario <span class="text-wave">en cristiano</span>
      </h2>
      <p class="text-base-content/70 max-w-2xl mt-3 mb-10">
        Si alguien te vende una web y no te explica estas {terminos.length}{" "}
        palabras, mal empezamos. Aquí las tienes sin humo, para que negocies
        sabiendo lo que firmas.
      </p>
    </div>

    <ul
      data-reveal-group
      class="grid grid-cols-1 sm:grid-cols-2 gap-4 justify-items-stretch max-w-4xl w-full"
    >
      {
        terminos.map(({ term, text, href }) => (
          <li class="card bg-base-100 shadow-sm border border-base-300">
            <div class="card-body gap-2 p-5">
              <h3 class="card-title text-base">{term}</h3>
              <p class="text-sm text-base-content/70 leading-relaxed">{text}</p>
              {href && (
                <a href={href} class="link link-primary text-sm font-bold">
                  Leer el análisis →
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    <p data-reveal class="text-center text-sm text-base-content/60 mt-8 max-w-xl mx-auto">
      ¿Te falta alguna palabra por traducir? Pregúntanosla y te la explicamos
      sin compromiso.
    </p>
  </div>
</section>
