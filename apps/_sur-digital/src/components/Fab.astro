---
// Botón flotante (FAB) de contacto: siempre visible al hacer scroll, lleva
// directo al perfil de LinkedIn. Oculto en móvil (ahí lo cubre MobileCta).
import { CONTACT } from "../data/contact";
import LinkedInIcon from "../icons/LinkedInIcon.astro";
---

<div class="fixed right-5 bottom-5 z-40 hidden md:block">
  <a
    href={CONTACT.linkedin}
    target="_blank"
    rel="noopener noreferrer"
    class="btn btn-circle btn-lg border-0 shadow-lg bg-[#0A66C2] text-white hover:bg-[#084c94] hover:shadow-xl transition-all"
    aria-label="Escríbenos por LinkedIn"
  >
    <LinkedInIcon class="size-7" />
  </a>
</div>
