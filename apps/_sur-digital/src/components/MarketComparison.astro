---
// Comparativa con nombre y precio publicado de los competidores de Málaga.
// Sustituye la versión genérica («la agencia tradicional») por datos que se
// pueden contrastar: ver COMPETENCIA-FEATURES.md.
//
// Solo se pinta lo que cada proveedor publica en su web. Si no publica un
// precio, se escribe «No publicado» o «—» en vez de estimarlo.
import {
  FEATURE_COMPARISON,
  MARKET_COMPARISON,
  NATIONAL_COMPARISON,
  MARKET_UPDATED,
} from "../data/market";
import { SECTORS } from "../data/sectors";

const totalSectors = SECTORS.length;

// Separa el símbolo del texto de la condición: «✓ 0 €» → icono + «0 €».
const cell = (value: string) => {
  if (value.startsWith("✓"))
    return { mark: "yes" as const, text: value.slice(1).trim() };
  if (value.startsWith("✗"))
    return { mark: "no" as const, text: value.slice(1).trim() };
  return { mark: "text" as const, text: value };
};
---

<section
  id="comparativa-mercado"
  class="pt-14 pb-20 bg-transparent flex flex-col items-center"
>
  <div class="container mx-auto px-6 flex flex-col items-center">
    <h2
      data-reveal
      class="text-3xl md:text-4xl font-bold text-base-content text-center"
    >
      Sur Digital frente <span class="text-wave">al mercado de Málaga</span>
    </h2>
    <p data-reveal class="text-base-content/70 text-center max-w-2xl mt-3 mb-6">
      Lo que cobra cada proveedor, según lo que publica en su web. Sin
      «desde» interpretados ni precios inventados: si una agencia no publica
      tarifa, aquí aparece como <em>no publicado</em>.
    </p>

    <p data-reveal class="md:hidden text-xs text-base-content/50 mb-4 text-center">
      Desliza la tabla para comparar las 6 columnas →
    </p>

    <div
      data-reveal
      role="region"
      aria-label="Comparativa de precios y servicios con agencias de Málaga"
      tabindex="0"
      class="overflow-x-auto w-full max-w-6xl shadow-lg rounded-box border border-base-300 bg-base-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary"
    >
      <table class="table table-sm md:table-md">
        <caption class="sr-only">
          Precios y servicios publicados por Sur Digital y nueve competidores
          de Málaga, consultados el {MARKET_UPDATED}
        </caption>
        <thead>
          <tr class="border-b-base-300">
            <th scope="col" class="bg-transparent text-start font-bold">Proveedor</th>
            <th scope="col" class="bg-transparent text-start font-bold">Web y ecommerce</th>
            <th scope="col" class="bg-transparent text-start font-bold">SEO local</th>
            <th scope="col" class="bg-transparent text-start font-bold">Redes / Ads</th>
            <th scope="col" class="bg-transparent text-start font-bold">Mantenimiento</th>
            <th scope="col" class="bg-transparent text-start font-bold">
              Qué le queda al competidor
            </th>
          </tr>
        </thead>
        <tbody>
          {
            MARKET_COMPARISON.map(({ provider, web, seo, ads, maintenance, edge, us }) => (
              <tr
                class:list={[
                  "border-b-base-200 align-top",
                  us ? "bg-primary/5" : "hover:bg-base-200/40",
                ]}
              >
                <th
                  scope="row"
                  class:list={[
                    "text-start text-sm whitespace-nowrap",
                    us ? "font-black text-primary" : "font-bold",
                  ]}
                >
                  {provider}
                </th>
                <td class="text-xs md:text-sm text-base-content/80 min-w-56">{web}</td>
                <td class="text-xs md:text-sm text-base-content/80 min-w-48">{seo}</td>
                <td class="text-xs md:text-sm text-base-content/80 min-w-48">{ads}</td>
                <td class="text-xs md:text-sm text-base-content/80 min-w-36">
                  {maintenance}
                </td>
                <td class="text-xs md:text-sm text-base-content/60 min-w-48">{edge}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p data-reveal class="text-xs text-base-content/50 mt-6 text-center max-w-2xl">
      Precios publicados el {MARKET_UPDATED}, sin IVA salvo que el proveedor
      indique lo contrario, y cambian a menudo. Se compara lo que cada web
      promete, no la calidad de entrega. Sur Digital trabaja con{" "}
      {totalSectors} especialidades por sector y barrio, publica plazo
      (menos de 7 días) y garantía de 30 días de ajustes.
    </p>
  </div>
</section>

<!-- Mercado nacional: el mismo criterio, pero con lo que añaden los
     proveedores que compiten en remoto desde Madrid, Barcelona o España. -->
<section
  id="comparativa-nacional"
  class="pt-14 pb-20 bg-base-200/40 flex flex-col items-center"
>
  <div class="container mx-auto px-6 flex flex-col items-center">
    <h2
      data-reveal
      class="text-3xl md:text-4xl font-bold text-base-content text-center"
    >
      Fuera de Málaga: <span class="text-wave">qué añade el mercado nacional</span>
    </h2>
    <p data-reveal class="text-base-content/70 text-center max-w-2xl mt-3 mb-6">
      Proveedores que trabajan en remoto y compiten por el mismo cliente. La
      columna de la derecha es lo que sigue siendo suyo: lo demás ya está en
      el catálogo de Sur Digital.
    </p>

    <p data-reveal class="md:hidden text-xs text-base-content/50 mb-4 text-center">
      Desliza la tabla para leer las tres columnas →
    </p>

    <div
      data-reveal
      role="region"
      aria-label="Comparativa de funcionalidades con proveedores nacionales"
      tabindex="0"
      class="overflow-x-auto w-full max-w-5xl shadow-lg rounded-box border border-base-300 bg-base-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary"
    >
      <table class="table table-sm md:table-md">
        <caption class="sr-only">
          Funcionalidades publicadas por seis proveedores nacionales,
          consultados el {MARKET_UPDATED}
        </caption>
        <thead>
          <tr class="border-b-base-300">
            <th scope="col" class="bg-transparent text-start font-bold">Proveedor</th>
            <th scope="col" class="bg-transparent text-start font-bold">
              Features diferenciales
            </th>
            <th scope="col" class="bg-transparent text-start font-bold">
              Qué le queda al competidor
            </th>
          </tr>
        </thead>
        <tbody>
          {
            NATIONAL_COMPARISON.map(({ provider, features, edge }) => (
              <tr class="border-b-base-200 hover:bg-base-200/40 align-top">
                <th
                  scope="row"
                  class="text-start text-sm font-bold whitespace-nowrap"
                >
                  {provider}
                </th>
                <td class="text-xs md:text-sm text-base-content/80 min-w-72">
                  {features}
                </td>
                <td class="text-xs md:text-sm text-base-content/60 min-w-56">
                  {edge}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p data-reveal class="text-xs text-base-content/50 mt-6 text-center max-w-2xl">
      Datos publicados por cada proveedor el {MARKET_UPDATED} y sujetos a
      cambio. Se compara el catálogo, no la calidad de entrega ni los casos
      reales de cada uno.
    </p>
  </div>
</section>

<!-- Matriz completa: 34 funcionalidades frente a los cuatro modelos de
     proveedor con los que se compara una pyme local. -->
<section
  id="comparativa-funcionalidades"
  class="pt-14 pb-20 bg-transparent flex flex-col items-center"
>
  <div class="container mx-auto px-6 flex flex-col items-center">
    <h2
      data-reveal
      class="text-3xl md:text-4xl font-bold text-base-content text-center"
    >
      La comparativa completa, <span class="text-wave">funcionalidad a funcionalidad</span>
    </h2>
    <p data-reveal class="text-base-content/70 text-center max-w-2xl mt-3 mb-6">
      Lo que incluye cada modelo de proveedor, sin quedarse en el precio de la
      web. <strong>✓</strong> lo incluye, <strong>✗</strong> no lo ofrece y
      «parcial» lo incluye con condiciones.
    </p>

    <p data-reveal class="md:hidden text-xs text-base-content/50 mb-4 text-center">
      Desliza la tabla para comparar las 6 columnas →
    </p>

    <div
      data-reveal
      role="region"
      aria-label="Matriz de funcionalidades frente a agencia local, agencia nacional, agente Kit Digital y freelance"
      tabindex="0"
      class="overflow-x-auto w-full max-w-6xl shadow-lg rounded-box border border-base-300 bg-base-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary"
    >
      <table class="table table-sm md:table-md">
        <caption class="sr-only">
          Funcionalidades publicadas por Sur Digital, agencia local, agencia
          nacional, agente Kit Digital y freelance, consultadas el {MARKET_UPDATED}
        </caption>
        <thead>
          <tr class="border-b-base-300">
            <th scope="col" class="bg-transparent text-start font-bold min-w-56">
              Funcionalidad
            </th>
            <th scope="col" class="bg-primary/5 text-start font-bold min-w-40">
              Sur Digital
            </th>
            <th scope="col" class="bg-transparent text-start font-bold min-w-32">
              Agencia local (Málaga)
            </th>
            <th scope="col" class="bg-transparent text-start font-bold min-w-32">
              Agencia nacional
            </th>
            <th scope="col" class="bg-transparent text-start font-bold min-w-32">
              Agente Kit Digital
            </th>
            <th scope="col" class="bg-transparent text-start font-bold min-w-28">
              Freelance
            </th>
          </tr>
        </thead>
        <tbody>
          {
            FEATURE_COMPARISON.map((row) => (
              <tr class="border-b-base-200 hover:bg-base-200/40 align-top">
                <th
                  scope="row"
                  class="text-start text-xs md:text-sm font-bold"
                >
                  {row.feature}
                </th>
                {[
                  row.us,
                  row.local,
                  row.national,
                  row.kit,
                  row.freelance,
                ].map((value, index) => {
                  const { mark, text } = cell(value);
                  return (
                    <td
                      class:list={[
                        "text-xs md:text-sm",
                        index === 0 && "bg-primary/5",
                        mark === "text" && "text-base-content/60",
                      ]}
                    >
                      {mark === "yes" && (
                        <span class="text-success font-bold" aria-label="Sí">
                          ✓
                        </span>
                      )}
                      {mark === "no" && (
                        <span class="text-error font-bold" aria-label="No">
                          ✗
                        </span>
                      )}
                      {text && (
                        <span class:list={[mark !== "text" && "ms-1"]}>{text}</span>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p data-reveal class="text-xs text-base-content/50 mt-6 text-center max-w-2xl">
      Matriz elaborada con lo que cada proveedor publica el {MARKET_UPDATED}.
      «Parcial» significa que existe con condiciones (según plan, precio aparte
      o solo en algunos paquetes), no que se entregue siempre.
    </p>
  </div>
</section>
