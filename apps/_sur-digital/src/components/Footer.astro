---
import { Image } from "astro:assets";
import { twJoin } from "tailwind-merge";

import { DATA } from "../data/data.astro";
import { CONTACT } from "../data/contact";
import { LOCALES, LOCALE_LABELS } from "../data/i18n";
import {
  isTranslated,
  localizedPath,
  localize,
  pageFromPath,
} from "../i18n/routes";
import { ui } from "../i18n/ui";

import Logo from "../assets/logoreverse-optimized.png";

// Estructura tomada de la referencia: una columna ancha de marca (logo,
// descripción, autor y dirección) y dos columnas de enlaces con títulos en
// caja normal. En español las columnas son Especialidades y Servicios; en el
// resto de idiomas, Servicios y Empresa, con los textos traducidos y enlaces a
// la versión que exista de cada página.
interface Props {
  lang?: string;
}
const { lang = "es" } = Astro.props;
const t = ui(lang);
const localized = lang !== "es";
const year = new Date().getFullYear();

// Enlaces que aún viven solo en español se marcan con hreflang.
const esLink = (path: string) => ({
  href: localize(path, lang),
  hreflang: isTranslated(path, lang) ? undefined : "es",
});

const serviceLinks = [
  { path: "/servicios/", label: t.footer.servicesAll },
  { path: "/precios/", label: t.footer.pricing },
  { path: "/glosario/", label: t.footer.glossary },
  { path: "/especialidades/", label: t.footer.specialitiesAll },
].map((item) => ({ ...item, ...esLink(item.path) }));

const companyLinks = [
  { path: "/clientes/", label: t.nav.clients },
  { path: "/blog/", label: t.nav.blog },
  { path: "/faq/", label: t.nav.faq },
].map((item) => ({ ...item, ...esLink(item.path) }));

// Cada idioma tiene su slug; si la página actual no está traducida, el enlace
// lleva a la home de ese idioma (que se resuelve con la cookie).
const page = pageFromPath(Astro.url.pathname);
const languageLinks = [
  { code: "es", href: localizedPath(page ?? "home", "es") },
  ...LOCALES.map((code) => ({
    code,
    href: localizedPath(page ?? "home", code),
  })),
];

const headClass = "mb-3 text-base font-bold";
const linkClass =
  "flex min-h-10 min-w-10 items-center leading-snug link link-hover";
---

<footer class="brand-surface px-6 pt-12 pb-24 md:pb-8">
  <div class="container mx-auto">
    <div class="grid gap-10 md:grid-cols-12">
      <!-- Marca: ocupa más ancho que las columnas de enlaces, como en la
           referencia, y sustituye la antigua columna de contacto. -->
      <div class="flex flex-col gap-4 md:col-span-5">
        <a
          href="/"
          data-lang={lang}
          aria-label="Sur Digital"
          class="inline-flex w-fit"
        >
          <Image
            src={Logo}
            alt="Sur Digital"
            widths={[128, 256]}
            sizes="112px"
            class="w-28 h-auto object-contain"
          />
        </a>
        <p class="max-w-md text-sm leading-relaxed">{t.footer.strap}</p>
        <p class="text-sm leading-relaxed">
          {CONTACT.name} · {t.contact.role}
        </p>
        <p class="flex flex-col items-start gap-1 text-sm leading-relaxed">
          <a
            href={CONTACT.maps}
            target="_blank"
            rel="noopener noreferrer"
            class="link link-hover"
          >
            {CONTACT.address}
          </a>
          <a
            href={CONTACT.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="link link-hover"
          >
            {t.footer.linkedin}
          </a>
        </p>
      </div>

      {
        localized ? (
          <>
            <nav
              aria-label={t.footer.servicesHead}
              class="flex flex-col md:col-span-4"
            >
              <h2 class={headClass}>{t.footer.servicesHead}</h2>
              <ul class="flex flex-col text-sm">
                {serviceLinks.map(({ href, label, hreflang }) => (
                  <li>
                    <a href={href} hreflang={hreflang} class={linkClass}>
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>

            <nav
              aria-label={t.footer.companyHead}
              class="flex flex-col md:col-span-3"
            >
              <h2 class={headClass}>{t.footer.companyHead}</h2>
              <ul class="flex flex-col text-sm">
                {companyLinks.map(({ href, label, hreflang }) => (
                  <li>
                    <a href={href} hreflang={hreflang} class={linkClass}>
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </>
        ) : (
          DATA.footer.map(({ title, items }, index) => (
            <nav
              aria-label={title}
              class:list={[
                "flex flex-col",
                index === 0 ? "md:col-span-4" : "md:col-span-3",
              ]}
            >
              <h2 class={headClass}>{title}</h2>
              <ul class="flex flex-col text-sm">
                {items.map((item) => {
                  const href = "href" in item ? item.href : undefined;
                  const external =
                    "external" in item && item.external ? true : undefined;
                  const bold = "bold" in item && item.bold;
                  const classes = twJoin(
                    "flex min-h-10 min-w-10 items-center leading-snug",
                    href && "link link-hover",
                    bold && "font-semibold"
                  );
                  return (
                    <li>
                      {href ? (
                        <a
                          href={href}
                          class={classes}
                          target={external ? "_blank" : undefined}
                          rel={external ? "noopener noreferrer" : undefined}
                        >
                          <span set:html={item.label} />
                        </a>
                      ) : (
                        <p class={classes}>
                          <span set:html={item.label} />
                        </p>
                      )}
                    </li>
                  );
                })}
              </ul>
            </nav>
          ))
        )
      }
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-white/15 pt-5 text-sm sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <a
          href="/aviso-legal/"
          hreflang="es"
          class="underline underline-offset-4 hover:no-underline"
          >{t.footer.legal}</a
        >
        <span aria-hidden="true">·</span>
        <a
          href="/politica-privacidad/"
          hreflang="es"
          class="underline underline-offset-4 hover:no-underline"
          >{t.footer.privacy}</a
        >
        {
          localized && (
            <>
              <span aria-hidden="true">·</span>
              <nav
                aria-label={t.footer.languagesHead}
                class="flex flex-wrap items-center gap-x-3"
              >
                {languageLinks.map(({ code, href }) => (
                  <a
                    href={href}
                    data-lang={code}
                    lang={code}
                    class="link link-hover inline-flex min-h-9 items-center"
                    aria-current={code === lang ? "true" : undefined}
                  >
                    {LOCALE_LABELS[code as keyof typeof LOCALE_LABELS]}
                  </a>
                ))}
              </nav>
            </>
          )
        }
      </div>
      <p>© {year} Sur Digital</p>
    </div>
  </div>
</footer>
