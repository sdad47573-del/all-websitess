---
import { Image } from "astro:assets";
import { twJoin } from "tailwind-merge";

import { DATA } from "../data/data.astro";

import Logo from "../assets/logoreverse-optimized.png";
---

<footer class="brand-surface pt-8 pb-24 md:pb-8 md:pt-10 px-6">
  <div class="container mx-auto flex flex-col gap-8 md:gap-10">
    <div
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-8 lg:gap-6 w-full"
    >
      <div class="col-span-2 sm:col-span-3 lg:col-span-1 flex flex-col gap-3">
        <Image
          src={Logo}
          alt="Sur Digital"
          widths={[128, 256]}
          sizes="112px"
          class="w-28 h-auto object-contain"
        />
        <p class="text-sm opacity-80 max-w-60">
          Webs rápidas para negocios de Málaga. Desde 0€, en menos de 7 días.
        </p>
      </div>
      {
        DATA.footer.map(({ title, items }) => (
          <nav aria-label={title} class="flex flex-col">
            <p class="text-sm font-bold uppercase tracking-wide opacity-80 pb-2 md:pb-3">
              {title}
            </p>
            <ul class="flex flex-col gap-1 text-sm">
              {items.map((item) => {
                const Icon = "icon" in item ? item.icon : null;
                const href = "href" in item ? item.href : undefined;
                const external =
                  "external" in item && item.external ? true : undefined;
                const classes = twJoin("flex gap-1.5 items-center leading-snug opacity-90 hover:opacity-100", href && "link link-hover");
                return (
                  <li>
                    {href ? (
                      <a
                        href={href}
                        class={classes}
                        target={external ? "_blank" : undefined}
                        rel={external ? "noopener noreferrer" : undefined}
                      >
                        {Icon && <Icon class="min-w-5 max-w-5" />}
                        <span set:html={item.label} />
                      </a>
                    ) : (
                      <p class={classes}>
                        {Icon && <Icon class="min-w-5 max-w-5" />}
                        <span set:html={item.label} />
                      </p>
                    )}
                  </li>
                );
              })}
            </ul>
          </nav>
        ))
      }
    </div>
    <div
      class="text-sm opacity-80 border-t border-white/20 pt-4 flex flex-col sm:flex-row justify-center items-center gap-1 sm:gap-4"
    >
      <p>© {new Date().getFullYear()} Sur Digital - Todos los derechos reservados.</p>
      <p class="flex justify-center gap-4">
        <a href="/aviso-legal/" class="link link-hover">Aviso legal</a>
        <a href="/politica-privacidad/" class="link link-hover">Privacidad</a>
      </p>
    </div>
  </div>
</footer>
