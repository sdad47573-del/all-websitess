---
// Teaser de precios para la home: los planes en versión mínima con enlace
// a /precios/ (donde están los detalles, extras y comparativa completos).
// Los planes salen de DATA.plans: única fuente de verdad para los precios.
import { DATA } from "../data/data.astro";
---

<section
  id="precios"
  class="pt-14 pb-20 bg-gradient-to-b from-base-100 to-base-200 flex flex-col items-center"
>
  <div data-reveal class="container mx-auto px-6 text-center">
    <h2 class="text-4xl md:text-5xl font-bold text-base-content">
      Precios claros, <span class="text-wave">sin sorpresas</span>
    </h2>
    <p class="text-base-content/70 max-w-2xl mx-auto mt-3">
      Otras agencias cobran <span class="font-bold">600–900€</span> por una web
      de 5 páginas. Nosotros empezamos desde
      <span class="font-bold text-secondary">0€</span>.
    </p>
  </div>

  <ul
    data-reveal-group
    class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 justify-items-center max-w-6xl w-full px-6 mt-10"
  >
    {
      DATA.plans.map((plan) => (
        <li
          class:list={[
            "card bg-base-100 w-full",
            plan.popular
              ? "shadow-lg border-2 border-secondary relative"
              : "shadow-md border border-base-300",
          ]}
        >
          {plan.popular && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 badge badge-secondary badge-sm font-bold">
              Más popular
            </span>
          )}
          <a
            href="/precios/"
            class="card-body items-center text-center gap-1"
          >
            <p class="font-bold text-base-content/70">{plan.name}</p>
            <p class="text-4xl font-black">{plan.price}€</p>
            <p class="text-sm text-base-content/60">{plan.tagline}</p>
            <span class="link link-primary text-sm font-bold pt-2">
              Ver qué incluye →
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <p data-reveal class="text-sm text-base-content/60 mt-8 max-w-xl mx-auto px-6">
    💡 Precio final cerrado antes de empezar. Sin cuotas ocultas ni permanencia.
    <a href="/precios/" class="link link-hover font-bold text-secondary"
      >Ver detalles y extras</a
    >.<br />
    ¿Ya tienes web? <a href="/precios/" class="link link-hover font-bold text-secondary"
      >SEO, redes y Google Ads desde 145 €/mes</a
    >.
  </p>
</section>
