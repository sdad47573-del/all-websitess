---
// Zonas de trabajo: refuerza el SEO local de la home mencionando barrios y
// municipios reales de Málaga y la Costa del Sol (señales locales para Google).
const malagaCity = [
  "Centro Histórico",
  "Teatinos",
  "Carretera de Cádiz",
  "Cruz de Humilladero",
  "Palma-Palmilla",
  "Ciudad Jardín",
  "Este (El Palo, Pedregalejo)",
  "Campanillas",
  "Puerto de la Torre",
  "Bailén-Miraflores",
  "Churriana",
  "Huelin",
];

const costaDelSol = [
  "Fuengirola",
  "Benalmádena",
  "Torremolinos",
  "Marbella",
  "Estepona",
  "San Pedro Alcántara",
  "Mijas",
  "Rincón de la Victoria",
  "La Cala de Mijas",
  "Torre del Mar",
  "Manilva",
  "Casares",
];

const provincia = [
  "Alhaurín de la Torre",
  "Cártama",
  "Coín",
  "Álora",
  "Antequera",
  "Ronda",
  "Vélez-Málaga",
  "Nerja",
];
---

<section
  id="zonas"
  class="pt-14 pb-20 bg-gradient-to-b from-base-100 to-base-200 flex flex-col items-center"
>
  <div class="container mx-auto px-6">
    <div data-reveal class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-bold text-base-content">
        Webs en <span class="text-wave">toda Málaga</span>
      </h2>
      <p class="text-base-content/70 max-w-2xl mx-auto mt-3">
        Trabajamos con negocios de la ciudad, de toda la Costa del Sol y del
        resto de la provincia. Y si estás fuera, igual: el proceso es 100%
        online y en menos de 7 días tu web está funcionando.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      <div data-reveal class="card bg-base-100 shadow-md border border-base-300">
        <div class="card-body gap-4">
          <h3 class="card-title text-lg">
            <span aria-hidden="true">🏙️</span> Málaga ciudad
          </h3>
          <ul class="flex flex-wrap gap-2">
            {
              malagaCity.map((zona) => (
                <li class="badge badge-lg badge-outline font-bold">{zona}</li>
              ))
            }
          </ul>
        </div>
      </div>

      <div data-reveal class="card bg-base-100 shadow-md border border-base-300">
        <div class="card-body gap-4">
          <h3 class="card-title text-lg">
            <span aria-hidden="true">🌊</span> Costa del Sol
          </h3>
          <ul class="flex flex-wrap gap-2">
            {
              costaDelSol.map((zona) => (
                <li class="badge badge-lg badge-outline font-bold">{zona}</li>
              ))
            }
          </ul>
        </div>
      </div>

      <div data-reveal class="card bg-base-100 shadow-md border border-base-300">
        <div class="card-body gap-4">
          <h3 class="card-title text-lg">
            <span aria-hidden="true">🏞️</span> Resto de la provincia
          </h3>
          <ul class="flex flex-wrap gap-2">
            {
              provincia.map((zona) => (
                <li class="badge badge-lg badge-outline font-bold">{zona}</li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <p data-reveal class="text-center text-sm text-base-content/60 mt-8 max-w-xl mx-auto">
      ¿Buscabas “diseño web cerca de mí”? Si tu negocio está en cualquiera de
      estas zonas,
      <a href="https://www.linkedin.com/company/sur-digital-malaga" target="_blank" rel="noopener noreferrer" class="link link-hover font-bold text-secondary">
        hablemos</a
      >.
    </p>
  </div>
</section>
