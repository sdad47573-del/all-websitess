---
// Entregables técnicos: qué se lleva el cliente con CUALQUIER web nuestra.
// Elimina la duda "¿y esto qué incluye?" antes del precio.
const entregables = [
  {
    emoji: "📱",
    title: "Diseño responsive real",
    text: "Probada en móvil, tablet y ordenador. El 60% de tus visitas llegan desde el teléfono.",
  },
  {
    emoji: "⚡",
    title: "Velocidad optimizada",
    text: "Carga en menos de 2,5s: imágenes modernas, caché y código mínimo. Core Web Vitals en verde.",
  },
  {
    emoji: "🔒",
    title: "HTTPS y seguridad",
    text: "Certificado SSL configurado y formularios protegidos contra spam.",
  },
  {
    emoji: "🗺️",
    title: "Alta en Google",
    text: "Search Console, sitemap y Google Business optimizado para tu zona.",
  },
  {
    emoji: "📊",
    title: "Medición instalada",
    text: "Sabrás cuántas visitas tienes y de dónde vienen desde el primer día.",
  },
  {
    emoji: "🧾",
    title: "Todo a tu nombre",
    text: "Dominio, hosting y archivos con tus credenciales. Sin permanencia.",
  },
];
---

<section
  id="incluido"
  class="pt-14 pb-20 bg-gradient-to-b from-base-100 to-base-200 flex flex-col items-center"
>
  <div class="container mx-auto px-6">
    <div data-reveal class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-bold text-base-content">
        Tu web <span class="text-wave">incluye todo esto</span>
      </h2>
      <p class="text-base-content/70 max-w-2xl mx-auto mt-3">
        Da igual el sector o el tamaño del proyecto: cada web que entregamos
        lleva de serie estas seis cosas. Sin extras ni letra pequeña.
      </p>
    </div>

    <ul
      data-reveal-group
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto"
    >
      {
        entregables.map(({ emoji, title, text }) => (
          <li class="card bg-base-100 shadow-md border border-base-300">
            <div class="card-body gap-2">
              <span class="text-3xl" aria-hidden="true">{emoji}</span>
              <h3 class="card-title text-base pt-1">{title}</h3>
              <p class="text-sm text-base-content/70 leading-relaxed">{text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <p data-reveal class="text-center text-sm text-base-content/60 mt-10">
      ¿Quieres la lista completa en detalle?
      <a href="/servicios/" class="link link-hover font-bold text-secondary">
        Ver todos los servicios</a
      >.
    </p>
  </div>
</section>
