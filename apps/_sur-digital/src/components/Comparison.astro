---
// Comparativa frente a las otras dos opciones habituales del mercado:
// agencia tradicional y freelancer/plantilla DIY.
// Datos en DATA.comparison: agency/diy/us son string (texto) o boolean (✓/✗).
import { DATA } from "../data/data.astro";
---

<section
  id="comparativa"
  class="pt-14 pb-20 bg-gradient-to-b from-base-200 to-base-100 flex flex-col items-center"
>
  <div class="container mx-auto px-6 flex flex-col items-center">
    <h2 data-reveal class="text-4xl md:text-5xl font-bold text-base-content text-center">
      Agencias, plantillas <span class="text-wave">y nosotros</span>
    </h2>
    <p data-reveal class="text-base-content/70 text-center max-w-2xl mt-3 mb-12">
      Compara las tres opciones que tienes cuando quieres web: la agencia de
      siempre, hacértela tú (o un sobrino) y lo que ofrecemos.
    </p>

    <p
      data-reveal
      class="md:hidden text-xs text-base-content/50 mb-4 -mt-8 text-center"
    >
      Desliza la tabla para comparar las 3 columnas →
    </p>

    <div
      data-reveal
      role="region"
      aria-label="Comparativa entre agencia, hacerla tú y Sur Digital"
      tabindex="0"
      class="overflow-x-auto w-full max-w-4xl shadow-lg rounded-box border border-base-300 bg-base-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary"
    >
      <table class="table table-sm md:table-md">
        <thead>
          <tr class="border-b-base-300">
            <th class="bg-transparent"></th>
            <th class="bg-transparent text-center font-bold">
              <span class="text-sm md:text-base">Agencia</span>
              <span class="block text-[10px] font-normal text-base-content/50">tradicional</span>
            </th>
            <th class="bg-transparent text-center font-bold">
              <span class="text-sm md:text-base">Hacerla tú</span>
              <span class="block text-[10px] font-normal text-base-content/50">o plantilla</span>
            </th>
            <th class="bg-transparent text-center font-bold text-primary">
              <span class="text-sm md:text-base">Sur Digital</span>
              <span class="block text-[10px] font-normal text-primary/60">nosotros</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {
            DATA.comparison.map(({ feature, agency, diy, us }) => (
              <tr class="border-b-base-200 hover:bg-base-200/40">
                <th scope="row" class="font-bold text-sm text-start">
                  {feature}
                </th>
                <td class="text-center">
                  {agency === true ? (
                    <span class="text-success text-lg" aria-label="Sí">✓</span>
                  ) : agency === false ? (
                    <span class="text-error text-lg" aria-label="No">✗</span>
                  ) : (
                    <span class="text-xs text-base-content/60">{agency}</span>
                  )}
                </td>
                <td class="text-center">
                  {diy === true ? (
                    <span class="text-success text-lg" aria-label="Sí">✓</span>
                  ) : diy === false ? (
                    <span class="text-error text-lg" aria-label="No">✗</span>
                  ) : (
                    <span class="text-xs text-base-content/60">{diy}</span>
                  )}
                </td>
                <td class="text-center">
                  {us === true ? (
                    <span class="text-success text-lg" aria-label="Sí">✓</span>
                  ) : us === false ? (
                    <span class="text-error text-lg" aria-label="No">✗</span>
                  ) : (
                    <span class="text-xs font-bold text-primary">{us}</span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p data-reveal class="text-xs text-base-content/50 mt-6 text-center max-w-xl">
      Precios de agencia y freelancer según rangos habituales del mercado
      malagueño en 2026. La columna "hacerla tú" asume plantillas tipo
      constructor de webs.
    </p>
  </div>
</section>
