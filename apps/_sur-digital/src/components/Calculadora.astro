---
// Calculadora de presupuesto: estimación orientativa, en el navegador y sin
// backend. No inventa precios: suma los planes de DATA.plans y los extras de
// DATA.extras, que son los mismos que se publican en /precios/. Si un extra
// cambia de nombre, el build falla en vez de calcular mal.
import { CONTACT } from "../data/contact";
import { DATA } from "../data/data.astro";

// Busca el importe numérico de un extra por su nombre (única fuente de precios)
const extra = (name: string) => {
  const found = DATA.extras.find((item) => item.name === name);
  if (!found) throw new Error(`Calculadora: no existe el extra "${name}"`);
  return found.amount;
};

const paginaExtra = extra("Página adicional");
const idiomaExtra = extra("Idioma adicional");
const logoExtra = extra("Logo e identidad básica");
const mantenimientoExtra = extra("Mantenimiento mensual");

// El plan preseleccionado es Web Completa. Antes era el índice fijo 1; al
// añadir el plan Portfolio ese índice pasó a apuntar a otro plan y el total
// inicial cambiaba sin que nadie tocara la calculadora.
const defaultPlanIndex = Math.max(
  0,
  DATA.plans.findIndex((plan) => plan.name === "Web Completa")
);
---

<section
  id="calculadora"
  class="pt-14 pb-20 bg-gradient-to-b from-base-200 to-base-100 flex flex-col items-center"
>
  <div class="container mx-auto px-6 max-w-3xl">
    <div data-reveal class="text-center mb-10">
      <h2 class="text-4xl md:text-5xl font-bold text-base-content">
        Calcula tu <span class="text-wave">presupuesto</span>
      </h2>
      <p class="text-base-content/70 max-w-2xl mx-auto mt-3">
        Marca lo que necesitas y verás una estimación al momento, con las
        tarifas que ya tenemos publicadas. El precio definitivo se cierra por
        escrito antes de empezar.
      </p>
    </div>

    <!-- Es un div y no un <form> a propósito: sin botón de envío, evitamos
         que pulsar Enter en el campo de páginas recargue la página. -->
    <div
      id="calc"
      data-page-price={paginaExtra}
      role="group"
      aria-label="Calculadora de presupuesto"
      class="card bg-base-100 shadow-md border border-base-300"
    >
      <div class="card-body gap-6">
        <fieldset>
          <legend class="font-bold text-lg mb-3">1. ¿Qué necesitas?</legend>
          <div class="flex flex-col gap-2">
            {
              DATA.plans.map((plan, i) => (
                <label class="flex items-start gap-3 cursor-pointer rounded-box border border-base-300 p-3 hover:border-secondary transition-colors">
                  <input
                    type="radio"
                    name="plan"
                    value={plan.name}
                    data-amount={plan.price}
                    data-pages={plan.price > 0 ? "true" : "false"}
                    checked={i === defaultPlanIndex}
                    class="radio radio-secondary radio-sm mt-1 shrink-0"
                  />
                  <span>
                    <span class="font-bold">{plan.name}</span>
                    <span class="badge badge-sm badge-ghost ml-2 font-bold">
                      {plan.price}€
                    </span>
                    <span class="block text-sm text-base-content/60">
                      {plan.tagline}
                    </span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div id="calc-pages-field" class="flex items-center justify-between gap-4 flex-wrap">
          <label for="calc-pages" class="font-bold text-lg">
            2. ¿Cuántas páginas extra?
            <span class="block text-sm font-normal text-base-content/60">
              {paginaExtra}€ por página adicional (a partir del plan Web Completa)
            </span>
          </label>
          <input
            id="calc-pages"
            type="number"
            min="0"
            max="10"
            step="1"
            value="0"
            inputmode="numeric"
            aria-label="Número de páginas extra"
            class="input input-bordered w-24 text-center"
          />
        </div>

        <fieldset>
          <legend class="font-bold text-lg mb-3">3. ¿Algo más?</legend>
          <div class="flex flex-col gap-3">
            <label class="flex items-start gap-3 cursor-pointer">
              <input
                type="checkbox"
                name="addon"
                data-amount={idiomaExtra}
                data-label="Segundo idioma"
                class="checkbox checkbox-secondary checkbox-sm mt-1 shrink-0"
              />
              <span>
                <span class="font-bold">Segundo idioma</span>
                <span class="block text-sm text-base-content/60">
                  +{idiomaExtra}€ · estructura y SEO del segundo idioma
                  (traducción aparte)
                </span>
              </span>
            </label>

            <label class="flex items-start gap-3 cursor-pointer">
              <input
                type="checkbox"
                name="addon"
                data-amount={logoExtra}
                data-label="Logo e identidad básica"
                class="checkbox checkbox-secondary checkbox-sm mt-1 shrink-0"
              />
              <span>
                <span class="font-bold">Logo e identidad básica</span>
                <span class="block text-sm text-base-content/60">
                  +{logoExtra}€ · logo en todos los formatos, paleta y
                  tipografías
                </span>
              </span>
            </label>

            <label class="flex items-start gap-3 cursor-pointer">
              <input
                type="checkbox"
                name="addon"
                data-amount={mantenimientoExtra}
                data-label="Mantenimiento mensual"
                data-monthly="true"
                class="checkbox checkbox-secondary checkbox-sm mt-1 shrink-0"
              />
              <span>
                <span class="font-bold">Mantenimiento mensual</span>
                <span class="block text-sm text-base-content/60">
                  +{mantenimientoExtra}€/mes · actualizaciones, copias y cambios
                  de contenido (sin permanencia)
                </span>
              </span>
            </label>
          </div>
        </fieldset>

        <div class="divider my-0"></div>

        <div class="text-center">
          <!-- Desglose de lo marcado. Se rellena con JS; sin JS queda oculto y
               el total inicial sigue siendo el del plan preseleccionado. -->
          <ul
            id="calc-breakdown"
            class="mx-auto mb-4 max-w-sm space-y-1 text-start text-sm text-base-content/70"
            hidden
          ></ul>
          <p class="text-sm text-base-content/60">Estimación orientativa</p>
          <!-- aria-live aquí y no en el contenedor: así solo se anuncia el
               importe cuando cambia, no el desglose entero en cada pulsación. -->
          <p
            id="calc-total"
            class="text-4xl md:text-5xl font-black"
            aria-live="polite"
          >
            {DATA.plans[defaultPlanIndex].price}€
          </p>
          <p id="calc-monthly" class="h-5 text-sm font-bold text-secondary"></p>
          <button
            type="button"
            id="calc-copy"
            class="btn btn-outline btn-sm mt-4"
            aria-describedby="calc-copy-status"
          >
            Copiar resumen
          </button>
          <p
            id="calc-copy-status"
            role="status"
            aria-live="polite"
            class="mt-2 min-h-4 text-xs text-base-content/60"
          ></p>
        </div>

        <a
          href={CONTACT.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-lg w-full"
        >
          Confírmalo por LinkedIn
        </a>

        <p class="text-center text-xs text-base-content/60">
          Cálculo hecho con nuestras tarifas publicadas, sin IVA y sin
          permanencia. El importe final se cierra por escrito antes de tocar
          nada.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // El cálculo vive en src/lib/presupuesto.ts, sin DOM, para poder probarlo con
  // `bun test` (ver tests/presupuesto.test.ts). Aquí solo se pinta el resultado.
  import { buildQuote, formatEuros } from "../lib/presupuesto";

  const calc = document.getElementById("calc");

  if (calc) {
    // Alias ya no nulo: dentro de update() el compilador pierde el
    // estrechamiento del if, porque la función puede llamarse más tarde.
    const root: HTMLElement = calc;
    const pagePrice = Number(calc.dataset.pagePrice ?? 0);
    const plans = calc.querySelectorAll<HTMLInputElement>('input[name="plan"]');
    const pages = calc.querySelector<HTMLInputElement>("#calc-pages");
    const pagesField = calc.querySelector<HTMLElement>("#calc-pages-field");
    const addons = calc.querySelectorAll<HTMLInputElement>(
      'input[name="addon"]'
    );
    const totalEl = calc.querySelector<HTMLElement>("#calc-total");
    const monthlyEl = calc.querySelector<HTMLElement>("#calc-monthly");
    const breakdownEl = calc.querySelector<HTMLElement>("#calc-breakdown");
    const copyButton = calc.querySelector<HTMLButtonElement>("#calc-copy");
    const copyStatus = calc.querySelector<HTMLElement>("#calc-copy-status");

    // Resumen en texto plano listo para pegar en el mensaje de LinkedIn: el CTA
    // solo lleva al perfil, así que sin esto hay que reescribir a mano lo que
    // se acaba de marcar.
    let summary = "";

    function update() {
      const planInput = root.querySelector<HTMLInputElement>(
        'input[name="plan"]:checked'
      );
      // Todo el cálculo (plan, páginas extra, extras y resumen) está en
      // src/lib/presupuesto.ts: aquí solo se traduce el formulario a datos.
      const quote = buildQuote({
        plan: planInput
          ? {
              name: planInput.value,
              price: Number(planInput.dataset.amount ?? 0),
            }
          : null,
        extraPages: Number(pages?.value ?? 0),
        extraPagePrice: pagePrice,
        addons: [...addons]
          .filter((addon) => addon.checked)
          .map((addon) => ({
            name: addon.dataset.label ?? "Extra",
            amount: Number(addon.dataset.amount ?? 0),
            monthly: addon.dataset.monthly === "true",
          })),
      });

      if (pages) {
        pages.disabled = !quote.pagesAllowed;
        // El módulo acota el valor (0–10 y entero): se refleja en el campo para
        // que lo que se ve sea exactamente lo que se cobra.
        const value = String(quote.extraPages);
        if (pages.value !== value) pages.value = value;
      }
      if (pagesField) {
        pagesField.classList.toggle("opacity-40", !quote.pagesAllowed);
      }

      if (totalEl) totalEl.textContent = formatEuros(quote.total);
      if (monthlyEl) {
        monthlyEl.textContent =
          quote.monthly > 0
            ? `+ ${formatEuros(quote.monthly)}/mes de mantenimiento`
            : "";
      }

      if (breakdownEl) {
        breakdownEl.replaceChildren(
          ...quote.lines.map((line) => {
            const item = document.createElement("li");
            item.className =
              "flex items-baseline justify-between gap-4 border-b border-base-300/60 pb-1 last:border-0 last:pb-0";
            const name = document.createElement("span");
            name.textContent = line.label;
            const value = document.createElement("span");
            value.className = "font-bold whitespace-nowrap";
            value.textContent = line.value;
            item.append(name, value);
            return item;
          })
        );
        // Con un solo concepto el total ya lo dice todo: la lista sobra.
        breakdownEl.hidden = quote.lines.length <= 1;
      }

      summary = quote.summary;
    }

    for (const input of [...plans, ...addons, pages]) {
      input?.addEventListener("input", update);
      input?.addEventListener("change", update);
    }
    update();

    // Copiar el resumen. Clipboard API cuando existe; si no (HTTP o navegador
    // antiguo), el textarea temporal de siempre. El botón confirma durante unos
    // segundos y el cambio se anuncia por el role="status" del texto de estado.
    copyButton?.addEventListener("click", async () => {
      const reset = () => {
        copyButton.textContent = "Copiar resumen";
        if (copyStatus) copyStatus.textContent = "";
      };

      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(summary);
        } else {
          const area = document.createElement("textarea");
          area.value = summary;
          area.setAttribute("readonly", "");
          area.className = "sr-only";
          root.append(area);
          area.select();
          const copied = document.execCommand("copy");
          area.remove();
          if (!copied) throw new Error("No se ha podido copiar");
        }
        copyButton.textContent = "Copiado ✓";
        if (copyStatus) {
          copyStatus.textContent =
            "Resumen copiado. Pégalo en tu mensaje de LinkedIn.";
        }
        window.setTimeout(reset, 3000);
      } catch {
        if (copyStatus) {
          copyStatus.textContent =
            "No se ha podido copiar automáticamente. Selecciona el resumen y cópialo a mano.";
        }
      }
    });
  }
</script>
