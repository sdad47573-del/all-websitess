---
// Extras: acerca a la home lo que hoy solo vive en la página de precios.
// Fuente única de verdad: DATA.extras en data/data.astro, así que un extra
// nuevo aparece aquí solo.
import { DATA } from "../data/data.astro";
---

<section
  id="extras"
  class="pt-14 pb-20 bg-gradient-to-b from-base-100 to-base-200 flex flex-col items-center"
>
  <div class="container mx-auto px-6 flex flex-col items-center">
    <div data-reveal class="flex flex-col items-center text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-base-content">
        Extras <span class="text-wave">a precio de lista</span>
      </h2>
      <p class="text-base-content/70 max-w-2xl mt-3 mb-10">
        Lo que puedes añadir cuando lo necesites, con su precio a la vista. Nada
        se cobra sin que lo hayas pedido antes por escrito.
      </p>
    </div>

    <ul
      data-reveal-group
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 justify-items-stretch max-w-5xl w-full"
    >
      {
        DATA.extras.map(({ name, price, note }) => (
          <li class="card bg-base-100 shadow-sm border border-base-300">
            <div class="card-body gap-2 p-5">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="card-title text-base">{name}</h3>
                <span class="badge badge-secondary badge-outline font-bold whitespace-nowrap">
                  {price}
                </span>
              </div>
              <p class="text-sm text-base-content/70 leading-relaxed">{note}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div data-reveal class="flex flex-col sm:flex-row gap-3 mt-8">
      <a href="/precios/" class="btn btn-outline">Ver planes y precios</a>
      <a
        href="https://www.linkedin.com/company/sur-digital-malaga"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary">Preguntar por un extra</a
      >
    </div>
  </div>
</section>
