---
// Barra CTA fija solo visible en móvil: mantiene siempre visible la
// acción principal al hacer scroll (buena práctica de conversión).
import { CONTACT } from "../data/contact";
import LinkedInIcon from "../icons/LinkedInIcon.astro";
import { ui } from "../i18n/ui";
import { isTranslated } from "../i18n/routes";

interface Props {
  lang?: string;
}
const { lang = "es" } = Astro.props;
const t = ui(lang);
---

<div
  class="fixed bottom-0 inset-x-0 z-40 md:hidden bg-base-100/95 backdrop-blur-sm border-t border-base-300 p-3 shadow-[0_-4px_16px_rgba(0,0,0,0.06)]"
>
  <div class="flex gap-2">
    <a
      href="/precios/"
      hreflang={isTranslated("/precios/", lang) ? undefined : "es"}
      class="btn btn-ghost btn-lg shrink-0">{t.common.prices}</a
    >
    <a
      href={CONTACT.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary btn-lg flex-1"
    >
      <LinkedInIcon class="size-5" />
      {t.nav.contact}
    </a>
  </div>
</div>
