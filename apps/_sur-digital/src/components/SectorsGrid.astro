---
// Grid de especialidades por sector. Fuente única de verdad: SECTORS en
// data/sectors.ts, así que las landings nuevas aparecen aquí solas.
import { SECTORS } from "../data/sectors";
---

<section
  id="especialidades"
  class="pt-14 pb-20 bg-gradient-to-b from-base-200 to-base-100 flex flex-col items-center"
>
  <div class="container mx-auto px-6 flex flex-col items-center">
    <div data-reveal class="flex flex-col items-center text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-base-content">
        Especialistas en <span class="text-wave">tu sector</span>
      </h2>
      <p class="text-base-content/70 max-w-2xl mt-3 mb-10">
        No hacemos webs genéricas: cada sector tiene su propia estrategia,
        sus propias secciones y sus propias palabras clave en Google.
      </p>
    </div>

    <ul
      data-reveal-group
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 justify-items-center max-w-5xl w-full"
    >
      {
        SECTORS.map((sector) => (
          <li class="card bg-base-100 shadow-md border border-base-300 w-full transition-all hover:shadow-lg hover:-translate-y-1">
            <a href={`/web-para-${sector.slug}/`} class="card-body gap-2">
              <span class="text-3xl" aria-hidden="true">{sector.emoji}</span>
              <h3 class="card-title text-lg">{sector.navLabel}</h3>
              <p class="text-sm text-base-content/70 leading-relaxed">
                {sector.tagline}.
              </p>
              <span class="link link-primary text-sm font-bold pt-1">
                Ver propuesta para {sector.name.toLowerCase()} →
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div data-reveal class="flex flex-col sm:flex-row gap-3 mt-8">
      <a href="/especialidades/" class="btn btn-outline">
        Ver todas las especialidades
      </a>
      <a href="https://www.linkedin.com/company/sur-digital-malaga" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
        ¿Tu negocio es de otro sector? Cuéntanoslo
      </a>
    </div>
  </div>
</section>
