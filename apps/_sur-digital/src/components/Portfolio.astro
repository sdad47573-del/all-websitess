---
// Clientes con web publicada. Datos y capturas en data/portfolio.
import { Image } from "astro:assets";
import { PORTFOLIO } from "../data/portfolio";
import { ORIGINS } from "../data/proxy-origins";

// Las tarjetas enlazan a la web del cliente servida por el proxy (/<slug>/), no
// al despliegue original: la visita no sale del dominio y el enlace no depende
// de que el proyecto del cliente siga publicado en su URL de Vercel o Netlify.
// El slug sale de proxy-origins, que es la única lista de clientes proxeados.
const PROXY_PATH_BY_ORIGIN = new Map(
  Object.entries(ORIGINS).map(([slug, origin]) => [origin, `/${slug}/`]),
);
const proxyPath = (url: string) => PROXY_PATH_BY_ORIGIN.get(url) ?? url;

// Categorías en el orden en que se pintan los filtros. Se cuentan sobre los
// propios datos para que un proyecto nuevo no obligue a tocar esta lista.
const CATEGORIES = [
  "Restaurantes y bares",
  "Peluquería y belleza",
  "Comercio",
  "Taller y motor",
  "Servicios profesionales",
].filter((c) => PORTFOLIO.some((p) => p.category === c));

// Dos tags como máximo en la card normal: con tres, los que se repiten entre
// proyectos (Tapas, Teatinos, Peluquería…) se amontonan y la fila se ensucia.
const MAX_TAGS = 2;

// El escaparate son los proyectos con captura propia y se pagina de 24 en 24;
// el resto de clientes se lista debajo en formato compacto, sin imagen, para
// que aparezcan todos sin renderizar más de mil tarjetas completas.
const PAGE_SIZE = 24;
const CURATED = PORTFOLIO.filter((p) => p.preview);
const DIRECTORY = PORTFOLIO.filter((p) => !p.preview);

// La home pinta solo las tarjetas visibles (6) y enlaza a /clientes/ para el
// resto: ya no descarga el catálogo completo para ampliarlo en el sitio.
interface Props {
  limit?: number;
}
const { limit } = Astro.props;
const isCatalog = typeof limit !== "number";
const renderedProjects = isCatalog ? CURATED : CURATED.slice(0, limit);
const totalLabel = PORTFOLIO.length.toLocaleString("es-ES");

const slugify = (s: string) =>
  s
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-");
---

<section
  id="clientes"
  class="pt-14 pb-20 bg-gradient-to-b from-base-100 to-base-200 flex flex-col items-center"
>
  <div class="container mx-auto px-6 flex flex-col items-center">
    <div data-reveal class="flex flex-col items-center">
      <h2 class="text-4xl md:text-5xl font-bold text-base-content text-center">
        Clientes <span class="text-wave">reales</span>
      </h2>
      <p class="text-base-content/70 text-center max-w-2xl mt-3">
        Webs publicadas para negocios reales. Explora cada cliente y descubre
        cómo presentamos su marca, sus productos y sus servicios.
      </p>
    </div>

    <!-- Buscador del catálogo completo. En la home no aparece: allí solo hay
         seis tarjetas y el enlace a /clientes/. -->
    {
      isCatalog && (
        <div data-reveal class="w-full max-w-xl mt-8">
          <label for="portfolio-search" class="sr-only">
            Buscar cliente por nombre, ciudad o sector
          </label>
          <input
            id="portfolio-search"
            type="search"
            data-portfolio-search
            placeholder="Buscar por nombre, ciudad o sector…"
            autocomplete="off"
            class="input input-bordered w-full"
          />
        </div>
      )
    }

    <!-- Filtros por categoría. En la home son atajos al catálogo; en
         /clientes/ filtran la rejilla sin recargar. -->
    <div data-reveal-group
      class="flex flex-wrap justify-center gap-2 mt-6"
      role="group"
      aria-label="Filtrar clientes por categoría"
    >
      <button
        type="button"
        class="btn btn-sm"
        data-filter="todos"
        aria-pressed="true"
      >
        Todos
        <span class="badge badge-sm badge-ghost">{totalLabel}</span>
      </button>
      {
        CATEGORIES.map((category) => (
          <button
            type="button"
            class="btn btn-sm btn-ghost"
            data-filter={slugify(category)}
            data-label={category}
            aria-pressed="false"
          >
            {category}
            <span class="badge badge-sm badge-ghost">
              {PORTFOLIO.filter((p) => p.category === category).length.toLocaleString("es-ES")}
            </span>
          </button>
        ))
      }
    </div>

    <p data-portfolio-count class="sr-only" role="status" aria-live="polite">
      Mostrando {totalLabel} clientes
    </p>

    <ul
      id="portafolio-grid"
      data-reveal-group
      data-portfolio-grid
      data-catalog={isCatalog ? "full" : "teaser"}
      data-page-size={PAGE_SIZE}
      data-total={PORTFOLIO.length}
      class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3 max-w-6xl w-full mt-8 grid-flow-row-dense"
    >
      {
        renderedProjects.map(
          ({ title, sector, category, description, tags, accent, url, preview, destacado }, index) => (
          <li
            data-category={slugify(category)}
            data-portfolio-card
            data-search={[title, sector, category, ...tags].join(" ")}
            data-destacado={destacado ? "" : undefined}
            hidden={isCatalog && index >= PAGE_SIZE ? true : undefined}
            class={[
              "card relative flex w-full flex-col overflow-hidden border border-base-300 bg-base-100 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg motion-reduce:transform-none motion-reduce:transition-none",
              // La destacada ocupa 2×2 celdas del mosaico. Al ser grid item
              // estirado (stretch), mide exactamente lo que sus vecinas: filas
              // alineadas y cero huecos, sin JS de por medio.
              destacado ? "sm:col-span-2 sm:row-span-2 sm:min-h-[30rem]" : "",
            ].join(" ")}
          >
            <a
              href={proxyPath(url)}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-1 flex-col focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <div
                class={[
                  "relative overflow-hidden bg-base-200 aspect-[1254/564]",
                  // En la destacada (2×2) la imagen crece hasta llenar el
                  // hueco que sobre en la card; object-cover recorta el
                  // screenshot por el centro sin deformarlo.
                  destacado ? "sm:aspect-auto sm:min-h-0 sm:flex-1" : "",
                ].join(" ")}
              >
                {/* Los clientes migrados no tienen captura: llevan un panel con la
                    inicial, del mismo tamaño que la imagen para que la rejilla no
                    baile entre tarjetas. */}
                {preview ? (
                  <Image
                    src={preview}
                    alt={`Captura de la web de ${title}`}
                    widths={destacado ? [480, 640, 800, 1200] : [320, 480, 640, 800]}
                    sizes={
                      // En escritorio la rejilla va topada a max-w-6xl (1152 px),
                      // así que una card mide ~370 px y la destacada ~760. Con
                      // 33vw/60vw el navegador pedía la variante de 800/1200 px
                      // para pintarla a 634/1152 y sobraba un tercio del archivo.
                      destacado
                        ? "(max-width: 639px) 100vw, (max-width: 1023px) 100vw, 780px"
                        : "(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 380px"
                    }
                    loading="lazy"
                    class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.04] motion-reduce:transform-none motion-reduce:transition-none"
                  />
                ) : (
                  <div
                    aria-hidden="true"
                    class="flex h-full w-full items-center justify-center bg-gradient-to-br from-base-300 via-base-200 to-base-300"
                  >
                    <span class="text-4xl font-black tracking-tight text-base-content/20 select-none">
                      {title.slice(0, 1).toUpperCase()}
                    </span>
                  </div>
                )}
              </div>

              <div
                class={[
                  "p-5 flex flex-col gap-1.5",
                  // La destacada incluye descripción y más aire; la imagen de
                  // arriba absorbe el resto con flex-1 para que la altura total
                  // la marquen las cards normales del mosaico.
                  destacado ? "sm:p-6 sm:gap-2" : "",
                ].join(" ")}
              >
                <p
                  class={`truncate text-xs font-bold uppercase tracking-wide ${accent.split(" ")[1]}`}
                >
                  {sector}
                </p>
                <h3
                  class={`font-bold text-base-content leading-snug ${
                    // Altura fija de 2 líneas en la card normal: todos los
                    // títulos miden lo mismo y las filas del mosaico cuadran.
                    destacado
                      ? "text-2xl line-clamp-2 sm:text-3xl"
                      : "text-lg line-clamp-2 min-h-[3.25rem]"
                  }`}
                >
                  {title}
                </h3>

                {/* La descripción es el bloque más repetido del listado: solo
                    aparece en las destacadas. */}
                {destacado && (
                  <p class="text-sm text-base-content/70 leading-relaxed max-w-prose">
                    {description}
                  </p>
                )}

                {/* Zona de tags de altura fija (2 filas como máximo): un tag
                    que salte de línea no puede descolocar la fila del mosaico. */}
                <div class="flex h-[52px] flex-wrap content-start gap-1.5 overflow-hidden pt-1.5">
                  {tags.slice(0, destacado ? tags.length : MAX_TAGS).map((tag) => (
                    <span class="badge badge-sm badge-outline">{tag}</span>
                  ))}
                </div>

                <p
                  class="mt-auto pt-2 text-xs font-bold text-primary inline-flex items-center gap-1"
                >
                  Visitar web
                  <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">
                    →
                  </span>
                </p>
              </div>
              <span class="sr-only">de {title} (abre en una pestaña nueva)</span>
            </a>
            <button
              type="button"
              class="portfolio-quick-view-button btn btn-sm btn-circle absolute top-3 right-3 z-10 border-base-300 bg-base-100/90 text-base-content shadow-md transition-transform duration-200 hover:-translate-y-0.5 hover:scale-[1.03] motion-reduce:transform-none motion-reduce:transition-none"
              data-quick-view
              data-title={title}
              data-sector={sector}
              data-description={description}
              data-url={proxyPath(url)}
              data-tags={tags.join("|")}
              aria-haspopup="dialog"
              aria-controls="portfolio-quick-view"
              aria-label={`Vista rápida de ${title}`}
            >
              <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2.5 12s3.3-6 9.5-6 9.5 6 9.5 6-3.3 6-9.5 6-9.5-6-9.5-6Z" />
                <circle cx="12" cy="12" r="2.5" />
              </svg>
              <span class="sr-only">Vista rápida</span>
            </button>
          </li>
        ))
      }
    </ul>

    <!-- Sin JS se ven todas las tarjetas: el atributo hidden de las que
         quedan fuera de la primera página se anula aquí. -->
    <noscript>
      <style>
        li[data-portfolio-card][hidden] { display: flex !important; }
      </style>
    </noscript>

    <!-- El resto de clientes, en formato compacto: aparecen todos sin sumar
         mil tarjetas con imagen, botones y datos al DOM. -->
    {
      isCatalog && (
        <section
          class="w-full max-w-6xl mt-14 pt-10 border-t border-base-300"
          aria-labelledby="portfolio-directory-title"
        >
          <div class="text-center">
            <h3
              id="portfolio-directory-title"
              class="text-2xl md:text-3xl font-bold text-base-content"
            >
              También trabajan con nosotros
            </h3>
            <p class="text-base-content/70 mt-2 max-w-2xl mx-auto">
              {DIRECTORY.length.toLocaleString("es-ES")} negocios más con su web
              publicada y su enlace directo. Usa el buscador o los filtros de
              arriba para encontrar el tuyo.
            </p>
          </div>
          <ul
            data-portfolio-directory
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 mt-6"
          >
            {DIRECTORY.map(({ title, sector, category, tags, url }) => (
              <li
                data-portfolio-row
                data-category={slugify(category)}
                data-search={[title, sector, category, ...tags].join(" ")}
              >
                <a
                  href={proxyPath(url)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex min-w-0 items-baseline justify-between gap-3 border-b border-base-300/60 py-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >
                  <span class="truncate text-sm font-medium text-base-content group-hover:text-primary">
                    {title}
                  </span>
                  <span class="shrink-0 max-w-[45%] truncate text-[11px] text-base-content/50">
                    {sector}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- En el catálogo amplía el escaparate de 24 en 24. En la home es un
         enlace normal a /clientes/: no descarga mil tarjetas para enseñarlas
         aquí. -->
    {
      isCatalog ? (
        <button
          type="button"
          class="btn btn-primary mt-8"
          data-show-more
          aria-controls="portafolio-grid"
          hidden
        >
          Ver más proyectos
        </button>
      ) : (
        <a
          href="/clientes/"
          class="btn btn-primary mt-8"
          aria-controls="portafolio-grid"
        >
          Ver todos los clientes ({totalLabel})
        </a>
      )
    }

    <dialog
      id="portfolio-quick-view"
      data-portfolio-dialog
      class="modal"
      aria-labelledby="portfolio-dialog-title"
      aria-describedby="portfolio-dialog-description"
    >
      <div class="portfolio-dialog-box modal-box relative w-11/12 max-w-3xl p-0 overflow-hidden">
        <button
          type="button"
          class="btn btn-sm btn-circle btn-ghost absolute top-3 right-3 z-10 bg-base-100/90"
          data-dialog-close
          aria-label="Cerrar vista rápida"
        >
          <svg aria-hidden="true" class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <path d="m4 4 8 8M12 4l-8 8" />
          </svg>
        </button>
        <img data-dialog-image class="aspect-[1254/564] w-full bg-base-200 object-cover" alt="" />
        <div class="flex flex-col gap-3 p-6 sm:p-8">
          <p data-dialog-sector class="text-xs font-bold uppercase tracking-wide text-primary"></p>
          <h2 id="portfolio-dialog-title" data-dialog-title class="text-2xl font-bold text-base-content sm:text-3xl"></h2>
          <p id="portfolio-dialog-description" data-dialog-description class="text-base-content/75 leading-relaxed"></p>
          <ul data-dialog-tags class="flex flex-wrap gap-2" aria-label="Etiquetas del cliente"></ul>
          <!-- href de respaldo: el script lo sustituye por la URL del cliente
               al abrir la vista rápida. Sin él, el enlace nace sin destino y
               Lighthouse lo marca como no rastreable. -->
          <a
            href="/clientes/"
            data-dialog-link
            class="btn btn-primary mt-2 self-start"
            target="_blank"
            rel="noopener noreferrer"
          >
            Visitar web <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button aria-label="Cerrar vista rápida">Cerrar</button>
      </form>
    </dialog>

    <p data-portfolio-empty hidden class="text-base-content/70 mt-10 text-center">
      No hay clientes que coincidan con esta búsqueda.
    </p>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    [data-portfolio-card].portfolio-card-enter {
      animation: portfolio-card-enter 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--portfolio-stagger, 0ms);
    }

    @keyframes portfolio-card-enter {
      from {
        opacity: 0;
        transform: translateY(14px) scale(0.985);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    dialog[data-portfolio-dialog][open] .portfolio-dialog-box {
      animation: portfolio-dialog-enter 240ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    @keyframes portfolio-dialog-enter {
      from {
        opacity: 0;
        transform: translateY(12px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    dialog[data-portfolio-dialog][open]::backdrop {
      animation: portfolio-backdrop-enter 200ms ease-out both;
    }

    @keyframes portfolio-backdrop-enter {
      from { background-color: rgb(0 0 0 / 0); }
      to { background-color: rgb(0 0 0 / 0.35); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-portfolio-card].portfolio-card-enter,
    dialog[data-portfolio-dialog][open] .portfolio-dialog-box,
    dialog[data-portfolio-dialog][open]::backdrop {
      animation: none !important;
    }
  }
</style>

<script>
  // Catálogo de clientes: escaparate de los proyectos con captura, listado
  // compacto con el resto (para que aparezcan todos), filtro por categoría,
  // búsqueda por texto y páginas de 24 tarjetas en el escaparate. La home usa
  // este mismo componente como resumen: allí los filtros llevan a /clientes/ y
  // «Ver todos» es un enlace normal.
  const grid = document.querySelector<HTMLElement>("[data-portfolio-grid]");
  const directory = document.querySelector<HTMLElement>("[data-portfolio-directory]");
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-filter]")
  );
  const status = document.querySelector<HTMLElement>("[data-portfolio-count]");
  const empty = document.querySelector<HTMLElement>("[data-portfolio-empty]");
  const showMore = document.querySelector<HTMLElement>("[data-show-more]");
  const search = document.querySelector<HTMLInputElement>("[data-portfolio-search]");
  const isCatalog = grid?.dataset.catalog === "full";
  // Tarjetas del escaparate y filas del listado compacto. El escaparate pagina;
  // el listado enseña siempre todas sus coincidencias.
  let cards: HTMLElement[] = [];
  let rows: HTMLElement[] = [];

  const portfolioDialog = document.querySelector<HTMLDialogElement>("[data-portfolio-dialog]");

  const openQuickView = (button: HTMLButtonElement) => {
    if (!portfolioDialog) return;
    const dialogImage = portfolioDialog.querySelector<HTMLImageElement>("[data-dialog-image]");
    const dialogSector = portfolioDialog.querySelector<HTMLElement>("[data-dialog-sector]");
    const dialogTitle = portfolioDialog.querySelector<HTMLElement>("[data-dialog-title]");
    const dialogDescription = portfolioDialog.querySelector<HTMLElement>("[data-dialog-description]");
    const dialogTags = portfolioDialog.querySelector<HTMLUListElement>("[data-dialog-tags]");
    const dialogLink = portfolioDialog.querySelector<HTMLAnchorElement>("[data-dialog-link]");
    if (!dialogImage || !dialogSector || !dialogTitle || !dialogDescription || !dialogTags || !dialogLink) return;

    const title = button.dataset.title ?? "Cliente";
    const cardImage = button.closest<HTMLElement>("[data-category]")
      ?.querySelector<HTMLImageElement>("img");
    const imageSrc = cardImage?.currentSrc ?? cardImage?.src ?? "";
    // Las tarjetas sin captura no pintan <img>: el diálogo oculta la suya.
    dialogImage.hidden = !imageSrc;
    dialogImage.src = imageSrc;
    dialogImage.alt = imageSrc ? `Captura de la web de ${title}` : "";
    dialogSector.textContent = button.dataset.sector ?? "";
    dialogTitle.textContent = title;
    dialogDescription.textContent = button.dataset.description ?? "";
    dialogLink.href = button.dataset.url ?? "#";
    dialogTags.replaceChildren(
      ...(button.dataset.tags ?? "").split("|").filter(Boolean).map((tag) => {
        const item = document.createElement("li");
        item.className = "badge badge-outline";
        item.textContent = tag;
        return item;
      })
    );
    portfolioDialog.showModal();
  };

  // La vista rápida se engancha también a las tarjetas que llegan después:
  // se llama al arrancar y otra vez al ampliar la página.
  const bindQuickViews = (root: ParentNode) => {
    for (const button of root.querySelectorAll<HTMLButtonElement>("[data-quick-view]")) {
      if (button.dataset.quickViewBound === "true") continue;
      button.dataset.quickViewBound = "true";
      button.addEventListener("click", () => openQuickView(button));
    }
  };

  bindQuickViews(document);

  if (portfolioDialog) {
    portfolioDialog.querySelector("[data-dialog-close]")?.addEventListener("click", () => {
      portfolioDialog.close();
    });
    portfolioDialog.addEventListener("click", (event) => {
      if (event.target === portfolioDialog) portfolioDialog.close();
    });
  }

  if (grid instanceof HTMLElement && buttons.length > 0) {
    const portfolioGrid = grid;
    cards = Array.from(portfolioGrid.querySelectorAll<HTMLElement>("[data-portfolio-card]"));
    rows = directory
      ? Array.from(directory.querySelectorAll<HTMLElement>("[data-portfolio-row]"))
      : [];
    const pageSize =
      Number.parseInt(portfolioGrid.dataset.pageSize ?? "24", 10) || 24;
    let visibleLimit = pageSize;
    let currentFilter = "todos";
    let currentQuery = "";

    const format = (value: number) => value.toLocaleString("es-ES");
    const normalize = (value: string) =>
      value
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .trim();

    // El texto buscable se resuelve una sola vez: título, sector, categoría y
    // tags. Normalizar todo el listado en cada tecla sería tirar trabajo.
    const searchable = new Map<HTMLElement, string>(
      [...cards, ...rows].map((element): [HTMLElement, string] => [
        element,
        normalize(element.dataset.search ?? ""),
      ])
    );

    const syncUrl = () => {
      if (!isCatalog) return;
      const params = new URLSearchParams(window.location.search);
      if (currentFilter === "todos") params.delete("categoria");
      else params.set("categoria", currentFilter);
      if (search?.value.trim()) params.set("q", search.value.trim());
      else params.delete("q");
      const query = params.toString();
      window.history.replaceState(
        null,
        "",
        `${window.location.pathname}${query ? `?${query}` : ""}${window.location.hash}`
      );
    };

    const matches = (element: HTMLElement) => {
      const matchCategory =
        currentFilter === "todos" || element.dataset.category === currentFilter;
      const matchQuery =
        !currentQuery ||
        (searchable.get(element) ?? "").includes(currentQuery);
      return matchCategory && matchQuery;
    };

    function apply() {
      const matchingCards = cards.filter(matches);
      const matchingRows = rows.filter(matches);
      const shown = new Set(matchingCards.slice(0, visibleLimit));
      const shownRows = new Set(matchingRows);

      for (const card of cards) {
        card.hidden = !shown.has(card);
        card.classList.remove("portfolio-card-enter");
      }
      // El listado compacto no pagina: si coincide, aparece.
      for (const row of rows) row.hidden = !shownRows.has(row);

      requestAnimationFrame(() => {
        let index = 0;
        for (const card of shown) {
          card.style.setProperty(
            "--portfolio-stagger",
            `${Math.min(index, 8) * 45}ms`
          );
          card.classList.add("portfolio-card-enter");
          index += 1;
        }
      });

      for (const button of buttons) {
        const active = button.dataset.filter === currentFilter;
        button.setAttribute("aria-pressed", String(active));
        // El botón activo mantiene el aspecto primario del CTA.
        button.classList.toggle("btn-primary", active);
        button.classList.toggle("btn-ghost", !active);
      }

      const totalShown = shown.size + matchingRows.length;
      const totalMatching = matchingCards.length + matchingRows.length;
      if (status) {
        // data-label y no el texto del botón: el botón incluye el contador
        // de proyectos y ese número no debe colarse en el anuncio.
        const label = buttons.find((b) => b.dataset.filter === currentFilter)
          ?.dataset.label;
        status.textContent = `Mostrando ${format(totalShown)} de ${format(
          totalMatching
        )} ${totalMatching === 1 ? "cliente" : "clientes"}${
          label ? ` en ${label}` : ""
        }`;
      }
      if (empty) empty.hidden = totalMatching > 0;

      if (showMore) {
        const remaining = matchingCards.length - shown.size;
        showMore.hidden = remaining <= 0;
        showMore.textContent = `Ver más proyectos con captura (${format(remaining)})`;
      }

      // aria-controls apunta a la lista filtrada, no a la sección completa.
      for (const button of buttons) {
        button.setAttribute("aria-controls", portfolioGrid.id);
      }
    }

    if (isCatalog) {
      // El catálogo admite enlaces compartibles: /clientes/?categoria=bares&q=…
      const params = new URLSearchParams(window.location.search);
      const requested = params.get("categoria") ?? "";
      if (
        requested &&
        buttons.some((button) => button.dataset.filter === requested)
      ) {
        currentFilter = requested;
      }
      if (search) {
        search.value = params.get("q") ?? "";
        currentQuery = normalize(search.value);
        search.addEventListener("input", () => {
          currentQuery = normalize(search.value);
          visibleLimit = pageSize;
          apply();
          syncUrl();
        });
      }

      for (const button of buttons) {
        button.addEventListener("click", () => {
          currentFilter = button.dataset.filter ?? "todos";
          visibleLimit = pageSize;
          apply();
          syncUrl();
        });
      }

      showMore?.addEventListener("click", () => {
        const previous = cards.filter((card) => !card.hidden).length;
        visibleLimit += pageSize;
        apply();
        bindQuickViews(portfolioGrid);
        // Si el botón desaparece al agotar el escaparate, el foco se pierde con
        // él: pasa a la primera tarjeta que acaba de aparecer.
        if (showMore.hidden) {
          const visible = cards.filter((card) => !card.hidden);
          visible[previous]?.querySelector<HTMLAnchorElement>("a")?.focus();
        }
      });
    } else {
      // Resumen de la home: los filtros abren el catálogo completo.
      for (const button of buttons) {
        button.addEventListener("click", () => {
          const filter = button.dataset.filter ?? "todos";
          window.location.href =
            filter === "todos"
              ? "/clientes/"
              : `/clientes/?categoria=${encodeURIComponent(filter)}`;
        });
      }
    }

    // Estado inicial: primera página del escaparate y listado completo.
    apply();
  }
</script>
