---
// Clientes con web publicada. Datos y capturas en data/portfolio.
import { Image } from "astro:assets";
import { PORTFOLIO } from "../data/portfolio";
import { ORIGINS } from "../data/proxy-origins";

// Las tarjetas enlazan a la página estática /<slug>/ cuando esa web está en
// src/apps. Los clientes que solo tienen un despliegue externo enlazan a su URL
// original: el sitio se genera completo como estático y ya no hay proxy.
const PROXY_PATH_BY_ORIGIN = new Map(
  Object.entries(ORIGINS).map(([slug, origin]) => [origin, `/${slug}/`]),
);
const APP_SLUGS = new Set(
  Object.keys(import.meta.glob("../apps/*/pages/index.astro")).flatMap(
    (file) => {
      const slug = file.split("/")[2];
      return slug ? [slug] : [];
    },
  ),
);
const proxyPath = (url: string) => {
  const staticPath = PROXY_PATH_BY_ORIGIN.get(url);
  return staticPath && APP_SLUGS.has(staticPath.slice(1, -1))
    ? staticPath
    : url;
};

// Categorías en el orden en que se pintan los filtros. Se cuentan sobre los
// propios datos para que un proyecto nuevo no obligue a tocar esta lista.
const CATEGORIES = [
  "Restaurantes y bares",
  "Peluquería y belleza",
  "Comercio",
  "Taller y motor",
  "Servicios profesionales",
].filter((c) => PORTFOLIO.some((p) => p.category === c));

// Dos tags como máximo en la card normal: con tres, los que se repiten entre
// proyectos (Tapas, Teatinos, Peluquería…) se amontonan y la fila se ensucia.
const MAX_TAGS = 2;

// El escaparate son los proyectos con captura propia; el resto de clientes se
// lista debajo en formato compacto, sin imagen, para que aparezcan todos sin
// renderizar más de mil tarjetas completas.
const CURATED = PORTFOLIO.filter((p) => p.preview);
const DIRECTORY = PORTFOLIO.filter((p) => !p.preview);

// La home pinta solo las tarjetas visibles (6) y enlaza a /clientes/ para el
// resto: ya no descarga el catálogo completo para ampliarlo en el sitio.
interface Props {
  limit?: number;
  // La página /clientes/ pinta su propia cabecera y estadísticas.
  intro?: boolean;
}
const { limit, intro = true } = Astro.props;
const isCatalog = typeof limit !== "number";
const renderedProjects = isCatalog ? CURATED : CURATED.slice(0, limit);
const totalLabel = PORTFOLIO.length.toLocaleString("es-ES");

const slugify = (s: string) =>
  s
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-");

// Ciudades del filtro agrupadas por comunidad. Se calculan sobre PORTFOLIO para
// que una ciudad nueva aparezca sola y en su grupo.
type CityEntry = { label: string; count: number };
const CITY_INDEX = new Map<string, CityEntry & { community: string }>();
for (const project of PORTFOLIO) {
  const city = project.city?.trim();
  if (!city) continue;
  const key = slugify(city);
  const entry = CITY_INDEX.get(key);
  if (entry) {
    entry.count += 1;
    if (!entry.community) entry.community = project.community?.trim() || "";
  } else {
    CITY_INDEX.set(key, {
      label: city,
      count: 1,
      community: project.community?.trim() || "",
    });
  }
}

const CITY_GROUPS = (() => {
  const groups = new Map<string, [string, CityEntry][]>();
  for (const [key, { label, count, community }] of CITY_INDEX) {
    const name = community || "Sin comunidad";
    const cities = groups.get(name) ?? [];
    cities.push([key, { label, count }]);
    groups.set(name, cities);
  }
  return [...groups.entries()]
    .map(([community, cities]) => ({
      community,
      cities: cities.sort((a, b) =>
        a[1].label.localeCompare(b[1].label, "es"),
      ),
      total: cities.reduce((sum, [, city]) => sum + city.count, 0),
    }))
    .sort((a, b) => {
      if (a.community === "Sin comunidad") return 1;
      if (b.community === "Sin comunidad") return -1;
      return a.community.localeCompare(b.community, "es");
    });
})();
---

<section
  id="clientes"
  class={[
    "bg-gradient-to-b from-base-100 to-base-200 flex flex-col items-center",
    intro ? "pt-14 pb-20" : "pt-0 pb-0",
  ].join(" ")}
>
  <div class="container mx-auto px-6 flex flex-col items-center">
    {
      intro && (
        <div data-reveal class="flex flex-col items-center">
          <h2 class="text-4xl md:text-5xl font-bold text-base-content text-center">
            Clientes <span class="text-wave">reales</span>
          </h2>
          <p class="text-base-content/70 text-center max-w-2xl mt-3">
            Webs publicadas para negocios reales. Explora cada cliente y
            descubre cómo presentamos su marca, sus productos y sus servicios.
          </p>
        </div>
      )
    }

    <!-- Buscador y ciudad comparten fila: son los dos filtros de texto y
         quedan alineados con la altura del campo. En la home no aparecen:
         allí solo hay seis tarjetas y el enlace a /clientes/. -->
    {
      isCatalog && (
        <div
          data-reveal
          class="mt-8 flex w-full max-w-2xl flex-col gap-3 sm:flex-row sm:items-center"
        >
          <div class="relative flex-1">
            <label for="portfolio-search" class="sr-only">
              Buscar cliente por nombre, ciudad o sector
            </label>
            <svg aria-hidden="true" class="pointer-events-none absolute left-4 top-1/2 size-4 -translate-y-1/2 text-base-content/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="6.5" />
              <path d="m16 16 4.5 4.5" />
            </svg>
            <input
              id="portfolio-search"
              type="search"
              data-portfolio-search
              placeholder="Buscar por nombre, ciudad o sector…"
              autocomplete="off"
              class="input input-bordered h-12 w-full rounded-full bg-base-100 pl-11 pr-4 shadow-sm"
            />
          </div>
          {
            CITY_GROUPS.length > 0 && (
              <button
                type="button"
                class="btn btn-outline h-12 w-full shrink-0 justify-between gap-2 rounded-full pl-4 pr-3 font-normal shadow-sm sm:w-auto sm:justify-start"
                data-city-open
                aria-haspopup="dialog"
                aria-controls="portfolio-city-dialog"
                aria-label="Filtrar por ciudad"
              >
                <span class="inline-flex items-center gap-2">
                  <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 21s-6-5.2-6-10a6 6 0 1 1 12 0c0 4.8-6 10-6 10Z" />
                    <circle cx="12" cy="11" r="2.25" />
                  </svg>
                  <span class="opacity-70">Ciudad</span>
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <span class="badge badge-sm badge-ghost max-w-36 truncate" data-city-current>Todas</span>
                  <svg aria-hidden="true" class="size-3 opacity-60" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m4 6 4 4 4-4" />
                  </svg>
                </span>
              </button>
            )
          }
        </div>
      )
    }

    <!-- Filtros por categoría. En la home son atajos al catálogo; en
         /clientes/ filtran la rejilla sin recargar. -->
    <div data-reveal-group
      class="flex flex-wrap justify-center gap-2 mt-6"
      role="group"
      aria-label="Filtrar clientes por categoría"
    >
      <button
        type="button"
        class="btn btn-sm"
        data-filter="todos"
        aria-pressed="true"
      >
        Todos
        <span class="badge badge-sm badge-ghost">{totalLabel}</span>
      </button>
      {
        CATEGORIES.map((category) => (
          <button
            type="button"
            class="btn btn-sm btn-ghost"
            data-filter={slugify(category)}
            data-label={category}
            aria-pressed="false"
          >
            {category}
            <span class="badge badge-sm badge-ghost">
              {PORTFOLIO.filter((p) => p.category === category).length.toLocaleString("es-ES")}
            </span>
          </button>
        ))
      }
    </div>

    <!-- Barra de resultados: el contador es visible y solo aparece «Limpiar
         filtros» cuando hay algo que limpiar. -->
    {
      isCatalog && (
        <div
          data-reveal
          class="mt-7 flex w-full max-w-6xl flex-wrap items-center justify-between gap-3 border-y border-base-300/70 py-2.5"
        >
          <p
            data-portfolio-count
            class="text-sm text-base-content/60"
            role="status"
            aria-live="polite"
          >
            Mostrando {totalLabel} clientes
          </p>
          <button
            type="button"
            data-portfolio-reset
            hidden
            class="btn btn-sm btn-ghost gap-1.5 rounded-full text-base-content/60 hover:text-base-content"
          >
            <svg aria-hidden="true" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
              <path d="m6 6 12 12M18 6 6 18" />
            </svg>
            Limpiar filtros
          </button>
        </div>
      )
    }

    <ul
      id="portafolio-grid"
      data-reveal-group
      data-portfolio-grid
      data-catalog={isCatalog ? "full" : "teaser"}
      class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3 max-w-6xl w-full mt-8 grid-flow-row-dense"
    >
      {
        renderedProjects.map(
          ({ title, sector, city, category, description, tags, accent, url, preview, destacado }) => (
          <li
            data-category={slugify(category)}
            data-city={city ? slugify(city) : undefined}
            data-portfolio-card
            data-search={[title, sector, city, category, ...tags].filter(Boolean).join(" ")}
            data-destacado={destacado ? "" : undefined}
            class={[
              "card relative flex w-full flex-col overflow-hidden border border-base-300 bg-base-100 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg motion-reduce:transform-none motion-reduce:transition-none",
              // La destacada ocupa 2×2 celdas del mosaico. Al ser grid item
              // estirado (stretch), mide exactamente lo que sus vecinas: filas
              // alineadas y cero huecos, sin JS de por medio.
              destacado ? "sm:col-span-2 sm:row-span-2 sm:min-h-[30rem]" : "",
            ].join(" ")}
          >
            <a
              href={proxyPath(url)}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-1 flex-col focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <div
                class={[
                  "relative overflow-hidden bg-base-200 aspect-[1254/564]",
                  // En la destacada (2×2) la imagen crece hasta llenar el
                  // hueco que sobre en la card; object-cover recorta el
                  // screenshot por el centro sin deformarlo.
                  destacado ? "sm:aspect-auto sm:min-h-0 sm:flex-1" : "",
                ].join(" ")}
              >
                {/* Los clientes migrados no tienen captura: llevan un panel con la
                    inicial, del mismo tamaño que la imagen para que la rejilla no
                    baile entre tarjetas. */}
                {preview ? (
                  <Image
                    src={preview}
                    alt={`Captura de la web de ${title}`}
                    widths={destacado ? [480, 640, 800, 1200] : [320, 480, 640, 800]}
                    sizes={
                      // En escritorio la rejilla va topada a max-w-6xl (1152 px),
                      // así que una card mide ~370 px y la destacada ~760. Con
                      // 33vw/60vw el navegador pedía la variante de 800/1200 px
                      // para pintarla a 634/1152 y sobraba un tercio del archivo.
                      destacado
                        ? "(max-width: 639px) 100vw, (max-width: 1023px) 100vw, 780px"
                        : "(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 380px"
                    }
                    loading="lazy"
                    class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.04] motion-reduce:transform-none motion-reduce:transition-none"
                  />
                ) : (
                  <div
                    aria-hidden="true"
                    class="flex h-full w-full items-center justify-center bg-gradient-to-br from-base-300 via-base-200 to-base-300"
                  >
                    <span class="text-4xl font-black tracking-tight text-base-content/20 select-none">
                      {title.slice(0, 1).toUpperCase()}
                    </span>
                  </div>
                )}
              </div>

              <div
                class={[
                  "p-5 flex flex-col gap-1.5",
                  // La destacada incluye descripción y más aire; la imagen de
                  // arriba absorbe el resto con flex-1 para que la altura total
                  // la marquen las cards normales del mosaico.
                  destacado ? "sm:p-6 sm:gap-2" : "",
                ].join(" ")}
              >
                <p
                  class={`truncate text-xs font-bold uppercase tracking-wide ${accent.split(" ")[1]}`}
                >
                  {sector}{city ? ` · ${city}` : ""}
                </p>
                <h3
                  class={`font-bold text-base-content leading-snug ${
                    // Altura fija de 2 líneas en la card normal: todos los
                    // títulos miden lo mismo y las filas del mosaico cuadran.
                    destacado
                      ? "text-2xl line-clamp-2 sm:text-3xl"
                      : "text-lg line-clamp-2 min-h-[3.25rem]"
                  }`}
                >
                  {title}
                </h3>

                {/* La descripción es el bloque más repetido del listado: solo
                    aparece en las destacadas. */}
                {destacado && (
                  <p class="text-sm text-base-content/70 leading-relaxed max-w-prose">
                    {description}
                  </p>
                )}

                {/* Zona de tags de altura fija (2 filas como máximo): un tag
                    que salte de línea no puede descolocar la fila del mosaico. */}
                <div class="flex h-[52px] flex-wrap content-start gap-1.5 overflow-hidden pt-1.5">
                  {tags.slice(0, destacado ? tags.length : MAX_TAGS).map((tag) => (
                    <span class="badge badge-sm badge-outline">{tag}</span>
                  ))}
                </div>

                <p
                  class="mt-auto pt-2 text-xs font-bold text-primary inline-flex items-center gap-1"
                >
                  Visitar web
                  <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">
                    →
                  </span>
                </p>
              </div>
              <span class="sr-only">de {title} (abre en una pestaña nueva)</span>
            </a>
            <button
              type="button"
              class="portfolio-quick-view-button btn btn-sm btn-circle absolute top-3 right-3 z-10 border-base-300 bg-base-100/90 text-base-content shadow-md transition-transform duration-200 hover:-translate-y-0.5 hover:scale-[1.03] motion-reduce:transform-none motion-reduce:transition-none"
              data-quick-view
              data-title={title}
              data-sector={sector}
              data-description={description}
              data-url={proxyPath(url)}
              data-tags={tags.join("|")}
              aria-haspopup="dialog"
              aria-controls="portfolio-quick-view"
              aria-label={`Vista rápida de ${title}`}
            >
              <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2.5 12s3.3-6 9.5-6 9.5 6 9.5 6-3.3 6-9.5 6-9.5-6-9.5-6Z" />
                <circle cx="12" cy="12" r="2.5" />
              </svg>
              <span class="sr-only">Vista rápida</span>
            </button>
          </li>
        ))
      }
    </ul>

    <!-- Plantilla para pintar como tarjeta los clientes del listado compacto
         cuando hay búsqueda o filtros activos. Se clona desde el script: así
         no duplicamos 1.192 tarjetas en el HTML inicial. -->
    {
      isCatalog && (
        <template data-portfolio-card-template>
          <li
            data-portfolio-directory-card
            class="card relative flex w-full flex-col overflow-hidden border border-base-300 bg-base-100 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg motion-reduce:transform-none motion-reduce:transition-none"
          >
            <a
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-1 flex-col focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <div class="relative overflow-hidden bg-base-200 aspect-[1254/564]">
                <div
                  data-card-fallback
                  aria-hidden="true"
                  class="flex h-full w-full items-center justify-center bg-gradient-to-br from-base-300 via-base-200 to-base-300"
                >
                  <span
                    data-card-initial
                    class="text-4xl font-black tracking-tight text-base-content/20 select-none"
                  ></span>
                </div>
                <!-- La portada tapa el panel de la inicial; si no carga, el
                     error la oculta y queda el panel de respaldo. -->
                <img
                  data-card-image
                  alt=""
                  width="640"
                  height="288"
                  loading="lazy"
                  decoding="async"
                  hidden
                  class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.04] motion-reduce:transform-none motion-reduce:transition-none"
                />
              </div>
              <div class="p-5 flex flex-col gap-1.5">
                <p
                  data-card-sector
                  class="truncate text-xs font-bold uppercase tracking-wide text-primary"
                ></p>
                <h3
                  data-card-title
                  class="font-bold text-base-content leading-snug text-lg line-clamp-2 min-h-[3.25rem]"
                ></h3>
                <div
                  data-card-tags
                  class="flex h-[52px] flex-wrap content-start gap-1.5 overflow-hidden pt-1.5"
                ></div>
                <p class="mt-auto pt-2 text-xs font-bold text-primary inline-flex items-center gap-1">
                  Visitar web
                  <span
                    aria-hidden="true"
                    class="transition-transform duration-300 group-hover:translate-x-1"
                  >
                    →
                  </span>
                </p>
              </div>
            </a>
          </li>
        </template>
      )
    }

    <!-- En la home, el enlace al catálogo completo. En /clientes/ ya está
         todo debajo, así que no hace falta paginar ni cargar más. -->
    {
      !isCatalog && (
        <a
          href="/clientes/"
          class="btn btn-primary mt-8"
          aria-controls="portafolio-grid"
        >
          Ver todos los clientes ({totalLabel})
        </a>
      )
    }

    <!-- El resto de clientes se carga desde /clientes.json en el navegador:
         el HTML estático de la página no incluye las 1.192 fichas. -->
    {
      isCatalog && (
        <section
          data-portfolio-directory-section
          class="w-full max-w-6xl mt-14 pt-10 border-t border-base-300"
          aria-labelledby="portfolio-directory-title"
        >
          <div class="text-center">
            <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
              <h3
                id="portfolio-directory-title"
                class="text-2xl md:text-3xl font-bold text-base-content"
              >
                También trabajan con nosotros
              </h3>
              <span
                data-portfolio-directory-count
                class="badge badge-outline tabular-nums"
              >
                {DIRECTORY.length.toLocaleString("es-ES")}
              </span>
            </div>
            <p class="text-base-content/70 mt-2 max-w-2xl mx-auto">
              Negocios con su web publicada y su enlace directo. Usa el buscador
              o los filtros de arriba para encontrar el tuyo.
            </p>
          </div>
          <ul
            data-portfolio-directory
            aria-busy="true"
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 mt-6"
          >
            <li
              data-portfolio-directory-status
              class="sm:col-span-2 lg:col-span-3 flex items-center justify-center gap-2 py-8 text-sm text-base-content/60"
            >
              <span class="loading loading-spinner loading-sm" aria-hidden="true"></span>
              Cargando los {DIRECTORY.length.toLocaleString("es-ES")} clientes restantes…
            </li>
          </ul>
          <p
            data-portfolio-directory-error
            hidden
            class="mt-4 text-center text-sm text-error"
          >
            No se pudieron cargar los clientes restantes. Recarga la página para
            intentarlo de nuevo.
          </p>
          <noscript>
            <p class="mt-4 text-center text-sm text-base-content/60">
              Los {DIRECTORY.length.toLocaleString("es-ES")} clientes adicionales
              necesitan JavaScript para cargarse.
            </p>
          </noscript>
        </section>
      )
    }

    <dialog
      id="portfolio-quick-view"
      data-portfolio-dialog
      class="modal"
      aria-labelledby="portfolio-dialog-title"
      aria-describedby="portfolio-dialog-description"
    >
      <div class="portfolio-dialog-box modal-box relative w-11/12 max-w-3xl p-0 overflow-hidden">
        <button
          type="button"
          class="btn btn-sm btn-circle btn-ghost absolute top-3 right-3 z-10 bg-base-100/90"
          data-dialog-close
          aria-label="Cerrar vista rápida"
        >
          <svg aria-hidden="true" class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <path d="m4 4 8 8M12 4l-8 8" />
          </svg>
        </button>
        <img data-dialog-image class="aspect-[1254/564] w-full bg-base-200 object-cover" alt="" decoding="async" loading="lazy" />
        <div class="flex flex-col gap-3 p-6 sm:p-8">
          <p data-dialog-sector class="text-xs font-bold uppercase tracking-wide text-primary"></p>
          <h2 id="portfolio-dialog-title" data-dialog-title class="text-2xl font-bold text-base-content sm:text-3xl"></h2>
          <p id="portfolio-dialog-description" data-dialog-description class="text-base-content/75 leading-relaxed"></p>
          <ul data-dialog-tags class="flex flex-wrap gap-2" aria-label="Etiquetas del cliente"></ul>
          <!-- href de respaldo: el script lo sustituye por la URL del cliente
               al abrir la vista rápida. Sin él, el enlace nace sin destino y
               Lighthouse lo marca como no rastreable. -->
          <a
            href="/clientes/"
            data-dialog-link
            class="btn btn-primary mt-2 self-start"
            target="_blank"
            rel="noopener noreferrer"
          >
            Visitar web <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button aria-label="Cerrar vista rápida">Cerrar</button>
      </form>
    </dialog>

    <!-- El filtro de ciudad se elige en un modal: con más de 250 ciudades, un
         desplegable nativo era incómodo de recorrer. -->
    {
      isCatalog && CITY_GROUPS.length > 0 && (
        <dialog
          id="portfolio-city-dialog"
          data-city-dialog
          class="modal"
          aria-labelledby="portfolio-city-title"
        >
          <div class="modal-box max-w-3xl overflow-hidden p-0">
            <div class="border-b border-base-300 bg-gradient-to-br from-base-100 via-base-100 to-base-200 px-6 pb-5 pt-6 sm:px-8">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary">
                    Filtro por ciudad
                  </p>
                  <h3
                    id="portfolio-city-title"
                    data-city-title
                    class="mt-1 text-2xl font-bold text-base-content"
                  >
                    Comunidades
                  </h3>
                  <p
                    data-city-subtitle
                    aria-live="polite"
                    class="mt-1 text-sm text-base-content/60"
                  >
                    {CITY_GROUPS.length.toLocaleString("es-ES")} comunidades · elige una para ver sus ciudades.
                  </p>
                </div>
                <button
                  type="button"
                  class="btn btn-sm btn-circle btn-ghost shrink-0"
                  data-city-close
                  aria-label="Cerrar filtro de ciudades"
                >
                  <svg aria-hidden="true" class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
                    <path d="m4 4 8 8M12 4l-8 8" />
                  </svg>
                </button>
              </div>
            </div>
            <div class="city-scroll max-h-[55vh] space-y-5 overflow-y-auto px-6 py-5 sm:px-8">
              <button
                type="button"
                class="btn btn-sm btn-primary w-full justify-between rounded-xl px-4"
                data-city-option="todas"
                aria-pressed="true"
              >
                <span class="inline-flex items-center gap-2">
                  <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M3 12h18M12 3c2.5 2.4 2.5 15.6 0 18M12 3c-2.5 2.4-2.5 15.6 0 18" />
                  </svg>
                  Todas las ciudades
                </span>
                <span class="badge badge-sm badge-ghost tabular-nums">{totalLabel}</span>
              </button>

              <!-- Primer nivel: comunidades. Al elegir una se sustituye por sus
                   ciudades, sin recargar ni cerrar el modal. -->
              <div data-city-panel="communities">
                <div class="grid gap-2 sm:grid-cols-2">
                  {CITY_GROUPS.map(({ community, cities, total }) => (
                    <button
                      type="button"
                      data-city-community={community}
                      data-city-count={cities.length}
                      data-city-total={total}
                      class="group flex items-center justify-between gap-3 rounded-xl border border-base-300/80 bg-base-100 px-4 py-3 text-left transition-colors hover:border-primary/40 hover:bg-base-200/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                    >
                      <span class="flex min-w-0 items-center gap-3">
                        <span
                          aria-hidden="true"
                          class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-base-200 text-primary/70"
                        >
                          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 21s-6-5.2-6-10a6 6 0 1 1 12 0c0 4.8-6 10-6 10Z" />
                            <circle cx="12" cy="11" r="2.25" />
                          </svg>
                        </span>
                        <span class="min-w-0">
                          <span class="block truncate text-sm font-semibold text-base-content">
                            {community}
                          </span>
                          <span class="block text-xs text-base-content/50">
                            {cities.length.toLocaleString("es-ES")} {cities.length === 1 ? "ciudad" : "ciudades"} · {total.toLocaleString("es-ES")} {total === 1 ? "cliente" : "clientes"}
                          </span>
                        </span>
                      </span>
                      <svg aria-hidden="true" class="size-4 shrink-0 text-base-content/30 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-primary motion-reduce:transform-none" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m6 3 5 5-5 5" />
                      </svg>
                    </button>
                  ))}
                </div>
              </div>

              <!-- Segundo nivel: ciudades de la comunidad elegida. -->
              <div data-city-panel="cities" hidden>
                <button
                  type="button"
                  data-city-back
                  class="btn btn-sm btn-ghost -ml-2 mb-3 gap-1.5 rounded-full text-base-content/60 hover:text-base-content"
                >
                  <svg aria-hidden="true" class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 3 5 8l5 5" />
                  </svg>
                  Comunidades
                </button>
                {CITY_GROUPS.map(({ community, cities }) => (
                  <section data-city-group={community} hidden>
                    <div class="flex flex-wrap gap-2">
                      {cities.map(([key, { label, count }]) => (
                        <button
                          type="button"
                          class="btn btn-sm btn-ghost justify-between gap-2 rounded-full font-normal"
                          data-city-option={key}
                          data-label={label}
                          aria-pressed="false"
                        >
                          <span>{label}</span>
                          <span class="badge badge-sm badge-ghost tabular-nums">
                            {count.toLocaleString("es-ES")}
                          </span>
                        </button>
                      ))}
                    </div>
                  </section>
                ))}
              </div>
            </div>
          </div>
          <form method="dialog" class="modal-backdrop">
            <button aria-label="Cerrar filtro de ciudades">Cerrar</button>
          </form>
        </dialog>
      )
    }

    {
      isCatalog && (
        <div data-portfolio-empty hidden class="mt-10 w-full max-w-6xl">
          <div class="mx-auto flex max-w-lg flex-col items-center gap-4 rounded-2xl border border-dashed border-base-300 bg-base-100/70 px-6 py-12 text-center">
            <span
              aria-hidden="true"
              class="flex size-12 items-center justify-center rounded-full bg-base-200 text-base-content/40"
            >
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="6.5" />
                <path d="m16 16 4.5 4.5" />
                <path d="m8.5 8.5 5 5m0-5-5 5" />
              </svg>
            </span>
            <div>
              <p class="text-lg font-bold text-base-content">Sin coincidencias</p>
              <p class="mt-1 text-sm text-base-content/60">
                No hay clientes que coincidan con estos filtros. Prueba con otro
                nombre, sector o ciudad.
              </p>
            </div>
            <button
              type="button"
              data-portfolio-reset
              class="btn btn-sm btn-primary rounded-full px-5"
            >
              Limpiar filtros
            </button>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    [data-portfolio-card].portfolio-card-enter,
    [data-portfolio-directory-card].portfolio-card-enter {
      animation: portfolio-card-enter 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--portfolio-stagger, 0ms);
    }

    @keyframes portfolio-card-enter {
      from {
        opacity: 0;
        transform: translateY(14px) scale(0.985);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    dialog[data-portfolio-dialog][open] .portfolio-dialog-box {
      animation: portfolio-dialog-enter 240ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    @keyframes portfolio-dialog-enter {
      from {
        opacity: 0;
        transform: translateY(12px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    dialog[data-portfolio-dialog][open]::backdrop {
      animation: portfolio-backdrop-enter 200ms ease-out both;
    }

    dialog[data-city-dialog][open] .modal-box {
      animation: portfolio-dialog-enter 240ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    dialog[data-city-dialog][open]::backdrop {
      animation: portfolio-backdrop-enter 200ms ease-out both;
    }

    @keyframes portfolio-backdrop-enter {
      from { background-color: rgb(0 0 0 / 0); }
      to { background-color: rgb(0 0 0 / 0.35); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-portfolio-card].portfolio-card-enter,
    [data-portfolio-directory-card].portfolio-card-enter,
    dialog[data-portfolio-dialog][open] .portfolio-dialog-box,
    dialog[data-portfolio-dialog][open]::backdrop,
    dialog[data-city-dialog][open] .modal-box,
    dialog[data-city-dialog][open]::backdrop {
      animation: none !important;
    }
  }

  /* daisyUI da display:inline-flex a .btn, que gana al atributo hidden. */
  [data-portfolio-reset][hidden] {
    display: none;
  }

  .city-scroll {
    scrollbar-width: thin;
    scrollbar-color: var(--color-base-300) transparent;
  }

  .city-scroll::-webkit-scrollbar {
    width: 8px;
  }

  .city-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .city-scroll::-webkit-scrollbar-thumb {
    border-radius: 9999px;
    background: var(--color-base-300);
  }
</style>

<script>
  // Catálogo de clientes: escaparate de los proyectos con captura y listado
  // compacto con el resto, para que aparezcan todos. La home usa este mismo
  // componente como resumen: allí los filtros llevan a /clientes/ y «Ver todos»
  // es un enlace normal.
  const grid = document.querySelector<HTMLElement>("[data-portfolio-grid]");
  const directory = document.querySelector<HTMLElement>("[data-portfolio-directory]");
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-filter]")
  );
  const status = document.querySelector<HTMLElement>("[data-portfolio-count]");
  const empty = document.querySelector<HTMLElement>("[data-portfolio-empty]");
  const search = document.querySelector<HTMLInputElement>("[data-portfolio-search]");
  const cityOpen = document.querySelector<HTMLButtonElement>("[data-city-open]");
  const cityDialog = document.querySelector<HTMLDialogElement>("[data-city-dialog]");
  const cityOptions = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-city-option]")
  );
  const cityCurrent = document.querySelector<HTMLElement>("[data-city-current]");
  const cityScroll = document.querySelector<HTMLElement>(".city-scroll");
  const cityPanels = Array.from(
    document.querySelectorAll<HTMLElement>("[data-city-panel]")
  );
  const cityGroupSections = Array.from(
    document.querySelectorAll<HTMLElement>("[data-city-group]")
  );
  const cityCommunities = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-city-community]")
  );
  const cityTitle = document.querySelector<HTMLElement>("[data-city-title]");
  const citySubtitle = document.querySelector<HTMLElement>("[data-city-subtitle]");
  const cityBack = document.querySelector<HTMLButtonElement>("[data-city-back]");
  const directorySection = document.querySelector<HTMLElement>(
    "[data-portfolio-directory-section]"
  );
  const directoryCount = document.querySelector<HTMLElement>(
    "[data-portfolio-directory-count]"
  );
  const directoryStatus = document.querySelector<HTMLElement>(
    "[data-portfolio-directory-status]"
  );
  const directoryError = document.querySelector<HTMLElement>(
    "[data-portfolio-directory-error]"
  );
  const resetButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-portfolio-reset]")
  );
  const cardTemplate = document.querySelector<HTMLTemplateElement>(
    "[data-portfolio-card-template]"
  );
  interface DirectoryClient {
    title: string;
    sector: string;
    city: string;
    category: string;
    tags: string[];
    accent: string;
    url: string;
    image: string;
    thumb: string;
  }
  const isCatalog = grid?.dataset.catalog === "full";
  // Tarjetas del escaparate, filas del listado compacto y tarjetas que se
  // generan a partir de esas filas al filtrar.
  let cards: HTMLElement[] = [];
  let rows: HTMLElement[] = [];
  let directoryCards: HTMLElement[] = [];
  let directoryLoaded = false;
  let directoryFailed = false;

  const portfolioDialog = document.querySelector<HTMLDialogElement>("[data-portfolio-dialog]");

  const openQuickView = (button: HTMLButtonElement) => {
    if (!portfolioDialog) return;
    const dialogImage = portfolioDialog.querySelector<HTMLImageElement>("[data-dialog-image]");
    const dialogSector = portfolioDialog.querySelector<HTMLElement>("[data-dialog-sector]");
    const dialogTitle = portfolioDialog.querySelector<HTMLElement>("[data-dialog-title]");
    const dialogDescription = portfolioDialog.querySelector<HTMLElement>("[data-dialog-description]");
    const dialogTags = portfolioDialog.querySelector<HTMLUListElement>("[data-dialog-tags]");
    const dialogLink = portfolioDialog.querySelector<HTMLAnchorElement>("[data-dialog-link]");
    if (!dialogImage || !dialogSector || !dialogTitle || !dialogDescription || !dialogTags || !dialogLink) return;

    const title = button.dataset.title ?? "Cliente";
    const cardImage = button.closest<HTMLElement>("[data-category]")
      ?.querySelector<HTMLImageElement>("img");
    const imageSrc = cardImage?.currentSrc ?? cardImage?.src ?? "";
    // Las tarjetas sin captura no pintan <img decoding="async" loading="lazy">: el diálogo oculta la suya.
    dialogImage.hidden = !imageSrc;
    dialogImage.src = imageSrc;
    dialogImage.alt = imageSrc ? `Captura de la web de ${title}` : "";
    dialogSector.textContent = button.dataset.sector ?? "";
    dialogTitle.textContent = title;
    dialogDescription.textContent = button.dataset.description ?? "";
    dialogLink.href = button.dataset.url ?? "#";
    dialogTags.replaceChildren(
      ...(button.dataset.tags ?? "").split("|").filter(Boolean).map((tag) => {
        const item = document.createElement("li");
        item.className = "badge badge-outline";
        item.textContent = tag;
        return item;
      })
    );
    portfolioDialog.showModal();
  };

  // La vista rápida solo existe en las tarjetas del escaparate: todas se
  // enganchan una sola vez al arrancar.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-quick-view]")) {
    button.addEventListener("click", () => openQuickView(button));
  }

  if (portfolioDialog) {
    portfolioDialog.querySelector("[data-dialog-close]")?.addEventListener("click", () => {
      portfolioDialog.close();
    });
    portfolioDialog.addEventListener("click", (event) => {
      if (event.target === portfolioDialog) portfolioDialog.close();
    });
  }

  if (cityDialog) {
    let activeCommunity = "";

    // El modal abre siempre en el nivel de comunidades. Elegir una muestra sus
    // ciudades y «Comunidades» devuelve al listado anterior sin cerrar el modal.
    const showCityPanel = (community: string, moveFocus = true) => {
      const previousCommunity = activeCommunity;
      activeCommunity = community;

      for (const panel of cityPanels) {
        panel.hidden =
          panel.dataset.cityPanel !== (community ? "cities" : "communities");
      }
      for (const group of cityGroupSections) {
        group.hidden = group.dataset.cityGroup !== community;
      }

      const communityButton = cityCommunities.find(
        (button) => button.dataset.cityCommunity === community
      );
      if (community) {
        const cities = Number(communityButton?.dataset.cityCount ?? 0);
        const total = Number(communityButton?.dataset.cityTotal ?? 0);
        if (cityTitle) cityTitle.textContent = community;
        if (citySubtitle) {
          citySubtitle.textContent = `${cities.toLocaleString("es-ES")} ${
            cities === 1 ? "ciudad" : "ciudades"
          } · ${total.toLocaleString("es-ES")} ${
            total === 1 ? "cliente" : "clientes"
          }`;
        }
      } else {
        if (cityTitle) cityTitle.textContent = "Comunidades";
        if (citySubtitle) {
          citySubtitle.textContent = `${cityCommunities.length.toLocaleString(
            "es-ES"
          )} comunidades · elige una para ver sus ciudades.`;
        }
      }

      if (cityScroll) cityScroll.scrollTop = 0;
      if (!moveFocus) return;
      if (community) {
        cityBack?.focus();
      } else {
        cityCommunities
          .find((button) => button.dataset.cityCommunity === previousCommunity)
          ?.focus();
      }
    };

    cityOpen?.addEventListener("click", () => {
      showCityPanel("", false);
      cityDialog.showModal();
    });
    for (const button of cityCommunities) {
      button.addEventListener("click", () => {
        showCityPanel(button.dataset.cityCommunity ?? "");
      });
    }
    cityBack?.addEventListener("click", () => {
      showCityPanel("");
    });
    cityDialog.querySelector("[data-city-close]")?.addEventListener("click", () => {
      cityDialog.close();
    });
    cityDialog.addEventListener("click", (event) => {
      if (event.target === cityDialog) cityDialog.close();
    });
  }

  if (grid instanceof HTMLElement && buttons.length > 0) {
    const portfolioGrid = grid;
    cards = Array.from(portfolioGrid.querySelectorAll<HTMLElement>("[data-portfolio-card]"));
    rows = directory
      ? Array.from(directory.querySelectorAll<HTMLElement>("[data-portfolio-row]"))
      : [];
    let currentFilter = "todos";
    let currentCity = "todas";
    let currentQuery = "";

    // El filtro de ciudad vive en un modal: el botón muestra la ciudad activa y
    // las opciones se marcan al elegir.
    const cityLabelFor = (key: string) =>
      cityOptions.find((option) => option.dataset.cityOption === key)?.dataset
        .label ?? "";
    const updateCityUi = () => {
      for (const option of cityOptions) {
        const active = (option.dataset.cityOption ?? "todas") === currentCity;
        option.setAttribute("aria-pressed", String(active));
        option.classList.toggle("btn-primary", active);
        option.classList.toggle("btn-ghost", !active);
      }
      if (cityCurrent) {
        cityCurrent.textContent = cityLabelFor(currentCity) || "Todas";
      }
      cityOpen?.classList.toggle("btn-primary", currentCity !== "todas");
      cityOpen?.classList.toggle("btn-outline", currentCity === "todas");
    };

    for (const option of cityOptions) {
      option.addEventListener("click", () => {
        currentCity = option.dataset.cityOption ?? "todas";
        updateCityUi();
        cityDialog?.close();
        apply();
        syncUrl();
      });
    }

    const format = (value: number) => value.toLocaleString("es-ES");
    const normalize = (value: string) =>
      value
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .trim();
    const slugify = (value: string) =>
      value
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, "-");

    // Convierte una fila del listado en la misma tarjeta del escaparate. Al no
    // tener captura propia, usa el panel con la inicial del cliente.
    const createDirectoryCard = (row: HTMLElement) => {
      const template = cardTemplate?.content.firstElementChild;
      if (!template) return null;
      const card = template.cloneNode(true) as HTMLElement;
      const link = card.querySelector<HTMLAnchorElement>("a");
      const rowLink = row.querySelector<HTMLAnchorElement>("a");
      if (link && rowLink) {
        link.setAttribute("href", rowLink.getAttribute("href") ?? "#");
      }

      const title = row.dataset.title ?? "Cliente";
      const initial = card.querySelector<HTMLElement>("[data-card-initial]");
      if (initial) initial.textContent = title.slice(0, 1).toUpperCase();

      const image = card.querySelector<HTMLImageElement>("[data-card-image]");
      const fallback = card.querySelector<HTMLElement>("[data-card-fallback]");
      const imageSrc = row.dataset.image ?? "";
      if (image && imageSrc) {
        image.alt = `Portada de ${title}`;
        image.addEventListener(
          "error",
          () => {
            image.hidden = true;
            if (fallback) fallback.hidden = false;
          },
          { once: true }
        );
        image.src = imageSrc;
        image.hidden = false;
      }

      const sector = card.querySelector<HTMLElement>("[data-card-sector]");
      if (sector) {
        const city = row.dataset.cityLabel;
        sector.textContent = `${row.dataset.sector ?? ""}${
          city ? ` · ${city}` : ""
        }`;
        const accentClass = (row.dataset.accent ?? "").split(" ")[1];
        if (accentClass) {
          sector.classList.remove("text-primary");
          sector.classList.add(accentClass);
        }
      }

      const titleElement = card.querySelector<HTMLElement>("[data-card-title]");
      if (titleElement) titleElement.textContent = title;

      const tags = card.querySelector<HTMLElement>("[data-card-tags]");
      if (tags) {
        for (const tag of (row.dataset.tags ?? "")
          .split("|")
          .filter(Boolean)
          .slice(0, 2)) {
          const item = document.createElement("span");
          item.className = "badge badge-sm badge-outline";
          item.textContent = tag;
          tags.append(item);
        }
      }
      return card;
    };

    // Reconstruye en el navegador la fila compacta que antes venía en el HTML.
    const createDirectoryRow = (client: DirectoryClient) => {
      const row = document.createElement("li");
      row.dataset.portfolioRow = "";
      row.dataset.category = slugify(client.category);
      if (client.city) row.dataset.city = slugify(client.city);
      row.dataset.search = [
        client.title,
        client.sector,
        client.city,
        client.category,
        ...client.tags,
      ]
        .filter(Boolean)
        .join(" ");
      row.dataset.title = client.title;
      row.dataset.sector = client.sector;
      if (client.city) row.dataset.cityLabel = client.city;
      row.dataset.tags = client.tags.join("|");
      row.dataset.accent = client.accent;
      row.dataset.image = client.image ?? "";

      const link = document.createElement("a");
      link.href = client.url;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.className =
        "group -mx-2 flex min-w-0 items-center gap-3 rounded-lg border-b border-base-300/60 px-2 py-2 transition-colors hover:bg-base-200/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";

      // Miniatura perezosa: la fila no pide la portada completa de 640×288.
      // La inicial queda detrás como respaldo si la imagen no carga.
      const media = document.createElement("span");
      media.className =
        "relative h-9 w-20 shrink-0 overflow-hidden rounded-md bg-base-200";
      const initial = document.createElement("span");
      initial.className =
        "absolute inset-0 flex items-center justify-center text-sm font-black text-base-content/25 select-none";
      initial.textContent = client.title.slice(0, 1).toUpperCase();
      initial.setAttribute("aria-hidden", "true");
      media.append(initial);

      const preview = client.thumb || client.image;
      if (preview) {
        const image = document.createElement("img");
        image.src = preview;
        image.alt = "";
        image.width = 160;
        image.height = 72;
        image.loading = "lazy";
        image.decoding = "async";
        image.className = "absolute inset-0 h-full w-full object-cover";
        image.addEventListener(
          "error",
          () => {
            image.hidden = true;
          },
          { once: true }
        );
        media.append(image);
      }

      const body = document.createElement("span");
      body.className = "min-w-0 flex-1";
      const name = document.createElement("span");
      name.className =
        "block truncate text-sm font-medium text-base-content group-hover:text-primary";
      name.textContent = client.title;
      const meta = document.createElement("span");
      meta.className = "mt-0.5 block truncate text-[11px] text-base-content/50";
      meta.textContent = client.city || client.sector;
      body.append(name, meta);

      const arrow = document.createElement("span");
      arrow.className =
        "shrink-0 text-base-content/30 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-primary";
      arrow.textContent = "→";
      arrow.setAttribute("aria-hidden", "true");

      link.append(media, body, arrow);
      row.append(link);
      return row;
    };

    // El texto buscable se resuelve una sola vez: título, sector, categoría y
    // tags. Normalizar todo el listado en cada tecla sería tirar trabajo.
    const searchable = new Map<HTMLElement, string>(
      [...cards, ...rows].map((element): [HTMLElement, string] => [
        element,
        normalize(element.dataset.search ?? ""),
      ])
    );

    // Los 1.192 clientes del listado viven en un JSON estático: se piden solo
    // al cargar la página y se añaden a los filtros existentes.
    const loadDirectory = async () => {
      if (!isCatalog || !directory) return;
      try {
        const response = await fetch("/clientes.json", {
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const clients = (await response.json()) as DirectoryClient[];
        const fragment = document.createDocumentFragment();
        for (const client of clients) {
          const row = createDirectoryRow(client);
          rows.push(row);
          searchable.set(row, normalize(row.dataset.search ?? ""));
          fragment.append(row);
        }
        directory.append(fragment);
        directoryLoaded = true;
        directory.setAttribute("aria-busy", "false");
        directoryStatus?.remove();
        apply();
      } catch (error) {
        console.error("No se pudieron cargar los clientes restantes", error);
        directoryLoaded = true;
        directoryFailed = true;
        directory.setAttribute("aria-busy", "false");
        directoryStatus?.remove();
        if (directoryError) directoryError.hidden = false;
        if (directoryCount) directoryCount.textContent = "—";
        apply();
      }
    };

    const syncUrl = () => {
      if (!isCatalog) return;
      const params = new URLSearchParams(window.location.search);
      if (currentFilter === "todos") params.delete("categoria");
      else params.set("categoria", currentFilter);
      if (currentCity === "todas") params.delete("ciudad");
      else params.set("ciudad", currentCity);
      if (search?.value.trim()) params.set("q", search.value.trim());
      else params.delete("q");
      const query = params.toString();
      window.history.replaceState(
        null,
        "",
        `${window.location.pathname}${query ? `?${query}` : ""}${window.location.hash}`
      );
    };

    const matches = (element: HTMLElement) => {
      const matchCategory =
        currentFilter === "todos" || element.dataset.category === currentFilter;
      const matchCity =
        currentCity === "todas" || element.dataset.city === currentCity;
      const matchQuery =
        !currentQuery ||
        (searchable.get(element) ?? "").includes(currentQuery);
      return matchCategory && matchCity && matchQuery;
    };

    function apply() {
      const hasFilters =
        currentFilter !== "todos" ||
        currentCity !== "todas" ||
        currentQuery !== "";
      const matchingCards = cards.filter(matches);
      const matchingRows = rows.filter(matches);
      const shown = new Set(matchingCards);
      const shownRows = new Set(matchingRows);

      // Las tarjetas del listado se generan solo cuando hay filtros activos:
      // así los resultados se ven como cards sin duplicar 1.192 fichas.
      for (const card of directoryCards) card.remove();
      directoryCards = [];
      if (hasFilters) {
        for (const row of matchingRows) {
          const card = createDirectoryCard(row);
          if (!card) continue;
          directoryCards.push(card);
          portfolioGrid.append(card);
        }
      }

      for (const card of cards) {
        card.hidden = !shown.has(card);
        card.classList.remove("portfolio-card-enter");
      }
      for (const row of rows) row.hidden = !shownRows.has(row);

      requestAnimationFrame(() => {
        let index = 0;
        for (const card of [...shown, ...directoryCards]) {
          card.style.setProperty(
            "--portfolio-stagger",
            `${Math.min(index, 8) * 45}ms`
          );
          card.classList.add("portfolio-card-enter");
          index += 1;
        }
      });

      for (const button of buttons) {
        const active = button.dataset.filter === currentFilter;
        button.setAttribute("aria-pressed", String(active));
        // El botón activo mantiene el aspecto primario del CTA.
        button.classList.toggle("btn-primary", active);
        button.classList.toggle("btn-ghost", !active);
      }

      const total = matchingCards.length + matchingRows.length;
      if (status) {
        if (isCatalog && !directoryLoaded) {
          status.textContent = "Cargando clientes…";
        } else {
          // data-label y no el texto del botón: el botón incluye el contador
          // de proyectos y ese número no debe colarse en el anuncio.
          const label = buttons.find((b) => b.dataset.filter === currentFilter)
            ?.dataset.label;
          const cityLabel = currentCity === "todas" ? "" : cityLabelFor(currentCity);
          const where = [label, cityLabel].filter(Boolean).join(" · ");
          status.textContent = `Mostrando ${format(total)} ${
            total === 1 ? "cliente" : "clientes"
          }${where ? ` en ${where}` : ""}`;
        }
      }
      if (empty) {
        empty.hidden = !directoryLoaded || directoryFailed || total > 0;
      }

      for (const button of resetButtons) button.hidden = !hasFilters;

      // Mientras carga, la sección sigue visible con su mensaje. Con filtros,
      // los resultados del listado ya están como tarjetas en la rejilla; sin
      // filtros se mantiene el listado compacto completo.
      if (directorySection) {
        directorySection.hidden =
          (!directoryFailed &&
            directoryLoaded &&
            matchingRows.length === 0) ||
          (hasFilters && directoryCards.length > 0);
      }
      if (directoryCount && directoryLoaded && !directoryFailed) {
        directoryCount.textContent = format(matchingRows.length);
      }

      // aria-controls apunta a la lista filtrada, no a la sección completa.
      for (const button of buttons) {
        button.setAttribute("aria-controls", portfolioGrid.id);
      }
    }

    if (isCatalog) {
      // El catálogo admite enlaces compartibles: /clientes/?categoria=bares&q=…
      const params = new URLSearchParams(window.location.search);
      const requested = params.get("categoria") ?? "";
      if (
        requested &&
        buttons.some((button) => button.dataset.filter === requested)
      ) {
        currentFilter = requested;
      }
      const requestedCity = params.get("ciudad") ?? "";
      if (
        requestedCity &&
        cityOptions.some(
          (option) => option.dataset.cityOption === requestedCity
        )
      ) {
        currentCity = requestedCity;
      }
      updateCityUi();

      if (search) {
        search.value = params.get("q") ?? "";
        currentQuery = normalize(search.value);
        search.addEventListener("input", () => {
          currentQuery = normalize(search.value);
          apply();
          syncUrl();
        });
      }

      for (const button of buttons) {
        button.addEventListener("click", () => {
          currentFilter = button.dataset.filter ?? "todos";
          apply();
          syncUrl();
        });
      }

      for (const button of resetButtons) {
        button.addEventListener("click", () => {
          currentFilter = "todos";
          currentCity = "todas";
          currentQuery = "";
          if (search) search.value = "";
          updateCityUi();
          apply();
          syncUrl();
          search?.focus();
        });
      }
    } else {
      // Resumen de la home: los filtros abren el catálogo completo.
      for (const button of buttons) {
        button.addEventListener("click", () => {
          const filter = button.dataset.filter ?? "todos";
          window.location.href =
            filter === "todos"
              ? "/clientes/"
              : `/clientes/?categoria=${encodeURIComponent(filter)}`;
        });
      }
    }

    // Estado inicial: escaparate completo; el listado se rellena al pedir el JSON.
    apply();

    if (isCatalog) {
      void loadDirectory();
    }
  }
</script>
