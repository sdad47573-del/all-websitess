---
// FAQ orientado a eliminar objeciones de compra + SEO (rich snippets).
// Las preguntas viven en DATA.faq: única fuente para esta sección y el JSON-LD.
import { DATA } from "../data/data.astro";
---

<section
  id="faq"
  class="pt-14 pb-20 bg-gradient-to-b from-base-200 to-base-100 flex flex-col items-center"
>
  <div class="container mx-auto px-6 text-center">
    <h2 data-reveal class="text-4xl md:text-5xl font-bold text-base-content mb-2">
      Preguntas <span class="text-wave">frecuentes</span>
    </h2>
    <p class="text-base-content/70 max-w-2xl mx-auto mb-10">
      Todo lo que necesitas saber antes de empezar. Si te queda alguna duda,
      <a
        href="https://www.linkedin.com/company/sur-digital-malaga"
        target="_blank"
        rel="noopener noreferrer"
        class="link link-hover font-bold text-secondary"
        >escríbenos por LinkedIn</a
      >.
    </p>

    <div data-reveal-group class="flex flex-col gap-3 max-w-3xl mx-auto text-start">
      {
        DATA.faq.map(({ q, a }) => (
          <details class="collapse collapse-arrow bg-base-100 shadow-sm">
            <summary class="collapse-title font-bold">{q}</summary>
            <div class="collapse-content text-base-content/70" set:html={a} />
          </details>
        ))
      }
    </div>
  </div>
</section>
