---
// Logo 3D interactivo de public/models, compartido por la home española y las
// homes traducidas (antes vivía dentro de Hero4 y solo lo tenía el español).
//
// Pinta primero el póster (mismo encuadre, luz y sombra que el 3D) y Three.js
// + el modelo se descargan solo cuando el visitante interactúa con el logo:
// pasar el ratón por encima, pulsar o arrastrar. Así 220 KB de motor 3D no
// compiten con el LCP ni bloquean el hilo principal. Una vez cargado, el logo
// se balancea solo, se puede arrastrar para girarlo y da una vuelta completa al
// hacer clic. Con `prefers-reduced-motion` se apaga el balanceo ambiental.
//
// Los textos de accesibilidad se pueden pasar por props: las homes traducidas
// usan los de src/i18n/ui.ts y el español se queda con los de por defecto.
import { Image } from "astro:assets";
import posterLogo from "../assets/logo-sur-digital-3d.webp";

// Logo del hero: GLB comprimido con meshoptimizer (EXT_meshopt_compression),
// que lo deja en un tercio del tamaño original; el loader lo decodifica al
// vuelo al cargarlo.
const MODEL_SRC = "/models/logo-sur-digital.glb";

interface Props {
  label?: string;
  labelLite?: string;
  loading?: string;
  error?: string;
}

const {
  label = "Logo 3D interactivo. Se balancea solo, gira al arrastrarlo y da una vuelta completa al hacer clic.",
  labelLite = "Logo de Sur Digital",
  loading = "Cargando modelo 3D…",
  error = "No se ha podido cargar el modelo 3D",
} = Astro.props;
---

<!-- Gate de red del hero 3D. En 2G/3G o con ahorro de datos el logo se queda
     como imagen estática y no se descarga nada al interactuar: son ~205 KB de
     Three.js + modelo. Va inline para decidirlo antes de la interacción. -->
<script is:inline>
  (function () {
    var connection = navigator.connection || {};
    var type = connection.effectiveType || "";
    var lite =
      connection.saveData === true ||
      type === "slow-2g" ||
      type === "2g" ||
      type === "3g";
    // Ojo: no usar data-model3d, que es el selector del propio hero
    // (document.querySelector lo encontraría antes en <html>).
    document.documentElement.dataset.hero3d = lite ? "lite" : "full";
  })();
</script>

<!-- En móvil y tablet el logo va debajo del texto y más pequeño: si va primero,
     el titular y el CTA caen fuera de la primera pantalla. En escritorio
     recupera su tamaño y pasa a la derecha del texto. -->
<div class="relative mx-auto w-full max-w-[280px] sm:max-w-sm lg:mx-0 lg:max-w-lg">
  <div
    data-model3d
    data-src={MODEL_SRC}
    data-label-lite={labelLite}
    class="relative aspect-square cursor-grab touch-pan-y select-none active:cursor-grabbing"
    role="img"
    aria-label={label}
  >
    <!-- Imagen estática del logo con el mismo encuadre, luz y sombra que el
         modelo 3D. Es lo que se ve al cargar (y lo único en redes lentas o con
         ahorro de datos). Se sirve adaptada al tamaño real de la columna: 280 px
         en móvil, 384 en tablet y ~490 en escritorio. -->
    <Image
      data-model3d-poster
      src={posterLogo}
      widths={[280, 384, 490, 720]}
      sizes="(max-width: 639px) 280px, (max-width: 1023px) 384px, 490px"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 h-full w-full object-contain transition-opacity duration-700"
    />

    <!-- Encima del póster: se funde cuando el 3D ya tiene su primer frame. -->
    <canvas
      data-model3d-canvas
      class="absolute inset-0 block h-full w-full opacity-0 transition-opacity duration-700"
      aria-hidden="true"></canvas>

    <p data-model3d-loading class="sr-only">{loading}</p>

    <p
      data-model3d-error
      hidden
      class="pointer-events-none absolute inset-x-0 bottom-3 text-center text-[10px] font-bold uppercase tracking-[0.2em] text-base-content/40"
    >
      {error}
    </p>
  </div>
</div>

<script>
  // Logo 3D del hero con Three.js. Se carga en diferido (Three.js + el modelo)
  // y se pausa fuera de pantalla o con la pestaña oculta. El logo se balancea
  // solo, se puede arrastrar para girarlo y da una vuelta completa al hacer
  // clic.
  import type { Mesh, MeshStandardMaterial, Object3D, Texture } from "three";

  const host = document.querySelector<HTMLElement>("[data-model3d]");
  const canvas = host?.querySelector<HTMLCanvasElement>("[data-model3d-canvas]");
  // El script del cliente no ve las constantes del frontmatter: la ruta llega
  // por data-src.
  const modelSrc = host?.dataset.src ?? "/models/logo-sur-digital.glb";

  if (host && canvas) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const poster = host.querySelector<HTMLImageElement>("[data-model3d-poster]");
    // El gate del <head> decide antes del primer paint: en 2G/3G o con ahorro
    // de datos no se descargan los ~205 KB de Three.js + modelo y el hero se
    // queda con el póster. Sin `navigator.connection` (Safari) se carga normal.
    const lite = document.documentElement.dataset.hero3d === "lite";
    let booted = false;

    const boot = async () => {
      if (booted) return;
      booted = true;

      const loading = host.querySelector<HTMLElement>("[data-model3d-loading]");
      const errorLabel = host.querySelector<HTMLElement>("[data-model3d-error]");
      // Un reintento tras un fallo anterior no debe arrastrar el aviso viejo.
      if (errorLabel) errorLabel.hidden = true;

      try {
        // El modelo se pide a la vez que los módulos: son 36 KB que se bajan
        // mientras llega Three.js, en paralelo.
        const modelBytes = fetch(modelSrc).then((response) => {
          if (!response.ok) {
            throw new Error(`${response.status} ${response.statusText} al pedir ${modelSrc}`);
          }
          return response.arrayBuffer();
        });
        // Si el arranque falla antes de pedir el modelo, que no quede una
        // promesa rechazada sin gestionar.
        modelBytes.catch(() => {});

        // Los cuatro módulos se piden a la vez. Antes iban en serie y el GLB
        // no empezaba a descargarse hasta terminar el último; ahora la red
        // trabaja en paralelo desde el primer momento.
        //
        // En desarrollo, Vite devuelve 504 mientras reoptimiza dependencias y
        // el primer import dinámico falla. Como ahora la carga la dispara el
        // visitante, ese 504 dejaba el aviso de error fijo: se reintenta una
        // vez sin recargar y, si el fallo es real, el siguiente gesto sobre el
        // logo vuelve a intentarlo.
        const loadModules = () =>
          Promise.all([
            import("three"),
            import("three/examples/jsm/loaders/GLTFLoader.js"),
            import("three/examples/jsm/libs/meshopt_decoder.module.js"),
          ]);

        let modules: Awaited<ReturnType<typeof loadModules>>;
        try {
          modules = await loadModules();
        } catch (error) {
          console.warn("Reintentando la carga de los módulos 3D…", error);
          await new Promise((resolve) => setTimeout(resolve, 800));
          modules = await loadModules();
        }
        const [THREE, { GLTFLoader }, { MeshoptDecoder }] = modules;

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
          powerPreference: "high-performance",
        });
        // 1,75 en vez de 2: en pantallas retina se nota el borde, pero por
        // encima de 1,75 ya no se aprecia y se paga el doble de píxeles.
        let pixelRatio = Math.min(window.devicePixelRatio || 1, 1.75);
        renderer.setPixelRatio(pixelRatio);
        // Sin tone mapping las luces altas se recortan a blanco plano y los
        // metales quedan sin matices. ACES comprime el rango como una cámara.
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        // El póster se renderizó con mucha más luz que la que daba el entorno
        // anterior: sin subir la exposición el azul salía casi negro al lado
        // de la imagen estática.
        renderer.toneMappingExposure = 1.65;
        renderer.setClearAlpha(0);

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 60);

        // Entorno de estudio propio en vez de RoomEnvironment. La sala gris
        // genérica de Three.js dejaba el logo plano y con reflejos sucios;
        // este degradado con softboxes dibuja franjas de luz limpias y
        // alargadas en el marco y en los cantos, como en una foto de producto.
        // Se genera en un canvas y se precomputa una sola vez con PMREM.
        const pmrem = new THREE.PMREMGenerator(renderer);
        const envCanvas = document.createElement("canvas");
        envCanvas.width = 1024;
        envCanvas.height = 512;
        const envContext = envCanvas.getContext("2d");
        if (envContext) {
          const room = envContext.createLinearGradient(0, 0, 0, 512);
          room.addColorStop(0, "#eaf4ff");
          room.addColorStop(0.4, "#8fa6bf");
          room.addColorStop(0.58, "#33455a");
          room.addColorStop(1, "#0a141f");
          envContext.fillStyle = room;
          envContext.fillRect(0, 0, 1024, 512);

          // Los softboxes se pintan con blur: si no, su reflejo en el modelo
          // tendría el borde duro de un rectángulo.
          const softbox = (x: number, y: number, width: number, height: number, color: string) => {
            envContext.save();
            envContext.filter = "blur(26px)";
            envContext.fillStyle = color;
            envContext.beginPath();
            if (envContext.roundRect) {
              envContext.roundRect(x - width / 2, y - height / 2, width, height, height / 2);
            } else {
              envContext.rect(x - width / 2, y - height / 2, width, height);
            }
            envContext.fill();
            envContext.restore();
          };
          // Cálido a la izquierda, frío a la derecha y una tira cenital: los
          // tres acentos que separan el azul del logo del fondo oscuro.
          softbox(215, 155, 360, 84, "rgba(255, 224, 182, 0.92)");
          softbox(815, 145, 320, 104, "rgba(186, 224, 255, 0.95)");
          softbox(512, 42, 460, 54, "rgba(255, 255, 255, 0.85)");
        }
        const envTexture = new THREE.CanvasTexture(envCanvas);
        envTexture.mapping = THREE.EquirectangularReflectionMapping;
        envTexture.colorSpace = THREE.SRGBColorSpace;
        scene.environment = pmrem.fromEquirectangular(envTexture).texture;
        scene.environmentIntensity = 1.35;
        envTexture.dispose();
        pmrem.dispose();

        // Luz de estudio: relleno frío + clave + dos rim lights de marca. El
        // entorno ya aporta luz base, así que el hemisférico baja.
        // El relleno de suelo más claro es lo que ilumina las paredes
        // internas del marco (miran hacia abajo) y evita la línea negra que
        // quedaba dentro del borde superior.
        scene.add(new THREE.HemisphereLight(0xffffff, 0x4a6480, 1.2));

        const key = new THREE.DirectionalLight(0xffffff, 3.4);
        key.position.set(3.2, 4.2, 4.8);
        scene.add(key);

        const rimWarm = new THREE.PointLight(0xffb066, 24, 26, 2);
        rimWarm.position.set(-3.2, 1.4, 3.2);
        scene.add(rimWarm);

        const rimCool = new THREE.PointLight(0x2b9bff, 18, 26, 2);
        rimCool.position.set(3.4, -1.4, 2.4);
        scene.add(rimCool);

        // Sombra de contacto: óvalo difuso orientado a cámara (sprite). Antes
        // era un plano horizontal, pero con la cámara a la altura del logo se
        // veía de canto y su ancho se salía del encuadre, así que aparecía
        // cortada en seco contra los bordes del lienzo. Como sprite siempre
        // mira al espectador, y su tamaño se ata al encuadre al colocarla.
        const shadowCanvas = document.createElement("canvas");
        shadowCanvas.width = shadowCanvas.height = 256;
        const shadowContext = shadowCanvas.getContext("2d");
        if (shadowContext) {
          const gradient = shadowContext.createRadialGradient(128, 128, 0, 128, 128, 128);
          gradient.addColorStop(0, "rgba(12, 27, 44, 0.42)");
          gradient.addColorStop(0.4, "rgba(12, 27, 44, 0.16)");
          gradient.addColorStop(0.72, "rgba(12, 27, 44, 0.04)");
          gradient.addColorStop(1, "rgba(12, 27, 44, 0)");
          shadowContext.fillStyle = gradient;
          shadowContext.fillRect(0, 0, 256, 256);
        }
        const shadowTexture = new THREE.CanvasTexture(shadowCanvas);
        shadowTexture.colorSpace = THREE.SRGBColorSpace;

        const contactShadow = new THREE.Sprite(
          new THREE.SpriteMaterial({
            map: shadowTexture,
            transparent: true,
            opacity: 0.8,
            depthWrite: false,
            toneMapped: false,
          })
        );
        contactShadow.visible = false;
        contactShadow.renderOrder = -1;
        scene.add(contactShadow);

        const BASE_X = 0;
        const BASE_Y = -0.35;
        const TAU = Math.PI * 2;

        const stage = new THREE.Group();
        stage.rotation.set(BASE_X, BASE_Y, 0);
        scene.add(stage);

        // --- Carga del modelo ---
        // El GLB llega comprimido con meshoptimizer (36 KB frente a 131 KB en
        // claro). Como ya se está descargando desde que arrancó el script,
        // aquí solo se esperan esos bytes y se parsean: nada de red.
        // El GLB trae materiales planos: poca cosa para un logo que se mira de
        // cerca. Se les sube un poco el reflejo del entorno y se les baja la
        // rugosidad, que es lo que marca el brillo de los cantos biselados
        // (los dos tonos de azul se mantienen tal cual).
        const polishMaterials = (object: Object3D) => {
          object.traverse((node) => {
            const mesh = node as Mesh;
            if (!mesh.isMesh) return;
            const materials = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
            for (const material of materials) {
              const standard = material as MeshStandardMaterial;
              if (!standard.isMeshStandardMaterial) continue;
              standard.envMapIntensity = 1.25;
              standard.roughness = Math.max(0.18, standard.roughness * 0.72);
              standard.needsUpdate = true;
            }
          });
        };

        const loadObject = async (src: string): Promise<Object3D> => {
          const loader = new GLTFLoader();
          // Sin este decodificador el archivo no abre.
          loader.setMeshoptDecoder(MeshoptDecoder);
          await MeshoptDecoder.ready;

          const data =
            src === modelSrc
              ? await modelBytes
              : await fetch(src).then((response) => {
                  if (!response.ok) {
                    throw new Error(`${response.status} al pedir ${src}`);
                  }
                  return response.arrayBuffer();
                });

          const loaded = (await loader.parseAsync(data, "")).scene;
          polishMaterials(loaded);
          return loaded;
        };

        // Liberar geometría, materiales y texturas del modelo que se va: los
        // archivos son grandes y sin esto cada cambio dejaría memoria de GPU
        // retenida hasta recargar la página.
        const disposeObject = (object: Object3D) => {
          object.traverse((node) => {
            const mesh = node as Mesh;
            if (!mesh.isMesh) return;
            mesh.geometry.dispose();
            const materials = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
            for (const material of materials) {
              for (const value of Object.values(material as unknown as Record<string, unknown>)) {
                if (value && (value as Texture).isTexture) (value as Texture).dispose();
              }
              material.dispose();
            }
          });
        };

        // --- Estado del modelo y de la interacción ---
        let pivot: Object3D | null = null;
        let currentSrc = "";
        let loadToken = 0;
        let baseScale = 1;
        // 0 → 1 en la entrada de cada modelo: pequeño "pop" en vez de aparecer
        // de golpe al cambiar de pieza.
        let enter = 1;
        // Radio de la esfera envolvente del modelo ya escalado, para encuadrar.
        let modelRadius = 1.5;
        // Huella del modelo y altura de su base, para dimensionar la sombra.
        let shadowFootprint = 0;
        let shadowBottom = -1;
        // Tamaño base de la sombra en el lienzo; el flote la encoge y la aclara
        // un poco en el aire y la devuelve al bajar.
        let shadowWidth = 0;
        let shadowHeight = 0;

        // --- Encuadre ---
        // Ajusta la distancia de cámara al radio real y al aspecto: el modelo
        // llena el canvas igual en móvil que en escritorio, en vez de depender
        // de una distancia fija que dejaba piezas diminutas o recortadas.
        const fitCamera = () => {
          const vFov = THREE.MathUtils.degToRad(camera.fov);
          const hFov = 2 * Math.atan(Math.tan(vFov / 2) * camera.aspect);
          const distance = (modelRadius * 1.06) / Math.sin(Math.min(vFov, hFov) / 2);
          camera.position.set(0, 0, Math.max(4.2, distance));
          camera.lookAt(0, 0, 0);
          camera.updateProjectionMatrix();
        };

        // La sombra se ata al ancho visible en ese momento: con el logo muy
        // ancho o el lienzo estrecho (móvil) se encoge en vez de salirse y
        // quedar cortada.
        const placeShadow = () => {
          if (!shadowFootprint) return;
          const halfHeight =
            Math.tan(THREE.MathUtils.degToRad(camera.fov) / 2) * camera.position.z;
          const halfWidth = halfHeight * camera.aspect;
          const width = Math.min(shadowFootprint * 1.3, halfWidth * 1.72);
          const height = Math.min(width * 0.24, halfHeight * 0.8);
          shadowWidth = width;
          shadowHeight = height;
          contactShadow.scale.set(width, height, 1);
          // Centrada justo bajo la base: se lee como apoyo y no como una
          // mancha detrás del logo.
          contactShadow.position.set(0, shadowBottom - height * 0.06, -0.35);
        };

        const showModel = async (src: string) => {
          if (src === currentSrc) return;

          const token = ++loadToken;
          if (errorLabel) errorLabel.hidden = true;
          if (loading) loading.hidden = false;

          let next: Object3D;
          try {
            next = await loadObject(src);
          } catch (error) {
            console.warn(`El modelo 3D ${src} no se ha podido cargar.`, error);
            if (token === loadToken) {
              if (loading) loading.hidden = true;
              if (errorLabel) errorLabel.hidden = false;
            }
            return; // se queda el modelo anterior
          }

          // Mientras cargaba se ha pedido otro modelo: se descarta este.
          if (token !== loadToken) {
            disposeObject(next);
            return;
          }

          // Centrar y escalar a partir de su caja real: los modelos vienen en
          // unidades de Blender o de Rhino (a veces centímetros), así que sin
          // normalizar saldrían diminutos o gigantes.
          const bounds = new THREE.Box3().setFromObject(next);
          const size = bounds.getSize(new THREE.Vector3());
          const center = bounds.getCenter(new THREE.Vector3());
          next.position.sub(center);

          const group = new THREE.Group();
          group.add(next);
          const scale = 2.8 / Math.max(size.x, size.y, size.z);
          group.scale.setScalar(scale);
          baseScale = scale;

          // Encuadre y sombra se calculan del tamaño ya escalado.
          const scaled = new THREE.Box3().setFromObject(group);
          modelRadius = scaled.getBoundingSphere(new THREE.Sphere()).radius;

          shadowFootprint = Math.max(size.x * scale, size.z * scale);
          shadowBottom = scaled.min.y;
          contactShadow.visible = true;

          if (pivot) {
            stage.remove(pivot);
            disposeObject(pivot);
          }
          pivot = group;
          stage.add(group);
          currentSrc = src;
          enter = 0;

          fitCamera();
          placeShadow();

          if (loading) loading.hidden = true;
          // El póster se funde y el lienzo aparece: el cambio no se nota.
          poster?.classList.add("opacity-0");
          canvas.classList.remove("opacity-0");
          if (!raf) draw(0);
        };

        // --- Tamaño ---
        const resize = () => {
          const rect = host.getBoundingClientRect();
          const width = Math.max(1, Math.round(rect.width));
          const height = Math.max(1, Math.round(rect.height));
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
          fitCamera();
          placeShadow();
        };

        resize();

        // --- Arrastre ---
        // Arrastrar gira la pieza con inercia al soltar; un toque corto (sin
        // desplazamiento) mantiene el comportamiento anterior de vuelta completa.
        let dragging = false;
        let dragDistance = 0;
        let lastPointerX = 0;
        let lastPointerY = 0;
        let yaw = 0;
        let pitch = 0;
        let yawVelocity = 0;

        const beginDrag = (event: PointerEvent) => {
          if (event.pointerType === "mouse" && event.button !== 0) return;
          dragging = true;
          dragDistance = 0;
          yawVelocity = 0;
          lastPointerX = event.clientX;
          lastPointerY = event.clientY;
          host.setPointerCapture?.(event.pointerId);
        };

        const moveDrag = (event: PointerEvent) => {
          if (!dragging) return;
          const dx = event.clientX - lastPointerX;
          const dy = event.clientY - lastPointerY;
          lastPointerX = event.clientX;
          lastPointerY = event.clientY;
          dragDistance += Math.abs(dx) + Math.abs(dy);

          yaw += dx * 0.008;
          pitch = Math.max(-0.45, Math.min(0.45, pitch + dy * 0.004));
          yawVelocity = dx * 0.008;
        };

        const endDrag = () => {
          if (!dragging) return;
          dragging = false;
          // Menos de 8 px de recorrido: ha sido un clic, no un arrastre.
          if (dragDistance < 8) spinOnce();
        };

        host.addEventListener("pointerdown", beginDrag);
        host.addEventListener("pointermove", moveDrag);
        host.addEventListener("pointerup", endDrag);
        host.addEventListener("pointercancel", endDrag);
        window.addEventListener("pointerup", endDrag);

        // Un clic sobre el modelo da una vuelta completa; después vuelve a
        // mirar al cursor, porque 2π y 0 son la misma orientación.
        let spin = 0;
        let spinTarget = 0;

        const spinOnce = () => {
          spinTarget += TAU;
        };

        // --- Bucle ---
        let raf = 0;
        let elapsed = 0;
        let slowFrames = 0;
        // Timer sustituye a Clock en three: getDelta sigue devolviendo segundos.
        const timer = new THREE.Timer();

        const draw = (delta: number) => {
          elapsed += delta;

          const ease = (current: number, target: number, speed: number) =>
            current + (target - current) * Math.min(1, delta * speed);

          if (spinTarget !== spin) {
            spin = ease(spin, spinTarget, 7);
            if (Math.abs(spinTarget - spin) < 0.015) {
              spin = 0;
              spinTarget = 0;
            }
          }

          if (!dragging) {
            // Inercia del arrastre con decaimiento independiente del framerate.
            yaw += yawVelocity;
            yawVelocity *= Math.pow(0.92, delta * 60);
            if (Math.abs(yawVelocity) < 0.0004) yawVelocity = 0;
            // El cabeceo vuelve solo a la horizontal: si no, el modelo se queda
            // torcido y no hay forma evidente de enderezarlo.
            pitch = ease(pitch, 0, 1.4);
          }

          // Animación de escaparate: un balanceo lento que enseña el canto del
          // logo sin llegar a ponerlo de perfil, con flote e inclinación suaves.
          // Es ambiente: con reduced-motion se apaga (multiplicado por 0), pero
          // el arrastre y el giro del clic siguen funcionando.
          const ambient = reduceMotion.matches ? 0 : 1;

          stage.rotation.y = BASE_Y + spin + yaw + Math.sin(elapsed * 0.55) * 0.3 * ambient;
          stage.rotation.x = BASE_X + pitch + Math.sin(elapsed * 0.42) * 0.035 * ambient;
          stage.rotation.z = Math.cos(elapsed * 0.37) * 0.02 * ambient;
          const floatY = Math.sin(elapsed * 0.7) * 0.05 * ambient;
          stage.position.y = floatY;

          // La sombra de contacto sigue al flote: cuando el logo sube se
          // encoge y se aclara; al bajar vuelve a su sitio. Es lo que hace que
          // el movimiento se lea como levitación y no como un recorte pegado.
          if (shadowWidth) {
            contactShadow.scale.set(
              shadowWidth * (1 - floatY * 0.7),
              shadowHeight * (1 - floatY * 0.7),
              1
            );
            (contactShadow.material as THREE.SpriteMaterial).opacity = 0.8 - floatY * 2.2;
          }

          // Entrada del modelo: escala de 0,9 a 1 y sube desde un poco abajo.
          if (pivot && enter < 1) {
            enter = Math.min(1, enter + delta * 2.6);
            const eased = 1 - Math.pow(1 - enter, 3);
            pivot.scale.setScalar(baseScale * (0.9 + 0.1 * eased));
            pivot.position.y = (1 - eased) * 0.18;
          }

          renderer.render(scene, camera);
        };

        // 30 fps en reposo: el flote es suave y no pide 60. Al arrastrar o al
        // girar se sube a 60 para que el gesto siga al dedo sin retardo.
        const FRAME_MS = 1000 / 30;
        let lastFrame = 0;
        let lastTick = 0;

        const loop = () => {
          raf = requestAnimationFrame(loop);
          const now = performance.now();
          const sinceLast = now - lastTick;
          lastTick = now;

          if (document.hidden) {
            // Consumir el tiempo acumulado para que al volver no haya un salto.
            timer.update(now);
            return;
          }

          // Si los frames llegan tarde de forma sostenida (GPU lenta, portátil
          // en ahorro de energía) se baja la resolución nativa una sola vez. Se
          // mide la cadencia real: renderer.render encola en el proceso GPU y
          // vuelve antes de que el trabajo esté hecho.
          if (pixelRatio > 1 && sinceLast < 900) {
            slowFrames = sinceLast > 50 ? slowFrames + 1 : 0;
            if (slowFrames >= 20) {
              pixelRatio = 1;
              slowFrames = 0;
              renderer.setPixelRatio(1);
              resize();
            }
          }

          const frameMs = dragging || spinTarget !== spin ? 1000 / 60 : FRAME_MS;
          if (now - lastFrame < frameMs) return;
          lastFrame = now;
          timer.update(now);
          draw(Math.min(timer.getDelta(), 0.05));
        };

        // setSize limpia el lienzo: cuando el bucle está parado (fuera de
        // pantalla) hay que repintar el frame estático a mano.
        new ResizeObserver(() => {
          resize();
          if (!raf) draw(0);
        }).observe(host);

        const visibility = new IntersectionObserver(
          ([entry]) => {
            if (entry.isIntersecting) {
              if (!raf) loop();
            } else {
              cancelAnimationFrame(raf);
              raf = 0;
            }
          },
          { threshold: 0.05 }
        );
        visibility.observe(host);

        loop();

        reduceMotion.addEventListener("change", () => {
          if (!raf) loop();
        });

        draw(0);

        void showModel(modelSrc);
      } catch (error) {
        console.warn("El modelo 3D del hero no se ha podido cargar.", error);
        // Que un fallo puntual (red, módulos) no deje el logo muerto hasta
        // recargar: el siguiente gesto vuelve a intentar el arranque.
        booted = false;
        if (loading) loading.hidden = true;
        if (errorLabel) errorLabel.hidden = false;
      }
    };

    if (lite) {
      // Red lenta o ahorro de datos: el póster se queda y no se pide nada más.
      canvas.classList.add("hidden");
      // Sin 3D no hay nada que arrastrar: la etiqueta no debe prometerlo.
      host.setAttribute("aria-label", host.dataset.labelLite ?? "Logo de Sur Digital");
    } else {
      // Nada de Three.js hasta que el visitante muestra intención. El póster
      // ocupa su sitio y se ve idéntico, así que esperar no cuesta nada; a
      // cambio, el motor 3D (186 KB) y el modelo (36 KB) no se descargan en la
      // carga inicial ni se evalúan en mitad del LCP. En táctil, pointerenter
      // no dispara y el primer toque arranca la carga.
      // Los listeners se quedan puestos: si el arranque falla, el siguiente
      // gesto lo reintenta (boot sale solo si ya está en marcha).
      const start = () => {
        boot();
      };
      const onEnter = (event: PointerEvent) => {
        if (event.pointerType === "mouse") start();
      };
      host.addEventListener("pointerenter", onEnter);
      // pointerenter solo llega al cruzar el borde: no dispara al recargar con
      // el cursor ya encima ni cuando el logo pasa por debajo al hacer scroll.
      // pointermove sí, y es igual de barato (boot sale si ya está en marcha).
      host.addEventListener("pointermove", onEnter);
      host.addEventListener("pointerdown", start);
      host.addEventListener("focusin", start);

      // Los gestos son el atajo, no el único camino: si nadie pasa por encima,
      // el 3D se carga igualmente cuando el hero entra en pantalla y el
      // navegador queda ocioso. Antes dependía de pointerenter, así que con el
      // cursor ya encima (recarga, volver atrás, ancla) no cargaba nunca, y el
      // estado :hover no sobrevive a una recarga. El póster queda como respaldo
      // hasta el primer frame.
      const schedule = (task: () => void) => {
        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(task, { timeout: 2000 });
        } else {
          window.setTimeout(task, 600);
        }
      };
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          schedule(start);
        },
        { rootMargin: "200px" },
      );
      observer.observe(host);
    }
  }
</script>
