---
// Antes/Después: compara el tipo de web anticuada que encontramos por un lado
// y el tipo de web que entregamos por otro. No es un cliente concreto: son
// dos prototipos, por eso el copy lo dice así en vez de vender un caso.
import { DATA } from "../data/data.astro";
import { CONTACT } from "../data/contact";

const { before, after } = DATA.beforeAfter;
---

<section
  id="antes-despues"
  class="pt-14 pb-20 bg-gradient-to-b from-base-200 to-base-100 flex flex-col items-center"
>
  <div class="container mx-auto px-6 flex flex-col items-center">
    <div data-reveal class="flex flex-col items-center">
      <h2 class="text-4xl md:text-5xl font-bold text-base-content text-center">
        De web anticuada a <span class="text-wave">máquina de vender</span>
      </h2>
      <p class="text-base-content/60 text-center max-w-2xl mt-3 mb-12">
        A la izquierda, la web que suele tener la mayoría de negocios locales. A
        la derecha, la que te entregamos. Cambia solo el punto de partida: la
        diferencia la notas desde el primer día.
      </p>
    </div>

    <div
      data-reveal-group
      class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl w-full"
    >
      <!-- ANTES -->
      <div class="card bg-base-100 shadow-md border border-base-300">
        <div class="card-body gap-4">
          <div class="flex items-center justify-between">
            <p class="font-black text-xl text-base-content/50">{before.label}</p>
            <!-- Medidor estilo Lighthouse -->
            <div
              class="radial-progress text-error font-bold"
              style={`--value:${before.score}; --size:4.5rem; --thickness: 5px;`}
              role="img"
              aria-label={`Puntuación ${before.score} de 100`}
            >
              {before.score}
            </div>
          </div>
          <ul class="flex flex-col gap-2.5 text-sm text-base-content/70">
            {
              before.items.map((item) => (
                <li class="flex gap-2 items-start">
                  <span class="text-error font-black shrink-0">✗</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- DESPUÉS -->
      <div class="card bg-base-100 shadow-lg border-2 border-secondary">
        <div class="card-body gap-4">
          <div class="flex items-center justify-between">
            <p class="font-black text-xl text-primary">{after.label}</p>
            <div
              class="radial-progress text-success font-bold"
              style={`--value:${after.score}; --size:4.5rem; --thickness: 5px;`}
              role="img"
              aria-label={`Puntuación ${after.score} de 100`}
            >
              {after.score}
            </div>
          </div>
          <ul class="flex flex-col gap-2.5 text-sm text-base-content/70">
            {
              after.items.map((item) => (
                <li class="flex gap-2 items-start">
                  <span class="text-success font-black shrink-0">✓</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <p data-reveal class="text-sm text-base-content/60 mt-8 text-center max-w-xl">
      ¿Tu web se parece más a la de la izquierda? Envíanos la URL por
      <a
        href={CONTACT.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="link link-hover font-bold text-secondary underline"
        >LinkedIn</a
      > y te preparamos una propuesta de mejora gratuita.
    </p>
  </div>
</section>
