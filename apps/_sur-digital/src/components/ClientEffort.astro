---
// "Qué necesitamos de ti": el proceso visto desde el cliente (cuánto tiempo
// y material suyo requiere cada fase). Complementa al Stepper (que cuenta el
// proceso desde nuestro lado). Datos en DATA.process.
import { DATA } from "../data/data.astro";
---

<section
  class="pt-14 pb-20 bg-gradient-to-b from-base-200 to-base-100 flex flex-col items-center"
>
  <div class="container mx-auto px-6">
    <div data-reveal class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-bold text-base-content">
        Qué necesitamos <span class="text-wave">de ti</span>
      </h2>
      <p class="text-base-content/70 max-w-2xl mx-auto mt-3">
        La pregunta que casi nadie responde antes de contratarte. Spoiler:
        mucho menos de lo que temes.
      </p>
    </div>

    <ul data-reveal-group class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {
        DATA.process.map(({ phase, need, time }) => (
          <li class="card bg-base-100 shadow-md border border-base-300">
            <div class="card-body gap-2">
              <div class="flex items-center justify-between gap-3 flex-wrap">
                <h3 class="card-title text-base">{phase}</h3>
                <span class="badge badge-outline badge-secondary badge-sm font-bold shrink-0">
                  {time}
                </span>
              </div>
              <p class="text-sm text-base-content/70 leading-relaxed" set:html={need} />
            </div>
          </li>
        ))
      }
    </ul>

    <p data-reveal class="text-center text-sm text-base-content/60 mt-8">
      Total: <span class="font-bold text-base-content">menos de una hora de tu tiempo</span> en
      toda la semana. Del resto nos encargamos nosotros.
    </p>
  </div>
</section>
