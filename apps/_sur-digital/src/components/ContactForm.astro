---
// Sección de contacto: el sitio tiene un único canal, la página de LinkedIn
// de Sur Digital. Se conserva el id="contacto" porque muchos CTA del sitio
// (Fab, MobileCta, precios, 404…) apuntan a este ancla.
// `lang` traduce los textos y mantiene el ancla y el diseño intactos.
import { CONTACT } from "../data/contact";
import LinkedInIcon from "../icons/LinkedInIcon.astro";
import { ui } from "../i18n/ui";

interface Props {
  lang?: string;
}
const { lang = "es" } = Astro.props;
const t = ui(lang).contact;
---

<section
  id="contacto"
  class="pt-14 pb-20 bg-gradient-to-b from-base-100 to-base-200 flex flex-col items-center"
>
  <div class="container mx-auto px-6 text-center">
    <h2 data-reveal class="text-4xl md:text-5xl font-bold text-base-content mb-2">
      {t.formTitleA} <span class="text-wave">{t.formTitleB}</span>
    </h2>
    <p class="text-base-content/70 max-w-2xl mx-auto mb-10">
      {t.formLead}
    </p>

    <div
      data-reveal
      class="card bg-base-100 shadow-lg border border-base-300 w-full max-w-xl mx-auto p-6 md:p-10 flex flex-col items-center gap-5"
    >
      <div
        class="w-16 h-16 rounded-full bg-[#0A66C2] flex items-center justify-center shrink-0"
        aria-hidden="true"
      >
        <LinkedInIcon class="size-8 text-white" />
      </div>

      <div>
        <p class="font-bold text-xl">{CONTACT.name}</p>
        <p class="text-base-content/70 text-sm">{t.role}</p>
      </div>

      <a
        href={CONTACT.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary btn-lg w-full"
      >
        <LinkedInIcon class="size-5" />
        {t.button}
      </a>

      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-1 text-sm">
        <li class="flex items-center gap-1.5">
          <span aria-hidden="true">⚡</span> {t.badgeTime}
        </li>
        <li class="flex items-center gap-1.5">
          <span aria-hidden="true">📍</span> {t.badgeArea}
        </li>
        <li class="flex items-center gap-1.5">
          <span aria-hidden="true">🤝</span> {t.badgeLockin}
        </li>
      </ul>

      <p class="text-xs text-base-content/60 text-center">
        {t.privacyBefore}
        <a
          href="/politica-privacidad/"
          hreflang="es"
          class="link link-hover underline">{t.privacyLink}</a
        >{t.privacyAfter}
      </p>
    </div>
  </div>
</section>
