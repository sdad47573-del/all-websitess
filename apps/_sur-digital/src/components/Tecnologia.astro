---
// Con qué construimos las webs y por qué importa. Es una sección de
// confianza técnica sin jerga: cada tecnología con su traducción a beneficio
// real (velocidad, seguridad, coste o mantenimiento).
const stack = [
  {
    name: "Astro",
    what: "Genera la web ya montada, sin cargar programas en tu móvil",
    why: "Es la razón de que cargue en menos de dos segundos: solo descarga lo imprescindible.",
  },
  {
    name: "Tailwind y daisyUI",
    what: "El sistema de diseño de la interfaz",
    why: "Todo se ve igual en móvil, tablet y ordenador, y se puede cambiar de color sin rehacer la web.",
  },
  {
    name: "AVIF y WebP",
    what: "Los formatos de tus fotos al publicarlas",
    why: "Una foto de 3 MB baja a 80 KB sin que se note. Tu web pesa menos y Google lo valora.",
  },
  {
    name: "Vercel",
    what: "El alojamiento en servidores con red global",
    why: "La web se sirve desde el punto más cercano, así que carga rápido también fuera de Málaga.",
  },
  {
    name: "Pagefind",
    what: "El buscador interno de tu web",
    why: "El cliente encuentra su servicio escribiendo dos palabras, sin menús imposibles de recorrer.",
  },
  {
    name: "Imágenes de compartir automáticas",
    what: "La portada que aparece al mandar tu enlace",
    why: "Cada artículo y cada página tienen su propia tarjeta al compartir en WhatsApp o LinkedIn.",
  },
];

const compromisos = [
  "Sin plugins de pago ni licencias anuales escondidas en la factura",
  "Sin panel de administración que haya que actualizar cada mes por seguridad",
  "Código legible: si algún día te lo llevas a otro proveedor, se puede mantener",
  "Todo el material (código, imágenes, dominio) queda a tu nombre",
];
---

<section
  id="tecnologia"
  class="pt-14 pb-20 bg-gradient-to-b from-base-100 to-base-200 flex flex-col items-center"
>
  <div class="container mx-auto px-6 flex flex-col items-center">
    <div data-reveal class="flex flex-col items-center text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-base-content">
        Con qué <span class="text-wave">construimos</span>
      </h2>
      <p class="text-base-content/70 max-w-2xl mt-3 mb-10">
        No hace falta que sepas nada de esto, pero sí que sepas con qué está hecha
        tu web: es lo que explica que sea rápida, segura y barata de mantener.
      </p>
    </div>

    <ul
      data-reveal-group
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 justify-items-stretch max-w-5xl w-full"
    >
      {
        stack.map(({ name, what, why }) => (
          <li class="card bg-base-100 shadow-sm border border-base-300">
            <div class="card-body gap-2 p-5">
              <h3 class="card-title text-base">{name}</h3>
              <p class="text-sm text-base-content/70 leading-relaxed">{what}</p>
              <p class="text-sm text-base-content/60 leading-relaxed border-l-2 border-primary/40 pl-3">
                {why}
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <ul data-reveal-group class="flex flex-col gap-2 max-w-2xl w-full mt-10">
      {
        compromisos.map((item) => (
          <li class="card bg-base-100 shadow-sm border border-base-300">
            <p class="card-body py-4 flex-row items-center gap-3 text-sm text-base-content/70">
              <span class="text-primary font-black shrink-0" aria-hidden="true">✓</span>
              {item}
            </p>
          </li>
        ))
      }
    </ul>

    <a data-reveal href="/servicios/" class="btn btn-outline mt-8">
      Ver todos los servicios
    </a>
  </div>
</section>
