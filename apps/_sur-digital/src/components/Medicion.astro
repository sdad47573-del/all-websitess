---
// Medición: responde a la pregunta «¿y esto para qué me sirve?». Lista qué se
// mide, de dónde vienen las visitas y qué recibe el cliente cada mes. Evita
// prometer posiciones: solo describe lo que se puede comprobar.
const metricas = [
  {
    metric: "Visitas y páginas vistas",
    text: "Cuánta gente entra y qué páginas mira. Si la web de tu servicio no se visita, ahí tenemos trabajo.",
  },
  {
    metric: "De dónde vienen",
    text: "Google, el mapa, redes o directo escribiendo tu nombre. Es la diferencia entre depender de una red social o ser dueño de tu tráfico.",
  },
  {
    metric: "Clics en llamar y escribir",
    text: "Cada pulsación en el teléfono o en el botón de contacto queda registrada: sabes cuántos contactos ha traído la web.",
  },
  {
    metric: "Formularios enviados",
    text: "Los envíos del formulario, con su origen. Los formularios que se abandonan también se ven, y casi siempre hay un motivo que se puede arreglar.",
  },
  {
    metric: "Búsquedas que te traen",
    text: "Con qué palabras te encuentra la gente en Google (Search Console). Es lo que decide qué contenido escribimos el mes siguiente.",
  },
  {
    metric: "Velocidad y errores",
    text: "Cuánto tarda en cargar en móvil real y si alguna página falla. Se revisa solo, sin que tú tengas que pedirlo.",
  },
];

const informe = [
  "Cada mes recibes un resumen de una página, en castellano y con las cifras clave arriba",
  "Lo comparamos con el mes anterior: qué sube, qué baja y por qué",
  "Terminamos siempre con una propuesta concreta: qué haríamos el mes siguiente",
  "Sin dashboard que tengas que aprender ni herramientas que caducan",
];
---

<section
  id="medicion"
  class="pt-14 pb-20 bg-gradient-to-b from-base-200 to-base-100 flex flex-col items-center"
>
  <div class="container mx-auto px-6 flex flex-col items-center">
    <div data-reveal class="flex flex-col items-center text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-base-content">
        Lo que <span class="text-wave">medimos</span>
      </h2>
      <p class="text-base-content/70 max-w-2xl mt-3 mb-10">
        Una web sin medición es una apuesta. Desde el primer día dejamos
        instalado qué se cuenta y a quién se lo contamos, para que sepas si tu
        web está trabajando o solo decorando.
      </p>
    </div>

    <ul
      data-reveal-group
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 justify-items-stretch max-w-5xl w-full"
    >
      {
        metricas.map(({ metric, text }) => (
          <li class="card bg-base-100 shadow-sm border border-base-300">
            <div class="card-body gap-2 p-5">
              <h3 class="card-title text-base">{metric}</h3>
              <p class="text-sm text-base-content/70 leading-relaxed">{text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div data-reveal class="card bg-base-100 shadow-md border border-base-300 max-w-2xl w-full mt-10">
      <div class="card-body gap-4">
        <h3 class="card-title text-xl">El informe mensual</h3>
        <ul class="flex flex-col gap-2">
          {
            informe.map((item) => (
              <li class="flex items-start gap-2 text-sm text-base-content/70">
                <span class="text-primary font-black shrink-0" aria-hidden="true">✓</span>
                {item}
              </li>
            ))
          }
        </ul>
        <a href="/blog/checklist-lanzar-web-negocio/" class="link link-primary text-sm font-bold">
          Mira la checklist que aplicamos antes de lanzar →
        </a>
      </div>
    </div>
  </div>
</section>
