---
import { Image } from "astro:assets";
import Logo from "../assets/logo-optimized.png";
import { CONTACT } from "../data/contact";
import LinkedInIcon from "../icons/LinkedInIcon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { LOCALES, LOCALE_LABELS } from "../data/i18n";
import { localize } from "../i18n/routes";
import { ui } from "../i18n/ui";

// `lang` traduce la navegación. Los enlaces apuntan a la versión localizada
// solo si esa página ya está traducida (ver src/i18n/routes.ts); si no, van a
// la española y se marcan con hreflang="es".
interface Props {
  lang?: string;
}
const { lang = "es" } = Astro.props;
const t = ui(lang);

// Enlaces de navegación: una sola lista para escritorio y móvil.
const NAV = [
  { href: "/servicios/", label: t.nav.services },
  { href: "/especialidades/", label: t.nav.specialities },
  { href: "/clientes/", label: t.nav.clients },
  { href: "/precios/", label: t.nav.pricing },
  { href: "/faq/", label: t.nav.faq },
  { href: "/blog/", label: t.nav.blog },
].map((item) => {
  const href = localize(item.href, lang);
  // Si el enlace aún apunta a la página española, se marca como tal para que
  // Google no lo tome por contenido de este idioma.
  const hreflang = href === item.href && lang !== "es" ? "es" : undefined;
  return { ...item, href, hreflang };
});

// Cambio de idioma conservando la página en la que está el visitante.
const currentPath = Astro.url.pathname;
const pathWithoutLang =
  lang === "es"
    ? currentPath
    : currentPath.replace(new RegExp(`^/${lang}(?=/|$)`), "") || "/";
const langHref = (code: string) =>
  code === "es" ? pathWithoutLang : localize(pathWithoutLang, code);

const logoHref = lang === "es" ? "/" : `/${lang}/`;
const currentCode = lang.toUpperCase();
---

<header
  id="top"
  class="fixed w-full bg-base-100/90 backdrop-blur-sm z-50 shadow-sm transition-[top] duration-300"
  style="top: var(--banner-h, 0px);"
>
  <nav class="container mx-auto px-6 py-4">
    <div class="flex justify-between items-center">
      <!-- shrink-0: sin esto, cuando la fila no cabe el logo se comprime y el
           texto del logo se planta encima de "Servicios". -->
      <a href={logoHref} aria-label="Sur Digital" class="flex shrink-0 items-center">
        <!-- 96px es el ancho real que ocupa h-8; sin `widths` Astro servía el
             logo a resolución completa (60 KB) para pintarlo a 96 px. -->
        <Image
          src={Logo}
          alt="Sur Digital"
          widths={[96, 192, 288]}
          sizes="96px"
          class="h-8 w-auto"
        />
      </a>

      <!-- Navegación desktop, desde lg (1024 px). En tablet (768–1023 px)
           estos enlaces no caben junto al logo y el CTA: el logo quedaba
           pisado y el botón de tema se salía por la derecha, así que ahí se
           mantiene la cabecera compacta con el menú hamburguesa.
           Sin desplegable de sectores: duplicaba el hub /especialidades/
           (misma lista de landings en dos sitios del nav). Los sectores se
           enlazan desde el hub, la home y el footer. -->
      <div class="hidden lg:flex space-x-6 items-center">
        {
          NAV.map(({ href, label, hreflang }) => (
            <a
              href={href}
              hreflang={hreflang}
              class="text-base-content/70 hover:text-primary transition-colors"
            >
              {label}
            </a>
          ))
        }
        <a
          href={CONTACT.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary items-center flex gap-2"
          aria-label={t.contact.button}
          ><LinkedInIcon class="size-4" /><span>{t.nav.contact}</span></a
        >
        <ThemeToggle />

        <!-- Selector de idioma (escritorio) -->
        <div class="dropdown dropdown-end" data-dropdown>
          <button
            type="button"
            aria-label={t.common.languages}
            aria-expanded="false"
            class="btn btn-ghost btn-sm gap-1 font-bold"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"
              ></path>
            </svg>
            {currentCode}
          </button>
          <ul
            class="dropdown-content menu bg-base-100 rounded-box border border-base-300 shadow-lg z-50 w-44 p-2 mt-2"
          >
            <li>
              <a
                href={langHref("es")}
                hreflang="es"
                lang="es"
                class={lang === "es" ? "font-bold" : undefined}
                aria-current={lang === "es" ? "true" : undefined}
                >{LOCALE_LABELS.es}</a
              >
            </li>
            {
              LOCALES.map((code) => (
                <li>
                  <a
                    href={langHref(code)}
                    hreflang={code}
                    lang={code}
                    class={lang === code ? "font-bold" : undefined}
                    aria-current={lang === code ? "true" : undefined}
                  >
                    {LOCALE_LABELS[code]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Tema + menú + CTA compacto en móvil -->
      <div class="flex lg:hidden items-center gap-1">
        <ThemeToggle />
        <a
          href={CONTACT.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
          aria-label={t.contact.button}
          ><LinkedInIcon class="size-4" /><span class="sr-only">{t.nav.contact}</span></a
        >
        <!-- Menú hamburguesa. daisyUI lo abre con :focus-within, pero en iOS
             tocar un botón no le da el foco, así que se abre y se cierra con el
             script de abajo y aria-expanded refleja el estado real. -->
        <div class="dropdown dropdown-end" data-dropdown>
          <button
            type="button"
            aria-label={t.common.languages}
            aria-expanded="false"
            aria-controls="menu-movil"
            class="btn btn-ghost btn-square"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
          <ul
            id="menu-movil"
            tabindex="-1"
            class="dropdown-content menu bg-base-100 rounded-box border border-base-300 shadow-lg z-50 w-64 p-2 mt-2"
          >
            {
              NAV.map(({ href, label, hreflang }) => (
                <li>
                  <a href={href} hreflang={hreflang}>{label}</a>
                </li>
              ))
            }
            <li>
              <a
                href={CONTACT.linkedin}
                target="_blank"
                rel="noopener noreferrer"
              >
                <LinkedInIcon class="size-4" />
                {t.contact.button}
              </a>
            </li>
            <li class="menu-title text-xs uppercase tracking-wide">
              {t.common.languages}
            </li>
            {
              LOCALES.map((code) => (
                <li>
                  <a href={langHref(code)} hreflang={code} lang={code}>
                    {LOCALE_LABELS[code]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  // Apertura y cierre de los desplegables de la cabecera.
  //
  // daisyUI abre el .dropdown-content con :focus-within. Eso va bien con
  // teclado, pero en iOS tocar un <button> no le da el foco, así que el menú
  // hamburguesa se quedaba cerrado al tocarlo. Aquí se controla con click,
  // se propaga aria-expanded y se cierra con Escape o al pulsar fuera.
  const headerLogo = document.querySelector<HTMLElement>("header a[href]");

  for (const dropdown of document.querySelectorAll<HTMLElement>(
    "[data-dropdown]"
  )) {
    const trigger = dropdown.querySelector("button");
    const content = dropdown.querySelector<HTMLElement>(".dropdown-content");
    if (!trigger || !content) continue;

    const setOpen = (open: boolean, moveFocusOut = false) => {
      dropdown.classList.toggle("dropdown-open", open);
      trigger.setAttribute("aria-expanded", String(open));

      // daisyUI muestra el contenido mientras el desplegable tenga el foco
      // (:focus-within). Si cerramos dejando el foco dentro, el menú se
      // reabre solo, así que al cerrar hay que sacarlo de ahí.
      if (!open && moveFocusOut && dropdown.contains(document.activeElement)) {
        headerLogo?.focus();
      }
    };

    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      const open = !dropdown.classList.contains("dropdown-open");
      setOpen(open);
      if (open) content.querySelector<HTMLElement>("a")?.focus();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (!dropdown.classList.contains("dropdown-open")) return;
      setOpen(false, true);
    });

    document.addEventListener("click", (event) => {
      if (!dropdown.classList.contains("dropdown-open")) return;
      // Pulsar fuera ya mueve el foco, pero con el ratón puede no pasar.
      if (!dropdown.contains(event.target as Node)) setOpen(false, true);
    });

    // Al pulsar un enlace del menú se cierra: en las páginas con ancla
    // (#clientes, #faq) la navegación no recarga y el menú se quedaba
    // abierto encima del contenido.
    for (const link of content.querySelectorAll("a")) {
      link.addEventListener("click", () => setOpen(false, true));
    }
  }
</script>
