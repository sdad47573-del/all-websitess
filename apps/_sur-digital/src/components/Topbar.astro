---
import { Image } from "astro:assets";
import Logo from "../assets/logo-optimized.png";
import { CONTACT } from "../data/contact";
import LinkedInIcon from "../icons/LinkedInIcon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { LOCALES, LOCALE_LABELS } from "../data/i18n";
import {
  isTranslated,
  localizedPath,
  localize,
  pageFromPath,
} from "../i18n/routes";
import { ui } from "../i18n/ui";

// `lang` traduce la navegación. Los enlaces apuntan a la versión localizada
// solo si esa página ya está traducida (ver src/i18n/routes.ts); si no, van a
// la española y se marcan con hreflang="es".
interface Props {
  lang?: string;
}
const { lang = "es" } = Astro.props;
const t = ui(lang);

// Ruta actual sin barra final, para marcar el enlace activo del menú.
const trimSlash = (value: string) =>
  value.length > 1 && value.endsWith("/") ? value.slice(0, -1) : value;
const currentPath = trimSlash(Astro.url.pathname);

// Enlaces de navegación: una sola lista para escritorio y móvil.
const NAV = [
  { href: "/servicios/", label: t.nav.services },
  { href: "/especialidades/", label: t.nav.specialities },
  { href: "/clientes/", label: t.nav.clients },
  { href: "/precios/", label: t.nav.pricing },
  { href: "/faq/", label: t.nav.faq },
  { href: "/blog/", label: t.nav.blog },
].map((item) => {
  // Cada idioma tiene su slug (/precios/ → /preise/). Lo que todavía no está
  // traducido enlaza a la página española y se marca con hreflang="es".
  const href = localize(item.href, lang);
  return {
    ...item,
    href,
    hreflang: isTranslated(item.href, lang) ? undefined : "es",
    // Página actual: aria-current para el lector de pantalla y color para
    // quien navega a ojo. Las anclas no cuentan como página distinta.
    active: trimSlash(href) === currentPath,
  };
});

// Cambio de idioma conservando la página: cada página traducida tiene su slug
// en cada idioma (/precios/ → /preise/). En una página que solo existe en
// español, los enlaces de idioma llevan a la home.
const page = pageFromPath(Astro.url.pathname);
const languageHref = (code: string) => localizedPath(page ?? "home", code);

const logoHref = "/";
const currentCode = lang.toUpperCase();

// Idiomas del selector: nombre nativo + código, con el idioma actual marcado.
// La misma lista se usa en escritorio y en el menú móvil (antes el móvil no
// ofrecía volver al español).
const languageOptions = [
  { code: "es", label: LOCALE_LABELS.es, href: languageHref("es") },
  ...LOCALES.map((code) => ({
    code,
    label: LOCALE_LABELS[code],
    href: languageHref(code),
  })),
].map((option) => ({ ...option, current: option.code === lang }));
---

<header
  id="top"
  class="fixed w-full bg-base-100/90 backdrop-blur-sm z-50 shadow-sm transition-[top] duration-300"
  style="top: var(--banner-h, 0px);"
>
  <nav class="container mx-auto px-6 py-4">
    <div class="flex justify-between items-center">
      <!-- shrink-0: sin esto, cuando la fila no cabe el logo se comprime y el
           texto del logo se planta encima de "Servicios". -->
      <!-- data-lang: al volver a la home se guarda el idioma de la página (la
           home es la única que no tiene slug propio). -->
      <a
        href={logoHref}
        data-lang={lang}
        aria-label="Sur Digital"
        class="flex shrink-0 items-center"
      >
        <!-- 96px es el ancho real que ocupa h-8; sin `widths` Astro servía el
             logo a resolución completa (60 KB) para pintarlo a 96 px. En AVIF
             el archivo baja a la mitad que en WebP. Y va eager: es la cabecera,
             siempre visible; en lazy el navegador lo pedía tarde y Lighthouse
             lo contaba como imagen de la carga inicial. -->
        <Image
          src={Logo}
          alt="Sur Digital"
          widths={[96, 192, 288]}
          sizes="96px"
          format="avif"
          loading="eager"
          class="h-8 w-auto"
        />
      </a>

      <!-- Navegación desktop, desde lg (1024 px). En tablet (768–1023 px)
           estos enlaces no caben junto al logo y el CTA: el logo quedaba
           pisado y el botón de tema se salía por la derecha, así que ahí se
           mantiene la cabecera compacta con el menú hamburguesa.
           Sin desplegable de sectores: duplicaba el hub /especialidades/
           (misma lista de landings en dos sitios del nav). Los sectores se
           enlazan desde el hub, la home y el footer. -->
      <div class="hidden lg:flex space-x-6 items-center">
        {
          NAV.map(({ href, label, hreflang, active }) => (
            <a
              href={href}
              hreflang={hreflang}
              aria-current={active ? "page" : undefined}
              class:list={[
                "transition-colors",
                active
                  ? "font-semibold text-primary underline decoration-2 underline-offset-8"
                  : "text-base-content/70 hover:text-primary",
              ]}
            >
              {label}
            </a>
          ))
        }
        <a
          href={CONTACT.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary items-center flex gap-2"
          aria-label={t.contact.button}
          ><LinkedInIcon class="size-4" /><span>{t.nav.contact}</span></a
        >
        <ThemeToggle lang={lang} />

        <!-- Selector de idioma (escritorio): píldora con el código actual y
             panel con los seis idiomas en su nombre nativo, con check en el
             activo. -->
        <div class="dropdown dropdown-end" data-dropdown>
          <button
            type="button"
            aria-label={t.common.languages}
            aria-expanded="false"
            class="btn btn-sm h-9 gap-1.5 rounded-full border border-base-300 bg-base-100/70 px-2.5 font-semibold text-base-content/80 shadow-none hover:border-primary/40 hover:bg-base-200 hover:text-base-content"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-4 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"
              ></path>
            </svg>
            <span class="text-xs tracking-wide">{currentCode}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-3.5 opacity-50"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
            </svg>
          </button>
          <div
            class="dropdown-content z-50 mt-2 w-60 overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-xl"
          >
            <p
              class="border-b border-base-200 px-3 py-2 text-[0.7rem] font-bold uppercase tracking-wider text-base-content/50"
            >
              {t.common.languages}
            </p>
            <ul class="menu w-full gap-0.5 p-1.5">
              {
                languageOptions.map((option) => (
                  <li>
                    <a
                      href={option.href}
                      data-lang={option.code}
                      lang={option.code}
                      aria-current={option.current ? "true" : undefined}
                      class:list={[
                        "flex items-center gap-2 rounded-btn px-2 py-2 text-sm",
                        option.current
                          ? "bg-primary/10 font-bold text-primary"
                          : "text-base-content/80 hover:bg-base-200",
                      ]}
                    >
                      <span
                        class:list={[
                          "w-7 shrink-0 rounded border px-0.5 text-center text-[0.65rem] font-bold uppercase tracking-wide",
                          option.current
                            ? "border-primary/30 bg-primary/10 text-primary"
                            : "border-base-300 text-base-content/50",
                        ]}
                      >
                        {option.code}
                      </span>
                      <span class="flex-1">{option.label}</span>
                      {option.current && (
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="size-4 shrink-0 text-primary"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          aria-hidden="true"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="m5 13 4 4L19 7"
                          />
                        </svg>
                      )}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <!-- Tema + menú + CTA compacto en móvil -->
      <div class="flex lg:hidden items-center gap-1">
        <ThemeToggle lang={lang} />
        <a
          href={CONTACT.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
          aria-label={t.contact.button}
          ><LinkedInIcon class="size-4" /><span class="sr-only">{t.nav.contact}</span></a
        >
        <!-- Menú hamburguesa. daisyUI lo abre con :focus-within, pero en iOS
             tocar un botón no le da el foco, así que se abre y se cierra con el
             script de abajo y aria-expanded refleja el estado real. -->
        <div class="dropdown dropdown-end" data-dropdown>
          <button
            type="button"
            aria-label={t.common.menu}
            aria-expanded="false"
            aria-controls="menu-movil"
            class="btn btn-ghost btn-square"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
          <ul
            id="menu-movil"
            tabindex="-1"
            class="dropdown-content menu bg-base-100 rounded-box border border-base-300 shadow-lg z-50 w-64 p-2 mt-2"
          >
            {
              NAV.map(({ href, label, hreflang, active }) => (
                <li>
                  <a
                    href={href}
                    hreflang={hreflang}
                    aria-current={active ? "page" : undefined}
                    class={active ? "font-bold text-primary" : undefined}
                  >
                    {label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href={CONTACT.linkedin}
                target="_blank"
                rel="noopener noreferrer"
              >
                <LinkedInIcon class="size-4" />
                {t.contact.button}
              </a>
            </li>
            <li class="menu-title px-3 text-[0.7rem] uppercase tracking-wider">
              {t.common.languages}
            </li>
            {
              languageOptions.map((option) => (
                <li>
                  <a
                    href={option.href}
                    hreflang={option.code}
                    lang={option.code}
                    aria-current={option.current ? "true" : undefined}
                    class:list={[
                      "flex items-center gap-2",
                      option.current && "font-bold text-primary",
                    ]}
                  >
                    <span
                      class:list={[
                        "w-7 shrink-0 rounded border px-0.5 text-center text-[0.65rem] font-bold uppercase tracking-wide",
                        option.current
                          ? "border-primary/30 bg-primary/10 text-primary"
                          : "border-base-300 text-base-content/50",
                      ]}
                    >
                      {option.code}
                    </span>
                    <span class="flex-1">{option.label}</span>
                    {option.current && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="size-4 shrink-0 text-primary"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="m5 13 4 4L19 7"
                        />
                      </svg>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  // Apertura y cierre de los desplegables de la cabecera.
  //
  // daisyUI abre el .dropdown-content con :focus-within. Eso va bien con
  // teclado, pero en iOS tocar un <button> no le da el foco, así que el menú
  // hamburguesa se quedaba cerrado al tocarlo. Aquí se controla con click,
  // se propaga aria-expanded y se cierra con Escape o al pulsar fuera.
  const headerLogo = document.querySelector<HTMLElement>("header a[href]");

  for (const dropdown of document.querySelectorAll<HTMLElement>(
    "[data-dropdown]"
  )) {
    const trigger = dropdown.querySelector("button");
    const content = dropdown.querySelector<HTMLElement>(".dropdown-content");
    if (!trigger || !content) continue;

    const setOpen = (open: boolean, moveFocusOut = false) => {
      dropdown.classList.toggle("dropdown-open", open);
      trigger.setAttribute("aria-expanded", String(open));

      // daisyUI muestra el contenido mientras el desplegable tenga el foco
      // (:focus-within). Si cerramos dejando el foco dentro, el menú se
      // reabre solo, así que al cerrar hay que sacarlo de ahí.
      if (!open && moveFocusOut && dropdown.contains(document.activeElement)) {
        headerLogo?.focus();
      }
    };

    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      const open = !dropdown.classList.contains("dropdown-open");
      setOpen(open);
      if (open) content.querySelector<HTMLElement>("a")?.focus();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (!dropdown.classList.contains("dropdown-open")) return;
      setOpen(false, true);
    });

    document.addEventListener("click", (event) => {
      if (!dropdown.classList.contains("dropdown-open")) return;
      // Pulsar fuera ya mueve el foco, pero con el ratón puede no pasar.
      if (!dropdown.contains(event.target as Node)) setOpen(false, true);
    });

    // Al pulsar un enlace del menú se cierra: en las páginas con ancla
    // (#clientes, #faq) la navegación no recarga y el menú se quedaba
    // abierto encima del contenido.
    for (const link of content.querySelectorAll("a")) {
      link.addEventListener("click", () => setOpen(false, true));
    }
  }
</script>
