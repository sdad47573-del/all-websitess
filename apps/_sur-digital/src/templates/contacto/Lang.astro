---
// Página de contacto en los cinco idiomas: misma estructura y diseño que la
// española, con los textos del diccionario de interfaz.
import Layout from "../../../layouts/Layout.astro";
import Topbar from "../../../components/Topbar.astro";
import ContactForm from "../../../components/ContactForm.astro";
import Footer from "../../../components/Footer.astro";
import MobileCta from "../../../components/MobileCta.astro";
import Fab from "../../../components/Fab.astro";
import { LOCALES, LOCALE_HTML_LANG, type Locale } from "../../../data/i18n";
import { ui } from "../../../i18n/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = ui(lang);
// La URL pública no lleva idioma (ver src/i18n/routes.ts).
const path = "/contacto/";
---

<Layout
  title={t.contact.metaTitle}
  description={t.contact.metaDescription}
  lang={LOCALE_HTML_LANG[lang]}
  path={path}
>
  <Topbar lang={lang} />

  <main
    id="contenido"
    class="page-top pb-20 bg-gradient-to-b from-base-100 to-base-200"
  >
    <section class="container mx-auto px-6 max-w-3xl text-center mb-2" data-reveal>
      <h1 class="text-4xl md:text-5xl font-bold text-base-content mb-4">
        {t.contact.title}
      </h1>
      <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
        {t.contact.lead}
      </p>
    </section>

    <ContactForm lang={lang} />
  </main>

  <Fab lang={lang} />
  <MobileCta lang={lang} />
  <Footer lang={lang} />
</Layout>
