---
// Página de preguntas frecuentes con URL propia: el menú y los artículos ya
// no enlazan a /#faq.
import { DATA } from "../../../data/data.astro";
import Layout from "../../../layouts/Layout.astro";
import Topbar from "../../../components/Topbar.astro";
import Faq from "../../../components/Faq.astro";
import Footer from "../../../components/Footer.astro";

// FAQPage de esta página (la home y /precios/ tienen los suyos). Las respuestas
// de DATA.faq llevan HTML para la vista, pero el schema va en texto plano.
const plainText = (html: string) =>
  html
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: DATA.faq.map((entry) => ({
    "@type": "Question",
    name: entry.q,
    acceptedAnswer: { "@type": "Answer", text: plainText(entry.a) },
  })),
};
---

<Layout
  title="Preguntas frecuentes | Sur Digital"
  description="Precio cerrado, plazos, propiedad del dominio, Kit Digital y mantenimiento: las dudas que aparecen antes de contratar una web en Málaga."
  path="/faq/"
>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(faqSchema)}
  />

  <Topbar />

  <main
    id="contenido"
    class="page-top pb-20 bg-gradient-to-b from-base-100 to-base-200"
  >
    <section class="container mx-auto px-6 max-w-3xl text-center mb-2" data-reveal>
      <h1 class="text-4xl md:text-5xl font-bold text-base-content mb-4">
        Dudas antes de <span class="text-wave">empezar</span>
      </h1>
      <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
        Lo que más nos preguntan por LinkedIn, respondido sin letra pequeña.
      </p>
    </section>

    <Faq />
  </main>

  <Footer />
</Layout>
