---
// Página de precios dedicada: planes, extras, comparativa con agencias,
// FAQ de precios y schema OfferCatalog. Reutiliza Pricing (compact) y
// Comparison; el home usa la versión teaser (PricingLink).
import { DATA } from "../../data/data.astro";
import Layout from "../../layouts/Layout.astro";
import Topbar from "../../components/Topbar.astro";
import Footer from "../../components/Footer.astro";
import Pricing from "../../components/Pricing.astro";
import CambiosContent from "../../components/CambiosContent.astro";
import Comparison from "../../components/Comparison.astro";
import MarketComparison from "../../components/MarketComparison.astro";
import Retainers from "../../components/Retainers.astro";
import Enterprise from "../../components/Enterprise.astro";

const site = (
  Astro.site?.toString() ?? "https://www.sur-digital.com"
).replace(/\/$/, "");
const pageUrl = `${site}/precios/`;
const webPlan = DATA.plans.find((plan) => plan.name === "Web Completa");
if (!webPlan) throw new Error("Precios: falta el plan Web Completa");
const webPrice = webPlan.price;
const formatPrice = (price: number) =>
  price.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");

// `links` es opcional y solo se pinta en la página: el JSON-LD de abajo usa
// únicamente q/a, así que el schema se queda en texto plano.
const priceFaq: { q: string; a: string; links?: { href: string; label: string }[] }[] = [
  {
    q: "¿El 0€ es para siempre o tiene truco?",
    a: "Sin truco: la primera landing (1 página) es gratis de verdad. Solo pedimos que el dominio y el hosting vayan a tu nombre. Si luego quieres más páginas u otros servicios, ahí ya hay precio (cerrado y por escrito).",
  },
  {
    q: "¿Qué significa \"precio cerrado\"?",
    a: "Que lo que firmas es lo que pagas: sin horas extra, sin sorpresas con el IVA ni recargos al entregar. Si el alcance cambia porque TÚ quieres más cosas, se re-presupuesta antes de tocar nada.",
  },
  {
    q: "¿El hosting se paga aparte?",
    a: "El plan Web Completa incluye dominio y hosting el primer año. Del segundo en adelante son unos 60–90€/año según plataforma, a tu nombre y pagados directo al proveedor: sin intermediarios ni recargos nuestros.",
  },
  {
    q: "¿Puedo pagar con el Kit Digital?",
    a: "No trabajamos con Kit Digital. En el blog contamos por qué (burocracia, IVA fuera y plantillas cerradas), y también cómo elegir bien proveedor si tienes la subvención concedida.",
    links: [
      {
        href: "/blog/kit-digital-merece-la-pena/",
        label: "Por qué no trabajamos con el Kit Digital",
      },
      {
        href: "/blog/kit-digital-fraude-proveedores/",
        label: "Cómo elegir proveedor si tienes la subvención",
      },
    ],
  },
  {
    q: "¿Cómo se paga y cuándo?",
    a: "Transferencia o Bizum. En planes de pago: la mitad al empezar y la mitad al entregar. La primera landing no se paga: es gratis.",
  },
  {
    q: "¿Qué pasa si quiero cancelar el mantenimiento?",
    a: "Se cancela y punto: sin permanencia. Tu web sigue siendo tuya y funcionando; solo dejas de tener las actualizaciones y cambios mensuales.",
  },
  {
    q: "¿Los planes mensuales tienen permanencia?",
    a: "No: SEO local, redes sociales y Google Ads se pagan mes a mes y se cancelan cuando quieras. La web sigue siendo tuya pase lo que pase.",
  },
];

// Lo que NO entra en el precio: decirlo evita malentendidos y refuerza el
// "precio cerrado" (nada de esto se cobra por sorpresa sin avisar antes).
const exclusiones = [
  {
    name: "Certificados, licencias y tasas oficiales",
    note: "Si tu actividad necesita permisos o certificados, los tramita tu gestoría.",
  },
  {
    name: "Fotografía y vídeo profesional",
    note: "Trabajamos con tus fotos o te ponemos en contacto con un fotógrafo de confianza; se presupuesta aparte.",
  },
  {
    name: "Redacción de textos legales",
    note: "El aviso legal y la política de privacidad los redacta tu gestoría o abogado; nosotros los publicamos.",
  },
  {
    name: "Inversión publicitaria (Google Ads, Meta Ads)",
    note: "El presupuesto de anuncios se paga directo a la plataforma; la gestión de campañas se presupuesta aparte.",
  },
  {
    name: "Dominio y hosting a partir del segundo año",
    note: "El primer año va incluido en Web Completa y Pro. Después son unos 60–90€/año, pagados directo al proveedor.",
  },
  {
    name: "Cambios de alcance a mitad de proyecto",
    note: "El trabajo se cierra por escrito: si el proyecto crece porque quieres más cosas, se re-presupuesta antes de seguir.",
  },
];

// Guía "¿qué plan te toca?": traduce la necesidad del visitante a un plan
// concreto antes de enseñar las cuatro tarjetas. El nombre y el precio se
// buscan en DATA.plans (única fuente), así que si un plan cambia de nombre el
// build falla aquí en vez de publicar una guía desactualizada.
const guiaPlanes = [
  { necesidad: "Quiero empezar sin gastar nada", plan: "Landing Gratis" },
  { necesidad: "Soy fotógrafo, arquitecto o marca personal", plan: "Portfolio" },
  { necesidad: "Tengo un negocio y quiero hasta 5 páginas", plan: "Web Completa" },
  { necesidad: "Quiero vender online o una web grande", plan: "Pro + Tienda" },
].map(({ necesidad, plan }) => {
  const found = DATA.plans.find((item) => item.name === plan);
  if (!found) throw new Error(`Guía de precios: no existe el plan "${plan}"`);
  return { necesidad, name: found.name, price: found.price };
});

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${site}/` },
    { "@type": "ListItem", position: 2, name: "Precios", item: pageUrl },
  ],
};

const offersSchema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: "Planes y precios de diseño web en Málaga",
  url: pageUrl,
  provider: {
    "@type": "ProfessionalService",
    name: "Sur Digital",
    url: `${site}/`,
  },
  itemListElement: [
    {
      "@type": "Offer",
      name: "Portfolio",
      price: "490",
      priceCurrency: "EUR",
      valueAddedTaxIncluded: false,
      description:
        "Web de portfolio para fotógrafos, arquitectos y marca personal: galería, textos redactados y formación.",
    },
    {
      "@type": "Offer",
      name: "Landing Gratis",
      price: "0",
      priceCurrency: "EUR",
      valueAddedTaxIncluded: false,
      description:
        "Landing page de 1 página, moderna y responsive, con botón de contacto. Entrega en menos de 7 días.",
    },
    {
      "@type": "Offer",
      name: "Web Completa",
      price: "690",
      priceCurrency: "EUR",
      valueAddedTaxIncluded: false,
      description:
        "Hasta 5 páginas a medida, dominio propio, hosting 1 año, SEO básico y optimización móvil.",
    },
    {
      "@type": "Offer",
      name: "Pro + Tienda",
      price: "1290",
      priceCurrency: "EUR",
      valueAddedTaxIncluded: false,
      description:
        "Tienda online o web corporativa grande con pasarela de pago y SEO local.",
    },
    {
      "@type": "Offer",
      name: "Mantenimiento mensual",
      price: "49",
      priceCurrency: "EUR",
      valueAddedTaxIncluded: false,
      description:
        "Actualizaciones, copias de seguridad y cambios de contenido. Sin permanencia.",
    },
  ],
};
---

<Layout
  title="Precios diseño web Málaga 2026: desde 0€ | Sur Digital"
  description="Precios de diseño web en Málaga: landing gratis, web completa 690€, tienda online 1.290€ y mantenimiento 49€/mes. Precio cerrado por escrito, sin permanencia."
  image={`${site}/og/precios.png`}
  path="/precios/"
>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(breadcrumbs)}
  />
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(offersSchema)}
  />
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: priceFaq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />

  <Topbar />

  <main id="contenido" class="page-top pb-20 bg-gradient-to-b from-base-100 to-base-200">
    <!-- Hero -->
    <section class="container mx-auto px-6 max-w-4xl text-center mb-10" data-reveal>
      <p class="text-sm text-base-content/60 font-bold uppercase tracking-wide mb-3">
        <a href="/" class="link link-hover">Inicio</a> · Precios
      </p>
      <h1 class="text-4xl md:text-5xl font-bold text-base-content mb-4">
        Precios claros, <span class="text-wave">sin sorpresas</span>
      </h1>
      <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
        La mayoría de las agencias locales cobran{" "}
        <span class="font-bold">600–1.500€</span> por una web de 5 páginas; la nuestra cuesta{" "}
        <span class="font-bold">{formatPrice(webPrice)}€</span>. Aquí tienes lo que cuesta cada cosa, con el IVA y las
        condiciones por escrito antes de empezar. Más abajo tienes la
        comparativa con agencias de Málaga y sus precios publicados.
      </p>
    </section>

    <!-- Guía rápida: el visitante se reconoce en una línea y baja directo a
         la tarjeta que le toca, en vez de leer los cuatro planes enteros. -->
    <section class="container mx-auto px-6 max-w-4xl mb-8" data-reveal>
      <h2 class="text-2xl md:text-3xl font-bold text-base-content text-center mb-2">
        ¿Qué plan te toca?
      </h2>
      <p class="text-base-content/70 text-center max-w-2xl mx-auto mb-6">
        Busca tu caso. Cada tarjeta de abajo dice para quién es, qué incluye y
        cuánto cuesta.
      </p>
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          guiaPlanes.map(({ necesidad, name, price }) => (
            <li class="card bg-base-100 shadow-sm border border-base-300">
              <a href="#planes" class="card-body py-4 gap-1">
                <span class="text-sm text-base-content/70">{necesidad}</span>
                <span class="font-bold">
                  {name} · {price === 0 ? "gratis" : `${formatPrice(price)}€`}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Planes (reutiliza el componente de la home, sin cabecera) -->
    <div id="planes">
      <Pricing compact />
    </div>

    <!-- Extras -->
    <section class="container mx-auto px-6 max-w-3xl mt-16 mb-16">
      <h2 class="text-2xl md:text-3xl font-bold text-base-content mb-2 text-center" data-reveal>
        Extras y servicios sueltos
      </h2>
      <p class="text-base-content/70 text-center max-w-2xl mx-auto mb-8" data-reveal>
        Cosas que no entran en los planes pero puedes añadir a cualquiera de
        ellos, con su precio a la vista.
      </p>
      <ul data-reveal-group class="flex flex-col gap-3">
        {
          DATA.extras.map(({ name, price, note }) => (
            <li class="card bg-base-100 shadow-sm border border-base-300">
              <div class="card-body py-4 flex-row flex-wrap items-center gap-3">
                <div class="flex-1 min-w-0">
                  <p class="font-bold">{name}</p>
                  <p class="text-sm text-base-content/70">{note}</p>
                </div>
                <span class="font-black text-lg text-secondary shrink-0">
                  {price}
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <Retainers />

    <Enterprise />

    <!-- Qué no incluye: transparencia antes de la comparativa -->
    <section class="container mx-auto px-6 max-w-3xl mt-16 mb-16">
      <h2 class="text-2xl md:text-3xl font-bold text-base-content mb-2 text-center" data-reveal>
        Qué no incluye
      </h2>
      <p class="text-base-content/70 text-center max-w-2xl mx-auto mb-8" data-reveal>
        Decir lo que no entra es tan importante como decir lo que sí. Nada de
        esta lista se cobra por sorpresa: si lo necesitas, se presupuesta
        antes de empezar.
      </p>
      <ul data-reveal-group class="flex flex-col gap-3">
        {
          exclusiones.map(({ name, note }) => (
            <li class="card bg-base-100 shadow-sm border border-base-300">
              <div class="card-body py-4 flex-row items-start gap-3">
                <span class="font-black shrink-0 text-base-content/40" aria-hidden="true">
                  —
                </span>
                <div class="flex-1 min-w-0">
                  <p class="font-bold">{name}</p>
                  <p class="text-sm text-base-content/70">{note}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <CambiosContent />

    <!-- Comparativa con agencias -->
    <Comparison />

    <!-- Comparativa con nombre y precio publicado de la competencia local -->
    <MarketComparison />

    <!-- FAQ de precios -->
    <section class="container mx-auto px-6 max-w-3xl mt-16">
      <h2 class="text-2xl md:text-3xl font-bold text-base-content mb-6 text-center" data-reveal>
        Preguntas sobre precios
      </h2>
      <div data-reveal-group class="flex flex-col gap-3">
        {
          priceFaq.map(({ q, a, links }) => (
            <details class="collapse collapse-arrow bg-base-100 shadow-sm">
              <summary class="collapse-title font-bold">{q}</summary>
              <div class="collapse-content text-base-content/70">
                {a}
                {links && (
                  <ul class="mt-2 flex flex-col gap-1">
                    {links.map(({ href, label }) => (
                      <li>
                        <a href={href} class="link link-primary font-bold text-sm">
                          {label} →
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </details>
          ))
        }
      </div>
      <p class="text-center mt-8" data-reveal>
        <a href="https://www.linkedin.com/company/sur-digital-malaga" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
          Pide tu presupuesto por escrito
        </a>
      </p>
    </section>
  </main>

  <Footer />
</Layout>
