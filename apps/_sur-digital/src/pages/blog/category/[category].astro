---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Topbar from "../../../components/Topbar.astro";
import Footer from "../../../components/Footer.astro";
import { pageTitle, slugifyCategory } from "../../../lib/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const categories = [...new Set(posts.map((p) => p.data.category))];

  return categories.map((category) => ({
    params: { category: slugifyCategory(category) },
    props: {
      category,
      posts: posts
        .filter((p) => p.data.category === category)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { category, posts } = Astro.props;

// Title orientado a la búsqueda (no "Artículos de…"): en Google la categoría
// compite por la keyword de cabeza (p. ej. "seo local", 82 impresiones), y un
// title que empieza por la keyword rinde mejor en CTR.
const categoryTitles: Record<string, string> = {
  "SEO local": "SEO local en Málaga: guía y artículos",
  Precios: "Precios de una web en Málaga: guías y casos",
  Guías: "Guías de webs y SEO para negocios de Málaga",
  Sectores: "Webs por sector para negocios de Málaga",
  Anuncios: "Anuncios y novedades",
};

// La categoría de SEO local es la que más impresiones recibe (120 en 3 meses,
// posición 24) y era un archivo vacío: solo tarjetas. Un hub con contenido
// propio puede pelear la primera página; el resto de categorías no tienen
// volumen suficiente para justificar textos únicos.
const seoLocalContent =
  category === "SEO local"
    ? {
        intro: [
          "El SEO local es el trabajo de aparecer en Google cuando alguien busca tu servicio en tu zona: el mapa de tres negocios que sale antes que las webs, las búsquedas \"cerca de mí\" y las de \"fontanero en Málaga\". No compites contra toda internet: compites contra los negocios que están a tu alrededor.",
          "Estos artículos cubren el ciclo completo: qué es, cómo se optimiza la ficha de Google Business, cómo se piden reseñas, cuánto cuesta y cuánto tarda. Si prefieres empezar por lo urgente, ve directo a la <a href=\"/blog/que-es-el-seo-local/\">guía de qué es el SEO local</a>.",
        ],
        sections: [
          {
            heading: "Cómo decide Google qué negocios enseña en el mapa",
            paragraphs: [
              "Google resume sus criterios en tres: <strong>relevancia</strong> (que tu ficha y tu web digan lo que la gente busca), <strong>distancia</strong> (lo lejos que está el negocio de quien busca) y <strong>prominencia</strong> (reseñas, menciones y enlaces que te dan autoridad). La distancia no se compra; la relevancia y la prominencia sí se trabajan.",
              "En la práctica, la ficha de Google Business es la pieza que más mueve la aguja al principio: categoría correcta, horario real, fotos propias, publicaciones y reseñas respondidas. La guía paso a paso está en <a href=\"/blog/ficha-google-business-optimizada/\">cómo optimizar tu ficha de Google</a>.",
            ],
          },
          {
            heading: "Web local: una página por servicio y zona",
            paragraphs: [
              "La ficha sola no basta. Tu web necesita una página por servicio y por zona donde trabajas de verdad, con contenido propio y datos locales: no veinte páginas copiadas cambiando el nombre del municipio. Esa es la diferencia entre posicionar y que Google ignore el intento.",
              "Si trabajas en Málaga capital y Costa del Sol, la estructura es la misma: servicios claros, pruebas (clientes, reseñas, casos) y una ficha que coincida con el nombre, la dirección y el teléfono de la web.",
            ],
          },
          {
            heading: "Cuánto cuesta y cuánto tarda",
            paragraphs: [
              "El posicionamiento local mensual en Sur Digital parte de <a href=\"/servicios/\">100 €/mes, sin permanencia</a>. Lo que cuesta dependerá de la competencia de tu zona y del punto de partida de tu ficha y tu web; los rangos están en <a href=\"/blog/cuanto-cuesta-seo-local-malaga/\">cuánto cuesta el SEO local en Málaga</a>.",
              "En plazos, seamos honestos: las primeras semanas se mueven las bases, los resultados notables suelen llegar entre el mes 2 y el 4, y lo bueno se consolida al año. Lo detallamos mes a mes en <a href=\"/blog/seo-local-cuanto-tarda/\">cuánto tarda el SEO local</a>.",
            ],
          },
        ],
        faq: [
          {
            q: "¿Qué es el SEO local en una frase?",
            a: "Es el conjunto de acciones para que tu negocio aparezca en Google Maps y en las búsquedas de tu zona cuando alguien busca lo que vendes cerca de ti.",
          },
          {
            q: "¿Puedo salir en Google Maps sin web?",
            a: "Sí, con una ficha de Google Business verificada. Pero una web con páginas por servicio y zona te da relevancia y refuerza la ficha; sin ella compites con una mano atada.",
          },
          {
            q: "¿Comprar reseñas acelera el posicionamiento?",
            a: "No, y puede costarte la ficha. Google detecta patrones artificiales. Tres reseñas reales al mes durante un año pesan más que treinta compradas en una semana.",
          },
          {
            q: "¿Cuánto tarda el SEO local en dar clientes?",
            a: "Las bases se mueven en 4 semanas, los primeros resultados notables entre el mes 2 y el 4, y la autoridad se consolida al año. Nadie serio garantiza posiciones.",
          },
        ],
      }
    : null;

const site = (
  Astro.site?.toString() ?? "https://sur-digital.vercel.app"
).replace(/\/$/, "");
const categoryUrl = `${site}/blog/category/${slugifyCategory(category)}/`;
const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: `${site}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: `${site}/blog/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: category,
      item: categoryUrl,
    },
  ],
};

const formatDate = (d: Date) =>
  d.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });
---

<Layout
  title={pageTitle(
    categoryTitles[category] ?? `${category} para negocios de Málaga`
  )}
  description={seoLocalContent
    ? "Qué es el SEO local y cómo salir en Google Maps en Málaga: ficha, reseñas, páginas por zona, precios y plazos reales. Guía y artículos."
    : `${posts.length} artículos sobre ${category.toLowerCase()} para negocios de Málaga: qué hacer, cuánto cuesta y los errores que cuestan clientes. Sin humo.`}
  path={`/blog/category/${slugifyCategory(category)}/`}
>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(breadcrumbs)}
  />
  {seoLocalContent && (
    <script
      is:inline
      type="application/ld+json"
      slot="head"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: seoLocalContent.faq.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      })}
    />
  )}

  <Topbar />

  <main id="contenido" class="page-top pb-20 bg-gradient-to-b from-base-100 to-base-200">
    <div class="container mx-auto px-6 max-w-4xl">
      <nav
        aria-label="Migas de pan"
        class="text-sm text-base-content/60 font-bold uppercase tracking-wide mb-2 flex items-center gap-2"
      >
        <a href="/blog/" class="link link-hover">Blog</a>
        <span aria-hidden="true">·</span>
        <span>{category}</span>
      </nav>
      <h1 data-reveal class="text-4xl md:text-5xl font-bold text-base-content mb-3">{category}</h1>
      <p class="text-base-content/70 mb-8">
        {posts.length}
        {posts.length === 1 ? "artículo" : "artículos"} en esta categoría.
      </p>

      {seoLocalContent && (
        <div class="mb-12 space-y-5 text-base-content/70 leading-relaxed">
          {seoLocalContent.intro.map((paragraph) => (
            <p set:html={paragraph} />
          ))}
          {seoLocalContent.sections.map((section) => (
            <section>
              <h2 class="text-2xl font-bold text-base-content mt-8 mb-3">
                {section.heading}
              </h2>
              {section.paragraphs.map((paragraph) => (
                <p class="mb-3" set:html={paragraph} />
              ))}
            </section>
          ))}
        </div>
      )}

      <ul data-reveal-group class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          posts.map((post) => (
            <li class="card bg-base-100 shadow-md border border-base-300 transition-all hover:shadow-lg hover:-translate-y-1">
              <a href={`/blog/${post.id}/`} class="card-body p-6 gap-2">
                <div class="flex items-center justify-between gap-2">
                  <time
                    class="text-xs text-base-content/60 font-bold uppercase tracking-wide"
                    datetime={post.data.pubDate.toISOString()}
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                  <span class="badge badge-sm badge-secondary badge-outline font-bold">
                    {post.data.category}
                  </span>
                </div>
                <h2 class="card-title text-lg leading-snug">
                  {post.data.title}
                </h2>
                <p class="text-sm text-base-content/70 leading-relaxed">
                  {post.data.description}
                </p>
                <span class="link link-primary text-sm font-bold pt-1">
                  Leer artículo →
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      {seoLocalContent && (
        <section class="mt-12">
          <h2 class="text-2xl font-bold text-base-content mb-6">
            Preguntas frecuentes sobre SEO local
          </h2>
          <div class="flex flex-col gap-3">
            {seoLocalContent.faq.map((f) => (
              <details class="collapse collapse-arrow bg-base-100 border border-base-300">
                <summary class="collapse-title font-bold">{f.q}</summary>
                <div class="collapse-content text-sm text-base-content/70">
                  <p>{f.a}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      <p class="mt-12">
        <a href="/blog/" class="link link-primary font-bold"
          >← Ver todos los artículos</a
        >
      </p>
    </div>
  </main>

  <Footer />
</Layout>
