---
import About from '../components/About.astro';
import AntesDespues from '../components/AntesDespues.astro';
import Areas from '../components/Areas.astro';
import Calculadora from '../components/Calculadora.astro';
import CambiosContent from '../components/CambiosContent.astro';
import Comparison from '../components/Comparison.astro';
import ContactForm from '../components/ContactForm.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Deliverables from '../components/Deliverables.astro';
import Extras from '../components/Extras.astro';
import Fab from '../components/Fab.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Hero4 from '../components/Hero4.astro';
import JsonLd from '../components/JsonLd.astro';
import LatestPosts from '../components/LatestPosts.astro';
import Medicion from '../components/Medicion.astro';
import MobileCta from '../components/MobileCta.astro';
import Portfolio from '../components/Portfolio.astro';
import PricingLink from '../components/PricingLink.astro';
import Section1 from '../components/Section1.astro';
import SectorsGrid from '../components/SectorsGrid.astro';
import Stepper from '../components/Stepper.astro';
import Tecnologia from '../components/Tecnologia.astro';
import Topbar from '../components/Topbar.astro';
import TrustSignals from '../components/TrustSignals.astro';
import { PORTFOLIO } from '../data/portfolio';
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Consultora web en Málaga | Landing gratis"
	description={`Consultora web en Málaga: diseño web, SEO local y tiendas online. Primera landing gratis, web completa 490€ y tienda 890€. ${PORTFOLIO.length} proyectos con precio cerrado.`}
>
	<JsonLd slot="head" />
	<!-- Gate de red del hero 3D. En 4G o mejor se adelantan con el HTML las
	     descargas que antes arrancaban al ejecutarse el script del hero (el
	     motor Three.js, que es el 90 % de la espera en móvil, y el modelo).
	     En 2G/3G o con ahorro de datos no se pide nada: el hero se queda con
	     la imagen estática, que ahorra unos 205 KB.
	     La lista de chunks la escribe el plugin preloadHero3d al construir,
	     porque sus nombres llevan hash. -->
	<script is:inline>
		(function () {
			var connection = navigator.connection || {};
			var type = connection.effectiveType || "";
			var lite =
				connection.saveData === true ||
				type === "slow-2g" ||
				type === "2g" ||
				type === "3g";
			// Ojo: no usar data-model3d, que es el selector del propio hero
			// (document.querySelector lo encontraría antes en <html>).
			document.documentElement.dataset.hero3d = lite ? "lite" : "full";
			if (lite) return;
			var chunks = /*PRELOAD_CHUNKS*/[];
			for (var i = 0; i < chunks.length; i++) {
				var module = document.createElement("link");
				module.rel = "modulepreload";
				module.href = chunks[i];
				document.head.appendChild(module);
			}
			var model = document.createElement("link");
			model.rel = "preload";
			model.as = "fetch";
			model.href = "/models/logo-sur-digital.glb";
			model.crossOrigin = "anonymous";
			document.head.appendChild(model);
		})();
	</script>

	<Topbar />
	<main id="contenido">
		<Hero4 />
		<Portfolio />
		<PricingLink />
		<Extras />
		<TrustSignals />
		<SectorsGrid />
		<Stepper />
		<CambiosContent />
		<Section1 />
		<AntesDespues />
		<Calculadora />
		<Deliverables />
		<Tecnologia />
		<Medicion />
		<Comparison />
		<About />
		<Areas />
		<LatestPosts />
		<ContactForm />
		<Faq />
	</main>
	<Fab />
	<MobileCta />
	<CookieBanner />

	<Footer />
</Layout>
