---
import Layout from "../layouts/Layout.astro";
import { PORTFOLIO } from "../data/portfolio";

import Topbar from "../components/Topbar.astro";
import Hero4 from "../components/Hero4.astro";
import Stepper from "../components/Stepper.astro";
import Section1 from "../components/Section1.astro";
import AntesDespues from "../components/AntesDespues.astro";
import Portfolio from "../components/Portfolio.astro";
import SectorsGrid from "../components/SectorsGrid.astro";
import PricingLink from "../components/PricingLink.astro";
import Calculadora from "../components/Calculadora.astro";
import Comparison from "../components/Comparison.astro";
import TrustSignals from "../components/TrustSignals.astro";
import About from "../components/About.astro";
import Areas from "../components/Areas.astro";
import LatestPosts from "../components/LatestPosts.astro";
import Deliverables from "../components/Deliverables.astro";
import ClientEffort from "../components/ClientEffort.astro";
import ContactForm from "../components/ContactForm.astro";
import Faq from "../components/Faq.astro";
import Glosario from "../components/Glosario.astro";
import Fab from "../components/Fab.astro";
import MobileCta from "../components/MobileCta.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import LaunchBanner from "../components/LaunchBanner.astro";
import JsonLd from "../components/JsonLd.astro";

const featuredProject = PORTFOLIO[1] ?? PORTFOLIO[0];
---

<Layout
  title="Sur Digital: diseño web en Málaga | Landing gratis"
  description={`Agencia de diseño web en Málaga. Tu primera landing gratis, web completa 99€ y tienda online 299€. ${PORTFOLIO.length} proyectos, precio cerrado y online en 7 días.`}
>
  <JsonLd slot="head" />

  <LaunchBanner />
  <Topbar />
  <main id="contenido">
    <Hero4 featured={featuredProject} projectCount={PORTFOLIO.length} />
    <Portfolio />
    <PricingLink />
    <TrustSignals />
    <SectorsGrid />
    <Stepper />
    <ClientEffort />
    <Section1 />
    <AntesDespues />
    <Calculadora />
    <Deliverables />
    <Comparison />
    <About />
    <Areas />
    <LatestPosts />
    <ContactForm />
    <Faq />
    <Glosario />
  </main>
  <Fab />
  <MobileCta />
  <CookieBanner />

  <Footer />
</Layout>
