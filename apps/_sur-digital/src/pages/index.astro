---
import About from '../components/About.astro';
import AntesDespues from '../components/AntesDespues.astro';
import Areas from '../components/Areas.astro';
import Calculadora from '../components/Calculadora.astro';
import CambiosContent from '../components/CambiosContent.astro';
import Comparison from '../components/Comparison.astro';
import ContactForm from '../components/ContactForm.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Deliverables from '../components/Deliverables.astro';
import Extras from '../components/Extras.astro';
import Fab from '../components/Fab.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Hero4 from '../components/Hero4.astro';
import JsonLd from '../components/JsonLd.astro';
import LatestPosts from '../components/LatestPosts.astro';
import Medicion from '../components/Medicion.astro';
import MobileCta from '../components/MobileCta.astro';
import Portfolio from '../components/Portfolio.astro';
import PricingLink from '../components/PricingLink.astro';
import Section1 from '../components/Section1.astro';
import SectorsGrid from '../components/SectorsGrid.astro';
import Stepper from '../components/Stepper.astro';
import Tecnologia from '../components/Tecnologia.astro';
import Topbar from '../components/Topbar.astro';
import TrustSignals from '../components/TrustSignals.astro';
import { PORTFOLIO } from '../data/portfolio';
import Layout from '../layouts/Layout.astro';

const featuredProject = PORTFOLIO[1] ?? PORTFOLIO[0];
---

<Layout
	title="Agencia diseño web en Málaga | Landing gratis"
	description={`Agencia de diseño web en Málaga. Tu primera landing gratis, web completa 490€ y tienda online 890€. ${PORTFOLIO.length} proyectos, precio cerrado y online en 7 días.`}
>
	<JsonLd slot="head" />

	<Topbar />
	<main id="contenido">
		<Hero4 featured={featuredProject} projectCount={PORTFOLIO.length} />
		<Portfolio />
		<PricingLink />
		<Extras />
		<TrustSignals />
		<SectorsGrid />
		<Stepper />
		<CambiosContent />
		<Section1 />
		<AntesDespues />
		<Calculadora />
		<Deliverables />
		<Tecnologia />
		<Medicion />
		<Comparison />
		<About />
		<Areas />
		<LatestPosts />
		<ContactForm />
		<Faq />
	</main>
	<Fab />
	<MobileCta />
	<CookieBanner />

	<Footer />
</Layout>
