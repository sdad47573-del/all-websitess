---
// Página de preguntas frecuentes con URL propia: el menú y los artículos ya
// no enlazan a /#faq.
import Layout from "../layouts/Layout.astro";
import Topbar from "../components/Topbar.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Preguntas frecuentes | Sur Digital"
  description="Precio cerrado, plazos, propiedad del dominio, Kit Digital y mantenimiento: las dudas que aparecen antes de contratar una web en Málaga."
  path="/faq/"
>
  <Topbar />

  <main
    id="contenido"
    class="page-top pb-20 bg-gradient-to-b from-base-100 to-base-200"
  >
    <section class="container mx-auto px-6 max-w-3xl text-center mb-2" data-reveal>
      <h1 class="text-4xl md:text-5xl font-bold text-base-content mb-4">
        Dudas antes de <span class="text-wave">empezar</span>
      </h1>
      <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
        Lo que más nos preguntan por LinkedIn, respondido sin letra pequeña.
      </p>
    </section>

    <Faq />
  </main>

  <Footer />
</Layout>
