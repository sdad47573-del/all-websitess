---
// Página de clientes: el portfolio completo con URL propia, para que la
// navegación no dependa de /#clientes.
import Layout from "../layouts/Layout.astro";
import Topbar from "../components/Topbar.astro";
import Portfolio from "../components/Portfolio.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Clientes: webs publicadas en Málaga | Sur Digital"
  description="Portfolio de webs publicadas para negocios de Málaga y la Costa del Sol: restaurantes, comercios y profesionales. Precio cerrado y entrega en 7 días."
  path="/clientes/"
>
  <Topbar />

  <main
    id="contenido"
    class="page-top pb-20 bg-gradient-to-b from-base-100 to-base-200"
  >
    <section class="container mx-auto px-6 max-w-3xl text-center mb-6" data-reveal>
      <h1 class="text-4xl md:text-5xl font-bold text-base-content mb-4">
        Webs que ya están <span class="text-wave">trabajando</span>
      </h1>
      <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
        Cada proyecto con su enlace, para que lo abras y lo compruebes por tu
        cuenta: diseño, velocidad y cómo se pide cita o se compra.
      </p>
    </section>

    <Portfolio />
  </main>

  <Footer />
</Layout>
