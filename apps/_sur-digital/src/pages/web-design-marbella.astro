---
import Layout from "../layouts/Layout.astro";
import Topbar from "../components/Topbar.astro";
import Footer from "../components/Footer.astro";
import { CONTACT } from "../data/contact";

const site = (
  Astro.site?.toString() ?? "https://www.sur-digital.com"
).replace(/\/$/, "");

const faqs = [
  {
    q: "Do you work in English?",
    a: "Yes. The whole project — texts, calls and support — can run in English. Your website launches in Spanish and English from day one.",
  },
  {
    q: "How much does a website cost?",
    a: "Landing page free, full website €690, online shop €1,290. Fixed written quote, no lock-in, everything registered in your name.",
  },
  {
    q: "How long does it take?",
    a: "A landing page goes online in less than 7 days. Full websites and shops depend on content, usually 2–3 weeks.",
  },
  {
    q: "Do you do Google Maps positioning?",
    a: "Yes. Business profile setup, reviews strategy and local SEO in Spanish and English so you appear in the map pack.",
  },
];
---

<Layout
  lang="en"
  title="Web Design in Marbella: Prices & Local SEO | Sur Digital"
  description="Web design in Marbella: free landing page, full website €690, online shop €1,290. English-speaking team with Google Maps SEO included."
  path="/web-design-marbella/"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Web Design in Marbella" },
  ]}
  translations={[{ lang: "es", path: "/blog/diseno-web-marbella/" }]}
>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })}
  />

  <Topbar lang="en" />

  <main id="contenido" class="page-top pb-20 bg-gradient-to-b from-base-100 to-base-200">
    <article class="container mx-auto px-6 max-w-3xl">
      <p class="text-sm text-base-content/60 font-bold uppercase tracking-wide mb-3">
        <a href="/" class="link link-hover">Home</a> · Marbella
      </p>
      <h1 class="text-4xl md:text-5xl font-bold text-base-content mt-3 mb-6">
        Web design in Marbella, with fixed prices
      </h1>
      <p class="text-lg text-base-content/70 mb-8">
        We build fast websites for local businesses on the Costa del Sol:
        restaurants, clinics, real estate and services. In Spanish and English,
        with Google Maps positioning included.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body">
            <h2 class="card-title text-lg">Landing page</h2>
            <p class="text-3xl font-black">Free</p>
            <p class="text-sm text-base-content/70">One page, online in less than 7 days.</p>
          </div>
        </div>
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body">
            <h2 class="card-title text-lg">Full website</h2>
            <p class="text-3xl font-black">€690</p>
            <p class="text-sm text-base-content/70">Up to 5 pages, domain and 1 year of hosting.</p>
          </div>
        </div>
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body">
            <h2 class="card-title text-lg">Online shop</h2>
            <p class="text-3xl font-black">€1,290</p>
            <p class="text-sm text-base-content/70">Catalogue, payments and shipping setup.</p>
          </div>
        </div>
      </div>

      <h2 class="text-2xl font-bold mb-4">Why Marbella is different</h2>
      <div class="prose prose-neutral max-w-none mb-12">
        <p>
          Part of your customers search in English («dentist in Marbella»,
          «lawyer Marbella»). Your website and your Google Maps listing need
          English content that ranks on its own — not a machine-translated
          widget. We also prepare your high-season setup before summer:
          bookings, opening hours and updated menus or catalogues.
        </p>
      </div>

      <h2 class="text-2xl font-bold mb-4">Questions, answered</h2>
      <div class="flex flex-col gap-3 mb-12">
        {
          faqs.map((f) => (
            <details class="collapse collapse-arrow bg-base-100 border border-base-300">
              <summary class="collapse-title font-bold">{f.q}</summary>
              <div class="collapse-content text-sm text-base-content/70">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>

      <aside class="card brand-surface shadow-lg border-0">
        <div class="card-body items-center text-center gap-3">
          <p class="text-xl font-bold">Get your free landing page</p>
          <p class="text-sm">
            Fixed quote in writing, no lock-in, everything in your name.
          </p>
          <a
            href={CONTACT.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary mt-1"
          >
            Contact us on LinkedIn
          </a>
        </div>
      </aside>
    </article>
  </main>

  <Footer lang="en" />
</Layout>
