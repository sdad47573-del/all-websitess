---
// On-demand a propósito: la ruta pública `/<slug>/…` (src/pages/[...path].ts)
// reescribe a esta página cuando el slug no es de ningún cliente, y Astro no
// permite reescribir una ruta on-demand a una página prerenderizada
// (ForbiddenRewrite). El resto de rutas desconocidas también acaban aquí.
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Topbar from "../components/Topbar.astro";
import Footer from "../components/Footer.astro";
import { CONTACT } from "../data/contact";
---

<Layout
  title="Página no encontrada | Sur Digital"
  description="La página que buscas no existe o ha cambiado de dirección."
  noindex
>
  <Topbar />

  <main id="contenido"
    class="page-top min-h-[70vh] pb-20 bg-gradient-to-b from-base-100 to-base-200 flex flex-col items-center justify-center text-center px-6"
  >
    <p class="text-8xl font-black text-wave mb-4">404</p>
    <h1 class="text-3xl md:text-4xl font-bold text-base-content mb-4">
      Esta página no existe… <span class="text-wave">todavía</span>
    </h1>
    <p class="text-base-content/70 max-w-md mb-10">
      Si tu negocio no tiene web, este error le pasa a tus clientes cada vez
      que te buscan en Google. Hagamos que no vuelva a ocurrir.
    </p>
    <div class="flex flex-col sm:flex-row gap-3">
      <a href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
        Solicita tu web gratis
      </a>
      <a href="/blog/" class="btn btn-outline btn-lg">Leer el blog</a>
    </div>
  </main>

  <Footer />
</Layout>
