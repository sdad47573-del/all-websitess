---
// Página de contacto con URL propia: los CTA y los artículos del blog ya no
// apuntan a /#contacto.
import Layout from "../layouts/Layout.astro";
import Topbar from "../components/Topbar.astro";
import ContactForm from "../components/ContactForm.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Contacto: hablemos de tu web | Sur Digital"
  description="Cuéntanos qué necesita tu negocio y te respondemos por LinkedIn en menos de 24 horas. Presupuesto cerrado por escrito, sin permanencia."
  path="/contacto/"
>
  <Topbar />

  <main
    id="contenido"
    class="page-top pb-20 bg-gradient-to-b from-base-100 to-base-200"
  >
    <section class="container mx-auto px-6 max-w-3xl text-center mb-2" data-reveal>
      <h1 class="text-4xl md:text-5xl font-bold text-base-content mb-4">
        Contacto
      </h1>
      <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
        Sin formularios largos ni llamadas comerciales: un mensaje con lo que
        necesitas y una respuesta clara en menos de 24 horas.
      </p>
    </section>

    <ContactForm />
  </main>

  <Footer />
</Layout>
