---
// Página de contacto con URL propia: los CTA y los artículos del blog ya no
// apuntan a /#contacto.
import Layout from "../layouts/Layout.astro";
import Topbar from "../components/Topbar.astro";
import ContactForm from "../components/ContactForm.astro";
import Footer from "../components/Footer.astro";
import { LOCALES } from "../data/i18n";
import { ui } from "../i18n/ui";

const t = ui("es");

// Ya existe la misma página en los cinco idiomas.
const translations = LOCALES.map((lang) => ({
  lang,
  path: `/${lang}/contacto/`,
}));
---

<Layout
  title={t.contact.metaTitle}
  description={t.contact.metaDescription}
  path="/contacto/"
  translations={translations}
>
  <Topbar />

  <main
    id="contenido"
    class="page-top pb-20 bg-gradient-to-b from-base-100 to-base-200"
  >
    <section class="container mx-auto px-6 max-w-3xl text-center mb-2" data-reveal>
      <h1 class="text-4xl md:text-5xl font-bold text-base-content mb-4">
        {t.contact.title}
      </h1>
      <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
        {t.contact.lead}
      </p>
    </section>

    <ContactForm />
  </main>

  <Footer />
</Layout>
