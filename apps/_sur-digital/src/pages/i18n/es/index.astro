---
import About from '../../../components/About.astro';
import Calculadora from '../../../components/Calculadora.astro';
import ContactForm from '../../../components/ContactForm.astro';
import Fab from '../../../components/Fab.astro';
import Faq from '../../../components/Faq.astro';
import Footer from '../../../components/Footer.astro';
import Hero4 from '../../../components/Hero4.astro';
import JsonLd from '../../../components/JsonLd.astro';
import MobileCta from '../../../components/MobileCta.astro';
import Portfolio from '../../../components/Portfolio.astro';
import PricingLink from '../../../components/PricingLink.astro';
import SectorsGrid from '../../../components/SectorsGrid.astro';
import Stepper from '../../../components/Stepper.astro';
import Topbar from '../../../components/Topbar.astro';
import TrustSignals from '../../../components/TrustSignals.astro';
import { PORTFOLIO } from '../../../data/portfolio';
import Layout from '../../../layouts/Layout.astro';
---

<Layout
	title="Consultora web en Málaga | Tu web gratis en 7 días"
	description={`Consultora web en Málaga: landing gratis en 7 días, web completa 490 € y tienda 890 €. Precio cerrado por escrito, dominio a tu nombre y sin permanencia.`}
>
	<JsonLd slot="head" />

	<Topbar />
	<main id="contenido">
		<Hero4 />
		<!-- Resumen del proceso antes de enseñar precios: el visitante entiende
		     qué pasa y qué tiene que hacer él (20 minutos el día 1). -->
		<Stepper compact />
		<Portfolio limit={6} />
		<PricingLink />
		<TrustSignals />
		<SectorsGrid />
		<Calculadora />
		<About />
		<ContactForm />
		<Faq />
	</main>
	<Fab />
	<MobileCta />

	<Footer />
</Layout>
