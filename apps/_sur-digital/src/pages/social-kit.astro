---
import Layout from "../layouts/Layout.astro";
import Topbar from "../components/Topbar.astro";
import Footer from "../components/Footer.astro";

// Página interna de trabajo: previsualiza y descarga las tarjetas para redes.
// Noindex + fuera del sitemap (ver astro.config.mjs).

const site = (
  Astro.site?.toString() ?? "https://sur-digital.vercel.app"
).replace(/\/$/, "");

const cards = [
  {
    name: "Home / genérica",
    og: "/og/default.png",
    square: "/og/default.square.png",
    use: "Compartir la home en LinkedIn, Facebook, X y WhatsApp",
  },
  {
    name: "Blog",
    og: "/og/blog.png",
    square: "/og/blog.square.png",
    use: "Enlazar al blog en redes y newsletter",
  },
  {
    name: "Post de lanzamiento",
    og: "/og/blog/lanzamos-sur-digital-oferta.png",
    square: "/og/blog/lanzamos-sur-digital-oferta.square.png",
    use: "Post + historia anunciando la oferta (con la web link en bio/stories)",
  },
  {
    name: "Restaurantes",
    og: "/og/web-para-restaurantes.png",
    square: "/og/web-para-restaurantes.square.png",
    use: "Grupos de Facebook de hostelería, hashtags locales",
  },
  {
    name: "Gimnasios",
    og: "/og/web-para-gimnasios.png",
    square: "/og/web-para-gimnasios.square.png",
    use: "Grupos de emprendedores y deporte local",
  },
  {
    name: "Abogados",
    og: "/og/web-para-abogados.png",
    square: "/og/web-para-abogados.square.png",
    use: "LinkedIn: post profesional dirigido a despachos",
  },
];
---

<Layout
  title="Kit para redes sociales | Sur Digital (interno)"
  description="Tarjetas para compartir el sitio en Instagram, LinkedIn y Facebook."
  path="/social-kit/"
  noindex
>
  <Topbar />

  <main id="contenido" class="page-top pb-20 bg-gradient-to-b from-base-100 to-base-200">
    <div class="container mx-auto px-6 max-w-5xl">
      <p class="text-xs font-black uppercase tracking-widest text-secondary mb-2">
        Interno · no indexado
      </p>
      <h1 class="text-4xl font-bold text-base-content mb-3">Kit para redes sociales</h1>
      <p class="text-base-content/70 max-w-2xl mb-4">
        Cada tarjeta existe en dos formatos: <strong>horizontal 1200×630</strong>
        (la que se muestra automáticamente al pegar el enlace en LinkedIn,
        Facebook, X o WhatsApp) y <strong>cuadrada 1080×1080</strong> para
        publicaciones e historias de Instagram.
      </p>
      <p class="text-sm text-base-content/60 mb-12">
        Consejo: en Instagram el enlace no es clicable — publica la tarjeta y
        pon la URL en la bio o en la historia con el sticker de enlace.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          cards.map((card) => (
            <div class="card bg-base-100 shadow-md border border-base-300">
              <div class="card-body gap-3">
                <p class="font-bold">{card.name}</p>
                <p class="text-sm text-base-content/60">{card.use}</p>

                <div class="grid grid-cols-2 gap-3">
                  <figure>
                    <img
                      src={card.og}
                      alt={`Tarjeta horizontal: ${card.name}`}
                      class="rounded-box border border-base-300 w-full"
                      width="1200"
                      height="630"
                      loading="lazy"
                    />
                    <figcaption class="text-xs text-center text-base-content/50 mt-1">
                      1200×630 · enlaces
                    </figcaption>
                  </figure>
                  <figure>
                    <img
                      src={card.square}
                      alt={`Tarjeta cuadrada: ${card.name}`}
                      class="rounded-box border border-base-300 w-full"
                      width="1080"
                      height="1080"
                      loading="lazy"
                    />
                    <figcaption class="text-xs text-center text-base-content/50 mt-1">
                      1080×1080 · Instagram
                    </figcaption>
                  </figure>
                </div>

                <div class="flex gap-2">
                  <a href={card.og} download class="btn btn-outline btn-xs flex-1">
                    Descargar horizontal
                  </a>
                  <a
                    href={card.square}
                    download
                    class="btn btn-primary btn-xs flex-1"
                  >
                    Descargar cuadrada
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="alert mt-12">
        <span>
          Las URLs para compartir son siempre las canónicas:
          <code>{site}/blog/lanzamos-sur-digital-oferta/</code> etc. Las tarjetas
          horizontales se muestran solas al pegar la URL.
        </span>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
