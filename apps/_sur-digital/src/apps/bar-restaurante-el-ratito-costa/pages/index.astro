---
import '../styles/global.css';

const business = {
	name: 'Bar Restaurante El Ratito Costa',
	short: 'El Ratito Costa',
	street: 'Pago Zahora s/n',
	city: 'Barbate',
	postalCode: '11159',
	phone: '+34 856 36 85 48',
	latitude: 36.2059611,
	longitude: -6.0357796,
	site: 'https://www.sur-digital.com/bar-restaurante-el-ratito-costa',
};

const mapsUrl =
	'https://www.google.com/maps/place/Bar+restaurante+El+Ratito+Costa/@36.2059611,-6.0357796,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c472fd56e62e3:0x57283981e98c210e!8m2!3d36.2059611!4d-6.0357796!16s%2Fg%2F11cm9h0q2b?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const phoneHref = 'tel:+34856368548';

const specialties = [
	{
		kicker: 'De almadraba',
		title: 'Atún y fritura',
		text: 'Pescados del día: atún de almadraba, sardinas, chocos, ortiguillas y fritura crujiente.',
	},
	{
		kicker: 'De la tierra',
		title: 'Retinto a la brasa',
		text: 'Carne de retinto certificada: solomillo, carrillada, albóndigas y parrillada.',
	},
	{
		kicker: 'Para compartir',
		title: 'Brasa y hamburguesas',
		text: 'Parrillada argentina, hamburguesas especiales y cachopo, en raciones generosas.',
	},
	{
		kicker: 'Dulce final',
		title: 'Tartas caseras',
		text: 'Tartas de pistacho, chocolate, queso y zanahoria, milhojas y arroz con leche.',
	},
	{
		kicker: 'En familia',
		title: 'Jardín infantil',
		text: 'Extenso jardín trasero con zonas techadas, campo de fútbol y castillo hinchable.',
	},
	{
		kicker: 'Aviso',
		title: 'Mar–dom 11:30–24',
		text: 'Lunes cerrado, según directorio. Confirma en el 856 36 85 48.',
	},
];

const gallery = [
	{ src: '/bar-restaurante-el-ratito-costa/fotos/jardin.svg', alt: 'Ilustración del jardín — sustituye por foto propia' },
	{ src: '/bar-restaurante-el-ratito-costa/fotos/atun.svg', alt: 'Ilustración del atún — sustituye por foto propia' },
	{ src: '/bar-restaurante-el-ratito-costa/fotos/brasa.svg', alt: 'Ilustración de la brasa — sustituye por foto propia' },
	{ src: '/bar-restaurante-el-ratito-costa/fotos/salon.svg', alt: 'Ilustración del salón — sustituye por foto propia' },
	{ src: '/bar-restaurante-el-ratito-costa/fotos/postre.svg', alt: 'Ilustración de postres — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está El Ratito Costa?',
		a: 'En Pago Zahora s/n, 11159 Barbate (Cádiz), entre Zahora y Los Caños de Meca.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De martes a domingo de 11:30 a 24:00; lunes cerrado, según directorio. Confirma en el 856 36 85 48, sobre todo fuera de temporada.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Cocina gaditana, atún de almadraba y fritura, retinto a la brasa y tartas caseras. Confirma la carta del día en el local.',
	},
	{
		q: '¿Es apto para niños y mascotas?',
		a: 'Sí: jardín con castillo hinchable y campo de fútbol para niños, y terraza trasera donde se admiten perros, según las reseñas.',
	},
	{
		q: '¿Cómo llego?',
		a: 'Por la carretera de Los Caños de Meca (Zahora), con aparcamiento privado amplio. Usa el botón «Cómo llegar» para abrir la ruta en Google Maps.',
	},
];

const description =
	'El Ratito Costa: bar restaurante familiar en Pago Zahora s/n, Barbate. Atún de almadraba, retinto a la brasa y jardín infantil. Mar–dom 11:30–24:00. Tel. 856 36 85 48.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 856 36 85 48',
	image: [`${business.site}/fotos/jardin.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Andaluza', 'Pescados'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:30',
			closes: '24:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Jardín familiar con zona infantil', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento privado', value: true },
	],
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="El Ratito Costa: bar restaurante familiar en Pago Zahora, Barbate. Atún, retinto y jardín infantil. Mar–dom 11:30–24:00. 856 36 85 48." />
		<meta name="keywords" content="El Ratito Costa, comer Zahora, restaurante Caños de Meca, Pago Zahora restaurante, atún Barbate" />
		<meta name="author" content="El Ratito Costa" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/bar-restaurante-el-ratito-costa/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>El Ratito Costa | Bar Restaurante familiar en Zahora</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="El Ratito Costa · Atún y brasa en Zahora" />
		<meta property="og:description" content="Atún de almadraba, retinto a la brasa y jardín familiar en Pago Zahora. Lunes cerrado." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/jardin.svg`} />
		<meta property="og:image:alt" content="El Ratito Costa, Zahora" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="El Ratito Costa · Bar Restaurante en Zahora" />
		<meta name="twitter:description" content="Pago Zahora: atún, retinto y jardín infantil." />
		<meta name="twitter:image" content={`${business.site}/fotos/jardin.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Barbate" />
		<meta name="geo.position" content="36.2059611;-6.0357796" />
		<meta name="ICBM" content="36.2059611, -6.0357796" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="El Ratito Costa, inicio">
				<span class="brand-mark" aria-hidden="true">RC</span>
				<span class="brand-name">El Ratito Costa <small>Zahora · Barbate</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">El restaurante</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>856 36 85 48</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Pago Zahora · Barbate</p>
					<h1 id="hero-title">Atún y brasa<br />en <em>familia.</em></h1>
					<p class="hero-lede">
						Bar restaurante entre Zahora y Caños de Meca, con jardín trasero,
						parque infantil y cocina gaditana de atún y retinto.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 856 36 85 48</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>11:30–24</b> mar–dom</li>
						<li><b>Lun</b> cerrado</li>
						<li>Jardín familiar</li>
						<li>Parking propio</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/bar-restaurante-el-ratito-costa/fotos/jardin.svg" alt="Ilustración del jardín de El Ratito Costa, Zahora" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Pago Zahora · Barbate</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>11:30–24</b><span>Mar–dom</span></div>
					<div><b>Lun</b><span>Cerrado</span></div>
					<div><b>8,4</b><span>Directorio local</span></div>
				</div>
				<ul class="services">
					<li>Atún</li>
					<li>Retinto</li>
					<li>Jardín</li>
					<li>Infantil</li>
					<li>Mascotas</li>
					<li>Parking</li>
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> El restaurante</p>
				<div class="about-grid">
					<h2>Un ratito<br />que <em>cunde.</em></h2>
					<div class="about-copy">
						<p>
							El Ratito Costa está en Pago Zahora s/n (11159 Barbate),
							con coordenadas 36.2059611, -6.0357796, junto a las playas
							de Zahora y Los Caños de Meca.
						</p>
						<p>
							Local con terraza de entrada, salón interior con barra y cocina a la vista,
							y un gran jardín trasero con zonas techadas, campo de fútbol y castillo
							hinchable gratuito para los más pequeños.
						</p>
						<p class="about-note">
							Mar–dom 11:30–24:00; lunes cerrado, según directorio. Confirma en el
							856 36 85 48, sobre todo fuera de temporada, y reserva en verano.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales según su ficha pública: gaditana, brasa y caseras.
						Confirma la carta del día en el propio local.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El jardín<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del restaurante.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Pago Zahora s/n</p>
					<h2>Ven al jardín<br /><em>a comer.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Martes a domingo</th>
								<td>11:30 – 24:00</td>
							</tr>
							<tr>
								<th scope="row">Lunes</th>
								<td>Cerrado</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Según directorio. Confirma en el 856 36 85 48 antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al restaurante ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 856 36 85 48</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de El Ratito Costa en Pago Zahora, Barbate" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> El Ratito Costa · Zahora</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">RC</span>
				<p>El Ratito Costa<small>{business.street} · {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} El Ratito Costa · Zahora. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/bar-restaurante-el-ratito-costa/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/bar-restaurante-el-ratito-costa/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/bar-restaurante-el-ratito-costa/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>856 36 85 48</span></a>
	</body>
</html>
