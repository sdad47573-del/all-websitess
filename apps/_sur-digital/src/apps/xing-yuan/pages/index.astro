---
import '../styles/global.css';
import { BUSINESS, FAQ, GALERIA, HORARIO_NOTA, MAPS, PLATOS } from '../data/site';

const title = 'Xing Yuan · cocina mandarina en Abando, Bilbao';
const description = BUSINESS.description;
const hero = GALERIA[0];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: 'Xing Yuan 兴源食府',
	description,
	url: `${BUSINESS.siteUrl}/`,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	telephone: BUSINESS.phoneHref,
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina mandarina', 'Cocina china'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: { '@type': 'GeoCoordinates', latitude: 43.2584583, longitude: -2.9331427 },
	hasMap: MAPS.place,
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La mesa', href: '#mesa' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Visita', href: '#visita' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#123c36" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="Xing Yuan Bilbao, restaurante chino Abando, cocina mandarina Bilbao, Fernández del Campo 6, comer chino Bilbao, tallarines salteados Bilbao" />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${BUSINESS.siteUrl}/`} />
		<link rel="icon" type="image/svg+xml" href="/xing-yuan/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Mulish:wght@400;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<link rel="preload" as="image" href="/xing-yuan/fotos/xing-yuan-01.jpg" />
		<meta property="og:type" content="restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={BUSINESS.name} />
		<meta property="og:title" content="Xing Yuan · cocina mandarina en Abando, Bilbao" />
		<meta property="og:description" content="Cocina mandarina en Fernández del Campo, 6 (Abando, Bilbao). Fideos y tallarines salteados, gamba rebozada, sopa agripicante y rollitos. Teléfono 944 71 95 17." />
		<meta property="og:url" content={`${BUSINESS.siteUrl}/`} />
		<meta property="og:image" content={`${BUSINESS.siteUrl}/og.jpg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Fachada de Xing Yuan en Bilbao" />
		<meta property="place:location:latitude" content="43.2584583" />
		<meta property="place:location:longitude" content="-2.9331427" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Xing Yuan · cocina mandarina en Bilbao" />
		<meta name="twitter:description" content="Cocina mandarina en Abando, Bilbao. Fideos, gamba rebozada y sopa agripicante." />
		<meta name="twitter:image" content={`${BUSINESS.siteUrl}/og.jpg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="wrap topbar-inner">
				<a class="brand" href="#inicio" aria-label="Xing Yuan, inicio">
					<span class="brand-mark" aria-hidden="true">X</span>
					<span class="brand-name">Xing Yuan <small>Cocina mandarina · Abando</small></span>
				</a>
				<nav aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-phone" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero wrap" id="inicio" aria-labelledby="hero-title">
				<div>
					<p class="eyebrow"><span aria-hidden="true"></span> Abando · Bilbao · Cocina mandarina</p>
					<h1 id="hero-title">Cocina mandarina<br /><em>en Abando.</em></h1>
					<p class="hero-lede">
						Xing Yuan es un restaurante de cocina mandarina en Fernández del Campo, 6, en pleno
						barrio de Abando. Fideos y tallarines al wok, gamba rebozada, sopa agripicante y
						rollitos, en un comedor con servicio en sala.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href={BUSINESS.phoneHref}>Llamar al {BUSINESS.phone}</a>
						<a class="button button-ghost" href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>{BUSINESS.street}</b>48010 Bilbao · Abando</li>
						<li><b>Cocina mandarina</b>Según su ficha de Google</li>
						<li><b>{BUSINESS.phone}</b>Teléfono del local</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<span class="hero-tag">Abando · 兴源食府</span>
					<img
						src={hero.src}
						width={hero.w}
						height={hero.h}
						alt={hero.alt}
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Fachada en Fernández del Campo, 6</span>
						<a href={MAPS.place} target="_blank" rel="noreferrer">Ver ficha ↗</a>
					</figcaption>
				</figure>
			</section>

			<div class="wrap">
				<ul class="chips" aria-label="Resumen del local">
					<li>Cocina mandarina</li>
					<li>Abando</li>
					<li>Bilbao · 48010</li>
					<li>Comedor</li>
					<li>Teléfono directo</li>
				</ul>
			</div>

			<section class="about wrap" id="casa" aria-labelledby="casa-title">
				<div class="about-grid">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> La casa</p>
						<h2 id="casa-title">Un chino de barrio<br />con <em>nombre propio.</em></h2>
					</div>
					<div class="about-copy">
						<p>
							Xing Yuan (兴源食府) ocupa el número 6 de Fernández del Campo, en Abando, a un paso
							del centro de Bilbao. Su ficha de Google lo clasifica como restaurante de cocina
							mandarina.
						</p>
						<p>
							En las fotos de su perfil se ve un comedor amplio, con barra al fondo y mesas
							vestidas de blanco, además de un robot camarero que reparte las bandejas entre
							las mesas. En la mesa aparecen fideos y tallarines salteados, gamba rebozada,
							sopa agripicante, rollitos y berenjena en salsa.
						</p>
						<p class="about-note">
							No publicamos horario ni carta porque no están verificados en la ficha pública:
							llama al {BUSINESS.phone} o consulta su ficha de Google antes de ir.
						</p>
						<div class="about-links">
							<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">Ficha en Google Maps ↗</a>
							<a class="simple-link" href="#mesa">Qué se ve en la mesa</a>
						</div>
					</div>
				</div>
			</section>

			<section class="highlight-strip" aria-labelledby="claves-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Tres cosas claras</p>
					<h2 id="claves-title">Cocina del norte de China,<br /><em>servida en sala.</em></h2>
					<ul class="highlights">
						<li>
							<span class="highlight-mark">01 · La cocina</span>
							<h3>Mandarina, al wok</h3>
							<p>Fideos, tallarines y salteados con verdura; gamba rebozada y sopa agripicante entre las fotos de la ficha.</p>
						</li>
						<li>
							<span class="highlight-mark">02 · El local</span>
							<h3>Comedor para sentarse</h3>
							<p>Mesas vestidas, barra al fondo y servicio en sala, con un robot camarero que lleva los platos.</p>
						</li>
						<li class="highlight-wide">
							<span class="highlight-mark">03 · La dirección</span>
							<h3>Fernández del Campo, 6 · Abando</h3>
							<p>En el 48010 de Bilbao, con la boca de metro de Abando y el centro a un paseo. Teléfono directo del local: {BUSINESS.phone}.</p>
						</li>
					</ul>
				</div>
			</section>

			<section class="menu" id="mesa" aria-labelledby="mesa-title">
				<div class="wrap">
					<div class="menu-head">
						<div>
							<p class="section-label"><span aria-hidden="true"></span> Lo que se ve en la mesa</p>
							<h2 id="mesa-title">Platos de la casa,<br /><em>sin precios inventados.</em></h2>
						</div>
						<div>
							<p>
								Estos platos son los que aparecen en las fotos del perfil del restaurante. No
								publicamos precios ni una carta cerrada porque no están verificados: pídelos en
								el local o consúltalos en su ficha.
							</p>
							<a class="button button-primary" href={MAPS.place} target="_blank" rel="noreferrer">Ver la ficha en Google ↗</a>
						</div>
					</div>

					<div class="menu-groups">
						{
							[
								{ titulo: 'Al wok', platos: PLATOS.slice(0, 3) },
								{ titulo: 'Fritos y sopa', platos: PLATOS.slice(3) },
							].map((grupo) => (
								<div class="menu-group">
									<h3>{grupo.titulo}</h3>
									<ul class="dishes">
										{grupo.platos.map((plato) => (
											<li>
												<span class="dish">
													{plato.nombre}
													<em>{plato.nota}</em>
												</span>
											</li>
										))}
									</ul>
								</div>
							))
						}
					</div>

					<p class="menu-note">
						La carta puede cambiar según el día y la temporada. Si buscas un plato concreto,
						llama al <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a> y pregunta antes de ir.
					</p>
				</div>
			</section>

			<section class="wrap section-pad" id="fotos" aria-labelledby="fotos-title">
				<div class="gallery-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Fotos de la ficha</p>
						<h2 id="fotos-title">La fachada, el comedor<br /><em>y lo que sale.</em></h2>
					</div>
					<div>
						<p>
							Ocho fotos del perfil público del restaurante en Google Maps: la puerta en
							Fernández del Campo, la sala y varios platos.
						</p>
						<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">Galería completa en Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						GALERIA.map((foto) => (
							<figure class="shot">
								<img src={foto.src} alt={foto.alt} width={foto.w} height={foto.h} loading="lazy" decoding="async" />
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías del perfil del establecimiento en Google Maps. Los platos y el montaje
					pueden variar respecto a la foto.
				</p>
			</section>

			<section class="visit" id="visita" aria-labelledby="visita-title">
				<div class="wrap visit-grid">
					<div>
						<p class="section-label section-label-light"><span aria-hidden="true"></span> Visita</p>
						<h2 id="visita-title">Fernández del Campo, 6<br /><em>Abando.</em></h2>
						<p class="address">
							{BUSINESS.street}<br />
							{BUSINESS.postalCode} {BUSINESS.city} · {BUSINESS.region}
						</p>

						<table class="hours">
							<caption>Horario</caption>
							<tbody>
								<tr>
									<th scope="row">Horario publicado</th>
									<td>No disponible</td>
								</tr>
								<tr>
									<th scope="row">Teléfono</th>
									<td><a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a></td>
								</tr>
							</tbody>
						</table>
						<p class="hours-note">
							{HORARIO_NOTA} <a href={MAPS.place} target="_blank" rel="noreferrer">Abrir la ficha ↗</a>
						</p>

						<div class="visit-links">
							<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
							<a class="button button-ghost" href={BUSINESS.phoneHref}>Llamar</a>
						</div>
						<a class="phone-link" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
						<p class="reserve-note">
							No hacemos reservas desde esta web: el teléfono y la ficha de Google son los
							canales del restaurante.
						</p>
					</div>

					<div>
						<div class="map-frame">
							<iframe
								src={MAPS.embed}
								title={`Mapa de ${BUSINESS.name}, ${BUSINESS.street}, ${BUSINESS.city}`}
								loading="lazy"
								allowfullscreen
								referrerpolicy="no-referrer-when-downgrade"></iframe>
						</div>
						<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
							<span aria-hidden="true">⌖</span> Xing Yuan · Abando, Bilbao
						</a>
					</div>
				</div>
			</section>

			<section class="wrap faq section-pad" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						FAQ.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap footer-grid">
				<div class="footer-brand">
					<span class="brand-mark" aria-hidden="true">X</span>
					<p>
						Xing Yuan
						<small>{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}</small>
					</p>
				</div>
				<nav aria-label="Enlaces del restaurante">
					<a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
					<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
					<a href="/xing-yuan/aviso-legal">Aviso legal</a>
				</nav>
				<small class="legal">
					© {new Date().getFullYear()} Xing Yuan · Abando, Bilbao. Fotografías del perfil público
					del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas:
					confirma horario y carta antes de la visita.
					<nav class="legal-links" aria-label="Información legal">
						<a href="/xing-yuan/aviso-legal">Aviso legal</a>
						<a href="/xing-yuan/aviso-legal#privacidad">Privacidad</a>
						<a href="/xing-yuan/aviso-legal#cookies">Cookies</a>
					</nav>
					<span class="credit">Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></span>
				</small>
			</div>
		</footer>

		<a class="mobile-call" href={BUSINESS.phoneHref}>Llamar <span>{BUSINESS.phone}</span></a>
	</body>
</html>
