---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/panaria-panoramica-01.jpg';
import mesaDulces from '../assets/fotos/panaria-apaisada-02.jpg';
import comedor from '../assets/fotos/panaria-apaisada-03.jpg';
import cafeNata from '../assets/fotos/panaria-apaisada-04.jpg';
import desayuno from '../assets/fotos/panaria-apaisada-05.jpg';
import barra from '../assets/fotos/panaria-apaisada-07.jpg';
import vitrina from '../assets/fotos/panaria-apaisada-09.jpg';
import calle from '../assets/fotos/panaria-vertical-06.jpg';
import entrada from '../assets/fotos/panaria-vertical-08.jpg';
import tartaQueso from '../assets/fotos/panaria-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Panaria · panadería-cafetería con tartas y zumos en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: desayuno,
		alt: 'Bandeja con tostada de jamón y tomate cherry, bol de aguacate y pollo, zumo de naranja y café',
	},
	{
		src: vitrina,
		alt: 'Vitrina de tartas de Panaria con tarta de zanahoria, queso, crumble y brownie',
	},
	{
		src: tartaQueso,
		alt: 'Porción de tarta de queso en un táper de plástico para llevar',
	},
	{
		src: cafeNata,
		alt: 'Café con nata en vaso de cristal con canela, sobre un sobre de azúcar de Panaria',
	},
	{
		src: mesaDulces,
		alt: 'Mesa con café con leche, donuts glaseados y de chocolate, croissant de jamón y virutas',
	},
	{
		src: barra,
		alt: 'Barra de Panaria con la máquina de café, neveras, estanterías y lámparas negras',
	},
	{
		src: comedor,
		alt: 'Comedor de Panaria con mesas de madera, sillas Thonet, bancos corridos y lámparas colgantes',
	},
	{
		src: fachada,
		alt: 'Fachada de Panaria en la calle de Alarcos, con el rótulo blanco y la puerta de cristal abierta',
	},
	{
		src: calle,
		alt: 'Entrada de Panaria desde la acera de losetas rojas y blancas, con la pizarra de desayunos',
	},
	{
		src: entrada,
		alt: 'Puerta y escaparate de Panaria con el vinilo de la marca y la pizarra en la calle',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'CafeOrCoffeeShop',
	'@id': `${BUSINESS.siteUrl}/#panaria-alarcos`,
	name: BUSINESS.name,
	alternateName: ['Panaria Ciudad Real', 'Panaria Alarcos', 'Panaria calle de Alarcos'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	currenciesAccepted: 'EUR',
	servesCuisine: ['Desayunos', 'Brunch', 'Bollería', 'Tartas', 'Bocadillos', 'Café'],
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.channel },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Entrada adaptada', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Servicio de catering', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"panaria-apaisada-05.jpg": desayuno,
	"panaria-apaisada-09.jpg": vitrina,
	"panaria-vertical-10.jpg": tartaQueso,
	"panaria-apaisada-04.jpg": cafeNata,
	"panaria-apaisada-02.jpg": mesaDulces,
	"panaria-apaisada-07.jpg": barra,
	"panaria-apaisada-03.jpg": comedor,
	"panaria-panoramica-01.jpg": fachada,
	"panaria-vertical-06.jpg": calle,
	"panaria-vertical-08.jpg": entrada,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#101a2b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panaria Ciudad Real, panadería cafetería calle de Alarcos, desayunos Ciudad Real, tartas Ciudad Real, bollería Ciudad Real, brunch Ciudad Real, bocadillos y ensaladas centro Ciudad Real, café para llevar 13001"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería-cafetería en la calle de Alarcos, 3, de Ciudad Real. Desayunos, bollería, tartas en vitrina, bocadillos, ensaladas y zumos. 3,8 sobre 5 con 621 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bandeja de desayuno de Panaria con tostada de jamón y bol de aguacate"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#101a2b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[desayuno]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/panaria/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Panadería-cafetería en Alarcos"
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta en el local."
			ctaLabel="Cómo llegar"
			navAriaLabel="Enlaces de Panaria en la calle de Alarcos"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	</body>
</html>
