---
import { Image } from 'astro:assets';
import foto01 from '../assets/fotos/la-nueva-perola-apaisada-01.jpg';
import foto02 from '../assets/fotos/la-nueva-perola-vertical-02.jpg';
import foto03 from '../assets/fotos/la-nueva-perola-vertical-03.jpg';
import foto04 from '../assets/fotos/la-nueva-perola-vertical-04.jpg';
import foto05 from '../assets/fotos/la-nueva-perola-vertical-05.jpg';
import foto06 from '../assets/fotos/la-nueva-perola-vertical-06.jpg';
import foto07 from '../assets/fotos/la-nueva-perola-vertical-07.jpg';

const fotos = [foto01, foto02, foto03, foto04, foto05, foto06, foto07];

const MAPS_URL =
	'https://www.google.com/maps/place/La+Nueva+Perola/@37.9876598,-1.1210245,17z/data=!3m1!4b1!4m6!3m5!1s0xd638342e9665679:0x93fb192ce05a8470!8m2!3d37.9876598!4d-1.1210245!16s%2Fg%2F11jgms0smr?authuser=0&hl=es&entry=ttu';
const CREDIT_URL = 'https://www.sur-digital.com/';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>La Nueva Perola</title>
		<meta name="description" content="La Nueva Perola." />
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"@id": "https://www.sur-digital.com/la-nueva-perola/#negocio",
	"name": "La nueva perola",
	"url": "https://www.sur-digital.com/la-nueva-perola/",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 37.9876598,
		"longitude": -1.1210245
	},
	"hasMap": "https://www.google.com/maps/place/La+Nueva+Perola/@37.9876598,-1.1210245,17z/data=!3m1!4b1!4m6!3m5!1s0xd638342e9665679:0x93fb192ce05a8470!8m2!3d37.9876598!4d-1.1210245!16s%2Fg%2F11jgms0smr?authuser=0&hl=es&entry=ttu"
}
</script>
		<meta property="og:image" content="https://www.sur-digital.com/la-nueva-perola/og.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta property="og:url" content="https://www.sur-digital.com/la-nueva-perola/" />
		<meta property="og:locale" content="es_ES" />
			<meta property="og:title" content="La Nueva Perola" />
		<meta property="og:description" content="La Nueva Perola." />
	</head>
	<body>
		<header>
			<h1 set:html={piezas.portada.titulo} />
			<a href={MAPS_URL} rel="noopener" target="_blank">Ver en Google Maps</a>
		</header>

		<main>
			<section class="galeria">
				{fotos.map((foto) => <Image src={foto} alt="La Nueva Perola" loading="lazy" />)}
			</section>
		</main>

		<footer>
			<p>
				Creado por <a href={CREDIT_URL} rel="noopener">Sur Digital</a>
			</p>
		</footer>
	</body>
</html>
