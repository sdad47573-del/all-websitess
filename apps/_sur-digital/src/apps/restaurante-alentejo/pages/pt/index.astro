---
import '../../styles/global.css';
import Portada from '../../components/Portada.astro';
import { addressLine, business, faqSchema, restaurantSchema, site } from '../../data/site';
import { textos } from '../../data/textos';

/** Portada en portugués (pt-PT). La española vive en la raíz y comparte la misma plantilla. */
const lang = 'pt' as const;
const t = textos[lang];

const url = `${site.siteUrl}/pt/`;
const alternates = [
	{ hreflang: 'es', href: `${site.siteUrl}/` },
	{ hreflang: 'pt', href: `${site.siteUrl}/pt/` },
	{ hreflang: 'x-default', href: `${site.siteUrl}/` },
];
---

<!doctype html>
<html lang="pt">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#241a16" />
		<meta name="description" content={t.description} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content={business.country} />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={url} />
		{alternates.map((alt) => (
			<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
		))}
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/restaurante-alentejo/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{t.title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content={t.locale} />
		<meta property="og:locale:alternate" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={t.title} />
		<meta property="og:description" content={t.description} />
		<meta property="og:url" content={url} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t.ogAlt} />
		<meta property="og:street-address" content={addressLine} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:country-name" content={business.countryName} />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={t.title} />
		<meta name="twitter:description" content={t.description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={t.ogAlt} />
		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(restaurantSchema(lang, t))}
		/>
		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(faqSchema(lang, t.faq.items))}
		/>
	</head>
	<body>
		<Portada lang={lang} t={t} />
	</body>
</html>
