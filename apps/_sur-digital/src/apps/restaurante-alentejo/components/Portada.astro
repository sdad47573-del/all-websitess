---
/**
 * Cuerpo de la portada, escrito una sola vez para los dos idiomas.
 *
 * Recibe el idioma y su diccionario de textos desde la página (`/` o `/pt/`), que es la que lleva el
 * `<head>` con el título, la descripción, el canónico, el hreflang y los datos estructurados.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	addressLine,
	business,
	directionsUrl,
	hours,
	localeIntl,
	mapEmbedUrl,
	mapsUrl,
	otraVersion,
	phoneHref,
	prefijo,
	reviewsUrl,
	site,
	type Idioma,
} from '../data/site';
import type { Textos } from '../data/textos';

type Props = { lang: Idioma; t: Textos };
const { lang, t } = Astro.props;

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

/** Las diez fotografías de la ficha, en el orden en que se descargaron. */
const galeria = [
	'restaurante-alentejo-panoramica-01.jpg',
	'restaurante-alentejo-vertical-02.jpg',
	'restaurante-alentejo-apaisada-03.jpg',
	'restaurante-alentejo-apaisada-04.jpg',
	'restaurante-alentejo-apaisada-05.jpg',
	'restaurante-alentejo-apaisada-06.jpg',
	'restaurante-alentejo-apaisada-07.jpg',
	'restaurante-alentejo-vertical-08.jpg',
	'restaurante-alentejo-vertical-09.jpg',
	'restaurante-alentejo-vertical-10.jpg',
];

/**
 * Tres fotos de avance en el collage (también están en la galería).
 *
 * La ficha trae **una panorámica** (1984 × 960), cinco apaisadas y cuatro verticales, así que arriba
 * va la panorámica 01, que encaja en el hueco ancho sin recorte apreciable, y abajo la apaisada 05
 * (16:9) con la vertical 09.
 */
const collage = [
	{ name: 'restaurante-alentejo-panoramica-01.jpg', clase: 'collage-item collage-item-a' },
	{ name: 'restaurante-alentejo-apaisada-05.jpg', clase: 'collage-item collage-item-b' },
	{ name: 'restaurante-alentejo-vertical-09.jpg', clase: 'collage-item collage-item-c' },
];

/** Números y horas con el formato del idioma de la página. */
const numero = (valor: number) => valor.toLocaleString(localeIntl(lang));
const sinCero = (hora: string) => hora.replace(/^0/, '');
const servicio = (shifts: readonly { open: string; close: string }[]) =>
	shifts.length ? shifts.map((s) => `${sinCero(s.open)} – ${sinCero(s.close)}`).join(' · ') : t.cerrado;

const reseñas = `${numero(business.reviewCount)} ${t.banda.resenas}`;
const valoracion = `${numero(business.rating)} / 5`;
const numeroFotos = galeria.length;
const rutaLegal = `${prefijo(lang)}/aviso-legal`;
---

<a class="skip-link" href="#contenido">{t.skipLink}</a>

<header class="topbar">
	<a class="brand" href="#inicio" aria-label={`${business.name}, ${t.navLabel}`}>
		<span class="brand-mark" aria-hidden="true">A</span>
		<span class="brand-text">
			{business.name}
			<small>{t.brandSub}</small>
		</span>
	</a>
	<nav aria-label={t.navLabel}>
		{t.nav.map((item) => <a href={item.href}>{item.label}</a>)}
	</nav>
	<div class="topbar-actions">
		<a class="lang-switch" href={otraVersion(lang, 'inicio')} hreflang={lang === 'es' ? 'pt' : 'es'}>
			<span class="bandera" aria-hidden="true">{lang === 'es' ? '🇵🇹' : '🇪🇸'}</span>
			{t.otroIdioma}
		</a>
		<a class="topbar-cta" href={phoneHref}>
			<span aria-hidden="true">☎</span>
			{t.navCta}
		</a>
	</div>
</header>

<main id="contenido">
	<section class="hero" id="inicio" aria-labelledby="hero-title">
		<div class="hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">{t.hero.eyebrow}</p>
				<h1 id="hero-title">
					{t.hero.tituloA}
					<br />
					<em>{t.hero.tituloB}</em>
				</h1>
				<p class="hero-lede">
					{t.hero.ledeA} {numero(business.rating)} {t.hero.ledeB}
				</p>
				<div class="hero-actions">
					<a class="btn btn-solid" href={phoneHref}>
						{t.llamar} {business.phone}
					</a>
					<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
						{t.hero.ctaSecundaria} <span aria-hidden="true">↗</span>
					</a>
				</div>
				<ul class="hero-facts">
					<li>
						<small>{t.hero.datos.direccion}</small>
						<strong>{addressLine}</strong>
					</li>
					<li>
						<small>{t.hero.datos.horario}</small>
						<strong>{t.horarioResumen}</strong>
					</li>
					<li>
						<small>{t.hero.datos.telefono}</small>
						<strong>{business.phone}</strong>
					</li>
					<li>
						<small>{t.hero.datos.valoracion}</small>
						<strong>{valoracion} · {reseñas}</strong>
					</li>
				</ul>
			</div>

			<div class="hero-collage">
				{collage.map((item, index) => (
					<figure class={item.clase}>
						<Image
							src={foto(item.name)}
							alt={t.altFoto}
							widths={index === 0 ? [640, 900, 1200] : [320, 480, 640]}
							sizes={
								index === 0 ? '(max-width: 1080px) 92vw, 46vw' : '(max-width: 1080px) 45vw, 23vw'
							}
							format="webp"
							quality={68}
							loading={index === 0 ? 'eager' : 'lazy'}
							fetchpriority={index === 0 ? 'high' : undefined}
							decoding="async"
						/>
					</figure>
				))}
			</div>
		</div>
	</section>

	<div class="band">
		<span>{valoracion} · {reseñas}</span>
		<span>{addressLine}</span>
		<span>{t.horarioResumen}</span>
		<span>{t.banda.telefono} {business.phone}</span>
	</div>

	<section class="section" id="local" aria-labelledby="local-title">
		<div class="wrap bar-grid">
			<div class="bar-text">
				<p class="kicker">{t.local.kicker}</p>
				<h2 class="title" id="local-title">
					{t.local.tituloA}
					<br />
					<em>{t.local.tituloB}</em>
				</h2>
				<p>{t.local.p1}</p>
				<p>{t.local.p2}</p>
				<p>{t.local.p3}</p>
			</div>
			<div class="quote-row">
				<div class="quote-score">
					<strong>{valoracion}</strong>
					<span>{reseñas} · Google Maps</span>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						{lang === 'es' ? 'Ver todas' : 'Ver todas'} <span aria-hidden="true">↗</span>
					</a>
				</div>
				<p class="quote-note">{t.sinResenas}</p>
			</div>
		</div>
	</section>

	<section class="section palabras" id="fotos" aria-labelledby="fotos-title">
		<div class="wrap">
			<p class="kicker">{t.fotos.kicker}</p>
			<h2 class="title" id="fotos-title">
				{t.fotos.tituloA}
				<em>{t.fotos.tituloB}</em>
			</h2>
			<p class="lead">
				{t.fotos.leadA} {numeroFotos} {t.fotos.leadB}
			</p>
			<div class="cocina-grid">
				{galeria.map((name) => (
					<figure class="cocina-item">
						<Image
							src={foto(name)}
							alt={t.altFoto}
							widths={[380, 560, 800]}
							sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
							format="webp"
							quality={68}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>{t.credito}</figcaption>
					</figure>
				))}
			</div>
			<p class="cocina-note">
				{t.fotos.nota}{' '}
				<a href={phoneHref}>{t.fotos.notaTelefono} {business.phone}</a>{' '}
				<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
					{t.fotos.notaMaps} <span aria-hidden="true">↗</span>
				</a>
			</p>
		</div>
	</section>

	<section class="section" id="horario" aria-labelledby="horario-title">
		<div class="wrap horario-grid">
			<div>
				<p class="kicker">{t.horario.kicker}</p>
				<h2 class="title" id="horario-title">
					{t.horario.tituloA}
					<br />
					<em>{t.horario.tituloB}</em>
				</h2>
				<address>
					{business.streetAddress}
					<br />
					{business.city} · {business.region}
					<br />
					{business.countryName}
				</address>
				<table class="hours-table">
					<caption>{t.horario.caption}</caption>
					<tbody>
						{hours.map((item) => (
							<tr class:list={[{ 'is-closed': item.shifts.length === 0 }]}>
								<th scope="row">{t.dias[item.dayOfWeek]}</th>
								<td>{servicio(item.shifts)}</td>
							</tr>
						))}
					</tbody>
				</table>
				<p class="hours-note">{t.horario.nota}</p>
				<p class="access-note">{t.horario.accesibilidadTitulo}</p>
				<ul class="access-list">
					{accesibilidad.map((item) => (
						<li class:list={[{ 'is-no': !item.disponible }]}>{t.accesibilidad[item.key]}</li>
					))}
				</ul>
				<a class="contact-line" href={phoneHref}>
					<small>{t.horario.telefonoTitulo}</small>
					<strong>{business.phone}</strong>
				</a>
				<div class="place-actions">
					<a
						class="btn btn-solid"
						href={directionsUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						{t.horario.acciones.indicaciones} <span aria-hidden="true">↗</span>
					</a>
					<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
						{t.horario.acciones.ficha} <span aria-hidden="true">↗</span>
					</a>
				</div>
			</div>
			<div class="map-card">
				<iframe
					title={`${t.horario.mapaTitulo}: ${business.name}, ${business.city}`}
					src={mapEmbedUrl}
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
					allowfullscreen></iframe>
				<div class="map-tag">
					<div>
						<strong>{business.shortName}</strong>
						<small>{addressLine}</small>
					</div>
					<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
						{t.horario.acciones.indicaciones} <span aria-hidden="true">↗</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section faq" id="preguntas" aria-labelledby="faq-title">
		<div class="wrap">
			<p class="kicker">{t.faq.kicker}</p>
			<h2 class="title" id="faq-title">
				{t.faq.tituloA} <em>{t.faq.tituloB}</em>
			</h2>
			<div class="faq-list">
				{t.faq.items.map((faq) => (
					<details>
						<summary>{faq.q}</summary>
						<p>{faq.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>
</main>

<footer class="site-footer">
	<div class="footer-top">
		<a class="footer-brand" href="#inicio" aria-label={`${business.name}, ${t.navLabel}`}>
			<span class="brand-mark" aria-hidden="true">A</span>
			<span>
				{business.name}
				<small>{addressLine}</small>
			</span>
		</a>
		<nav class="footer-nav" aria-label={t.footer.navLabel}>
			<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
				{t.footer.indicaciones} <span aria-hidden="true">↗</span>
			</a>
			<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
				{t.footer.ficha} <span aria-hidden="true">↗</span>
			</a>
			<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
				{t.footer.resenas} <span aria-hidden="true">↗</span>
			</a>
			<a href={otraVersion(lang, 'inicio')} hreflang={lang === 'es' ? 'pt' : 'es'}>
				{t.otroIdioma}
			</a>
		</nav>
		<small class="footer-note">
			© {new Date().getFullYear()} {business.name} · {addressLine}. {t.footer.nota}{' '}
			{site.consultado}. {t.footer.notaFin}
		</small>
	</div>
	<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
	<a href="/restaurante-alentejo/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
	<a href="/restaurante-alentejo/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
	<a href="/restaurante-alentejo/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
</nav>
</footer>


<a class="mobile-call" href={phoneHref}>
	{t.llamar} {business.shortName} <span>{business.phone}</span>
</a>
