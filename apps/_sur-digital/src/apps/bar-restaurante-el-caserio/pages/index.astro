---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import terraza from '../assets/fotos/bar-restaurante-el-caserio-apaisada-01.jpg';
import bravas from '../assets/fotos/bar-restaurante-el-caserio-apaisada-02.jpg';
import merluza from '../assets/fotos/bar-restaurante-el-caserio-apaisada-03.jpg';
import codillo from '../assets/fotos/bar-restaurante-el-caserio-apaisada-04.jpg';
import mariscada from '../assets/fotos/bar-restaurante-el-caserio-vertical-05.jpg';
import sopa from '../assets/fotos/bar-restaurante-el-caserio-vertical-06.jpg';
import tartaQueso from '../assets/fotos/bar-restaurante-el-caserio-vertical-07.jpg';
import bacalao from '../assets/fotos/bar-restaurante-el-caserio-apaisada-08.jpg';
import tartaChocolate from '../assets/fotos/bar-restaurante-el-caserio-apaisada-09.jpg';
import bravasDetalle from '../assets/fotos/bar-restaurante-el-caserio-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Bar Restaurante El Caserío, en Euskadi Etorbidea 23 (20110 Trintxerpe, Pasaia). Menú del día, mariscada, txuleta y postres caseros, con terraza. 4,1 sobre 5 y teléfono 943 39 38 87.';

const title = 'Bar Restaurante El Caserío · Menú del día en Trintxerpe';

const galeria = [
	{
		src: terraza,
		alt: 'Terraza cubierta del Bar Restaurante El Caserío con mesas y sillas junto a un edificio de ladrillo en Trintxerpe',
	},
	{
		src: mariscada,
		alt: 'Mariscada con langostinos, cigalas, almejas, navajas y vieiras en una bandeja metálica',
	},
	{
		src: bravas,
		alt: 'Patatas bravas con alioli y pimentón servidas en una pizarra en El Caserío',
	},
	{
		src: merluza,
		alt: 'Merluza a la plancha con patatas cocidas, ajo y perejil en un plato del restaurante',
	},
	{
		src: codillo,
		alt: 'Codillo asado con salsa y patatas fritas en un plato del restaurante',
	},
	{
		src: bacalao,
		alt: 'Bacalao en salsa roja con perejil picado en un plato de El Caserío',
	},
	{
		src: sopa,
		alt: 'Sopa de pescado servida en un plato hondo con un trozo de pan al lado',
	},
	{
		src: tartaQueso,
		alt: 'Porción de tarta de queso con nata y sirope en un plato',
	},
	{
		src: tartaChocolate,
		alt: 'Tarta de chocolate con nata y sirope de chocolate en un plato',
	},
	{
		src: bravasDetalle,
		alt: 'Detalle de las patatas bravas con alioli y pimentón de El Caserío',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#caserio`,
	name: BUSINESS.name,
	alternateName: ['El Caserío', 'El Caserío Trintxerpe', 'Bar Restaurante El Caserio'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 943 39 38 87',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Vasca', 'Española', 'Marisco y parrilla'],
	areaServed: [
		{ '@type': 'City', name: 'Pasaia' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: `${BUSINESS.city}, ${BUSINESS.municipality}`,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday'],
			opens: '09:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '09:00',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '10:00',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '10:00',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const nota = BUSINESS.rating.toFixed(1).replace('.', ',');
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f5d3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Bar Restaurante El Caserío, El Caserío Trintxerpe, comer en Trintxerpe, menú del día Pasaia, mariscada Pasaia, restaurante Trintxerpe, terraza Pasaia, txuleta Gipuzkoa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Bar Restaurante El Caserío · Menú del día en Trintxerpe"
			ogDescription="Menú del día con primeros y segundos a elegir, mariscada, txuleta y postres caseros en Euskadi Etorbidea 23 (Trintxerpe, Pasaia). Terraza. Tel. 943 39 38 87."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Terraza cubierta del Bar Restaurante El Caserío en Trintxerpe"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2f5d3a"
			street={BUSINESS.street}
			city={`${BUSINESS.city}, ${BUSINESS.municipality}`}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34943393887"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.municipality}`}
			preload={[terraza]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="BAR RESTAURANTE EL CASERÍO"
			subtitle="Trintxerpe · Pasaia"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Euskadi Etorbidea, 23 · Trintxerpe"
				title="Menú del día<br /><em>junto a la ría.</em>"
				lede={`Bar Restaurante El Caserío es el restaurante familiar de Euskadi Etorbidea, 23, en Trintxerpe (Pasaia, Gipuzkoa). Menú del día con primeros y segundos a elegir, mariscada, txuleta y postres caseros, con terraza descubierta y otra cubierta. Cierra los lunes. ${nota} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={terraza}
				imageAlt="Terraza cubierta del Bar Restaurante El Caserío con mesas y sillas junto a un edificio de ladrillo en Trintxerpe"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${nota}</b> en Google (${BUSINESS.reviewsCount} reseñas)`,
					},
					{ label: 'Cocina', html: 'Menú del día · marisco y carnes' },
					{ label: 'Horario', html: 'Cierra lunes · mar–jue, mediodía' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece el Bar Restaurante El Caserío" items={[...SERVICIOS]} />

			<LocalAbout
				label="La casa"
				title="Comida de casa<br /><em>y mantel largo.</em>"
				paragraphs={[
					'El Bar Restaurante El Caserío está en Euskadi Etorbidea, 23, en Trintxerpe (20110 Pasaia, Gipuzkoa), en la avenida que cruza el barrio y a un paso de la ría. Google lo clasifica como restaurante, y sus reseñas lo describen como un refugio familiar de mesas espaciadas y trato cercano.',
					'Cierra los lunes. De martes a jueves abre de 9:00 a 17:00, solo a mediodía; el viernes alarga hasta las 23:30; el sábado va de 10:00 a 23:30 y el domingo de 10:00 a 16:00. En las reseñas se avisa de que a la hora de comer solo se sirve menú en la terraza.',
					'En las fotos de su perfil de Google aparecen la terraza cubierta con la carpa, la mariscada con langostinos, cigalas, almejas, navajas y vieiras, las patatas bravas, la merluza con patatas, el bacalao en salsa roja, el codillo con patatas fritas, la sopa de pescado y dos tartas de postre.',
					`Tiene ${nota} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google. Las publicadas hablan de «buena relación calidad-precio», de un menú «estupendo, mucha variedad y muy rico», del ambiente familiar y del trato del personal.`,
				]}
				note="La ficha de Google no publica carta ni precios: los platos y los importes de esta página son los que citan las reseñas publicadas, con su fecha."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="El menú<br /><em>y la parrilla.</em>"
				description="La ficha de Google no publica carta. Esto es lo que citan sus reseñas y lo que aparece en las fotos del perfil; el menú cambia cada día."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={[...MENU]}
				note="El menú del día costaba 14 € entre semana y 20 € el de fin de semana según una reseña de noviembre de 2025, y la mariscada para dos, 65 € con bebida y postre. Confirma precios y disponibilidad al llamar."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La terraza,<br /><em>el mar y la mesa.</em>"
				description="Estas fotografías proceden del perfil del Bar Restaurante El Caserío en Google Maps: la terraza cubierta, la mariscada, las patatas bravas, el pescado, el codillo, la sopa y los postres caseros."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Euskadi Etorbidea, 23,<br /><em>en Trintxerpe.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.municipality} · Gipuzkoa`,
				]}
				hours={[...HOURS]}
				hoursNote="Horario de la ficha de Google: cierra los lunes; de martes a jueves, de 9:00 a 17:00; el viernes, hasta las 23:30; el sábado, de 10:00 a 23:30; y el domingo, de 10:00 a 16:00. Puede cambiar, así que conviene llamar antes."
				mapTitle="Mapa del Bar Restaurante El Caserío en Euskadi Etorbidea, 23, Trintxerpe (Pasaia)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Bar Restaurante El Caserío · Trintxerpe"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 943 39 38 87. La ficha de Google marca acceso para sillas de ruedas y asientos adaptados, y las reseñas describen una terraza descubierta, otra cubierta con carpa y un comedor con las mesas espaciadas."
			/>

			<LocalFaq
				items={[...FAQ]}
				eyebrow="Preguntas frecuentes"
				title="Antes de <em>venir.</em>"
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}, ${BUSINESS.municipality}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/bar-restaurante-el-caserio/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a El Caserío"
		/>
	</body>
</html>
