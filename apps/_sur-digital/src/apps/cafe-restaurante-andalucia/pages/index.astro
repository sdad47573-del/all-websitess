---
import '../styles/global.css';

const business = {
	name: 'Café Restaurante Andalucía',
	short: 'Andalucía',
	street: 'Av. Andalucía, 21',
	city: 'Vejer de la Frontera',
	postalCode: '11150',
	phone: '+34 956 45 01 90',
	latitude: 36.2522787,
	longitude: -5.9688732,
	site: 'https://www.sur-digital.com/cafe-restaurante-andalucia',
};

const mapsUrl =
	'https://www.google.com/maps/place/Caf%C3%A9+Restaurante+Andaluc%C3%ADa/data=!4m7!3m6!1s0xd0c45cee6d569bf:0x7b144516f67130d4!8m2!3d36.2522787!4d-5.9688732!16s%2Fg%2F11xbct4hf!19sChIJv2nV5s5FDA0R1DBx9hZFFHs?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34956450190';

const specialties = [
	{
		kicker: 'Por la mañana',
		title: 'Café y desayunos',
		text: 'Para empezar el día en la avenida, de lunes a sábado desde las 8:00.',
	},
	{
		kicker: 'Al mediodía',
		title: 'Almuerzos',
		text: 'Café restaurante de diario para comer sin complicaciones hasta las 17:00.',
	},
	{
		kicker: 'De barrio',
		title: 'Barra cercana',
		text: 'Ambiente de bar de avenida, con clientela de Vejer.',
	},
	{
		kicker: 'Al aire',
		title: 'Terraza',
		text: 'Para tomar café o almorzar al aire en la Av. Andalucía.',
	},
	{
		kicker: 'Valorado',
		title: '4,4 con 440 reseñas',
		text: 'Bien valorado por la clientela según el recuento público disponible.',
	},
	{
		kicker: 'Aviso',
		title: 'Domingo cerrado',
		text: 'Cierra los domingos. Confirma el horario vigente en el 956 45 01 90.',
	},
];

const gallery = [
	{ src: '/cafe-restaurante-andalucia/fotos/cafe.svg', alt: 'Ilustración del café — sustituye por foto propia' },
	{ src: '/cafe-restaurante-andalucia/fotos/desayuno.svg', alt: 'Ilustración de desayunos — sustituye por foto propia' },
	{ src: '/cafe-restaurante-andalucia/fotos/barra.svg', alt: 'Ilustración de la barra — sustituye por foto propia' },
	{ src: '/cafe-restaurante-andalucia/fotos/almuerzo.svg', alt: 'Ilustración de almuerzos — sustituye por foto propia' },
	{ src: '/cafe-restaurante-andalucia/fotos/terraza.svg', alt: 'Ilustración de la terraza — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Café Restaurante Andalucía?',
		a: 'En Av. Andalucía, 21, 11150 Vejer de la Frontera (Cádiz).',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De lunes a sábado de 8:00 a 17:00; domingo cerrado, según directorio. Confirma en el 956 45 01 90.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'Para grupos conviene llamar al 956 45 01 90.',
	},
	{
		q: '¿Qué se puede tomar?',
		a: 'Café bar restaurante de diario: desayunos y almuerzos. Confirma la oferta del día en el local.',
	},
	{
		q: '¿Cómo llego?',
		a: 'Está en la Av. Andalucía, vía de entrada a Vejer. Usa el botón «Cómo llegar» para abrir la ruta en Google Maps.',
	},
];

const description =
	'Café Restaurante Andalucía: café bar en Av. Andalucía 21, Vejer. Desayunos y almuerzos. Lun–sáb 8:00–17:00, dom cerrado. Tel. 956 45 01 90.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 956 45 01 90',
	image: [`${business.site}/fotos/cafe.svg`],
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Andaluza'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:00',
			closes: '17:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.4,
		reviewCount: 440,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="Café Restaurante Andalucía: café bar en Av. Andalucía 21, Vejer. Desayunos y almuerzos. Lun–sáb 8–17. 956 45 01 90." />
		<meta name="keywords" content="Café Restaurante Andalucía Vejer, Av Andalucía 21, desayunos Vejer, almorzar Vejer" />
		<meta name="author" content="Café Restaurante Andalucía" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/cafe-restaurante-andalucia/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>Andalucía | Café Restaurante en Vejer</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Andalucía · Café Restaurante en Vejer" />
		<meta property="og:description" content="Desayunos y almuerzos en Av. Andalucía 21. Lun–sáb 8:00–17:00." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/cafe.svg`} />
		<meta property="og:image:alt" content="Café Restaurante Andalucía, Vejer" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Andalucía · Café Restaurante en Vejer" />
		<meta name="twitter:description" content="Av. Andalucía 21: desayunos y almuerzos. Lun–sáb 8–17." />
		<meta name="twitter:image" content={`${business.site}/fotos/cafe.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Vejer de la Frontera" />
		<meta name="geo.position" content="36.2522787;-5.9688732" />
		<meta name="ICBM" content="36.2522787, -5.9688732" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Café Restaurante Andalucía, inicio">
				<span class="brand-mark" aria-hidden="true">A</span>
				<span class="brand-name">Andalucía <small>Vejer · Av. Andalucía</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cafe">El café</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>956 45 01 90</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Av. Andalucía, 21 · Vejer</p>
					<h1 id="hero-title">El café<br />de <em>la avenida.</em></h1>
					<p class="hero-lede">
						Café bar restaurante para el día a día vejeriego: café y desayunos por la mañana,
						almuerzos hasta media tarde.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 956 45 01 90</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>Lun–sáb</b> 8–17</li>
						<li>Desayunos</li>
						<li>Almuerzos</li>
						<li>Domingo cerrado</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/cafe-restaurante-andalucia/fotos/cafe.svg" alt="Ilustración de Café Restaurante Andalucía, Vejer" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Av. Andalucía 21 · Vejer</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>4,4</b><span>440 reseñas</span></div>
					<div><b>8–17</b><span>Lun–sáb</span></div>
					<div><b>21</b><span>Av. Andalucía</span></div>
				</div>
				<ul class="services">
					<li>Café</li>
					<li>Desayunos</li>
					<li>Almuerzos</li>
					<li>Terraza</li>
					<li>Barra</li>
					<li>Diario</li>
				</ul>
			</section>

			<section class="about section-pad" id="cafe">
				<p class="section-label"><span aria-hidden="true"></span> El café</p>
				<div class="about-grid">
					<h2>De 8 a 5,<br />como <em>un reloj.</em></h2>
					<div class="about-copy">
						<p>
							Café Restaurante Andalucía está en Av. Andalucía, 21 (11150 Vejer de la Frontera),
							con coordenadas 36.2522787, -5.9688732.
						</p>
						<p>
							Café bar restaurante de avenida para desayunar y almorzar entre semana y el sábado,
							con horario continuo de mañana y mediodía.
						</p>
						<p class="about-note">
							Abre de lunes a sábado de 8:00 a 17:00; domingo cerrado, según directorio. Confirma
							en el 956 45 01 90 antes de venir.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales de café restaurante. Confirma la oferta del día
						en el propio local.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El café<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del café.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Av. Andalucía, 21</p>
					<h2>Ven a la avenida<br /><em>a desayunar.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes a sábado</th>
								<td>8:00 – 17:00</td>
							</tr>
							<tr>
								<th scope="row">Domingo</th>
								<td>Cerrado</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Según directorio. Confirma en el 956 45 01 90 antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al café ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 956 45 01 90</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de Café Andalucía en Av. Andalucía 21, Vejer" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Andalucía · Vejer</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">A</span>
				<p>Andalucía<small>{business.street} · {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del café">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Andalucía · Vejer de la Frontera. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/cafe-restaurante-andalucia/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/cafe-restaurante-andalucia/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/cafe-restaurante-andalucia/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al café <span>956 45 01 90</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/cafe-restaurante-andalucia/aviso-legal">Aviso legal</a>
			<a href="/cafe-restaurante-andalucia/aviso-legal#privacidad">Privacidad</a>
			<a href="/cafe-restaurante-andalucia/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
