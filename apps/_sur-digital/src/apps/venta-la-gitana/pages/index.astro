---
import '../styles/global.css';

const business = {
	name: 'Restaurante Venta La Gitana',
	short: 'Venta La Gitana',
	street: 'Polígono Industrial Caña Ancha, Nave 1',
	city: 'Vejer de la Frontera',
	postalCode: '11150',
	phone: '+34 956 45 01 64',
	latitude: 36.269965,
	longitude: -5.9641498,
	site: 'https://www.sur-digital.com/venta-la-gitana',
};

const mapsUrl =
	'https://www.google.com/maps/place/Venta+la+Gitana/@36.269965,-5.9641498,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c45eb0da6e651:0xede3cfd5be3ba046!8m2!3d36.269965!4d-5.9641498!16s%2Fg%2F1td1r3yl?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34956450164';

const specialties = [
	{
		kicker: 'Desde las 6:00',
		title: 'Desayunos de venta',
		text: 'Abren a diario desde las seis de la mañana con desayunos de venta.',
	},
	{
		kicker: 'Al mediodía',
		title: 'Tapeo y comidas',
		text: 'Cocina española para tapear o comer al mediodía hasta las 21:00.',
	},
	{
		kicker: 'De diario',
		title: 'Menú de venta',
		text: 'Venta de polígono para trabajadores y vecinos: comer bien sin complicaciones.',
	},
	{
		kicker: 'Fácil',
		title: 'Aparcar sin vueltas',
		text: 'En el polígono Caña Ancha, con acceso directo y sitio para aparcar.',
	},
	{
		kicker: 'Horario',
		title: 'Lun–dom 6–21',
		text: 'Horario amplio todos los días según directorios. Confirma en el 956 45 01 64.',
	},
	{
		kicker: 'Reserva',
		title: '956 45 01 64',
		text: 'Para grupos conviene llamar antes, sobre todo al mediodía.',
	},
];

const gallery = [
	{ src: '/fotos/venta.svg', alt: 'Ilustración de la venta — sustituye por foto propia' },
	{ src: '/fotos/desayuno.svg', alt: 'Ilustración de desayunos — sustituye por foto propia' },
	{ src: '/fotos/barra.svg', alt: 'Ilustración de la barra — sustituye por foto propia' },
	{ src: '/fotos/platos.svg', alt: 'Ilustración de cocina española — sustituye por foto propia' },
	{ src: '/fotos/poligono.svg', alt: 'Ilustración del polígono — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Venta La Gitana?',
		a: 'En Polígono Industrial Caña Ancha, Nave 1, 11150 Vejer de la Frontera (Cádiz).',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De lunes a domingo de 6:00 a 21:00, según directorios. Confirma en el 956 45 01 64.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'Para grupos al mediodía conviene llamar al 956 45 01 64.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Venta de cocina española: desayunos desde las 6:00, tapeo y comidas. Confirma la carta del día en el local.',
	},
	{
		q: '¿Cómo llego?',
		a: 'Está en el polígono Caña Ancha de Vejer. Usa el botón «Cómo llegar» para abrir la ruta en Google Maps.',
	},
];

const description =
	'Venta La Gitana: restaurante de cocina española en Pol. Caña Ancha Nave 1, Vejer. Desayunos desde las 6:00. Lun–dom 6:00–21:00. Tel. 956 45 01 64.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 956 45 01 64',
	image: [`${business.site}/fotos/venta.svg`],
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Andaluza'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '06:00',
			closes: '21:00',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="Venta La Gitana: venta española en Pol. Caña Ancha Nave 1, Vejer. Desayunos desde las 6:00. Lun–dom 6–21. 956 45 01 64." />
		<meta name="keywords" content="Venta La Gitana Vejer, Caña Ancha comer, desayunos Vejer, cocina española Vejer" />
		<meta name="author" content="Venta La Gitana" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/venta-la-gitana/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>Venta La Gitana | Restaurante en Vejer</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Venta La Gitana · Venta española en Vejer" />
		<meta property="og:description" content="Desayunos desde las 6:00 en Pol. Caña Ancha Nave 1. Lun–dom 6:00–21:00." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/venta.svg`} />
		<meta property="og:image:alt" content="Venta La Gitana, Vejer de la Frontera" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Venta La Gitana · Restaurante en Vejer" />
		<meta name="twitter:description" content="Pol. Caña Ancha Nave 1: desayunos desde las 6:00. Lun–dom 6–21." />
		<meta name="twitter:image" content={`${business.site}/fotos/venta.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Vejer de la Frontera" />
		<meta name="geo.position" content="36.269965;-5.9641498" />
		<meta name="ICBM" content="36.269965, -5.9641498" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Venta La Gitana, inicio">
				<span class="brand-mark" aria-hidden="true">VG</span>
				<span class="brand-name">Venta La Gitana <small>Vejer · Caña Ancha</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#venta">La venta</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>956 45 01 64</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Caña Ancha, Nave 1 · Vejer</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Venta española en el polígono de Vejer: desayunos desde las 6:00,
						tapeo y comidas hasta las 21:00, todos los días.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 956 45 01 64</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>6–21</b> lun–dom</li>
						<li>Desayunos</li>
						<li>Cocina española</li>
						<li>Fácil aparcar</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/venta-la-gitana/fotos/venta.svg" alt="Ilustración de Venta La Gitana, Vejer de la Frontera" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Caña Ancha Nave 1 · Vejer</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>6–21</b><span>Todos los días</span></div>
					<div><b>Nave 1</b><span>Caña Ancha</span></div>
					<div><b>Vejer</b><span>Cádiz</span></div>
				</div>
				<ul class="services">
					<li>Desayunos</li>
					<li>Tapeo</li>
					<li>Comidas</li>
					<li>Venta</li>
					<li>Parking</li>
					<li>Diario</li>
				</ul>
			</section>

			<section class="about section-pad" id="venta">
				<p class="section-label"><span aria-hidden="true"></span> La venta</p>
				<div class="about-grid">
					<h2>La del polígono<br />de <em>Vejer.</em></h2>
					<div class="about-copy">
						<p>
							Venta La Gitana está en Polígono Industrial Caña Ancha, Nave 1 (11150 Vejer),
							con coordenadas 36.269965, -5.9641498.
						</p>
						<p>
							Restaurante español de venta para el día a día: desayunos desde primera hora,
							tapeo y comidas de cocina española hasta la noche.
						</p>
						<p class="about-note">
							Abre de lunes a domingo de 6:00 a 21:00, según directorios. Confirma en el
							956 45 01 64 antes de venir.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales de venta española. Confirma la carta del día
						en el propio local.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>La venta<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias de la venta.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Caña Ancha, Nave 1</p>
					<h2>Ven a la venta<br /><em>a desayunar.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes a domingo</th>
								<td>6:00 – 21:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Según directorios. Confirma en el 956 45 01 64 antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar a la venta ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 956 45 01 64</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de Venta La Gitana en Caña Ancha, Vejer" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> La Gitana · Vejer</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">VG</span>
				<p>Venta La Gitana<small>{business.street} · {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces de la venta">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Venta La Gitana · Vejer de la Frontera. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/venta-la-gitana/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/venta-la-gitana/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/venta-la-gitana/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar a la venta <span>956 45 01 64</span></a>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34956450164?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Restaurante%20Venta%20La%20Gitana." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Restaurante Venta La Gitana"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
