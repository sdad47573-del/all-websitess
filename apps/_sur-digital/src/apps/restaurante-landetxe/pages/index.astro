---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import comedor from '../assets/fotos/restaurante-landetxe-apaisada-01.jpg';
import pulpo from '../assets/fotos/restaurante-landetxe-vertical-02.jpg';
import tarta from '../assets/fotos/restaurante-landetxe-vertical-03.jpg';
import rodaballo from '../assets/fotos/restaurante-landetxe-apaisada-04.jpg';
import rodaballoClams from '../assets/fotos/restaurante-landetxe-apaisada-05.jpg';
import tostas from '../assets/fotos/restaurante-landetxe-apaisada-06.jpg';
import tartaleta from '../assets/fotos/restaurante-landetxe-vertical-07.jpg';
import bogavante from '../assets/fotos/restaurante-landetxe-vertical-08.jpg';
import ensalada from '../assets/fotos/restaurante-landetxe-apaisada-09.jpg';
import rodaballoAjo from '../assets/fotos/restaurante-landetxe-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Landetxe Jatetxea, restaurante y taberna en Mendiburu Kalea, Elizalde (Oiartzun). Pintxos, cocina de taberna y raciones generosas, con 4,5 sobre 5 en Google. Teléfono 666 69 34 66.';

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de Landetxe Jatetxea con barra de madera, ventanales y mesas grises',
	},
	{
		src: pulpo,
		alt: 'Pulpo a la plancha con patatas y puré sobre un plato azul',
	},
	{
		src: tarta,
		alt: 'Tarta de chocolate con nata, flores y crujiente en un plato blanco',
	},
	{
		src: rodaballo,
		alt: 'Rodaballo al horno con almejas, patatas y perejil en una fuente blanca',
	},
	{
		src: rodaballoClams,
		alt: 'Rodaballo con almejas y patatas servido en una fuente blanca',
	},
	{
		src: tostas,
		alt: 'Tostas con salmón, huevo y brotes verdes en Landetxe',
	},
	{
		src: tartaleta,
		alt: 'Tartaleta de marisco con gamba y mejillón sobre un plato azul',
	},
	{
		src: bogavante,
		alt: 'Arroz con bogavante en una cazuela de barro',
	},
	{
		src: ensalada,
		alt: 'Ensalada de tomate con ventresca de atún y pimientos verdes',
	},
	{
		src: rodaballoAjo,
		alt: 'Rodaballo entero con ajo laminado y perejil',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#landetxe`,
	name: BUSINESS.name,
	alternateName: ['Landetxe', 'Landetxe Jatetxea', 'Restaurante Landetxe', 'Landetxeko taberna'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: `+34 ${BUSINESS.phone}`,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina de taberna', 'Pintxos'],
	areaServed: [
		{ '@type': 'City', name: 'Oiartzun' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '09:00',
			closes: '22:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '09:00',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '09:30',
			closes: '22:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La barra', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Landetxe Jatetxea · Taberna y restaurante en Oiartzun';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-landetxe-apaisada-01.jpg": comedor,
	"restaurante-landetxe-vertical-02.jpg": pulpo,
	"restaurante-landetxe-vertical-03.jpg": tarta,
	"restaurante-landetxe-apaisada-04.jpg": rodaballo,
	"restaurante-landetxe-apaisada-05.jpg": rodaballoClams,
	"restaurante-landetxe-apaisada-06.jpg": tostas,
	"restaurante-landetxe-vertical-07.jpg": tartaleta,
	"restaurante-landetxe-vertical-08.jpg": bogavante,
	"restaurante-landetxe-apaisada-09.jpg": ensalada,
	"restaurante-landetxe-apaisada-10.jpg": rodaballoAjo,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f4a46" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700&family=Gloock&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Landetxe Jatetxea, Landetxe Oiartzun, restaurante Oiartzun, taberna Elizalde, comer en Oiartzun, pintxos Oiartzun, Mendiburu Kalea, Landetxeko taberna"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Restaurante y taberna en Mendiburu Kalea, Elizalde (Oiartzun). Pintxos, cocina de taberna y raciones generosas, con 4,5 sobre 5 en Google. Teléfono 666 69 34 66."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rodaballo con almejas y patatas de Landetxe Jatetxea"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2f4a46"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Elizalde, Oiartzun"
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/restaurante-landetxe/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Landetxe"
			subtitle="Jatetxea · Oiartzun"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
				reviews={REVIEWS}
				googleMaps={MAPS.place}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Landetxe"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34666693466?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Oiartzun." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Oiartzun"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
