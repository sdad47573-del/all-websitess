---
import Carniceria from '../components/Carniceria.astro';
import Contact from '../components/Contact.astro';
import Fab from '../components/Fab.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Highlights from '../components/Highlights.astro';
import Productos from '../components/Productos.astro';
import Servicios from '../components/Servicios.astro';
import Topbar from '../components/Topbar.astro';
import { breadcrumbs } from '../data/schema';
import Layout from '../layouts/Layout.astro';
---

<Layout schema={[breadcrumbs([{ name: 'Inicio', path: '/carniceria-jose-luis/' }])]}>
	<Topbar />
	<main>
		<Hero />
		<Highlights />
		<Carniceria />
		<Productos />
		<Servicios />
		<Contact />
		<Faq />
	</main>
	<Footer />
	<Fab />
</Layout>
