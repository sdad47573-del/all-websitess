---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/m-encanta-comidas-para-llevar-apaisada-01.jpg';
import aperitivos from '../assets/fotos/m-encanta-comidas-para-llevar-apaisada-02.jpg';
import chicharrones from '../assets/fotos/m-encanta-comidas-para-llevar-apaisada-03.jpg';
import caracoles from '../assets/fotos/m-encanta-comidas-para-llevar-apaisada-04.jpg';
import patio from '../assets/fotos/m-encanta-comidas-para-llevar-vertical-05.jpg';
import carta from '../assets/fotos/m-encanta-comidas-para-llevar-vertical-06.jpg';
import patioMesas from '../assets/fotos/m-encanta-comidas-para-llevar-apaisada-07.jpg';
import terraza from '../assets/fotos/m-encanta-comidas-para-llevar-apaisada-08.jpg';
import terrazaInterior from '../assets/fotos/m-encanta-comidas-para-llevar-apaisada-09.jpg';
import arroz from '../assets/fotos/m-encanta-comidas-para-llevar-apaisada-10.jpg';

import { BUSINESS, FAQ, MAPS, MENU, SERVICES } from '../data/site';

const title = "M'encanta · Comidas caseras para llevar en Salteras";
const description = BUSINESS.description;
const gallery = [
  { src: fachada, alt: 'Fachada del establecimiento M’encanta en Salteras' },
  { src: carta, alt: 'Carta fotografiada de M’encanta con tapas, pescado frito, precios y teléfono de pedidos' },
  { src: aperitivos, alt: 'Bandeja de aperitivos variados preparada para compartir' },
  { src: chicharrones, alt: 'Chicharrones servidos en una bandeja' },
  { src: caracoles, alt: 'Caracoles en salsa, uno de los platos de temporada anunciados en la carta' },
  { src: arroz, alt: 'Arroz servido en una paellera' },
  { src: patio, alt: 'Terraza con mesas y sillas en M’encanta' },
  { src: patioMesas, alt: 'Mesas de la terraza interior de M’encanta' },
  { src: terraza, alt: 'Terraza exterior preparada para recibir comensales' },
  { src: terrazaInterior, alt: 'Vista de la terraza y el comedor exterior' },
];

const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: BUSINESS.name,
  description,
  url: `${BUSINESS.siteUrl}/`,
  telephone: '+34658694133',
  servesCuisine: ['Comida casera', 'Cocina española', 'Pescado frito'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.street,
    addressLocality: BUSINESS.city,
    addressRegion: BUSINESS.region,
    postalCode: BUSINESS.postalCode,
    addressCountry: BUSINESS.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: BUSINESS.geo.lat,
    longitude: BUSINESS.geo.lng,
  },
  sameAs: [MAPS.place, MAPS.facebook],
  image: [`${BUSINESS.siteUrl}/og.jpg`],
};

const nav = [
  { label: 'La casa', href: '#casa' },
  { label: 'Carta', href: '#carta' },
  { label: 'Fotos', href: '#galeria' },
  { label: 'Encuéntranos', href: '#visitanos' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"m-encanta-comidas-para-llevar-apaisada-01.jpg": fachada,
	"m-encanta-comidas-para-llevar-vertical-06.jpg": carta,
	"m-encanta-comidas-para-llevar-apaisada-02.jpg": aperitivos,
	"m-encanta-comidas-para-llevar-apaisada-03.jpg": chicharrones,
	"m-encanta-comidas-para-llevar-apaisada-04.jpg": caracoles,
	"m-encanta-comidas-para-llevar-apaisada-10.jpg": arroz,
	"m-encanta-comidas-para-llevar-vertical-05.jpg": patio,
	"m-encanta-comidas-para-llevar-apaisada-07.jpg": patioMesas,
	"m-encanta-comidas-para-llevar-apaisada-08.jpg": terraza,
	"m-encanta-comidas-para-llevar-apaisada-09.jpg": terrazaInterior,
};

const horas = [];

---
<!doctype html>
<html lang="es">
  <head>
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <LocalSeo
      name={BUSINESS.name}
      description={description}
      keywords="M'encanta, comida para llevar Salteras, comidas caseras, guisos, pollos asados, catering Salteras"
      canonical={`${BUSINESS.siteUrl}/`}
      site={BUSINESS.siteUrl}
      ogTitle={title}
      ogDescription="Guisos caseros, pollos asados, tapas y menú semanal en Salteras. Pregunta por el reparto y el catering."
      ogImage={`${BUSINESS.siteUrl}/og.jpg`}
      ogImageAlt="Fachada de M’encanta Comidas para Llevar en Salteras"
      ogImageWidth={1200}
      ogImageHeight={630}
      author={BUSINESS.name}
      themeColor="#274537"
      street={BUSINESS.street}
      city={BUSINESS.city}
      region={BUSINESS.region}
      geoRegion="ES-SE"
      postalCode={BUSINESS.postalCode}
      phone={BUSINESS.phone}
      latitude={BUSINESS.geo.lat}
      longitude={BUSINESS.geo.lng}
      placeName="Salteras"
      locale="es_ES"
      countryName="España"
      contact={{
        street: BUSINESS.street,
        locality: BUSINESS.city,
        region: BUSINESS.region,
        postalCode: BUSINESS.postalCode,
        country: BUSINESS.country,
        phone: BUSINESS.phone,
        latitude: BUSINESS.geo.lat,
        longitude: BUSINESS.geo.lng,
      }}
      preload={[fachada]}
      schemas={[restaurantSchema]}
    />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  		<meta property="og:image" content="https://www.sur-digital.com/m-encanta-comidas-para-llevar/og.jpg" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta property="og:url" content="https://www.sur-digital.com/m-encanta-comidas-para-llevar/" />
		<meta property="og:locale" content="es_ES" />
			<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
	</head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <LocalTopbar
      mark={BUSINESS.mark}
      name={BUSINESS.shortName}
      subtitle="Comida casera · Salteras"
      phone={BUSINESS.phone}
      phoneHref={BUSINESS.phoneHref}
      nav={nav}
      homeLabel="inicio"
      navAriaLabel="Navegación principal"
    />

    <main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={horas}
								mapas={MAPS}
			/>
		</main>

    <LocalFooter
      mark={BUSINESS.mark}
      name={BUSINESS.name}
      address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
      links={[
        { label: 'Google Maps ↗', href: MAPS.place, external: true },
        { label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
        { label: 'Facebook ↗', href: MAPS.facebook, external: true },
        { label: 'Aviso legal', href: '/aviso-legal' },
      ]}
      phone={BUSINESS.phone}
      phoneHref={BUSINESS.phoneHref}
      legal="Información basada en la carta fotografiada y los perfiles públicos del establecimiento. Confirma teléfono, horario, precios y disponibilidad antes de pedir."
      ctaLabel="Llamar a M’encanta"
      navAriaLabel="Enlaces de M’encanta"
      legalLinks={[
        { label: 'Aviso legal', href: '/aviso-legal' },
        { label: 'Privacidad', href: '/aviso-legal#privacidad' },
        { label: 'Cookies', href: '/aviso-legal#cookies' },
      ]}
      creditLabel="Creado por"
      creditName="Sur Digital"
      creditHref="https://www.sur-digital.com/"
    />
  <!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34658694133?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20M." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a M"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
