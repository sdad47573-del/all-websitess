---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/el-paseo-apaisada-01.jpg';
import foto1 from '../assets/fotos/el-paseo-apaisada-04.jpg';
import foto2 from '../assets/fotos/el-paseo-vertical-02.jpg';
import foto3 from '../assets/fotos/el-paseo-apaisada-05.jpg';
import foto4 from '../assets/fotos/el-paseo-vertical-07.jpg';
import foto5 from '../assets/fotos/el-paseo-apaisada-06.jpg';

const business = {
	name: 'El Paseo',
	street: 'Av. Juan Carlos I, 21',
	city: 'Campos del Río',
	region: 'Región de Murcia',
	province: 'Murcia',
	postalCode: '30191',
	phone: '+34 653 89 67 37',
	latitude: 38.0393011,
	longitude: -1.3542245,
	site: 'https://www.sur-digital.com/el-paseo',
};

const mapsUrl =
	'https://www.google.com/maps/place/El+Paseo/@38.0393011,-1.3542245,17z/data=!3m1!4b1!4m6!3m5!1s0xd647cb981adce95:0xb10cea6157fc668d!8m2!3d38.0393011!4d-1.3542245!16s%2Fg%2F11cjgdr8tv?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34653896737';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'La cocina',
		title: 'Cocina mediterránea',
		text: 'El Paseo se presenta en Google Maps como bar restaurante y restaurante mediterráneo, en pleno Campos del Río.',
	},
	{
		kicker: 'La barra',
		title: 'Cerveza de grifo bien tirada',
		text: '«Cerveza de grifo bien tirada», destaca una reseña. El bar es la primera parada, a cualquier hora.',
	},
	{
		kicker: 'Para celebrar',
		title: 'Un lugar para celebraciones',
		text: '«Un lugar perfecto para celebraciones», cuenta un cliente. Comidas de empresa, cumpleaños o reuniones familiares.',
	},
	{
		kicker: 'El servicio',
		title: 'Servicio profesional',
		text: '«Servicio profesional y agradable»: el trato es lo que más repiten quienes han estado en la casa.',
	},
	{
		kicker: 'El precio',
		title: 'Buen trato y buenos precios',
		text: '«Buen trato, buen servicio, buenos precios», resume otra de las reseñas de la ficha de Google Maps.',
	},
	{
		kicker: 'El horario',
		title: 'De 6:00 a 24:00',
		text: 'Abre todos los días de la semana, de seis de la mañana a medianoche, según su ficha de Google Maps.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de El Paseo publicada en su ficha de Google Maps' },
	{ src: photos.foto2, alt: 'Imagen del bar restaurante El Paseo en Campos del Río' },
	{ src: photos.foto3, alt: 'Fotografía de El Paseo en la avenida Juan Carlos I, 21, Campos del Río' },
	{ src: photos.foto4, alt: 'Imagen de El Paseo subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Vista de El Paseo según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está El Paseo?',
		a: 'En la avenida Juan Carlos I, 21, 30191 Campos del Río (Murcia). Coordenadas 38.0393011, -1.3542245.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Según su ficha de Google Maps, abre todos los días de 6:00 a 24:00, de lunes a domingo. En festivos conviene llamar antes.',
	},
	{
		q: '¿Se puede celebrar una comida o un cumpleaños?',
		a: 'Los clientes lo describen como «un lugar perfecto para celebraciones». Llama al 653 89 67 37 para consultar disponibilidad y condiciones.',
	},
	{
		q: '¿Qué se puede comer y beber?',
		a: 'Cocina mediterránea de bar restaurante, con cerveza de grifo entre lo más citado en las reseñas. La carta no está publicada en la ficha de Google Maps.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso, aparcamiento, aseo y asientos adaptados para sillas de ruedas.',
	},
	{
		q: '¿Cómo se contacta?',
		a: 'Llamando al 653 89 67 37. También puedes abrir la ficha de Google Maps desde esta web para ver la ruta y la información actualizada.',
	},
];

const description =
	'El Paseo, bar restaurante mediterráneo en Campos del Río (Murcia). Celebraciones, cerveza de grifo y buen servicio de 6:00 a 24:00. Llama al 653 89 67 37.';

const images = [
	`${business.site}/og.jpg`,
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: business.phone,
	image: images,
	servesCuisine: ['Mediterránea', 'Española'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '06:00',
			closes: '23:59',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.5,
		reviewCount: 599,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1f4a44" />
		<meta
			name="description"
			content="El Paseo, bar restaurante mediterráneo en Campos del Río (Murcia). Celebraciones, cerveza de grifo y buen servicio de 6:00 a 24:00. Llama al 653 89 67 37."
		/>
		<meta
			name="keywords"
			content="El Paseo, bar restaurante Campos del Río, restaurante mediterráneo Murcia, celebraciones Campos del Río, cerveza de grifo"
		/>
		<meta name="author" content="El Paseo" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/el-paseo/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Karla:wght@400;500;600;700&family=Lora:ital,wght@0,500;0,600;0,700;1,500&display=swap"
			rel="stylesheet"
		/>
		<title>El Paseo | Cocina mediterránea y celebraciones en Campos del Río</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="El Paseo · Cocina mediterránea en Campos del Río" />
		<meta
			property="og:description"
			content="Bar restaurante mediterráneo en Campos del Río (Murcia). Celebraciones, cerveza de grifo y buen servicio."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.jpg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="El Paseo, bar restaurante en Campos del Río (Murcia)" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="El Paseo · Cocina mediterránea en Campos del Río" />
		<meta
			name="twitter:description"
			content="Bar restaurante mediterráneo en Campos del Río (Murcia). Llama al 653 89 67 37."
		/>
		<meta name="twitter:image" content={`${business.site}/og.jpg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Campos del Río" />
		<meta name="geo.position" content="38.0393011;-1.3542245" />
		<meta name="ICBM" content="38.0393011, -1.3542245" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="El Paseo, inicio">
				<span class="brand-mark" aria-hidden="true">P</span>
				<span class="brand-name">El Paseo <small>Campos del Río · Murcia</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#cocina">La cocina</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>653 89 67 37</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Av. Juan Carlos I, 21 · Campos del Río</p>
					<h1 id="hero-title">Cocina<br />mediterránea<br /><em>y celebraciones.</em></h1>
					<p class="hero-lede">
						El Paseo es bar restaurante y restaurante mediterráneo en Campos del Río (Murcia). Buen servicio,
						cerveza de grifo bien tirada y un lugar pensado también para celebrar.
					</p>
					<div class="hero-actions">
						<a class="button button-sea" href={phoneHref}>Llamar 653 89 67 37</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,5</b> en Google (599 reseñas)</li>
						<li>Cocina mediterránea</li>
						<li>Abierto todos los días</li>
						<li>Campos del Río</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="webp"
						quality={70}
						alt="El Paseo, bar restaurante de cocina mediterránea en Campos del Río"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,5</b><span>Google</span></div>
					<div><b>599</b><span>Reseñas</span></div>
					<div><b>7/7</b><span>Días abierto</span></div>
				</div>
				<ul class="services">
					<li>Cocina mediterránea</li>
					<li>Bar restaurante</li>
					<li>Celebraciones</li>
					<li>Cerveza de grifo</li>
					<li>Local accesible</li>
					<li>Aparcamiento adaptado</li>
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> Bar restaurante en Campos del Río</p>
				<div class="about-grid">
					<h2>El sitio<br />de siempre,<br /><em>en el paseo.</em></h2>
					<div class="about-copy">
						<p>
							El Paseo está en la avenida Juan Carlos I, 21, en Campos del Río (Murcia). Bar restaurante y
							restaurante mediterráneo, con servicio de barra y de mesa durante todo el día.
						</p>
						<p>
							Las reseñas de Google Maps hablan de un trato excelente, servicio profesional y agradable,
							buenos precios y cerveza de grifo bien tirada. Varios clientes lo señalan como un lugar
							perfecto para celebraciones.
						</p>
						<p class="about-note">
							Abre todos los días de 6:00 a 24:00, según la ficha. Llama al 653 89 67 37 para reservar o
							consultar una celebración.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="cocina">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Lo que dicen las reseñas</p>
						<h2>Cocina, barra<br />y <em>celebraciones.</em></h2>
					</div>
					<p>
						Sin carta publicada en la ficha, lo que mejor define a El Paseo son las reseñas de sus clientes:
						cocina mediterránea, buena cerveza, trato cercano y un sitio al que volver.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>El Paseo<br /><em>en imágenes.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de El Paseo. En la ficha encontrarás la
							galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="webp"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres el
					titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Av. Juan Carlos I, 21</p>
					<h2>Ven a Campos<br /><em>del Río.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes a domingo</th>
								<td>6:00 – 24:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o para una celebración, llama antes.
					</p>

					<div class="visit-links">
						<a class="button button-sea" href={phoneHref}>Llamar 653 89 67 37</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 653 89 67 37</a>

					<ul class="access">
						<li>Acceso adaptado</li>
						<li>Aparcamiento adaptado</li>
						<li>Aseo adaptado</li>
						<li>Asientos adaptados</li>
					</ul>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de El Paseo en la avenida Juan Carlos I, 21, Campos del Río"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;">
								<a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a>
							</p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> El Paseo · Campos del Río
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">P</span>
				<p>El Paseo<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} El Paseo · Campos del Río, Murcia. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>

			<p class="footer-credit">
				Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
				<a href="https://sur-digital.vercel.app/" rel="noopener">sur-digital.vercel.app</a>
			</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/el-paseo/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/el-paseo/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/el-paseo/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar a El Paseo <span>653 89 67 37</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/el-paseo/aviso-legal">Aviso legal</a>
			<a href="/el-paseo/aviso-legal#privacidad">Privacidad</a>
			<a href="/el-paseo/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
