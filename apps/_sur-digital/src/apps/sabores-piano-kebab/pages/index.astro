---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import cocina from '../assets/fotos/sabores-piano-kebab-apaisada-01.jpg';
import mostrador from '../assets/fotos/sabores-piano-kebab-apaisada-02.jpg';
import calzones from '../assets/fotos/sabores-piano-kebab-apaisada-10.jpg';
import calzone from '../assets/fotos/sabores-piano-kebab-cuadrada-03.jpg';
import platoKebab from '../assets/fotos/sabores-piano-kebab-vertical-04.jpg';
import pincho from '../assets/fotos/sabores-piano-kebab-vertical-05.jpg';
import durumCoche from '../assets/fotos/sabores-piano-kebab-vertical-06.jpg';
import durum from '../assets/fotos/sabores-piano-kebab-vertical-07.jpg';
import pollo from '../assets/fotos/sabores-piano-kebab-vertical-08.jpg';
import curry from '../assets/fotos/sabores-piano-kebab-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Sabores Piano Kebab · kebab, dürüm y calzone en la Ronda de Calatrava, Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: platoKebab,
		alt: 'Plato de kebab con carne de döner, patatas fritas, ensalada y salsa de ajo y picante',
	},
	{
		src: pincho,
		alt: 'Pincho de döner girando junto a la campana de la cocina, con la carne dorada',
	},
	{
		src: calzone,
		alt: 'Calzone recién horneado con la masa dorada y espolvoreado de orégano',
	},
	{
		src: calzones,
		alt: 'Dos calzones en sus cajas abiertas con una bandeja de patatas y dos refrescos',
	},
	{
		src: durum,
		alt: 'Dürüm de kebab abierto por la mitad, con carne, lechuga y tomate',
	},
	{
		src: durumCoche,
		alt: 'Dürüm de kebab envuelto en papel, con la carne y la verdura a la vista',
	},
	{
		src: pollo,
		alt: 'Medio pollo a la brasa con arroz, patatas y ensalada en el mismo plato',
	},
	{
		src: curry,
		alt: 'Curry de pollo con verduras, pan naan y ensalada de cebolla morada',
	},
	{
		src: mostrador,
		alt: 'Barra del local bajo los carteles de precios, con la freidora y la caja registradora',
	},
	{
		src: cocina,
		alt: 'Cocina con el pincho de döner en el asador y el mostrador de trabajo al fondo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#sabores-piano-kebab`,
	name: BUSINESS.name,
	alternateName: ['Piano Kebab', 'Sabores Piano Kebab Ciudad Real'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Turca', 'Kebab', 'Pizza', 'Bocadillos'],
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Feature ID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google kgmid', value: BUSINESS.channel },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"sabores-piano-kebab-vertical-04.jpg": platoKebab,
	"sabores-piano-kebab-vertical-05.jpg": pincho,
	"sabores-piano-kebab-cuadrada-03.jpg": calzone,
	"sabores-piano-kebab-apaisada-10.jpg": calzones,
	"sabores-piano-kebab-vertical-07.jpg": durum,
	"sabores-piano-kebab-vertical-06.jpg": durumCoche,
	"sabores-piano-kebab-vertical-08.jpg": pollo,
	"sabores-piano-kebab-vertical-09.jpg": curry,
	"sabores-piano-kebab-apaisada-02.jpg": mostrador,
	"sabores-piano-kebab-apaisada-01.jpg": cocina,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#16181f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Sabores Piano Kebab Ciudad Real, kebab Ronda de Calatrava, dürüm Ciudad Real, calzone Ciudad Real, pizza kebab 13003, restaurante turco Ciudad Real, falafel, pollo a la brasa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Kebab, dürüm, calzone y pizza en la Ronda de Calatrava, 14, de Ciudad Real. 2,8 sobre 5 con 811 reseñas en Google. Teléfono 926 92 22 87."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Plato de kebab de Sabores Piano Kebab"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#16181f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[platoKebab]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/sabores-piano-kebab/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Kebab, dürüm y calzone en la Ronda"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y precios antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Sabores Piano Kebab"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34926922287?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Ciudad%20Real." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Ciudad Real"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
