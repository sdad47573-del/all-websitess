---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/morning-terraza-cafe-tostada.jpg';
import maquina from '../assets/fotos/morning-maquina-cafe-logo.jpg';
import cartaMesa from '../assets/fotos/morning-mesa-carta.jpg';
import croissantPistacho from '../assets/fotos/morning-croissant-pistacho-caja.jpg';
import croissantChocolate from '../assets/fotos/morning-croissant-chocolate.jpg';
import croissantPapel from '../assets/fotos/morning-croissant-chocolate-papel.jpg';
import croissantBatido from '../assets/fotos/morning-croissant-batido-mesa.jpg';
import tostadaFresa from '../assets/fotos/morning-tostada-fresa.jpg';
import tostadaChocolate from '../assets/fotos/morning-tostada-chocolate.jpg';
import tostadaBandeja from '../assets/fotos/morning-tostada-chocolate-bandeja.jpg';
import tostadaHuevos from '../assets/fotos/morning-tostada-huevos-cafe.jpg';
import waffles from '../assets/fotos/morning-waffles-bandeja.jpg';
import smoothie from '../assets/fotos/morning-smoothie-rojo.jpg';
import smoothieIngredientes from '../assets/fotos/morning-smoothie-ingredientes.jpg';
import frappe from '../assets/fotos/morning-frappe-coco.jpg';
import cafeFrappe from '../assets/fotos/morning-cafe-frappe-taza.jpg';
import jamon from '../assets/fotos/morning-jamon-conos.jpg';
import cervezas from '../assets/fotos/morning-cervezas-botellas.jpg';

const business = {
	name: 'Morning Coffee',
	tagline: 'Cafetería de desayuno en Bailén-Miraflores',
	street: 'Av. de Carlos Haya, 198',
	district: 'Bailén-Miraflores',
	city: 'Málaga',
	postalCode: '29010',
	phone: '685 01 41 27',
	latitude: 36.7249507,
	longitude: -4.4572812,
	rating: 4.9,
	reviewsCount: 49,
	site: 'https://www.sur-digital.com/morning-coffee-malaga',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd72f71717db3df3:0x82c39cb9a1933fe6';
const cidDecimal = '9422547166482874342';
const placeId = 'ChIJ8z3bFxf3cg0R5j-Tobmcw4I';

const mapsUrl = `https://www.google.com/maps/place/?q=place_id:${placeId}&hl=es`;
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34685014127';

const description =
	'Morning Coffee en Av. de Carlos Haya, 198 (Bailén-Miraflores, Málaga). Cafetería de desayuno: tostadas, croissants, wafples, batidos y café de especialidad. Abierto todos los días de 8:00 a 14:00. 4,9 en Google. Tel. 685 01 41 27.';

const servicios = [
	'Desayunos',
	'Tostadas',
	'Croissants',
	'Wafles',
	'Café de especialidad',
	'Batidos y smoothies',
	'Frappés',
	'Croissant de pistacho',
	'Frutos rojos',
	'Comer en el local',
	'Autoservicio',
	'Entrega sin contacto',
	'Bailén-Miraflores',
];

const grupos = [
	{
		title: 'Desayuno salado',
		items: [
			{ name: 'Tostadas de la casa', note: 'con aguacate, tomate y aceite, servido en barra' },
			{ name: 'Tostada con jamón y tomate', note: 'la clásica, recién hecha' },
			{ name: 'Tostada con fresa y sirope', note: 'la versión dulce de la carta' },
			{ name: 'Wafles con frutos rojos', note: 'con crema y fruta por encima' },
			{ name: 'Tostada de chocolate', note: 'con cacao y toppings, para desayunar con dulce' },
		],
	},
	{
		title: 'Bollería y café',
		items: [
			{ name: 'Croissant clásico', note: 'de mantequilla, recién horneado' },
			{ name: 'Croissant de chocolate', note: 'relleno de chocolate fundido' },
			{ name: 'Croissant de pistacho', note: 'el más recomendado por los clientes' },
			{ name: 'Café de especialidad', note: 'espresso, con leche o en vaso grande' },
			{ name: 'Frappé', note: 'batido de café con hielo y nata o coco' },
		],
	},
	{
		title: 'Batidos y para llevar',
		items: [
			{ name: 'Smoothie de frutos rojos', note: 'con ingredientes frescos, hechos al momento' },
			{ name: 'Zumo de naranja', note: 'exprimido, en vaso de cristal' },
			{ name: 'Batido de café', note: 'la alternativa fría al espresso' },
			{ name: 'Autoservicio', note: 'para recoger sin esperas en hora punta' },
			{ name: 'Entrega sin contacto', note: 'pedidos a través de plataformas de reparto' },
		],
	},
];

const galeria = [
	{ src: maquina, alt: 'Máquina de café de especialidad con el logotipo de Morning Coffee en Málaga' },
	{ src: cartaMesa, alt: 'Mesa de Morning Coffee con la carta y zumo de naranja en Bailén-Miraflores' },
	{ src: croissantPistacho, alt: 'Croissant de pistacho de Morning Coffee, cafetería en Bailén-Miraflores, Málaga' },
	{ src: croissantChocolate, alt: 'Croissant de chocolate de Morning Coffee en Málaga' },
	{ src: croissantPapel, alt: 'Croissant de chocolate con chocolate fundido en Morning Coffee, Málaga' },
	{ src: croissantBatido, alt: 'Croissant con batido de café en Morning Coffee, cafetería en Málaga' },
	{ src: tostadaFresa, alt: 'Tostada con fresa y sirope de Morning Coffee en Bailén-Miraflores' },
	{ src: tostadaChocolate, alt: 'Tostada con chocolate y crema en Morning Coffee, cafetería en Málaga' },
	{ src: tostadaBandeja, alt: 'Tostada de chocolate servida en bandeja en Morning Coffee, Málaga' },
	{ src: tostadaHuevos, alt: 'Tostada con huevos y café en Morning Coffee, desayuno en Málaga' },
	{ src: waffles, alt: 'Wafles con frutos rojos en Morning Coffee, cafetería en Bailén-Miraflores, Málaga' },
	{ src: smoothie, alt: 'Smoothie de frutos rojos en vaso de cristal de Morning Coffee, Málaga' },
	{ src: smoothieIngredientes, alt: 'Smoothie terminado con ingredientes por encima en Morning Coffee, Málaga' },
	{ src: frappe, alt: 'Frappé con coco en Morning Coffee, cafetería en Bailén-Miraflores, Málaga' },
	{ src: cafeFrappe, alt: 'Café con leche y frappé en Morning Coffee, cafetería de desayuno en Málaga' },
	{ src: jamon, alt: 'Jamón serrano servido en Morning Coffee, cafetería en Bailén-Miraflores, Málaga' },
	{ src: cervezas, alt: 'Cervezas del local en Morning Coffee, Bailén-Miraflores, Málaga' },
];

const faqs = [
	{
		q: '¿Dónde está Morning Coffee?',
		a: 'En la avenida de Carlos Haya, 198, en el barrio de Bailén-Miraflores (29010 Málaga). Es una cafetería de desayuno y media mañana, con servicio en barra y mesas en el local.',
	},
	{
		q: '¿Cuál es el horario de Morning Coffee?',
		a: 'Abre todos los días: de lunes a viernes de 8:00 a 14:00, y sábado y domingo de 8:30 a 14:00. Es un local de mañana, así que por la tarde está cerrado.',
	},
	{
		q: '¿Qué se desayuna en Morning Coffee?',
		a: 'Tostas de la casa, tostadas con jamón y tomate, tostada dulce con fresa, waffles con frutos rojos, croissants y café de especialidad. También hay batidos y frapés para las mañanas de calor.',
	},
	{
		q: '¿Tiene takeaway o reparto?',
		a: 'Sí. La ficha indica que hay servicio de comer en el local, autoservicio y entrega sin contacto a través de plataformas de reparto. También se puede pedir directamente por teléfono al 685 01 41 27.',
	},
	{
		q: '¿Qué reseñas tiene Morning Coffee?',
		a: 'La nota media es de 4,9 sobre 49 reseñas, una de las más altas del barrio. Lo que más se repite es el croissant de pistacho, las tostadas y la relación calidad-precio, y varios clientes destacan que lo descubrieron de paso y volvieron.',
	},
	{
		q: '¿Morning Coffee es un local LGBTQ+ friendly?',
		a: 'Sí, así figura en la ficha de Google Maps, que lo marca como amigable con la comunidad LGBTQ+.',
	},
	{
		q: '¿Sirve café para llevar?',
		a: 'Sí, es la modalidad más habitual del local: café expresso, café con leche, frappé y batidos para tomar rápido al pasar por la avenida de Carlos Haya.',
	},
	{
		q: '¿Cómo puedo contactar con Morning Coffee?',
		a: 'Por teléfono en el 685 01 41 27, que es el número que aparece en su ficha de Google Maps, o por el enlace a su ficha en esta misma web. Es la forma más rápida de confirmar productos y horarios en festivos.',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': ['CafeOrCoffeeShop', 'Bakery'],
	'@id': `${business.site}/#negocio`,
	name: business.name,
	alternateName: ['Morning Coffee Málaga', 'Morning Coffee Bailén', 'Morning Coffee Carlos Haya'],
	slogan: 'Tu desayuno en Bailén-Miraflores',
	description,
	url: `${business.site}/`,
	telephone: '+34 685 01 41 27',
	priceRange: '1–10 €',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cafetería', 'Desayunos', 'Bollería', 'Batidos'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Bailén-Miraflores' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	image: `${business.site}/og.jpg`,
	sameAs: [mapsUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:00',
			closes: '14:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '08:30',
			closes: '14:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Desayunos', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Café de especialidad', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Autoservicio', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Entrega sin contacto', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Comer en el local', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Croissant de pistacho', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Morning Coffee · Cafetería de desayuno en Bailén-Miraflores</title>
		<meta name="theme-color" content="#115e59" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="cafetería Bailén-Miraflores, Morning Coffee Málaga, café Carlos Haya, desayuno Málaga, cafetería 29010 Málaga, croissant de pistacho Málaga, tostadas Bailén, wafles Málaga, cafetería Carlos Haya 198, brunch Málaga, café Bailén, desayuno Bailén-Miraflores, cafetería Carlos Haya"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Morning Coffee · Cafetería de desayuno en Bailén-Miraflores, Málaga"
			ogDescription="Tostas, croissants, wafles, batidos y café de especialidad en Av. de Carlos Haya, 198. Abierto todos los días de 8:00 a 14:00. 4,9 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Mesa de Morning Coffee con café y tostada en Bailén-Miraflores, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#115e59"
			street={business.street}
			city={business.city}
			region="Andalucía"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Bailén-Miraflores, Málaga"
			contact={{
				street: business.street,
				locality: business.city,
				region: 'Andalucía',
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[heroImage]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://www.sur-digital.com/morning-coffee-malaga/og.jpg" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7249507;-4.4572812" />
		<meta name="ICBM" content="36.7249507, -4.4572812" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="M"
			name="Morning Coffee"
			subtitle="Cafetería"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Bailén-Miraflores · Málaga"
				title="Tu mañana empieza<br /><em>aquí, con calma.</em>"
				lede="Morning Coffee está en la avenida de Carlos Haya, 198, en Bailén-Miraflores. Una cafetería de desayuno: tostadas de la casa, croissant de pistacho, wafles con frutos rojos, batidos y café de especialidad. Abre todos los días a las ocho de la mañana y cierra a las dos. 4,9 en Google."
				image={heroImage}
				imageAlt="Mesa de Morning Coffee con café y tostada en la avenida de Carlos Haya, Málaga"
				primaryCta={{ label: 'Llamar 685 01 41 27', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,9</b> en Google (49 reseñas)' },
					{ label: 'Horario', html: 'Todos los días, <b>8:00–14:00</b>' },
					{ label: 'Fin de semana', html: 'De 8:30 a 14:00' },
					{ label: 'Especialidad', html: 'Croissant de <b>pistacho</b> y tostadas' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Morning Coffee" items={servicios} />

			<LocalAbout
				label="Cafetería de desayuno"
				title="De las ocho a las dos,<br /><em>sin prisa.</em>"
				paragraphs={[
					'Morning Coffee está en la avenida de Carlos Haya, 198, dentro del barrio de Bailén-Miraflores. El local tiene un horario muy marcado: abre todos los días por la mañana y cierra a las dos, así que la carta está pensada para el desayuno y la media mañana, no para la cena ni para el vermut de la tarde.',
					'El local trabaja con café de especialidad, con una máquina propia y una mezcla seleccionada. A ese café se suman los batidos y los frapés, para las mañanas de calor, y los zumos naturales de naranja y de fruta.',
					'La otra mitad de la carta es la bollería y el desayuno salado: croissants de mantequilla, de chocolate y de pistacho, tostadas de la casa, tostada con jamón y tomate y wafles con frutos rojos. Varios clientes signaler el croissant de pistacho como lo mejor de la carta.',
					'El servicio es de autoservicio, pensado para que las mañanas de más flujo no se ralenticen, y el local también ofrece entrega sin contacto a través de plataformas de reparto. La nota media en Google es de 4,9, de las más altas del barrio.',
				]}
				note="La nota media es de 4,9 sobre 49 reseñas. Lo que más se repite: el croissant de pistacho, la calidad de las tostadas, la relación calidad-precio y el trato del personal. También se destaca que lo descubren de paso y vuelven."
				links={[{ label: 'Ficha y reseñas en Google', href: cidUrl, external: true }]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Tostas, wafles<br /><em>y café.</em>"
				description="Selección de lo que se sirve en Morning Coffee, recogida de las fotos de la ficha de Google Maps y de las reseñas. La carta puede cambiar, así que confírmala en el local o por teléfono."
				cta={{ label: 'Llamar para preguntar', href: phoneHref }}
				groups={grupos}
				note="La carta puede variar con el tiempo, así que llama al 685 01 41 27 si buscas algo concreto."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El café, las tostadas<br /><em>y los croissants.</em>"
				description="Estas fotografías proceden del perfil de Morning Coffee en Google Maps: la máquina de café, la carta sobre la mesa, las tostadas, los croissants y los batidos. En la ficha están todas las fotos y las reseñas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del local en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Av. de Carlos Haya, 198 · 29010 Málaga"
				title="Nos vemos<br /><em>en Bailén.</em>"
				addressLines={[
					business.street,
					business.district,
					`${business.postalCode} ${business.city}, España`,
				]}
				hours={[
					{ day: 'Lunes', value: '8:00–14:00' },
					{ day: 'Martes', value: '8:00–14:00' },
					{ day: 'Miércoles', value: '8:00–14:00' },
					{ day: 'Jueves', value: '8:00–14:00' },
					{ day: 'Viernes', value: '8:00–14:00' },
					{ day: 'Sábado', value: '8:30–14:00' },
					{ day: 'Domingo', value: '8:30–14:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google: de lunes a viernes de 8:00 a 14:00 y sábado y domingo de 8:30 a 14:00. Cierra por la tarde, así que conviene ir por la mañana. Puede variar en festivos."
				mapTitle="Mapa de Morning Coffee en la avenida de Carlos Haya, 198, Bailén-Miraflores, Málaga"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Morning Coffee · Bailén"
				mapHref={cidUrl}
				links={[{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' }]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="No hay reserva en línea: el local es de autoservicio y barra. Para pedidos o grupos, llama al 685 01 41 27."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="M"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Ficha y fotos ↗', href: cidUrl, external: true },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Morning Coffee"
		/>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/morning-coffee-malaga/aviso-legal">Aviso legal</a>
			<a href="/morning-coffee-malaga/aviso-legal#privacidad">Privacidad</a>
			<a href="/morning-coffee-malaga/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>