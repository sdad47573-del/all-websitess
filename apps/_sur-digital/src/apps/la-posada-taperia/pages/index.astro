---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import exterior from '../assets/fotos/la-posada-taperia-vertical-07.jpg';
import solomillo from '../assets/fotos/la-posada-taperia-vertical-05.jpg';
import foie from '../assets/fotos/la-posada-taperia-apaisada-03.jpg';
import carta from '../assets/fotos/la-posada-taperia-vertical-04.jpg';
import lomos from '../assets/fotos/la-posada-taperia-vertical-02.jpg';
import migas from '../assets/fotos/la-posada-taperia-vertical-06.jpg';
import huevos from '../assets/fotos/la-posada-taperia-vertical-08.jpg';
import plancha from '../assets/fotos/la-posada-taperia-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'La Posada Tapería, tapería en la Plaza del Mentidero, 1 (10800 Coria, Cáceres). Tostas, solomillo de toro con romesco, torrezno de Soria y ensaladilla de pulpo. Cocina de 12:00 a 2:00, cerrado lunes. Reservas en el 607 57 44 16.';

const galeria = [
	{ src: solomillo, alt: 'Solomillo de toro con salsa romesco y pimientos de piquillo en La Posada Tapería, Coria' },
	{ src: exterior, alt: 'Fachada de Tapería La Posada en la Plaza del Mentidero de Coria, con la torre al fondo' },
	{ src: foie, alt: 'Tapa de foie con tomate seco y reducción balsámica, servida con cesto de pan en La Posada Tapería' },
	{ src: carta, alt: 'Carta de La Posada Tapería: tostas y novedades con sus precios, fotografiada en la ficha de Google' },
	{ src: migas, alt: 'Cazuela de migas con huevo frito encima, servida en La Posada Tapería de Coria' },
	{ src: lomos, alt: 'Tapa de carne a la plancha con queso fundido sobre patatas en La Posada Tapería' },
	{ src: huevos, alt: 'Migas con dos huevos fritos en cazuela de hierro, en La Posada Tapería de Coria' },
	{ src: plancha, alt: 'Filetes a la plancha con queso fundido y tomates asados en La Posada Tapería' },
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#posada`,
	name: BUSINESS.name,
	alternateName: ['La Posada Tapería Coria', 'Tapería La Posada', 'La Posada Coria'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 607 57 44 16',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Tapas', 'Extremeña', 'Mediterránea'],
	areaServed: [
		{ '@type': 'City', name: 'Coria' },
		{ '@type': 'AdministrativeArea', name: 'Cáceres' },
		{ '@type': 'AdministrativeArea', name: 'Extremadura' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId }],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '02:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Mesas en la plaza', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Raciones muy generosas, riquísimas y muy buena atención, muy recomendable.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Comimos una paella estupenda y solomillo al ajo tostado buenísimo.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La tapería', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'La Posada Tapería · Tapas en la Plaza del Mentidero (Coria)';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#6d3324" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Posada Tapería, tapería Coria, tapas Coria, Plaza del Mentidero, restaurante Coria Cáceres, tostas Coria, solomillo de toro, menú Coria centro, tapas Cáceres"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="La Posada Tapería · Tapas en la Plaza del Mentidero (Coria)"
			ogDescription="Tostas, solomillo de toro con romesco y ensaladilla de pulpo en la Plaza del Mentidero, 1 (Coria). 4,4 en Google con 1.055 reseñas. Cocina de 12:00 a 2:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Solomillo de toro con salsa romesco y pimientos de piquillo en La Posada Tapería, Coria"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#6d3324"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			postalCode={BUSINESS.postalCode}
			phone="+34607574416"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[solomillo]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/la-posada-taperia/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Posada Tapería"
			subtitle="Tapas · Coria"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Plaza del Mentidero · Coria"
				title="Tostas y tapas<br /><em>en la plaza.</em>"
				lede={`La Posada Tapería está en la Plaza del Mentidero, 1, en pleno centro de Coria. Tostas, solomillo de toro con romesco y ensaladilla de pulpo, con mesas en la plaza y cocina de 12:00 a 2:00. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={solomillo}
				imageAlt="Solomillo de toro con salsa romesco y pimientos de piquillo en La Posada Tapería, Coria"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)` },
					{ label: 'Horario', html: 'Mar–Dom 12:00–2:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phoneDisplay}</b>` },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece La Posada Tapería" items={SERVICIOS} />

			<LocalAbout
				label="La tapería"
				title="La plaza, la carta<br /><em>y el horno.</em>"
				paragraphs={[
					`La Posada Tapería se levanta en la Plaza del Mentidero, 1, del casco histórico de Coria (10800), con la torre asomando por detrás de la fachada tal y como se ve en sus fotos de Google. Mesas fuera, en la plaza, y barra de tapas dentro.`,
					'Su carta de tostas —Rociera, Extremeña, Griega y Mentidero— convive con novedades como el solomillo de toro con salsa romesco y pimientos de piquillo, el torrezno de Soria con pimentón o la ensaladilla de pulpo al pimentón.',
					'Las reseñas lo resumen en dos frases: «raciones muy generosas, riquísimas y muy buena atención» y «una paella estupenda y solomillo al ajo tostado buenísimo». La ficha no ofrece reserva online: se llama y se queda la mesa.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Se repiten las raciones generosas, la buena atención y platos como la paella y el solomillo.`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.cid, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Tostas, solomillo<br /><em>y torrezno.</em>"
				description="Precios tomados de la carta que la propia ficha de Google Maps tiene fotografiada: tostas, novedades y lo de siempre. Sin sorpresas ni datos inventados."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La carta puede cambiar y las fotos de la ficha pueden tardar en actualizarse: si buscas un plato concreto, llama antes y te lo confirman. El cesto de pan son 2 €."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La plaza,<br /><em>los platos y la carta.</em>"
				description="Estas fotografías proceden del perfil de La Posada Tapería en Google Maps: la fachada en la Plaza del Mentidero, los platos de la casa y la carta con sus precios."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Nos vemos<br /><em>en la plaza.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google. El cierre de las 2:00 es de madrugada, ya en el día siguiente; el lunes el local permanece cerrado."
				mapTitle="Mapa de La Posada Tapería en la Plaza del Mentidero, 1, Coria (Cáceres)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Posada Tapería · Coria"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva llamando al 607 57 44 16. La ficha de Google marca aseo y asientos adaptados. Está en la Plaza del Mentidero, en el centro de Coria, con mesas en la plaza."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.cid, external: true },
				{ label: 'Aviso legal', href: '/la-posada-taperia/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a La Posada"
		/>
	</body>
</html>
