---
import { Image } from 'astro:assets';
import '../styles/global.css';
import { fotos } from '../data/fotos';

const business = {
	name: 'Bar La Tahona',
	short: 'La Tahona',
	area: 'El Palmar · Conil',
	city: 'Vejer de la Frontera / Conil',
	latitude: 36.276458,
	longitude: -6.0880376,
	site: 'https://www.sur-digital.com/bar-la-tahona',
};

const mapsUrl =
	'https://www.google.com/maps/place/Bar+La+Tahona/@36.276458,-6.0880376,17z/data=!3m1!4b1!4m9!3m8!1s0xd0c381f4b28c015:0x1503d91dbb97a883!5m2!4m1!1i2!8m2!3d36.276458!4d-6.0880376!16s%2Fg%2F11c1rsyxnc?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=15&output=embed`;

const specialties = [
	{
		kicker: 'De barrio',
		title: 'El bar de siempre',
		text: 'Bar de trato cercano para desayunos, tapas y raciones del día.',
	},
	{
		kicker: 'Para picar',
		title: 'Tapas y raciones',
		text: 'Lo propio de un bar gaditano: para picar algo sin complicaciones.',
	},
	{
		kicker: 'Por la mañana',
		title: 'Desayunos',
		text: 'Parada natural para desayunar en la zona de El Palmar y Conil.',
	},
	{
		kicker: 'Al aire',
		title: 'Terraza',
		text: 'Para tomar algo al aire cuando acompaña el tiempo.',
	},
	{
		kicker: 'En ruta',
		title: 'Palmar y Conil',
		text: 'En la costa entre El Palmar de Vejer y Conil de la Frontera.',
	},
	{
		kicker: 'Confirma',
		title: 'Ficha de Maps',
		text: 'Dirección, teléfono y horario: consúltalos en su ficha de Google Maps.',
	},
];

const faqs = [
	{
		q: '¿Dónde está Bar La Tahona?',
		a: 'En las coordenadas 36.276458, -6.0880376, en la costa entre El Palmar de Vejer y Conil, según su ficha de Google Maps.',
	},
	{
		q: '¿Cuál es la dirección exacta, el teléfono o el horario?',
		a: 'No hay fuente verificable y no los inventamos: míralos en su ficha de Google Maps y confirma allí antes de venir.',
	},
	{
		q: '¿Qué se puede tomar?',
		a: 'Bar de tapas y raciones. Confirma la oferta del día en el propio local.',
	},
	{
		q: '¿Cómo llego?',
		a: 'Usa el botón «Cómo llegar» para abrir la ruta en Google Maps con las coordenadas de su ficha.',
	},
];

const description =
	'Bar La Tahona: bar en la costa entre El Palmar de Vejer y Conil (36.276458, -6.0880376). Tapas y raciones. Consulta dirección y horario en su ficha de Maps.';

const placeSchema = {
	'@context': 'https://schema.org',
	'@type': 'BarOrPub',
	'@id': `${business.site}/#bar`,
	name: business.name,
	description,
	url: `${business.site}/`,
	image: [`${business.site}/fotos/barra.svg`],
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española'],
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="Bar La Tahona: bar entre El Palmar y Conil (36.276458, -6.0880376). Tapas y raciones. Consulta su ficha de Maps." />
		<meta name="keywords" content="Bar La Tahona, bar El Palmar, bar Conil, tapas Cádiz" />
		<meta name="author" content="Bar La Tahona" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/bar-la-tahona/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>La Tahona | Bar entre El Palmar y Conil</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="La Tahona · Bar entre El Palmar y Conil" />
		<meta property="og:description" content="Tapas y raciones en la costa gaditana. Consulta su ficha de Maps." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/barra.svg`} />
		<meta property="og:image:alt" content="Bar La Tahona, costa de Cádiz" />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="La Tahona · Bar entre El Palmar y Conil" />
		<meta name="twitter:description" content="Tapas y raciones en la costa gaditana." />
		<meta name="twitter:image" content={`${business.site}/fotos/barra.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(placeSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.position" content="36.276458;-6.0880376" />
		<meta name="ICBM" content="36.276458, -6.0880376" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="La Tahona, inicio">
				<span class="brand-mark" aria-hidden="true">LT</span>
				<span class="brand-name">La Tahona <small>El Palmar · Conil</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#bar">El bar</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={mapsUrl} target="_blank" rel="noreferrer">Ver en Maps ↗</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Costa de Cádiz · El Palmar – Conil</p>
					<h1 id="hero-title">El bar<br />de <em>la costa.</em></h1>
					<p class="hero-lede">
						Bar La Tahona: bar en la costa entre El Palmar de Vejer y Conil.
						No publicamos dirección, teléfono ni horario por falta de fuente verificable:
						consúltalos en su ficha de Google Maps.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Maps ↗</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>Bar</b> de costa</li>
						<li>Tapas y raciones</li>
						<li>El Palmar – Conil</li>
						<li>Ver ficha de Maps</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image src={fotos[0].src} alt={fotos[0].alt} fetchpriority="high" />
					<figcaption>
						<span>36.276458, -6.0880376</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>Bar</b><span>De costa</span></div>
					<div><b>Tapa</b><span>Y ración</span></div>
					<div><b>Maps</b><span>Ficha</span></div>
				</div>
				<ul class="services">
					<li>Tapas</li>
					<li>Raciones</li>
					<li>Desayunos</li>
					<li>Terraza</li>
					<li>Barrio</li>
					<li>Costa</li>
				</ul>
			</section>

			<section class="about section-pad" id="bar">
				<p class="section-label"><span aria-hidden="true"></span> El bar</p>
				<div class="about-grid">
					<h2>Sin inventar<br /><em>nada.</em></h2>
					<div class="about-copy">
						<p>
							Bar La Tahona figura en Google Maps en las coordenadas 36.276458, -6.0880376,
							en la costa entre El Palmar de Vejer y Conil de la Frontera.
						</p>
						<p>
							Más allá del nombre y la ubicación de su ficha no hay dirección postal, teléfono ni
							horario verificables, así que no los publicamos: esta web es una base honesta que el
							titular puede completar en minutos.
						</p>
						<p class="about-note">
							Si eres el titular, pásanos dirección, teléfono y horario y los publicamos con su
							schema correspondiente, junto a tus fotos.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales de un bar gaditano. Confirma la oferta del día
						en el propio bar.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El bar<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Fotos del perfil público del bar en Google Maps: el interior y los platos que salen de su
							cocina. Las imágenes pertenecen a sus autores; si eres el titular y quieres retirar alguna,
							escríbenos y la quitamos.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{fotos.map((foto, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<Image src={foto.src} alt={foto.alt} loading="lazy" />
							<figcaption>{foto.pie}</figcaption>
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el
					titular y quieres retirar alguna, escríbenos y la quitamos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> 36.276458, -6.0880376</p>
					<h2>Ven al bar<br /><em>a tomar algo.</em></h2>
					<p class="address">
						Costa entre El Palmar de Vejer y Conil<br />
						Coords 36.276458, -6.0880376
					</p>

					<p class="hours-note">Dirección, teléfono y horario sin fuente verificable. Míralos en su ficha de Google Maps.</p>

					<div class="visit-links">
						<a class="button button-ember" href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Maps ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de Bar La Tahona, costa El Palmar-Conil" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> La Tahona · Costa</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">LT</span>
				<p>La Tahona<small>Costa El Palmar – Conil</small></p>
			</div>
			<nav aria-label="Enlaces del bar">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
			</nav>
			<small>© {new Date().getFullYear()} La Tahona · Conil de la Frontera. Fotos del perfil público en Google Maps.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/bar-la-tahona/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/bar-la-tahona/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/bar-la-tahona/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

	</body>
</html>
