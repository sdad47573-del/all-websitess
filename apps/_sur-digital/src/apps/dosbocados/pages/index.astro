---
import '../styles/global.css';

const business = {
	name: 'dosbocados',
	stand: 'Puesto nº 107',
	market: 'Mercado Central de Abastos',
	street: 'Pl. Libertad',
	city: 'Cádiz',
	postalCode: '11005',
	phone: '+34 670 75 08 37',
	email: 'alecanguas@yahoo.es',
	latitude: 36.5303627,
	longitude: -6.2981077,
	site: 'https://www.sur-digital.com/dosbocados',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+dosbocados/@36.5303627,-6.2981077,17z/data=!3m1!4b1!4m6!3m5!1s0xd0dd161cffe80c7:0xfa0cc3070609127a!8m2!3d36.5303627!4d-6.2981077!16s%2Fg%2F11hb5vbdls?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const phoneHref = 'tel:+34670750837';
const facebookUrl = 'https://www.facebook.com/DosBocadosCadiz/';
const instagramUrl = 'https://www.instagram.com/dosbocadoscadiz/';

const specialties = [
	{
		kicker: 'El rey',
		title: 'Tarantelo de atún',
		text: 'El producto estrella según Tripadvisor: tarantelo de atún con producto del mercado, elaborado a diario.',
	},
	{
		kicker: 'Fríos y calientes',
		title: 'Salmón con guacamole',
		text: 'Emparedado de salmón con guacamole en pan de pimienta y chile. Una decena de rellenos que van rotando.',
	},
	{
		kicker: 'Tres quesos',
		title: 'Gouda, azul y gruyère',
		text: 'Con rúcula y nueces dentro de pan de semillas de amapola. De los más pedidos por sus seguidores.',
	},
	{
		kicker: 'En pan gallego',
		title: 'Carrillada y chicharrones',
		text: 'Montaditos en pequeñas piezas de pan gallego: chicharrones con queso, carrillada en salsa, salchichas al vino o atún con crema.',
	},
	{
		kicker: 'Verde',
		title: 'Espinacas con bacon',
		text: 'Crema de espinacas con bacon dentro de pan aromatizado con cebolla. Original y casero.',
	},
	{
		kicker: 'Para llevar',
		title: 'Bandeja de 6',
		text: 'Bandejas surtidas con seis emparedados de distintos sabores para tomar en las mesas altas o llevar.',
	},
];

const gallery = [
	{ src: '/dosbocados/fotos/puesto.svg', alt: 'Ilustración del puesto nº 107 de dosbocados — sustituye por foto propia' },
	{ src: '/dosbocados/fotos/montadito.svg', alt: 'Ilustración de montaditos en pan gallego — sustituye por foto propia' },
	{ src: '/dosbocados/fotos/sandwich.svg', alt: 'Ilustración de emparedados fríos y calientes — sustituye por foto propia' },
	{ src: '/dosbocados/fotos/tres-quesos.svg', alt: 'Ilustración del emparedado de tres quesos — sustituye por foto propia' },
	{ src: '/dosbocados/fotos/bandeja.svg', alt: 'Ilustración de la bandeja surtida de 6 — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está dosbocados?',
		a: 'En el puesto nº 107 del Mercado Central de Abastos, Pl. Libertad, 11005 Cádiz, con mesas altas en su entorno.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Horario de mercado al mediodía, hacia las 12:30–15:30. Según Turismo Cádiz abre de martes a domingo; publicaciones recientes hablan de martes a sábado. Confirma en el 670 75 08 37 antes de ir.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'Es un puesto de mercado para comer allí o llevar. Llama al 670 75 08 37 para consultar disponibilidad del día.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Comida casera en formato original: montaditos, sandwiches y hamburguesas. Una decena de rellenos rotativos: salmón con guacamole, tres quesos, carrillada, chicharrones con queso, salchichas al vino, atún con crema y el famoso tarantelo de atún.',
	},
	{
		q: '¿Se puede llevar?',
		a: 'Sí: bandejas surtidas con seis emparedados de distintos sabores para llevar, además de comer en el puesto.',
	},
];

const description =
	'dosbocados: montaditos, sandwiches y tarantelo de atún en el puesto 107 del Mercado Central, Pl. Libertad (Cádiz). Comida casera al mediodía. Tel. 670 75 08 37.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: 'Restaurante dosbocados',
	alternateName: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 670 75 08 37',
	email: business.email,
	image: [`${business.site}/fotos/puesto.svg`],
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Tapas', 'Montaditos', 'Casera', 'Mediterránea'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: `${business.market}, ${business.stand} (${business.street})`,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [facebookUrl, instagramUrl],
	acceptsReservations: 'False',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:30',
			closes: '15:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.8,
		reviewCount: 245,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#4a2415" />
		<meta name="description" content="dosbocados: montaditos, sandwiches y tarantelo de atún en el puesto 107 del Mercado Central, Pl. Libertad (Cádiz). Comida casera al mediodía. 670 75 08 37." />
		<meta name="keywords" content="dosbocados Cádiz, Mercado Central Cádiz comer, montaditos Cádiz, tarantelo atún Cádiz, sandwiches mercado abastos, puesto 107 mercado Cádiz" />
		<meta name="author" content="dosbocados" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/dosbocados/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>dosbocados | Montaditos y tarantelo en el Mercado de Cádiz</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="dosbocados · Montaditos caseros en el Mercado Central" />
		<meta property="og:description" content="Tarantelo de atún, tres quesos, carrillada y bandejas surtidas en el puesto 107 del Mercado Central, Cádiz. 4,8 en Tripadvisor." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/puesto.svg`} />
		<meta property="og:image:alt" content="dosbocados, rincón gastronómico en el Mercado Central de Cádiz" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="dosbocados · Montaditos caseros en el Mercado de Cádiz" />
		<meta name="twitter:description" content="Montaditos, sandwiches y tarantelo de atún en el Mercado Central, Cádiz." />
		<meta name="twitter:image" content={`${business.site}/fotos/puesto.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Cádiz" />
		<meta name="geo.position" content="36.5303627;-6.2981077" />
		<meta name="ICBM" content="36.5303627, -6.2981077" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="dosbocados, inicio">
				<span class="brand-mark" aria-hidden="true">2b</span>
				<span class="brand-name">dosbocados <small>Mercado Central · Cádiz</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#puesto">El puesto</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>670 75 08 37</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Puesto nº 107 · Mercado Central</p>
					<h1 id="hero-title">Comida casera<br />en formato <em>original.</em></h1>
					<p class="hero-lede">
						Rincón gastronómico del Mercado Central: montaditos, sandwiches y el famoso tarantelo de atún,
						con producto del mercado elaborado a diario. Para comer allí o llevar.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a class="button button-ghost" href={phoneHref}>Llamar 670 75 08 37</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,8</b> en Tripadvisor</li>
						<li>Mediodía</li>
						<li>Bandeja de 6</li>
						<li>Para llevar</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/dosbocados/fotos/puesto.svg" alt="Ilustración del puesto nº 107 de dosbocados en el Mercado Central de Cádiz" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Mercado Central · Cádiz</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>4,8</b><span>Tripadvisor</span></div>
					<div><b>~10</b><span>Rellenos/día</span></div>
					<div><b>6</b><span>Bandeja surtida</span></div>
				</div>
				<ul class="services">
					<li>Mercado</li>
					<li>Montaditos</li>
					<li>Sandwiches</li>
					<li>Tarantelo</li>
					<li>Mesas altas</li>
					<li>Para llevar</li>
				</ul>
			</section>

			<section class="about section-pad" id="puesto">
				<p class="section-label"><span aria-hidden="true"></span> Un rincón del mercado</p>
				<div class="about-grid">
					<h2>Pequeños bocadillos<br />con producto <em>del mercado.</em></h2>
					<div class="about-copy">
						<p>
							dosbocados es el puesto nº 107 del Mercado Central de Abastos de Cádiz. Se dedica a pequeños
							bocadillos con distintos panes: cada día prepara una decena de rellenos y propuestas entre
							montaditos y sandwiches, que van variando.
						</p>
						<p>
							Entre sus creaciones: salmón con guacamole en pan de pimienta y chile, crema de espinacas con
							bacon en pan de cebolla, tres quesos con rúcula y nueces en pan de amapola, y montaditos en
							pan gallego de chicharrones con queso, carrillada, salchichas al vino o atún con crema.
						</p>
						<p class="about-note">
							Se come en el propio puesto, con mesas altas en su entorno, o en bandejas surtidas de seis para
							llevar. Horario de mercado al mediodía: confirma el día en el 670 75 08 37.
						</p>
						<div class="about-links">
							<a class="simple-link" href={facebookUrl} target="_blank" rel="noreferrer">Facebook del puesto <span aria-hidden="true">↗</span></a>
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">Instagram <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su carta</p>
						<h2>Lo que más<br />se pide <em>en el puesto.</em></h2>
					</div>
					<p>
						Creaciones citadas por Turismo Cádiz y las reseñas de sus clientes. Los rellenos rotan a diario:
						confirma disponibilidad al llamar.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El puesto<br /><em>y sus bocados.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del puesto.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Mercado Central · Puesto nº 107</p>
					<h2>Ven al mercado<br /><em>a picar.</em></h2>
					<p class="address">
						{business.market}, {business.stand}<br />
						{business.street}, {business.postalCode} {business.city}
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Martes a domingo</th>
								<td>12:30 – 15:30</td>
							</tr>
							<tr>
								<th scope="row">Lunes</th>
								<td>Cerrado</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Horario según Turismo Cádiz; publicaciones recientes hablan de martes a sábado. Al ser horario de mercado, llama antes de ir: {business.phone}.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al puesto ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 670 75 08 37</a>
					<p class="hours-note">Escríbeles también a <a class="phone-link" href={`mailto:${business.email}`}>{business.email}</a></p>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de dosbocados en el Mercado Central, puesto 107, Cádiz" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> dosbocados · Cádiz</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">2b</span>
				<p>dosbocados<small>Mercado Central · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del puesto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} dosbocados · Cádiz. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/dosbocados/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/dosbocados/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/dosbocados/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al puesto <span>670 75 08 37</span></a>
	</body>
</html>
