---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
	} from '@astro-components';

import mesaPuesta from '../assets/fotos/restaurante-el-rocio-apaisada-01.jpg';
import mejillones from '../assets/fotos/restaurante-el-rocio-apaisada-02.jpg';
import patatasAlioli from '../assets/fotos/restaurante-el-rocio-apaisada-03.jpg';
import menuDia from '../assets/fotos/restaurante-el-rocio-apaisada-04.jpg';
import entrecot from '../assets/fotos/restaurante-el-rocio-apaisada-05.jpg';
import almejas from '../assets/fotos/restaurante-el-rocio-apaisada-06.jpg';
import potaje from '../assets/fotos/restaurante-el-rocio-apaisada-07.jpg';
import arrozConejo from '../assets/fotos/restaurante-el-rocio-apaisada-08.jpg';
import gambasAjillo from '../assets/fotos/restaurante-el-rocio-apaisada-09.jpg';
import calamares from '../assets/fotos/restaurante-el-rocio-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
	REVIEWS
} from '../data/site';

const description =
	'Restaurante "El Rocío" en Fortuna (Murcia): cocina española, arroces, carnes a la brasa y raciones generosas en la Avenida Narciso Yepes, 22. De lunes a sábado, de 9:00 a 18:00. Reservas en el 868 68 03 03.';

const galeria = [
	{
		src: mesaPuesta,
		alt: 'Mesa preparada con la carta de Restaurante El Rocío y el cartel de reservado, en Fortuna (Murcia)',
	},
	{
		src: arrozConejo,
		alt: 'Arroz con conejo y caracoles en paella de Restaurante El Rocío, Fortuna',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la brasa con patatas y pimientos de Padrón en Restaurante El Rocío, Fortuna',
	},
	{
		src: mejillones,
		alt: 'Mejillones al vapor en cazuela de barro con limón, Restaurante El Rocío',
	},
	{
		src: almejas,
		alt: 'Almejas a la marinera en cazuela de barro, Restaurante El Rocío (Fortuna)',
	},
	{
		src: gambasAjillo,
		alt: 'Gambas al ajillo en cazuela de barro, Restaurante El Rocío (Fortuna, Murcia)',
	},
	{
		src: calamares,
		alt: 'Calamares a la plancha con ensalada, limón y salsa verde en Restaurante El Rocío',
	},
	{
		src: potaje,
		alt: 'Potaje de alubias con chorizo y morcilla de Restaurante El Rocío, Fortuna',
	},
	{
		src: patatasAlioli,
		alt: 'Patatas fritas en cuenco con alioli aparte, Restaurante El Rocío (Fortuna)',
	},
	{
		src: menuDia,
		alt: 'Menú del día de Restaurante El Rocío: sopa, pollo con patatas, ensalada, postre, pan y café',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	acceptsReservations: true,
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['El Rocío Fortuna', 'Restaurante El Rocio', 'El Rocío Murcia'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	telephone: '+34 868 68 03 03',
	priceRange: BUSINESS.priceRange,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Murciana', 'Arroces'],
	areaServed: [
		{ '@type': 'City', name: 'Fortuna' },
		{ '@type': 'AdministrativeArea', name: 'Región de Murcia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId }],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '09:00',
			closes: '18:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Reserva por teléfono', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El restaurante', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title =
	'Restaurante "El Rocío" · Cocina española en Fortuna, Murcia';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-el-rocio-apaisada-01.jpg": mesaPuesta,
	"restaurante-el-rocio-apaisada-08.jpg": arrozConejo,
	"restaurante-el-rocio-apaisada-05.jpg": entrecot,
	"restaurante-el-rocio-apaisada-02.jpg": mejillones,
	"restaurante-el-rocio-apaisada-06.jpg": almejas,
	"restaurante-el-rocio-apaisada-09.jpg": gambasAjillo,
	"restaurante-el-rocio-apaisada-10.jpg": calamares,
	"restaurante-el-rocio-apaisada-07.jpg": potaje,
	"restaurante-el-rocio-apaisada-03.jpg": patatasAlioli,
	"restaurante-el-rocio-apaisada-04.jpg": menuDia,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#8d2b2b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante El Rocío Fortuna, El Rocío Fortuna Murcia, restaurante Fortuna, cocina española Fortuna, arroz con conejo y caracoles, paella Fortuna, carnes a la brasa Murcia, menú del día Fortuna, Avenida Narciso Yepes, reservar restaurante Fortuna"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Restaurante El Rocío · Cocina española en Fortuna, Murcia"
			ogDescription="Cocina española, arroces y carnes a la brasa en la Av. Narciso Yepes, 22 (Fortuna). De lunes a sábado, 9:00–18:00. 4,4 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Mesa preparada con la carta de Restaurante El Rocío, en Fortuna (Murcia)"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#8d2b2b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			postalCode={BUSINESS.postalCode}
			phone="+34868680303"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`Fortuna, ${BUSINESS.regionName}`}
			preload={[mesaPuesta]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/restaurante-el-rocio/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Rocío"
			subtitle="Cocina española · Fortuna"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
				reviews={REVIEWS}
				googleMaps={MAPS.place}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.cid, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a El Rocío"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34868680303?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Fortuna." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Fortuna"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
