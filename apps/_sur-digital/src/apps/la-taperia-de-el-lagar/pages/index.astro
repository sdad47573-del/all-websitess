---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import plaza from '../assets/fotos/la-taperia-de-el-lagar-apaisada-05.jpg';
import plancha from '../assets/fotos/la-taperia-de-el-lagar-cuadrada-07.jpg';
import salon from '../assets/fotos/la-taperia-de-el-lagar-apaisada-01.jpg';
import ensalada from '../assets/fotos/la-taperia-de-el-lagar-apaisada-02.jpg';
import atun from '../assets/fotos/la-taperia-de-el-lagar-vertical-06.jpg';
import arroz from '../assets/fotos/la-taperia-de-el-lagar-vertical-09.jpg';
import brownie from '../assets/fotos/la-taperia-de-el-lagar-vertical-08.jpg';
import postreNaranja from '../assets/fotos/la-taperia-de-el-lagar-vertical-04.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Restaurante La Taperia de El Lagar, en la C. Humilladero, 30 (10860 Gata, Cáceres). Tapas y postres caseros, de 8:00 a 24:00. Tel. 678 43 88 12.';

const galeria = [
	{ src: plancha, alt: 'Carne a la plancha con patatas fritas y pimientos asados, servida en El Lagar de Gata' },
	{ src: plaza, alt: 'Plaza porticada de Gata con sombrillas y casas con enredaderas, en el casco del pueblo' },
	{ src: ensalada, alt: 'Ensalada de hojas con huevo de codorniz, granada y frutos rojos en El Lagar, Gata' },
	{ src: salon, alt: 'Salón de El Lagar con las mesas montadas para una comida de grupo en Gata (Cáceres)' },
	{ src: atun, alt: 'Lonchas de atún sellado emplatadas con salsa y toques verdes en Restaurante La Taperia de El Lagar' },
	{ src: arroz, alt: 'Arroz meloso servido en plato hondo en Restaurante La Taperia de El Lagar, Gata' },
	{ src: brownie, alt: 'Brownie con helado de vainilla y salsa de chocolate emplatado en El Lagar de Gata' },
	{ src: postreNaranja, alt: 'Postre de naranja y crema emplatado con su punto de salsa en El Lagar, Gata' },
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#lagar`,
	name: BUSINESS.name,
	alternateName: ['La Taperia de El Lagar', 'El Lagar Gata', 'Tapería El Lagar Gata'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 678 43 88 12',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Gata' },
		{ '@type': 'AdministrativeArea', name: 'Cáceres' },
		{ '@type': 'AdministrativeArea', name: 'Extremadura' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId }],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Friday', 'Saturday', 'Sunday'],
			opens: '08:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday'],
			opens: '08:00',
			closes: '17:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Salón para grupos', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Buen sitio, buena gente y buen ambiente.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 4, bestRating: 5 },
			reviewBody: 'Los postres caseros muy recomendables, sobre todo la tarta de galleta.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La tapería', href: '#casa' },
	{ label: 'La cocina', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'La Taperia de El Lagar · Tapas en Gata (Cáceres)';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#6d3324" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Taperia de El Lagar, El Lagar Gata, tapería Gata Cáceres, tapas Gata, restaurante Gata, C. Humilladero, comida Gata, postres caseros"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="La Taperia de El Lagar · Tapas en Gata (Cáceres)"
			ogDescription="Tapas, carne a la plancha y postres caseros en la C. Humilladero, 30 (Gata, Cáceres). 4,3 en Google con 346 reseñas. Abierto desde las 8:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Carne a la plancha con patatas y pimientos asados en Restaurante La Taperia de El Lagar"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#6d3324"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			postalCode={BUSINESS.postalCode}
			phone="+34678438812"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[plancha]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/la-taperia-de-el-lagar/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Taperia de El Lagar"
			subtitle="Tapas · Gata"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Humilladero · Gata"
				title="Tapas, brasa<br /><em>y postres de casa.</em>"
				lede={`La Taperia de El Lagar está en la C. Humilladero, 30, de Gata (Cáceres). Tapas, carne a la plancha, arroces y los postres caseros que sus reseñas recomienden. Abierto desde las 8:00; reservas en el ${BUSINESS.phoneDisplay}.`}
				image={plancha}
				imageAlt="Carne a la plancha con patatas fritas y pimientos asados, servida en El Lagar de Gata"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)` },
					{ label: 'Horario', html: 'Mar–Jue 8:00–17:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phoneDisplay}</b>` },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece La Taperia de El Lagar" items={SERVICIOS} />

			<LocalAbout
				label="La tapería"
				title="Bar de pueblo<br /><em>con cocina.</em>"
				paragraphs={[
					`La Taperia de El Lagar está en la Calle del Humilladero, 30, del 10860 Gata (Cáceres), el pueblo de la comarca que lleva su nombre. Su ficha lo clasifica como «restaurante especializado en tapas» y su gente lo resume como «buen sitio, buena gente y buen ambiente».`,
					'La cocina pasa de las 8:00 de la mañana a medianoche los lunes, viernes, sábado y domingo —de martes a jueves hasta las 17:00—: tapas para picar, carne a la plancha con patatas y pimientos, arroces y postres caseros.',
					'La tarta de galleta es su estrella: «los postres caseros muy recomendables, sobre todo la tarta de galleta», escribe una reseña. La ficha no publica carta ni precios, así que aquí no se inventan: se consultan en el local.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Se repiten el ambiente del local y los postres caseros.`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.cid, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La cocina"
				title="Plancha, arroces<br /><em>y tarta de galleta.</em>"
				description="Resumen de lo que publica su ficha de Google: lo que nombran las reseñas y lo que se ve en las fotos del perfil. Sin precios, porque la ficha no los tiene publicados."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La pizarra cambia según el día. Si vienes por un plato concreto —la tarta de galleta, la plancha, un arroz—, llama antes al 678 43 88 12 y te lo confirman."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La plancha,<br /><em>la ensalada y el postre.</em>"
				description="Estas fotografías proceden del perfil de Restaurante La Taperia de El Lagar en Google Maps: carne a la plancha, ensalada, atún, arroces, postres y el salón montado para grupos."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Nos vemos<br /><em>en el Humilladero.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google. Los lunes, viernes, sábado y domingo abre de 8:00 a 24:00; de martes a jueves, de 8:00 a 17:00. Para la cocina, conviene llamar antes."
				mapTitle="Mapa de Restaurante La Taperia de El Lagar en la C. Humilladero, 30, Gata (Cáceres)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Taperia de El Lagar · Gata"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva llamando al 678 43 88 12. La ficha de Google marca asientos adaptados. Está en la Calle del Humilladero, en el casco de Gata (10860), con salón para comidas de grupo."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.cid, external: true },
				{ label: 'Aviso legal', href: '/la-taperia-de-el-lagar/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a El Lagar"
		/>
	</body>
</html>
