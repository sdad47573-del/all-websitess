---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/el-fogon-de-begona-apaisada-04.jpg';
import vitrina from '../assets/fotos/el-fogon-de-begona-apaisada-03.jpg';
import vitrinaDos from '../assets/fotos/el-fogon-de-begona-apaisada-05.jpg';
import vitrinaTres from '../assets/fotos/el-fogon-de-begona-apaisada-06.jpg';
import pizarraMenu from '../assets/fotos/el-fogon-de-begona-apaisada-08.jpg';
import rotulo from '../assets/fotos/el-fogon-de-begona-vertical-01.jpg';
import paellas from '../assets/fotos/el-fogon-de-begona-vertical-02.jpg';
import pizarraDia from '../assets/fotos/el-fogon-de-begona-vertical-07.jpg';
import cartelTortillas from '../assets/fotos/el-fogon-de-begona-vertical-09.jpg';
import mural from '../assets/fotos/el-fogon-de-begona-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'El Fogón de Begoña · Comida casera en San Blas-Canillejas';
const description =
	'El Fogón de Begoña, en C. de Lucas Mallada, 3 (San Blas-Canillejas, 28037 Madrid). Comida casera, pollo asado y menú del día. De 10:00 a 16:30 y de 19:00 a 22:00.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de ladrillo de El Fogón de Begoña con el mural de la granja, el toldo y el rótulo de comida casera',
	},
	{
		src: vitrina,
		alt: 'La vitrina de El Fogón de Begoña con bandejas de sopa, pollo a la gallega, ensaladas y guisos',
	},
	{
		src: vitrinaDos,
		alt: 'Otra vitrina con bandejas de rabo de toro, guisos y postres de El Fogón de Begoña',
	},
	{
		src: vitrinaTres,
		alt: 'Bandejas de jamón asado, rabo de toro, callos y codillo en la vitrina de El Fogón de Begoña',
	},
	{
		src: pizarraMenu,
		alt: 'La pizarra del menú del día con primeros, segundos, especialidades y bocadillos',
	},
	{
		src: rotulo,
		alt: 'El rótulo verde de El Fogón de Bego con «Comida para llevar y a domicilio»',
	},
	{
		src: paellas,
		alt: 'Tres paellas de El Fogón de Begoña: marinera, arroz negro y mixta',
	},
	{
		src: pizarraDia,
		alt: 'Las pizarras de platos del día, grupos A y B, con ensaladas, primeros y segundos',
	},
	{
		src: cartelTortillas,
		alt: 'El cartel de tortillas rellenas de El Fogón de Begoña',
	},
	{
		src: mural,
		alt: 'El mural de la granja en la fachada de El Fogón de Begoña',
	},
];

const precioNumerico = (price) => price?.replace(/[^\d,]/g, '').replace(',', '.');

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de El Fogón de Begoña',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: precioNumerico(item.price),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-fogon-de-begona`,
	name: BUSINESS.fullName,
	alternateName: ['El Fogón de Begoña', 'El Fogón de Bego', 'El Fogón de Begoña Madrid'],
	description:
		'Establecimiento de comida casera para llevar y a domicilio en la calle de Lucas Mallada, 3 (San Blas-Canillejas, 28037 Madrid). Menú del día, pollo asado, paellas y tortillas rellenas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34910815801',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Pollo asado', 'Arroces', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'San Blas-Canillejas' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	amenityFeature: {
		'@type': 'LocationFeatureSpecification',
		name: 'Acceso para sillas de ruedas',
		value: true,
	},
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:00',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '19:00',
			closes: '22:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"el-fogon-de-begona-apaisada-04.jpg": fachada,
	"el-fogon-de-begona-apaisada-03.jpg": vitrina,
	"el-fogon-de-begona-apaisada-05.jpg": vitrinaDos,
	"el-fogon-de-begona-apaisada-06.jpg": vitrinaTres,
	"el-fogon-de-begona-apaisada-08.jpg": pizarraMenu,
	"el-fogon-de-begona-vertical-01.jpg": rotulo,
	"el-fogon-de-begona-vertical-02.jpg": paellas,
	"el-fogon-de-begona-vertical-07.jpg": pizarraDia,
	"el-fogon-de-begona-vertical-09.jpg": cartelTortillas,
	"el-fogon-de-begona-vertical-10.jpg": mural,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f4d3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Amatic+SC:wght@400;700&family=Bree+Serif&family=Nunito+Sans:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Fogón de Begoña Madrid, comida casera San Blas, pollo asado Lucas Mallada, menú del día San Blas-Canillejas, tortillas rellenas Madrid, comida para llevar 28037"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera, pollo asado, paellas y tortillas rellenas en Lucas Mallada, 3, San Blas-Canillejas. Menú del día por 8,50 €."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tres paellas de El Fogón de Begoña: marinera, arroz negro y mixta"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1f4d3a"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="San Blas-Canillejas"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Fogón de Begoña"
			subtitle="Comida casera · San Blas"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma menú, precios y horario antes de la visita."
			ctaLabel="Llamar a El Fogón de Begoña"
			navAriaLabel="Enlaces de El Fogón de Begoña"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34910815801?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carta%20de%20El%20Fog%C3%B3n%20de%20Bego%C3%B1a." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carta de El Fogón de Begoña"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
