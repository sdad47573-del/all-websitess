---
import '../styles/global.css';

const business = {
	name: 'La Tapería del Calamar',
	street: 'Paseo Marítimo, 4',
	city: 'Cádiz',
	postalCode: '11010',
	phone: '+34 656 88 76 19',
	latitude: 36.5046487,
	longitude: -6.2772548,
	site: 'https://www.sur-digital.com/la-taperia-del-calamar',
};

const mapsUrl =
	'https://www.google.com/maps/place/La+Taperia+Del+Calamar/@36.5046487,-6.2772548,17z/data=!3m1!4b1!4m6!3m5!1s0xd0dd30ae96d965f:0x1c61d18455c80902!8m2!3d36.5046487!4d-6.2772548!16s%2Fg%2F11m7761_wz?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const phoneHref = 'tel:+34656887619';
const instagramUrl = 'https://www.instagram.com/lataperiadelcalamar/';
const facebookUrl = 'https://www.facebook.com/p/La-Taper%C3%ADa-del-Calamar-61584259642557/';

const specialties = [
	{
		kicker: 'Para empezar',
		title: 'Papas aliñás',
		text: 'Las de Cádiz de verdad: frescas, bien aliñadas y perfectas para abrir boca mirando al mar.',
	},
	{
		kicker: 'El estrella',
		title: 'Nido de puntillitas',
		text: 'Puntillitas crujientes con huevo frito por encima. El contraste de la yema rompiéndose lo hace irresistible.',
	},
	{
		kicker: 'Fritura gaditana',
		title: 'Chocos y pavía',
		text: 'Chocos fritos tiernos con rebozado ligero y pavía de merluza jugosa. Fritura de costa bien hecha.',
	},
	{
		kicker: 'El sorprendente',
		title: 'Taco de tortillita',
		text: 'Taco de tortillita de camarones con gambas al ajillo. Potente, original y muy gaditano.',
	},
	{
		kicker: 'Para mojar pan',
		title: 'Carne al toro',
		text: 'Melosa, con salsa intensa. Raciones generosas para compartir sin remordimientos.',
	},
	{
		kicker: 'Sobremesa',
		title: 'Mojito y spritz',
		text: 'Carta de cócteles para alargar la tarde: mojito, aperol spritz y caipisco sour frente al mar.',
	},
];

const gallery = [
	{ src: '/la-taperia-del-calamar/fotos/terraza-mar.svg', alt: 'Ilustración de la terraza de La Tapería del Calamar frente al mar — sustituye por foto propia' },
	{ src: '/la-taperia-del-calamar/fotos/tapas.svg', alt: 'Ilustración de tapas gaditanas — sustituye por foto propia del local' },
	{ src: '/la-taperia-del-calamar/fotos/puntillitas.svg', alt: 'Ilustración del nido de puntillitas con huevo — sustituye por foto propia' },
	{ src: '/la-taperia-del-calamar/fotos/carne-toro.svg', alt: 'Ilustración de la carne al toro — sustituye por foto propia' },
	{ src: '/la-taperia-del-calamar/fotos/cocteles.svg', alt: 'Ilustración de cócteles en la sobremesa — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está La Tapería del Calamar?',
		a: 'En el Paseo Marítimo, 4, 11010 Cádiz, en primera línea de playa, en la zona de Cortadura. Es el rincón de tapeo del grupo CalaMar Multibar junto al mar.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Abre todos los días de 12:00 a 00:00, con cocina ininterrumpida. Siempre es buen momento para sentarse, pero en fines de semana de buen tiempo suele llenarse.',
	},
	{
		q: '¿Se puede reservar mesa?',
		a: 'No. El propio local avisa en su Instagram: no hacen reservas. Atienden por orden de llegada, así que conviene ir con un poco de margen.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Tapeo gaditano sin complicaciones y raciones generosas: papas aliñás, nido de puntillitas con huevo, chocos fritos, pavía de merluza, taco de tortillita con gambas al ajillo, carne al toro y cócteles.',
	},
	{
		q: '¿Tiene terraza?',
		a: 'Sí, terraza en el paseo para comer con vistas al mar. Ideal para una cerveza que acaba en comida, cena y sobremesa.',
	},
];

const description =
	'La Tapería del Calamar: tapas gaditanas generosas frente al mar en el Paseo Marítimo, 4 (Cádiz). Todos los días 12:00–00:00, sin reservas. Llama al 656 88 76 19.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 656 88 76 19',
	image: [`${business.site}/fotos/terraza-mar.svg`],
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Gaditana', 'Tapas', 'Fritura de pescado', 'Mediterránea'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [instagramUrl, facebookUrl],
	acceptsReservations: 'False',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '00:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos al aire libre', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Vistas al mar', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Comida para llevar', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0e2a3a" />
		<meta name="description" content="La Tapería del Calamar: tapas gaditanas generosas frente al mar en el Paseo Marítimo, 4 (Cádiz). Todos los días 12:00–00:00, sin reservas. 656 88 76 19." />
		<meta name="keywords" content="La Tapería del Calamar Cádiz, tapas Cádiz paseo marítimo, puntillitas Cádiz, chocos fritos Cádiz, carne al toro Cádiz, tapeo Cortadura, Paseo Marítimo 4 Cádiz" />
		<meta name="author" content="La Tapería del Calamar" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/la-taperia-del-calamar/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>La Tapería del Calamar | Tapas frente al mar en Cádiz</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="La Tapería del Calamar · Tapeo gaditano en el Paseo Marítimo" />
		<meta property="og:description" content="Papas aliñás, puntillitas, chocos, carne al toro y cócteles frente al mar. Paseo Marítimo 4, Cádiz. Todos los días 12:00–00:00." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/terraza-mar.svg`} />
		<meta property="og:image:alt" content="La Tapería del Calamar, bar de tapas en el Paseo Marítimo de Cádiz" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="La Tapería del Calamar · Tapas frente al mar en Cádiz" />
		<meta name="twitter:description" content="Tapas generosas, fritura gaditana y cócteles en el Paseo Marítimo 4, Cádiz." />
		<meta name="twitter:image" content={`${business.site}/fotos/terraza-mar.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Cádiz" />
		<meta name="geo.position" content="36.5046487;-6.2772548" />
		<meta name="ICBM" content="36.5046487, -6.2772548" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="La Tapería del Calamar, inicio">
				<span class="brand-mark" aria-hidden="true">C</span>
				<span class="brand-name">La Tapería del Calamar <small>Cádiz · Paseo Marítimo</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#taperia">La tapería</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>656 88 76 19</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Paseo Marítimo, 4 · Cádiz</p>
					<h1 id="hero-title">Tapeo gaditano<br />frente al mar<br /><em>sin mirar el reloj.</em></h1>
					<p class="hero-lede">
						Bar de tapas en primera línea: papas aliñás, puntillitas, chocos fritos,
						carne al toro y cócteles. Cocina ininterrumpida, raciones generosas y terraza con vistas.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a class="button button-ghost" href={phoneHref}>Llamar 656 88 76 19</a>
					</div>
					<ul class="hero-facts">
						<li><b>12–00</b> todos los días</li>
						<li>Sin reservas</li>
						<li>Terraza al mar</li>
						<li>Cocina sin cierre</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/la-taperia-del-calamar/fotos/terraza-mar.svg" alt="Ilustración de la terraza de La Tapería del Calamar frente al mar en Cádiz" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Paseo Marítimo 4 · Cádiz</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>12–00</b><span>Horario diario</span></div>
					<div><b>Mar</b><span>Primera línea</span></div>
					<div><b>No</b><span>Reservas</span></div>
				</div>
				<ul class="services">
					<li>Terraza</li>
					<li>Vistas al mar</li>
					<li>Tapas</li>
					<li>Cócteles</li>
					<li>Para llevar</li>
					<li>Sin reserva</li>
				</ul>
			</section>

			<section class="about section-pad" id="taperia">
				<p class="section-label"><span aria-hidden="true"></span> Una tapería en Cortadura</p>
				<div class="about-grid">
					<h2>Vienes por una cerveza<br />y te quedas <em>a comer.</em></h2>
					<div class="about-copy">
						<p>
							La Tapería del Calamar está en el Paseo Marítimo, 4, en Cádiz, parte del grupo CalaMar Multibar.
							Un sitio donde lo importante es comer bien, sin prisas, con una carta que mezcla lo tradicional
							con cocina de costa.
						</p>
						<p>
							Aquí las raciones son generosas y los precios invitan a pedir otra ronda: nido de puntillitas con
							huevo frito, chocos en su punto, pavía de merluza, taco de tortillita de camarones con gambas al
							ajillo y carne al toro para mojar pan.
						</p>
						<p class="about-note">
							No hacen reservas: atienden por orden de llegada. La cocina no cierra, así que siempre es buen
							momento para sentarse. Si vienes en fin de semana de sol, ve con margen.
						</p>
						<div class="about-links">
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">Instagram del local <span aria-hidden="true">↗</span></a>
							<a class="simple-link" href={facebookUrl} target="_blank" rel="noreferrer">Facebook <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su carta</p>
						<h2>Lo que más<br />se pide <em>en la mesa.</em></h2>
					</div>
					<p>
						Platos citados por clientes y guías locales: tapeo clásico gaditano, fritura y cócteles.
						La carta y los fuera de carta cambian, confirma disponibilidad en el local.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>La tapería<br /><em>junto al mar.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del local y verás aquí la terraza y los platos.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Paseo Marítimo, 4</p>
					<h2>Ven a tapear<br /><em>al paseo.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes a domingo</th>
								<td>12:00 – 00:00</td>
							</tr>
							<tr>
								<th scope="row">Reservas</th>
								<td>No se reserva · por orden de llegada</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Horario según ficha pública del local. En festivos o eventos, llama antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al local ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 656 88 76 19</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de La Tapería del Calamar en el Paseo Marítimo, 4, Cádiz" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> La Tapería del Calamar · Cádiz</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">C</span>
				<p>La Tapería del Calamar<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} La Tapería del Calamar · Cádiz. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/la-taperia-del-calamar/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/la-taperia-del-calamar/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/la-taperia-del-calamar/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar a la tapería <span>656 88 76 19</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/la-taperia-del-calamar/aviso-legal">Aviso legal</a>
			<a href="/la-taperia-del-calamar/aviso-legal#privacidad">Privacidad</a>
			<a href="/la-taperia-del-calamar/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
