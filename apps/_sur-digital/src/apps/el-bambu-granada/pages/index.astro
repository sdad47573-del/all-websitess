---
import { Image } from 'astro:assets';
import fachada from '../assets/fotos/el-bambu-granada-vertical-08.jpg';
const business = {
	name: 'El Bambú',
	street: 'Calle Margarita Xirgu, 7',
	city: 'Granada',
	region: 'Granada',
	postalCode: '18007',
	country: 'ES',
	phone: '+34 633 29 64 50',
	latitude: 37.1579697,
	longitude: -3.596582,
	site: 'https://www.sur-digital.com/el-bambu-granada',
};

const mapsUrl = 'https://www.google.com/maps/place/El+Bamb%C3%BA/@37.1579697,-3.596582,17z/data=!3m1!4b1!4m6!3m5!1s0xd71fca0b2f191f3:0x21176dd78b2af9c5!8m2!3d37.1579697!4d-3.596582!16s%2Fg%2F11sq140fz9?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34633296450';
const siteUrl = `${business.site}/`;
const description = 'El Bambú, cocina latina en el Zaidín de Granada. Descubre su ubicación en calle Margarita Xirgu, teléfono, mapa y acceso a las fotos de Google Maps.';

const faqs = [
	{
		question: '¿Dónde está El Bambú en Granada?',
		answer: 'El Bambú está en la calle Margarita Xirgu, 7, en la zona de Los Vergeles, Zaidín, Granada (18007). Abre las indicaciones para consultar el trayecto.',
	},
	{
		question: '¿Cuál es el teléfono de El Bambú?',
		answer: 'El teléfono publicado de El Bambú es el 633 29 64 50. Llama para consultar reservas, disponibilidad, horario y platos del día.',
	},
	{
		question: '¿Qué tipo de comida ofrece?',
		answer: 'Las fichas y comentarios públicos destacan comida latina y platos como sancocho y chicharrón, además de tapas. La oferta puede cambiar; confirma la carta y los alérgenos directamente con el establecimiento.',
	},
	{
		question: '¿Cuál es el horario de apertura?',
		answer: 'No hemos podido confirmar un horario fiable y actualizado en las fuentes consultadas. Comprueba la ficha de Google Maps o llama al 633 29 64 50 antes de desplazarte.',
	},
	{
		question: '¿Dónde puedo ver fotos de El Bambú?',
		answer: 'Abre la ficha del restaurante en Google Maps desde esta página para consultar sus fotos, reseñas e información actualizada.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${siteUrl}#restaurant`,
	name: business.name,
	description,
	url: siteUrl,
	telephone: business.phone,
	servesCuisine: ['Latinoamericana', 'Dominicana', 'Tapas'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: business.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

import Galeria from '../components/Galeria.astro';---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#253f37" />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" type="image/svg+xml" href="/el-bambu-granada/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" />
		<title>El Bambú en Granada | Cocina latina en el Zaidín</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="El Bambú · Cocina latina en Granada" />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${business.site}/og.svg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="El Bambú, restaurante de cocina latina en Granada" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.region" content="ES-GR" />
		<meta name="geo.placename" content="Granada" />
		<meta name="geo.position" content="37.1579697;-3.596582" />
		<meta name="ICBM" content="37.1579697, -3.596582" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="El Bambú, inicio"><span class="brand-mark" aria-hidden="true">B</span><span>El Bambú<small>Cocina latina · Granada</small></span></a>
			<nav aria-label="Navegación principal"><a href="#restaurante">El restaurante</a><a href="#sabores">Sabores</a><a href="#galeria">Fotos</a><a href="#visita">Cómo llegar</a></nav>
			<a class="header-call" href={phoneHref}>Llamar · 633 29 64 50</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span>Zaidín · Granada</span><i aria-hidden="true"></i> Los Vergeles</p>
					<h1>Un viaje de sabor<br /><em>en cada plato.</em></h1>
					<p class="lede">El Bambú trae a Granada sabores de la cocina latina en un ambiente de barrio. Ven a descubrir platos caseros y tapas en la calle Margarita Xirgu; llama para consultar la carta y organizar tu visita.</p>
					<div class="actions"><a class="button button-gold" href={phoneHref}>Llamar al restaurante <span aria-hidden="true">↗</span></a><a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-details"><span>⌖ Calle Margarita Xirgu, 7</span><span>✦ Cocina latina · tapas</span></div>
				</div>
				<figure class="hero-photo">
					<Image
						src={fachada}
						alt="Fachada de El Bambú en la calle Margarita Xirgu, con la terraza y el rótulo del restaurante"
						widths={[480, 720, 1080, 1440]}
						sizes="(max-width: 720px) 100vw, 48vw"
						format="webp"
						quality={76}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>El Bambú · Calle Margarita Xirgu, 7</span>
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">Foto de Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<div class="ticker" aria-label="El Bambú, cocina latina en Granada"><span>El Bambú</span><b>✳</b><span>Cocina latina</span><b>✳</b><span>Zaidín · Granada</span><b>✳</b><span>Sabores caseros</span></div>

			<Galeria nombre="El Bambú" mapsUrl={mapsUrl} titulo="El Bambú, en imágenes" intro="La picadera, los platos, la mesa y los detalles del local, tal como aparecen en la ficha pública de Google Maps." />

			<section class="intro section-wrap" id="restaurante"><div><p class="eyebrow eyebrow-dark">Un rincón de sabor en el Zaidín</p><h2>Cocina con raíces,<br /><em>cerca de casa.</em></h2></div><div class="intro-copy"><p>El Bambú está en la calle Margarita Xirgu, en la zona de Los Vergeles del Zaidín. Los comentarios públicos describen una propuesta latina y destacan platos de cocina casera, con un trato cercano.</p><p>Consulta la carta disponible, el horario y las opciones del día llamando directamente al restaurante.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver reseñas y fotos en Google Maps ↗</a></div></section>

			<section class="specialties section-wrap" id="sabores" aria-labelledby="specialties-title"><div class="section-heading"><p class="eyebrow eyebrow-dark">Una mesa llena de sabor</p><h2 id="specialties-title">Sabores latinos<br /><em>para disfrutar.</em></h2><p>Algunos platos que aparecen en comentarios públicos del restaurante. Pregunta qué preparan hoy y descubre la carta actual.</p></div>
				<div class="special-grid">
					<article class="special-card"><span class="special-icon" aria-hidden="true">♨</span><span class="card-kicker">CUCHARA Y TRADICIÓN</span><h3>Sancocho</h3><p>Un plato de cuchara mencionado por quienes han visitado El Bambú.</p></article>
					<article class="special-card card-green"><span class="special-icon" aria-hidden="true">✦</span><span class="card-kicker">SABOR CRUJIENTE</span><h3>Chicharrón</h3><p>Uno de los sabores que destaca en opiniones públicas del establecimiento.</p></article>
					<article class="special-card card-terracotta"><span class="special-icon" aria-hidden="true">❋</span><span class="card-kicker">PARA PICAR</span><h3>Tapas y picadas</h3><p>Opciones para compartir en una comida informal con amigos o familia.</p></article>
				</div><p class="menu-note">La carta puede cambiar. Consulta disponibilidad, ingredientes, alérgenos y precios directamente con el restaurante.</p>
			</section>

			<section class="photo-section" id="fotos"><div class="photo-copy"><p class="eyebrow">La ficha, al día</p><h2>Mapa, reseñas<br />y datos <em>actualizados.</em></h2><p>El mapa del local y el acceso a su ficha de Google Maps, donde se consultan reseñas, horario y datos actualizados. Las fotos del negocio están en la galería de esta misma página.</p><a class="button button-gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Abrir ficha en Google Maps <span aria-hidden="true">↗</span></a><p class="photo-note">Las reseñas y los avisos se leen siempre en la ficha original de Google.</p></div>
				<div class="map-photo"><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Google de El Bambú en la calle Margarita Xirgu, Granada" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
					<noscript>
						<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
					</noscript>
				</div><a class="map-caption" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">⌖</span><span><b>El Bambú</b><small>Margarita Xirgu, 7 · Ver ficha y fotos ↗</small></span></a></div>
			</section>

			<section class="visit section-wrap" id="visita"><div class="visit-copy"><p class="eyebrow eyebrow-dark">Nos vemos en el Zaidín</p><h2>Tu próxima mesa<br /><em>está en El Bambú.</em></h2><p>El restaurante se encuentra en la calle Margarita Xirgu, en Los Vergeles. Llama para consultar horario, reservas y disponibilidad antes de salir.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button button-dark" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Llamar · 633 29 64 50</a></div></div>
				<div class="visit-card"><div class="visit-title"><span class="visit-icon" aria-hidden="true">⌖</span><div><p class="eyebrow eyebrow-dark">Ubicación y contacto</p><h3>Los Vergeles · Granada</h3></div></div><dl><div><dt>Dirección</dt><dd>Calle Margarita Xirgu, 7<br />18007 Granada</dd></div><div><dt>Teléfono</dt><dd><a href={phoneHref}>633 29 64 50</a></dd></div><div><dt>Horario</dt><dd>Consulta la ficha<br />o llama antes de ir</dd></div></dl><p class="visit-note">No hemos podido confirmar un horario actualizado. Contacta con el restaurante antes de desplazarte.</p><a class="visit-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Abrir ficha de Google Maps ↗</a></div>
			</section>

			<section class="faq-section section-wrap" id="preguntas"><p class="eyebrow eyebrow-dark">Preguntas frecuentes</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
		</main>

		<footer class="footer"><div class="footer-top"><a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">B</span><span>El Bambú<small>Cocina latina · Granada</small></span></a><p>Sabores latinos<br />en el Zaidín.</p><nav aria-label="Enlaces de El Bambú"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={phoneHref}>633 29 64 50</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} El Bambú · Granada</span><a href="/el-bambu-granada/aviso-legal/">Aviso legal y privacidad</a> <a href="/el-bambu-granada/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a> <span>Confirma horario, carta y disponibilidad directamente.</span></div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar <span>633 29 64 50</span></a>
	</body>
</html>

<style is:global>
	:root{font-family:'DM Sans',sans-serif;color:#303b36;background:#f7f3e9;font-synthesis:none;text-rendering:optimizeLegibility;--forest:#253f37;--forest-light:#53755e;--gold:#d9ad62;--cream:#f7f3e9;--ink:#303b36;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid #d9ad62;outline-offset:4px}.skip-link{position:absolute;z-index:99;top:-60px;left:16px;padding:12px 16px;background:var(--gold);color:var(--forest)}.skip-link:focus{top:12px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:22px;background:var(--forest);color:#fcf9f0}.brand{display:flex;align-items:center;gap:11px;font-size:15px;font-weight:700}.brand small{display:block;margin-top:4px;color:#d9e2d9;font-size:9px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--gold);border-radius:50%;color:#ead09a;font:700 23px var(--display)}.topbar nav{display:flex;gap:clamp(14px,2.5vw,32px);color:#e7ede5;font-size:12px}.topbar nav a:hover,.footer a:hover{color:#ead09a}.header-call{padding:11px 17px;border:1px solid #ffffff55;border-radius:99px;font-size:11px;font-weight:700}.hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:560px;background:var(--forest);color:#fcf9f0;overflow:hidden}.hero-copy{padding:73px 4vw 64px 9vw;align-self:center}.eyebrow{margin:0 0 19px;color:#e8ce93;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase}.eyebrow i{display:inline-block;width:22px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.section-heading h2,.photo-copy h2,.visit h2,.faq-section h2{margin:0;font:600 clamp(39px,4.8vw,64px)/1.08 var(--display);letter-spacing:-1.2px}.hero h1 em,.intro h2 em,.section-heading h2 em,.photo-copy h2 em,