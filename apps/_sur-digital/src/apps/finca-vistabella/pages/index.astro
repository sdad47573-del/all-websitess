---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/finca-vistabella-apaisada-01.jpg';
import foto1 from '../assets/fotos/finca-vistabella-apaisada-04.jpg';
import foto2 from '../assets/fotos/finca-vistabella-vertical-03.jpg';
import foto3 from '../assets/fotos/finca-vistabella-apaisada-09.jpg';
import foto4 from '../assets/fotos/finca-vistabella-vertical-08.jpg';
import foto5 from '../assets/fotos/finca-vistabella-apaisada-05.jpg';

const business = {
	name: 'Finca Vistabella',
	street: 'Paraje Vistabella',
	city: 'Librilla',
	region: 'Región de Murcia',
	province: 'Murcia',
	postalCode: '30892',
	latitude: 37.8837089,
	longitude: -1.363764,
	site: 'https://www.sur-digital.com/finca-vistabella',
};

const mapsUrl =
	'https://www.google.com/maps/place/Finca+vistabella/@37.8837089,-1.363764,17z/data=!3m1!4b1!4m6!3m5!1s0xd6485fe4e4ec473:0x63d66ea976f474c3!8m2!3d37.8837089!4d-1.363764!16s%2Fg%2F11bx4d38zw?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'Para empezar',
		title: 'Tapeo y cerveza fresquita',
		text: '«Cerveza fresquita y tapeo estupendo», resume una de las reseñas de la ficha. La barra es la primera parada.',
	},
	{
		kicker: 'En la mesa',
		title: 'Raciones grandes',
		text: '«Comida buena y raciones grandes»: es otra de las frases que repiten quienes han comido en la finca.',
	},
	{
		kicker: 'El servicio',
		title: 'Camareros atentos',
		text: '«Camareros muy atentos, amables y rápidos», cuenta otra reseña. El servicio es parte de la casa.',
	},
	{
		kicker: 'La cocina',
		title: 'Cocina española',
		text: 'Restaurante y bar restaurante de cocina española, en el Paraje Vistabella de Librilla.',
	},
	{
		kicker: 'Sin barreras',
		title: 'Local accesible',
		text: 'Acceso, aparcamiento y aseo adaptados para sillas de ruedas, según los datos de la ficha.',
	},
	{
		kicker: 'Todos los días',
		title: 'De 9:00 a 17:00',
		text: 'Abre todos los días de la semana con el mismo horario, incluido el fin de semana.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de Finca Vistabella publicada en su ficha de Google Maps' },
	{ src: photos.foto2, alt: 'Imagen de la finca en Librilla tomada de su galería de Google Maps' },
	{ src: photos.foto3, alt: 'Fotografía de Finca Vistabella en el Paraje Vistabella, Librilla' },
	{ src: photos.foto4, alt: 'Imagen de Finca Vistabella subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Vista de Finca Vistabella según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está Finca Vistabella?',
		a: 'En el Paraje Vistabella, 30892 Librilla (Murcia). Coordenadas 37.8837089, -1.363764.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Según su ficha de Google Maps, abre todos los días de 9:00 a 17:00. El horario puede cambiar en festivos, así que conviene comprobarlo en Google Maps antes de ir.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Cocina española de restaurante y bar restaurante: tapeo, raciones y comida de casa. Las reseñas destacan la cerveza fresca, el tapeo y el tamaño de las raciones.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso para sillas de ruedas, aparcamiento adaptado y aseo adaptado.',
	},
	{
		q: '¿Se puede aparcar?',
		a: 'Sí, la ficha incluye aparcamiento adaptado para sillas de ruedas. Al estar en el Paraje Vistabella, se llega en coche.',
	},
	{
		q: '¿Cómo se contacta?',
		a: 'La ficha de Google Maps no publica teléfono. Para ver la información actualizada, el horario o trazar la ruta, abre la ficha desde el botón de esta web.',
	},
];

const description =
	'Finca Vistabella, restaurante de cocina española en el Paraje Vistabella de Librilla (Murcia): tapeo, raciones y comida casera de 9:00 a 17:00 todos los días.';

const images = [
	`${business.site}/og.jpg`,
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	image: images,
	servesCuisine: ['Española', 'Tapas'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '17:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.5,
		reviewCount: 524,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#26301f" />
		<meta
			name="description"
			content="Finca Vistabella, restaurante de cocina española en el Paraje Vistabella de Librilla (Murcia): tapeo, raciones y comida casera de 9:00 a 17:00 todos los días."
		/>
		<meta
			name="keywords"
			content="Finca Vistabella, restaurante Librilla, tapeo Librilla, cocina española Murcia, Paraje Vistabella, comer en Librilla"
		/>
		<meta name="author" content="Finca Vistabella" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/finca-vistabella/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Finca Vistabella | Cocina española en Librilla</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Finca Vistabella · Cocina española en Librilla" />
		<meta
			property="og:description"
			content="Tapeo, raciones y cocina española en el Paraje Vistabella, Librilla (Murcia). Todos los días de 9:00 a 17:00."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.jpg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Finca Vistabella, restaurante en Librilla (Murcia)" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Finca Vistabella · Cocina española en Librilla" />
		<meta
			name="twitter:description"
			content="Tapeo, raciones y cocina española en el Paraje Vistabella, Librilla (Murcia)."
		/>
		<meta name="twitter:image" content={`${business.site}/og.jpg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Librilla" />
		<meta name="geo.position" content="37.8837089;-1.363764" />
		<meta name="ICBM" content="37.8837089, -1.363764" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Finca Vistabella, inicio">
				<span class="brand-mark" aria-hidden="true">FV</span>
				<span class="brand-name">Finca Vistabella <small>Librilla · Murcia</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#finca">La finca</a>
				<a href="#mesa">La mesa</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-link" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Paraje Vistabella · Librilla</p>
					<h1 id="hero-title">Comer en el campo,<br />sin prisa,<br /><em>en Librilla.</em></h1>
					<p class="hero-lede">
						Finca Vistabella es un restaurante de cocina española en el Paraje Vistabella, Librilla (Murcia).
						Tapeo, raciones y comida de casa, todos los días de 9:00 a 17:00.
					</p>
					<div class="hero-actions">
						<a class="button button-clay" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
						<a class="button button-ghost" href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,5</b> en Google (524 reseñas)</li>
						<li>Raciones grandes</li>
						<li>Todos los días 9:00–17:00</li>
						<li>Librilla</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						alt="Finca Vistabella, restaurante de cocina española en Librilla"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver la ficha ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,5</b><span>Google</span></div>
					<div><b>524</b><span>Reseñas</span></div>
					<div><b>7/7</b><span>Días abierto</span></div>
				</div>
				<ul class="services">
					<li>Cocina española</li>
					<li>Tapeo</li>
					<li>Raciones</li>
					<li>Bar restaurante</li>
					<li>Acceso adaptado</li>
					<li>Aparcamiento adaptado</li>
				</ul>
			</section>

			<section class="about section-pad" id="finca">
				<p class="section-label"><span aria-hidden="true"></span> Restaurante rural en Librilla</p>
				<div class="about-grid">
					<h2>El campo,<br />la mesa<br />y <em>la sobremesa.</em></h2>
					<div class="about-copy">
						<p>
							Finca Vistabella está en el Paraje Vistabella, en Librilla (Murcia), a las afueras del casco
							urbano. Un restaurante y bar restaurante de cocina española, con tapeo, raciones y comida de
							casa.
						</p>
						<p>
							La ficha de Google Maps lo define como restaurante de cocina española y bar restaurante. Sus
							reseñas hablan de cerveza fresquita, tapeo estupendo, raciones grandes y un servicio atento,
							amable y rápido.
						</p>
						<p class="about-note">
							Abre todos los días de 9:00 a 17:00, según Google Maps. No consta teléfono en la ficha: la
							ruta y la información actualizada están en el botón de Google Maps.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="mesa">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Lo que dicen las reseñas</p>
						<h2>Tapeo,<br />raciones y <em>buen trato.</em></h2>
					</div>
					<p>
						Sin carta publicada en la ficha de Google Maps, lo que mejor describe la casa son las reseñas de
						sus clientes: tapeo, raciones generosas y servicio rápido.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow light"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>La finca<br /><em>en imágenes.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Finca Vistabella. En la ficha
							encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="avif"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres el
					titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Paraje Vistabella, s/n</p>
					<h2>Ven a Librilla<br /><em>a comer.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes a domingo</th>
								<td>9:00 – 17:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, comprueba la ficha antes de venir.
					</p>

					<ul class="access">
						<li>Acceso para sillas de ruedas</li>
						<li>Aparcamiento adaptado</li>
						<li>Aseo adaptado</li>
					</ul>

					<div class="visit-links">
						<a class="button button-clay" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-line" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver ficha en Google Maps
						</a>
					</div>
					<p class="contact-note">
						La ficha no publica teléfono. Las rutas y los datos actualizados están en Google Maps.
					</p>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Finca Vistabella en el Paraje Vistabella, Librilla"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;">
								<a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a>
							</p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Finca Vistabella · Librilla
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">FV</span>
				<p>Finca Vistabella<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Finca Vistabella · Librilla, Murcia. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>

			<p class="footer-credit">
				Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
				<a href="https://sur-digital.vercel.app/" rel="noopener">sur-digital.vercel.app</a>
			</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/finca-vistabella/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/finca-vistabella/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/finca-vistabella/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-cta" href={directionsUrl} target="_blank" rel="noreferrer">
			Cómo llegar a la finca <span aria-hidden="true">↗</span>
		</a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/finca-vistabella/aviso-legal">Aviso legal</a>
			<a href="/finca-vistabella/aviso-legal#privacidad">Privacidad</a>
			<a href="/finca-vistabella/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
