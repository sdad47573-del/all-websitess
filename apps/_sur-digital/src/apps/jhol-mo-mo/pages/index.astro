---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import momos from '../assets/fotos/jhol-mo-mo-vertical-08.jpg';
import fachada from '../assets/fotos/jhol-mo-mo-apaisada-01.jpg';
import terraza from '../assets/fotos/jhol-mo-mo-apaisada-04.jpg';
import carta from '../assets/fotos/jhol-mo-mo-vertical-06.jpg';
import momosSalsa from '../assets/fotos/jhol-mo-mo-vertical-09.jpg';
import arroz from '../assets/fotos/jhol-mo-mo-vertical-02.jpg';
import patatas from '../assets/fotos/jhol-mo-mo-vertical-05.jpg';
import pasta from '../assets/fotos/jhol-mo-mo-apaisada-07.jpg';
import carne from '../assets/fotos/jhol-mo-mo-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Jhol Mo Mo Restaurant & Bar, restaurante nepalí en la R. Maria Andrade 60C (Lisboa): momos con sopa, sets nepalíes, curries y cocina continental. Abre todos los días de 9:00 a 23:30. 4,4 en Google con 448 reseñas. Tel. 920 141 222.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de Jhol Mo Mo en la Rua Maria Andrade, con el toldo, las banderolas y la terraza de mesas turquesa',
	},
	{
		src: terraza,
		alt: 'Clientes en la terraza de Jhol Mo Mo, en la Rua Maria Andrade de Lisboa, al anochecer',
	},
	{
		src: carta,
		alt: 'Carta de Jhol Mo Mo con los sets nepalíes, ensaladas y platos continentales',
	},
	{
		src: momosSalsa,
		alt: 'Mo mo al vapor con cuenco de chutney naranja servidos en Jhol Mo Mo',
	},
	{
		src: arroz,
		alt: 'Arroz blanco con verduras salteadas y zanahoria en el plato de Jhol Mo Mo',
	},
	{
		src: patatas,
		alt: 'Patatas guisadas con guindilla y cilantro de Jhol Mo Mo',
	},
	{
		src: pasta,
		alt: 'Pasta con gambas y tomate servida en un plato negro en Jhol Mo Mo',
	},
	{
		src: carne,
		alt: 'Carne en salsa agridulce con piña servida en Jhol Mo Mo',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['Jhol Mo Mo', 'Jhol Mo Mo Lisboa', 'Jhol MoMo Arroios'],
	slogan: 'Mo mo y cocina nepalí en Lisboa',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 920 141 222',
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Nepalí', 'Curry', 'Cocina asiática'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Arroios' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '09:00',
			closes: '23:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos accesibles para personas en sillas de ruedas',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Pedidos online', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((body) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
		reviewBody: body,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Jhol Mo Mo · Restaurante nepalí en Arroios, Lisboa';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#8c2130" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Outfit:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Jhol Mo Mo, restaurante nepalí Lisboa, momos Lisboa, jhol momo Lisboa, comer en Arroios, comida nepalí Lisboa, curry Lisboa, R. Maria Andrade 60C, restaurante nepalés Lisboa, Intendente"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Jhol Mo Mo · Restaurante nepalí en Arroios, Lisboa"
			ogDescription="Momos con sopa, sets nepalíes y curries en la Rua Maria Andrade, todos los días de 9:00 a 23:30. 4,4 en Google con 448 reseñas. Tel. 920 141 222."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada y terraza de Jhol Mo Mo en la Rua Maria Andrade, Lisboa"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#8c2130"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone="+351920141222"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.regionName}`}
			countryName="Portugal"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				phone: '+351 920 141 222',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[momos]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Nepalí · Mo mo · Lisboa"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="R. Maria Andrade, 60C · Arroios, Lisboa"
				title="Nepal<br />en un plato,<br /><em>en Lisboa.</em>"
				lede={`Jhol Mo Mo es un restaurante nepalí en la Rua Maria Andrade, en Arroios: momos hechos al momento, jhol mo mo con sopa, sets nepalíes con arroz y curries, todos los días de 9:00 a 23:30.`}
				image={momos}
				imageAlt="Mo mo al vapor con chutney en un plato azul de Jhol Mo Mo, en Lisboa"
				primaryCta={{ label: `Pedir: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Mo mo"
				facts={[
					{ label: 'Nota', html: '<b>4,4 en Google</b> con 448 reseñas' },
					{ label: 'Todos los días', html: '<b>9:00 – 23:30</b>' },
					{ label: 'Pedidos', html: '<b>Online o por teléfono</b>' },
					{ label: 'Cocina', html: '<b>Nepalí y bar</b>' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Jhol Mo Mo" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Mo mo, curries<br /><em>y banderolas.</em>"
				paragraphs={[
					'En la Rua Maria Andrade, 60C, en Arroios, Jhol Mo Mo Restaurant & Bar se presenta como restaurante nepalí y bar. La fachada, con las banderolas de oración y una pequeña terraza de mesas turquesa sobre césped artificial, lleva a la mesa el sabor de Nepal en pleno centro de Lisboa.',
					'El propio restaurante lo explica en su ficha: «We offer Nepali taste, hot and cold beverages with some spicy and tangy starters. Dumpling with soup is our speciality dish». El plato que da nombre al local es el jhol mo mo, la empanadilla al vapor servida en caldo, con su chutney al lado.',
					'La carta fotografiada en el perfil organiza la comida en sets nepalíes —Nepali Khana Set, Newari Khaja Set y Dhido Set, con versión vegetariana o de pollo, cerdo y cordero—, curries de pollo, cerdo y verduras, y una pequeña selección continental con bitoque, bacalhau à Brás, carbonara o tosta mista. Las reseñas insisten en que se cocina al momento y en el trato del equipo.',
				]}
				note="«A comida é cozinhada na hora, com ingredientes frescos, e a um preço imbatível», dice una reseña. Otra: «restaurante delicioso com uma equipa muito atenciosa e simpática»."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Sets, curries<br /><em>y mo mo.</em>"
				description="La carta que aparece fotografiada en el perfil, con sus precios: sets nepalíes, mo mo, curries de pollo, cerdo y verduras, y una pequeña selección continental."
				cta={{ label: `Pedir: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Precios de la carta fotografiada en el perfil (sets nepalíes de 9 a 13 €; continentales de 4 a 12 €). Cambian según el día y la temporada: confírmalos al pedir o en el 920 141 222. La ficha de Google permite además «Pedir online»."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La terraza,<br />la carta<br /><em>y los momos.</em>"
				description="Estas fotografías proceden del perfil de Jhol Mo Mo en Google Maps: la fachada de la Rua Maria Andrade, la terraza al anochecer, la carta, los momos al vapor y los platos que salen de su cocina."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="R. Maria Andrade, 60C · 1170-210 Lisboa"
				title="En Arroios,<br /><em>todos los días.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Arroios, Portugal']}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="Abre todos los días, de 9:00 a 23:30, domingo incluido, sin cerrar a mediodía. En festivos puede cambiar: llama antes."
				mapTitle="Mapa de Jhol Mo Mo en la Rua Maria Andrade, 60C, Arroios (Lisboa)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Jhol Mo Mo · Arroios"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `+351 ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva por teléfono, en el 920 141 222. La ficha de Google permite «Pedir online» para el pedido. Marca asientos accesibles para sillas de ruedas; para entrada y aseo adaptados conviene preguntar al llamar."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Jhol Mo Mo"
			creditLabel="Creado por"
		/>
	</body>
</html>
