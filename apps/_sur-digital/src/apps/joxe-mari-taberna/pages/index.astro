---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/joxe-mari-taberna-apaisada-01.jpg';
import hamburguesaFritas from '../assets/fotos/joxe-mari-taberna-vertical-02.jpg';
import pintxoAmarillo from '../assets/fotos/joxe-mari-taberna-vertical-03.jpg';
import quesoCabra from '../assets/fotos/joxe-mari-taberna-vertical-04.jpg';
import pintxosAtun from '../assets/fotos/joxe-mari-taberna-apaisada-05.jpg';
import pintxosCrema from '../assets/fotos/joxe-mari-taberna-apaisada-06.jpg';
import hamburguesa from '../assets/fotos/joxe-mari-taberna-apaisada-07.jpg';
import vitrina from '../assets/fotos/joxe-mari-taberna-vertical-08.jpg';
import mojitos from '../assets/fotos/joxe-mari-taberna-vertical-09.jpg';
import postre from '../assets/fotos/joxe-mari-taberna-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Joxe Mari Taberna, restaurante vasco en Erregezaintza Kalea, 49 (20008 Donostia / San Sebastián). Pintxos, raciones y menú del día, con 4,3 sobre 5 en Google y 307 reseñas. Teléfono 943 90 51 24. Cierra los lunes.';

const galeria = [
	{
		src: vitrina,
		alt: 'Vitrina de pintxos de Joxe Mari Taberna con varias bandejas y una clienta al fondo',
	},
	{
		src: quesoCabra,
		alt: 'Pintxo de queso de cabra con nueces y miel en una pizarra',
	},
	{
		src: pintxoAmarillo,
		alt: 'Pintxo con salsa amarilla y sal en una pizarra, con tomates al fondo',
	},
	{
		src: pintxosAtun,
		alt: 'Pintxos de atún sobre pan en una pizarra',
	},
	{
		src: pintxosCrema,
		alt: 'Pintxos con crema blanca y una tira naranja en un plato blanco',
	},
	{
		src: hamburguesa,
		alt: 'Hamburguesa con bacon, queso y patatas fritas en una cesta',
	},
	{
		src: hamburguesaFritas,
		alt: 'Hamburguesa con bacon y queso fundido con patatas fritas',
	},
	{
		src: mojitos,
		alt: 'Dos mojitos con hielo, lima y menta en la barra',
	},
	{
		src: postre,
		alt: 'Postre con helado, migas de galleta y caramelo',
	},
	{
		src: fachada,
		alt: 'Toldo de Taberna Joxe Mari sobre la fachada de piedra del local',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#joxe-mari`,
	name: BUSINESS.name,
	alternateName: ['Joxe Mari', 'Joxe Mari Donostia', 'Taberna Joxe Mari', 'Restaurante Joxe Mari'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: `+34 ${BUSINESS.phone}`,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina vasca', 'Pintxos', 'Raciones'],
	areaServed: [
		{ '@type': 'City', name: 'Donostia / San Sebastián' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '10:00',
			closes: '24:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La barra', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Joxe Mari Taberna · Pintxos y cocina vasca en Donostia';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f3a3d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400..700&family=Work+Sans:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Joxe Mari Taberna, Joxe Mari Donostia, taberna Joxe Mari, pintxos Donostia, menú del día Donostia, restaurante vasco Donostia, raciones Donostia, Erregezaintza Kalea, comer en Donostia, restaurante Gipuzkoa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Restaurante vasco en Erregezaintza Kalea, 49 (Donostia). Pintxos de alta elaboración, raciones y menú del día, con 4,3 sobre 5 en Google y 307 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Toldo de Taberna Joxe Mari sobre la fachada de piedra del local"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1f3a3d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Erregezaintza Kalea, Donostia"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Joxe Mari"
			subtitle="Taberna · Donostia"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Erregezaintza Kalea, 49 · Donostia"
				title="Pintxos de alta <br /><em>elaboración.</em>"
				lede={`Joxe Mari Taberna es un restaurante vasco en Erregezaintza Kalea, 49, en Donostia. Su ficha se presenta como especialista en pintxos de alta elaboración y Google le da 4,3 sobre 5 con 307 reseñas, con el menú del día entre lo más citado. Abre de martes a domingo y cierra los lunes: para venir, llama al ${BUSINESS.phone}.`}
				image={fachada}
				imageAlt="Toldo de Taberna Joxe Mari sobre la fachada de piedra del local"
				primaryCta={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,3</b> en Google · 307 reseñas' },
					{ label: 'La casa', html: '<b>Pintxos</b> de alta elaboración' },
					{ label: 'Horario', html: '<b>Lunes</b> cerrado' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Joxe Mari Taberna" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Pintxos, barra <br /><em>y menú del día.</em>"
				paragraphs={[
					'En el número 49 de Erregezaintza Kalea está Joxe Mari Taberna, un restaurante vasco que Google puntúa con 4,3 sobre 5 a partir de 307 reseñas.',
					'Su ficha se presenta como especialista en pintxos de alta elaboración. No publica carta completa, precios, correo ni web propia, así que esta web no los inventa.',
					'Las reseñas destacan la cocina, los pintxos y el menú del día «a precio asequible», además de un local «agradable y limpio» con un camarero «súper profesional». No todas son elogios: otra opinión habla de nachos insulsos, calamares salados y raciones escasas.',
					'En las fotos del perfil se ven la vitrina de pintxos, el queso de cabra con nueces y miel, hamburguesas, mojitos y postres.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. La ficha marca acceso para sillas de ruedas y asientos adaptados.`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La barra"
				title="Lo que dicen <br /><em>las reseñas.</em>"
				description="La ficha no publica carta completa ni precios. Esto no es un menú: es lo que dice el local de sí mismo, lo que cuentan sus opiniones y lo que se ve en sus fotos."
				cta={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados en la ficha. Para saber qué hay hoy, lo más directo es llamar al 943 90 51 24."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Diez fotos <br /><em>de la taberna.</em>"
				description="Las diez fotografías publicadas en el perfil de Joxe Mari Taberna en Google Maps: la fachada, la vitrina de pintxos, la cocina y la barra."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a Erregezaintza <br /><em>a picar algo.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, `${BUSINESS.regionName}, España`]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario de la ficha de Google: de martes a viernes de 8:00 a 24:00, y sábados y domingos de 10:00 a 24:00. Los lunes cierra. Conviene confirmarlo por teléfono antes de ir."
				mapTitle="Mapa de Joxe Mari Taberna en Erregezaintza Kalea, 49, Donostia"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Joxe Mari Taberna · Donostia"
				mapHref={MAPS.cid}
				links={[
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref, variant: 'primary' },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="El teléfono 943 90 51 24 es el único canal de contacto que publica la ficha de Google: no hay correo ni web propia. La ficha marca acceso y asientos adaptados."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/joxe-mari-taberna/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Joxe Mari"
		/>
	</body>
</html>
