---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	descripcionLocal,
	directionsUrl,
	distintivo,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Pura Cepa Neotaberna · Restaurante mediterráneo en Ciudad Real';
const description =
	'Pura Cepa Neotaberna, restaurante mediterráneo en la Avenida Torreón del Alcázar, 9 de Ciudad Real. 4,2 sobre 5 con 2.070 reseñas; abre todos los días.';
const keywords =
	'Pura Cepa Neotaberna, Pura Cepa Ciudad Real, neotaberna Ciudad Real, restaurante mediterráneo Ciudad Real, Avenida Torreón del Alcázar, jamones y mariscos Ciudad Real';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas diez fotografías, así que no se inventa una
 * descripción y todos los `alt` avisan solo de dónde salen.
 */
const altFoto =
	'Fotografía publicada en la ficha de Google Maps de Pura Cepa Neotaberna, en Ciudad Real';
const altOg = 'Fotografía de Pura Cepa Neotaberna publicada en su ficha de Google Maps';

/**
 * Autor que el manifiesto de la descarga atribuye a las diez fotos: el propio local.
 * Como sí hay a quién citar, cada foto de la galería lleva su pie.
 */
const autorFoto = 'Pura Cepa Neotaberna';

/**
 * Galería completa: las diez fotografías de la ficha.
 *
 * Seis son verticales y cuatro apaisadas (una de ellas panorámica), así que la galería va en tres
 * columnas: con formatos mezclados el mosaico se lee mejor que en una rejilla de recortes.
 */
const galeria = [
	'pura-cepa-neotaberna-vertical-01.jpg',
	'pura-cepa-neotaberna-vertical-02.jpg',
	'pura-cepa-neotaberna-vertical-03.jpg',
	'pura-cepa-neotaberna-vertical-04.jpg',
	'pura-cepa-neotaberna-apaisada-05.jpg',
	'pura-cepa-neotaberna-vertical-06.jpg',
	'pura-cepa-neotaberna-vertical-07.jpg',
	'pura-cepa-neotaberna-apaisada-08.jpg',
	'pura-cepa-neotaberna-apaisada-09.jpg',
	'pura-cepa-neotaberna-apaisada-10.jpg',
];

/**
 * Tres fotos de avance en el collage de la portada (también están en la galería).
 *
 * Arriba va la apaisada panorámica y abajo dos verticales, con las proporciones por defecto del
 * repositorio (16/9 y 4/5).
 */
const collage = [
	{ name: 'pura-cepa-neotaberna-apaisada-09.jpg', clase: 'collage-item collage-item-a' },
	{ name: 'pura-cepa-neotaberna-vertical-01.jpg', clase: 'collage-item collage-item-b' },
	{ name: 'pura-cepa-neotaberna-vertical-03.jpg', clase: 'collage-item collage-item-c' },
];

/**
 * Número de reseñas destacadas que publica la ficha.
 *
 * Aquí son tres, pero se cuenta en vez de escribirlo a mano para que el texto no se desincronice si
 * la ficha cambia.
 */
const numeroResenas = reviews.length;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#2b1218" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CR" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/pura-cepa-neotaberna/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">PC</span>
				<span class="brand-text">
					Pura Cepa
					<small>Torreón del Alcázar, 9 · Ciudad Real</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#local">La casa</a>
				<a href="#fotos">Las fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Ciudad Real · Avenida Torreón del Alcázar, 9</p>
						<h1 id="hero-title">
							Pura Cepa Neotaberna,
							<br />
							<em>taberna y cocina mediterránea.</em>
						</h1>
						<p class="hero-lede">
							Pura Cepa Neotaberna está en la Avenida Torreón del Alcázar, 9, con código
							postal 13004, en Ciudad Real. Google lo clasifica como restaurante y restaurante
							mediterráneo, y le da {business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas. Abre todos los días de
							8:00 a 24:00, sin día de cierre.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>Llamar al {business.phone}</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas
								</strong>
							</li>
						</ul>
					</div>

					<div class="hero-collage">
						{collage.map((item, index) => (
							<figure class={item.clase}>
								<Image
									src={foto(item.name)}
									alt={altFoto}
									widths={index === 0 ? [640, 900, 1200] : [320, 480, 640]}
									sizes={
										index === 0
											? '(max-width: 1080px) 92vw, 46vw'
											: '(max-width: 1080px) 45vw, 23vw'
									}
									format="webp"
									quality={68}
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : undefined}
									decoding="async"
								/>
							</figure>
						))}
					</div>
				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
					{business.reviewCount.toLocaleString('es-ES')} reseñas
				</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>{hoursSummary}</span>
				<span>Teléfono {business.phone}</span>
			</div>

			<section class="section" id="local" aria-labelledby="local-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">La casa</p>
						<h2 class="title" id="local-title">
							Taberna, terraza y barra,
							<br />
							<em>en el centro de Ciudad Real.</em>
						</h2>
						<p>
							Google lo clasifica como restaurante y restaurante mediterráneo. Le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas. Está en la Avenida
							Torreón del Alcázar, 9, con código postal 13004, y la ficha publica su plus code
							X3MH+V2 Ciudad Real.
						</p>
						<p class="descripcion">{descripcionLocal}</p>
						<p>
							Abre todos los días de 8:00 a 24:00, sin día de cierre. Google muestra junto al
							nombre el distintivo «{distintivo}», el único de ese tipo que publica la ficha.
						</p>
						<p>
							Esta web se ha preparado solo con lo que publica esa ficha, consultada el{' '}
							{site.consultado}: nombre, dirección, teléfono, categorías, horario, valoración,
							servicios de accesibilidad, el distintivo, la descripción del titular, las{' '}
							{numeroResenas} reseñas que destaca y sus propias fotografías. La ficha no
							publica los precios, así que aquí no se reproducen.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>{business.reviewCount.toLocaleString('es-ES')} reseñas en Google Maps</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver todas ↗</a>
						</div>
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									<strong>{review.rating} sobre 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section cocina" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						La barra <em>por dentro.</em>
					</h2>
					<p class="lead">
						Son las diez fotografías que Pura Cepa Neotaberna publica en su ficha de Google
						Maps, todas atribuidas al propio local. La ficha no trae una descripción del
						contenido de estas fotos, así que no se inventa ninguna y los textos alternativos
						solo avisan de dónde salen.
					</p>
					<div class="cocina-grid">
						{galeria.map((name) => (
							<figure class="cocina-item">
								<Image
									src={foto(name)}
									alt={altFoto}
									widths={[380, 560, 800]}
									sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
									format="webp"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>Foto de {autorFoto}</figcaption>
							</figure>
						))}
					</div>
					<p class="cocina-note">
						La ficha no publica los precios, así que esta web no los reproduce. Para saber qué
						hay hoy, lo más rápido es{' '}
						<a href={phoneHref}>llamar al {business.phone}</a> o mirar las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos y reseñas de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Avenida Torreón del Alcázar, 9,
							<br />
							<em>13004 Ciudad Real.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr class:list={[{ 'is-closed': item.shifts.length === 0 }]}>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							La ficha publica el <strong>mismo horario los siete días, de 8:00 a 24:00, sin
							día de cierre</strong> (el cierre se escribe como 00:00 en los datos estructurados).
							Es el horario que publica la ficha consultada el {site.consultado}, con el aviso
							de que el lunes 12, Fiesta Nacional de España, podría ser diferente. Conviene
							confirmar por teléfono antes de ir.
						</p>
						<ul class="access-list">
							{accesibilidad.map((item) => (
								<li class:list={[{ 'is-no': !item.disponible }]}>{item.label}</li>
							))}
						</ul>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>llamar.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">PC</span>
					<span>
						Pura Cepa Neotaberna
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Pura Cepa Neotaberna · Avenida Torreón del Alcázar, 9
					(13004 Ciudad Real). Web informativa elaborada con los datos y las fotografías que el
					local publica en su ficha de Google Maps, consultada el {site.consultado}. Confirma
					horario y disponibilidad por teléfono antes de salir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/pura-cepa-neotaberna/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/pura-cepa-neotaberna/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/pura-cepa-neotaberna/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a Pura Cepa Neotaberna <span>{business.phone}</span>
		</a>

	</body>
</html>
