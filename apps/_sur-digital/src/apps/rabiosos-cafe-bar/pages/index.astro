---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/rabiosos-terraza-exterior-frank-capra.jpg';
import fachada from '../assets/fotos/rabiosos-fachada-velero-frank-capra.jpg';
import cartaTapas from '../assets/fotos/rabiosos-carta-tapas.jpg';
import cartaBocadillos from '../assets/fotos/rabiosos-carta-bocadillos.jpg';
import barraBotelleria from '../assets/fotos/rabiosos-barra-botelleria.jpg';
import ventanalBanco from '../assets/fotos/rabiosos-ventanal-banco.jpg';
import bocadilloCompleto from '../assets/fotos/rabiosos-bocadillo-completo.jpg';
import bocadilloPollo from '../assets/fotos/rabiosos-bocadillo-pollo.jpg';
import bocadilloMano from '../assets/fotos/rabiosos-bocadillo-mano.jpg';
import empanadas from '../assets/fotos/rabiosos-empanadas-argentinas.jpg';
import empanadaCalzone from '../assets/fotos/rabiosos-empanada-calzone.jpg';
import croquetasCena from '../assets/fotos/rabiosos-croquetas-cena.jpg';
import papasBandeja from '../assets/fotos/rabiosos-papas-bandeja.jpg';
import papasPlato from '../assets/fotos/rabiosos-papas-plato.jpg';
import cafeTostada from '../assets/fotos/rabiosos-cafe-tostada.jpg';
import cafeTaza from '../assets/fotos/rabiosos-cafe-taza.jpg';
import latte from '../assets/fotos/rabiosos-latte.jpg';
import huevosRotos from '../assets/fotos/rabiosos-huevos-rotos.jpg';
import sopaPollo from '../assets/fotos/rabiosos-sopa-pollo.jpg';
import cervezaCroquetas from '../assets/fotos/rabiosos-cerveza-croquetas.jpg';
import decoracionPared from '../assets/fotos/rabiosos-decoracion-pared.jpg';
import cocotero from '../assets/fotos/rabiosos-cocotero-planta.jpg';

const business = {
	name: 'Rabiosos Cafe Bar',
	tagline: 'Café, bocadillos y tapas en Teatinos',
	street: 'C. Frank Capra, 8, local 13',
	district: 'Teatinos-Universidad',
	city: 'Málaga',
	postalCode: '29010',
	phone: '623 32 27 51',
	latitude: 36.7188074,
	longitude: -4.4605594,
	rating: 4.0,
	reviewsCount: 186,
	site: 'https://www.sur-digital.com/rabiosos-cafe-bar',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd72f734c4ff32d7:0x5ce70543f0fdfb11';
const cidDecimal = '6694325160473656081';
const placeId = 'ChIJ1zL_xDT3cg0REfv98EMF51w';

const mapsUrl = `https://www.google.com/maps/place/?q=place_id:${placeId}&hl=es`;
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34623322751';

const description =
	'Rabiosos Cafe Bar en C. Frank Capra, 8, local 13 (Teatinos, Málaga). Bocadillos, empanadas argentinas, croquetas, hamburguesas y tapas con producto propio. Abierto de lunes a viernes de 7:30 a 1:00. Tel. 623 32 27 51.';

const servicios = [
	'Bocadillos',
	'Empanadas argentinas',
	'Tapas',
	'Croquetas caseras',
	'Hamburguesas de carne madurada',
	'Café y desayuno',
	'Comida para llevar',
	'Tortitas de camarones',
	'Berenjenas al escabeche',
	'Croissant relleno',
	'Choricitos a la sidra',
	'Terraza en la calle',
	'Aire acondicionado',
	'Barrio de Teatinos',
];

// Carta transcrita de las fotos de la carta del propio local publicadas en Google Maps.
const grupos = [
	{
		title: 'Bocadillos',
		items: [
			{ name: 'Pitufo normal o integral', note: 'con el relleno a elegir' },
			{ name: 'Atún, queso fresco o salchichón', note: 'los clásicos' },
			{ name: 'Jamón, jamón serrano o pavo' },
			{ name: 'Mixto, con manchego o con queso fresco', note: 'hay que elegir entre más de treinta rellenos' },
			{ name: 'Wrap de tortilla de patata o de pollo', note: 'una alternativa más ligera al bocadillo' },
		],
	},
	{
		title: 'Tapas',
		items: [
			{ name: 'Empanada argentina', note: 'de carne, de jamón y queso o de humita, y también en versión Cocktail' },
			{ name: 'Croquetas y croquetas de camarones', note: 'por ración, y se pueden pedir en versión Cocktail' },
			{ name: 'Gilda, pulpo o boquerones', note: 'sobre pan, con alcaparras o aceitunas' },
			{ name: 'Boquerones en vinagre y albóndigas de almendra', note: 'las clásicas de barra' },
			{ name: 'Tortitas de camarones, berenjenas al escabeche y choricitos a la sidra', note: 'platos propios que no faltan en la barra' },
		],
	},
	{
		title: 'Empanadas, desayuno y bar',
		items: [
			{ name: 'Empanada de carne, jamón y queso o humita', note: 'la especialidad del local, recomendada en casi todas las reseñas' },
			{ name: 'Croissant solo o relleno', note: 'con jamón y queso, mixto o mixto vegetal' },
			{ name: 'Café, café con leche y cortado', note: 'la base de la casa, servida en las mesas de terraza y del ventanal' },
			{ name: 'Cerveza y combinados', note: 'con una carta amplia de licores y aperitivos' },
			{ name: 'Zumos, refrescos y agua', note: 'junto con café, té y zumos naturales' },
		],
	},
];

const galeria = [
	{ src: cartaTapas, alt: 'Carta de tapas de Rabiosos Cafe Bar en Teatinos, Málaga' },
	{ src: cartaBocadillos, alt: 'Carta de bocadillos de Rabiosos Cafe Bar en Teatinos, Málaga' },
	{ src: empanadas, alt: 'Empanadas argentinas caseras de Rabiosos Cafe Bar, Teatinos, Málaga' },
	{ src: empanadaCalzone, alt: 'Empanada cerrada al estilo calzone en Rabiosos Cafe Bar, cafetería en Teatinos, Málaga' },
	{ src: croquetasCena, alt: 'Croquetas caseras crocantes con papas fritas en Rabiosos Cafe Bar, Teatinos, Málaga' },
	{ src: papasBandeja, alt: 'Papas fritas con salsas en Rabiosos Cafe Bar, bar y cafetería en Málaga' },
	{ src: papasPlato, alt: 'Plato de papas fritas en Rabiosos Cafe Bar, cafetería en Teatinos, Málaga' },
	{ src: bocadilloCompleto, alt: 'Bocadillo completo servido en Rabiosos Cafe Bar en Teatinos, Málaga' },
	{ src: bocadilloPollo, alt: 'Bocadillo de pollo con tomate y aguacate en Rabiosos Cafe Bar, Teatinos, Málaga' },
	{ src: bocadilloMano, alt: 'Bocadillo casero sostenido a mano en Rabiosos Cafe Bar, cafetería en Teatinos' },
	{ src: huevosRotos, alt: 'Huevos rotos con bacon en Rabiosos Cafe Bar, desayuno en Teatinos, Málaga' },
	{ src: sopaPollo, alt: 'Sopa de pollo con garbanzos en Rabiosos Cafe Bar, Teatinos, Málaga' },
	{ src: cafeTostada, alt: 'Café con leche junto a un bocadillo en Rabiosos Cafe Bar, Teatinos, Málaga' },
	{ src: cafeTaza, alt: 'Café con arte en la espuma en Rabiosos Cafe Bar, cafetería en Teatinos, Málaga' },
	{ src: latte, alt: 'Café con leche servido en Rabiosos Cafe Bar, cafetería en Teatinos, Málaga' },
	{ src: cervezaCroquetas, alt: 'Cerveza fría con croquetas en Rabiosos Cafe Bar, bar en Teatinos, Málaga' },
	{ src: barraBotelleria, alt: 'Estantería con botellas en la barra de Rabiosos Cafe Bar en Teatinos, Málaga' },
	{ src: ventanalBanco, alt: 'Mesas junto al ventanal de Rabiosos Cafe Bar en Teatinos, Málaga' },
	{ src: decoracionPared, alt: 'Pared del interior de Rabiosos Cafe Bar con decoración, Teatinos, Málaga' },
	{ src: cocotero, alt: 'Planta junto a la barra de Rabiosos Cafe Bar en Teatinos, Málaga' },
	{ src: fachada, alt: 'Fachada de Rabiosos Cafe Bar en la calle Frank Capra, Teatinos, Málaga' },
];

const faqs = [
	{
		q: '¿Dónde está Rabiosos Cafe Bar?',
		a: 'En la calle Frank Capra, 8, local 13, en el barrio de Teatinos-Universidad (29010 Málaga), dentro de un conjunto de locales con acceso desde la calle. Tiene mesas en la terraza exterior y un ventanal que da a la calle.',
	},
	{
		q: '¿Cuál es el horario de Rabiosos?',
		a: 'Abre de lunes a viernes de 7:30 a la 1:00 de la madrugada, para Breakfast, café, bocadillos y la tarde de barra. Los sábados y domingos está cerrado, así que conviene confirmar antes de venir el fin de semana.',
	},
	{
		q: '¿Qué specialty tiene Rabiosos?',
		a: 'Las empanadas. La propia carta distingue entre la empanada argentina clásica, la de jamón y queso y la de humita, y las reseñas las mencionan entre lo mejor del local. También las hacen en versión Cocktail, pensadas para acompañar una caña.',
	},
	{
		q: '¿Cuántos bocadillos hay en la carta?',
		a: 'Más de treinta, con pan normal o integral. Los hay de pitufo, de tortilla, de lomo en manteca, de atún, de queso manchego, de jamón cocido, de paveto, de tortilla francesa o de patata, entre otros. Sobre el bocadillo se puede añadir un extra de queso loncha, jamón cocido, pavo, serrano, manchego, bacon, atún o huevo por muy poco.',
	},
	{
		q: '¿Sirve desayuno?',
		a: 'Sí. Abre a las 7:30 entre semana, así que se puede desayunar con café, croissant solo o relleno, tortilla, huevos o un bocadillo. También hay tostas, tostadas y platos para empezar el día.',
	},
	{
		q: '¿Se puede comer o tomar algo para llevar?',
		a: 'Sí. Se puede pedir para llevar y recoger en el mostrador. También hay formatos Cocktail de croquetas y empanadas, pensados para acompañar una caña en la barra',
	},
	{
		q: '¿Rabiosos es un sitio ambiente LGBTQ+?',
		a: 'Sí, así figura en la ficha de Google Maps del local, que lo marca como cafetería y bar con ambiente LGBTQ+-friendly.',
	},
	{
		q: '¿Dónde aparcar o cómo llegar?',
		a: 'Está en Teatinos-Universidad, a poca distancia de la Universidad. Puedes llegar andando desde el campus o en transporte público; la forma más cómoda es consultar la ruta en Google Maps con el botón de cómo llegar de esta misma web.',
	},
	{
		q: '¿Cómo contacto con Rabiosos Cafe Bar?',
		a: 'Por teléfono en el 623 32 27 51, el número que aparece en su ficha de Google Maps. Es la vía más rápida para confirmar si hay algo concreto en la carta o si el local tiene algún evento en portada.',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': ['CafeOrCoffeeShop', 'Bar', 'Restaurant'],
	'@id': `${business.site}/#negocio`,
	name: business.name,
	alternateName: ['Rabiosos', 'Rabiosos Café Bar', 'Rabiosos Teatinos', 'Rabiosos Frank Capra'],
	slogan: 'Bocadillos, empanadas y bar en Teatinos',
	description,
	url: `${business.site}/`,
	telephone: '+34 623 32 27 51',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cafetería', 'Bocadillos', 'Tapas', 'Desayunos', 'Comida argentina'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	image: `${business.site}/og.jpg`,
	sameAs: [mapsUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '00:00',
			closes: '00:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:30',
			closes: '01:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza exterior', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aire acondicionado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Desayunos', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Comida para llevar', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Empanadas argentinas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Bocadillos', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Rabiosos Cafe Bar · Bocadillos y tapas en Teatinos, Málaga</title>
		<meta name="theme-color" content="#922f2c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="bocadillos Teatinos, Rabiosos Málaga, cafe bar Teatinos, cafetería 29010 Málaga, bocadillo Málaga Universidad, empanadas argentinas Teatinos, croquetas Málaga, hamburguesa Teatinos, bar Frank Capra, desayuno Teatinos, cafeteria 29010, comida para llevar Teatinos, tapas Teatinos, empanada Málaga"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Rabiosos Cafe Bar · Bocadillos, empanadas y bar en Teatinos, Málaga"
			ogDescription="Más de treinta bocadillos, empanadas argentinas y croquetas caseras en C. Frank Capra, 8, local 13, Teatinos. De lunes a viernes de 7:30 a 1:00."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Terraza de Rabiosos Cafe Bar en la calle Frank Capra, Teatinos, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#922f2c"
			street={business.street}
			city={business.city}
			region="Andalucía"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Teatinos-Universidad, Málaga"
			contact={{
				street: business.street,
				locality: business.city,
				region: 'Andalucía',
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[heroImage]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://www.sur-digital.com/rabiosos-cafe-bar/og.jpg" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7188074;-4.4605594" />
		<meta name="ICBM" content="36.7188074, -4.4605594" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="R"
			name="Rabiosos"
			subtitle="Cafe Bar"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Teatinos · Málaga"
				title="Más de treinta<br /><em>bocadillos y un bar.</em>"
				lede="Rabiosos Cafe Bar está en la calle Frank Capra, 8, local 13, en pleno Teatinos. Un café que abre a las 7:30 y no cierra hasta la una: desayuno, bocadillos, empanadas argentinas, croquetas caseras y la barra de la tarde. 4,0 en Google."
				image={heroImage}
				imageAlt="Terraza de Rabiosos Cafe Bar con mesas en la calle Frank Capra, Teatinos, Málaga"
				primaryCta={{ label: 'Llamar 623 32 27 51', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,0</b> en Google (186 reseñas)' },
					{ label: 'Horario', html: 'Lunes a viernes, <b>7:30–1:00</b>' },
					{ label: 'Fin de semana', html: 'Cerrado' },
					{ label: 'Especialidad', html: 'Empanadas <b>argentinas</b> y bocadillos' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Rabiosos" items={servicios} />

			<LocalAbout
				label="Café, bocadillos y bar"
				title="Abierto de la mañana<br /><em>hasta la una.</em>"
				paragraphs={[
					'Rabiosos ocupa el local 13 del número 8 de la calle Frank Capra, en el corazón del barrio de Teatinos-Universidad, a muy poca distancia de los edificios de la Universidad. El horario lo dice casi todo: abre a las 7:30 de la mañana y no cierra hasta la una de la madrugada, de lunes a viernes.',
					'Por la mañana funciona como café y Breakfast: café, croissant solo o relleno, tortilla, huevos, tostadas y bocadillos. A partir de mediodía la carta se abre a los bocadillos y a las tapas, y por la tarde ya es un bar con birras, copas y la bantería de siempre.',
					'Lo que distingue a Rabiosos del resto de cafeterías del barrio es la carta. Hay más de treinta bocadillos, con pan normal o integral y con la posibilidad de añadir un extra de queso, jamón, pavo, serrano, manchego, bacon, atún o huevo. Y hay una parte de tapas con producto propio que va desde la empanada argentina y las croquetas hasta las tortitas de camarones o las berenjenas al escabeche.',
					'El local es de los que se llena de gente entre clase y clase. Tiene mesas en la terraza exterior, un ventanal a la calle y un interior con una barra amplia y mucho donde elegir.',
				]}
				note="La nota media en Google es de 4,0 sobre 186 reseñas. Lo más citado: la variedad y la calidad de los bocadillos, las empanadas, el crocante de las croquetas y el trato del personal."
				links={[{ label: 'Ficha y reseñas en Google', href: cidUrl, external: true }]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Bocadillos,<br /><em>empanadas y tapas.</em>"
				description="Selección de la carta real de Rabiosos, transcrita de las fotos de la carta que hay en su ficha de Google Maps. Los precios que se indican con los que aparecen en esas fotos y pueden cambiar con el tiempo."
				cta={{ label: 'Llamar para preguntar', href: phoneHref }}
				groups={grupos}
				note="Los precios y la disponibilidad pueden variar: la carta cambia con frecuencia. Los formatos para llevar y las versiones Cocktail suelen tener condiciones distintas. Para confirmar, llama al 623 32 27 51."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La carta, la barra<br /><em>y las mesas.</em>"
				description="Estas fotografías proceden del perfil de Rabiosos Cafe Bar en Google Maps: la carta del local, los bocadillos, las empanadas, la barra y el interior. En la ficha están todas las fotos y las reseñas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del local en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="C. Frank Capra, 8 · 29010 Málaga"
				title="Nos vemos<br /><em>en Teatinos.</em>"
				addressLines={[
					business.street,
					business.district,
					`${business.postalCode} ${business.city}, España`,
				]}
				hours={[
					{ day: 'Lunes', value: '7:30–1:00' },
					{ day: 'Martes', value: '7:30–1:00' },
					{ day: 'Miércoles', value: '7:30–1:00' },
					{ day: 'Jueves', value: '7:30–1:00' },
					{ day: 'Viernes', value: '7:30–1:00' },
					{ day: 'Sábado', value: 'Cerrado', closed: true },
					{ day: 'Domingo', value: 'Cerrado', closed: true },
				]}
				hoursNote="Horario publicado en la ficha de Google: de lunes a viernes de 7:30 a 1:00 de la madrugada, y cerrado el fin de semana. Puede variar en festivos, así que llama antes si vienes de lejos."
				mapTitle="Mapa de Rabiosos Cafe Bar en la calle Frank Capra, 8, Teatinos-Universidad, Málaga"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Rabiosos · Teatinos"
				mapHref={cidUrl}
				links={[{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' }]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="No hay reserva en línea: es un local de sala, terraza y barra por orden de llegada. Para pedidos o grupos, llama al 623 32 27 51."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="R"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Ficha y fotos ↗', href: cidUrl, external: true },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Rabiosos"
		/>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/rabiosos-cafe-bar/aviso-legal">Aviso legal</a>
			<a href="/rabiosos-cafe-bar/aviso-legal#privacidad">Privacidad</a>
			<a href="/rabiosos-cafe-bar/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
