---
import { BUSINESS, NAV } from '../data/site';

interface Props {
	base?: string;
}

const { base = '' } = Astro.props;
---

<div class="border-base-300 bg-base-100/95 sticky top-0 z-50 border-b backdrop-blur-md">
	<header
		class="mx-auto flex h-[4.75rem] max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
	>
		<a href={`${base}#inicio`} class="group flex items-baseline gap-2.5" aria-label={BUSINESS.name}>
			<span class="font-display text-[1.9rem] leading-none font-semibold tracking-[-0.05em]">
				Antic<span class="text-primary">.</span>
			</span>
			<span class="label text-base-content/45 hidden text-[0.5rem] sm:block">
				Restaurante · Castelló
			</span>
		</a>

		<nav class="hidden items-center gap-7 lg:flex" aria-label="Navegación principal">
			{NAV.map((item) => (
				<a
					href={`${base}${item.href}`}
					class="text-base-content/65 hover:text-primary label text-[0.57rem] transition-colors"
				>
					{item.label}
				</a>
			))}
		</nav>

		<div class="flex items-center gap-2">
			<a
				href={BUSINESS.phoneHref}
				class="text-base-content/70 hover:text-primary hidden items-center gap-2 text-sm font-semibold transition-colors sm:inline-flex"
			>
				<i class="ri-phone-line text-base" aria-hidden="true"></i>
				{BUSINESS.phone}
			</a>
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-neutral btn-sm h-10 gap-2 rounded-sm px-4 text-[0.62rem] font-bold tracking-[0.12em] uppercase"
			>
				<i class="ri-arrow-right-up-line text-base" aria-hidden="true"></i>
				<span class="hidden sm:inline">Cómo llegar</span>
				<span class="sm:hidden">Ruta</span>
			</a>
			<details class="dropdown dropdown-end lg:hidden">
				<summary class="btn btn-ghost btn-sm h-10 rounded-sm" aria-label="Abrir menú">
					<i class="ri-menu-line text-xl" aria-hidden="true"></i>
				</summary>
				<ul class="menu dropdown-content border-base-300 bg-base-100 rounded-box z-50 mt-2 w-64 border p-2 shadow-xl">
					{NAV.map((item) => (
						<li>
							<a href={`${base}${item.href}`}>{item.label}</a>
						</li>
					))}
					<li>
						<a href={`${base}aviso-legal`}>Aviso legal</a>
					</li>
					<li>
						<a href={BUSINESS.phoneHref}>
							<i class="ri-phone-line" aria-hidden="true"></i> {BUSINESS.phone}
						</a>
					</li>
				</ul>
			</details>
		</div>
	</header>
</div>
