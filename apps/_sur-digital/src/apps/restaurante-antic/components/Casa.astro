---
import { Image } from 'astro:assets';
import { BUSINESS, CASA_FACTS, IMAGES } from '../data/site';
---

<section id="casa" class="bg-neutral text-neutral-content relative overflow-hidden py-20 sm:py-24">
	<div
		class="pointer-events-none absolute -top-20 -right-24 size-96 rounded-full border border-white/5"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-12 lg:grid-cols-[0.94fr_1.06fr] lg:gap-16">
			<div class="relative">
				<figure class="relative overflow-hidden">
					<Image
						src={IMAGES.fotoFachada}
						alt="Fachada de Antic en la calle Herrero: rótulo ovalado Antic Restaurante, toldo de Bocatería Cafetería Antic y veladores en la acera"
						widths={[560, 840, 1120]}
						sizes="(min-width: 1024px) 44vw, 100vw"
						class="aspect-[4/5] w-full object-cover"
						loading="lazy"
					/>
				</figure>
				<figure
					class="border-neutral bg-base-100 absolute -right-2 -bottom-8 w-36 overflow-hidden border-4 shadow-2xl sm:-right-6 sm:w-44"
				>
					<Image
						src={IMAGES.fotoCarajilloDetalle}
						alt="Carajillo en vaso, servido en la barra de Antic"
						widths={[220, 360]}
						sizes="176px"
						class="aspect-square w-full object-cover"
						loading="lazy"
					/>
					<figcaption class="text-base-content/50 px-2 py-1.5 text-center text-[0.5rem]">
						El carajillo de la casa
					</figcaption>
				</figure>
			</div>

			<div class="lg:pl-4">
				<p class="label text-accent">— La casa</p>
				<h2
					class="font-display mt-3 text-4xl leading-[0.98] font-semibold tracking-[-0.03em] sm:text-5xl"
				>
					El de siempre,<br />
					<span class="text-accent italic">con las luces encendidas</span>
				</h2>

				<p class="mt-6 max-w-xl text-base leading-relaxed text-white/70">
					Antic significa antiguo. El rótulo de Bocatería-Cafetería sigue en la fachada de la calle
					Herrero, y el local mantiene lo que le funciona: la cafetería de primera hora, el
					bocadillo montado al momento y la mesa de la terraza.
				</p>
				<p class="mt-4 max-w-xl text-base leading-relaxed text-white/70">
					Hoy es también restaurante y pizzería. Interiores claros, ambiente agradable y apto para
					todos los públicos, con una cocina sencilla y moderna que funciona con menú del día y
					carta completa.
				</p>

				<div class="mt-9 grid grid-cols-2 gap-px border border-white/10 bg-white/10">
					{CASA_FACTS.map((dato) => (
						<div class="bg-neutral px-4 py-5">
							<p class="label text-[0.48rem] text-white/40">{dato.label}</p>
							<p class="font-display mt-1.5 text-2xl leading-none font-semibold">{dato.value}</p>
						</div>
					))}
				</div>

				<div class="mt-7 flex flex-wrap items-center gap-3">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="label inline-flex items-center gap-2 text-[0.55rem] text-accent underline decoration-accent/40 underline-offset-4"
					>
						<i class="ri-google-fill" aria-hidden="true"></i> Ver la ficha en Google
					</a>
					<span class="text-white/20" aria-hidden="true">/</span>
					<a
						href={BUSINESS.phoneHref}
						class="label inline-flex items-center gap-2 text-[0.55rem] text-white/60 underline decoration-white/20 underline-offset-4"
					>
						<i class="ri-phone-line" aria-hidden="true"></i> {BUSINESS.phone}
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
