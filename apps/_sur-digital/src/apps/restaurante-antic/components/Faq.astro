---
import { BUSINESS, FAQ } from '../data/site';
---

<section id="faq" class="bg-base-100 border-base-300 border-t py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-10 lg:grid-cols-[0.62fr_1.38fr] lg:gap-16">
			<div class="lg:sticky lg:top-28 lg:self-start">
				<p class="label text-primary">— Preguntas frecuentes</p>
				<h2 class="font-display mt-3 text-4xl leading-[0.98] font-semibold tracking-[-0.03em] sm:text-5xl">
					Antes de<br />
					<span class="text-primary italic">venir</span>
				</h2>
				<p class="text-base-content/60 mt-5 max-w-xs text-sm leading-relaxed">
					Horario, menú, terraza y accesibilidad. Si queda alguna duda, llama al restaurante.
				</p>
				<a
					href={BUSINESS.phoneHref}
					class="label mt-5 inline-flex items-center gap-2 text-[0.55rem] text-primary underline decoration-primary/30 underline-offset-4"
				>
					<i class="ri-phone-line" aria-hidden="true"></i> {BUSINESS.phone}
				</a>
			</div>

			<div class="border-base-300 border-t">
				{FAQ.map((item, index) => (
					<details class="group border-base-300 border-b" open={index === 0}>
						<summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left">
							<span class="flex items-baseline gap-4">
								<span class="font-display text-base-content/30 text-sm italic">
									{String(index + 1).padStart(2, '0')}
								</span>
								<span class="text-base font-semibold sm:text-lg">{item.q}</span>
							</span>
							<span
								class="border-base-300 text-primary flex size-8 shrink-0 items-center justify-center rounded-full border transition-transform group-open:rotate-45"
							>
								<i class="ri-add-line text-lg" aria-hidden="true"></i>
							</span>
						</summary>
						<p class="text-base-content/65 max-w-2xl pb-6 pl-9 text-sm leading-relaxed">
							{item.a}
						</p>
					</details>
				))}
			</div>
		</div>
	</div>
</section>
