---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	descripcionTitular,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	platos,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Café Bar El Reencuentro | Tapas en Sanlúcar de Barrameda';
const description =
	'Café Bar El Reencuentro, en la calle Pozo Amarguillo, 53 de Sanlúcar de Barrameda. 4,5 sobre 5 con 150 reseñas; abre de martes a domingo de 9:00 a 17:00.';
const keywords =
	'Café Bar El Reencuentro, El Reencuentro Sanlúcar, bar Sanlúcar de Barrameda, tapas Sanlúcar, Pozo Amarguillo, bar de barrio Sanlúcar, sopa de galeras, carrillada, pescaito frito, El Reencuentro teléfono';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas diez fotografías y el manifiesto de la descarga no
 * atribuye autor, así que no se inventa una descripción ni una atribución: los `alt` avisan solo
 * de dónde salen.
 */
const altFoto =
	'Fotografía publicada en la ficha de Google Maps de Café Bar El Reencuentro, en Sanlúcar de Barrameda';
const altOg = 'Fotografía de Café Bar El Reencuentro publicada en su ficha de Google Maps';

/** Galería completa: las diez fotografías de la ficha, en el orden en que se descargaron. */
const galeria = [
	'cafe-bar-el-reencuentro-vertical-01.jpg',
	'cafe-bar-el-reencuentro-vertical-02.jpg',
	'cafe-bar-el-reencuentro-apaisada-07.jpg',
	'cafe-bar-el-reencuentro-vertical-03.jpg',
	'cafe-bar-el-reencuentro-apaisada-08.jpg',
	'cafe-bar-el-reencuentro-vertical-04.jpg',
	'cafe-bar-el-reencuentro-vertical-05.jpg',
	'cafe-bar-el-reencuentro-vertical-06.jpg',
	'cafe-bar-el-reencuentro-panoramica-10.jpg',
	'cafe-bar-el-reencuentro-vertical-09.jpg',
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1f5c4d" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CA" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/cafe-bar-el-reencuentro/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Figtree:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<header class="topbar">
			<div class="topbar-row">
				<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
					<span class="brand-mark" aria-hidden="true">
						ER
					</span>
					<span class="brand-text">
						El Reencuentro
						<small>Café bar · Sanlúcar</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					<a href="#casa">La casa</a>
					<a href="#mesa">La mesa</a>
					<a href="#fotos">Las fotos</a>
					<a href="#horario">Horario</a>
					<a href="#preguntas">Preguntas</a>
				</nav>
				<a class="topbar-phone" href={phoneHref}>
					<span aria-hidden="true">☎</span>
					{business.phone}
				</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<div class="hero-tags">
							<p class="eyebrow">Sanlúcar · Bar de barrio</p>
							<span class="badge-pill">Bar restaurante</span>
						</div>
						<h1 id="hero-title">
							<span class="h1-kicker">Café Bar</span>
							El <mark>Reencuentro</mark>
						</h1>
						<p class="hero-sub">Tapas y cocina casera en Sanlúcar de Barrameda</p>
						<p class="hero-lede">
							En la calle Pozo Amarguillo, 53. Google lo clasifica como{' '}
							<strong>bar restaurante</strong> y <strong>bar</strong>, y le da{' '}
							<strong>{business.rating.toLocaleString('es-ES')} sobre 5</strong> con{' '}
							<strong>{business.reviewCount.toLocaleString('es-ES')} reseñas</strong>. Abre de
							martes a domingo, de 9:00 a 17:00; los lunes cierra.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>
								Llamar al {business.phone}
							</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas
								</strong>
							</li>
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
						</ul>
					</div>

					<div class="hero-media">
						<figure class="hero-circle">
							<Image
								src={foto('cafe-bar-el-reencuentro-vertical-01.jpg')}
								alt={altFoto}
								widths={[420, 640, 860]}
								sizes="(max-width: 1080px) 80vw, 34vw"
								format="webp"
								quality={70}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</figure>
						<figure class="hero-small hero-small-a">
							<Image
								src={foto('cafe-bar-el-reencuentro-vertical-02.jpg')}
								alt={altFoto}
								widths={[220, 340, 480]}
								sizes="(max-width: 1080px) 40vw, 17vw"
								format="webp"
								quality={68}
								loading="eager"
								decoding="async"
							/>
						</figure>
						<figure class="hero-small hero-small-b">
							<Image
								src={foto('cafe-bar-el-reencuentro-apaisada-07.jpg')}
								alt={altFoto}
								widths={[220, 340, 480]}
								sizes="(max-width: 1080px) 40vw, 17vw"
								format="webp"
								quality={68}
								loading="eager"
								decoding="async"
							/>
						</figure>
						<p class="hero-note">Abierto de martes a domingo · 9:00–17:00</p>
						<p class="hero-caption">Fotos publicadas por el local en Google Maps.</p>
					</div>
				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 ·{' '}
					{business.reviewCount.toLocaleString('es-ES')} reseñas
				</span>
				<span>{business.streetAddress}</span>
				<span>Martes a domingo · 9:00–17:00</span>
				<span>Lunes cerrado</span>
			</div>

			<section class="section" id="casa" aria-labelledby="casa-title">
				<div class="wrap casa-grid">
					<figure class="casa-photo">
						<Image
							src={foto('cafe-bar-el-reencuentro-apaisada-08.jpg')}
							alt={altFoto}
							widths={[520, 800, 1100]}
							sizes="(max-width: 1080px) 92vw, 44vw"
							format="webp"
							quality={70}
							loading="lazy"
							decoding="async"
						/>
					</figure>

					<div class="casa-text">
						<p class="kicker">La casa</p>
						<h2 class="title" id="casa-title">
							Pequeño, acogedor
							<br />
							<em>y sin pretensiones.</em>
						</h2>
						<p>
							Café Bar El Reencuentro es un bar de barrio en la calle Pozo Amarguillo, 53, en
							Sanlúcar de Barrameda. Google lo clasifica como <strong>bar restaurante</strong> y{' '}
							<strong>bar</strong>, y en la ficha consultada el {site.consultado} tenía{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas.
						</p>
						<p>
							Abre de martes a domingo, de 9:00 a 17:00. El lunes figura como cerrado, así que la
							semana empieza el martes por la mañana. En las reseñas destacadas se habla de tapas,
							montaditos y platos de cuchara, y del trato del camarero.
						</p>
						<p>
							La ficha no publica carta ni precios, así que esta web no los inventa. Sí publica dos
							datos de accesibilidad: acceso y asientos adaptados para sillas de ruedas.
						</p>
						<div class="casa-quote">
							{descripcionTitular}
							<cite>Resumen de la descripción del titular en Google Maps</cite>
						</div>
						<ul class="tag-list" aria-label="Datos que publica la ficha">
							<li>{business.category}</li>
							<li>Bar</li>
							<li>Martes a domingo</li>
							<li>Lunes cerrado</li>
							<li>Acceso adaptado</li>
							<li>Asientos adaptados</li>
						</ul>
					</div>
				</div>
			</section>

			<section class="section mesa" id="mesa" aria-labelledby="mesa-title">
				<div class="wrap mesa-grid">
					<div class="mesa-text">
						<p class="kicker">La mesa</p>
						<h2 class="title" id="mesa-title">
							Ocho nombres,
							<br />
							<em>ninguna carta inventada.</em>
						</h2>
						<p>
							La ficha no publica carta ni precios. Estos son los platos que aparecen en las tres
							reseñas que Google destaca, copiados de lo que escriben los clientes. No es una lista
							oficial del local ni lleva importes.
						</p>
						<div class="mesa-nota">
							<strong>Cómo leer esta lista</strong>
							Sopa de galeras, carrillada, berza, pescaito frito y paella salen de una reseña;
							caracoles, montaditos y tapitas, de otra. Para saber qué hay hoy y cuánto cuesta, hay
							que llamar al local.
						</div>
					</div>
					<div>
						<ul class="mesa-lista">
							{platos.map((plato) => (
								<li>
									<span class="nombre">{plato.nombre}</span>
									<span class="origen">{plato.origen}</span>
								</li>
							))}
						</ul>
						<p class="mesa-pie">
							Teléfono del local: <a href={phoneHref}>{business.phone}</a>. También puedes leer las{' '}
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
								reseñas completas en Google Maps ↗
							</a>
						</p>
					</div>
				</div>
			</section>

			<section class="section" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<div class="reviews-head">
						<div>
							<p class="kicker">Las reseñas</p>
							<h2 class="title" id="resenas-title">
								Lo que dicen
								<br />
								<em>los clientes.</em>
							</h2>
						</div>
						<p class="score">
							<strong>{business.rating.toLocaleString('es-ES')}</strong>
							<span>{business.reviewCount.toLocaleString('es-ES')} reseñas</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
								Ver todas ↗
							</a>
						</p>
					</div>
					<div class="reviews-grid">
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>«{review.text}»</p>
								<footer>
									<strong>{review.rating} sobre 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
					<p class="reviews-note">
						Son las tres reseñas que la ficha destaca, copiadas tal cual (con su ortografía y su
						puntuación). No representan a todos los clientes: son una muestra de las{' '}
						{business.reviewCount.toLocaleString('es-ES')} opiniones publicadas.
					</p>
				</div>
			</section>

			<section class="section galeria" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						El Reencuentro
						<br />
						<em>en diez imágenes.</em>
					</h2>
					<p class="lead">
						Son las diez fotografías que el local publica en su ficha de Google Maps. La ficha no
						describe su contenido y el manifiesto de la descarga no atribuye autor, así que se
						muestran sin pie de autor y sin una descripción inventada.
					</p>
					<div class="galeria-grid">
						{galeria.map((name) => (
							<figure class="galeria-item">
								<Image
									src={foto(name)}
									alt={altFoto}
									widths={[380, 560, 800]}
									sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
									format="webp"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))}
					</div>
					<p class="galeria-note">
						La ficha no publica la carta ni los precios, así que esta web no los reproduce. Para
						saber qué hay hoy, llama al <a href={phoneHref}>{business.phone}</a> o mira las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos y reseñas de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section horario" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div class="horario-card">
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Pozo Amarguillo, 53
							<br />
							<em>Sanlúcar.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
							<br />
							Plus Code: {business.plusCode}
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr class:list={[{ 'is-closed': item.closed }]}>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							De martes a domingo, de 9:00 a 17:00. El lunes cierra. Es el horario de la ficha
							consultada el {site.consultado}; conviene confirmarlo por teléfono antes de ir, sobre
							todo en festivos.
						</p>
						<p class="access-title">Accesibilidad publicada en la ficha</p>
						<ul class="access-list">
							{accesibilidad.map((item) => (
								<li>{item.label}</li>
							))}
						</ul>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<div class="map-tag">
							<div>
								<strong>El Reencuentro</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap faq-grid">
					<div class="faq-intro">
						<p class="kicker">Preguntas frecuentes</p>
						<h2 class="title" id="faq-title">
							Antes de
							<br />
							<em>acercarte.</em>
						</h2>
						<p>
							Todo lo que publica la ficha de El Reencuentro, resumido sin añadir nada. Lo que la
							ficha no dice se responde diciendo que no lo dice.
						</p>
					</div>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">
						ER
					</span>
					<span>
						El Reencuentro
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Café Bar El Reencuentro · {business.streetAddress} (
					{business.postalCode} {business.city}). Web informativa elaborada con los datos y las
					fotografías que el local publica en su ficha de Google Maps, consultada el
					{site.consultado}. Confirma horario y disponibilidad por teléfono antes de salir.
				</small>
			</div>
			<a class="mobile-call" href={phoneHref}>
				Llamar a El Reencuentro <span>{business.phone}</span>
			</a>
