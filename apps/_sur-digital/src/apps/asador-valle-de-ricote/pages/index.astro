---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/asador-valle-de-ricote-apaisada-01.jpg';
import foto1 from '../assets/fotos/asador-valle-de-ricote-apaisada-06.jpg';
import foto2 from '../assets/fotos/asador-valle-de-ricote-apaisada-08.jpg';
import foto3 from '../assets/fotos/asador-valle-de-ricote-vertical-03.jpg';
import foto4 from '../assets/fotos/asador-valle-de-ricote-vertical-04.jpg';
import foto5 from '../assets/fotos/asador-valle-de-ricote-vertical-05.jpg';
import foto6 from '../assets/fotos/asador-valle-de-ricote-vertical-09.jpg';
import {
	accessibility,
	business,
	directionsUrl,
	faqs,
	faqSchema,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	site,
	specialty,
} from '../data/site';

const title = 'Asador Valle de Ricote · Asados a la brasa en Blanca';
const description =
	'Asador Valle de Ricote en Calle de Gran Vía, 46D, Blanca (Murcia). Asados a la brasa, paella de pulpo y gazpacho manchego. Tel. 608 65 30 50.';
const keywords =
	'Asador Valle de Ricote, asador Blanca Murcia, carnes a la brasa, paella de pulpo, gazpacho manchego, restaurante Valle de Ricote';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
	foto6: foto6,
};

const specialties = [
	{
		kicker: 'La brasa',
		title: 'Asados y carnes a la brasa',
		text: 'Es lo que define a la casa: un asador especializado en barbacoa, con asados y carnes a la brasa como especialidad.',
	},
	{
		kicker: 'El mar',
		title: 'Paellas de pulpo',
		text: 'La paella de pulpo aparece en la especialidad que declara el propio local, junto a los asados.',
	},
	{
		kicker: 'La tierra',
		title: 'Gazpacho manchego',
		text: 'Gazpacho manchego en la carta, con el sabor de la comarca en la que está el local.',
	},
	{
		kicker: 'El final',
		title: 'Postres caseros',
		text: 'Gran variedad de postres caseros. Las reseñas destacan la tarta de chocolate y turrón.',
	},
	{
		kicker: 'Todo el día',
		title: 'Abre a las 5:00',
		text: 'Abre todos los días de 5:00 a 17:00, y los viernes y sábados añade turno de noche de 20:00 a 24:00.',
	},
	{
		kicker: 'La mesa',
		title: 'Raciones generosas',
		text: '«Raciones generosas, buen género, buena atención, y buen precio», resume una de las reseñas destacadas.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía del Asador Valle de Ricote publicada en su ficha de Google Maps' },
	{ src: photos.foto2, alt: 'Imagen del asador en Blanca, Murcia, tomada de su galería de Google Maps' },
	{ src: photos.foto3, alt: 'Fotografía del local en la Calle de Gran Vía, 46D de Blanca' },
	{ src: photos.foto4, alt: 'Fotografía del Asador Valle de Ricote subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Imagen del restaurante en el Valle de Ricote según las fotos de su ficha' },
	{ src: photos.foto6, alt: 'Vista del Asador Valle de Ricote según las fotos de su ficha de Google Maps' },
];

const images = [
	`${site.siteUrl}/og.jpg`,
	`${site.siteUrl}${photos.hero.src}`,
	`${site.siteUrl}${photos.foto1.src}`,
	`${site.siteUrl}${photos.foto2.src}`,
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#241713" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="icon" type="image/svg+xml" href="/asador-valle-de-ricote/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Karla:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Asador Valle de Ricote · Asados a la brasa en Blanca" />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Asador Valle de Ricote, en Blanca (Murcia)" />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Asador Valle de Ricote · Asados a la brasa en Blanca" />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Blanca" />
		<meta name="geo.position" content="38.1793861;-1.3714672" />
		<meta name="ICBM" content="38.1793861, -1.3714672" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Asador Valle de Ricote, inicio">
				<span class="brand-mark" aria-hidden="true">AV</span>
				<span class="brand-name">Valle de Ricote <small>Blanca · Murcia</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">El asador</a>
				<a href="#mesa">La mesa</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>608 65 30 50</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Calle de Gran Vía, 46D · Blanca</p>
					<h1 id="hero-title">Asados a la<br />brasa y<br /><em>paella de pulpo.</em></h1>
					<p class="hero-lede">
						Asador Valle de Ricote, restaurante especializado en barbacoa en Blanca (Murcia). Asados,
						carnes a la brasa, gazpacho manchego y postres caseros, con la mesa abierta todos los
						días.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 608 65 30 50</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,3</b> en Google (290 reseñas)</li>
						<li>Asador y barbacoa</li>
						<li>Abierto los 7 días</li>
						<li>Blanca (Murcia)</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="webp"
						quality={70}
						alt="Asador Valle de Ricote, asados a la brasa en Blanca (Murcia)"
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,3</b><span>Google</span></div>
					<div><b>290</b><span>Reseñas</span></div>
					<div><b>7/7</b><span>Días</span></div>
				</div>
				<ul class="services">
					<li>Asador</li>
					<li>Barbacoa</li>
					<li>Carnes a la brasa</li>
					<li>Paella de pulpo</li>
					<li>Gazpacho manchego</li>
					<li>Postres caseros</li>
					<li>Local accesible</li>
				</ul>
			</section>

			<section class="about section-pad" id="restaurante">
				<p class="section-label"><span aria-hidden="true"></span> Asador y restaurante</p>
				<div class="about-grid">
					<h2>La brasa<br />del Valle<br /><em>de Ricote.</em></h2>
					<div class="about-copy">
						<p>
							El Asador Valle de Ricote está en la Calle de Gran Vía, 46D, en Blanca (Murcia). Google
							lo clasifica como restaurante especializado en barbacoa, y el propio local define su
							especialidad: asados, carnes a la brasa, paellas de pulpo, gazpacho manchego y gran
							variedad de postres caseros.
						</p>
						<p>
							Es un sitio del que la gente vuelve: entre las reseñas que la ficha destaca se lee que
							«pasamos de casualidad pero sin duda, volveremos a repetir», que el churrasco a la
							brasa está muy bueno y que las raciones son generosas, con buen género, buena atención
							y buen precio.
						</p>
						<p class="about-note">
							Abre todos los días de 5:00 a 17:00, y los viernes y sábados añade un segundo turno de
							20:00 a 24:00. Llama al 608 65 30 50 para consultar disponibilidad.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="mesa">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Lo que se pide</p>
						<h2>De la brasa<br />a la <em>paella.</em></h2>
					</div>
					<p>
						La ficha describe una casa de asados y carnes a la brasa en el Valle de Ricote, con el mar
						y la tierra también en la carta.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="reviews section-pad" id="opiniones">
				<p class="section-label"><span aria-hidden="true"></span> Lo que dicen</p>
				<div class="reviews-head">
					<h2>Reseñas<br /><em>destacadas.</em></h2>
					<p>
						Las tres reseñas que la ficha de Google Maps destaca de este local, citadas tal cual.
					</p>
				</div>
				<div class="reviews-grid">
					{
						reviews.map((review) => (
							<figure class="review">
								<div class="review-stars" role="img" aria-label={`${review.rating} de 5 estrellas`}>
									{'★'.repeat(review.rating)}
									<span aria-hidden="true">{'☆'.repeat(5 - review.rating)}</span>
								</div>
								<blockquote>{review.text}</blockquote>
								<figcaption>{review.source}</figcaption>
							</figure>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>El asador<br /><em>en imágenes.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Asador Valle de Ricote. En la
							ficha encontrarás la galería completa, con aportaciones de clientes, y las reseñas
							actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="webp"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres
					el titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Calle de Gran Vía, 46D</p>
					<h2>Ven a<br /><em>Blanca.</em></h2>
					<p class="address">
						{business.streetAddress}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							{
								hours.map((day) => (
									<tr>
										<th scope="row">{day.day}</th>
										<td>{day.service}</td>
									</tr>
								))
							}
						</tbody>
					</table>
					<p class="hours-note">
						{hoursSummary}. Horario de la ficha de Google Maps, consultado el {site.consultado}. En
						festivos o para un grupo, llama antes de venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar 608 65 30 50</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>{business.phone}</a>

					<ul class="access">
						{
							accessibility.map((item) => (
								<li>{item.label}</li>
							))
						}
					</ul>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Asador Valle de Ricote en la Calle de Gran Vía, 46D, Blanca (Murcia)"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;">
								<a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a>
							</p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Valle de Ricote · Blanca
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">AV</span>
				<p>Asador Valle de Ricote<small>{business.streetAddress} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Asador Valle de Ricote · Calle de Gran Vía, 46D, Blanca, Murcia.
				Fotografías procedentes de la ficha del restaurante en Google Maps.
			</small>

			<p class="footer-credit">
				Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
				<a href="https://sur-digital.vercel.app/" rel="noopener">sur-digital.vercel.app</a>
			</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/asador-valle-de-ricote/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/asador-valle-de-ricote/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/asador-valle-de-ricote/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al asador <span>608 65 30 50</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/asador-valle-de-ricote/aviso-legal">Aviso legal</a>
			<a href="/asador-valle-de-ricote/aviso-legal#privacidad">Privacidad</a>
			<a href="/asador-valle-de-ricote/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
