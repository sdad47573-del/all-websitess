---
import { Image } from 'astro:assets';
import {
	BUSINESS,
	ESPECIALES,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	NOTA_ESPECIALES,
	NOTA_PIZZA,
	PIZZAS,
	RATING,
	RESENAS,
	TAMANOS,
} from '../data/site';
import '../styles/global.css';

import fotoEsquina from '../assets/fotos/kebab-turkish-y-pizzeria-apaisada-01.jpg';
import fotoPizza from '../assets/fotos/kebab-turkish-y-pizzeria-apaisada-02.jpg';
import fotoPuerta from '../assets/fotos/kebab-turkish-y-pizzeria-apaisada-03.jpg';
import fotoRotulo from '../assets/fotos/kebab-turkish-y-pizzeria-apaisada-04.jpg';
import fotoRollo from '../assets/fotos/kebab-turkish-y-pizzeria-apaisada-06.jpg';
import fotoMenuDos from '../assets/fotos/kebab-turkish-y-pizzeria-apaisada-10.jpg';
import fotoFachada from '../assets/fotos/kebab-turkish-y-pizzeria-vertical-05.jpg';
import fotoCarta from '../assets/fotos/kebab-turkish-y-pizzeria-vertical-07.jpg';
import fotoHojas from '../assets/fotos/kebab-turkish-y-pizzeria-vertical-08.jpg';
import fotoCliente from '../assets/fotos/kebab-turkish-y-pizzeria-vertical-09.jpg';

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Restaurant',
			'@id': `${BUSINESS.siteUrl}/#restaurante`,
			name: BUSINESS.fullName,
			description: BUSINESS.description,
			url: `${BUSINESS.siteUrl}/`,
			telephone: '+34951503534',
			image: `${BUSINESS.siteUrl}/og.jpg`,
			priceRange: '€',
			servesCuisine: ['Turca', 'Kebab', 'Pizza'],
			address: {
				'@type': 'PostalAddress',
				streetAddress: BUSINESS.street,
				addressLocality: BUSINESS.city,
				addressRegion: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				addressCountry: BUSINESS.country,
			},
			geo: {
				'@type': 'GeoCoordinates',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			},
			hasMap: MAPS.place,
			aggregateRating: {
				'@type': 'AggregateRating',
				ratingValue: RATING.value,
				reviewCount: RATING.count,
				bestRating: 5,
			},
			openingHoursSpecification: [
				{
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Saturday', 'Sunday'],
					opens: '13:00',
					closes: '16:00',
				},
				{
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
					opens: '19:00',
					closes: '24:00',
				},
			],
			amenityFeature: [
				{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
				{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
				{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
			],
		},
		{
			'@type': 'FAQPage',
			'@id': `${BUSINESS.siteUrl}/#faq`,
			mainEntity: FAQ.map((item) => ({
				'@type': 'Question',
				name: item.q,
				acceptedAnswer: { '@type': 'Answer', text: item.a },
			})),
		},
	],
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Kebab Turkish y Pizzeria · Kebab y pizza en Puerto de la Torre</title>
		<meta name="description" content={BUSINESS.description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#161a10" />
		<link rel="canonical" href={`${BUSINESS.siteUrl}/`} />
		<link rel="icon" type="image/svg+xml" href="/kebab-turkish-y-pizzeria/favicon.svg" />

		<meta property="og:type" content="restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={BUSINESS.name} />
		<meta property="og:title" content="Kebab Turkish y Pizzeria · Kebab y pizza en Puerto de la Torre" />
		<meta property="og:description" content={BUSINESS.description} />
		<meta property="og:url" content={`${BUSINESS.siteUrl}/`} />
		<meta property="og:image" content={`${BUSINESS.siteUrl}/og.jpg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Fachada verde de Kebab Turkish y Pizzeria en Puerto de la Torre" />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Karla:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<a class="skip" href="#contenido">Saltar al contenido</a>

		<header class="top">
			<div class="wrap top__in">
				<a class="brand" href="/kebab-turkish-y-pizzeria/" aria-label="Kebab Turkish y Pizzeria, inicio">
					<span class="brand__mark" aria-hidden="true">{BUSINESS.mark}</span>
					<span class="brand__name">
						<strong>Kebab Turkish</strong>
						<small>y Pizzeria · Puerto de la Torre</small>
					</span>
				</a>
				<nav class="nav" aria-label="Secciones">
					<a href="#casa">La casa</a>
					<a href="#carta">Carta</a>
					<a href="#fotos">Fotos</a>
					<a href="#visita">Visita</a>
					<a href="#preguntas">Preguntas</a>
				</nav>
				<a class="call" href={BUSINESS.phoneHref}>Llamar · {BUSINESS.phone}</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero">
				<div class="wrap hero__grid">
					<div>
						<p class="kicker">C. Lara Castañeda, 9 · Puerto de la Torre</p>
						<h1 class="hero__title" set:html={piezas.portada.titulo} />
						<p class="hero__lede">
							Döner, rollos, pizzas desde 5 € y menús para dos en una esquina de Puerto de la
							Torre. Cocina abierta de mediodía y de noche, y reparto a domicilio.
						</p>
						<div class="hero__actions">
							<a class="btn btn--lime" href={BUSINESS.phoneHref}>Llamar al {BUSINESS.phone}</a>
							<a class="btn btn--dark" href="#carta">Ver la carta</a>
						</div>
						<p class="rating">
							<b>{RATING.label}</b>
							<span>sobre 5 · {RATING.count} reseñas en Google</span>
						</p>
					</div>

					<figure class="hero__media">
						<div class="hero__frame">
							<Image
								src={fotoFachada}
								alt="Fachada verde de Kebab Turkish y Pizzeria, con el rótulo y la puerta abierta"
								widths={[420, 720, 1000]}
								sizes="(max-width: 1024px) 92vw, 30rem"
								loading="eager"
								fetchpriority="high"
							/>
						</div>
						<figcaption>
							<span>La puerta, en la calle Lara Castañeda</span>
							<span>Foto: ficha de Google</span>
						</figcaption>
						<div class="sticker" aria-hidden="true">
							<span>Pizza mediana</span>
							<b>5,00 €</b>
						</div>
					</figure>
				</div>
			</section>

			<div class="band">
				<div class="wrap band__in">
					<div class="band__item">
						<span>Mediodía</span>
						<strong>13:00 – 16:00</strong>
					</div>
					<div class="band__item">
						<span>Noche</span>
						<strong>19:00 – 24:00</strong>
					</div>
					<div class="band__item">
						<span>Viernes solo noche · pedidos</span>
						<strong><a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a></strong>
					</div>
				</div>
			</div>

			<section class="sec" id="casa">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">La esquina</span>
							<h2>Un local verde con la carta en la puerta</h2>
						</div>
						<p>
							Todo lo que cuenta esta página sale de la ficha pública del local en Google y de
							sus fotos: la dirección, el teléfono, la nota, el horario y la carta impresa en
							las dos hojas de la entrada.
						</p>
					</div>

					<div class="about">
						<figure class="about__fig">
							<Image
								src={fotoRotulo}
								alt="Rótulo de Kebab Turkish y Pizzeria con los dos teléfonos y el cartel de servicio a domicilio"
								widths={[420, 760, 1100]}
								sizes="(max-width: 1024px) 92vw, 32rem"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>El rótulo, con el fijo, el móvil de pedidos y el reparto</figcaption>
						</figure>
						<div class="about__text">
							<p class="lead">
								Verde lima por fuera, carta verde por dentro: 24 pizzas de masa fresca a un
								lado y 24 menús al otro, escritos en las hojas de la puerta.
							</p>
							<p>
								Google lo clasifica como pizzería, aunque el cartel grande diga «Kebab
								Turkish» y anuncie «Döner Kebab · Pizzeria · Auténtica Comida Turca». La nota
								publicada es un 3,5 sobre 5 con 209 reseñas: hay elogios claros a la pizza y
								al trato, y también quejas por esperas largas en el reparto.
							</p>
							<p>
								La cocina abre dos veces al día, mediodía y noche, y no descansa ningún día.
								La excepción es el viernes: ese día solo hay turno de noche. En la fachada
								consta «Servicio a domicilio» y un segundo número para pedidos, el{' '}
								{BUSINESS.deliveryPhone}.
							</p>
							<blockquote class="pull">
								«Unas pizzas buenísimas y un trato amable buen servicio.»
								<cite>Reseña de cinco estrellas publicada en Google</cite>
							</blockquote>
						</div>
					</div>

					<div class="cards">
						{
							HIGHLIGHTS.map((item) => (
								<article class="card">
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="sec sec--paper" id="carta">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">La carta, fotografiada</span>
							<h2>Veinticuatro pizzas y veinticuatro menús</h2>
						</div>
						<p>
							La carta no está en texto ni en la ficha: está impresa en las hojas de la puerta.
							De ahí salen los platos y los precios de esta página, tal como aparecen.
						</p>
					</div>

					<div class="sizes">
						{
							TAMANOS.map((t) => (
								<div class="sizes__cell">
									<span>{t.label}</span>
									<strong>{t.price}</strong>
								</div>
							))
						}
					</div>
					<p class="sizes__note">{NOTA_PIZZA} El precio es el mismo para cualquiera de las 24 pizzas.</p>

					<div class="carta__grid">
						<div>
							<ol class="pizzas">
								{
									PIZZAS.map((pizza) => (
										<li class="pizza">
											<span class="pizza__n">{String(pizza.n).padStart(2, '0')}</span>
											<div>
												<h4>{pizza.name}</h4>
												<p>{pizza.ingredients}</p>
											</div>
										</li>
									))
								}
							</ol>
						</div>

						<aside class="carta__aside">
							<h3>Dos hojas en la puerta</h3>
							<p>
								A la izquierda, las pizzas con sus ingredientes y los tres tamaños. A la
								derecha, los menús especiales y las raciones. La foto de al lado es la carta
								completa, tal como está pegada en el cristal.
							</p>
							<figure>
								<Image
									src={fotoHojas}
									alt="Carta completa del local: 24 pizzas a la izquierda y menús especiales a la derecha"
									widths={[360, 620, 900]}
									sizes="(max-width: 1024px) 46vw, 17rem"
									loading="lazy"
									decoding="async"
								/>
								<figcaption>La carta, en las dos hojas de la entrada</figcaption>
							</figure>
							<p class="nota">
								Precios de la carta fotografiada en octubre de 2026. Pueden cambiar.
							</p>
						</aside>
					</div>

					<div class="especiales">
						<div class="especiales__head">
							<h3>Menús especiales y raciones</h3>
							<p>
								Precio suelto y, en rojo, el del menú. La carta no detalla qué bebida o
								guarnición entra en cada menú.
							</p>
						</div>
						<ul class="esp-list">
							{
								ESPECIALES.map((item) => (
									<li class="esp">
										<span class="esp__name">
											{item.name}
											{item.note && <span class="esp__note">{item.note}</span>}
										</span>
										<span class="esp__dots" aria-hidden="true"></span>
										<span class="esp__price">{item.price}</span>
										{item.menu && <span class="esp__menu">/ {item.menu}</span>}
									</li>
								))
							}
						</ul>
						<p class="nota">{NOTA_ESPECIALES}</p>
					</div>
				</div>
			</section>

			<section class="sec" id="fotos">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">La galería de la ficha</span>
							<h2>La fachada, la carta y lo que sale de la cocina</h2>
						</div>
						<p>
							Las diez fotos públicas del local, repartidas entre la portada, la sección de la
							casa, la carta y esta galería. Ninguna repetida.
						</p>
					</div>

					<div class="photos">
						<figure class="photo photo--wide">
							<Image
								src={fotoEsquina}
								alt="Esquina de la calle Lara Castañeda con la fachada verde del local y el paso de cebra"
								widths={[480, 800, 1200]}
								sizes="(max-width: 760px) 92vw, 46vw"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>La esquina, con el paso de cebra delante</figcaption>
						</figure>
						<figure class="photo">
							<Image
								src={fotoPizza}
								alt="Pizza de queso cortada en porciones dentro de su caja de cartón"
								widths={[380, 620, 900]}
								sizes="(max-width: 760px) 46vw, 24vw"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>Pizza de queso, en su caja</figcaption>
						</figure>
						<figure class="photo photo--tall">
							<Image
								src={fotoCarta}
								alt="Carta del local con las 24 pizzas y los menús especiales con precios"
								widths={[380, 620, 900]}
								sizes="(max-width: 760px) 46vw, 24vw"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>La carta completa, de una sola mirada</figcaption>
						</figure>
						<figure class="photo">
							<Image
								src={fotoRollo}
								alt="Rollo de kebab envuelto en papel de aluminio sobre una mesa de topos"
								widths={[380, 620, 900]}
								sizes="(max-width: 760px) 46vw, 24vw"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>Un rollo de kebab, para llevar</figcaption>
						</figure>
						<figure class="photo photo--tall">
							<Image
								src={fotoCliente}
								alt="Fachada del local con un cliente entrando por la puerta"
								widths={[380, 620, 900]}
								sizes="(max-width: 760px) 46vw, 24vw"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>La puerta, un mediodía</figcaption>
						</figure>
						<figure class="photo">
							<Image
								src={fotoPuerta}
								alt="Detalle de la puerta con la lista de pizzas y los menús especiales"
								widths={[380, 620, 900]}
								sizes="(max-width: 760px) 46vw, 24vw"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>Los ingredientes, pizza por pizza</figcaption>
						</figure>
						<figure class="photo photo--wide">
							<Image
								src={fotoMenuDos}
								alt="Cartel del menú para dos personas y del falafel en la puerta del local"
								widths={[480, 800, 1200]}
								sizes="(max-width: 760px) 92vw, 46vw"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>El menú para dos y el falafel</figcaption>
						</figure>
					</div>
				</div>
			</section>

			<section class="sec sec--ink" id="resenas">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">Lo que dicen</span>
							<h2>{RATING.label} sobre 5, sin maquillar</h2>
						</div>
						<p>
							Las reseñas publicadas en la ficha, con sus estrellas. También la que se queja:
							una espera de una hora y veinte minutos en el reparto.
						</p>
					</div>

					<div class="reviews">
						{
							RESENAS.map((resena) => (
								<article class={resena.valor === 1 ? 'review review--bad' : 'review'}>
									<span class="review__stars" aria-label={`${resena.valor} de 5 estrellas`}>
										{'★'.repeat(resena.valor)}
										{'☆'.repeat(5 - resena.valor)}
									</span>
									<p>{resena.texto}</p>
									<footer>Reseña de Google</footer>
								</article>
							))
						}
					</div>
					<div class="reviews__foot">
						<span>Valoración de la ficha en octubre de 2026 · {RATING.count} reseñas.</span>
						<a href={MAPS.reviews} target="_blank" rel="noreferrer">Leer todas en Google ↗</a>
					</div>
				</div>
			</section>

			<section class="sec" id="visita">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">Cómo llegar</span>
							<h2>Lara Castañeda, 9, Puerto de la Torre</h2>
						</div>
						<p>
							Un bajo con la fachada verde, en una esquina con paso de cebra. Sin aparcamiento
							propio según la ficha: hay que buscar sitio en la calle.
						</p>
					</div>

					<div class="visit">
						<div class="visit__info">
							<p class="visit__address">
								<strong>{BUSINESS.name}</strong>
								{BUSINESS.street}<br />
								{BUSINESS.district} · {BUSINESS.postalCode} {BUSINESS.city}
							</p>
							<div class="visit__actions">
								<a class="btn btn--lime" href={BUSINESS.phoneHref}>Llamar al {BUSINESS.phone}</a>
								<a class="btn btn--ghost" href={MAPS.directions} target="_blank" rel="noreferrer">
									Cómo llegar ↗
								</a>
							</div>

							<table class="hours">
								<caption>Horario publicado en la ficha</caption>
								<tbody>
									{
										HORARIO.map((dia) => (
											<tr>
												<th scope="row">
													{dia.dia}
													{dia.note && <span class="note">{dia.note}</span>}
												</th>
												<td>{dia.horas}</td>
											</tr>
										))
									}
								</tbody>
							</table>
							<p class="hours__aviso">{HORARIO_AVISO}</p>

							<div class="delivery">
								<strong>Servicio a domicilio</strong>
								<p>
									El rótulo lo anuncia y da un móvil para pedidos:{' '}
									<a href={BUSINESS.deliveryPhoneHref}>{BUSINESS.deliveryPhone}</a>. La ficha no
									publica plataformas ni importe mínimo, así que conviene llamar antes.
								</p>
							</div>
						</div>

						<div class="map">
							<iframe
								src={MAPS.embed}
								title={`Mapa de ${BUSINESS.name}, ${BUSINESS.street}, ${BUSINESS.city}`}
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
								allowfullscreen></iframe>
							<div class="map__foot">
								<span>{BUSINESS.street} · {BUSINESS.district}</span>
								<a href={MAPS.place} target="_blank" rel="noreferrer">Abrir la ficha en Google Maps ↗</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="sec sec--paper" id="preguntas">
				<div class="wrap">
					<div class="head">
						<div>
							<span class="head__label">Antes de venir</span>
							<h2>Preguntas frecuentes</h2>
						</div>
						<p>
							Lo que la ficha y la carta permiten responder. Para lo demás, el teléfono del
							local: {BUSINESS.phone}.
						</p>
					</div>

					<div class="faq">
						{
							FAQ.map((item, i) => (
								<details open={i === 0}>
									<summary>{item.q}</summary>
									<p>{item.a}</p>
								</details>
							))
						}
					</div>
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="wrap">
				<div class="footer__top">
					<div class="footer__brand">
						<strong>Kebab Turkish y Pizzeria</strong>
