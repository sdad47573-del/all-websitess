---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import paella from '../assets/fotos/el-raco-de-l-arros-apaisada-05.jpg';
import comedor from '../assets/fotos/el-raco-de-l-arros-apaisada-02.jpg';
import gambas from '../assets/fotos/el-raco-de-l-arros-apaisada-03.jpg';
import calamares from '../assets/fotos/el-raco-de-l-arros-apaisada-10.jpg';
import fachadaNoche from '../assets/fotos/el-raco-de-l-arros-vertical-04.jpg';
import senoret from '../assets/fotos/el-raco-de-l-arros-vertical-06.jpg';
import negro from '../assets/fotos/el-raco-de-l-arros-vertical-07.jpg';
import bogavante from '../assets/fotos/el-raco-de-l-arros-vertical-08.jpg';
import ensalada from '../assets/fotos/el-raco-de-l-arros-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = "El Racó de l'Arròs · Arroces y paellas en Moraira";
const description =
	"El Racó de l'Arròs, Av. Madrid, 3 (03724 Moraira, Alicante). Arroces y paellas de cocina valenciana y mediterránea, con terraza. 4,5 sobre 5 con 1.194 reseñas. Martes cerrado.";

const galeria = [
	{
		src: paella,
		alt: 'Paellera de arroz amarillo con trozos de pollo, judía verde y limón, en la mesa',
	},
	{
		src: fachadaNoche,
		alt: "La fachada azul de El Racó de l'Arròs al anochecer, con el toldo, la terraza y la puerta de madera",
	},
	{
		src: comedor,
		alt: "El comedor de El Racó de l'Arròs con azulejos verdes en la pared, manteles blancos y sillas de asiento azul",
	},
	{
		src: senoret,
		alt: 'Paella de pollo y judía verde en la paellera, con gajos de limón y la cuchara de servir',
	},
	{
		src: negro,
		alt: 'Arroz negro con sepia y gambas en la paellera, con dos gajos de limón',
	},
	{
		src: bogavante,
		alt: 'Arroz caldoso con medio bogavante en la cazuela, con el caparazón rojo asomando',
	},
	{
		src: gambas,
		alt: 'Gambas al ajillo en cazuela de barro con el aceite y el perejil',
	},
	{
		src: calamares,
		alt: 'Calamares a la romana rebozados, con limón y una rama de perejil',
	},
	{
		src: ensalada,
		alt: 'Ensalada mixta en fuente de cristal con atún, huevo, aceitunas, zanahoria y tomate',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: "Lo que se ve en las mesas de El Racó de l'Arròs",
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-raco-de-l-arros`,
	name: BUSINESS.name,
	alternateName: ["El Racó de l'Arròs Moraira", 'El Raco de l Arros', 'Racó de l’Arròs'],
	description:
		'Arroces y paellas de cocina valenciana y mediterránea en la Avenida de Madrid, 3 (03724 Moraira, Alicante), con terraza en la acera y comedor de mantel blanco.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34965744372',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Valenciana', 'Mediterránea', 'Española', 'Arroces'],
	areaServed: [
		{ '@type': 'City', name: 'Teulada' },
		{ '@type': 'Place', name: 'Moraira' },
		{ '@type': 'AdministrativeArea', name: 'Marina Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday', 'Friday', 'Saturday'],
			opens: '19:00',
			closes: '22:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Los arroces', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"el-raco-de-l-arros-apaisada-05.jpg": paella,
	"el-raco-de-l-arros-vertical-04.jpg": fachadaNoche,
	"el-raco-de-l-arros-apaisada-02.jpg": comedor,
	"el-raco-de-l-arros-vertical-06.jpg": senoret,
	"el-raco-de-l-arros-vertical-07.jpg": negro,
	"el-raco-de-l-arros-vertical-08.jpg": bogavante,
	"el-raco-de-l-arros-apaisada-03.jpg": gambas,
	"el-raco-de-l-arros-apaisada-10.jpg": calamares,
	"el-raco-de-l-arros-vertical-09.jpg": ensalada,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f3b34" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Marcellus&family=Mulish:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Racó de l'Arròs, arroces Moraira, paella Moraira, restaurante Moraira, cocina valenciana Moraira, arroz negro Moraira, Avenida de Madrid Moraira, Teulada Moraira"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Arroces y paellas de cocina valenciana en la Avenida de Madrid, 3 (Moraira), con terraza en la acera. Mediodía de miércoles a domingo, con cenas jueves, viernes y sábado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Paella de pollo y judía verde en la paellera de El Racó de l'Arròs, en Moraira"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1f3b34"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[paella]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Racó de l'Arròs"
			subtitle="Arroces · Moraira"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma platos, precios y horario antes de ir."
			ctaLabel="Llamar a El Racó de l'Arròs"
			navAriaLabel="Enlaces de El Racó de l'Arròs"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34965744372?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Lo%20que%20se%20ve%20en%20las%20mesas%20de%20El%20Rac%C3%B3%20de%20l." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Lo que se ve en las mesas de El Racó de l"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
