---
import { Image } from 'astro:assets';

import '../styles/global.css';

import foto from '../assets/fotos/asador-de-pollos-nerea-01.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_NOTA,
	MAPS,
	MENU,
	MENU_NOTA,
	RESENAS,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'Asador de Pollos Nerea · Pollo asado y recetas de casa en Bilbao';
const description =
	'Asador de Pollos Nerea, en Juan de Garay Kalea, 57 (Ibaiondo, 48003 Bilbao). Pollo asado desde 15,20 €, codillo, raciones y recetas caseras. Pedidos al 944 43 53 36 o por Glovo.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#negocio`,
	name: BUSINESS.name,
	alternateName: ['Asador Nerea', 'Asador de Pollos Nerea Bilbao', 'Pollos Nerea'],
	description:
		'Asador de pollos y comida para llevar en Juan de Garay Kalea, 57 (Ibaiondo, 48003 Bilbao). Pollo asado, codillo, raciones y recetas caseras.',
	url: `${BUSINESS.siteUrl}/`,
	telephone: '+34944435336',
	sameAs: [MAPS.place, MAPS.facebook],
	areaServed: [
		{ '@type': 'City', name: 'Bilbao' },
		{ '@type': 'AdministrativeArea', name: 'Bizkaia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	servesCuisine: ['Pollo asado', 'Comida casera'],
	hasTakeaway: true,
	priceRange: '€€',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:30',
			closes: '22:00',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Horario', href: '#horario' },
	{ label: 'Dónde está', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#102a22" />
		<link rel="canonical" href={`${BUSINESS.siteUrl}/`} />
		<link rel="icon" href="/asador-de-pollos-nerea/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Oswald:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={BUSINESS.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${BUSINESS.siteUrl}/`} />
		<meta property="og:image" content={`${BUSINESS.siteUrl}/og.jpg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(bizSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label={`${BUSINESS.name}, inicio`}>
					<span class="brand-mark" aria-hidden="true">{BUSINESS.mark}</span>
					<span class="brand-name">
						Asador de Pollos Nerea
						<small>Pollo asado · Ibaiondo, Bilbao</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-cta" href={BUSINESS.phoneHref}>
					{BUSINESS.phone} <span aria-hidden="true">↗</span>
				</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Ibaiondo · 48003 Bilbao</p>
						<h1 id="hero-title">Pollo asado, patatas y recetas de casa <em>en Bilbao La Vieja.</em></h1>
						<p class="hero-lede">
							Asador de Pollos Nerea está en el número 57 de Juan de Garay Kalea, entre Ibaiondo y
							Bilbao La Vieja. El asador despacha pollo entero o medio, codillo y raciones, y
							mantiene los guisos de siempre. Se recoge en el local o se pide por teléfono y por
							Glovo.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={BUSINESS.phoneHref}>
								Llamar · {BUSINESS.phone}
							</a>
							<a class="button button-ghost" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<dl class="hero-facts">
							<div>
								<dt>Horario</dt>
								<dd>L–V · 9:30–22:00</dd>
							</div>
							<div>
								<dt>Reseñas en Google</dt>
								<dd>{REVIEWS.label} opiniones</dd>
							</div>
							<div>
								<dt>Pedidos</dt>
								<dd>Local y Glovo</dd>
							</div>
						</dl>
					</div>

					<figure class="hero-media">
						<div class="hero-photo">
							<Image
								src={foto}
								alt="El asador de pollos Nerea en Juan de Garay Kalea, 57, en Bilbao"
								widths={[360, 540, 720, 900]}
								sizes="(max-width: 900px) 92vw, 42vw"
								format="webp"
								quality={76}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</div>
						<figcaption>
							<span>Juan de Garay Kalea, 57</span>
							<span>Foto del local</span>
						</figcaption>
						<span class="hero-seal" aria-hidden="true">
							<strong>{REVIEWS.label}</strong>
							<small>opiniones<br />en Google</small>
						</span>
					</figure>
				</div>
			</section>

			<section class="chips-wrap wrap" aria-label="Lo que ofrece el asador">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<div class="about-grid">
					<div class="about-copy">
						<p class="section-label"><span aria-hidden="true"></span> La casa</p>
						<h2 id="about-title">Mucho más que <em>una pollería.</em></h2>
						<p>
							Así se presenta el propio negocio en su perfil: «mucho más que una pollería». Y la
							carta lo confirma. El asador es el centro —pollo entero, medio pollo y codillo—, pero
							alrededor hay raciones para completar la mesa y una lista de guisos que se hacen en
							casa.
						</p>
						<p>
							El local está en Juan de Garay Kalea, 57, en Ibaiondo, a un paso de Bilbao La Vieja y
							a unos 260 metros de la parada de Cercanías Miribilla. Funciona sobre todo con
							recogida y reparto: el pedido se hace por teléfono o desde Glovo y Just Eat.
						</p>
						<p>
							No hay carta de temporada ni promesas de autor. Lo que hay es pollo asado, patatas,
							croquetas y guisos de cuchara, con precios de barrio y una ficha de Google con más
							de seiscientas opiniones.
						</p>
						<div class="about-links">
							<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha en Google Maps <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href="#carta">Ver la carta y los precios</a>
						</div>
					</div>
				</div>

				<ul class="highlights">
					{
						HIGHLIGHTS.map((item) => (
							<li>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section class="menu" id="carta" aria-labelledby="menu-title">
				<div class="wrap menu-grid">
					<div class="menu-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> La carta</p>
						<h2 id="menu-title">Del asador <em>a la mesa.</em></h2>
						<p class="menu-lede">
							Estos son los platos y precios que el negocio publica en su carta de reparto. Los
							guisos y los menús van sin precio en esa carta, así que se confirman al encargar.
						</p>

						<div class="menu-groups">
							{
								MENU.map((group) => (
									<div class="menu-group">
										<h3>{group.title}</h3>
										<ul>
											{group.items.map((item) => (
												<li>
													<strong>{item.name}</strong>
													{item.price && <span class="menu-price">{item.price}</span>}
													{item.note && <em>{item.note}</em>}
												</li>
											))}
										</ul>
									</div>
								))
							}
						</div>

						<p class="menu-note">{MENU_NOTA}</p>
						<div class="menu-actions">
							<a class="button button-primary" href={BUSINESS.phoneHref}>Encargar por teléfono</a>
							<a class="button button-ghost" href={MAPS.glovo} target="_blank" rel="noreferrer">
								Ver la carta en Glovo <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="hours" id="horario" aria-labelledby="hours-title">
				<div class="wrap hours-grid">
					<div class="hours-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> Horario</p>
						<h2 id="hours-title">De 9:30 a 22:00, <em>de lunes a viernes.</em></h2>
						<p class="hours-lede">
							Es el horario que el negocio anuncia en su perfil. Da servicio durante todo el día,
							así que vale tanto para recoger un pollo a mediodía como para resolver la cena.
						</p>
						<p class="hours-note">
							<strong>El fin de semana, confírmalo.</strong> {HORARIO_NOTA}
						</p>
						<a class="hours-link" href={BUSINESS.phoneHref}>
							Llamar al {BUSINESS.phone} <span aria-hidden="true">↗</span>
						</a>
					</div>

					<div class="hours-table-wrap">
						<table class="hours-table">
							<caption class="visually-hidden">Horario publicado por el negocio</caption>
							<tbody>
								{
									HORARIO.map((row) => (
										<tr>
											<th scope="row">{row.dia}</th>
											<td>{row.horas}</td>
										</tr>
									))
								}
							</tbody>
						</table>
						<p class="hours-foot">
							Horario del perfil del negocio en Instagram, consultado en noviembre de 2026.
						</p>
					</div>
				</div>
			</section>

			<section class="rating wrap" id="opiniones" aria-labelledby="rating-title">
				<div class="rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> Lo que dicen en Google</p>
						<h2 id="rating-title">Más de 650 opiniones <em>en la ficha.</em></h2>
						<p>
							La ficha de Google reúne {REVIEWS.label} opiniones en el momento de consultarla
							({REVIEWS.updated}). Los agregadores que las recogen no coinciden en la nota media,
							así que aquí no se publica una cifra inventada: se citan reseñas textuales y se
							enlaza la ficha para leerlas todas. Hay opiniones de todo tipo, incluidas algunas
							sobre el trato en el mostrador.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<small>
											{resena.autor} · {resena.fecha} · Reseña publicada en Google
										</small>
									</li>
								))
							}
						</ul>
						<div class="rating-actions">
							<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
								Leer las opiniones en Google <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="rating-figure">
						<div class="rating-symbol" aria-hidden="true">
							<span class="rating-value">{REVIEWS.label}</span>
						</div>
						<p class="rating-caption">
							opiniones publicadas<br />
							en la ficha de Google
						</p>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Dónde está</p>
					<h2 id="visit-title">En Juan de Garay <em>Kalea, 57.</em></h2>
					<p class="address">
						{BUSINESS.street}<br />
						{BUSINESS.locality} · {BUSINESS.postalCode} {BUSINESS.city}<br />
						{BUSINESS.region}
					</p>

					<p class="visit-phone">
						<span>Teléfono</span>
						<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
					</p>

					<ul class="visit-list">
						<li>
							<span>Categoría</span>
							Asador de pollos y comida para llevar
						</li>
						<li>
							<span>Reparto</span>
							Glovo y Just Eat
						</li>
						<li>
							<span>Transporte</span>
							Cercanías Miribilla, a unos 260 m
						</li>
						<li>
							<span>Ficha de Google</span>
							<a href={MAPS.place} target="_blank" rel="noreferrer">{REVIEWS.label} opiniones ↗</a>
						</li>
					</ul>

					<div class="visit-links">
						<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-ghost" href={BUSINESS.phoneHref}>Llamar y encargar</a>
					</div>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Asador de Pollos Nerea en Juan de Garay Kalea, 57, Bilbao"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Juan de Garay Kalea, 57
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>encargar.</em></h2>
				<div class="faq-list">
					{
						FAQ.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">{BUSINESS.mark}</span>
						<p>
							{BUSINESS.name}
							<small>
								Pollo asado y recetas de casa<br />
								{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}
							</small>
						</p>
					</div>
					<nav aria-label="Enlaces del establecimiento">
						<a href={BUSINESS.phoneHref}>Llamar</a>
						<a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
						<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a href={MAPS.glovo} target="_blank" rel="noreferrer">Glovo ↗</a>
						<a href="#carta">Carta</a>
						<a href="#horario">Horario</a>
					</nav>
				</div>
				<small class="legal">
					© {new Date().getFullYear()}
					{BUSINESS.name} · Datos de la ficha pública de Google, la carta de Glovo y el perfil del
					negocio, consultados en noviembre de 2026. Los precios y el horario pueden cambiar:
					confírmalos por teléfono antes de encargar.
				</small>
				<p class="credit">
					<small>Creado por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small>
				</p>
			</div>
		</footer>
		<!-- contacto-rapido -->
		<style>
			.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
			.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
			.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
			.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
			.contact-fabs .fab-call { background: #c2410c; }
			.contact-fabs .fab-wa { background: #25d366; }
			.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
			@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
			@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
			.contact-fabs.is-stacked { bottom: 5.75rem; }
			@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
			@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
		</style>
		<nav class="contact-fabs" aria-label="Contacto rápido">
			<a
				class="fab-wa"
				href="https://wa.me/34944435336?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Asador%20de%20Pollos%20Nerea."
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Escribir por WhatsApp a Asador de Pollos Nerea"
			>
				<svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg>
			</a>
		</nav>
	</body>
</html>
