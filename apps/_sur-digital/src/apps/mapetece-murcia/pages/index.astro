---
import f01 from '../assets/fotos/mapetece-murcia-apaisada-01.jpg';
import f02 from '../assets/fotos/mapetece-murcia-vista-2-02.jpg';
import f03 from '../assets/fotos/mapetece-murcia-apaisada-03.jpg';
import f04 from '../assets/fotos/mapetece-murcia-apaisada-04.jpg';
import f05 from '../assets/fotos/mapetece-murcia-apaisada-05.jpg';
import f06 from '../assets/fotos/mapetece-murcia-apaisada-06.jpg';
import f07 from '../assets/fotos/mapetece-murcia-apaisada-07.jpg';
import f08 from '../assets/fotos/mapetece-murcia-apaisada-08.jpg';
import f09 from '../assets/fotos/mapetece-murcia-apaisada-09.jpg';
import f10 from '../assets/fotos/mapetece-murcia-apaisada-10.jpg';

const fotos = [f01, f02, f03, f04, f05, f06, f07, f08, f09, f10];

const MAPS_URL =
	'https://www.google.com/maps/place/Mapetece+Murcia/@37.975138,-1.120652,17z/data=!3m1!4b1!4m6!3m5!1s0xd63820a182d31cd:0xcedefad458a508f6!8m2!3d37.975138!4d-1.120652!16s%2Fg%2F11bw5ykr1d?authuser=0&hl=es&entry=ttu';
const CREDIT_URL = 'https://www.sur-digital.com/';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Mapetece Murcia</title>
		<meta name="description" content="Mapetece Murcia." />
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"@id": "https://www.sur-digital.com/mapetece-murcia/#negocio",
	"name": "Mapetece murcia",
	"url": "https://www.sur-digital.com/mapetece-murcia/",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 37.975138,
		"longitude": -1.120652
	},
	"hasMap": "https://www.google.com/maps/place/Mapetece+Murcia/@37.975138,-1.120652,17z/data=!3m1!4b1!4m6!3m5!1s0xd63820a182d31cd:0xcedefad458a508f6!8m2!3d37.975138!4d-1.120652!16s%2Fg%2F11bw5ykr1d?authuser=0&hl=es&entry=ttu"
}
</script>
		<meta property="og:image" content="https://www.sur-digital.com/mapetece-murcia/og.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta property="og:url" content="https://www.sur-digital.com/mapetece-murcia/" />
		<meta property="og:locale" content="es_ES" />
			<meta property="og:title" content="Mapetece Murcia" />
		<meta property="og:description" content="Mapetece Murcia." />
	</head>
	<body>
		<header>
			<h1 set:html={piezas.portada.titulo} />
			<a href={MAPS_URL} rel="noopener" target="_blank">Ver en Google Maps</a>
		</header>

		<main>
			<section>
				{fotos.map((foto) => (
					<img src={foto.src} width={foto.width} height={foto.height} alt="Mapetece Murcia" loading="lazy" />
				))}
			</section>
		</main>

		<footer>
			<p>
				Creado por <a href={CREDIT_URL} rel="noopener">Sur Digital</a>
			</p>
		</footer>
	</body>
</html>
