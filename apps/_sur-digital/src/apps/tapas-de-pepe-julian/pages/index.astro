---
import '../styles/global.css';

const business = {
	name: 'Tapas de Pepe Julián',
	short: 'Pepe Julián',
	street: 'C/ Juan Relinque 7',
	city: 'Barbate',
	postalCode: '11160',
	phone: '+34 956 45 10 98',
	latitude: 36.2539043,
	longitude: -5.966001,
	site: 'https://www.sur-digital.com/tapas-de-pepe-julian',
};

const mapsUrl =
	'https://www.google.com/maps/place/Tapas+de+Pepe+Juli%C3%A1n/@36.2539043,-5.966001,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c45c8c399cc01:0x99a35548173751d2!8m2!3d36.2539043!4d-5.966001!16s%2Fg%2F1xn_pn77?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const phoneHref = 'tel:+34956451098';

const specialties = [
	{
		kicker: 'Clásico',
		title: 'Atún mechado',
		text: 'El imprescindible de la casa según la Guía Gastronómica de Cádiz.',
	},
	{
		kicker: 'Popular',
		title: 'Ensaladilla',
		text: 'Muy popular entre la clientela, para compartir en la barra.',
	},
	{
		kicker: 'De siempre',
		title: 'Tapas clásicas',
		text: 'Mesón de tapas clásicas en el centro de Barbate.',
	},
	{
		kicker: 'En el centro',
		title: 'Juan Relinque 7',
		text: 'De los clásicos barbateños que salen en la guía provincial.',
	},
	{
		kicker: 'Contacto',
		title: '956 45 10 98',
		text: 'Llama para confirmar el horario del día antes de venir.',
	},
	{
		kicker: 'Aviso',
		title: 'Miércoles cerrado',
		text: 'Cierra los miércoles, según la guía. Confirma en el 956 45 10 98.',
	},
];

const gallery = [
	{ src: '/fotos/meson.svg', alt: 'Ilustración del mesón — sustituye por foto propia' },
	{ src: '/fotos/tapas.svg', alt: 'Ilustración de tapas — sustituye por foto propia' },
	{ src: '/fotos/atun.svg', alt: 'Ilustración del atún — sustituye por foto propia' },
	{ src: '/fotos/ensaladilla.svg', alt: 'Ilustración de la ensaladilla — sustituye por foto propia' },
	{ src: '/fotos/barra.svg', alt: 'Ilustración de la barra — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Pepe Julián?',
		a: 'En C/ Juan Relinque 7, 11160 Barbate (Cádiz).',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Cierra los miércoles, según la Guía Gastronómica de Cádiz. Confirma el horario del día en el 956 45 10 98.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Tapas clásicas, atún mechado y la popular ensaladilla. Confirma la carta del día en el local.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'Es un mesón clásico de centro: para grupos llama al 956 45 10 98.',
	},
	{
		q: '¿Cómo llego?',
		a: 'En el centro de Barbate, en la calle Juan Relinque. Usa el botón «Cómo llegar» para abrir la ruta en Google Maps.',
	},
];

const description =
	'Pepe Julián: mesón de tapas clásicas en C/ Juan Relinque 7, Barbate. Atún mechado y ensaladilla. Miércoles cerrado. Tel. 956 45 10 98.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 956 45 10 98',
	image: [`${business.site}/fotos/meson.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Andaluza', 'Tapas'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="Pepe Julián: mesón de tapas en Juan Relinque 7, Barbate. Atún mechado y ensaladilla. Miércoles cerrado. 956 45 10 98." />
		<meta name="keywords" content="Pepe Julián Barbate, tapas Barbate, atún mechado, Juan Relinque Barbate" />
		<meta name="author" content="Pepe Julián" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/tapas-de-pepe-julian/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>Pepe Julián | Mesón de tapas en Barbate</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Pepe Julián · Tapas clásicas en Barbate" />
		<meta property="og:description" content="Atún mechado y ensaladilla en Juan Relinque 7. Miércoles cerrado." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/meson.svg`} />
		<meta property="og:image:alt" content="Pepe Julián, Barbate" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Pepe Julián · Tapas en Barbate" />
		<meta name="twitter:description" content="Juan Relinque 7: atún mechado clásico." />
		<meta name="twitter:image" content={`${business.site}/fotos/meson.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Barbate" />
		<meta name="geo.position" content="36.2539043;-5.966001" />
		<meta name="ICBM" content="36.2539043, -5.966001" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Pepe Julián, inicio">
				<span class="brand-mark" aria-hidden="true">PJ</span>
				<span class="brand-name">Pepe Julián <small>Barbate · Tapas</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">El mesón</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>956 45 10 98</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Juan Relinque 7 · Barbate</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Mesón clásico barbateño de la guía provincial: atún mechado,
						ensaladilla y tapas para la barra.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 956 45 10 98</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>Mié</b> cerrado</li>
						<li><b>Atún</b> mechado</li>
						<li>Ensaladilla</li>
						<li>Clásico</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/tapas-de-pepe-julian/fotos/meson.svg" alt="Ilustración de Pepe Julián, Barbate" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Juan Relinque 7 · Barbate</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>Mié</b><span>Cerrado</span></div>
					<div><b>7</b><span>Juan Relinque</span></div>
					<div><b>Guía</b><span>Cádiz</span></div>
				</div>
				<ul class="services">
					<li>Atún mechado</li>
					<li>Ensaladilla</li>
					<li>Tapas</li>
					<li>Barra</li>
					<li>Clásico</li>
					<li>Centro</li>
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> El mesón</p>
				<div class="about-grid">
					<h2>De los clásicos<br />de <em>la guía.</em></h2>
					<div class="about-copy">
						<p>
							Pepe Julián está en C/ Juan Relinque 7 (11160 Barbate),
							con coordenadas 36.2539043, -5.966001.
						</p>
						<p>
							Mesón de tapas clásicas citado en la Guía Gastronómica de Cádiz,
							con el atún mechado como imprescindible.
						</p>
						<p class="about-note">
							Cierra los miércoles, según la guía. Confirma el horario del día
							en el 956 45 10 98.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales según la guía: clásicas y atún.
						Confirma la carta del día en el propio local.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El mesón<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del mesón.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Juan Relinque 7</p>
					<h2>Ven a la barra<br /><em>a tapear.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Cierre</caption>
						<tbody>
							<tr>
								<th scope="row">Miércoles</th>
								<td>Cerrado</td>
							</tr>
							<tr>
								<th scope="row">Resto de días</th>
								<td>A confirmar: 956 45 10 98</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Según la guía provincial. Confirma en el 956 45 10 98 antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al mesón ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 956 45 10 98</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de Pepe Julián en Juan Relinque 7, Barbate" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Pepe Julián · Barbate</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">PJ</span>
				<p>Pepe Julián<small>{business.street} · {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del mesón">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Pepe Julián · Barbate. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/tapas-de-pepe-julian/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/tapas-de-pepe-julian/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/tapas-de-pepe-julian/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al mesón <span>956 45 10 98</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/tapas-de-pepe-julian/aviso-legal">Aviso legal</a>
			<a href="/tapas-de-pepe-julian/aviso-legal#privacidad">Privacidad</a>
			<a href="/tapas-de-pepe-julian/aviso-legal#cookies">Cookies</a>
		</nav>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34956451098?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Tapas%20de%20Pepe%20Juli%C3%A1n." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Tapas de Pepe Julián"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
