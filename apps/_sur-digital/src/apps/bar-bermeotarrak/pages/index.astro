---
import '../styles/global.css';
import { Image } from 'astro:assets';
import g1 from '../assets/galeria/gal-01.jpg';
import g2 from '../assets/galeria/gal-02.jpg';
import g3 from '../assets/galeria/gal-03.jpg';
import g4 from '../assets/galeria/gal-04.jpg';
import g5 from '../assets/galeria/gal-05.jpg';
import g6 from '../assets/galeria/gal-06.jpg';
import {
	business,
	directionsUrl,
	faqSchema,
	faqs,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviewsUrl,
	servicios,
	site,
} from '../data/site';
import heroA from '../assets/hero/hero-salmon.jpg';
import heroB from '../assets/hero/hero-pescado.jpg';
import heroC from '../assets/hero/hero-barra.jpg';

const title = 'Bar Bermeotarrak · Parrilla en Cruces, Barakaldo';
const description =
	'Bar Bermeotarrak, parrilla vasca en Plaza Inmaculada 23, Barakaldo. Pescados a la parrilla. Teléfono 944 99 86 82.';
const keywords =
	'Bar Bermeotarrak, Bermeotarrak Barakaldo, parrilla Cruces, pescados parrilla Barakaldo, Plaza Inmaculada';

const galeria = [
	{ img: g1, alt: 'Comedor de restaurante (fotografía de archivo)', caption: 'El comedor' },
	{ img: g2, alt: 'Plato de pescado (fotografía de archivo)', caption: 'Del mar' },
	{ img: g3, alt: 'Plato de arroz (fotografía de archivo)', caption: 'De cuchara' },
	{ img: g4, alt: 'Comedor acogedor de restaurante (fotografía de archivo)', caption: 'El local' },
	{ img: g5, alt: 'Plato de la carta (fotografía de archivo)', caption: 'De la carta' },
	{ img: g6, alt: 'Mesa con varios platos (fotografía de archivo)', caption: 'La mesa' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1f3a5d" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-BI" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/bar-bermeotarrak/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración propia de Bar Bermeotarrak en Barakaldo; no es una foto del local" />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content="Ilustración propia de Bar Bermeotarrak en Barakaldo; no es una foto del local" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">BE</span>
				<span class="brand-text">
					Bermeotarrak
					<small>Cruces · Barakaldo</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#local">La casa</a>
				<a href="#fotos">Fotos</a>
				<a href="#visita">Visita</a>
				<a href="#carta">Carta</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Cruces · Plaza Inmaculada, 23</p>
						<h1 id="hero-title">
							Bar Bermeotarrak,
							<br />
							<em>pescados a la parrilla.</em>
						</h1>
						<p class="hero-lede">
							Bar restaurante y parrilla en Plaza Inmaculada, 23 (Barakaldo, Bizkaia),
							en la zona de Cruces. Cocina tradicional vasca con especialidad en
							pescados y mariscos. {hoursSummary}.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>Llamar al {business.phone}</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.city} ({business.zone})
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Especialidad</small>
								<strong>Pescados y mariscos a la parrilla</strong>
							</li>
						</ul>
					</div>

										<div class="hero-collage">
					<figure class="collage-item collage-item-a">
						<Image
						src={heroA}
						alt="Plato de salmón (fotografía de archivo)"
						widths={[640, 900, 1200]}
						sizes="(max-width: 1080px) 92vw, 46vw"
						format="webp"
						quality={68}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					</figure>
					<figure class="collage-item collage-item-b">
						<Image
						src={heroB}
						alt="Pescado a la plancha (fotografía de archivo)"
						widths={[320, 480, 640]}
						sizes="(max-width: 1080px) 45vw, 23vw"
						format="webp"
						quality={68}
						loading="lazy"
						decoding="async"
					/>
					</figure>
					<figure class="collage-item collage-item-c">
						<Image
						src={heroC}
						alt="Barra de bar con bebidas (fotografía de archivo)"
						widths={[320, 480, 640]}
						sizes="(max-width: 1080px) 45vw, 23vw"
						format="webp"
						quality={68}
						loading="lazy"
						decoding="async"
					/>
					</figure>
					</div>
					<p class="hero-photo-note">Fotos de portada: banco de imágenes (Unsplash).</p>
				</div>
			</section>

			<div class="band">
				<span>
					{business.streetAddress} · {business.city}
				</span>
				<span>Pescados y mariscos a la parrilla</span>
				<span>Teléfono {business.phone}</span>
			</div>

						<section class="section carta" id="carta" aria-labelledby="carta-title">
				<div class="wrap">
					<p class="kicker">La carta</p>
					<h2 class="title" id="carta-title">
						Lo típico <em>de la casa.</em>
					</h2>
					<ul class="carta-list">
						<li>Pescados a la parrilla</li>
						<li>Mariscos</li>
						<li>Cocina tradicional vasca</li>
					</ul>
					<p class="carta-note">La carta del día puede cambiar: confirma por teléfono antes de ir.</p>
				</div>
			</section>

<section class="section" id="local" aria-labelledby="local-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">La casa</p>
						<h2 class="title" id="local-title">
							Parrilla de barrio,
							<br />
							<em>producto del mar.</em>
						</h2>
						<p>
							Bar Bermeotarrak es un bar restaurante en Cruces (Barakaldo) con cocina
							tradicional vasca y parrilla de pescados y mariscos. Figura en las guías
							tanto como bar y cafetería como restaurante.
						</p>
						<p>
							Esta web se ha preparado solo con datos públicos consultados el{' '}
							{site.consultado}: ficha de Google Maps y guías locales. No hay horario
							ni valoración publicados en fuentes verificables, así que aquí no se
							reproducen: llama al {business.phone} antes de ir.
						</p>
						<p class="bar-note">
							Nota sobre las fotos: las imágenes de la ficha de Google Maps tienen
							derechos de sus autores y no se pueden copiar aquí. Las ilustraciones
							de esta web son de archivo (Unsplash): haz tus propias fotos para sustituirlas (ver README). por fotos propias del local.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>Parrilla</strong>
							<span>Pescados y mariscos · cocina tradicional</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver ficha ↗</a>
						</div>
						{servicios.map((item) => (
							<blockquote class="quote">
								<p>{item.label}</p>
								<footer>
									<strong>La casa</strong>
									<span>Especialidad publicada en guías</span>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section cocina" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Fotos</p>
					<h2 class="title" id="fotos-title">
						La casa <em>en imágenes.</em>
					</h2>
					<p class="lead">
						Fotos de ambiente de archivo (Unsplash). Cuando tengas fotos propias del local
						y sus platos, sustitúyelas en <code>src/assets/galeria/</code> (ver README).
					</p>
					<div class="cocina-grid">
						{galeria.map((foto) => (
							<figure class="cocina-item">
								<Image
								src={foto.img}
								alt={foto.alt}
								widths={[380, 560, 800]}
								sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
								format="webp"
								quality={68}
								loading="lazy"
								decoding="async"
							/>
								<figcaption>{foto.caption}</figcaption>
							</figure>
						))}
					</div>
					<p class="cocina-note">
						Para saber qué hay hoy, lo más rápido es{' '}
						<a href={phoneHref}>llamar al {business.phone}</a> o mirar la{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="visita" aria-labelledby="visita-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Ubicación</p>
						<h2 class="title" id="visita-title">
							Plaza Inmaculada, 23,
							<br />
							<em>Cruces, Barakaldo.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.city} ({business.zone})
							<br />
							{business.province} · España
						</address>
						<p class="hours-note">
							No hay horario publicado en fuentes verificables:{' '}
							<strong>{hoursSummary.toLowerCase()}</strong>, sobre todo en festivos.
						</p>
						<ul class="access-list">
							{servicios.map((item) => (
								<li>{item.label}</li>
							))}
						</ul>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="transport-list" aria-label="Cómo llegar">
							<li>En metro: estación de Cruces cercana.</li>
							<li>En coche, por la zona de Cruces.</li>
						</ul>
					</div>
					<div class="map-card">
						<div class="map-facade" data-map-src={mapEmbedUrl}>
							<svg viewBox="0 0 120 90" width="120" height="90" role="img" aria-label="Vista previa del mapa">
							<rect width="120" height="90" rx="10" fill="#e9dfc9" />
							<g stroke="#d3c5a3" stroke-width="5">
								<path d="M0 30 H120 M0 62 H120 M35 0 V90 M78 0 V90" />
							</g>
							<g stroke="#ffffff" stroke-width="2">
								<path d="M0 30 H120 M0 62 H120 M35 0 V90 M78 0 V90" />
							</g>
							<path d="M60 60 c-9 0 -15 -7 -15 -15 c0 -9 7 -16 15 -16 s15 7 15 16 c0 8 -6 15 -15 15 z" fill="#a83e4a" />
							<circle cx="60" cy="44" r="6" fill="#faf7f0" />
						</svg>
							<p>El mapa interactivo se carga solo si lo pides.</p>
							<button class="btn btn-solid map-load" type="button">Cargar mapa interactivo</button>
						</div>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>llamar.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">BE</span>
					<span>
						Bar Bermeotarrak
						<small>
							{business.streetAddress} · {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Bar Bermeotarrak · {business.streetAddress} ({business.city}).
					Web informativa no oficial elaborada con datos públicos consultados el {site.consultado}. Las fotos son ilustraciones propias.
					Confirma horario y disponibilidad por teléfono antes de salir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/bar-bermeotarrak/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/bar-bermeotarrak/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/bar-bermeotarrak/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a Bermeotarrak <span>{business.phone}</span>
		</a>

	
	<script is:inline>
		const shareBtn = document.getElementById("compartir");
		shareBtn?.addEventListener("click", async () => {
			const url = location.href;
			if (navigator.share) {
				try { await navigator.share({ title: document.title, url }); } catch (e) {}
			} else {
				try {
					await navigator.clipboard.writeText(url);
					shareBtn.textContent = "Enlace copiado";
					setTimeout(() => { shareBtn.textContent = "Compartir"; }, 2000);
				} catch (e) {}
			}
		});
	</script>
	<script is:inline>
		const load = document.querySelector('.map-load');
		if (load) {
			load.addEventListener('click', () => {
				const box = load.parentElement;
				const src = box.getAttribute('data-map-src');
				const frame = document.createElement('iframe');
				frame.src = src;
				frame.title = 'Mapa interactivo de Google Maps';
				frame.loading = 'lazy';
				frame.referrerPolicy = 'no-referrer-when-downgrade';
				frame.allowFullscreen = true;
				box.replaceChildren(frame);
			});
		}
	</script>
</body>
</html>
