---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import espetadas from '../assets/fotos/o-brilhante-apaisada-02.jpg';
import comedor from '../assets/fotos/o-brilhante-apaisada-01.jpg';
import terraza from '../assets/fotos/o-brilhante-apaisada-05.jpg';
import sardinas from '../assets/fotos/o-brilhante-apaisada-03.jpg';
import costeleta from '../assets/fotos/o-brilhante-apaisada-04.jpg';
import chuleton from '../assets/fotos/o-brilhante-vertical-07.jpg';
import costilla from '../assets/fotos/o-brilhante-apaisada-10.jpg';
import mesa from '../assets/fotos/o-brilhante-apaisada-08.jpg';
import bitoque from '../assets/fotos/o-brilhante-vertical-09.jpg';
import postre from '../assets/fotos/o-brilhante-vertical-06.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Restaurante O Brilhante, tasca portuguesa de grelhados en la Av. Bulhão Pato 24, Trafaria (Almada): espetadas, sardinas, costeleta de novilho y bitoque, con terraza. Cenas de 19:00 a 21:30, domingo cerrado. 4,4 en Google con 64 reseñas. Tel. 212 958 552.';

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de O Brilhante con manteles de cuadros rojos, pared de ladrillo, barra y clientes cenando',
	},
	{
		src: terraza,
		alt: 'Terraza de O Brilhante con mesas y sillas verdes bajo sombrillas, en Trafaria',
	},
	{
		src: sardinas,
		alt: 'Sardinas asadas a la brasa con ensalada de tomate, cebolla y limón en O Brilhante',
	},
	{
		src: costeleta,
		alt: 'Costeleta de ternera a la brasa con limón y ensalada servida en O Brilhante',
	},
	{
		src: chuleton,
		alt: 'Chuleta de ternera a la brasa con patata frita y limón en la mesa de O Brilhante',
	},
	{
		src: costilla,
		alt: 'Costilla de ternera a la brasa cortada en la mesa de O Brilhante',
	},
	{
		src: mesa,
		alt: 'Mesa de O Brilhante con bistec, patata frita, ensalada y vino blanco durante la cena',
	},
	{
		src: bitoque,
		alt: 'Bitoque con huevo frito, arroz, patata frita y ensalada en O Brilhante',
	},
	{
		src: postre,
		alt: 'Pudim de la casa con canela servido en copa en O Brilhante',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['O Brilhante', 'O Brilhante Trafaria', 'Restaurante O Brilhante'],
	slogan: 'Tasca portuguesa y grelhados en Trafaria',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 212 958 552',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Portuguesa', 'Grelhados', 'Peixe'],
	areaServed: [
		{ '@type': 'City', name: 'Trafaria' },
		{ '@type': 'AdministrativeArea', name: 'Almada' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '19:00',
			closes: '21:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos accesibles para sillas de ruedas',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((body) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
		reviewBody: body,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La brasa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'O Brilhante · Tasca y grelhados en Trafaria';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#16505b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="O Brilhante Trafaria, restaurante Trafaria, grelhados Trafaria, espetadas Trafaria, sardinas Almada, comer en Trafaria, Av. Bulhão Pato 24, tasca portuguesa Almada, restaurante Almada"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="O Brilhante · Tasca y grelhados en Trafaria"
			ogDescription="Espetadas, sardinas y costeleta a la brasa, con terraza. Cenas de 19:00 a 21:30, domingo cerrado. 4,4 en Google con 64 reseñas. Tel. 212 958 552."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Espetadas de vacuno a la brasa con patata frita y limón en O Brilhante, Trafaria"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#16505b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-15"
			postalCode={BUSINESS.postalCode}
			phone="+351212958552"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.regionName}`}
			countryName="Portugal"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				phone: '+351 212 958 552',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[espetadas]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Tasca y grelhados · Trafaria"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. Bulhão Pato, 24 · Trafaria, Almada"
				title="La brasa<br /><em>de Trafaria.</em>"
				lede="O Brilhante es una tasca portuguesa en la Avenida Bulhão Pato, en Trafaria: espetadas, sardinas y costeleta a la brasa, con mantel de cuadros y terraza bajo las sombrillas. Solo abre para cenar, de 19:00 a 21:30, de lunes a sábado."
				image={espetadas}
				imageAlt="Espetadas de vacuno a la brasa con patata frita y limón servidas en O Brilhante"
				primaryCta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Grelhados"
				facts={[
					{ label: 'Nota', html: '<b>4,4 en Google</b> con 64 reseñas' },
					{ label: 'Solo cenas', html: '<b>19:00 – 21:30</b>' },
					{ label: 'Domingo', html: '<b>Domingo cerrado</b>' },
					{ label: 'Terraza', html: '<b>Mesas fuera</b>' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece O Brilhante" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Tasca de siempre,<br /><em>brasa de verdad.</em>"
				paragraphs={[
					'En la Avenida Bulhão Pato, 24, en la Trafaria, O Brilhante es una tasca de barrio sin adornos: manteles de cuadros rojos, pared de ladrillo, barra con la cafetera y la vitrina de los postres, y una terraza de mesas verdes bajo sombrillas en la acera. El pueblo mira al Tajo, enfrente de Lisboa.',
					'La cocina va a la brasa: espetadas de vacuno con patata frita y limón, sardinas asadas con ensalada de tomate y cebolla, costeleta de novilho y chuletón para cortar en la mesa. También hay pescado fresco del día y bitoque, el bistec con huevo frito, arroz, patata y ensalada que aparece en las fotos.',
					'Para terminar, el pudim de la casa con canela y una copa de vino blanco o tinto. Las reseñas de Google lo resumen bien: los grelhados y el ambiente agradable y cuidado son lo que más se repite, junto con la recomendación de darse un paseo por Trafaria.',
				]}
				note="«Tanto os grelhados como comida é bom», dice una reseña. Otra: «Restaurante com ambiente agradável, requintado». Y una tercera: «Recomendo para um passeio na Trafaria»."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La brasa"
				title="Espetadas,<br /><em>sardinas y costeleta.</em>"
				description="La ficha no publica carta: estos platos salen de las fotos del perfil y de las reseñas, que destacan los grelhados y el pescado fresco."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="O Brilhante no publica precios en Google y esta web no los inventa. Los platos cambian según el pescado del día, así que confirma disponibilidad y precio en el 212 958 552. La ficha tampoco ofrece reserva ni pedido online."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor,<br />la terraza<br /><em>y la brasa.</em>"
				description="Estas fotografías proceden del perfil de O Brilhante en Google Maps: el comedor de manteles de cuadros, la terraza de sombrillas, las sardinas, la costeleta, el bitoque y el pudim de la casa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Av. Bulhão Pato, 24 · 2825-846 Trafaria"
				title="En Trafaria,<br /><em>solo cenas.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Almada, Portugal']}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="Abre solo para cenar, de 19:00 a 21:30, de lunes a sábado; el domingo cierra. La ficha avisa de que el horario puede cambiar en festivos, así que llama antes si vas en día señalado."
				mapTitle="Mapa de O Brilhante en la Avenida Bulhão Pato, 24, Trafaria (Almada)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="O Brilhante · Trafaria"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva por teléfono, en el 212 958 552. La ficha marca entrada y asientos accesibles para sillas de ruedas, pero no confirma aseo adaptado; para eso, llama antes. Hay mesas en la terraza, según las fotos."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, platos y precios antes de la visita."
			ctaLabel="Llamar a O Brilhante"
			creditLabel="Creado por"
		/>
	</body>
</html>
