---
import { HIGHLIGHTS } from '../data/site';
---

<section class="bg-base-100 py-14 sm:py-16">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
			{
				HIGHLIGHTS.map((item) => (
					<div class="flex gap-4">
						<span class="bg-primary/8 text-primary flex size-11 shrink-0 items-center justify-center rounded-full">
							<i class={`${item.icon} text-xl`} />
						</span>
						<div>
							<h2 class="text-lg font-bold">{item.title}</h2>
							<p class="text-base-content/65 mt-1 text-sm leading-relaxed">{item.text}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
