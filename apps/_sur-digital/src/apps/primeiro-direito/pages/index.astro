---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import terraza from '../assets/fotos/primeiro-direito-vertical-10.jpg';
import comedor from '../assets/fotos/primeiro-direito-vertical-01.jpg';
import mesa from '../assets/fotos/primeiro-direito-vertical-02.jpg';
import queijos from '../assets/fotos/primeiro-direito-apaisada-03.jpg';
import salon from '../assets/fotos/primeiro-direito-cuadrada-04.jpg';
import entrada from '../assets/fotos/primeiro-direito-apaisada-06.jpg';
import sopa from '../assets/fotos/primeiro-direito-vertical-07.jpg';
import pared from '../assets/fotos/primeiro-direito-vertical-08.jpg';
import doces from '../assets/fotos/primeiro-direito-apaisada-09.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'1.º Direito, restaurante de cocina tradicional portuguesa en el Parque Florestal de Monsanto (Lisboa), junto al campo de rugby del Grupo Desportivo de Direito. Comidas de martes a domingo, 12:45–15:00. 4,6 en Google con 393 reseñas. Tel. 21 760 1592.';

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de 1.º Direito con vigas de madera, suelo de barro y mesas redondas junto a los ventanales',
	},
	{
		src: terraza,
		alt: 'Terraza de 1.º Direito bajo la sombrilla, con mesas de mantel blanco y el jardín de Monsanto al fondo',
	},
	{
		src: doces,
		alt: 'Buffet de doces de 1.º Direito con leite-creme, merengues, bolo de chocolate, tarta de frutos rojos y fruta',
	},
	{
		src: queijos,
		alt: 'Mesa de queijos, enchidos, uvas y pan junto al ventanal de 1.º Direito',
	},
	{
		src: entrada,
		alt: 'Entrada y terraza de 1.º Direito con el cartel de bienvenida al restaurante',
	},
	{
		src: sopa,
		alt: 'Sopa verde de la casa con crocante servida en un plato blanco en 1.º Direito',
	},
	{
		src: salon,
		alt: 'Salón de la chimenea de ladrillo de 1.º Direito, con butacas, velas y el cartel Direito',
	},
	{
		src: pared,
		alt: 'Pared de madera con cabezas de cerámica de animales y fotos de equipos de rugby en 1.º Direito',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['1º Direito', 'Primeiro Direito', 'Restaurante 1.º Direito Lisboa'],
	slogan: 'Cocina tradicional portuguesa en el Parque Florestal de Monsanto',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 21 760 1592',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Portuguesa', 'Cocina tradicional', 'Bufetes'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Parque Florestal de Monsanto' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Parque Florestal de Monsanto, Campo de Rugby do Grupo Desportivo de Direito, Alto da Boa Vista',
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:45',
			closes: '15:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos para personas en sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Estava tudo impecável, empregados, comida, musica... localização top.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Ambiente rústico num chalé de madeira com terraço e vista para o campo de rugby.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = '1.º Direito · Cocina portuguesa en Monsanto, Lisboa';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f4d3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Spectral:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="1.º Direito, 1º Direito Lisboa, restaurante Monsanto, comer en Monsanto, restaurante Parque Florestal de Monsanto, cocina tradicional portuguesa Lisboa, restaurante campo de rugby Direito, Alto da Boa Vista Lisboa, reservar restaurante Monsanto"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="1.º Direito · Cocina portuguesa en Monsanto, Lisboa"
			ogDescription="Cocina tradicional portuguesa en un chalé de madera de Monsanto, con terraza sobre el campo de rugby. Solo comidas, de martes a domingo. 4,6 en Google con 393 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Terraza de 1.º Direito con mesas de mantel blanco y el jardín de Monsanto al fondo"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1f4d3a"
			street="Parque Florestal de Monsanto, Campo de Rugby do Grupo Desportivo de Direito"
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone="+351217601592"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.regionName}`}
			countryName="Portugal"
			contact={{
				street: 'Parque Florestal de Monsanto',
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				phone: '+351 21 760 1592',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[terraza]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Cocina portuguesa · Monsanto"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Parque Florestal de Monsanto · Lisboa"
				title="Cocina portuguesa<br />entre pinos,<br /><em>en Monsanto.</em>"
				lede={`1.º Direito es un restaurante de cocina tradicional portuguesa dentro del Parque Florestal de Monsanto, en Lisboa: un chalé de madera con terraza de sombrillas y comedor con vistas al campo de rugby del Grupo Desportivo de Direito. Solo comidas, de martes a domingo.`}
				image={terraza}
				imageAlt="Terraza de 1.º Direito bajo la sombrilla, con mesas de mantel blanco y el jardín de Monsanto al fondo"
				primaryCta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="En Monsanto"
				facts={[
					{ label: 'Nota', html: '<b>4,6 en Google</b> con 393 reseñas' },
					{ label: 'Comidas', html: '<b>12:45 – 15:00</b>' },
					{ label: 'De martes a domingo', html: '<b>Lunes cerrado</b>' },
					{ label: 'Reserva', html: '<b>Online o por teléfono</b>' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece 1.º Direito" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un chalé de madera<br /><em>no alto de Monsanto.</em>"
				paragraphs={[
					'1.º Direito está dentro del Parque Florestal de Monsanto, junto al campo de rugby del Grupo Desportivo de Direito, en el Alto da Boa Vista. Se llega por los accesos del parque, entre pinos y eucaliptos, y al final aparece el chalé: paredes de madera, suelo de barro y una terraza de sombrillas sobre el jardín.',
					'Dentro, el comedor se reparte entre vigas oscuras, lámparas de latón y mesas redondas junto a los ventanales, con el verde de Monsanto al otro lado del cristal. Hay además un salón con chimenea de ladrillo, butacas, velas y las fotos de los equipos del club: el restaurante nació ligado al Grupo Desportivo de Direito.',
					'La ficha lo clasifica como restaurante de cocina tradicional portuguesa y abre solo al mediodía, de martes a domingo de 12:45 a 15:00. En las fotos del perfil están la sopa verde de la casa, la mesa de queijos e enchidos y un buffet de doces con leite-creme, merengues, bolo de chocolate y fruta. Las reseñas hablan de comida, servicio y música, y de almuerzos de grupo servidos en buffet.',
				]}
				note="«Estava tudo impecável, empregados, comida, musica... localização top», dice una reseña. Otra lo resume así: «ambiente rústico num chalé de madeira com terraço e vista para o campo de rugby»."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La mesa"
				title="Cocina de casa<br /><em>y mesa de buffet.</em>"
				description="La ficha de Google no publica carta ni precios. Esto es lo que muestran las fotos del perfil —sopa, queijos e enchidos, doces— y lo que cuentan las reseñas sobre los almuerzos de grupo."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Sin carta publicada, el menú cambia según el día y la temporada. Platos, precios y menús de grupo se consultan llamando al 21 760 1592."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor,<br />la terraza<br /><em>y la mesa.</em>"
				description="Estas fotografías proceden del perfil de 1.º Direito en Google Maps: el comedor de madera, la terraza de sombrillas entre los pinos, el salón de la chimenea, la mesa de queijos e enchidos y el buffet de doces."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Parque Florestal de Monsanto · Alto da Boa Vista · 1500 Lisboa"
				title="En el Alto<br /><em>da Boa Vista.</em>"
				addressLines={[
					'Parque Florestal de Monsanto',
					'Campo de Rugby do Grupo Desportivo de Direito',
					'1500 Lisboa, Portugal',
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="Solo comidas: de martes a domingo, de 12:45 a 15:00. Lunes cerrado y sin servicio de cenas. En festivos puede cambiar: llama antes."
				mapTitle="Mapa de 1.º Direito en el Parque Florestal de Monsanto, Lisboa"
				mapEmbedUrl={MAPS.embed}
				mapLabel="1.º Direito · Monsanto"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `+351 ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				reserveNote="Se reserva desde la ficha de Google («Reservar mesa») o por teléfono, en el 21 760 1592. Para grupos y almuerzos de empresa conviene llamar con antelación. La ficha marca aparcamiento, entrada, asientos y aseo accesibles."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>subir a Monsanto.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address="Parque Florestal de Monsanto · 1500 Lisboa"
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a 1.º Direito"
			creditLabel="Creado por"
		/>
	</body>
</html>
