---
import '../styles/global.css';
import { LocalFooter, LocalSecciones, LocalSeo, LocalTopbar } from '@astro-components';

import foto from '../assets/fotos/good-times-01.jpg';
import { BUSINESS, FAQ, MAPS } from '../data/site';
import secciones from '../data/secciones.json';

const title = 'Good Times · Comida rápida y fresh tacos en Bilbao';
const description =
	'Good Times, restaurante de comida rápida en Allende Particular Kalea, 10 (48004 Bilbao). Fresh tacos, teléfono 652 32 24 85, fotos y cómo llegar. Según su ficha de Google Maps.';

const piezas = secciones.secciones;
const fotos = { 'good-times-01.jpg': foto };

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'FastFoodRestaurant',
	'@id': `${BUSINESS.siteUrl}/#good-times`,
	name: BUSINESS.name,
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	telephone: '+34652322485',
	servesCuisine: ['Comida rápida', 'Tacos'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Dónde estamos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..600&family=Rubik:ital,wght@0,400..800;1,400..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Good Times Bilbao, comida rápida Bilbao, tacos Bilbao, Allende Particular Kalea 10, fast food 48004, Good Times fresh tacos"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida rápida y fresh tacos en Allende Particular Kalea, 10, Bilbao. Teléfono, fotos y cómo llegar."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Good Times en Bilbao con el rótulo luminoso de Fresh Tacos"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#17181d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-BI"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Bilbao"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[foto]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Good Times"
			subtitle="Fresh tacos · Bilbao"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district,
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={[]}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/good-times/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma carta, precios y horario con el establecimiento."
			ctaLabel="Llamar a Good Times"
			navAriaLabel="Enlaces de Good Times"
			legalLinks={[
				{ label: 'Aviso legal', href: '/good-times/aviso-legal' },
				{ label: 'Privacidad', href: '/good-times/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/good-times/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
		<!-- contacto-rapido -->
		<style>
			.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
			.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
			.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
			.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
			.contact-fabs .fab-call { background: #e2402a; }
			.contact-fabs .fab-wa { background: #25d366; }
			.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
			@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
			@media (max-width: 680px) { .contact-fabs { bottom: 6rem; } }
		</style>
		<nav class="contact-fabs" aria-label="Contacto rápido">
			<a class="fab-call" href={BUSINESS.phoneHref} aria-label={`Llamar a ${BUSINESS.name}`}
				><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
					><path
						fill="currentColor"
						d="M6.6 10.8c1.2 2.4 3.2 4.4 5.6 5.6l1.9-1.9c.3-.3.7-.4 1.1-.2 1.2.4 2.4.6 3.7.6.6 0 1 .4 1 1V19c0 .6-.4 1-1 1C10.6 20 4 13.4 4 5c0-.6.4-1 1-1h3.1c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.7.1.4 0 .8-.2 1.1l-1.9 1.9Z"
					/></svg
				></a
			>
			<a
				class="fab-wa"
				href={BUSINESS.whatsappHref}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`Escribir por WhatsApp a ${BUSINESS.name}`}
				><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"
					><path
						fill="currentColor"
						d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"
					/></svg
				></a
			>
		</nav>
	</body>
</html>
