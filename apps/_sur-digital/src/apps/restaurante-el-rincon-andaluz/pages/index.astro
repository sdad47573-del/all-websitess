---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import heroImage from '../assets/fotos/restaurante-el-rincon-andaluz-apaisada-01.jpg';
import croquetas from '../assets/fotos/restaurante-el-rincon-andaluz-apaisada-04.jpg';
import bocadilloTortilla from '../assets/fotos/restaurante-el-rincon-andaluz-apaisada-05.jpg';
import tartaChocolate from '../assets/fotos/restaurante-el-rincon-andaluz-apaisada-10.jpg';
import bocadilloQueso from '../assets/fotos/restaurante-el-rincon-andaluz-panoramica-08.jpg';
import carne from '../assets/fotos/restaurante-el-rincon-andaluz-vertical-02.jpg';
import flan from '../assets/fotos/restaurante-el-rincon-andaluz-vertical-03.jpg';
import calamares from '../assets/fotos/restaurante-el-rincon-andaluz-vertical-06.jpg';
import gambas from '../assets/fotos/restaurante-el-rincon-andaluz-vertical-07.jpg';
import montaditos from '../assets/fotos/restaurante-el-rincon-andaluz-vertical-09.jpg';

const business = {
	name: 'Restaurante El Rincón Andaluz',
	brand: 'El Rincón Andaluz',
	tagline: 'Cocina andaluza y bar en Onda',
	street: 'Carrer Ceramista Mundina, 1',
	city: 'Onda',
	region: 'Comunitat Valenciana',
	postalCode: '12200',
	phone: '673 88 95 37',
	latitude: 39.9653533,
	longitude: -0.2634144,
	rating: 4.6,
	reviewsCount: 201,
	site: 'https://www.sur-digital.com/restaurante-el-rincon-andaluz',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd600b9612e8c0e5:0xe22120f51f04c72f';
const cidDecimal = '16294341163962648367';
const placeId = 'ChIJ5cDoEpYLYA0RL8cEH_UgIeI';

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+El+Rinc%C3%B3n+Andaluz/@39.9653533,-0.2634144,17z/data=!3m1!4b1!4m6!3m5!1s0xd600b9612e8c0e5:0xe22120f51f04c72f!8m2!3d39.9653533!4d-0.2634144!16s%2Fg%2F11j8vvwn6v?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&q=El+Rinc%C3%B3n+Andaluz+Onda&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34673889537';

const description =
	'Restaurante andaluz y bar en Onda (Castellón): surtido de ibéricos, gambas de Huelva, calamares, montaditos y carnes a la plancha. Abre todos los días desde las 9:00.';

const servicios = [
	'Cocina andaluza',
	'Bar de tapas',
	'Surtido de ibéricos',
	'Gambas de Huelva',
	'Calamares a la plancha',
	'Montaditos de jamón',
	'Carnes a la plancha',
	'Croquetas caseras',
	'Postres caseros',
	'Aperitivo con la bebida',
	'Desayunos y almuerzos',
	'En el centro de Onda',
];

const grupos = [
	{
		title: 'Para picar',
		items: [
			{
				name: 'Surtido de ibéricos',
				note: 'jamón y embutido cortados finos, con pan de la casa',
			},
			{
				name: 'Gambas de Huelva',
				note: 'cocidas y servidas en la fuente, para pelar sin prisa',
			},
			{
				name: 'Calamares a la plancha',
				note: 'con patatas y un chorro de aceite de oliva y perejil',
			},
			{
				name: 'Croquetas caseras',
				note: 'de las que salen doradas y se piden de dos en dos',
			},
		],
	},
	{
		title: 'Montaditos y bocadillos',
		items: [
			{
				name: 'Montadito de jamón',
				note: 'pan con tomate, jamón serrano y un hilo de aceite',
			},
			{
				name: 'Bocadillo de tortilla',
				note: 'de tortilla de patata, en pan de barra',
			},
			{
				name: 'Bocadillo de queso y tomate',
				note: 'con lonchas de queso y tomate rallado',
			},
		],
	},
	{
		title: 'De la plancha',
		items: [
			{
				name: 'Combinado de carne',
				note: 'el surtido que recomiendan las reseñas, con patatas y alioli',
			},
			{
				name: 'Carne a la plancha',
				note: 'con patatas caseras y un poco de alioli aparte',
			},
		],
	},
	{
		title: 'Postres y café',
		items: [
			{
				name: 'Flan con nata',
				note: 'con caramelo y nata montada, de los de cuchara',
			},
			{
				name: 'Tarta de chocolate',
				note: 'en vaso, con base de galleta',
			},
			{
				name: 'Café',
				note: 'para acompañar el montadito de media mañana',
			},
		],
	},
];

const galeria = [
	{
		src: croquetas,
		alt: 'Croquetas caseras recién fritas en Restaurante El Rincón Andaluz, Onda',
	},
	{
		src: bocadilloTortilla,
		alt: 'Bocadillo de tortilla con un plato de embutido en El Rincón Andaluz, Onda',
	},
	{
		src: tartaChocolate,
		alt: 'Tarta de chocolate en vaso de Restaurante El Rincón Andaluz, Onda',
	},
	{
		src: bocadilloQueso,
		alt: 'Bocadillo de queso y tomate con sangría en El Rincón Andaluz, Onda',
	},
	{
		src: carne,
		alt: 'Carne a la plancha con patatas y alioli en Restaurante El Rincón Andaluz, Onda',
	},
	{
		src: flan,
		alt: 'Flan con nata y caramelo de El Rincón Andaluz, Onda',
	},
	{
		src: calamares,
		alt: 'Calamares a la plancha con patatas en El Rincón Andaluz, Onda',
	},
	{
		src: gambas,
		alt: 'Gambas de Huelva servidas en la mesa de El Rincón Andaluz, Onda',
	},
	{
		src: montaditos,
		alt: 'Montaditos de jamón serrano con café en Restaurante El Rincón Andaluz, Onda',
	},
];

const faqs = [
	{
		q: '¿Dónde está El Rincón Andaluz?',
		a: 'En el Carrer Ceramista Mundina, 1, 12200 Onda (Castellón). Desde esta página puedes abrir Google Maps y trazar la ruta hasta la puerta con el botón «Cómo llegar».',
	},
	{
		q: '¿Qué tipo de comida sirven?',
		a: 'Cocina andaluza de bar y restaurante: surtido de ibéricos, gambas de Huelva, calamares a la plancha, croquetas caseras, montaditos de jamón y bocadillos, carnes a la plancha y postres de cuchara como el flan con nata o la tarta de chocolate.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De lunes a jueves abre de 9:00 a 15:00; los viernes y los sábados, de 9:00 a 17:00 y de 20:00 a 1:00; los domingos, de 9:00 a 16:00. Es el horario publicado en la ficha de Google, así que conviene confirmarlo por teléfono antes de ir.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'No hay reserva online ni formulario en esta web: se reserva llamando al 673 88 95 37. Para el aperitivo o el almuerzo entre semana no suele hacer falta, pero en las noches de viernes y sábado conviene llamar antes.',
	},
	{
		q: '¿Ponen aperitivo con la bebida?',
		a: 'Sí, es costumbre de la casa: como cuenta una de las reseñas, «pides tú cerveza y te ponen tu aperitivo». No es un menú cerrado ni una tapa a elegir, así que lo que salga depende del día.',
	},
	{
		q: '¿Se puede desayunar o almorzar?',
		a: 'Sí. El local abre a las 9:00 como bar, con café, montaditos y bocadillos, y a mediodía pasa a la cocina. Es la fórmula de toda la vida: desayuno, almuerzo y comida, sin cambiar de sitio.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['El Rincón Andaluz', 'Rincón Andaluz Onda', 'El Rincón Andaluz Onda'],
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 673 88 95 37',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Cocina andaluza', 'Tapas', 'Cocina española', 'Pescado y marisco'],
	areaServed: [
		{ '@type': 'City', name: 'Onda' },
		{ '@type': 'AdministrativeArea', name: 'Plana Baixa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '09:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '09:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '20:00',
			closes: '01:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '09:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-el-rincon-andaluz-apaisada-01.jpg": heroImage,
	"restaurante-el-rincon-andaluz-apaisada-04.jpg": croquetas,
	"restaurante-el-rincon-andaluz-apaisada-05.jpg": bocadilloTortilla,
	"restaurante-el-rincon-andaluz-apaisada-10.jpg": tartaChocolate,
	"restaurante-el-rincon-andaluz-panoramica-08.jpg": bocadilloQueso,
	"restaurante-el-rincon-andaluz-vertical-02.jpg": carne,
	"restaurante-el-rincon-andaluz-vertical-03.jpg": flan,
	"restaurante-el-rincon-andaluz-vertical-06.jpg": calamares,
	"restaurante-el-rincon-andaluz-vertical-07.jpg": gambas,
	"restaurante-el-rincon-andaluz-vertical-09.jpg": montaditos,
};

const horas = [
					{ day: 'Lunes', value: '9:00 – 15:00' },
					{ day: 'Martes', value: '9:00 – 15:00' },
					{ day: 'Miércoles', value: '9:00 – 15:00' },
					{ day: 'Jueves', value: '9:00 – 15:00' },
					{ day: 'Viernes', value: '9:00 – 17:00 · 20:00 – 1:00' },
					{ day: 'Sábado', value: '9:00 – 17:00 · 20:00 – 1:00' },
					{ day: 'Domingo', value: '9:00 – 16:00' },
				];
const mapasPagina = {
	place: cidUrl,
	directions: cidUrl,
	streetView: cidUrl,
	embed: mapEmbedUrl,
};---

<!doctype html>
<html lang="es">
	<head>
		<title>El Rincón Andaluz · Cocina andaluza en Onda</title>
		<meta name="theme-color" content="#2f5d50" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Jost:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="El Rincón Andaluz Onda, restaurante andaluz Onda, tapas Onda, gambas de Huelva Onda, montaditos Onda, bar Carrer Ceramista Mundina, comer en Onda Castellón, cocina andaluza Castellón, carne a la plancha Onda, restaurante Onda Plana Baixa"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="El Rincón Andaluz · Cocina andaluza en Onda"
			ogDescription="Surtido de ibéricos, gambas de Huelva, calamares, montaditos y carnes a la plancha en Onda. Abre desde las 9:00. 4,6 en Google con 201 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Mesa con vino blanco, pan y jamón en Restaurante El Rincón Andaluz, Onda"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#2f5d50"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Onda, Castellón"
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="RA"
			name={business.brand}
			subtitle="Cocina andaluza · Onda"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: business.name,
					street: business.street,
					district: business.district ?? '',
					postalCode: business.postalCode,
					city: business.city,
				}}
								horario={horas}
								mapas={mapasPagina}
			/>
		</main>

		<LocalFooter
			mark="RA"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a El Rincón Andaluz"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34673889537?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Restaurante%20el%20rincon%20andaluz." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Restaurante el rincon andaluz"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
