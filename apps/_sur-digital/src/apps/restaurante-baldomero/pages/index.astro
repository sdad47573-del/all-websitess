---
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	facebookLegacyUrl,
	facebookUrl,
	faqSchema,
	faqs,
	hours,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	dishes,
} from '../lib/business';

const title = 'Restaurante Baldomero | Cocina cordobesa en Aldea Quintana';
const description =
	'Restaurante Baldomero, cocina tradicional cordobesa en Aldea Quintana, La Carlota. Queso de Zuheros, salmorejo, espárragos y postres caseros. Reserva: 957 30 62 59.';
const keywords =
	'Restaurante Baldomero, restaurante Aldea Quintana, restaurantes La Carlota Córdoba, comida casera Córdoba, cocina tradicional cordobesa, queso de Zuheros, salmorejo, rabo de toro, Avenida de Cádiz 20';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#25221c" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Aldea Quintana, La Carlota" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/restaurante-baldomero/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700;9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Restaurante Baldomero en Aldea Quintana, La Carlota, Córdoba" />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.district} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<meta name="twitter:image:alt" content="Restaurante Baldomero en Aldea Quintana, Córdoba" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Restaurante Baldomero, inicio">
				<span class="brand-mark" aria-hidden="true">B</span>
				<span class="brand-name">Restaurante Baldomero <small>Cocina cordobesa · Aldea Quintana</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cocina">La casa</a>
				<a href="#carta">Especialidades</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 957 30 62 59</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Aldea Quintana · La Carlota · Córdoba</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-intro">
						Una mesa cordobesa con tradición familiar, producto de proximidad y recetas caseras. Haz una parada en Aldea Quintana para saborear cocina andaluza en un ambiente acogedor.
					</p>
					<div class="hero-actions">
						<a class="button button-copper" href={phoneHref}>Llamar y reservar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={mapsUrl} target="_blank" rel="noreferrer">Ver Google Maps <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Dirección</small><address>{business.streetAddress}<br />{business.postalCode} {business.district}</address></div>
						<div><small>Reservas</small><a href={phoneHref}>{business.phone}</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración original de un plato casero con ingredientes de la campiña cordobesa">
					<span class="plate-dot" aria-hidden="true"></span>
					<div class="plate" aria-hidden="true"><div class="food"></div></div>
					<div class="art-copy"><strong>Sabor a tradición</strong><span>Recetas · Producto · Familia</span></div>
				</div>
			</section>

			<div class="facts" aria-label="Propuesta de Restaurante Baldomero">
				<span>Cocina tradicional cordobesa</span>
				<span>Recetas caseras</span>
				<span>Producto de proximidad</span>
				<span>Aldea Quintana · La Carlota</span>
			</div>

			<section class="story section-pad" id="cocina" aria-labelledby="story-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Una casa con historia</p>
					<h2 id="story-title">Parada en el camino,<br /><em>mesa de familia.</em></h2>
				</div>
				<div class="story-copy">
					<p>
						Restaurante Baldomero está en Avenida de Cádiz, 20, en Aldea Quintana, municipio de La Carlota. Una casa de tradición familiar donde la cocina cordobesa y el trato cercano invitan a hacer una pausa y disfrutar de la mesa.
					</p>
					<p>
						En su cocina conviven recetas de siempre, productos de la provincia y propuestas de temporada. Entre los platos que aparecen en recomendaciones públicas están el queso de Zuheros, el revuelto de espárragos, el salmorejo, el rabo de toro y los postres caseros.
					</p>
					<p class="story-note">
						La carta, los precios y el horario pueden cambiar. Llama antes para consultar las especialidades disponibles y reservar, especialmente los fines de semana.
					</p>
				</div>
			</section>

			<section class="menu section-pad" id="carta" aria-labelledby="menu-title">
				<div class="section-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Sabores de Córdoba</p>
						<h2 id="menu-title">Lo bueno empieza<br /><em>al centro de la mesa.</em></h2>
					</div>
					<p>Una muestra de platos señalados en reseñas y guías públicas. La carta cambia con la temporada; pregunta directamente por los platos del día y los productos disponibles.</p>
				</div>
				<div class="menu-grid">
					{dishes.map((dish, index) => (
						<article class="menu-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.text}</p>
						</article>
					))}
				</div>
				<p class="menu-note">Platos orientativos, no una carta completa. Consulta precios, ingredientes y disponibilidad en el restaurante. <a href={phoneHref}>Llama al 957 30 62 59</a>.</p>
			</section>

			<section class="gallery section-pad" id="fotos" aria-labelledby="gallery-title">
				<div>
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Restaurante Baldomero · Córdoba</p>
					<h2 id="gallery-title">Conoce el local<br /><em>y sus fotos reales.</em></h2>
					<div class="gallery-copy">
						<p>La URL de Maps facilitada identifica la ficha del restaurante, pero no contiene enlaces directos a archivos fotográficos. Abre la ficha o sus perfiles para ver fotos recientes del local y sus platos.</p>
						<div class="gallery-links">
							<a class="button button-copper" href={mapsUrl} target="_blank" rel="noreferrer">Fotos en Google Maps <span aria-hidden="true">↗</span></a>
							<a class="social-link" href={facebookUrl} target="_blank" rel="noreferrer">Facebook del restaurante ↗</a>
							<a class="social-link" href={facebookLegacyUrl} target="_blank" rel="noreferrer">Perfil histórico ↗</a>
						</div>
					</div>
				</div>
				<div class="map-preview">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
						title="Mapa de Restaurante Baldomero en Avenida de Cádiz, 20, Aldea Quintana; abre Google Maps para consultar fotos"
					 src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<div class="map-caption"><span>Avenida de Cádiz, 20 · Aldea Quintana</span><a href={mapsUrl} target="_blank" rel="noreferrer">Abrir ficha y fotos ↗</a></div>
				</div>
				<p class="gallery-note">La ilustración es original y no representa una fotografía real del restaurante. Las fotos del local se consultan en Google Maps y sus perfiles públicos.</p>
			</section>

			<section class="visit section-pad" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Aldea Quintana · 14191</p>
					<h2 id="visit-title">Ven a comer<br /><em>a La Carlota.</em></h2>
					<address>{business.streetAddress}<br />{business.district}, {business.postalCode} {business.city}, {business.province}</address>
					<table class="hours">
						<caption>Horario publicado</caption>
						<tbody>
							{hours.map((item) => (
								<tr><th scope="row">{item.day}</th><td>{item.open} – {item.close}</td></tr>
							))}
						</tbody>
					</table>
					<p class="hours-note">Horario orientativo según fuentes públicas recientes. Confirma por teléfono en festivos y fechas especiales.</p>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={mapsUrl} target="_blank" rel="noreferrer">Ficha de Google Maps</a>
					</div>
					<a class="visit-phone" href={phoneHref}>Reservas: {business.phone}</a>
				</div>
				<div class="map-card">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
						title="Mapa de Restaurante Baldomero en Avenida de Cádiz, 20, Aldea Quintana, La Carlota"
					 src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<div class="map-label"><div><strong>{business.name}</strong><small>{business.streetAddress} · {business.district}</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
			<Galeria nombre="Restaurante Baldomero" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="footer-brand" href="#inicio" aria-label="Restaurante Baldomero, volver al inicio">
				<span class="brand-mark" aria-hidden="true">B</span>
				<span>Restaurante Baldomero<small>{business.streetAddress} · {business.postalCode} {business.district}</small></span>
			</a>
			<nav class="footer-nav" aria-label="Perfiles y contacto del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Restaurante Baldomero · Aldea Quintana, La Carlota. Consulta por teléfono el horario, la carta y disponibilidad.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/restaurante-baldomero/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/restaurante-baldomero/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/restaurante-baldomero/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar para reservar <span>957 30 62 59</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/restaurante-baldomero/aviso-legal">Aviso legal</a>
					<a href="/restaurante-baldomero/aviso-legal#privacidad">Privacidad</a>
					<a href="/restaurante-baldomero/aviso-legal#cookies">Cookies</a>
				</nav>
						<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34957306259?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Restaurante%20Baldomero." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Restaurante Baldomero"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>


