---
import '../styles/global.css';
import { Image } from 'astro:assets';
import heroPhoto from '../assets/fotos/taberna-pura-cepa-cordoba-cuadrada-03.jpg';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	facebookUrl,
	faqSchema,
	faqs,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	openingHours,
	phoneHref,
	restaurantSchema,
	specialties,
	tripadvisorUrl,
} from '../lib/business';

const title = 'Taberna Pura Cepa | Cocina cordobesa en Ciudad Jardín, Córdoba';
const description =
	'Taberna Pura Cepa en Córdoba: salmorejo, flamenquín, rabo de toro y tablas de ibéricos en Av. del Aeropuerto, 6 (Poniente Sur). Terraza, desayunos y vinos Montilla-Moriles. Reservas: 957 08 49 06.';
const keywords =
	'Taberna Pura Cepa, taberna en Córdoba, comer en Ciudad Jardín Córdoba, cocina cordobesa, salmorejo Córdoba, flamenquín Córdoba, rabo de toro al PX, Avenida del Aeropuerto 6 Córdoba, tapear Córdoba, reservar taberna Córdoba';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#5b1f28" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/taberna-pura-cepa-cordoba/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración original de una copa de vino para Taberna Pura Cepa; no es una fotografía del establecimiento" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Taberna Pura Cepa, inicio">
				<span class="brand-mark" aria-hidden="true">PC</span>
				<span class="brand-copy">Pura Cepa <small>Taberna · Córdoba</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#taberna">La taberna</a>
				<a href="#carta">La carta</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 957 08 49 06</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Ciudad Jardín · Córdoba</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-intro">Taberna Pura Cepa es una casa de barrio en la Avenida del Aeropuerto: barra de madera, productos de la tierra, cocina cordobesa de siempre y una terraza para quedarse sin mirar el reloj.</p>
					<div class="hero-actions">
						<a class="button button-gold" href={phoneHref}>Reservar por teléfono <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Nos encontrarás en</small><address>{business.streetAddress}<br />{business.postalCode} · Córdoba</address></div>
						<div><small>Reservas</small><a href={phoneHref}>{business.phone}</a><br /><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a></div>
					</div>
				</div>
				<figure class="hero-art">
					<Image
						class="hero-photo"
						src={heroPhoto}
						alt="Fotografía de Taberna Pura Cepa publicada en su ficha de Google Maps"
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 700px) 100vw, 48vw"
						format="webp"
						quality={70}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					<span class="hero-scrim" aria-hidden="true"></span>
					<figcaption class="art-caption"><strong>Pura Cepa</strong>Taberna &amp; terraza</figcaption>
				</figure>
			</section>

			<div class="promise" aria-label="Información de Taberna Pura Cepa">
				<span>Cocina cordobesa</span><span>Terraza exterior</span><span>Admite mascotas</span><span>Vinos Montilla-Moriles</span>
			</div>

			<section class="section intro" id="taberna" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Una taberna de barrio</p>
					<h2 id="intro-title">Sabor a barrio,<br /><em>mesa de siempre.</em></h2>
				</div>
				<div class="intro-copy">
					<p>En el pasaje comercial de Poniente Sur, a un paso del barrio de Ciudad Jardín, Taberna Pura Cepa es uno de esos locales que se han ganado a pulso la confianza del vecindario cordobés. Su propietario, Juan, lleva décadas al frente de la barra atendiendo a quien entra.</p>
					<p>El local, amplio y luminoso tras su reforma, combina desayunos, almuerzos, cenas y tapeo. La carta mira a la cocina cordobesa y andaluza: cuchara, fritos, ahumados e ibéricos, con raciones y medias raciones para compartir.</p>
					<p class="source-note">La información de esta página procede de la ficha de Google Maps, de los perfiles oficiales del establecimiento y de directorios gastronómicos. La carta y los horarios pueden cambiar: confirma antes de tu visita.</p>
				</div>
			</section>

			<section class="section carta" id="carta" aria-labelledby="carta-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Cocina cordobesa y de mercado</p>
						<h2 id="carta-title">Platos que<br /><em>saben a Córdoba.</em></h2>
					</div>
					<p>Una selección orientativa de los platos más mencionados por la clientela y presentes en fuentes gastronómicas. No sustituye la carta vigente.</p>
				</div>
				<div class="carta-grid">
					{specialties.map((dish, index) => (
						<article class="carta-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<div class="carta-extra">
					<p><strong>Bodega:</strong> finos, amontillados, olorosos y Pedro Ximénez de la D.O. Montilla-Moriles, además de cerveza de grifo bien tirada.</p>
					<p><strong>Medias raciones:</strong> la casa permite compartir con raciones completas o medias, abundantes según los clientes.</p>
					<p class="menu-note">Consulta platos del día, disponibilidad y alérgenos con el equipo. <a href={phoneHref}>Llama a la taberna</a>.</p>
				</div>
			</section>

			<Galeria
				id="fotos"
				nombre="Taberna Pura Cepa"
				titulo="Pura Cepa, en fotos."
				intro="Fotos reales del local, de la barra y de los platos, publicadas en la ficha de Google Maps. Para ver la colección completa, abre la ficha en Google Maps o los perfiles oficiales de la taberna."
				mapsUrl={mapsUrl}
			/>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14004 · Poniente Sur, Córdoba</p>
					<h2 id="visit-title">Ven a tapear<br /><em>a Pura Cepa.</em></h2>
					<address>{business.streetAddress}<br />{business.postalCode} {business.locality}<br />{business.province}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Reservas y consultas</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Ubicación</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Redes sociales</small><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a> · <a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a> · <a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar y reservar</a>
					</div>
					<p class="hours-note">Los horarios pueden variar en festivos y temporada alta. Llama antes de desplazarte para confirmarlo.</p>
				</div>
				<div class="visit-side">
					<div class="hours-card">
						<h3>Horario orientativo</h3>
						<ul>
							{openingHours.map((slot) => (
								<li><span>{slot.day}</span><strong>{slot.hours}</strong></li>
							))}
						</ul>
					</div>
					<div class="map-card">
						<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Taberna Pura Cepa en Avenida del Aeropuerto, Córdoba" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-label"><div><strong>Taberna Pura Cepa</strong><small>Av. del Aeropuerto, 6 · Córdoba</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="Taberna Pura Cepa, volver al inicio">
				<span class="brand-mark" aria-hidden="true">PC</span><span class="brand-copy">Pura Cepa <small>Taberna · Ciudad Jardín</small></span>
			</a>
			<nav class="footer-nav" aria-label="Redes y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Taberna Pura Cepa · Córdoba. Consulta horarios, carta y alérgenos directamente con el establecimiento.</small>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/taberna-pura-cepa-cordoba/aviso-legal">Aviso legal</a>
			<a href="/taberna-pura-cepa-cordoba/aviso-legal#privacidad">Privacidad</a>
			<a href="/taberna-pura-cepa-cordoba/aviso-legal#cookies">Cookies</a>
		</nav>
		<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
	</footer>
		<a class="mobile-call" href={phoneHref}>Reservar en Pura Cepa <span>957 08 49 06</span></a>

						<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34957084906?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Taberna%20Pura%20Cepa." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Taberna Pura Cepa"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>


