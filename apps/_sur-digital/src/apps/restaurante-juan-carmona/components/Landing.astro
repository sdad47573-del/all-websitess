---
import { getImage, Image } from 'astro:assets';
import '../styles/global.css';
import {
	business,
	createRestaurantSchema,
	directionsUrl,
	facebookUrl,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	photos,
	reviewUrl,
	whatsappUrl,
} from '../lib/business';
import { content } from '../lib/content';

interface Props {
	locale: 'es' | 'en';
}

const { locale } = Astro.props;
const page = content[locale];
const canonical = `${business.site}${page.path}`;
// El hero se sirve en AVIF, asi que se precarga esa variante y no el JPEG original.
const heroPreload = await getImage({ src: photos.hero, width: 1200, format: 'webp', quality: 70 });
const sectionIds =
	locale === 'es'
		? { story: 'casa', food: 'carta', gallery: 'fotos', zone: 'zona', visit: 'visita' }
		: { story: 'house', food: 'menu', gallery: 'photos', zone: 'area', visit: 'visit' };

const galleryAlts =
	locale === 'es'
		? [
				'Fotografía de Restaurante Juan Carmona en La Carihuela, Torremolinos, publicada en su ficha de Google Maps',
				'Imagen del restaurante en la calle Mar, La Carihuela, desde el perfil de Google Maps',
				'Detalle del comedor de Restaurante Juan Carmona (Torremolinos) en Google Maps',
				'Fotografía de la terraza de Restaurante Juan Carmona en su ficha de Google Maps',
				'Fotografía de los platos de marisco y pescado de Juan Carmona, desde Google Maps',
				'Otra imagen de Restaurante Juan Carmona en La Carihuela procedente de Google Maps',
				'Imagen del pescado fresco de Restaurante Juan Carmona en Torremolinos, según Google Maps',
			]
		: [
				'Photograph of Restaurante Juan Carmona in La Carihuela, Torremolinos, from its Google Maps listing',
				'Image of the restaurant on Calle Mar, La Carihuela, from the Google Maps profile',
				'Detail of the dining room at Restaurante Juan Carmona in Torremolinos, from Google Maps',
				'Photo of the terrace at Restaurante Juan Carmona on its Google Maps listing',
				'Photo of the seafood and fish dishes at Juan Carmona, from Google Maps',
				'Another image of Restaurante Juan Carmona in La Carihuela taken from Google Maps',
				'Image of the fresh fish at Restaurante Juan Carmona in Torremolinos, from Google Maps',
			];

const restaurantSchema = createRestaurantSchema(page.description);
// Nodo `WebSite` del grafo: las páginas legales apuntan a él con `isPartOf`, así que tiene
// que estar definido también en la portada.
const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': `${business.site}/#website`,
	url: `${business.site}/`,
	name: business.name,
	inLanguage: page.lang,
	publisher: { '@id': `${business.site}/#restaurante` },
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: page.faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: business.name, item: `${business.site}${page.path}` },
	],
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang={page.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0e2a35" />
		<link rel="preload" as="image" href={heroPreload.src} type="image/webp" fetchpriority="high" />
		<meta name="description" content={page.description} />
		<meta name="keywords" content={page.keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="La Carihuela, Torremolinos" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="es" href={`${business.site}/`} />
		<link rel="alternate" hreflang="en" href={`${business.site}/en/`} />
		<link rel="alternate" hreflang="x-default" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/restaurante-juan-carmona/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{page.title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content={page.locale} />
		<meta property="og:locale:alternate" content={locale === 'es' ? 'en_GB' : 'es_ES'} />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={page.title} />
		<meta property="og:description" content={page.description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:alt" content={galleryAlts[0]} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.neighborhood} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="Spain" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={page.title} />
		<meta name="twitter:description" content={page.description} />
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#main">{page.skip}</a>

		<header class="site-header">
			<a class="brand" href={page.path} aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">JC</span>
				<span class="brand-name">Juan Carmona<small>La Carihuela · Torremolinos</small></span>
			</a>
			<nav aria-label={page.navLabel}>
				{page.nav.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
			<div class="header-actions">
				<a class="language" href={page.languageHref} lang={locale === 'es' ? 'en' : 'es'}>
					{page.languageLabel}
				</a>
				<a class="header-call" href={phoneHref}>{business.phone}</a>
			</div>
		</header>

		<main id="main">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true">❋</span>{page.eyebrow}</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-intro">{page.intro}</p>
					<div class="hero-actions">
						<a class="button button-primary" href={phoneHref}>
							{page.primaryCta}<span aria-hidden="true">↗</span>
						</a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">
							{page.directionsCta}<span aria-hidden="true">↗</span>
						</a>
					</div>
					<p class="hero-note">{page.heroNote}</p>
					<ul class="hero-facts">
						{page.heroFacts.map((fact) => (
							<li><b>{fact.value}</b><span>{fact.label}</span></li>
						))}
					</ul>
				</div>
				<figure class="hero-photo">
					<Image
						src={photos.hero}
						alt={galleryAlts[0]}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="webp"
						quality={70}
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>{page.galleryCaption}</span>
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">{page.galleryCta} ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="story section-wrap" id={sectionIds.story}>
				<p class="section-label"><span aria-hidden="true">❋</span>{page.storyLabel}</p>
				<div class="story-main">
					<h2>{page.storyTitle}</h2>
					<div class="story-copy">
						<p>{page.storyText}</p>
						<p>{page.storyDetail}</p>
						<div class="story-links">
							<a class="text-link" href={instagramUrl} target="_blank" rel="noopener noreferrer">
								Instagram del restaurante<span aria-hidden="true">↗</span>
							</a>
							<a class="text-link" href={facebookUrl} target="_blank" rel="noopener noreferrer">
								Facebook<span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
				<div class="pillars">
					{page.pillars.map((item) => (
						<article class="pillar">
							<h3>{item.title}</h3>
							<p>{item.detail}</p>
						</article>
					))}
				</div>
			</section>

			<section class="menu" id={sectionIds.food}>
				<div class="menu-grid section-wrap">
					<div class="menu-copy">
						<p class="eyebrow eyebrow-dark"><span aria-hidden="true">❋</span>{page.foodEyebrow}</p>
						<h2>{page.foodTitle}</h2>
						<p>{page.foodText}</p>
						<ul class="tags">
							{page.foodTags.map((tag) => <li>{tag}</li>)}
						</ul>
					</div>
					<div class="menu-cards">
						{page.specialties.map((item) => (
							<article class="dish">
								<span class="dish-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="gallery section-wrap" id={sectionIds.gallery} aria-labelledby="gallery-title">
				<div class="gallery-head">
					<div>
						<p class="eyebrow eyebrow-dark"><span aria-hidden="true">❋</span>{page.galleryEyebrow}</p>
						<h2 id="gallery-title">{page.galleryTitle}</h2>
						<p>{page.galleryText}</p>
					</div>
					<a class="button button-primary" href={mapsUrl} target="_blank" rel="noopener noreferrer">
						{page.galleryCta}<span aria-hidden="true">↗</span>
					</a>
				</div>
				<div class="gallery-grid">
					{photos.gallery.map((photo, index) => (
						<figure class="shot">
							<Image
								src={photo}
								alt={galleryAlts[index + 1]}
								widths={[320, 480, 640]}
								sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
								format="webp"
								quality={65}
								loading="lazy"
								decoding="async"
							/>
						</figure>
					))}
				</div>
				<p class="gallery-note">{page.photoNote}</p>
			</section>

			<section class="zone section-wrap" id={sectionIds.zone} aria-labelledby="zone-title">
				<p class="section-label"><span aria-hidden="true">❋</span>{page.zoneLabel}</p>
				<div class="zone-head">
					<h2 id="zone-title">{page.zoneTitle}</h2>
					<p>{page.zoneText}</p>
				</div>
				<ul class="zone-points">
					{page.zonePoints.map((point) => (
						<li class="zone-point">
							<h3>{point.title}</h3>
							<p>{point.detail}</p>
						</li>
					))}
				</ul>
			</section>

			<section class="visit section-wrap" id={sectionIds.visit}>
				<div class="visit-grid">
					<div class="visit-copy">
						<p class="eyebrow"><span aria-hidden="true">❋</span>{page.visitEyebrow}</p>
						<h2>{page.visitTitle}</h2>
						<div class="contact-details">
							<div class="contact-item">
								<span class="contact-icon" aria-hidden="true">⌖</span>
								<p>
									<small>{page.addressLabel}</small>{business.streetAddress}<br />
									{business.postalCode} {business.neighborhood}<br />
									{business.city} · {business.region}
								</p>
							</div>
							<div class="contact-item">
								<span class="contact-icon" aria-hidden="true">☎</span>
								<p>
									<small>{page.phoneLabel}</small>
									<a href={phoneHref}>{business.phone}</a>
								</p>
							</div>
							<div class="contact-item">
								<span class="contact-icon" aria-hidden="true">◷</span>
								<p>
									<small>{page.hoursLabel}</small>{page.hoursText}
								</p>
							</div>
						</div>
						<table class="hours">
							<caption>Horario</caption>
							<tbody>
								{page.hoursRows.map((row) => (
									<tr>
										<th scope="row">{row.days}</th>
										<td>{row.hours}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">{page.hoursNote}</p>
						<a class="visit-call" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-panel">
						<div class="map-heading">
							<span><i aria-hidden="true"></i>{page.mapArea}</span>
							<a href={mapsUrl} target="_blank" rel="noopener noreferrer">{page.mapOpen} ↗</a>
						</div>
						<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
							title={page.mapTitle}
						 src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">{locale === 'en' ? 'Directions in Google Maps ↗' : 'Cómo llegar en Google Maps ↗'}</a></p>
							</noscript>
						</div>
						<a class="map-footer" href={directionsUrl} target="_blank" rel="noopener noreferrer">
							<span class="map-pin" aria-hidden="true">⌖</span>
							<span><strong>{business.shortName}</strong><small>{business.streetAddress} · {business.neighborhood}</small></span>
							<b>{page.mapDirections} ↗</b>
						</a>
					</div>
				</div>
			</section>

			<section class="faq section-wrap">
				<div class="faq-title">
					<p class="eyebrow eyebrow-dark"><span aria-hidden="true">❋</span>{page.faqEyebrow}</p>
					<h2>{page.faqTitle}</h2>
				</div>
				<div class="faq-list">
					{page.faqs.map((faq) => (
						<details>
							<summary>{faq.q}<span aria-hidden="true">+</span></summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand" href={page.path} aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">JC</span>
				<span class="brand-name">Juan Carmona<small>La Carihuela · Torremolinos</small></span>
			</a>
			<p>{page.footerNote}<br />{business.streetAddress}, {business.neighborhood} · {business.postalCode}</p>
			<div class="footer-links">
				<a href={page.languageHref}>{page.languageLabel}</a>
				<a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a>
				<a href={reviewUrl} target="_blank" rel="noopener noreferrer">{page.reviewCta} ↗</a>
				<a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</div>
			<small class="footer-legal">
				© {new Date().getFullYear()} {business.name} · {business.city} · {page.photosCredit}
			</small>
			<nav class="footer-legal-links" aria-label={page.legalNavLabel}>
				<a href="/restaurante-juan-carmona/aviso-legal/">Aviso legal</a>
				<a href="/restaurante-juan-carmona/privacidad/">Política de privacidad</a>
				<a href="/restaurante-juan-carmona/cookies/">Política de cookies</a>
			</nav>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
		</footer>

		<nav class="float-actions" aria-label={page.actionsLabel}>
			{whatsappUrl && (
				<a
					class="float-btn float-btn-whatsapp"
					href={whatsappUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={page.whatsappCta}
				>
					<span class="float-icon" aria-hidden="true">✆</span><span class="float-text">{page.whatsappCta}</span>
				</a>
			)}
			<a
				class="float-btn float-btn-review"
				href={reviewUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={page.reviewCta}
			>
				<span class="float-icon" aria-hidden="true">★</span><span class="float-text">{page.reviewCta}</span>
			</a>
			<a class="float-btn float-btn-primary" href={phoneHref} aria-label={page.callCta}>
				<span class="float-icon" aria-hidden="true">☎</span><span class="float-text">{page.callCta}</span>
			</a>
		</nav>

		<a class="mobile-cta" href={phoneHref}>
			<span aria-hidden="true">↗</span>{page.primaryCta}<strong>{business.phone}</strong>
		</a>
	</body>
</html>


