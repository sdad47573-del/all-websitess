---
import WhatsappFab from '../components/WhatsappFab.astro';
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

const business = {
	name: 'PITXÓN Restaurante Bar',
	tagline: 'Gastrobar · Terraza en el Parque de los Juncos',
	street: 'C. Juan Fernández, 34',
	district: 'Parque de los Juncos',
	city: 'Cartagena',
	region: 'Región de Murcia',
	postalCode: '30204',
	phone: '605 45 76 34',
	latitude: 37.6105707,
	longitude: -0.9876871,
	site: 'https://www.sur-digital.com/pitxon-restaurante-bar',
};

const mapsUrl = `https://www.google.com/maps/place/PITX%C3%93N+Restaurante+Bar/@${business.latitude},${business.longitude},17z/data=!3m1!4b1!4m6!3m5!1s0xd634326586ad9f3:0xb43a83a20c78248b!8m2!3d${business.latitude}!4d${business.longitude}!16s%2Fg%2F11tnv_75q8`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34605457634';

const description =
	'PITXÓN Restaurante Bar, gastrobar con terraza en el Parque de los Juncos (C. Juan Fernández 34, Cartagena): desayunos, tapas frescas, cañas y vinos. Lun–dom 08:30–23:00, vie–sáb hasta 24:00. Tel. 605 45 76 34.';

const servicios = [
	'Terraza en el parque',
	'Desayunos',
	'Tapas frescas',
	'Cañas y vinos',
	'Familiar',
	'Admite perros',
	'Accesible sillas de ruedas',
	'Reservas',
	'Abierto todos los días',
];

const platos = [
	{ name: 'Desayunos: café y tostada a tu manera', note: 'el rito semanal de muchas familias, con servicio paciente' },
	{ name: 'Tapas frescas del día', note: 'producto bien tratado a precios ajustados' },
	{ name: 'Tacos', note: 'el bocado recomendado por la clientela del parque' },
	{ name: 'Raciones para compartir', note: 'en mesa o en terraza entre pinos' },
	{ name: 'Cocina tradicional murciana', note: 'fondo casero de mediodía' },
	{ name: 'Cañas bien tiradas y vinos', note: 'para la sobremesa al aire libre' },
	{ name: 'Planes con niños y perros', note: 'terraza amplia donde todos caben' },
];

const fotos = [
	{ src: '/pitxon-restaurante-bar/fotos/terraza-parque.svg', alt: 'Ilustración placeholder de la terraza de PITXÓN en el Parque de los Juncos — sustituir por foto propia' },
	{ src: '/pitxon-restaurante-bar/fotos/desayunos-tostada.svg', alt: 'Ilustración placeholder de desayunos con café y tostada — sustituir por foto propia' },
	{ src: '/pitxon-restaurante-bar/fotos/tapas-frescas.svg', alt: 'Ilustración placeholder de tapas frescas y tacos — sustituir por foto propia' },
	{ src: '/pitxon-restaurante-bar/fotos/canas-vino.svg', alt: 'Ilustración placeholder de cañas y vinos — sustituir por foto propia' },
	{ src: '/pitxon-restaurante-bar/fotos/familias-parque.svg', alt: 'Ilustración placeholder de planes en familia en el parque — sustituir por foto propia' },
	{ src: '/pitxon-restaurante-bar/fotos/exterior-juan-fernandez.svg', alt: 'Ilustración placeholder del exterior en C. Juan Fernández 34 — sustituir por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está PITXÓN Restaurante Bar?',
		a: 'En C. Juan Fernández 34, 30204 Cartagena, junto al Parque de los Juncos. Es un gastrobar con terraza amplia rodeada de verde, ideal para ir con familia, niños y perros.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Abre todos los días: de lunes a jueves y domingos de 08:30 a 23:00, y viernes y sábados de 08:30 a 24:00 (datos públicos actualizados en 2026). Confirma en festivos llamando al 605 45 76 34.',
	},
	{
		q: '¿Qué se come en PITXÓN?',
		a: 'Gastrobar de tapas frescas y cocina tradicional murciana: desayunos con café y tostada, tacos recomendados por la clientela, raciones para compartir, cañas y vinos. Precios ajustados y producto bien tratado.',
	},
	{
		q: '¿Es un sitio familiar?',
		a: 'Sí, es su seña de identidad: ambiente acogedor para familias, terraza donde los niños se mueven a gusto y se admiten perros. El personal es conocido por su paciencia con los desayunos personalizados.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'Puedes reservar llamando al 605 45 76 34. En fines de semana y buen tiempo la terraza se llena: mejor llamar antes, sobre todo en grupo.',
	},
	{
		q: '¿Es accesible?',
		a: 'Sí, dispone de asientos y aseo accesibles para sillas de ruedas según su ficha pública.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 605 45 76 34',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Española', 'Tapas', 'Gastrobar'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'C. Juan Fernández, 34',
		addressLocality: business.city,
		addressRegion: 'Murcia',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: { '@type': 'GeoCoordinates', latitude: business.latitude, longitude: business.longitude },
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Sunday'], opens: '08:30', closes: '23:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday', 'Saturday'], opens: '08:30', closes: '24:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza al aire libre', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Admite perros', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Reservas', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Qué pedir', href: '#carta' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>PITXÓN Restaurante Bar | Gastrobar con terraza en Cartagena</title>
		<meta name="theme-color" content="#14101c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="PITXÓN, restaurante Cartagena, Parque de los Juncos comer, Juan Fernández 34, gastrobar Cartagena, tapas Cartagena, desayunos Cartagena, terraza Cartagena"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="PITXÓN Restaurante Bar · Terraza en el Parque de los Juncos"
			ogDescription="Desayunos, tapas frescas, tacos, cañas y vinos en C. Juan Fernández 34, Cartagena. Todos los días 08:30–23:00."
			ogImage={`${business.site}/og.svg`}
			ogImageAlt="PITXÓN Restaurante Bar, gastrobar con terraza en Cartagena"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#14101c"
			street={business.street}
			city={business.city}
			region="Murcia"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Parque de los Juncos, Cartagena"
			preload={[]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Cartagena" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<style>
			.hero-custom { display:grid; grid-template-columns: 1.05fr 0.95fr; gap:2.5rem; align-items:center; padding:4.5rem 0 2.5rem; }
			.hero-custom h1 { font-size: clamp(2.6rem, 5.4vw, 4.4rem); line-height:1.02; margin:0.6rem 0 1rem; }
			.hero-custom h1 em { color: var(--amber); font-style:normal; }
			.hero-custom img { width:100%; height:auto; border-radius: var(--radius); border:1px solid var(--line); }
			.fotos-grid { display:grid; grid-template-columns: repeat(3, 1fr); gap:1rem; margin-top:1.6rem; }
			.fotos-grid figure { margin:0; border:1px solid var(--line); border-radius:14px; overflow:hidden; background:var(--deep-2); }
			.fotos-grid img { width:100%; height:220px; object-fit:cover; display:block; }
			.fotos-grid figcaption { padding:0.6rem 0.8rem; font-size:0.85rem; color:var(--muted); }
			.aviso-fotos { border:1px dashed var(--amber); border-radius:14px; padding:1rem 1.2rem; background:rgba(245,165,36,0.08); font-size:0.95rem; }
			@media (max-width: 980px){ .hero-custom{grid-template-columns:1fr; padding-top:3rem;} .fotos-grid{grid-template-columns:1fr 1fr;} }
			@media (max-width: 640px){ .fotos-grid{grid-template-columns:1fr;} .fotos-grid img{height:200px;} }
		</style>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="P"
			name={business.name}
			subtitle="Parque de los Juncos · Cartagena"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<section class="hero-custom wrap" id="inicio" aria-labelledby="hero-title">
				<div>
					<p class="eyebrow"><span aria-hidden="true"></span> C. Juan Fernández 34 · Cartagena</p>
					<h1 id="hero-title">Tu mesa<br />en el parque,<br /><em>todos los días.</em></h1>
					<p class="hero-lede">Gastrobar familiar junto al Parque de los Juncos: desayunos de café y tostada, tapas frescas, tacos, cañas y vinos en terraza entre pinos. De 08:30 a 23:00 (fines de semana hasta las 24:00).</p>
					<div class="hero-actions">
						<a class="button button-primary" href={phoneHref}>Llamar 605 45 76 34</a>
						<a class="button button-ghost" href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>Terraza</b> en el Parque de los Juncos</li>
						<li><b>08:30–23:00</b> · vie–sáb hasta 24:00</li>
						<li><b>Familiar</b> · admite perros</li>
						<li><b>Reservas</b> por teléfono</li>
					</ul>
				</div>
				<figure style="margin:0">
					<img src="/pitxon-restaurante-bar/fotos/terraza-parque.svg" alt="Ilustración de la terraza de PITXÓN en el Parque de los Juncos" fetchpriority="high" decoding="async" />
					<figcaption style="color:var(--muted);font-size:0.85rem;margin-top:0.5rem">Imagen provisional — sustitúyela por fotos propias. <a href={mapsUrl} target="_blank" rel="noreferrer">Ver galería en Maps ↗</a></figcaption>
				</figure>
			</section>

			<LocalChips label="Servicios de PITXÓN" items={servicios} />

			<LocalAbout
				label="Un gastrobar de barrio junto al parque"
				title="Desayunos,<br />tapas frescas<br /><em>y terraza verde.</em>"
				paragraphs={[
					'PITXÓN está en C. Juan Fernández 34, pegado al Parque de los Juncos: terraza amplia rodeada de verde donde se desayuna, se tapea y se alarga la sobremesa sin prisa.',
					'Su fama la han hecho los desayunos en familia —cada café y cada tostada a su manera, servidos con paciencia— y una carta de tapas frescas con tacos recomendados, raciones para compartir y fondo de cocina murciana.',
					'Ambiente acogedor, precios ajustados y personal atento: el sitio al que se vuelve cada semana.',
				]}
				note="La clientela destaca el trato del personal y la terraza familiar. En fines de semana con buen tiempo, mejor reservar."
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
					{ label: 'Ficha en Google Maps', href: mapsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="Lo más pedido"
				title="Qué pedir<br /><em>en PITXÓN.</em>"
				description="Selección a partir de reseñas públicas de la clientela. Carta viva de gastrobar: pregunta por las tapas del día."
				cta={{ label: 'Reservar por teléfono', href: phoneHref }}
				groups={[{ title: 'La carta', items: platos }]}
				note="Si vais en grupo o con niños y perros, avisad al reservar para preparar la mesa de terraza."
			/>

			<section class="section-pad wrap" id="fotos" aria-labelledby="fotos-title">
				<p class="eyebrow"><span aria-hidden="true"></span> Fotos</p>
				<h2 id="fotos-title">El bar, <em style="color:var(--amber);font-style:normal">en imágenes.</em></h2>
				<div class="aviso-fotos" role="note">
					<strong>⚠️ Sobre las fotos de Google Maps:</strong> no las he descargado ni copiado: las imágenes de la ficha de Google tienen derechos de sus autores y las condiciones de Google Maps no permiten extraerlas automáticamente. Esta web usa <strong>ilustraciones placeholder propias</strong> en <code>public/fotos/</code>. Sustitúyelas por fotos propias del local (mismo nombre de archivo) y se publicarán solas.
				</div>
				<div class="fotos-grid">
					{fotos.map((f) => (
						<figure>
							<img src={f.src} alt={f.alt} loading="lazy" decoding="async" />
							<figcaption>{f.alt.split('—')[0]}</figcaption>
						</figure>
					))}
				</div>
				<p style="margin-top:1rem"><a class="button button-ghost" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos reales en Google Maps ↗</a></p>
			</section>

			<LocalVisit
				eyebrow="C. Juan Fernández 34 · 30204 Cartagena"
				title="Nos vemos<br /><em>en Los Juncos.</em>"
				addressLines={[
					'C. Juan Fernández, 34',
					'Parque de los Juncos',
					'30204 Cartagena (Murcia), España',
				]}
				hours={[
					{ day: 'Lunes', value: '08:30 – 23:00' },
					{ day: 'Martes', value: '08:30 – 23:00' },
					{ day: 'Miércoles', value: '08:30 – 23:00' },
					{ day: 'Jueves', value: '08:30 – 23:00' },
					{ day: 'Viernes', value: '08:30 – 24:00' },
					{ day: 'Sábado', value: '08:30 – 24:00' },
					{ day: 'Domingo', value: '08:30 – 23:00' },
				]}
				hoursNote="Horario según ficha pública (2026). Confirma en festivos por teléfono."
				mapTitle="Mapa de PITXÓN Restaurante Bar en C. Juan Fernández 34, Cartagena"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="PITXÓN · Parque de los Juncos"
				mapHref={mapsUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Reservas en el 605 45 76 34. Terraza demandada en fin de semana."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="P"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Cómo llegar ↗', href: directionsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Ilustraciones propias provisionales. Información elaborada a partir de fuentes públicas; confirma horarios y precios antes de la visita."
			ctaLabel="Llamar a PITXÓN"
		/>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/pitxon-restaurante-bar/aviso-legal">Aviso legal</a>
			<a href="/pitxon-restaurante-bar/aviso-legal#privacidad">Privacidad</a>
			<a href="/pitxon-restaurante-bar/aviso-legal#cookies">Cookies</a>
		</nav>
		<WhatsappFab phone={phoneHref} name={business.name} />
	</body>
</html>
