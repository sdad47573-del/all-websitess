---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/la-cocina-del-hogar-vertical-01.jpg';
import cartel from '../assets/fotos/la-cocina-del-hogar-vertical-08.jpg';
import migas from '../assets/fotos/la-cocina-del-hogar-vertical-06.jpg';
import tartas from '../assets/fotos/la-cocina-del-hogar-vertical-03.jpg';
import bizcocho from '../assets/fotos/la-cocina-del-hogar-vertical-05.jpg';
import tortillas from '../assets/fotos/la-cocina-del-hogar-apaisada-02.jpg';
import croquetas from '../assets/fotos/la-cocina-del-hogar-apaisada-07.jpg';
import horario from '../assets/fotos/la-cocina-del-hogar-apaisada-09.jpg';
import tartaHorno from '../assets/fotos/la-cocina-del-hogar-apaisada-04.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'La Cocina Del Hogar · Comida casera en Ciudad Real';
const description =
	'Menú del día, pollo asado con patatas, arroces y migas por encargo en C. Morería, 19 (13002 Ciudad Real). De 12:00 a 15:30; martes cerrado.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de La Cocina Del Hogar en la calle Morería de Ciudad Real, con el rótulo, el teléfono y la pizarra del menú del día',
	},
	{
		src: cartel,
		alt: 'El cartel del menú del día de La Cocina Del Hogar, con los platos, el precio de 9,90 € y los pollos asados',
	},
	{
		src: migas,
		alt: 'Una bandeja de migas con tropezones de pan, chorizo y pimiento verde frito',
	},
	{
		src: tortillas,
		alt: 'Dos tortillas de patata doradas en platos blancos sobre la mesa de acero de la cocina',
	},
	{
		src: croquetas,
		alt: 'Dos bandejas de croquetas empanadas, alineadas y listas para freír',
	},
	{
		src: tartas,
		alt: 'Diez tartas recién horneadas en sus moldes de aluminio, alineadas sobre la mesa de acero',
	},
	{
		src: bizcocho,
		alt: 'Un trozo de bizcocho glaseado en blanco y espolvoreado con canela',
	},
	{
		src: horario,
		alt: 'El cartel de horario del local: de 12:00 a 15:30, de lunes a domingo, con el martes cerrado',
	},
	{
		src: tartaHorno,
		alt: 'Una tarta horneada de superficie dorada, recién salida del horno, en su molde',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-cocina-del-hogar`,
	name: BUSINESS.fullName,
	alternateName: ['La Cocina del Hogar Ciudad Real', 'La Cocina Del Hogar Morería', 'Cocina del Hogar'],
	description:
		'Comida casera para llevar en la calle Morería, 19 (13002 Ciudad Real): menú del día con dos platos y postre, pollos asados con patatas, arroces y migas por encargo.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34926721660',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	slogan: 'Sabor y calidez en cada plato',
	servesCuisine: ['Cocina casera', 'Cocina manchega', 'Asador', 'Comida para llevar'],
	hasMenu: {
		'@type': 'Menu',
		name: 'Menú del día de La Cocina Del Hogar',
		inLanguage: 'es-ES',
		hasMenuSection: MENU.map((group) => ({
			'@type': 'MenuSection',
			name: group.title,
			hasMenuItem: group.items.map((item) => ({
				'@type': 'MenuItem',
				name: item.name,
				description: item.note,
			})),
		})),
	},
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '15:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El menú', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-cocina-del-hogar-vertical-01.jpg": fachada,
	"la-cocina-del-hogar-vertical-08.jpg": cartel,
	"la-cocina-del-hogar-vertical-06.jpg": migas,
	"la-cocina-del-hogar-apaisada-02.jpg": tortillas,
	"la-cocina-del-hogar-apaisada-07.jpg": croquetas,
	"la-cocina-del-hogar-vertical-03.jpg": tartas,
	"la-cocina-del-hogar-vertical-05.jpg": bizcocho,
	"la-cocina-del-hogar-apaisada-09.jpg": horario,
	"la-cocina-del-hogar-apaisada-04.jpg": tartaHorno,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#3e5c46" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700&family=Figtree:wght@400;600;700&family=Shadows+Into+Light&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Cocina Del Hogar Ciudad Real, comida casera para llevar Ciudad Real, menú del día Ciudad Real, pollo asado Ciudad Real, migas por encargo, comida a domicilio Ciudad Real, calle Morería 19, 13002"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Menú del día con dos platos y postre, pollo asado con patatas, arroces y migas por encargo en la calle Morería, 19, Ciudad Real. De 12:00 a 15:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Los platos de comida casera de La Cocina Del Hogar, en Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#3e5c46"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Cocina"
			subtitle="Del Hogar · Ciudad Real"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultados en noviembre de 2026. Los precios son los del cartel del propio local y pueden cambiar: confírmalos antes de pedir."
			ctaLabel="Llamar a La Cocina Del Hogar"
			navAriaLabel="Enlaces de La Cocina Del Hogar"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34926721660?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Men%C3%BA%20del%20d%C3%ADa%20de%20La%20Cocina%20Del%20Hogar." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Menú del día de La Cocina Del Hogar"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
