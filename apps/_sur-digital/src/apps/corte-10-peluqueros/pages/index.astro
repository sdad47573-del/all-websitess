---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	mapEmbedUrl,
	mapsUrl,
	photoUrl,
	phoneHrefs,
	structuredData,
} from '../lib/business';

const title = 'Peluquería | Corte 10 Peluqueros | Peluquería en Bailén-Miraflores, Málaga';
const description =
	'Corte 10 Peluqueros, peluquería en Calle Ibrahin, 18 (Bailén-Miraflores), Málaga. Corte, peinado, color y tratamientos. Llama al 687 65 19 12 o consulta cómo llegar.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0f1e1c" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/corte-10-peluqueros/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Outfit:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={photoUrl} />
		<meta property="og:image:alt" content="Fotografía de Corte 10 Peluqueros compartida en Google Maps" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={photoUrl} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Corte 10 Peluqueros, inicio"><span class="brand-mark" aria-hidden="true">C10</span><span class="brand-label">CORTE 10 <small>PELUQUEROS · MÁLAGA</small></span></a>
			<nav aria-label="Navegación principal"><a href="#servicios">Servicios</a><a href="#contacto">Contacto</a></nav>
			<a class="header-phone" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> {business.phones[0]}</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-content">
					<p class="eyebrow">PELUQUERÍA · BAILÉN-MIRAFLORES</p>
					<h1 id="hero-title">Peluquería<br /><em>Corte 10</em> Peluqueros</h1>
					<p class="hero-intro">Tu peluquería de barrio en Bailén-Miraflores, Málaga. Corte, peinado, color y tratamientos con un trato cercano y precios de barrio.</p>
					<div class="hero-actions"><a class="button button-jade" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Llamar y pedir cita</a><a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
				</div>
				<figure class="hero-photo">
					<div class="photo-label"><span>C10 / 01</span><span>FOTO DE LA FICHA DE GOOGLE MAPS</span><a href={mapsUrl} target="_blank" rel="noreferrer">VER FICHA ↗</a></div>
					<a href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Ver la foto de Corte 10 Peluqueros y su galería en Google Maps"><img src={photoUrl} alt="Fotografía de Corte 10 Peluqueros publicada en Google Maps" width="1200" height="869" fetchpriority="high" decoding="async" /><span class="photo-open" aria-hidden="true">↗</span></a>
					<span class="photo-stamp" aria-hidden="true">CORTE<br /><i>10</i><br />MÁLAGA</span>
				</figure>
			</section>

			<section class="salon-strip" id="servicios" aria-label="Servicios de Corte 10 Peluqueros">
				<p class="strip-title"><span>01 /</span> LO QUE HACEMOS</p>
				<div><span>01</span><strong>Corte y peinado</strong></div>
				<div><span>02</span><strong>Color y mechas</strong></div>
				<div><span>03</span><strong>Tratamientos</strong></div>
			</section>

			<section class="about-section" aria-labelledby="about-title">
				<p class="section-label"><span>02 /</span> CORTE 10 · BAILÉN-MIRAFLORES</p>
				<div class="about-content"><h2 id="about-title">Peluquería<br /><em>de barrio.</em></h2><div><p>Estamos en Calle Ibrahin, en pleno Bailén-Miraflores, con más de 200 valoraciones en Google. Un salón de peluquería y estilismo para toda la familia: cortes, peinados, color y cuidado del cabello, con atención cercana y sin complicaciones. Pásate o llámanos para reservar tu cita.</p><a class="social-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver opiniones en Google Maps <span aria-hidden="true">↗</span></a></div></div>
				<div class="about-footer"><span>CORTE · COLOR · PEINADO</span><span>29010 MÁLAGA</span><span>✳</span></div>
			</section>

			<section class="contact-section" id="contacto" aria-labelledby="contact-title">
				<p class="section-label"><span>03 /</span> VISÍTANOS</p>
				<div class="contact-layout">
					<div class="contact-copy"><p class="contact-kicker">ESTAMOS EN MIRAFLORES</p><h2 id="contact-title">Ven a<br /><em>Corte 10.</em></h2>
						<div class="contact-card">
							<div class="contact-row"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div></div>
							<div class="contact-row"><span aria-hidden="true">☎</span><div><small>LLÁMANOS</small><a href={phoneHrefs[0]}>{business.phones[0]}</a></div></div>
						</div>
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-card"><div class="map-header"><span><i></i> CALLE IBRAHIN · MÁLAGA</span><a href={mapsUrl} target="_blank" rel="noreferrer">ABRIR MAPS ↗</a></div><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Corte 10 Peluqueros en Calle Ibrahin, Málaga" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div><div class="map-footer"><span aria-hidden="true">⌖</span><div><strong>{business.name}</strong><small>{business.streetAddress} · {business.city}</small></div><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar a Corte 10 Peluqueros">↗</a></div></div>
				</div>
				<div class="social-row"><span>ENCUÉNTRANOS TAMBIÉN EN</span><a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><a href={phoneHrefs[0]}>{business.phones[0]} ↗</a></div>
			</section>
			<Galeria nombre="Peluquería | Corte 10 Peluqueros" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer"><a class="brand footer-brand" href="#inicio" aria-label="Corte 10 Peluqueros, volver al inicio"><span class="brand-mark">C10</span><span class="brand-label">CORTE 10 <small>PELUQUEROS · MÁLAGA</small></span></a><p>{business.streetAddress}, {business.city}<br /><a href={phoneHrefs[0]}>{business.phones[0]}</a></p><a class="footer-social" href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><small>© {new Date().getFullYear()} Corte 10 Peluqueros · Málaga &nbsp;·&nbsp; Foto de portada de la ficha de Google Maps.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
	<a href="/corte-10-peluqueros/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
	<a href="/corte-10-peluqueros/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
	<a href="/corte-10-peluqueros/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
</nav>
</footer>
		<a class="phone-cta" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Llamar a Corte 10 <strong>{business.phones[0]}</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/corte-10-peluqueros/aviso-legal">Aviso legal</a>
					<a href="/corte-10-peluqueros/aviso-legal#privacidad">Privacidad</a>
					<a href="/corte-10-peluqueros/aviso-legal#cookies">Cookies</a>
				</nav>
						<WhatsappFab phone={datos.phoneHrefs[0]} name={datos.business?.name} />
						</body>
</html>


