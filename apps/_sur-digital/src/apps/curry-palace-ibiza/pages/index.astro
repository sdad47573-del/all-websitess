---
import { Image } from 'astro:assets';
import '../styles/global.css';
import fotoFachada from '../assets/fotos/curry-palace-ibiza-apaisada-01.jpg';
import fotoParrillada from '../assets/fotos/curry-palace-ibiza-apaisada-02.jpg';
import fotoInterior from '../assets/fotos/curry-palace-ibiza-apaisada-07.jpg';
import fotoChutneys from '../assets/fotos/curry-palace-ibiza-apaisada-09.jpg';
import fotoTandoori from '../assets/fotos/curry-palace-ibiza-vertical-03.jpg';
import fotoCurrys from '../assets/fotos/curry-palace-ibiza-vertical-04.jpg';
import fotoButterChicken from '../assets/fotos/curry-palace-ibiza-vertical-05.jpg';
import fotoBiryani from '../assets/fotos/curry-palace-ibiza-vertical-08.jpg';
import fotoBiryaniPlato from '../assets/fotos/curry-palace-ibiza-vertical-10.jpg';
import fotoPakoras from '../assets/fotos/curry-palace-ibiza-vista-6-06.jpg';
import {
	business,
	directionsUrl,
	facebookUrl,
	faqSchema,
	faqs,
	googleReviewsUrl,
	hours,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	specialties,
	tripadvisorUrl,
} from '../lib/business';

const title = 'Curry Palace | Cocina india en Cala de Bou, Ibiza';
const description =
	'Curry Palace, restaurante indio en Carrer de Cala de Bou, 13 (Sant Josep). Currys al gusto, naan, arroz basmati y opciones vegetarianas. Tel. 971 80 45 36.';
const keywords =
	'Curry Palace Ibiza, restaurante indio Cala de Bou, curry Sant Josep, comida india Ibiza, naan Ibiza, restaurante vegetariano Cala de Bou, Curry Palace teléfono';

/** Fotografías descargadas de la ficha pública de Google Maps del restaurante. */
const galeria = [
	{
		src: fotoParrillada,
		alt: 'Plato de mixed grill con pollo tandoori, brochetas de carne, ensalada y limón',
		caption: 'Mixed grill',
	},
	{
		src: fotoTandoori,
		alt: 'Fuente de metal con pollo tikka, alitas, seekh kebab y ensalada',
		caption: 'Al tandoor',
	},
	{
		src: fotoButterChicken,
		alt: 'Butter chicken en salsa cremosa con pimiento y cilantro',
		caption: 'Butter chicken',
	},
	{
		src: fotoCurrys,
		alt: 'Tres currys en cuencos de acero con arroz basmati sobre una mesa de mantel estampado',
		caption: 'Tres currys en la mesa',
	},
	{
		src: fotoBiryani,
		alt: 'Biryani de verduras con arroz, zanahoria, guisantes y cilantro',
		caption: 'Biryani de verduras',
	},
	{
		src: fotoBiryaniPlato,
		alt: 'Biryani de verduras servido en plato blanco con rodajas de pepino',
		caption: 'Arroz y especias',
	},
	{
		src: fotoPakoras,
		alt: 'Pakoras de verduras con ensalada, tomate y maíz',
		caption: 'Pakoras',
	},
	{
		src: fotoChutneys,
		alt: 'Tres salsas indias en cuencos de acero con cuchara y ensalada',
		caption: 'Chutneys',
	},
	{
		src: fotoInterior,
		alt: 'Interior de Curry Palace con mesas, sillas y paredes color salmón',
		caption: 'Interior del restaurante',
	},
];

const starMark = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true">
	<path d="M12 2.4c3.9 2.9 6.1 6.1 6.1 9.6 0 4-2.7 7.3-6.1 9.6-3.4-2.3-6.1-5.6-6.1-9.6 0-3.5 2.2-6.7 6.1-9.6Z" />
	<path d="M12 7.2v10.2M8.6 11.9h6.8" />
	<circle cx="12" cy="12" r="9.4" stroke-dasharray="1.5 3.2" />
</svg>`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1b1114" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="Curry Palace" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-IB" />
		<meta name="geo.placename" content="Cala de Bou, Sant Josep de sa Talaia" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/curry-palace-ibiza/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..600&family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@300..800&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Curry Palace" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Fachada iluminada de Curry Palace en Cala de Bou, Ibiza" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.jpg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Curry Palace, inicio">
				<span class="brand-mark" aria-hidden="true" set:html={starMark}></span>
				<span class="brand-copy">
					<strong>Curry Palace</strong>
					<small>Indian cuisine · Cala de Bou</small>
				</span>
			</a>
			<nav class="site-nav" aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">Carta</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
					<path d="M6.6 3.5 9 4.9l-1.3 3.3a13 13 0 0 0 6.1 6.1l3.3-1.3 1.4 2.4c.4.7.2 1.6-.5 2l-1.6.9c-1.8 1-4.2.2-7.2-2.6-3-3-3.9-5.4-2.9-7.2l.9-1.6c.4-.7 1.3-.9 2-.5Z" />
				</svg>
				971 80 45 36
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-bg">
					<Image
						src={fotoFachada}
						alt="Fachada iluminada de Curry Palace en Cala de Bou, con el rótulo Indian Cuisine y la terraza abierta"
						format="webp"
						quality={82}
						widths={[640, 960, 1280, 1600]}
						sizes="100vw"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
				<div class="wrap">
					<div class="hero-content">
						<p class="eyebrow">Cocina india · Cala de Bou</p>
						<h1 id="hero-title">Curry, naan y<br /><em>especias de verdad.</em></h1>
						<p class="hero-intro">
							Cocina india tradicional en Carrer de Cala de Bou, 13. Currys al punto de picante que pidas,
							pan naan recién hecho, arroz basmati y opciones vegetarianas. En el interior o en la terraza.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={phoneHref}>
								Llamar y reservar
								<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M3 13 13 3M6 3h7v7" />
								</svg>
							</a>
							<a class="button button-ghost-light" href="#carta">Ver la carta</a>
							<span class="hero-rating">
								<strong>4,5 ★</strong>
								<a href={googleReviewsUrl} target="_blank" rel="noreferrer">404 reseñas en Google</a>
							</span>
						</div>
					</div>
					<div class="hero-foot">
						<div>
							<small>Nos encontrarás</small>
							<address>Carrer de Cala de Bou, 13<br />07829 Sant Josep de sa Talaia</address>
						</div>
						<div>
							<small>Horario</small>
							<p>13:00 – 23:00<br />Todos los días</p>
						</div>
						<div>
							<small>Reservas</small>
							<p><a href={phoneHref}>{business.phone}</a><br />Terraza e interior</p>
						</div>
					</div>
				</div>
			</section>

			<div class="band" aria-label="Especialidades de Curry Palace">
				<div class="wrap">
					<ul>
						<li>Butter chicken</li>
						<li>Tikka masala</li>
						<li>Chana masala</li>
						<li>Naan al tandoor</li>
					</ul>
				</div>
			</div>

			<section class="section story" id="casa" aria-labelledby="story-title">
				<div class="wrap">
					<div class="story-grid">
						<div>
							<p class="section-label">La casa</p>
							<h2 id="story-title">Una mesa india,<br />sin <em>ceremonias.</em></h2>
						</div>
						<div class="story-copy">
							<p>
								En Carrer de Cala de Bou, 13, Curry Palace lleva la cocina india de todos los días a un
								local sencillo y acogedor: manteles estampados, cuencos de acero y una terraza que se abre a
								la calle.
							</p>
							<p>
								La carta recorre los clásicos: butter chicken, tikka masala, korma, madras, vindaloo y platos
								vegetarianos como el chana masala. El curry se puede pedir más suave o más picante, y el naan
								sale del tandoor para mojar. También hay arroz basmati y opciones para compartir.
							</p>
							<p>
								Según las reseñas, el trato cercano y la posibilidad de adaptar los currys sin gluten forman
								parte de la experiencia. La carta puede cambiar: pregunta al hacer el pedido.
							</p>
							<p class="story-signature">Especias, arroz y pan recién hecho.</p>
							<p class="source-note">
								Datos de la ficha pública de Google Maps, Tripadvisor y Facebook, consultados en octubre de
								2026. La selección de platos es orientativa; no es la carta oficial.
							</p>
						</div>
					</div>
					<div class="facts">
						<div class="fact"><strong>4,5 / 5</strong><span>404 reseñas en Google</span></div>
						<div class="fact"><strong>13 – 23</strong><span>Todos los días de la semana</span></div>
						<div class="fact"><strong>Cala de Bou</strong><span>Sant Josep de sa Talaia</span></div>
					</div>
				</div>
			</section>

			<section class="section menu-section" id="carta" aria-labelledby="menu-title">
				<div class="wrap">
					<div class="menu-head">
						<div>
							<p class="section-label">La carta</p>
							<h2 id="menu-title">Del tandoor<br />a <em>la mesa.</em></h2>
						</div>
						<p>
							Ocho clásicos que aparecen en la carta y en las reseñas del restaurante. Precios, platos del día
							y alérgenos se consultan por teléfono o en el local.
						</p>
					</div>
					<div class="menu-grid">
						{specialties.map((dish, index) => (
							<article class="menu-item">
								<span class="menu-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
								<small>{dish.category}</small>
								<h3>{dish.name}</h3>
								<p>{dish.description}</p>
							</article>
						))}
					</div>
					<div class="spice-note">
						<strong>A tu gusto</strong>
						<span>Pide el curry más suave o más picante al hacer el pedido.</span>
						<strong>Sin gluten</strong>
						<span>Según las reseñas, los currys pueden adaptarse; confírmalo en el local.</span>
					</div>
					<p class="menu-note">
						La carta cambia según la temporada y el mercado. Llama al <a href={phoneHref}>{business.phone}</a>
						para preguntar por el menú del día, las opciones vegetarianas o la disponibilidad de mesa.
					</p>
				</div>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<div class="wrap">
					<div class="gallery-head">
						<div>
							<p class="section-label">La mesa</p>
							<h2 id="gallery-title">Del tandoor<br />al <em>plato.</em></h2>
						</div>
						<p>
							Nueve imágenes de la ficha pública de Curry Palace: la parrilla, los currys, el arroz, los
							chutneys y el interior del restaurante.
						</p>
					</div>
					<div class="gallery-grid">
						{galeria.map((foto, index) => (
							<figure class="gallery-photo">
								<Image
									src={foto.src}
									alt={foto.alt}
									format="webp"
									quality={78}
									widths={index === 3 ? [640, 960, 1200] : [320, 480, 720]}
									sizes={index === 3 ? '(min-width: 861px) 66vw, 50vw' : '(min-width: 861px) 33vw, 50vw'}
									loading="lazy"
								/>
								<figcaption>{foto.caption}</figcaption>
							</figure>
						))}
					</div>
					<div class="gallery-foot">
						<div class="gallery-links">
							<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
							<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
							<a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor ↗</a>
						</div>
						<p class="gallery-note">
							Fotografías alojadas desde la ficha pública del restaurante en Google Maps. Si eres el titular y
							quieres retirar alguna, escríbenos y la quitamos.
						</p>
					</div>
				</div>
			</section>

			<section class="section reviews" aria-labelledby="reviews-title">
				<div class="wrap">
					<div class="reviews-head">
						<div>
							<p class="section-label">Quien ha venido</p>
							<h2 id="reviews-title">La mesa, <em>palabra a palabra.</em></h2>
						</div>
						<div class="reviews-score">
							<strong>4,5</strong>
							<small>
								<span class="stars" aria-hidden="true">★★★★★</span><br />
								404 reseñas en Google<br />
								<a href={googleReviewsUrl} target="_blank" rel="noreferrer">Leerlas en Google ↗</a>
							</small>
						</div>
					</div>
					<div class="review-grid">
						{reviews.map((review) => (
							<article class="review">
								<blockquote>«{review.quote}»</blockquote>
								<footer>
									<span aria-label={`${review.rating} de 5 estrellas`}>{'★'.repeat(review.rating)}</span>
									<a href={googleReviewsUrl} target="_blank" rel="noreferrer">Reseña en Google ↗</a>
								</footer>
							</article>
						))}
					</div>
					<p class="reviews-note">
						Comentarios publicados por clientes en Google. Se reproducen de forma literal o ligeramente
						resumida; la valoración media corresponde a Google en octubre de 2026.
					</p>
				</div>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div class="wrap visit-grid">
					<div>
						<p class="section-label">Visítanos</p>
						<h2 id="visit-title">Te esperamos<br />en <em>Cala de Bou.</em></h2>
						<address>
							<strong>Curry Palace</strong><br />
							Carrer de Cala de Bou, 13<br />
							07829 Sant Josep de sa Talaia · Illes Balears
						</address>
						<ul class="hours" aria-label="Horario de Curry Palace">
							{hours.map((row) => (
								<li><span>{row.day}</span><span>{row.time}</span></li>
							))}
						</ul>
						<div class="contact-lines">
							<span><a href={phoneHref}>{business.phone}</a></span>
							<span>
								<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a> ·
								<a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor</a> ·
								<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps</a>
							</span>
						</div>
						<div class="visit-actions">
							<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">
								Cómo llegar
								<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M3 13 13 3M6 3h7v7" />
								</svg>
							</a>
							<a class="button button-ghost" href={phoneHref}>Llamar para reservar</a>
						</div>
						<p class="visit-note">
							Horario publicado por el restaurante. Algunos directorios separan el servicio de mediodía y el
							de noche: confirma por teléfono antes de venir, sobre todo fuera de temporada.
						</p>
					</div>
					<div class="map-card">
						<iframe
							title="Mapa de Curry Palace en Carrer de Cala de Bou, 13, Sant Josep de sa Talaia"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<div class="map-label">
							<div>
								<strong>Curry Palace</strong><br />
								<small>Carrer de Cala de Bou, 13 · Sant Josep</small>
							</div>
							<a href={mapsUrl} target="_blank" rel="noreferrer">Abrir en Maps ↗</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="section-label">Antes de venir</p>
					<h2 id="faq-title">Preguntas <em>frecuentes.</em></h2>
					<div class="faq-grid">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-top">
					<div class="footer-brand">
						<a class="brand" href="#inicio" aria-label="Curry Palace, volver al inicio">
							<span class="brand-mark" aria-hidden="true" set:html={starMark}></span>
							<span class="brand-copy">
								<strong>Curry Palace</strong>
								<small>Indian cuisine · Cala de Bou</small>
							</span>
						</a>
						<p>
							Cocina india en Cala de Bou: currys, naan recién hecho, arroz basmati y opciones vegetarianas en
							Carrer de Cala de Bou, 13.
						</p>
					</div>
					<div class="footer-col">
						<h2>Explorar</h2>
						<ul>
							<li><a href="#casa">La casa</a></li>
							<li><a href="#carta">Carta</a></li>
							<li><a href="#fotos">Fotos</a></li>
							<li><a href="#preguntas">Preguntas frecuentes</a></li>
						</ul>
					</div>
					<div class="footer-col">
						<h2>Contacto</h2>
						<ul>
							<li><address>Carrer de Cala de Bou, 13<br />07829 Sant Josep de sa Talaia</address></li>
							<li><a href={phoneHref}>{business.phone}</a></li>
							<li><a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a></li>
							<li><a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor</a></li>
							<li><a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps</a></li>
						</ul>
					</div>
				</div>
				<div class="footer-bottom">
					<small class="copyright">
						© {new Date().getFullYear()} Curry Palace · Cala de Bou. Horarios y carta orientativos; confirma con
						el restaurante.
					</small>
					<nav class="legal-links" aria-label="Información legal">
						<a href="/curry-palace-ibiza/aviso-legal">Aviso legal</a>
						<a href="/curry-palace-ibiza/aviso-legal#privacidad">Privacidad</a>
						<a href="/curry-palace-ibiza/aviso-legal#cookies">Cookies</a>
					</nav>
					<small class="credit">
						Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
						sur-digital.vercel.app
					</small>
				</div>
			</div>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar y reservar <span>{business.phone}</span></a>
	</body>
</html>
