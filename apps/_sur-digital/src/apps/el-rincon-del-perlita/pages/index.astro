---
import WhatsappFab from '../components/WhatsappFab.astro';
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/el-rincon-del-perlita-apaisada-04.jpg';
import fotoTerraza from '../assets/fotos/el-rincon-del-perlita-vertical-09.jpg';
import fotoBarra from '../assets/fotos/el-rincon-del-perlita-apaisada-01.jpg';
import fotoPatatas from '../assets/fotos/el-rincon-del-perlita-apaisada-02.jpg';
import fotoCervezas from '../assets/fotos/el-rincon-del-perlita-vertical-10.jpg';
import fotoHamburguesa from '../assets/fotos/el-rincon-del-perlita-apaisada-05.jpg';
import fotoTabla from '../assets/fotos/el-rincon-del-perlita-apaisada-03.jpg';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

const business = {
	name: 'El Rincón del Perlita',
	tagline: 'Bar · Terraza · +150 cervezas en Cartagena',
	street: 'Calle Honda, 29 (esq. Plaza San Francisco)',
	district: 'Casco Antiguo',
	city: 'Cartagena',
	region: 'Región de Murcia',
	postalCode: '30201',
	phone: '868 09 03 22',
	latitude: 37.6019041,
	longitude: -0.9847265,
	site: 'https://www.sur-digital.com/el-rincon-del-perlita',
};

const mapsUrl = `https://www.google.com/maps/place/EL+RINC%C3%93N+DEL+PERLITA/@${business.latitude},${business.longitude},17z/data=!3m1!4b1!4m6!3m5!1s0xd63432da5b1cd77:0xc348caa2cf7f9fa7!8m2!3d${business.latitude}!4d${business.longitude}!16s%2Fg%2F11gy01s4bt`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34868090322';
const facebookUrl = 'https://www.facebook.com/p/El-Rinc%C3%B3n-del-Perlita-100063333604280/';

const description =
	'El Rincón del Perlita, bar con terraza en Calle Honda 29, Cartagena: patatas Despeinás, croquetas, hamburguesas, tapas y más de 150 cervezas. Abierto todos los días de 9:00 a 1:00. Tel. 868 09 03 22.';

const servicios = [
	'Terraza amplia',
	'+150 cervezas',
	'Tapas y raciones',
	'Patatas Despeinás',
	'Hamburguesas',
	'Desayunos',
	'Comida para llevar',
	'Acceso movilidad reducida',
	'Abierto todos los días',
];

const platos = [
	{ name: 'Patatas Despeinás', note: 'el plato más alabado por los clientes habituales' },
	{ name: 'Croquetas de jamón y boletus', note: 'cremosas y muy bien valoradas' },
	{ name: 'Hamburguesas generosas', note: 'incluye Beyond burger y boletus con trufa' },
	{ name: 'Marinera', note: 'la tapa típica de la zona, no puede faltar' },
	{ name: 'Huevos rotos', note: 'ración abundante para compartir' },
	{ name: 'Tosta de salmón con queso de cabra', note: 'con cebolla caramelizada' },
	{ name: 'Pulpo', note: 'uno de los platos citados en reseñas favorables' },
	{ name: 'Michirones', note: 'clásico cartagenero de cuchara' },
	{ name: 'Tequeños venezolanos', note: 'guiño latino de la carta' },
	{ name: 'Muerte por chocolate y tarta de la abuela', note: 'postres caseros para cerrar' },
];

const fotos = [
	{ src: fotoTerraza, alt: 'Terraza con sombrillas de El Rincón del Perlita, en Plaza San Francisco' },
	{ src: fotoPatatas, alt: 'Patatas Despeinás de El Rincón del Perlita' },
	{ src: fotoCervezas, alt: 'Neveras con más de 150 cervezas en El Rincón del Perlita' },
	{ src: fotoHamburguesa, alt: 'Hamburguesa casera con patatas de El Rincón del Perlita' },
	{ src: fotoTabla, alt: 'Tabla de embutidos y quesos en la terraza de El Rincón del Perlita' },
	{ src: fotoBarra, alt: 'Barra alta y terraza de El Rincón del Perlita en Calle Honda 29' },
];

const faqs = [
	{
		q: '¿Dónde está El Rincón del Perlita?',
		a: 'En Calle Honda 29, esquina con Plaza San Francisco, en el casco antiguo de Cartagena (30201, Murcia). Es un bar con terraza amplia, sin comedor interior: toda la experiencia es al aire libre, en una de las zonas más animadas del centro.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Abre todos los días desde las 9:00: desayunos, tapas, comidas y cenas. De domingo a jueves cierra a la 1:00 y viernes y sábados a la 1:30. Conviene confirmar en festivos llamando al 868 09 03 22.',
	},
	{
		q: '¿Qué se come en El Rincón del Perlita?',
		a: 'Carta variada de bar: tapas, raciones, hamburguesas, montaditos, platos mediterráneos y guiños latinos. Lo más citado: patatas Despeinás, croquetas de jamón y boletus, hamburguesas, marinera, huevos rotos, tosta de salmón con queso de cabra, pulpo, michirones y tequeños. De postre: muerte por chocolate y tarta de la abuela.',
	},
	{
		q: '¿Es verdad que tienen más de 150 cervezas?',
		a: 'Sí, presume de una de las cartas cerveceras más amplias del centro de Cartagena, con artesanas y de importación de varios estilos. Si buscas recomendación concreta, pregunta al personal qué tienen de grifo ese día.',
	},
	{
		q: '¿Cuánto cuesta comer allí?',
		a: 'Relación calidad-precio muy competitiva: raciones abundantes y precios económicos o moderados. Muchos grupos de cuatro comen o cenan por unos 50 euros con bebida. Las cervezas especiales de alta graduación pueden tener suplemento.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'No es imprescindible, pero la terraza se llena en fines de semana. Para grupos, llama al 868 09 03 22. También ofrecen comida para llevar.',
	},
	{
		q: '¿Tiene acceso para movilidad reducida?',
		a: 'Sí, dispone de acceso para personas con movilidad reducida al ser terraza a pie de calle. Si vas en silla de ruedas y necesitas mesa concreta, avisa por teléfono.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'BarOrPub',
	'@id': `${business.site}/#bar`,
	name: business.name,
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 868 09 03 22',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Tapas', 'Mediterránea', 'Española', 'Latina', 'Hamburguesas'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Calle Honda, 29',
		addressLocality: business.city,
		addressRegion: 'Murcia',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: { '@type': 'GeoCoordinates', latitude: business.latitude, longitude: business.longitude },
	hasMap: mapsUrl,
	sameAs: [facebookUrl, mapsUrl],
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'], opens: '09:00', closes: '25:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday', 'Saturday'], opens: '09:00', closes: '25:30' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza al aire libre', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Comida para llevar', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso movilidad reducida', value: true },
	],
	aggregateRating: { '@type': 'AggregateRating', ratingValue: 4.1, reviewCount: 1200, bestRating: 5 },
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Qué pedir', href: '#carta' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>El Rincón del Perlita | Terraza y +150 cervezas en Cartagena</title>
		<meta name="theme-color" content="#221105" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Rincón del Perlita, bar Cartagena, terraza Calle Honda, Plaza San Francisco comer, patatas Despeinás, cervezas Cartagena, tapas Cartagena centro, hamburguesas Cartagena, marinera, michirones"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="El Rincón del Perlita · Bar con terraza en Cartagena"
			ogDescription="Patatas Despeinás, croquetas, hamburguesas y +150 cervezas en Calle Honda 29, Cartagena. Terraza amplia todos los días de 9:00 a 1:00."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="El Rincón del Perlita, bar con terraza en Calle Honda 29, Cartagena"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#221105"
			street={business.street}
			city={business.city}
			region="Murcia"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Casco Antiguo, Cartagena"
			preload={[]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Cartagena" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<style>
			.hero-custom { display:grid; grid-template-columns: 1.05fr 0.95fr; gap:2.5rem; align-items:center; padding:4.5rem 0 2.5rem; }
			.hero-custom h1 { font-size: clamp(2.6rem, 5.4vw, 4.4rem); line-height:1.02; margin:0.6rem 0 1rem; }
			.hero-custom h1 em { color: var(--amber); font-style:normal; }
			.hero-custom img { width:100%; height:auto; border-radius: var(--radius); border:1px solid var(--line); }
			.fotos-grid { display:grid; grid-template-columns: repeat(3, 1fr); gap:1rem; margin-top:1.6rem; }
			.fotos-grid figure { margin:0; border:1px solid var(--line); border-radius:14px; overflow:hidden; background:var(--deep-2); }
			.fotos-grid img { width:100%; height:220px; object-fit:cover; display:block; }
			.fotos-grid figcaption { padding:0.6rem 0.8rem; font-size:0.85rem; color:var(--muted); }
			@media (max-width: 980px){ .hero-custom{grid-template-columns:1fr; padding-top:3rem;} .fotos-grid{grid-template-columns:1fr 1fr;} }
			@media (max-width: 640px){ .fotos-grid{grid-template-columns:1fr;} .fotos-grid img{height:200px;} }
		</style>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="P"
			name={business.name}
			subtitle="Terraza · Cartagena centro"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<section class="hero-custom wrap" id="inicio" aria-labelledby="hero-title">
				<div>
					<p class="eyebrow"><span aria-hidden="true"></span> Casco Antiguo · Cartagena</p>
					<h1 id="hero-title">Terraza, tapas<br />y <em>+150 cervezas.</em></h1>
					<p class="hero-lede">Bar de barrio en Calle Honda 29, esquina con Plaza San Francisco. Patatas Despeinás, croquetas, hamburguesas generosas y marinera, con una de las cartas de cerveza más amplias del centro. Abierto todos los días desde las 9:00.</p>
					<div class="hero-actions">
						<a class="button button-primary" href={phoneHref}>Llamar 868 09 03 22</a>
						<a class="button button-ghost" href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>Terraza amplia</b> en Plaza San Francisco</li>
						<li><b>9:00 – 1:00</b> · vie/sáb hasta 1:30</li>
						<li><b>€€</b> · raciones abundantes</li>
						<li><b>Para llevar</b> disponible</li>
					</ul>
				</div>
				<figure style="margin:0">
					<Image
						src={fotoHero}
						alt="Terraza de El Rincón del Perlita en Calle Honda 29, Cartagena"
						widths={[600, 1000]}
						sizes="(min-width: 980px) 46vw, 92vw"
						quality={80}
						loading="eager"
						fetchpriority="high"
					/>
					<figcaption style="color:var(--muted);font-size:0.85rem;margin-top:0.5rem">Terraza en Calle Honda 29 · <a href={mapsUrl} target="_blank" rel="noreferrer">Ver galería en Google Maps ↗</a></figcaption>
				</figure>
			</section>

			<LocalChips label="Servicios de El Rincón del Perlita" items={servicios} />

			<LocalAbout
				label="Un bar de terraza en el centro"
				title="De barrio,<br />de cañas<br /><em>y de raciones grandes.</em>"
				paragraphs={[
					'El Rincón del Perlita está en Calle Honda 29, esquina con Plaza San Francisco, en pleno casco antiguo de Cartagena. No tiene comedor interior: todo pasa en su terraza amplia, animada a mediodía y por la noche.',
					'Aquí se viene a por patatas Despeinás —el plato más famoso—, croquetas de jamón y boletus, hamburguesas generosas, marinera, huevos rotos, michirones y tequeños. Y de postre, muerte por chocolate o tarta de la abuela.',
					'Para beber, su seña de identidad: más de 150 cervezas entre artesanas y de importación. Precios económicos, raciones abundantes y ambiente desenfadado de grupo y familias.',
				]}
				note="Nota media agregada en torno al 4,1 sobre más de mil reseñas públicas. El servicio puede ir justo cuando la terraza está llena: para grupos, mejor llamar antes."
				links={[
					{ label: 'Facebook del bar', href: facebookUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
					{ label: 'Ficha en Google Maps', href: mapsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="Lo más pedido"
				title="Qué pedir<br /><em>en El Perlita.</em>"
				description="Selección a partir de los platos que más se repiten en reseñas públicas. La carta es amplia y cambia: pregunta por lo del día y por las cervezas de grifo."
				cta={{ label: 'Consultar por teléfono', href: phoneHref }}
				groups={[{ title: 'La carta', items: platos }]}
				note="Raciones abundantes: si vais en grupo, pedid al centro y ampliad. Preguntad por suplementos en cervezas especiales."
			/>

			<section class="section-pad wrap" id="fotos" aria-labelledby="fotos-title">
				<p class="eyebrow"><span aria-hidden="true"></span> Fotos</p>
				<h2 id="fotos-title">El bar, <em style="color:var(--amber);font-style:normal">en imágenes.</em></h2>
				<div class="fotos-grid">
					{fotos.map((f) => (
						<figure>
							<Image
								src={f.src}
								alt={f.alt}
								widths={[400, 700]}
								sizes="(min-width: 980px) 30vw, (min-width: 640px) 46vw, 92vw"
								quality={75}
								loading="lazy"
								decoding="async"
							/>
							<figcaption>{f.alt}</figcaption>
						</figure>
					))}
				</div>
				<p style="margin-top:1rem"><a class="button button-ghost" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos reales en Google Maps ↗</a></p>
			</section>

			<LocalVisit
				eyebrow="Calle Honda 29 · 30201 Cartagena"
				title="Nos vemos<br /><em>en la plaza.</em>"
				addressLines={[
					'Calle Honda, 29 (esq. Plaza San Francisco)',
					'Casco Antiguo',
					'30201 Cartagena (Murcia), España',
				]}
				hours={[
					{ day: 'Lunes', value: '9:00 – 1:00' },
					{ day: 'Martes', value: '9:00 – 1:00' },
					{ day: 'Miércoles', value: '9:00 – 1:00' },
					{ day: 'Jueves', value: '9:00 – 1:00' },
					{ day: 'Viernes', value: '9:00 – 1:30' },
					{ day: 'Sábado', value: '9:00 – 1:30' },
					{ day: 'Domingo', value: '9:00 – 1:00' },
				]}
				hoursNote="Horario orientativo según fuentes públicas (Turismo Región de Murcia y reseñas). Confirma por teléfono en festivos."
				mapTitle="Mapa de El Rincón del Perlita en Calle Honda 29, Cartagena"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="El Rincón del Perlita · Cartagena"
				mapHref={mapsUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Facebook', href: facebookUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Grupos y terraza llena en fin de semana: llama al 868 09 03 22. Comida para llevar disponible."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="P"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Cómo llegar ↗', href: directionsUrl, external: true },
				{ label: 'Facebook ↗', href: facebookUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías del establecimiento. Información elaborada a partir de fuentes públicas; confirma horarios y precios antes de la visita."
			ctaLabel="Llamar a El Rincón del Perlita"
		/>
		<WhatsappFab phone={phoneHref} name={business.name} />
	</body>
</html>
