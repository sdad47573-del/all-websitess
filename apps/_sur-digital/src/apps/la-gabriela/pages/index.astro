---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	credito,
	descripcionTitular,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	platos,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'La Gabriela · Restaurante en Jerez de la Frontera';
const description =
	'La Gabriela, restaurante andaluz en la plaza Plateros, 3 de Jerez de la Frontera: cocina tradicional con productos de km 0. 4 sobre 5 con 1.733 reseñas.';
const keywords =
	'La Gabriela Jerez, La Gabriela Plaza Plateros, restaurante Jerez de la Frontera, cocina andaluza Jerez, tapas Jerez centro, restaurante Plaza Plateros';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas diez fotografías y el manifiesto de la descarga no
 * atribuye autor, así que no se inventa una descripción ni una atribución: los `alt` avisan solo
 * de dónde salen.
 */
const altFoto =
	'Fotografía publicada en la ficha de Google Maps de La Gabriela, en Jerez de la Frontera';
const altOg = 'Fotografía de La Gabriela publicada en su ficha de Google Maps';

/** Galería completa: las diez fotografías de la ficha, en el orden en que se descargaron. */
const galeria = [
	'la-gabriela-vertical-02.jpg',
	'la-gabriela-apaisada-01.jpg',
	'la-gabriela-apaisada-03.jpg',
	'la-gabriela-vertical-05.jpg',
	'la-gabriela-vertical-06.jpg',
	'la-gabriela-apaisada-04.jpg',
	'la-gabriela-apaisada-07.jpg',
	'la-gabriela-vertical-08.jpg',
	'la-gabriela-vertical-09.jpg',
	'la-gabriela-vertical-10.jpg',
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#241f1a" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CA" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/la-gabriela/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">
					LG
				</span>
				<span class="brand-text">
					La Gabriela
					<small>Plaza Plateros · Jerez</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#plaza">La plaza</a>
				<a href="#mesa">La mesa</a>
				<a href="#fotos">Fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="hero-eyebrow">Plaza Plateros, 3 · Jerez de la Frontera</p>
						<h1 id="hero-title">
							La Gabriela
							<span>cocina tradicional en la plaza.</span>
						</h1>
						<p class="hero-lede">
							Restaurante andaluz, mediterráneo y de tapas en la plaza Plateros, en el centro de
							Jerez. El titular habla de cocina tradicional con productos de km 0, y Google le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas. Abre todos los días{' '}
							<strong>desde las 12:00</strong>.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>
								Llamar al {business.phone}
							</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>Desde las 12:00, todos los días</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 ·{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas
								</strong>
							</li>
							<li>
								<small>Teléfono</small>
								<strong>{business.phone}</strong>
							</li>
						</ul>
					</div>

					<figure class="hero-figure">
						<Image
							src={foto('la-gabriela-vertical-02.jpg')}
							alt={altFoto}
							widths={[420, 640, 900]}
							sizes="(max-width: 1080px) 82vw, 40vw"
							format="avif"
							quality={70}
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>
						<figcaption>Fotografía de la ficha de Google Maps · {site.consultado}</figcaption>
						<p class="hero-plaque">
							<strong>{business.rating.toLocaleString('es-ES')}</strong>
							<span>{business.reviewCount.toLocaleString('es-ES')} reseñas</span>
						</p>
					</figure>
				</div>
			</section>

			<div class="cenefa" aria-hidden="true"></div>

			<div class="band">
				<span>{business.streetAddress}</span>
				<span>Todos los días desde las 12:00</span>
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
					{business.reviewCount.toLocaleString('es-ES')} reseñas
				</span>
			</div>

			<section class="section" id="plaza" aria-labelledby="plaza-title">
				<div class="wrap plaza-grid">
					<div class="plaza-text">
						<p class="kicker">La plaza</p>
						<h2 class="title" id="plaza-title">
							Un lugar de encuentro
							<em> en Plateros.</em>
						</h2>
						<blockquote class="titular">
							<p>{descripcionTitular}</p>
							<footer>Descripción del titular en la ficha de Google Maps</footer>
						</blockquote>
						<p class="titular-note">
							Está transcrita tal cual, con la raya inicial y las comillas del original: es la
							descripción completa que publica el restaurante en Google.
						</p>
					</div>
					<div>
						<ul class="chips" aria-label="Categorías que publica la ficha">
							{business.categories.map((categoria) => (
								<li>{categoria}</li>
							))}
						</ul>
						<div class="km0">
							<strong>Cocina de km 0</strong>
							<p>
								Es lo que anuncia el titular en su descripción: cocina tradicional con productos de
								km 0. La ficha no detalla qué productos ni de qué proveedores.
							</p>
						</div>
						<ul class="datos">
							<li>
								<span>Dirección</span>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<span>Horario</span>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<span>Teléfono</span>
								<strong>{business.phone}</strong>
							</li>
							<li>
								<span>Plus code</span>
								<strong>{business.plusCode}</strong>
							</li>
							<li>
								<span>Consultada</span>
								<strong>{site.consultado}</strong>
							</li>
						</ul>
					</div>
				</div>
			</section>

			<section class="section mesa" id="mesa" aria-labelledby="mesa-title">
				<div class="wrap">
					<p class="kicker">La mesa</p>
					<h2 class="title" id="mesa-title">
						Tres platos
						<em> que se nombran.</em>
					</h2>
					<p class="lead">
						La ficha no publica carta ni precios. Lo único que nombra platos son las reseñas
						destacadas; estos tres salen de una de ellas, la que habla del arroz a la flamenca, las
						albóndigas de secreto y el solomillo.
					</p>
					<div class="platos">
						{platos.map((plato) => (
							<article class="plato">
								<small>En las reseñas</small>
								<h3>{plato.nombre}</h3>
								<p>{plato.nota}</p>
							</article>
						))}
					</div>
					<p class="mesa-note">
						Son menciones de clientes, no una carta oficial. Para saber qué hay hoy y cuánto cuesta,
						lo más rápido es <a href={phoneHref}>llamar al {business.phone}</a>.
					</p>
				</div>
			</section>

			<section class="section" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						Diez fotos
						<em> de la ficha.</em>
					</h2>
					<p class="lead">
						Las diez fotografías que La Gabriela publica en su ficha de Google Maps. La ficha no las
						describe y el manifiesto de la descarga no atribuye autor, así que se muestran sin pie
						inventado.
					</p>
					<div
						class="tira"
						role="region"
						aria-label="Galería de diez fotos de la ficha"
						tabindex="0"
					>
						{galeria.map((name, index) => (
							<figure class="tira-item">
								<Image
									src={foto(name)}
									alt={altFoto}
									widths={[300, 460, 640]}
									sizes="(max-width: 760px) 72vw, 34vw"
									format="avif"
									quality={66}
									loading="lazy"
									decoding="async"
								/>
								<span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
							</figure>
						))}
					</div>
					<p class="tira-hint">Desliza para ver las diez →</p>
					<p class="galeria-note">
						Fotos de la ficha consultada el {site.consultado}. Si eres el titular y prefieres que no
						aparezcan, se retiran: el teléfono de contacto es el{' '}
						<a href={phoneHref}>{business.phone}</a>.
					</p>
				</div>
			</section>

			<section class="section horario" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y llegada</p>
						<h2 class="title" id="horario-title">
							Plaza Plateros, 3,
							<em> Jerez.</em>
						</h2>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr
										class:list={[
											{ 'fin-de-semana': item.day === 'Viernes' || item.day === 'Sábado' },
										]}
									>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							Abre todos los días desde las 12:00. De domingo a jueves cierra a las 23:00 y los
							viernes y sábados, a las 24:00. Es el horario consultado el {site.consultado};
							conviene confirmarlo por teléfono antes de ir, sobre todo en festivos.
						</p>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<p class="access-title">Accesibilidad publicada en la ficha</p>
						<ul class="access-list">
							{accesibilidad.map((item) => (
								<li class:list={[{ 'is-no': !item.disponible }]}>{item.label}</li>
							))}
						</ul>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="resenas" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<div class="resenas-head">
						<div>
							<p class="kicker">Lo que dicen</p>
							<h2 class="title" id="resenas-title">
								Tres reseñas
								<em> destacadas.</em>
							</h2>
						</div>
						<div class="score">
							<strong>{business.rating.toLocaleString('es-ES')}</strong>
							<span>
								sobre 5 · {business.reviewCount.toLocaleString('es-ES')} reseñas
								<br />
								<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
									Ver todas ↗
								</a>
							</span>
						</div>
					</div>
					<div class="quote-grid">
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									{review.rating} sobre 5<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de
						<em> venir.</em>
					</h2>
					<p class="lead">
						{business.reviewCount.toLocaleString('es-ES')} reseñas, tres destacadas y cuatro datos
						de accesibilidad: todo lo que publica la ficha, resumido sin añadir nada.
					</p>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">
						LG
					</span>
					<span>
						La Gabriela
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del restaurante">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} La Gabriela · Plaza Plateros, 3 (11403 Jerez de la Frontera).
					Web informativa elaborada con los datos y las fotografías que el restaurante publica en su
					ficha de Google Maps, consultada el {site.consultado}. Confirma horario y disponibilidad
					por teléfono antes de salir.
					<span class="credit">
						Web creada por{' '}
						<a href={credito.url} rel="noopener">
							{credito.nombre}
						</a>
					</span>
				</small>
			</div>

			<a class="mobile-call" href={phoneHref}>
				Llamar a La Gabriela <span>{business.phone}</span>
			</a>

			<nav class="legal-links" aria-label="Información legal">
				<a href="/la-gabriela/aviso-legal">Aviso legal</a>
				<a href="/la-gabriela/aviso-legal#privacidad">Privacidad</a>
				<a href="/la-gabriela/aviso-legal#cookies">Cookies</a>
			</nav>
		</footer>
	</body>
</html>
