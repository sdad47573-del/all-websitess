---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	avisoFestivo,
	business,
	directionsUrl,
	distintivo,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Gastro Molí · Restaurante en Finestrat';
const description =
	'Gastro Molí, restaurante en la Av. de Benidorm, 13 de Finestrat. 4,4 sobre 5 con 525 reseñas; abre sábado, domingo y lunes y cierra de martes a viernes.';
const keywords =
	'Gastro Molí, Gastro Molí Finestrat, restaurante Finestrat, restaurante Av. de Benidorm Finestrat, Gastro Molí teléfono, Gastro Molí horario';

/**
 * Texto alternativo y pie de las fotos.
 *
 * La ficha no describe el contenido de estas fotografías, así que no se inventa una descripción: el
 * `alt` avisa solo de dónde salen y el pie cita a quien las publica, que en esta ficha es el propio
 * local (el manifiesto de la descarga trae «Gastro Molí» como autor de las diez).
 */
const altFoto = 'Fotografía publicada por Gastro Molí en su ficha de Google Maps, en Finestrat';
const pieFoto = 'Foto de Gastro Molí';
const altOg = 'Fotografía de Gastro Molí publicada en su ficha de Google Maps';

/**
 * Galería: las diez fotografías de la ficha.
 *
 * Aquí no hay duplicados (los diez ficheros tienen MD5 distinto), así que se publican las diez.
 */
const galeria = [
	'gastro-moli-vertical-01.jpg',
	'gastro-moli-vertical-02.jpg',
	'gastro-moli-vertical-03.jpg',
	'gastro-moli-vertical-04.jpg',
	'gastro-moli-apaisada-05.jpg',
	'gastro-moli-vertical-06.jpg',
	'gastro-moli-vertical-07.jpg',
	'gastro-moli-vertical-08.jpg',
	'gastro-moli-apaisada-09.jpg',
	'gastro-moli-apaisada-10.jpg',
];

/**
 * Tres fotos de avance en el collage de la portada (también están en la galería).
 *
 * Arriba va la apaisada **09**, que es la única de la ficha que viene en 16/9 (4624 × 2604), así que
 * no hay que recortarla; abajo van las verticales **01** y **04**, que encajan en la proporción 4/5
 * del repositorio.
 */
const collage = [
	{ name: 'gastro-moli-apaisada-09.jpg', clase: 'collage-item collage-item-a' },
	{ name: 'gastro-moli-vertical-01.jpg', clase: 'collage-item collage-item-b' },
	{ name: 'gastro-moli-vertical-04.jpg', clase: 'collage-item collage-item-c' },
];

/** Reseñas que destaca la ficha, contadas para que el texto no se desincronice si la ficha cambia. */
const numeroResenas = reviews.length;

/** Número de fotografías de la galería. */
const numeroFotos = galeria.length;

/** Días que la ficha marca como cerrados. */
const diasCerrados = hours.filter((item) => item.shifts.length === 0).length;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#2b2320" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-A" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/gastro-moli/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">GM</span>
				<span class="brand-text">
					Gastro Molí
					<small>Av. de Benidorm · Finestrat</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#local">La casa</a>
				<a href="#fotos">Las fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Finestrat · Av. de Benidorm, 13</p>
						<h1 id="hero-title">
							Gastro Molí,
							<br />
							<em>de sábado a lunes.</em>
						</h1>
						<p class="hero-lede">
							Está en la Av. de Benidorm, 13, con código postal 03509, en Finestrat
							(Alicante). Google solo publica la categoría «{business.category}», sin
							cocina declarada, y la ficha no publica descripción del titular. Le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas y sirve tres días:
							cierra de martes a viernes.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>Llamar al {business.phone}</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas
								</strong>
							</li>
						</ul>
					</div>

					<div class="hero-collage">
						{collage.map((item, index) => (
							<figure class={item.clase}>
								<Image
									src={foto(item.name)}
									alt={altFoto}
									widths={index === 0 ? [640, 900, 1200] : [320, 480, 640]}
									sizes={
										index === 0
											? '(max-width: 1080px) 92vw, 46vw'
											: '(max-width: 1080px) 45vw, 23vw'
									}
									format="webp"
									quality={68}
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : undefined}
									decoding="async"
								/>
							</figure>
						))}
					</div>
				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
					{business.reviewCount.toLocaleString('es-ES')} reseñas
				</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>{hoursSummary}</span>
				<span>{distintivo}</span>
				<span>Teléfono {business.phone}</span>
			</div>

			<section class="section" id="local" aria-labelledby="local-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">La casa</p>
						<h2 class="title" id="local-title">
							Paella, brasa
							<br />
							<em>y tres días de mesa.</em>
						</h2>
						<p>
							Google solo publica una categoría, «{business.category}», sin cocina
							declarada, y la ficha tampoco publica descripción del titular. Le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas. Está en la Av.
							de Benidorm, 13, con código postal 03509, y la ficha publica su plus code
							HQ9Q+PX Finestrat.
						</p>
						<p>
							Lo único que se sabe de la comida es lo que cuentan las{' '}
							<strong>tres reseñas que destaca Google</strong>: una «paella con un
							arroz suculento y bien surtida de marisco», un atún a la brasa con salsa,
							y una mesa en la que pidieron pulpo, croquetas, ensalada de ventresca y
							arroz a banda. Esta última es la <strong>única reseña crítica</strong> de
							las tres (1 sobre 5) y se cita aquí tal cual, sin recortar su texto.
						</p>
						<p>
							El horario está muy recortado: abre <strong>sábado, domingo y lunes</strong> y{' '}
							<strong>cierra de martes a viernes</strong>. Cada día abierto tiene además su
							propio tramo: el sábado hasta las 23:00, el domingo hasta las 18:00 y el lunes
							hasta las 19:00.
						</p>
						<p>
							La ficha <strong>no publica carta ni precios</strong>, así que aquí no se
							reproduce ninguno. Sí publica tres servicios de accesibilidad, los tres
							disponibles (acceso, aseo y asientos adaptados), y el distintivo «
							{distintivo}» junto al nombre. Esta web se ha preparado solo con lo que
							publica esa ficha, consultada el {site.consultado}: nombre, dirección,
							teléfono, categoría, horario, valoración, accesibilidad, el distintivo,
							las {numeroResenas} reseñas que destaca y sus propias fotografías.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>{business.reviewCount.toLocaleString('es-ES')} reseñas en Google Maps</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver todas ↗</a>
						</div>
						{reviews.map((review) => (
							<blockquote class:list={['quote', { 'is-low': review.rating < 3 }]}>
								<p>{review.text}</p>
								<footer>
									<strong>{review.rating} sobre 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section cocina" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						La casa <em>por dentro.</em>
					</h2>
					<p class="lead">
						Son las {numeroFotos} fotografías que Gastro Molí publica en su ficha de
						Google Maps. La ficha las atribuye al propio local, así que cada una lleva su
						pie. No las describe, y aquí no se inventa ninguna descripción.
					</p>
					<div class="cocina-grid">
						{galeria.map((name) => (
							<figure class="cocina-item">
								<Image
									src={foto(name)}
									alt={altFoto}
									widths={[380, 560, 800]}
									sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
									format="webp"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>{pieFoto}</figcaption>
							</figure>
						))}
					</div>
					<p class="cocina-note">
						La ficha no publica la carta ni los precios, así que esta web no los reproduce.
						Para saber qué hay hoy y si el local está abierto, lo más rápido es{' '}
						<a href={phoneHref}>llamar al {business.phone}</a> o mirar las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos y reseñas de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Av. de Benidorm, 13,
							<br />
							<em>03509 Finestrat.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr class:list={[{ 'is-closed': item.shifts.length === 0 }]}>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							El local <strong>abre sábado, domingo y lunes</strong> y{' '}
							<strong>cierra de martes a viernes</strong>: {diasCerrados} de los siete
							días de la semana aparecen como «Cerrado» en la ficha. Los tres días
							abiertos tienen tramos distintos (sábado 10:00–23:00, domingo 10:00–18:00 y
							lunes 9:30–19:00). Es el horario que publica la ficha consultada el{' '}
							{site.consultado}, y la propia ficha marca el lunes con el aviso «
							{avisoFestivo}», es decir, que ese tramo del 12 de octubre es el horario
							de festivo. Conviene confirmar el horario antes de ir.
						</p>
						<ul class="access-list">
							{accesibilidad.map((item) => (
								<li class:list={[{ 'is-no': !item.disponible }]}>{item.label}</li>
							))}
						</ul>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>llamar.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">GM</span>
					<span>
						Gastro Molí
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Gastro Molí · Av. de Benidorm, 13 (03509 Finestrat). Web
					informativa elaborada con los datos y las fotografías que el local publica en su ficha
					de Google Maps, consultada el {site.consultado}. Confirma horario y disponibilidad por
					teléfono antes de salir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/gastro-moli/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/gastro-moli/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/gastro-moli/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a Gastro Molí <span>{business.phone}</span>
		</a>

	</body>
</html>
