---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import arroz from '../assets/fotos/restaurante-neocantina-apaisada-01.jpg';
import churros from '../assets/fotos/restaurante-neocantina-apaisada-02.jpg';
import morcilla from '../assets/fotos/restaurante-neocantina-apaisada-03.jpg';
import migas from '../assets/fotos/restaurante-neocantina-apaisada-04.jpg';
import entrecot from '../assets/fotos/restaurante-neocantina-apaisada-05.jpg';
import calabacin from '../assets/fotos/restaurante-neocantina-apaisada-06.jpg';
import hojaldre from '../assets/fotos/restaurante-neocantina-vertical-07.jpg';
import croqueta from '../assets/fotos/restaurante-neocantina-apaisada-08.jpg';
import hamburguesa from '../assets/fotos/restaurante-neocantina-vertical-09.jpg';
import godello from '../assets/fotos/restaurante-neocantina-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	SERVICIOS,
} from '../data/site';

const title = 'Restaurante Neocantina · Cocina manchega en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: arroz,
		alt: 'Arroz con sardinas abiertas en sartén de hierro, recién sacado del fuego',
	},
	{
		src: migas,
		alt: 'Migas manchegas con huevo frito en la sartén, con pan y mantel de cuadros',
	},
	{
		src: morcilla,
		alt: 'Morcilla sobre crema de garbanzos con garbanzos tostados, en plato de cerámica decorado',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la brasa con patatas asadas y sal gruesa en plato de gres',
	},
	{
		src: churros,
		alt: 'Churros recién hechos en cucurucho de papel sobre tabla de madera, con chocolate',
	},
	{
		src: calabacin,
		alt: 'Milhojas de calabacín con ensalada y frutos secos sobre plato de cristal rayado',
	},
	{
		src: croqueta,
		alt: 'Croqueta dorada sobre salsa de pimiento con ensalada, en plato blanco',
	},
	{
		src: hamburguesa,
		alt: 'Hamburguesa con huevo frito y patatas fritas junto a dos cañas',
	},
	{
		src: godello,
		alt: 'Botella de Godello Orovel 2020 en la mesa, junto a copas de vino',
	},
];

const cartaGrupos = [
	{
		title: 'Para empezar y compartir',
		items: [
			{ name: 'Croqueta de la casa', note: 'dorada por fuera, sobre salsa de pimiento' },
			{ name: 'Morcilla con crema de garbanzos', note: 'con garbanzos tostados y yema curada' },
			{ name: 'Milhojas de calabacín', note: 'con ensalada y frutos secos' },
			{ name: 'Raciones de la barra', note: 'la parte de cantina: se pregunta por lo del día' },
		],
	},
	{
		title: 'Cuchara y sartén',
		items: [
			{ name: 'Migas manchegas', note: 'coronadas con un huevo frito' },
			{ name: 'Arroz con sardinas', note: 'en sartén de hierro, con las sardinas abiertas encima' },
			{ name: 'Hojaldre de carne guisada', note: 'sobre salsa de pimiento y con ensalada' },
			{ name: 'Guisos de temporada', note: 'lo que marque el mercado; se pregunta al reservar' },
		],
	},
	{
		title: 'A la brasa',
		items: [
			{ name: 'Entrecot a la brasa', note: 'con patatas asadas y sal gruesa' },
			{ name: 'Carnes a la parrilla', note: 'el punto se pide en mesa' },
			{ name: 'Hamburguesa con huevo frito', note: 'con patatas fritas' },
		],
	},
	{
		title: 'Postres y sobremesa',
		items: [
			{ name: 'Churros con chocolate', note: 'en cucurucho de papel, para mojar' },
			{ name: 'Vinos de la casa', note: 'blancos tipo Godello y tintos de la tierra' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#neocantina`,
	name: BUSINESS.name,
	alternateName: ['Neocantina', 'Neocantina Ciudad Real', 'Restaurante Neocantina Ciudad Real'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, BUSINESS.instagram, BUSINESS.facebook],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina manchega', 'Cocina española', 'Brasa'],
	acceptsReservations: true,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid }],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-neocantina-vertical-07.jpg": hojaldre,
	"restaurante-neocantina-apaisada-01.jpg": arroz,
	"restaurante-neocantina-apaisada-04.jpg": migas,
	"restaurante-neocantina-apaisada-03.jpg": morcilla,
	"restaurante-neocantina-apaisada-05.jpg": entrecot,
	"restaurante-neocantina-apaisada-02.jpg": churros,
	"restaurante-neocantina-apaisada-06.jpg": calabacin,
	"restaurante-neocantina-apaisada-08.jpg": croqueta,
	"restaurante-neocantina-vertical-09.jpg": hamburguesa,
	"restaurante-neocantina-apaisada-10.jpg": godello,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1b2117" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Neocantina, restaurante Ciudad Real, cocina manchega Ciudad Real, comer en Ciudad Real, Av. de las Lagunas de Ruidera 8, migas manchegas, arroz con sardinas, carnes a la brasa Ciudad Real, restaurante 13004, reservar mesa Ciudad Real"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina manchega, brasa y sobremesa en la avenida de las Lagunas de Ruidera, 8, 13004 Ciudad Real. Reservas en el 926 22 26 94."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Hojaldre de carne guisada del Restaurante Neocantina, en Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1b2117"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="13004 Ciudad Real"
			preload={[hojaldre]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/restaurante-neocantina/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Neocantina"
			subtitle="Restaurante · Ciudad Real"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Restaurante Neocantina"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Instagram ↗', href: BUSINESS.instagram, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías tomados de la ficha y del perfil públicos del restaurante en Google Maps. El horario exacto y los precios se confirman por teléfono."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Restaurante Neocantina"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34926222694?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Croqueta%20de%20la%20casa." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Croqueta de la casa"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
