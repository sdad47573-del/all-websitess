---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import barra from '../assets/fotos/izadi-taberna-panoramica-02.jpg';
import croquetaServilleta from '../assets/fotos/izadi-taberna-vertical-03.jpg';
import croquetaPlato from '../assets/fotos/izadi-taberna-vertical-01.jpg';
import croquetaRelleno from '../assets/fotos/izadi-taberna-vertical-04.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Izadi Taberna, taberna y cafetería en Hamarretxeta Kalea, 20, Pasai Antxo (20110 Pasaia, Gipuzkoa). Pinchos, croquetas y café todos los días desde las 8:00. Tel. 943 51 07 50.';

const galeria = [
	{
		src: barra,
		alt: 'Dos croquetas en un plato de porcelana sobre la barra de madera, con una caña de cerveza al lado',
	},
	{
		src: croquetaServilleta,
		alt: 'Una croqueta en un cuenco pequeño, junto a una servilleta de Izadi Taberna con su anagrama',
	},
	{
		src: croquetaPlato,
		alt: 'Croqueta abierta en un plato blanco, con el papel de la cuenta de la taberna al fondo',
	},
	{
		src: croquetaRelleno,
		alt: 'Media croqueta en la mano, con la bechamel del relleno a la vista',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#izadi`,
	name: BUSINESS.name,
	alternateName: ['Izadi', 'Izadi Taberna Pasai Antxo', 'Izadi Pasaia'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 943 51 07 50',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Vasca', 'Tradicional', 'Pinchos'],
	areaServed: [
		{ '@type': 'City', name: 'Pasaia' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '08:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Friday',
			opens: '08:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '09:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '09:00',
			closes: '23:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Excelente sitio para tomar un pincho o una exquisita croqueta.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody:
				'Personal muy majo y agradable, pintxos super ricos,especialmente las croquetas',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Taberna de pasaia con buen trato y buenas croquetas',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La barra', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Izadi Taberna · Pinchos y croquetas en Pasai Antxo';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#9e2b25" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Izadi Taberna, taberna Pasai Antxo, pinchos Pasaia, croquetas Pasai Antxo, cafetería Pasaia, comer en Pasai Antxo, Izadi Pasaia"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Taberna y cafetería en Hamarretxeta Kalea, 20 (Pasai Antxo, Pasaia). Pinchos, croquetas y café todos los días desde las 8:00. Tel. 943 51 07 50."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Dos croquetas y una caña de cerveza sobre la barra de Izadi Taberna"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#9e2b25"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34943510750"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Pasai Antxo, Pasaia"
			preload={[barra]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/izadi-taberna/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Izadi"
			subtitle="Taberna · Pasai Antxo"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Hamarretxeta Kalea, 20 · Pasai Antxo, Pasaia"
				title="Pinchos y croquetas<br /><em>en Pasai Antxo.</em>"
				lede={`Izadi Taberna es una taberna y cafetería de barrio en Hamarretxeta Kalea, 20, en Pasai Antxo (Pasaia, Gipuzkoa). Barra de pinchos, croquetas y café desde primera hora: abre todos los días, a las 8:00 de lunes a viernes y a las 9:00 el fin de semana. Se atiende por teléfono, en el ${BUSINESS.phoneDisplay}.`}
				image={barra}
				imageAlt="Dos croquetas en un plato de porcelana sobre la barra de madera, con una caña de cerveza al lado"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,7</b> en Google · 84 reseñas' },
					{ label: 'Apertura', html: '<b>8:00</b> de lunes a viernes' },
					{ label: 'Reseñas', html: '<b>Croquetas</b> lo que más citan' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Izadi Taberna" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="La barra<br /><em>de siempre.</em>"
				paragraphs={[
					'Izadi Taberna está en Hamarretxeta Kalea, 20, en Pasai Antxo, dentro del término municipal de Pasaia (Gipuzkoa). Una taberna de barrio con cafetería y cocina, de las que abren temprano y siguen abiertas hasta la noche.',
					'Google la clasifica a la vez como restaurante y como cafetería. Su ficha no incluye descripción del local ni carta, así que esta web no inventa platos ni precios: se limita a lo que dicen sus reseñas y a lo que consta en la ficha.',
					'Y lo que dicen es muy concreto: «Excelente sitio para tomar un pincho o una exquisita croqueta», «pintxos super ricos, especialmente las croquetas» y «taberna de Pasaia con buen trato y buenas croquetas». Las croquetas aparecen en las tres.',
					'Abre todos los días: de lunes a jueves de 8:00 a 23:00, el viernes de 8:00 a 24:00, el sábado de 9:00 a 24:00 y el domingo de 9:00 a 23:00.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «Excelente sitio para tomar un pincho o una exquisita croqueta».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La barra"
				title="Pinchos, croquetas<br /><em>y café.</em>"
				description="La ficha de Google no publica carta ni precios y el local no tiene web propia. Esto es todo lo que se puede afirmar con fuentes: lo que citan sus reseñas y las categorías con las que Google lo describe."
				cta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. Llama al 943 51 07 50 para preguntar qué pinchos hay hoy y si queda sitio en la barra."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Cuatro fotos<br /><em>de la barra.</em>"
				description="Son las cuatro fotografías que el perfil de Izadi Taberna tiene publicadas en Google Maps: la barra con dos croquetas y una caña, la servilleta de la casa con su anagrama y el relleno de las croquetas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en Pasai Antxo.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} Pasai Antxo · ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: de lunes a jueves de 8:00 a 23:00; viernes de 8:00 a 24:00; sábado de 9:00 a 24:00; domingo de 9:00 a 23:00. Abre todos los días."
				mapTitle="Mapa de Izadi Taberna en Hamarretxeta Kalea, 20, Pasai Antxo (Pasaia, Gipuzkoa)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Izadi Taberna · Pasai Antxo"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se atiende por teléfono en el 943 51 07 50. La ficha de Google no publica datos de accesibilidad ni de terraza, así que conviene preguntar antes de ir."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} Pasai Antxo, ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/izadi-taberna/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Izadi Taberna"
		/>
	</body>
</html>
