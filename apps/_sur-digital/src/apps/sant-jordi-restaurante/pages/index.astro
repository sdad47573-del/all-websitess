---
import { Image } from 'astro:assets';
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/sant-jordi-restaurante-fachada.jpg';
import fachadaCalle from '../assets/fotos/sant-jordi-restaurante-fachada-calle.jpg';
import entrada from '../assets/fotos/sant-jordi-restaurante-entrada.jpg';

const business = {
	name: 'Sant Jordi Restaurante',
	brand: 'Sant Jordi',
	tagline: 'Restaurante mediterráneo en L’Alcora',
	street: 'Carrer Mossen Julio Vilar, 2',
	city: 'L’Alcora',
	region: 'Comunitat Valenciana',
	postalCode: '12110',
	phone: '964 36 22 00',
	latitude: 40.0706978,
	longitude: -0.2073817,
	rating: 4.8,
	reviewsCount: 8,
	site: 'https://www.sur-digital.com/sant-jordi-restaurante',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd5fe40ce2efdc1d:0xf8f1f325ddfb2a60';
const cidDecimal = '17938386134756960864';
const placeId = 'ChIJHdzv4gzkXw0RYCr73SXz8fg';

const mapsUrl =
	'https://www.google.com/maps/place/Sant+Jordi+Restaurante/@40.0706978,-0.2073817,17z/data=!3m1!4b1!4m6!3m5!1s0xd5fe40ce2efdc1d:0xf8f1f325ddfb2a60!8m2!3d40.0706978!4d-0.2073817!16s%2Fg%2F1q5bmpc_x?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&q=Sant+Jordi+Restaurante+L%27Alcora&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34964362200';

const description =
	'Sant Jordi Restaurante, restaurante mediterráneo en el centro de L’Alcora (Castellón). Abre todos los días de 9:30 a 0:30. Teléfono 964 36 22 00.';

const servicios = [
	'Restaurante mediterráneo',
	'Cocina mediterránea',
	'Abierto todos los días',
	'De 9:30 a 0:30',
	'En el centro de L’Alcora',
	'L’Alcora, capital de la cerámica',
];

const faqs = [
	{
		q: '¿Dónde está Sant Jordi Restaurante?',
		a: 'En el Carrer Mossen Julio Vilar, 2, 12110 L’Alcora (Castellón), en el centro del municipio. Desde esta página puedes abrir Google Maps y trazar la ruta hasta la puerta con el botón «Cómo llegar».',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'La ficha de Google marca apertura todos los días, de 9:30 a 0:30. Es un horario largo, de los que cubren desayuno, comida y cena, pero conviene confirmarlo por teléfono antes de desplazarse, sobre todo en festivos.',
	},
	{
		q: '¿Qué tipo de cocina hace?',
		a: 'Google lo clasifica como restaurante mediterráneo. No tiene carta publicada en la ficha, así que esta web no reproduce platos que no se puedan comprobar: el menú del día y la carta se consultan directamente en el local o llamando al 964 36 22 00.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'No hay reserva online ni formulario en esta web: se reserva llamando al 964 36 22 00. Si vais en grupo o queréis una mesa concreta, lo mejor es llamar con antelación.',
	},
	{
		q: '¿Esta es la web oficial del restaurante?',
		a: 'No. Es una web informativa elaborada con los datos públicos de su ficha de Google Maps, porque el restaurante no tiene una web propia publicada. Por eso no hay reservas online ni carrito: todo se gestiona por teléfono o en el local.',
	},
	{
		q: '¿Por qué no hay galería de platos ni carta en esta web?',
		a: 'Porque la ficha de Google no tiene fotos propias del restaurante ni una carta que se pueda consultar, y aquí no se inventan ni se copian de otros sitios. Las únicas imágenes públicas del local son capturas de Google Street View: la fachada de la portada y las dos de la sección «El local desde la calle». Si el titular facilita fotos o la carta, se añaden.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['Sant Jordi', 'Sant Jordi L’Alcora', 'Restaurante Sant Jordi Alcora'],
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 964 36 22 00',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Cocina mediterránea', 'Restaurante'],
	areaServed: [
		{ '@type': 'City', name: 'L’Alcora' },
		{ '@type': 'AdministrativeArea', name: 'Alcalatén' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: "L'Alcora",
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '09:30',
			closes: '00:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El local', href: '#galeria' },
	{ label: 'Datos', href: '#datos' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>Sant Jordi Restaurante · L’Alcora</title>
		<meta name="theme-color" content="#14416b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=DM+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Sant Jordi Restaurante, restaurante L'Alcora, restaurante mediterráneo L'Alcora, comer en L'Alcora, Carrer Mossen Julio Vilar 2, restaurante Castellón Alcalatén, teléfono Sant Jordi L'Alcora, restaurante abierto todos los días L'Alcora"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Sant Jordi Restaurante · L’Alcora"
			ogDescription="Restaurante mediterráneo en el centro de L’Alcora. Abre todos los días de 9:30 a 0:30. Teléfono 964 36 22 00."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Esquina de Sant Jordi Restaurante con su cartel azul en L’Alcora"
			ogImageWidth={1024}
			ogImageHeight={538}
			author={business.name}
			themeColor="#14416b"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="L’Alcora, Castellón"
			preload={[fachada]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="SJ"
			name={business.brand}
			subtitle="Restaurante · L’Alcora"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<section class="hero wrap" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Carrer Mossen Julio Vilar, 2 · L’Alcora</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante mediterráneo en el centro de L’Alcora, la capital de la cerámica de Castellón.
						Abre todos los días, de 9:30 a 0:30, y atiende por teléfono en el 964 36 22 00. Su ficha de
						Google le da un 4,8 sobre 5.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href={phoneHref}>Llamar 964 36 22 00</a>
						<a class="button button-ghost" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,8</b> en Google (8 reseñas)</li>
						<li>Cocina <b>mediterránea</b></li>
						<li>Todos los días, <b>9:30 – 0:30</b></li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={fachada}
						alt="Esquina del edificio de Sant Jordi Restaurante con el cartel azul del restaurante y la placa de la calle, L’Alcora"
						widths={[520, 760, 1024]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="webp"
						quality={72}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Fachada en Google Street View</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en el mapa ↗</a>
					</figcaption>
				</figure>
			</section>

			<LocalChips label="Qué ofrece Sant Jordi Restaurante" items={servicios} />

			<LocalAbout
				label="Restaurante mediterráneo en L’Alcora"
				title="En el centro<br />de la capital<br /><em>de la cerámica.</em>"
				paragraphs={[
					'Sant Jordi Restaurante está en el Carrer Mossen Julio Vilar, 2, en pleno casco de L’Alcora, un municipio de la comarca del Alcalatén conocido en toda España por su industria cerámica: aquí se fabrican azulejos y pavimentos que acaban en fachadas de medio mundo.',
					'La ficha de Google lo clasifica como restaurante mediterráneo y marca apertura todos los días, de 9:30 a 0:30, con un horario que cubre desde el café de la mañana hasta la última mesa de la noche. Para comer o cenar, lo más directo es llamar al 964 36 22 00.',
					'Esta web reúne lo que se puede comprobar: dirección, teléfono, horario, categoría y nota media. No hay carta ni galería de platos porque el restaurante no las tiene publicadas en Google, y aquí no se inventan platos ni se copian fotos de otros sitios: las únicas imágenes son las de la fachada y la entrada, tomadas de Google Street View.',
				]}
				note="La ficha reúne por ahora 8 reseñas, con una nota media de 4,8 sobre 5. Es una ficha joven y sin fotos propias publicadas: si eres el titular y quieres completarla, desde el propio panel de Google puedes añadir imágenes, carta y servicios, y nos los puedes pasar para incorporarlos a la web."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<section class="gallery section-pad wrap" id="galeria" aria-labelledby="galeria-title">
				<div class="gallery-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> El local desde la calle</p>
						<h2 id="galeria-title">Cómo reconocer<br /><em>la puerta.</em></h2>
					</div>
					<div>
						<p>
							La ficha de Google no tiene fotos subidas por el restaurante, así que las únicas
							imágenes públicas del local son las de Google Street View. Estas dos capturas sirven
							para reconocer la fachada y la entrada desde la calle: el número 2, las dos yucas y el
							rótulo de Sant Jordi sobre la persiana.
						</p>
						<a class="button button-ghost" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid gallery-grid--paisaje">
					<figure class="shot">
						<Image
							src={fachadaCalle}
							alt="Fachada de Sant Jordi Restaurante en el Carrer Mossen Julio Vilar, 2, de L’Alcora, vista desde la calle"
							widths={[420, 640, 1024]}
							sizes="(max-width: 980px) 92vw, 48vw"
							format="webp"
							quality={70}
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<figure class="shot">
						<Image
							src={entrada}
							alt="Entrada de Sant Jordi Restaurante con el número 2, el rótulo del restaurante y dos yucas en la fachada"
							widths={[420, 640, 1024]}
							sizes="(max-width: 980px) 92vw, 48vw"
							format="webp"
							quality={70}
							loading="lazy"
							decoding="async"
						/>
					</figure>
				</div>
				<p class="gallery-note">
					Capturas de Google Street View de la fachada y la entrada del local. Si eres el titular y
					prefieres retirarlas, o quieres añadir fotos propias de la carta y del restaurante,
					escríbenos y las cambiamos.
				</p>
			</section>

			<section class="section-pad" id="datos" aria-labelledby="datos-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Información práctica</p>
					<h2 id="datos-title">Lo que conviene saber<br /><em>antes de ir.</em></h2>
					<dl class="info-grid">
						<div class="info-card">
							<dt>Dirección</dt>
							<dd>
								Carrer Mossen Julio Vilar, 2<br />
								12110 L’Alcora (Castellón)
								<small>En el centro del municipio</small>
							</dd>
						</div>
						<div class="info-card">
							<dt>Teléfono</dt>
							<dd>
								<a href={phoneHref}>964 36 22 00</a>
								<small>Reservas y consultas por teléfono</small>
							</dd>
						</div>
						<div class="info-card">
							<dt>Horario</dt>
							<dd>
								Todos los días<br />
								9:30 – 0:30
								<small>Según la ficha de Google</small>
							</dd>
						</div>
						<div class="info-card">
							<dt>Cocina</dt>
							<dd>
								Restaurante mediterráneo
								<small>Sin carta publicada: se consulta en el local</small>
							</dd>
						</div>
					</dl>
					<p class="about-links">
						<a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar en Google Maps ↗</a>
						<a href={reviewsUrl} target="_blank" rel="noreferrer">Ver las 8 reseñas ↗</a>
					</p>
				</div>
			</section>

			<LocalVisit
				eyebrow="Carrer Mossen Julio Vilar, 2 · 12110 L’Alcora"
				title="Nos vemos<br /><em>en Sant Jordi.</em>"
				addressLines={[
					business.street,
					`${business.postalCode} ${business.city}`,
					'Castellón, España',
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: '9:30 – 0:30' },
					{ day: 'Martes', value: '9:30 – 0:30' },
					{ day: 'Miércoles', value: '9:30 – 0:30' },
					{ day: 'Jueves', value: '9:30 – 0:30' },
					{ day: 'Viernes', value: '9:30 – 0:30' },
					{ day: 'Sábado', value: '9:30 – 0:30' },
					{ day: 'Domingo', value: '9:30 – 0:30' },
				]}
				hoursNote="Horario publicado en la ficha de Google: todos los días, de 9:30 a 0:30. Al ser un horario tan amplio conviene confirmarlo por teléfono antes de ir, sobre todo en festivos y en la semana de las fiestas de la cerámica."
				mapTitle="Mapa de Sant Jordi Restaurante en el Carrer Mossen Julio Vilar, 2, L’Alcora"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Sant Jordi Restaurante · L’Alcora"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Las reservas se hacen por teléfono, en el 964 36 22 00: no hay reserva online ni formulario en esta web. Como no hay carta publicada, aprovecha la llamada para preguntar por el menú del día y por la disponibilidad de mesas."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="SJ"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Web informativa elaborada con datos públicos de la ficha de Google Maps del restaurante, con una imagen de fachada de Google Street View. No es la web oficial ni publica carta ni precios; confirma horarios y disponibilidad por teléfono."
			ctaLabel="Llamar a Sant Jordi"
			creditName="Sur Digital"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34964362200?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Sant%20Jordi%20Restaurante." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Sant Jordi Restaurante"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
