---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import hogazas from '../assets/fotos/panaderia-artesana-sabor-a-pan-vertical-06.jpg';
import bandeja from '../assets/fotos/panaderia-artesana-sabor-a-pan-apaisada-01.jpg';
import tartaFruta from '../assets/fotos/panaderia-artesana-sabor-a-pan-vista-2-02.jpg';
import tartaMama from '../assets/fotos/panaderia-artesana-sabor-a-pan-apaisada-03.jpg';
import figuraBebe from '../assets/fotos/panaderia-artesana-sabor-a-pan-vista-4-04.jpg';
import tartaMamaManuscrita from '../assets/fotos/panaderia-artesana-sabor-a-pan-vertical-05.jpg';
import tartaFutbol from '../assets/fotos/panaderia-artesana-sabor-a-pan-apaisada-07.jpg';
import tartasNumeros from '../assets/fotos/panaderia-artesana-sabor-a-pan-apaisada-08.jpg';
import rosconTartaletas from '../assets/fotos/panaderia-artesana-sabor-a-pan-apaisada-09.jpg';
import roscon from '../assets/fotos/panaderia-artesana-sabor-a-pan-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	MAPS,
	MENU,
	PANES,
	REVIEW_QUOTE,
	REVIEWS,
} from '../data/site';

const title = 'Sabor a Pan · Panadería artesana y pastelería en Málaga';
const description = BUSINESS.description;
const ratingLabel = BUSINESS.rating.toFixed(1).replace('.', ',');

const galeria = [
	{
		src: bandeja,
		alt: 'Bandeja de pasteles: cuadrados con glaseado rojo y nata, dulces con chocolate y coco y pasteles rellenos de nata',
		caption: 'La bandeja de la pastelería',
	},
	{
		src: tartaFruta,
		alt: 'Tarta de fruta redonda con kiwi, melocotón, fresa y uvas sobre crema',
		caption: 'Una tarta de fruta, antes de salir del obrador',
	},
	{
		src: tartaMama,
		alt: 'Tarta de chocolate con baño blanco, fresas, frambuesas, arándanos y una placa que dice la mejor mamá del mundo',
		caption: 'Tarta de chocolate para el Día de la Madre',
	},
	{
		src: figuraBebe,
		alt: 'Figura de pasta de azúcar de un bebé dormido con chupete sobre una base rosa con estrellas y corazones',
		caption: 'Figura de azúcar para una tarta de bautizo',
	},
	{
		src: tartaFutbol,
		alt: 'Tarta de cumpleaños con forma de balón de fútbol en blanco y negro sobre base de chocolate',
		caption: 'Tarta de fútbol, personalizada con el nombre',
	},
	{
		src: tartasNumeros,
		alt: 'Dos tartas de chocolate con forma de número 2 y número 5, decoradas con barritas de chocolate y estrellas',
		caption: 'Tartas de números, para cumpleaños',
	},
	{
		src: rosconTartaletas,
		alt: 'Rosco de bizcocho junto a tartaletas de fresa, kiwi y melocotón, y una tarta de manzana',
		caption: 'Rosco y tartaletas de fruta',
	},
	{
		src: roscon,
		alt: 'Dos roscos de brioche con fruta confitada y azúcar glas sobre papel de horno',
		caption: 'Roscón de frutas, recién horneado',
	},
	{
		src: tartaMamaManuscrita,
		alt: 'Tarta de chocolate con el mensaje Felicidades Mamá escrito en nata y fresas junto a un cucurucho',
		caption: 'Otra tarta de chocolate, escrita a mano',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#sabor-a-pan`,
	name: BUSINESS.name,
	alternateName: ['Sabor a Pan', 'Panadería Sabor a Pan', 'Obrador Sabor a Pan Málaga'],
	description:
		'Obrador artesanal de pan y pastelería en C. Cristóbal de Villalón, 11 (Cruz de Humilladero, 29006 Málaga): masas madres, tartas de encargo, palmeras gigantes, empanadas y dulces caseros.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 951 24 52 57',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '17:00',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '07:00',
			closes: '14:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
	],
	makesOffer: [
		{
			'@type': 'Offer',
			itemOffered: { '@type': 'Product', name: 'Pan de masa madre' },
		},
		{
			'@type': 'Offer',
			itemOffered: { '@type': 'Product', name: 'Tartas personalizadas' },
		},
		{
			'@type': 'Offer',
			itemOffered: { '@type': 'Product', name: 'Palmeras gigantes personalizadas' },
		},
		{
			'@type': 'Offer',
			itemOffered: { '@type': 'Product', name: 'Empanadas y hojaldres' },
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: REVIEW_QUOTE,
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El obrador', href: '#obrador' },
	{ label: 'Los panes', href: '#panes' },
	{ label: 'Pastelería', href: '#pasteleria' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Visítanos', href: '#visitanos' },
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#faf6ec" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Alegreya+Sans:wght@400;500;700&family=Chivo+Mono:wght@500&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Sabor a Pan, panadería artesana Málaga, obrador Cruz de Humilladero, tartas personalizadas Málaga, pan de masa madre Málaga, palmeras gigantes, Cristóbal de Villalón 11"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Obrador artesanal de pan y pastelería en Cristóbal de Villalón, 11, Cruz de Humilladero. Masas madres, tartas de encargo y dulces caseros. Teléfono 951 24 52 57."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tarta de chocolate con fresas y el mensaje Felicidades Mamá, del obrador Sabor a Pan"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#faf6ec"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[hogazas]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/panaderia-artesana-sabor-a-pan/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Panadería Artesana Sabor a Pan, inicio">
					<span class="brand-mark" aria-hidden="true">
						SP
					</span>
					<span class="brand-name">
						Sabor a Pan
						<small>Obrador artesanal · Panadería y pastelería</small>
					</span>
				</a>
				<nav class="nav" aria-label="Navegación principal">
					{nav.map((item) => (
						<a href={item.href}>{item.label}</a>
					))}
				</nav>
				<a class="topbar-phone" href={BUSINESS.phoneHref}>
					<span class="topbar-phone-label">Encargos</span> {BUSINESS.phone}
				</a>
			</div>
			<nav class="mobile-nav wrap" aria-label="Navegación principal en móvil">
				{nav.map((item) => (
					<a href={item.href}>{item.label}</a>
				))}
			</nav>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Cruz de Humilladero · Málaga
						</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-lede">
							Pan de masa madre y pastelería hecha en el obrador, en la calle Cristóbal de Villalón,
							11. Tartas de cumpleaños y de bodas, palmeras gigantes, empanadas y dulces caseros.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={BUSINESS.phoneHref}>
								Encargar · {BUSINESS.phone}
							</a>
							<a
								class="button button-ghost"
								href={MAPS.directions}
								target="_blank"
								rel="noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<div class="hero-facts">
							<div>
								<span>Google</span>
								<strong>{ratingLabel} / 5</strong>
								<small>{BUSINESS.reviewsCount} reseñas</small>
							</div>
							<div>
								<span>Horario</span>
								<strong>7:00–20:30</strong>
								<small>con cierre de mediodía</small>
							</div>
							<div>
								<span>El obrador</span>
								<strong>Masa madre</strong>
								<small>harinas de cereales</small>
							</div>
						</div>
					</div>

					<figure class="hero-photo">
						<div class="hero-photo-main">
							<Image
								src={hogazas}
								alt="Hogazas de corteza dorada recién horneadas sobre la bandeja del obrador"
								widths={[420, 640, 900, 1200]}
								sizes="(max-width: 980px) 92vw, 42vw"
								format="avif"
								quality={74}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</div>
						<div class="hero-photo-inset">
							<Image
								src={tartaFutbol}
								alt="Tarta de cumpleaños con forma de balón de fútbol sobre base de chocolate"
								widths={[260, 380, 520]}
								sizes="(max-width: 700px) 34vw, 16vw"
								format="avif"
								quality={72}
								loading="lazy"
								decoding="async"
							/>
						</div>
						<span class="stamp" aria-hidden="true">
							<span>Obrador artesanal</span>
							<span>Masa madre · Málaga</span>
						</span>
						<figcaption>
							<span>Fotos del perfil de Google Maps</span>
							<a href={MAPS.place} target="_blank" rel="noreferrer">
								Ver la ficha ↗
							</a>
						</figcaption>
					</figure>
				</div>
			</section>

			<section class="breads" id="panes" aria-labelledby="breads-title">
				<div class="wrap breads-grid">
					<div class="breads-head">
						<p class="section-label">
							<span aria-hidden="true"></span> Carta de panes
						</p>
						<h2 id="breads-title">
							Seis panes, <em>un obrador.</em>
						</h2>
						<p>
							Los panes que la panadería enumera en su ficha de Google. La disponibilidad cambia
							según el día; para reservar una pieza, llama al
							<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>.
						</p>
					</div>
					<ul class="breads-list">
						{PANES.map((pan, index) => (
							<li>
								<span class="breads-index">{String(index + 1).padStart(2, '0')}</span>
								<span class="breads-name">{pan.name}</span>
								<span class="breads-dots" aria-hidden="true"></span>
								<span class="breads-note">{pan.note}</span>
							</li>
						))}
					</ul>
				</div>
			</section>

			<section class="facts" aria-label="Datos de la ficha">
				<div class="wrap facts-grid">
					<div class="fact">
						<span class="fact-kicker">La ficha</span>
						<strong>{ratingLabel} / 5</strong>
						<p>{BUSINESS.reviewsCount} reseñas en Google.</p>
					</div>
					<div class="fact">
						<span class="fact-kicker">El teléfono</span>
						<strong>
							<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
						</strong>
						<p>Para tartas y encargos.</p>
					</div>
					<div class="fact">
						<span class="fact-kicker">El horario</span>
						<strong>7:00–20:30</strong>
						<p>Sábado hasta las 14:00; domingo cerrado.</p>
					</div>
					<div class="fact">
						<span class="fact-kicker">El local</span>
						<strong>Accesible</strong>
						<p>Acceso y aparcamiento adaptado.</p>
					</div>
				</div>
			</section>

			<section class="about wrap" id="obrador" aria-labelledby="about-title">
				<div class="about-head">
					<p class="section-label">
						<span aria-hidden="true"></span> El obrador
					</p>
					<h2 id="about-title">
						Todo se hace <em>aquí dentro.</em>
					</h2>
					<p>
						La panadería se presenta como obrador artesanal de panadería y pastelería: masas madres,
						harinas de cereales y encargos que se preparan uno a uno, desde una tarta de boda hasta
						una palmera gigante.
					</p>
				</div>

				<blockquote class="owner-quote">
					<p>{BUSINESS.ownerNote}</p>
					<cite>Descripción del establecimiento en su ficha de Google</cite>
				</blockquote>

				<div class="highlights-grid">
					{HIGHLIGHTS.map((item) => (
						<article class="highlight">
							<span class="highlight-number">{item.number}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="counter" id="pasteleria" aria-labelledby="counter-title">
				<div class="wrap">
					<div class="counter-head">
						<div>
							<p class="section-label">
								<span aria-hidden="true"></span> La pastelería
							</p>
							<h2 id="counter-title">
								Tartas, dulces <em>y salados.</em>
							</h2>
						</div>
						<p>
							La ficha no publica carta ni precios. Esto es lo que la panadería enumera en su
							descripción de Google y lo que aparece en las fotos del perfil.
						</p>
					</div>

					<div class="menu-grid">
						{MENU.map((group) => (
							<article class="menu-card">
								<span class="menu-kicker">{group.kicker}</span>
								<h3>{group.title}</h3>
								<ul>
									{group.items.map((item) => (
										<li>
											<strong>{item.name}</strong>
											<span>{item.note}</span>
										</li>
									))}
								</ul>
							</article>
						))}
					</div>

					<div class="counter-note">
						<p>
							<strong>Sin carta ni precios publicados.</strong> Cada tarta se prepara por encargo:
							para concretar tamaño, sabor y fecha, llama al
							<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>.
						</p>
						<a class="button button-primary" href={BUSINESS.phoneHref}>
							Llamar al obrador
						</a>
					</div>
				</div>
			</section>

			<section class="gallery wrap" id="fotos" aria-labelledby="gallery-title">
				<div class="gallery-head">
					<div>
						<p class="section-label">
							<span aria-hidden="true"></span> La casa en fotos
						</p>
						<h2 id="gallery-title">
							De la bandeja <em>a la tarta.</em>
						</h2>
					</div>
					<p>
						Nueve imágenes del perfil de Google Maps: la bandeja de pasteles, tartas de fruta y de
						chocolate, tartas de números y de fútbol, figuras de azúcar y el roscón de frutas. Son
						fotos del obrador, no de un banco de imágenes.
					</p>
				</div>

				<div class="gallery-grid">
					{galeria.map((photo) => (
						<figure>
							<Image
								src={photo.src}
								alt={photo.alt}
								widths={[420, 640, 960, 1200]}
								sizes="(max-width: 700px) 92vw, 31vw"
								format="avif"
								quality={72}
								loading="lazy"
								decoding="async"
							/>
							<figcaption>{photo.caption}</figcaption>
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes del perfil del establecimiento en Google Maps. Si eres titular de alguna y
					quieres retirarla, escríbenos y la borramos.
				</p>
			</section>

			<section class="reviews" aria-labelledby="reviews-title">
				<div class="wrap reviews-grid">
					<div class="reviews-score">
						<span class="score-number">{ratingLabel}</span>
						<span class="score-stars" role="img" aria-label="4,1 de 5 estrellas">
							★★★★☆
						</span>
						<span class="score-count">{BUSINESS.reviewsCount} reseñas en Google</span>
					</div>
					<div class="reviews-copy">
						<p class="section-label section-label-light">
							<span aria-hidden="true"></span> Lo que dicen
						</p>
						<h2 id="reviews-title">
							«Todo casero <em>y muy bueno</em>»
						</h2>
						<div class="review-list">
							{REVIEWS.map((item) => (
								<figure>
									<blockquote>«{item.text}»</blockquote>
									<figcaption>{item.note}</figcaption>
								</figure>
							))}
						</div>
						<a class="reviews-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer las 18 reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label">
						<span aria-hidden="true"></span> Visítanos
					</p>
					<h2 id="visit-title">
						En Cristóbal <em>de Villalón.</em>
					</h2>
					<p class="address">
						{BUSINESS.street}
						<br />
						{BUSINESS.district}
						<br />
						{BUSINESS.postalCode} {BUSINESS.city}
					</p>

					<table class="hours">
						<caption>Horario de la ficha de Google</caption>
						<tbody>
							{HOURS.map((row) => (
								<tr>
									<th scope="row">{row.day}</th>
									<td>{row.value}</td>
								</tr>
							))}
						</tbody>
					</table>
					<p class="hours-note">
						Horario publicado por el establecimiento en Google, consultado el 28 de octubre de 2026.
						En festivos puede cambiar: confirma antes de ir.
					</p>

					<div class="visit-phone">
						<span>Teléfono y encargos</span>
						<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
					</div>

					<div class="visit-links">
						<a class="button button-primary" href={BUSINESS.phoneHref}>
							Llamar ahora
						</a>
						<a class="button button-ghost" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<p class="visit-note">
						La ficha indica acceso para sillas de ruedas y aparcamiento adaptado. No consta reparto
						a domicilio ni venta online.
					</p>
				</div>

				<div class="map-frame">
					<iframe
