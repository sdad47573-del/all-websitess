---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/bunbun-chicken-apaisada-01.jpg';
import bandeja from '../assets/fotos/bunbun-chicken-apaisada-03.jpg';
import polloPatatas from '../assets/fotos/bunbun-chicken-apaisada-04.jpg';
import salon from '../assets/fotos/bunbun-chicken-apaisada-05.jpg';
import letrero from '../assets/fotos/bunbun-chicken-apaisada-06.jpg';
import arcos from '../assets/fotos/bunbun-chicken-apaisada-07.jpg';
import mostrador from '../assets/fotos/bunbun-chicken-apaisada-08.jpg';
import cartel from '../assets/fotos/bunbun-chicken-apaisada-09.jpg';
import pollitos from '../assets/fotos/bunbun-chicken-vertical-02.jpg';
import patatas from '../assets/fotos/bunbun-chicken-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Bunbun Chicken · Pollo frito y hamburguesas en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de Bunbun Chicken de noche, en rojo, con el rótulo luminoso y los arcos iluminados de la calle Pozo Concejo',
	},
	{
		src: bandeja,
		alt: 'Dos hamburguesas de pollo crujiente y dos bandejas de pollo frito con salsa amarilla en una bandeja naranja',
	},
	{
		src: polloPatatas,
		alt: 'Bandeja de pollo frito recién hecho con patatas gajo al fondo, sobre una mesa del local',
	},
	{
		src: salon,
		alt: 'Salón de Bunbun Chicken: mesas de madera, sillas blancas, arcos de neón y una estantería con pollitos amarillos',
	},
	{
		src: letrero,
		alt: 'Letrero redondo iluminado con el pollo de dibujo animado y el nombre Bun Bun Chicken',
	},
	{
		src: arcos,
		alt: 'Ventanas arqueadas del local desde la acera, con neones naranjas y el dibujo del pollo en azul',
	},
	{
		src: mostrador,
		alt: 'Mostrador de Bunbun Chicken con el cartel de Cashier, las pantallas del menú y la máquina de refrescos',
	},
	{
		src: cartel,
		alt: 'Cartel de la carta de Bunbun Chicken con los precios de la hamburguesa, las patatas, la ensalada, el takoyaki, la salchicha, el pincho y las bebidas',
	},
	{
		src: pollitos,
		alt: 'Estantería del local con pollitos de peluche amarillos bajo un arco iluminado',
	},
	{
		src: patatas,
		alt: 'Ración de patatas fritas con sal en una bandeja naranja, con pollo frito al lado',
	},
];

const carta = [
	{
		title: 'Hamburguesas y pollo',
		items: [
			{
				name: 'Hamburguesa bunbun',
				note: 'pollo crujiente, queso y verduras en pan brioche',
				price: '4,95 €',
			},
			{
				name: 'Pollo frito en bandeja',
				note: 'para compartir, como el de las fotos del local',
			},
			{
				name: 'Alitas con salsa',
				note: 'con la salsa amarilla de la bandeja',
			},
		],
	},
	{
		title: 'Para picar',
		items: [
			{ name: 'Salchicha bunbun', note: 'en brocheta, con su salsa', price: '2,55 €' },
			{ name: 'Pincho de hotpot picante', note: 'el pincho largo de la carta', price: '3,55 €' },
			{ name: 'Takoyaki', note: '3 unidades', price: '3,95 €' },
			{ name: 'Bumbunato fritte', note: 'frito de la casa', price: '3,95 €' },
		],
	},
	{
		title: 'Patatas y ensalada',
		items: [
			{ name: 'Patatas fritas', note: 'ración para compartir', price: '2,95 €' },
			{ name: 'Ensalada bunbun', note: 'con pollo crujiente y salsa', price: '3,95 €' },
		],
	},
	{
		title: 'Bebidas y postres',
		items: [
			{ name: 'Burbuja con leche', note: 'bubble tea con perlas', price: '4,95 €' },
			{ name: 'Burbuja de maracuyá', note: 'bubble tea de fruta', price: '4,95 €' },
			{ name: 'Burbuja de pomelo', note: 'bubble tea de fruta', price: '4,95 €' },
			{ name: 'Bunbun arroz burbuja', note: 'postre de arroz', price: '4,55 €' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#bunbun-chicken`,
	name: BUSINESS.name,
	alternateName: ['Bun Bun Chicken', 'Bunbun Chicken Ciudad Real', 'Bunbun chicken pollo frito'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo frito', 'Hamburguesas', 'Comida para llevar'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Ciudad Real' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday'],
			opens: '12:00',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday'],
			opens: '19:30',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday', 'Sunday'],
			opens: '19:30',
			closes: '00:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"bunbun-chicken-apaisada-03.jpg": bandeja,
	"bunbun-chicken-apaisada-01.jpg": fachada,
	"bunbun-chicken-apaisada-04.jpg": polloPatatas,
	"bunbun-chicken-apaisada-05.jpg": salon,
	"bunbun-chicken-apaisada-06.jpg": letrero,
	"bunbun-chicken-apaisada-07.jpg": arcos,
	"bunbun-chicken-apaisada-08.jpg": mostrador,
	"bunbun-chicken-apaisada-09.jpg": cartel,
	"bunbun-chicken-vertical-02.jpg": pollitos,
	"bunbun-chicken-vertical-10.jpg": patatas,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1b1013" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,700&family=Nunito+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Bunbun chicken Ciudad Real, pollo frito Ciudad Real, hamburguesas Pozo Concejo, bubble tea Ciudad Real, takoyaki Ciudad Real, pollo frito para llevar 13004, restaurante pollo Ciudad Real, Bun Bun Chicken, C. Pozo Concejo"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo frito crujiente, hamburguesas bunbun, patatas, takoyaki y bubble tea en la calle Pozo Concejo, Ciudad Real. De 12:00 a 16:30 y desde las 19:30; martes cerrado."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Bunbun Chicken, pollo frito y hamburguesas en Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1b1013"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CR"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[bandeja]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/bunbun-chicken/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Bunbun Chicken"
			subtitle="Pollo frito · Ciudad Real"
			nav={nav}
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Bunbun Chicken"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone=""
			phoneHref=""
			legal="Datos, horario, precios y fotografías tomados de la ficha y del perfil públicos del local en Google Maps, consultados en noviembre de 2026. Los precios son los del cartel del propio establecimiento y pueden cambiar."
			ctaLabel=""
			navAriaLabel="Enlaces de Bunbun Chicken"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	</body>
</html>
