---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/guria-taberna-apaisada-01.jpg';
import costillas from '../assets/fotos/guria-taberna-apaisada-02.jpg';
import cafe from '../assets/fotos/guria-taberna-apaisada-03.jpg';
import barraPintxos from '../assets/fotos/guria-taberna-vertical-04.jpg';
import interior from '../assets/fotos/guria-taberna-apaisada-05.jpg';
import hamburguesa from '../assets/fotos/guria-taberna-apaisada-06.jpg';
import combinado from '../assets/fotos/guria-taberna-vertical-07.jpg';
import calle from '../assets/fotos/guria-taberna-apaisada-08.jpg';
import terraza from '../assets/fotos/guria-taberna-apaisada-09.jpg';
import cafeNata from '../assets/fotos/guria-taberna-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Guria Taberna, en Puntapax Kalea 12 (20170 Usurbil). Bocadillos, hamburguesas, platos combinados y ensaladas, con barra de pintxos y terraza. 4,4 sobre 5 y teléfono 943 55 93 35.';

const title = 'Guria Taberna · Bocadillos y platos en Usurbil';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada turquesa de Guria Taberna con el rótulo guria y las sillas de colores de la terraza, en Usurbil',
	},
	{
		src: barraPintxos,
		alt: 'Barra de Guria Taberna con pintxos, empanada y aceitunas, con la televisión al fondo',
	},
	{
		src: hamburguesa,
		alt: 'Hamburguesa con bacon, queso y patatas fritas servida en un plato de la taberna',
	},
	{
		src: costillas,
		alt: 'Costillas con salsa, patatas fritas y ensalada en un plato de Guria Taberna',
	},
	{
		src: combinado,
		alt: 'Plato combinado con huevo frito, queso en salsa de tomate y patatas fritas',
	},
	{
		src: interior,
		alt: 'Interior de Guria Taberna con la barra turquesa, taburetes y lámparas colgantes',
	},
	{
		src: terraza,
		alt: 'Terraza cubierta de Guria Taberna con mesas y sillas de mimbre al anochecer',
	},
	{
		src: calle,
		alt: 'Fachada de Guria Taberna en la calle Puntapax, con el rótulo pintado en la pared',
	},
	{
		src: cafe,
		alt: 'Café con leche en taza blanca sobre la mesa de madera de la taberna',
	},
	{
		src: cafeNata,
		alt: 'Café con nata servido en vaso con cuchara',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#guria`,
	name: BUSINESS.name,
	alternateName: ['Guria', 'Guria Usurbil', 'Guria taberna Usurbil'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 943 55 93 35',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Vasca', 'Española', 'Taberna'],
	areaServed: [
		{ '@type': 'City', name: 'Usurbil' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday'],
			opens: '11:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday'],
			opens: '18:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday'],
			opens: '11:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday'],
			opens: '18:00',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday'],
			opens: '18:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Sunday'],
			opens: '11:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '11:30',
			closes: '23:59',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const nota = BUSINESS.rating.toFixed(1).replace('.', ',');
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17677a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Guria Taberna, Guria Usurbil, taberna Usurbil, bocadillos Usurbil, hamburguesas Usurbil, platos combinados Usurbil, pintxos Usurbil, bar Usurbil"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Guria Taberna · Bocadillos y platos en Usurbil"
			ogDescription="Taberna de bocadillos, hamburguesas, platos combinados y ensaladas en Puntapax Kalea 12 (Usurbil). Barra de pintxos y terraza. Tel. 943 55 93 35."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada turquesa de Guria Taberna con el rótulo guria y las sillas de colores de la terraza"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#17677a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34943559335"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="GURIA TABERNA"
			subtitle="Usurbil · Gipuzkoa"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Puntapax Kalea, 12 · Usurbil"
				title="La taberna turquesa<br /><em>de Usurbil.</em>"
				lede={`Guria Taberna es la taberna de fachada turquesa de Puntapax Kalea, 12, en Usurbil (Gipuzkoa). Bocadillos, hamburguesas, platos combinados y ensaladas, con barra de pintxos y terraza. Cierra los lunes; los martes abre solo por la noche y de miércoles a domingo tiene mediodía y noche. ${nota} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={fachada}
				imageAlt="Fachada turquesa de Guria Taberna con el rótulo guria y las sillas de colores de la terraza, en Usurbil"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${nota}</b> en Google (${BUSINESS.reviewsCount} reseñas)`,
					},
					{ label: 'Cocina', html: 'Bocadillos, hamburguesas y platos combinados' },
					{ label: 'Horario', html: 'Cierra lunes · mié–dom, mediodía y noche' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Guria Taberna" items={[...SERVICIOS]} />

			<LocalAbout
				label="La casa"
				title="Barra de pintxos<br /><em>y terraza.</em>"
				paragraphs={[
					'Guria Taberna está en Puntapax Kalea, 12, en el 20170 Usurbil (Gipuzkoa). Se reconoce por la fachada turquesa y el rótulo guria sobre la puerta, con las mesas y sillas de colores de la terraza en la misma acera. Google la clasifica como restaurante y taberna.',
					'Cierra los lunes. Los martes abre solo por la noche, de 18:00 a 24:00; los miércoles y jueves tiene mediodía y noche (11:00–15:00 y 18:00–23:00, hasta las 23:30 el jueves); el viernes va de 11:00 a 24:00, el sábado de 11:30 a 24:00 y el domingo de 11:00 a 24:00.',
					'En las fotos de su perfil de Google aparecen la barra con pintxos, empanada y aceitunas, la hamburguesa con bacon y patatas, las costillas con ensalada, un plato combinado de huevo y queso, el interior con la barra turquesa y la terraza cubierta al anochecer.',
					`Tiene ${nota} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google. Las publicadas hablan de «buena cerveza», «buen servicio», «muy buenas hamburguesas», de las patatas bravas y de los bocadillos, «sobre todo el vegetal».`,
				]}
				note="La ficha de Google no publica carta ni precios: los platos de esta página son los que citan las reseñas y los que se ven en las fotos del perfil."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="De la barra<br /><em>y de la cocina.</em>"
				description="La ficha de Google no publica carta ni precios. Esto es lo que anuncia el propio local y lo que citan sus reseñas; el menú del día se consulta en la barra."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={[...MENU]}
				note="No hay precios publicados. Para saber qué hay hoy y si queda mesa, llama al 943 55 93 35."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La fachada,<br /><em>la barra y la mesa.</em>"
				description="Estas fotografías proceden del perfil de Guria Taberna en Google Maps: la fachada turquesa, la barra de pintxos, el interior, la terraza cubierta, la hamburguesa, las costillas, el plato combinado y los cafés."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Puntapax Kalea,<br /><em>en el centro de Usurbil.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Gipuzkoa']}
				hours={[...HOURS]}
				hoursNote="Horario de la ficha de Google: cierra los lunes; los martes solo por la noche (18:00–24:00); miércoles y jueves con mediodía y noche; de viernes a domingo desde las 11:00 (el sábado desde las 11:30) hasta medianoche. Puede cambiar, así que conviene llamar antes."
				mapTitle="Mapa de Guria Taberna en Puntapax Kalea, 12, Usurbil (Gipuzkoa)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Guria Taberna · Usurbil"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 943 55 93 35. La ficha de Google marca acceso para sillas de ruedas, aseo adaptado y asientos adaptados, y en las fotos se ve la terraza cubierta junto a la fachada."
			/>

			<LocalFaq
				items={[...FAQ]}
				eyebrow="Preguntas frecuentes"
				title="Antes de <em>venir.</em>"
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/guria-taberna/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Guria Taberna"
		/>
	</body>
</html>
