---
import Fab from '../components/Fab.astro';
import '../styles/index.css';

import 'remixicon/fonts/remixicon.css';

const { title, description } = Astro.props;
---

<!-- todoo poner todos los metas bien -->
<html lang="es" data-theme="cerrajero-malaga">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/cerrajero/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />
		<meta name="author" content="Jose Aguilar - linkedin.com/in/jose-antonio-aguilar-granados" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta
			name="keywords"
			content="cerrajero Málaga, cerrajero 24 horas Málaga, cerrajero urgente Málaga, cerrajero barato Málaga, apertura de puertas Málaga, cambio de cerraduras Málaga, cerrajero cerca de mí, cerrajero profesional Málaga, reparación de persianas Málaga, cerrajero económico Málaga, copia de llaves Málaga, cerraduras de seguridad Málaga, bombín antibumping Málaga, cerrajero disponible 24h, cerrajero Málaga teléfono"
		/>

		<!-- Robots: permitir indexación y seguimiento (esto es el valor por defecto, puedes omitir si es estándar) -->
		<meta name="robots" content="index, follow" />

		<!-- Canonical (si tienes versiones duplicadas de URL) -->
		<link rel="canonical" href="https://cerrajeroeconomicomalaga.vercel.app/" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta
			property="og:title"
			content="Cerrajero Málaga 24 h – Apertura puertas, cambio cerraduras y persianas"
		/>
		<meta
			property="og:description"
			content="Servicio profesional de cerrajería en Málaga. Disponible 24 horas los 7 días de la semana."
		/>
		<meta property="og:url" content="https://cerrajeroeconomicomalaga.vercel.app/" />
		<meta property="og:site_name" content="Cerrajero Málaga 24 h" />
		<meta property="og:locale" content="es_ES" />
		<!-- Imagen para compartir en redes: sustituye por la URL de tu imagen -->
		<meta property="og:image" content="https://cerrajeroeconomicomalaga.vercel.app/compartir.png" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta
			name="twitter:title"
			content="Cerrajero Málaga 24 h – Apertura puertas, cambio cerraduras y persianas"
		/>
		<meta
			name="twitter:description"
			content="Servicio profesional de cerrajería en Málaga, disponible 24h. Llama al 686 29 89 29."
		/>
		<meta
			name="twitter:image"
			content="https://cerrajeroeconomicomalaga.vercel.app/compartir.png"
		/>
	</head>
	<body>
		<Fab />
		<slot />
	</body>
</html>
