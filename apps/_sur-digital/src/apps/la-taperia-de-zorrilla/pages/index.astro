---
import '../styles/global.css';

const business = {
	name: 'La Tapería de Zorrilla',
	street: 'Calle Zorrilla, 1',
	zone: 'Plaza de Mina',
	city: 'Cádiz',
	postalCode: '11004',
	phone: '+34 856 53 03 36',
	latitude: 36.5358237,
	longitude: -6.2967549,
	site: 'https://www.sur-digital.com/la-taperia-de-zorrilla',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+LA+TAPERIA+DE+ZORRILLA/@36.5358237,-6.2967549,17z/data=!3m1!4b1!4m6!3m5!1s0xd0dd1d40d61734b:0x101a6365c40eb1b4!8m2!3d36.5358237!4d-6.2967549!16s%2Fg%2F11j6x1bkxw?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const phoneHref = 'tel:+34856530336';
const instagramUrl = 'https://www.instagram.com/taperia_zorrilla/';
const facebookUrl = 'https://www.facebook.com/people/La-Taperia-de-Zorrilla/100084224953510/';
const bookingUrl = 'https://www.thefork.com/restaurant/la-taperia-de-zorrilla-r626069';

const specialties = [
	{
		kicker: 'Las famosas',
		title: 'Croquetas variadas',
		text: 'De las más pedidas según las reseñas: cremosas, caseras y perfectas para compartir en el centro de la mesa.',
	},
	{
		kicker: 'De la plancha',
		title: 'Presa con patatas',
		text: 'Presa a la plancha con patatas, en su punto y con producto de calidad. Plato generoso de la carta.',
	},
	{
		kicker: 'Clásicos',
		title: 'Papas bravas y ensaladilla',
		text: 'Bravas, ensaladilla y salmorejo con jamón cortado a mano. Los de siempre, bien hechos.',
	},
	{
		kicker: 'Para compartir',
		title: 'Tapas y platos caseros',
		text: 'Cocina mediterránea con toques de fusión: tapas y platos caseros con un toque innovador para compartir.',
	},
	{
		kicker: 'Jamón',
		title: 'Jamón cortado a mano',
		text: 'Citado en las reseñas como espectacular. Ideal con un salmorejo fresquito para empezar.',
	},
	{
		kicker: 'Dulce final',
		title: 'Postres de carta',
		text: 'La casa anuncia postres nuevos en carta. Pregunta por el postre del momento y por la Ruta de la Tapa.',
	},
];

const gallery = [
	{ src: '/la-taperia-de-zorrilla/fotos/terraza-zorrilla.svg', alt: 'Ilustración de la terraza de La Tapería de Zorrilla — sustituye por foto propia' },
	{ src: '/la-taperia-de-zorrilla/fotos/tapas.svg', alt: 'Ilustración de tapas caseras — sustituye por foto propia del local' },
	{ src: '/la-taperia-de-zorrilla/fotos/croquetas.svg', alt: 'Ilustración de croquetas variadas — sustituye por foto propia' },
	{ src: '/la-taperia-de-zorrilla/fotos/presa.svg', alt: 'Ilustración de la presa a la plancha con patatas — sustituye por foto propia' },
	{ src: '/la-taperia-de-zorrilla/fotos/ensaladilla.svg', alt: 'Ilustración de ensaladilla y salmorejo — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está La Tapería de Zorrilla?',
		a: 'En Calle Zorrilla, 1, 11004 Cádiz, en la zona de Plaza de Mina, en pleno centro histórico de Cádiz.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Abre de lunes a domingo en dos turnos: de 13:00 a 16:30 y de 20:00 a 00:00, según Turismo del Ayuntamiento de Cádiz. En festivos conviene llamar antes.',
	},
	{
		q: '¿Se puede reservar mesa?',
		a: 'Sí. Se puede reservar por teléfono en el 856 53 03 36 y a través de su ficha en TheFork, enlazada en esta página.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Bar de tapas con cocina mediterránea y toques de fusión: croquetas, presa a la plancha con patatas, papas bravas, ensaladilla, salmorejo con jamón cortado a mano y postres de carta.',
	},
	{
		q: '¿Tiene terraza?',
		a: 'Sí, cuenta con una pequeña terraza en la calle Zorrilla, ideal en los meses de buen tiempo en Cádiz.',
	},
];

const description =
	'La Tapería de Zorrilla: tapas y platos caseros con toque innovador en Calle Zorrilla, 1 (Cádiz). Lunes a domingo 13:00–16:30 y 20:00–00:00. Reserva en el 856 53 03 36.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 856 53 03 36',
	image: [`${business.site}/fotos/terraza-zorrilla.svg`],
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Tapas', 'Española tradicional'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [instagramUrl, facebookUrl],
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '00:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Comida para llevar', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1b1714" />
		<meta name="description" content="La Tapería de Zorrilla: tapas y platos caseros en Calle Zorrilla, 1 (Cádiz). Lunes a domingo 13:00–16:30 y 20:00–00:00. Reserva en el 856 53 03 36." />
		<meta name="keywords" content="La Tapería de Zorrilla Cádiz, tapas Cádiz centro, Plaza de Mina restaurante, croquetas Cádiz, presa plancha Cádiz, Calle Zorrilla 1, reservar mesa Cádiz" />
		<meta name="author" content="La Tapería de Zorrilla" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/la-taperia-de-zorrilla/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>La Tapería de Zorrilla | Tapas en el centro de Cádiz</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="La Tapería de Zorrilla · Tapas caseras junto a Plaza de Mina" />
		<meta property="og:description" content="Croquetas, presa a la plancha, ensaladilla y salmorejo en Calle Zorrilla, 1 (Cádiz). Lunes a domingo, mediodía y noche." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/terraza-zorrilla.svg`} />
		<meta property="og:image:alt" content="La Tapería de Zorrilla, bar de tapas en el centro de Cádiz" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="La Tapería de Zorrilla · Tapas en el centro de Cádiz" />
		<meta name="twitter:description" content="Tapas y platos caseros con toque innovador en Calle Zorrilla, 1, Cádiz." />
		<meta name="twitter:image" content={`${business.site}/fotos/terraza-zorrilla.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Cádiz" />
		<meta name="geo.position" content="36.5358237;-6.2967549" />
		<meta name="ICBM" content="36.5358237, -6.2967549" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="La Tapería de Zorrilla, inicio">
				<span class="brand-mark" aria-hidden="true">Z</span>
				<span class="brand-name">La Tapería de Zorrilla <small>Cádiz · Plaza de Mina</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#taperia">La tapería</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>856 53 03 36</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Calle Zorrilla, 1 · Cádiz</p>
					<h1 id="hero-title">Tapas caseras<br />con toque innovador<br /><em>en el centro.</em></h1>
					<p class="hero-lede">
						Bar de tapas junto a Plaza de Mina: croquetas, presa a la plancha, ensaladilla,
						salmorejo con jamón y postres. Cocina mediterránea para compartir, mediodía y noche.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={bookingUrl} target="_blank" rel="noreferrer">Reservar mesa ↗</a>
						<a class="button button-ghost" href={phoneHref}>Llamar 856 53 03 36</a>
					</div>
					<ul class="hero-facts">
						<li><b>13–16:30</b> · <b>20–00</b></li>
						<li>Todos los días</li>
						<li>Terraza</li>
						<li>8,7 en TheFork</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/la-taperia-de-zorrilla/fotos/terraza-zorrilla.svg" alt="Ilustración de la terraza de La Tapería de Zorrilla en Cádiz" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Calle Zorrilla 1 · Cádiz</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>8,7</b><span>TheFork</span></div>
					<div><b>4,2</b><span>Tripadvisor</span></div>
					<div><b>7d</b><span>Apertura semanal</span></div>
				</div>
				<ul class="services">
					<li>Terraza</li>
					<li>Tapas</li>
					<li>Para compartir</li>
					<li>Para llevar</li>
					<li>Reservas</li>
					<li>Centro</li>
				</ul>
			</section>

			<section class="about section-pad" id="taperia">
				<p class="section-label"><span aria-hidden="true"></span> Un bar junto a Plaza de Mina</p>
				<div class="about-grid">
					<h2>De tapas o de platos,<br />siempre <em>para compartir.</em></h2>
					<div class="about-copy">
						<p>
							La Tapería de Zorrilla está en Calle Zorrilla, 1, en pleno centro de Cádiz, a un paso de
							Plaza de Mina. Un bar de tapas con cocina mediterránea y toques de fusión, con servicio
							profesional y ambiente relajado.
						</p>
						<p>
							Su propuesta son tapas y platos caseros con un toque innovador: croquetas variadas, presa a la
							plancha con patatas, papas bravas, ensaladilla, salmorejo con jamón cortado a mano y postres
							que van cambiando en carta.
						</p>
						<p class="about-note">
							Abre todos los días en dos turnos, mediodía y noche. Cuenta con una pequeña terraza que se
							llena en cuanto sale el sol: si vienes en fin de semana, reserva antes.
						</p>
						<div class="about-links">
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">Instagram del local <span aria-hidden="true">↗</span></a>
							<a class="simple-link" href={facebookUrl} target="_blank" rel="noreferrer">Facebook <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su carta</p>
						<h2>Lo que más<br />se pide <em>en la mesa.</em></h2>
					</div>
					<p>
						Platos citados en reseñas de clientes y guías locales. La carta y los fuera de carta cambian,
						confirma disponibilidad y precios en el local.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>La tapería<br /><em>por dentro.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del local.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Calle Zorrilla, 1</p>
					<h2>Ven de tapas<br /><em>al centro.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España ({business.zone})
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes a domingo</th>
								<td>13:00 – 16:30 · 20:00 – 00:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Horario según Turismo del Ayuntamiento de Cádiz. En festivos, llama antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={bookingUrl} target="_blank" rel="noreferrer">Reservar en TheFork ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 856 53 03 36</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de La Tapería de Zorrilla en Calle Zorrilla, 1, Cádiz" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> La Tapería de Zorrilla · Cádiz</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">Z</span>
				<p>La Tapería de Zorrilla<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} La Tapería de Zorrilla · Cádiz. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/la-taperia-de-zorrilla/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/la-taperia-de-zorrilla/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/la-taperia-de-zorrilla/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar a la tapería <span>856 53 03 36</span></a>
	</body>
</html>
