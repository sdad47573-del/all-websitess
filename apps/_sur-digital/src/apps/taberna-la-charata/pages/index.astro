---
import '../styles/global.css';
import {
	business,
	directionsUrl,
	galleryPhotos,
	heroPhoto,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	specialties,
	structuredData,
} from '../lib/business';
import { Image } from 'astro:assets';

const title = 'Taberna La Charata | Cocina casera y tapas en Rincón de la Victoria';
const description =
	'Taberna La Charata, cocina casera y tapas en Calle Córdoba, Local 2, Rincón de la Victoria (Málaga). Atún en manteca, pulpo a la charata y recetas de siempre. Consulta cómo llegar.';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1d4e89" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="Rincón de la Victoria" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/taberna-la-charata/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,600;0,700;1,600&family=Noto+Sans+Mono:wght@400;500&family=Public+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://taberna-la-charata-malaga.vercel.app/og.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Taberna La Charata, inicio"><span class="brand-mark" aria-hidden="true">LC</span><span class="brand-label">LA CHARATA <small>TABERNA · RINCÓN DE LA VICTORIA</small></span></a>
			<nav aria-label="Navegación principal"><a href="#casa">La casa</a><a href="#contacto">Contacto</a></nav>
			<a class="header-action" href={directionsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Cómo llegar</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<Image
					class="hero-bg"
					src={heroPhoto}
					alt=""
					widths={[640, 960, 1280, 1600]}
					sizes="100vw"
					format="webp"
					quality={60}
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
				<span class="hero-medallion" aria-hidden="true">LC</span>
				<div class="hero-content">
					<p class="eyebrow"><span></span> TABERNA · COCINA CASERA · RINCÓN DE LA VICTORIA</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-sub">Taberna de tapas · Rincón de la Victoria</p>
					<p class="hero-intro">Recetas de la abuela Josefina, comida muy casera y una barra de bar de las de siempre. Ven a tapear a La Charata, en pleno centro de Rincón de la Victoria, al lado del Ayuntamiento.</p>
					<div class="hero-actions"><a class="button button-cream" href={directionsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Cómo llegar</a><a class="button button-ghost" href={instagramUrl} target="_blank" rel="noreferrer">Ver en Instagram <span aria-hidden="true">↗</span></a></div>
				</div>
				<div class="hero-datos">
					<div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div>
					<div><small>DÓNDE ESTAMOS</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a></div>
					<div><small>SÍGUENOS</small><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a></div>
				</div>
			</section>

			<div class="azulejo" aria-hidden="true"></div>

			<section class="photos-section" aria-labelledby="photos-title">
				<p class="section-label"><span>01 /</span> UNA MIRADA A LA TABERNA</p>
				<div class="photos-head"><div><h2 id="photos-title">La Charata<br /><em>por dentro.</em></h2><p>Fotos de la taberna compartidas en Google Maps.</p></div><a class="social-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver todas las fotos en Google Maps <span aria-hidden="true">↗</span></a></div>
				<div class="photo-gallery">
					{galleryPhotos.map((photo, index) => (
						<a class="photo-tile" href={photo.src.src} target="_blank" rel="noreferrer" aria-label={`Abrir foto ${index + 1} de Taberna La Charata`}>
							<Image
								src={photo.src}
								alt={photo.alt}
								widths={[320, 480, 640]}
								sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
								format="webp"
								quality={65}
								loading={index < 2 ? 'eager' : 'lazy'}
								decoding="async"
							/>
						</a>
					))}
				</div>
			</section>

			<section class="casa-section" id="casa" aria-labelledby="casa-title">
				<p class="section-label"><span>01 /</span> DE LA CASA</p>
				<div class="casa-head"><h2 id="casa-title">Recetas de la abuela<br /><em>Josefina.</em></h2><p class="casa-lead">Comida casera, de cuchara y de barra. Estos son los platos que más se piden en La Charata.</p></div>
				<ul class="casa-list">
					{specialties.map((dish) => (
						<li class="casa-item"><strong>{dish.name}</strong><small>{dish.note}</small></li>
					))}
				</ul>
				<p class="casa-foot">Y mucho más en la pizarra del local. También para llevar a casa.</p>
			</section>

			<section class="about-section" aria-labelledby="about-title">
				<p class="section-label"><span>02 /</span> TABERNA LA CHARATA</p>
				<div class="about-content"><h2 id="about-title">Cocina casera,<br /><em>de verdad.</em></h2><div><p>Somos una taberna familiar en el centro de Rincón de la Victoria, a un paso del Ayuntamiento. Aquí se cocina como en casa: producto fresco, recetas de siempre y raciones generosas, con un tapeo honesto y precios de barrio. El local es pequeño y tiene terraza, así que ven con tiempo y disfruta.</p><a class="social-link" href={instagramUrl} target="_blank" rel="noreferrer">Síguenos en Instagram <span aria-hidden="true">↗</span></a></div></div>
				<div class="about-footer"><span>TAPAS · CASERO · DE CUCHARA</span><span>29730 RINCÓN DE LA VICTORIA</span><span>✦</span></div>
			</section>

			<section class="contact-section" id="contacto" aria-labelledby="contact-title">
				<p class="section-label"><span>03 /</span> VISÍTANOS</p>
				<div class="contact-layout">
					<div class="contact-copy"><p class="contact-kicker">EN EL CENTRO DEL PUEBLO</p><h2 id="contact-title">Ven a<br /><em>tapear.</em></h2>
						<div class="contact-card">
							<div class="contact-row"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div></div>
							<div class="contact-row"><span aria-hidden="true">✦</span><div><small>REDES</small><a href={instagramUrl} target="_blank" rel="noreferrer">@tabernalacharata_ ↗</a></div></div>
						</div>
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-card"><div class="map-header"><span><i></i> CALLE CÓRDOBA · RINCÓN DE LA VICTORIA</span><a href={mapsUrl} target="_blank" rel="noreferrer">ABRIR MAPS ↗</a></div><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Taberna La Charata en Calle Córdoba, Rincón de la Victoria" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div><div class="map-footer"><span aria-hidden="true">⌖</span><div><strong>{business.name}</strong><small>{business.streetAddress} · {business.city}</small></div><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar a Taberna La Charata">↗</a></div></div>
				</div>
				<div class="social-row"><span>ENCUÉNTRANOS TAMBIÉN EN</span><a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a></div>
			</section>
		</main>

		<footer class="site-footer"><a class="brand footer-brand" href="#inicio" aria-label="Taberna La Charata, volver al inicio"><span class="brand-mark">LC</span><span class="brand-label">LA CHARATA <small>TABERNA · RINCÓN DE LA VICTORIA</small></span></a><p>{business.streetAddress}<br />{business.postalCode} {business.city}</p><a class="footer-social" href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a><small>© {new Date().getFullYear()} Taberna La Charata · Rincón de la Victoria &nbsp;·&nbsp; Consulta la carta y los horarios en el local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/taberna-la-charata/aviso-legal">Aviso legal</a>
			<a href="/taberna-la-charata/aviso-legal#privacidad">Privacidad</a>
			<a href="/taberna-la-charata/aviso-legal#cookies">Cookies</a>
		</nav>
	</footer>
		<a class="action-cta" href={directionsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Cómo llegar a La Charata <strong>{business.city}</strong></a>

						</body>
</html>


