---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/rey-kebab-el-atabal-apaisada-01.jpg';
import rotulo from '../assets/fotos/rey-kebab-el-atabal-apaisada-02.jpg';
import pizzas from '../assets/fotos/rey-kebab-el-atabal-apaisada-04.jpg';
import plato from '../assets/fotos/rey-kebab-el-atabal-apaisada-05.jpg';
import barra from '../assets/fotos/rey-kebab-el-atabal-apaisada-07.jpg';
import doner from '../assets/fotos/rey-kebab-el-atabal-vertical-03.jpg';
import patatas from '../assets/fotos/rey-kebab-el-atabal-vertical-06.jpg';
import costillas from '../assets/fotos/rey-kebab-el-atabal-vertical-08.jpg';
import mesas from '../assets/fotos/rey-kebab-el-atabal-vertical-09.jpg';
import pizza from '../assets/fotos/rey-kebab-el-atabal-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	MENU_NOTE,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Rey Kebab El Atabal · Kebab, durum y pizzas en Teatinos (Málaga)';
const description = BUSINESS.description;

const galeria = [
	{
		src: rotulo,
		alt: 'Rótulo rojo de Rey Kebab con el cartel de döner kebab, pizzas y comida turca sobre la fachada verde',
	},
	{
		src: pizzas,
		alt: 'Dos pizzas de Rey Kebab recién hechas en sus cajas, una de carne y otra de salami',
	},
	{
		src: plato,
		alt: 'Plato de kebab de Rey Kebab con carne de pollo, arroz, patatas fritas y ensalada',
	},
	{
		src: barra,
		alt: 'Barra de Rey Kebab con la pizarra de precios iluminada y las cajas de pizza apiladas',
	},
	{
		src: doner,
		alt: 'Pieza de carne de döner asándose en el pincho vertical del asador de Rey Kebab',
	},
	{
		src: patatas,
		alt: 'Patatas fritas de Rey Kebab en un cuenco de barro cubiertas de queso fundido y salsa blanca',
	},
	{
		src: costillas,
		alt: 'Bandeja de costillas de cordero asadas con pimientos y tomate de Rey Kebab',
	},
	{
		src: mesas,
		alt: 'Sala de Rey Kebab con mesas blancas, sillas verdes y el televisor encendido',
	},
	{
		src: pizza,
		alt: 'Pizza de Rey Kebab con jamón y champiñones sobre un plato blanco',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Rey Kebab El Atabal',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price && /^\d+,\d{2} €$/.test(item.price)
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#rey-kebab`,
	name: BUSINESS.name,
	alternateName: [
		'Rey Kebab',
		'Rey Kebab El Atabal',
		'Rey Kebab Málaga',
		'Kebab Teatinos',
	],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Turca', 'Kebab', 'Pizza'],
	hasMenu: menuSchema,
	hasDeliveryMethod: 'http://purl.org/goodrelations/v1#DeliveryModeOwnFleet',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'Neighborhood', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google Maps feature ID', value: BUSINESS.featureId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '12:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '19:00',
			closes: '24:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	review: RESENAS.map((resena) => ({
		'@type': 'Review',
		reviewBody: resena.texto,
		reviewRating: {
			'@type': 'Rating',
			ratingValue: resena.valor,
			bestRating: 5,
		},
		author: { '@type': 'Person', name: 'Cliente de Google Maps' },
	})),
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Servicio a domicilio', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Para llevar', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"rey-kebab-el-atabal-apaisada-01.jpg": fachada,
	"rey-kebab-el-atabal-apaisada-02.jpg": rotulo,
	"rey-kebab-el-atabal-apaisada-04.jpg": pizzas,
	"rey-kebab-el-atabal-apaisada-05.jpg": plato,
	"rey-kebab-el-atabal-apaisada-07.jpg": barra,
	"rey-kebab-el-atabal-vertical-03.jpg": doner,
	"rey-kebab-el-atabal-vertical-06.jpg": patatas,
	"rey-kebab-el-atabal-vertical-08.jpg": costillas,
	"rey-kebab-el-atabal-vertical-09.jpg": mesas,
	"rey-kebab-el-atabal-vertical-10.jpg": pizza,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#14100e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Rey Kebab El Atabal, kebab Teatinos, kebab Málaga, durum Málaga, pizzas Teatinos, comida turca Málaga, kebab a domicilio Málaga, C. Nuzas 22, kebab cerca de la universidad"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Kebab turco, durum y pizzas al horno en la C. Nuzas 22 (Teatinos-Universidad, Málaga). Abierto todos los días de 12:00 a 16:00 y de 19:00 a 24:00, con servicio a domicilio."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Rey Kebab El Atabal con el rótulo rojo y la terraza en la calle Nuzas"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#14100e"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/rey-kebab-el-atabal/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Rey Kebab"
			subtitle="Comida turca · El Atabal"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, precios y carta antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Rey Kebab"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34952629694?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carta%20de%20Rey%20Kebab%20El%20Atabal." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carta de Rey Kebab El Atabal"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
