---
import { BUSINESS, HOURS } from '../data/site';
import Layout from '../layouts/Layout.astro';
import Galeria from '../components/Galeria.astro';
const faq = [
	{
		question: '¿Dónde está la Clínica Dental Manuel Carmona González?',
		answer: `La clínica está en ${BUSINESS.street}, ${BUSINESS.postalCode}, en el distrito de ${BUSINESS.district}, Málaga. Puedes abrir su ubicación en Google Maps desde esta página.`,
	},
	{
		question: '¿Cómo puedo contactar con la clínica?',
		answer: `Puedes llamar al ${BUSINESS.phoneDisplay}. Para solicitar una cita o confirmar disponibilidad, contacta directamente con la clínica.`,
	},
	{
		question: '¿Cuál es el horario de la clínica dental?',
		answer: 'El horario publicado indica atención de lunes a viernes y cierre durante el fin de semana. Los horarios pueden cambiar; recomendamos llamar para confirmarlos antes de acudir.',
	},
	{
		question: '¿Dónde puedo ver fotos del establecimiento?',
		answer: 'La galería de fotos y las imágenes compartidas por usuarios se consultan directamente en la ficha de Google Maps de la clínica.',
	},
];
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};
---

<Layout>
	<header class="sticky top-0 z-50 border-b border-base-300/70 bg-base-100/90 backdrop-blur-lg">
		<div class="mx-auto flex min-h-18 max-w-7xl items-center justify-between gap-4 px-5 py-3 lg:px-8">
			<a href="#inicio" class="flex items-center gap-3" aria-label={`${BUSINESS.name}, inicio`}>
				<span class="flex size-11 items-center justify-center rounded-2xl bg-primary text-primary-content"><i class="ri-health-book-line text-2xl" aria-hidden="true"></i></span>
				<span class="max-w-64 leading-tight"><span class="font-display block text-sm font-extrabold sm:text-base">Clínica Dental</span><span class="block text-xs text-base-content/65">Manuel Carmona González · Málaga</span></span>
			</a>
			<nav class="hidden items-center gap-7 text-sm font-semibold text-base-content/75 md:flex" aria-label="Navegación principal">
				<a class="hover:text-primary" href="#clinica">La clínica</a><a class="hover:text-primary" href="#horario">Horario</a><a class="hover:text-primary" href="#ubicacion">Ubicación</a>
			</nav>
			<a href={BUSINESS.phoneHref} class="btn btn-primary btn-sm gap-2 rounded-full px-4"><i class="ri-phone-line" aria-hidden="true"></i><span class="hidden sm:inline">{BUSINESS.phoneDisplay}</span><span class="sm:hidden">Llamar</span></a>
		</div>
	</header>

	<main>
		<section id="inicio" class="dental-hero relative overflow-hidden">
			<div class="dental-grid pointer-events-none absolute inset-0 opacity-40"></div>
			<div class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 sm:py-24 lg:grid-cols-[1.04fr_.96fr] lg:px-8 lg:py-28">
				<div class="max-w-2xl">
					<p class="section-kicker inline-flex items-center gap-2 text-xs font-bold uppercase"><i class="ri-map-pin-2-line" aria-hidden="true"></i>Bailén-Miraflores · Málaga</p>
					<h1 class="font-display mt-5 text-4xl leading-[1.1] font-extrabold tracking-tight text-primary sm:text-6xl">Clínica Dental<br /><span class="text-base-content">Manuel Carmona González</span></h1>
					<p class="mt-6 max-w-xl text-lg leading-relaxed text-base-content/75">Consulta dental en <strong>{BUSINESS.street}, Málaga</strong>. Encuentra aquí el teléfono, el horario publicado y la ubicación para llegar fácilmente.</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a href={BUSINESS.phoneHref} class="btn btn-primary btn-lg gap-2 rounded-full"><i class="ri-phone-line" aria-hidden="true"></i>Llamar a la clínica</a>
						<a href={BUSINESS.googleMaps} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-lg gap-2 rounded-full border-primary/30"><i class="ri-map-pin-line" aria-hidden="true"></i>Cómo llegar</a>
					</div>
					<div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm text-base-content/70"><span><i class="ri-map-pin-line mr-2 text-primary" aria-hidden="true"></i>C/ José Iturbi, 1</span><span><i class="ri-time-line mr-2 text-primary" aria-hidden="true"></i>Lunes a viernes</span></div>
				</div>
				<div class="relative mx-auto w-full max-w-lg">
					<div class="hero-art soft-shadow relative flex aspect-[1.05/1] items-center justify-center overflow-hidden rounded-[2rem] border border-white/80">
						<div class="dental-grid absolute inset-0 opacity-60"></div>
						<div class="absolute top-8 left-8 size-20 rounded-full bg-white/35 blur-xl"></div>
						<svg class="relative w-[78%] max-w-[360px] drop-shadow-xl" viewBox="0 0 420 400" role="img" aria-labelledby="tooth-title tooth-desc" xmlns="http://www.w3.org/2000/svg">
							<title id="tooth-title">Ilustración original de un diente</title><desc id="tooth-desc">Gráfico decorativo de una sonrisa, no es una fotografía de la clínica.</desc>
							<path d="M111 61c-27 1-52 18-59 46-11 43 14 90 30 128 14 35 17 99 43 104 26 5 38-68 56-91 13-16 25-16 38 0 18 23 30 96 56 91 26-5 29-69 43-104 16-38 41-85 30-128-7-28-32-45-59-46-26-1-48 17-70 17s-44-18-70-17Z" fill="#fffdf7" stroke="#1d5c53" stroke-width="9" stroke-linejoin="round"/>
							<path d="M107 112c12-16 32-20 47-10M266 102c15-10 35-6 47 10" fill="none" stroke="#bbd8cd" stroke-width="10" stroke-linecap="round"/>
							<path d="M152 179c17 13 36 19 58 19s41-6 58-19" fill="none" stroke="#d9a255" stroke-width="8" stroke-linecap="round"/>
							<circle cx="139" cy="147" r="8" fill="#1d5c53"/><circle cx="281" cy="147" r="8" fill="#1d5c53"/>
							<path d="M75 273c-15 2-25 16-22 30m294-30c15 2 25 16 22 30" fill="none" stroke="#73a89a" stroke-width="7" stroke-linecap="round"/>
						</svg>
						<div class="absolute right-5 bottom-5 left-5 flex items-center gap-3 rounded-2xl border border-white/60 bg-white/80 p-4 shadow-lg backdrop-blur-sm"><span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-secondary/20 text-primary"><i class="ri-map-pin-user-line text-xl" aria-hidden="true"></i></span><span><strong class="block text-sm">En Málaga, cerca de ti</strong><span class="text-xs text-base-content/65">Bailén-Miraflores · 29010</span></span></div>
					</div>
					<p class="mt-3 text-center text-xs text-base-content/55">Ilustración original decorativa; no es una fotografía del establecimiento.</p>
					<a class="mx-auto mt-2 inline-flex items-center justify-center gap-2 text-xs font-semibold text-primary underline-offset-4 hover:underline" href={BUSINESS.googlePhotos} target="_blank" rel="noopener noreferrer"><i class="ri-google-line" aria-hidden="true"></i>Ver fotos de la clínica en Google Maps</a>
				</div>
			</div>
		</section>

		<section id="clinica" class="bg-base-100 py-18 sm:py-24">
			<div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-[.85fr_1.15fr] lg:px-8">
				<div><p class="section-kicker text-xs font-bold uppercase">Información de contacto</p><h2 class="font-display mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Tu clínica dental en Málaga</h2><p class="mt-5 leading-relaxed text-base-content/70">La Clínica Dental Manuel Carmona González está situada en la calle José Iturbi, en el distrito de Bailén-Miraflores. Consulta directamente con el centro para pedir cita o resolver cualquier duda sobre la atención disponible.</p><p class="mt-4 text-sm leading-relaxed text-base-content/60">La información de esta página sirve como referencia. Confirma por teléfono los detalles antes de acudir.</p></div>
				<div class="grid gap-4 sm:grid-cols-2">
					<article class="rounded-3xl border border-base-300 bg-base-100 p-6 shadow-sm"><span class="flex size-12 items-center justify-center rounded-2xl bg-secondary/20 text-primary"><i class="ri-map-pin-line text-2xl" aria-hidden="true"></i></span><h3 class="font-display mt-4 text-lg font-bold">Dirección</h3><address class="mt-2 text-sm leading-relaxed text-base-content/70 not-italic">{BUSINESS.street}<br />{BUSINESS.postalCode} {BUSINESS.city}</address><a href={BUSINESS.googleMaps} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-primary">Ver en Google Maps <i class="ri-arrow-right-line" aria-hidden="true"></i></a></article>
					<article class="rounded-3xl border border-base-300 bg-base-100 p-6 shadow-sm"><span class="flex size-12 items-center justify-center rounded-2xl bg-secondary/20 text-primary"><i class="ri-phone-line text-2xl" aria-hidden="true"></i></span><h3 class="font-display mt-4 text-lg font-bold">Teléfono</h3><p class="mt-2 text-sm text-base-content/70">Contacta directamente con la clínica.</p><a href={BUSINESS.phoneHref} class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-primary">{BUSINESS.phoneDisplay} <i class="ri-arrow-right-line" aria-hidden="true"></i></a></article>
				</div>
			</div>
		</section>

		<section id="horario" class="bg-base-200/60 py-18 sm:py-24">
			<div class="mx-auto grid max-w-7xl gap-10 px-5 lg:grid-cols-[.8fr_1.2fr] lg:px-8">
				<div><p class="section-kicker text-xs font-bold uppercase">Planifica tu visita</p><h2 class="font-display mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Horario de la clínica</h2><p class="mt-5 leading-relaxed text-base-content/70">Horario publicado en directorios consultados. Puede cambiar en festivos o por circunstancias del centro; recomendamos confirmar por teléfono.</p><a href={BUSINESS.phoneHref} class="btn btn-primary mt-6 gap-2 rounded-full"><i class="ri-phone-line" aria-hidden="true"></i>Confirmar horario</a></div>
				<div class="overflow-hidden rounded-3xl border border-base-300 bg-base-100 shadow-sm"><ul class="divide-y divide-base-300">{HOURS.map((item) => <li class="flex flex-wrap items-center justify-between gap-2 px-5 py-4 text-sm sm:px-7"><span class="font-semibold">{item.day}</span><span class={item.time === 'Cerrado' ? 'text-base-content/50' : 'font-medium text-base-content/75'}>{item.time}</span></li>)}</ul></div>
			</div>
		</section>

		<section id="ubicacion" class="bg-base-100 py-18 sm:py-24">
			<div class="mx-auto max-w-7xl px-5 lg:px-8">
				<div class="mx-auto max-w-2xl text-center"><p class="section-kicker text-xs font-bold uppercase">Cómo llegar</p><h2 class="font-display mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Clínica dental en Bailén-Miraflores</h2><p class="mt-4 text-base-content/70">C/ José Iturbi, 1 · 29010 Málaga</p></div>
				<div class="map-frame mt-10 overflow-hidden rounded-[2rem] border border-base-300 bg-base-200 shadow-sm"><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe src={BUSINESS.googleMapsEmbed} title={`Mapa para llegar a ${BUSINESS.name}, Málaga`} width="100%" height="440" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
				</div></div>
				<div class="mt-5 flex flex-wrap justify-center gap-3"><a href={BUSINESS.googleMaps} target="_blank" rel="noopener noreferrer" class="btn btn-primary gap-2 rounded-full"><i class="ri-navigation-line" aria-hidden="true"></i>Abrir indicaciones</a><a href={BUSINESS.googlePhotos} target="_blank" rel="noopener noreferrer" class="btn btn-outline gap-2 rounded-full"><i class="ri-image-line" aria-hidden="true"></i>Ver fotos en Google Maps</a></div>
			</div>
		</section>

		<section class="bg-primary py-16 text-primary-content sm:py-20">
			<div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-7 px-5 sm:flex-row sm:items-center lg:px-8"><div><p class="text-xs font-bold tracking-[.16em] text-secondary uppercase">Clínica Dental Manuel Carmona González</p><h2 class="font-display mt-3 text-2xl font-extrabold sm:text-3xl">Contacta para solicitar información</h2><p class="mt-2 text-sm text-white/75">C/ José Iturbi, 1 · Málaga</p></div><a href={BUSINESS.phoneHref} class="btn btn-secondary btn-lg gap-2 rounded-full"><i class="ri-phone-line" aria-hidden="true"></i>{BUSINESS.phoneDisplay}</a></div>
		</section>

		<section id="preguntas" class="bg-base-100 py-18 sm:py-24">
			<div class="mx-auto max-w-4xl px-5 lg:px-8"><div class="text-center"><p class="section-kicker text-xs font-bold uppercase">Resolvemos tus dudas</p><h2 class="font-display mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Preguntas frecuentes</h2></div><div class="mt-9 space-y-3">{faq.map((item) => <details class="collapse-arrow rounded-2xl border border-base-300 bg-base-100"><summary class="collapse-title font-display font-bold">{item.question}</summary><div class="collapse-content text-sm leading-relaxed text-base-content/70">{item.answer}</div></details>)}</div></div>
		</section>
		<Galeria nombre="Clínica Dental Manuel Carmona González" />
	</main>

	<footer class="bg-neutral text-neutral-content">
		<div class="mx-auto grid max-w-7xl gap-8 px-5 py-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr] lg:px-8">
			<div><p class="font-display text-lg font-extrabold">{BUSINESS.name}</p><p class="mt-3 max-w-md text-sm leading-relaxed text-white/65">Consulta dental en Bailén-Miraflores, Málaga. Información de contacto y localización.</p></div>
			<div><p class="font-bold">Dirección</p><address class="mt-3 text-sm leading-relaxed text-white/65 not-italic">{BUSINESS.street}<br />{BUSINESS.postalCode} {BUSINESS.city}</address></div>
			<div><p class="font-bold">Contacto</p><a href={BUSINESS.phoneHref} class="mt-3 block text-sm text-white/75 hover:text-secondary">{BUSINESS.phoneDisplay}</a><a href={BUSINESS.googleMaps} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm text-white/75 hover:text-secondary">Cómo llegar en Google Maps</a></div>
		</div>
		<div class="border-t border-white/10 px-5 py-4 text-center text-xs text-white/50">© {new Date().getFullYear()} {BUSINESS.name} · Málaga · <a href="/clinica-dental-manuel-carmona/aviso-legal" class="hover:text-secondary underline">Aviso legal</a> <a href="/clinica-dental-manuel-carmona/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a> · <a href="/clinica-dental-manuel-carmona/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a> </div>
	
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small>
			</p>
</footer>
	<a href={BUSINESS.phoneHref} class="btn btn-primary btn-lg fixed right-4 bottom-4 z-40 gap-2 rounded-full shadow-xl md:hidden" aria-label={`Llamar a ${BUSINESS.name} al ${BUSINESS.phoneDisplay}`}><i class="ri-phone-fill" aria-hidden="true"></i>Llamar</a>
	
</Layout>
