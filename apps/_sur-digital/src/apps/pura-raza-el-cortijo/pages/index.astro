---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/pura-raza-el-cortijo-apaisada-06.jpg';
import foto1 from '../assets/fotos/pura-raza-el-cortijo-vertical-01.jpg';
import foto2 from '../assets/fotos/pura-raza-el-cortijo-vertical-02.jpg';
import foto3 from '../assets/fotos/pura-raza-el-cortijo-apaisada-03.jpg';
import foto4 from '../assets/fotos/pura-raza-el-cortijo-vertical-04.jpg';
import foto5 from '../assets/fotos/pura-raza-el-cortijo-apaisada-05.jpg';

const business = {
	name: 'Pura Raza el Cortijo',
	street: 'Pl. Santiago, 1',
	city: 'Burgos',
	postalCode: '09007',
	phone: '+34 676 32 55 56',
	latitude: 42.3500443,
	longitude: -3.6689609,
	site: 'https://www.sur-digital.com/pura-raza-el-cortijo',
};

const mapsUrl =
	'https://www.google.com/maps/place/Pura+Raza+el+Cortijo/data=!4m7!3m6!1s0xd45e2d502ac2fff:0x846cbc102d75f81b!8m2!3d42.3500443!4d-3.6689609!16s%2Fg%2F11fx90xt7c!19sChIJ_y-sAtXiRQ0RG_h1LRC8bIQ?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34676325556';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'El más pedido',
		title: 'Menú del día',
		text: 'El motivo por el que muchos repiten: raciones generosas, vino aceptable incluido, café y postre. Calidad y cantidad a buen precio entre semana.',
	},
	{
		kicker: 'De la brasa',
		title: 'Carnes Pura Raza',
		text: 'Solomillo a la parrilla, chuletón trinchado, entrecot en su punto y cachopo suculento. La casa presume de excelentes carnes en presentación y precio.',
	},
	{
		kicker: 'Para compartir',
		title: 'Huevos y raciones',
		text: 'Huevos rotos con cecina, chopitos, arroz caldoso, morros y torreznos en su punto. Platos citados una y otra vez en las reseñas de clientes.',
	},
	{
		kicker: 'Para picar',
		title: 'Tapas y entrantes',
		text: 'Ensaladilla rusa, embutidos, quesos y el detalle de la casa: tapa de chorizo para abrir boca. Ideal en barra o en terraza.',
	},
	{
		kicker: 'También pescado',
		title: 'Pescados y arroces',
		text: 'Junto a la carne, pescados y raciones perfectas según la descripción del propio local. Pregunta por el fuera de carta del día.',
	},
	{
		kicker: 'El final dulce',
		title: 'Postres caseros',
		text: 'Coulant de chocolate con nata y postres del menú para cerrar. Grupos grandes bien atendidos incluso con poco tiempo para comer.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de Pura Raza el Cortijo publicada en su ficha de Google Maps (Burgos)' },
	{ src: photos.foto2, alt: 'Interior de Pura Raza el Cortijo, restaurante en la plaza de Santiago, Burgos' },
	{ src: photos.foto3, alt: 'Fotografía de Pura Raza el Cortijo en Burgos, desde Google Maps' },
	{ src: photos.foto4, alt: 'Imagen de Pura Raza el Cortijo (plaza de Santiago, Burgos) subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Detalle de Pura Raza el Cortijo en Burgos según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está Pura Raza el Cortijo?',
		a: 'En la plaza de Santiago, 1, 09007 Burgos (España). Coordenadas 42.3500443, -3.6689609. Es el restaurante-bar conocido como El Cortijo del Pura Raza.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Lunes de 9:00 a 23:00, miércoles y jueves de 9:00 a 23:00, viernes de 9:00 a 24:00, sábado de 11:00 a 24:00 y domingo de 11:00 a 23:00. Los martes permanece cerrado. Confirma festivos por teléfono.',
	},
	{
		q: '¿Cómo reservo mesa?',
		a: 'Llamando al 676 32 55 56. Para grupos grandes (hay reseñas de grupos de más de 30 personas) conviene reservar con antelación: el servicio es rápido incluso con poco tiempo.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Menú del día con raciones generosas, carnes a la brasa (solomillo, chuletón, entrecot, cachopo), huevos rotos con cecina, arroz caldoso, chopitos, torreznos, ensaladilla y coulant de chocolate.',
	},
	{
		q: '¿Tiene terraza y es accesible?',
		a: 'Sí, tiene terraza y figuras de accesibilidad en su ficha: acceso, aparcamiento, aseo y asientos adaptados para sillas de ruedas. También atiende grupos y celebraciones.',
	},
];

const images = [
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'Pura Raza el Cortijo en Burgos (plaza de Santiago, 1): menú del día generoso, carnes a la brasa, huevos rotos con cecina y trato de barrio. Reserva en el 676 32 55 56.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 676 32 55 56',
	image: images,
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo, tarjeta de crédito',
	servesCuisine: ['Española', 'Carnes a la brasa', 'Mediterránea', 'Tapas'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Castilla y León',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday'],
			opens: '09:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Friday',
			opens: '09:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '11:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '11:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Ideal para grupos', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.4,
		reviewCount: 1138,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1b1714" />
		<meta
			name="description"
			content="Pura Raza el Cortijo en Burgos: menú del día generoso y carnes a la brasa en la plaza de Santiago, 1. Reserva en el 676 32 55 56."
		/>
		<meta
			name="keywords"
			content="Pura Raza el Cortijo Burgos, restaurante plaza Santiago Burgos, menú del día Burgos, carnes a la brasa Burgos, cachopo Burgos, huevos rotos cecina, chuletón Burgos"
		/>
		<meta name="author" content="Pura Raza el Cortijo" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/pura-raza-el-cortijo/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Pura Raza el Cortijo | Menú del día y brasa en Burgos</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Pura Raza el Cortijo · Menú del día y brasa en Burgos" />
		<meta
			property="og:description"
			content="Raciones generosas, solomillo, chuletón, cachopo y huevos rotos con cecina en la plaza de Santiago, 1 (Burgos). Lunes, miércoles a domingo."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="Pura Raza el Cortijo, restaurante en Burgos" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Castilla y León" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Pura Raza el Cortijo · Menú del día y brasa en Burgos" />
		<meta
			name="twitter:description"
			content="Menú del día generoso y carnes a la brasa en la plaza de Santiago, 1 (Burgos)."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Burgos" />
		<meta name="geo.position" content="42.3500443;-3.6689609" />
		<meta name="ICBM" content="42.3500443, -3.6689609" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Pura Raza el Cortijo, inicio">
				<span class="brand-mark" aria-hidden="true">P</span>
				<span class="brand-name">Pura Raza el Cortijo <small>Burgos · Pl. Santiago</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cortijo">El cortijo</a>
				<a href="#especialidades">Especialidades</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>676 32 55 56</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Plaza de Santiago · Burgos</p>
					<h1 id="hero-title">Menú del día<br />y carne de verdad<br /><em>en Burgos.</em></h1>
					<p class="hero-lede">
						El Cortijo del Pura Raza en la plaza de Santiago: raciones generosas, carnes y pescados
						perfectos en presentación y precio, y un equipo que quiere que salgas satisfecho en
						calidades y en cantidades.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>
							Reservar 676 32 55 56
						</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,4</b> en Google (1.138 reseñas)</li>
						<li>Menú del día</li>
						<li>Brasa y raciones</li>
						<li>Terraza</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="webp"
						quality={70}
						alt="Fotografía de Pura Raza el Cortijo publicada en su ficha de Google Maps (Burgos)"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,4</b><span>Google</span></div>
					<div><b>1.1k</b><span>Reseñas</span></div>
					<div><b>3,5</b><span>Tripadvisor</span></div>
				</div>
				<ul class="services">
					<li>Terraza</li>
					<li>Local accesible</li>
					<li>Menú del día</li>
					<li>Grupos</li>
					<li>Reservas</li>
					<li>Bar</li>
				</ul>
			</section>

			<section class="about section-pad" id="cortijo">
				<p class="section-label"><span aria-hidden="true"></span> Un cortijo en Burgos</p>
				<div class="about-grid">
					<h2>Calidades y cantidades<br />para salir satisfecho<br /><em>todos los días.</em></h2>
					<div class="about-copy">
						<p>
							Pura Raza el Cortijo está en la plaza de Santiago, 1, 09007 Burgos. Restaurante y bar de
							cocina española donde, en sus propias palabras, el mayor potencial son los clientes y el
							propósito es que se vayan totalmente satisfechos tanto en calidades como en cantidades.
						</p>
						<p>
							Su oferta mezcla menú del día, carnes (solomillo, chuletón, entrecot, cachopo), pescados y
							raciones para compartir: huevos rotos con cecina, chopitos, arroz caldoso, torreznos y
							morros. Servicio rápido incluso para grupos grandes.
						</p>
						<p class="about-note">
							Sobre el horario: la ficha de Google Maps marca lunes, miércoles y jueves de 9:00 a 23:00,
							viernes hasta las 24:00, sábado de 11:00 a 24:00 y domingo de 11:00 a 23:00. Martes cerrado.
							Si vienes en festivo, llama antes.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="especialidades">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su carta</p>
						<h2>Lo que más<br />se pide <em>en la mesa.</em></h2>
					</div>
					<p>
						Platos citados en la descripción del propio local y en las reseñas de sus clientes:
						menú del día, brasa, raciones y postres. La carta cambia, así que confirma disponibilidad al
						reservar.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>El cortijo<br /><em>por dentro.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Pura Raza el Cortijo. En la ficha
							encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="webp"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres
					el titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Plaza de Santiago, 1</p>
					<h2>Ven a comer<br /><em>a Gamonal.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes</th>
								<td>9:00 – 23:00</td>
							</tr>
							<tr>
								<th scope="row">Martes</th>
								<td>Cerrado</td>
							</tr>
							<tr>
								<th scope="row">Miércoles y jueves</th>
								<td>9:00 – 23:00</td>
							</tr>
							<tr>
								<th scope="row">Viernes</th>
								<td>9:00 – 24:00</td>
							</tr>
							<tr>
								<th scope="row">Sábado</th>
								<td>11:00 – 24:00</td>
							</tr>
							<tr>
								<th scope="row">Domingo</th>
								<td>11:00 – 23:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, llama antes de
						venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>
							Llamar 676 32 55 56
						</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 676 32 55 56</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Pura Raza el Cortijo en la plaza de Santiago, 1, Burgos"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Pura Raza el Cortijo · Burgos
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">P</span>
				<p>Pura Raza el Cortijo<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Pura Raza el Cortijo · Burgos. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>

			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
