---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/bar-antonio-jaepi-apaisada-04.jpg';
import foto1 from '../assets/fotos/bar-antonio-jaepi-apaisada-01.jpg';
import foto2 from '../assets/fotos/bar-antonio-jaepi-vertical-02.jpg';
import foto3 from '../assets/fotos/bar-antonio-jaepi-vertical-03.jpg';
import foto4 from '../assets/fotos/bar-antonio-jaepi-apaisada-06.jpg';
import foto5 from '../assets/fotos/bar-antonio-jaepi-apaisada-07.jpg';

const business = {
	name: 'Bar Antonio JAEPI',
	short: 'Antonio JAEPI',
	street: 'C. Fuente, 82',
	city: 'Cabezabellosa',
	region: 'Extremadura',
	province: 'Cáceres',
	postalCode: '10729',
	phone: '+34 659 63 95 00',
	latitude: 40.1393194,
	longitude: -6.0006073,
	site: 'https://www.sur-digital.com/bar-antonio-jaepi',
};

const mapsUrl =
	'https://www.google.com/maps/place/Bar+Antonio+JAEPI/@40.1393194,-6.0006073,17z/data=!3m1!4b1!4m6!3m5!1s0xd3e3faa0eaffb35:0x54511283e86f7730!8m2!3d40.1393194!4d-6.0006073!16s%2Fg%2F11pwy4ndl8?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34659639500';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'La cocina',
		title: 'Comida casera',
		text: '«Comida casera increíble», dicen las reseñas. Platos de siempre, bien hechos y sin pretensiones, como en casa.',
	},
	{
		kicker: 'Para picar',
		title: 'Escalivada y croquetas',
		text: 'Escalivada, ensaladilla rusa y croquetas: lo que más se repite entre las tapas de la casa cuando los clientes cuentan qué comieron.',
	},
	{
		kicker: 'El postre',
		title: 'Postre de fresas',
		text: 'El postre de fresas es el que más se nombra en las reseñas de quien ya ha comido en el bar. Conviene dejarse hueco.',
	},
	{
		kicker: 'El sitio',
		title: 'Vistas al valle',
		text: 'La ficha de Google Maps lo presenta como un bar restaurante con maravillosas vistas al Valle de Cabezabellosa.',
	},
	{
		kicker: 'El trato',
		title: 'Atención cercana',
		text: 'Buena atención y una camarera muy buena gente: el trato es la otra mitad de las reseñas, junto a la comida.',
	},
	{
		kicker: 'Horario',
		title: 'Abierto todos los días',
		text: 'De 10:00 a 22:00 de lunes a jueves, de 11:00 a 23:30 viernes y sábado y de 10:00 a 23:00 el domingo.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de Bar Antonio JAEPI publicada en su ficha de Google Maps (Cabezabellosa)' },
	{ src: photos.foto2, alt: 'Imagen de Bar Antonio JAEPI en Cabezabellosa tomada de su galería de Google Maps' },
	{ src: photos.foto3, alt: 'Fotografía del bar en la calle Fuente, 82, Cabezabellosa' },
	{ src: photos.foto4, alt: 'Imagen de Bar Antonio JAEPI subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Vista de Bar Antonio JAEPI según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está Bar Antonio JAEPI?',
		a: 'En la calle Fuente, 82, 10729 Cabezabellosa (Cáceres). Coordenadas 40.1393194, -6.0006073.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De lunes a jueves abre de 10:00 a 22:00, viernes y sábado de 11:00 a 23:30 y el domingo de 10:00 a 23:00, según su ficha de Google Maps.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Cocina casera y tapas. Entre lo que citan las reseñas están la escalivada, la ensaladilla rusa, las croquetas y el postre de fresas.',
	},
	{
		q: '¿Tiene vistas al valle?',
		a: 'Su ficha lo describe como un bar restaurante donde disfrutar de las maravillosas vistas del Valle de Cabezabellosa.',
	},
	{
		q: '¿Cómo se contacta?',
		a: 'Llamando al 659 63 95 00. Si vienes en festivo o quieres confirmar el horario, es mejor llamar antes.',
	},
];

const images = [
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'Bar Antonio JAEPI, bar de tapas y restaurante en Cabezabellosa (Cáceres): comida casera, tapas y vistas al valle. Llama al 659 63 95 00.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: business.phone,
	image: images,
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Casera', 'Tapas'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '10:00',
			closes: '22:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '11:00',
			closes: '23:30',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '10:00', closes: '23:00' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.6,
		reviewCount: 120,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1b211b" />
		<meta
			name="description"
			content="Bar Antonio JAEPI, bar de tapas y restaurante en Cabezabellosa (Cáceres): comida casera, tapas y vistas al valle. Llama al 659 63 95 00."
		/>
		<meta
			name="keywords"
			content="Bar Antonio JAEPI, bar Cabezabellosa, restaurante Cabezabellosa, comida casera Cáceres, tapas Valle de Cabezabellosa, bar de tapas Cáceres"
		/>
		<meta name="author" content="Bar Antonio JAEPI" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/bar-antonio-jaepi/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Bar Antonio JAEPI | Comida casera en Cabezabellosa</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Bar Antonio JAEPI · Cocina casera y vistas al valle" />
		<meta
			property="og:description"
			content="Bar de tapas y restaurante en Cabezabellosa (Cáceres). Comida casera, croquetas, postre de fresas y vistas al Valle de Cabezabellosa."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="Bar Antonio JAEPI, bar restaurante en Cabezabellosa" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Bar Antonio JAEPI · Cocina casera y vistas al valle" />
		<meta
			name="twitter:description"
			content="Comida casera y tapas en Cabezabellosa (Cáceres), con vistas al valle. Llama al 659 63 95 00."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Cabezabellosa" />
		<meta name="geo.position" content="40.1393194;-6.0006073" />
		<meta name="ICBM" content="40.1393194, -6.0006073" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Bar Antonio JAEPI, inicio">
				<span class="brand-mark" aria-hidden="true">A</span>
				<span class="brand-name">Bar Antonio JAEPI <small>Cabezabellosa · Cáceres</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#bar">El bar</a>
				<a href="#especialidades">La cocina</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>659 63 95 00</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C. Fuente, 82 · Cabezabellosa</p>
					<h1 id="hero-title">Comida casera<br />con vistas al<br /><em>valle.</em></h1>
					<p class="hero-lede">
						Bar Antonio JAEPI es bar de tapas y restaurante en Cabezabellosa (Cáceres). Cocina casera, tapas
						para compartir y el trato cercano que repiten sus reseñas, con las vistas al Valle de
						Cabezabellosa que destaca su ficha.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 659 63 95 00</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,6</b> en Google (120 reseñas)</li>
						<li>Comida casera</li>
						<li>Tapas</li>
						<li>Vistas al valle</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="webp"
						quality={70}
						alt="Bar Antonio JAEPI, bar restaurante en Cabezabellosa (Cáceres)"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,6</b><span>Google</span></div>
					<div><b>120</b><span>Reseñas</span></div>
					<div><b>7/7</b><span>Días</span></div>
				</div>
				<ul class="services">
					<li>Comida casera</li>
					<li>Tapas</li>
					<li>Bar restaurante</li>
					<li>Postres caseros</li>
					<li>Vistas al valle</li>
					<li>Cabezabellosa</li>
				</ul>
			</section>

			<section class="about section-pad" id="bar">
				<p class="section-label"><span aria-hidden="true"></span> Un bar de pueblo en Cabezabellosa</p>
				<div class="about-grid">
					<h2>Cocina de casa<br />en lo alto del<br /><em>valle.</em></h2>
					<div class="about-copy">
						<p>
							Bar Antonio JAEPI está en la calle Fuente, 82, en Cabezabellosa (Cáceres). Es bar de tapas y
							restaurante, con cocina casera y un trato que las reseñas describen como cercano: buena
							atención y una camarera muy buena gente.
						</p>
						<p>
							Su ficha de Google Maps lo presenta como «fantástico bar-restaurante donde disfrutar de las
							maravillosas vistas del Valle de Cabezabellosa». Entre las reseñas se repiten la comida
							casera, la escalivada, la ensaladilla rusa, las croquetas y el postre de fresas.
						</p>
						<p class="about-note">
							Abre todos los días: de 10:00 a 22:00 de lunes a jueves, de 11:00 a 23:30 viernes y sábado y de
							10:00 a 23:00 el domingo. En festivos, llama antes al 659 63 95 00.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="especialidades">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Lo que se pide</p>
						<h2>Platos de casa<br />y tapas <em>para compartir.</em></h2>
					</div>
					<p>
						Lo que más citan sus clientes: comida casera, escalivada, ensaladilla rusa, croquetas y el postre
						de fresas. La carta cambia según el día, así que confirma lo que hay al llegar.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>El bar<br /><em>en imágenes.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Bar Antonio JAEPI. En la ficha
							encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="webp"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres el
					titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C. Fuente, 82</p>
					<h2>Ven al bar<br /><em>a Cabezabellosa.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes a jueves</th>
								<td>10:00 – 22:00</td>
							</tr>
							<tr>
								<th scope="row">Viernes y sábado</th>
								<td>11:00 – 23:30</td>
							</tr>
							<tr>
								<th scope="row">Domingo</th>
								<td>10:00 – 23:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, llama antes de venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar 659 63 95 00</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 659 63 95 00</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Bar Antonio JAEPI en la calle Fuente, 82, Cabezabellosa"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Bar Antonio JAEPI · Cabezabellosa
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">A</span>
				<p>Bar Antonio JAEPI<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Bar Antonio JAEPI · Cabezabellosa. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>

			<p class="footer-credit">
				Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
				<a href="https://sur-digital.vercel.app/" rel="noopener">sur-digital.vercel.app</a>
			</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/bar-antonio-jaepi/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/bar-antonio-jaepi/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/bar-antonio-jaepi/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al bar <span>659 63 95 00</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/bar-antonio-jaepi/aviso-legal">Aviso legal</a>
			<a href="/bar-antonio-jaepi/aviso-legal#privacidad">Privacidad</a>
			<a href="/bar-antonio-jaepi/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
