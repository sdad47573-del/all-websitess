---
import WhatsappFab from '../components/WhatsappFab.astro';
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import heroImage from '../assets/fotos/rincon-del-palo-malaga.jpg';
import foto1 from '../assets/fotos/rincon-del-palo-malaga-foto-1.jpg';
import foto2 from '../assets/fotos/rincon-del-palo-malaga-foto-2.jpg';
import foto3 from '../assets/fotos/rincon-del-palo-malaga-foto-3.png';
import foto4 from '../assets/fotos/rincon-del-palo-malaga-foto-4.png';
import foto5 from '../assets/fotos/rincon-del-palo-malaga-foto-5.png';
import foto6 from '../assets/fotos/rincon-del-palo-malaga-foto-6.jpg';
import foto7 from '../assets/fotos/rincon-del-palo-malaga-foto-7.png';
import foto8 from '../assets/fotos/rincon-del-palo-malaga-foto-8.jpg';
import foto9 from '../assets/fotos/rincon-del-palo-malaga-foto-9.png';
import foto10 from '../assets/fotos/rincon-del-palo-malaga-foto-10.png';

const business = {
	name: 'Rincón del Palo',
	tagline: 'Marisquería-freidemar en Teatinos',
	street: 'C/ Pirandello, 8, local 2',
	district: 'Teatinos-Universidad',
	city: 'Málaga',
	postalCode: '29010',
	phone: '744 61 83 69',
	latitude: 36.7174276,
	longitude: -4.4622472,
	plusCode: 'PG8Q+X4 Málaga',
	site: 'https://www.sur-digital.com/rincon-del-palo',
};

const cid = '0xd72f740fe590985:0xc5087714b4a494c3';
const placeId = 'ChIJhQlZ_kD3cg0Rw5SktBR3CMU';

const mapsUrl = `https://www.google.com/maps/place/Rinc%C3%B3n+del+Palo/@${business.latitude},${business.longitude},17z/data=!3m1!4b1!4m6!3m5!1s${cid}!8m2!3d${business.latitude}!4d${business.longitude}!16s%2Fg%2F11hcf1t3cc`;
const cidUrl = `https://www.google.com/maps?cid=${cid}`;
const reviewsUrl =
	'https://www.google.com/search?q=Rinc%C3%B3n+del+Palo+Teatinos+M%C3%A1laga&ludocid=14197728756099224771#lrd=0x816f16f5a1e0a0dd:0xc5087714b4a494c3';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34744618369';
const instagramUrl = 'https://www.instagram.com/rincondelpalo/';
const facebookUrl = 'https://www.facebook.com/marisqueriafreiduria/';

const description =
	'Rincón del Palo, marisquería y fritura malagueña en Teatinos (Málaga): pescaíto frito, pulpo, almejas, gambas y sardinas a la plancha. C/ Pirandello 8, local 2. Tel. 744 61 83 69.';

const servicios = [
	'Pescaíto frito',
	'Marisco del día',
	'Cocina malagueña',
	'Almejas y conchas finas',
	'Sardinas a la plancha',
	'Terraza cubierta',
	'Comidas y cenas',
	'Para llevar',
	'Accesible para sillas de ruedas',
];

const platos = [
	{
		name: 'Pescaíto frito',
		note: 'el motivo principal de la casa, con fritura de la mejor materia prima',
	},
	{
		name: 'Pulpo frito y pulpo a la gallega',
		note: 'las dos preparaciones más citadas en las reseñas de Google',
	},
	{
		name: 'Almejas malagueñas y conchas finas',
		note: 'marisco de la costa, servido fresco y bien frío',
	},
	{ name: 'Gambas', note: 'cocidas o a la plancha, reseñadas por su sabor' },
	{
		name: 'Buchones de rosada',
		note: 'especialidad de la casa, recomendada por los clientes',
	},
	{
		name: 'Peregrinas',
		note: 'otro de los platos que más se repiten en las opiniones',
	},
	{
		name: 'Sardinas a la plancha',
		note: 'con limón y pan, el clásico de las noches de verano',
	},
	{
		name: 'Berenjenas fritas',
		note: 'acompañamiento habitual de la fritura malagueña',
	},
	{
		name: 'Cañaíllas',
		note: 'ración de pescado azul muy solicitada en temporada',
	},
	{ name: 'Tortitas y cerveza', note: 'para el poste o la sobremesa malagueña' },
];

const galeria = [
	{
		src: foto1,
		alt: 'Fotografía de Rincón del Palo publicada en su perfil de Google Maps (Teatinos, Málaga)',
	},
	{
		src: foto6,
		alt: 'Platos de marisco y fritura de Rincón del Palo, marisquería en Teatinos, Málaga',
	},
	{
		src: foto2,
		alt: 'Imagen de Rincón del Palo, pescaíto frito y marisco en la calle Pirandello 8, Málaga',
	},
	{
		src: foto8,
		alt: 'Sardinas a la plancha de Rincón del Palo, restaurante de Teatinos (Málaga)',
	},
	{
		src: foto10,
		alt: 'Publicación de Rincón del Palo con su pescaíto frito y marisco en Google Maps',
	},
	{
		src: foto3,
		alt: 'Foto del local de Rincón del Palo en la plaza de Pirandello, Teatinos-Universidad, Málaga',
	},
	{
		src: foto4,
		alt: 'Rincón del Palo Marisquería-Fritura, imagen compartida en Google Maps',
	},
	{
		src: foto7,
		alt: 'Detalle de Rincón del Palo, marisquería y fritura en Teatinos, Málaga',
	},
	{
		src: foto9,
		alt: 'Rincón del Palo en Málaga, ficha de Google Maps con el nuevo horario del local',
	},
	{
		src: foto5,
		alt: 'Comida de Rincón del Palo, fritura malagueña y marisco en Teatinos',
	},
];

const faqs = [
	{
		q: '¿Dónde está Rincón del Palo en Málaga?',
		a: 'En la calle Pirandello, 8, local 2, en el barrio de Teatinos-Universidad (29010 Málaga), en una extensa plaza con parque infantil junto a la Ciudad de la Justicia. Es un local de marisquería y fritura que se puede comer en la terraza o para llevar.',
	},
	{
		q: '¿Cuál es el horario de Rincón del Palo?',
		a: 'Abre de miércoles a domingo. Según la ficha del restaurante, el servicio va de 11:00 a 16:00 y de 20:00 a 23:00, aunque el propio negocio aclara en sus publicaciones que el horario de atención real al público es de 13:00 a 16:00 para el almuerzo y de 20:15 a 23:00 para la cena, estando en el local desde las 11:00 y desde las 20:00 para recibir a proveedores y gestionar reservas. Los lunes y martes permanece cerrado.',
	},
	{
		q: '¿Qué se come en Rincón del Palo?',
		a: 'Es una marisquería y fritura malagueña: pescaíto frito, marisco y platos de la costa. Entre los platos más citados por los clientes en Google están el pulpo frito y a la gallega, las almejas malagueñas, las conchas finas, las gambas, los buchones de rosada y las peregrinas, además de berenjenas fritas y sardinas a la plancha. También se hacen raciones de cañaíllas en temporada.',
	},
	{
		q: '¿Hay que reservar mesa?',
		a: 'Recomendable, especialmente los fines de semana y para grupos. El teléfono de reservas e información es el 744 61 83 69. Ten en cuenta que el negocio ha comunicado en alguna ocasión que, de forma temporal, no atendía llamadas ni gestionaba reservas y las mesas se asignaban por orden de llegada, así que conviene confirmar la situación por teléfono o en su perfil de Google antes de ir.',
	},
	{
		q: '¿Tiene terraza y accesibilidad?',
		a: 'Sí. La ficha del negocio indica asientos al aire libre y, además, la marisquería dispone de local climatizado y terraza cubierta con toldos y estufas. También figura como accesible para sillas de ruedas y cuenta con servicio para llevar y a domicilio.',
	},
	{
		q: '¿Rincón del Palo sirve para llevar o a domicilio?',
		a: 'Sí. El local ofrece servicio para llevar y pedidos a domicilio, según consta en la ficha de Google. Puedes llamar al 744 61 83 69 para consultar la disponibilidad y recoger en el local o pedir entrega.',
	},
	{
		q: '¿Cómo se llega a Rincón del Palo?',
		a: 'Está en la calle Pirandello, 8, en Teatinos-Universidad, junto a la Ciudad de la Justicia y muy cerca del campus universitario. Puedes llegar en coche por la carretera de Cádiz, y en autobús o taxi hasta la plaza. Desde el centro de Málaga son unos diez minutos en coche.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: 'Rincón del Palo Marisquería-Fritura',
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 744 61 83 69',
	priceRange: '€€€€',
	currenciesAccepted: 'EUR',
	servesCuisine: [
		'Marisquería',
		'Pescados y mariscos',
		'Cocina malagueña',
		'Fritura',
		'Cocina mediterránea',
	],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [instagramUrl, facebookUrl, cidUrl],
	acceptsReservations: 'True',
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: business.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday'],
			opens: '00:00',
			closes: '00:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza al aire libre', value: true },
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza cubierta con toldos y estufas',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Local climatizado', value: true },
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Accesible para sillas de ruedas',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Servicio para llevar', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Pedidos a domicilio', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Reservas', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.5,
		reviewCount: 644,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Qué pedir', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"rincon-del-palo-malaga.jpg": heroImage,
	"rincon-del-palo-malaga-foto-1.jpg": foto1,
	"rincon-del-palo-malaga-foto-6.jpg": foto6,
	"rincon-del-palo-malaga-foto-2.jpg": foto2,
	"rincon-del-palo-malaga-foto-8.jpg": foto8,
	"rincon-del-palo-malaga-foto-10.png": foto10,
	"rincon-del-palo-malaga-foto-3.png": foto3,
	"rincon-del-palo-malaga-foto-4.png": foto4,
	"rincon-del-palo-malaga-foto-7.png": foto7,
	"rincon-del-palo-malaga-foto-9.png": foto9,
	"rincon-del-palo-malaga-foto-5.png": foto5,
};

const horas = [
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: 'Cerrado', closed: true },
					{ day: 'Miércoles', value: '11:00 – 16:00 · 20:00 – 23:00' },
					{ day: 'Jueves', value: '11:00 – 16:00 · 20:00 – 23:00' },
					{ day: 'Viernes', value: '11:00 – 16:00 · 20:00 – 23:00' },
					{ day: 'Sábado', value: '11:00 – 16:00 · 20:00 – 23:00' },
					{ day: 'Domingo', value: '11:00 – 16:00 · 20:00 – 23:00' },
				];
const mapasPagina = {
	place: cidUrl,
	directions: cidUrl,
	streetView: cidUrl,
	embed: mapEmbedUrl,
};

---
<!doctype html>
<html lang="es">
	<head>
		<title>Rincón del Palo | Marisquería y pescaíto en Teatinos, Málaga</title>
		<meta name="theme-color" content="#08222a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Rincón del Palo, marisquería Teatinos Málaga, fritura Málaga, pescaíto frito Teatinos, restaurante Pirandello 8, comer en Teatinos, marisco Málaga, almejas malagueñas, comida en Teatinos-Universidad, Ciudad de la Justicia comer, restaurante 29010 Málaga, fritura malagueña"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Rincón del Palo · Marisquería y fritura malagueña en Teatinos"
			ogDescription="Pescaíto frito, pulpo, almejas, gambas y sardinas a la plancha en la C/ Pirandello 8, local 2 (Teatinos-Universidad, Málaga). 4,5 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Rincón del Palo, marisquería y fritura malagueña en Teatinos, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#08222a"
			street={business.street}
			city={business.city}
			region="Andalucía"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Teatinos-Universidad, Málaga"
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="R"
			name={business.name}
			subtitle="Marisquería · Teatinos, Málaga"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: business.name,
					street: business.street,
					district: business.district ?? '',
					postalCode: business.postalCode,
					city: business.city,
				}}
								horario={horas}
								mapas={mapasPagina}
			/>
		</main>

		<LocalFooter
			mark="R"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: 'Instagram ↗', href: instagramUrl, external: true },
				{ label: 'Facebook ↗', href: facebookUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios y precios antes de la visita."
			ctaLabel="Llamar a Rincón del Palo"
		/>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/rincon-del-palo/aviso-legal">Aviso legal</a>
			<a href="/rincon-del-palo/aviso-legal#privacidad">Privacidad</a>
			<a href="/rincon-del-palo/aviso-legal#cookies">Cookies</a>
		</nav>
		<WhatsappFab phone={phoneHref} />
	</body>
</html>
