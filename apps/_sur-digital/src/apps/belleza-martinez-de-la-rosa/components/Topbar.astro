---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES, NAV } from '../data/site';

interface Props {
	base?: string;
}

const { base = '' } = Astro.props;
---

<div class="border-base-300/70 bg-base-100/85 sticky top-0 z-50 border-b backdrop-blur-md">
	<header
		class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
	>
		<a href={`${base}#inicio`} class="flex items-center gap-3" aria-label={BUSINESS.name}>
			<Image
				src={IMAGES.logo}
				alt=""
				width={44}
				height={44}
				quality={90}
				class="size-10 shrink-0 rounded-md object-cover"
			/>
			<span class="leading-tight">
				<span class="font-display block text-lg font-bold tracking-tight">Belleza</span>
				<span class="text-base-content/60 block text-[0.6rem] tracking-[0.22em] uppercase">
					Suárez · Málaga
				</span>
			</span>
		</a>

		<nav class="hidden items-center gap-6 lg:flex" aria-label="Navegación principal">
			{
				NAV.map((item) => (
					<a
						href={`${base}${item.href}`}
						class="text-base-content/75 hover:text-primary text-sm font-medium transition-colors"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2">
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-ghost btn-sm hidden rounded-full sm:inline-flex"
			>
				<i class="ri-map-pin-line"></i> Cómo llegar
			</a>
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-primary btn-sm gap-2 rounded-full px-4"
			>
				<i class="ri-google-fill text-base"></i>
				<span class="hidden sm:inline">Ficha de Google</span>
				<span class="sm:hidden">Google</span>
			</a>
			<details class="dropdown dropdown-end lg:hidden">
				<summary class="btn btn-ghost btn-sm list-none" aria-label="Abrir menú"
					><i class="ri-menu-line text-xl"></i></summary
				>
				<ul
					class="menu dropdown-content rounded-box border-base-300 bg-base-100 z-50 mt-2 w-56 border p-2 shadow-xl"
				>
					{
						NAV.map((item) => (
							<li>
								<a href={`${base}${item.href}`}>{item.label}</a>
							</li>
						))
					}
					<li>
						<a href={base ? `${base}aviso-legal` : '/belleza-martinez-de-la-rosa/aviso-legal'}>Aviso legal y privacidad</a>
					</li>
				</ul>
			</details>
		</div>
	</header>
</div>
