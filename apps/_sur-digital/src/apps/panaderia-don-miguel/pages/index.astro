---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import fachada from '../assets/fotos/panaderia-don-miguel-apaisada-01.jpg';
import interior from '../assets/fotos/panaderia-don-miguel-apaisada-07.jpg';
import croissants from '../assets/fotos/panaderia-don-miguel-apaisada-10.jpg';
import vitrina from '../assets/fotos/panaderia-don-miguel-vertical-02.jpg';
import tartas from '../assets/fotos/panaderia-don-miguel-vertical-03.jpg';
import mostrador from '../assets/fotos/panaderia-don-miguel-vertical-04.jpg';
import obrador from '../assets/fotos/panaderia-don-miguel-vertical-05.jpg';
import dulces from '../assets/fotos/panaderia-don-miguel-vertical-06.jpg';
import tienda from '../assets/fotos/panaderia-don-miguel-vertical-08.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HOURS, HOURS_NOTE, MAPS, SERVICIOS } from '../data/site';

const title = 'Panadería Don Miguel · Pan de cada día en Cruz de Humilladero, Málaga';
const description =
	'Panadería Don Miguel en C. Corregidor Ruiz de Pereda, 1 (Cruz de Humilladero, 29006 Málaga): pan hecho cada mañana, bollos, tartas por encargo y víveres. 5,0 sobre 5 en Google. Horario y mapa.';
const ratingLabel = BUSINESS.rating.toFixed(1).replace('.', ',');

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#don-miguel`,
	name: BUSINESS.name,
	alternateName: ['Don Miguel', 'Panadería Confitería Don Miguel'],
	description:
		'Panadería de barrio en el Corregidor Ruiz de Pereda, 29006 Málaga, con pan del día, bollos, dulces y tartas por encargo. La ficha de Google le da 5,0 sobre 5 con 6 reseñas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '08:15',
			closes: '14:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '17:15',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '08:15',
			closes: '14:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '17:15',
			closes: '21:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '08:30',
			closes: '14:35',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '17:30',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '09:00',
			closes: '14:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Horario', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const shots = [
	{
		src: mostrador,
		alt: 'Mostrador de Panadería Don Miguel con el expositor de pan, la carro de baguettes y el horno al fondo',
		caption: 'El mostrador',
	},
	{
		src: tartas,
		alt: 'Vitrina refrigerada con tarta de queso, porciones de carrot cake y postres de merengue y chocolate',
		caption: 'Tartas y postres',
	},
	{
		src: obrador,
		alt: 'Carros del obrador cargados con piezas de masa cruda de baguettes y hogazas esperando al horno',
		caption: 'El obrador',
	},
	{
		src: croissants,
		alt: 'Bandeja dorada con cinco croissants recién horneados sobre papel',
		caption: 'Bollería',
	},
	{
		src: vitrina,
		alt: 'Vitrina con tartaletas de fruta, petits fours surtidos y pastelitos individuales',
		caption: 'La vitrina',
	},
	{
		src: dulces,
		alt: 'Mostrador visto desde arriba con donuts, tartas, éclairs y panes rústicos al fondo',
		caption: 'Dulces del día',
	},
	{
		src: interior,
		alt: 'Interior de la tienda con el mural del campo de trigo, sillas azules y la zona de mesas',
		caption: 'El local',
	},
	{
		src: tienda,
		alt: 'Frigoríficos de bebidas, estante de snacks y pizarra con los tipos de pan de la casa',
		caption: 'La tienda',
	},
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#6d3f1e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Don Miguel, panadería Málaga, pan Cruz de Humilladero, tartas por encargo 29006, panadería de barrio Málaga, víveres y bebidas"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería de barrio en el Corregidor Ruiz de Pereda, 29006 Málaga. Pan del día, tartas por encargo y víveres. 5,0 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Panadería Don Miguel en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#6d3f1e"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Panadería Don Miguel, inicio">
					<span class="brand-mark" aria-hidden="true">D</span>
					<span class="brand-name">
						Panadería Don Miguel
						<small>Panadería · Málaga</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-cta" href={MAPS.directions} target="_blank" rel="noreferrer">
					Cómo llegar <span aria-hidden="true">↗</span>
				</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Cruz de Humilladero · 29006 Málaga</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-lede">
							Panadería y confitería en el Corregidor Ruiz de Pereda, 1. La casa anuncia pan
							recién salido del horno todas las mañanas, bollos y dulces, tartas por encargo y
							un surtido de víveres, bebidas y snacks para llevar a casa.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha y reseñas <span aria-hidden="true">↗</span>
							</a>
						</div>
						<p class="hero-note">
							<span>Sin teléfono ni web publicados.</span> La ficha de Google tampoco incluye
							redes sociales del negocio; el encargo de tartas se habla en la tienda.
						</p>
						<ul class="hero-facts">
							<li>
								<b>{ratingLabel} / 5</b>
								{BUSINESS.reviewsCount} reseñas en Google
							</li>
							<li>
								<b>L–J 8:15–14:30</b>
								y de 17:15 a 20:30
							</li>
							<li>
								<b>Corregidor Ruiz de Pereda, 1</b>
								Cruz de Humilladero, {BUSINESS.city}
							</li>
						</ul>
					</div>

					<figure class="hero-photo">
						<Image
							src={fachada}
							alt="Fachada de Panadería Don Miguel con su rótulo granate y la entrada por unas escaleras"
							widths={[480, 760, 1200]}
							sizes="(max-width: 980px) 92vw, 46vw"
							format="webp"
							quality={74}
							priority
							decoding="async"
						/>
						<figcaption>
							<span>Fotos del perfil de Google Maps de la casa</span>
							<a href={MAPS.place} target="_blank" rel="noreferrer">Ver ficha ↗</a>
						</figcaption>
					</figure>
				</div>
			</section>

			<section class="chips-wrap wrap" aria-label="Lo que publica la ficha de Google">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<p class="section-label"><span aria-hidden="true"></span> La casa</p>
				<div class="about-grid">
					<h2 id="about-title">Panadería de barrio <em>en Cruz de Humilladero.</em></h2>
					<div class="about-copy">
						<p>
							Don Miguel es una panadería y confitería del Corregidor Ruiz de Pereda, número 1,
							en el barrio de Cruz de Humilladero. Google la clasifica simplemente como panadería
							y le da 5,0 sobre 5 con 6 reseñas.
						</p>
						<p>
							La casa anuncia en su ficha que el pan se hace cada mañana para que salga recién
							salido del horno, y que en el mostrador hay bollos y dulces. También se pueden
							pedir tartas a gusto para cualquier ocasión; no publica catálogo ni precios, así
							que el encargo se habla directamente en la tienda.
						</p>
						<p>
							El local va más allá del obrador: la ficha incluye víveres, bebidas frías y un
							surtido de patatas y snacks de picar, pensado para completar la compra del día.
						</p>
						<p>
							El horario es partido, con mañana y tarde, y cambia un poco según el día. El 1 de
							noviembre Google advierte de que podría variar: conviene confirmarlo antes de ir.
						</p>
						<div class="about-links">
							<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha en Google Maps <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="three" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas de la casa</p>
							<h2 id="three-title">Lo que sí <em>se sabe.</em></h2>
						</div>
						<p>
							Todo lo que sigue sale de la ficha pública de Google Maps: sin precios ni carta
							publicados, esto es lo que la página puede afirmar.
						</p>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="gallery wrap" id="galeria" aria-labelledby="gallery-title">
				<div class="gallery-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Galería</p>
						<h2 id="gallery-title">La casa, <em>en fotos.</em></h2>
					</div>
					<p>
						Ocho imágenes de la galería del perfil de Google Maps de Don Miguel: la fachada del
						mostrador, las tartas de la vitrina, el obrador con la masa del día y la tienda. Se
						muestran como información del local.
					</p>
				</div>

				<div class="gallery-grid">
					{
						shots.map((shot) => (
							<figure class="shot">
								<Image
									src={shot.src}
									alt={shot.alt}
									widths={[420, 680, 1024]}
									sizes="(max-width: 700px) 92vw, (max-width: 980px) 46vw, 30vw"
									format="webp"
									quality={72}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>{shot.caption}</figcaption>
							</figure>
						))
					}
				</div>

				<p class="gallery-note">
					Fotografías descargadas de la galería pública de Google Maps (octubre de 2026) e
					incluidas como información del establecimiento.
				</p>
			</section>

			<section class="rating" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-figure" aria-hidden="true">
						<span class="rating-number">{ratingLabel}</span>
						<span class="rating-max">/ 5</span>
					</div>
					<div class="rating-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que dice Google</p>
						<h2 id="rating-title">Seis reseñas, <em>cinco estrellas.</em></h2>
						<p>
							La ficha tiene una media de 5,0 sobre 5 con 6 reseñas. Aquí solo se reproduce la
							valoración publicada: las opiniones completas se leen en Google Maps.
						</p>
						<div class="rating-actions">
							<span class="stars stars-large" role="img" aria-label="5 de 5 estrellas">★★★★★</span>
							<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
								Leer las reseñas en Google <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Visítanos</p>
					<h2 id="visit-title">En el Corregidor <em>Ruiz de Pereda.</em></h2>
					<p class="address">
						{BUSINESS.street}<br />
						{BUSINESS.district}<br />
						{BUSINESS.postalCode} {BUSINESS.city}
					</p>

					<table class="hours">
						<caption>Horario publicado en Google</caption>
						<tbody>
							{HOURS.map((row) => (
								<tr>
									<th scope="row">{row.day}</th>
									<td>{row.value}</td>
								</tr>
							))}
						</tbody>
					</table>
					<p class="hours-note">{HOURS_NOTE}</p>

					<div class="visit-links">
						<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
							Ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
					<p class="reserve-note">
						La ficha no publica teléfono, web ni sistema de pedidos online: para encargar una
						tarta conviene pasar por la tienda en horario de mañana o tarde.
					</p>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Panadería Don Miguel en el Corregidor Ruiz de Pereda, Málaga"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Corregidor Ruiz de Pereda, 1 · 29006
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>pasar.</em></h2>
				<div class="faq-list">
					{
						FAQ.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">D</span>
						<p>
							Panadería Don Miguel
							<small>
								Panadería · Confitería<br />
								{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}
							</small>
						</p>
					</div>
					<nav aria-label="Enlaces de la panadería">
						<a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
						<a href={MAPS.reviews} target="_blank" rel="noreferrer">Reseñas ↗</a>
						<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a href="/panaderia-don-miguel/aviso-legal">Aviso legal</a>
					</nav>
				</div>
				<small class="legal">
					© {new Date().getFullYear()} {BUSINESS.name} · Datos y valoración de la ficha pública
					de Google Maps, consultada en octubre de 2026. Las fotografías proceden de la galería
					del perfil del establecimiento en Google Maps. La web no publica teléfono, carta ni
					precios porque la ficha no los incluye.
				</small>
				<nav class="legal-links" aria-label="Información legal">
					<a href="/panaderia-don-miguel/aviso-legal">Aviso legal</a>
					<a href="/panaderia-don-miguel/aviso-legal#privacidad">Privacidad</a>
					<a href="/panaderia-don-miguel/aviso-legal#cookies">Cookies</a>
				</nav>
				<p class="credit">
					<small
						>Creado por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a>
						</small
					>
				</p>
			</div>
		</footer>
	</body>
</html>
