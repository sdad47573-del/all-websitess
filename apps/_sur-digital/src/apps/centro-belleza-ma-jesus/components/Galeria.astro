---
import { Image } from '@astro-components';
import { GALLERY } from '../data/site';
---

<section id="galeria" class="bg-base-100 scroll-mt-20 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">El centro</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">
				Belleza, piel y bienestar en Huelin
			</h2>
			<div class="astyle-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/70 mt-6">
				Fachada, interior, cabina y trabajos de manicura: una muestra real del centro en Huelin.
			</p>
		</div>

		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{
				GALLERY.map((foto) => (
					<figure class="border-base-300 bg-base-100 overflow-hidden rounded-sm border shadow-md">
						<div class="overflow-hidden">
							<Image
								src={foto.src}
								alt={foto.alt}
								widths={[400, 700]}
								sizes="(min-width: 1024px) 24vw, (min-width: 640px) 48vw, 92vw"
								quality={80}
								loading="lazy"
								class="aspect-square w-full object-cover transition-transform duration-500 hover:scale-105"
							/>
						</div>
						<figcaption class="text-base-content/60 px-3 py-2.5 text-xs leading-snug">
							{foto.caption}
						</figcaption>
					</figure>
				))
			}
		</div>
		<p class="text-base-content/50 mt-8 text-center text-xs">
			Fotos del perfil público del centro en Google Maps, mostradas como referencia del local. Si eres el
			titular y prefieres retirarlas, escríbenos y las quitamos.
		</p>
	</div>
</section>
