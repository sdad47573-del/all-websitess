---
import '../styles/global.css';
import { LocalSeo } from '@astro-components';
import { Image } from 'astro:assets';

import heroPhoto from '../assets/fotos/restaurante-mustang-apaisada-04.jpg';
import fachada from '../assets/fotos/restaurante-mustang-apaisada-10.jpg';
import comedor from '../assets/fotos/restaurante-mustang-apaisada-01.jpg';
import coche from '../assets/fotos/restaurante-mustang-vertical-08.jpg';
import solomillos from '../assets/fotos/restaurante-mustang-apaisada-06.jpg';
import entrecote from '../assets/fotos/restaurante-mustang-apaisada-07.jpg';
import pared from '../assets/fotos/restaurante-mustang-apaisada-09.jpg';
import postre from '../assets/fotos/restaurante-mustang-apaisada-03.jpg';
import terraza from '../assets/fotos/restaurante-mustang-apaisada-05.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	RESENAS_NOTA,
} from '../data/site';

const title = 'Restaurante Mustang · Cocina americana en Teatinos, Málaga';
const description = BUSINESS.description;

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de Restaurante Mustang con mesas vestidas de blanco, sillas negras y pósteres de música y coches en las paredes',
		caption: 'El comedor',
		className: 'g1',
	},
	{
		src: coche,
		alt: 'Cadillac rojo clásico aparcado dentro del restaurante, junto a la puerta y los pósteres de coches',
		caption: 'El Cadillac del local',
		className: 'g2',
	},
	{
		src: solomillos,
		alt: 'Plato de solomillos a la plancha con patatas fritas y salsa blanca por encima',
		caption: 'Solomillos con patatas',
		className: 'g3',
	},
	{
		src: entrecote,
		alt: 'Plato de carne a la plancha con sal en escamas, patatas fritas y pan',
		caption: 'Carne a la plancha',
		className: 'g4',
	},
	{
		src: pared,
		alt: 'Pared del restaurante con pósteres de Michael Jackson, John Lennon y The Beatles, matrículas americanas y guantes de boxeo',
		caption: 'La pared',
		className: 'g5',
	},
	{
		src: postre,
		alt: 'Brownie de chocolate con helado de vainilla, nata y sirope de chocolate',
		caption: 'Postre de chocolate',
		className: 'g6',
	},
	{
		src: terraza,
		alt: 'Terraza de Restaurante Mustang de noche, con las sillas rojas ocupadas y el cartel de neón MUSTANG BURGERS',
		caption: 'La terraza, de noche',
		className: 'g7',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante-mustang`,
	name: BUSINESS.fullName,
	alternateName: ['Mustang', 'Mustang Burgers', 'Mustang Teatinos'],
	description:
		'Restaurante americano en C. Juan Francés Bosca, 39 (Teatinos-Universidad, 29010 Málaga): bocadillos, camperos, carnes a la plancha y terraza, hasta las 23:30.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34952109717',
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Cocina americana', 'Bocadillos', 'Carnes a la plancha'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Sunday'],
			opens: '19:30',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Friday',
			opens: '12:30',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '12:00',
			closes: '23:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#local' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const year = new Date().getFullYear();
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#11151d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Mustang Málaga, Mustang Burgers Teatinos, cocina americana Málaga, bocadillos Teatinos, camperos Málaga, carnes a la plancha Teatinos, restaurante Juan Francés Bosca, cenar hasta tarde Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina americana, camperos, bocatas y carnes a la plancha en Teatinos. Terraza y cocina hasta las 23:30. 3,5 sobre 5 con 610 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Terraza nocturna de Restaurante Mustang con el cartel de neón MUSTANG BURGERS"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#11151d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[heroPhoto]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<div class="topline">
			<div class="wrap topline-inner">
				<p>Juan Francés Bosca, 39 · Teatinos</p>
				<p class="topline-hours">Abierto hasta las 23:30</p>
				<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
			</div>
		</div>

		<header class="site-header" id="inicio">
			<div class="wrap header-inner">
				<a class="brand" href="#inicio" aria-label="Restaurante Mustang, inicio">
					<span class="brand-stamp" aria-hidden="true">M</span>
					<span class="brand-name">Café-bar restaurante <strong>Mustang</strong></span>
				</a>
				<nav class="site-nav" aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="header-call" href={BUSINESS.phoneHref}>
					<span aria-hidden="true">☎</span> {BUSINESS.phone}
				</a>
			</div>
			<nav class="mobile-nav wrap" aria-label="Navegación principal en móvil">
				{nav.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
		</header>

		<main id="contenido">
			<section class="hero" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Teatinos · Málaga</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-lede">
							El Mustang lleva años en la esquina de Juan Francés Bosca: <strong>cocina americana</strong>,
							camperos y bocadillos, carnes a la plancha y terraza para alargar la cena hasta las
							23:30.
						</p>
						<div class="hero-actions">
							<a class="btn btn-primary" href={BUSINESS.phoneHref}>Llamar · {BUSINESS.phone}</a>
							<a class="btn btn-ghost" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<strong>{RATING.label} / 5</strong>
								<span>{RATING.count} reseñas en Google</span>
							</li>
							<li>
								<strong>Hasta 23:30</strong>
								<span>todos los días</span>
							</li>
							<li>
								<strong>J. Francés Bosca, 39</strong>
								<span>Teatinos · 29010</span>
							</li>
						</ul>
					</div>

					<figure class="hero-figure">
						<Image
							src={heroPhoto}
							alt="Fachada de Restaurante Mustang de noche, con el cartel de neón MUSTANG BURGERS y la terraza llena de gente"
							widths={[520, 760, 1080]}
							sizes="(max-width: 880px) 92vw, 52vw"
							loading="eager"
							fetchpriority="high"
						/>
						<span class="hero-sticker" aria-hidden="true">
							<small>Café-bar</small>
							<strong>hasta 23:30</strong>
						</span>
						<figcaption class="hero-caption">
							La terraza, de noche <span>Foto del perfil de Google Maps</span>
						</figcaption>
					</figure>
				</div>
			</section>

			<div class="marquee" aria-hidden="true">
				<div class="marquee-track">
					<span>Camperos</span><span>·</span><span>Bocadillos</span><span>·</span><span>Solomillos</span><span>·</span><span>Cocina americana</span><span>·</span><span>Terraza</span><span>·</span><span>Teatinos</span><span>·</span>
					<span>Camperos</span><span>·</span><span>Bocadillos</span><span>·</span><span>Solomillos</span><span>·</span><span>Cocina americana</span><span>·</span><span>Terraza</span><span>·</span><span>Teatinos</span><span>·</span>
				</div>
			</div>

			<section class="about" id="local" aria-labelledby="about-title">
				<div class="wrap">
					<div class="about-grid">
						<div class="about-intro">
							<p class="eyebrow">01 — El local</p>
							<h2 id="about-title">Un diner <em>en Teatinos.</em></h2>
							<div class="about-copy">
								<p>
									Google lo clasifica como «Restaurante americano». En las fotos del perfil se
									entiende por qué: un Cadillac rojo aparcado dentro del comedor, matrículas
									americanas en las paredes, pósteres de discos y coches, y una barra de neón que
									se enciende de noche sobre la terraza.
								</p>
								<p>
									La cocina es de barrio y sin ceremonia: camperos, bocadillos, solomillos y
									patatas fritas. De lunes a jueves y el domingo abre solo por la noche; el
									viernes desde las 12:30 y el sábado desde las 12:00, siempre hasta las 23:30.
								</p>
								<p>
									Con 610 reseñas, la nota de la ficha es 3,5 sobre 5. No es un local de
									unanimidades: hay opiniones muy buenas y también quejas sobre el queso de los
									bocadillos o el tamaño de los solomillos. Esta web no las esconde.
								</p>
							</div>
							<p class="rating-chip">
								<strong>{RATING.label}</strong>
								<span>sobre 5 · {RATING.count} reseñas en Google</span>
							</p>
						</div>

						<figure class="facade">
							<Image
								src={fachada}
								alt="Fachada diurna de Restaurante Mustang con el rótulo rojo MUSTANG BURGERS y la terraza bajo los árboles"
								widths={[420, 640, 900]}
								sizes="(max-width: 980px) 92vw, 40vw"
							/>
							<figcaption>
								<span>Juan Francés Bosca, 39</span>
								El rótulo de la fachada resume la casa: Mustang Burgers, café-bar y restaurante,
								con terraza en la acera.
							</figcaption>
						</figure>
					</div>

					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-number" aria-hidden="true">0{index + 1}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<section class="carta" id="carta" aria-labelledby="carta-title">
				<div class="wrap">
					<header class="section-head">
						<div>
							<p class="eyebrow">02 — La carta</p>
							<h2 id="carta-title">Lo que piden <em>las reseñas.</em></h2>
						</div>
						<p>
							La ficha de Google no publica carta ni precios, así que aquí solo aparecen las
							familias de platos que nombran las opiniones del local. No hay carta inventada.
						</p>
					</header>

					<div class="carta-grid">
						<div class="menu-groups">
							{
								MENU.map((group) => (
									<div class="menu-group">
										<h3>{group.title}</h3>
										<ul>
											{group.items.map((item) => (
												<li class="menu-item">
													<h4>{item.name}</h4>
													<p>{item.note}</p>
												</li>
											))}
										</ul>
									</div>
								))
							}
							<p class="menu-note">
								Los nombres salen de las reseñas publicadas en la ficha de Google. La carta
								completa, los ingredientes y los precios se consultan en el local o por teléfono.
							</p>
						</div>

						<aside class="carta-card" aria-labelledby="carta-card-title">
							<p class="card-kicker">Para pedir</p>
							<h3 id="carta-card-title">Sin carta online. <em>Hay teléfono.</em></h3>
							<p>
								Si quieres saber qué hay, cuánto cuesta o si queda mesa en la terraza, lo más
								rápido es llamar al restaurante.
							</p>
							<a class="card-phone" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
							<p class="card-note">
								C. Juan Francés Bosca, 39 · Teatinos-Universidad, Málaga. Cocina hasta las 23:30.
							</p>
						</aside>
					</div>
				</div>
			</section>

			<section class="gallery" id="galeria" aria-labelledby="gallery-title">
				<div class="wrap">
					<header class="section-head section-head-light">
						<div>
							<p class="eyebrow">03 — Las fotos</p>
							<h2 id="gallery-title">Neón, <em>Cadillac y plancha.</em></h2>
						</div>
						<p>
							Imágenes del perfil público del restaurante en Google Maps: el comedor, el coche, la
							terraza y los platos que salen de la cocina.
						</p>
					</header>

					<div class="gallery-grid">
						{
							galeria.map((photo) => (
								<figure class={photo.className}>
									<Image
										src={photo.src}
										alt={photo.alt}
										widths={[420, 700, 1000, 1400]}
										sizes="(max-width: 640px) 92vw, (max-width: 980px) 46vw, 48vw"
									/>
									<figcaption>{photo.caption}</figcaption>
								</figure>
							))
						}
					</div>

					<p class="gallery-credit">
						Fotografías del perfil público de {BUSINESS.fullName} en Google Maps, consultado en
						octubre de 2026.
						<a href={MAPS.place} target="_blank" rel="noreferrer">
							Ver la ficha completa <span aria-hidden="true">↗</span>
						</a>
					</p>
				</div>
			</section>

			<section class="reviews" aria-labelledby="reviews-title">
				<div class="wrap reviews-grid">
					<div class="rating-block">
						<p class="eyebrow">04 — En Google</p>
						<p class="big-rating">{RATING.label}</p>
						<p class="stars" aria-label={`${RATING.label} de 5 estrellas`}>
							<span aria-hidden="true">★★★☆☆</span>
						</p>
						<p class="rating-count">{RATING.count} reseñas en Google</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>

					<div class="review-list">
						<h2 id="reviews-title">Lo que dice la ficha</h2>
						<p class="review-note">{RESENAS_NOTA}</p>
						{
							RESENAS.map((texto) => (
								<blockquote class="review">
									<p>«{texto}»</p>
									<footer>Reseña publicada en Google</footer>
								</blockquote>
							))
						}
					</div>
				</div>
			</section>

			<section class="visit" id="visitanos" aria-labelledby="visit-title">
				<div class="wrap">
					<header class="section-head">
						<div>
							<p class="eyebrow">05 — Visitar</p>
							<h2 id="visit-title">Juan Francés Bosca, 39. <em>Hasta las 23:30.</em></h2>
						</div>
						<p>
							En pleno Teatinos, junto a la zona universitaria. La cocina cierra a la misma hora
							todos los días; el mediodía solo se abre viernes y sábado.
						</p>
					</header>

					<div class="visit-grid">
						<div class="visit-info">
							<div class="visit-block">
								<h3>Horario</h3>
								<table>
									<caption class="visually-hidden">Horario de Restaurante Mustang</caption>
									<tbody>
										{
											HORARIO.map((row) => (
												<tr>
													<th scope="row">{row.dia}</th>
													<td>{row.horas}</td>
												</tr>
											))
										}
									</tbody>
								</table>
								<p class="notice">{HORARIO_AVISO}</p>
							</div>

							<div class="visit-block">
								<h3>Dónde</h3>
								<address>
									<strong>{BUSINESS.street}</strong><br />
									{BUSINESS.district}<br />
									{BUSINESS.postalCode} {BUSINESS.city}
								</address>
								<p class="visit-links">
									<a href={MAPS.directions} target="_blank" rel="noreferrer">
										Cómo llegar <span aria-hidden="true">↗</span>
									</a>
									<a href={MAPS.streetView} target="_blank" rel="noreferrer">
										Vista de la calle <span aria-hidden="true">↗</span>
									</a>
								</p>
							</div>

							<div class="visit-block">
								<h3>Contacto</h3>
								<p class="visit-phone">
									<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
								</p>
								<p>
									Es el único teléfono que publica la ficha de Google. No hay reservas online ni
									web propia.
								</p>
							</div>

							<div class="visit-block">
								<h3>Accesibilidad</h3>
								<p>
									La ficha marca acceso para sillas de ruedas, aseo adaptado y asientos
									adaptados. Indica que no hay aparcamiento accesible.
								</p>
							</div>
						</div>

						<div class="map-column">
							<div class="map-frame">
								<iframe
									title="Mapa de Restaurante Mustang en C. Juan Francés Bosca, 39, Málaga"
									src={MAPS.embed}
									loading="lazy"
									referrerpolicy="no-referrer-when-downgrade"
									allowfullscreen
								></iframe>
							</div>
							<p class="map-caption">
								<span>Juan Francés Bosca, 39 · 29010 Málaga</span>
								<a href={MAPS.place} target="_blank" rel="noreferrer">
									Abrir en Google Maps <span aria-hidden="true">↗</span>
								</a>
							</p>
						</div>
					</div>
				</div>
			</section>

			<section class="faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap faq-grid">
					<div class="faq-intro">
						<p class="eyebrow">06 — Preguntas</p>
						<h2 id="faq-title">Antes de <em>venir.</em></h2>
						<p>
							Lo que la ficha pública permite responder y lo que conviene confirmar por teléfono.
							Sin cartas ni precios inventados.
