---
import '../styles/global.css';

const business = {
	name: 'Restaurante La Tasca',
	short: 'La Tasca Tapería',
	street: 'C/ Baessipo, 7',
	city: 'Barbate',
	postalCode: '11160',
	phone: '+34 856 94 09 09',
	latitude: 36.1899126,
	longitude: -5.9230111,
	site: 'https://www.sur-digital.com/la-tasca-barbate',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+La+Tasca/@36.1899126,-5.9230111,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c436a7ec8517b:0xe70dbe111dc8639!8m2!3d36.1899126!4d-5.9230111!16s%2Fg%2F11j9dm_2nj?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const phoneHref = 'tel:+34856940909';
const instagramUrl = 'https://www.instagram.com/la_tasca_taperia/';

const specialties = [
	{
		kicker: 'De Barbate',
		title: 'Atún en adobo',
		text: 'Atún en adobo del que respeta el sabor: para mojar, repetir y preguntarse cómo puede estar tan bueno.',
	},
	{
		kicker: 'En directo',
		title: 'Ronqueo de atún',
		text: 'En Barbate hablar de atún es fácil: organizan ronqueo con menú para vivirlo de cerca.',
	},
	{
		kicker: 'Tapería',
		title: 'Tapas y bebidas',
		text: 'Bar de tapas mediterráneo y español: comidas, cenas, brunch y copas hasta tarde.',
	},
	{
		kicker: 'Tierra de atún',
		title: 'Valientes pescadores',
		text: 'En tierras de valientes pescadores, tapería excelente según la clientela local.',
	},
	{
		kicker: 'Reserva',
		title: '856 94 09 09',
		text: 'Reserva en el 856 94 09 09, sobre todo en temporada.',
	},
	{
		kicker: 'Confirma',
		title: 'Carta y horario',
		text: 'Confirma carta y horario en su Instagram @la_tasca_taperia o en la ficha de Maps.',
	},
];

const gallery = [
	{ src: '/la-tasca-barbate/fotos/tasca.svg', alt: 'Ilustración de la tapería — sustituye por foto propia' },
	{ src: '/la-tasca-barbate/fotos/atun.svg', alt: 'Ilustración de atún en adobo — sustituye por foto propia' },
	{ src: '/la-tasca-barbate/fotos/tapas.svg', alt: 'Ilustración de tapas — sustituye por foto propia' },
	{ src: '/la-tasca-barbate/fotos/barra.svg', alt: 'Ilustración de la barra — sustituye por foto propia' },
	{ src: '/la-tasca-barbate/fotos/ronqueo.svg', alt: 'Ilustración del ronqueo — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está La Tasca?',
		a: 'En C/ Baessipo, 7, 11160 Barbate (Cádiz), según publicaciones locales.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'No hay horario verificado publicado: confirma en el 856 94 09 09 o en su Instagram antes de venir.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'En temporada conviene reservar en el 856 94 09 09.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Tapería de atún de Barbate: atún en adobo, tapas mediterráneas y ronqueo con menú.',
	},
	{
		q: '¿Cómo llego?',
		a: 'Está en la C/ Baessipo de Barbate. Usa el botón «Cómo llegar» para abrir la ruta en Google Maps.',
	},
];

const description =
	'La Tasca Tapería: tapería de atún en C/ Baessipo 7, Barbate. Atún en adobo y ronqueo. Tel. 856 94 09 09.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: `${business.name} (${business.short})`,
	description,
	url: `${business.site}/`,
	telephone: '+34 856 94 09 09',
	image: [`${business.site}/fotos/tasca.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Española'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [instagramUrl],
	acceptsReservations: 'True',
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="La Tasca Tapería: atún de Barbate en C/ Baessipo 7. Atún en adobo y ronqueo. 856 94 09 09." />
		<meta name="keywords" content="La Tasca Barbate, tapería Barbate, Baessipo 7, atún Barbate, ronqueo atún" />
		<meta name="author" content="La Tasca Tapería" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/la-tasca-barbate/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>La Tasca | Tapería de atún en Barbate</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="La Tasca · Tapería de atún en Barbate" />
		<meta property="og:description" content="Atún en adobo y ronqueo en C/ Baessipo 7, Barbate." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/tasca.svg`} />
		<meta property="og:image:alt" content="La Tasca Tapería, Barbate" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="La Tasca · Tapería de atún en Barbate" />
		<meta name="twitter:description" content="C/ Baessipo 7: atún en adobo y ronqueo." />
		<meta name="twitter:image" content={`${business.site}/fotos/tasca.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Barbate" />
		<meta name="geo.position" content="36.1899126;-5.9230111" />
		<meta name="ICBM" content="36.1899126, -5.9230111" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="La Tasca, inicio">
				<span class="brand-mark" aria-hidden="true">LT</span>
				<span class="brand-name">La Tasca <small>Tapería · Barbate</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#tasca">La tasca</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>856 94 09 09</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C/ Baessipo, 7 · Barbate</p>
					<h1 id="hero-title">Atún de<br /><em>Barbate.</em></h1>
					<p class="hero-lede">
						Tapería barbateña de atún: atún en adobo para mojar y repetir,
						y ronqueo para vivirlo de cerca.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 856 94 09 09</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>Tapería</b> de atún</li>
						<li>Atún en adobo</li>
						<li>Ronqueo</li>
						<li>Baessipo 7</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/la-tasca-barbate/fotos/tasca.svg" alt="Ilustración de La Tasca Tapería, Barbate" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>C/ Baessipo 7 · Barbate</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>4,1</b><span>Tripadvisor</span></div>
					<div><b>Atún</b><span>De almadraba</span></div>
					<div><b>Nº 7</b><span>Baessipo</span></div>
				</div>
				<ul class="services">
					<li>Atún en adobo</li>
					<li>Ronqueo</li>
					<li>Tapas</li>
					<li>Brunch</li>
					<li>Copas</li>
					<li>Reservas</li>
				</ul>
			</section>

			<section class="about section-pad" id="tasca">
				<p class="section-label"><span aria-hidden="true"></span> La tasca</p>
				<div class="about-grid">
					<h2>A mojar<br />y <em>repetir.</em></h2>
					<div class="about-copy">
						<p>
							La Tasca Tapería está en C/ Baessipo, 7 (11160 Barbate),
							con coordenadas 36.1899126, -5.9230111.
						</p>
						<p>
							En tierras de valientes pescadores: tapería excelente de atún, con atún en adobo
							del que respeta el sabor y ronqueo con menú para descubrirlo mesa a mesa.
						</p>
						<p class="about-note">
							No publicamos horario por falta de fuente verificable: confirma en el 856 94 09 09
							o en @la_tasca_taperia antes de venir. No confundir con la antigua Tasca de Zahara
							ni con La Tasca de Alonso.
						</p>
						<div class="about-links">
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">Instagram @la_tasca_taperia <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales según publicaciones. Confirma la carta del día
						en la propia tasca.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>La tasca<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias de la tasca.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C/ Baessipo, 7</p>
					<h2>Ven a Barbate<br /><em>al atún.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<p class="hours-note">Horario sin fuente verificable. Confirma en el 856 94 09 09 antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar a la tasca ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 856 94 09 09</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de La Tasca en C/ Baessipo 7, Barbate" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> La Tasca · Barbate</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">LT</span>
				<p>La Tasca<small>{business.street} · {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces de la tasca">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} La Tasca · Barbate. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/la-tasca-barbate/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/la-tasca-barbate/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/la-tasca-barbate/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar a la tasca <span>856 94 09 09</span></a>
	</body>
</html>
