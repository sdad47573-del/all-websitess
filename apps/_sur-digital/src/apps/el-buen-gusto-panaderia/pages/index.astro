---
import '../styles/global.css';
import { LocalFooter, LocalSecciones, LocalSeo, LocalTopbar } from '@astro-components';

import fachada from '../assets/fotos/el-buen-gusto-panaderia-panoramica-01.jpg';
import terraza from '../assets/fotos/el-buen-gusto-panaderia-vertical-02.jpg';
import flan from '../assets/fotos/el-buen-gusto-panaderia-vertical-05.jpg';
import pasta from '../assets/fotos/el-buen-gusto-panaderia-vertical-03.jpg';
import carne from '../assets/fotos/el-buen-gusto-panaderia-vertical-04.jpg';

import secciones from '../data/secciones.json';
import { BUSINESS, HOURS, MAPS } from '../data/site';

const piezas = secciones.secciones;
const piezaFaq = piezas.find((item) => item.tipo === 'faq' && item.visible !== false) as
	| { preguntas?: { pregunta: string; respuesta: string }[] }
	| undefined;

const fotos = {
	'el-buen-gusto-panaderia-panoramica-01.jpg': fachada,
	'el-buen-gusto-panaderia-vertical-02.jpg': terraza,
	'el-buen-gusto-panaderia-vertical-03.jpg': pasta,
	'el-buen-gusto-panaderia-vertical-04.jpg': carne,
	'el-buen-gusto-panaderia-vertical-05.jpg': flan,
};

const title = '«El Buen Gusto» Panadería · Panadería de barrio en Poniente Sur, Córdoba';
const description = BUSINESS.description;

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#el-buen-gusto`,
	name: BUSINESS.name,
	alternateName: ['El Buen Gusto Panadería Córdoba', 'Panadería El Buen Gusto'],
	description:
		'Panadería de barrio en la calle Naranjal de Almagro, Poniente Sur (14004 Córdoba).',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: (piezaFaq?.preguntas ?? []).map((item) => ({
		'@type': 'Question',
		name: item.pregunta,
		acceptedAnswer: { '@type': 'Answer', text: item.respuesta },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];


---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#7c3f1d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400..700;1,400..700&family=Rubik:wght@300..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Buen Gusto Panadería Córdoba, panadería Poniente Sur, panadería 14004, Naranjal de Almagro, panadería de barrio Córdoba"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería de barrio en la calle Naranjal de Almagro, Poniente Sur (14004 Córdoba), con el rótulo de panadería en la fachada y mesas en la acera. 4,7 sobre 5 con 7 reseñas en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de «El Buen Gusto» Panadería en una esquina de Poniente Sur, con los rótulos del local y mesas en la acera"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#7c3f1d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: '',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/el-buen-gusto-panaderia/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Panadería · Poniente Sur"
			nav={nav}
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district,
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.district}, ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, valoración y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. La ficha no publica horario, teléfono ni catálogo; confirma antes de ir."
			ctaLabel="Ver en Google Maps"
			navAriaLabel="Enlaces de «El Buen Gusto» Panadería"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
