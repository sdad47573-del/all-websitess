---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/ks-restaurante-e-cafe-vertical-01.jpg';
import carilFrango from '../assets/fotos/ks-restaurante-e-cafe-vertical-02.jpg';
import folheto from '../assets/fotos/ks-restaurante-e-cafe-apaisada-03.jpg';
import arrozFrango from '../assets/fotos/ks-restaurante-e-cafe-vertical-04.jpg';
import balcao from '../assets/fotos/ks-restaurante-e-cafe-vertical-05.jpg';
import logotipo from '../assets/fotos/ks-restaurante-e-cafe-vertical-06.jpg';
import frangoBatata from '../assets/fotos/ks-restaurante-e-cafe-vertical-08.jpg';
import mesaKebab from '../assets/fotos/ks-restaurante-e-cafe-vertical-09.jpg';
import clientes from '../assets/fotos/ks-restaurante-e-cafe-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICOS,
} from '../data/site';

const title = 'Ks Restaurante e Café · Döner kebab em Sacavém';
const description = BUSINESS.description;

const galeria = [
	{
		src: carilFrango,
		alt: 'Frango estufado em molho alaranjado, com gengibre em juliana e coentros, numa frigideira preta',
	},
	{
		src: arrozFrango,
		alt: 'Arroz com frango, limão e coentros num prato preto, com uma lata de Coca-Cola ao lado',
	},
	{
		src: frangoBatata,
		alt: 'Frango grelhado com batata frita e salada numa bandeja, com uma lata de Sumol ao lado',
	},
	{
		src: balcao,
		alt: 'Balcão do Ks com vitrine de pastelaria, máquina de café e um cliente a beber café',
	},
	{
		src: clientes,
		alt: 'Grupo de clientes à mesa, num almoço com kebab e batata frita',
	},
	{
		src: fachada,
		alt: 'Fachada do Ks Cafe Restaurant com o logótipo na vitrina e o folheto de kebab exposto',
	},
	{
		src: logotipo,
		alt: 'Autocolante redondo com o logótipo KS Cafe & Restaurant e a morada, Rua Salvador Allende 27, Sacavém',
	},
	{
		src: folheto,
		alt: 'Folheto do KS Cafe & Restaurante com a lista de pizzas, os menus e os contactos da casa',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#ks`,
	name: BUSINESS.name,
	alternateName: ['KS Cafe', 'KS Cafe & Restaurante', 'Ks Restaurante e Cafe Sacavém'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	currenciesAccepted: 'EUR',
	servesCuisine: ['Döner kebab', 'Grelhados'],
	areaServed: [
		{ '@type': 'City', name: 'Sacavém' },
		{ '@type': 'AdministrativeArea', name: 'Loures' },
		{ '@type': 'AdministrativeArea', name: 'Distrito de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '05:00',
			closes: '22:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A cozinha', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"ks-restaurante-e-cafe-vertical-09.jpg": mesaKebab,
	"ks-restaurante-e-cafe-vertical-02.jpg": carilFrango,
	"ks-restaurante-e-cafe-vertical-04.jpg": arrozFrango,
	"ks-restaurante-e-cafe-vertical-08.jpg": frangoBatata,
	"ks-restaurante-e-cafe-vertical-05.jpg": balcao,
	"ks-restaurante-e-cafe-vertical-10.jpg": clientes,
	"ks-restaurante-e-cafe-vertical-01.jpg": fachada,
	"ks-restaurante-e-cafe-vertical-06.jpg": logotipo,
	"ks-restaurante-e-cafe-apaisada-03.jpg": folheto,
};
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#23201d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,600;0,700;1,400&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Ks Restaurante e Café, KS Cafe Sacavém, döner kebab Sacavém, kebab Sacavém, comer em Sacavém, restaurante Rua Salvador Allende, kebab perto de Lisboa, café Sacavém"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Restaurante de döner kebab na R. Salvador Allende 27c, em Sacavém. Aberto todos os dias das 5:00 às 22:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Mesa posta com frango grelhado e kebab no Ks Restaurante e Café"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#23201d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Sacavém, Lisboa"
			locale="pt_PT"
			countryName="Portugal"
			preload={[mesaKebab]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/ks-restaurante-e-cafe/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Ks Cafe"
			subtitle="Restaurante · Sacavém"
			nav={nav}
			cta={{ label: 'Google Maps', href: MAPS.place, external: true }}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Informação elaborada a partir de fontes públicas; confirma horário e oferta antes da visita."
			ctaLabel="Ver no Google Maps"
			navAriaLabel="Ligações do Ks Restaurante e Café"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
