---
import '../styles/global.css';

const business = {
	name: 'Bar Restaurante Las Manuelas',
	short: 'Las Manuelas',
	street: 'Cam. de Piñero, 121',
	area: 'El Palmar de Vejer',
	city: 'Vejer de la Frontera',
	postalCode: '11159',
	phone: '+34 621 29 87 57',
	latitude: 36.2415428,
	longitude: -6.0663914,
	site: 'https://www.sur-digital.com/bar-restaurante-las-manuelas',
};

const mapsUrl =
	'https://www.google.com/maps/place/bar+restaurante+las+Manuelas/@36.2415428,-6.0663914,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c477e211bff33:0xb513f99511d06bb9!8m2!3d36.2415428!4d-6.0663914!16s%2Fg%2F11rfrz7715?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34621298757';
const instagramUrl = 'https://www.instagram.com/lasmanuelaselpalmar/';

const specialties = [
	{
		kicker: 'De la casa',
		title: 'Croquetas de puchero',
		text: 'Cremosas por dentro con fritura perfecta; para muchos, las mejores de la zona.',
	},
	{
		kicker: 'Del mar',
		title: 'Atún encebollado',
		text: 'Ración generosa de atún fresco con cebolla caramelizada, cazón en adobo y chipirones.',
	},
	{
		kicker: 'Para compartir',
		title: 'Tortillitas y almejas',
		text: 'Tortillitas de camarones, almejas en salsa y ensaladilla de pulpo para abrir boca.',
	},
	{
		kicker: 'A la brasa',
		title: 'Carnes y retinto',
		text: 'Lomo bajo de ternera, lagartillo ibérico, parrilladas y hamburguesa de retinto.',
	},
	{
		kicker: 'Casera',
		title: 'Raciones generosas',
		text: 'Comida casera de Manoli e Ignacio, con cantidades que satisfacen y precio ajustado.',
	},
	{
		kicker: 'En El Palmar',
		title: 'Mié–dom 12–24',
		text: 'De miércoles a domingo de 12:00 a 24:00; lunes y martes cerrado. Reserva recomendada.',
	},
];

const gallery = [
	{ src: '/bar-restaurante-las-manuelas/fotos/venta.svg', alt: 'Ilustración del bar restaurante — sustituye por foto propia' },
	{ src: '/bar-restaurante-las-manuelas/fotos/croquetas.svg', alt: 'Ilustración de croquetas — sustituye por foto propia' },
	{ src: '/bar-restaurante-las-manuelas/fotos/atun.svg', alt: 'Ilustración de atún encebollado — sustituye por foto propia' },
	{ src: '/bar-restaurante-las-manuelas/fotos/terraza.svg', alt: 'Ilustración de la terraza — sustituye por foto propia' },
	{ src: '/bar-restaurante-las-manuelas/fotos/brasa.svg', alt: 'Ilustración de carnes a la brasa — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Las Manuelas?',
		a: 'En Cam. de Piñero, 121, 11159 El Palmar de Vejer (Vejer de la Frontera, Cádiz).',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De miércoles a domingo de 12:00 a 24:00; lunes y martes cerrado, según su Instagram oficial. Confirma en el 621 29 87 57.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'La reserva está recomendada, sobre todo en temporada: llama al 621 29 87 57.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Comida casera gaditana: croquetas de puchero, atún encebollado, cazón en adobo, chipirones, tortillitas, carnes a la brasa y postres caseros.',
	},
	{
		q: '¿Tienen Instagram?',
		a: 'Sí: @lasmanuelaselpalmar, donde publican horario y platos.',
	},
];

const description =
	'Bar Restaurante Las Manuelas: comida casera en Cam. de Piñero, 121, El Palmar de Vejer. Croquetas, atún encebollado, brasa. Mié–dom 12:00–24:00. Tel. 621 29 87 57.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 621 29 87 57',
	image: [`${business.site}/fotos/venta.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Andaluza', 'Mediterránea'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [instagramUrl],
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '24:00',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="Bar Restaurante Las Manuelas: comida casera en Cam. de Piñero, 121, El Palmar de Vejer. Croquetas, atún, brasa. Mié–dom 12:00–24:00. 621 29 87 57." />
		<meta name="keywords" content="Las Manuelas El Palmar, bar restaurante Las Manuelas, comer El Palmar Vejer, Camino Piñero 121, comida casera Cádiz" />
		<meta name="author" content="Bar Restaurante Las Manuelas" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/bar-restaurante-las-manuelas/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>Las Manuelas | Comida casera en El Palmar de Vejer</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Las Manuelas · Comida casera en El Palmar" />
		<meta property="og:description" content="Comida casera en Cam. de Piñero, 121: croquetas, atún encebollado, brasa. Mié–dom 12:00–24:00." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/venta.svg`} />
		<meta property="og:image:alt" content="Bar Restaurante Las Manuelas, El Palmar de Vejer" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Las Manuelas · Comida casera en El Palmar" />
		<meta name="twitter:description" content="Croquetas, atún y brasa en Cam. de Piñero, 121. Mié–dom 12:00–24:00." />
		<meta name="twitter:image" content={`${business.site}/fotos/venta.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="El Palmar de Vejer" />
		<meta name="geo.position" content="36.2415428;-6.0663914" />
		<meta name="ICBM" content="36.2415428, -6.0663914" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Las Manuelas, inicio">
				<span class="brand-mark" aria-hidden="true">LM</span>
				<span class="brand-name">Las Manuelas <small>El Palmar · Vejer</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">El bar</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>621 29 87 57</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Cam. de Piñero, 121 · El Palmar</p>
					<h1 id="hero-title">Comida casera<br />de <em>verdad.</em></h1>
					<p class="hero-lede">
						Bar restaurante de Manoli e Ignacio en El Palmar de Vejer: raciones generosas,
						carnes a la brasa y pescado fresco, sin clichés turísticos.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 621 29 87 57</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>Mié–dom</b> 12–24</li>
						<li>Comida casera</li>
						<li>Raciones generosas</li>
						<li>Reserva recomendada</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/bar-restaurante-las-manuelas/fotos/venta.svg" alt="Ilustración de Bar Restaurante Las Manuelas, El Palmar de Vejer" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Cam. de Piñero 121 · El Palmar</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>12–24</b><span>Mié–dom</span></div>
					<div><b>Casera</b><span>Cocina</span></div>
					<div><b>Palmar</b><span>Vejer</span></div>
				</div>
				<ul class="services">
					<li>Croquetas</li>
					<li>Atún</li>
					<li>Brasa</li>
					<li>Tortillitas</li>
					<li>Reservas</li>
					<li>Terraza</li>
				</ul>
			</section>

			<section class="about section-pad" id="restaurante">
				<p class="section-label"><span aria-hidden="true"></span> El bar de Manoli e Ignacio</p>
				<div class="about-grid">
					<h2>Generoso<br />y <em>casero.</em></h2>
					<div class="about-copy">
						<p>
							Bar Restaurante Las Manuelas está en Cam. de Piñero, 121 (11159 El Palmar de Vejer),
							en una finca privada con salón interior y terraza, a un paso de la playa.
						</p>
						<p>
							Su filosofía es el producto fresco y el sabor auténtico: croquetas de puchero y jamón,
							cordón blue con salsa de champiñones, ensaladilla de pulpo, atún encebollado, cazón en
							adobo, chipirones, calamar de potera y carnes a la brasa como el lomo bajo o el
							lagartillo ibérico.
						</p>
						<p class="about-note">
							Abre de miércoles a domingo de 12:00 a 24:00; lunes y martes cerrado, según su Instagram
							oficial. Reserva en el 621 29 87 57, sobre todo en temporada.
						</p>
						<div class="about-links">
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">Instagram @lasmanuelaselpalmar <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales según reseñas públicas: tapas, medias raciones y platos. Confirma la carta
						del día en el propio restaurante.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>La venta<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del restaurante.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Cam. de Piñero, 121</p>
					<h2>Ven a El Palmar<br /><em>a comer.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.area}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Miércoles a domingo</th>
								<td>12:00 – 24:00</td>
							</tr>
							<tr>
								<th scope="row">Lunes y martes</th>
								<td>Cerrado</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Según Instagram oficial. Confirma en el 621 29 87 57 antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al restaurante ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 621 29 87 57</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de Las Manuelas en Cam. de Piñero 121, El Palmar" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Las Manuelas · El Palmar</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">LM</span>
				<p>Las Manuelas<small>{business.street} · {business.area}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Las Manuelas · El Palmar de Vejer. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/bar-restaurante-las-manuelas/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/bar-restaurante-las-manuelas/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/bar-restaurante-las-manuelas/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>621 29 87 57</span></a>
	</body>
</html>
