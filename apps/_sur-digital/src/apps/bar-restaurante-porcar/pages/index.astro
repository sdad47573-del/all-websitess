---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';
import comedor from '../assets/fotos/bar-restaurante-porcar-apaisada-01.jpg';
import fachada from '../assets/fotos/bar-restaurante-porcar-apaisada-08.jpg';
import ensalada from '../assets/fotos/bar-restaurante-porcar-apaisada-10.jpg';
import cafe from '../assets/fotos/bar-restaurante-porcar-vertical-02.jpg';
import olla from '../assets/fotos/bar-restaurante-porcar-vertical-03.jpg';
import chuletillas from '../assets/fotos/bar-restaurante-porcar-vertical-04.jpg';
import cordero from '../assets/fotos/bar-restaurante-porcar-vertical-05.jpg';
import setas from '../assets/fotos/bar-restaurante-porcar-vertical-06.jpg';
import iglesia from '../assets/fotos/bar-restaurante-porcar-vertical-07.jpg';
import calle from '../assets/fotos/bar-restaurante-porcar-vertical-09.jpg';

const business = {
	name: 'Bar restaurante Porcar',
	brand: 'Porcar',
	street: "Carrer l'Església",
	city: 'Xodos',
	region: 'Castelló',
	postalCode: '12134',
	phone: '964 37 02 82',
	latitude: 40.2452791,
	longitude: -0.2875449,
	rating: 4.4,
	reviewsCount: 508,
	site: 'https://www.sur-digital.com/bar-restaurante-porcar',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd5fea130e13c3e7:0x66360051516c9b3d';
const cidDecimal = '7365074589869447997';
const placeId = 'ChIJ58MTDhPqXw0RPZtsUVEANmY';

const mapsUrl =
	'https://www.google.com/maps/place/Bar+restaurante+Porcar/@40.2452791,-0.2875449,17z/data=!3m1!4b1!4m6!3m5!1s0xd5fea130e13c3e7:0x66360051516c9b3d!8m2!3d40.2452791!4d-0.2875449!16s%2Fg%2F11c1xhszpt?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34964370282';

const description =
	"Bar restaurante Porcar, en el Carrer l'Església de Xodos (Castellón): cocina casera de montaña, olla, carnes a la brasa y setas, con barra y café. Abre de 9:00 a 24:00.";

const servicios = [
	'Bar',
	'Restaurante',
	'Cocina casera',
	'Olla y guisos',
	'Carnes a la brasa',
	'Setas',
	'Cafetería',
	'Comedor amplio',
	'Acceso adaptado',
	'Reservas por teléfono',
];

const grupos = [
	{
		title: 'De cuchara',
		items: [
			{
				name: 'Olla de la casa',
				note: 'garbanzos, patata, costilla, morcilla y verdura, servida con cesta de pan de pueblo',
			},
			{
				name: 'Cordero guisado',
				note: 'guiso con patatas y su salsa, con pan para mojar',
			},
		],
	},
	{
		title: 'A la brasa',
		items: [
			{
				name: 'Chuletillas de cordero',
				note: 'a la brasa con queso fundido, patatas fritas y berenjena asada',
			},
			{
				name: 'Setas salteadas',
				note: 'con aceite de oliva, ajo y un toque de pimentón',
			},
		],
	},
	{
		title: 'De la huerta y del bar',
		items: [
			{
				name: 'Ensalada de la casa',
				note: 'lechuga, tomate, granada, aceitunas negras, maíz y zanahoria',
			},
			{
				name: 'Café solo',
				note: 'servido en vaso, el de después de comer en la barra',
			},
		],
	},
];

const galeria = [
	{
		src: comedor,
		alt: "Comedor de Bar restaurante Porcar con mesas largas puestas, en Xodos",
	},
	{
		src: olla,
		alt: "Olla de garbanzos con costilla y morcilla, con cesta de pan, en Bar restaurante Porcar",
	},
	{
		src: cafe,
		alt: "Café solo servido en vaso en la barra de Bar restaurante Porcar, Xodos",
	},
	{
		src: chuletillas,
		alt: "Chuletillas de cordero a la brasa con queso fundido, patatas y berenjena en Bar restaurante Porcar",
	},
	{
		src: cordero,
		alt: "Cordero guisado con patatas en Bar restaurante Porcar, Xodos",
	},
	{
		src: setas,
		alt: "Setas salteadas con pimentón en Bar restaurante Porcar",
	},
	{
		src: ensalada,
		alt: "Ensalada de la casa con tomate, granada y aceitunas en Bar restaurante Porcar",
	},
	{
		src: calle,
		alt: "Calle de piedra de Xodos con la torre de la iglesia al fondo, junto al bar",
	},
	{
		src: iglesia,
		alt: "Iglesia de piedra y plaza de Xodos, al lado de Bar restaurante Porcar",
	},
];

const faqs = [
	{
		q: '¿Dónde está Bar restaurante Porcar?',
		a: "En el Carrer l'Església, 12134 Xodos (Castelló), en el casco del pueblo y junto a la iglesia, con las casas de piedra y la montaña alrededor. Es un pueblo de montaña de l'Alcalatén, así que se llega por carretera comarcal; el botón «Cómo llegar» abre la ruta en Google Maps.",
	},
	{
		q: '¿Qué horario tiene?',
		a: 'Abre todos los días de 9:00 a 24:00, de martes a domingo. El lunes permanece cerrado. Al ser un local de pueblo, en fiestas y días señalados el horario puede alargarse o cambiar: conviene llamar antes al 964 37 02 82.',
	},
	{
		q: '¿Qué tipo de comida sirve?',
		a: 'Cocina casera de la comarca, como resumen sus reseñas: «cocina casera y típica de la comarca muy bien elaborada». En sus fotos aparecen la olla de garbanzos con costilla y morcilla, el cordero guisado con patatas, las chuletillas a la brasa con queso, las setas salteadas y la ensalada de la casa.',
	},
	{
		q: '¿Hay carta o menú publicado?',
		a: 'No. La ficha de Google no incluye carta, menú del día ni precios, y esta web no los inventa: los platos que ves en «La mesa» son los que aparecen fotografiados en el perfil del local. Lo que haya cada día, las raciones y su precio se preguntan en el bar o por teléfono.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'No hay reserva online ni formulario en esta web: se reserva llamando al 964 37 02 82. El comedor es amplio y tiene mesas largas para grupos, así que para venir en cuadrilla o en fin de semana conviene avisar con tiempo.',
	},
	{
		q: '¿Se puede solo tomar café o una caña?',
		a: 'Sí. La ficha lo clasifica como bar y restaurante, y en sus fotos está el café en vaso y la cerveza en la mesa. Por la mañana y a media tarde funciona como bar del pueblo, además de dar comidas.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'La ficha de Google marca entrada, aseo y asientos adaptados para sillas de ruedas. No marca plaza de aparcamiento adaptada. Al estar en una calle de piedra del casco antiguo, el acceso a la puerta tiene cuesta.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['Porcar', 'Bar Porcar', 'Restaurante Porcar', 'Bar restaurante Porcar Xodos'],
	slogan: 'Cocina casera de montaña en Xodos',
	description,
	url: `${business.site}/`,
	telephone: '+34 964 37 02 82',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Cocina casera', 'Cocina de montaña', 'Carnes a la brasa', 'Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Xodos' },
		{ '@type': 'AdministrativeArea', name: "L'Alcalatén" },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '23:59',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La mesa', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Bar Restaurante Porcar · Cocina casera en Xodos</title>
		<meta name="theme-color" content="#24382b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Karla:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Bar restaurante Porcar, bar Porcar Xodos, restaurante Xodos, Chodos, cocina casera Xodos, olla Xodos, cordero a la brasa, setas, comer en Xodos, L'Alcalatén, Castellón, Penyagolosa"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Bar Restaurante Porcar · Cocina casera en Xodos"
			ogDescription="Olla, cordero a la brasa y setas en Xodos. Bar restaurante de pueblo abierto de 9:00 a 24:00, lunes cerrado. 4,4 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Fachada de Bar restaurante Porcar en el Carrer l'Església de Xodos"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#24382b"
			street={business.street}
			city={`${business.city} (Chodos)`}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Xodos, Castellón"
			contact={{
				street: business.street,
				locality: business.city,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[fachada]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="P"
			name={business.brand}
			subtitle="Bar restaurante · Xodos"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer l'Església · Xodos (Castelló)"
				title="Cocina casera<br />de <em>montaña.</em>"
				lede="Bar restaurante Porcar está en el Carrer l'Església de Xodos, pegado a la iglesia del pueblo. Abre todos los días de 9:00 a 24:00 y sirve cocina casera de la comarca: olla, carnes a la brasa y setas, con la barra abierta para el café y la caña."
				image={fachada}
				imageAlt="Fachada de Bar restaurante Porcar en el Carrer l'Església de Xodos, con la montaña al fondo"
				primaryCta={{ label: 'Llamar 964 37 02 82', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4</b> en Google (508 reseñas)' },
					{ label: 'Horario', html: '<b>9:00 – 24:00</b>' },
					{ label: 'Lunes', html: '<b>Cerrado</b>' },
					{ label: 'Cocina', html: '<b>Casera y de la comarca</b>' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Bar restaurante Porcar" items={servicios} />

			<LocalAbout
				label="El bar del pueblo, en Xodos"
				title="Piedra, olla<br />y <em>montaña.</em>"
				paragraphs={[
					'Porcar ocupa la planta baja de una casa de piedra del Carrer l\'Església, con el rótulo en la fachada y las mesas de la terraza en la misma calle, a cuatro pasos de la iglesia. Xodos es un pueblo de montaña de l\'Alcalatén: casas de piedra, calles en cuesta y el monte alrededor.',
					'La cocina es la de casa y la de la comarca, como dicen sus reseñas: «cocina casera y típica de la comarca muy bien elaborada». En las fotos del local aparecen la olla de garbanzos con costilla y morcilla, el cordero guisado con patatas, las chuletillas a la brasa con queso fundido, las setas salteadas con pimentón y la ensalada de la casa con granada.',
					'El horario es de bar de pueblo: de 9:00 a 24:00, de martes a domingo, con el lunes para descansar. Por la mañana se desayuna y se toma el café, a mediodía se come en el comedor y por la tarde la barra sigue abierta. La ficha reúne 508 opiniones con un 4,4.',
				]}
				note="«Buen sitio y buen trato y una comida casera buenísima», dice una reseña. Otra añade: «cocina casera y típica de la comarca muy bien elaborada… a repetir»."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La mesa"
				title="Olla, brasa<br />y <em>setas.</em>"
				description="En la ficha de Google no hay carta ni precios, así que esta lista recoge solo lo que aparece en las fotos del local y lo que cuentan sus reseñas: cocina casera de la comarca, sin adornos."
				cta={{ label: 'Preguntar qué hay hoy', href: phoneHref }}
				groups={grupos}
				note="Esta web no publica precios: la ficha del restaurante no tiene carta ni menú del día. Lo que se cocina cada jornada, las raciones y su importe se confirman en la barra o llamando al 964 37 02 82."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor,<br />los platos<br /><em>y el pueblo.</em>"
				description="Estas fotografías proceden del perfil de Bar restaurante Porcar en Google Maps: el comedor con las mesas puestas, la olla de garbanzos con costilla y morcilla, las chuletillas a la brasa, el cordero guisado, las setas, la ensalada, el café en vaso de la barra y las calles de piedra de Xodos."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer l'Església · 12134 Xodos"
				title="Sube al pueblo<br /><em>y come aquí.</em>"
				addressLines={[
					business.street,
					`${business.postalCode} ${business.city}`,
					'Castelló, España',
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: '9:00 – 24:00' },
					{ day: 'Miércoles', value: '9:00 – 24:00' },
					{ day: 'Jueves', value: '9:00 – 24:00' },
					{ day: 'Viernes', value: '9:00 – 24:00' },
					{ day: 'Sábado', value: '9:00 – 24:00' },
					{ day: 'Domingo', value: '9:00 – 24:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google: de 9:00 a 24:00 de martes a domingo, con el lunes cerrado. En fiestas del pueblo y días señalados suele cambiar, así que llama antes al 964 37 02 82."
				mapTitle="Mapa de Bar restaurante Porcar en el Carrer l'Església de Xodos"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Bar restaurante Porcar · Xodos"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Las reservas se hacen por teléfono, llamando al 964 37 02 82: no hay reserva online ni formulario en esta web. El comedor tiene mesas largas, así que para grupos y fines de semana conviene llamar con tiempo."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="P"
			name="Bar restaurante Porcar"
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, platos y precios antes de la visita."
			ctaLabel="Llamar a Porcar"
			creditName="Sur Digital"
		/>
	</body>
</html>
