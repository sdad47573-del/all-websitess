---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import wok from '../assets/fotos/el-leon-de-oro-panoramica-03.jpg';
import comedor from '../assets/fotos/el-leon-de-oro-apaisada-01.jpg';
import guindilla from '../assets/fotos/el-leon-de-oro-vertical-02.jpg';
import empanadillas from '../assets/fotos/el-leon-de-oro-vertical-04.jpg';
import leon from '../assets/fotos/el-leon-de-oro-vertical-05.jpg';
import fideosAnchos from '../assets/fotos/el-leon-de-oro-vertical-06.jpg';
import berenjenas from '../assets/fotos/el-leon-de-oro-vertical-07.jpg';
import judias from '../assets/fotos/el-leon-de-oro-vertical-08.jpg';
import pato from '../assets/fotos/el-leon-de-oro-vertical-09.jpg';
import sopa from '../assets/fotos/el-leon-de-oro-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'El León de Oro · Restaurante chino en Abando, Bilbao';
const description =
	'El León de Oro, C. Fernández del Campo, 8 (48010 Bilbao, Abando). Restaurante chino con cocina a la vista: pato laqueado, empanadillas a la plancha, berenjenas, verdura al wok y fideos. 4,1 sobre 5 con 622 reseñas.';

const galeria = [
	{
		src: wok,
		alt: 'Wok de coliflor y verdura salteada con ternera, sobre el hornillo de la mesa',
	},
	{
		src: comedor,
		alt: 'El comedor de El León de Oro con mesas de madera, sillas oscuras y el relieve chino en la pared',
	},
	{
		src: pato,
		alt: 'Pato laqueado cortado en láminas sobre lechuga, con un cuenco de salsa',
	},
	{
		src: leon,
		alt: 'Gran albóndiga estofada en su salsa, rodeada de bollos al vapor',
	},
	{
		src: empanadillas,
		alt: 'Empanadillas a la plancha doradas, con el cuenco de salsa de soja',
	},
	{
		src: fideosAnchos,
		alt: 'Tallarines de arroz ancho salteados con verdura y zanahoria',
	},
	{
		src: berenjenas,
		alt: 'Berenjenas estofadas en salsa, con la piel morada',
	},
	{
		src: judias,
		alt: 'Judías verdes salteadas con ajo y guindilla',
	},
	{
		src: sopa,
		alt: 'Sopa de fideos con pollo y espinaca, con los fideos servidos con cuchara',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que sirve El León de Oro',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-leon-de-oro`,
	name: BUSINESS.name,
	alternateName: ['El León de Oro Bilbao', 'Leon de Oro Abando', 'Restaurante chino León de Oro'],
	description:
		'Restaurante chino en la calle Fernández del Campo, 8 (Abando, 48010 Bilbao): pato laqueado, empanadillas a la plancha, berenjenas, verdura al wok, fideos y sopas, con la cocina a la vista.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34944435646',
	currenciesAccepted: 'EUR',
	servesCuisine: ['China', 'Asiática'],
	areaServed: [
		{ '@type': 'City', name: 'Bilbao' },
		{ '@type': 'Place', name: 'Abando' },
		{ '@type': 'AdministrativeArea', name: 'Bizkaia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Friday', 'Saturday'],
			opens: '12:00',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday'],
			opens: '11:30',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '20:00',
			closes: '23:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"el-leon-de-oro-panoramica-03.jpg": wok,
	"el-leon-de-oro-apaisada-01.jpg": comedor,
	"el-leon-de-oro-vertical-09.jpg": pato,
	"el-leon-de-oro-vertical-05.jpg": leon,
	"el-leon-de-oro-vertical-04.jpg": empanadillas,
	"el-leon-de-oro-vertical-06.jpg": fideosAnchos,
	"el-leon-de-oro-vertical-07.jpg": berenjenas,
	"el-leon-de-oro-vertical-08.jpg": judias,
	"el-leon-de-oro-vertical-10.jpg": sopa,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#3b2a1e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Work+Sans:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El León de Oro Bilbao, restaurante chino Bilbao, comida china Abando, pato laqueado Bilbao, empanadillas chinas Bilbao, Fernández del Campo, restaurante Abando"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Restaurante chino en Abando (Bilbao): pato laqueado, empanadillas a la plancha, berenjenas, verdura al wok, fideos y sopas. Todos los días de 12:00 a 16:30 y de 20:00 a 23:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Wok de coliflor y verdura salteada en El León de Oro, Bilbao"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#3b2a1e"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[wok]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El León de Oro"
			subtitle="Cocina china · Abando"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma platos, precios y horario antes de ir."
			ctaLabel="Llamar a El León de Oro"
			navAriaLabel="Enlaces de El León de Oro"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34944435646?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Lo%20que%20sirve%20El%20Le%C3%B3n%20de%20Oro." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Lo que sirve El León de Oro"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
