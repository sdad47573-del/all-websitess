---
import '../styles/global.css';

const business = {
	name: 'Bar El Rincón de Adel',
	short: 'El Rincón de Adel',
	city: 'Barbate',
	latitude: 36.25486,
	longitude: -5.9676175,
	site: 'https://www.sur-digital.com/bar-el-rincon-de-adel',
};

const mapsUrl =
	'https://www.google.com/maps/place/Bar+El+rinc%C3%B3n+de+Adel/@36.25486,-5.9676175,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c45cf53b6aa1b:0x3ce5211a917c7d4b!8m2!3d36.25486!4d-5.9676175!16s%2Fg%2F11bzzgkk4y?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;

const specialties = [
	{
		kicker: 'De barrio',
		title: 'Bar español',
		text: 'Bar de cocina tradicional y productos de la tierra, según la reapertura anunciada.',
	},
	{
		kicker: 'De siempre',
		title: 'Cocina tradicional',
		text: 'Tapas y platos de la tierra para el día a día.',
	},
	{
		kicker: 'En Barbate',
		title: 'Centro de Barbate',
		text: 'En el casco de Barbate: confirma la dirección exacta en su ficha de Maps.',
	},
	{
		kicker: 'Valorado',
		title: '4,5 en directorio',
		text: 'Unas 250 valoraciones con un 4,5 en directorio local.',
	},
	{
		kicker: 'Aviso',
		title: 'Sin teléfono publicado',
		text: 'Sin teléfono ni horario en fuente sólida: usa la ficha de Maps.',
	},
	{
		kicker: 'Aviso',
		title: 'Carta del día',
		text: 'Confirma la carta del día en el propio local.',
	},
];

const gallery = [
	{ src: '/bar-el-rincon-de-adel/fotos/bar.svg', alt: 'Ilustración del bar — sustituye por foto propia' },
	{ src: '/bar-el-rincon-de-adel/fotos/rincon.svg', alt: 'Ilustración del rincón — sustituye por foto propia' },
	{ src: '/bar-el-rincon-de-adel/fotos/tierra.svg', alt: 'Ilustración de productos — sustituye por foto propia' },
	{ src: '/bar-el-rincon-de-adel/fotos/tapa.svg', alt: 'Ilustración de tapas — sustituye por foto propia' },
	{ src: '/bar-el-rincon-de-adel/fotos/salon.svg', alt: 'Ilustración del salón — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está El Rincón de Adel?',
		a: 'En Barbate (Cádiz), coordenadas 36.25486, -5.9676175. Confirma la dirección exacta en su ficha de Google Maps.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'El horario no está publicado en una fuente sólida. Consulta su ficha de Google Maps antes de venir.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Bar de cocina tradicional y productos de la tierra. Confirma la carta del día en el propio local.',
	},
	{
		q: '¿Tienen teléfono?',
		a: 'No hay teléfono publicado en fuente sólida. Usa el botón «Ver en Google Maps» para su ficha.',
	},
	{
		q: '¿Cómo llego?',
		a: 'En el centro de Barbate. Usa el botón «Cómo llegar» para abrir la ruta en Google Maps.',
	},
];

const description =
	'Bar El Rincón de Adel en Barbate: bar de cocina tradicional y productos de la tierra. Consulta su ficha de Google Maps.';

const businessSchema = {
	'@context': 'https://schema.org',
	'@type': 'BarOrPub',
	'@id': `${business.site}/#bar`,
	name: business.name,
	description,
	url: `${business.site}/`,
	image: [`${business.site}/fotos/bar.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Andaluza'],
	address: {
		'@type': 'PostalAddress',
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.5,
		reviewCount: 250,
		bestRating: 5,
	},
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="El Rincón de Adel: bar de cocina tradicional en Barbate. Consulta su ficha de Google Maps." />
		<meta name="keywords" content="Rincón de Adel Barbate, bar Barbate centro, comer Barbate" />
		<meta name="author" content="El Rincón de Adel" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/bar-el-rincon-de-adel/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>El Rincón de Adel | Bar tradicional en Barbate</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="El Rincón de Adel · Tradicional en Barbate" />
		<meta property="og:description" content="Bar de cocina tradicional y productos de la tierra en Barbate." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/bar.svg`} />
		<meta property="og:image:alt" content="El Rincón de Adel, Barbate" />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:country-name" content="España" />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="El Rincón de Adel · Bar en Barbate" />
		<meta name="twitter:description" content="Tradicional de la tierra en Barbate." />
		<meta name="twitter:image" content={`${business.site}/fotos/bar.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(businessSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Barbate" />
		<meta name="geo.position" content="36.25486;-5.9676175" />
		<meta name="ICBM" content="36.25486, -5.9676175" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="El Rincón de Adel, inicio">
				<span class="brand-mark" aria-hidden="true">RA</span>
				<span class="brand-name">El Rincón de Adel <small>Barbate · Centro</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">El bar</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={mapsUrl} target="_blank" rel="noreferrer">Ver en Maps ↗</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Barbate · Cádiz</p>
					<h1 id="hero-title">De la tierra<br />al <em>rincón.</em></h1>
					<p class="hero-lede">
						Bar de cocina tradicional en Barbate, con productos de la tierra
						y ambiente de barrio.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,5</b> en directorio</li>
						<li><b>Bar</b> tradicional</li>
						<li>De la tierra</li>
						<li>Barbate</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/bar-el-rincon-de-adel/fotos/bar.svg" alt="Ilustración de El Rincón de Adel, Barbate" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Barbate · Cádiz</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>4,5</b><span>Directorio</span></div>
					<div><b>Bar</b><span>Tradicional</span></div>
					<div><b>Tierra</b><span>De la tierra</span></div>
				</div>
				<ul class="services">
					<li>Tradicional</li>
					<li>Tapas</li>
					<li>Tierra</li>
					<li>Barrio</li>
					<li>Centro</li>
					<li>Maps</li>
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> El bar</p>
				<div class="about-grid">
					<h2>Un rincón<br />de <em>Barbate.</em></h2>
					<div class="about-copy">
						<p>
							El Rincón de Adel está en Barbate (Cádiz),
							con coordenadas 36.25486, -5.9676175.
						</p>
						<p>
							Bar español de cocina tradicional y productos de la tierra,
							reabierto bajo nueva gerencia según el anuncio local.
						</p>
						<p class="about-note">
							Dirección exacta, teléfono y horario sin fuente sólida publicada.
							Consulta su ficha de Google Maps antes de venir.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales de bar tradicional. Confirma la carta del día
						en el propio local.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El rincón<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del bar.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Barbate</p>
					<h2>Ven al rincón<br /><em>a comer.</em></h2>
					<p class="address">
						{business.city} (Cádiz), España<br />
						36.25486, -5.9676175
					</p>

					<table class="hours">
						<caption>Contacto</caption>
						<tbody>
							<tr>
								<th scope="row">Dirección y horario</th>
								<td>En su ficha de Google Maps</td>
							</tr>
							<tr>
								<th scope="row">Teléfono</th>
								<td>Sin fuente sólida publicada</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Sin teléfono ni horario inventados. Consulta la ficha antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Maps ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de El Rincón de Adel en Barbate" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> El Rincón · Barbate</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">RA</span>
				<p>El Rincón de Adel<small>Barbate</small></p>
			</div>
			<nav aria-label="Enlaces del bar">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
			</nav>
			<small>© {new Date().getFullYear()} El Rincón de Adel · Barbate. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/bar-el-rincon-de-adel/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/bar-el-rincon-de-adel/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/bar-el-rincon-de-adel/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

	</body>
</html>
