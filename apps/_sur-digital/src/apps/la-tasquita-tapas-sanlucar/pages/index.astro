---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/la-tasquita-tapas-sanlucar-apaisada-07.jpg';
import foto1 from '../assets/fotos/la-tasquita-tapas-sanlucar-apaisada-01.jpg';
import foto2 from '../assets/fotos/la-tasquita-tapas-sanlucar-vertical-02.jpg';
import foto3 from '../assets/fotos/la-tasquita-tapas-sanlucar-vista-4-04.jpg';
import foto4 from '../assets/fotos/la-tasquita-tapas-sanlucar-vertical-05.jpg';
import foto5 from '../assets/fotos/la-tasquita-tapas-sanlucar-apaisada-06.jpg';

const business = {
	name: 'La Tasquita Tapas',
	street: 'C. Trascuesta, 9',
	city: 'Sanlúcar de Barrameda',
	region: 'Andalucía',
	province: 'Cádiz',
	postalCode: '11540',
	phone: '+34 633 58 35 49',
	latitude: 36.7776339,
	longitude: -6.3536048,
	site: 'https://www.sur-digital.com/la-tasquita-tapas-sanlucar',
};

const mapsUrl =
	'https://www.google.com/maps/place/La+Tasquita+Tapas+restaurante/data=!4m7!3m6!1s0xd0ddfa72d7b4851:0x68e3644f620f7ec!8m2!3d36.7776339!4d-6.3536048!16s%2Fg%2F11q2ycbwhn!19sChIJUUh7LaffDQ0R7Pcg9kQ2jgY?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34633583549';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'La que más citan',
		title: 'Tosta de atún rojo',
		text: 'La tapa destacada en las reseñas de la casa, junto al surtido de atún. Producto de la costa gaditana en formato tosta.',
	},
	{
		kicker: 'Del mar',
		title: 'Corvina y sardinas',
		text: 'Ensalada tibia de corvina y tosta de sardinas: dos de los platos que los clientes nombran cuando recomiendan el local.',
	},
	{
		kicker: 'Frescas',
		title: 'Boquerones y ceviche',
		text: 'Ensalada de boquerones con tomate y ceviche. Tapas frescas para abrir o para compartir en terraza.',
	},
	{
		kicker: 'De cuchara y brasa',
		title: 'Surtido y lagarto',
		text: 'Surtido de atún y lagarto entre lo que piden quienes repiten. Pregunta por el fuera de carta del día.',
	},
	{
		kicker: 'El local',
		title: 'Terraza y salón',
		text: 'Local climatizado con terraza exterior para 35 personas y salón interior para 24. A partir de 10 personas se reserva el salón completo.',
	},
	{
		kicker: 'Para grupos',
		title: 'Salón completo',
		text: 'Si vienes en grupo, llama antes: el salón se reserva completo desde 10 comensales. Teléfono 633 58 35 49.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de La Tasquita Tapas publicada en su ficha de Google Maps (Sanlúcar de Barrameda)' },
	{ src: photos.foto2, alt: 'Interior de La Tasquita Tapas, restaurante en la calle Trascuesta, Sanlúcar' },
	{ src: photos.foto3, alt: 'Fotografía de La Tasquita Tapas en Sanlúcar de Barrameda, desde Google Maps' },
	{ src: photos.foto4, alt: 'Imagen de La Tasquita Tapas (Sanlúcar de Barrameda) subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Detalle de La Tasquita Tapas según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está La Tasquita Tapas?',
		a: 'En la calle Trascuesta, 9, 11540 Sanlúcar de Barrameda (Cádiz). Coordenadas 36.7776339, -6.3536048.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Lunes cerrado, martes de 10:30 a 16:00, miércoles y jueves según la ficha de 10:30 a 16:00 (la ficha muestra “10:30–4:00”, conviene confirmar la tarde), viernes de 9:00 a 23:30, sábado de 10:30 a 23:30 y domingo de 9:00 a 17:00. Llama antes en festivos.',
	},
	{
		q: '¿Cómo reservo mesa?',
		a: 'Llamando al 633 58 35 49. A partir de 10 personas se reserva el salón completo, así que para grupos conviene llamar con antelación.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Tapas marineras: tosta de atún rojo, surtido de atún, ensalada tibia de corvina, tosta de sardinas, ensalada de boquerones con tomate, ceviche y lagarto.',
	},
	{
		q: '¿Tiene terraza y es accesible?',
		a: 'Sí: terraza exterior para unas 35 personas y salón interior climatizado para 24. La ficha marca acceso, aseo y asientos adaptados para sillas de ruedas.',
	},
];

const images = [
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'La Tasquita Tapas en Sanlúcar de Barrameda (calle Trascuesta, 9): tosta de atún rojo, corvina, sardinas y tapas marineras con terraza. Reserva en el 633 58 35 49.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: 'La Tasquita Tapas restaurante',
	description,
	url: `${business.site}/`,
	telephone: '+34 633 58 35 49',
	image: images,
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo, tarjeta de crédito',
	servesCuisine: ['Española', 'Tapas', 'Pescados y mariscos', 'Andaluza'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Tuesday', opens: '10:30', closes: '16:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Wednesday', 'Thursday'], opens: '10:30', closes: '16:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '09:00', closes: '23:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '10:30', closes: '23:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '09:00', closes: '17:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza exterior', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Salón climatizado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Ideal para grupos', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.7,
		reviewCount: 866,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1b1714" />
		<meta
			name="description"
			content="La Tasquita Tapas en Sanlúcar de Barrameda: tosta de atún rojo, corvina, sardinas y tapas marineras en la calle Trascuesta, 9. Reserva en el 633 58 35 49."
		/>
		<meta
			name="keywords"
			content="La Tasquita Tapas Sanlúcar, restaurante calle Trascuesta, tapas Sanlúcar de Barrameda, atún rojo Sanlúcar, tosta sardinas, ensalada corvina, ceviche Sanlúcar"
		/>
		<meta name="author" content="La Tasquita Tapas" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/la-tasquita-tapas-sanlucar/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>La Tasquita Tapas | Tapas marineras en Sanlúcar</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="La Tasquita Tapas · Tapas marineras en Sanlúcar" />
		<meta
			property="og:description"
			content="Tosta de atún rojo, corvina, sardinas y ceviche en la calle Trascuesta, 9 (Sanlúcar de Barrameda). Terraza y salón climatizado."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="La Tasquita Tapas, restaurante en Sanlúcar de Barrameda" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="La Tasquita Tapas · Tapas marineras en Sanlúcar" />
		<meta
			name="twitter:description"
			content="Tapas marineras en la calle Trascuesta, 9 (Sanlúcar de Barrameda): atún rojo, corvina y sardinas."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Sanlúcar de Barrameda" />
		<meta name="geo.position" content="36.7776339;-6.3536048" />
		<meta name="ICBM" content="36.7776339, -6.3536048" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="La Tasquita Tapas, inicio">
				<span class="brand-mark" aria-hidden="true">T</span>
				<span class="brand-name">La Tasquita Tapas <small>Sanlúcar · Trascuesta</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#tasquita">La tasquita</a>
				<a href="#especialidades">Especialidades</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>633 58 35 49</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Calle Trascuesta · Sanlúcar</p>
					<h1 id="hero-title">Tapas marineras<br />de verdad<br /><em>en Sanlúcar.</em></h1>
					<p class="hero-lede">
						La Tasquita Tapas en la calle Trascuesta: tosta de atún rojo, corvina, sardinas y ceviche en un
						local climatizado con terraza para 35 y salón para 24. Cocina de producto, para picar o para
						quedarse.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>
							Reservar 633 58 35 49
						</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,7</b> en Google (866 reseñas)</li>
						<li>Atún rojo</li>
						<li>Terraza 35 pax</li>
						<li>Salón climatizado</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="webp"
						quality={70}
						alt="Fotografía de La Tasquita Tapas publicada en su ficha de Google Maps (Sanlúcar de Barrameda)"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,7</b><span>Google</span></div>
					<div><b>866</b><span>Reseñas</span></div>
					<div><b>35+24</b><span>Terraza+salón</span></div>
				</div>
				<ul class="services">
					<li>Terraza</li>
					<li>Climatizado</li>
					<li>Local accesible</li>
					<li>Grupos</li>
					<li>Reservas</li>
					<li>Tapas</li>
				</ul>
			</section>

			<section class="about section-pad" id="tasquita">
				<p class="section-label"><span aria-hidden="true"></span> Una tasquita en Sanlúcar</p>
				<div class="about-grid">
					<h2>Producto de la costa<br />en la Trascuesta<br /><em>para picar.</em></h2>
					<div class="about-copy">
						<p>
							La Tasquita Tapas restaurante está en la calle Trascuesta, 9, 11540 Sanlúcar de Barrameda
							(Cádiz). Restaurante de tapas marineras con terraza exterior para unas 35 personas y salón
							interior climatizado para 24.
						</p>
						<p>
							Lo que más citan sus clientes: tosta de atún rojo, ensalada tibia de corvina, tosta de
							sardinas, ensalada de boquerones con tomate, ceviche, surtido de atún y lagarto.
						</p>
						<p class="about-note">
							Sobre el horario: la ficha de Google Maps marca lunes cerrado, martes de 10:30 a 16:00,
							viernes de 9:00 a 23:30, sábado de 10:30 a 23:30 y domingo de 9:00 a 17:00. Miércoles y jueves
							figuran como “10:30–4:00”: confirma la tarde por teléfono antes de venir.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="especialidades">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su carta</p>
						<h2>Lo que más<br />se pide <em>en la mesa.</em></h2>
					</div>
					<p>
						Platos citados en las reseñas de sus clientes: atún, corvina, sardinas y frescos para compartir.
						La carta cambia, así que confirma disponibilidad al reservar.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>La tasquita<br /><em>por dentro.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de La Tasquita Tapas. En la ficha
							encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="webp"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres
					el titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Calle Trascuesta, 9</p>
					<h2>Ven de tapas<br /><em>a Sanlúcar.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes</th>
								<td>Cerrado</td>
							</tr>
							<tr>
								<th scope="row">Martes</th>
								<td>10:30 – 16:00</td>
							</tr>
							<tr>
								<th scope="row">Miércoles y jueves</th>
								<td>10:30 – 16:00*</td>
							</tr>
							<tr>
								<th scope="row">Viernes</th>
								<td>9:00 – 23:30</td>
							</tr>
							<tr>
								<th scope="row">Sábado</th>
								<td>10:30 – 23:30</td>
							</tr>
							<tr>
								<th scope="row">Domingo</th>
								<td>9:00 – 17:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						*La ficha muestra “10:30–4:00” para miércoles y jueves: confirma la tarde por teléfono.
						En festivos, llama antes de venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>
							Llamar 633 58 35 49
						</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 633 58 35 49</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de La Tasquita Tapas en la calle Trascuesta, 9, Sanlúcar de Barrameda"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> La Tasquita Tapas · Sanlúcar
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">T</span>
				<p>La Tasquita Tapas<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} La Tasquita Tapas · Sanlúcar de Barrameda. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>

			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
