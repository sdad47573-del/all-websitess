---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import terraza from '../assets/fotos/restaurante-llevant-apaisada-01.jpg';
import cervezas from '../assets/fotos/restaurante-llevant-panoramica-02.jpg';
import costa from '../assets/fotos/restaurante-llevant-apaisada-03.jpg';
import mar from '../assets/fotos/restaurante-llevant-panoramica-04.jpg';
import vino from '../assets/fotos/restaurante-llevant-vertical-05.jpg';
import noche from '../assets/fotos/restaurante-llevant-panoramica-06.jpg';
import terrazaGente from '../assets/fotos/restaurante-llevant-apaisada-07.jpg';
import velero from '../assets/fotos/restaurante-llevant-panoramica-08.jpg';
import picoteo from '../assets/fotos/restaurante-llevant-panoramica-09.jpg';
import ibiza from '../assets/fotos/restaurante-llevant-panoramica-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Restaurante Llevant, en C. de Carles Roman Ferrer, 5 (Figueretes, Eivissa). Cocina catalana y terraza frente al mar con vistas a Ibiza y Dalt Vila. Atardeceres y picoteo.';

const galeria = [
	{
		src: terraza,
		alt: 'Terraza de Llevant bajo una lona blanca, con mesas y sillas verdes junto al mar y vistas a la costa de Ibiza',
	},
	{
		src: terrazaGente,
		alt: 'Terraza de Llevant al sol con clientes sentados, bombillas colgadas y la isla al fondo',
	},
	{
		src: picoteo,
		alt: 'Nachos con guacamole y nata agria, calamares a la romana, croquetas y ensaladilla sobre una mesa blanca',
	},
	{
		src: cervezas,
		alt: 'Tres copas de cerveza de barril Estrella Galicia sobre una mesa blanca frente al mar',
	},
	{
		src: vino,
		alt: 'Copa de vino blanco y gafas de sol en una mesa de la terraza, con el mar y la barandilla de cuerda al fondo',
	},
	{
		src: mar,
		alt: 'Mar de Figueretes con un velero y el islote del faro al fondo, visto desde la terraza',
	},
	{
		src: costa,
		alt: 'Agua turquesa sobre las rocas de la orilla con la ciudad de Ibiza al fondo',
	},
	{
		src: velero,
		alt: 'Vista del mar desde la barandilla de cuerda de la terraza, con veleros y el islote a lo lejos',
	},
	{
		src: noche,
		alt: 'Vista nocturna de la bahía de Ibiza desde la terraza, con las luces del paseo marítimo',
	},
	{
		src: ibiza,
		alt: 'Panorámica de Ibiza con Dalt Vila y el casco urbano desde la orilla de Figueretes',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#llevant`,
	name: BUSINESS.name,
	alternateName: ['Llevant', 'Llevant Ibiza', 'Restaurante Llevant Ibiza', 'Llevant Figueretes'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	currenciesAccepted: 'EUR',
	servesCuisine: ['Catalana', 'Mediterránea'],
	areaServed: [
		{ '@type': 'City', name: 'Eivissa' },
		{ '@type': 'AdministrativeArea', name: 'Figueretes' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Llevant · Terraza frente al mar en Figueretes, Ibiza';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-llevant-apaisada-01.jpg": terraza,
	"restaurante-llevant-apaisada-07.jpg": terrazaGente,
	"restaurante-llevant-panoramica-09.jpg": picoteo,
	"restaurante-llevant-panoramica-02.jpg": cervezas,
	"restaurante-llevant-vertical-05.jpg": vino,
	"restaurante-llevant-panoramica-04.jpg": mar,
	"restaurante-llevant-apaisada-03.jpg": costa,
	"restaurante-llevant-panoramica-08.jpg": velero,
	"restaurante-llevant-panoramica-06.jpg": noche,
	"restaurante-llevant-panoramica-10.jpg": ibiza,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1d6b7a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Llevant Ibiza, restaurante Llevant, terraza Figueretes, comer en Figueretes, tomar algo frente al mar Ibiza, puesta de sol Ibiza, cocina catalana Ibiza, Carles Roman Ferrer"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Llevant · Terraza frente al mar en Figueretes, Ibiza"
			ogDescription="Terraza sobre el mar en Figueretes (Ibiza), con vistas a Dalt Vila y al atardecer. Para picar y beber algo. C. de Carles Roman Ferrer, 5."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Terraza de Llevant bajo una lona blanca con vistas al mar en Figueretes"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1d6b7a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[terraza]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/restaurante-llevant/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Restaurante Llevant"
			subtitle="Cocina catalana · Figueretes, Ibiza"
			phone="Ver ficha"
			phoneHref={MAPS.place}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
				reviews={REVIEWS}
				googleMaps={MAPS.place}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone="en Google Maps"
			phoneHref={MAPS.place}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; el horario y el contacto están en la ficha de Google."
			ctaLabel="Horario y contacto"
		/>
	</body>
</html>
