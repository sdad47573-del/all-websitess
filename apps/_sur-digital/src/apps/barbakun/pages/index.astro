---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/barbakun-fachada.jpg';
import pizza from '../assets/fotos/barbakun-pizza.jpg';
import hamburguesa from '../assets/fotos/barbakun-hamburguesa.jpg';
import fritos from '../assets/fotos/barbakun-fritos.jpg';
import patatas from '../assets/fotos/barbakun-patatas-asadas.jpg';
import comedor from '../assets/fotos/barbakun-comedor.jpg';
import rellenas from '../assets/fotos/barbakun-patatas-rellenas.jpg';
import noche from '../assets/fotos/barbakun-fachada-noche.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Barbakun · Pizzas, hamburguesas y reparto en Escaldes-Engordany';
const description =
	'Barbakun, Av. Fiter i Rossell, 38 (AD700 Escaldes-Engordany). Pizzas al horno, hamburguesas, fritos y parrilla, con reparto a domicilio. 4,4 sobre 5 con 43 reseñas. Martes a domingo de 13:00 a 15:30 y de 19:30 a 23:00; lunes cerrado.';

const galeria = [
	{
		src: pizza,
		alt: 'Pizza entera en su caja, con jamón, carne picada, maíz y queso fundido',
	},
	{
		src: hamburguesa,
		alt: 'Hamburguesa en pan de sésamo envuelta en papel de cuadros rojos y blancos',
	},
	{
		src: fritos,
		alt: 'Bandeja de acero con empanadillas recién fritas',
	},
	{
		src: patatas,
		alt: 'Bandeja de patatas asadas en tandas, doradas y con sal',
	},
	{
		src: rellenas,
		alt: 'Bandeja de patatas rellenas fritas, doradas por fuera',
	},
	{
		src: comedor,
		alt: 'Comedor de Barbakun con mesa de madera, vitrina de bebidas y barra',
	},
	{
		src: noche,
		alt: 'Fachada de Barbakun de noche, con el rótulo iluminado en la avenida',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que se sirve en Barbakun',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#barbakun`,
	name: BUSINESS.name,
	alternateName: ['Barbakun Escaldes', 'Barbakun Andorra'],
	description:
		'Pizzas al horno, hamburguesas, fritos y parrilla en Escaldes-Engordany, con reparto a domicilio y servicio en mesa.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376727726',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pizza', 'Hamburguesas', 'Parrilla'],
	hasDelivery: true,
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Escaldes-Engordany' },
		{ '@type': 'City', name: 'Andorra la Vella' },
		{ '@type': 'AdministrativeArea', name: 'Andorra' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '19:30',
			closes: '23:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"barbakun-fachada.jpg": fachada,
	"barbakun-pizza.jpg": pizza,
	"barbakun-hamburguesa.jpg": hamburguesa,
	"barbakun-fritos.jpg": fritos,
	"barbakun-patatas-asadas.jpg": patatas,
	"barbakun-patatas-rellenas.jpg": rellenas,
	"barbakun-comedor.jpg": comedor,
	"barbakun-fachada-noche.jpg": noche,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#171310" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Rubik:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Barbakun Andorra, pizza Escaldes-Engordany, hamburguesas Andorra, comida a domicilio Escaldes, Fiter i Rossell 38, reparto pizza Andorra"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pizzas al horno, hamburguesas, fritos y parrilla en Escaldes-Engordany, con reparto a domicilio. 4,4 en Google con 43 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Hamburguesa de Barbakun envuelta en papel de cuadros"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#171310"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-08"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Barbakun"
			subtitle="Pizzas y parrilla · Escaldes"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma carta, precios y horario antes de pedir."
			ctaLabel="Llamar a Barbakun"
			navAriaLabel="Enlaces de Barbakun"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34376727726?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Lo%20que%20se%20sirve%20en%20Barbakun." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Lo que se sirve en Barbakun"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
