---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/freiduria-luisa-y-alexandra-vertical-09.jpg';
import cucurucho from '../assets/fotos/freiduria-luisa-y-alexandra-apaisada-01.jpg';
import mostrador from '../assets/fotos/freiduria-luisa-y-alexandra-vertical-02.jpg';
import bandeja from '../assets/fotos/freiduria-luisa-y-alexandra-vertical-03.jpg';
import platoBoquerones from '../assets/fotos/freiduria-luisa-y-alexandra-apaisada-08.jpg';
import croquetasPatatas from '../assets/fotos/freiduria-luisa-y-alexandra-apaisada-05.jpg';
import croquetasMahonesa from '../assets/fotos/freiduria-luisa-y-alexandra-vertical-10.jpg';
import bolsaBascula from '../assets/fotos/freiduria-luisa-y-alexandra-vertical-06.jpg';
import flanes from '../assets/fotos/freiduria-luisa-y-alexandra-apaisada-04.jpg';
import tartaQueso from '../assets/fotos/freiduria-luisa-y-alexandra-apaisada-07.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'Freiduría Luisa y Alexandra · Pescado frito para llevar en Sevilla';
const description = BUSINESS.description;

const galeria = [
	{
		src: mostrador,
		alt: 'Mesa con bandejas de fritos variados: calamares, gambas, boquerones, salmonetes, croquetas y tortillitas, todas con su rodaja de limón',
	},
	{
		src: cucurucho,
		alt: 'Boquerones fritos en un cucurucho de papel abierto sobre una bandeja de aluminio, con un gajo de limón',
	},
	{
		src: bandeja,
		alt: 'Bandeja con frito variado: calamares, boquerones, aletrías, patatas y limón',
	},
	{
		src: platoBoquerones,
		alt: 'Cuatro boquerones fritos sobre un plato blanco con una rodaja de limón',
	},
	{
		src: croquetasPatatas,
		alt: 'Seis croquetas caseras junto a una ración de patatas fritas en un plato blanco',
	},
	{
		src: croquetasMahonesa,
		alt: 'Plato de croquetas fritas doradas con una cucharada de mahonesa al lado',
	},
	{
		src: bolsaBascula,
		alt: 'Bolsa de papel con boquerones fritos recién pesados en la báscula del local, que marca 203 gramos',
	},
	{
		src: flanes,
		alt: 'Cinco vasitos de flan casero con chocolate rallado por encima',
	},
	{
		src: tartaQueso,
		alt: 'Vasito de tarta de queso con mermelada de frutos rojos y láminas de almendra',
	},
];

const carta = [
	{
		title: 'Del frito',
		items: [
			{ name: 'Pescado frito variado', note: 'la bandeja que una reseña pide «para dos personas»' },
			{ name: 'Chocos', note: 'los que una reseña destacada llama deliciosos' },
			{ name: 'Boquerones', note: 'en cucurucho de papel, con limón' },
			{ name: 'Salmonetes', note: 'en la bandeja de frito, tal y como se ven en las fotos' },
		],
	},
	{
		title: 'Para picar',
		items: [
			{ name: 'Croquetas', note: 'caseras, servidas con patatas o con mahonesa' },
			{ name: 'Patatas fritas', note: 'Google clasifica el local como tienda de pescado y papas fritas' },
			{ name: 'Calamares y gambas', note: 'en la mesa de fritos que el local publica en su perfil' },
		],
	},
	{
		title: 'Postre y para llevar',
		items: [
			{ name: 'Flan casero con chocolate', note: 'en vasitos, recién preparado' },
			{ name: 'Tarta de queso con frutos rojos', note: 'también en vasito, con almendra' },
			{ name: 'Cucurucho o bandeja', note: 'el frito va en papel o en bandeja de aluminio' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'FastFoodRestaurant',
	'@id': `${BUSINESS.siteUrl}/#freiduria`,
	name: BUSINESS.name,
	alternateName: [
		'Freiduría Luisa y Alexandra',
		'Freiduria Luisa Alexandra',
		'Freiduría Emilio Lemos',
	],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pescado frito', 'Freiduría', 'Comida para llevar'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Sevilla Este, Sevilla' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '01:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"freiduria-luisa-y-alexandra-vertical-09.jpg": fachada,
	"freiduria-luisa-y-alexandra-vertical-02.jpg": mostrador,
	"freiduria-luisa-y-alexandra-apaisada-01.jpg": cucurucho,
	"freiduria-luisa-y-alexandra-vertical-03.jpg": bandeja,
	"freiduria-luisa-y-alexandra-apaisada-08.jpg": platoBoquerones,
	"freiduria-luisa-y-alexandra-apaisada-05.jpg": croquetasPatatas,
	"freiduria-luisa-y-alexandra-vertical-10.jpg": croquetasMahonesa,
	"freiduria-luisa-y-alexandra-vertical-06.jpg": bolsaBascula,
	"freiduria-luisa-y-alexandra-apaisada-04.jpg": flanes,
	"freiduria-luisa-y-alexandra-apaisada-07.jpg": tartaQueso,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0b1a20" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:ital,wght@0,500;0,700;0,800;1,700&family=Karla:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Freiduría Luisa y Alexandra, freiduría Sevilla, pescado frito para llevar Sevilla, papas fritas para llevar 41020, freiduría Emilio Lemos, frito variado Sevilla Este, chocos fritos Sevilla, boquerones fritos para llevar, freiduría avenida de Emilio Lemos 19"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Freiduría para llevar en la avenida de Emilio Lemos 19, local 5C1, Sevilla. Pescado frito, chocos y papas fritas todos los días de 13:00 a 17:00 y de 20:00 a 1:00. Pedidos en el 642 98 38 13."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo de Freiduría Luisa y Alexandra con la bandeja de fritos y el teléfono de pedidos"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#0b1a20"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Emilio Lemos, Sevilla"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/freiduria-luisa-y-alexandra/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Freiduría Luisa y Alexandra"
			subtitle="Pescado frito · Emilio Lemos"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
				reviews={REVIEWS}
				googleMaps={MAPS.place}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Freiduría Luisa y Alexandra"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías tomados de la ficha y del perfil públicos del local en Google Maps. Sin carta de precios publicada: confirma horario, disponibilidad y reparto antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de la Freiduría Luisa y Alexandra"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34642983813?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Pescado%20frito%20variado." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Pescado frito variado"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
