---
import { Image } from '@astro-components';
import { GALLERY } from '../data/site';
---

<section id="galeria" class="bg-base-100 scroll-mt-20 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">Galería</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">Bar Perla por dentro</h2>
			<div class="bg-secondary mx-auto mt-5 h-0.5 w-24"></div>
			<p class="text-base-content/70 mt-6">
				Fotos reales del bar, tomadas de su ficha pública de Google Maps.
			</p>
		</div>

		<div class="mt-12 grid auto-rows-[165px] grid-cols-2 gap-3 sm:auto-rows-[205px] lg:grid-cols-4">
			{
				GALLERY.map((foto, index) => (
					<figure
						class:list={[
							'overflow-hidden rounded-lg shadow-md',
							index === 0 && 'col-span-2 row-span-2',
							index === 5 && 'sm:col-span-2',
						]}
					>
						<Image
							src={foto.src}
							alt={foto.alt}
							widths={[400, 700, 1000]}
							sizes="(min-width: 1024px) 24vw, 48vw"
							quality={80}
							loading="lazy"
							class="foto-calida h-full w-full object-cover transition-transform duration-700 hover:scale-[1.04]"
						/>
					</figure>
				))
			}
		</div>
		<p class="text-base-content/50 mt-6 text-center text-xs">
			Galería de la ficha de Google Maps del bar.
		</p>
	</div>
</section>
