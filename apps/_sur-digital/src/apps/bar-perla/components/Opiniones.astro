---
import { BUSINESS, REVIEWS } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
---

<section id="opiniones" class="bg-base-200 trama-perla scroll-mt-20 py-20 sm:py-24">
	<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
		<div class="text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">Opiniones</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">Lo que dicen en Google</h2>
			<div class="bg-secondary mx-auto mt-5 h-0.5 w-24"></div>
		</div>

		<div class="border-base-300 bg-base-100 mt-12 grid gap-8 rounded-lg border p-8 sm:p-10 lg:grid-cols-[0.6fr_1.4fr] lg:items-center">
			<div class="text-center lg:text-left">
				<p class="font-display text-6xl leading-none font-bold">
					{BUSINESS.rating.toString().replace('.', ',')}
				</p>
				<p class="mt-3">
					<span class="text-primary tracking-tight" aria-hidden="true">
						{
							estrellas.map((n) => (
								<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
							))
						}
					</span>
				</p>
				<p class="text-base-content/60 mt-2 text-sm">{BUSINESS.reviewCount} reseñas en Google</p>
				<p class="text-base-content/50 mt-4 text-xs leading-relaxed">
					Valoración media consultada en octubre de 2026. Las opiniones cambian con el tiempo.
				</p>
			</div>

			<div class="border-base-300 lg:border-l lg:pl-10">
				<i class="ri-quote-text text-secondary/40 text-3xl" aria-hidden="true" />
				{
					REVIEWS.map((review) => (
						<figure>
							<blockquote class="font-display mt-3 text-2xl leading-snug font-medium sm:text-3xl">
								{review.text}
							</blockquote>
							<figcaption class="mt-5 flex items-center justify-between gap-3">
								<span class="text-base-content/60 text-xs font-semibold tracking-[0.12em] uppercase">
									{review.author}
								</span>
								<span class="text-primary text-sm" aria-label={`${review.rating} de 5 estrellas`}>
									{estrellas.map((n) => (
										<i class={n <= review.rating ? 'ri-star-fill' : 'ri-star-line'} />
									))}
								</span>
							</figcaption>
						</figure>
					))
				}
				<p class="text-base-content/50 mt-6 text-xs leading-relaxed">
					Selección de una reseña positiva publicada en Google.
				</p>
			</div>
		</div>

		<p class="mt-8 text-center text-sm">
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="text-primary font-semibold underline underline-offset-4"
			>
				Leer todas las reseñas en Google Maps
			</a>
		</p>
	</div>
</section>
