---
import { BUSINESS, NAV, SUR_DIGITAL_URL } from '../data/site';

interface Props {
	base?: string;
}

const { base = '' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-neutral text-neutral-content relative overflow-hidden">
	<div class="border-accent/30 border-t" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-7xl px-4 pt-14 pb-28 sm:px-6 sm:pb-14 lg:px-8">
		<div class="flex flex-col gap-6 border-b border-white/10 pb-10 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="label text-accent text-[0.55rem]">Onda · Castellón</p>
				<p class="font-display mt-2 text-4xl leading-none font-semibold tracking-[-0.02em] sm:text-5xl">
					La <span class="text-accent italic">Alacena</span>
				</p>
				<p class="text-base-content mt-3 max-w-xs text-sm leading-relaxed text-white/55">
					Cocina casera, bocadillos de mostrador y carnes a la brasa en el centro de Onda.
				</p>
			</div>
			<a
				href={BUSINESS.phoneHref}
				class="btn btn-accent btn-sm h-11 w-fit gap-2 rounded-full px-5 text-[0.7rem] font-semibold"
			>
				<i class="ri-phone-line text-base" aria-hidden="true"></i>
				{BUSINESS.phone}
			</a>
		</div>

		<div class="mt-9 grid gap-9 sm:grid-cols-2 lg:grid-cols-4">
			<div class="sm:col-span-2 lg:col-span-1">
				<p class="label text-white/35 text-[0.52rem]">La casa</p>
				<p class="mt-3 max-w-xs text-sm leading-relaxed text-white/60">
					Desayunos desde las 8:00, almuerzos de mostrador, menú del día y carnes a la brasa.
					De lunes a sábado, en el centro de Onda.
				</p>
				<div class="mt-5 flex items-center gap-2 text-sm">
					<i class="ri-star-fill text-accent" aria-hidden="true"></i>
					<span class="font-semibold text-white">{BUSINESS.rating.toString().replace('.', ',')}</span>
					<span class="text-white/40">· {BUSINESS.reviewCount} reseñas en Google</span>
				</div>
			</div>

			<div>
				<h2 class="label text-white/35 text-[0.52rem]">Navegación</h2>
				<ul class="mt-3 space-y-2.5 text-sm">
					{NAV.map((item) => (
						<li>
							<a href={`${base}${item.href}`} class="text-white/70 transition-colors hover:text-white">
								{item.label}
							</a>
						</li>
					))}
					<li>
						<a href={`${base}aviso-legal`} class="text-white/70 transition-colors hover:text-white">
							Aviso legal y privacidad
						</a>
					</li>
				</ul>
			</div>

			<div>
				<h2 class="label text-white/35 text-[0.52rem]">Horario</h2>
				<ul class="mt-3 space-y-1.5 text-xs">
					{BUSINESS.hours.map((row) => (
						<li class="flex items-baseline justify-between gap-3">
							<span class="text-white/45">{row.days}</span>
							<span class={row.hours === 'Cerrado' ? 'text-white/25' : 'text-white/75'}>
								{row.hours}
							</span>
						</li>
					))}
				</ul>
			</div>

			<div>
				<h2 class="label text-white/35 text-[0.52rem]">Contacto</h2>
				<ul class="mt-3 space-y-3 text-sm">
					<li class="flex gap-2">
						<i class="ri-map-pin-line text-accent mt-0.5" aria-hidden="true"></i>
						<a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="text-white/65 transition-colors hover:text-white"
						>
							{BUSINESS.street}
							<br />
							{BUSINESS.postalCode} {BUSINESS.city}
							<br />
							{BUSINESS.region}
						</a>
					</li>
					<li class="flex gap-2">
						<i class="ri-phone-line text-accent mt-0.5" aria-hidden="true"></i>
						<a href={BUSINESS.phoneHref} class="text-white/65 transition-colors hover:text-white">
							{BUSINESS.phone}
						</a>
					</li>
					<li class="flex gap-2">
						<i class="ri-google-fill text-accent mt-0.5" aria-hidden="true"></i>
						<a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="text-white/65 transition-colors hover:text-white"
						>
							Ficha y reseñas en Google
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div
			class="mt-11 flex flex-col gap-3 border-t border-white/10 pt-5 text-[0.62rem] text-white/40 lg:flex-row lg:items-center lg:justify-between"
		>
			<p>© {year} {BUSINESS.name} · {BUSINESS.city}</p>
			<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
				<a href={`${base}aviso-legal`} class="transition-colors hover:text-white">Aviso legal</a>
				<a href={`${base}aviso-legal#cookies`} class="transition-colors hover:text-white">Cookies</a>
				<span class="hidden text-white/20 sm:inline">|</span>
				<p>
					Creado por Sur Digital ·
					<a
						href={SUR_DIGITAL_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-accent font-semibold text-white underline decoration-white/30 underline-offset-2 transition-colors"
					>
						sur-digital.vercel.app
					</a>
				</p>
			</div>
		</div>
	</div>
</footer>
