---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/** Nombre del negocio: va en el alt de cada foto. Obligatorio. */
	nombre: string;
	titulo?: string;
	intro?: string;
	nota?: string;
	/** Enlace a la ficha completa, si la pagina tiene uno. */
	mapsUrl?: string;
	/** Las paginas con version inglesa pasan su locale para traducir los textos. */
	locale?: 'es' | 'en';
	id?: string;
	limite?: number;
}

const {
	nombre,
	mapsUrl,
	locale = 'es',
	id = 'galeria',
	limite = 12,
} = Astro.props;

const TEXTOS = {
	es: {
		titulo: 'Fotos de la ficha de Google Maps',
		intro: (negocio: string) => `Una selección de las fotografías publicadas en la ficha de Google Maps de ${negocio}. La ficha completa reúne muchas más.`,
		nota: 'Fotografías de la ficha pública de Google Maps, alojadas aquí para servirlas optimizadas (AVIF y varios tamaños).',
		enlace: 'Ver la ficha completa en Google Maps',
		forma: { panoramica: 'panorámica', apaisada: 'horizontal', vertical: 'vertical', cuadrada: 'cuadrada' },
		general: 'general',
		alt: (forma: string, negocio: string) => `Fotografía ${forma} de ${negocio}, publicada en su ficha de Google Maps`,
		ampliar: (n: number, total: number) => `Ampliar la foto ${n} de ${total}`,
		anterior: 'Foto anterior',
		siguiente: 'Foto siguiente',
		cerrar: 'Cerrar el visor de fotos',
		visor: 'Visor de fotos',
	},
	en: {
		titulo: 'Photos from the Google Maps listing',
		intro: (negocio: string) => `A selection of the photographs published on the Google Maps listing of ${negocio}. The full listing holds many more.`,
		nota: 'Photographs from the public Google Maps listing, hosted here so they can be served optimised (AVIF and several sizes).',
		enlace: 'Open the full listing on Google Maps',
		forma: { panoramica: 'panoramic', apaisada: 'landscape', vertical: 'portrait', cuadrada: 'square' },
		general: 'general',
		alt: (forma: string, negocio: string) => `${forma} photograph of ${negocio}, published on its Google Maps listing`,
		ampliar: (n: number, total: number) => `Enlarge photo ${n} of ${total}`,
		anterior: 'Previous photo',
		siguiente: 'Next photo',
		cerrar: 'Close the photo viewer',
		visor: 'Photo viewer',
	},
};

const t = TEXTOS[locale];
const titulo = Astro.props.titulo ?? t.titulo;
const intro = Astro.props.intro ?? t.intro(nombre);
const nota = Astro.props.nota ?? t.nota;

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}', {
	eager: true,
});

/**
 * La forma viene en el nombre del archivo: `<app>-apaisada-03.jpg`.
 * Se busca por palabra suelta entre las conocidas, porque el slug de la app
 * tambien puede llevar guiones (`barberia-hair-cool-vertical-01.jpg`).
 * Se usa para el alt y para la clase de maquetacion (la panoramica ocupa dos
 * columnas y la vertical dos filas) en vez de recortarlo todo a 4:3.
 */
const FORMAS = ['panoramica', 'apaisada', 'vertical', 'cuadrada'] as const;
const galeria = Object.keys(fotos)
	.sort((a, b) => a.localeCompare(b))
	.slice(0, limite)
	.map((ruta, i) => {
		const archivo = ruta.split('/').pop() ?? '';
		const partes = archivo.split('-').slice(1, -1);
		const clave = FORMAS.find((f) => partes.includes(f)) ?? '';
		const forma = t.forma[clave as keyof typeof t.forma] ?? t.general;
		const clase = clave === 'panoramica' ? 'es-panoramica' : clave === 'vertical' ? 'es-vertical' : '';
		return { src: fotos[ruta].default, alt: t.alt(forma, nombre), clase, n: i + 1 };
	});

---
{
	galeria.length > 0 && (
		<section class="galeria" id={id} data-galeria={id} aria-labelledby={`${id}-titulo`}>
			<div class="galeria-head">
				<p class="galeria-kicker">Google Maps · {galeria.length} fotos</p>
				<h2 id={`${id}-titulo`}>{titulo}</h2>
				<p class="galeria-intro">{intro}</p>
			</div>
			<ul class="galeria-grid">
				{galeria.map((foto) => (
					<li class={foto.clase}>
						<figure>
							<button type="button" data-foto aria-label={t.ampliar(foto.n, galeria.length)}>
								<Image
									src={foto.src}
									alt={foto.alt}
									widths={[320, 480, 640, 960]}
									sizes="(max-width: 640px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="webp"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
								<span class="galeria-zoom" aria-hidden="true">
									<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
										<circle cx="11" cy="11" r="7" />
										<path d="m20 20-3.5-3.5M11 8v6M8 11h6" />
									</svg>
								</span>
							</button>
							<figcaption class="sr-only">{foto.alt}</figcaption>
						</figure>
					</li>
				))}
			</ul>
			{mapsUrl ? (
				<p class="galeria-nota">
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						{t.enlace} <span aria-hidden="true">↗</span>
					</a>
					{nota}
				</p>
			) : (
				<p class="galeria-nota">{nota}</p>
			)}
			<dialog class="galeria-visor" aria-label={t.visor}>
				<div class="visor-marco">
					<button type="button" class="visor-cerrar" data-cerrar autofocus>
						<span aria-hidden="true">✕</span>
						<span class="sr-only">{t.cerrar}</span>
					</button>
					<button type="button" class="visor-flecha visor-anterior" data-anterior aria-label={t.anterior}>
						<span aria-hidden="true">‹</span>
					</button>
					<figure class="visor-figura">
						<img data-visor-img alt="" />
						<figcaption class="visor-pie">
							<span data-visor-leyenda />
							<span aria-hidden="true"> · </span>
							<span data-visor-cuenta />
						</figcaption>
					</figure>
					<button type="button" class="visor-flecha visor-siguiente" data-siguiente aria-label={t.siguiente}>
						<span aria-hidden="true">›</span>
					</button>
				</div>
			</dialog>
			<script define:vars={{ id }}>
				(function () {
					var root = document.querySelector('section[data-galeria="' + id + '"]');
					if (!root) return;
					var botones = Array.prototype.slice.call(root.querySelectorAll('[data-foto]'));
					var dialogo = root.querySelector('dialog');
					if (!botones.length || !dialogo) return;
					var img = dialogo.querySelector('[data-visor-img]');
					var leyenda = dialogo.querySelector('[data-visor-leyenda]');
					var cuenta = dialogo.querySelector('[data-visor-cuenta]');
					var anterior = dialogo.querySelector('[data-anterior]');
					var siguiente = dialogo.querySelector('[data-siguiente]');
					var cerrar = dialogo.querySelector('[data-cerrar]');
					var actual = 0;
					function pintar() {
						var mini = botones[actual].querySelector('img');
						if (!mini) return;
						img.src = mini.currentSrc || mini.src;
						img.alt = mini.alt || '';
						if (leyenda) leyenda.textContent = mini.alt || '';
						if (cuenta) cuenta.textContent = actual + 1 + ' / ' + botones.length;
						if (anterior) anterior.disabled = actual === 0;
						if (siguiente) siguiente.disabled = actual === botones.length - 1;
					}
					botones.forEach(function (boton, i) {
						boton.addEventListener('click', function () {
							actual = i;
							pintar();
							if (typeof dialogo.showModal === 'function') dialogo.showModal();
						});
					});
					if (anterior)
						anterior.addEventListener('click', function () {
							if (actual > 0) {
								actual -= 1;
								pintar();
							}
						});
					if (siguiente)
						siguiente.addEventListener('click', function () {
							if (actual < botones.length - 1) {
								actual += 1;
								pintar();
							}
						});
					if (cerrar)
						cerrar.addEventListener('click', function () {
							dialogo.close();
						});
					dialogo.addEventListener('keydown', function (evento) {
						if (evento.key === 'ArrowLeft' && actual > 0) {
							actual -= 1;
							pintar();
							evento.preventDefault();
						} else if (evento.key === 'ArrowRight' && actual < botones.length - 1) {
							actual += 1;
							pintar();
							evento.preventDefault();
						}
					});
				})();
			</script>
		</section>
	)
}

<style>
	.galeria {
		--gal-bg: var(--ink, #172a21);
		--gal-ink: var(--cream, #f5eddd);
		--gal-line: rgba(245, 237, 221, 0.13);
		padding: clamp(4rem, 9vw, 6rem) 7vw;
		background: var(--gal-bg);
		color: var(--gal-ink);
	}
	.galeria :global(.galeria-head) {
		max-width: 48rem;
		margin: 0 auto clamp(2rem, 4vw, 3rem);
		text-align: center;
	}
	.galeria :global(.galeria-kicker) {
		margin: 0 0 1rem;
		color: var(--amber, #d9a441);
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		opacity: 0.9;
	}
	.galeria :global(h2) {
		margin: 0;
		font-family: var(--display, Georgia, serif);
		font-size: clamp(2.4rem, 4.8vw, 4rem);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.03em;
	}
	.galeria :global(.galeria-intro) {
		margin: 1.1rem 0 0;
		font-size: 0.8125rem;
		line-height: 1.85;
		opacity: 0.72;
	}
	.galeria :global(.galeria-grid) {
		display: grid;
		gap: clamp(0.6rem, 1.6vw, 1rem);
		padding: 0;
		margin: 0;
		list-style: none;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		grid-auto-flow: dense;
	}
	.galeria :global(.galeria-grid figure) {
		height: 100%;
		margin: 0;
		overflow: hidden;
		border-radius: 0;
		background: var(--gal-line);
	}
	.galeria :global(.galeria-grid [data-foto]) {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
	}
	.galeria :global(.galeria-grid [data-foto]:focus-visible) {
		outline: 3px solid var(--amber, #d9a441);
		outline-offset: 3px;
		border-radius: 0;
	}
	.galeria :global(.galeria-grid img) {
		display: block;
		width: 100%;
		height: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}
	/* La panoramica ocupa dos columnas y la vertical dos filas: se aprovecha
		el encuadre real de cada foto en vez de recortarlo todo a 4:3. */
	@media (min-width: 40rem) {
		.galeria :global(.galeria-grid .es-panoramica) {
			grid-column: span 2;
		}
		.galeria :global(.galeria-grid .es-vertical) {
			grid-row: span 2;
		}
		.galeria :global(.galeria-grid .es-vertical img) {
			aspect-ratio: auto;
		}
	}
	.galeria :global(.galeria-zoom) {
		position: absolute;
		right: 0.6rem;
		bottom: 0.6rem;
		display: inline-flex;
		padding: 0.45rem;
		border-radius: 999px;
		background: rgba(20, 16, 12, 0.65);
		color: #fff;
		opacity: 0;
		transition: opacity 0.25s ease;
		pointer-events: none;
	}
	.galeria :global(.galeria-grid [data-foto]:hover .galeria-zoom),
	.galeria :global(.galeria-grid [data-foto]:focus-visible .galeria-zoom) {
		opacity: 1;
	}
	@media (hover: none) {
		.galeria :global(.galeria-zoom) {
			opacity: 1;
		}
	}
	/* Leyenda solo para lector de pantalla y buscadores: el texto ya existe
		en el alt, aqui queda como contenido indexable sin ensuciar la tarjeta. */
	.galeria :global(.sr-only) {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	.galeria :global(.galeria-nota) {
		max-width: 46rem;
		margin: clamp(1.5rem, 3vw, 2rem) auto 0;
		font-size: 0.6875rem;
		line-height: 1.8;
		text-align: center;
		opacity: 0.55;
	}
	.galeria :global(.galeria-nota a) {
		display: block;
		margin-bottom: 0.6rem;
		color: var(--amber, #d9a441);
		font-weight: 700;
		text-decoration: underline;
		opacity: 0.95;
	}
	/* Visor a pantalla completa con el <dialog> nativo: sin dependencias,
		con Escape de serie y fondo bloqueado mientras esta abierto. */
	.galeria :global(.galeria-visor) {
		width: 100vw;
		max-width: 100vw;
		height: 100vh;
		max-height: 100vh;
		padding: 0;
		margin: 0;
		border: 0;
		background: rgba(20, 16, 12, 0.94);
		color: #fff;
	}
	.galeria :global(.galeria-visor::backdrop) {
		background: rgba(20, 16, 12, 0.94);
	}
	.galeria :global(.visor-marco) {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		width: 100%;
		height: 100%;
		padding: clamp(3rem, 8vh, 4.5rem) clamp(0.75rem, 4vw, 3rem) 4.5rem;
		box-sizing: border-box;
	}
	.galeria :global(.visor-figura) {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: 0;
	}
	.galeria :global(.visor-figura img) {
		max-width: min(92vw, 1100px);
		max-height: 76vh;
		object-fit: contain;
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.06);
	}
	.galeria :global(.visor-pie) {
		margin: 0.9rem 0 0;
		max-width: min(92vw, 1100px);
		font-size: 0.8125rem;
		line-height: 1.6;
		text-align: center;
		opacity: 0.85;
	}
	.galeria :global(.visor-cerrar) {
		position: absolute;
		top: 1rem;
		right: 1rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 0;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.14);
		color: #fff;
		font-size: 1.1rem;
		cursor: pointer;
	}
	.galeria :global(.visor-cerrar:hover) {
		background: rgba(255, 255, 255, 0.28);
	}
	.galeria :global(.visor-flecha) {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 0;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.14);
		color: #fff;
		font-size: 1.6rem;
		line-height: 1;
		cursor: pointer;
	}
	.galeria :global(.visor-flecha:hover:not(:disabled)) {
		background: rgba(255, 255, 255, 0.28);
	}
	.galeria :global(.visor-flecha:disabled) {
		opacity: 0.25;
		cursor: default;
	}
	@media (max-width: 40rem) {
		.galeria :global(.visor-flecha) {
			position: absolute;
			bottom: 1rem;
		}
		.galeria :global(.visor-anterior) {
			left: 1rem;
		}
		.galeria :global(.visor-siguiente) {
			right: 1rem;
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		.galeria :global(.galeria-grid img) {
			transition: transform 0.5s ease;
		}
		.galeria :global(.galeria-grid figure:hover img) {
			transform: scale(1.03);
		}
	}
</style>
