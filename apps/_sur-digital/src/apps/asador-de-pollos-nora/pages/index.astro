---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import cuscus from '../assets/fotos/asador-de-pollos-nora-apaisada-02.jpg';
import vitrinaDulces from '../assets/fotos/asador-de-pollos-nora-panoramica-01.jpg';
import pastelaPorcion from '../assets/fotos/asador-de-pollos-nora-apaisada-03.jpg';
import polloGarbanzos from '../assets/fotos/asador-de-pollos-nora-cuadrada-04.jpg';
import tartas from '../assets/fotos/asador-de-pollos-nora-apaisada-05.jpg';
import pastelaGrande from '../assets/fotos/asador-de-pollos-nora-apaisada-06.jpg';
import pescado from '../assets/fotos/asador-de-pollos-nora-apaisada-07.jpg';
import pastelaPescado from '../assets/fotos/asador-de-pollos-nora-apaisada-08.jpg';
import bollitos from '../assets/fotos/asador-de-pollos-nora-panoramica-09.jpg';
import fritos from '../assets/fotos/asador-de-pollos-nora-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
} from '../data/site';

const title = 'Asador de pollos Nora · Pollo asado y comida árabe en Málaga';
const description = BUSINESS.description;

const galeria = [
	{
		src: vitrinaDulces,
		alt: 'Vitrina de dulces árabes del asador con tartas, petit fours y pastelitos bajo campanas de cristal',
	},
	{
		src: pastelaPorcion,
		alt: 'Porción de pastela de carne cortada, con el hojaldre crujiente y el relleno a la vista',
	},
	{
		src: polloGarbanzos,
		alt: 'Pollo asado en salsa con cebolla, garbanzos y perejil fresco',
	},
	{
		src: pastelaGrande,
		alt: 'Pastela redonda entera en una bandeja de aluminio, recién hecha',
	},
	{
		src: pescado,
		alt: 'Bandeja de lomos de pescado al horno con hierbas sobre pimiento rojo',
	},
	{
		src: pastelaPescado,
		alt: 'Pastela de pescado decorada con langostinos y rodajas de limón',
	},
	{
		src: bollitos,
		alt: 'Bollitos de almendra con pétalos de rosa en la bandeja del mostrador',
	},
	{
		src: fritos,
		alt: 'Empanadillas fritas y doradas apiladas en una bandeja de acero',
	},
	{
		src: tartas,
		alt: 'Bandeja de tartas y pastelitos empaquetados en la vitrina del local',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#asador-de-pollos-nora`,
	name: BUSINESS.fullName,
	alternateName: ['Asador Nora', 'Nora comida árabe', 'Pollo asado Nora Málaga'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Árabe', 'Halal', 'Andaluza', 'Pollo asado'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Cruz de Humilladero' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Monday', opens: '11:00', closes: '16:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Tuesday', opens: '11:00', closes: '16:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Wednesday', opens: '09:00', closes: '17:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Thursday', opens: '11:00', closes: '16:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '11:00', closes: '16:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '11:00', closes: '16:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '11:00', closes: '16:30' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"asador-de-pollos-nora-apaisada-02.jpg": cuscus,
	"asador-de-pollos-nora-panoramica-01.jpg": vitrinaDulces,
	"asador-de-pollos-nora-apaisada-03.jpg": pastelaPorcion,
	"asador-de-pollos-nora-cuadrada-04.jpg": polloGarbanzos,
	"asador-de-pollos-nora-apaisada-06.jpg": pastelaGrande,
	"asador-de-pollos-nora-apaisada-07.jpg": pescado,
	"asador-de-pollos-nora-apaisada-08.jpg": pastelaPescado,
	"asador-de-pollos-nora-panoramica-09.jpg": bollitos,
	"asador-de-pollos-nora-apaisada-10.jpg": fritos,
	"asador-de-pollos-nora-apaisada-05.jpg": tartas,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17120f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Asador de pollos Nora, comida árabe Málaga, pollo asado Málaga, Av. de Carlos Haya 63, Cruz de Humilladero, cuscús Málaga, pastela Málaga, comida halal Málaga, dulces árabes Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado, cuscús, pastela y dulces árabes en la avenida de Carlos Haya 63, Cruz de Humilladero. Comida halal y andaluza. 4,6 sobre 5 con 96 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bandeja de cuscús con verduras, garbanzos y pasas del Asador de pollos Nora"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#17120f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Cruz de Humilladero, Málaga"
			preload={[cuscus]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/asador-de-pollos-nora/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Asador Nora"
			subtitle="Pollo asado · comida árabe"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces del Asador de pollos Nora"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34652109820?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20M%C3%A1laga." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Málaga"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
