---
import { Image } from 'astro:assets';
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import heroPhoto from '../assets/fotos/bar-la-primera-del-naranjo-cordoba-apaisada-01.jpg';
import {
	business,
	directionsUrl,
	faqSchema,
	faqs,
	mapEmbedUrl,
	mapsUrl,
	openingHours,
	paginasAmarillasUrl,
	phoneHref,
	restaurantSchema,
	specialties,
	tripadvisorUrl,
} from '../lib/business';

const title = 'Bar La Primera del Naranjo | Cocina casera desde 1924 en Córdoba';
const description =
	'Bar La Primera del Naranjo en Córdoba: cien años de cocina casera andaluza en el barrio del Naranjo. Bacalao, pijotas, carnes a la brasa, guisos de siempre, patio entoldado y reservas. C. Académico Sarazá, 4 · 957 76 71 03.';
const keywords =
	'Bar La Primera del Naranjo, La Primera del Naranjo Córdoba, bar centenario Córdoba, comer en el barrio del Naranjo, cocina casera Córdoba, bacalao rebozado Córdoba, entrecot a la piedra, churrasco salsa verde, restaurante barrio Naranjo Córdoba, Calle Académico Sarazá 4 Córdoba, celebraciones y grupos Córdoba';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#24503f" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/bar-la-primera-del-naranjo-cordoba/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Work+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración original de un naranjo para Bar La Primera del Naranjo; no es una fotografía del establecimiento" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Bar La Primera del Naranjo, inicio">
				<span class="brand-mark" aria-hidden="true">1924</span>
				<span class="brand-copy">La Primera <small>del Naranjo · Córdoba</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">La carta</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 957 76 71 03</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Barrio del Naranjo · Córdoba · Desde 1924</p>
					<h1 id="hero-title">Cien años<br /><em>a fuego lento.</em></h1>
					<p class="hero-intro">Bar La Primera del Naranjo es la primera taberna que se abrió en el barrio, en 1924, y sigue en el mismo sitio cuatro generaciones después. Cocina casera andaluza, pescado fresco de lonja, carnes a la brasa y guisos de siempre, con patio entoldado para comer sin prisas.</p>
					<div class="hero-actions">
						<a class="button button-orange" href={phoneHref}>Reservar por teléfono <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Nos encontrarás en</small><address>{business.streetAddress}<br />{business.postalCode} · Córdoba</address></div>
						<div><small>Reservas</small><a href={phoneHref}>{business.phone}</a><br /><a href={mapsUrl} target="_blank" rel="noreferrer">Ficha en Google Maps ↗</a></div>
					</div>
				</div>
				<div class="hero-art">
					<Image
						src={heroPhoto}
						alt="Fotografía de Bar La Primera del Naranjo, publicada en su ficha de Google Maps"
						widths={[480, 768, 1200, 1600]}
						sizes="(max-width: 900px) 100vw, 50vw"
						format="avif"
						quality={70}
						loading="eager"
						fetchpriority="high"
						class="hero-photo"
					/>
					<span class="hero-scrim" aria-hidden="true"></span>
					<div class="badge" aria-hidden="true"><strong>100</strong><span>años · 1924</span></div>
					<div class="casa-tag" aria-hidden="true"><small>Casa de comidas</small><strong>Cocina casera</strong><span>Patio entoldado · grupos y celebraciones</span></div>
					<div class="art-caption"><strong>La Primera</strong>del Naranjo</div>
				</div>
			</section>

			<div class="promise" aria-label="Información de Bar La Primera del Naranjo">
				<span>Desde 1924</span><span>Pescado fresco de lonja</span><span>Carnes a la brasa</span><span>Patio entoldado</span>
			</div>

			<section class="section intro" id="casa" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Cuatro generaciones</p>
					<h2 id="intro-title">Tradición de barrio,<br /><em>mesa de familia.</em></h2>
				</div>
				<div class="intro-copy">
					<p>El negocio nació en 1924 y no se ha movido de la Calle Académico Sarazá, en el barrio del Naranjo, junto a la Sierra y la Asomadilla. Hoy lo lleva la cuarta generación: Loli Bueno, junto a sus padres Pablo Bueno y Loli Fernández y su marido Francisco García, 'Chico'.</p>
					<p>La cocina es casera de principio a fin: el pescado se recepciona a diario y lo que no pasa el control no entra; los guisos se hacen a fuego lento, sin atajos. El local ofrece un salón amplio y tranquilo, sin televisiones, y un patio entoldado con aire acondicionado en verano y estufas de brasero en invierno.</p>
					<p class="source-note">La información de esta página procede de la ficha de Google Maps, de reportajes de prensa local y de directorios gastronómicos. La carta y los horarios pueden cambiar: confirma antes de tu visita.</p>
				</div>
			</section>

			<section class="section carta" id="carta" aria-labelledby="carta-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Cocina casera andaluza</p>
						<h2 id="carta-title">Platos que<br /><em>no fallan.</em></h2>
					</div>
					<p>Una selección orientativa de los platos que la propia casa y la clientela destacan, presentes en reportajes y reseñas. No sustituye la carta vigente.</p>
				</div>
				<div class="carta-grid">
					{specialties.map((dish, index) => (
						<article class="carta-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<div class="carta-extra">
					<p><strong>Por encargo:</strong> cochinillo entero y habichuelas verdinas con carabineros, entre otras elaboraciones que requieren tiempo. Pídelas con antelación.</p>
					<p><strong>Del mar:</strong> el bacalao se trabaja entero en el obrador y se sirve frito, rebozado, con tomate o con salmorejo, además de pijotas, boquerones y coquinas.</p>
					<p class="menu-note">Consulta la carta, los platos del día y los alérgenos con el restaurante. <a href={phoneHref}>Llama al 957 76 71 03</a>.</p>
				</div>
			</section>

			<Galeria
				id="fotos"
				nombre="Bar La Primera del Naranjo"
				titulo="La Primera, en fotos."
				intro="Fotos reales del local, del patio y de los platos, publicadas en la ficha de Google Maps. Para ver la colección completa, con fotos de viajeros y del barrio, abre la ficha en Google Maps o Tripadvisor."
				mapsUrl={mapsUrl}
			/>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14012 · Naranjo, Córdoba</p>
					<h2 id="visit-title">Ven a comer<br /><em>al Naranjo.</em></h2>
					<address>{business.streetAddress}<br />{business.postalCode} {business.locality}<br />{business.province}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Reservas y consultas</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Ubicación</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Más información</small><a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor</a> · <a href={paginasAmarillasUrl} target="_blank" rel="noreferrer">Páginas Amarillas</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar y reservar</a>
					</div>
					<p class="hours-note">Se recomienda reservar, sobre todo los fines de semana y para grupos. Los horarios pueden variar en festivos; llama antes de desplazarte para confirmarlo.</p>
				</div>
				<div class="visit-side">
					<div class="hours-card">
						<h3>Horario orientativo</h3>
						<ul>
							{openingHours.map((slot) => (
								<li><span>{slot.day}</span><strong>{slot.hours}</strong></li>
							))}
						</ul>
					</div>
					<div class="map-card">
						<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Bar La Primera del Naranjo en Calle Académico Sarazá, Córdoba" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-label"><div><strong>La Primera del Naranjo</strong><small>Académico Sarazá, 4 · Córdoba</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="Bar La Primera del Naranjo, volver al inicio">
				<span class="brand-mark" aria-hidden="true">1924</span><span class="brand-copy">La Primera <small>del Naranjo · Córdoba</small></span>
			</a>
			<nav class="footer-nav" aria-label="Fuentes y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor ↗</a>
				<a href={paginasAmarillasUrl} target="_blank" rel="noreferrer">Páginas Amarillas ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Bar La Primera del Naranjo · Córdoba. Consulta horarios, carta y alérgenos directamente con el establecimiento.</small>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/bar-la-primera-del-naranjo-cordoba/aviso-legal">Aviso legal</a>
			<a href="/bar-la-primera-del-naranjo-cordoba/aviso-legal#privacidad">Privacidad</a>
			<a href="/bar-la-primera-del-naranjo-cordoba/aviso-legal#cookies">Cookies</a>
		</nav>
		<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
	</footer>
		<a class="mobile-call" href={phoneHref}>Reservar en La Primera del Naranjo <span>957 76 71 03</span></a>

						</body>
</html>


