---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import esquina from '../assets/fotos/panaderia-yoli-street-01.jpg';
import calle from '../assets/fotos/panaderia-yoli-street-02.jpg';
import travesia from '../assets/fotos/panaderia-yoli-street-03.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, MAPS, SERVICIOS, STREET_VIEW } from '../data/site';

const title = 'Panadería Yoli · Travesía del Ciprés, Cruz de Humilladero (Málaga)';
const description =
	'Panadería Yoli en la Travesía del Ciprés (Cruz de Humilladero, 29010 Málaga). Panadería de barrio; la ficha de Google no publica horario, teléfono ni valoración. Mapa y vistas de la calle.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#yoli`,
	name: BUSINESS.name,
	alternateName: ['Yoli', 'Panadería Yoli Málaga'],
	description:
		'Panadería de barrio en la Travesía del Ciprés, 29010 Málaga. La ficha de Google no publica horario, teléfono ni valoración.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El local', href: '#local' },
	{ label: 'Dónde está', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f4d3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Yoli, panadería Cruz de Humilladero, Travesía del Ciprés, panadería Málaga 29010, panadería de barrio Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería de barrio en la Travesía del Ciprés, 29010 Málaga. La ficha de Google no publica horario, teléfono ni valoración."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La esquina de la Travesía del Ciprés, en Cruz de Humilladero, en Google Street View"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1f4d3a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[esquina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Panadería Yoli, inicio">
					<span class="brand-mark" aria-hidden="true">Y</span>
					<span class="brand-name">
						Panadería Yoli
						<small>Panadería · Málaga</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-cta" href={MAPS.directions} target="_blank" rel="noreferrer">
					Cómo llegar <span aria-hidden="true">↗</span>
				</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Cruz de Humilladero · 29010 Málaga</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-lede">
							Una panadería en la Travesía del Ciprés, en Cruz de Humilladero. La ficha de Google
							la clasifica como panadería y no publica horario, teléfono ni valoración: aquí
							está lo que sí consta.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
								Ver la ficha <span aria-hidden="true">↗</span>
							</a>
						</div>
						<p class="hero-note">
							<span>La ficha no publica horario, teléfono ni fotos.</span> Las imágenes de esta
							página son vistas de Google Street View de la calle, no del interior del local.
						</p>
					</div>

					<aside class="hero-ticket" aria-label="Datos publicados en la ficha de Google">
						<p class="ticket-top">Málaga · Cruz de Humilladero</p>
						<p class="ticket-status">Ficha sin reseñas<br />ni horario publicados</p>
						<div class="ticket-rule" aria-hidden="true"><span>✦</span></div>
						<dl class="ticket-data">
							<div>
								<dt>Nombre</dt>
								<dd>PANADERIA YOLI</dd>
							</div>
							<div>
								<dt>Categoría</dt>
								<dd>Panadería</dd>
							</div>
							<div>
								<dt>Dirección</dt>
								<dd>{BUSINESS.street}<br />{BUSINESS.district} · {BUSINESS.postalCode} {BUSINESS.city}</dd>
							</div>
							<div>
								<dt>Reseñas</dt>
								<dd>Ninguna publicada</dd>
							</div>
						</dl>
						<a class="ticket-link" href={MAPS.place} target="_blank" rel="noreferrer">
							Abrir en Google Maps <span aria-hidden="true">↗</span>
						</a>
						<span class="ticket-stamp" aria-hidden="true">Pan<br />de barrio</span>
					</aside>
				</div>
			</section>

			<section class="chips-wrap wrap" aria-label="Lo que publica la ficha de Google">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<p class="section-label"><span aria-hidden="true"></span> La casa</p>
				<div class="about-grid">
					<h2 id="about-title">Una panadería <em>sin ficha completa.</em></h2>
					<div class="about-copy">
						<p>
							Yoli es una panadería de la Travesía del Ciprés, en Cruz de Humilladero. Google la
							clasifica como panadería y la dirección no incluye número de portal: la ficha solo
							indica la calle y el código postal.
						</p>
						<p>
							La ficha pública está sin reclamar y no publica horario, teléfono, página web,
							redes sociales, descripción, accesibilidad, carta ni precios. Tampoco tiene fotos
							del perfil ni reseñas.
						</p>
						<p>
							Esta página no rellena esos huecos: se limita al nombre, la categoría, la
							dirección, el mapa y las vistas de la calle que la propia ficha asocia al negocio.
							Si necesitas confirmar horario o surtido, lo más fiable es acercarte al local.
						</p>
						<div class="about-links">
							<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha en Google Maps <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="three" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas de la casa</p>
							<h2 id="three-title">Lo que sí <em>se sabe.</em></h2>
						</div>
						<p>
							La ficha es mínima: sin reseñas, sin horario y sin teléfono. Esto es lo único que
							publica Google, sin añadir nada que no conste.
						</p>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="local wrap" id="local" aria-labelledby="local-title">
				<div class="local-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> El local</p>
						<h2 id="local-title">La calle, <em>en tres vistas.</em></h2>
					</div>
					<p>
						La ficha no tiene fotos del perfil. Estas tres vistas de Google Street View, tomadas
						en {STREET_VIEW.date}, enseñan la travesía y la esquina donde la ficha sitúa el local.
						Se muestran como imágenes del entorno, no del interior.
					</p>
				</div>

				<div class="local-grid">
					<figure class="local-main">
						<Image
							src={esquina}
							alt="La esquina de la Travesía del Ciprés con contenedores, coches aparcados y edificios de viviendas, en Google Street View"
							widths={[480, 720, 1024]}
							sizes="(max-width: 900px) 92vw, 58vw"
							format="webp"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>
							<span>La esquina y los contenedores</span>
							<span>Google Street View · {STREET_VIEW.date}</span>
						</figcaption>
					</figure>
					<div class="local-side">
						<figure>
							<Image
								src={calle}
								alt="La calle con coches aparcados y los edificios de ladrillo de la travesía, en Google Street View"
								widths={[420, 640, 1024]}
								sizes="(max-width: 900px) 92vw, 36vw"
								format="webp"
								quality={72}
								loading="lazy"
								decoding="async"
							/>
							<figcaption>La calle</figcaption>
						</figure>
						<figure>
							<Image
								src={travesia}
								alt="La travesía vista desde la esquina, con los edificios a ambos lados y un coche rojo aparcado, en Google Street View"
								widths={[420, 640, 1024]}
								sizes="(max-width: 900px) 92vw, 36vw"
								format="webp"
								quality={72}
								loading="lazy"
								decoding="async"
							/>
							<figcaption>La travesía</figcaption>
						</figure>
					</div>
				</div>

				<div class="local-note">
					<p>
						<strong>Son vistas de la calle, no del negocio.</strong> Google no publica fotos del
						perfil de esta ficha; el panorama de Street View es el que la propia ficha asocia al
						local. No se usa ninguna imagen de otro perfil de Google, y no se afirma qué portal
						es la panadería porque en estas vistas no se distingue el rótulo.
					</p>
					<a class="simple-link" href={MAPS.streetView} target="_blank" rel="noreferrer">
						Abrir Street View <span aria-hidden="true">↗</span>
					</a>
				</div>
			</section>

			<section class="rating" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">Aún no hay <em>reseñas publicadas.</em></h2>
						<p>
							La ficha no tiene valoración ni opiniones en el momento de consultarla (octubre de
							2026). Esta página no reproduce valoraciones que no existen: si quieres ver el
							estado actual o dejar una reseña, se hace en Google Maps.
						</p>
						<div class="rating-actions">
							<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
								Ver la ficha en Google <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="rating-figure" aria-hidden="true">
						<span class="rating-symbol">—</span>
						<span class="rating-caption">sin<br />reseñas</span>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Dónde está</p>
					<h2 id="visit-title">En la Travesía <em>del Ciprés.</em></h2>
					<p class="address">
						{BUSINESS.street}<br />
						{BUSINESS.district}<br />
						{BUSINESS.postalCode} {BUSINESS.city}
					</p>

					<p class="hours-note">
						<strong>La ficha no publica horario.</strong> No se indica aquí ninguna franja porque
						Google no la ofrece; conviene comprobar el letrero del local o preguntar en la tienda.
					</p>

					<div class="visit-links">
						<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
							Ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
					<p class="visit-note">
						Sin teléfono ni página web publicados. La atención es en el propio establecimiento.
					</p>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Panadería Yoli en la Travesía del Ciprés, Málaga"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Tr.ª del Ciprés · 29010
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>pasar.</em></h2>
				<div class="faq-list">
					{
						FAQ.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">Y</span>
						<p>
							Panadería Yoli
							<small>
								Panadería<br />
								{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}
							</small>
						</p>
					</div>
					<nav aria-label="Enlaces de la panadería">
						<a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
						<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a href="/panaderia-yoli/aviso-legal">Aviso legal</a>
					</nav>
				</div>
				<small class="legal">
					© {new Date().getFullYear()} {BUSINESS.name} · Datos de la ficha pública de Google Maps,
					consultada en octubre de 2026. Las imágenes son vistas de Google Street View
					({STREET_VIEW.date}), identificadas como tales. La web no publica horario, teléfono,
					carta ni precios porque la ficha no los incluye.
				</small>
				<nav class="legal-links" aria-label="Información legal">
					<a href="/panaderia-yoli/aviso-legal">Aviso legal</a>
					<a href="/panaderia-yoli/aviso-legal#privacidad">Privacidad</a>
					<a href="/panaderia-yoli/aviso-legal#cookies">Cookies</a>
				</nav>
				<p class="credit">
					<small
						>Creado por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a>
						</small
					>
				</p>
			</div>
		</footer>
	</body>
</html>
