const today = new Date().toISOString().slice(0, 10);
const business = {
	name: 'Restaurante Casa Gonzalez',
	streetAddress: 'C. Tabladilla, 10',
	city: 'Sevilla',
	postalCode: '41013',
	phone: '+34 615 25 18 97',
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#211e1a" />
		<title>Aviso legal y privacidad | Restaurante Casa Gonzalez</title>
		<meta
			name="description"
			content="Aviso legal, política de privacidad y política de cookies de Restaurante Casa Gonzalez, en la calle Tabladilla 10 de Sevilla."
		/>
