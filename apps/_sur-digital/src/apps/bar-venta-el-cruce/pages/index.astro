---
import '../styles/global.css';

const business = {
	name: 'Bar / Venta El Cruce',
	short: 'El Cruce',
	city: 'Vejer de la Frontera',
	area: 'La Barca de Vejer',
	latitude: 36.2614546,
	longitude: -5.9647106,
	site: 'https://www.sur-digital.com/bar-venta-el-cruce',
};

const mapsUrl =
	'https://www.google.com/maps/place/Bar+%2FVenta+El+Cruce/@36.2614546,-5.9647106,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c45b16b3c6e6b:0x513cc912d6263dcd!8m2!3d36.2614546!4d-5.9647106!16s%2Fg%2F11rd_4nv17?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;

const specialties = [
	{
		kicker: 'De paso',
		title: 'Bar venta',
		text: 'Bar venta de carretera para parar en ruta por La Janda.',
	},
	{
		kicker: 'De siempre',
		title: 'Café y tapas',
		text: 'Lo propio de una venta: café, tapas y menú del día a confirmar.',
	},
	{
		kicker: 'En ruta',
		title: 'Junto al cruce',
		text: 'Parada práctica entre Vejer y La Barca de Vejer.',
	},
	{
		kicker: 'Aviso',
		title: 'Sin teléfono publicado',
		text: 'Sin teléfono en fuente sólida: usa la ficha de Maps.',
	},
	{
		kicker: 'Aviso',
		title: 'Sin horario publicado',
		text: 'Sin horario en fuente sólida: consulta su ficha antes de venir.',
	},
	{
		kicker: 'Aviso',
		title: 'Carta del día',
		text: 'Confirma la carta del día en el propio local.',
	},
];

const gallery = [
	{ src: '/bar-venta-el-cruce/fotos/cruce.svg', alt: 'Ilustración del cruce — sustituye por foto propia' },
	{ src: '/bar-venta-el-cruce/fotos/venta.svg', alt: 'Ilustración de la venta — sustituye por foto propia' },
	{ src: '/bar-venta-el-cruce/fotos/barra.svg', alt: 'Ilustración de la barra — sustituye por foto propia' },
	{ src: '/bar-venta-el-cruce/fotos/mesa.svg', alt: 'Ilustración de la mesa — sustituye por foto propia' },
	{ src: '/bar-venta-el-cruce/fotos/cafe.svg', alt: 'Ilustración del café — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está El Cruce?',
		a: 'Junto a La Barca de Vejer (Vejer de la Frontera, Cádiz), coordenadas 36.2614546, -5.9647106.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'El horario no está publicado en una fuente sólida. Consulta su ficha de Google Maps antes de venir.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Bar venta de tapas y menú del día. Confirma la carta en el propio local.',
	},
	{
		q: '¿Tienen teléfono?',
		a: 'No hay teléfono publicado en fuente sólida. Usa el botón «Ver en Google Maps» para su ficha.',
	},
	{
		q: '¿Cómo llego?',
		a: 'Junto al cruce de La Barca de Vejer. Usa el botón «Cómo llegar» para abrir la ruta en Google Maps.',
	},
];

const description =
	'Bar / Venta El Cruce junto a La Barca de Vejer: bar venta de carretera. Consulta su ficha de Google Maps.';

const businessSchema = {
	'@context': 'https://schema.org',
	'@type': 'BarOrPub',
	'@id': `${business.site}/#bar`,
	name: business.name,
	description,
	url: `${business.site}/`,
	image: [`${business.site}/fotos/cruce.svg`],
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Andaluza'],
	address: {
		'@type': 'PostalAddress',
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="El Cruce: bar venta junto a La Barca de Vejer. Consulta su ficha de Google Maps." />
		<meta name="keywords" content="El Cruce Vejer, bar Barca de Vejer, venta La Janda" />
		<meta name="author" content="El Cruce" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/bar-venta-el-cruce/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>El Cruce | Bar venta en La Barca de Vejer</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="El Cruce · Bar venta en Vejer" />
		<meta property="og:description" content="Bar venta de carretera junto a La Barca de Vejer." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/cruce.svg`} />
		<meta property="og:image:alt" content="El Cruce, Vejer" />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:country-name" content="España" />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="El Cruce · Bar en Vejer" />
		<meta name="twitter:description" content="Parada de carretera en La Barca." />
		<meta name="twitter:image" content={`${business.site}/fotos/cruce.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(businessSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Vejer de la Frontera" />
		<meta name="geo.position" content="36.2614546;-5.9647106" />
		<meta name="ICBM" content="36.2614546, -5.9647106" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="El Cruce, inicio">
				<span class="brand-mark" aria-hidden="true">EC</span>
				<span class="brand-name">El Cruce <small>Vejer · La Barca</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La venta</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={mapsUrl} target="_blank" rel="noreferrer">Ver en Maps ↗</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> La Barca de Vejer</p>
					<h1 id="hero-title">Parada<br />del <em>cruce.</em></h1>
					<p class="hero-lede">
						Bar venta de carretera junto a La Barca de Vejer:
						café, tapas y menú para seguir ruta.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>Venta</b> carretera</li>
						<li><b>La Barca</b> Vejer</li>
						<li>Café</li>
						<li>Tapas</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/bar-venta-el-cruce/fotos/cruce.svg" alt="Ilustración de El Cruce, Vejer" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>La Barca · Vejer</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>Venta</b><span>Carretera</span></div>
					<div><b>La Barca</b><span>Vejer</span></div>
					<div><b>Maps</b><span>Ficha Maps</span></div>
				</div>
				<ul class="services">
					<li>Café</li>
					<li>Tapas</li>
					<li>Menú</li>
					<li>Paso</li>
					<li>Maps</li>
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> La venta</p>
				<div class="about-grid">
					<h2>Junto al cruce,<br />de <em>paso.</em></h2>
					<div class="about-copy">
						<p>
							El Cruce está junto a La Barca de Vejer (Vejer de la Frontera),
							con coordenadas 36.2614546, -5.9647106.
						</p>
						<p>
							Bar venta para parar en ruta por La Janda.
						</p>
						<p class="about-note">
							Dirección exacta, teléfono y horario sin fuente sólida publicada.
							Consulta su ficha de Google Maps antes de venir.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales de bar venta. Confirma la carta del día
						en el propio local.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El cruce<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias de la venta.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> La Barca de Vejer</p>
					<h2>Para en El Cruce<br /><em>de paso.</em></h2>
					<p class="address">
						{business.area} ({business.city}), España<br />
						36.2614546, -5.9647106
					</p>

					<table class="hours">
						<caption>Contacto</caption>
						<tbody>
							<tr>
								<th scope="row">Dirección y horario</th>
								<td>En su ficha de Google Maps</td>
							</tr>
							<tr>
								<th scope="row">Teléfono</th>
								<td>Sin fuente sólida publicada</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Sin teléfono ni horario inventados. Consulta la ficha antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Maps ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de El Cruce en La Barca de Vejer" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> El Cruce · Vejer</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">EC</span>
				<p>El Cruce<small>La Barca · Vejer</small></p>
			</div>
			<nav aria-label="Enlaces de la venta">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
			</nav>
			<small>© {new Date().getFullYear()} El Cruce · Vejer. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/bar-venta-el-cruce/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/bar-venta-el-cruce/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/bar-venta-el-cruce/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/bar-venta-el-cruce/aviso-legal">Aviso legal</a>
			<a href="/bar-venta-el-cruce/aviso-legal#privacidad">Privacidad</a>
			<a href="/bar-venta-el-cruce/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
