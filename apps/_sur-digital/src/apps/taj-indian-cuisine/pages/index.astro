---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import caris from '../assets/fotos/taj-indian-cuisine-apaisada-03.jpg';
import sala from '../assets/fotos/taj-indian-cuisine-apaisada-05.jpg';
import fachada from '../assets/fotos/taj-indian-cuisine-vertical-01.jpg';
import arrozNaan from '../assets/fotos/taj-indian-cuisine-vertical-02.jpg';
import cartaBorrego from '../assets/fotos/taj-indian-cuisine-vertical-04.jpg';
import lassi from '../assets/fotos/taj-indian-cuisine-vertical-06.jpg';
import chanaMasala from '../assets/fotos/taj-indian-cuisine-vertical-07.jpg';
import sobremesaManga from '../assets/fotos/taj-indian-cuisine-vertical-08.jpg';
import mesaTikka from '../assets/fotos/taj-indian-cuisine-vertical-09.jpg';
import pizza from '../assets/fotos/taj-indian-cuisine-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICOS,
} from '../data/site';

const title = 'Taj Indian Cuisine · Cozinha indiana em Setúbal';
const description = BUSINESS.description;

const galeria = [
	{
		src: sala,
		alt: 'Sala do Taj com garrafeira de madeira na parede, mesas de toalha preta, guardanapos amarelos e a vitrine ao fundo',
	},
	{
		src: fachada,
		alt: 'Fachada do Taj Indian Cuisine com o letreiro «Comida Indiano, Kebab e Pizza», os telefones e fotografias de pratos',
	},
	{
		src: arrozNaan,
		alt: 'Prato de arroz basmati com coentros e um pão naan cortado em triângulos sobre papel',
	},
	{
		src: cartaBorrego,
		alt: 'Página da carta do Taj dedicada ao prato de borrego, com onze caris e os preços de 10,50 a 10,90 euros',
	},
	{
		src: lassi,
		alt: 'Três copos altos de lassi de manga com canecas de cartão e fios de molho na borda',
	},
	{
		src: chanaMasala,
		alt: 'Chana masala de grão-de-bico num karahi de metal, com coentros e gengibre em juliana, e arroz basmati ao lado',
	},
	{
		src: sobremesaManga,
		alt: 'Taça de vidro com manga, waffle partido e molho de frutos vermelhos, com colher e garfo ao lado',
	},
	{
		src: caris,
		alt: 'Frango tikka masala em duas panelas de metal, arroz basmati, naan com coentros e molhos numa mesa escura',
	},
	{
		src: pizza,
		alt: 'Pizza com fiambre, milho, pimento verde e cogumelos, cortada em fatias',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#taj`,
	name: BUSINESS.name,
	alternateName: ['Taj Setúbal', 'Taj Indian Cuisine Setúbal', 'Taj Indiano Setúbal'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Indiana', 'Asiática', 'Kebab', 'Hambúrgueres', 'Pizza', 'Portuguesa', 'Vegana'],
	areaServed: [
		{ '@type': 'City', name: 'Setúbal' },
		{ '@type': 'AdministrativeArea', name: 'Península de Setúbal' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '10:00',
			closes: '23:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"taj-indian-cuisine-vertical-09.jpg": mesaTikka,
	"taj-indian-cuisine-apaisada-05.jpg": sala,
	"taj-indian-cuisine-vertical-01.jpg": fachada,
	"taj-indian-cuisine-vertical-02.jpg": arrozNaan,
	"taj-indian-cuisine-vertical-04.jpg": cartaBorrego,
	"taj-indian-cuisine-vertical-06.jpg": lassi,
	"taj-indian-cuisine-vertical-07.jpg": chanaMasala,
	"taj-indian-cuisine-vertical-08.jpg": sobremesaManga,
	"taj-indian-cuisine-apaisada-03.jpg": caris,
	"taj-indian-cuisine-vertical-10.jpg": pizza,
};
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2a1a20" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Marcellus&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Taj Indian Cuisine, Taj Setúbal, restaurante indiano Setúbal, comida indiana Setúbal, caril Setúbal, naan Setúbal, kebab Setúbal, pizza Setúbal, comer em Setúbal"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Restaurante indiano na Av. Dom João II, loja c, em Setúbal. Comida indiana, kebab e pizza, todos os dias das 10:00 às 23:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Mesa com caris indianos, naan e arroz no Taj Indian Cuisine"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2a1a20"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-15"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Setúbal, Portugal"
			locale="pt_PT"
			countryName="Portugal"
			preload={[mesaTikka]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/taj-indian-cuisine/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Taj"
			subtitle="Cozinha indiana · Setúbal"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Informação elaborada a partir de fontes públicas; confirma horário e oferta antes da visita."
			ctaLabel="Ligar"
			navAriaLabel="Ligações do Taj Indian Cuisine"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/351920499430?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Set%C3%BAbal." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Setúbal"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
