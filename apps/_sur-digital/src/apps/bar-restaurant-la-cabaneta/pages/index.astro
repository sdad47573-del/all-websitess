---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import terraza from '../assets/fotos/bar-restaurant-la-cabaneta-terraza.jpg';
import coca from '../assets/fotos/bar-restaurant-la-cabaneta-coca.jpg';
import parrilladaPlato from '../assets/fotos/bar-restaurant-la-cabaneta-parrillada-plato.jpg';
import pollo from '../assets/fotos/bar-restaurant-la-cabaneta-pollo.jpg';
import hamburguesa from '../assets/fotos/bar-restaurant-la-cabaneta-hamburguesa.jpg';
import parrilladaSarten from '../assets/fotos/bar-restaurant-la-cabaneta-parrillada-sarten.jpg';
import calcots from '../assets/fotos/bar-restaurant-la-cabaneta-calcots.jpg';
import bocadillo from '../assets/fotos/bar-restaurant-la-cabaneta-bocadillo.jpg';
import calamares from '../assets/fotos/bar-restaurant-la-cabaneta-calamares.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Bar Restaurant La Cabaneta · Parrilla y menú diario en Canillo';
const description =
	'Bar Restaurant La Cabaneta, Carretera General 2, 75 (AD100 Canillo). Parrilla con pollo, costillas y calçots, y menú diario, bocadillos y tapas. Terraza de madera. 4,3 sobre 5 con 660 reseñas. Todos los días, 12:00–24:00.';

const galeria = [
	{
		src: coca,
		alt: 'Coca de fruta confitada y piñones sobre una bandeja dorada, con el cartel de madera de La Cabaneta detrás',
	},
	{
		src: parrilladaPlato,
		alt: 'Plato de parrillada con costillas, pollo, butifarra, ensalada rusa, patata al horno y verduras',
	},
	{
		src: pollo,
		alt: 'Medio pollo a la brasa con patatas fritas y pimientos de Padrón en un plato azul',
	},
	{
		src: hamburguesa,
		alt: 'Hamburguesa con patatas gajo sobre una tabla de madera, servida en papel de periódico',
	},
	{
		src: parrilladaSarten,
		alt: 'Costillas y pollo a la brasa en una sartén de hierro con patatas y cebolla asada',
	},
	{
		src: calcots,
		alt: 'Calçots asándose sobre la parrilla con llama viva',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo de bacon y queso partido por la mitad en un plato, con un refresco al lado',
	},
	{
		src: calamares,
		alt: 'Calamares a la romana recién fritos con dos gajos de limón',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que se cocina en La Cabaneta',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-cabaneta`,
	name: BUSINESS.name,
	alternateName: ['La Cabaneta', 'Bar La Cabaneta', 'La Cabaneta Canillo'],
	description:
		'Bar y restaurante de parrilla en Canillo: pollo y costillas a la brasa, calçots de temporada, menú diario, bocadillos y tapas, con terraza de madera al pie de la CG-2.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376727999',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Parrilla', 'Cocina de montaña', 'Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Canillo' },
		{ '@type': 'AdministrativeArea', name: 'Andorra' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '23:59',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La parrilla', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"bar-restaurant-la-cabaneta-terraza.jpg": terraza,
	"bar-restaurant-la-cabaneta-coca.jpg": coca,
	"bar-restaurant-la-cabaneta-parrillada-plato.jpg": parrilladaPlato,
	"bar-restaurant-la-cabaneta-pollo.jpg": pollo,
	"bar-restaurant-la-cabaneta-hamburguesa.jpg": hamburguesa,
	"bar-restaurant-la-cabaneta-parrillada-sarten.jpg": parrilladaSarten,
	"bar-restaurant-la-cabaneta-calcots.jpg": calcots,
	"bar-restaurant-la-cabaneta-bocadillo.jpg": bocadillo,
	"bar-restaurant-la-cabaneta-calamares.jpg": calamares,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#24382f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Barlow:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Bar Restaurant La Cabaneta, La Cabaneta Canillo, parrilla Canillo, pollo a la brasa Andorra, menú diario Canillo, bocadillos Canillo, terraza Canillo, Carretera General 2 Canillo"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Parrilla de brasa en Canillo: pollo, costillas, calçots de temporada, menú diario, bocadillos y tapas. Terraza de madera y 4,3 en Google con 660 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Costillas y pollo a la brasa con patatas de Bar Restaurant La Cabaneta"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#24382f"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-03"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[terraza]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Cabaneta"
			subtitle="Bar restaurant · Canillo"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma menú, precios y horario antes de ir."
			ctaLabel="Llamar a La Cabaneta"
			navAriaLabel="Enlaces de Bar Restaurant La Cabaneta"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34376727999?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Lo%20que%20se%20cocina%20en%20La%20Cabaneta." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Lo que se cocina en La Cabaneta"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
