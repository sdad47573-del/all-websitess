---
import 'remixicon/fonts/remixicon.css';
import '../styles/index.css';

import { BUSINESS, GALLERY, SCHEMA, IMAGES } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	path?: string;
	keywords?: string;
	schema?: unknown[];
	noIndex?: boolean;
}

const {
	title = 'Mesón Emigrante · Cocina casera extremeña en Zarza de Granadilla',
	description = 'Mesón de cocina casera en Zarza de Granadilla (Cáceres), Valle del Ambroz: menús diarios, raciones generosas, carnes a la parrilla, arroz caldoso y postres caseros. Horario y contacto.',
	path = '/meson-emigrante/',
	keywords = 'Mesón Emigrante, restaurante Zarza de Granadilla, comer en Zarza de Granadilla, cocina extremeña Cáceres, menú del día Valle del Ambroz, carnes a la parrilla Ambroz, restaurante cerca de Granadilla, restaurante Cáparra, Mesón El Emigrante',
	schema = [],
	noIndex = false,
} = Astro.props;

const canonical = new URL(path, BUSINESS.siteUrl).toString();
const ogImage = new URL(IMAGES.fotoApaisada3.src, BUSINESS.siteUrl).toString();
const robots = noIndex
	? 'noindex, follow'
	: 'index, follow, max-image-preview:large, max-snippet:-1';

const imagenesSchema = GALLERY.map((foto) => new URL(foto.src.src, BUSINESS.siteUrl).toString());

const webPage = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	'@id': `${canonical}#webpage`,
	url: canonical,
	name: title,
	description,
	isPartOf: {
		'@type': 'WebSite',
		'@id': `${BUSINESS.siteUrl}/#website`,
		name: BUSINESS.name,
		url: `${BUSINESS.siteUrl}/`,
	},
	about: { '@id': SCHEMA['@id'] },
	inLanguage: 'es',
	primaryImageOfPage: imagenesSchema[0],
};

const datosEstructurados = [{ ...SCHEMA, image: imagenesSchema }, webPage, ...schema];
---

<!doctype html>
<html
	lang="es"
	data-theme="meson-emigrante"
	prefix="og: https://ogp.me/ns# place: https://ogp.me/ns/place#"
>
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/meson-emigrante/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={BUSINESS.name} />
		<meta name="robots" content={robots} />
		<meta name="theme-color" content="#4a2f24" />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={BUSINESS.name} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={`${BUSINESS.name} en ${BUSINESS.city}`} />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:street-address" content={BUSINESS.street} />
		<meta property="og:locality" content={BUSINESS.city} />
		<meta property="og:region" content={BUSINESS.region} />
		<meta property="og:postal-code" content={BUSINESS.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="place:location:latitude" content={String(BUSINESS.geo.lat)} />
		<meta property="place:location:longitude" content={String(BUSINESS.geo.lng)} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={`${BUSINESS.name} en ${BUSINESS.city}`} />

		<meta name="geo.region" content="ES-CC" />
		<meta name="geo.placename" content={BUSINESS.city} />
		<meta name="geo.position" content={`${BUSINESS.geo.lat};${BUSINESS.geo.lng}`} />
		<meta name="ICBM" content={`${BUSINESS.geo.lat}, ${BUSINESS.geo.lng}`} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..600&family=Work+Sans:ital,wght@0,300..600;1,300..500&display=swap"
			rel="stylesheet"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link
				href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..600&family=Work+Sans:ital,wght@0,300..600;1,300..500&display=swap"
				rel="stylesheet"
			/>
		</noscript>

		{datosEstructurados.map((bloque) => (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(bloque)} />
		))}
	</head>
	<body class="bg-base-100 text-base-content font-sans antialiased">
		<slot />
	</body>
</html>
