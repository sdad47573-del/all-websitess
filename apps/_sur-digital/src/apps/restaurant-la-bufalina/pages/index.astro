---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import terraza from '../assets/fotos/restaurant-la-bufalina-vertical-01.jpg';
import carta from '../assets/fotos/restaurant-la-bufalina-vertical-02.jpg';
import fachada from '../assets/fotos/restaurant-la-bufalina-vertical-03.jpg';
import burrata from '../assets/fotos/restaurant-la-bufalina-apaisada-04.jpg';
import piadina from '../assets/fotos/restaurant-la-bufalina-apaisada-05.jpg';
import burrataTabla from '../assets/fotos/restaurant-la-bufalina-vertical-06.jpg';
import prosciutto from '../assets/fotos/restaurant-la-bufalina-vista-7-07.jpg';
import jamon from '../assets/fotos/restaurant-la-bufalina-vertical-08.jpg';
import margherita from '../assets/fotos/restaurant-la-bufalina-vista-9-09.jpg';
import terrazaCalle from '../assets/fotos/restaurant-la-bufalina-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Restaurant la Bufalina, pizzería italiana en Passeig de Vara de Rey, 13 (Eivissa). Pizza al horno, ensaladas, bowls y piadinas, con terraza y servicio a domicilio. Tel. 971 30 28 94.';

const galeria = [
	{
		src: terraza,
		alt: 'Terraza de la Bufalina con sombrillas blancas, farolillos de bambú y sillas de mimbre en Passeig de Vara de Rey',
	},
	{
		src: terrazaCalle,
		alt: 'Fachada amarilla de la Bufalina con el toldo verde y mesas en la acera de Vara de Rey',
	},
	{
		src: fachada,
		alt: 'Entrada de la Bufalina con el rótulo «Pizza & Fresh Food», la carta en el escaparate y un cajero automático al lado',
	},
	{
		src: carta,
		alt: 'Carta de la Bufalina en el escaparate, con las Maxi Ensaladas, las Maxi Bowls y las pizzas',
	},
	{
		src: margherita,
		alt: 'Pizza margherita con tomate, mozzarella y hojas de albahaca sobre una tabla de madera',
	},
	{
		src: burrata,
		alt: 'Pizza con burrata, prosciutto, rúcula y aceite de oliva en una tabla de madera',
	},
	{
		src: burrataTabla,
		alt: 'Pizza con burrata, prosciutto, tomate cherry y rúcula servida en tabla',
	},
	{
		src: prosciutto,
		alt: 'Pizza con prosciutto, burrata, tomate seco y albahaca vista de cerca',
	},
	{
		src: jamon,
		alt: 'Pizza con jamón, champiñones, alcachofas y mozzarella en su caja de cartón',
	},
	{
		src: piadina,
		alt: 'Piadina de fiambre y ensalada cortada por la mitad, con una cerveza en la mesa',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-bufalina`,
	name: BUSINESS.name,
	alternateName: ['La Bufalina', 'Bufalina Ibiza', 'Pizzería La Bufalina', 'La Bufalina Eivissa'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 971 30 28 94',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Italiana', 'Pizza', 'Mediterránea'],
	areaServed: [
		{ '@type': 'City', name: 'Eivissa' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '11:00',
			closes: '01:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Bucle magnético asistencial',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'La Bufalina · Pizzería italiana en Vara de Rey, Ibiza';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurant-la-bufalina-vertical-01.jpg": terraza,
	"restaurant-la-bufalina-vertical-10.jpg": terrazaCalle,
	"restaurant-la-bufalina-vertical-03.jpg": fachada,
	"restaurant-la-bufalina-vertical-02.jpg": carta,
	"restaurant-la-bufalina-vista-9-09.jpg": margherita,
	"restaurant-la-bufalina-apaisada-04.jpg": burrata,
	"restaurant-la-bufalina-vertical-06.jpg": burrataTabla,
	"restaurant-la-bufalina-vista-7-07.jpg": prosciutto,
	"restaurant-la-bufalina-vertical-08.jpg": jamon,
	"restaurant-la-bufalina-apaisada-05.jpg": piadina,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#b23a2f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Bufalina, pizzeria Ibiza, pizza Ibiza centro, Vara de Rey, comer pizza Eivissa, pizzería italiana Ibiza, pizza a domicilio Ibiza, ensaladas y bowls Ibiza"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="La Bufalina · Pizzería italiana en Vara de Rey, Ibiza"
			ogDescription="Pizza italiana, ensaladas, bowls y piadinas en Passeig de Vara de Rey, 13 (Eivissa), con terraza. Para llevar y a domicilio. Tel. 971 30 28 94."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Pizza con burrata, prosciutto y rúcula de la Bufalina"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#b23a2f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			phone="+34971302894"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[terraza]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/restaurant-la-bufalina/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Bufalina"
			subtitle="Pizzería italiana · Eivissa"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
				reviews={REVIEWS}
				googleMaps={MAPS.place}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes del pedido."
			ctaLabel="Pedir en la Bufalina"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34971302894?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Eivissa." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Eivissa"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
