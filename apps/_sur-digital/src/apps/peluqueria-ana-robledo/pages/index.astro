---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	mapEmbedUrl,
	mapsUrl,
	photoUrl,
	phoneHrefs,
	structuredData,
} from '../lib/business';

const title = 'Peluquería Ana Robledo | Estilismo en Bailén-Miraflores, Málaga';
const description =
	'Peluquería Ana Robledo. Estilismo, peluquería en Avenida de Carlos Haya, 192 (Bailén-Miraflores), Málaga. Corte, color, mechas y extensiones. Llama al 675 20 38 84.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#2b211c" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/peluqueria-ana-robledo/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=DM+Mono:wght@400;500&family=Jost:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={photoUrl} />
		<meta property="og:image:alt" content="Fotografía de Peluquería Ana Robledo compartida en Google Maps" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={photoUrl} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Peluquería Ana Robledo, inicio"><span class="brand-mark" aria-hidden="true">AR</span><span class="brand-label">ANA ROBLEDO <small>PELUQUERÍA · ESTILISMO</small></span></a>
			<nav aria-label="Navegación principal"><a href="#estudio">El estudio</a><a href="#contacto">Contacto</a></nav>
			<a class="header-phone" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> {business.phones[0]}</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<figure class="hero-photo">
					<div class="photo-label"><span>AR / 01</span><span>FOTO DE LA FICHA DE GOOGLE MAPS</span></div>
					<a href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Ver la foto de Peluquería Ana Robledo y su galería en Google Maps"><img src={photoUrl} alt="Fotografía de Peluquería Ana Robledo publicada en Google Maps" width="900" height="1200" fetchpriority="high" decoding="async" /><span class="photo-open" aria-hidden="true">↗</span></a>
					<figcaption><span>ESTILISMO · MÁLAGA</span><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha ↗</a></figcaption>
					<span class="photo-stamp" aria-hidden="true">ANA<br /><i>✦</i><br />ROBLEDO</span>
				</figure>
				<div class="hero-content">
					<p class="eyebrow"><span></span> ESTILISMO · COLOR · CORTE</p>
					<h1 id="hero-title">El arte de<br /><em>cuidar tu pelo.</em></h1>
					<p class="hero-intro">Peluquería Ana Robledo, en Avenida de Carlos Haya (Bailén-Miraflores). Estilismo personalizado, color, mechas y extensiones, con dedicación a cada detalle y trato de tú a tú.</p>
					<div class="hero-actions"><a class="button button-plum" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Llamar y pedir cita</a><a class="button button-outline" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-location"><span class="location-rule" aria-hidden="true"></span><p>{business.district}<br /><strong>{business.city} · Andalucía</strong></p></div>
				</div>
			</section>

			<section class="salon-strip" id="estudio" aria-label="Servicios de Peluquería Ana Robledo">
				<p class="strip-title"><span>01 /</span> LO QUE HACEMOS</p>
				<div><span>01</span><strong>Corte y estilismo</strong></div>
				<div><span>02</span><strong>Color y mechas</strong></div>
				<div><span>03</span><strong>Extensiones</strong></div>
			</section>

			<section class="about-section" aria-labelledby="about-title">
				<p class="section-label"><span>02 /</span> ANA ROBLEDO · ESTILISMO</p>
				<div class="about-content"><h2 id="about-title">Un salón<br /><em>a tu medida.</em></h2><div><p>En Peluquería Ana Robledo cada cliente es distinto. Escuchamos lo que buscas y te aconsejamos el corte, el color o el tratamiento que mejor le sienta a tu pelo. Un espacio tranquilo en Bailén-Miraflores para renovarte y salir sintiéndote bien.</p><a class="social-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver la ficha y opiniones en Google Maps <span aria-hidden="true">↗</span></a></div></div>
				<div class="about-footer"><span>CORTE · COLOR · ESTILISMO</span><span>29010 MÁLAGA</span><span>✦</span></div>
			</section>

			<section class="contact-section" id="contacto" aria-labelledby="contact-title">
				<p class="section-label"><span>03 /</span> VISÍTANOS</p>
				<div class="contact-layout">
					<div class="contact-copy"><p class="contact-kicker">ESTAMOS EN CARLOS HAYA</p><h2 id="contact-title">Pide tu<br /><em>cita.</em></h2>
						<div class="contact-card">
							<div class="contact-row"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div></div>
							<div class="contact-row"><span aria-hidden="true">☎</span><div><small>LLÁMANOS</small><a href={phoneHrefs[0]}>{business.phones[0]}</a></div></div>
						</div>
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-card"><div class="map-header"><span><i></i> AV. DE CARLOS HAYA · MÁLAGA</span><a href={mapsUrl} target="_blank" rel="noreferrer">ABRIR MAPS ↗</a></div><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Peluquería Ana Robledo en Avenida de Carlos Haya, Málaga" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div><div class="map-footer"><span aria-hidden="true">⌖</span><div><strong>{business.name}</strong><small>{business.streetAddress} · {business.city}</small></div><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar a Peluquería Ana Robledo">↗</a></div></div>
				</div>
				<div class="social-row"><span>ENCUÉNTRANOS TAMBIÉN EN</span><a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><a href={phoneHrefs[0]}>{business.phones[0]} ↗</a></div>
			</section>
			<Galeria nombre="Peluquería Ana Robledo. Estilismo" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer"><a class="brand footer-brand" href="#inicio" aria-label="Peluquería Ana Robledo, volver al inicio"><span class="brand-mark">AR</span><span class="brand-label">ANA ROBLEDO <small>PELUQUERÍA · ESTILISMO</small></span></a><p>{business.streetAddress}, {business.city}<br /><a href={phoneHrefs[0]}>{business.phones[0]}</a></p><a class="footer-social" href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><small>© {new Date().getFullYear()} Peluquería Ana Robledo · Málaga &nbsp;·&nbsp; Foto de la ficha de Google Maps.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small>
			</p>
<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
	<a href="/peluqueria-ana-robledo/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
	<a href="/peluqueria-ana-robledo/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
	<a href="/peluqueria-ana-robledo/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
</nav>
</footer>
		<a class="phone-cta" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Llamar a Ana Robledo <strong>{business.phones[0]}</strong></a>
						<WhatsappFab phone={datos.phoneHrefs[0]} name={datos.business?.name} />
						</body>
</html>


