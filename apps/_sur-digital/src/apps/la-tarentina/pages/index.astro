---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	directionsUrl,
	faqSchema,
	faqs,
	floristSchema,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'La Tarentina Floristería · Flores en Sevilla';
const description =
	'Floristería en la Calle Mallorca, 1 (Sevilla), frente al Hospital Viamed. 5 sobre 5 con 235 reseñas en Google Maps. Teléfono 627 02 54 14.';
const keywords =
	'La Tarentina, floristería Sevilla, flores Sevilla, ramos de novia, Calle Mallorca';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas diez fotografías, así que no se inventa una
 * descripción y todos los `alt` avisan solo de dónde salen.
 */
const altFoto = 'Fotografía publicada en la ficha de Google Maps de La Tarentina Floristería, en Sevilla';
const altOg = 'Fotografía de La Tarentina Floristería publicada en su ficha de Google Maps';

/**
 * Galería completa: las diez fotografías de la ficha.
 *
 * El manifiesto de la descarga quedó sin autor (`author` vacío), así que se publican sin pie y sin
 * atribución: no hay nada que citar.
 */
const galeria = [
	'la-tarentina-vertical-01.jpg',
	'la-tarentina-vertical-02.jpg',
	'la-tarentina-vertical-03.jpg',
	'la-tarentina-vertical-04.jpg',
	'la-tarentina-vertical-05.jpg',
	'la-tarentina-vertical-06.jpg',
	'la-tarentina-vertical-07.jpg',
	'la-tarentina-vertical-08.jpg',
	'la-tarentina-vertical-09.jpg',
	'la-tarentina-vertical-10.jpg',
];

/**
 * Tres fotos de avance en el collage de la portada (también están en la galería).
 *
 * Arriba va la vertical (01), con el recorte ancho del hueco superior a cargo del
 * componente, y abajo dos verticales (02 y 03), con las proporciones por
 * defecto del repositorio (16/9 y 4/5). Todas las fotos de la ficha son verticales.
 */
const collage = [
	{ name: 'la-tarentina-vertical-01.jpg', clase: 'collage-item collage-item-a' },
	{ name: 'la-tarentina-vertical-03.jpg', clase: 'collage-item collage-item-b' },
	{ name: 'la-tarentina-vertical-02.jpg', clase: 'collage-item collage-item-c' },
];

/**
 * Número de reseñas destacadas que publica la ficha.
 *
 * La vista previa no incluía los textos de las reseñas, así que `reviews` viene vacío y la
 * portada muestra solo la tarjeta con la valoración y el enlace al listado completo.
 */
const numeroResenas = reviews.length;
const textoResenas = `${business.reviewCount.toLocaleString('es-ES')} reseñas`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#5c2e3e" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-SE" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/la-tarentina/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(floristSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">LT</span>
				<span class="brand-text">
					La Tarentina Floristería
					<small>Calle Mallorca, 1 · Sevilla</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#local">La tienda</a>
				<a href="#fotos">Las fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Sevilla · Calle Mallorca · 41014</p>
						<h1 id="hero-title">
							La Tarentina Floristería,
							<br />
							<em>en Sevilla.</em>
						</h1>
						<p class="hero-lede">
							La Tarentina Floristería está en la Calle Mallorca, 1, con código postal
							41003, en Sevilla.
							Google la clasifica como floristería (y también como tienda de globos, entrega de flores, tienda de regalos y organizador de eventos y bodas) y le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{textoResenas}. De lunes a viernes abre mañana y tarde (17:00–20:00); el sábado abre de 10:00 a 13:00 y el domingo cierra.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>Llamar al {business.phone}</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode}
									{business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{textoResenas}
								</strong>
							</li>
						</ul>
					</div>

					<div class="hero-collage">
						{collage.map((item, index) => (
							<figure class={item.clase}>
								<Image
									src={foto(item.name)}
									alt={altFoto}
									widths={index === 0 ? [640, 900, 1200] : [320, 480, 640]}
									sizes={
										index === 0
											? '(max-width: 1080px) 92vw, 46vw'
											: '(max-width: 1080px) 45vw, 23vw'
									}
									format="webp"
									quality={68}
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : undefined}
									decoding="async"
								/>
							</figure>
						))}
					</div>
				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
					{textoResenas}
				</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>{hoursSummary}</span>
				<span>Teléfono {business.phone}</span>
			</div>

			<section class="section" id="local" aria-labelledby="local-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">La tienda</p>
						<h2 class="title" id="local-title">
							Flores y plantas,
							<br />
							<em>en Sevilla.</em>
						</h2>
						<p>
							Google la clasifica como floristería, tienda de globos, entrega de flores, tienda de regalos y organizador de eventos y bodas. Le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{textoResenas}. Está en la
							Calle Mallorca, 1, con código postal
							41014, en Sevilla (la ficha no publica distrito), frente al Hospital Viamed Santa Angela de la Cruz, y la ficha publica su plus
							code
							82HM+27 Sevilla.
						</p>
						<p>
							Su propia descripción en la ficha dice, literalmente: «Floristería en Sevilla, frente al Hospital Viamed, Sta. Angela de la Cruz. En la Tarentina te esperamos para que hagas tus mejores regalos florales. Amplia variedad en flor fresca cortada, centros florales, flor preservada, ramos de flores, bouquets, ramos de novia, arreglos florales para bodas y eventos, plantas y exclusivos bombones Belgas con la mejor de nuestras sonrisas. No dudes en contactarnos.», y aquí se reproduce tal cual, sin añadir nada. La vista previa no incluía los textos de las reseñas, así que no se reproduce ningún extracto.
						</p>
						<p>
							Esta web se ha preparado solo con lo que publica la ficha, consultada
							el {site.consultado}: nombre, dirección, teléfono, categoría,
							horario, valoración, el servicio de accesibilidad, la descripción del titular
							y sus propias fotografías. La
							ficha no publica textos de reseñas, web, catálogo ni precios, así que aquí no se
							reproducen.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>{textoResenas} en Google Maps</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver todas ↗</a>
						</div>
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									<strong>{review.rating} sobre 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section cocina" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						La tienda <em>en fotos.</em>
					</h2>
					<p class="lead">
						Son las diez fotografías que La Tarentina Floristería publica en su ficha de
						Google Maps. El manifiesto de la descarga no atribuye ninguna a un autor
						con nombre, así que se publican sin pie y sin atribución. La ficha no
						describe el contenido de las fotos y aquí no se inventa ninguna descripción.
					</p>
					<div class="cocina-grid">
						{galeria.map((name) => (
							<figure class="cocina-item">
								<Image
									src={foto(name)}
									alt={altFoto}
									widths={[380, 560, 800]}
									sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
									format="webp"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))}
					</div>
					<p class="cocina-note">
						La ficha no publica catálogo ni precios, así que esta web no los reproduce.
						Para saber qué hay hoy, lo más rápido es{' '}
						<a href={phoneHref}>llamar al {business.phone}</a> o mirar las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos y reseñas de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Calle Mallorca, 1,
							<br />
							<em>41014 Sevilla.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr class:list={[{ 'is-closed': item.shifts.length === 0 }]}>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							La tienda abre <strong>de lunes a viernes</strong> mañana de 10:00 a 14:00 y tarde de 17:00 a 20:00; el <strong>sábado</strong> abre de 10:00 a 13:00 y el <strong>domingo</strong> cierra. Conviene confirmar
							por teléfono antes de ir.
						</p>
						{accesibilidad.length > 0 ? (
						<ul class="access-list">
							{accesibilidad.map((item) => (
								<li class:list={[{ 'is-no': !item.disponible }]}>{item.label}</li>
							))}
						</ul>
) : (
						<p class="hours-note">La ficha no publica datos de accesibilidad.</p>
)}
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
						 src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>llamar.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">LT</span>
					<span>
						La Tarentina Floristería
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} La Tarentina Floristería · Calle Mallorca, 1
					(41014 Sevilla). Web informativa elaborada con los datos, la descripción y las fotografías que
					el local publica en su ficha de Google Maps, consultada el {site.consultado}.
					Confirma horario y disponibilidad por teléfono antes de salir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/la-tarentina/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/la-tarentina/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/la-tarentina/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a La Tarentina Floristería <span>{business.phone}</span>
		</a>

	</body>
</html>
