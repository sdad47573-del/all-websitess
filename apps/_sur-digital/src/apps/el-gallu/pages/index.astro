---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import { Image } from 'astro:assets';
import '../styles/global.css';
import {
	business,
	directionsUrl,
	dishPhoto,
	gallery,
	mapEmbedUrl,
	mapsUrl,
	phoneHrefs,
	specialties,
	structuredData,
} from '../lib/business';

const title = 'El Gallu | Cocina asturiana y sidrería en Rincón de la Victoria';
const description =
	'El Gallu, cocina asturiana y sidrería en Calle Jaén, 11, Rincón de la Victoria (Málaga). Cachopo, gildas, croquetas caseras y sidra natural. Reservas: 618 79 29 62.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#23262a" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="Rincón de la Victoria" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/el-gallu/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Overpass+Mono:wght@400;500&family=Rubik:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta property="og:image" content="https://el-gallu-malaga.vercel.app/og.png" />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="El Gallu, inicio"
				><span class="brand-mark" aria-hidden="true">EG</span><span class="brand-label"
					>EL GALLU <small>ASTURIANO · SIDRERÍA</small></span
				></a
			>
			<nav class="desktop-nav" aria-label="Navegación principal">
				<a href="#carta">La carta</a><a href="#fotos">Fotos</a><a href="#contacto">Contacto</a>
			</nav>
			<a class="header-phone" href={phoneHrefs[0]}
				><span aria-hidden="true">☎</span> {business.phones[0]}</a
			>
			<nav class="mobile-nav" aria-label="Navegación móvil">
				<a href="#carta">La carta</a><a href="#fotos">Fotos</a><a href="#contacto">Contacto</a>
			</nav>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-inner">
					<div class="hero-content">
						<p class="eyebrow"><span></span> COCINA ASTURIANA · SIDRERÍA</p>
						<h1 id="hero-title">El<br /><em>Gallu</em></h1>
						<p class="hero-sub">Restaurante asturiano · Rincón de la Victoria</p>
						<p class="hero-intro">
							Cocina asturiana y del norte en Rincón de la Victoria. Cachopo, gildas, croquetas
							caseras y buenos postres, con sidra natural para acompañar. Un rincón tranquilo junto
							al parque.
						</p>
						<div class="hero-actions">
							<a class="button button-cider" href={phoneHrefs[0]}
								><span aria-hidden="true">☎</span> Llamar y reservar</a
							><a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer"
								>Cómo llegar <span aria-hidden="true">↗</span></a>
						</div>
					</div>
					<figure class="hero-media">
						<Image
							src={dishPhoto.src}
							alt={dishPhoto.alt}
							width={dishPhoto.width}
							height={dishPhoto.height}
							widths={[420, 700, 1000]}
							sizes="(max-width: 900px) 90vw, 380px"
							format="webp"
							quality={72}
							loading="eager"
							fetchpriority="high"
						/>
						<figcaption>Plato de la casa · foto de la ficha de Google</figcaption>
					</figure>
				</div>
				<div class="hero-bar">
					<div class="bar-cell">
						<small>DIRECCIÓN</small><address>
							{business.streetAddress}<br />{business.postalCode}
							{business.city}
						</address>
					</div>
					<div class="bar-cell">
						<small>RESERVAS</small><a href={phoneHrefs[0]}>{business.phones[0]}</a>
					</div>
					<div class="bar-cell">
						<small>DÓNDE ESTAMOS</small><a href={mapsUrl} target="_blank" rel="noreferrer"
							>Ver en Google Maps ↗</a>
					</div>
				</div>
			</section>

			<section class="placas-section" id="carta" aria-labelledby="placas-title">
				<div class="placas-head">
					<p class="section-label"><span>01 /</span> LO MÁS PEDIDO</p>
					<h2 id="placas-title">Clásicos<br /><em>del norte.</em></h2>
				</div>
				<ul class="placas">
					{
						specialties.map((dish, index) => (
							<li class="placa">
								<span class="placa-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<strong class="placa-name">{dish.name}</strong>
								<span class="placa-note">{dish.note}</span>
							</li>
						))
					}
				</ul>
				<p class="placas-foot">
					Y muchos más platos en la carta del local. Pregunta por las sugerencias del día.
				</p>
			</section>

			<section class="gallery-section" id="fotos" aria-labelledby="gallery-title">
				<div class="gallery-head">
					<p class="section-label"><span>02 /</span> LA CARTA EN FOTOGRAFÍAS</p>
					<h2 id="gallery-title">Lo que se ve<br /><em>en la mesa.</em></h2>
				</div>
				<ul class="gallery">
					{
						gallery.map((photo) => (
							<li class="gallery-item">
								<figure>
									<Image
										src={photo.src}
										alt={photo.alt}
										widths={[360, 620, 900]}
										sizes="(max-width: 700px) 86vw, (max-width: 1100px) 44vw, 30vw"
										format="webp"
										quality={70}
										loading="lazy"
									/>
									<figcaption>{photo.cap}</figcaption>
								</figure>
							</li>
						))
					}
				</ul>
				<p class="gallery-foot">Imágenes de la ficha de Google Maps de El Gallu.</p>
			</section>

			<section class="about-section" aria-labelledby="about-title">
				<p class="section-label"><span>03 /</span> EL GALLU · RINCÓN DE LA VICTORIA</p>
				<div class="about-content">
					<h2 id="about-title">Cocina de siempre,<br /><em>producto de verdad.</em></h2><div>
						<p>
							En El Gallu traemos al sur la cocina asturiana: recetas honestas, raciones generosas y
							producto de calidad. Cachopo para compartir, gildas, croquetas caseras, quesos y
							embutidos del norte, y una sidra natural que sienta de maravilla. Terraza agradable
							junto al parque, ideal para ir en familia o con amigos.
						</p><a class="social-link" href={mapsUrl} target="_blank" rel="noreferrer"
							>Ver la ficha y las opiniones en Google Maps <span aria-hidden="true">↗</span></a>
					</div>
				</div>
				<div class="about-footer">
					<span>ASTURIANA · SIDRA · CACHOPO</span><span>29730 RINCÓN DE LA VICTORIA</span><span
						>✦</span>
				</div>
			</section>

			<section class="contact-section" id="contacto" aria-labelledby="contact-title">
				<p class="section-label"><span>04 /</span> VISÍTANOS</p>
				<div class="contact-layout">
					<div class="contact-copy">
						<p class="contact-kicker">ESTAMOS EN CALLE JAÉN</p><h2 id="contact-title">
							Reserva<br /><em>tu mesa.</em>
						</h2>
						<div class="contact-card">
							<div class="contact-row">
								<span aria-hidden="true">⌖</span><div>
									<small>DIRECCIÓN</small><address>
										{business.streetAddress}<br />{business.postalCode}
										{business.city}
									</address>
								</div>
							</div>
							<div class="contact-row">
								<span aria-hidden="true">☎</span><div>
									<small>RESERVAS</small><a href={phoneHrefs[0]}>{business.phones[0]}</a>
								</div>
							</div>
						</div>
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer"
							>Abrir indicaciones <span aria-hidden="true">↗</span></a
						>
					</div>
					<div class="map-card">
						<div class="map-header">
							<span><i></i> CALLE JAÉN · RINCÓN DE LA VICTORIA</span><a
								href={mapsUrl}
								target="_blank"
								rel="noreferrer">ABRIR MAPS ↗</a>
						</div><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
							title="Mapa de El Gallu en Calle Jaén, Rincón de la Victoria"
						 src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div><div class="map-footer">
							<span aria-hidden="true">⌖</span><div>
								<strong>{business.name}</strong><small
									>{business.streetAddress} · {business.city}</small>
							</div><a
								href={directionsUrl}
								target="_blank"
								rel="noreferrer"
								aria-label="Cómo llegar a El Gallu">↗</a>
						</div>
					</div>
				</div>
				<div class="social-row">
					<span>ENCUÉNTRANOS TAMBIÉN EN</span><a href={mapsUrl} target="_blank" rel="noreferrer"
						>Google Maps ↗</a
					><a href={phoneHrefs[0]}>{business.phones[0]} ↗</a>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio" aria-label="El Gallu, volver al inicio"
				><span class="brand-mark">EG</span><span class="brand-label"
					>EL GALLU <small>ASTURIANO · SIDRERÍA</small></span
				></a
			><p>
				{business.streetAddress}, {business.postalCode}
				{business.city}<br /><a href={phoneHrefs[0]}>{business.phones[0]}</a>
			</p><a class="footer-social" href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a
			><small
				>© {new Date().getFullYear()} El Gallu · Rincón de la Victoria &nbsp;·&nbsp; Consulta la carta
				y los horarios en el local.</small
			>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small
					>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a
					></small
				>
			</p>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/el-gallu/aviso-legal">Aviso legal</a>
			<a href="/el-gallu/aviso-legal#privacidad">Privacidad</a>
			<a href="/el-gallu/aviso-legal#cookies">Cookies</a>
		</nav>
	</footer>
		<a class="phone-cta" href={phoneHrefs[0]}
			><span aria-hidden="true">☎</span> Reservar en El Gallu <strong>{business.phones[0]}</strong
			></a
		>

		<WhatsappFab phone={datos.phoneHrefs[0]} name={datos.business?.name} />
	</body>
</html>


