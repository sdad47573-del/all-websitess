---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import bife from '../assets/fotos/restaurante-o-ferreirinho-vertical-07.jpg';
import cozido from '../assets/fotos/restaurante-o-ferreirinho-apaisada-09.jpg';
import peixe from '../assets/fotos/restaurante-o-ferreirinho-vertical-04.jpg';
import marisco from '../assets/fotos/restaurante-o-ferreirinho-apaisada-02.jpg';
import migas from '../assets/fotos/restaurante-o-ferreirinho-apaisada-03.jpg';
import sobremesa from '../assets/fotos/restaurante-o-ferreirinho-vertical-01.jpg';
import caracois from '../assets/fotos/restaurante-o-ferreirinho-apaisada-05.jpg';
import guisado from '../assets/fotos/restaurante-o-ferreirinho-vertical-10.jpg';
import pratosDoDia from '../assets/fotos/restaurante-o-ferreirinho-panoramica-08.jpg';
import sopa from '../assets/fotos/restaurante-o-ferreirinho-apaisada-06.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
} from '../data/site';

const description = BUSINESS.description;

const galeria = [
	{
		src: bife,
		alt: 'Bife a la parrilla con patatas fritas, ensalada y un vaso de vino tinto en O Ferreirinho',
	},
	{
		src: marisco,
		alt: 'Arroz de marisco con gambas y mejillones, con cilantro por encima, servido en la cazuela',
	},
	{
		src: migas,
		alt: 'Migas con trozos de cerdo, chouriço y jamón sobre una fuente blanca',
	},
	{
		src: sobremesa,
		alt: 'Tarta de chocolate con galleta Lotus en la base y cobertura brillante, sobre un pie de pastelería',
	},
	{
		src: guisado,
		alt: 'Carne guisada en salsa oscura con arroz blanco, grelos y salsa fresca de tomate',
	},
	{
		src: peixe,
		alt: 'Pescado entero a la brasa con patatas asadas y grelos en una fuente, en O Ferreirinho',
	},
	{
		src: caracois,
		alt: 'Ració de caracóis en plato blanco con el cuenco de salsa amarilla al lado',
	},
	{
		src: pratosDoDia,
		alt: 'Tres platos de pratos do dia: pollo y costilla guisados, puré y alubias en salsa',
	},
	{
		src: sopa,
		alt: 'Cuenco de sopa con rodajas de chouriço, morcilla y berza en O Ferreirinho',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.fullName,
	alternateName: [BUSINESS.name, 'Restaurante O Ferreirinho Bucelas', 'O Ferreirinho Loures'],
	slogan: 'Comida casera a pie de la EN-116',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 934 802 421',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Portuguesa', 'Casera', 'Parrilla'],
	areaServed: [
		{ '@type': 'City', name: 'Bucelas' },
		{ '@type': 'City', name: 'Loures' },
		{ '@type': 'AdministrativeArea', name: 'Área Metropolitana de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '07:30',
			closes: '21:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'O Ferreirinho · Comida casera en Bucelas (Loures)';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-o-ferreirinho-apaisada-09.jpg": cozido,
	"restaurante-o-ferreirinho-vertical-07.jpg": bife,
	"restaurante-o-ferreirinho-apaisada-02.jpg": marisco,
	"restaurante-o-ferreirinho-apaisada-03.jpg": migas,
	"restaurante-o-ferreirinho-vertical-01.jpg": sobremesa,
	"restaurante-o-ferreirinho-vertical-10.jpg": guisado,
	"restaurante-o-ferreirinho-vertical-04.jpg": peixe,
	"restaurante-o-ferreirinho-apaisada-05.jpg": caracois,
	"restaurante-o-ferreirinho-panoramica-08.jpg": pratosDoDia,
	"restaurante-o-ferreirinho-apaisada-06.jpg": sopa,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#6d1f24" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;500;600;700&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="O Ferreirinho, Restaurante O Ferreirinho, restaurante Bucelas, comer en Bucelas, pratos do dia Bucelas, restaurante Loures, comida caseira Loures, N116 Bucelas, grelhados Bucelas, caracóis Bucelas, arroz de marisco Bucelas"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="O Ferreirinho · Comida casera en Bucelas"
			ogDescription="Pratos do dia a 7,50 €, pescado a la brasa, bifes y arroz de marisco, de lunes a sábado. 4,3 en Google con 141 reseñas. Tel. 934 802 421."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bife a la parrilla con patatas fritas y vino tinto en O Ferreirinho, Bucelas"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#6d1f24"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone="+351934802421"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.municipality}`}
			countryName="Portugal"
			contact={{
				street: BUSINESS.street,
				locality: `${BUSINESS.city}, ${BUSINESS.municipality}`,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				phone: '+351 934 802 421',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[cozido]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Restaurante · Bucelas"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a O Ferreirinho"
			creditLabel="Creado por"
			creditName="Sur Digital"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/351934802421?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Bucelas." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Bucelas"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
