---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/punto-coma-fachada-terraza.jpg';
import fachadaToldo from '../assets/fotos/punto-coma-fachada-toldo.jpg';
import fachadaSombrillas from '../assets/fotos/punto-coma-fachada-sombrillas.jpg';
import cartaBebidas from '../assets/fotos/punto-coma-carta-bebidas.jpg';
import pitufos from '../assets/fotos/punto-coma-pitufos-cristal.jpg';
import pitufo from '../assets/fotos/punto-coma-pitufo-desayuno.jpg';
import bocadillo from '../assets/fotos/punto-coma-bocadillo-jamon.jpg';
import cafeTaza from '../assets/fotos/punto-coma-cafe-leche.jpg';
import cafeEspuma from '../assets/fotos/punto-coma-cafe-cerca.jpg';
import desayunoExterior from '../assets/fotos/punto-coma-desayuno-exterior.jpg';
import desayunoPlato from '../assets/fotos/punto-coma-desayuno-plato.jpg';
import churros from '../assets/fotos/punto-coma-churros-cafe.jpg';
import barra from '../assets/fotos/punto-coma-barra-trasera.jpg';
import barraTazas from '../assets/fotos/punto-coma-barra-sillones.jpg';

const business = {
	name: 'Punto & Coma',
	tagline: 'Café y tapas en Teatinos',
	street: 'C. Dr. Miguel Díaz Recio, 32',
	district: 'Teatinos-Universidad',
	city: 'Málaga',
	postalCode: '29010',
	phone: '',
	latitude: 36.7249,
	longitude: -4.4739,
	rating: 3.8,
	reviewsCount: 71,
	site: 'https://www.sur-digital.com/punto-coma-malaga',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd72f7c4a9ee4a0f:0x6d1d129c57bc3162';
const cidDecimal = '7862460987154903394';
const placeId = 'ChIJD0ruqcT3cg0RYjG8V5wSHW0';

const mapsUrl = `https://www.google.com/maps/place/?q=place_id:${placeId}&hl=es`;
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;

const description =
	'Punto & Coma, café y tapas en C. Dr. Miguel Díaz Recio, 32 (Teatinos, Málaga). Desayunos desde las siete de la mañana: pitufos, bocadillos, churros y café. De lunes a viernes hasta las 16:00. 3,8 en Google.';

const servicios = [
	'Café desde las 7:00',
	'Pitufos y bocadillos',
	'Churros',
	'Huevos rotos',
	'Desayunos',
	'Café de especialidad',
	'Infusiones y tes',
	'Batidos puleva',
	'Cócteles y licores',
	'Vinos por copa',
	'Cerveza de BOTELLA',
	'Terraza en la calle',
	'Barrio de Teatinos',
];

// Carta transcrita de la foto de la carta del propio local publicada en Google Maps.
const grupos = [
	{
		title: 'Cafés e infusiones',
		items: [
			{ name: 'Café simple o doble' },
			{ name: 'Espresso, doppio y bombón' },
			{ name: 'Vaso de leche, colacao y capuccino' },
			{ name: 'Infusiones, té y chocolate' },
			{ name: 'Baileys, ron, coñac y anís' },
		],
	},
	{
		title: 'Desayuno y picoteo',
		items: [
			{ name: 'Bacon mollete con tomate y queso' },
			{ name: 'Pitufos y bocadillos', note: 'la especialidad del local, con mollete recién hecho' },
			{ name: 'Churros con café', note: 'el clásico de la mañana, con chocolate para mojar' },
			{ name: 'Huevos rotos', note: 'con bacon y patata, servidos en plato' },
			{ name: 'Terraza en la calle', note: 'con sombrillas y veletas, junto a la acera' },
		],
	},
	{
		title: 'Bebidas frías y barra',
		items: [
			{ name: 'Zumo natural de naranja' },
			{ name: 'Batidos puleva, biofrutas y refrescos' },
			{ name: 'Cócteles combinados', note: 'JB, balloonines, daiquiri, mojito, Larios, Bacardí y ron' },
			{ name: 'Cerveza de botella', note: 'Mahou y Radler en botella, y caña de barril' },
			{ name: 'Vinos por copa', note: 'tinto y blanco por copa, y el tinto de verano en botella' },
		],
	},
];

const galeria = [
	{ src: cartaBebidas, alt: 'Carta de bebidas de Punto & Coma, café y tapas en Teatinos, Málaga' },
	{ src: pitufos, alt: 'Pitufos de Punto & Coma bajo campana de cristal en Teatinos, Málaga' },
	{ src: pitufo, alt: 'Pitufo con café y zumo de naranja en Punto & Coma, desayuno en Teatinos' },
	{ src: bocadillo, alt: 'Bocadillo de jamón y queso servido en Punto & Coma, cafetería en Teatinos, Málaga' },
	{ src: churros, alt: 'Churros con café en Punto & Coma, café y tapas en Teatinos, Málaga' },
	{ src: desayunoPlato, alt: 'Desayuno completo en plato en Punto & Coma, cafetería en Teatinos, Málaga' },
	{ src: cafeTaza, alt: 'Café con leche en taza de Punto & Coma, café y tapas en Teatinos, Málaga' },
	{ src: cafeEspuma, alt: 'Café con leche espumosa en vaso de Punto & Coma, cafetería en Teatinos' },
	{ src: desayunoExterior, alt: 'Mesa de terraza de Punto & Coma con café y tostada en Teatinos, Málaga' },
	{ src: barra, alt: 'Barra de Punto & Coma con las tazas alineadas en Teatinos, Málaga' },
	{ src: barraTazas, alt: 'Tazas de café en la barra de Punto & Coma, café y tapas en Teatinos, Málaga' },
	{ src: fachadaToldo, alt: 'Fachada de Punto & Coma en la calle Miguel Díaz Recio, Teatinos, Málaga' },
	{ src: fachadaSombrillas, alt: 'Terraza con sombrillas de Punto & Coma en Teatinos-Universidad, Málaga' },
];

const faqs = [
	{
		q: '¿Dónde está Punto & Coma?',
		a: 'En la calle Dr. Miguel Díaz Recio, 32, en el barrio de Teatinos-Universidad (29010 Málaga), junto a la Universidad. Tiene terraza con sombrillas y veletas en la acera.',
	},
	{
		q: '¿Cuál es el horario de Punto & Coma?',
		a: 'De lunes a viernes abre de 7:00 a 16:00, y el sábado de 7:00 a 12:30. El domingo está cerrado. Es un local pensado para el desayuno y la mañana, así que por la tarde cierra pronto.',
	},
	{
		q: '¿Tiene teléfono?',
		a: 'No. La ficha de Google Maps del local no publica ningún número de teléfono, y el propio ticket del local aparece con el campo de teléfono en blanco. La vía de contacto más fiable es la ficha de Google Maps, desde donde se puede escribir o pedir información.',
	},
	{
		q: '¿Qué es un pitufo?',
		a: 'Es el mollete relleno que se pide en los bares y cafeterías de Málaga, y en Punto & Coma es la especialidad. Se prepara con bacon, tomate y queso, y se sirve en barra o en mesa.',
	},
	{
		q: '¿Tiene terraza?',
		a: 'Sí, y es una de las cosas que más destacan los clientes: mesas en la acera con sombrillas y veletas. También hay sitio dentro, con la barra y las tazas alineadas que aparecen en las fotos de la ficha.',
	},
	{
		q: '¿Sirve comida o solo café?',
		a: 'El local se anuncia como café y tapas, y en la carta aparecen los cócteles, los licores, las cervezas de botella y los vinos por copa, además de zumos y batidos. Para el desayuno, los pitufos, los bocadillos y los churros son la base.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'No hay sistema de reservas: es un local de barra y terraza por orden de llegada. Alguna reseña menciona que a las horas punta se puede esperar, porque el espacio es limitado.',
	},
	{
		q: '¿Cómo llego a Punto & Coma?',
		a: 'Está en Teatinos-Universidad, a poca distancia de los edificios de la Universidad. Puedes usar el botón de cómo llegar de esta misma web, que abre la ruta en Google Maps, o ir andando desde el campus.',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': ['CafeOrCoffeeShop', 'Bar', 'Bakery'],
	'@id': `${business.site}/#negocio`,
	name: business.name,
	alternateName: ['Punto y Coma', 'Punto & Coma Café y Tapas', 'Punto & Coma Teatinos', 'Punto Coma Málaga'],
	slogan: 'Tu punto y coma en Teatinos',
	description,
	url: `${business.site}/`,
	priceRange: '1–10 €',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cafetería', 'Desayunos', 'Tapas', 'Cócteles'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	image: `${business.site}/og.jpg`,
	sameAs: [mapsUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '07:00',
			closes: '12:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '00:00',
			closes: '00:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza en la calle', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Desayunos desde las 7:00', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Pitufos y bocadillos', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Churros', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Cócteles y licores', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Vinos por copa', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Punto &amp; Coma · Café y tapas en Teatinos, Málaga</title>
		<meta name="theme-color" content="#1e4a3c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Punto & Coma Málaga, café Teatinos, cafetería Teatinos, pitufos Teatinos, pitufo Málaga, desayuno Teatinos, café Miguel Díaz Recio, bar Teatinos, cafetería 29010 Málaga, churros Teatinos, desayuno Universidad Málaga, café Bailén, cafetería Dr. Miguel Díaz Recio 32"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Punto &amp; Coma · Café y tapas en Teatinos, Málaga"
			ogDescription="Pitufos, bocadillos, churros y café desde las 7:00 en C. Dr. Miguel Díaz Recio, 32, Teatinos. De lunes a viernes hasta las 16:00."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Fachada y terraza de Punto &amp; Coma en la calle Miguel Díaz Recio, Teatinos, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#1e4a3c"
			street={business.street}
			city={business.city}
			region="Andalucía"
			postalCode={business.postalCode}
			phone=""
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Teatinos-Universidad, Málaga"
			preload={[heroImage]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://www.sur-digital.com/punto-coma-malaga/og.jpg" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7249;-4.4739" />
		<meta name="ICBM" content="36.7249, -4.4739" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="P&C"
			name="Punto & Coma"
			subtitle="Café y Tapas"
			phone="Google Maps"
			phoneHref={mapsUrl}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Teatinos · Málaga"
				title="Tu punto y coma<br /><em>en Teatinos.</em>"
				lede="Punto & Coma está en la calle Dr. Miguel Díaz Recio, 32, a pasos de la Universidad. Abre a las siete de la mañana con café, pitufos recién hechos y churros, y no cierra hasta las cuatro de la tarde de lunes a viernes. Café y tapas en un local pequeño y con terraza."
				image={heroImage}
				imageAlt="Fachada y terraza de Punto & Coma en la calle Miguel Díaz Recio, Teatinos, Málaga"
				primaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl }}
				secondaryCta={{ label: 'Cómo llegar', href: directionsUrl }}
				facts={[
					{ label: 'Nota', html: '<b>3,8</b> en Google (71 reseñas)' },
					{ label: 'Horario', html: 'Lunes a viernes, <b>7:00–16:00</b>' },
					{ label: 'Sábado y domingo', html: 'Sábado 7:00–12:30, domingo cerrado' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Punto & Coma" items={servicios} />

			<LocalAbout
				label="Café y tapas"
				title="Desde las siete,<br /><em>hasta la tarde.</em>"
				paragraphs={[
					'Punto & Coma ocupa el número 32 de la calle Dr. Miguel Díaz Recio, en pleno Teatinos-Universidad, a poca distancia de los edificios de la Universidad. El rótulo del local ya lo explica: café y tapas. Y el horario también: abre a las siete de la mañana y cierra a las cuatro de la tarde de lunes a viernes, con el sábado hasta las doce y media y el domingo cerrado.',
					'El centro del local es el desayuno. Los pitufos y los bocadillos con mollete son la especialidad, y en las fotos de la ficha se ven los churros, los huevos rotos y el bacon mollete con tomate y queso. El café es la otra mitad del negocio, del espresso matinal a los cócteles de la tarde.',
					'La carta es sorprendentemente amplia para un local de barrio: además de los cafés e infusiones, hay batidos puleva, zumos naturales, cócteles combinados, licores, vinos por copa y cervezas de botella.',
					'El local tiene terraza en la acera, con sombrillas y veletas, y dentro una barra con las tazas alineadas. Varios clientes lo recomiendan como sitio tranquilo para desayunar; otros señalan que a las horas punta hay que esperar, porque el número de mesas es limitado.',
				]}
				note="La nota media en Google es de 3,8 sobre 71 reseñas. Lo más citado: el pitufo, que varios clientes dicen que está muy rico, y el ambiente tranquilo del local. También aparece alguna queja sobre el tiempo de espera en horas punta y sobre el espacio."
				links={[{ label: 'Ficha y reseñas en Google', href: cidUrl, external: true }]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Café, pitufo<br /><em>y algo de barra.</em>"
				description="Carta transcrita de la foto de la carta del propio local publicada en su ficha de Google Maps. La carta puede cambiar, así que confírmala en el local."
				cta={{ label: 'Ver la carta en Google Maps', href: mapsUrl }}
				groups={grupos}
				note="La carta de la foto puede haber cambiado; consulta la ficha de Google Maps del local para verla al día."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La carta, los pitufos<br /><em>y la terraza.</em>"
				description="Estas fotografías proceden del perfil de Punto & Coma en Google Maps: la carta de bebidas, los pitufos bajo campana de cristal, los desayunos, el café y la terraza. En la ficha están todas las fotos y las reseñas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del local en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="C. Dr. Miguel Díaz Recio, 32 · 29010 Málaga"
				title="Nos vemos<br /><em>en Teatinos.</em>"
				addressLines={[
					business.street,
					business.district,
					`${business.postalCode} ${business.city}, España`,
				]}
				hours={[
					{ day: 'Lunes', value: '7:00–16:00' },
					{ day: 'Martes', value: '7:00–16:00' },
					{ day: 'Miércoles', value: '7:00–16:00' },
					{ day: 'Jueves', value: '7:00–16:00' },
					{ day: 'Viernes', value: '7:00–16:00' },
					{ day: 'Sábado', value: '7:00–12:30' },
					{ day: 'Domingo', value: 'Cerrado', closed: true },
				]}
				hoursNote="Horario publicado en la ficha de Google: de lunes a viernes de 7:00 a 16:00, sábado de 7:00 a 12:30 y domingo cerrado. Puede variar en festivos."
				mapTitle="Mapa de Punto &amp; Coma en la calle Dr. Miguel Díaz Recio, 32, Teatinos-Universidad, Málaga"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Punto &amp; Coma · Teatinos"
				mapHref={cidUrl}
				links={[{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' }]}
				contactLink={{ label: 'Ficha en Google Maps', href: cidUrl, external: true }}
				reserveNote="No hay teléfono publicado ni sistema de reservas: es un local de barra y terraza por orden de llegada. Para información o pedidos, usa el mensaje de la ficha de Google Maps."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="P&C"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Ficha y fotos ↗', href: cidUrl, external: true },
			]}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			phone=""
			phoneHref={mapsUrl}
			ctaLabel="Abrir en Google Maps"
		/>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/punto-coma-malaga/aviso-legal">Aviso legal</a>
			<a href="/punto-coma-malaga/aviso-legal#privacidad">Privacidad</a>
			<a href="/punto-coma-malaga/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>