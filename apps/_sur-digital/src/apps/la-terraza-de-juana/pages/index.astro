---
import '../styles/global.css';

const business = {
	name: 'Restaurante La Terraza de Juana',
	short: 'La Terraza de Juana',
	claim: 'Casa de Comidas y Copas',
	street: 'Pago Santa Lucía s/n',
	city: 'Vejer de la Frontera',
	postalCode: '11150',
	latitude: 36.267295,
	longitude: -5.9734763,
	site: 'https://www.sur-digital.com/la-terraza-de-juana',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+La+Terraza+de+Juana+-+Casa+de+Comidas+y+Copas+-+Vejer/@36.267295,-5.9734763,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c4592910fc0af:0xf17a841f232da110!8m2!3d36.267295!4d-5.9734763!16s%2Fg%2F11nn1x56yy?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=15&output=embed`;
const instagramUrl = 'https://www.instagram.com/laterrazadejuanavejer/';
const facebookUrl = 'https://www.facebook.com/laterrazadejuana/';

const specialties = [
	{
		kicker: 'Casa de comidas',
		title: 'Para comer en familia',
		text: 'Un lugar ideal para comer en familia en Santa Lucía, según su propia casa.',
	},
	{
		kicker: 'Y copas',
		title: 'Con los amigos',
		text: 'Y para tomar una copa con los amigos en su terraza.',
	},
	{
		kicker: 'Desde las 13:00',
		title: 'Apertura al mediodía',
		text: 'Abren sus puertas desde las 13:00, según su Instagram oficial.',
	},
	{
		kicker: 'Monumento natural',
		title: 'Santa Lucía',
		text: 'En Santa Lucía, entorno declarado monumento natural por su paisaje.',
	},
	{
		kicker: 'Terraza',
		title: 'Tan bonita como el resto',
		text: '«Es tiempo de terraza. Y la nuestra es tan bonita como el resto», dicen ellos.',
	},
	{
		kicker: 'Confirma',
		title: 'Horario y reservas',
		text: 'El horario completo varía por temporada: consúltalo en su Instagram o ficha de Maps.',
	},
];

const gallery = [
	{ src: '/la-terraza-de-juana/fotos/terraza.svg', alt: 'Ilustración de la terraza — sustituye por foto propia' },
	{ src: '/la-terraza-de-juana/fotos/santa-lucia.svg', alt: 'Ilustración de Santa Lucía — sustituye por foto propia' },
	{ src: '/la-terraza-de-juana/fotos/comidas.svg', alt: 'Ilustración de casa de comidas — sustituye por foto propia' },
	{ src: '/la-terraza-de-juana/fotos/copas.svg', alt: 'Ilustración de copas — sustituye por foto propia' },
	{ src: '/la-terraza-de-juana/fotos/familia.svg', alt: 'Ilustración de comida en familia — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está La Terraza de Juana?',
		a: 'En Pago Santa Lucía s/n, 11150 Vejer de la Frontera (Cádiz), en Santa Lucía, según sus publicaciones.',
	},
	{
		q: '¿Cuál es el teléfono o el horario completo?',
		a: 'No hay fuente verificable completa: abren desde las 13:00 según Instagram, con horario de temporada. Míralo en su Instagram o ficha de Maps antes de venir.',
	},
	{
		q: '¿Qué se puede tomar?',
		a: 'Casa de comidas y copas: para comer en familia o tomar una copa con amigos. Confirma la oferta del día en el local.',
	},
	{
		q: '¿Cómo llego?',
		a: 'Usa el botón «Cómo llegar» para abrir la ruta en Google Maps con las coordenadas de su ficha.',
	},
];

const description =
	'La Terraza de Juana: casa de comidas y copas en Pago Santa Lucía s/n, Vejer. Terraza en monumento natural. Abren desde las 13:00. Consulta horario en Instagram.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: `${business.name} — ${business.claim}`,
	description,
	url: `${business.site}/`,
	image: [`${business.site}/fotos/terraza.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Mediterránea'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [instagramUrl, facebookUrl],
	acceptsReservations: 'True',
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="La Terraza de Juana: casa de comidas y copas en Santa Lucía, Vejer. Terraza en monumento natural. Desde las 13:00." />
		<meta name="keywords" content="Terraza de Juana Vejer, Santa Lucía Vejer comer, casa de comidas Vejer, terraza Vejer" />
		<meta name="author" content="Restaurante La Terraza de Juana" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/la-terraza-de-juana/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>La Terraza de Juana | Casa de Comidas y Copas en Vejer</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="La Terraza de Juana · Casa de Comidas y Copas" />
		<meta property="og:description" content="Terraza en Santa Lucía, Vejer: comer en familia o tomar una copa. Desde las 13:00." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/terraza.svg`} />
		<meta property="og:image:alt" content="La Terraza de Juana, Santa Lucía, Vejer" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="La Terraza de Juana · Casa de Comidas y Copas" />
		<meta name="twitter:description" content="Santa Lucía, Vejer: terraza, comidas y copas. Desde las 13:00." />
		<meta name="twitter:image" content={`${business.site}/fotos/terraza.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Santa Lucía, Vejer de la Frontera" />
		<meta name="geo.position" content="36.267295;-5.9734763" />
		<meta name="ICBM" content="36.267295, -5.9734763" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="La Terraza de Juana, inicio">
				<span class="brand-mark" aria-hidden="true">TJ</span>
				<span class="brand-name">Terraza de Juana <small>Santa Lucía · Vejer</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">La casa</a>
				<a href="#carta">Comidas y copas</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Santa Lucía · Vejer de la Frontera</p>
					<h1 id="hero-title">Comidas<br />y <em>copas.</em></h1>
					<p class="hero-lede">
						Casa de comidas y copas en Santa Lucía: monumento natural, terraza bonita,
						para comer en familia o tomar una copa con amigos. Desde las 13:00.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={instagramUrl} target="_blank" rel="noreferrer">Ver Instagram ↗</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>13:00</b> apertura</li>
						<li>Santa Lucía</li>
						<li>Terraza</li>
						<li>Comidas y copas</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/la-terraza-de-juana/fotos/terraza.svg" alt="Ilustración de La Terraza de Juana, Santa Lucía, Vejer" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Santa Lucía · Vejer</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>13h</b><span>Apertura</span></div>
					<div><b>Santa</b><span>Lucía</span></div>
					<div><b>Vejer</b><span>Cádiz</span></div>
				</div>
				<ul class="services">
					<li>Comidas</li>
					<li>Copas</li>
					<li>Terraza</li>
					<li>Familia</li>
					<li>Amigos</li>
					<li>Monumento natural</li>
				</ul>
			</section>

			<section class="about section-pad" id="restaurante">
				<p class="section-label"><span aria-hidden="true"></span> La casa</p>
				<div class="about-grid">
					<h2>Todos los días<br />son <em>buenos.</em></h2>
					<div class="about-copy">
						<p>
							«¡Todos los días son buenos para disfrutar en La Terraza de Juana! Desde las 13:00 horas
							abrimos nuestras puertas», dice la casa en su Instagram oficial.
						</p>
						<p>
							La encontrarás en Santa Lucía (Vejer), Pago Santa Lucía s/n, un entorno declarado monumento
							natural por la riqueza de su paisaje: ideal para comer en familia o tomar una copa.
						</p>
						<p class="about-note">
							El horario completo varía por temporada (hay horario de invierno propio): no lo inventamos.
							Confirma el día y las reservas en su Instagram @laterrazadejuanavejer o en su ficha de Maps.
						</p>
						<div class="about-links">
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">Instagram @laterrazadejuanavejer <span aria-hidden="true">↗</span></a>
							<a class="simple-link" href={facebookUrl} target="_blank" rel="noreferrer">Facebook <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Comidas<br /><em>y copas.</em></h2>
					</div>
					<p>
						Líneas generales según su propia casa. Confirma la oferta del día
						en el restaurante.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>La terraza<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias de la casa.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Pago Santa Lucía s/n</p>
					<h2>Ven a Santa Lucía<br /><em>a disfrutar.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<p class="hours-note">Apertura desde las 13:00 según Instagram. Horario completo de temporada sin fuente verificable: confirma antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={instagramUrl} target="_blank" rel="noreferrer">Preguntar en Instagram ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de La Terraza de Juana en Santa Lucía, Vejer" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Terraza de Juana · Vejer</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">TJ</span>
				<p>Terraza de Juana<small>{business.street} · {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
			</nav>
			<small>© {new Date().getFullYear()} Terraza de Juana · Vejer de la Frontera. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/la-terraza-de-juana/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/la-terraza-de-juana/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/la-terraza-de-juana/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

	</body>
</html>
