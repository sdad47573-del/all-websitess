---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/restaurante-rincon-de-la-murada-apaisada-03.jpg';
import foto1 from '../assets/fotos/restaurante-rincon-de-la-murada-apaisada-01.jpg';
import foto2 from '../assets/fotos/restaurante-rincon-de-la-murada-apaisada-04.jpg';
import foto3 from '../assets/fotos/restaurante-rincon-de-la-murada-vertical-02.jpg';
import foto4 from '../assets/fotos/restaurante-rincon-de-la-murada-apaisada-08.jpg';
import foto5 from '../assets/fotos/restaurante-rincon-de-la-murada-vertical-05.jpg';

const business = {
	name: 'Restaurante Rincón De La Murada',
	short: 'Rincón de la Murada',
	street: 'Av. San José Vte, 15',
	city: 'La Murada',
	region: 'Comunidad Valenciana',
	province: 'Alicante',
	postalCode: '03318',
	phone: '+34 671 08 27 76',
	latitude: 38.1749583,
	longitude: -0.9640668,
	site: 'https://www.sur-digital.com/restaurante-rincon-de-la-murada',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+Rinc%C3%B3n+De+La+Murada/@38.1749583,-0.9640668,17z/data=!3m1!4b1!4m6!3m5!1s0xd63973d48fc121d:0x586d56c4e1ac3a97!8m2!3d38.1749583!4d-0.9640668!16s%2Fg%2F11g71ct9tr?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34671082776';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'Cada día',
		title: 'Plato del día',
		text: 'Todos los días hay un plato del día, además de la carta de tapas y raciones amplias de la casa.',
	},
	{
		kicker: 'Los domingos',
		title: 'Paellas',
		text: 'Los domingos, paellas. Es lo que la casa anuncia para el día grande de la semana, junto al plato del día.',
	},
	{
		kicker: 'Cocina española',
		title: 'Pelotas y embutidos',
		text: 'Pelotas, embutidos, ensaladillas, bocadillos, sepia y calamar a la romana: cocina española de pueblo.',
	},
	{
		kicker: 'También americana',
		title: 'Pizzas y hamburguesas',
		text: 'Pizzas, hamburguesas, patatas fritas y sándwiches para quien busca algo distinto a la carta de siempre.',
	},
	{
		kicker: 'En la mesa',
		title: 'Raciones amplias',
		text: 'Tapas y raciones amplias con buen producto y servicio al mejor precio de la zona, según cuenta la propia casa.',
	},
	{
		kicker: 'Para llevar',
		title: 'Encargos por teléfono',
		text: 'Se pueden hacer encargos por teléfono: llama al 671 08 27 76 y pregunta por lo que necesites.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de Restaurante Rincón De La Murada publicada en su ficha de Google Maps' },
	{ src: photos.foto2, alt: 'Imagen del restaurante en La Murada tomada de su galería de Google Maps' },
	{ src: photos.foto3, alt: 'Fotografía del bar restaurante en la avenida San José Vte, 15, La Murada' },
	{ src: photos.foto4, alt: 'Imagen de Restaurante Rincón De La Murada subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Vista del Rincón de la Murada según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está el Rincón de la Murada?',
		a: 'En la avenida San José Vte, 15, 03318 La Murada (Alicante). Coordenadas 38.1749583, -0.9640668.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De lunes a sábado abre de 7:00 a 23:00 y el domingo de 7:00 a 18:00. El martes cierra, según su ficha de Google Maps.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Cocina española y americana: paellas, embutidos, pelotas, ensaladillas, bocadillos, sepia, calamar a la romana, pizzas, hamburguesas, patatas fritas y sándwiches. Hay plato del día y, los domingos, paellas.',
	},
	{
		q: '¿Se puede encargar por teléfono?',
		a: 'Sí. La casa indica en su ficha que se pueden realizar encargos por teléfono llamando al 671 08 27 76.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso, aparcamiento, aseo y asientos adaptados para sillas de ruedas.',
	},
	{
		q: '¿Qué dicen sus clientes?',
		a: 'Tiene 4,4 sobre 5 con 381 reseñas. Los comentarios hablan de un sitio agradable, buenas raciones y muy buenos precios.',
	},
];

const images = [
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'El Rincón de la Murada, bar restaurante de pueblo en La Murada (Alicante): tapas, raciones amplias, plato del día y paellas los domingos. Llama al 671 08 27 76.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: business.short,
	description,
	url: `${business.site}/`,
	telephone: business.phone,
	image: images,
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Americana', 'Tapas'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '07:00',
			closes: '23:00',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '07:00', closes: '18:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.4,
		reviewCount: 381,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1f2418" />
		<meta
			name="description"
			content="El Rincón de la Murada, bar restaurante de pueblo en La Murada (Alicante): tapas, raciones amplias, plato del día y paellas los domingos. Llama al 671 08 27 76."
		/>
		<meta
			name="keywords"
			content="Rincón de la Murada, restaurante La Murada, bar de tapas La Murada, plato del día Alicante, paellas domingo, pizzas y hamburguesas La Murada"
		/>
		<meta name="author" content="Restaurante Rincón De La Murada" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/restaurante-rincon-de-la-murada/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Restaurante Rincón De La Murada | La Murada, Alicante</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="El Rincón de la Murada · Tapas y plato del día" />
		<meta
			property="og:description"
			content="Bar restaurante de pueblo en La Murada (Alicante): tapas, raciones amplias, plato del día y paellas los domingos."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="Restaurante Rincón De La Murada, en La Murada (Alicante)" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="El Rincón de la Murada · Tapas y plato del día" />
		<meta
			name="twitter:description"
			content="Tapas, raciones y paellas los domingos en La Murada (Alicante). Llama al 671 08 27 76."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="La Murada" />
		<meta name="geo.position" content="38.1749583;-0.9640668" />
		<meta name="ICBM" content="38.1749583, -0.9640668" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Rincón de la Murada, inicio">
				<span class="brand-mark" aria-hidden="true">R</span>
				<span class="brand-name">Rincón de la Murada <small>La Murada · Alicante</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">El bar</a>
				<a href="#cocina">La cocina</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>671 08 27 76</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Av. San José Vte, 15 · La Murada</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						El Rincón de la Murada es un bar restaurante de pueblo con tapas y raciones amplias. Cocina
						española, pizzas y hamburguesas, plato del día todos los días y paellas los domingos, con
						encargos por teléfono.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 671 08 27 76</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,4</b> en Google (381 reseñas)</li>
						<li>Raciones amplias</li>
						<li>Plato del día</li>
						<li>Encargos por teléfono</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="webp"
						quality={70}
						alt="Restaurante Rincón De La Murada, bar restaurante en La Murada (Alicante)"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,4</b><span>Google</span></div>
					<div><b>381</b><span>Reseñas</span></div>
					<div><b>6/7</b><span>Días</span></div>
				</div>
				<ul class="services">
					<li>Tapas y raciones</li>
					<li>Plato del día</li>
					<li>Paellas los domingos</li>
					<li>Pizzas y hamburguesas</li>
					<li>Encargos por teléfono</li>
					<li>Local accesible</li>
				</ul>
			</section>

			<section class="about section-pad" id="restaurante">
				<p class="section-label"><span aria-hidden="true"></span> Bar restaurante de pueblo</p>
				<div class="about-grid">
					<h2>Cocina de siempre<br />y algo<br /><em>americano.</em></h2>
					<div class="about-copy">
						<p>
							El Rincón de la Murada está en la avenida San José Vte, 15, en La Murada (Alicante). Es un bar
							restaurante tradicional de pueblo, con tapas y raciones amplias.
						</p>
						<p>
							Su cocina mezcla lo español —paellas, embutidos, pelotas, ensaladillas, bocadillos, sepia o
							calamar a la romana— con pizzas, hamburguesas, patatas fritas y sándwiches. Todos los días hay
							plato del día y los domingos, paellas.
						</p>
						<p class="about-note">
							Abre de lunes a sábado de 7:00 a 23:00 y el domingo de 7:00 a 18:00. El martes cierra. Se pueden
							hacer encargos por teléfono al 671 08 27 76.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="cocina">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De la carta</p>
						<h2>Tapas, paellas<br />y plato <em>del día.</em></h2>
					</div>
					<p>
						La casa lo cuenta en su ficha: producto bueno, servicio al mejor precio de la zona y una carta que
						va de la cocina española de siempre a las pizzas y hamburguesas.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>El Rincón<br /><em>en imágenes.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Restaurante Rincón De La Murada. En la
							ficha encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="webp"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres el
					titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Av. San José Vte, 15</p>
					<h2>Ven a La Murada<br /><em>a comer.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes y miércoles a sábado</th>
								<td>7:00 – 23:00</td>
							</tr>
							<tr>
								<th scope="row">Domingo</th>
								<td>7:00 – 18:00</td>
							</tr>
							<tr>
								<th scope="row">Martes</th>
								<td>Cerrado</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, llama antes de venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar 671 08 27 76</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 671 08 27 76</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Restaurante Rincón De La Murada en la avenida San José Vte, 15, La Murada"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Rincón de la Murada · Alicante
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">R</span>
				<p>Rincón de la Murada<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Restaurante Rincón De La Murada · La Murada, Alicante. Fotografías procedentes de la
				ficha del restaurante en Google Maps.
			</small>

			<p class="footer-credit">
				Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
				<a href="https://sur-digital.vercel.app/" rel="noopener">sur-digital.vercel.app</a>
			</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/restaurante-rincon-de-la-murada/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/restaurante-rincon-de-la-murada/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/restaurante-rincon-de-la-murada/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al bar <span>671 08 27 76</span></a>
	<!-- contacto-rapido -->
<style>
