---
import { SOCIAL_POSTS } from '../data/site';
---

<section id="publicaciones" class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase"
				>Desde la tienda</span
			><h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">
				Frutería Fresco en Instagram
			</h2><div class="fresco-divider mx-auto mt-5 h-px w-32"></div><p
				class="text-base-content/70 mt-6 leading-relaxed"
			>
				Descubre fotos y publicaciones reales de la cuenta oficial: sus productos, novedades y
				sabores de casa.
			</p>
		</div>
		<div class="mt-12 grid gap-5 md:grid-cols-2">
			{
				SOCIAL_POSTS.map((post) => (
					<article class="rounded-box border-base-300 bg-base-200 overflow-hidden border">
						<iframe
							src={post.embedUrl}
							title={post.title}
							class="h-[520px] w-full bg-white"
							loading="lazy"
							allowfullscreen
							referrerpolicy="strict-origin-when-cross-origin"
						/>
						<div class="flex flex-col justify-between gap-4 p-6 sm:flex-row sm:items-center">
							<div>
								<h3 class="font-display text-lg font-bold">{post.title}</h3>
								<p class="text-base-content/65 mt-1 text-sm">{post.description}</p>
							</div>
							<a
								href={post.url}
								target="_blank"
								rel="noopener noreferrer"
								class="btn btn-outline btn-sm shrink-0 gap-2 rounded-full"
							>
								<i class="ri-external-link-line" />
								Instagram
							</a>
						</div>
					</article>
				))
			}
		</div>
		<p class="text-base-content/55 mt-6 text-center text-xs">
			Las imágenes y publicaciones se consultan en el perfil de Instagram de la tienda y pertenecen
			a sus respectivos autores.
		</p>
	</div>
</section>
