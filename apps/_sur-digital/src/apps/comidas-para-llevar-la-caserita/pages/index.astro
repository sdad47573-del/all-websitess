import foto03 from '../assets/fotos/comidas-para-llevar-la-caserita-vertical-03.jpg';
import foto06 from '../assets/fotos/comidas-para-llevar-la-caserita-vertical-06.jpg';
import foto07 from '../assets/fotos/comidas-para-llevar-la-caserita-vertical-07.jpg';
