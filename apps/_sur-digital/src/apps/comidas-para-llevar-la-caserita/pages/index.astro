const fotos = [foto01, foto02, foto03, foto04, foto05, foto06, foto07, foto08, foto09, foto10];

const MAPS_URL =
	'https://www.google.com/maps/place/Comidas+para+llevar+La+Caserita/@37.618669,-0.994427,17z/data=!3m1!4b1!4m6!3m5!1s0xd634380e6d93b03:0xbd9df1851a4021b!8m2!3d37.618669!4d-0.994427!16s%2Fg%2F11fcrfzl1p?authuser=0&hl=es&entry=ttu';
const CREDIT_URL = 'https://sur-digital.vercel.app/';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
