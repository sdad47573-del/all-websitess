---
import { twJoin } from 'tailwind-merge';

const DATA = [
	{
		href: '/bar-panel/dashboard',
		icon: 'ri-restaurant-line',
		label: 'Gestión de Menú',
	},
	{
		href: '/bar-panel/dashboard/categories',
		icon: 'ri-list-check',
		label: 'Categorías',
	},
	// {
	// 	href: '/bar-panel/dashboard/hours',
	// 	icon: 'ri-time-line',
	// 	label: 'Horarios',
	// },
	// {
	// 	href: '/bar-panel/dashboard/offers',
	// 	icon: 'ri-price-tag-3-line',
	// 	label: 'Ofertas Especiales',
	// },
	// {
	// 	href: '/bar-panel/dashboard/stats',
	// 	icon: 'ri-bar-chart-line',
	// 	label: 'Estadísticas',
	// },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-gray-200 bg-white shadow-sm">
	<div
		class="mx-auto flex max-w-7xl flex-col px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
	>
		<div class="mb-3 flex items-center justify-between sm:mb-0">
			<a href="/bar-panel/dashboard" class="flex items-center gap-2">
				<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-teal-500 text-white">
					<i class="ri-store-2-line text-xl"></i>
				</div>
				<span class="text-xl font-bold text-gray-800">RestaurantPanel</span>
			</a>
		</div>

		<nav class="flex items-center gap-1 overflow-x-auto pb-1 sm:pb-0">
			{
				DATA.map((item) => {
					const isActive = currentPath === item.href;
					return (
						<a
							href={item.href}
							class={twJoin(
								'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors',
								isActive
									? 'bg-teal-50 text-teal-700'
									: 'text-gray-600 hover:bg-gray-50 hover:text-gray-900',
							)}
						>
							<i
								class={twJoin(item.icon, 'text-lg', isActive ? 'text-teal-600' : 'text-gray-400')}
							/>
							<span>{item.label}</span>
						</a>
					);
				})
			}
		</nav>
	</div>
</header>
