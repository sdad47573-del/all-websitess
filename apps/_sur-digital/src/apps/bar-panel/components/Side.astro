---
import { twJoin } from 'tailwind-merge';

let DATA = [
	{
		href: '/bar-panel/dashboard',
		icon: 'ri-restaurant-line',
		label: 'Gestión de Menú',
	},
	{
		href: '/bar-panel/dashboard/categories',
		icon: 'ri-list-check',
		label: 'Categorías',
	},
	// {
	// 	href: '/bar-panel/dashboard/hours',
	// 	icon: 'ri-time-line',
	// 	label: 'Horarios',
	// },
	// {
	// 	href: '/bar-panel/dashboard/offers',
	// 	icon: 'ri-price-tag-3-line',
	// 	label: 'Ofertas Especiales',
	// },
	// {
	// 	href: '/bar-panel/dashboard/stats',
	// 	icon: 'ri-bar-chart-line',
	// 	label: 'Estadísticas',
	// },
];

DATA = DATA.map((item) => ({
	...item,
	isActive: Astro.url.pathname === item.href,
}));
---

<aside class="hidden min-h-screen w-64 border-r border-gray-200 bg-white md:block">
	<div class="p-6">
		<h1 class="text-2xl font-bold text-gray-800">RestaurantPanel</h1><p
			class="mt-1 text-sm text-gray-500"
		>
			Panel de Gestión
		</p>
	</div><nav class="space-y-2 px-4">
		{
			DATA.map((item) => (
				<a
					href={item.href}
					class={twJoin(
						'flex w-full cursor-pointer items-center gap-3 rounded-lg px-4 py-3 whitespace-nowrap transition-all',
						item.isActive ? 'bg-teal-500 text-white' : 'text-gray-700 hover:bg-gray-100',
					)}
				>
					<div class="flex h-5 w-5 items-center justify-center">
						<i class={item.icon} />
					</div>
					<span class="text-sm font-medium">{item.label}</span>
				</a>
			))
		}
	</nav>
</aside>
