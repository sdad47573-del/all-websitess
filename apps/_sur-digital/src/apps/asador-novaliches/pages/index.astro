---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/asador-novaliches-apaisada-10.jpg';
import fachada from '../assets/fotos/asador-novaliches-apaisada-01.jpg';
import parrillada from '../assets/fotos/asador-novaliches-apaisada-03.jpg';
import tabla from '../assets/fotos/asador-novaliches-apaisada-04.jpg';
import bandeja from '../assets/fotos/asador-novaliches-apaisada-06.jpg';
import pulpo from '../assets/fotos/asador-novaliches-apaisada-07.jpg';
import pincho from '../assets/fotos/asador-novaliches-vertical-02.jpg';
import almuerzo from '../assets/fotos/asador-novaliches-vertical-08.jpg';
import mariscada from '../assets/fotos/asador-novaliches-vertical-09.jpg';
import carajillo from '../assets/fotos/asador-novaliches-vista-5-05.jpg';

const business = {
	name: 'Asador Novaliches',
	brand: 'Asador Novaliches',
	tagline: 'Parrilla de leña en Novaliches, Jérica',
	street: 'Pob. Novaliches, 4',
	city: 'Novaliches (Jérica)',
	region: 'Comunitat Valenciana',
	postalCode: '12450',
	phone: '660 62 11 28',
	latitude: 39.9133535,
	longitude: -0.5489771,
	rating: 4.4,
	reviewsCount: 1779,
	site: 'https://www.sur-digital.com/asador-novaliches',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd607e91580ae2a1:0x17cdf339f46e9c1f';
const cidDecimal = '1715294463337602079';
const placeId = 'ChIJoeIKWJF-YA0RH5xu9DnzzRc';

const mapsUrl =
	'https://www.google.com/maps/place/Asador+Novaliches/@39.9133535,-0.5489771,17z/data=!3m1!4b1!4m6!3m5!1s0xd607e91580ae2a1:0x17cdf339f46e9c1f!8m2!3d39.9133535!4d-0.5489771!16s%2Fg%2F11cn5pgs_j?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&q=Asador+Novaliches&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34660621128';

const description =
	'Asador y parrilla en Novaliches (Jérica, Castellón): parrilladas de carne, pulpo a la brasa, mariscada y almuerzos. Abre de martes a domingo desde las 8:00.';

const servicios = [
	'Parrilla de leña',
	'Parrilladas de carne',
	'Longaniza y morcilla a la brasa',
	'Panceta y secreto',
	'Pulpo a la brasa',
	'Mariscada',
	'Almuerzos',
	'Huevos fritos con patatas',
	'Raciones generosas',
	'Aparcamiento en la puerta',
	'En Novaliches, Jérica',
	'Alto Palancia',
];

const grupos = [
	{
		title: 'Parrilladas para compartir',
		items: [
			{
				name: 'Parrillada de la casa',
				note: 'longaniza, morcilla, panceta, huevos fritos y patatas en la bandeja',
			},
			{
				name: 'Parrillada de carne',
				note: 'tabla de carnes a la brasa con patatas, pimiento asado y un bol de alioli',
			},
			{
				name: 'Bandeja de embutido a la brasa',
				note: 'chorizo, longaniza y morcilla recién sacados de la parrilla',
			},
		],
	},
	{
		title: 'De la brasa',
		items: [
			{
				name: 'Longaniza y chorizo',
				note: 'a la parrilla, con sal gorda por encima',
			},
			{
				name: 'Morcilla',
				note: 'de las que se abren y se comen con pan',
			},
			{
				name: 'Panceta y secreto',
				note: 'corte grueso, marcado en la brasa',
			},
			{
				name: 'Pincho de pollo y panceta',
				note: 'con patatas y alioli, de los que se piden en el almuerzo',
			},
		],
	},
	{
		title: 'Del mar',
		items: [
			{
				name: 'Pulpo a la brasa',
				note: 'con patatas, pimentón y sal gorda, servido en tabla',
			},
			{
				name: 'Mariscada',
				note: 'bogavante, langostinos, cigalas y almejas en la fuente',
			},
		],
	},
	{
		title: 'Almuerzos y café',
		items: [
			{
				name: 'Almuerzo del asador',
				note: 'huevo frito, patatas, longaniza y un trozo de pan',
			},
			{
				name: 'Carajillo',
				note: 'en vaso, con su espuma, para cerrar la mañana',
			},
		],
	},
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada blanca de Asador Novaliches en la pedanía de Jérica, Castellón',
	},
	{
		src: parrillada,
		alt: 'Parrillada con longaniza, morcilla, huevos fritos y patatas en Asador Novaliches',
	},
	{
		src: tabla,
		alt: 'Tabla de carnes a la brasa con patatas y pimiento asado en Asador Novaliches',
	},
	{
		src: bandeja,
		alt: 'Bandeja de chorizo, longaniza y morcilla a la brasa en Asador Novaliches',
	},
	{
		src: pulpo,
		alt: 'Pulpo a la brasa con patatas y pimentón en Asador Novaliches, Novaliches',
	},
	{
		src: pincho,
		alt: 'Pincho de pollo y panceta a la brasa con patatas y alioli en Asador Novaliches',
	},
	{
		src: almuerzo,
		alt: 'Plato de almuerzo con huevo frito, patatas, longaniza y pan en Asador Novaliches',
	},
	{
		src: mariscada,
		alt: 'Mariscada con bogavante, langostinos, cigalas y almejas en Asador Novaliches',
	},
	{
		src: carajillo,
		alt: 'Carajillo servido en vaso en Asador Novaliches, Novaliches',
	},
];

const faqs = [
	{
		q: '¿Dónde está Asador Novaliches?',
		a: 'En Pob. Novaliches, 4, 12450 Novaliches, pedanía de Jérica, en la comarca del Alto Palancia (Castellón). Desde esta página puedes abrir Google Maps y trazar la ruta con el botón «Cómo llegar».',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Abre de martes a sábado de 8:00 a 24:00, y los domingos de 8:00 a 18:00. Los lunes permanece cerrado. Es el horario de la ficha de Google, así que en festivos conviene confirmarlo por teléfono.',
	},
	{
		q: '¿Qué se pide en un asador así?',
		a: 'La parrillada es lo que más sale: longaniza, morcilla, panceta y huevos fritos con patatas en la bandeja, o una tabla de carnes a la brasa para compartir. También hay pulpo a la brasa y mariscada, y las reseñas destacan lo generosas que son las raciones.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'No hay reserva online ni formulario en esta web: se reserva llamando al 660 62 11 28. Los fines de semana y en las fiestas del pueblo se llena, así que conviene llamar con antelación, sobre todo si vais en grupo.',
	},
	{
		q: '¿Se puede almorzar?',
		a: 'Sí, es una de las cosas que más se repiten en las reseñas: «muy buen sitio donde almorzar». La brasa arranca a primera hora y hay almuerzos con huevo frito, patatas y embutido, además de la carta del asador.',
	},
	{
		q: '¿Hay pescado y marisco?',
		a: 'Sí. Además de las carnes, en sus fotos aparecen el pulpo a la brasa con patatas y pimentón y una mariscada con bogavante, langostinos, cigalas y almejas. La disponibilidad depende de la lonja, así que conviene preguntar al reservar.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['Novaliches Asador', 'Asador Novaliches Jérica', 'Asador de Novaliches'],
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 660 62 11 28',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Parrilla', 'Asador', 'Carnes a la brasa', 'Cocina española'],
	areaServed: [
		{ '@type': 'City', name: 'Jérica' },
		{ '@type': 'AdministrativeArea', name: 'Alto Palancia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: 'Novaliches',
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '08:00',
			closes: '18:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El asador', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Asador Novaliches · Parrilla en Jérica</title>
		<meta name="theme-color" content="#5c1f2b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Asador Novaliches, asador Jérica, parrilla Alto Palancia, comer en Novaliches, parrillada Jérica, pulpo a la brasa Castellón, asador Castellón interior, almuerzo Novaliches, mariscada Alto Palancia, Pob. Novaliches 4"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Asador Novaliches · Parrilla en Jérica"
			ogDescription="Parrilladas de carne, pulpo a la brasa, mariscada y almuerzos en Novaliches (Jérica). De martes a domingo desde las 8:00. 4,4 en Google con 1.779 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Asador de leña con pulpo, morcilla y longaniza en Asador Novaliches, Jérica"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#5c1f2b"
			street={business.street}
			city="Novaliches, Jérica"
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Novaliches, Jérica, Castellón"
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="AN"
			name={business.brand}
			subtitle="Parrilla · Novaliches, Jérica"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Pob. Novaliches, 4 · Jérica"
				title="Carne a la brasa<br />en el Alto Palancia<br /><em>desde las 8:00.</em>"
				lede="Asador Novaliches es la parrilla de Novaliches, pedanía de Jérica, en el Alto Palancia. Abre a las 8:00 para el almuerzo y sigue con las parrilladas: longaniza, morcilla, panceta y huevos fritos con patatas, tablas de carne a la brasa, pulpo y mariscada cuando hay."
				image={heroImage}
				imageAlt="Asador de leña con pulpo, morcilla, longaniza y huevos en Asador Novaliches, Jérica"
				primaryCta={{ label: 'Llamar 660 62 11 28', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4</b> en Google (1.779 reseñas)' },
					{ label: 'Cocina', html: 'Parrilla de leña' },
					{ label: 'Horario', html: 'Desde las 8:00' },
					{ label: 'Cierre', html: 'Lunes, cerrado' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Asador Novaliches" items={servicios} />

			<LocalAbout
				label="Parrilla en Novaliches, Jérica"
				title="La brasa,<br />la bandeja<br /><em>y el pueblo.</em>"
				paragraphs={[
					'Asador Novaliches está en la calle principal de Novaliches, 4, en esta pedanía de Jérica que apenas tiene cinco calles y vive entre la sierra y la vía del tren. La fachada es blanca, con el cartel verde del asador y una barrica en la puerta; dentro, el humo de la leña lo dice todo.',
					'La parrilla es el centro de la casa. Por ella pasan la longaniza, el chorizo, la morcilla, la panceta y el secreto, que salen a la mesa en bandejas y tablas, con patatas, pimientos asados y huevos fritos cuando toca. Las raciones son grandes, de las que se comparten, y el aioli se sirve aparte en su bol.',
					'No solo hay carne: el pulpo a la brasa con pimentón se sirve en tabla y, cuando la lonja acompaña, hay mariscada con bogavante, langostinos y cigalas. Y como el asador abre a las 8:00, también es parada de almuerzo: huevo frito, patatas y embutido con un trozo de pan, y un carajillo para cerrar.',
				]}
				note="La ficha de Google reúne 1.779 opiniones con una nota media de 4,4. Las reseñas hablan de «buen sitio donde almorzar», de raciones generosas y buen ambiente, de una parrillada «espectacular» y de la carne a la brasa y el pulpo «en su punto»."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Todo pasa<br /><em>por la parrilla.</em>"
				description="Selección hecha con lo que aparece en las fotos de la ficha de Google y con los platos que citan los clientes: parrilladas, longaniza, chorizo y morcilla, panceta, secreto, pincho de pollo, pulpo a la brasa, mariscada y almuerzos."
				cta={{ label: 'Reservar por teléfono', href: phoneHref }}
				groups={grupos}
				note="Esta web no publica precios: no hay carta oficial publicada y los importes cambian con el mercado. La parrillada del día, el marisco disponible y el precio se confirman en el asador o por teléfono."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Brasa, bandejas<br /><em>y mesas largas.</em>"
				description="Estas fotografías proceden del perfil de Asador Novaliches en Google Maps: la fachada con el cartel verde, la parrillada con longaniza, morcilla y huevos, la tabla de carnes con pimiento asado, la bandeja de embutido, el pulpo a la brasa, el pincho de pollo y panceta, el plato de almuerzo, la mariscada y el carajillo."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Pob. Novaliches, 4 · 12450 Novaliches"
				title="Nos vemos<br /><em>en el asador.</em>"
				addressLines={[
					business.street,
					`${business.postalCode} Novaliches`,
					'Jérica (Castellón), España',
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: '8:00 – 24:00' },
					{ day: 'Miércoles', value: '8:00 – 24:00' },
					{ day: 'Jueves', value: '8:00 – 24:00' },
					{ day: 'Viernes', value: '8:00 – 24:00' },
					{ day: 'Sábado', value: '8:00 – 24:00' },
					{ day: 'Domingo', value: '8:00 – 18:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google: de martes a sábado, de 8:00 a 24:00; domingos de 8:00 a 18:00 y lunes cerrado. En fiestas del pueblo y temporada alta puede cambiar, así que llama al 660 62 11 28 antes de ir."
				mapTitle="Mapa de Asador Novaliches en Pob. Novaliches, 4, Jérica"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Asador Novaliches · Jérica"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Las reservas se hacen por teléfono, en el 660 62 11 28: no hay reserva online ni formulario en esta web. El asador se llena los fines de semana y en fiestas, así que conviene llamar con antelación. Si vais en grupo o alguien tiene alguna alergia, avisad al reservar."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="AN"
			name={business.name}
			address={`${business.street} · ${business.postalCode} Novaliches (Jérica)`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			creditName="Sur Digital · sur-digital.vercel.app"
			ctaLabel="Llamar a Asador Novaliches"
		/>
	</body>
</html>
