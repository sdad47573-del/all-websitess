---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import tortilla from '../assets/fotos/amazkar-taberna-apaisada-01.jpg';
import tartaEntera from '../assets/fotos/amazkar-taberna-vertical-02.jpg';
import tartaPorcion from '../assets/fotos/amazkar-taberna-apaisada-03.jpg';
import carneSalsa from '../assets/fotos/amazkar-taberna-vertical-04.jpg';
import txipirones from '../assets/fotos/amazkar-taberna-vertical-05.jpg';
import tortillaDorada from '../assets/fotos/amazkar-taberna-apaisada-06.jpg';
import tacos from '../assets/fotos/amazkar-taberna-vertical-07.jpg';
import arrozTinta from '../assets/fotos/amazkar-taberna-vertical-08.jpg';
import arrozHuevo from '../assets/fotos/amazkar-taberna-apaisada-09.jpg';
import platoCombinado from '../assets/fotos/amazkar-taberna-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Amazkar Taberna, taberna de cocina tradicional en Kontzejuerreka Kalea, 2, barrio de Elizalde (20180 Oiartzun, Gipuzkoa). Raciones y platos combinados. De miércoles a domingo desde las 9:30. Tel. 612 55 88 53.';

const galeria = [
	{
		src: tortilla,
		alt: 'Tortilla de patata cuajada en un plato blanco, con una porción ya cortada',
	},
	{
		src: tartaPorcion,
		alt: 'Porción de tarta de queso con la superficie tostada, servida en un plato blanco',
	},
	{
		src: carneSalsa,
		alt: 'Lonchas de carne guisada en salsa marrón con un panecillo al lado',
	},
	{
		src: txipirones,
		alt: 'Txipirones a la plancha con su tinta y un chorro de aceite de oliva',
	},
	{
		src: platoCombinado,
		alt: 'Plato combinado de patatas fritas, huevo y jamón curado en una fuente alargada',
	},
	{
		src: arrozTinta,
		alt: 'Arroz con tinta de calamar en un plato hondo, con una rebanada de pan encima',
	},
	{
		src: arrozHuevo,
		alt: 'Arroz meloso con una yema de huevo y una rebanada de pan tostado',
	},
	{
		src: tacos,
		alt: 'Tres tacos de pollo en salsa con guacamole y nachos en una bandeja negra',
	},
	{
		src: tartaEntera,
		alt: 'Tarta de queso entera recién hecha, sobre la barra de madera de la taberna',
	},
	{
		src: tortillaDorada,
		alt: 'Tortilla recién hecha, dorada por fuera y jugosa por dentro',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#amazkar`,
	name: BUSINESS.name,
	alternateName: ['Amazkar', 'Amazkar Taberna Oiartzun', 'Amazkar Oiartzun'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 612 55 88 53',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Tradicional', 'Vasca', 'Casera'],
	areaServed: [
		{ '@type': 'City', name: 'Oiartzun' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday'],
			opens: '09:30',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '09:30',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '09:30',
			closes: '17:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Se admiten perros', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Relación precio calidad adecuada, la cocinera Ohiana es una crack.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody:
				'Las raciones espectaculares y los platos combinados increibles también.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Trato amable, buen producto y profesionalidad',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Amazkar Taberna · Cocina tradicional en Oiartzun';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#57202e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Karla:wght@400;500;600;700&family=Newsreader:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Amazkar Taberna, taberna Oiartzun, comer en Oiartzun, taberna Elizalde, raciones Oiartzun, platos combinados Oiartzun, cocina tradicional Gipuzkoa, Amazkar Elizalde"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Taberna de cocina tradicional en Kontzejuerreka Kalea, 2 (Elizalde, Oiartzun). Raciones y platos combinados, de miércoles a domingo desde las 9:30. Tel. 612 55 88 53."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tortilla de patata servida en un plato blanco en Amazkar Taberna"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#57202e"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34612558853"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Oiartzun, Gipuzkoa"
			preload={[tortilla]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/amazkar-taberna/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Amazkar"
			subtitle="Taberna · Oiartzun"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Kontzejuerreka Kalea, 2 · Elizalde, Oiartzun"
				title="Cocina tradicional<br /><em>en Oiartzun.</em>"
				lede={`Amazkar Taberna es una taberna de barrio en Kontzejuerreka Kalea, 2, en Elizalde (Oiartzun, Gipuzkoa). Cocina tradicional, raciones y platos combinados en un local sencillo, con la barra de madera y las mesas de siempre. Abre de miércoles a domingo a partir de las 9:30. Se reserva por teléfono, en el ${BUSINESS.phoneDisplay}.`}
				image={tortilla}
				imageAlt="Tortilla de patata cuajada en un plato blanco, con una porción ya cortada"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5</b> en Google · 243 reseñas' },
					{ label: 'Horario', html: '<b>9:30</b> de miércoles a domingo' },
					{ label: 'Cierre', html: '<b>Lunes y martes</b> descansa' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Amazkar Taberna" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una taberna<br /><em>de barrio.</em>"
				paragraphs={[
					'Amazkar Taberna está en Kontzejuerreka Kalea, 2, en el barrio de Elizalde, dentro del término municipal de Oiartzun (Gipuzkoa). Es una taberna de las de siempre: barra de madera, taburetes y mesas corridas.',
					'El propio local se presenta en Google con tres palabras en euskera: «Sukaldaritza tradizionala», cocina tradicional. La ficha lo clasifica como taberna y le da 4,5 sobre 5 con 243 reseñas.',
					'Sus reseñas hablan de raciones «espectaculares» y de platos combinados «increíbles», de una relación precio-calidad adecuada y del trato: «trato amable, buen producto y profesionalidad». Una de ellas cita por su nombre a la cocinera, Ohiana.',
					'Abre de miércoles a domingo desde las 9:30. Los lunes y los martes descansa, y los viernes y sábados alarga hasta la medianoche.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «Relación precio calidad adecuada, la cocinera Ohiana es una crack».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Raciones y<br /><em>platos combinados.</em>"
				description="La ficha de Google no publica carta ni precios, y el local no tiene web propia. Lo que sigue es lo que citan sus reseñas y la descripción con la que se presenta la casa."
				cta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. Llama al 612 55 88 53 para preguntar qué hay hoy y si queda mesa."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La mesa<br /><em>de Amazkar.</em>"
				description="Estas fotografías proceden del perfil de Amazkar Taberna en Google Maps: la tortilla, la tarta de queso, la carne en salsa, los txipirones con su tinta, el arroz y los platos combinados."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en Elizalde.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} Elizalde · ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: miércoles y jueves de 9:30 a 23:00; viernes y sábado de 9:30 a 24:00; domingo de 9:30 a 17:00. Lunes y martes cerrado. Para grupos conviene llamar antes."
				mapTitle="Mapa de Amazkar Taberna en Kontzejuerreka Kalea, 2, Elizalde (Oiartzun, Gipuzkoa)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Amazkar Taberna · Elizalde, Oiartzun"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se atiende por teléfono en el 612 55 88 53. La ficha de Google marca acceso para sillas de ruedas y asientos adaptados, pero no aparcamiento adaptado. También marca que se admiten perros."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} Elizalde, ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/amazkar-taberna/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Amazkar Taberna"
		/>
	</body>
</html>
