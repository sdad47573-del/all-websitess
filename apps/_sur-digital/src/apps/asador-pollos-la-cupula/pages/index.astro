---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import fachada from '../assets/fotos/asador-pollos-la-cupula-apaisada-10.jpg';
import puchero from '../assets/fotos/asador-pollos-la-cupula-apaisada-02.jpg';
import vitrina from '../assets/fotos/asador-pollos-la-cupula-apaisada-03.jpg';
import verduras from '../assets/fotos/asador-pollos-la-cupula-apaisada-04.jpg';
import pollos from '../assets/fotos/asador-pollos-la-cupula-apaisada-07.jpg';
import ensaladas from '../assets/fotos/asador-pollos-la-cupula-vertical-05.jpg';
import pescado from '../assets/fotos/asador-pollos-la-cupula-vertical-06.jpg';
import ensaladilla from '../assets/fotos/asador-pollos-la-cupula-vertical-08.jpg';

import { BUSINESS, FICHA, FAQ, HIGHLIGHTS, HORARIO_NOTA, MAPS, RATING, SERVICIOS } from '../data/site';

const title = 'Asador Pollos La Cúpula · Pollos asados y comida para llevar en Altea';
const description =
	"Asador Pollos La Cúpula, en el carrer d'Alcoi, 9 (03590 Altea, Alicante). Restaurante de comida para llevar con 4,6 sobre 5 en Google. Pedidos por teléfono: 965 84 31 10.";

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-cupula`,
	name: BUSINESS.name,
	alternateName: ['La Cúpula Altea', 'Asador Pollos La Cúpula Altea', 'Pollos La Cúpula'],
	description:
		'Asador de pollos y restaurante de comida para llevar en el carrer d\'Alcoi, 9 (03590 Altea, Alicante).',
	url: `${BUSINESS.siteUrl}/`,
	telephone: '+34965843110',
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Altea' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Alicante' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.png`],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		bestRating: 5,
		worstRating: 1,
	},
	servesCuisine: ['Pollo asado', 'Comida para llevar'],
	hasTakeaway: true,
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La ficha', href: '#ficha' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Horario', href: '#horario' },
	{ label: 'Dónde está', href: '#visitanos' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1c1a17" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600&family=Source+Sans+3:ital,wght@0,300..700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador Pollos La Cúpula Altea, pollos asados Altea, comida para llevar Altea, asador Carrer d'Alcoi, pollo asado Alicante"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollos asados y comida para llevar en el carrer d'Alcoi, 9. Pedidos por teléfono al 965 84 31 10."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Tarjeta de Asador Pollos La Cúpula, en Altea"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1c1a17"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Altea"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[pollos]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Asador Pollos La Cúpula, inicio">
					<span class="brand-mark" aria-hidden="true">{BUSINESS.mark}</span>
					<span class="brand-name">
						Asador Pollos La Cúpula
						<small>Pollos asados · Altea</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-cta" href={BUSINESS.phoneHref}>
					{BUSINESS.phone} <span aria-hidden="true">↗</span>
				</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Altea · Carrer d'Alcoi, 9</p>
						<h1 id="hero-title">Pollos asados y comida para llevar <em>en Altea.</em></h1>
						<p class="hero-lede">
							Asador Pollos La Cúpula está en el carrer d'Alcoi, 9, en Altea. Google lo
							clasifica como restaurante de comida para llevar y le da un 4,6 sobre 5. La
							ficha no publica web ni reservas: se pide por teléfono.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={BUSINESS.phoneHref}>
								Llamar · {BUSINESS.phone}
							</a>
							<a class="button button-ghost" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<dl class="hero-facts">
							<div>
								<dt>Valoración</dt>
								<dd>{RATING.label} en Google</dd>
							</div>
							<div>
								<dt>Categoría</dt>
								<dd>Comida para llevar</dd>
							</div>
							<div>
								<dt>Plus code</dt>
								<dd>{BUSINESS.plusCode}</dd>
							</div>
						</dl>
					</div>

					<figure class="hero-media">
						<div class="hero-photo">
							<Image
								src={pollos}
								alt="Pollos asados dorados en la bandeja del asador de La Cúpula"
								widths={[480, 720, 1024, 1400]}
								sizes="(max-width: 900px) 92vw, 46vw"
								format="webp"
								quality={72}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</div>
						<figcaption>
							<span>Pollos asados de La Cúpula</span>
							<span>Foto de la ficha de Google</span>
						</figcaption>
					</figure>
				</div>
			</section>

			<section class="chips-wrap wrap" aria-label="Lo que publica la ficha de Google">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<div class="about-grid">
					<div class="about-copy">
						<p class="section-label"><span aria-hidden="true"></span> La casa</p>
						<h2 id="about-title">Un asador de pollos <em>en el casco de Altea.</em></h2>
						<p>
							El nombre lo dice entero: Asador Pollos La Cúpula. La ficha de Google lo
							clasifica como restaurante de comida para llevar y lo sitúa en el número 9 del
							carrer d'Alcoi, en Altea (03590, Alicante).
						</p>
						<p>
							De puertas adentro la ficha no cuenta nada más: no publica descripción del
							negocio, ni carta, ni precios, ni página web, ni perfiles sociales. Lo que sí
							da es el teléfono, el 965 84 31 10, y una valoración media de 4,6 sobre 5.
						</p>
						<p>
							Esta página recoge exactamente eso. Ni una carta inventada ni un horario de
							relleno: para saber qué hay hoy, cuánto cuesta o si queda pollo, hay que
							llamar.
						</p>
						<div class="about-links">
							<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha en Google Maps <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href="#ficha">Ver lo que publica la ficha</a>
						</div>
					</div>

					<figure class="about-media">
						<Image
							src={fachada}
							alt="La fachada de Asador Pollos La Cúpula en el carrer d'Alcoi, con el toldo naranja y el rótulo del local"
							widths={[400, 640, 900]}
							sizes="(max-width: 900px) 92vw, 40vw"
							format="webp"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>La fachada, en el carrer d'Alcoi</figcaption>
					</figure>
				</div>

				<ul class="highlights">
					{
						HIGHLIGHTS.map((item) => (
							<li>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section class="menu" id="ficha" aria-labelledby="menu-title">
				<div class="wrap menu-grid">
					<div class="menu-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> La ficha</p>
						<h2 id="menu-title">Lo que Google <em>publica del local.</em></h2>
						<p class="menu-lede">
							Estos son los datos que aparecen en la ficha pública: los únicos que esta web
							puede afirmar sin inventar nada.
						</p>

						<div class="menu-groups">
							<div class="menu-group">
								<h3>Datos publicados</h3>
								<ul>
									{
										FICHA.map((item) => (
											<li>
												<strong>{item.label}</strong>
												<span>{item.value}</span>
											</li>
										))
									}
								</ul>
							</div>
						</div>

						<p class="menu-note">
							Sin carta y sin precios en la web: la ficha no los publica. Para encargar, llama
							al <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>.
						</p>
					</div>

					<figure class="menu-media">
						<Image
							src={ensaladas}
							alt="Dos cuencos de ensalada con tomate, maíz y aceitunas"
							widths={[480, 720, 1000]}
							sizes="(max-width: 900px) 92vw, 45vw"
							format="webp"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>De la vitrina: ensaladas y platos preparados</figcaption>
					</figure>
				</div>
			</section>

			<section class="fotos wrap" id="fotos" aria-labelledby="fotos-title">
				<div class="fotos-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Fotos de la ficha</p>
						<h2 id="fotos-title">El local y lo que sale <em>del asador.</em></h2>
					</div>
					<p>
						Imágenes del perfil público del negocio en Google Maps: la vitrina, el puchero,
						las verduras y el pescado de la casa.
					</p>
				</div>
				<div class="fotos-grid">
					<figure class="foto foto-wide">
						<Image
							src={vitrina}
							alt="La vitrina del asador con los platos preparados y las bebidas"
							widths={[640, 960, 1400]}
							sizes="(max-width: 900px) 92vw, 62vw"
							format="webp"
							quality={70}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>La vitrina del local</figcaption>
					</figure>
					<figure class="foto">
						<Image
							src={puchero}
							alt="Un puchero de cocido con repollo, zanahoria y patata"
							widths={[320, 480, 640]}
							sizes="(max-width: 900px) 92vw, 22vw"
							format="webp"
							quality={68}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>El puchero del día</figcaption>
					</figure>
					<figure class="foto">
						<Image
							src={verduras}
							alt="Berenjenas, tomates, calabacín y cebollas frescas"
							widths={[320, 480, 640]}
							sizes="(max-width: 900px) 92vw, 22vw"
							format="webp"
							quality={68}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Verduras frescas</figcaption>
					</figure>
					<figure class="foto">
						<Image
							src={pescado}
							alt="Bandejas de pescado al horno con verduras"
							widths={[320, 480, 640]}
							sizes="(max-width: 900px) 92vw, 22vw"
							format="webp"
							quality={68}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Pescado al horno</figcaption>
					</figure>
					<figure class="foto">
						<Image
							src={ensaladilla}
							alt="Ensaladilla con tomate, pimiento y huevo"
							widths={[320, 480, 640]}
							sizes="(max-width: 900px) 92vw, 22vw"
							format="webp"
							quality={68}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Ensaladilla de la casa</figcaption>
					</figure>
				</div>
			</section>

			<section class="hours" id="horario" aria-labelledby="hours-title">
				<div class="wrap hours-grid">
					<div class="hours-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> Horario</p>
						<h2 id="hours-title">El horario, <em>en la ficha.</em></h2>
						<p class="hours-lede">
							Google no publica el horario completo de la semana de este local. Lo que marca
							es que el miércoles cierra y que la siguiente apertura es el domingo a las
							9:00.
						</p>
						<p class="hours-note">
							<strong>Antes de ir, compruébalo.</strong> {HORARIO_NOTA}
						</p>
						<a class="hours-link" href={BUSINESS.phoneHref}>
							Llamar al {BUSINESS.phone} <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Dónde está</p>
					<h2 id="visit-title">En el carrer <em>d'Alcoi, 9.</em></h2>
					<p class="address">
						{BUSINESS.street}<br />
						{BUSINESS.postalCode} {BUSINESS.city}<br />
						{BUSINESS.region}
					</p>

					<p class="visit-phone">
						<span>Teléfono</span>
						<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
					</p>

					<p class="hours-note">
						<strong>El teléfono es el que publica la ficha.</strong> No consta página web ni perfil
						social del negocio, así que esta página no enlaza ninguno.
					</p>

					<ul class="visit-list">
						<li>
							<span>Categoría</span>
							{BUSINESS.googleCategory}
						</li>
						<li>
							<span>Valoración</span>
							{RATING.label} sobre 5 en Google
						</li>
						<li>
							<span>Plus code</span>
							{BUSINESS.plusCode}
						</li>
					</ul>

					<div class="visit-links">
						<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
							Ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Asador Pollos La Cúpula en el carrer d'Alcoi, 9, Altea"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Carrer d'Alcoi, 9
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>llamar.</em></h2>
				<div class="faq-list">
					{
						FAQ.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">{BUSINESS.mark}</span>
						<p>
							{BUSINESS.name}
							<small>
								Pollos asados y comida para llevar<br />
								{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}
							</small>
						</p>
					</div>
					<nav aria-label="Enlaces del establecimiento">
						<a href={BUSINESS.phoneHref}>Llamar</a>
						<a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
						<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a href="#horario">Horario</a>
						<a href="/asador-pollos-la-cupula/aviso-legal">Aviso legal</a>
					</nav>
				</div>
				<small class="legal">
					© {new Date().getFullYear()}
					{BUSINESS.name} · Datos de la ficha pública de Google Maps, consultada en noviembre de
					2026. La web no publica carta, precios ni horario completo porque la ficha no los incluye.
				</small>
				<nav class="legal-links" aria-label="Información legal">
					<a href="/asador-pollos-la-cupula/aviso-legal">Aviso legal</a>
					<a href="/asador-pollos-la-cupula/aviso-legal#privacidad">Privacidad</a>
					<a href="/asador-pollos-la-cupula/aviso-legal#cookies">Cookies</a>
				</nav>
				<p class="credit">
					<small>Creado por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small>
				</p>
			</div>
		</footer>
		<style>
			/* El horario no tiene foto: esa sección va a una columna de lectura. */
			.hours-grid {
				display: block;
			}

			.hours-copy {
				max-width: 46rem;
			}

			/* La ficha solo publica un grupo de datos: la rejilla de dos columnas
			   dejaría la lista a media anchura. */
			.menu-groups {
				grid-template-columns: 1fr;
			}
		</style>
		<!-- contacto-rapido -->
		<style>
			.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
			.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
			.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
			.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
			.contact-fabs .fab-call { background: #c2410c; }
			.contact-fabs .fab-wa { background: #25d366; }
			.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
			@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
			@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
			.contact-fabs.is-stacked { bottom: 5.75rem; }
			@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
			@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
		</style>
		<nav class="contact-fabs" aria-label="Contacto rápido">
			<a class="fab-call" href={BUSINESS.phoneHref} aria-label={`Llamar a ${BUSINESS.name}`}>
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path
						fill="currentColor"
