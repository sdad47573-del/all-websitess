---
import { BUSINESS, NAV } from '../data/site';
---

<div class="border-base-300/70 bg-base-100/90 sticky top-0 z-50 border-b backdrop-blur-md">
	<header
		class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
	>
		<a href="/fruteria-la-alacena/#inicio" class="flex items-center gap-3" aria-label={`${BUSINESS.name}, inicio`}
			><span
				class="bg-primary text-primary-content flex size-10 items-center justify-center rounded-xl"
				><i class="ri-leaf-fill text-xl"></i></span
			><span class="leading-tight"
				><span class="font-display block text-lg font-bold">La Alacena</span><span
					class="text-base-content/60 block text-[0.6rem] tracking-[0.18em] uppercase"
					>Teatinos · Málaga</span
				></span
			></a
		>
		<nav class="hidden items-center gap-6 lg:flex" aria-label="Navegación principal">
			{
				NAV.map((item) => (
					<a
						href={`/${item.href}`}
						class="text-base-content/75 hover:text-primary text-sm font-medium"
					>
						{item.label}
					</a>
				))
			}
		</nav>
		<div class="flex items-center gap-2">
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-ghost btn-sm hidden rounded-full sm:inline-flex"
				><i class="ri-map-pin-line"></i>Cómo llegar</a
			><a href={BUSINESS.phoneHref} class="btn btn-primary btn-sm gap-2 rounded-full px-4"
				><i class="ri-phone-line"></i><span class="hidden sm:inline">{BUSINESS.phoneDisplay}</span
				><span class="sm:hidden">Llamar</span></a
			><details class="dropdown dropdown-end lg:hidden">
				<summary class="btn btn-ghost btn-sm list-none" aria-label="Abrir menú"
					><i class="ri-menu-line text-xl"></i></summary
				><ul
					class="menu dropdown-content rounded-box border-base-300 bg-base-100 z-50 mt-2 w-56 border p-2 shadow-xl"
				>
					{
						NAV.map((item) => (
							<li>
								<a href={`/${item.href}`}>{item.label}</a>
							</li>
						))
					}<li><a href="/fruteria-la-alacena/contacto">Contacto</a></li><li><a href="/fruteria-la-alacena/aviso-legal">Aviso legal</a></li>
				</ul>
			</details>
		</div>
	</header>
</div>
