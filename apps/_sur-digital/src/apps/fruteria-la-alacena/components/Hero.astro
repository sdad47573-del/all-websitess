---
import { BUSINESS } from '../data/site';
---

<section id="inicio" class="hero-alacena relative overflow-hidden text-white">
	<div class="alacena-dots absolute inset-0 opacity-60"></div>
	<div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-32">
		<div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
			<div>
				<p
					class="text-secondary inline-flex items-center gap-2 text-xs font-semibold tracking-[0.22em] uppercase"
				>
					<i class="ri-map-pin-line"></i>{BUSINESS.district} · {BUSINESS.city}
				</p>
				<h1
					class="font-display mt-4 text-4xl leading-[1.04] font-extrabold sm:text-5xl lg:text-6xl"
				>
					Frutería<br /><span class="text-secondary">La Alacena</span><br />de Alhaurín
				</h1>
				<p class="font-display mt-4 text-xl font-semibold text-white/90 sm:text-2xl">
					Fruta y verdura fresca para tu hogar
				</p>
				<p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80">
					Una frutería de barrio con productos a granel y compra cercana, en <strong
						class="text-white">Calle Hermes, 2</strong
					>, Teatinos, Málaga.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-secondary btn-lg gap-2 rounded-full"
						><i class="ri-phone-line"></i>Llamar al {BUSINESS.phoneDisplay}</a
					><a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline btn-lg hover:text-primary rounded-full border-white/40 bg-white/5 text-white hover:bg-white"
						><i class="ri-map-pin-line"></i>Cómo llegar</a
					>
				</div>
				<div class="mt-8 flex flex-wrap gap-x-5 gap-y-3 text-sm text-white/70">
					<span><i class="ri-leaf-line text-secondary mr-2"></i>Fruta y verdura</span><span
						><i class="ri-shopping-basket-2-line text-secondary mr-2"></i>A granel</span
					><span><i class="ri-home-heart-line text-secondary mr-2"></i>Pedidos por WhatsApp</span>
				</div>
			</div>
			<div class="relative mx-auto w-full max-w-md">
				<div
					class="produce-art alacena-dots relative flex aspect-square items-center justify-center overflow-hidden rounded-[2rem] border border-white/30 shadow-2xl"
				>
					<div
						class="to-primary/20 absolute inset-0 bg-gradient-to-br from-white/20 via-transparent"
					>
					</div><div class="relative flex items-end gap-3 sm:gap-5" aria-hidden="true">
						<div
							class="bg-accent flex size-28 items-center justify-center rounded-full shadow-xl ring-4 ring-white/30 sm:size-36"
						>
							<i class="ri-leaf-fill text-primary absolute -mt-24 ml-8 rotate-45 text-4xl sm:-mt-32"
							></i>
						</div><div
							class="bg-secondary z-10 -mb-2 flex size-32 items-center justify-center rounded-[45%_45%_48%_48%] shadow-xl ring-4 ring-white/30 sm:size-40"
						>
							<i class="ri-apple-fill text-primary/80 text-6xl sm:text-7xl"></i>
						</div><div
							class="bg-warning -mb-1 flex size-24 items-center justify-center rounded-[55%_45%_55%_45%] shadow-xl ring-4 ring-white/30 sm:size-32"
						>
							<i class="ri-leaf-line text-primary text-4xl sm:text-5xl"></i>
						</div>
					</div><div
						class="bg-primary/90 absolute bottom-5 left-1/2 -translate-x-1/2 rounded-full px-5 py-2 text-xs font-semibold tracking-widest text-white uppercase"
					>
						Cercano · Fresco · Local
					</div>
				</div><p class="mt-4 text-center text-xs text-white/50">
					Ilustración decorativa. <a
						class="text-white/70 underline"
						href={BUSINESS.instagram}
						target="_blank"
						rel="noopener noreferrer">Ver fotos del comercio en Instagram</a
					>.
				</p>
			</div>
		</div>
	</div>
</section>
