---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import bandeja from '../assets/fotos/sushi-rairakku-apaisada-02.jpg';
import tabla from '../assets/fotos/sushi-rairakku-vertical-03.jpg';
import fachada from '../assets/fotos/sushi-rairakku-apaisada-06.jpg';
import pizarra from '../assets/fotos/sushi-rairakku-apaisada-05.jpg';
import bufe from '../assets/fotos/sushi-rairakku-vertical-04.jpg';
import mesa from '../assets/fotos/sushi-rairakku-vertical-07.jpg';
import comedorDia from '../assets/fotos/sushi-rairakku-vertical-01.jpg';
import chapa from '../assets/fotos/sushi-rairakku-vertical-09.jpg';
import comedorNoche from '../assets/fotos/sushi-rairakku-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
} from '../data/site';

const description = BUSINESS.description;

const galeria = [
	{
		src: tabla,
		alt: 'Tabla redonda de madera con nigiri, sashimi, maki y dos temaki en su soporte, en Sushi Rairakku',
	},
	{
		src: fachada,
		alt: 'Fachada de Sushi Rairakku con el rótulo rosa, toldos y farolillos rojos en Algueirão-Mem Martins',
	},
	{
		src: pizarra,
		alt: 'Pizarra negra con el logotipo de Sushi Rairakku y un dibujo de flor de cerezo',
	},
	{
		src: bufe,
		alt: 'Tabla de sushi para compartir junto a una bandeja de salteado chino y patatas fritas',
	},
	{
		src: mesa,
		alt: 'Mesa con soporte de temaki, plato de sashimi y nigiri, gambas a la plancha y tempura',
	},
	{
		src: comedorDia,
		alt: 'Comedor de Sushi Rairakku de día, con lámparas colgantes cálidas y mesas puestas junto al ventanal',
	},
	{
		src: chapa,
		alt: 'Gambas a la plancha con pimiento verde y cebolla sobre la chapa caliente',
	},
	{
		src: comedorNoche,
		alt: 'Comedor por la noche con cortinas, farolillos y una jarra de sangría en primer plano',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.fullName,
	alternateName: ['Sushi Rairakku', 'Sushi Rairakku Algueirão', 'Rairakku Mem Martins'],
	slogan: 'All you can eat à la carte',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 21 155 4222',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Japonesa', 'Sushi', 'Chinesa'],
	areaServed: [
		{ '@type': 'City', name: 'Algueirão-Mem Martins' },
		{ '@type': 'City', name: 'Sintra' },
		{ '@type': 'AdministrativeArea', name: 'Área Metropolitana de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '19:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Sushi Rairakku · Rodízio de sushi en Algueirão-Mem Martins';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"sushi-rairakku-apaisada-02.jpg": bandeja,
	"sushi-rairakku-vertical-03.jpg": tabla,
	"sushi-rairakku-apaisada-06.jpg": fachada,
	"sushi-rairakku-apaisada-05.jpg": pizarra,
	"sushi-rairakku-vertical-04.jpg": bufe,
	"sushi-rairakku-vertical-07.jpg": mesa,
	"sushi-rairakku-vertical-01.jpg": comedorDia,
	"sushi-rairakku-vertical-09.jpg": chapa,
	"sushi-rairakku-vertical-10.jpg": comedorNoche,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f3d3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Sora:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Sushi Rairakku, sushi Algueirão, rodízio sushi Mem Martins, all you can eat sushi Sintra, restaurante japonês Algueirão-Mem Martins, sushi à la carte Sintra, temaki Mem Martins, restaurante chinês Algueirão, Praceta Serra de Baixo"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Sushi Rairakku · Rodízio de sushi en Algueirão-Mem Martins"
			ogDescription="All you can eat à la carte con más de cien variedades de sushi, sashimi, tempura y cocina china. Dos turnos todos los días. 4,4 en Google con 1.427 reseñas. Tel. 21 155 4222."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bandeja de sushi con nigiri de salmón, sashimi y maki en Sushi Rairakku"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#1f3d3a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone="+351211554222"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.municipality}`}
			countryName="Portugal"
			contact={{
				street: BUSINESS.street,
				locality: `${BUSINESS.city}, ${BUSINESS.municipality}`,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				phone: '+351 21 155 4222',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[bandeja]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Japonês e chinês · Sintra"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Sushi Rairakku"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/351211554222?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Algueir%C3%A3o-Mem%20Martins." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Algueirão-Mem Martins"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
