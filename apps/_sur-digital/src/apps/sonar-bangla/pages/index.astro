---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import curryNaan from '../assets/fotos/sonar-bangla-vista-3-03.jpg';
import tikkaChana from '../assets/fotos/sonar-bangla-vertical-02.jpg';
import papadums from '../assets/fotos/sonar-bangla-apaisada-06.jpg';
import samosa from '../assets/fotos/sonar-bangla-vertical-09.jpg';
import haleem from '../assets/fotos/sonar-bangla-vertical-08.jpg';
import cartaFoto from '../assets/fotos/sonar-bangla-vertical-04.jpg';
import comedorRojo from '../assets/fotos/sonar-bangla-apaisada-01.jpg';
import comedorVerde from '../assets/fotos/sonar-bangla-apaisada-10.jpg';
import terrazaNoche from '../assets/fotos/sonar-bangla-vertical-07.jpg';
import fachada from '../assets/fotos/sonar-bangla-apaisada-05.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
} from '../data/site';

const description =
	'Sonar Bangla, restaurante indio y bangladesí en la Rua do Benformoso 262 (1100-084 Lisboa, Mouraria): biryani desde 7,95 €, arroces, pescado con arroz, samosas y chá desi. 4,4 en Google con 758 reseñas. Tel. 920 374 334.';

const galeria = [
	{
		src: curryNaan,
		alt: 'Curri de carne en karahi de metal con cilantro y naan recién hecho en Sonar Bangla, Lisboa',
	},
	{
		src: tikkaChana,
		alt: 'Pollo tikka masala con nata y chana masala de garbanzos en la mesa de Sonar Bangla',
	},
	{
		src: papadums,
		alt: 'Papadums crujientes con tres chutneys (menta, tamarindo y picante) sobre mantel de cuadros',
	},
	{
		src: samosa,
		alt: 'Samosa triangular de masa fina sobre cama de lechuga, servida en Sonar Bangla',
	},
	{
		src: haleem,
		alt: 'Cuenco de haleem de lentejas con cebolla frita y cilantro, con paratha al fondo',
	},
	{
		src: cartaFoto,
		alt: 'Tarjeta de la carta de Sonar Bangla con los precios de biryani, arroces y pescado con arroz',
	},
	{
		src: comedorRojo,
		alt: 'Comedor de Sonar Bangla con paredes rojas, verdes y amarillas y mesas con servilletas azules',
	},
	{
		src: comedorVerde,
		alt: 'Sala amplia de Sonar Bangla con paredes verdes, lámparas de araña y mesas vestidas',
	},
	{
		src: terrazaNoche,
		alt: 'Mesa con mantel de cuadros en la terraza de Sonar Bangla, en una calle empedrada de noche',
	},
	{
		src: fachada,
		alt: 'Fachada con el cartel verde de Ghoroa Restaurante Indiano, imagen del perfil de Sonar Bangla',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['Sonar Bangla Restaurante', 'Sonar Bangla Lisboa'],
	slogan: 'Cocina de Bangladesh y de la India en la Mouraria',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 920 374 334',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Bangladesí', 'India', 'Halal'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Área Metropolitana de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '09:00',
			closes: '23:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	hasMenu: {
		'@type': 'Menu',
		name: 'Carta de Sonar Bangla',
		hasMenuSection: MENU.filter((grupo) => grupo.items.some((item) => item.price)).map(
			(grupo) => ({
				'@type': 'MenuSection',
				name: grupo.title,
				hasMenuItem: grupo.items
					.filter((item) => item.price)
					.map((item) => ({
						'@type': 'MenuItem',
						name: item.name,
						description: item.note,
						offers: {
							'@type': 'Offer',
							price: Number(item.price.replace(',', '.').replace(' €', '')).toFixed(2),
							priceCurrency: 'EUR',
						},
					})),
			}),
		),
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Sonar Bangla · Cocina de Bangladesh en la Mouraria, Lisboa';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"sonar-bangla-apaisada-06.jpg": papadums,
	"sonar-bangla-vista-3-03.jpg": curryNaan,
	"sonar-bangla-vertical-02.jpg": tikkaChana,
	"sonar-bangla-vertical-09.jpg": samosa,
	"sonar-bangla-vertical-08.jpg": haleem,
	"sonar-bangla-vertical-04.jpg": cartaFoto,
	"sonar-bangla-apaisada-01.jpg": comedorRojo,
	"sonar-bangla-apaisada-10.jpg": comedorVerde,
	"sonar-bangla-vertical-07.jpg": terrazaNoche,
	"sonar-bangla-apaisada-05.jpg": fachada,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#12513c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Mulish:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Sonar Bangla Lisboa, restaurante bangladesí Lisboa, restaurante indio Mouraria, biryani Lisboa, Rua do Benformoso, curry Intendente, restaurante halal Lisboa, Sonar Bangla Mouraria"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Sonar Bangla · Cocina de Bangladesh en la Mouraria, Lisboa"
			ogDescription="Biryani desde 7,95 €, arroces, pescado con arroz, samosas y chá desi, todos los días de 9:00 a 23:30. 4,4 en Google con 758 reseñas. Tel. 920 374 334."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Curri de carne con naan en Sonar Bangla, Lisboa"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#12513c"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone="+351920374334"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.regionName}`}
			countryName="Portugal"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				phone: '+351 920 374 334',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[papadums]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Bangladesh e India · Mouraria"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, platos y precios antes de la visita."
			ctaLabel="Llamar a Sonar Bangla"
			creditLabel="Creado por"
			creditName="Sur Digital"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/351920374334?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Lisboa." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Lisboa"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
