---
import { BUSINESS } from '../data/site';

const HOURS = BUSINESS.hours.map((row) => ({
	...row,
	closed: row.hours === 'Cerrado',
}));
---

<section id="contacto" class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
			<div>
				<p class="text-secondary text-xs font-semibold tracking-[0.22em] uppercase">Dónde estamos</p>
				<h2 class="font-display mt-3 text-3xl leading-tight font-bold sm:text-4xl">
					En la calle Circo
				</h2>
				<p class="text-base-content/70 mt-4 leading-relaxed">
					En la calle Circo, nº 2, en Jerez de la Frontera. Llama si quieres reservar mesa o preguntar
					por las tapas del día y el brunch del domingo.
				</p>

				<div class="mt-7 space-y-3">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="border-base-300 hover:border-secondary flex items-start gap-4 rounded-2xl border p-4 transition-colors"
					>
						<span class="bg-secondary/10 text-secondary flex size-10 shrink-0 items-center justify-center rounded-full">
							<i class="ri-map-pin-2-line text-lg"></i>
						</span>
						<span>
							<span class="block text-sm font-bold">Dirección</span>
							<span class="text-base-content/65 block text-sm">{BUSINESS.street}</span>
							<span class="text-base-content/65 block text-sm">{BUSINESS.postalCode} {BUSINESS.city}</span>
						</span>
					</a>

					<a
						href={BUSINESS.phoneHref}
						class="border-base-300 hover:border-secondary flex items-start gap-4 rounded-2xl border p-4 transition-colors"
					>
						<span class="bg-secondary/10 text-secondary flex size-10 shrink-0 items-center justify-center rounded-full">
							<i class="ri-phone-line text-lg"></i>
						</span>
						<span>
							<span class="block text-sm font-bold">Teléfono</span>
							<span class="text-base-content/65 block text-sm">{BUSINESS.phone}</span>
							<span class="text-base-content/45 block text-xs">Llámanos para reservar</span>
						</span>
					</a>

					<div class="border-base-300 flex items-start gap-4 rounded-2xl border p-4">
						<span class="bg-secondary/10 text-secondary flex size-10 shrink-0 items-center justify-center rounded-full">
							<i class="ri-wheelchair-line text-lg"></i>
						</span>
						<span>
							<span class="block text-sm font-bold">Accesibilidad</span>
							<span class="text-base-content/65 block text-sm">
								Acceso, aparcamiento, asientos y aseo adaptados
							</span>
							<span class="text-base-content/45 block text-xs">Según la ficha de Google</span>
						</span>
					</div>
				</div>
			</div>

			<div class="flex flex-col gap-5">
				<div class="border-base-300 bg-base-100 overflow-hidden rounded-2xl border">
					<h3 class="border-base-300 flex items-center gap-2 border-b px-6 py-4 text-sm font-bold">
						<i class="ri-time-line text-secondary text-lg"></i> Horario
					</h3>
					<ul class="divide-base-200 divide-y px-6 py-2">
						{
							HOURS.map((row) => (
								<li
									class={`flex items-center justify-between gap-4 py-2.5 text-sm ${
										row.closed ? 'text-base-content/45' : ''
									}`}
								>
									<span class={row.closed ? '' : 'font-semibold'}>{row.days}</span>
									<span class={row.closed ? 'text-secondary font-semibold' : 'text-base-content/70 text-right'}>
										{row.hours}
									</span>
								</li>
							))
						}
					</ul>
					<p class="text-base-content/45 px-6 pt-2 pb-5 text-xs">{BUSINESS.hoursNote}</p>
				</div>

				<a
					href={BUSINESS.googleMaps}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-primary btn-block gap-2 rounded-full"
				>
					<i class="ri-route-line text-lg"></i> Abrir ruta en Google Maps
				</a>
			</div>
		</div>

		<div class="border-base-300 mt-12 overflow-hidden rounded-2xl border">
			<iframe
				title="Mapa de A Bocados en Jerez de la Frontera"
				src={BUSINESS.googleMapsEmbed}
				width="100%"
				height="380"
				style="border:0"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				allowfullscreen></iframe>
		</div>
	</div>
</section>
