---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import salaJardim from '../assets/fotos/la-villa-apaisada-10.jpg';
import triptico from '../assets/fotos/la-villa-apaisada-03.jpg';
import pizzaMar from '../assets/fotos/la-villa-cuadrada-07.jpg';
import mesaVinho from '../assets/fotos/la-villa-apaisada-09.jpg';
import peixeGrelhado from '../assets/fotos/la-villa-vista-6-06.jpg';
import massaMarisco from '../assets/fotos/la-villa-cuadrada-04.jpg';
import pizzas from '../assets/fotos/la-villa-vista-5-05.jpg';
import noite from '../assets/fotos/la-villa-apaisada-01.jpg';
import brinde from '../assets/fotos/la-villa-vertical-02.jpg';
import beringela from '../assets/fotos/la-villa-vertical-08.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICOS } from '../data/site';

const title = 'La Villa · Restaurante italiano no jardim, em Lisboa';
const description =
	'La Villa, restaurante italiano no Campo dos Mártires da Pátria, em Lisboa. Pizzas no forno de lenha, massas caseiras e esplanada no jardim. Aberto todos os dias.';

const galeria = [
	{
		src: triptico,
		alt: 'Três fotografias da casa: a focaccia com burrata, a esplanada entre as árvores e uma pizza de forno de lenha',
	},
	{
		src: pizzaMar,
		alt: 'Pizza de frutos do mar com mexilhões, amêijoas e camarão sobre toalha de xadrez verde',
	},
	{
		src: mesaVinho,
		alt: 'Mesa do La Villa com pizza, esparguete, peixe grelhado, vinho tinto e toalha de xadrez verde',
	},
	{
		src: peixeGrelhado,
		alt: 'Filete de peixe grelhado com ervas, alho e limão num prato branco',
	},
	{
		src: massaMarisco,
		alt: 'Massa com mexilhões e camarão num prato azul, sobre toalha de xadrez verde',
	},
	{
		src: pizzas,
		alt: 'Duas pizzas de forno de lenha com manjericão sobre toalha de xadrez verde',
	},
	{
		src: salaJardim,
		alt: 'Sala do La Villa com teto de madeira, banco corrido azul e janelas para o jardim',
	},
	{
		src: noite,
		alt: 'Esplanada do La Villa à noite, com o letreiro luminoso e as mesas de xadrez verde',
	},
	{
		src: brinde,
		alt: 'Duas pessoas a brindar à mesa, junto à janela da esplanada',
	},
	{
		src: beringela,
		alt: 'Beringela roxa a crescer na horta, entre folhas verdes',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta do La Villa',
	inLanguage: 'pt-PT',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-villa`,
	name: BUSINESS.name,
	alternateName: ['La Villa Lisboa', 'La Villa Restaurante', 'La Villa Campo dos Mártires'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, MAPS.instagram],
	telephone: '+351 21 050 8171',
	email: BUSINESS.email,
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Dinheiro, Mastercard, cartão de débito',
	priceRange: '€€',
	servesCuisine: ['Cozinha italiana', 'Pizza', 'Massas'],
	acceptsReservations: MAPS.booking,
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Distrito de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '23:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Estacionamento acessível a pessoas em cadeiras de rodas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada acessível a pessoas em cadeiras de rodas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Lugares para pessoas em cadeiras de rodas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'WC acessível a pessoas em cadeiras de rodas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Anel de indução magnética de assistência',
			value: false,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aceita cães',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2b3a2c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Mulish:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Villa Lisboa, restaurante italiano Lisboa, pizza forno de lenha Lisboa, Campo dos Mártires da Pátria, massas caseiras, pizzaria Lisboa, restaurante com esplanada Lisboa, reservar La Villa, La Villa Campo Mártires"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Italiano no Campo dos Mártires da Pátria: pizzas de forno de lenha, massas caseiras e esplanada entre as árvores. Todos os dias, das 12:00 às 23:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Sala do La Villa com janelas para o jardim e mesas de xadrez verde"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2b3a2c"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lisboa"
			locale="pt_PT"
			countryName="Portugal"
			preload={[salaJardim]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/la-villa/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Villa"
			subtitle="Italiano · Campo dos Mártires"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow="Campo dos Mártires da Pátria, 40-41 · Lisboa"
				title="Um italiano <br /><em>dentro do jardim.</em>"
				lede={`O La Villa fica no Campo dos Mártires da Pátria, 40-41, entre as árvores do jardim, com sala envidraçada e esplanada. Pizzas de forno de lenha, massas caseiras e risotos, todos os dias das 12:00 às 23:30. Tem 4,6 sobre 5 no Google com ${BUSINESS.reviewsCount.toLocaleString('pt-PT')} críticas.`}
				image={salaJardim}
				imageAlt="Sala do La Villa com teto de madeira, banco corrido azul e janelas para o jardim"
				primaryCta={{ label: 'Reservar mesa', href: MAPS.booking, external: true }}
				secondaryCta={{ label: 'Ficha e críticas no Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> no Google · 2.919 críticas' },
					{ label: 'Horário', html: '<b>12:00–23:30</b> todos os dias' },
					{ label: 'Mesas', html: '<b>Aceita cães</b> na esplanada' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto do perfil de Google Maps"
				galleryLinkLabel="Ver a galeria"
			/>

			<LocalChips label="O que oferece o La Villa" items={SERVICOS} />

			<LocalAbout
				label="A casa"
				title="Uma villa italiana <br /><em>no Campo dos Mártires.</em>"
				paragraphs={[
					'O La Villa ocupa o lugar de um antigo quiosque no jardim do Campo dos Mártires da Pátria, no centro de Lisboa. A sala é envidraçada, com teto de madeira e um banco corrido azul, e as mesas saem para a esplanada, debaixo das árvores, com toalhas de xadrez verde.',
					'A casa abriu no verão de 2021 e apresenta-se como um italiano de bairro: pizzas de massa caseira no forno de lenha, com mais de vinte combinações, pastas também caseiras, risotos, saladas e entradas para partilhar — da focaccia com burrata ao carpaccio.',
					'A descrição que o próprio espaço assina na ficha de Google fala de «um espaço acolhedor que combina tradição e modernidade à mesa», com ingredientes frescos e pratos que vão da gastronomia portuguesa a propostas internacionais.',
					'A ficha não publica carta nem preços. Os pratos desta página são os que a casa e a imprensa descrevem desde a abertura, e o preço médio é o que a ficha técnica de imprensa indica: entre 10 e 20 euros por pessoa.',
				]}
				note="4,6 sobre 5 com 2.919 críticas no Google. Uma delas: «Excelente restaurante de comida italiana no meio de um jardim»."
				links={[
					{ label: 'Ficha e críticas no Google', href: MAPS.reviews, external: true },
					{ label: 'Reservar na página da casa', href: MAPS.booking, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="A carta"
				title="Pizzas de lenha, <br /><em>massas caseiras.</em>"
				description="A ficha de Google não publica carta nem preços. Estes são os pratos que a casa e a imprensa descrevem desde a abertura de 2021; a carta muda com o mercado."
				cta={{ label: `Ligar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Não há preços publicados na ficha de Google nem na página da casa, por isso esta página não fixa valores. O preço médio indicado é de 10 a 20 euros por pessoa; confirma na sala ou ao telefone."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Dez fotografias <br /><em>da casa.</em>"
				description="As dez fotografias do perfil do La Villa no Google Maps: a sala envidraçada, a esplanada à noite, as pizzas de forno de lenha, as massas, o peixe grelhado e a horta."
				images={galeria}
				cta={{ label: 'Ver tudo no Google Maps', href: MAPS.place }}
				note="Imagens alojadas nesta página e provenientes do perfil do estabelecimento em Google Maps. Se tens os direitos de alguma e queres retirá-la, diz-nos e apagamo-la."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="À mesa, <br /><em>debaixo das árvores.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Lisboa, Portugal']}
				hours={HOURS}
				hoursCaption="Horário"
				hoursNote="Horário publicado na ficha de Google: todos os dias, das 12:00 às 23:30, sem dia de fecho. Convém confirmá-lo antes de ir."
				mapTitle="Mapa do La Villa no Campo dos Mártires da Pátria, 40-41, Lisboa"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Villa · Campo dos Mártires"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Reservar na página da casa', href: MAPS.booking, external: true, variant: 'primary' },
					{ label: 'Como chegar', href: MAPS.directions, external: true },
					{ label: 'Instagram', href: MAPS.instagram, external: true },
				]}
				contactLink={{ label: `Ligar para o ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Reservas pelo telefone, por e-mail para lavillalisboa@gmail.com ou na página de reservas da casa. A esplanada fica no jardim; a sala tem entrada, lugares e WC acessíveis, e a casa aceita cães."
			/>

			<LocalFaq items={FAQ} eyebrow="Perguntas frequentes" title="Antes de <em>vir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Reservar ↗', href: MAPS.booking, external: true },
				{ label: 'Instagram ↗', href: MAPS.instagram, external: true },
				{ label: 'Aviso legal', href: '/la-villa/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Carta elaborada a partir de fontes públicas; confirma horário e preços antes da visita."
			ctaLabel="Ligar ao La Villa"
			navAriaLabel="Ligações do La Villa"
			legalLinks={[
				{ label: 'Aviso legal', href: '/la-villa/aviso-legal' },
				{ label: 'Privacidade', href: '/la-villa/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/la-villa/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	</body>
</html>
