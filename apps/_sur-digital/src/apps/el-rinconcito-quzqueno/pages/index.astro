---
import '../styles/global.css';
import { LocalFooter, LocalSecciones, LocalSeo, LocalTopbar } from '@astro-components';

import fotoCeviche from '../assets/fotos/el-rinconcito-quzqueno-01.jpg';

import { BUSINESS, FAQ, MAPS, RATING } from '../data/site';

const title = 'El Rinconcito Quzqueño · Asador de pollos en Alcobendas';
const description = BUSINESS.description;

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-rinconcito-quzqueno`,
	name: BUSINESS.fullName,
	alternateName: ['El Rinconcito Quzqueño Alcobendas', 'Rinconcito Quzqueño'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34910065266',
	servesCuisine: ['Peruana', 'Pollo asado', 'Comida para llevar'],
	areaServed: [{ '@type': 'City', name: BUSINESS.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId }],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"el-rinconcito-quzqueno-01.jpg": fotoCeviche,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#123c36" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Mulish:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Rinconcito Quzqueño Alcobendas, asador de pollos Alcobendas, comida para llevar Alcobendas, comida a domicilio Alcobendas, restaurante peruano Alcobendas, ceviche Alcobendas, Marquesa Viuda de Aldama"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Asador de pollos y comida para llevar y a domicilio en la calle Marquesa Viuda de Aldama, 44 (Alcobendas). Restaurante peruano con 4,2 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="El Rinconcito Quzqueño, asador de pollos y comida para llevar en Alcobendas"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#123c36"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Alcobendas"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fotoCeviche]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Rinconcito Quzqueño"
			subtitle="Asador de pollos · Alcobendas"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district,
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Ficha en Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal={`Datos y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Valoración publicada: ${RATING.label} sobre 5. Confirma horario y oferta con el establecimiento.`}
			ctaLabel="Llamar a El Rinconcito"
			navAriaLabel="Enlaces de El Rinconcito Quzqueño"
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	</body>
</html>
