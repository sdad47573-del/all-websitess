---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	reviewsUrl,
	structuredData,
} from '../lib/business';

const title = 'Salón de Belleza Nuevo Estilo | Estética en Norte Sierra, Córdoba';
const description =
	'Salón de Belleza Nuevo Estilo, en Av de los Almogávares, 30 (Norte Sierra, Córdoba). Centro de estética. Llama al 957 28 39 67.';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#171714" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/salon-belleza-nuevo-estilo/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Oswald:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.jpg`} />
		<meta property="og:image:alt" content="Salón de Belleza Nuevo Estilo en Córdoba" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.jpg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.placename" content="Córdoba" />
			<meta name="geo.position" content="37.8965843;-4.7752082" />
			<meta name="ICBM" content="37.8965843, -4.7752082" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Nuevo Estilo, inicio">
				<span class="brand-mark" aria-hidden="true">NE<span>✳</span></span>
				<span class="brand-name">NUEVO ESTILO <small>BELLEZA · CÓRDOBA</small></span>
			</a>
			<nav aria-label="Navegación principal"><a href="#salon">El salón</a><a href="#ubicacion">Encuéntranos</a></nav>
			<a class="header-call" href={phoneHref}><span aria-hidden="true">☎</span> {business.phone}</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> BELLEZA · ESTÉTICA · NORTE SIERRA</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-description">Salón de Belleza Nuevo Estilo, en Av de los Almogávares, 30. Centro de estética en Norte Sierra, Córdoba. Llama y pide tu cita.</p>
					<div class="hero-actions"><a class="button button-gold" href={phoneHref}><span aria-hidden="true">☎</span> Llamar ahora</a><a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-address"><span class="address-icon" aria-hidden="true">⌖</span><p>{business.streetAddress}<br /><strong>{business.postalCode} · {business.city}</strong></p></div>
				</div>

				<figure class="hero-image">
					<div class="image-label"><span>NE / 01</span><span>NUEVO ESTILO</span></div>
					<a href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Abrir la ficha de Nuevo Estilo en Google Maps">
						<div style="display:grid;place-items:center;aspect-ratio:4/3;background:#22211d;border:1px solid rgb(217 184 121 / .35);border-radius:8px;padding:2rem;text-align:center;">
							<div><p style="margin:0;font-size:2rem;">✳</p><p style="margin:.5rem 0 0;font-weight:700;letter-spacing:.1em;">NUEVO ESTILO</p><p style="margin:.25rem 0 0;opacity:.65;font-size:.8rem;">Av de los Almogávares, 30 · Córdoba</p><p style="margin:.75rem 0 0;"><span style="display:inline-block;padding:.5rem 1rem;border:1px solid #d9b879;border-radius:999px;font-size:.8rem;">Ver ficha en Google Maps ↗</span></p></div>
						</div>
					</a>
					<figcaption><span>FICHA DE GOOGLE MAPS</span><a href={reviewsUrl} target="_blank" rel="noreferrer">Ver reseñas ↗</a></figcaption>
					<div class="image-seal" aria-hidden="true">NE<br />✳<br /><b>CÓRDOBA</b></div>
				</figure>
				<span class="hero-mark" aria-hidden="true">✳</span>
			</section>

			<section class="barber-section" id="salon" aria-labelledby="barber-title">
				<div class="section-index"><span>01</span> CENTRO DE ESTÉTICA EN CÓRDOBA</div>
				<div class="barber-content">
					<h2 id="barber-title">Tu salón<br /><em>en Córdoba.</em></h2>
					<div class="barber-text"><p>En Nuevo Estilo, en Av de los Almogávares, la belleza empieza con una buena conversación. Acércate al salón de Norte Sierra y descubre un trato cercano y personalizado.</p><div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:12px;"><a href={instagramUrl} target="_blank" rel="noreferrer" class="text-link">Instagram del salón <span aria-hidden="true">↗</span></a><a href={reviewsUrl} target="_blank" rel="noreferrer" class="text-link">Reseñas en Google <span aria-hidden="true">↗</span></a></div></div>
				</div>
				<div class="barber-details"><span>NUEVO ESTILO</span><span>ALMOGÁVARES 30 · CÓRDOBA</span><span>✳</span></div>
			</section>

			<section class="location-section" id="ubicacion" aria-labelledby="location-title">
				<div class="section-index"><span>02</span> CÓMO LLEGAR</div>
				<div class="location-content">
					<div class="location-info"><p class="location-kicker">TE ESPERAMOS EN</p><h2 id="location-title">Almogávares,<br /><em>Norte Sierra.</em></h2>
						<div class="contact-list">
							<div class="contact-item"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div></div>
							<div class="contact-item"><span aria-hidden="true">↗</span><div><small>TELÉFONO</small><a href={phoneHref}>{business.phone}</a></div></div>
							<div class="contact-item"><span aria-hidden="true">◷</span><div><small>HORARIO</small><p>Sin horario publicado en la ficha: llama al {business.phone} antes de salir.</p></div></div>
						</div>
						<a class="button button-gold map-button" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-frame"><div class="map-head"><span><i></i> NUEVO ESTILO</span><a href={mapsUrl} target="_blank" rel="noreferrer">GOOGLE MAPS ↗</a></div><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa del Salón de Belleza Nuevo Estilo en Av de los Almogávares, Córdoba" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div><div class="map-caption"><span class="map-pin" aria-hidden="true">⌖</span><span><strong>Nuevo Estilo</strong><small>{business.streetAddress} · {business.city}</small></span><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar">↗</a></div></div>
				</div>
			</section>
			<Galeria nombre="Salón de Belleza Nuevo Estilo" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer"><a class="brand footer-brand" href="#inicio" aria-label="Volver arriba"><span class="brand-mark">NE<span>✳</span></span><span class="brand-name">NUEVO ESTILO <small>BELLEZA · CÓRDOBA</small></span></a><p>{business.streetAddress}, {business.city}<br /><a href={phoneHref}>{business.phone}</a></p><a class="footer-maps" href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><small>© {new Date().getFullYear()} Nuevo Estilo · Norte Sierra, Córdoba · La ficha de Google no devolvió fotos (16-10-2026)</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small>
			</p>
<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
	<a href="/salon-belleza-nuevo-estilo/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
	<a href="/salon-belleza-nuevo-estilo/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
	<a href="/salon-belleza-nuevo-estilo/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
</nav>
</footer>
		<a class="phone-cta" href={phoneHref}><span aria-hidden="true">☎</span> Llamar al salón <strong>{business.phone}</strong></a>
						<WhatsappFab phone={datos.phoneHref} name={datos.business?.name} />
						</body>
</html>
