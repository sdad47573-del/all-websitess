---
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	emailHref,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	services,
	structuredData,
	whatsappUrl,
} from '../lib/business';

const title = 'Taller Finca la Palma | Chapa, pintura y mecánica en Málaga';
const description =
	'Taller Finca la Palma en Teatinos, Málaga. Servicios de chapa, pintura y mecánica. Estamos en C. Francisco Barbin, 11. Llama al 952 28 55 40 o escríbenos por WhatsApp.';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#173c3b" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/taller-finca-la-palma/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://www.sur-digital.com/taller-finca-la-palma/og.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7212802;-4.4726736" />
		<meta name="ICBM" content="36.7212802, -4.4726736" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Taller Finca la Palma, inicio">
				<span class="brand-mark" aria-hidden="true"><span>FP</span><i></i></span>
				<span class="brand-name">Finca la Palma <small>Taller · Teatinos · Málaga</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#servicios">Servicios</a>
				<a href="#ubicacion">Ubicación</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}><span aria-hidden="true">↗</span> 952 28 55 40</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span> Teatinos · Málaga</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Chapa, pintura y mecánica en Teatinos. Estamos en la calle Francisco Barbin; contacta con el
						taller o consulta cómo llegar.
					</p>
					<div class="hero-actions">
						<a class="button button-leaf" href={phoneHref}><span aria-hidden="true">↗</span> Llamar al taller</a>
						<a class="button button-outline" href={whatsappUrl} target="_blank" rel="noreferrer">
							WhatsApp <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="hero-address">
						<span class="address-icon" aria-hidden="true">⌖</span>
						<span><small>ENCUÉNTRANOS EN</small><strong>{business.streetAddress} · {business.city}</strong></span>
					</div>
				</div>

				<div class="hero-art" aria-hidden="true">
					<div class="art-orbit orbit-one"></div>
					<div class="art-orbit orbit-two"></div>
					<div class="sun-disc"></div>
					<div class="palm palm-back"><span class="trunk"></span><i class="frond frond-a"></i><i class="frond frond-b"></i><i class="frond frond-c"></i><i class="frond frond-d"></i></div>
					<div class="palm palm-front"><span class="trunk"></span><i class="frond frond-a"></i><i class="frond frond-b"></i><i class="frond frond-c"></i><i class="frond frond-d"></i></div>
					<div class="art-caption"><span>CARROCERÍA · PINTURA · MECÁNICA</span><b>FP / 01</b></div>
					<div class="art-stamp">MÁLAGA<br /><strong>ES</strong></div>
				</div>
			</section>

			<section class="identity-strip" aria-label="Datos del taller">
				<div class="identity-mark" aria-hidden="true">FP<span>.</span></div>
				<p><small>ESPECIALIDADES</small><strong>Chapa · Pintura · Mecánica</strong></p>
				<span class="strip-rule" aria-hidden="true"></span>
				<p><small>DIRECCIÓN</small><strong>{business.streetAddress}</strong></p>
				<span class="strip-rule" aria-hidden="true"></span>
				<p><small>LOCALIDAD</small><strong>{business.district} · {business.city}</strong></p>
			</section>

			<section class="services section-pad" id="servicios" aria-labelledby="services-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow dark"><span class="eyebrow-mark" aria-hidden="true"></span> Qué hacemos</p>
						<h2 id="services-title">Cuidamos cada<br /><em>detalle.</em></h2>
					</div>
					<p class="section-intro">Servicios de taller en Teatinos, Málaga. Llámanos para consultar tu caso y pedir información.</p>
				</div>
				<div class="service-grid">
					{services.map((service, index) => (
						<article class:list={['service-card', index === 0 && 'service-feature']}>
							<span class="service-mark" aria-hidden="true">{index === 0 ? '01' : '02'}</span>
							<div><h3>{service.title}</h3><p>{service.detail}</p></div>
							<span class="service-arrow" aria-hidden="true">↗</span>
						</article>
					))}
				</div>
				<a class="service-cta" href={whatsappUrl} target="_blank" rel="noreferrer">Consultar por WhatsApp <span aria-hidden="true">↗</span></a>
			</section>

			<section class="location section-pad" id="ubicacion" aria-labelledby="location-title">
				<div class="location-copy">
					<p class="eyebrow dark"><span class="eyebrow-mark" aria-hidden="true"></span> Estamos en Teatinos</p>
					<h2 id="location-title">Ven a vernos<br /><em>a la Palma.</em></h2>
					<p class="location-lede">Nos encontrarás en la calle Francisco Barbin, en el distrito de Teatinos-Universidad, Málaga.</p>
					<address>
						<span class="address-pin" aria-hidden="true">⌖</span>
						<span><strong>{business.streetAddress}</strong><small>{business.postalCode} {business.city}, España</small></span>
					</address>
					<a class="contact-detail" href={phoneHref}><small>TELÉFONO</small><strong>952 28 55 40</strong></a>
					<a class="contact-detail email-detail" href={emailHref}><small>CORREO</small><strong>{business.email}</strong></a>
					<div class="contact-actions">
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="text-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Google Maps ↗</a>
					</div>
					<div class="social-links">
						<a href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp · 647 00 45 77 ↗</a>
						<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram del taller ↗</a>
					</div>
				</div>
				<div class="map-shell">
					<div class="map-head"><span><i aria-hidden="true"></i> UBICACIÓN DEL TALLER</span><span>TEATINOS · MÁLAGA</span></div>
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
						title="Mapa de Taller Finca la Palma en calle Francisco Barbin, 11, Málaga"
					 src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-tag" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Finca la Palma · Málaga</a>
				</div>
			</section>
			<Galeria nombre="Taller Finca la Palma" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio" aria-label="Taller Finca la Palma, volver al inicio">
				<span class="brand-mark" aria-hidden="true"><span>FP</span><i></i></span>
				<span class="brand-name">Finca la Palma <small>Taller · Teatinos · Málaga</small></span>
			</a>
			<p>{business.streetAddress} · {business.postalCode} {business.city}</p>
			<a class="footer-phone" href={phoneHref}>952 28 55 40 <span aria-hidden="true">↗</span></a>
			<small>© {new Date().getFullYear()} {business.name}. Información de contacto y ubicación.</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
	<a href="/taller-finca-la-palma/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
	<a href="/taller-finca-la-palma/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
	<a href="/taller-finca-la-palma/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
</nav>
</footer>

		<a class="mobile-call" href={phoneHref}><span aria-hidden="true">↗</span> Llamar al taller <strong>952 28 55 40</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/taller-finca-la-palma/aviso-legal">Aviso legal</a>
					<a href="/taller-finca-la-palma/aviso-legal#privacidad">Privacidad</a>
					<a href="/taller-finca-la-palma/aviso-legal#cookies">Cookies</a>
				</nav>
						<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34952285540?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Taller%20Finca%20la%20Palma." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Taller Finca la Palma"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>


