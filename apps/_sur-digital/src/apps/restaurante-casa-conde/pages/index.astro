---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	directionsUrl,
	distintivo,
	faqSchema,
	faqs,
	horarioNota,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Restaurante Casa Conde · Comer en el centro de Jaén';

// La valoración y el número de reseñas se interpolan con `toLocaleString('es-ES')` para que la
// descripción (meta y Open Graph) coincida siempre con lo que se ve en el cuerpo de la página.
const rating = business.rating.toLocaleString('es-ES');
const resenas = business.reviewCount.toLocaleString('es-ES');
const description = `Restaurante en la ${business.streetAddress} de ${business.city}, con ${rating} sobre 5 y ${resenas} reseñas en Google Maps. La ficha no publica horario: llama al ${business.phone}.`;
const keywords =
	'Restaurante Casa Conde, Casa Conde Jaén, restaurante centro Jaén, Millán de Priego Jaén, comer en Jaén, brunch Jaén, Casa Conde teléfono';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas diez fotografías, así que no se inventa una
 * descripción y todos los `alt` avisan solo de dónde salen.
 */
const altFoto =
	'Fotografía publicada en la ficha de Google Maps del Restaurante Casa Conde, en Jaén';
const altOg = 'Fotografía del Restaurante Casa Conde publicada en su ficha de Google Maps';

/**
 * Autor que el manifiesto de la descarga atribuye a las diez fotos: el propio restaurante.
 * Como sí hay a quién citar, cada foto de la galería lleva su pie.
 */
const autorFoto = 'Restaurante Casa Conde';

/**
 * Galería completa: las diez fotografías de la ficha, en el orden en que las sirve Google.
 * Son seis apaisadas y cuatro verticales, así que la galería va en tres columnas con el ancho
 * natural de cada foto.
 */
const galeria = [
	'restaurante-casa-conde-vertical-01.jpg',
	'restaurante-casa-conde-vertical-02.jpg',
	'restaurante-casa-conde-apaisada-03.jpg',
	'restaurante-casa-conde-apaisada-04.jpg',
	'restaurante-casa-conde-apaisada-05.jpg',
	'restaurante-casa-conde-apaisada-06.jpg',
	'restaurante-casa-conde-apaisada-07.jpg',
	'restaurante-casa-conde-vertical-08.jpg',
	'restaurante-casa-conde-apaisada-09.jpg',
	'restaurante-casa-conde-vertical-10.jpg',
];

/**
 * Tres fotos de avance en el collage de la portada (también están en la galería).
 * La apaisada 07 es la única con proporción panorámica, así que ocupa el hueco ancho (16/9) sin
 * recorte y las dos verticales, los dos huecos estrechos (4/5).
 */
const collage = [
	{ name: 'restaurante-casa-conde-apaisada-07.jpg', clase: 'collage-item collage-item-a' },
	{ name: 'restaurante-casa-conde-vertical-01.jpg', clase: 'collage-item collage-item-b' },
	{ name: 'restaurante-casa-conde-vertical-08.jpg', clase: 'collage-item collage-item-c' },
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#2a2126" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-J" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/restaurante-casa-conde/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">
					C
				</span>
				<span class="brand-text">
					Casa Conde
					<small>Millán de Priego · Jaén</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#local">La casa</a>
				<a href="#fotos">Las fotos</a>
				<a href="#donde">Dónde</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Jaén · Calle Millán de Priego</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-lede">
							El Restaurante Casa Conde está en la Calle Millán de Priego, con código
							postal 23004, en Jaén. Google lo clasifica como restaurante, le da {rating}{' '}
							sobre 5 con {resenas} reseñas y le pone el distintivo «{distintivo}». La
							ficha no publica horario, así que para saber si está abierto lo mejor es
							llamar al {business.phone}.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>
								Llamar al {business.phone}
							</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>No publicado en la ficha · llama y pregunta</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{rating} sobre 5 con {resenas} reseñas
								</strong>
							</li>
							<li>
								<small>Distintivo</small>
								<strong>{distintivo}</strong>
							</li>
						</ul>
					</div>

					<div class="hero-collage">
						{collage.map((item, index) => (
							<figure class={item.clase}>
								<Image
									src={foto(item.name)}
									alt={altFoto}
									widths={index === 0 ? [480, 720, 960] : [300, 420, 560]}
									sizes={
										index === 0
											? '(max-width: 1080px) 92vw, 46vw'
											: '(max-width: 1080px) 45vw, 23vw'
									}
									format="webp"
									quality={68}
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : undefined}
									decoding="async"
								/>
							</figure>
						))}
					</div>
				</div>
			</section>

			<div class="band">
				<span>
					{rating} sobre 5 con {resenas} reseñas
				</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>{horarioNota}</span>
				<span>Teléfono {business.phone}</span>
			</div>

			<section class="section" id="local" aria-labelledby="local-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">La casa</p>
						<h2 class="title" id="local-title">
							Cocina de casa
							<br />
							<em>en el centro de Jaén.</em>
						</h2>
						<p>
							Google lo clasifica solo como restaurante y le da {rating} sobre 5 con{' '}
							{resenas} reseñas. Está en la Calle Millán de Priego, con código postal
							23004, y la ficha publica su plus code Q6C5+V3 Jaén. Lleva además el
							distintivo «{distintivo}».
						</p>
						<p>
							La ficha no indica un número de portal para esa calle ni publica una tabla
							de horarios, así que esta web no escribe ninguna de las dos cosas. Para
							saber si el local está abierto hoy, la vía fiable es el teléfono.
						</p>
						<p class="bar-note">
							Esta web se ha preparado solo con lo que publica la ficha, consultada el{' '}
							{site.consultado}: nombre, dirección, teléfono, categoría, valoración,
							distintivo, los servicios de accesibilidad, las tres reseñas que destaca y
							sus propias fotografías. Lo que la ficha no publica —carta, precios, tipo
							de cocina, descripción del local, web propia y horario— no se reproduce
							ni se inventa.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{rating} / 5</strong>
							<span>{resenas} reseñas en Google Maps</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
								Ver todas ↗
							</a>
						</div>
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									<strong>{review.rating} sobre 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section cocina" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						El restaurante <em>por dentro.</em>
					</h2>
					<p class="lead">
						Son las diez fotografías que el Restaurante Casa Conde publica en su ficha de
						Google Maps. La ficha no trae una descripción del contenido de estas fotos, así
						que no se inventa ninguna y los textos alternativos solo avisan de dónde salen.
					</p>
					<div class="cocina-grid">
						{galeria.map((name) => (
							<figure class="cocina-item">
								<Image
									src={foto(name)}
									alt={altFoto}
									widths={[320, 480, 720]}
									sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
									format="webp"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>Foto de {autorFoto}</figcaption>
							</figure>
						))}
					</div>
					<p class="cocina-note">
						La ficha no publica la carta ni los precios, así que esta web no los reproduce.
						Para saber qué hay hoy, lo más rápido es{' '}
						<a href={phoneHref}>llamar al {business.phone}</a> o mirar las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos y reseñas de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="donde" aria-labelledby="donde-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Dónde está</p>
						<h2 class="title" id="donde-title">
							Calle Millán de Priego,
							<br />
							<em>23004 Jaén.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<p class="hours-note">
							<strong>Sin horario publicado.</strong> La ficha de Google Maps de este
							restaurante no publica tabla de horarios: no aparece ningún día con
							horario asignado y Google sigue ofreciendo «Añadir horario» en lugar de
							mostrarlo. Se consultó el {site.consultado} y se repitió la consulta para
							descartar una respuesta incompleta. Como no hay dato que copiar, aquí no
							hay ninguna tabla: lo único honesto es llamar al {business.phone} y
							preguntar.
						</p>
						<ul class="access-list">
							{accesibilidad.map((item) => (
								<li class:list={[{ 'is-no': !item.disponible }]}>{item.label}</li>
							))}
						</ul>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>llamar.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">
						C
					</span>
					<span>
						Casa Conde
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Restaurante Casa Conde · Calle Millán de Priego (23004
					Jaén). Web informativa elaborada con los datos y las fotografías que el local publica
					en su ficha de Google Maps, consultada el {site.consultado}. La ficha no publica
					horario: confírmalo por teléfono antes de salir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/restaurante-casa-conde/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/restaurante-casa-conde/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/restaurante-casa-conde/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a Casa Conde <span>{business.phone}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/restaurante-casa-conde/aviso-legal">Aviso legal</a>
			<a href="/restaurante-casa-conde/aviso-legal#privacidad">Privacidad</a>
			<a href="/restaurante-casa-conde/aviso-legal#cookies">Cookies</a>
		</nav>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
