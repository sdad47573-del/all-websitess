---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import pastelasHorno from '../assets/fotos/la-canela-asador-vertical-01.jpg';
import pastelasAzucar from '../assets/fotos/la-canela-asador-vertical-02.jpg';
import fachada from '../assets/fotos/la-canela-asador-vertical-03.jpg';
import croquetas from '../assets/fotos/la-canela-asador-apaisada-04.jpg';
import vitrina from '../assets/fotos/la-canela-asador-apaisada-05.jpg';
import arroz from '../assets/fotos/la-canela-asador-vertical-06.jpg';
import arrozCanela from '../assets/fotos/la-canela-asador-vertical-07.jpg';
import couscousVerduras from '../assets/fotos/la-canela-asador-vertical-08.jpg';
import couscousPollo from '../assets/fotos/la-canela-asador-apaisada-09.jpg';
import pastelas from '../assets/fotos/la-canela-asador-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'La Canela · Asador y comida casera en Palma-Palmilla';
const description =
	'La Canela, asador y comida casera árabe y andaluza en Av. Jane Bowles, 1, local 14 (Palma-Palmilla, 29011 Málaga). Pollo asado, pastela y couscous, halal y para llevar.';

const galeria = [
	{
		src: vitrina,
		alt: 'La vitrina de La Canela con tarrinas de comida preparada, bandejas de pastela y platos caseros listos para llevar',
	},
	{
		src: pastelas,
		alt: 'Pastelas de pollo espolvoreadas con azúcar glas en una bandeja de aluminio',
	},
	{
		src: couscousPollo,
		alt: 'Tarrina de couscous con pollo, calabacín, zanahoria y cebolla caramelizada',
	},
	{
		src: pastelasHorno,
		alt: 'Una mano con guante sacando del horno una bandeja de pastelas recién hechas',
	},
	{
		src: fachada,
		alt: 'La fachada de La Canela en la avenida Jane Bowles, con el rótulo, la buganvilla y el cartel de halal',
	},
	{
		src: croquetas,
		alt: 'Croquetas caseras doradas en una bandeja de aluminio',
	},
	{
		src: arroz,
		alt: 'Fuente de arroz con verduras y limón, junto a otra de arroz con carne y naranja',
	},
	{
		src: arrozCanela,
		alt: 'Arroz con canela en rama, frutos secos picados y una flor de naranja en el centro',
	},
	{
		src: pastelasAzucar,
		alt: 'Pastelas de pollo con azúcar glas y canela servidas en una bandeja metálica',
	},
	{
		src: couscousVerduras,
		alt: 'Tarrina de calabacín y zanahoria con salsa de cebolla y frutos secos picados',
	},
];

const pasos = [
	{
		title: 'Llama y pregunta',
		text: 'El teléfono de la ficha es el 614 73 96 21. Allí se consulta el pollo del día, las raciones, los precios y la disponibilidad.',
	},
	{
		title: 'Recoge o pide a domicilio',
		text: 'Google la clasifica como comida para llevar y comida a domicilio. Al llamar se confirma la zona de reparto y el tiempo de espera.',
	},
	{
		title: 'Cocina árabe, andaluza y halal',
		text: 'La casa trabaja el asador andaluz y la cocina árabe, con categoría halal en la ficha. Todo se prepara en el local.',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de La Canela',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-canela`,
	name: BUSINESS.name,
	alternateName: ['La Canela Málaga', 'La Canela Asador', 'La Canela comida casera'],
	description:
		'Asador y comida casera árabe y andaluza en la avenida Jane Bowles, 1, local 14 (Palma-Palmilla, 29011 Málaga). Pollo asado, pastela, couscous y platos halal para llevar o a domicilio.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34614739621',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina árabe', 'Cocina andaluza', 'Comida casera', 'Halal'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Tuesday',
			opens: '11:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:00',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Pedir', href: '#pedir' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-canela-asador-vertical-03.jpg": fachada,
	"la-canela-asador-apaisada-05.jpg": vitrina,
	"la-canela-asador-vertical-10.jpg": pastelas,
	"la-canela-asador-apaisada-09.jpg": couscousPollo,
	"la-canela-asador-vertical-01.jpg": pastelasHorno,
	"la-canela-asador-apaisada-04.jpg": croquetas,
	"la-canela-asador-vertical-06.jpg": arroz,
	"la-canela-asador-vertical-07.jpg": arrozCanela,
	"la-canela-asador-vertical-02.jpg": pastelasAzucar,
	"la-canela-asador-vertical-08.jpg": couscousVerduras,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2b190f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Marcellus&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Canela Málaga, asador Málaga, pollo asado Palma-Palmilla, comida casera Málaga, cocina árabe Málaga, restaurante halal Málaga, pastela, couscous, comida a domicilio Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Asador y comida casera árabe y andaluza en Palma-Palmilla. Pollo asado, pastela y couscous, halal, para llevar o a domicilio."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Couscous con pollo y verduras de La Canela, asador y comida casera en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#2b190f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Canela"
			subtitle="Asador y comida casera · Málaga"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma disponibilidad, precios y horario antes de la visita."
			ctaLabel="Llamar a La Canela"
			navAriaLabel="Enlaces de La Canela"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34614739621?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carta%20de%20La%20Canela." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carta de La Canela"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
