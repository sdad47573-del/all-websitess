---
import { Image, getImage } from 'astro:assets';
import fachada from '../assets/fotos/restaurante-isla-cristina-apaisada-01.jpg';
import paellaMarisco from '../assets/fotos/restaurante-isla-cristina-apaisada-02.jpg';
import arrozMarisco from '../assets/fotos/restaurante-isla-cristina-vista-3-03.jpg';
import paellaMixta from '../assets/fotos/restaurante-isla-cristina-apaisada-04.jpg';
import arrozSeco from '../assets/fotos/restaurante-isla-cristina-apaisada-05.jpg';
import mesaCompartida from '../assets/fotos/restaurante-isla-cristina-panoramica-06.jpg';
import pescado from '../assets/fotos/restaurante-isla-cristina-apaisada-07.jpg';
import arrozBanda from '../assets/fotos/restaurante-isla-cristina-vertical-08.jpg';
import arrozFinal from '../assets/fotos/restaurante-isla-cristina-apaisada-09.jpg';
import paellaCasa from '../assets/fotos/restaurante-isla-cristina-apaisada-10.jpg';

const negocio = {
  name: 'Restaurante Isla Cristina',
  address: 'Gran Vía de la Manga, 1',
  locality: 'La Manga',
  postalCode: '30380',
  region: 'Murcia',
  country: 'ES',
  phone: '+34 685 74 64 26',
  latitude: 37.6507607,
  longitude: -0.7184323,
  site: 'https://www.sur-digital.com/restaurante-isla-cristina',
};
// La foto de la ficha va al `og:image`, pero las imágenes con hash del build no
// sirven como URL fija: se genera una variante propia y se usa esa ruta.
const ogImage = await getImage({ src: fachada, width: 1200, format: 'jpeg' });

const mapsUrl = 'https://www.google.com/maps/place/Restaurante+Isla+Cristina/data=!4m7!3m6!1s0xd631863bbeaa8b3:0x25dc3282a6840f6!8m2!3d37.6507607!4d-0.7184323!16s%2Fg%2F11clwfvy5t!19sChIJs6jqu2MYYw0R9kBoKijDXQI?authuser=0&hl=es&g_ep=EgoyMDI2MTAwNi4wIJJjKgBIAVAD&rclk=1';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${negocio.latitude}%2C${negocio.longitude}`;
const phoneHref = 'tel:+34685746426';
const description = 'Restaurante Isla Cristina en Gran Vía de la Manga, 1, La Manga. Cocina mediterránea y casera, arroces y paellas. Consulta disponibilidad y cómo llegar.';
const gallery = [
  { src: paellaMarisco, alt: 'Paella de marisco con gambas, mejillones y limón del Restaurante Isla Cristina' },
  { src: arrozSeco, alt: 'Arroz seco servido en paellera en el Restaurante Isla Cristina' },
  { src: pescado, alt: 'Platos de pescado y acompañamientos servidos en mesa' },
  { src: mesaCompartida, alt: 'Mesa compartida con platos caseros en el Restaurante Isla Cristina' },
  { src: arrozBanda, alt: 'Paella de arroz con marisco y limón del Restaurante Isla Cristina' },
  { src: paellaCasa, alt: 'Arroz a la paella preparado en el Restaurante Isla Cristina' },
  { src: paellaMixta, alt: 'Paella de marisco recién servida en el Restaurante Isla Cristina' },
  { src: arrozFinal, alt: 'Paella de arroz de la casa en el Restaurante Isla Cristina' },
];
const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': `${negocio.site}/#restaurante`,
  name: negocio.name,
  description,
  url: `${negocio.site}/`,
  telephone: negocio.phone,
  servesCuisine: ['Mediterránea', 'Española', 'Arroces'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: negocio.address,
    addressLocality: negocio.locality,
    addressRegion: negocio.region,
    postalCode: negocio.postalCode,
    addressCountry: negocio.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: negocio.latitude, longitude: negocio.longitude },
  hasMap: mapsUrl,
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#123c45" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="geo.region" content="ES-MU" />
    <meta name="geo.placename" content={`${negocio.locality}, ${negocio.region}`} />
    <meta name="geo.position" content={`${negocio.latitude};${negocio.longitude}`} />
    <meta name="ICBM" content={`${negocio.latitude}, ${negocio.longitude}`} />
    <link rel="canonical" href={`${negocio.site}/`} />
    <link rel="icon" type="image/svg+xml" href="/restaurante-isla-cristina/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />
    <title>Restaurante Isla Cristina | Arroces y mediterráneo en La Manga</title>
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={negocio.name} />
    <meta property="og:title" content="Restaurante Isla Cristina · La Manga" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${negocio.site}/`} />
    <meta property="og:image" content={`${negocio.site}${ogImage.src}`} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:alt" content="Fachada del Restaurante Isla Cristina, en la Gran Vía de la Manga" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="topbar">
      <a class="brand" href="#inicio" aria-label="Restaurante Isla Cristina, inicio">
        <span class="brand-mark" aria-hidden="true">IC</span>
        <span>ISLA CRISTINA<small>ARROCES · LA MANGA</small></span>
      </a>
      <nav aria-label="Navegación principal"><a href="#casa">El restaurante</a><a href="#sabores">La cocina</a><a href="#fotos">Fotos</a><a href="#visitanos">Cómo llegar</a></nav>
      <a class="top-call" href={phoneHref}>Llamar <span>685 74 64 26</span></a>
    </header>

    <main id="contenido">
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> La Manga · Costa Cálida</p>
          <h1 id="hero-title" set:html={piezas.portada.titulo} />
          <p class="hero-lede">Arroces, cocina casera y sobremesas sin prisa en Gran Vía de la Manga. Una mesa para compartir los sabores de la costa.</p>
          <div class="hero-actions"><a class="button button-gold" href={phoneHref}>Llamar al restaurante <span>↗</span></a><a class="button button-line" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span>↗</span></a></div>
          <div class="hero-facts"><span>Gran Vía de la Manga, 1</span><i></i><span>Cocina mediterránea y casera</span></div>
        </div>
        <figure class="hero-photo-wrap">
          <Image class="hero-photo" src={fachada} alt="Fachada de Restaurante Isla Cristina en La Manga, con el rótulo del restaurante" widths={[600, 900, 1200, 1600]} sizes="(max-width: 760px) 100vw, 52vw" format="webp" quality={76} loading="eager" fetchpriority="high" decoding="async" />
          <span class="hero-shade" aria-hidden="true"></span>
          <figcaption><span>RESTAURANTE ISLA CRISTINA</span><span>LA MANGA · MURCIA</span></figcaption>
          <span class="hero-stamp" aria-hidden="true">ARROZ<br />Y MAR</span>
        </figure>
      </section>

      <div class="ribbon" aria-label="Especialidades"><span>Arroces al momento</span><b>✳</b><span>Cocina mediterránea</span><b>✳</b><span>Comida casera</span><b>✳</b><span>La Manga</span></div>

      <section class="story section" id="casa">
        <div class="section-kicker"><span>EL RESTAURANTE</span><i></i><span>LA MANGA · MURCIA</span></div>
        <div class="story-grid"><h2>Un lugar para<br />sentarse <em>a gusto.</em></h2><div class="story-copy"><p>Restaurante Isla Cristina está en Gran Vía de la Manga, a un paso del Mediterráneo. Una casa de cocina mediterránea y casera, conocida por sus arroces para compartir.</p><p>Ven a disfrutar de una comida tranquila en familia o con amigos. Para confirmar disponibilidad, horario de cocina o reservar, contacta directamente con el restaurante.</p><a class="under-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver ficha y opiniones en Google Maps ↗</a></div></div>
        <div class="story-signature"><span>COCINA MEDITERRÁNEA</span><span>ARROCES · MAR · SOBREMESA</span></div>
      </section>

      <section class="special section" id="sabores">
        <div class="special-photo"><Image src={arrozMarisco} alt="Paella de marisco con gambas y mejillones servida en paellera" widths={[420, 720, 1000]} sizes="(max-width: 760px) 90vw, 42vw" format="webp" quality={74} loading="lazy" decoding="async" /><span class="special-tag">HECHO PARA<br />COMPARTIR</span></div>
        <div class="special-copy"><p class="eyebrow eyebrow-dark"><span></span> SABORES DE LA COSTA</p><h2>El arroz reúne<br /><em>a todos.</em></h2><p>En la galería de la ficha aparecen paellas de marisco, arroces secos, pescado y platos caseros. La carta puede cambiar: pregunta por el arroz del día, los ingredientes y el tiempo de preparación.</p><ul><li><span>01</span> Paellas y arroces</li><li><span>02</span> Pescado y cocina casera</li><li><span>03</span> Para compartir alrededor de la mesa</li></ul><a class="under-link" href={phoneHref}>Consultar por teléfono ↗</a></div>
      </section>

      <section class="gallery section" id="fotos">
        <div class="gallery-heading"><p class="eyebrow eyebrow-dark"><span></span> FOTOS DE GOOGLE MAPS</p><h2>La mesa, el arroz<br /><em>y la buena compañía.</em></h2><p>Imágenes de la ficha pública de Restaurante Isla Cristina.</p></div>
        <div class="gallery-grid">{gallery.map((photo, index) => <figure class:list={['gallery-item', `gallery-item-${index + 1}`]}><Image src={photo.src} alt={photo.alt} widths={[360, 600, 900]} sizes="(max-width: 680px) 92vw, (max-width: 1050px) 46vw, 30vw" format="webp" quality={70} loading="lazy" decoding="async" /></figure>)}</div>
        <p class="photo-note">Fotografías de la ficha pública del restaurante en Google Maps. Consulta la ficha original para ver más imágenes y reseñas.</p>
      </section>

      <section class="visit section" id="visitanos">
        <div class="visit-copy"><p class="eyebrow"><span></span> EN LA MANGA</p><h2>Tu próxima mesa<br /><em>está aquí.</em></h2><p>Estamos en Gran Vía de la Manga, 1. Abre el mapa para planificar la ruta y llama para consultar disponibilidad y horario.</p><address>Gran Vía de la Manga, 1<br />30380 La Manga · Murcia</address><div class="visit-actions"><a class="button button-gold" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="phone-link" href={phoneHref}>+34 685 74 64 26</a></div></div>
        <div class="map-card"><div class="map-top"><span><i></i> LA MANGA · COSTA CÁLIDA</span><a href={mapsUrl} target="_blank" rel="noopener noreferrer">ABRIR MAPS ↗</a></div><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Restaurante Isla Cristina, Gran Vía de la Manga, Murcia" src={`https://maps.google.com/maps?q=${negocio.latitude}%2C${negocio.longitude}&z=16&hl=es&output=embed`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        	<noscript>
        		<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
        	</noscript>
        </div><a class="map-label" href={directionsUrl} target="_blank" rel="noopener noreferrer"><b>Restaurante Isla Cristina</b><span>Gran Vía de la Manga, 1 · La Manga</span></a></div>
      </section>
    </main>
    <footer class="footer"><a class="brand" href="#inicio"><span class="brand-mark" aria-hidden="true">IC</span><span>ISLA CRISTINA<small>ARROCES · LA MANGA</small></span></a><p>Restaurante Isla Cristina<br />Gran Vía de la Manga, 1 · Murcia</p><nav aria-label="Enlaces"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={phoneHref}>685 74 64 26</a></nav><small>© {new Date().getFullYear()} Restaurante Isla Cristina · La Manga</small>
      <p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
    <nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
    	<a href="/restaurante-isla-cristina/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
    	<a href="/restaurante-isla-cristina/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
    	<a href="/restaurante-isla-cristina/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
    </nav>
    </footer>
    <a class="mobile-call" href={phoneHref}>Llamar al restaurante <strong>685 74 64 26</strong></a>
  <!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34685746426?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Restaurante%20Isla%20Cristina." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Restaurante Isla Cristina"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
<style is:global>
:root{font-family:'DM Sans',sans-serif;color:#18383b;background:#f7f1e5;font-synthesis:none;text-rendering:optimizeLegibility;--sea:#123c45;--sea-deep:#0b2c34;--foam:#f7f1e5;--sand:#eadcc4;--sun:#e6ad69;--coral:#d77655;--ink:#18383b;--muted:#697b77;--display:'DM Serif Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:78px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible{outline:3px solid var(--coral);outline-offset:4px}.skip-link{position:absolute;top:-5rem;left:1rem;z-index:50;padding:.7rem 1rem;background:var(--sun);color:var(--sea-deep)}.skip-link:focus{top:1rem}.topbar{position:relative;z-index:5;display:flex;min-height:76px;align-items:center;justify-content:space-between;gap:24px;padding:0 6vw;background:var(--sea-deep);color:var(--foam)}.brand{display:flex;align-items:center;gap:11px;font-weight:700;letter-spacing:.5px}.brand-mark{display:grid;width:42px;height:42px;place-items:center;border:1px solid rgb(230 173 105 / .7);border-radius:50%;color:var(--sun);font:700 12px var(--display);letter-spacing:0}.brand small{display:block;margin-top:4px;color:rgb(247 241 229 / .58);font-size:7px;font-weight:500;letter-spacing:1.3px}.topbar nav{display:flex;gap:clamp(14px,2.6vw,34px);font-size:10px;color:rgb(247 241 229 / .78)}.topbar nav a:hover,.footer a:hover{color:var(--sun)}.top-call{padding:10px 14px;border:1px solid rgb(247 241 229 / .3);border-radius:99px;font-size:9px;font-weight:600}.top-call span{color:var(--sun)}.hero{display:grid;min-height:620px;grid-template-columns:1fr 1fr;overflow:hidden;background:var(--sea);color:var(--foam)}.hero-copy{align-self:center;padding:66px 5vw 60px 9vw}.eyebrow{display:flex;align-items:center;gap:9px;margin:0 0 19px;color:var(--sun);font-size:8px;font-weight:700;letter-spacing:1.8px}.eyebrow>span{width:6px;height:6px;border-radius:50%;background:var(--coral);box-shadow:0 0 0 4px rgb(215 118 85 / .16)}.hero h1,.story h2,.special h2,.gallery h2,.visit h2{margin:0;font:400 clamp(47px,5.5vw,76px)/1.02 var(--display);letter-spacing:-1.1px}.hero h1 em,.story h2 em,.special h2 em,.gallery h2 em,.visit h2 em{color:var(--sun);font-weight:400}.hero-lede{max-width:480px;margin:22px 0 0;color:rgb(247 241 229 / .78);font-size:13px;line-height:1.9}.hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:25px}.button{display:inline-flex;min-height:45px;align-items:center;justify-content:center;gap:13px;padding:0 17px;border:1px solid transparent;border-radius:3px;font-size:9px;font-weight:700;transition:transform .18s,background .18s}.button:hover{transform:translateY(-2px)}.button-gold{background:var(--sun);color:var(--sea-deep)}.button-gold:hover{background:#f0c17f}.button-line{border-color:rgb(247 241 229 / .4);color:var(--foam)}.button-line:hover{border-color:var(--sun);color:var(--sun)}.hero-facts{display:flex;align-items:center;gap:12px;margin-top:25px;padding-top:16px;border-top:1px solid rgb(247 241 229 / .18);color:rgb(247 241 229 / .66);font-size:8px}.hero-facts i{width:4px;height:4px;border-radius:50%;background:var(--sun)}.hero-photo-wrap{position:relative;min-height:620px;margin:0;overflow:hidden;background:#31534e}.hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 50%}.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgb(9 35 38 / .04) 35%,rgb(9 35 38 / .74) 100%),linear-gradient(90deg,rgb(9 35 38 / .1),transparent 35%)}.hero-photo-wrap figcaption{position:absolute;right:25px;bottom:22px;left:25px;display:flex;justify-content:space-between;gap:12px;padding-top:12px;border-top:1px solid rgb(247 241 229 / .48);color:var(--foam);font-size:7px;font-weight:700;letter-spacing:1.1px}.hero-stamp{position:absolute;top:10%;right:9%;display:grid;width:75px;height:75px;place-content:center;border:1px solid var(--foam);border-radius:50%;color:var(--foam);font-size:8px;font-weight:700;letter-spacing:1px;line-height:1.45;text-align:center;transform: