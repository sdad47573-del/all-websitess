---
import { BUSINESS } from '../data/site';
---

<section id="contacto" class="bg-base-200 scroll-mt-20 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">Visítanos</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">Dónde estamos</h2>
			<div class="astyle-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/70 mt-6">
				{BUSINESS.name} está en {BUSINESS.city}. La dirección exacta aparece en su ficha de Google Maps.
			</p>
		</div>

		<div class="mt-14 grid gap-8 lg:grid-cols-2">
			<div class="space-y-6">
				<div class="etiqueta-astyle border-base-300 bg-base-100 rounded-sm border p-7">
					<h3 class="text-xl font-semibold">Horario y reserva</h3>
					<div class="mt-5 space-y-4 text-sm">
						{
							BUSINESS.hours.map((tramo) => (
								<div class="border-base-300 flex items-baseline justify-between gap-4 border-b pb-3">
									<span class="font-semibold">{tramo.days}</span>
									<span class="text-base-content/70 text-right">{tramo.hours}</span>
								</div>
							))
						}
					</div>
					<p class="text-base-content/55 mt-4 text-xs leading-relaxed">{BUSINESS.hoursNote}</p>
					<div class="mt-6 flex flex-wrap gap-3">
						<a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-primary gap-2 rounded-full"
						>
							<i class="ri-google-fill"></i> Ficha de Google
						</a>
					</div>
				</div>

				<div class="etiqueta-astyle border-base-300 bg-base-100 rounded-sm border p-7">
					<h3 class="text-xl font-semibold">Cómo llegar</h3>
					<p class="text-base-content/70 mt-4 text-sm leading-relaxed">
						{BUSINESS.district}, {BUSINESS.region}. Ubicación en Google Maps.
					</p>
					<div class="mt-6 flex flex-wrap gap-3">
						<a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline gap-2 rounded-full"
						>
							<i class="ri-map-pin-line"></i> Cómo llegar
						</a>
					</div>
				</div>
			</div>

			<div class="etiqueta-astyle border-base-300 bg-base-100 overflow-hidden rounded-sm border">
				<iframe
					title="Mapa de Café Bar El Patio en Google Maps"
					src={BUSINESS.googleMapsEmbed}
					class="h-full min-h-[420px] w-full border-0"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
			</div>
		</div>
	</div>
</section>
