---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import polloFrito from '../assets/fotos/asador-3-delicias-apaisada-03.jpg';
import polloAsado from '../assets/fotos/asador-3-delicias-cuadrada-01.jpg';
import racionPollo from '../assets/fotos/asador-3-delicias-vertical-05.jpg';
import arroz from '../assets/fotos/asador-3-delicias-apaisada-07.jpg';
import nachos from '../assets/fotos/asador-3-delicias-apaisada-06.jpg';
import hamburguesa from '../assets/fotos/asador-3-delicias-apaisada-09.jpg';
import polloTiras from '../assets/fotos/asador-3-delicias-apaisada-10.jpg';
import lomo from '../assets/fotos/asador-3-delicias-apaisada-04.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
} from '../data/site';

const title = 'Asador 3 Delicias · Pollo asado y tapas en Sevilla';
const description = BUSINESS.description;

const galeria = [
	{
		src: arroz,
		alt: 'Arroz 3 delicias emplatado con pimiento rojo y perejil, junto a la tarjeta de Asador 3 Delicias con la dirección y el teléfono',
	},
	{
		src: polloAsado,
		alt: 'Pollo asado entero dorado con ensalada, patatas fritas y salsas, sobre fondo de madera',
	},
	{
		src: racionPollo,
		alt: 'Ración de pollo asado con patatas fritas en un plato de rayas azules y blancas',
	},
	{
		src: nachos,
		alt: 'Plato de nachos con queso fundido, guacamole, pico de gallo y nata agria',
	},
	{
		src: hamburguesa,
		alt: 'Hamburguesa con bacon y queso en pan de sésamo, con patatas fritas alrededor',
	},
	{
		src: polloTiras,
		alt: 'Tiras de pollo frito crujiente con patatas fritas y un cuenco de ketchup',
	},
	{
		src: lomo,
		alt: 'Lomo a la plancha con pimientos, arroz blanco, huevo frito y patatas fritas',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#asador-3-delicias`,
	name: BUSINESS.fullName,
	alternateName: ['Asador Tres Delicias', 'Asador 3 Delicias Sevilla', 'Pollo asado López de Gómara'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Asador', 'Pollo frito', 'Tapas', 'Comida para llevar'],
	areaServed: [
		{ '@type': 'City', name: 'Sevilla' },
		{ '@type': 'AdministrativeArea', name: 'López de Gómara' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	hasMenu: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	acceptsReservations: false,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Monday', opens: '12:30', closes: '17:00' },
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday'],
			opens: '12:30',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday'],
			opens: '20:00',
			closes: '23:00',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '12:30', closes: '16:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '20:00', closes: '23:45' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '12:30', closes: '23:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '12:30', closes: '23:00' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"asador-3-delicias-apaisada-03.jpg": polloFrito,
	"asador-3-delicias-apaisada-07.jpg": arroz,
	"asador-3-delicias-cuadrada-01.jpg": polloAsado,
	"asador-3-delicias-vertical-05.jpg": racionPollo,
	"asador-3-delicias-apaisada-06.jpg": nachos,
	"asador-3-delicias-apaisada-09.jpg": hamburguesa,
	"asador-3-delicias-apaisada-10.jpg": polloTiras,
	"asador-3-delicias-apaisada-04.jpg": lomo,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1a1416" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Karla:wght@300..700&family=Marcellus&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Asador 3 Delicias, pollo asado Sevilla, pollo frito crujiente, asador López de Gómara, tapas Sevilla, serranitos, hamburguesas Sevilla, comida para llevar Sevilla"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado, pollo frito crujiente, tapas, serranitos y hamburguesas en López de Gómara 9, Sevilla. De lunes a domingo, martes cerrado. 4,4 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Pollo frito crujiente con patatas fritas de Asador 3 Delicias"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#1a1416"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="López de Gómara, Sevilla"
			preload={[polloFrito]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/asador-3-delicias/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Asador 3 Delicias"
			subtitle="Pollos y tapas · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Asador 3 Delicias"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34640155590?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Sevilla." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Sevilla"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
