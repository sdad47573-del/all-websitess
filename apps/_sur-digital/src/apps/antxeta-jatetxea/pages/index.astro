---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/antxeta-jatetxea-apaisada-01.jpg';
import carne from '../assets/fotos/antxeta-jatetxea-vertical-02.jpg';
import calamares from '../assets/fotos/antxeta-jatetxea-apaisada-03.jpg';
import pimientos from '../assets/fotos/antxeta-jatetxea-apaisada-04.jpg';
import tortilla from '../assets/fotos/antxeta-jatetxea-apaisada-05.jpg';
import platos from '../assets/fotos/antxeta-jatetxea-vertical-06.jpg';
import terraza from '../assets/fotos/antxeta-jatetxea-apaisada-07.jpg';
import chuleton from '../assets/fotos/antxeta-jatetxea-panoramica-08.jpg';
import postre from '../assets/fotos/antxeta-jatetxea-apaisada-09.jpg';
import tartaQueso from '../assets/fotos/antxeta-jatetxea-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Antxeta jatetxea (Antxeta Taberna), en Zubiaurrenea Kalea 6 (20170 Usurbil). Menú del día, raciones, bocatas y platos combinados de comida casera. Terraza. Tel. 943 54 43 12.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada amarilla de Antxeta Taberna en Usurbil, con el rótulo verde y un pájaro dibujado',
	},
	{
		src: carne,
		alt: 'Carne en salsa con patatas chips en un plato de Antxeta jatetxea',
	},
	{
		src: calamares,
		alt: 'Calamares a la plancha con balsámico, tomate y lechuga en un plato de Antxeta',
	},
	{
		src: pimientos,
		alt: 'Pimientos del piquillo rellenos en salsa naranja con perejil picado',
	},
	{ src: tortilla, alt: 'Tortilla jugosa con una rodaja de limón en un plato' },
	{
		src: platos,
		alt: 'Croquetas y calamares, pimientos del piquillo rellenos y calamares a la plancha con balsámico',
	},
	{
		src: terraza,
		alt: 'Terraza de Antxeta Taberna con mesas y clientes delante de la fachada amarilla',
	},
	{
		src: chuleton,
		alt: 'Chuletón a la plancha con patatas fritas y pimientos del piquillo',
	},
	{
		src: postre,
		alt: 'Postre casero con helado de nata y sirope de chocolate',
	},
	{ src: tartaQueso, alt: 'Porción de tarta de queso con mermelada de frutos rojos' },
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#antxeta`,
	name: BUSINESS.name,
	alternateName: ['Antxeta Taberna', 'Antxeta', 'Antxeta Usurbil'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 943 54 43 12',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Vasca', 'Española', 'Casera'],
	areaServed: [
		{ '@type': 'City', name: 'Usurbil' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '08:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '08:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '09:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '09:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Una gran variedad de comida,menú, raciones, bocatas, platos combinados...',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Salimos satisfechos,volveremos',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Si quieres comida casera super rica no dudes en venir!',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Antxeta jatetxea · Comida casera en Usurbil';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#4a6b1f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Antxeta jatetxea, Antxeta Taberna, comer en Usurbil, menú del día Usurbil, raciones Usurbil, bocatas Usurbil, platos combinados Usurbil, comida casera Gipuzkoa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Antxeta jatetxea · Comida casera en Usurbil"
			ogDescription="Menú del día, raciones, bocatas y platos combinados en Antxeta Taberna, Zubiaurrenea Kalea 6 (Usurbil). Terraza. Tel. 943 54 43 12."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada amarilla de Antxeta Taberna en Usurbil"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#4a6b1f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34943544312"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/antxeta-jatetxea/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="ANTXETA JATETXEA"
			subtitle="Comida casera · Usurbil"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Zubiaurrenea Kalea, 6 · Usurbil"
				title="Comida casera<br /><em>en Antxeta Taberna.</em>"
				lede={`Antxeta jatetxea es un restaurante y bar con el rótulo de Antxeta Taberna, en Zubiaurrenea Kalea, 6, de Usurbil (Gipuzkoa). Menú del día, raciones, bocatas y platos combinados, con comida casera y terraza delante de la fachada amarilla. Abre todos los días desde las 8:00. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={fachada}
				imageAlt="Fachada amarilla de Antxeta Taberna en Usurbil, con el rótulo verde y un pájaro dibujado"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)`,
					},
					{ label: 'Cocina', html: 'Casera · menú, raciones y bocatas' },
					{ label: 'Horario', html: 'Todos los días · desde las 8:00' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Antxeta jatetxea" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="La taberna<br /><em>de la esquina.</em>"
				paragraphs={[
					'Antxeta jatetxea está en Zubiaurrenea Kalea, 6, en Usurbil (Gipuzkoa), con el rótulo verde de Antxeta Taberna sobre una fachada amarilla. Google lo clasifica como restaurante y bar, y abre todos los días, de 8:00 a 23:00 de lunes a jueves y hasta las 24:00 los viernes y sábados.',
					'Sus reseñas hablan de una carta amplia: menú del día, raciones, bocatas y platos combinados, además de comida casera. Una de ellas lo resume así: «Una gran variedad de comida, menú, raciones, bocatas, platos combinados…».',
					'En las fotos de su perfil aparecen la carne en salsa con patatas, los calamares a la plancha con balsámico, los pimientos del piquillo rellenos, las croquetas, la tortilla, el chuletón con patatas y piquillos y la tarta de queso con frutos rojos. Delante del bar, las mesas de la terraza ocupan la plaza.',
					'Google le da 4,3 sobre 5 con 232 reseñas. Las publicadas se cierran con un «salimos satisfechos, volveremos» y con la recomendación de venir «si quieres comida casera súper rica».',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «Si quieres comida casera super rica no dudes en venir!».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Menú, raciones<br /><em>y platos combinados.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que citan sus reseñas y lo que aparece en las fotos del perfil. El menú del día cambia cada jornada."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. Llama al 943 54 43 12 para saber el menú de hoy y si queda mesa en la terraza."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La taberna,<br /><em>la mesa y la terraza.</em>"
				description="Estas fotografías proceden del perfil de Antxeta jatetxea en Google Maps: la fachada con el rótulo, la terraza de la plaza, la carne en salsa, los calamares, los piquillos, la tortilla, el chuletón y la tarta de queso."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en la taberna.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: de lunes a jueves de 8:00 a 23:00, viernes de 8:00 a 24:00, sábado de 9:00 a 24:00 y domingo de 9:00 a 23:00. Para grupos conviene llamar antes."
				mapTitle="Mapa de Antxeta jatetxea en Zubiaurrenea Kalea, 6, Usurbil (Gipuzkoa)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Antxeta jatetxea · Usurbil"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 943 54 43 12. Tiene terraza delante de la fachada y la ficha de Google marca acceso para sillas de ruedas, asientos adaptados y aparcamiento adaptado."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/antxeta-jatetxea/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Antxeta jatetxea"
		/>
	</body>
</html>
