---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/meson-restaurante-a-xestosa-apaisada-01.jpg';
import patatas from '../assets/fotos/meson-restaurante-a-xestosa-vertical-02.jpg';
import cochinillos from '../assets/fotos/meson-restaurante-a-xestosa-apaisada-03.jpg';
import valle from '../assets/fotos/meson-restaurante-a-xestosa-apaisada-04.jpg';
import sala from '../assets/fotos/meson-restaurante-a-xestosa-apaisada-05.jpg';
import chuletones from '../assets/fotos/meson-restaurante-a-xestosa-apaisada-06.jpg';
import poza from '../assets/fotos/meson-restaurante-a-xestosa-apaisada-07.jpg';
import queso from '../assets/fotos/meson-restaurante-a-xestosa-vertical-08.jpg';
import chuleton from '../assets/fotos/meson-restaurante-a-xestosa-vertical-09.jpg';
import cochinillo from '../assets/fotos/meson-restaurante-a-xestosa-vista-10-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Mesón Restaurante A Xestosa, en Lugar Cende 17 (36873 Covelo, Pontevedra). Comida casera y carnes frescas a la brasa en el valle de Tielas. Cochinillo y cabrito por encargo. Tel. 659 51 64 96.';

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de piedra de A Xestosa con una mesa larga vestida de cuadros rojos y blancos y sillas de madera tallada',
	},
	{
		src: chuleton,
		alt: 'Chuletón a la brasa en plato de barro con patatas fritas y pimientos de Padrón sobre mantel de cuadros verdes',
	},
	{
		src: cochinillos,
		alt: 'Cuatro cochinillos asados enteros en bandejas de barro con patatas paja y pimientos de Padrón',
	},
	{
		src: sala,
		alt: 'Sala de piedra del mesón con mesas de mantel de cuadros verdes y sillas de madera',
	},
	{
		src: chuletones,
		alt: 'Dos chuletones a la brasa con patatas fritas y ensalada de arroz en un plato blanco',
	},
	{
		src: patatas,
		alt: 'Fuente de patatas fritas con pimientos de Padrón y un chuletón al fondo, con un cuenco de sal',
	},
	{
		src: queso,
		alt: 'Plato de queso frito gratinado sobre un plato azul, con la carta de vinos Cerra Meiga en la mesa',
	},
	{
		src: cochinillo,
		alt: 'Ración de cochinillo asado con patatas fritas y pimientos de Padrón en una bandeja de barro, en una mesa de madera',
	},
	{
		src: poza,
		alt: 'Poza natural de agua transparente con una persona bañándose y el valle de Covelo al fondo',
	},
	{
		src: valle,
		alt: 'Vistas del valle de Covelo desde la aldea, con casas de piedra, prados y montes con molinos al fondo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#a-xestosa`,
	name: BUSINESS.name,
	alternateName: ['A Xestosa', 'Restaurante A Xestosa', 'Mesón A Xestosa', 'A Xestosa Covelo'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 659 51 64 96',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Gallega', 'Brasa', 'Casera'],
	areaServed: [
		{ '@type': 'City', name: 'Covelo' },
		{ '@type': 'AdministrativeArea', name: 'O Condado' },
		{ '@type': 'AdministrativeArea', name: 'Pontevedra' },
		{ '@type': 'AdministrativeArea', name: 'Galicia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:30',
			closes: '23:59',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'A Xestosa · Mesón de brasa en Covelo';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#3f5d3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="A Xestosa, Mesón A Xestosa, comer en Covelo, restaurante Covelo Pontevedra, valle de Tielas, carnes a la brasa Covelo, cochinillo Covelo, santuario da Virxe da Xestosa, merendero Covelo"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="A Xestosa · Mesón de brasa en Covelo"
			ogDescription="Comida casera y carnes frescas a la brasa en el valle de Tielas (Covelo, Pontevedra). Cochinillo, cabrito y arroces por encargo. Tel. 659 51 64 96."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Comedor de piedra de A Xestosa con mesa larga de cuadros rojos"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#3f5d3a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-GA"
			postalCode={BUSINESS.postalCode}
			phone="+34659516496"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/meson-restaurante-a-xestosa/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="A XESTOSA"
			subtitle="Mesón · Covelo"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Lugar Cende, 17 · Covelo"
				title="Comida casera<br /><em>en el valle de Tielas.</em>"
				lede={`A Xestosa es un mesón familiar de Lugar Cende, 17, en Covelo (Pontevedra), en el valle de Tielas. Comida casera, carnes frescas a la brasa, quesos y embutido, con el santuario de la Virgen de la Xestosa y el río con merendero y pozas naturales al lado. Abre todos los días de 9:30 a 24:00, salvo el miércoles. Teléfono: ${BUSINESS.phoneDisplay}.`}
				image={comedor}
				imageAlt="Comedor de piedra de A Xestosa con una mesa larga vestida de cuadros rojos y blancos"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)` },
					{ label: 'Cocina', html: 'Casera · carnes a la brasa' },
					{ label: 'Horario', html: 'Todos los días · 9:30–24:00 · miércoles cerrado' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece A Xestosa" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un mesón<br /><em>de los de siempre.</em>"
				paragraphs={[
					'A Xestosa es un mesón familiar en Lugar Cende, 17, en Covelo (Pontevedra), dentro del valle de Tielas. Google lo clasifica como restaurante gallego y la propia ficha se presenta así: «comidas caseras, carnes frescas a la brasa, buenos quesos, buen embutido, un trato familiar». Abre todos los días de 9:30 a 24:00, salvo el miércoles.',
					'Dentro, el comedor es de piedra, con mesas vestidas de cuadros y sillas de madera tallada; en el otro comedor el mantel es verde. En la mesa, el pan, el vino y los platos de barro: chuletón a la brasa con patatas y pimientos de Padrón, cochinillo asado y queso frito.',
					'Sus reseñas lo resumen bien: «todo muy rico (queso frito y chuletón de vaca) y trato extraordinario», y «buena comida, buen trato y grandes personas, volveremos pronto». Una tercera avisa de los encargos: «hacen encargos de cochinillo, cabrito y arroces, para tomar nota».',
					'A la ficha del negocio pertenece también el entorno: el santuario de la Virgen de la Xestosa y su capilla, el río con merendero y pozas naturales, las rutas de senderismo por la ruta de las estrellas y, según cuenta, el punto más alto de la provincia de Pontevedra. Google le da 4,6 sobre 5 con 292 reseñas.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una de ellas: «${REVIEWS[1]}»`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Brasa, queso<br /><em>y cocina de casa.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que citan sus reseñas, lo que cuenta la propia ficha y lo que aparece en las fotos del perfil."
				cta={{ label: `Encargos y reservas: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. Llama al 659 51 64 96 para encargar cochinillo, cabrito o arroces, o para preguntar por el menú del día."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor,<br /><em>la brasa y el valle.</em>"
				description="Estas fotografías proceden del perfil de A Xestosa en Google Maps: los comedores de piedra, el chuletón, el cochinillo, el queso frito, la poza natural y las vistas del valle de Covelo."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en Cende.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: todos los días de 9:30 a 24:00; miércoles cerrado. Para encargos de cochinillo, cabrito o arroces conviene llamar con antelación."
				mapTitle="Mapa del Mesón Restaurante A Xestosa en Lugar Cende, 17, Covelo (Pontevedra)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="A Xestosa · Covelo"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 659 51 64 96. La ficha de Google marca acceso para sillas de ruedas, aparcamiento adaptado y aseo adaptado."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/meson-restaurante-a-xestosa/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a A Xestosa"
		/>
	</body>
</html>
