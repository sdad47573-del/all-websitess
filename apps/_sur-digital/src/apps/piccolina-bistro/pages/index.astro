---
import '../styles/global.css';

const business = {
	name: 'Piccolina Bistro',
	short: 'Piccolina',
	area: 'Plaza de España · Casco histórico',
	city: 'Vejer de la Frontera',
	postalCode: '11150',
	phone: '+34 671 76 53 39',
	latitude: 36.2539232,
	longitude: -5.9622093,
	site: 'https://www.sur-digital.com/piccolina-bistro',
};

const mapsUrl =
	'https://www.google.com/maps/place/Piccolina+Bistro/@36.2539232,-5.9622093,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c45c8276d166d:0x35fd2fbe6423bfe6!8m2!3d36.2539232!4d-5.9622093!16s%2Fg%2F11b6gdkk69?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34671765339';
const instagramUrl = 'https://www.instagram.com/lapiccolinavejer/';

const specialties = [
	{
		kicker: 'Italiana',
		title: 'Pequeño bistró',
		text: 'Pequeño restaurante donde la comida italiana es la protagonista, junto a la Plaza de España.',
	},
	{
		kicker: 'Con encanto',
		title: 'Rincón vejeriego',
		text: 'Un lugar con encanto en el casco histórico, con terraza para las noches de Vejer.',
	},
	{
		kicker: 'Para cenar',
		title: 'Noche de velas',
		text: 'Citado entre los sitios donde comer en la Noche de Velas... o cualquier día.',
	},
	{
		kicker: 'Terraza',
		title: 'Al aire vejeriego',
		text: 'Terraza en el pueblo para comer o tomar algo sin prisas.',
	},
	{
		kicker: 'Llama',
		title: '671 76 53 39',
		text: 'Reserva por teléfono, sobre todo en fin de semana y temporada.',
	},
	{
		kicker: 'Confirma',
		title: 'Carta y horario',
		text: 'Confirma carta y horario vigente en su Instagram @lapiccolinavejer o en la ficha de Maps.',
	},
];

const gallery = [
	{ src: '/piccolina-bistro/fotos/bistro.svg', alt: 'Ilustración del bistró — sustituye por foto propia' },
	{ src: '/piccolina-bistro/fotos/pasta.svg', alt: 'Ilustración de cocina italiana — sustituye por foto propia' },
	{ src: '/piccolina-bistro/fotos/pizza.svg', alt: 'Ilustración de plato de la casa — sustituye por foto propia' },
	{ src: '/piccolina-bistro/fotos/terraza.svg', alt: 'Ilustración de la terraza — sustituye por foto propia' },
	{ src: '/piccolina-bistro/fotos/plaza.svg', alt: 'Ilustración de la Plaza de España — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Piccolina Bistro?',
		a: 'Junto a la Plaza de España, en el casco histórico de Vejer de la Frontera (11150, Cádiz), según guías locales.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'No hay horario verificado publicado: confirma en el 671 76 53 39 o en su Instagram antes de venir.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'Es un local pequeño: en fin de semana y temporada conviene reservar en el 671 76 53 39.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Bistró de comida italiana en Vejer. Confirma la carta del día en el propio local.',
	},
	{
		q: '¿Cómo llego?',
		a: 'Está en el casco histórico, junto a la Plaza de España. Usa el botón «Cómo llegar» para abrir la ruta en Google Maps.',
	},
];

const description =
	'Piccolina Bistro: pequeño restaurante italiano junto a la Plaza de España, Vejer. Con terraza. Tel. 671 76 53 39.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 671 76 53 39',
	image: [`${business.site}/fotos/bistro.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Italiana', 'Mediterránea'],
	address: {
		'@type': 'PostalAddress',
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [instagramUrl],
	acceptsReservations: 'True',
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="Piccolina Bistro: italiano junto a la Plaza de España, Vejer. Con terraza. 671 76 53 39." />
		<meta name="keywords" content="Piccolina Bistro Vejer, La Piccolina, italiano Vejer, Plaza España comer, terraza Vejer" />
		<meta name="author" content="Piccolina Bistro" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/piccolina-bistro/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>Piccolina Bistro | Italiano en Vejer de la Frontera</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Piccolina Bistro · Italiano en Vejer" />
		<meta property="og:description" content="Pequeño italiano junto a la Plaza de España, con terraza." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/bistro.svg`} />
		<meta property="og:image:alt" content="Piccolina Bistro, Vejer de la Frontera" />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Piccolina Bistro · Italiano en Vejer" />
		<meta name="twitter:description" content="Junto a la Plaza de España, con terraza. 671 76 53 39." />
		<meta name="twitter:image" content={`${business.site}/fotos/bistro.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Vejer de la Frontera" />
		<meta name="geo.position" content="36.2539232;-5.9622093" />
		<meta name="ICBM" content="36.2539232, -5.9622093" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Piccolina Bistro, inicio">
				<span class="brand-mark" aria-hidden="true">PB</span>
				<span class="brand-name">Piccolina Bistro <small>Vejer · Plaza España</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#bistro">El bistró</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>671 76 53 39</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Plaza de España · Vejer</p>
					<h1 id="hero-title">Pequeña Italia<br />en <em>Vejer.</em></h1>
					<p class="hero-lede">
						Piccolina Bistro: pequeño italiano junto a la Plaza de España, con terraza
						en el casco histórico de Vejer de la Frontera.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 671 76 53 39</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>Bistró</b> italiano</li>
						<li>Plaza de España</li>
						<li>Con terraza</li>
						<li>Reserva recomendada</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/piccolina-bistro/fotos/bistro.svg" alt="Ilustración de Piccolina Bistro, Vejer de la Frontera" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Plaza de España · Vejer</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>PB</b><span>Bistró</span></div>
					<div><b>Plaza</b><span>España</span></div>
					<div><b>Vejer</b><span>Casco</span></div>
				</div>
				<ul class="services">
					<li>Italiana</li>
					<li>Terraza</li>
					<li>Bistró</li>
					<li>Casco histórico</li>
					<li>Reservas</li>
					<li>Copas</li>
				</ul>
			</section>

			<section class="about section-pad" id="bistro">
				<p class="section-label"><span aria-hidden="true"></span> El bistró</p>
				<div class="about-grid">
					<h2>Chiquito<br />y <em>encantador.</em></h2>
					<div class="about-copy">
						<p>
							Piccolina Bistro está junto a la Plaza de España, en el casco histórico de Vejer
							(11150, Cádiz), con coordenadas 36.2539232, -5.9622093.
						</p>
						<p>
							Pequeño restaurante de comida italiana con terraza: citado entre los sitios donde comer
							en la Noche de Velas o cualquier día en Vejer.
						</p>
						<p class="about-note">
							No publicamos calle con número ni horario por falta de fuente verificable: confirma en el
							671 76 53 39 o en @lapiccolinavejer antes de venir, y reserva al ser local pequeño.
						</p>
						<div class="about-links">
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">Instagram @lapiccolinavejer <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales de bistró italiano. Confirma la carta del día
						en el propio restaurante.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El bistró<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del bistró.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Plaza de España · Vejer</p>
					<h2>Ven al bistró<br /><em>a cenar.</em></h2>
					<p class="address">
						Junto a la Plaza de España<br />
						{business.postalCode} {business.city}, España
					</p>

					<p class="hours-note">Horario sin fuente verificable. Confirma en el 671 76 53 39 antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al bistró ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 671 76 53 39</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de Piccolina Bistro, Plaza de España, Vejer" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Piccolina · Vejer</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">PB</span>
				<p>Piccolina Bistro<small>Plaza de España · {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Piccolina Bistro · Vejer de la Frontera. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/piccolina-bistro/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/piccolina-bistro/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/piccolina-bistro/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al bistró <span>671 76 53 39</span></a>
	</body>
</html>
