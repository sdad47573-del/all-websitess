---
import { BUSINESS, SERVICIOS, VENTAJAS } from '../data/site';
---

<section id="tratamientos" class="bg-base-200 scroll-mt-20 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">Tratamientos</span
			>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">
				Micropigmentación y estética avanzada
			</h2>
			<div class="lorena-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/70 mt-6 leading-relaxed">
				Micropigmentación, microblading, HIFU y tratamientos faciales. El centro no publica una
				tarifa cerrada: escribe por
				<a
					class="text-primary font-semibold"
					href={BUSINESS.whatsapp}
					target="_blank"
					rel="noopener noreferrer">WhatsApp</a
				>
				o llama al
				<a class="text-primary font-semibold" href={BUSINESS.phoneHref}>{BUSINESS.phoneDisplay}</a>
				para saber el precio del tratamiento que te interesa.
			</p>
		</div>

		<div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{
				SERVICIOS.map((servicio) => (
					<article class="etiqueta-lorena rounded-box border-base-300 bg-base-100 group border p-6 transition-shadow hover:shadow-lg">
						<span class="bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-content flex size-12 items-center justify-center rounded-xl transition-colors">
							<i class={`${servicio.icon} text-2xl`} />
						</span>
						<h3 class="font-display mt-5 text-xl font-bold">{servicio.title}</h3>
						<p class="text-base-content/65 mt-2 text-sm leading-relaxed">{servicio.text}</p>
					</article>
				))
			}
		</div>

		<div class="mt-16">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="font-display text-3xl font-bold sm:text-4xl">Por qué elegir este centro</h2>
				<div class="lorena-divider mx-auto mt-5 h-px w-32"></div>
			</div>
			<div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{
					VENTAJAS.map((ventaja) => (
						<article class="rounded-box border-base-300 bg-base-100 flex h-full gap-4 border p-6">
							<span class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-full">
								<i class={`${ventaja.icon} text-xl`} />
							</span>
							<div>
								<h3 class="font-display text-lg font-bold">{ventaja.title}</h3>
								<p class="text-base-content/65 mt-1 text-sm leading-relaxed">{ventaja.text}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>

		<div
			class="border-base-300 bg-base-100 rounded-box mt-14 grid gap-6 border p-8 lg:grid-cols-[1.4fr_1fr] lg:items-center"
		>
			<div>
				<h3 class="font-display text-2xl font-bold">Cita previa por WhatsApp</h3>
				<p class="text-base-content/70 mt-3 text-sm leading-relaxed">
					Cuéntame qué tratamiento te interesa y te asesoro sin compromiso: te explico en qué
					consiste, cuánto dura y cómo se cuida después. Publico trabajos y resultados en Instagram,
					así puedes ver el estilo antes de decidirte.
				</p>
			</div>
			<div class="flex flex-wrap gap-3 lg:justify-end">
				<a
					href={BUSINESS.whatsapp}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-primary gap-2 rounded-full"
				>
					<i class="ri-whatsapp-line"></i> Escribir por WhatsApp
				</a>
				<a
					href={BUSINESS.instagram}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-outline gap-2 rounded-full"
				>
					<i class="ri-instagram-line"></i> Ver en Instagram
				</a>
			</div>
		</div>
	</div>
	<div class="mx-auto mt-10 text-center">
		<a href="/lorena-molina-estetica/servicios" class="text-primary font-semibold underline"
			>Ver todos los productos y servicios</a
		>
	</div>
</section>
