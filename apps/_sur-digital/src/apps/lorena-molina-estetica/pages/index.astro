---
import Centro from '../components/Centro.astro';
import Contact from '../components/Contact.astro';
import Fab from '../components/Fab.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Highlights from '../components/Highlights.astro';
import Reviews from '../components/Reviews.astro';
import Topbar from '../components/Topbar.astro';
import Tratamientos from '../components/Tratamientos.astro';
import { breadcrumbs } from '../data/schema';
import Layout from '../layouts/Layout.astro';
---

<Layout schema={[breadcrumbs([{ name: 'Inicio', path: '/lorena-molina-estetica/' }])]}>
	<Topbar />
	<main>
		<Hero />
		<Highlights />
		<Centro />
		<Tratamientos />
		<Reviews />
		<Contact />
		<Faq />
	</main>
	<Footer />
	<Fab />
</Layout>
