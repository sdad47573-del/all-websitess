---
import Contact from '../components/Contact.astro';
import Fab from '../components/Fab.astro';
import Footer from '../components/Footer.astro';
import Topbar from '../components/Topbar.astro';
import { breadcrumbs } from '../data/schema';
import { BUSINESS } from '../data/site';
import Layout from '../layouts/Layout.astro';

const contactSchema = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	'@id': `${BUSINESS.siteUrl}/contacto#contacto`,
	name: `Contacto de ${BUSINESS.name} en ${BUSINESS.city}`,
	inLanguage: 'es',
	url: `${BUSINESS.siteUrl}/contacto`,
	mainEntity: { '@type': 'GroceryStore', '@id': `${BUSINESS.siteUrl}/` },
};
---

<Layout
	title={`Contacto y horario | ${BUSINESS.name} en Teatinos, Málaga`}
	description={`Teléfono, horario y cómo llegar a ${BUSINESS.name}, en Calle Béla Bartók, Teatinos, Málaga. Llama al ${BUSINESS.phoneDisplay}.`}
	path="/fruteria-congelados-teatinos/contacto"
	schema={[
		contactSchema,
		breadcrumbs([
			{ name: 'Inicio', path: '/fruteria-congelados-teatinos/' },
			{ name: 'Contacto', path: '/fruteria-congelados-teatinos/contacto' },
		]),
	]}
>
	<Topbar />
	<main>
		<section class="hero-fruta text-white">
			<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
				<nav class="mb-6 text-xs text-white/60" aria-label="Migas de pan">
					<a href="/fruteria-congelados-teatinos/" class="hover:text-secondary">Inicio</a><span class="mx-2">/</span><span
						class="text-white/90">Contacto</span
					>
				</nav><span class="text-secondary text-xs font-semibold tracking-[0.2em] uppercase"
					>Contacto y ubicación</span
				><h1 class="font-display mt-3 text-4xl font-bold sm:text-5xl">
					Visita nuestra frutería en Teatinos
				</h1><p class="mt-5 max-w-3xl leading-relaxed text-white/75">
					Estamos en {BUSINESS.street}, Málaga. Consulta el horario y llámanos para cualquier duda.
				</p><div class="mt-7 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-secondary gap-2 rounded-full"
						><i class="ri-phone-line"></i>{BUSINESS.phoneDisplay}</a
					><a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline rounded-full border-white/40 bg-white/5 text-white"
						><i class="ri-map-pin-line"></i>Abrir en Google Maps</a
					>
				</div>
			</div>
		</section>
		<Contact />
	</main>
	<Footer />
	<Fab />
</Layout>
