---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
---

<section id="inicio" class="hero-tapita relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.fotoPortada}
			alt="Bar restaurante La Tapita en Sanlúcar de Barrameda"
			widths={[640, 1100, 1600]}
			sizes="100vw"
			quality={74}
			loading="eager"
			fetchpriority="high"
			class="h-full w-full object-cover opacity-25"
		/>
		<div class="from-neutral/95 via-neutral/55 absolute inset-0 bg-gradient-to-r"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
		<div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
			<div>
				<p class="text-accent inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase">
					<span><i class="ri-map-pin-line"></i> Sanlúcar de Barrameda</span>
					<span class="text-white/50">Cádiz</span>
				</p>

				<h1 class="font-display mt-4 text-5xl leading-[0.98] font-bold sm:text-6xl lg:text-7xl">
					La Tapita<br />
					<span class="text-accent">bar restaurante</span>
				</h1>

				<p class="font-display mt-6 max-w-xl text-lg leading-relaxed text-white/80 sm:text-xl">
					Tapas, raciones y barra desde primera hora de la mañana, en el Paseo Jardín Botánico.
				</p>

				<div class="mt-7 flex flex-wrap items-center gap-3">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="badge badge-lg gap-2 border-white/20 bg-white/10 px-4 py-3 text-sm font-semibold text-white"
					>
						<span class="text-accent tracking-tight" aria-hidden="true">
							{
								estrellas.map((n) => (
									<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
								))
							}
						</span>
						{BUSINESS.rating.toString().replace('.', ',')} · {BUSINESS.reviewCount} reseñas en Google
					</a>
				</div>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-accent btn-lg gap-2 rounded-full">
						<i class="ri-phone-line text-xl"></i>
						{BUSINESS.phone}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-lg gap-2 rounded-full border-white/35 bg-transparent text-white hover:border-white hover:bg-white hover:text-neutral"
					>
						<i class="ri-google-fill"></i>
						Ver ficha de Google
					</a>
				</div>

				<dl class="mt-10 grid gap-x-6 gap-y-5 border-t border-white/15 pt-7 sm:grid-cols-3">
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Horario</dt>
						<dd class="mt-1 text-base font-bold">7:30 – 23:00</dd>
						<dd class="text-xs text-white/55">Domingos desde las 8:00</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Dónde</dt>
						<dd class="mt-1 text-base font-bold">P.º Jardín Botánico, 10</dd>
						<dd class="text-xs text-white/55">11540 Sanlúcar</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Acceso</dt>
						<dd class="mt-1 text-base font-bold">Adaptado</dd>
						<dd class="text-xs text-white/55">Entrada y aseo</dd>
					</div>
				</dl>
			</div>

			<figure class="relative mx-auto w-full max-w-md lg:max-w-none">
				<div class="border-accent/40 absolute -inset-2 -rotate-2 rounded-lg border"></div>
				<div class="relative grid grid-cols-5 gap-3">
					<div class="col-span-3 overflow-hidden rounded-lg shadow-2xl">
						<Image
							src={IMAGES.fotoInterior}
							alt="Interior de Bar restaurante La Tapita"
							widths={[360, 620]}
							sizes="(min-width: 1024px) 22vw, 55vw"
							quality={85}
							loading="eager"
							class="foto-calida aspect-[3/4] w-full object-cover"
						/>
					</div>
					<div class="col-span-2 flex flex-col gap-3">
						<div class="overflow-hidden rounded-lg shadow-xl">
							<Image
								src={IMAGES.fotoApaisada}
								alt="Ambiente en Bar restaurante La Tapita"
								widths={[260, 440]}
								sizes="(min-width: 1024px) 15vw, 38vw"
								quality={85}
								loading="lazy"
								class="foto-calida aspect-square w-full object-cover"
							/>
						</div>
						<div class="sello-tapita bg-neutral/80 flex flex-1 flex-col justify-center rounded-lg px-4 py-5 text-center">
							<span class="text-accent font-display text-3xl font-bold">118</span>
							<span class="mt-1 text-[0.65rem] leading-tight tracking-[0.14em] text-white/60 uppercase">
								reseñas en Google
							</span>
						</div>
					</div>
				</div>
				<figcaption class="text-accent bg-neutral mt-4 inline-block rounded-full px-4 py-2 text-xs font-semibold shadow-lg">
					Abierto todos los días
				</figcaption>
			</figure>
		</div>
	</div>

	<div class="banda-tapita relative h-1.5 w-full"></div>
</section>
