---
import WhatsappFab from '../components/WhatsappFab.astro';
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';

const business = {
	name: 'Bar restaurante El Templo de Santi',
	shortName: 'El Templo de Santi',
	street: 'Calle Kandinsky, 20',
	city: 'Málaga',
	postalCode: '29006',
	phone: '+34 673 46 81 15',
	latitude: 36.7151318,
	longitude: -4.4659192,
	site: 'https://www.sur-digital.com/el-templo-de-santi',
};

const mapsUrl =
	'https://www.google.com/maps/place/Bar+restaurante+El+Templo+de+Santi/@36.7151662,-4.476406,14z/data=!4m7!3m6!1s0xd72f7d0f19606cb:0xd8300a1ddb3a2af4!8m2!3d36.7151318!4d-4.4659192!15sCgxSZXN0YXVyYW50ZXNaDiIMcmVzdGF1cmFudGVzkgENYmFyX2FuZF9ncmlsbJoBJENoZERTVWhOTUc5blMwVlFjWEIwTjJKMk9WOVVUbTFCUlJBQuABAPoBBAgAEEM!16s%2Fg%2F11rs9pb0gc?entry=tts&g_ep=EgoyMDI2MDkyOC4wIPu8ASoASAFQAw%3D%3D&skid=ada362cb-fb22-46be-aa33-0d3601b6d585';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34673468115';
const instagramUrl = 'https://www.instagram.com/eltemplodesanti/';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurant`,
	name: business.name,
	description:
		'Bar cafetería de comida casera y saludable en Teatinos, Málaga. Pet friendly. En Calle Kandinsky, 20.',
	url: `${business.site}/`,
	telephone: business.phone,
	servesCuisine: ['Cocina casera', 'Comida española'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [instagramUrl, mapsUrl],
	petsAllowed: true,
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#253c35" />
		<meta
			name="description"
			content="El Templo de Santi: comida casera, cafetería pet friendly y menú en Teatinos, Málaga. Estamos en Calle Kandinsky, 20."
		/>
		<meta
			name="keywords"
			content="El Templo de Santi Málaga, bar en Teatinos, restaurante Teatinos Málaga, comida casera Málaga, menú del día Teatinos, cafetería pet friendly Málaga, Calle Kandinsky 20"
		/>
		<meta name="author" content="El Templo de Santi" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/el-templo-de-santi/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap"
			rel="stylesheet"
		/>
		<title>El Templo de Santi | Comida casera en Teatinos, Málaga</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.shortName} />
		<meta property="og:title" content="El Templo de Santi · Teatinos, Málaga" />
		<meta
			property="og:description"
			content="Comida casera, menú y cafetería pet friendly en Calle Kandinsky, 20, Málaga."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="El Templo de Santi en Teatinos, Málaga" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="El Templo de Santi · Teatinos, Málaga" />
		<meta
			name="twitter:description"
			content="Comida casera, menú y cafetería pet friendly en Calle Kandinsky, 20."
		/>
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7151318;-4.4659192" />
		<meta name="ICBM" content="36.7151318, -4.4659192" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="El Templo de Santi, inicio">
				<span class="brand-mark" aria-hidden="true">S</span>
				<span class="brand-name">El Templo <small>de Santi · Málaga</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#templo">El Templo</a>
				<a href="#cocina">Cocina</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Cómo llegar</a>
			</nav>
			<a class="header-phone" href={phoneHref}>673 46 81 15 <span>↗</span></a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> Teatinos · Málaga</p>
					<h1 id="hero-title">Comida de casa.<br /><em>Buen rollo.</em></h1>
					<p class="hero-lede">
						Un bar cafetería de barrio con cocina casera, opciones saludables y sitio para venir con tu compañero de cuatro patas.
					</p>
					<div class="hero-actions">
						<a class="button button-gold" href={phoneHref}>Llamar al restaurante <span aria-hidden="true">↗</span></a>
						<a class="text-link" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<p class="hero-address"><span aria-hidden="true">⌖</span> Calle Kandinsky, 20 · 29006 Málaga</p>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración decorativa de una mesa con un plato saludable; no es una foto del local">
					<div class="art-wall"></div>
					<div class="art-window"><span class="sun"></span><span class="window-grid"></span></div>
					<div class="art-poster"><span>CASERO</span><b>Y DE AQUÍ</b><i>EL TEMPLO · MÁLAGA</i></div>
					<div class="art-table"></div>
					<div class="plate"><span class="plate-food"><i></i><i></i><i></i><i></i><i></i></span></div>
					<div class="glass"><span></span></div>
					<span class="art-label">ILUSTRACIÓN DECORATIVA · NO ES FOTO DEL LOCAL</span>
				</div>
				<div class="hero-stamp" aria-hidden="true"><span>COME<br />A GUSTO</span><i>✳</i></div>
			</section>

			<section class="story section-pad" id="templo">
				<p class="section-label"><span></span> Un bar cafetería en Teatinos</p>
				<div class="story-grid">
					<h2>Un sitio rico<br />para hacer<br /><em>una pausa.</em></h2>
					<div class="story-copy">
						<p>
							El Templo de Santi es un bar cafetería de comida casera en Calle Kandinsky, en el barrio de Teatinos-Universidad de Málaga.
						</p>
						<p>
							El perfil del local se describe con comida casera y saludable, ambiente pet friendly y servicio de desayunos y menús. Consulta qué hay hoy y confirma el horario antes de acercarte.
						</p>
						<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">Seguir a El Templo de Santi en Instagram <span aria-hidden="true">↗</span></a>
					</div>
				</div>
				<div class="story-rule"><span>EL TEMPLO DE SANTI</span><i></i><span>TEATINOS · MÁLAGA</span></div>
			</section>

			<section class="kitchen section-pad" id="cocina">
				<div class="kitchen-heading">
					<div><p class="eyebrow dark"><span></span> Una cocina para el día a día</p><h2>Menú, desayuno<br />y <em>algo rico.</em></h2></div>
					<p>Platos, menús y opciones saludables. La oferta cambia: llama para consultar el menú del día y disponibilidad.</p>
				</div>
				<div class="moments-grid">
					<article class="moment-card moment-breakfast"><span class="moment-kicker">Por la mañana</span><div class="moment-art breakfast-art" aria-hidden="true"><span class="coffee-art"></span><span class="toast-art"></span><i></i></div><h3>Desayunos</h3><p>Una pausa de café antes de seguir el día.</p></article>
					<article class="moment-card moment-menu"><span class="moment-kicker">A mediodía</span><div class="moment-art menu-art" aria-hidden="true"><span></span><i></i><b></b><em></em></div><h3>Menú casero</h3><p>Consulta el menú del día directamente con el local.</p></article>
					<article class="moment-card moment-fideua"><span class="moment-kicker">Plato mencionado</span><div class="moment-art fideua-art" aria-hidden="true"><span></span><i></i><b></b></div><h3>Fideuá</h3><p>Una de las opciones señaladas en las reseñas.</p></article>
				</div>
				<p class="menu-note">Ilustraciones decorativas. Platos y disponibilidad pueden variar; no se publican precios sin una carta oficial.</p>
			</section>

			<section class="gallery section-pad" id="fotos">
				<div class="gallery-copy">
					<p class="eyebrow dark"><span></span> Fotos de la ficha del local</p>
					<h2>Conoce el sitio<br /><em>antes de venir.</em></h2>
					<p>Abre Google Maps para ver las fotos del interior y los platos compartidas por clientes. Esta ilustración no representa una fotografía real del restaurante.</p>
					<a class="button button-forest" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a>
					<a class="instagram-link" href={instagramUrl} target="_blank" rel="noreferrer">Ver Instagram oficial <span aria-hidden="true">↗</span></a>
				</div>
				<a class="gallery-art" href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Abrir Google Maps para ver las fotos originales de El Templo de Santi">
					<div class="gallery-scene" aria-hidden="true"><span class="gallery-window"></span><span class="gallery-shelf"></span><span class="gallery-plate"></span><span class="gallery-mark">S</span></div>
					<span class="gallery-caption"><span>Ilustración decorativa · no es foto</span><b>Ver fotos originales ↗</b></span>
				</a>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span></span> Teatinos-Universidad</p>
					<h2>Ven al Templo<br /><em>en Kandinsky.</em></h2>
					<p class="address">Calle Kandinsky, 20<br />29006 Málaga, España</p>
					<div class="visit-links"><a class="button button-gold" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a><a class="phone-link" href={phoneHref}>+34 673 46 81 15</a></div>
					<p class="hours-note">Hay información pública contradictoria sobre el estado y horario actual. Llama o confirma la ficha de Google Maps antes de desplazarte.</p>
				</div>
				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
						title="Mapa de El Templo de Santi en Calle Kandinsky, Teatinos, Málaga"
					 src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span>⌖</span> El Templo de Santi · Málaga</a>
				</div>
			</section>
			<Galeria nombre="Bar restaurante El Templo de Santi" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">S</span><span class="brand-name">El Templo <small>de Santi · Málaga</small></span></a>
			<p>Comida casera y saludable</p>
			<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps <span aria-hidden="true">↗</span></a>
			<small>© {new Date().getFullYear()} El Templo de Santi</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
	<a href="/el-templo-de-santi/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
	<a href="/el-templo-de-santi/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
	<a href="/el-templo-de-santi/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
</nav>
</footer>
		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>673 46 81 15</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/el-templo-de-santi/aviso-legal">Aviso legal</a>
					<a href="/el-templo-de-santi/aviso-legal#privacidad">Privacidad</a>
					<a href="/el-templo-de-santi/aviso-legal#cookies">Cookies</a>
				</nav>
						<WhatsappFab phone={phoneHref} />
						</body>
</html>


