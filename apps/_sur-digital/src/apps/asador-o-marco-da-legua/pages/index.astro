---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import mesa from '../assets/fotos/asador-o-marco-da-legua-apaisada-01.jpg';
import pizza from '../assets/fotos/asador-o-marco-da-legua-apaisada-02.jpg';
import terraza from '../assets/fotos/asador-o-marco-da-legua-vertical-03.jpg';
import helado from '../assets/fotos/asador-o-marco-da-legua-vertical-04.jpg';
import surtido from '../assets/fotos/asador-o-marco-da-legua-apaisada-05.jpg';
import zamburinas from '../assets/fotos/asador-o-marco-da-legua-vertical-06.jpg';
import postres from '../assets/fotos/asador-o-marco-da-legua-apaisada-07.jpg';
import pulpo from '../assets/fotos/asador-o-marco-da-legua-apaisada-08.jpg';
import tabla from '../assets/fotos/asador-o-marco-da-legua-vertical-09.jpg';
import carne from '../assets/fotos/asador-o-marco-da-legua-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Asador O Marco Da Legua, en Aldea Lagoas 31 (32135 Piñor, Ourense). Carnes a la brasa, cabrito y cordero en horno tradicional de leña. Terraza en el jardín y comida para llevar. Tel. 673 65 64 13.';

const galeria = [
	{
		src: mesa,
		alt: 'Mesa de Asador O Marco Da Legua con una fuente de zamburiñas a la plancha, un cuenco de pimientos de Padrón y cesta de pan',
	},
	{
		src: terraza,
		alt: 'Terraza del asador en el jardín, con mesas y sillas bajo los árboles y luces colgadas de las ramas',
	},
	{
		src: pulpo,
		alt: 'Plato de pulpo á feira con patatas cocidas y pimentón, junto a un tentáculo a la plancha',
	},
	{
		src: zamburinas,
		alt: 'Ocho zamburiñas a la plancha con perejil en sus conchas sobre un plato blanco',
	},
	{
		src: pizza,
		alt: 'Pizza rectangular alargada con huevos fritos encima, servida sobre una tabla de madera',
	},
	{
		src: surtido,
		alt: 'Mesa con zamburiñas, pimientos de Padrón, pimientos con tomate y carne a la plancha con patatas fritas',
	},
	{
		src: tabla,
		alt: 'Tabla de madera con una longaniza grande, patatas paja, pimientos de Padrón y salsas',
	},
	{
		src: carne,
		alt: 'Plato de carne asada en lonchas finas sobre una cama de patatas fritas',
	},
	{
		src: postres,
		alt: 'Postres caseros de chocolate: una mousse en tarro de cristal y una copa de helado con nata y sirope',
	},
	{
		src: helado,
		alt: 'Copa de helado con nata montada, virutas de colores y un barquillo de fresa',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#o-marco-da-legua`,
	name: BUSINESS.name,
	alternateName: ['O Marco Da Legua', 'Asador O Marco Da Legua', 'O Marco da Legua', 'Asador Marco da Legua'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 673 65 64 13',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Gallega', 'Brasa', 'Asador'],
	areaServed: [
		{ '@type': 'City', name: 'Piñor' },
		{ '@type': 'AdministrativeArea', name: 'O Carballiño' },
		{ '@type': 'AdministrativeArea', name: 'Ourense' },
		{ '@type': 'AdministrativeArea', name: 'Galicia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday', 'Sunday'],
			opens: '10:30',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '10:30',
			closes: '00:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '11:00',
			closes: '00:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'O Marco Da Legua · Asador de brasa en Piñor';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#8a4a22" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="O Marco Da Legua, Asador O Marco Da Legua, comer en Piñor, asador Ourense, carnes a la brasa Ourense, cabrito horno de leña, cordero horno de leña, restaurante Piñor, comida para llevar Ourense"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="O Marco Da Legua · Asador de brasa en Piñor"
			ogDescription="Carnes a la brasa, cabrito y cordero en horno tradicional de leña en Aldea Lagoas (Piñor, Ourense). Terraza en el jardín y comida para llevar. Tel. 673 65 64 13."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Mesa del Asador O Marco Da Legua con zamburiñas y pimientos de Padrón"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#8a4a22"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-GA"
			postalCode={BUSINESS.postalCode}
			phone="+34673656413"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[mesa]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/asador-o-marco-da-legua/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="O MARCO DA LEGUA"
			subtitle="Asador · Piñor"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Aldea Lagoas, 31 · Piñor"
				title="Carnes a la brasa<br /><em>y horno de leña.</em>"
				lede={`Asador O Marco Da Legua es un restaurante familiar de Aldea Lagoas, 31, en Piñor (Ourense). Carnes a la brasa, cabrito y cordero en horno tradicional de leña, tapas y raciones, con terraza en el jardín y servicio de comida para llevar. Abre de jueves a domingo, desde las 10:30, y cierra de lunes a miércoles. Teléfono: ${BUSINESS.phoneDisplay}.`}
				image={mesa}
				imageAlt="Mesa del Asador O Marco Da Legua con zamburiñas a la plancha, pimientos de Padrón y cesta de pan"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)` },
					{ label: 'Cocina', html: 'Brasa y horno tradicional de leña' },
					{ label: 'Horario', html: 'Jue–dom · desde las 10:30 · lunes a miércoles cerrado' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Asador O Marco Da Legua" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un asador<br /><em>de aldea.</em>"
				paragraphs={[
					'Asador O Marco Da Legua está en Aldea Lagoas, 31, en Piñor (Ourense). Google lo clasifica como brasería, bar restaurante, restaurante familiar, restaurante gallego y bar de tapas, y su ficha lo presenta en una línea: «carnes a la brasa, cabrito y cordero en horno tradicional de leña».',
					'La casa abre de jueves a domingo. Jueves y domingo, de 10:30 a 24:00; el viernes, de 10:30 a 0:30; el sábado, de 11:00 a 0:30. Los lunes, martes y miércoles cierra. El servicio de comida para llevar es una de las categorías con las que Google describe el local.',
					'Fuera, la terraza ocupa el jardín: mesas y sillas bajo los árboles, con luces colgadas de las ramas. En la mesa aparecen las zamburiñas a la plancha, los pimientos de Padrón con queso, el pulpo á feira, la pizza con huevos, las carnes a la brasa y los postres caseros de chocolate.',
					'Sus reseñas lo dejan claro: «fuimos a cenar, pedimos chipirones a la plancha y churrasco, buenísimo todo», «camarera y cocinero de 5 estrellas, sitio para repetir» y «la pizza enorme y buenísima, postres caseros y también muy ricos». Google le da 4,8 sobre 5 con 210 reseñas.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una de ellas: «${REVIEWS[1]}»`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Brasa, leña<br /><em>y sobremesa.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que citan sus reseñas, lo que cuenta la propia ficha y lo que aparece en las fotos del perfil."
				cta={{ label: `Encargar para llevar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. Llama al 673 65 64 13 para encargar comida para llevar o preguntar por el cabrito y el cordero del horno de leña."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La mesa,<br /><em>la terraza y la brasa.</em>"
				description="Estas fotografías proceden del perfil de Asador O Marco Da Legua en Google Maps: la terraza del jardín, las zamburiñas, el pulpo á feira, la pizza, la tabla de embutido, las carnes y los postres caseros."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en Lagoas.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: jueves y domingo de 10:30 a 24:00, viernes de 10:30 a 0:30 y sábado de 11:00 a 0:30. Lunes, martes y miércoles cerrado."
				mapTitle="Mapa de Asador O Marco Da Legua en Aldea Lagoas, 31, Piñor (Ourense)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="O Marco Da Legua · Piñor"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 673 65 64 13. También se puede encargar comida para llevar. La ficha de Google marca acceso para sillas de ruedas, aparcamiento, aseo y asientos adaptados."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/asador-o-marco-da-legua/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a O Marco Da Legua"
		/>
	</body>
</html>
