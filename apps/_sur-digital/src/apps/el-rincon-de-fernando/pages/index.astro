---
import WhatsappFab from '../components/WhatsappFab.astro';
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';

const mapsUrl =
	'https://www.google.com/maps/place/El+Rinc%C3%B3n+de+Fernando/@36.7131892,-4.4740987,14z/data=!4m10!1m2!2m1!1sRestaurantes!3m6!1s0xd72f7e6d1f11cb3:0xfce192fac77fc64f!8m2!3d36.713637!4d-4.4502091!15sCgxSZXN0YXVyYW50ZXNaDiIMcmVzdGF1cmFudGVzkgERZmFtaWx5X3Jlc3RhdXJhbnSaASNDaFpEU1VoTk1HOW5TMFZKUTBGblNVTTNNalZZUldGM0VBReABAPoBBAgAED8!16s%2Fg%2F11qg_mh96t?entry=ttu&g_ep=EgoyMDI2MDkyOC4wIKXMDSoASAFQAw%3D%3D';
const directionsUrl = 'https://www.google.com/maps/dir/?api=1&destination=36.713637%2C-4.4502091';
const phone = 'tel:+34662289612';
const instagramUrl = 'https://www.instagram.com/rincon.de.fernando/';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#102c3b" />
		<meta
			name="description"
			content="El Rincón de Fernando, freiduría familiar en Málaga. Pescaito, marisco y pulpo de la casa en C. Río Guadiana, 4. Reserva por teléfono."
		/>
		<meta property="og:title" content="El Rincón de Fernando · Málaga" />
		<meta
			property="og:description"
			content="Freiduría familiar en Málaga. Ven a disfrutar del sabor del mar."
		/>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:url" content="https://www.sur-digital.com/el-rincon-de-fernando/" />
		<meta property="og:locale" content="es_ES" />
		<meta
			name="robots"
			content="index, follow, max-image-preview:large, max-snippet:-1"
		/>
		<link rel="canonical" href="https://www.sur-digital.com/el-rincon-de-fernando/" />
		<link rel="icon" type="image/svg+xml" href="/el-rincon-de-fernando/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>El Rincón de Fernando · Freiduría en Málaga</title>
			<meta property="og:image" content="https://www.sur-digital.com/el-rincon-de-fernando/og.png" />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta name="geo.position" content="36.713637;-4.4502091" />
		<meta name="ICBM" content="36.713637, -4.4502091" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="El Rincón de Fernando, inicio">
				<span class="brand-mark" aria-hidden="true">
					<svg viewBox="0 0 48 48" fill="none">
						<circle cx="24" cy="24" r="21" stroke="currentColor" stroke-width="1.5" />
						<path d="M10 24c7-9 18-9 25 0-7 9-18 9-25 0Zm25 0 8-7v14l-8-7Z" fill="currentColor" />
						<circle cx="20" cy="22" r="1.5" fill="#102c3b" />
					</svg>
				</span>
				<span class="brand-name">El Rincón <span>de Fernando</span></span>
			</a>
			<nav class="main-nav" aria-label="Navegación principal">
				<a href="#el-rincon">El rincón</a>
				<a href="#sabores">Sabores</a>
				<a href="#visitanos">Cómo llegar</a>
			</nav>
			<a class="header-call" href={phone}><span aria-hidden="true">↗</span> Reservar mesa</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-photo" role="img" aria-label="Pescado y marisco fresco para compartir"></div>
				<div class="hero-shade"></div>
				<div class="hero-content">
					<p class="eyebrow"><span></span> Málaga · sabor de aquí</p>
					<h1 id="hero-title">El mar,<br />a nuestra <em>manera.</em></h1>
					<p class="hero-copy">
						Una mesa para compartir, producto del mar y ese gustito de quedarse un rato más.
					</p>
					<div class="hero-actions">
						<a class="button button-yellow" href={phone}>Llama y reserva <span aria-hidden="true">↗</span></a>
						<a class="text-link" href="#sabores">Conócenos <span aria-hidden="true">↓</span></a>
					</div>
				</div>
				<div class="hero-stamp" aria-label="Freiduría familiar en Málaga">
					<svg class="stamp-ring" viewBox="0 0 120 120" aria-hidden="true">
						<defs><path id="stamp-path" d="M60,60 m-43,0 a43,43 0 1,1 86,0 a43,43 0 1,1 -86,0" /></defs>
						<text><textPath href="#stamp-path">FREIDURÍA FAMILIAR · MÁLAGA · </textPath></text>
					</svg>
					<span>Desde<br />el mar</span>
				</div>
				<a class="hero-location" href={directionsUrl} target="_blank" rel="noreferrer">
					<span class="pin-icon" aria-hidden="true">⌖</span>
					<span><strong>Ven a vernos</strong><br />C. Río Guadiana, 4 · Málaga</span>
				</a>
			</section>

			<section class="intro section-pad" id="el-rincon">
				<div class="intro-kicker"><span class="line"></span> Un rincón con sabor a Málaga</div>
				<div class="intro-grid">
					<h2>Lo bueno del mar<br />es <em>compartirlo.</em></h2>
					<div class="intro-text">
						<p>
							En El Rincón de Fernando nos gusta lo sencillo: juntarnos alrededor de la mesa y disfrutar de los sabores de siempre.
						</p>
						<p>Una freiduría familiar en Málaga para venir con hambre y sin prisa.</p>
						<a class="underlined-link" href={instagramUrl} target="_blank" rel="noreferrer">Síguenos en Instagram <span aria-hidden="true">↗</span></a>
					</div>
				</div>
				<div class="marquee" aria-hidden="true">
					<div class="marquee-track">BUEN PESCADO <span>✳</span> BUENA COMPAÑÍA <span>✳</span> SABOR MALAGUEÑO <span>✳</span> BUEN PESCADO <span>✳</span></div>
				</div>
			</section>

			<section class="flavours section-pad" id="sabores">
				<div class="section-heading">
					<div>
						<p class="eyebrow dark"><span></span> Para abrir el apetito</p>
						<h2>Del mar a <em>la mesa.</em></h2>
					</div>
					<p class="heading-note">Lo mejor es preguntar qué apetece hoy. Te esperamos para compartirlo.</p>
				</div>
				<div class="food-grid">
					<article class="food-card food-card-main">
						<div class="food-image food-image-fish" role="img" aria-label="Selección de pescado fresco frito"></div>
						<div class="food-card-caption"><span class="food-number">A</span><div><h3>Fritura de pescaito</h3><p>Un clásico para poner en el centro.</p></div><span class="arrow-round" aria-hidden="true">↗</span></div>
					</article>
					<article class="food-card food-card-pulpo">
						<div class="pulpo-art" aria-hidden="true">🐙</div>
						<p class="eyebrow"><span></span> De la casa</p>
						<h3>Pulpo<br /><em>de la casa.</em></h3>
						<p class="pulpo-note">Uno de esos sabores que saben a volver.</p>
						<span class="sun-mark" aria-hidden="true">✳</span>
					</article>
					<article class="food-card food-card-marisco">
						<div class="food-image food-image-sea" role="img" aria-label="Marisco preparado para compartir"></div>
						<div class="food-card-caption"><span class="food-number">B</span><div><h3>Sabores del mar</h3><p>Un plan que siempre apetece.</p></div><span class="arrow-round" aria-hidden="true">↗</span></div>
					</article>
				</div>
				<p class="menu-note">La disponibilidad y los platos pueden variar. Pregúntanos por lo que tenemos hoy.</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span></span> Estamos en Málaga</p>
					<h2>Tu mesa<br />está <em>por aquí.</em></h2>
					<p>C. Río Guadiana, 4<br />Málaga, España</p>
					<a class="button button-yellow" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					<div class="visit-phone"><span>¿Una reserva?</span><a href={phone}>662 28 96 12</a></div>
				</div>
				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
						title="Mapa para llegar a El Rincón de Fernando, Málaga"
					 src="https://maps.google.com/maps?q=36.713637%2C-4.4502091&z=16&output=embed"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span>⌖</span> El Rincón de Fernando</a>
				</div>
			</section>
			<Galeria nombre="El Rincón de Fernando" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio">
				<span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="21" stroke="currentColor" stroke-width="1.5" /><path d="M10 24c7-9 18-9 25 0-7 9-18 9-25 0Zm25 0 8-7v14l-8-7Z" fill="currentColor" /><circle cx="20" cy="22" r="1.5" fill="#102c3b" /></svg></span>
				<span class="brand-name">El Rincón <span>de Fernando</span></span>
			</a>
			<p>Freiduría familiar · Málaga</p>
			<a class="footer-social" href={instagramUrl} target="_blank" rel="noreferrer">Instagram <span aria-hidden="true">↗</span></a>
			<small>© {new Date().getFullYear()} El Rincón de Fernando</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small>
			</p>
<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
	<a href="/el-rincon-de-fernando/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
	<a href="/el-rincon-de-fernando/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
	<a href="/el-rincon-de-fernando/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
</nav>
</footer>
		<a class="mobile-reserve" href={phone}>Llama y reserva <span>662 28 96 12</span></a>
						<WhatsappFab phone={phone} />
						</body>
</html>


