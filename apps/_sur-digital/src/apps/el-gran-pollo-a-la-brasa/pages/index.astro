---
import { Image } from 'astro:assets';
import '../styles/global.css';
import { BRASA, BUSINESS, FAQ, FICHA, HIGHLIGHTS, HOURS, MAPS, RATING, SERVICIOS } from '../data/site';

import fachada from '../assets/fotos/el-gran-pollo-a-la-brasa-apaisada-04.jpg';
import asador from '../assets/fotos/el-gran-pollo-a-la-brasa-apaisada-06.jpg';
import plato from '../assets/fotos/el-gran-pollo-a-la-brasa-apaisada-02.jpg';
import troceado from '../assets/fotos/el-gran-pollo-a-la-brasa-cuadrada-09.jpg';
import patatas from '../assets/fotos/el-gran-pollo-a-la-brasa-vertical-05.jpg';
import brasas from '../assets/fotos/el-gran-pollo-a-la-brasa-vertical-07.jpg';
import mesa from '../assets/fotos/el-gran-pollo-a-la-brasa-apaisada-03.jpg';

const title = `${BUSINESS.name} · Pollo al carbón en Calpe`;
const description = BUSINESS.description;
const year = new Date().getFullYear();

const nav = [
  { label: 'El asador', href: '#casa' },
  { label: 'La brasa', href: '#brasa' },
  { label: 'Fotos', href: '#fotos' },
  { label: 'Dónde está', href: '#visitanos' },
  { label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${BUSINESS.siteUrl}/`} />
    <meta name="theme-color" content="#5a1f17" />
    <link rel="icon" href="/el-gran-pollo-a-la-brasa/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Mulish:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Restaurant",
        "@id": "https://www.sur-digital.com/el-gran-pollo-a-la-brasa/#negocio",
        "name": "El Gran Pollo a la Brasa",
        "url": "https://www.sur-digital.com/el-gran-pollo-a-la-brasa/",
        "description": "El Gran Pollo a la Brasa, restaurante halal especializado en pollo y carnes a la brasa en Carrer los Almendros, 9 (03710 Calp, Alicante).",
        "image": "https://www.sur-digital.com/el-gran-pollo-a-la-brasa/og.jpg",
        "telephone": "+34965830937",
        "servesCuisine": ["Pollo a la brasa", "Carnes a la parrilla", "Halal"],
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 38.6448273,
          "longitude": 0.0465562
        },
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Carrer los Almendros, 9",
          "addressLocality": "Calp",
          "addressRegion": "Comunidad Valenciana",
          "postalCode": "03710",
          "addressCountry": "ES"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": 4.1,
          "reviewCount": 297,
          "bestRating": 5,
          "worstRating": 1
        },
        "hasMap": "https://www.google.com/maps/place/El+Gran+Pollo+a+la+Brasa/@38.6448273,0.0465562,17z/data=!3m1!4b1!4m6!3m5!1s0x129dfe257e8bcec5:0x17c4f7af94fd2136!8m2!3d38.6448273!4d0.0465562!16s%2Fg%2F11cmrsmt9z",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
            "opens": "10:30",
            "closes": "00:30"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": "Sunday",
            "opens": "11:00",
            "closes": "21:00"
          }
        ]
      }
    </script>
    <meta property="og:image" content="https://www.sur-digital.com/el-gran-pollo-a-la-brasa/og.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:url" content="https://www.sur-digital.com/el-gran-pollo-a-la-brasa/" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="topbar">
      <div class="topbar-inner wrap">
        <a class="brand" href="#inicio" aria-label={`${BUSINESS.name}, inicio`}>
          <span class="brand-mark" aria-hidden="true">{BUSINESS.mark}</span>
          <span class="brand-name">
            El Gran Pollo
            <small>Brasa y carbón · Calpe</small>
          </span>
        </a>
        <nav aria-label="Navegación principal">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <a class="topbar-phone" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
      </div>
    </header>

    <main id="contenido">
      <section class="hero wrap" id="inicio" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span aria-hidden="true"></span> Carrer los Almendros, 9 · Calpe · Alicante</p>
          <h1 id="hero-title">Pollo a la brasa <em>de verdad.</em></h1>
          <p class="hero-lede">
            Pollos abiertos sobre brasas de carbón y carnes a la parrilla, en un restaurante halal de
            Calpe con terraza en la puerta. El rótulo de la casa lo promete así: «el más crujiente
            con un sabor diferente». Del asador a la mesa, sin más.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href={BUSINESS.phoneHref}>
              Llamar · {BUSINESS.phone}
            </a>
            <a class="button button-ghost" href={MAPS.directions} target="_blank" rel="noreferrer">
              Cómo llegar <span aria-hidden="true">↗</span>
            </a>
          </div>
          <ul class="hero-facts">
            <li><b>{RATING.label}</b> sobre 5 · {RATING.count} reseñas</li>
            <li><b>10:30–0:30</b> lunes a sábado</li>
            <li><b>Halal</b> cocina de la casa</li>
          </ul>
        </div>

        <figure class="hero-photo">
          <Image
            src={fachada}
            alt="Fachada de El Gran Pollo a la Brasa en Calpe, con el rótulo rojo, el cartel halal y las mesas de la terraza"
            widths={[480, 720, 1024]}
            sizes="(max-width: 900px) 92vw, 46vw"
            format="webp"
            quality={74}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>
            <span>Foto del perfil de Google</span>
            <a href={MAPS.place} target="_blank" rel="noreferrer">Ver la ficha ↗</a>
          </figcaption>
        </figure>
      </section>

      <section class="wrap" aria-label="Lo que ofrece el restaurante">
        <ul class="chips">
          {SERVICIOS.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="about" id="casa" aria-labelledby="about-title">
        <div class="wrap">
          <div class="about-grid">
            <h2 id="about-title">Un asador <em>de carbón.</em></h2>
            <div class="about-copy">
              <p>
                En la fachada blanca de Carrer los Almendros, 9, el rótulo rojo lo deja claro:
                «Restaurante El Gran Pollo a la Brasa», «toda clase de carne a la brasa» y «Calpe».
                Al lado, el sello verde de halal que marca la cocina de la casa.
              </p>
              <p>
                Dentro, el asador manda. Los pollos se abren y se colocan sobre la parrilla, encima
                de las brasas, y se van girando a mano. La ficha pública de Google lo clasifica como
                «restaurante especializado en pollo» y le da un {RATING.label} sobre 5 con{' '}
                {RATING.count} reseñas.
              </p>
              <p>
                A la mesa salen el pollo troceado, las patatas asadas con especias, las brochetas y
                las carnes a la parrilla. Fuera, unas mesas y sillas junto a la puerta hacen las
                veces de terraza para los días de buen tiempo.
              </p>
              <p class="about-note">
                Esta web no es la web oficial del restaurante y no publica carta ni precios. Para
                saber qué hay hoy o reservar mesa, llama al
                <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>.
              </p>
              <div class="about-links">
                <a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
                  Ficha en Google Maps <span aria-hidden="true">↗</span>
                </a>
                <a class="simple-link" href="#brasa">Ver qué sale del asador</a>
              </div>
            </div>
          </div>

          <ul class="highlights">
            {
              HIGHLIGHTS.map((item, index) => (
                <li class={index === HIGHLIGHTS.length - 1 ? 'highlight-wide' : undefined}>
                  <span class="highlight-mark">{String(index + 1).padStart(2, '0')}</span>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="menu" id="brasa" aria-labelledby="brasa-title">
        <div class="wrap">
          <div class="menu-head">
            <div>
              <p class="section-label"><span aria-hidden="true"></span> La brasa</p>
              <h2 id="brasa-title">Lo que sale <em>del asador.</em></h2>
            </div>
            <div>
              <p>
                Los platos que aparecen en las fotos del perfil: pollo al carbón, carnes, brochetas
                y patatas. Sin carta cerrada ni precios fijos: se consultan en el restaurante.
              </p>
              <a class="button button-primary" href={BUSINESS.phoneHref}>
                Preguntar por teléfono
              </a>
            </div>
          </div>

          <div class="menu-groups">
            <div class="menu-group">
              <h3>Del asador y la parrilla</h3>
              <ul class="dishes">
                {
                  BRASA.map((item) => (
                    <li>
                      <span class="dish">
                        {item.name}
                        <em>{item.text}</em>
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="menu-group">
              <h3>Datos de la ficha</h3>
              <ul class="dishes">
                {
                  FICHA.map((item) => (
                    <li>
                      <span class="dish">
                        {item.label}
                        <em>{item.value}</em>
                      </span>
                    </li>
                  ))
                }
                <li>
                  <span class="dish">
                    Teléfono
                    <em><a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>, el que publica la ficha</em>
                  </span>
                </li>
                <li>
                  <span class="dish">
                    Cómo llegar
                    <em><a href={MAPS.directions} target="_blank" rel="noreferrer">Ruta en Google Maps ↗</a></em>
                  </span>
                </li>
              </ul>
            </div>
          </div>

          <p class="menu-note">
            No hay carta ni precios en esta página. Para encargar comida o preguntar por el pollo
            del día, llama al <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>.
          </p>
        </div>
      </section>

      <section class="rating-section" id="opiniones" aria-labelledby="rating-title">
        <div class="wrap rating-grid">
          <div class="rating-copy">
            <p class="section-label"><span aria-hidden="true"></span> Opiniones</p>
            <h2 id="rating-title">Cuatro y uno <em>en la ficha.</em></h2>
            <p>
              Es la valoración media que publica Google Maps para El Gran Pollo a la Brasa al
              consultarla (noviembre de 2026), con {RATING.count} reseñas. Esta página no reproduce
              reseñas de terceros: para leerlas todas, abre la ficha del restaurante.
            </p>
          </div>
          <div class="rating-badge">
            <strong>{RATING.label}</strong>
            <span aria-hidden="true">★★★★☆</span>
            <small>Valoración en la ficha de Google · sobre 5</small>
          </div>
        </div>
      </section>

      <section class="section-pad" id="fotos" aria-labelledby="fotos-title">
        <div class="wrap">
          <div class="gallery-head">
            <div>
              <p class="section-label"><span aria-hidden="true"></span> Fotos del perfil</p>
              <h2 id="fotos-title">El asador, la parrilla <em>y la mesa.</em></h2>
            </div>
            <p>
              Imágenes del perfil público de El Gran Pollo a la Brasa en Google Maps: la fachada, los
              pollos sobre el carbón, el plato con patatas y la mesa con brochetas.
            </p>
          </div>
          <div class="gallery-grid">
            <figure class="shot">
              <Image
                src={asador}
                alt="Pollos asándose sobre las brasas en el asador de El Gran Pollo a la Brasa"
                widths={[640, 960, 1280]}
                sizes="(max-width: 900px) 92vw, 72rem"
                format="webp"
                quality={70}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <figure class="shot">
              <Image
                src={plato}
                alt="Pollo a la brasa servido con patatas asadas en un plato"
                widths={[320, 480, 640]}
                sizes="(max-width: 900px) 46vw, 24vw"
                format="webp"
                quality={68}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <figure class="shot">
              <Image
                src={troceado}
                alt="Pollo troceado a la brasa, dorado y con especias"
                widths={[320, 480, 640]}
                sizes="(max-width: 900px) 46vw, 24vw"
                format="webp"
                quality={68}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <figure class="shot">
              <Image
                src={patatas}
                alt="Patatas asadas con especias en un plato"
                widths={[320, 480, 640]}
                sizes="(max-width: 900px) 46vw, 24vw"
                format="webp"
                quality={68}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <figure class="shot">
              <Image
                src={brasas}
                alt="Parrilla con pollos y brasas de carbón en la cocina"
                widths={[320, 480, 640]}
                sizes="(max-width: 900px) 46vw, 24vw"
                format="webp"
                quality={68}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <figure class="shot">
              <Image
                src={mesa}
                alt="Mesa con pollo a la brasa, brochetas y patatas asadas"
                widths={[640, 960, 1280]}
                sizes="(max-width: 900px) 92vw, 48vw"
                format="webp"
                quality={68}
                loading="lazy"
                decoding="async"
              />
            </figure>
          </div>
          <p class="gallery-note">
            Imágenes alojadas en esta página y tomadas del perfil del establecimiento en Google
            Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos.
          </p>
        </div>
      </section>

      <section class="visit" id="visitanos" aria-labelledby="visit-title">
        <div class="wrap visit-grid">
          <div class="visit-copy">
            <p class="section-label section-label-light"><span aria-hidden="true"></span> Dónde está</p>
            <h2 id="visit-title">Ven al asador, <em>en Calpe.</em></h2>
            <p class="address">
              {BUSINESS.street}<br />
              {BUSINESS.postalCode} {BUSINESS.city}<br />
              {BUSINESS.region}
            </p>
            <table class="hours">
              <caption>Horario publicado</caption>
              <tbody>
                {
                  HOURS.map((item) => (
                    <tr>
                      <th scope="row">{item.day}</th>
                      <td>{item.value}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <p class="hours-note">
              Horario que publica la ficha de Google en noviembre de 2026; puede cambiar en festivos.
              El teléfono es el del restaurante: esta página no tramita pedidos ni reservas.
            </p>
            <a class="phone-link" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
            <div class="visit-links">
              <a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
                Cómo llegar <span aria-hidden="true">↗</span>
              </a>
              <a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
                Ficha en Google Maps <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <div class="map-frame">
            <iframe
              title={`Mapa de ${BUSINESS.name} en ${BUSINESS.street}, ${BUSINESS.city}`}
              src={MAPS.embed}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen></iframe>
            <a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
              <span aria-hidden="true">⌖</span> {BUSINESS.street}
            </a>
          </div>
        </div>
      </section>

      <section class="faq section-pad" id="preguntas" aria-labelledby="faq-title">
        <div class="wrap">
          <p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
          <h2 id="faq-title">Antes de <em>venir.</em></h2>
          <div class="faq-list">
            {
              FAQ.map((item) => (
                <details>
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <span class="brand-mark" aria-hidden="true">{BUSINESS.mark}</span>
            <p>
              {BUSINESS.name}
              <small>
                Pollo y carnes a la brasa<br />
                {BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}
              </small>
            </p>
          </div>
          <nav aria-label="Enlaces del establecimiento">
            <a href={BUSINESS.phoneHref}>Llamar</a>
            <a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
            <a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
            <a href="/el-gran-pollo-a-la-brasa/aviso-legal">Aviso legal</a>
          </nav>
        </div>
        <small class="legal">
          © {year} {BUSINESS.name} · Datos de la ficha pública de Google Maps, consultada en
          noviembre de 2026. Las fotografías proceden del mismo perfil.
        </small>
        <nav class="legal-links" aria-label="Información legal">
          <a href="/el-gran-pollo-a-la-brasa/aviso-legal">Aviso legal</a>
          <a href="/el-gran-pollo-a-la-brasa/aviso-legal#privacidad">Privacidad</a>
          <a href="/el-gran-pollo-a-la-brasa/aviso-legal#cookies">Cookies</a>
        </nav>
        <p class="credit">
          Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a>
        </p>
      </div>
    </footer>

    <a class="mobile-call" href={BUSINESS.phoneHref}>Llamar <span>{BUSINESS.phone}</span></a>
  </body>
</html>
