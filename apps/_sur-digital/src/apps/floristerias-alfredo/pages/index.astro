---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	descripcionParrafos,
	directionsUrl,
	faqSchema,
	faqs,
	floristSchema,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	site,
	whatsappUrl,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

/**
 * Galería: las nueve fotografías de la ficha. La primera ocupa dos columnas.
 */
const galeria = Object.keys(fotos)
	.sort((a, b) => a.localeCompare(b))
	.map((path) => path.split('/floristerias-alfredo/').pop() as string);

/**
 * La descripción del titular viene en cuatro párrafos separados por línea en blanco. El tercero
 * lleva la lista de servicios y el cuarto, el número de WhatsApp.
 */
const [intro, rapida, serviciosTexto, pedidosTexto] = descripcionParrafos;
const serviciosLineas = serviciosTexto.split('\n');
const serviciosTitulo = serviciosLineas[0];
const servicios = serviciosLineas.slice(1).map((linea) => linea.replace(/^•\s*/, ''));
const pedidosTitulo = pedidosTexto.split('\n')[0];

const title = 'Floristerías Alfredo · Floristería en Madrid';
const description =
	'Floristerías Alfredo, floristería, entrega de flores y tienda de regalos en la Pl. de Venecia (Salamanca, Madrid). Pedidos por WhatsApp al 633 69 77 43.';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas nueve fotografías, así que no se inventa una
 * descripción y todos los `alt` avisan solo de dónde salen.
 */
const altFoto =
	'Fotografía publicada en la ficha de Google Maps de Floristerías Alfredo, en Madrid';
const altOg = 'Fotografía de Floristerías Alfredo publicada en su ficha de Google Maps';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#4a1f2b" />
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="Floristerías Alfredo, floristería Madrid, Salamanca, Pl. de Venecia, ramos personalizados, entrega de flores"
		/>
		<meta name="author" content={business.shortName} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-MD" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/floristerias-alfredo/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400;1,6..96,500&family=Figtree:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.shortName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(floristSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.shortName}, inicio`}>
				<span class="brand-mark" aria-hidden="true">A</span>
				<span class="brand-text">
					Floristerías Alfredo
					<small>Salamanca · Madrid</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La floristería</a>
				<a href="#pedidos">Pedidos</a>
				<a href="#fotos">Fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phoneDisplay}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Floristería · Salamanca, Madrid</p>
						<h1 id="hero-title">
							Floristerías Alfredo,
							<em>flores con nombre propio.</em>
						</h1>
						<p class="hero-lede">
							Flores frescas, ramos personalizados y arreglos florales en la
							<strong>{business.streetAddress}</strong>, en el distrito de Salamanca. Google lo
							clasifica como floristería, entrega de flores y tienda de regalos. Los pedidos se
							hacen <strong>por WhatsApp</strong>.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
								Pedir por WhatsApp <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={phoneHref}>Llamar al {business.phoneDisplay}</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode}
									{business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Pedidos</small>
								<strong>WhatsApp {business.phoneDisplay}</strong>
							</li>
						</ul>
					</div>

					<div class="hero-media">
						<figure class="media-tall">
							<Image
								src={foto('floristerias-alfredo-vertical-05.jpg')}
								alt={altFoto}
								widths={[420, 620, 820]}
								sizes="(max-width: 1080px) 92vw, 44vw"
								format="webp"
								quality={68}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
							<figcaption>La floristería</figcaption>
						</figure>
						<figure class="media-wide">
							<Image
								src={foto('floristerias-alfredo-apaisada-01.jpg')}
								alt={altFoto}
								widths={[420, 620, 820]}
								sizes="(max-width: 1080px) 92vw, 44vw"
								format="webp"
								quality={68}
								loading="eager"
								decoding="async"
							/>
							<figcaption>Pl. de Venecia · Madrid</figcaption>
						</figure>
					</div>
				</div>
			</section>

			<div class="band" aria-label="Datos rápidos de Floristerías Alfredo">
				<span>Floristería · Entrega de flores · Regalos</span>
				<span>{business.streetAddress} · {business.postalCode} {business.city}</span>
				<span>Lun–sáb 9:30–19:30 · Dom 9:00–14:30</span>
				<span>WhatsApp {business.phoneDisplay}</span>
			</div>

			<section class="section casa" id="casa" aria-labelledby="casa-title">
				<div class="wrap">
					<p class="kicker">La floristería</p>
					<h2 class="title" id="casa-title">
						Flores frescas,
						<br />
						<em>ramos personalizados.</em>
					</h2>
					<p class="lead">
						Así se presenta el negocio en su ficha de Google Maps. Reproducimos su descripción
						tal cual, sin añadir servicios ni promesas que no estén escritas allí.
					</p>

					<div class="casa-grid">
						<div>
							<figure class="casa-photo">
								<Image
									src={foto('floristerias-alfredo-apaisada-02.jpg')}
									alt={altFoto}
									widths={[420, 620, 820]}
									sizes="(max-width: 1080px) 92vw, 36vw"
									format="webp"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
							</figure>
							<ul class="tags" aria-label="Categorías publicadas por Google">
								{business.categories.map((categoria) => <li>{categoria}</li>)}
							</ul>
							<p class="owner-note">
								Descripción literal del titular publicada en la ficha de Google Maps
								(consultada el {site.consultado}).
							</p>
						</div>

						<div class="owner-copy">
							<p>{intro}</p>
							<p>{rapida}</p>
							<p>{serviciosTitulo}</p>
							<ul class="servicios">
								{servicios.map((servicio) => <li>{servicio}</li>)}
							</ul>
							<p>
								{pedidosTitulo}
								<br />
								<a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
									{business.phone}
								</a>
							</p>
						</div>
					</div>
				</div>
			</section>

			<section class="pedidos" id="pedidos" aria-labelledby="pedidos-title">
				<div class="wrap pedidos-grid">
					<div>
						<p class="kicker">Pedidos</p>
						<h2 class="title" id="pedidos-title">
							Se pide
							<br />
							<em>por WhatsApp.</em>
						</h2>
						<p class="lead">
							Es lo que indica el propio negocio en su descripción: atención personalizada y
							preparación rápida de ramos por WhatsApp. Desde aquí abres la conversación con el
							número publicado, sin formularios ni carrito.
						</p>
						<div class="pedidos-actions">
							<a class="btn btn-solid" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
								Escribir por WhatsApp <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={phoneHref}>Llamar al {business.phoneDisplay}</a>
						</div>
					</div>

					<aside class="pedidos-card" aria-label="Horario y contacto">
						<small>WhatsApp y teléfono</small>
						<strong>{business.phoneDisplay}</strong>
						<p>
							El número que la ficha publica como teléfono y que la descripción del titular
							indica para pedidos y consultas.
						</p>
						<div class="hours-mini">
							<div><span>Lunes a sábado</span><span>9:30 – 19:30</span></div>
							<div><span>Domingo</span><span>9:00 – 14:30</span></div>
						</div>
					</aside>
				</div>
			</section>

			<section class="section" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						La floristería <em>en nueve imágenes.</em>
					</h2>
					<p class="lead">
						Son las nueve fotografías que Floristerías Alfredo publica en su ficha de Google
						Maps. El manifiesto de la descarga no atribuye ninguna a un autor con nombre, así que
						se publican sin pie y sin atribución. La ficha no describe su contenido y aquí no se
						inventa ninguna descripción.
					</p>
					<div class="fotos-grid">
						{galeria.map((name, index) => (
							<figure class:list={['foto', { 'foto-wide': index === 0 }]}>
								<Image
									src={foto(name)}
									alt={altFoto}
									widths={index === 0 ? [640, 900, 1200] : [380, 560, 800]}
									sizes={
										index === 0
											? '(max-width: 700px) 92vw, (max-width: 1080px) 62vw, 58vw'
											: '(max-width: 700px) 45vw, (max-width: 1080px) 30vw, 28vw'
									}
									format="webp"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>{String(index + 1).padStart(2, '0')}</figcaption>
							</figure>
						))}
					</div>
					<p class="fotos-note">
						La ficha no publica catálogo ni precios, así que esta web no los reproduce. Para
						encargar flores, escribe o llama al{' '}
						<a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
							{business.phoneDisplay}
						</a>{' '}
						o mira las fotos de la{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section visita" id="horario" aria-labelledby="horario-title">
				<div class="wrap visita-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Pl. de Venecia,
							<br />
							<em>28028 Madrid.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.district} · {business.province}
						</address>

						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							Es el horario de la ficha consultada el {site.consultado}. Conviene confirmarlo
							antes de ir.
						</p>

						<ul class="access-list" aria-label="Accesibilidad publicada en la ficha">
							{accesibilidad.map((item) => (
								<li class:list={[{ 'is-yes': item.disponible }]}>{item.label}</li>
							))}
						</ul>
						<p class="access-note">
							La ficha marca las cinco entradas como no disponibles. Se reproduce el dato tal
							cual.
						</p>

						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phoneDisplay}</strong>
						</a>

						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>

					<div class="map-card">
						<div class="map-frame">
							<iframe
								title={`Mapa de ${business.shortName} en ${business.city}`}
								src={mapEmbedUrl}
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
								allowfullscreen></iframe>
						</div>
						<div class="map-tag">
							<div>
								<strong>Floristerías Alfredo</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>escribir.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.shortName}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">A</span>
					<span>
						Floristerías Alfredo
						<small>{business.streetAddress} · {business.postalCode} {business.city}</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
						WhatsApp {business.phoneDisplay} ↗
					</a>
					<a href={phoneHref}>Llamar al {business.phoneDisplay}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Floristerías Alfredo · {business.streetAddress}
					({business.postalCode} {business.city}). Web informativa elaborada con los datos, la
					descripción y las fotografías que el local publica en su ficha de Google Maps, consultada
					el {site.consultado}. No es su web oficial y no vende nada.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/floristerias-alfredo/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/floristerias-alfredo/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/floristerias-alfredo/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
			Pedir por WhatsApp <span>{business.phoneDisplay}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/floristerias-alfredo/aviso-legal">Aviso legal</a>
			<a href="/floristerias-alfredo/aviso-legal#privacidad">Privacidad</a>
			<a href="/floristerias-alfredo/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
