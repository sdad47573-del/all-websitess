---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/pico-de-oro-vista-1-01.jpg';
import pollosBrasa from '../assets/fotos/pico-de-oro-cuadrada-06.jpg';
import parrilla from '../assets/fotos/pico-de-oro-apaisada-07.jpg';
import migas from '../assets/fotos/pico-de-oro-apaisada-02.jpg';
import vitrina from '../assets/fotos/pico-de-oro-apaisada-05.jpg';
import tortilla from '../assets/fotos/pico-de-oro-vertical-08.jpg';
import platoCordero from '../assets/fotos/pico-de-oro-apaisada-04.jpg';
import corderoHorno from '../assets/fotos/pico-de-oro-apaisada-10.jpg';
import corderoAliño from '../assets/fotos/pico-de-oro-apaisada-03.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, REVIEWS, SERVICIOS } from '../data/site';

const title = 'Pico de Oro · Pollo al carbón en Bormujos, Sevilla';
const description = BUSINESS.description;

const galeria = [
	{
		src: pollosBrasa,
		alt: 'Pollos ensartados asándose sobre las brasas en la parrilla de carbón del local',
	},
	{
		src: parrilla,
		alt: 'Parrilla con carne y pollos sobre la brasa encendida, en la cocina de Pico de Oro',
	},
	{
		src: migas,
		alt: 'Perola grande de migas con tropezones de chorizo y panceta, el plato de los domingos',
	},
	{
		src: vitrina,
		alt: 'Vitrina del local con tortillas, huevos rellenos, solomillo al whisky y albóndigas en salsa',
	},
	{
		src: tortilla,
		alt: 'Tortilla de patatas entera con cebolla y pimiento, recién cuajada y dorada por arriba',
	},
	{
		src: platoCordero,
		alt: 'Plato de carne asada con patatas panadera y verduras salteadas',
	},
	{
		src: corderoHorno,
		alt: 'Paletilla de cordero asándose en el horno, dorada por fuera y jugosa por dentro',
	},
	{
		src: corderoAliño,
		alt: 'Paletilla de cordero aliñada en bandeja con piña, aceite y especias, lista para el horno',
	},
];

const carta = [
	{
		title: 'Del carbón',
		items: [
			{ name: 'Pollo al carbón', note: 'la especialidad de la casa, asado sobre brasa' },
			{ name: 'Carnes a la brasa', note: 'lo que el negocio anuncia junto al pollo en su fachada' },
			{ name: 'Pollo asado para llevar', note: 'la ficha lo clasifica también como pollería' },
		],
	},
	{
		title: 'Freiduría',
		items: [
			{ name: 'Pescados fritos', note: 'el otro pilar de la casa, según su propia descripción' },
			{ name: 'Fritura para compartir', note: 'la carta de freiduría se pide por raciones en el local' },
		],
	},
	{
		title: 'Cuchara y arroces',
		items: [
			{ name: 'Arroces', note: 'en la descripción del negocio' },
			{ name: 'Paellas', note: 'por encargo, con días de antelación' },
			{ name: 'Comidas caseras', note: 'el plato del día según temporada' },
			{ name: 'Migas', note: 'solo los domingos' },
		],
	},
	{
		title: 'Barra y vitrina',
		items: [
			{ name: 'Tapas', note: 'la ficha lo clasifica como bar de tapas' },
			{ name: 'Tortillas', note: 'enteras en la vitrina del local' },
			{ name: 'Huevos rellenos', note: 'vistos en la vitrina, junto a la tortilla' },
			{ name: 'Solomillo al whisky', note: 'uno de los guisos de la vitrina' },
			{ name: 'Albóndigas en salsa', note: 'el otro guiso que aparece en la bandeja' },
		],
	},
	{
		title: 'Horno y dulce',
		items: [
			{ name: 'Asados al horno', note: 'como la paletilla que aparece en las fotos del perfil' },
			{ name: 'Pastelería', note: 'categoría con la que Google clasifica el local' },
			{ name: 'Panadería', note: 'también figura como panadería en la ficha' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#pico-de-oro`,
	name: BUSINESS.fullName,
	alternateName: ['Pico de Oro', 'Pico de Oro Bormujos', 'Pollos al carbón Pico de Oro'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Andaluza', 'Pollo al carbón', 'Pescados fritos', 'Comida casera'],
	areaServed: { '@type': 'City', name: 'Bormujos' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.province,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	foundingDate: '2020-10-14',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Thursday', 'Sunday'],
			opens: '19:00',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '19:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Tuesday',
			opens: '10:30',
			closes: '15:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#161009" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,600;0,700;1,600&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Pico de Oro Bormujos, pollo al carbón Bormujos, freiduría Bormujos, pescados fritos Sevilla, migas domingos Bormujos, comida casera 41930, Pablo Coso Calero 107, pollos asados Bormujos"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo al carbón, pescados fritos, arroces y comida casera en la calle Pablo Coso Calero 107, Bormujos. Todos los días de 10:30 a 16:00 y de 19:00 a 23:30; miércoles cerrado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Pico de Oro con los letreros de pollos asados, freiduría y tapas en Bormujos"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#161009"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.province}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Calle Pablo Coso Calero, Bormujos"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/pico-de-oro/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Pico de Oro"
			subtitle="Pollo al carbón · freiduría"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title={piezas.portada.titulo}
				lede="Pico de Oro es la freiduría y pollería de la calle Pablo Coso Calero 107, en Bormujos. Abrió el 14 de octubre de 2020 y desde entonces sirve pollo al carbón, pescados fritos, arroces, tapas y comida casera, con migas los domingos. Abre todos los días en dos turnos, de 10:30 a 16:00 y de 19:00 a 23:30: el martes solo al mediodía y el miércoles cierra. Reparte a domicilio con Glovo y Uber Eats."
				image={fachada}
				imageAlt="Fachada de Pico de Oro en la calle Pablo Coso Calero, con los letreros de pollos asados, freiduría y tapas"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,0</b> en Google · 163 reseñas' },
					{ label: 'Horario', html: '<b>10:30–16:00</b><br />y 19:00–23:30 · miércoles cerrado' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> pedidos y encargos` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Pico de Oro" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Desde 2020, <br /><em>a la brasa.</em>"
				paragraphs={[
					'Pico de Oro abrió en la calle Pablo Coso Calero 107 de Bormujos el 14 de octubre de 2020, en plena pandemia, como freiduría y pollería. El nombre completo de la ficha es Freiduría y Pollos al Carbón Pico de Oro, y la fachada lo resume en tres palabras: pollos asados, carnes y tapas.',
					'La casa se define como especialista en pollo al carbón, pescados fritos, arroces, comidas caseras, tapas y paellas. Los domingos añade migas, y la descripción de su ficha invita a encargar paellas y comidas para eventos con días de antelación.',
					'El horario es partido: de 10:30 a 16:00 y de 19:00 a 23:30, de lunes a domingo. El martes solo abre al mediodía, de 10:30 a 15:00, y el miércoles figura cerrado por descanso. Viernes y sábado alargan la noche hasta las 24:00.',
					'El reparto va con Glovo y Uber Eats, de lunes a domingo de 11:00 a 16:00 y de 18:30 a 23:30, según cuenta el propio negocio en su ficha. También hay terraza para degustar, en colaboración con el Café Bar Bohemia.',
				]}
				note="La ficha no publica carta con precios ni dominio propio: el campo de web apunta a un enlace corto de Google. Los platos de esta página salen de la descripción que firma el negocio, de las categorías de Google y de lo que se ve en las fotos de su perfil."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Lo que sale <br /><em>de la cocina.</em>"
				description="Sin precios publicados en la ficha, así que aquí van los platos y las familias de la carta que anuncia el propio negocio, sin inventar importes."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={carta}
				note="Esta lista sale de la descripción del negocio en Google, de las categorías con las que Google lo clasifica y de lo que se ve en las fotos de su perfil. No hay precios públicos: se confirman en el local o por teléfono. Paellas, asados y encargos para eventos se piden con días de antelación."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
					<div class="reviews-head">
						<h2 id="resenas-title">Cuatro sobre cinco, <br /><em>163 veces.</em></h2>
						<p>
							La ficha tiene 163 reseñas y una media de 4,0. Estas son las tres que Google destaca, con
							la puntuación que les dio su autor, la buena y la mala. En la ficha están todas.
						</p>
					</div>
					<div class="review-grid">
						{
							REVIEWS.map((review) => (
								<figure class="review-card">
									<p class="review-stars" aria-label={`${review.rating} sobre 5`}>
										{'★'.repeat(review.rating)}
										<span aria-hidden="true">{'★'.repeat(5 - review.rating)}</span>
									</p>
									<blockquote>{review.quote}</blockquote>
									<figcaption>Reseña publicada en Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="review-note">
						Citas de las reseñas públicas del local, con la puntuación del autor y la puntuación del
						texto normalizada. En la ficha de Google están todas, incluidas las críticas.
					</p>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Ocho fotos <br /><em>de la casa.</em>"
				description="Del perfil del local: el pollo girando sobre la brasa, la perola de migas, la vitrina de guisos y los asados al horno."
				images={galeria}
				cta={{ label: 'Ver todas en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a <br /><em>Bormujos.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.province}, España`,
				]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google. El martes solo abre al mediodía y el miércoles cierra por descanso. En festivos suele abrir, según el propio negocio, pero conviene confirmarlo por teléfono."
				mapTitle="Mapa de Pico de Oro en la calle Pablo Coso Calero 107, Bormujos"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Pico de Oro"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="El reparto va con Glovo y Uber Eats, de 11:00 a 16:00 y de 18:30 a 23:30. Para paellas, asados o comida de un evento, el propio negocio pide encargarlo con días de antelación por teléfono. Esta página no tramita pedidos ni reservas."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Pico de Oro"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías tomados de la ficha y del perfil públicos del local en Google Maps. Sin carta de precios publicada: confirma disponibilidad, horario y reparto antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Pico de Oro"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34614108496?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Pollo%20al%20carb%C3%B3n." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Pollo al carbón"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
