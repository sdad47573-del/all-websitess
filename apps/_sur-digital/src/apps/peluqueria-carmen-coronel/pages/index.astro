---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import { business, directionsUrl, mapEmbedUrl, mapsUrl, phoneHref, photoUrl, structuredData } from '../lib/business';
import Galeria from '../components/Galeria.astro';

const title = 'Peluquería Carmen Coronel | Peluquería en Málaga';
const description =
	'Peluquería Carmen Coronel en Málaga. Estamos en avenida de Carlos Haya, 186, bloque 1, local 2. Llama al 637 51 12 64 y consulta cómo llegar.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#402333" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/peluqueria-carmen-coronel/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={photoUrl} />
		<meta property="og:image:alt" content="Imagen de la ficha de Peluquería Carmen Coronel en Google Maps" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={photoUrl} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7244393;-4.4555305" />
		<meta name="ICBM" content="36.7244393, -4.4555305" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Peluquería Carmen Coronel, inicio">
				<span class="brand-mark" aria-hidden="true">CC</span>
				<span class="brand-name">Carmen Coronel <small>Peluquería · Málaga</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#salon">El salón</a>
				<a href="#ubicacion">Ubicación</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}><span aria-hidden="true">↗</span> 637 51 12 64</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Avda. Carlos de Haya · Málaga</p>
					<h1 id="hero-title">Peluquería<br /><em>Carmen Coronel</em></h1>
					<p class="hero-lede">Un salón en Málaga, en la avenida de Carlos de Haya. Llámanos para consultar disponibilidad y organizar tu visita.</p>
					<div class="hero-actions">
						<a class="button button-rose" href={phoneHref}><span aria-hidden="true">↗</span> Llamar al salón</a>
						<a class="button button-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-address">
						<span class="address-mark" aria-hidden="true">⌖</span>
						<span><small>VISÍTANOS EN</small><strong>{business.streetAddress}</strong></span>
					</div>
				</div>
				<figure class="hero-photo">
					<div class="photo-frame">
						<span class="photo-index">CARMEN CORONEL <i>·</i> MÁLAGA</span>
						<img
							src={photoUrl}
							alt="Fotografía de Peluquería Carmen Coronel publicada en su perfil de Google Maps"
							width="920"
							height="1190"
							fetchpriority="high"
							decoding="async"
						/>
						<span class="photo-edge" aria-hidden="true"></span>
					</div>
					<figcaption><span>Foto de la ficha de Google Maps</span><a href={mapsUrl} target="_blank" rel="noreferrer">Ver galería ↗</a></figcaption>
				</figure>
				<div class="hero-sun" aria-hidden="true"></div>
			</section>

			<section class="salon-band" id="salon" aria-label="Peluquería Carmen Coronel en Málaga">
				<p><span>UN SALÓN EN</span><strong>Bailén-Miraflores</strong></p>
				<span class="band-divider" aria-hidden="true"></span>
				<p><span>ENCUÉNTRANOS EN</span><strong>Avda. Carlos de Haya, 186</strong></p>
				<span class="band-divider" aria-hidden="true"></span>
				<a href={phoneHref}><span>LLÁMANOS</span><strong>637 51 12 64 ↗</strong></a>
			</section>

			<section class="visit section-pad" id="ubicacion" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="eyebrow dark"><span aria-hidden="true"></span> Encuentra el salón</p>
					<h2 id="visit-title">Te esperamos<br /><em>en Carlos Haya.</em></h2>
					<p class="visit-lede">Peluquería Carmen Coronel está en la avenida de Carlos Haya, en Málaga. Contacta directamente para consultar horarios y disponibilidad.</p>
					<address>
						<span class="pin-icon" aria-hidden="true">⌖</span>
						<span><strong>{business.streetAddress}</strong><small>{business.postalCode} {business.city}, España</small></span>
					</address>
					<a class="phone-link" href={phoneHref}><small>TELÉFONO</small><strong>637 51 12 64</strong></a>
					<div class="visit-actions">
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
						<a class="text-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha de Google Maps ↗</a>
					</div>
				</div>
				<div class="map-shell">
					<div class="map-label"><span><i aria-hidden="true"></i> UBICACIÓN</span><span>MÁLAGA · ES</span></div>
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
						title="Mapa de Peluquería Carmen Coronel, avenida de Carlos Haya 186, Málaga"
					 src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-tag" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Carmen Coronel · Málaga</a>
				</div>
			</section>
			<Galeria nombre="Peluquería Carmen Coronel" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio" aria-label="Peluquería Carmen Coronel, volver al inicio">
				<span class="brand-mark" aria-hidden="true">CC</span>
				<span class="brand-name">Carmen Coronel <small>Peluquería · Málaga</small></span>
			</a>
			<p>{business.streetAddress} · {business.city}</p>
			<a class="footer-phone" href={phoneHref}>637 51 12 64 <span aria-hidden="true">↗</span></a>
			<small>© {new Date().getFullYear()} {business.name}. Información de contacto y ubicación.</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
	<a href="/peluqueria-carmen-coronel/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
	<a href="/peluqueria-carmen-coronel/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
	<a href="/peluqueria-carmen-coronel/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
</nav>
</footer>

		<a class="mobile-call" href={phoneHref}><span aria-hidden="true">↗</span> Llamar a Carmen <strong>637 51 12 64</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/peluqueria-carmen-coronel/aviso-legal">Aviso legal</a>
					<a href="/peluqueria-carmen-coronel/aviso-legal#privacidad">Privacidad</a>
					<a href="/peluqueria-carmen-coronel/aviso-legal#cookies">Cookies</a>
				</nav>
						<WhatsappFab phone={datos.phoneHref} name={datos.business?.name} />
						</body>
</html>


