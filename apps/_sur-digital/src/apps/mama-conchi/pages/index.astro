---
import { Image } from 'astro:assets';

const MAPS_URL =
  'https://www.google.com/maps/place/Mama+Conchi/@40.3858894,-3.6420046,17z/data=!3m1!4b1!4m6!3m5!1s0xd4225e94dd0d0fd:0x8fc9d72f78e7c2e9!8m2!3d40.3858894!4d-3.6420046!16s%2Fg%2F11h056t8tk?authuser=0&hl=es&entry=ttu&g_ep=EgoyMDI2MTAyNy4wIKXMDSoASAFQAw%3D%3D';

const photoModules = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.jpg', {
  eager: true,
});
const photos = Object.keys(photoModules)
  .sort()
  .map((path) => photoModules[path].default);
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mama Conchi</title>
    <style>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        color: #1f2937;
        background: #fafafa;
      }
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1rem;
      }
      h1 {
        margin: 0 0 0.5rem;
      }
      .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 0.75rem;
        margin-top: 1.5rem;
      }
      .gallery img {
        width: 100%;
        height: auto;
        border-radius: 8px;
        display: block;
      }
      footer {
        border-top: 1px solid #e5e7eb;
        padding: 1.5rem 1rem;
        text-align: center;
        font-size: 0.875rem;
        color: #6b7280;
      }
      footer a {
        color: inherit;
      }
    </style>
  <script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"@id": "https://www.sur-digital.com/mama-conchi/#negocio",
	"name": "Mama conchi",
	"url": "https://www.sur-digital.com/mama-conchi/",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 40.3858894,
		"longitude": -3.6420046
	},
	"hasMap": "https://www.google.com/maps/place/Mama+Conchi/@40.3858894,-3.6420046,17z/data=!3m1!4b1!4m6!3m5!1s0xd4225e94dd0d0fd:0x8fc9d72f78e7c2e9!8m2!3d40.3858894!4d-3.6420046!16s%2Fg%2F11h056t8tk?authuser=0&hl=es&entry=ttu&g_ep=EgoyMDI2MTAyNy4wIKXMDSoASAFQAw%3D%3D"
}
</script>
		<meta property="og:image" content="https://www.sur-digital.com/mama-conchi/og.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta property="og:url" content="https://www.sur-digital.com/mama-conchi/" />
		<meta property="og:locale" content="es_ES" />
			<meta property="og:title" content="Mama Conchi" />
	</head>
  <body>
    <main>
      <h1 set:html={piezas.portada.titulo} />
      <p><a href={MAPS_URL} rel="noopener">Ver en Google Maps</a></p>
      <section class="gallery">
        {photos.map((photo) => <Image src={photo} alt="Mama Conchi" loading="lazy" />)}
      </section>
    </main>
    <footer>
      <p>Web creada por <a href="https://www.sur-digital.com" rel="noopener">Sur Digital</a></p>
    </footer>
  </body>
</html>
