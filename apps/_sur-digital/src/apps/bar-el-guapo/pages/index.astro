---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/bar-el-guapo-apaisada-01.jpg';
import embutidos from '../assets/fotos/bar-el-guapo-apaisada-03.jpg';
import patatas from '../assets/fotos/bar-el-guapo-apaisada-05.jpg';
import ensalada from '../assets/fotos/bar-el-guapo-apaisada-07.jpg';
import comedor from '../assets/fotos/bar-el-guapo-apaisada-08.jpg';
import pollo from '../assets/fotos/bar-el-guapo-vertical-04.jpg';
import calamares from '../assets/fotos/bar-el-guapo-vertical-06.jpg';
import tarta from '../assets/fotos/bar-el-guapo-vertical-09.jpg';
import cafe from '../assets/fotos/bar-el-guapo-vertical-10.jpg';

import Footer from '../components/Footer.astro';
import { BUSINESS, FAQ, HOURS, MAPS, MENU, NAV, SERVICIOS } from '../data/site';

const title = 'Bar El Guapo · Parrilla y carne a la brasa en Santa Cruz';
const description =
	'Bar El Guapo, parrilla y carne a la brasa en la Orilla del Azarbe, 64 (Santa Cruz, Murcia). Abre todos los días desde las 8:00. Llama al 968 85 04 30.';

const galeria = [
	{ src: fachada, alt: 'Fachada de Bar El Guapo en la Orilla del Azarbe, Santa Cruz de Murcia' },
	{ src: pollo, alt: 'Pollo a la brasa servido en bandeja con limón en Bar El Guapo, Murcia' },
	{ src: embutidos, alt: 'Tabla de embutidos con jamón, chorizo, mortadela y queso de Bar El Guapo' },
	{ src: patatas, alt: 'Patatas asadas con alioli de Bar El Guapo, Santa Cruz de Murcia' },
	{ src: ensalada, alt: 'Ensalada mixta con atún, huevo, maíz y aceitunas de Bar El Guapo' },
	{ src: calamares, alt: 'Calamares a la brasa con ensalada en Bar El Guapo, Santa Cruz de Murcia' },
	{ src: comedor, alt: 'Comedor de Bar El Guapo con mesas y manteles naranjas, Santa Cruz' },
	{ src: tarta, alt: 'Tarta de queso con frutos rojos de Bar El Guapo, Murcia' },
	{ src: cafe, alt: 'Café en vaso con el sobre de Bar El Guapo, en Santa Cruz de Murcia' },
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'BarOrPub',
	'@id': `${BUSINESS.siteUrl}/#bar`,
	name: BUSINESS.name,
	alternateName: ['El Guapo', 'Bar El Guapo Santa Cruz', 'Bar El Guapo Murcia'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34968850430',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Parrilla', 'Barbacoa', 'Cocina murciana'],
	areaServed: [
		{ '@type': 'City', name: 'Santa Cruz de Murcia' },
		{ '@type': 'AdministrativeArea', name: 'Región de Murcia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday'],
			opens: '08:00',
			closes: '18:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Friday', 'Saturday'],
			opens: '08:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '08:00',
			closes: '19:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#7c2a1a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Bar El Guapo, Bar El Guapo Murcia, parrilla Santa Cruz Murcia, carne a la brasa Murcia, pollo asado Santa Cruz, Orilla del Azarbe, bar Santa Cruz de Murcia, comer a la brasa Murcia, merendero Murcia"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Bar El Guapo · Parrilla en Santa Cruz de Murcia"
			ogDescription="Carne y pollo a la brasa, embutidos, ensaladas y postres en la Orilla del Azarbe, 64 (Santa Cruz, Murcia). Abre todos los días desde las 8:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Bar El Guapo, parrilla en la Orilla del Azarbe, Santa Cruz de Murcia"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#7c2a1a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			postalCode={BUSINESS.postalCode}
			phone="+34968850430"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Santa Cruz de Murcia"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/bar-el-guapo/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Parrilla · Santa Cruz de Murcia"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={NAV}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carr. Orilla del Azarbe, 64 · Santa Cruz"
				title="Carne a la brasa<br /><em>en la huerta de Murcia.</em>"
				lede={`Bar El Guapo es un bar de carretera con parrilla en la Orilla del Azarbe, en Santa Cruz (Murcia). Pollo y carne a la brasa, embutidos, ensaladas y postres. Abre todos los días desde las 8:00; se llama al ${BUSINESS.phoneDisplay}.`}
				image={fachada}
				imageAlt="Fachada de Bar El Guapo con el cartel de carne a la brasa, en Santa Cruz de Murcia"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount.toLocaleString('es-ES')} reseñas)`,
					},
					{ label: 'Horario', html: 'Todos los días · desde las 8:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phoneDisplay}</b>` },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Bar El Guapo" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un bar de carretera<br /><em>con parrilla.</em>"
				paragraphs={[
					`Bar El Guapo está en la carretera de la Orilla del Azarbe, 64, en Santa Cruz (30162, Murcia), junto al canal del Azarbe, con la huerta a un lado y la ciudad al otro.`,
					'La casa es una parrilla: el cartel de la fachada anuncia «carne a la brasa» y la ficha de Google la clasifica como parrilla, bar y restaurante especializado en barbacoa. En sus fotos aparecen el pollo asado, los calamares a la brasa, la tabla de embutidos, la ensalada mixta, las patatas con alioli y la tarta de queso.',
					'El comedor es amplio, con mesas grandes y manteles naranjas, de los de comer sin prisa. No hay carta ni precios publicados, así que esta web no los inventa: cuenta lo que se ve en la ficha y lo que dicen sus clientes.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount.toLocaleString('es-ES')} opiniones en Google. Las reseñas destacan la carne a la brasa con patatas asadas y el pollo: «buena cocina, buen servicio, buen ambiente y buena gente».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.cid, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La brasa"
				title="De la parrilla<br /><em>a la mesa.</em>"
				description="Resumen de lo que se ve en las fotos de la ficha de Google y de lo que citan sus reseñas. No es la carta completa: el bar no publica platos ni precios."
				cta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note={`La brasa manda, pero la carta cambia con el día. Si vas por algo concreto, llama antes al ${BUSINESS.phoneDisplay}; aquí no publicamos precios porque el bar no los tiene publicados.`}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La brasa<br /><em>y la mesa.</em>"
				description="Fotografías del perfil de Bar El Guapo en Google Maps: la fachada, el comedor y los platos que salen de la parrilla."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del bar en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Nos vemos<br /><em>en la Orilla del Azarbe.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario publicado en la ficha de Google (octubre de 2026): abre todos los días a las 8:00. Lunes, martes y jueves cierra a las 18:00; miércoles, viernes y sábado hasta medianoche, y el domingo a las 19:00. En fiestas conviene llamar antes."
				mapTitle="Mapa de Bar El Guapo en la carretera de la Orilla del Azarbe, 64, Santa Cruz de Murcia"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Bar El Guapo · Santa Cruz"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se habla con el bar por teléfono. La ficha de Google indica acceso, aparcamiento, aseo y asientos adaptados para sillas de ruedas. Para grupos y fines de semana, mejor llamar con antelación."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de<br /><em>venir.</em>" />
		</main>

		<Footer />
	</body>
</html>
