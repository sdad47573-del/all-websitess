---
import { BUSINESS, MAPS, NAV } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap">
		<div class="footer-grid">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">{BUSINESS.mark}</span>
				<p>
					{BUSINESS.name}
					<small>{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}</small>
					<small>Parrilla y carne a la brasa · {BUSINESS.regionName}</small>
				</p>
			</div>

			<nav aria-label="Enlaces de la web">
				{NAV.map((item) => <a href={item.href}>{item.label}</a>)}
				<a href="/bar-el-guapo/aviso-legal">Aviso legal</a>
			</nav>

			<div class="footer-contact">
				<a href={BUSINESS.phoneHref}>{BUSINESS.phoneDisplay}</a>
				<p>
					Lunes, martes y jueves · 8:00–18:00
					<br />
					Miércoles a sábado · hasta las 24:00
					<br />
					Domingo · 8:00–19:00
				</p>
				<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
			</div>
		</div>

		<small class="legal">
			© {year} {BUSINESS.name} · {BUSINESS.city} ({BUSINESS.region}). Fotografías procedentes de la
			ficha del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas:
			confirma horarios y carta antes de la visita.
		</small>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/bar-el-guapo/aviso-legal">Aviso legal</a>
			<a href="/bar-el-guapo/aviso-legal#privacidad">Privacidad</a>
			<a href="/bar-el-guapo/aviso-legal#cookies">Cookies</a>
			<a href={MAPS.place} target="_blank" rel="noreferrer">Ficha en Google Maps ↗</a>
		</nav>

		<p class="credit">
			<small>
				Creado por Sur Digital ·
				<a href="https://www.sur-digital.com/" target="_blank" rel="noopener noreferrer">
					www.sur-digital.com
				</a>
			</small>
		</p>
	</div>
</footer>

<a class="mobile-call" href={BUSINESS.phoneHref}>
	Llamar a Bar El Guapo <span>{BUSINESS.phoneDisplay}</span>
</a>
