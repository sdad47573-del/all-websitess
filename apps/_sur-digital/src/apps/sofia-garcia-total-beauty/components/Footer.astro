---
import { BUSINESS, NAV, PAGE_NAV } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-neutral text-neutral-content">
	<div class="mx-auto max-w-7xl px-4 py-12 pb-40 sm:px-6 md:pb-24 lg:px-8 lg:pb-28">
		<div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
			<div class="lg:col-span-2">
				<a href="/sofia-garcia-total-beauty/#inicio" class="flex items-center gap-3" aria-label={`${BUSINESS.name}, inicio`}>
					<span
						class="bg-primary font-display text-primary-content flex size-11 items-center justify-center rounded-full text-lg font-extrabold"
						>TB</span
					>
					<span>
						<span class="font-display block text-xl font-bold text-white">{BUSINESS.name}</span>
						<span class="text-xs tracking-[0.2em] text-white/50 uppercase">
							Teatinos-Universidad · Málaga
						</span>
					</span>
				</a>
				<p class="mt-5 max-w-md text-sm leading-relaxed text-white/70">{BUSINESS.summary}</p>
				<p class="mt-4 text-xs leading-relaxed text-white/50">
					Citas de lunes a viernes con hora reservada. Google todavía no publica el horario del
					salón: confírmalo por WhatsApp o por teléfono antes de desplazarte.
				</p>
			</div>
			<div>
				<h2 class="font-display text-lg font-semibold text-white">Secciones</h2>
				<ul class="mt-4 space-y-2 text-sm text-white/70">
					{
						NAV.map((item) => (
							<li>
								<a href={`/${item.href}`} class="hover:text-secondary transition-colors">
									{item.label}
								</a>
							</li>
						))
					}
					{
						PAGE_NAV.map((item) => (
							<li>
								<a href={item.href} class="hover:text-secondary transition-colors">
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<h2 class="font-display text-lg font-semibold text-white">Contacto y ubicación</h2>
				<address class="mt-4 space-y-3 text-sm text-white/70 not-italic">
					<p>
						{BUSINESS.street}<br />{BUSINESS.postalCode}
						{BUSINESS.district}<br />{BUSINESS.city}
					</p>
					<p>
						<a href={BUSINESS.phoneHref} class="hover:text-secondary">{BUSINESS.phoneDisplay}</a>
					</p>
					<p>
						<a
							href={BUSINESS.instagram}
							target="_blank"
							rel="noopener noreferrer"
							class="hover:text-secondary">Instagram</a
						>
					</p>
					<p>
						<a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="hover:text-secondary">Abrir ficha en Google Maps</a
						>
					</p>
				</address>
			</div>
		</div>
		<div
			class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 text-xs text-white/50 sm:flex-row"
		>
			<p>© {year} {BUSINESS.name}.</p>
			<div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
				<a href="/sofia-garcia-total-beauty/aviso-legal" class="hover:text-secondary transition-colors"
					>Aviso legal y privacidad</a
				>
				<a
					href="/sofia-garcia-total-beauty/aviso-legal#cookies"
					class="hover:text-secondary transition-colors underline underline-offset-2">Cookies</a
				>
				<p class="text-white/60">
					Web creada por <a
						href="https://sur-digital.vercel.app/"
						rel="noopener"
						class="text-white/80 underline underline-offset-2 transition-colors hover:text-secondary"
						>Sur Digital</a
					>
				</p>
			</div>
		</div>
	</div>
</footer>
