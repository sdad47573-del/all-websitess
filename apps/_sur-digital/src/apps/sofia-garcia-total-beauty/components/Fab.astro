---
import { BUSINESS } from '../data/site';
---

<a
	href={BUSINESS.whatsapp}
	target="_blank"
	rel="noopener noreferrer"
	class="btn btn-primary btn-lg fixed right-4 bottom-4 z-40 gap-2 rounded-full shadow-xl lg:hidden"
	aria-label={`Pedir cita en ${BUSINESS.name} por WhatsApp`}
>
	<i class="ri-whatsapp-fill text-xl" aria-hidden="true"></i>
	Pedir cita
</a>
