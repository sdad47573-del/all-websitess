---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	business,
	directionsUrl,
	faqSchema,
	faqs,
	floristSchema,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Ars Floristeria · Floristería en Usera, Madrid';
const description =
	'Ars Floristeria, floristería en la Calle de Antonio López, 154, Usera (Madrid). 4 sobre 5 con 25 reseñas en Google Maps. Abre todos los días de 9:30 a 21:30.';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas dos fotografías, así que no se inventa una
 * descripción y ambos `alt` avisan solo de dónde salen.
 */
const altFoto = 'Fotografía publicada en la ficha de Google Maps de Ars Floristeria, en Madrid';
const altOg = 'Fotografía de Ars Floristeria publicada en su ficha de Google Maps';

const textoResenas = `${business.reviewCount} reseñas`;
const nota = business.rating.toLocaleString('es-ES');
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#33402b" />
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="Ars Floristeria, floristería Madrid, floristería Usera, flores Antonio López, plantas Madrid"
		/>
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-MD" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/ars-floristeria/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Outfit:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(floristSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">A</span>
				<span class="brand-text">
					Ars Floristeria
					<small>Usera · Madrid</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La tienda</a>
				<a href="#resenas">Reseñas</a>
				<a href="#fotos">Fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phoneDisplay}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Floristería · Usera, Madrid</p>
						<h1 id="hero-title">
							Ars Floristeria,
							<em>flores en Usera.</em>
						</h1>
						<p class="hero-lede">
							Floristería en la <strong>Calle de Antonio López, 154</strong>, en el distrito de
							Usera. Google le da <strong>{nota} sobre 5</strong> con {textoResenas} y la clasifica
							como floristería. Abre <strong>todos los días de 9:30 a 21:30</strong>.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>
								Llamar al {business.phoneDisplay}
							</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode}
									{business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>{nota} sobre 5 con {textoResenas}</strong>
							</li>
						</ul>
					</div>

					<div class="hero-media">
						<figure class="media-main">
							<Image
								src={foto('ars-floristeria-apaisada-02.jpg')}
								alt={altFoto}
								widths={[640, 900, 1200]}
								sizes="(max-width: 1080px) 92vw, 46vw"
								format="webp"
								quality={68}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</figure>
						<figure class="media-inset">
							<Image
								src={foto('ars-floristeria-vertical-01.jpg')}
								alt={altFoto}
								widths={[260, 380, 520]}
								sizes="(max-width: 700px) 38vw, 18vw"
								format="webp"
								quality={68}
								loading="eager"
								decoding="async"
							/>
						</figure>
						<span class="media-tag">Madrid · 28026</span>
					</div>
				</div>
			</section>

			<div class="band" aria-label="Datos rápidos de Ars Floristeria">
				<span>{nota} sobre 5 · {textoResenas}</span>
				<span>{business.streetAddress} · {business.postalCode} {business.city}</span>
				<span>{hoursSummary}</span>
				<span>Teléfono {business.phoneDisplay}</span>
			</div>

			<section class="section casa" id="casa" aria-labelledby="casa-title">
				<div class="wrap casa-grid">
					<aside class="ficha casa-ficha" aria-label="Resumen de la ficha de Google Maps">
						<div class="ficha-head">
							<strong>La ficha</strong>
							<span>Google Maps</span>
						</div>
						<div class="ficha-score">
							<b>{nota}</b>
							<span>
								<span class="stars" aria-hidden="true">★★★★☆</span>
								{textoResenas} en Google Maps
							</span>
						</div>
						<dl class="ficha-rows">
							<div>
								<dt>Dirección</dt>
								<dd>{business.streetAddress}, {business.postalCode} {business.city}</dd>
							</div>
							<div>
								<dt>Barrio</dt>
								<dd>{business.district}, {business.city}</dd>
							</div>
							<div>
								<dt>Horario</dt>
								<dd>{hoursSummary}</dd>
							</div>
							<div>
								<dt>Teléfono</dt>
								<dd>{business.phoneDisplay}</dd>
							</div>
							<div>
								<dt>Plus code</dt>
								<dd>{business.plusCode}</dd>
							</div>
						</dl>
						<ul class="tags" aria-label="Categoría publicada por Google">
							{business.categories.map((categoria) => <li>{categoria}</li>)}
						</ul>
					</aside>

					<div class="casa-text">
						<p class="kicker">La tienda</p>
						<h2 class="title" id="casa-title">
							Una floristería
							<br />
							<em>de barrio.</em>
						</h2>
						<p class="lead">
							Google clasifica a Ars Floristeria con una sola etiqueta: floristería. La ficha no
							publica descripción del titular, catálogo ni precios, así que esta web no enumera
							productos ni tarifas.
						</p>
						<p>
							El local está en la <strong>Calle de Antonio López, 154</strong>, con código postal
							28026, en el distrito de Usera, Madrid. La ficha publica el plus code 97QX+V9 Madrid
							y las coordenadas 40.3897449, -3.7015345.
						</p>
						<p>
							En accesibilidad no hay ningún dato publicado, así que no se puede confirmar si el
							local dispone de acceso, aseo o asientos adaptados. Lo mejor es preguntar por
							teléfono antes de acercarse.
						</p>
						<p>
							Esta web solo reúne lo que el propio local publica en Google Maps, consultada el
							{site.consultado}: sus datos de contacto, su horario, su valoración, tres reseñas y
							sus fotografías. No es su web oficial y no vende nada.
						</p>
						<a class="casa-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">
							Ver la ficha completa en Google Maps ↗
						</a>
					</div>
				</div>
			</section>

			<section class="section quotes" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<div class="quotes-head">
						<div>
							<p class="kicker">Lo que dicen</p>
							<h2 class="title" id="resenas-title">
								Tres reseñas,
								<br />
								<em>tal como están escritas.</em>
							</h2>
						</div>
						<div class="quotes-rating">
							<b>{nota}</b>
							<div>
								<span class="stars" aria-hidden="true">★★★★☆</span>
								{textoResenas} en Google Maps
								<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
									Ver todas ↗
								</a>
							</div>
						</div>
					</div>
					<div class="quote-grid">
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									<strong>{review.rating} / 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
					<p class="quotes-note">
						Textos literales de tres de las reseñas que destaca la ficha. Google no muestra el
						nombre de quienes las firman en esta vista, así que se atribuyen a la ficha y no se
						inventa ninguna autoría.
					</p>
				</div>
			</section>

			<section class="section" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						La floristería <em>en dos imágenes.</em>
					</h2>
					<p class="lead">
						Son las dos únicas fotografías que Ars Floristeria publica en su ficha de Google
						Maps. El manifiesto de la descarga no atribuye ninguna a un autor con nombre, así que
						se publican sin pie y sin atribución. La ficha no describe su contenido y aquí no se
						inventa ninguna descripción.
					</p>
					<div class="fotos-grid">
						<figure class="foto foto-wide">
							<Image
								src={foto('ars-floristeria-apaisada-02.jpg')}
								alt={altFoto}
								widths={[640, 900, 1200]}
								sizes="(max-width: 700px) 92vw, 55vw"
								format="webp"
								quality={68}
								loading="lazy"
								decoding="async"
							/>
							<figcaption>01</figcaption>
						</figure>
						<figure class="foto foto-tall">
							<Image
								src={foto('ars-floristeria-vertical-01.jpg')}
								alt={altFoto}
								widths={[420, 620, 820]}
								sizes="(max-width: 700px) 92vw, 36vw"
								format="webp"
								quality={68}
								loading="lazy"
								decoding="async"
							/>
							<figcaption>02</figcaption>
						</figure>
					</div>
					<p class="fotos-note">
						La ficha no publica catálogo ni precios, así que esta web no los reproduce. Para
						saber qué hay hoy, lo más rápido es{' '}
						<a href={phoneHref}>llamar al {business.phoneDisplay}</a> o mirar las fotos y
						reseñas de la{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section visita" id="horario" aria-labelledby="horario-title">
				<div class="wrap visita-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Calle de Antonio López,
							<br />
							<em>154, 28026 Madrid.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.district} · {business.province}
						</address>

						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							La ficha publica un horario continuo de <strong>9:30 a 21:30 todos los días</strong>.
							Es el horario de la ficha consultada el {site.consultado}; conviene confirmarlo por
							teléfono antes de ir.
						</p>

						<p class="access-note">
							La ficha no publica datos de accesibilidad, así que esta web no puede confirmar si
							el local dispone de acceso, aseo o asientos adaptados.
						</p>

						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phoneDisplay}</strong>
						</a>

						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>

					<div class="map-card">
						<div class="map-frame">
							<iframe
								title={`Mapa de ${business.name} en ${business.city}`}
								src={mapEmbedUrl}
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
								allowfullscreen></iframe>
						</div>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>venir.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">A</span>
					<span>
						Ars Floristeria
						<small>{business.streetAddress} · {business.postalCode} {business.city}</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phoneDisplay}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Ars Floristeria · {business.streetAddress} ({business.postalCode}
					{business.city}). Web informativa elaborada con los datos y las fotografías que el local
					publica en su ficha de Google Maps, consultada el {site.consultado}. Confirma horario y
					disponibilidad por teléfono antes de salir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/ars-floristeria/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/ars-floristeria/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/ars-floristeria/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a Ars <span>{business.phoneDisplay}</span>
		</a>

	</body>
</html>
