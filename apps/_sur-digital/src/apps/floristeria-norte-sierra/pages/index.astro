---
import '../styles/global.css';
import {
	accesibilidad,
	business,
	directionsUrl,
	faqSchema,
	faqs,
	floristSchema,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Sin galería: la ficha no publica fotografías (ver la sección de fotos).

const title = 'Floristería · Flores en Norte-Sierra, Córdoba';
const description =
	'Floristería en Norte-Sierra (14006, Córdoba). 5 sobre 5 con 1 reseña en Google Maps. Sin teléfono ni horario publicados.';
const keywords =
	'Floristería, floristería Córdoba, flores Córdoba, Norte-Sierra';

/**
 * La ficha no publica fotografías.
 *
 * Tras 30 peticiones al endpoint de la galería no llegó ningún bloque de fotos, y la ficha
 * en vivo solo enseña imágenes de Street View. Por eso esta web no tiene galería ni collage:
 * aquí no se inventa ninguna imagen y la sección de fotos lo declara.
 */
const textoResenas = business.reviewCount === 1 ? '1 reseña' : `${business.reviewCount.toLocaleString('es-ES')} reseñas`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#5c2e3e" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/floristeria-norte-sierra/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.png`} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración con el nombre Floristería Norte-Sierra, en Córdoba" />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.png`} />
		<meta name="twitter:image:alt" content="Ilustración con el nombre Floristería Norte-Sierra, en Córdoba" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(floristSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">FL</span>
				<span class="brand-text">
					Floristería
					<small>Norte-Sierra · Córdoba</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#local">La tienda</a>
					<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a
				class="topbar-phone"
				href={directionsUrl}
				target="_blank"
				rel="noopener noreferrer"
			>
				Cómo llegar <span aria-hidden="true">↗</span>
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Córdoba · Norte-Sierra · 14006</p>
						<h1 id="hero-title">
							Floristería,
							<br />
							<em>en Córdoba.</em>
						</h1>
						<p class="hero-lede">
							Floristería está en el distrito Norte-Sierra (la ficha no publica calle),
							con código postal 14006, en Córdoba.
							Google la clasifica como floristería y le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{textoResenas}. La ficha no publica teléfono ni horario, así que esta web no tiene botón de llamada.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode}
									{business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{textoResenas}
								</strong>
							</li>
						</ul>
					</div>

				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
					{textoResenas}
				</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>{hoursSummary}</span>
				<span>Sin teléfono publicado</span>
			</div>

			<section class="section" id="local" aria-labelledby="local-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">La tienda</p>
						<h2 class="title" id="local-title">
							Flores y plantas,
							<br />
							<em>en Norte-Sierra.</em>
						</h2>
						<p>
							Google la clasifica como floristería. Le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{textoResenas}. Está en el distrito
							Norte-Sierra, con código postal
							14006, en Córdoba (la ficha no publica calle), y la ficha publica su plus code V6XC+43 Córdoba.
						</p>
						<p>
							La ficha no publica descripción del titular. El endpoint de la ficha no incluía extractos literales de reseñas, así que aquí no se reproduce ninguno: el enlace de la valoración abre el listado completo en Google Maps.
						</p>
						<p>
							Esta web se ha preparado solo con lo que publica la ficha, consultada
							el {site.consultado}: nombre, distrito, código postal, categoría, valoración, coordenadas y plus code. La ficha no publica calle, teléfono, horario, descripción, accesibilidad, fotografías, web, catálogo ni precios, así que aquí no se reproducen.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>{textoResenas} en Google Maps</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver todas ↗</a>
						</div>
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									<strong>{review.rating} sobre 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section cocina" id="fotos" aria-labelledby="fotos-title">
		<div class="wrap">
			<p class="kicker">Las fotos</p>
			<h2 class="title" id="fotos-title">
				Sin fotos <em>en la ficha.</em>
			</h2>
			<p class="lead">
				La ficha no publica fotografías: tras 30 peticiones al endpoint de la galería no llegó ningún bloque de fotos, y la ficha en vivo solo enseña imágenes de Street View. Por eso esta web no tiene galería: aquí no se inventa ninguna imagen. El escaparate se puede ver en el Street View de la
				<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
					ficha en Google Maps ↗
				</a>.
			</p>
		</div>
		</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Norte-Sierra,
							<br />
							<em>14006 Córdoba.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.district}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<p class="hours-note">
							La ficha no publica horario: ni horas de apertura ni días de cierre.
						</p>
						<p class="hours-note">
							Tampoco publica teléfono, así que conviene consultar la propia ficha en Google Maps antes de ir.
						</p>
						{accesibilidad.length > 0 ? (
						<ul class="access-list">
							{accesibilidad.map((item) => (
								<li class:list={[{ 'is-no': !item.disponible }]}>{item.label}</li>
							))}
						</ul>
) : (
						<p class="hours-note">La ficha no publica datos de accesibilidad.</p>
)}
												
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
						 src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>ir.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">FL</span>
					<span>
						Floristería
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Ubicación y ficha del local">
					<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
						Cómo llegar ↗
					</a>
					
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Floristería · Norte-Sierra
					(14006 Córdoba). Web informativa elaborada solo con los datos que el local publica
					en su ficha de Google Maps, consultada el {site.consultado}.
					La ficha no publica teléfono ni horario: confirma en la propia ficha antes de salir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/floristeria-norte-sierra/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/floristeria-norte-sierra/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/floristeria-norte-sierra/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={directionsUrl}>
			Cómo llegar a Floristería <span>↗</span>
		</a>

	</body>
</html>
