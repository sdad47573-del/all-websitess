---
import '../styles/global.css';

const business = {
	name: 'Vino y se quedó',
	area: 'Junto a la Plaza de España, casco histórico',
	city: 'Vejer de la Frontera',
	postalCode: '11150',
	latitude: 36.2537536,
	longitude: -5.962934,
	site: 'https://www.sur-digital.com/vino-y-se-quedo',
};

const mapsUrl =
	'https://www.google.com/maps/place/Vino+y+se+qued%C3%B3/@36.2537536,-5.962934,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c454245379031:0x79fa8f38139acb00!8m2!3d36.2537536!4d-5.962934!16s%2Fg%2F11z94dbj5x?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;

const specialties = [
	{
		kicker: 'De la tierra',
		title: 'Vinos de Cádiz',
		text: 'Vinos de Cádiz y vinos de la tierra como protagonistas: el nombre de la casa ya avisa de lo que pasa.',
	},
	{
		kicker: 'Para picar',
		title: 'Tapas',
		text: 'Tapas para acompañar el vino, en un local que nació para quedarse en la ruta del tapeo vejeriego.',
	},
	{
		kicker: 'De cuchara y plato',
		title: 'Platos',
		text: 'Platos además de tapas, según las reseñas: buena comida casera con producto de la zona.',
	},
	{
		kicker: 'Del Estrecho',
		title: 'Atún',
		text: 'El atún aparece en las reseñas como imprescindible: pruébalo con vistas a la plaza.',
	},
	{
		kicker: 'El marco',
		title: 'Plaza de España',
		text: 'Vistas espectaculares a la Plaza de España y a las casas blancas de Vejer desde la mesa.',
	},
	{
		kicker: 'El plan',
		title: 'Vino y tardeo',
		text: 'Buena comida y ubicación preciosa: el sitio al que vienes por una copa y te quedas a cenar.',
	},
];

const gallery = [
	{ src: '/fotos/plaza-espana.svg', alt: 'Ilustración de las vistas a la Plaza de España — sustituye por foto propia' },
	{ src: '/fotos/vinos.svg', alt: 'Ilustración de vinos de Cádiz — sustituye por foto propia del local' },
	{ src: '/fotos/tapas.svg', alt: 'Ilustración de tapas — sustituye por foto propia' },
	{ src: '/fotos/atun.svg', alt: 'Ilustración de plato de atún — sustituye por foto propia' },
	{ src: '/fotos/casas-blancas.svg', alt: 'Ilustración de las casas blancas de Vejer — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Vino y se quedó?',
		a: 'Junto a la Plaza de España, en el casco histórico de Vejer de la Frontera (11150, Cádiz), con vistas a la plaza y a las casas blancas.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'No hay horario verificado publicado. Consulta el horario vigente y la disponibilidad en su ficha de Google Maps, enlazada en esta página.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'Al ser un local con vistas muy demandado, conviene reservar. Consulta el teléfono en su ficha de Google Maps.',
	},
	{
		q: '¿Qué se puede tomar?',
		a: 'Vinos de Cádiz y de la tierra, tapas, platos y atún, según las reseñas de sus clientes: buena comida en una ubicación preciosa.',
	},
	{
		q: '¿Tiene vistas?',
		a: 'Sí, es su seña: vistas espectaculares a la Plaza de España y a las famosas casas blancas de Vejer.',
	},
];

const description =
	'Vino y se quedó: tapas, platos y vinos de Cádiz con vistas a la Plaza de España, en el casco histórico de Vejer de la Frontera.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	image: [`${business.site}/fotos/plaza-espana.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Tapas', 'Mediterránea', 'Vinos'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.area,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Vistas a la Plaza de España', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos al aire libre', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#3a1622" />
		<meta name="description" content="Vino y se quedó: tapas, platos y vinos de Cádiz con vistas a la Plaza de España, en Vejer de la Frontera. Buena comida en una ubicación preciosa." />
		<meta name="keywords" content="Vino y se quedó Vejer, restaurante Plaza de España Vejer, tapas Vejer Frontera, vinos Cádiz Vejer, atún Vejer, cenar Vejer vistas" />
		<meta name="author" content="Vino y se quedó" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/vino-y-se-quedo/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>Vino y se quedó | Tapas y vinos con vistas en Vejer</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Vino y se quedó · Tapas frente a la Plaza de España" />
		<meta property="og:description" content="Vinos de Cádiz, tapas, platos y atún con vistas a la Plaza de España y las casas blancas de Vejer." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/plaza-espana.svg`} />
		<meta property="og:image:alt" content="Vino y se quedó, restaurante con vistas en Vejer de la Frontera" />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Vino y se quedó · Tapas y vinos con vistas en Vejer" />
		<meta name="twitter:description" content="Tapas, platos y vinos de Cádiz con vistas a la Plaza de España, Vejer." />
		<meta name="twitter:image" content={`${business.site}/fotos/plaza-espana.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Vejer de la Frontera" />
		<meta name="geo.position" content="36.2537536;-5.962934" />
		<meta name="ICBM" content="36.2537536, -5.962934" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Vino y se quedó, inicio">
				<span class="brand-mark" aria-hidden="true">V</span>
				<span class="brand-name">Vino y se quedó <small>Vejer · Pza. España</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#local">El local</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-cta" href={mapsUrl} target="_blank" rel="noreferrer">Ficha en Maps ↗</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Plaza de España · Vejer</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante de tapas y vinos con vistas espectaculares a la Plaza de España y las casas
						blancas de Vejer: vinos de Cádiz, platos y atún en una ubicación preciosa.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a class="button button-ghost" href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha y horario ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>Vistas</b> a Pza. España</li>
						<li>Vinos de Cádiz</li>
						<li>Tapas y atún</li>
						<li>Casco histórico</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/vino-y-se-quedo/fotos/plaza-espana.svg" alt="Ilustración de las vistas a la Plaza de España desde Vino y se quedó, Vejer" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Plaza de España · Vejer</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>Plaza</b><span>De España</span></div>
					<div><b>Vino</b><span>De Cádiz</span></div>
					<div><b>Casco</b><span>Histórico</span></div>
				</div>
				<ul class="services">
					<li>Tapas</li>
					<li>Vinos</li>
					<li>Atún</li>
					<li>Vistas</li>
					<li>Terraza</li>
					<li>Centro</li>
				</ul>
			</section>

			<section class="about section-pad" id="local">
				<p class="section-label"><span aria-hidden="true"></span> Un local con nombre honesto</p>
				<div class="about-grid">
					<h2>El nombre hace honor<br />a lo que <em>pasa dentro.</em></h2>
					<div class="about-copy">
						<p>
							Vino y se quedó es un restaurante de tapas junto a la Plaza de España, en el casco
							histórico de Vejer de la Frontera. El nombre lo dice todo: pensabas entrar por una copa
							y acabas quedándote a comer.
						</p>
						<p>
							Su propuesta gira en torno a los vinos de Cádiz y de la tierra, con tapas, platos y atún
							según las reseñas. Buena comida en una ubicación preciosa, con la plaza como escenario.
						</p>
						<p class="about-note">
							Es un local del que aún hay poca información pública verificada: ni teléfono ni horario
							contrastados. Consulta ambos en su ficha de Google Maps antes de ir.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que se pide<br /><em>en la mesa.</em></h2>
					</div>
					<p>
						Lo citado en las reseñas públicas del local. La carta cambia: confirma disponibilidad
						en el propio restaurante.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El local<br /><em>y sus vistas.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del local.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Plaza de España · Vejer</p>
					<h2>Ven por un vino<br /><em>y quédate.</em></h2>
					<p class="address">
						{business.area}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Contacto y horario</caption>
						<tbody>
							<tr>
								<th scope="row">Teléfono</th>
								<td>Pendiente de confirmar con el titular</td>
							</tr>
							<tr>
								<th scope="row">Horario</th>
								<td>Consulta el horario vigente en su ficha de Google Maps</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">No publicamos datos sin fuente verificable. La ficha enlazada tiene el teléfono, el horario y las reseñas actualizadas.</p>

					<div class="visit-links">
						<a class="button button-ember" href={mapsUrl} target="_blank" rel="noreferrer">Abrir ficha en Maps ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de Vino y se quedó junto a la Plaza de España, Vejer de la Frontera" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Vino y se quedó · Vejer</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">V</span>
				<p>Vino y se quedó<small>{business.area} · {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
			</nav>
			<small>© {new Date().getFullYear()} Vino y se quedó · Vejer de la Frontera. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/vino-y-se-quedo/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/vino-y-se-quedo/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/vino-y-se-quedo/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

	</body>
</html>
