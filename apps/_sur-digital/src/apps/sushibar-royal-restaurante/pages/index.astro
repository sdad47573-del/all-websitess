---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import salaMadeira from '../assets/fotos/sushibar-royal-restaurante-vertical-01.jpg';
import pato from '../assets/fotos/sushibar-royal-restaurante-vertical-02.jpg';
import cartazSushi from '../assets/fotos/sushibar-royal-restaurante-apaisada-03.jpg';
import takeaway from '../assets/fotos/sushibar-royal-restaurante-vertical-04.jpg';
import carta from '../assets/fotos/sushibar-royal-restaurante-vertical-05.jpg';
import nigiri from '../assets/fotos/sushibar-royal-restaurante-vertical-06.jpg';
import frangoAmendoas from '../assets/fotos/sushibar-royal-restaurante-cuadrada-07.jpg';
import yakitori from '../assets/fotos/sushibar-royal-restaurante-vertical-08.jpg';
import salaBiombo from '../assets/fotos/sushibar-royal-restaurante-vertical-09.jpg';
import pratoSushi from '../assets/fotos/sushibar-royal-restaurante-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICOS,
} from '../data/site';

const title = 'Sushibar Royal Restaurante · Alverca do Ribatejo';
const description = BUSINESS.description;

const galeria = [
	{
		src: pratoSushi,
		alt: 'Prato quadrado com uramaki crocante, maki de salmão, sashimi e nigiri, com uma planta decorativa ao centro',
	},
	{
		src: salaMadeira,
		alt: 'Sala do Sushibar Royal com mesas de madeira, cadeiras verdes, separadores de vidro gravado e guardanapos vermelhos',
	},
	{
		src: cartazSushi,
		alt: 'Cartaz com a grelha de peças de sushi do Sushibar Royal, numeradas de 1 a 72',
	},
	{
		src: takeaway,
		alt: 'Caixa de takeaway com nigiri de salmão, uramaki com sésamo e rolos crocantes, com molho de soja ao lado',
	},
	{
		src: carta,
		alt: 'Página da carta do Sushibar Royal com as entradas e os tepan yaki numerados de T1 a T18',
	},
	{
		src: frangoAmendoas,
		alt: 'Frango panado com amêndoas picadas numa caixa preta, sobre tiras de couve',
	},
	{
		src: yakitori,
		alt: 'Dois espetos de frango yakitori com molho teriyaki, cenoura e folhas verdes num prato branco',
	},
	{
		src: salaBiombo,
		alt: 'Sala com biombo de madeira entalhada, candeeiro de cristal, garrafeira ao fundo e cadeiras verdes',
	},
	{
		src: pato,
		alt: 'Pato crocante fatiado sobre tiras de couve, com cenoura e salsa num prato branco',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#sushibar-royal`,
	name: BUSINESS.name,
	alternateName: ['Sushibar Royal', 'Sushibar Royal Alverca', 'Royal Sushi Alverca'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pan-asiática', 'Japonesa', 'Sushi'],
	areaServed: [
		{ '@type': 'City', name: 'Alverca do Ribatejo' },
		{ '@type': 'AdministrativeArea', name: 'Vila Franca de Xira' },
		{ '@type': 'AdministrativeArea', name: 'Distrito de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '19:00',
			closes: '23:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"sushibar-royal-restaurante-vertical-06.jpg": nigiri,
	"sushibar-royal-restaurante-vertical-10.jpg": pratoSushi,
	"sushibar-royal-restaurante-vertical-01.jpg": salaMadeira,
	"sushibar-royal-restaurante-apaisada-03.jpg": cartazSushi,
	"sushibar-royal-restaurante-vertical-04.jpg": takeaway,
	"sushibar-royal-restaurante-vertical-05.jpg": carta,
	"sushibar-royal-restaurante-cuadrada-07.jpg": frangoAmendoas,
	"sushibar-royal-restaurante-vertical-08.jpg": yakitori,
	"sushibar-royal-restaurante-vertical-09.jpg": salaBiombo,
	"sushibar-royal-restaurante-vertical-02.jpg": pato,
};
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#12161a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Sushibar Royal Restaurante, Sushibar Royal Alverca, sushi Alverca, sushi Alverca do Ribatejo, restaurante pan-asiático Alverca, tepan yaki Alverca, takeaway sushi Alverca"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cozinha pan-asiática e sushi na Av. 5 de Outubro 32, em Alverca do Ribatejo. De quarta a segunda, 12:00–15:00 e 19:00–23:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Prato de sushi e sashimi do Sushibar Royal Restaurante"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#12161a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Alverca do Ribatejo, Lisboa"
			locale="pt_PT"
			countryName="Portugal"
			preload={[nigiri]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/sushibar-royal-restaurante/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Sushibar Royal"
			subtitle="Cozinha pan-asiática · Alverca"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Informação elaborada a partir de fontes públicas; confirma horário e oferta antes da visita."
			ctaLabel="Ligar"
			navAriaLabel="Ligações do Sushibar Royal Restaurante"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/351211930735?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Alverca%20do%20Ribatejo." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Alverca do Ribatejo"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
