---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/la-carretera-terraza-teatinos-malaga.jpg';
import fachada from '../assets/fotos/la-carretera-fachada-navarro-ledesma-malaga.jpg';
import menuDelDia from '../assets/fotos/la-carretera-menu-del-dia-malaga.jpg';
import barraLocal from '../assets/fotos/la-carretera-barra-del-local-malaga.jpg';
import comedor from '../assets/fotos/la-carretera-comedor-interior-malaga.jpg';
import salonBarra from '../assets/fotos/la-carretera-salon-con-barra-malaga.jpg';
import barraTapas from '../assets/fotos/la-carretera-barra-de-tapas-malaga.jpg';
import desayuno from '../assets/fotos/la-carretera-desayuno-bocadillo-malaga.jpg';
import croquetas from '../assets/fotos/la-carretera-croquetas-malaga.jpg';
import albondigasSalsa from '../assets/fotos/la-carretera-albondigas-en-salsa-malaga.jpg';
import albondigasEnsalada from '../assets/fotos/la-carretera-albondigas-con-ensalada-malaga.jpg';
import guiso from '../assets/fotos/la-carretera-guiso-carne-con-patatas-malaga.jpg';
import tortilla from '../assets/fotos/la-carretera-tortilla-con-patatas-malaga.jpg';
import pincho from '../assets/fotos/la-carretera-pincho-con-patatas-malaga.jpg';
import pescaito from '../assets/fotos/la-carretera-pescaito-frito-malaga.jpg';
import carnePlancha from '../assets/fotos/la-carretera-carne-a-la-plancha-malaga.jpg';
import salmorejo from '../assets/fotos/la-carretera-salmorejo-malaga.jpg';
import paella from '../assets/fotos/la-carretera-paella-malaga.jpg';

const business = {
	name: 'La Carretera',
	fullName: 'Café Bar La Carretera',
	tagline: 'Cafetería, tapas y menú del día en Teatinos',
	street: 'C. Navarro Ledesma, 58',
	district: 'Teatinos-Universidad',
	city: 'Málaga',
	postalCode: '29010',
	phone: '609 74 33 59',
	latitude: 36.7251995,
	longitude: -4.4665837,
	rating: 4.3,
	reviewsCount: 171,
	site: 'https://www.sur-digital.com/cafe-bar-la-carretera',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd72f7397d198917:0x8eff3b0ca7f64c77';
const cidDecimal = '10304019397990567031';
const googleFeatureId = '/g/1pp2xbfsq';

const mapsUrl = `https://www.google.com/maps/place/Caf%C3%A9+Bar+La+Carretera/@${business.latitude},${business.longitude},17z/data=!3m1!4b1!4m6!3m5!1s${cid}!8m2!3d${business.latitude}!4d${business.longitude}`;
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = cidUrl;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34609743359';

const description =
	'Cafetería y bar de tapas en Teatinos (Málaga): desayunos desde las 7:00, bocadillos, tapas y raciones, y menú del día con paella los miércoles y viernes. En C. Navarro Ledesma, 58. Tel. 609 74 33 59.';

const servicios = [
	'Desayunos',
	'Cafetería',
	'Bocadillos y camperos',
	'Tapas y raciones',
	'Menú del día',
	'Paella miércoles y viernes',
	'Comida casera',
	'Platos de cuchara',
	'Bar de barrio',
	'Para familias',
	'Precios económicos',
	'Terraza en la calle',
];

const grupos = [
	{
		title: 'Desayunos',
		items: [
			{ name: 'Bocadillos y camperos', note: '«contundente y bien relleno», dicen las reseñas' },
			{ name: 'Catalana', note: 'el bocado de desayuno que más repiten los clientes' },
			{ name: 'Café con leche y tostadas', note: 'para empezar el día desde las 7:00' },
			{ name: 'Zumo y Cola Cao', note: 'el desayuno de toda la vida' },
		],
	},
	{
		title: 'Menú del día',
		items: [
			{
				name: 'Menú del día (lunes a viernes)',
				note: 'primero, segundo, pan, bebida y postre',
			},
			{ name: 'Tapas variadas', note: 'para picar o como primero' },
			{ name: 'Paella', note: 'los miércoles y los viernes' },
			{ name: 'Modificación del menú', note: 'se admite con suplemento' },
		],
	},
	{
		title: 'Tapas y raciones',
		items: [
			{ name: 'Croquetas', note: 'caseras, recién fritas' },
			{ name: 'Albóndigas en salsa', note: 'de las que se piden para mojar pan' },
			{ name: 'Tortilla de patatas', note: 'jugosa, en su punto' },
			{ name: 'Salmorejo', note: 'frío, con huevo y buen aceite de oliva' },
			{ name: 'Pincho con patatas', note: 'a la plancha, con guarnición' },
			{ name: 'Pescado frito', note: 'con ensalada y limón' },
			{ name: 'Carne a la plancha', note: 'con tomate y ensalada' },
		],
	},
	{
		title: 'Platos de cuchara',
		items: [
			{ name: 'Guiso de carne con patatas', note: 'la comida casera de siempre' },
			{ name: 'Potajes y guisos del día', note: 'según la pizarra del local' },
			{ name: 'Arroces', note: '«buen arroz», destacan en las reseñas' },
		],
	},
	{
		title: 'Bebidas y postres',
		items: [
			{ name: 'Café, infusiones y refrescos', note: 'carta completa de cafetería' },
			{ name: 'Cerveza de barril', note: 'bien tirada, para las tapas' },
			{ name: 'Postres caseros', note: 'pregunta por el del día' },
		],
	},
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada del Café Bar La Carretera en la esquina de la calle Navarro Ledesma, 58 (Teatinos, Málaga)',
	},
	{
		src: menuDelDia,
		alt: 'Cartel del menú del día del Café Bar La Carretera: tapas variadas y paella miércoles y viernes en Teatinos, Málaga',
	},
	{
		src: barraLocal,
		alt: 'Barra y mostrador del Café Bar La Carretera, cafetería en Teatinos (Málaga)',
	},
	{
		src: comedor,
		alt: 'Comedor del Café Bar La Carretera con mesas y sillas, bar de barrio en Teatinos, Málaga',
	},
	{
		src: salonBarra,
		alt: 'Salón interior del Café Bar La Carretera con barra y mesas, en la calle Navarro Ledesma, Málaga',
	},
	{
		src: barraTapas,
		alt: 'Barra de tapas del Café Bar La Carretera con albóndigas, ensaladilla y guisos, Teatinos, Málaga',
	},
	{
		src: desayuno,
		alt: 'Desayuno en el Café Bar La Carretera: bocadillo, zumo y café con leche, Málaga',
	},
	{
		src: croquetas,
		alt: 'Croquetas caseras con patatas fritas en el Café Bar La Carretera, Teatinos, Málaga',
	},
	{
		src: albondigasSalsa,
		alt: 'Albóndigas en salsa con patatas fritas en el Café Bar La Carretera, Málaga',
	},
	{
		src: albondigasEnsalada,
		alt: 'Albóndigas con ensalada de lechuga y tomate en el Café Bar La Carretera, Teatinos, Málaga',
	},
	{
		src: guiso,
		alt: 'Guiso de carne con patatas, comida casera del Café Bar La Carretera, Málaga',
	},
	{
		src: tortilla,
		alt: 'Tortilla de patatas con patatas fritas en el Café Bar La Carretera, Teatinos, Málaga',
	},
	{
		src: pincho,
		alt: 'Pincho a la plancha con patatas fritas en el Café Bar La Carretera, Málaga',
	},
	{
		src: pescaito,
		alt: 'Pescado frito con ensalada y limón en el Café Bar La Carretera, Teatinos, Málaga',
	},
	{
		src: carnePlancha,
		alt: 'Carne a la plancha con tomate y ensalada en el Café Bar La Carretera, Málaga',
	},
	{
		src: salmorejo,
		alt: 'Salmorejo con huevo picado y aceite de oliva en el Café Bar La Carretera, Teatinos, Málaga',
	},
	{
		src: paella,
		alt: 'Paella servida en el Café Bar La Carretera, que la prepara los miércoles y viernes en Teatinos, Málaga',
	},
];

const faqs = [
	{
		q: '¿Dónde está el Café Bar La Carretera?',
		a: 'En la calle Navarro Ledesma, 58, en el barrio de Teatinos-Universidad (29010 Málaga), a un paso de la Ciudad de la Justicia. Es un bar de barrio de esquina, con barra, comedor y terraza en la acera.',
	},
	{
		q: '¿Cuál es el horario del Café Bar La Carretera?',
		a: 'Abre de lunes a viernes de 7:00 a 16:30 y cierra los sábados y los domingos. Como es un horario de mañana, lo normal es ir a desayunar o a comer. En festivos puede cambiar, así que confirma antes si vienes de lejos.',
	},
	{
		q: '¿Tiene menú del día?',
		a: 'Sí. El menú del día se sirve de lunes a viernes e incluye primero, segundo, pan, bebida y postre. Admite modificaciones con suplemento, según la pizarra del propio local.',
	},
	{
		q: '¿Cuándo hay paella?',
		a: 'La paella se prepara los miércoles y los viernes, según el cartel del menú del local. Es uno de los platos que más destacan los clientes en las reseñas, junto con el resto de arroces y guisos.',
	},
	{
		q: '¿Qué se puede desayunar aquí?',
		a: 'Es un sitio clásico de desayunos en Teatinos. Hay bocadillos y camperos, catalanas, tostadas, café con leche, zumos y Cola Cao. Los clientes destacan que los bocadillos son «contundentes y bien rellenos» y que el pan está calentito.',
	},
	{
		q: '¿Se puede reservar?',
		a: 'No hay reserva en línea. Lo habitual es llamar al 609 74 33 59 para consultar disponibilidad, sobre todo si vais un grupo grande. En la zona de Navarro Ledesma, a mediodía, aparcar puede costar, así que si puedes ven en metro o autobús.',
	},
	{
		q: '¿Es un sitio para ir en familia o con niños?',
		a: 'Sí. Es un bar de barrio familiar, con mesas amplias y trato cercano. En las reseñas aparecen familias con niños y comidas de grupo, y lo que más se repite es la atención simpática del personal.',
	},
	{
		q: '¿Hay opciones vegetarianas o sin gluten?',
		a: 'Entre las tapas hay opciones sin carne, como la tortilla de patatas, el salmorejo o las ensaladas, y el menú del día admite cambios. Al ser una cocina casera y de fritura, lo mejor es avisar al personal y preguntar qué se puede adaptar ese día.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['Café Bar La Carretera', 'Bar La Carretera Teatinos', 'La Carretera Málaga'],
	slogan: 'Desayunos, tapas y menú del día en Teatinos',
	description,
	url: `${business.site}/`,
	telephone: '+34 609 74 33 59',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cafetería', 'Tapas', 'Cocina andaluza', 'Comida casera', 'Desayunos'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	image: `${business.site}/og.jpg`,
	sameAs: [mapsUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
		{ '@type': 'PropertyValue', name: 'Google Maps feature ID', value: googleFeatureId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '16:30',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Desayunos', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Menú del día', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Tapas y raciones', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Comida casera', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Para familias', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>La Carretera · Cafetería y menú del día en Teatinos, Málaga</title>
		<meta name="theme-color" content="#9e2b2b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.fullName}
			description={description}
			keywords="Café Bar La Carretera, La Carretera Teatinos, cafetería Teatinos, desayunos Teatinos, menú del día Málaga, bar de tapas Teatinos, bocadillos Málaga, paella miércoles y viernes, comer en Teatinos, cafetería Navarro Ledesma, bar 29010 Málaga, menú del día Málaga"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="La Carretera · Cafetería y menú del día en Teatinos, Málaga"
			ogDescription="Cafetería y bar de tapas en C. Navarro Ledesma, 58 (Teatinos): desayunos desde las 7:00, bocadillos, tapas y menú del día. 4,3 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Terraza del Café Bar La Carretera con sombrillas, cafetería y bar de tapas en Teatinos, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.fullName}
			themeColor="#9e2b2b"
			street={business.street}
			city={business.city}
			region="Andalucía"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Teatinos-Universidad, Málaga"
			contact={{
				street: business.street,
				locality: business.city,
				region: 'Andalucía',
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://www.sur-digital.com/cafe-bar-la-carretera/og.jpg" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7251995;-4.4665837" />
		<meta name="ICBM" content="36.7251995, -4.4665837" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="LC"
			name="La Carretera"
			subtitle="Café-Bar · Teatinos"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Teatinos · Málaga"
				title="Desayunos, tapas<br /><em>y menú del día.</em>"
				lede="Cafetería y bar de tapas en la calle Navarro Ledesma, 58, en pleno Teatinos. Desayunos desde las 7:00, bocadillos y tapas, y menú del día con paella los miércoles y viernes. Abierto de lunes a viernes hasta las 16:30."
				image={heroImage}
				imageAlt="Terraza del Café Bar La Carretera con sombrillas y clientes, bar de tapas en Teatinos (Málaga)"
				primaryCta={{ label: 'Llamar 609 74 33 59', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,3</b> en Google (171 reseñas)' },
					{ label: 'Horario', html: 'Lunes a viernes, 7:00–16:30' },
					{ label: 'Menú del día', html: 'De lunes a viernes' },
					{ label: 'Paella', html: 'Miércoles y viernes' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece el Café Bar La Carretera" items={servicios} />

			<LocalAbout
				label="Un bar de barrio"
				title="De toda la vida,<br /><em>con la cocina de casa.</em>"
				paragraphs={[
					'El Café Bar La Carretera está en la esquina de la calle Navarro Ledesma, 58, en pleno Teatinos y a un paso de la Ciudad de la Justicia. Es un bar de barrio de los de siempre: barra de azulejos, comedor con mesas amplias y terraza en la acera para los días de sol.',
					'Su fuerte son los desayunos, que empiezan a las 7:00, y el menú del día de lunes a viernes: primero, segundo, pan, bebida y postre, con tapas variadas y paella los miércoles y los viernes. A la carta hay bocadillos, catalanas, tapas, raciones y platos de cuchara, con la comida casera como bandera.',
					'Las reseñas lo resumen mejor que nadie: «muy buen sitio para desayunar, comer o tapear con precios económicos», «buen arroz, buenos precios y muy eficientes» y «la comida casera espectacular». Un sitio sencillo, familiar y bien de precio para comer en Teatinos.',
				]}
				note="La nota media en Google es 4,3 sobre 171 opiniones. Lo que más se repite en los comentarios es el buen precio, los bocadillos, la comida casera y el trato simpático del personal. La mayoría de reseñas hablan de desayunos y del menú del día."
				links={[
					{ label: 'Ficha y reseñas en Google', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Desayunos, menú del día<br /><em>y tapas.</em>"
				description="Resumen de lo que se sirve en el local: la pizarra del menú del día (fotografiada en su ficha de Google) y los platos que repiten los clientes en las reseñas. La carta cambia cada día, así que confírmala en el local."
				cta={{ label: 'Llamar para preguntar', href: phoneHref }}
				groups={grupos}
				note="El menú del día se sirve de lunes a viernes y se puede modificar con suplemento, según la pizarra del local. El resto de la carta cambia a diario: pregúntala al sentarte."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El bar y su comida,<br /><em>foto a foto.</em>"
				description="Estas fotografías proceden del perfil del Café Bar La Carretera en Google Maps, con imágenes de la ficha y de sus clientes. En la ficha del local están todas las fotos y las reseñas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del local en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="C. Navarro Ledesma, 58 · 29010 Málaga"
				title="Nos vemos<br /><em>en Teatinos.</em>"
				addressLines={[
					business.street,
					business.district,
					`${business.postalCode} ${business.city}, España`,
				]}
				hours={[
					{ day: 'Lunes', value: '7:00–16:30' },
					{ day: 'Martes', value: '7:00–16:30' },
					{ day: 'Miércoles', value: '7:00–16:30' },
					{ day: 'Jueves', value: '7:00–16:30' },
					{ day: 'Viernes', value: '7:00–16:30' },
					{ day: 'Sábado', value: 'Cerrado', closed: true },
					{ day: 'Domingo', value: 'Cerrado', closed: true },
				]}
				hoursNote="Horario publicado en la ficha de Google. El local abre de lunes a viernes por la mañana y cierra los fines de semana, así que es un sitio de desayunos y comidas. Puede variar en festivos: llama antes si vienes de lejos."
				mapTitle="Mapa del Café Bar La Carretera en la calle Navarro Ledesma, 58, Teatinos-Universidad, Málaga"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="La Carretera · Teatinos, Málaga"
				mapHref={cidUrl}
				links={[{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' }]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="No hay reserva en línea: para grupos o para preguntar el menú del día, llama al 609 74 33 59. En la zona de Navarro Ledesma, a mediodía, aparcar puede costar, así que si puedes ven en metro o autobús."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="LC"
			name={business.fullName}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
