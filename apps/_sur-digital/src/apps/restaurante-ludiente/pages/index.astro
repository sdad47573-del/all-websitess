---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import terraza from '../assets/fotos/restaurante-ludiente-apaisada-01.jpg';
import guiso from '../assets/fotos/restaurante-ludiente-apaisada-02.jpg';
import bocadillo from '../assets/fotos/restaurante-ludiente-apaisada-03.jpg';
import calamares from '../assets/fotos/restaurante-ludiente-apaisada-04.jpg';
import comedor from '../assets/fotos/restaurante-ludiente-apaisada-05.jpg';
import chuleton from '../assets/fotos/restaurante-ludiente-vertical-06.jpg';
import canelones from '../assets/fotos/restaurante-ludiente-vertical-07.jpg';
import bocadilloPatatas from '../assets/fotos/restaurante-ludiente-apaisada-08.jpg';
import ensalada from '../assets/fotos/restaurante-ludiente-apaisada-09.jpg';
import parrilla from '../assets/fotos/restaurante-ludiente-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description = BUSINESS.description;

const galeria = [
	{
		src: chuleton,
		alt: 'Chuletón a la brasa con patatas fritas y berenjena asada en Restaurante Ludiente',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo gigante de longaniza en pan rústico sobre la mesa de la terraza',
	},
	{
		src: parrilla,
		alt: 'Mesa con chuletas a la brasa, patatas fritas, berenjena asada y ensalada',
	},
	{
		src: canelones,
		alt: 'Canelones caseros gratinados con langostino en Restaurante Ludiente',
	},
	{
		src: calamares,
		alt: 'Calamares rellenos con su salsa y vieiras en Restaurante Ludiente',
	},
	{
		src: guiso,
		alt: 'Guiso de carne con pimientos verdes en la sartén, en Restaurante Ludiente',
	},
	{
		src: ensalada,
		alt: 'Ensalada con jamón curado y lascas de queso en Restaurante Ludiente',
	},
	{
		src: bocadilloPatatas,
		alt: 'Bocadillo enorme de carne con patatas gajo en Restaurante Ludiente',
	},
	{
		src: comedor,
		alt: 'Comedor de Restaurante Ludiente con mesas de madera, mamparas y el cartel del local',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': ['Restaurant', 'BarOrPub'],
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['Asador Ludiente', 'Bar Ludiente', 'Restaurante Asador Ludiente'],
	slogan: 'Los sabores que te harán sentir bien',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, BUSINESS.ownWebsite, 'https://www.facebook.com/BarLudiente/'],
	telephone: '+34 643 74 21 61',
	email: BUSINESS.email,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Parrilla', 'Casera', 'Bocadillos'],
	areaServed: [
		{ '@type': 'City', name: 'Ludiente' },
		{ '@type': 'AdministrativeArea', name: 'Alto Mijares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Sunday'],
			opens: '08:30',
			closes: '22:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '08:30',
			closes: '01:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza exterior', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza interior', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Salón comedor', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((body) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
		reviewBody: body,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Los espacios', href: '#espacios' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const title = 'Restaurante Ludiente · Asador y bar en Ludiente (Castellón)';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-ludiente-apaisada-01.jpg": terraza,
	"restaurante-ludiente-vertical-06.jpg": chuleton,
	"restaurante-ludiente-apaisada-03.jpg": bocadillo,
	"restaurante-ludiente-apaisada-10.jpg": parrilla,
	"restaurante-ludiente-vertical-07.jpg": canelones,
	"restaurante-ludiente-apaisada-04.jpg": calamares,
	"restaurante-ludiente-apaisada-02.jpg": guiso,
	"restaurante-ludiente-apaisada-09.jpg": ensalada,
	"restaurante-ludiente-apaisada-08.jpg": bocadilloPatatas,
	"restaurante-ludiente-apaisada-05.jpg": comedor,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f4234" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&family=Zilla+Slab:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Ludiente, asador Ludiente, bar Ludiente Castellón, carnes a la brasa Alto Mijares, bocadillos gigantes Ludiente, menú del día Ludiente, terraza Ludiente, Ctra. Argelita Ludiente"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Restaurante Ludiente · Asador y bar en Ludiente"
			ogDescription="Carnes a la brasa, guisos caseros, bocadillos enormes y terraza con vistas al pueblo. 4,0 en Google con 338 reseñas. Tel. 643 74 21 61."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Terraza de Restaurante Ludiente con vistas a las montañas y al campanario del pueblo"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2f4234"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone="+34643742161"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'España',
				phone: '+34 643 74 21 61',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[terraza]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Asador y bar · Ludiente"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
				reviews={REVIEWS}
				googleMaps={MAPS.place}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, platos y precios antes de la visita."
			ctaLabel="Llamar a Restaurante Ludiente"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34643742161?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Ludiente." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Ludiente"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
