---
import '../styles/global.css';

const business = {
	name: 'Restaurante Los Olivos',
	short: 'Los Olivos',
	city: 'Barbate',
	latitude: 36.2531072,
	longitude: -5.9807176,
	site: 'https://www.sur-digital.com/restaurante-los-olivos',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+Los+Olivos/@36.2531072,-5.9807176,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c45d7a0c202cf:0xb87faa870dec5dac!8m2!3d36.2531072!4d-5.9807176!16s%2Fg%2F11clt9bn7f?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;

const specialties = [
	{
		kicker: 'En Barbate',
		title: 'Restaurante local',
		text: 'Restaurante en Barbate: confirma la carta del día en el propio local.',
	},
	{
		kicker: 'De la tierra',
		title: 'Cocina andaluza',
		text: 'Cocina de la zona para el día a día, sin carta publicada en fuente sólida.',
	},
	{
		kicker: 'Para grupos',
		title: 'Mesa para compartir',
		text: 'Consulta disponibilidad y reservas en su ficha de Google Maps.',
	},
	{
		kicker: 'Aviso',
		title: 'Sin teléfono publicado',
		text: 'Sin teléfono en fuente sólida: usa la ficha de Maps.',
	},
	{
		kicker: 'Aviso',
		title: 'Sin horario publicado',
		text: 'Sin horario en fuente sólida: consulta su ficha antes de venir.',
	},
	{
		kicker: 'Aviso',
		title: 'Dirección exacta',
		text: 'Confirma la dirección exacta en su ficha de Google Maps.',
	},
];

const gallery = [
	{ src: '/fotos/olivos.svg', alt: 'Ilustración de olivos — sustituye por foto propia' },
	{ src: '/fotos/salon.svg', alt: 'Ilustración del salón — sustituye por foto propia' },
	{ src: '/fotos/casa.svg', alt: 'Ilustración de la casa — sustituye por foto propia' },
	{ src: '/fotos/mesa.svg', alt: 'Ilustración de la mesa — sustituye por foto propia' },
	{ src: '/fotos/terraza.svg', alt: 'Ilustración de la terraza — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Los Olivos?',
		a: 'En Barbate (Cádiz), coordenadas 36.2531072, -5.9807176. Confirma la dirección exacta en su ficha de Google Maps.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'El horario no está publicado en una fuente sólida. Consulta su ficha de Google Maps antes de venir.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Restaurante de cocina andaluza. Confirma la carta del día en el propio local.',
	},
	{
		q: '¿Tienen teléfono?',
		a: 'No hay teléfono publicado en fuente sólida. Usa el botón «Ver en Google Maps» para su ficha.',
	},
	{
		q: '¿Cómo llego?',
		a: 'En Barbate. Usa el botón «Cómo llegar» para abrir la ruta en Google Maps.',
	},
];

const description =
	'Restaurante Los Olivos en Barbate: restaurante de cocina andaluza. Consulta su ficha de Google Maps.';

const businessSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	image: [`${business.site}/fotos/olivos.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Andaluza'],
	address: {
		'@type': 'PostalAddress',
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="Los Olivos: restaurante en Barbate. Consulta horarios, teléfono y fotos en su ficha de Google Maps." />
		<meta name="keywords" content="Los Olivos Barbate, comer Barbate, restaurante Barbate" />
		<meta name="author" content="Los Olivos" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/restaurante-los-olivos/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>Los Olivos | Restaurante en Barbate</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Los Olivos · Restaurante en Barbate" />
		<meta property="og:description" content="Restaurante de cocina andaluza en Barbate." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/olivos.svg`} />
		<meta property="og:image:alt" content="Los Olivos, Barbate" />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:country-name" content="España" />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Los Olivos · Restaurante en Barbate" />
		<meta name="twitter:description" content="Cocina andaluza en Barbate." />
		<meta name="twitter:image" content={`${business.site}/fotos/olivos.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(businessSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Barbate" />
		<meta name="geo.position" content="36.2531072;-5.9807176" />
		<meta name="ICBM" content="36.2531072, -5.9807176" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Los Olivos, inicio">
				<span class="brand-mark" aria-hidden="true">LO</span>
				<span class="brand-name">Los Olivos <small>Barbate · Cádiz</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">El restaurante</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={mapsUrl} target="_blank" rel="noreferrer">Ver en Maps ↗</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Barbate · Cádiz</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante de cocina andaluza en Barbate para el día a día.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>Barbate</b> Cádiz</li>
						<li><b>Casa</b> andaluza</li>
						<li>De la tierra</li>
						<li>Maps</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/restaurante-los-olivos/fotos/olivos.svg" alt="Ilustración de Los Olivos, Barbate" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Barbate · Cádiz</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>Casa</b><span>Andaluza</span></div>
					<div><b>Barbate</b><span>Cádiz</span></div>
					<div><b>Maps</b><span>Ficha Maps</span></div>
				</div>
				<ul class="services">
					<li>Andaluza</li>
					<li>Casa</li>
					<li>Barrio</li>
					<li>Grupos</li>
					<li>Maps</li>
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> El restaurante</p>
				<div class="about-grid">
					<h2>De Barbate<br />de <em>siempre.</em></h2>
					<div class="about-copy">
						<p>
							Los Olivos está en Barbate (Cádiz),
							con coordenadas 36.2531072, -5.9807176.
						</p>
						<p>
							Restaurante de cocina andaluza para comer en el día a día.
						</p>
						<p class="about-note">
							Dirección exacta, teléfono y horario sin fuente sólida publicada.
							Consulta su ficha de Google Maps antes de venir.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales de restaurante andaluz. Confirma la carta del día
						en el propio local.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>La casa<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del restaurante.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Barbate</p>
					<h2>Ven a Los Olivos<br /><em>a comer.</em></h2>
					<p class="address">
						{business.city} (Cádiz), España<br />
						36.2531072, -5.9807176
					</p>

					<table class="hours">
						<caption>Contacto</caption>
						<tbody>
							<tr>
								<th scope="row">Dirección y horario</th>
								<td>En su ficha de Google Maps</td>
							</tr>
							<tr>
								<th scope="row">Teléfono</th>
								<td>Sin fuente sólida publicada</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Sin teléfono ni horario inventados. Consulta la ficha antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Maps ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de Los Olivos en Barbate" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Los Olivos · Barbate</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">LO</span>
				<p>Los Olivos<small>Barbate</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
			</nav>
			<small>© {new Date().getFullYear()} Los Olivos · Barbate. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/restaurante-los-olivos/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/restaurante-los-olivos/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/restaurante-los-olivos/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

	</body>
</html>
