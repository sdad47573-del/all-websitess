---
import { Image } from 'astro:assets';
import { GALLERY } from '../data/site';

const fotos = GALLERY.slice(0, 8);
---

<section id="galeria" class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="text-secondary text-xs font-semibold tracking-[0.22em] uppercase">Galería</p>
				<h2 class="font-display mt-3 text-4xl sm:text-5xl">Así es La Parrilla</h2>
			</div>
			<p class="text-base-content/60 max-w-sm text-sm">
				Fotos de la casa, la mesa y la terraza, sacadas de la ficha de Google del restaurante.
			</p>
		</div>

		<div class="mt-10 columns-2 gap-3 sm:gap-4 lg:columns-3">
			{fotos.map((foto) => (
				<figure class="mb-3 break-inside-avoid overflow-hidden rounded-xl sm:mb-4">
					<Image
						src={foto.src}
						alt={foto.alt}
						widths={[280, 460, 700]}
						sizes="(min-width: 1024px) 32vw, 46vw"
						quality={78}
						loading="lazy"
						class="foto-calida w-full object-cover transition-transform duration-500 hover:scale-105"
					/>
				</figure>
			))}
		</div>
	</div>
</section>
