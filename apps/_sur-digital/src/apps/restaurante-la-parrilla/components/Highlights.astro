---
import { HIGHLIGHTS } from '../data/site';
---

<section class="bg-base-100 py-14 sm:py-16">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
			{HIGHLIGHTS.map((item, index) => (
				<div class="border-base-300 border-t pt-5">
					<div class="flex items-center justify-between">
						<span class="text-primary bg-primary/5 flex size-10 items-center justify-center rounded-full">
							<i class={`${item.icon} text-lg`} />
						</span>
						<span class="font-display text-base-content/25 text-2xl">
							{String(index + 1).padStart(2, '0')}
						</span>
					</div>
					<h2 class="mt-4 text-lg font-bold">{item.title}</h2>
					<p class="text-base-content/65 mt-1 text-sm leading-relaxed">{item.text}</p>
				</div>
			))}
		</div>
	</div>
</section>
