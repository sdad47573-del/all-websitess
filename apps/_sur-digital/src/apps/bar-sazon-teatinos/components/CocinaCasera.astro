---
import { BUSINESS, COCINA_CASERA, HOURS } from '../data/site';

interface Props {
	/** Enlace a la carta completa (se oculta en la propia página de la carta). */
	showCartaLink?: boolean;
	class?: string;
}

const { showCartaLink = false, class: className = '' } = Astro.props;
---

<section id="cocina-casera" class={`scroll-mt-32 py-16 sm:py-20 ${className}`}>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div
			class="border-accent/40 bg-accent/10 rounded-box grid gap-8 border p-8 lg:grid-cols-[1.25fr_1fr] lg:p-10"
		>
			<div>
				<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">
					{COCINA_CASERA.eyebrow}
				</span>
				<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">{COCINA_CASERA.title}</h2>
				<p class="text-base-content/75 mt-5 leading-relaxed">{COCINA_CASERA.text}</p>

				<ul class="mt-6 flex flex-wrap gap-2">
					{
						COCINA_CASERA.incluye.map((apartado) => (
							<li class="border-accent/40 bg-base-100/70 inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm font-medium">
								<i class="ri-checkbox-circle-fill text-primary" />
								{apartado}
							</li>
						))
					}
				</ul>

				<p class="text-base-content/60 mt-5 text-sm">
					<i class="ri-information-line mr-1"></i>
					{COCINA_CASERA.nota}
				</p>
			</div>

			<div class="border-accent/30 bg-base-100 rounded-box flex flex-col gap-5 border p-6">
				<div>
					<p class="text-base-content/50 text-xs tracking-widest uppercase">Horario</p>
					<p class="font-display text-primary mt-1 text-3xl font-bold">{HOURS[0].hours}</p>
					<p class="text-base-content/60 mt-1 text-xs">
						{HOURS[0].days}, con servicio de mediodía.
					</p>
				</div>

				<div class="border-base-200 space-y-3 border-t pt-5 text-sm">
					<p class="flex items-center gap-3">
						<i class="ri-map-pin-line text-primary text-lg"></i>
						<span>{BUSINESS.street}, {BUSINESS.city}</span>
					</p>
					<p class="flex items-center gap-3">
						<i class="ri-phone-line text-primary text-lg"></i>
						<a href={BUSINESS.phoneHref} class="hover:text-primary">
							{BUSINESS.phoneDisplay}
						</a>
					</p>
					<p class="flex items-center gap-3">
						<i class="ri-links-line text-primary text-lg"></i>
						<a
							href={BUSINESS.digitalMenu}
							target="_blank"
							rel="noopener noreferrer"
							class="hover:text-primary"
						>
							Menú digital
						</a>
					</p>
				</div>

				<div class="mt-1 flex flex-col gap-2">
					<a href={BUSINESS.phoneHref} class="btn btn-primary btn-sm gap-2 rounded-full">
						<i class="ri-calendar-check-line"></i>
						Reservar mesa
					</a>
					{
						showCartaLink && (
							<a href="/bar-sazon-teatinos/carta" class="btn btn-ghost btn-sm gap-2 rounded-full">
								<i class="ri-book-2-line" />
								Ver la carta completa
							</a>
						)
					}
				</div>
			</div>
		</div>
	</div>
</section>
