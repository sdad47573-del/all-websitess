---
import { SPECIALTIES } from '../data/site';
---

<section id="especialidades" class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase"
				>Especialidades</span
			>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">
				Lo que nos ha hecho famosos en Teatinos
			</h2>
			<div class="sazon-divider mx-auto mt-5 h-px w-32"></div>
		</div>

		<div class="mt-14 grid gap-6 sm:grid-cols-2">
			{
				SPECIALTIES.map((item) => (
					<article class="group rounded-box border-base-300 bg-base-100 hover:border-primary/40 relative overflow-hidden border p-7 transition-all hover:-translate-y-1 hover:shadow-xl">
						<div class="flex items-start justify-between gap-4">
							<span class="bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-content flex size-14 items-center justify-center rounded-2xl transition-colors">
								<i class={`${item.icon} text-3xl`} />
							</span>
							<span class="badge badge-outline border-secondary/40 text-secondary">{item.tag}</span>
						</div>
						<h3 class="font-display mt-5 text-2xl font-semibold">{item.title}</h3>
						<p class="text-base-content/75 mt-3 leading-relaxed">{item.text}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
