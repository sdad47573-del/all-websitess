---
import { BUSINESS, REVIEWS } from '../data/site';
---

<section class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-10 lg:grid-cols-[320px_1fr] lg:gap-14">
			<div class="rounded-box border-base-300 bg-base-200 border p-8 text-center">
				<p class="font-display text-primary text-6xl font-bold">{BUSINESS.rating}</p>
				<div class="text-accent mt-3 flex justify-center gap-0.5">
					<i class="ri-star-fill"></i>
					<i class="ri-star-fill"></i>
					<i class="ri-star-fill"></i>
					<i class="ri-star-fill"></i>
					<i class="ri-star-half-fill"></i>
				</div>
				<p class="text-base-content/70 mt-4 text-sm">
					Más de {BUSINESS.reviewsCount.toLocaleString('es-ES')} reseñas en Google
				</p>
				<a
					href={BUSINESS.reviewsUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-primary btn-sm mt-6 gap-2 rounded-full"
				>
					<i class="ri-google-fill"></i>
					Leer las reseñas
				</a>
			</div>

			<div>
				<h2 class="font-display text-3xl font-bold sm:text-4xl">Lo que más gusta</h2>
				<div class="sazon-divider mt-5 h-px w-32"></div>

				<div class="mt-8 grid gap-5 sm:grid-cols-2">
					{
						REVIEWS.map((review) => (
							<blockquote class="rounded-box border-base-300 bg-base-100 border p-6 shadow-sm">
								<div class="text-accent flex gap-0.5">
									<i class="ri-star-fill text-sm" />
									<i class="ri-star-fill text-sm" />
									<i class="ri-star-fill text-sm" />
									<i class="ri-star-fill text-sm" />
									<i class="ri-star-fill text-sm" />
								</div>
								<p class="text-base-content/80 mt-3 text-sm leading-relaxed">«{review.text}»</p>
								<footer class="text-base-content/50 mt-3 text-xs">{review.source}</footer>
							</blockquote>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
