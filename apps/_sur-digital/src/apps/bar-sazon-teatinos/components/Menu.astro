---
import { MENU } from '../data/site';
---

<section id="carta" class="bg-base-200 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">La carta</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">
				Para picar, para compartir, para repetir
			</h2>
			<div class="sazon-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/70 mt-6">
				Tapas, medias raciones y raciones completas. Esta es una selección de la carta; la carta
				completa, con todos los platos, la tienes en un solo clic.
			</p>
		</div>

		<div class="mt-14 grid gap-6 lg:grid-cols-2">
			{
				MENU.map((category) => (
					<article class="card border-base-300 bg-base-100 border">
						<div class="card-body gap-5">
							<div class="border-base-200 flex items-center gap-3 border-b pb-4">
								<span class="bg-primary/10 text-primary flex size-11 items-center justify-center rounded-xl">
									<i class={`${category.icon} text-xl`} />
								</span>
								<h3 class="font-display text-xl font-semibold">{category.name}</h3>
							</div>

							<ul class="space-y-4">
								{category.items.map((item) => (
									<li class="border-base-200 border-b pb-4 last:border-0 last:pb-0">
										<h4 class="font-semibold">{item.name}</h4>
										<p class="text-base-content/70 mt-1 text-sm leading-relaxed">
											{item.description}
										</p>
										{item.tags && (
											<div class="mt-2 flex flex-wrap gap-1.5">
												{item.tags.map((tag) => (
													<span class="badge badge-sm border-primary/25 bg-primary/10 text-primary">
														{tag}
													</span>
												))}
											</div>
										)}
									</li>
								))}
							</ul>
						</div>
					</article>
				))
			}
		</div>

		<div class="mt-12 flex flex-col items-center gap-5">
			<a href="/bar-sazon-teatinos/carta" class="btn btn-primary btn-lg gap-2 rounded-full">
				<i class="ri-book-2-line text-xl"></i>
				Ver la carta completa
			</a>
			<p class="text-base-content/60 max-w-2xl text-center text-sm">
				<i class="ri-information-line mr-1"></i>
				Platos actualizados en la carta. Consulta alergias y opciones sin gluten con nuestro
				equipo.
			</p>
		</div>
	</div>
</section>
