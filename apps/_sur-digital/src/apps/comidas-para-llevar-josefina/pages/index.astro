---
import fachada from '../assets/fotos/comidas-para-llevar-josefina-vertical-01.jpg';
import vitrina from '../assets/fotos/comidas-para-llevar-josefina-vertical-02.jpg';
import tercera from '../assets/fotos/comidas-para-llevar-josefina-vertical-03.jpg';

const MAPS_URL =
	'https://www.google.com/maps/place/Comidas+Para+Llevar+Josefina/@37.994217,-1.1013566,17z/data=!3m1!4b1!4m6!3m5!1s0xd638260aecef583:0x81f752a6d7c7297f!8m2!3d37.994217!4d-1.1013566!16s%2Fg%2F11j34ln349?authuser=0&hl=es&entry=ttu';
const CREDIT_URL = 'https://www.sur-digital.com/';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Comidas Para Llevar Josefina</title>
		<meta name="description" content="Comidas Para Llevar Josefina: comida casera para llevar." />
		<link rel="canonical" href="https://www.sur-digital.com/comidas-para-llevar-josefina/" />
		<meta name="robots" content="index, follow" />
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Restaurant",
	"@id": "https://www.sur-digital.com/comidas-para-llevar-josefina/#negocio",
	"name": "Comidas para llevar josefina",
	"url": "https://www.sur-digital.com/comidas-para-llevar-josefina/",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 37.994217,
		"longitude": -1.1013566
	},
	"hasMap": "https://www.google.com/maps/place/Comidas+Para+Llevar+Josefina/@37.994217,-1.1013566,17z/data=!3m1!4b1!4m6!3m5!1s0xd638260aecef583:0x81f752a6d7c7297f!8m2!3d37.994217!4d-1.1013566!16s%2Fg%2F11j34ln349?authuser=0&hl=es&entry=ttu"
}
</script>
		<meta property="og:image" content="https://www.sur-digital.com/comidas-para-llevar-josefina/og.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta property="og:url" content="https://www.sur-digital.com/comidas-para-llevar-josefina/" />
		<meta property="og:locale" content="es_ES" />
			<meta property="og:title" content="Comidas Para Llevar Josefina" />
		<meta property="og:description" content="Comidas Para Llevar Josefina: comida casera para llevar." />
	</head>
	<body>
		<header>
			<h1 set:html={piezas.portada.titulo} />
			<p>Comida casera para llevar.</p>
			<a href={MAPS_URL} rel="noopener" target="_blank">Ver en Google Maps</a>
		</header>

		<main>
			<section>
				<img src={fachada.src} width={fachada.width} height={fachada.height} alt="Comidas Para Llevar Josefina" loading="lazy" decoding="async" />
				<img src={vitrina.src} width={vitrina.width} height={vitrina.height} alt="Comida para llevar en Josefina" loading="lazy" decoding="async" />
				<img src={tercera.src} width={tercera.width} height={tercera.height} alt="Comida para llevar en Josefina" loading="lazy" decoding="async" />
			</section>
		</main>

		<footer>
			<p>
				Creado por <a href={CREDIT_URL} rel="noopener">Sur Digital</a>
			</p>
		</footer>
	</body>
</html>
