---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	descripcionTitular,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	instalaciones,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	propuestas,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Restaurante Mosto La Jara · Sanlúcar de Barrameda';
const description =
	'Restaurante Mosto La Jara, en el Camino de La Victoria, 46 de Sanlúcar de Barrameda: pescados, guisos marineros y carnes a la brasa. Abre de viernes a domingo.';
const keywords =
	'Restaurante Mosto La Jara, Mosto La Jara, La Jara Sanlúcar, restaurante Sanlúcar de Barrameda, Camino de La Victoria, pescados Sanlúcar, carnes a la brasa';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas diez fotografías y el manifiesto de la descarga no
 * atribuye autor, así que no se inventa una descripción ni una atribución: los `alt` avisan solo
 * de dónde salen.
 */
const altFoto =
	'Fotografía publicada en la ficha de Google Maps de Restaurante Mosto La Jara, en Sanlúcar de Barrameda';
const altOg = 'Fotografía de Restaurante Mosto La Jara publicada en su ficha de Google Maps';

/** Galería completa: las diez fotografías de la ficha, alternando apaisadas y verticales. */
const galeria = [
	{ name: 'restaurante-mosto-la-jara-apaisada-01.jpg', clase: 'ancho', numero: '01' },
	{ name: 'restaurante-mosto-la-jara-vertical-02.jpg', clase: 'alto', numero: '02' },
	{ name: 'restaurante-mosto-la-jara-vertical-03.jpg', clase: 'alto', numero: '03' },
	{ name: 'restaurante-mosto-la-jara-apaisada-05.jpg', clase: 'ancho', numero: '04' },
	{ name: 'restaurante-mosto-la-jara-apaisada-09.jpg', clase: 'ancho', numero: '05' },
	{ name: 'restaurante-mosto-la-jara-vertical-04.jpg', clase: 'alto', numero: '06' },
	{ name: 'restaurante-mosto-la-jara-vertical-06.jpg', clase: 'alto', numero: '07' },
	{ name: 'restaurante-mosto-la-jara-apaisada-10.jpg', clase: 'ancho', numero: '08' },
	{ name: 'restaurante-mosto-la-jara-vertical-07.jpg', clase: 'medio', numero: '09' },
	{ name: 'restaurante-mosto-la-jara-vertical-08.jpg', clase: 'medio', numero: '10' },
];

/** Las dos primeras fotos hacen de portada: la apaisada grande y la vertical de al lado. */
const portada = foto('restaurante-mosto-la-jara-apaisada-09.jpg');
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#2b1118" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CA" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/restaurante-mosto-la-jara/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Marcellus&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">
					MJ
				</span>
				<span class="brand-text">
					Mosto La Jara
					<small>Sanlúcar de Barrameda</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#mesa">La mesa</a>
				<a href="#casa">La casa</a>
				<a href="#fotos">Fotos</a>
				<a href="#llegada">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="hero-eyebrow">La Jara · Sanlúcar de Barrameda</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-sub">
							Pescados y mariscos, guisos marineros y carnes de bellota a la brasa en el Camino de
							La Victoria, 46.
						</p>
						<p class="hero-lede">
							Restaurante en la zona de La Jara, con aparcamiento amplio, parque infantil, terrazas
							y salones climatizados según la descripción de su titular. Abre
							<strong>solo de viernes a domingo</strong>, de 13:00 a 23:30. Google le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>
								Llamar al {business.phone}
							</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas
								</strong>
							</li>
							<li>
								<small>Teléfono</small>
								<strong>{business.phone}</strong>
							</li>
						</ul>
					</div>

					<figure class="hero-figure">
						<Image
							src={portada}
							alt={altFoto}
							widths={[640, 900, 1200]}
							sizes="(max-width: 1080px) 92vw, 46vw"
							format="avif"
							quality={70}
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>
						<figcaption>
							<span>Ficha de Google Maps</span>
							<span>{site.consultado}</span>
						</figcaption>
						<p class="hero-stamp">
							<strong>{business.rating.toLocaleString('es-ES')}</strong>
							<span>{business.reviewCount.toLocaleString('es-ES')} reseñas</span>
						</p>
					</figure>
				</div>
			</section>

			<div class="aviso">
				<strong>Ojo al calendario</strong>
				<span>Viernes, sábado y domingo · 13:00–23:30</span>
				<span>De lunes a jueves, cerrado</span>
			</div>

			<section class="section" id="mesa" aria-labelledby="mesa-title">
				<div class="wrap mesa-grid">
					<div>
						<p class="kicker">La mesa</p>
						<h2 class="title" id="mesa-title">
							Lo que anuncia
							<em> la casa.</em>
						</h2>
						<blockquote class="titular">
							<p>{descripcionTitular}</p>
							<footer>Descripción del titular en la ficha de Google Maps</footer>
						</blockquote>
						<p class="mesa-note">
							Es la descripción completa que publica el restaurante, sin recortes. La ficha no
							publica carta ni precios, así que no hay ninguno en esta web: para saber qué hay hoy,
							lo mejor es <a href={phoneHref}>llamar al {business.phone}</a>.
						</p>
					</div>
					<div>
						<ul class="propuestas">
							{propuestas.map((item) => (
								<li>
									<div>
										<h3>{item.titulo}</h3>
										<p>{item.texto}</p>
									</div>
								</li>
							))}
						</ul>
						<p class="mesa-note">
							En las reseñas destacadas se citan almejas, langostinos, chuletón de retinto, pescaito
							y entrecot. Son platos que nombran los clientes, no una lista oficial.
						</p>
					</div>
				</div>
			</section>

			<section class="section casa" id="casa" aria-labelledby="casa-title">
				<div class="wrap">
					<p class="kicker">La casa</p>
					<h2 class="title" id="casa-title">
						Aparcamiento, parque
						<em> y terrazas.</em>
					</h2>
					<p class="lead">
						Cuatro instalaciones que el titular detalla en la ficha y que importan cuando se come en
						familia o en grupo. La ficha no publica aforo ni horario de cada espacio.
					</p>
					<div class="casa-grid">
						{instalaciones.map((item, index) => (
							<article class="casa-item">
								<small>Apunta la ficha · 0{index + 1}</small>
								<h3>{item.titulo}</h3>
								<p>{item.texto}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="section galeria" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						Diez fotos
						<em> de la ficha.</em>
					</h2>
					<p class="lead">
						Son las diez fotografías que el restaurante publica en su ficha de Google Maps. La ficha
						no las describe y el manifiesto de la descarga no atribuye autor, así que se muestran
						sin pie inventado.
					</p>
					<div class="galeria-grid">
						{galeria.map((item) => (
							<figure class:list={['galeria-item', item.clase]}>
								<Image
									src={foto(item.name)}
									alt={altFoto}
									widths={[420, 640, 900]}
									sizes="(max-width: 760px) 46vw, (max-width: 1080px) 46vw, 40vw"
									format="avif"
									quality={66}
									loading="lazy"
									decoding="async"
								/>
								<span aria-hidden="true">{item.numero}</span>
							</figure>
						))}
					</div>
					<p class="galeria-note">
						Fotos de la ficha consultada el {site.consultado}. Si eres el titular y prefieres que no
						aparezcan, se retiran: el teléfono de contacto es el{' '}
						<a href={phoneHref}>{business.phone}</a>.
					</p>
				</div>
			</section>

			<section class="section llegada" id="llegada" aria-labelledby="llegada-title">
				<div class="wrap llegada-grid">
					<div>
						<p class="kicker">Horario y llegada</p>
						<h2 class="title" id="llegada-title">
							Camino de La Victoria, 46,
							<em> Sanlúcar.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr class:list={[{ 'is-cerrado': item.closed }]}>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							Solo hay servicio <strong>viernes, sábado y domingo</strong>, de 13:00 a 23:30. Los
							otros cuatro días de la semana figuran como cerrados en la ficha. Es el horario
							consultado el {site.consultado}; conviene confirmarlo por teléfono antes de ir, sobre
							todo en festivos.
						</p>
						<p class="access-title">Accesibilidad publicada en la ficha</p>
						<ul class="access-list">
							{accesibilidad.map((item) => (
								<li class:list={[{ 'is-no': !item.disponible }]}>{item.label}</li>
							))}
						</ul>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="resenas" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<div class="resenas-head">
						<div>
							<p class="kicker">Lo que dicen</p>
							<h2 class="title" id="resenas-title">
								Tres reseñas
								<em> destacadas.</em>
							</h2>
						</div>
						<div class="score">
							<strong>{business.rating.toLocaleString('es-ES')}</strong>
							<span>
								sobre 5 · {business.reviewCount.toLocaleString('es-ES')} reseñas
								<br />
								<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
									Ver todas ↗
								</a>
							</span>
						</div>
					</div>
					<div class="quote-grid">
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									{review.rating} sobre 5 · {review.source}
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de
						<em> coger el coche.</em>
					</h2>
					<p class="lead">
						{business.reviewCount.toLocaleString('es-ES')} reseñas, tres destacadas y cuatro datos
						de accesibilidad: todo lo que publica la ficha, resumido sin añadir nada.
					</p>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">
						MJ
					</span>
					<span>
						Mosto La Jara
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del restaurante">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Restaurante Mosto La Jara · Camino de La Victoria, 46 (11540
					Sanlúcar de Barrameda). Web informativa elaborada con los datos y las fotografías que el
					restaurante publica en su ficha de Google Maps, consultada el {site.consultado}. Abre solo
					viernes, sábado y domingo: confirma horario y disponibilidad por teléfono antes de salir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>

			<a class="mobile-call" href={phoneHref}>
				Llamar a Mosto La Jara <span>{business.phone}</span>
			</a>

			<nav class="legal-links" aria-label="Información legal">
				<a href="/restaurante-mosto-la-jara/aviso-legal">Aviso legal</a>
				<a href="/restaurante-mosto-la-jara/aviso-legal#privacidad">Privacidad</a>
				<a href="/restaurante-mosto-la-jara/aviso-legal#cookies">Cookies</a>
			</nav>
		</footer>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
