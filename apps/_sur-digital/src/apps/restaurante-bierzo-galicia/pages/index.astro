---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import terraza from '../assets/fotos/restaurante-bierzo-galicia-apaisada-01.jpg';
import paella from '../assets/fotos/restaurante-bierzo-galicia-apaisada-03.jpg';
import calamares from '../assets/fotos/restaurante-bierzo-galicia-apaisada-04.jpg';
import entrecot from '../assets/fotos/restaurante-bierzo-galicia-apaisada-09.jpg';
import marisco from '../assets/fotos/restaurante-bierzo-galicia-vertical-02.jpg';
import pulpo from '../assets/fotos/restaurante-bierzo-galicia-vertical-06.jpg';

const business = {
	name: 'Restaurante del Bierzo y Galicia',
	brand: 'Bierzo y Galicia',
	street: 'Carrer Bisbe Serra, 5',
	city: 'Benicàssim',
	region: 'Castelló',
	postalCode: '12560',
	phone: '964 30 10 51',
	latitude: 40.0557752,
	longitude: 0.0767836,
	rating: 4.1,
	reviewsCount: 1629,
	site: 'https://www.sur-digital.com/restaurante-bierzo-galicia',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0x12a003fcfe34aba5:0xb9794027d84a7238';
const cidDecimal = '13364783909075317304';
const placeId = 'ChIJpas0_vwDoBIROHJK2CdAebk';

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+del+Bierzo+y+Galicia/@40.0557752,0.0767836,17z/data=!3m1!4b1!4m6!3m5!1s0x12a003fcfe34aba5:0xb9794027d84a7238!8m2!3d40.0557752!4d0.0767836!16s%2Fg%2F11bv382g_0?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34964301051';

const description =
	'Restaurante del Bierzo y Galicia, en Benicàssim: cocina gallega y del Bierzo con terraza cubierta. Pulpo, zamburiñas, arroces y carnes a la brasa, de 10:00 a 23:00.';

const servicios = [
	'Cocina gallega',
	'Cocina del Bierzo',
	'Pulpo y marisco',
	'Arroces',
	'Carnes a la brasa',
	'Terraza cubierta',
	'Comidas y cenas',
	'Grupos y celebraciones',
	'Acceso adaptado',
	'Reservas por teléfono',
];

const grupos = [
	{
		title: 'Del mar',
		items: [
			{
				name: 'Pulpo a la gallega',
				note: 'sobre patata cocida, con aceite de oliva y pimentón, servido con palillos',
			},
			{
				name: 'Zamburiñas',
				note: 'a la plancha con ajo y perejil, en su concha',
			},
			{
				name: 'Calamares a la andaluza',
				note: 'rebozados y recién fritos, con limón y perejil',
			},
			{
				name: 'Mejillones y sepia',
				note: 'los que cita una reseña: «rico pulpo, sepia, mejillones»',
			},
		],
	},
	{
		title: 'Arroces y brasa',
		items: [
			{
				name: 'Paella de marisco',
				note: 'en paellera, con mejillones y langostinos',
			},
			{
				name: 'Entrecot a la brasa',
				note: 'con patatas y pimiento asado a la plancha',
			},
			{
				name: 'Solomillo y lacón',
				note: 'los que recomienda una reseña: «recomendables las zamburiñas, el entrecot, solomillo, lacón»',
			},
		],
	},
	{
		title: 'De la tierra y la bodega',
		items: [
			{
				name: 'Queso de Cabrales',
				note: 'de la tabla de quesos, con cecina y chorizo',
			},
			{
				name: 'Cecina y chorizo',
				note: 'para empezar, con pan y vino',
			},
			{
				name: 'Vino del Bierzo',
				note: 'el vino turbio que cita una reseña: «probamos queso Cabrales, chorizo, cecina y vino turbio»',
			},
		],
	},
];

const galeria = [
	{
		src: paella,
		alt: 'Paella de marisco con mejillones y langostinos en Restaurante del Bierzo y Galicia, Benicàssim',
	},
	{
		src: pulpo,
		alt: 'Pulpo a la gallega con pimentón en Restaurante del Bierzo y Galicia, Benicàssim',
	},
	{
		src: marisco,
		alt: 'Zamburiñas en su concha y pulpo a la gallega en Restaurante del Bierzo y Galicia, Benicàssim',
	},
	{
		src: calamares,
		alt: 'Calamares a la andaluza con limón y perejil en Restaurante del Bierzo y Galicia',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la brasa con patatas y pimiento asado en Restaurante del Bierzo y Galicia',
	},
];

const faqs = [
	{
		q: '¿Dónde está el Restaurante del Bierzo y Galicia?',
		a: "En el Carrer Bisbe Serra, 5, 12560 Benicàssim (Castelló), en el casco urbano del pueblo, en un bajo con terraza cubierta. El botón «Cómo llegar» abre la ruta exacta en Google Maps.",
	},
	{
		q: '¿Qué horario tiene?',
		a: 'Abre de 10:00 a 23:00 de martes a sábado, sin cerrar a mediodía, y el domingo alarga hasta las 0:30. El lunes está cerrado. Al ser horario corrido, se puede comer tanto a mediodía como a media tarde.',
	},
	{
		q: '¿Qué tipo de comida sirve?',
		a: 'Cocina española con dos raíces: la ficha lo clasifica como restaurante gallego y de cocina española. En sus fotos y reseñas aparecen el pulpo a la gallega, las zamburiñas, los calamares, la paella de marisco, el entrecot a la brasa, el solomillo, el lacón, la cecina, el queso de Cabrales y el vino del Bierzo.',
	},
	{
		q: '¿Hay menú del día o carta publicada?',
		a: 'La ficha de Google no publica carta, menú del día ni precios, y esta web no los inventa: los platos de la sección «La mesa» son los que aparecen fotografiados en su perfil y los que citan las reseñas. El menú de cada día y los importes se consultan en el restaurante o por teléfono.',
	},
	{
		q: '¿Tiene terraza?',
		a: 'Sí. Las fotos de su ficha muestran una terraza cubierta bajo toldo, con ventiladores de techo y mesas con mantel blanco, además del comedor interior. Es una terraza cerrada, así que se usa también fuera de temporada de playa.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'No hay reserva online ni formulario en esta web: se reserva llamando al 964 30 10 51. Con 1.629 reseñas y terraza grande, en temporada alta y fines de semana conviene llamar con tiempo, sobre todo para grupos.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'La ficha de Google marca entrada, aseo y asientos adaptados para sillas de ruedas. No marca plaza de aparcamiento adaptada ni aparcamiento propio.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: [
		'Bierzo y Galicia',
		'Restaurante Bierzo y Galicia',
		'Bierzo y Galicia Benicàssim',
	],
	slogan: 'Cocina gallega y del Bierzo en Benicàssim',
	description,
	url: `${business.site}/`,
	telephone: '+34 964 30 10 51',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Gallega', 'Española', 'Del Bierzo', 'Marisco'],
	areaServed: [
		{ '@type': 'City', name: 'Benicàssim' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '10:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '10:00',
			closes: '00:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La mesa', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-bierzo-galicia-apaisada-01.jpg": terraza,
	"restaurante-bierzo-galicia-apaisada-03.jpg": paella,
	"restaurante-bierzo-galicia-vertical-06.jpg": pulpo,
	"restaurante-bierzo-galicia-vertical-02.jpg": marisco,
	"restaurante-bierzo-galicia-apaisada-04.jpg": calamares,
	"restaurante-bierzo-galicia-apaisada-09.jpg": entrecot,
};

const horas = [
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: '10:00 – 23:00' },
					{ day: 'Miércoles', value: '10:00 – 23:00' },
					{ day: 'Jueves', value: '10:00 – 23:00' },
					{ day: 'Viernes', value: '10:00 – 23:00' },
					{ day: 'Sábado', value: '10:00 – 23:00' },
					{ day: 'Domingo', value: '10:00 – 0:30' },
				];
const mapasPagina = {
	place: cidUrl,
	directions: cidUrl,
	streetView: cidUrl,
	embed: mapEmbedUrl,
};---

<!doctype html>
<html lang="es">
	<head>
		<title>Restaurante del Bierzo y Galicia · Pulpo y brasa en Benicàssim</title>
		<meta name="theme-color" content="#1d3f56" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Gloock&family=Mulish:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Restaurante del Bierzo y Galicia, Bierzo y Galicia Benicàssim, restaurante gallego Benicàssim, pulpo a la gallega, zamburiñas, marisco Benicàssim, lacón, cocina del Bierzo, comer en Benicàssim, Plana Alta, Castellón"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Restaurante del Bierzo y Galicia · Benicàssim"
			ogDescription="Pulpo, zamburiñas, arroces y carnes a la brasa en una terraza cubierta de Benicàssim. Abierto de 10:00 a 23:00; lunes cerrado."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Terraza cubierta del Restaurante del Bierzo y Galicia en Benicàssim"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#1d3f56"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Benicàssim, Castellón"
			contact={{
				street: business.street,
				locality: business.city,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[terraza]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="BG"
			name={business.brand}
			subtitle="Restaurante · Benicàssim"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: business.name,
					street: business.street,
					district: business.district ?? '',
					postalCode: business.postalCode,
					city: business.city,
				}}
								horario={horas}
								mapas={mapasPagina}
			/>
		</main>

		<LocalFooter
			mark="BG"
			name="Restaurante del Bierzo y Galicia"
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, platos y precios antes de la visita."
			ctaLabel="Llamar a Bierzo y Galicia"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34964301051?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Restaurante%20bierzo%20galicia." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Restaurante bierzo galicia"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
