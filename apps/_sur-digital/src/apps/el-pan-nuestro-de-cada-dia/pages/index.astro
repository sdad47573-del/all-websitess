---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import interior from '../assets/fotos/el-pan-nuestro-de-cada-dia-apaisada-01.jpg';
import tortas from '../assets/fotos/el-pan-nuestro-de-cada-dia-apaisada-02.jpg';
import salon from '../assets/fotos/el-pan-nuestro-de-cada-dia-apaisada-03.jpg';
import mostrador from '../assets/fotos/el-pan-nuestro-de-cada-dia-apaisada-04.jpg';

import { BUSINESS, DESAYUNOS, FAQ, HIGHLIGHTS, HOURS, HOURS_NOTE, MAPS, RESENAS, RESENAS_NOTE, SERVICIOS } from '../data/site';

const title = 'El Pan Nuestro De Cada Día · Panadería en Nte. Sierra, Córdoba';
const metaDescription =
	'El Pan Nuestro De Cada Día, panadería con salón en C. Abén Mazarra, 37 (Nte. Sierra, 14006 Córdoba). Pan, bollería y tortas, desayunos todos los días de 8:30 a 14:00. 4,6 con 12 reseñas.';
const description = BUSINESS.description;

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#el-pan-nuestro`,
	name: BUSINESS.name,
	alternateName: ['El Pan Nuestro', 'El Pan Nuestro Córdoba', 'Panadería Abén Mazarra'],
	description:
		'Panadería con salón en la calle Abén Mazarra, 37 (Nte. Sierra, 14006 Córdoba): pan, bollería, tortas y mesas para desayunar y merendar.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Panadería', 'Bollería', 'Desayunos'],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
		worstRating: 1,
	},
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '08:30',
			closes: '14:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Desayunos', href: '#desayunos' },
	{ label: 'Horario', href: '#horario' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Dónde está', href: '#visitanos' },
];

const stats = [
	{ label: 'Todos los días', value: '8:30–14:00' },
	{ label: 'Valoración', value: '4,6 · 12 reseñas' },
	{ label: 'Acceso', value: 'Adaptado' },
];

const galeria = [
	{
		src: mostrador,
		alt: 'El mostrador de pan con estanterías de barras y panes, el horno al fondo y murales de café',
		caption: 'El mostrador de pan',
	},
	{
		src: interior,
		alt: 'El interior del local con el expositor de bollos, la nevera y el pasillo hacia el salón',
		caption: 'El interior, desde la entrada',
	},
	{
		src: tortas,
		alt: 'Tres tortas grandes de crema y hojaldre en bandejas doradas dentro de la vitrina',
		caption: 'Las tortas de la vitrina',
	},
	{
		src: salon,
		alt: 'El salón con mesas y sillas de madera, la barra iluminada y la televisión al fondo',
		caption: 'El salón, con sus mesas',
	},
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#4f5c3b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Sora:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={metaDescription}
			keywords="El Pan Nuestro Córdoba, panadería Abén Mazarra, panadería Nte. Sierra, desayunos Córdoba 14006, bollería Córdoba, tortas Córdoba"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería con salón en Abén Mazarra, 37 (Nte. Sierra): pan, bollería, tortas y mesas para desayunar. Todos los días de 8:30 a 14:00. 4,6 con 12 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tres tortas grandes de crema y hojaldre en la vitrina de El Pan Nuestro De Cada Día"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#4f5c3b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[mostrador]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="El Pan Nuestro De Cada Día, inicio">
					<span class="brand-mark" aria-hidden="true">EP</span>
					<span class="brand-name">
						El Pan Nuestro
						<small>De cada día · Nte. Sierra, Córdoba</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-cta" href={MAPS.directions} target="_blank" rel="noreferrer">
					Cómo llegar <span aria-hidden="true">↗</span>
				</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> C. Abén Mazarra, 37 · Nte. Sierra · 14006</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-lede">
							Panadería de barrio en Abén Mazarra, con mostrador de pan, vitrina de tortas y
							mesas para desayunar o merendar. Abre todos los días a las 8:30, también sábados
							y domingos.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="button button-ghost" href="#desayunos">Ver el salón</a>
						</div>
						<dl class="hero-facts">
							{
								stats.map((stat) => (
									<div>
										<dt>{stat.label}</dt>
										<dd>{stat.value}</dd>
									</div>
								))
							}
						</dl>
					</div>

					<figure class="hero-media">
						<div class="hero-photo">
							<Image
								src={mostrador}
								alt="El mostrador de pan de El Pan Nuestro, con barras y panes en las estanterías y murales de café"
								widths={[480, 720, 1024, 1400]}
								sizes="(max-width: 980px) 92vw, 46vw"
								format="webp"
								quality={74}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</div>
						<figcaption>
							<span>El mostrador de pan</span>
							<span>Foto de la ficha de Google</span>
						</figcaption>
						<span class="hero-seal" aria-hidden="true">
							<strong>4,6</strong>
							<small>12 reseñas<br />en Google</small>
						</span>
					</figure>
				</div>
			</section>

			<section class="chips-wrap wrap" aria-label="Lo que ofrece la casa">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<div class="about-grid">
					<figure class="about-media">
						<Image
							src={salon}
							alt="El salón del local con mesas y sillas de madera, la barra iluminada y la televisión al fondo"
							widths={[480, 720, 1000]}
							sizes="(max-width: 980px) 92vw, 46vw"
							format="webp"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>El salón, con mesas de mantel</figcaption>
					</figure>

					<div class="about-copy">
						<p class="section-label"><span aria-hidden="true"></span> La casa</p>
						<h2 id="about-title">Panadería, <em>y sitio para sentarse.</em></h2>
						<p>
							El Pan Nuestro está en el número 37 de la calle Abén Mazarra, en Nte. Sierra. El
							local tiene dos caras: el mostrador de pan y la vitrina a la entrada, y un salón
							con mesas y sillas donde desayunar o merendar con calma.
						</p>
						<p>
							En la vitrina se ven tortas grandes de crema y hojaldre en bandejas doradas; en
							el mostrador, barras y panes apilados junto al horno. Es una panadería de barrio
							con cocina, televisión y mesas de mantel.
						</p>
						<p>
							Abre de 8:30 a 14:00 todos los días de la semana. La ficha no publica teléfono ni
							carta, así que esta web no los inventa: cuenta solo lo que la ficha y sus fotos
							muestran.
						</p>
						<div class="about-links">
							<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha en Google Maps <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href="#fotos">Ver las fotos</a>
						</div>
					</div>
				</div>

				<ul class="highlights">
					{
						HIGHLIGHTS.map((item) => (
							<li>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section class="desayunos" id="desayunos" aria-labelledby="desayunos-title">
				<div class="wrap desayunos-grid">
					<div class="desayunos-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> Desayunos y meriendas</p>
						<h2 id="desayunos-title">Café, pan <em>y una mesa.</em></h2>
						<p>
							Las reseñas lo dicen sin rodeos: es «buen lugar para desayunar y merendar
							familia». El salón de la galería lo confirma, con sus mesas de mantel y la barra
							al fondo.
						</p>

						<ol class="desayunos-list">
							{
								DESAYUNOS.map((item) => (
									<li>
										<h3>{item.title}</h3>
										<p>{item.text}</p>
									</li>
								))
							}
						</ol>
					</div>

					<figure class="desayunos-media">
						<Image
							src={tortas}
							alt="Tres tortas grandes de crema y hojaldre en bandejas doradas dentro de la vitrina"
							widths={[480, 720, 1000]}
							sizes="(max-width: 980px) 92vw, 44vw"
							format="webp"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Las tortas de la vitrina</figcaption>
					</figure>
				</div>
			</section>

			<section class="hours" id="horario" aria-labelledby="hours-title">
				<div class="wrap hours-grid">
					<div class="hours-copy">
						<p class="section-label"><span aria-hidden="true"></span> Horario</p>
						<h2 id="hours-title">Desde las 8:30, <em>todos los días.</em></h2>
						<p>
							La ficha publica el mismo horario de lunes a domingo: de 8:30 a 14:00. Un solo
							turno de mañana, con la apertura temprana para el desayuno.
						</p>
						<p class="hours-note">
							<strong>Ojo con el 1 de noviembre.</strong> {HOURS_NOTE}
						</p>
						<div class="hours-actions">
							<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
								Ver en Google Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>

					<div class="hours-table-wrap">
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google</caption>
							<tbody>
								{
									HOURS.map((row) => (
										<tr>
											<th scope="row">{row.day}</th>
											<td>{row.value}</td>
										</tr>
									))
								}
							</tbody>
						</table>
						<p class="hours-foot">
							Horario de la ficha pública de Google, consultada en octubre de 2026. Puede
							cambiar en festivos.
						</p>
					</div>
				</div>
			</section>

			<section class="fotos wrap" id="fotos" aria-labelledby="fotos-title">
				<div class="fotos-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Fotos</p>
						<h2 id="fotos-title">El local, <em>tal cual es.</em></h2>
					</div>
					<p>
						Las cuatro fotos de la galería pública de Google Maps: el mostrador de pan, el
						interior, la vitrina de tortas y el salón.
					</p>
				</div>

				<div class="fotos-grid">
					{
						galeria.map((photo) => (
							<figure class="foto">
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[420, 640, 900]}
									sizes="(max-width: 620px) 92vw, 46vw"
									format="webp"
									quality={70}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>{photo.caption}</figcaption>
							</figure>
						))
					}
				</div>
			</section>

			<section class="rating" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div>
						<span class="rating-value">4,6</span>
						<span class="rating-stars" aria-label="4,6 de 5 estrellas">★★★★★</span>
						<p class="rating-caption">
							valoración media<br />
							con 12 reseñas publicadas
						</p>
					</div>
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Lo que dicen</p>
						<h2 id="rating-title">Tres reseñas, <em>tres veces amabilidad.</em></h2>
						<ul class="quotes">
							{
								RESENAS.map((resena) => (
									<li>
										<blockquote>
											«{resena.texto}»
											<footer>Reseña de {resena.valor} estrellas en Google</footer>
										</blockquote>
									</li>
								))
							}
						</ul>
						<p class="rating-note">{RESENAS_NOTE}</p>
						<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver las reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Dónde está</p>
					<h2 id="visit-title">Abén Mazarra, <em>37.</em></h2>
					<p class="address">
						{BUSINESS.street}<br />
						{BUSINESS.district} · {BUSINESS.postalCode} {BUSINESS.city}
					</p>

					<p class="visit-note">
						<strong>Sin teléfono publicado:</strong> la ficha de Google no ofrece número de
						contacto ni página web, así que la visita es la forma de contactar. El acceso para
						sillas de ruedas sí está marcado.
					</p>

					<ul class="visit-list">
						<li>
							<span>Horario</span>
							Todos los días, de 8:30 a 14:00.
						</li>
						<li>
							<span>Acceso</span>
							Google marca acceso para sillas de ruedas.
						</li>
						<li>
							<span>Plus Code</span>
							{BUSINESS.plusCode}
						</li>
						<li>
							<span>Ficha</span>
							Panadería, sin web ni redes asociadas.
						</li>
					</ul>

					<div class="visit-links">
						<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
							Ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de El Pan Nuestro De Cada Día en la calle Abén Mazarra, 37, Córdoba"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Abén Mazarra, 37 · Nte. Sierra
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>entrar.</em></h2>
				<div class="faq-list">
					{
						FAQ.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">EP</span>
						<p>
							El Pan Nuestro
							<small>
								De cada día · panadería con salón<br />
								{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.district}, {BUSINESS.city}
							</small>
						</p>
					</div>
					<nav aria-label="Enlaces del establecimiento">
						<a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
						<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a href="#horario">Horario</a>
						<a href="#preguntas">Preguntas</a>
						<a href="/el-pan-nuestro-de-cada-dia/aviso-legal">Aviso legal</a>
					</nav>
				</div>
				<small class="legal">
					© {new Date().getFullYear()}
					{BUSINESS.name} · Datos, reseñas y fotografías de la ficha pública de Google Maps,
					consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de
					desplazarte.
				</small>
				<nav class="legal-links" aria-label="Información legal">
					<a href="/el-pan-nuestro-de-cada-dia/aviso-legal">Aviso legal</a>
					<a href="/el-pan-nuestro-de-cada-dia/aviso-legal#privacidad">Privacidad</a>
					<a href="/el-pan-nuestro-de-cada-dia/aviso-legal#cookies">Cookies</a>
				</nav>
				<p class="credit">
					<small>
						Creado por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a> ·
						www.sur-digital.com
					</small>
				</p>
			</div>
		</footer>
	</body>
</html>
