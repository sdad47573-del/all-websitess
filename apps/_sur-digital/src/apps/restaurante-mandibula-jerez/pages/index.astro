---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/restaurante-mandibula-jerez-vista-1-01.jpg';
import foto1 from '../assets/fotos/restaurante-mandibula-jerez-vertical-02.jpg';
import foto2 from '../assets/fotos/restaurante-mandibula-jerez-vertical-03.jpg';
import foto3 from '../assets/fotos/restaurante-mandibula-jerez-vertical-04.jpg';
import foto4 from '../assets/fotos/restaurante-mandibula-jerez-vertical-05.jpg';
import foto5 from '../assets/fotos/restaurante-mandibula-jerez-vista-6-06.jpg';

const business = {
	name: 'Restaurante Mandíbula',
	street: 'C. Madreselva, s/n',
	place: 'Zoo-botánico de Jerez',
	city: 'Jerez de la Frontera',
	region: 'Andalucía',
	province: 'Cádiz',
	postalCode: '11408',
	phone: '+34 722 74 32 43',
	latitude: 36.6906902,
	longitude: -6.1490191,
	site: 'https://www.sur-digital.com/restaurante-mandibula-jerez',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+Mand%C3%ADbula/data=!4m7!3m6!1s0xd0dc7d17fefa2b3:0x130735af71828ac4!8m2!3d36.6906902!4d-6.1490191!16s%2Fg%2F11tt346_wz!19sChIJs6Lvf9HHDQ0RxIqCca81BxM?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34722743243';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'La que citan',
		title: 'Baguette de serranito',
		text: 'Baguette de serranito espectacular según sus clientes: el bocado que más se nombra de la casa.',
	},
	{
		kicker: 'Para compartir',
		title: 'Patatas con queso y bacon',
		text: 'Patatas con queso y bacon increíbles: el plato para compartir en familia dentro del zoo.',
	},
	{
		kicker: 'Clásico',
		title: 'Combinado de huevo y lomo',
		text: 'Plato combinado de huevo, patatas y lomo: cocina casera, sencilla y de buen precio.',
	},
	{
		kicker: 'La casa',
		title: 'Tapas caseras de fin de semana',
		text: 'Restaurante familiar económico, con comida y tapas caseras los fines de semana dentro del parque zoo-botánico de Jerez.',
	},
	{
		kicker: 'El trato',
		title: 'Camareros geniales',
		text: 'Muy buen servicio, con unos camareros geniales y la comida buenísima, según sus reseñas.',
	},
	{
		kicker: 'Aviso',
		title: 'Lunes cerrado',
		text: 'El lunes cierra. De martes a domingo abre de 10:00 a 19:00: horario de visita del zoo. Llama en festivos.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de Restaurante Mandíbula publicada en su ficha de Google Maps (Jerez de la Frontera)' },
	{ src: photos.foto2, alt: 'Interior de Restaurante Mandíbula, en el zoo-botánico de Jerez' },
	{ src: photos.foto3, alt: 'Fotografía de Restaurante Mandíbula en Jerez de la Frontera, desde Google Maps' },
	{ src: photos.foto4, alt: 'Imagen de Restaurante Mandíbula (Jerez) subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Detalle de Restaurante Mandíbula según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está Restaurante Mandíbula?',
		a: 'En la calle Madreselva, s/n, 11408 Jerez de la Frontera (Cádiz), dentro del parque zoo-botánico de Jerez. Coordenadas 36.6906902, -6.1490191.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Lunes cerrado. De martes a domingo abre de 10:00 a 19:00. Confirma festivos por teléfono, ya que depende del parque.',
	},
	{
		q: '¿Cómo reservo mesa?',
		a: 'Llamando al 722 74 32 43. Es un restaurante familiar y económico: para grupos conviene llamar con antelación.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Comida y tapas caseras: baguette de serranito espectacular, patatas con queso y bacon increíbles y plato combinado de huevo, patatas y lomo.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso, aseo y asientos adaptados para sillas de ruedas. Para necesidades concretas, llama antes.',
	},
];

const images = [
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'Restaurante Mandíbula en el zoo de Jerez (calle Madreselva, s/n): tapas caseras, serranito y trato familiar. Reserva en el 722 74 32 43.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 722 74 32 43',
	image: images,
	priceRange: '€',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo, tarjeta de crédito',
	servesCuisine: ['Andaluza', 'Casera', 'Tapas', 'Española'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:00',
			closes: '19:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Ideal para familias', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.6,
		reviewCount: 80,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1b1714" />
		<meta
			name="description"
			content="Restaurante Mandíbula en el zoo de Jerez: tapas caseras, serranito y trato familiar en la calle Madreselva, s/n. Reserva en el 722 74 32 43."
		/>
		<meta
			name="keywords"
			content="Restaurante Mandíbula Jerez, zoo Jerez restaurante, tapas caseras Jerez, serranito Jerez, calle Madreselva"
		/>
		<meta name="author" content="Restaurante Mandíbula" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/restaurante-mandibula-jerez/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Restaurante Mandíbula | Tapas caseras en el zoo de Jerez</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Restaurante Mandíbula · Tapas caseras en Jerez" />
		<meta
			property="og:description"
			content="Comida y tapas caseras los fines de semana dentro del zoo-botánico de Jerez. Familiar y económico."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="Restaurante Mandíbula, en Jerez de la Frontera" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Restaurante Mandíbula · Tapas caseras en Jerez" />
		<meta
			name="twitter:description"
			content="Tapas caseras en la calle Madreselva, s/n (zoo de Jerez): serranito y trato familiar."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Jerez de la Frontera" />
		<meta name="geo.position" content="36.6906902;-6.1490191" />
		<meta name="ICBM" content="36.6906902, -6.1490191" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Restaurante Mandíbula, inicio">
				<span class="brand-mark" aria-hidden="true">M</span>
				<span class="brand-name">Restaurante Mandíbula <small>Jerez · Zoo</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#mandibula">Mandíbula</a>
				<a href="#especialidades">Especialidades</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>722 74 32 43</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Zoo-botánico · Jerez</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante Mandíbula en el zoo-botánico de Jerez: restaurante familiar económico, con comida y
						tapas caseras los fines de semana. Baguette de serranito, patatas con queso y combinados.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>
							Reservar 722 74 32 43
						</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,6</b> en Google (80 reseñas)</li>
						<li>Serranito</li>
						<li>Casera</li>
						<li>Familiar</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="webp"
						quality={70}
						alt="Fotografía de Restaurante Mandíbula publicada en su ficha de Google Maps (Jerez de la Frontera)"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,6</b><span>Google</span></div>
					<div><b>80</b><span>Reseñas</span></div>
					<div><b>10–19</b><span>Horario</span></div>
				</div>
				<ul class="services">
					<li>Tapas caseras</li>
					<li>Familiar</li>
					<li>Local accesible</li>
					<li>Grupos</li>
					<li>Reservas</li>
					<li>Económico</li>
				</ul>
			</section>

			<section class="about section-pad" id="mandibula">
				<p class="section-label"><span aria-hidden="true"></span> Un restaurante en el zoo</p>
				<div class="about-grid">
					<h2>Comer en familia<br />entre visita y visita<br /><em>al zoo.</em></h2>
					<div class="about-copy">
						<p>
							Restaurante Mandíbula está en la calle Madreselva, s/n, 11408 Jerez de la Frontera (Cádiz), dentro
							del parque zoo-botánico. Restaurante andaluz, familiar y económico.
						</p>
						<p>
							Lo que más citan sus clientes: muy buen servicio con camareros geniales y comida buenísima, con
							baguette de serranito espectacular, patatas con queso y bacon increíbles y plato combinado de
							huevo, patatas y lomo.
						</p>
						<p class="about-note">
							Sobre el horario: la ficha de Google Maps marca lunes cerrado y de martes a domingo de 10:00 a 19:00.
							Si vienes en festivo, llama antes.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="especialidades">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su carta</p>
						<h2>Lo que más<br />se pide <em>en la mesa.</em></h2>
					</div>
					<p>
						Platos citados en la descripción del propio local y en las reseñas de sus clientes. La carta cambia,
						así que confirma disponibilidad al reservar.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>Mandíbula<br /><em>por dentro.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Restaurante Mandíbula. En la ficha
							encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="webp"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres
					el titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C. Madreselva, s/n</p>
					<h2>Ven al zoo<br /><em>a comer.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España<br />
						({business.place})
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes</th>
								<td>Cerrado</td>
							</tr>
							<tr>
								<th scope="row">Martes a domingo</th>
								<td>10:00 – 19:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, llama antes de
						venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>
							Llamar 722 74 32 43
						</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 722 74 32 43</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Restaurante Mandíbula en la calle Madreselva, s/n, Jerez de la Frontera"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Restaurante Mandíbula · Jerez
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">M</span>
				<p>Restaurante Mandíbula<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Restaurante Mandíbula · Jerez de la Frontera. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>

			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/restaurante-mandibula-jerez/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/restaurante-mandibula-jerez/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/restaurante-mandibula-jerez/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar a Mandíbula <span>722 74 32 43</span></a>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
