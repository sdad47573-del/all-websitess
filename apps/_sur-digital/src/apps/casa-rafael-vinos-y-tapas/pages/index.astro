---
import '../styles/global.css';
import {
  business,
  directionsUrl,
  faqs,
  faqSchema,
  hours,
  hoursSource,
  hoursSummary,
  instagramUrl,
  facebookUrl,
  mapEmbedUrl,
  mapsUrl,
  officialWebUrl,
  phoneHref,
  phoneSecondaryHref,
  restaurantSchema,
  reviewsUrl,
  site,
} from '../data/site';

const title = 'Casa Rafael Vinos y Tapas · Periodista Emilio López 7, Cádiz';
const description =
  'Casa Rafael Vinos y Tapas en C. Periodista Emilio López 7, 11004 Cádiz. Reservas 676 89 28 88, horario, cómo llegar, mapa y preguntas. Web informativa no oficial.';
const keywords = 'Casa Rafael, vinos y tapas Cádiz, Periodista Emilio López, pescado fresco Cádiz';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e4b57" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={business.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="geo.region" content="ES-CA" />
    <meta name="geo.placename" content={business.city} />
    <meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
    <meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
    <link rel="canonical" href={`${site.siteUrl}/`} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/casa-rafael-vinos-y-tapas/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={business.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site.siteUrl}/`} />
    <meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
    <meta property="place:location:latitude" content={String(business.latitude)} />
    <meta property="place:location:longitude" content={String(business.longitude)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="topbar">
      <a class="brand" href="#inicio" aria-label={`${business.shortName}, inicio`}>
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
        <span class="brand-text">Casa Rafael<small>Emilio López 7 · Cádiz</small></span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="#local">El local</a>
        <a href="#fotos">Fotos</a>
        <a href="#horario">Horario</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
      <a class="topbar-phone" href={phoneHref}><span aria-hidden="true">☎</span>{business.phone}</a>
    </header>

    <main id="contenido">
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Cádiz · Centro histórico</p>
            <h1 id="hero-title">Casa Rafael<br /><em>vinos y tapas.</em></h1>
            <p class="hero-lede">
              {business.name} está en {business.streetAddress}, {business.postalCode} {business.city}.
              Web informativa no oficial: reservas por teléfono, horario oficial, cómo llegar, mapa y preguntas.
              Las fotos de Google Maps no se copian aquí por derechos de autor: esta web usa
              marcadores propios hasta tener fotos con permiso.
            </p>
            <div class="hero-actions">
              <a class="btn btn-solid" href={phoneHref}>Reservar: {business.phone}</a>
              <a class="btn btn-ghost" href={directionsUrl} target="_blank" rel="noopener noreferrer">
                Cómo llegar <span aria-hidden="true">↗</span>
              </a>
            </div>
            <ul class="hero-facts">
              <li><small>Dirección</small><strong>{business.streetAddress} · {business.postalCode} {business.city}</strong></li>
              <li><small>Horario</small><strong>{hoursSummary}</strong></li>
              <li><small>Reservas</small><strong>{business.phone} / {business.phoneSecondary}</strong></li>
            </ul>
          </div>

          <div class="hero-media">
            <div class="hero-collage hero-collage--sin-fotos" role="img" aria-label="Ilustración de Casa Rafael, sin fotografías">
              <div class="collage-item collage-item-main foto-ph">
                <span class="foto-ph-mark" aria-hidden="true">R</span>
                <span class="foto-ph-text">Foto propia pendiente</span>
                <small>Emilio López 7</small>
              </div>
              <div class="collage-item collage-item-top foto-ph foto-ph--alt">
                <span class="foto-ph-text">Barra / vinos</span><small>pendiente</small>
              </div>
              <div class="collage-item collage-item-bottom foto-ph">
                <span class="foto-ph-text">Pescado fresco</span><small>pendiente</small>
              </div>
            </div>
            <p class="hero-stamp" aria-hidden="true"><span>Tapas</span><strong>Casa Rafael</strong><span>Cádiz</span></p>
          </div>
        </div>
      </section>

      <div class="band">
        <span>{business.streetAddress} · {business.postalCode} {business.city}</span>
        <span>{hoursSummary}</span>
        <span>Reservas {business.phone}</span>
      </div>

      <section class="section local" id="local" aria-labelledby="local-title">
        <div class="wrap local-grid">
          <div class="local-text">
            <p class="kicker">El local</p>
            <h2 class="title" id="local-title">Pescado fresco<br /><em>y vinos.</em></h2>
            <p>
              {business.name} está en {business.streetAddress} ({business.postalCode} {business.city},
              {business.region}), en las coordenadas {business.latitude}, {business.longitude}.
              Turismo Cádiz lo lista como bar de tapas del centro histórico, de cocina tradicional
              con pescado fresco. Reservas solo por teléfono o presencial.
            </p>
            <ul class="category-list" aria-label="Categorías">
              {business.categories.map((c) => <li>{c}</li>)}
            </ul>
            <p class="local-note">
              Esta web no copia fotos, reseñas literales ni valoraciones de Google Maps.
              Web oficial: <a href={officialWebUrl} target="_blank" rel="noopener noreferrer">casarafaelvinosytapas.com ↗</a>.
              Para fotos y opiniones usa la <a href={mapsUrl} target="_blank" rel="noopener noreferrer">ficha en Google Maps ↗</a>
              o el <a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram ↗</a>.
            </p>
          </div>
          <div class="quote-row">
            <div class="quote-score">
              <strong>{business.phone}</strong>
              <span>También {business.phoneSecondary} · solo teléfono o presencial</span>
              <a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver en Maps ↗</a>
            </div>
            <blockquote class="quote">
              <p>No se aceptan reservas por otras webs ni redes sociales, para evitar fraudes.</p>
              <footer><strong>Aviso</strong><span>Web oficial del local</span></footer>
            </blockquote>
          </div>
        </div>
      </section>

      <section class="section fotos" id="fotos" aria-labelledby="fotos-title">
        <div class="wrap">
          <p class="kicker">Las fotos</p>
          <h2 class="title" id="fotos-title">Fotos <em>propias.</em></h2>
          <p class="lead">
            De momento no hay galería: las imágenes de Google Maps pertenecen a sus autores y sus
            condiciones prohíben descargarlas automáticamente. Cuando tengas fotos propias (hechas por
            ti o con permiso escrito del autor), guárdalas en <code>src/assets/fotos/</code> y aparecerán aquí.
          </p>
          <div class="fotos-grid">
            {[1, 2, 3].map((n) => (
              <figure class="foto-item foto-ph foto-ph--galeria">
                <span class="foto-ph-text">Espacio para foto {n}</span>
                <small>1200 × 800 · JPG</small>
              </figure>
            ))}
          </div>
          <p class="fotos-note">
            ¿Quieres ver cómo es por dentro? Mira la
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer">ficha con fotos en Google Maps ↗</a>,
            el <a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
            o <a href={phoneHref}>llama al {business.phone}</a>.
          </p>
        </div>
      </section>

      <section class="section horario" id="horario" aria-labelledby="horario-title">
        <div class="wrap horario-grid">
          <div>
            <p class="kicker">Horario y ubicación</p>
            <h2 class="title" id="horario-title">Emilio López 7,<br /><em>11004 Cádiz.</em></h2>
            <address>{business.streetAddress}<br />{business.postalCode} {business.city}<br />{business.province} · España</address>
            <table class="hours-table">
              <caption>{hoursSource} · lunes cerrado</caption>
              <tbody>
                {hours.map((item) => (
                  <tr><th scope="row">{item.day}</th><td>{item.service}</td></tr>
                ))}
              </tbody>
            </table>
            <p class="hours-note">Reservas en el {business.phone} o {business.phoneSecondary}. Confirma festivos por teléfono.</p>
            <a class="contact-line" href={phoneHref}><small>Reservas</small><strong>{business.phone}</strong></a>
            <div class="place-actions">
              <a class="btn btn-solid" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a>
              <a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver la ficha en Maps ↗</a>
            </div>
            <p class="hours-note">Secundario: <a href={phoneSecondaryHref}>{business.phoneSecondary}</a> · <a href={officialWebUrl} target="_blank" rel="noopener noreferrer">Web oficial ↗</a></p>
          </div>
          <div class="map-card">
            <iframe title={`Mapa de ${business.name} en ${business.city}`} src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
            <div class="map-tag">
              <div><strong>{business.shortName}</strong><small>{business.streetAddress} · {business.postalCode} {business.city}</small></div>
              <a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
            </div>
          </div>
        </div>
      </section>

      <section class="section faq" id="preguntas" aria-labelledby="faq-title">
        <div class="wrap">
          <p class="kicker">Preguntas frecuentes</p>
          <h2 class="title" id="faq-title">Antes de <em>venir.</em></h2>
          <div class="faq-list">
            {faqs.map((faq) => (
              <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-top">
        <a class="footer-brand" href="#inicio" aria-label={`${business.shortName}, volver al inicio`}>
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          <span>{business.name}<small>{business.streetAddress} · {business.postalCode} {business.city}</small></span>
        </a>
        <nav class="footer-nav" aria-label="Contacto y ficha del local">
          <a href={phoneHref}>Reservar: {business.phone}</a>
          <a href={officialWebUrl} target="_blank" rel="noopener noreferrer">Web oficial ↗</a>
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Ficha en Google Maps ↗</a>
          <a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
          <a href={facebookUrl} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
        </nav>
        <small class="footer-note">
          © {new Date().getFullYear()} {business.name} · {business.streetAddress} ({business.postalCode} {business.city}).
          Web informativa no oficial. Fuente de horario: Turismo Cádiz. Fuente de contacto: web oficial del local.
        </small>
      </div>
      <p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
    <nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
    	<a href="/casa-rafael-vinos-y-tapas/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
    	<a href="/casa-rafael-vinos-y-tapas/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
    	<a href="/casa-rafael-vinos-y-tapas/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
    </nav>
    </footer>

    <a class="mobile-call" href={phoneHref}>Reservar en Casa Rafael <span>{business.phone}</span></a>

  </body>
</html>
