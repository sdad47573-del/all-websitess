---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/venta-el-quinto-el-teniente-apaisada-05.jpg';
import foto1 from '../assets/fotos/venta-el-quinto-el-teniente-apaisada-01.jpg';
import foto2 from '../assets/fotos/venta-el-quinto-el-teniente-vertical-02.jpg';
import foto3 from '../assets/fotos/venta-el-quinto-el-teniente-apaisada-03.jpg';
import foto4 from '../assets/fotos/venta-el-quinto-el-teniente-vertical-06.jpg';
import foto5 from '../assets/fotos/venta-el-quinto-el-teniente-apaisada-04.jpg';

const business = {
	name: 'Venta el Quinto (el Teniente)',
	short: 'Venta el Quinto',
	street: 'Cam. Colorado, 45',
	city: 'Sanlúcar de Barrameda',
	region: 'Andalucía',
	province: 'Cádiz',
	postalCode: '11540',
	phone: '+34 697 34 10 84',
	latitude: 36.813455,
	longitude: -6.3215429,
	site: 'https://www.sur-digital.com/venta-el-quinto-el-teniente',
};

const mapsUrl =
	'https://www.google.com/maps/place/Venta+el+Quinto+(%22el+Teniente%22)/@36.813455,-6.3215429,17z/data=!3m1!4b1!4m6!3m5!1s0xd0de733593a0a69:0xfc1cf678cfe79e8b!8m2!3d36.813455!4d-6.3215429!16s%2Fg%2F11ckpyry8k?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34697341084';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'Lo que citan',
		title: 'Lagartitos al ajillo',
		text: 'Lagartitos al ajillo riquísimos según sus clientes: el plato que más se nombra cuando recomiendan la venta.',
	},
	{
		kicker: 'Con manzanilla',
		title: 'Bacalao a la manzanilla',
		text: 'Bacalao a la manzanilla riquísimo: cocina con vino de la tierra, como pide una venta sanluqueña.',
	},
	{
		kicker: 'Para volver',
		title: 'Arroces',
		text: 'Buena comida y bien atendidos: volveremos a probar los arroces, dicen quienes ya han venido.',
	},
	{
		kicker: 'La casa',
		title: 'Guisos, carne y marisco',
		text: 'Bar restaurante especializado en guisos, carne, mariscos y pescados, con los mejores productos de la tierra y de la mar y vinos para acompañarlos.',
	},
	{
		kicker: 'El trato',
		title: 'Atención personalizada',
		text: 'Cocina esmerada, cerveza fresquita y atención personalizada a los clientes, según sus reseñas.',
	},
	{
		kicker: 'Aviso',
		title: 'Mediodía largo',
		text: 'De lunes a jueves abre de 9:00 a 17:30; viernes y sábado hasta las 24:00 y domingo hasta las 18:00. Llama en festivos.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de Venta el Quinto publicada en su ficha de Google Maps (Sanlúcar de Barrameda)' },
	{ src: photos.foto2, alt: 'Interior de Venta el Quinto el Teniente, en el camino Colorado, Sanlúcar' },
	{ src: photos.foto3, alt: 'Fotografía de Venta el Quinto en Sanlúcar de Barrameda, desde Google Maps' },
	{ src: photos.foto4, alt: 'Imagen de Venta el Quinto (Sanlúcar de Barrameda) subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Detalle de Venta el Quinto según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está Venta el Quinto (el Teniente)?',
		a: 'En el camino Colorado, 45, 11540 Sanlúcar de Barrameda (Cádiz). Coordenadas 36.813455, -6.3215429.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Lunes a jueves de 9:00 a 17:30, viernes y sábado de 9:00 a 24:00 y domingo de 9:00 a 18:00. Confirma festivos por teléfono.',
	},
	{
		q: '¿Cómo reservo mesa?',
		a: 'Llamando al 697 34 10 84. Con 4,5 estrellas y más de 750 reseñas, para grupos conviene llamar con antelación.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Guisos, carne, mariscos y pescados de la tierra y la mar: lagartitos al ajillo, bacalao a la manzanilla y arroces, con vinos para acompañar.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso, aparcamiento, aseo y asientos adaptados para sillas de ruedas. Para necesidades concretas, llama antes.',
	},
];

const images = [
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'Venta el Quinto (el Teniente) en Sanlúcar de Barrameda (camino Colorado, 45): guisos, carne, marisco y arroces con vinos de la tierra. Reserva en el 697 34 10 84.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 697 34 10 84',
	image: images,
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo, tarjeta de crédito',
	servesCuisine: ['Española', 'Guisos', 'Pescados y mariscos', 'Andaluza'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '09:00',
			closes: '17:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '09:00',
			closes: '24:00',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '09:00', closes: '18:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Ideal para grupos', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.5,
		reviewCount: 755,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1b1714" />
		<meta
			name="description"
			content="Venta el Quinto (el Teniente) en Sanlúcar: guisos, carne, marisco y arroces en el camino Colorado, 45. Reserva en el 697 34 10 84."
		/>
		<meta
			name="keywords"
			content="Venta el Quinto Teniente Sanlúcar, camino Colorado restaurante, guisos Sanlúcar, arroces Sanlúcar, bacalao manzanilla, lagartitos ajillo"
		/>
		<meta name="author" content="Venta el Quinto" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/venta-el-quinto-el-teniente/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Venta el Quinto (el Teniente) | Guisos en Sanlúcar</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Venta el Quinto · Guisos y arroces en Sanlúcar" />
		<meta
			property="og:description"
			content="Guisos, carne, mariscos, pescados y arroces con vinos de la tierra en el camino Colorado, 45 (Sanlúcar de Barrameda)."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="Venta el Quinto, bar restaurante en Sanlúcar de Barrameda" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Venta el Quinto · Guisos y arroces en Sanlúcar" />
		<meta
			name="twitter:description"
			content="Guisos, arroces y marisco en el camino Colorado, 45 (Sanlúcar de Barrameda)."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Sanlúcar de Barrameda" />
		<meta name="geo.position" content="36.813455;-6.3215429" />
		<meta name="ICBM" content="36.813455, -6.3215429" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Venta el Quinto, inicio">
				<span class="brand-mark" aria-hidden="true">Q</span>
				<span class="brand-name">Venta el Quinto <small>Sanlúcar · Colorado</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#venta">La venta</a>
				<a href="#especialidades">Especialidades</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>697 34 10 84</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Camino Colorado · Sanlúcar</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Venta el Quinto (el Teniente) en el camino Colorado: bar restaurante de guisos, carne, mariscos y
						pescados con los mejores productos de la tierra y de la mar, con vinos para acompañarlos.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>
							Reservar 697 34 10 84
						</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,5</b> en Google (755 reseñas)</li>
						<li>Guisos</li>
						<li>Arroces</li>
						<li>Vinos</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="webp"
						quality={70}
						alt="Fotografía de Venta el Quinto publicada en su ficha de Google Maps (Sanlúcar de Barrameda)"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,5</b><span>Google</span></div>
					<div><b>755</b><span>Reseñas</span></div>
					<div><b>7/7</b><span>Días</span></div>
				</div>
				<ul class="services">
					<li>Guisos</li>
					<li>Arroces</li>
					<li>Local accesible</li>
					<li>Grupos</li>
					<li>Reservas</li>
					<li>Vinos</li>
				</ul>
			</section>

			<section class="about section-pad" id="venta">
				<p class="section-label"><span aria-hidden="true"></span> Una venta en Sanlúcar</p>
				<div class="about-grid">
					<h2>Cocina esmerada<br />todos los días<br /><em>el Teniente.</em></h2>
					<div class="about-copy">
						<p>
							Venta el Quinto (el Teniente) está en el camino Colorado, 45, 11540 Sanlúcar de Barrameda (Cádiz).
							Bar restaurante especializado en guisos, carne, mariscos y pescados de la tierra y la mar.
						</p>
						<p>
							Lo que más citan sus clientes: cocina esmerada, cerveza fresquita, atención personalizada,
							lagartitos al ajillo y bacalao a la manzanilla riquísimos, y arroces para volver a probar.
						</p>
						<p class="about-note">
							Sobre el horario: la ficha de Google Maps marca lunes a jueves de 9:00 a 17:30, viernes y sábado
							de 9:00 a 24:00 y domingo de 9:00 a 18:00. Si vienes en festivo, llama antes.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="especialidades">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su carta</p>
						<h2>Lo que más<br />se pide <em>en la mesa.</em></h2>
					</div>
					<p>
						Platos citados en la descripción del propio local y en las reseñas de sus clientes. La carta cambia
						según mercado, así que confirma disponibilidad al reservar.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>La venta<br /><em>por dentro.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Venta el Quinto. En la ficha
							encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="webp"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres
					el titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Camino Colorado, 45</p>
					<h2>Ven a la venta<br /><em>a Sanlúcar.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes a jueves</th>
								<td>9:00 – 17:30</td>
							</tr>
							<tr>
								<th scope="row">Viernes y sábado</th>
								<td>9:00 – 24:00</td>
							</tr>
							<tr>
								<th scope="row">Domingo</th>
								<td>9:00 – 18:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, llama antes de
						venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>
							Llamar 697 34 10 84
						</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 697 34 10 84</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Venta el Quinto en el camino Colorado, 45, Sanlúcar de Barrameda"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Venta el Quinto · Sanlúcar
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">Q</span>
				<p>Venta el Quinto (el Teniente)<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Venta el Quinto (el Teniente) · Sanlúcar de Barrameda. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>

			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small>
			</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/venta-el-quinto-el-teniente/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/venta-el-quinto-el-teniente/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/venta-el-quinto-el-teniente/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar a la venta <span>697 34 10 84</span></a>
	<!-- contacto-rapido -->
<style>
