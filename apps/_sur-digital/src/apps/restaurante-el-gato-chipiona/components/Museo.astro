---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES, MUSEO } from '../data/site';
---

<section id="museo" class="bg-base-200 trama-gato scroll-mt-20 overflow-hidden py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid items-center gap-14 lg:grid-cols-[1fr_0.9fr]">
			<div>
				<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">{MUSEO.kicker}</span>
				<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">{MUSEO.title}</h2>
				<div class="bg-secondary mt-5 h-0.5 w-24"></div>
				<p class="text-base-content/75 mt-6 text-lg leading-relaxed">{MUSEO.text}</p>
				<p class="text-base-content/55 mt-4 text-sm leading-relaxed">{MUSEO.note}</p>

				<div class="border-base-300 bg-base-100 mt-8 flex flex-wrap items-center gap-4 rounded-lg border p-5">
					<span class="sello-gato bg-primary text-accent flex size-16 shrink-0 flex-col items-center justify-center rounded-full text-center">
						<i class="ri-camera-lens-line text-xl" aria-hidden="true"></i>
						<span class="mt-1 text-[0.55rem] font-bold tracking-[0.1em] uppercase">Museo</span>
					</span>
					<p class="text-base-content/70 max-w-sm text-sm leading-relaxed">
						Un plan distinto en Chipiona: desayunar o comer y llevarse una visita cultural de
						propina.
					</p>
					<a href={BUSINESS.phoneHref} class="btn btn-primary btn-sm gap-2 rounded-full">
						<i class="ri-phone-line"></i> Preguntar
					</a>
				</div>
			</div>

			<figure class="relative mx-auto w-full max-w-md">
				<div class="border-accent absolute -inset-3 -rotate-2 rounded-lg border"></div>
				<div class="relative overflow-hidden rounded-lg shadow-2xl">
					<Image
						src={IMAGES.fotoMuseo}
						alt="Rincón del museo fotográfico de Restaurante El Gato"
						widths={[500, 900]}
						sizes="(min-width: 1024px) 38vw, 92vw"
						quality={86}
						loading="lazy"
						class="foto-calida aspect-[4/5] w-full object-cover"
					/>
				</div>
				<figcaption class="bg-primary text-accent-content absolute -bottom-5 left-4 rounded-full px-5 py-2 text-xs font-bold shadow-xl">
					Único en Chipiona
				</figcaption>
			</figure>
		</div>
	</div>
</section>
