---
import { faqSchema } from '../data/schema';
import { BUSINESS, FAQ } from '../data/site';
---

<section id="faq" class="bg-base-200 scroll-mt-20 py-20 sm:py-24">
	<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
		<div class="text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">
				Preguntas frecuentes
			</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">Antes de venir</h2>
			<div class="bg-secondary mx-auto mt-5 h-0.5 w-24"></div>
			<p class="text-base-content/70 mt-6">
				Lo que más se pregunta sobre {BUSINESS.name}. Si queda alguna duda, llama al
				<a class="text-primary font-semibold" href={BUSINESS.phoneHref}> {BUSINESS.phone}</a>.
			</p>
		</div>
		<div class="mt-12 space-y-3">
			{
				FAQ.map((item) => (
					<details class="collapse-arrow border-base-300 bg-base-100 collapse rounded-lg border">
						<summary class="collapse-title text-lg font-semibold">{item.q}</summary>
						<div class="collapse-content">
							<p class="text-base-content/75 text-sm leading-relaxed">{item.a}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
</section>
