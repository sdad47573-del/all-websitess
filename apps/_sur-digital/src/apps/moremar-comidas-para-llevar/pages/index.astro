---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import comedor from '../assets/fotos/moremar-comidas-para-llevar-panoramica-01.jpg';
import asado from '../assets/fotos/moremar-comidas-para-llevar-apaisada-02.jpg';
import mostrador from '../assets/fotos/moremar-comidas-para-llevar-apaisada-03.jpg';
import habas from '../assets/fotos/moremar-comidas-para-llevar-vertical-04.jpg';
import sirviendo from '../assets/fotos/moremar-comidas-para-llevar-apaisada-05.jpg';
import lentejas from '../assets/fotos/moremar-comidas-para-llevar-vertical-06.jpg';
import pizarra from '../assets/fotos/moremar-comidas-para-llevar-apaisada-07.jpg';
import barra from '../assets/fotos/moremar-comidas-para-llevar-apaisada-08.jpg';
import asadoBandejas from '../assets/fotos/moremar-comidas-para-llevar-apaisada-09.jpg';
import pinchos from '../assets/fotos/moremar-comidas-para-llevar-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Moremar · Comidas caseras y asados en Fuente Álamo';
const description =
	'Moremar comidas para llevar, en Ronda de Levante (30320 Fuente Álamo, Murcia). Cocina casera, raciones abundantes y asados los fines de semana, de 7:00 a 17:00.';

const galeria = [
	{
		src: comedor,
		alt: 'El comedor de Moremar con mesas de mantel rojo, sillas de madera, suelo de damero y la estantería de vinos',
	},
	{
		src: asado,
		alt: 'Un plato de asado con patatas al horno, tomate asado, ajos y dos croquetas',
	},
	{
		src: sirviendo,
		alt: 'Una empleada de Moremar sirviendo en la barra, con bandejas de patatas, pinchos morunos, caracoles y verdura',
	},
	{
		src: pizarra,
		alt: 'La pizarra del menú del día de Moremar con caldo de gallina, callos con garbanzos, paella, conejo, rabas, cordero y pollo asado',
	},
	{
		src: mostrador,
		alt: 'El mostrador de Moremar con bandejas de asado con patatas y tomate, un guiso y la vitrina de bebidas',
	},
	{
		src: habas,
		alt: 'Un plato de habas guisadas con chorizo y morcilla sobre mantel de cuadros azules',
	},
	{
		src: lentejas,
		alt: 'Un plato de lentejas con patata y zanahoria en una mesa de mantel rojo, con una ensalada al fondo',
	},
	{
		src: asadoBandejas,
		alt: 'Bandejas de asado con patatas panadera y tomate asado en el mostrador caliente',
	},
	{
		src: pinchos,
		alt: 'Un plato con pinchos morunos y un trozo de tortilla, con las bandejas del mostrador detrás',
	},
	{
		src: barra,
		alt: 'La barra de azulejos de Moremar vista desde una mesa con mantel de cuadros rojos y blancos',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#moremar`,
	name: BUSINESS.fullName,
	alternateName: ['Moremar', 'Moremar Fuente Álamo', 'Comidas para llevar Moremar'],
	description:
		'Cocina casera, raciones y asados para llevar en la Ronda de Levante (30320 Fuente Álamo, Murcia), con comedor y barra. Abre de 7:00 a 17:00, con el martes cerrado.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34669232605',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina española', 'Cocina casera', 'Asados', 'Comida para llevar'],
	hasMenu: {
		'@type': 'Menu',
		name: 'Carta de Moremar',
		inLanguage: 'es-ES',
		hasMenuSection: MENU.map((group) => ({
			'@type': 'MenuSection',
			name: group.title,
			hasMenuItem: group.items.map((item) => ({
				'@type': 'MenuItem',
				name: item.name,
				description: item.note,
			})),
		})),
	},
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Fuente Álamo de Murcia' },
		{ '@type': 'AdministrativeArea', name: 'Región de Murcia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '07:00',
			closes: '17:00',
		},
	],
	isAccessibleForFree: true,
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"moremar-comidas-para-llevar-panoramica-01.jpg": comedor,
	"moremar-comidas-para-llevar-apaisada-02.jpg": asado,
	"moremar-comidas-para-llevar-apaisada-05.jpg": sirviendo,
	"moremar-comidas-para-llevar-apaisada-07.jpg": pizarra,
	"moremar-comidas-para-llevar-apaisada-03.jpg": mostrador,
	"moremar-comidas-para-llevar-vertical-04.jpg": habas,
	"moremar-comidas-para-llevar-vertical-06.jpg": lentejas,
	"moremar-comidas-para-llevar-apaisada-09.jpg": asadoBandejas,
	"moremar-comidas-para-llevar-apaisada-10.jpg": pinchos,
	"moremar-comidas-para-llevar-apaisada-08.jpg": barra,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f5566" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Marcellus&family=Parisienne&family=Public+Sans:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Moremar Fuente Álamo, comidas para llevar Fuente Álamo, comida casera Ronda de Levante, asados fin de semana Murcia, menú del día Fuente Álamo, bar 30320, pollo asado Murcia"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina casera, raciones abundantes y asados los fines de semana en Ronda de Levante, Fuente Álamo. Comedor, barra y comida para llevar, de 7:00 a 17:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Un plato de asado con patatas y croquetas de Moremar, en Fuente Álamo"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1f5566"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Fuente Álamo de Murcia"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Moremar"
			subtitle="Comidas caseras · Fuente Álamo"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultados en noviembre de 2026. La ficha no publica carta con precios: confirma platos, precios y horario antes de la visita."
			ctaLabel="Llamar a Moremar"
			navAriaLabel="Enlaces de Moremar comidas para llevar"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34669232605?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carta%20de%20Moremar." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carta de Moremar"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
