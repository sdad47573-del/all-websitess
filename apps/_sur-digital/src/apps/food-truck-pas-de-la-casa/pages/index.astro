---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import terraza from '../assets/fotos/food-truck-pas-de-la-casa-apaisada-09.jpg';
import telecabina from '../assets/fotos/food-truck-pas-de-la-casa-apaisada-10.jpg';
import atardecer from '../assets/fotos/food-truck-pas-de-la-casa-vertical-01.jpg';
import hamburguesas from '../assets/fotos/food-truck-pas-de-la-casa-vertical-02.jpg';
import camion from '../assets/fotos/food-truck-pas-de-la-casa-vertical-03.jpg';
import ensalada from '../assets/fotos/food-truck-pas-de-la-casa-vertical-04.jpg';
import plaza from '../assets/fotos/food-truck-pas-de-la-casa-vertical-05.jpg';
import cafeSilla from '../assets/fotos/food-truck-pas-de-la-casa-vertical-06.jpg';
import noche from '../assets/fotos/food-truck-pas-de-la-casa-vertical-07.jpg';
import cafeMesa from '../assets/fotos/food-truck-pas-de-la-casa-vertical-08.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Food Truck · Comida rápida en Pas de la Casa';
const description =
	'Food Truck, en Pas de la Casa (AD200), al pie de las pistas de Grandvalira. Restaurante de comida rápida abierto todos los días de 9:00 a 19:00. 3,4 sobre 5 con 12 reseñas en Google. La ficha no publica teléfono ni carta.';

const galeria = [
	{
		src: camion,
		alt: 'El food truck, una furgoneta plateada con la ventanilla de servicio abierta, junto al bar de contenedor de San Miguel y la terraza de mesas blancas sobre la nieve',
	},
	{
		src: noche,
		alt: 'La terraza del food truck de noche, con las guirnaldas encendidas, el contenedor de dos plantas y la gente sentada en las mesas sobre la nieve pisada',
	},
	{
		src: plaza,
		alt: 'La explanada con el food truck y la terraza llena de esquiadores, con las banderas de Grandvalira y el hotel Màgic Pas al fondo',
	},
	{
		src: terraza,
		alt: 'La terraza al sol, con decenas de mesas y sillas blancas ocupadas por esquiadores y el telecabina y las pistas detrás',
	},
	{
		src: atardecer,
		alt: 'Vista desde la terraza cubierta: mesas de madera, guirnaldas de bombillas y el atardecer naranja sobre las pistas de Grandvalira y el edificio del telecabina',
	},
	{
		src: hamburguesas,
		alt: 'Una bandeja con dos hamburguesas con bacon, queso y lechuga en platos de cartón, con raciones de patatas fritas, entre esquiadores en una mesa de la terraza',
	},
	{
		src: ensalada,
		alt: 'Un bol de cartón con ensalada de tomate, mozzarella, aceitunas negras y pesto, sostenido con las pistas de esquí y el telecabina al fondo',
	},
	{
		src: cafeSilla,
		alt: 'Una mesa de la terraza con un café en vaso de cartón de San Miguel, sillas blancas alrededor y las pistas nevadas detrás',
	},
	{
		src: cafeMesa,
		alt: 'Un café con leche en vaso de cartón sobre una mesa de madera de la terraza, con esquiadores desenfocados al fondo',
	},
	{
		src: telecabina,
		alt: 'Dentro de la cabina del telecabina, con un esquiador con sudadera de Coll Blanc Panoramic Session y la estación de Pas de la Casa al fondo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'FastFoodRestaurant',
	'@id': `${BUSINESS.siteUrl}/#food-truck`,
	name: BUSINESS.fullName,
	alternateName: ['Food Truck Pas de la Casa', 'Food Truck Grandvalira'],
	description:
		'Puesto de comida rápida con terraza en Pas de la Casa, al pie de las pistas de Grandvalira, abierto todos los días de 9:00 a 19:00.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	servesCuisine: ['Comida rápida'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.plusCode,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '19:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"food-truck-pas-de-la-casa-vertical-03.jpg": camion,
	"food-truck-pas-de-la-casa-vertical-07.jpg": noche,
	"food-truck-pas-de-la-casa-vertical-05.jpg": plaza,
	"food-truck-pas-de-la-casa-apaisada-09.jpg": terraza,
	"food-truck-pas-de-la-casa-vertical-01.jpg": atardecer,
	"food-truck-pas-de-la-casa-vertical-02.jpg": hamburguesas,
	"food-truck-pas-de-la-casa-vertical-04.jpg": ensalada,
	"food-truck-pas-de-la-casa-vertical-06.jpg": cafeSilla,
	"food-truck-pas-de-la-casa-vertical-08.jpg": cafeMesa,
	"food-truck-pas-de-la-casa-apaisada-10.jpg": telecabina,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#161f2b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Work+Sans:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Food Truck Pas de la Casa, comida rápida Andorra, comer en Grandvalira, hamburguesas Pas de la Casa, terraza pistas Pas de la Casa, food truck Andorra"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida rápida con terraza al pie de las pistas de Grandvalira, en Pas de la Casa. Todos los días de 9:00 a 19:00. 3,4 sobre 5 con 12 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="El food truck de Pas de la Casa junto a la terraza de mesas blancas sobre la nieve"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#161f2b"
			street={BUSINESS.plusCode}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="AD-03"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.city}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.plusCode,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[camion]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Food Truck"
			subtitle="Pas de la Casa · Grandvalira"
			nav={nav}
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Food Truck"
			address={`${BUSINESS.plusCode} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone=""
			phoneHref=""
			ctaLabel=""
			legal="Datos, horario, valoración y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. La ficha no publica teléfono, carta ni precios."
			navAriaLabel="Enlaces del Food Truck"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	</body>
</html>
