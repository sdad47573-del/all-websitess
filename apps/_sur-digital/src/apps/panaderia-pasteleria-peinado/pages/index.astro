---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import fachada from '../assets/fotos/panaderia-pasteleria-peinado-vista-1-01.jpg';
import roscos from '../assets/fotos/panaderia-pasteleria-peinado-apaisada-07.jpg';
import donuts from '../assets/fotos/panaderia-pasteleria-peinado-vertical-02.jpg';
import canas from '../assets/fotos/panaderia-pasteleria-peinado-vertical-03.jpg';
import obrador from '../assets/fotos/panaderia-pasteleria-peinado-vertical-04.jpg';
import hogazas from '../assets/fotos/panaderia-pasteleria-peinado-vertical-05.jpg';
import bollos from '../assets/fotos/panaderia-pasteleria-peinado-vertical-06.jpg';
import berlinas from '../assets/fotos/panaderia-pasteleria-peinado-vertical-08.jpg';
import magdalenas from '../assets/fotos/panaderia-pasteleria-peinado-vertical-10.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HOURS, HOURS_NOTE, MAPS, SERVICIOS } from '../data/site';

const title = 'Panadería Pastelería Peinado · Pan y dulces en Cruz de Humilladero';
const description =
	'Panadería Pastelería Peinado en Calle Pedro Gómez Chaix, 3 (Cruz de Humilladero, 29007 Málaga): panadería y pastelería artesanal, roscos de reyes por WhatsApp. 4,7 sobre 5 con 70 reseñas. Horario, mapa y teléfono.';
const ratingLabel = BUSINESS.rating.toFixed(1).replace('.', ',');

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#peinado`,
	name: BUSINESS.name,
	alternateName: ['Peinado', 'Panadería Peinado', 'Pastelería Peinado'],
	description:
		'Panadería y pastelería artesanal en la calle Pedro Gómez Chaix, 29007 Málaga, con pedidos de roscos de reyes por WhatsApp. La ficha de Google le da 4,7 sobre 5 con 70 reseñas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	telephone: `+34${BUSINESS.phone.replace(/\s/g, '')}`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:00',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '08:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '08:00',
			closes: '14:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Horario', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const shots = [
	{
		src: roscos,
		alt: 'Roscas de reyes con fruta escarchada, azúcar y almendra, recién hechas en la bandeja',
		caption: 'Roscos de reyes',
	},
	{
		src: donuts,
		alt: 'Vitrina con donuts glaseados, lazos de azúcar y roscas, con el cartel del precio del donut',
		caption: 'La vitrina de dulces',
	},
	{
		src: magdalenas,
		alt: 'Magdalenas doradas recién horneadas en sus cápsulas de papel',
		caption: 'Magdalenas',
	},
	{
		src: hogazas,
		alt: 'Hogazas redondas con la corteza marcada y harina, apiladas en la bandeja del horno',
		caption: 'Hogazas',
	},
	{
		src: canas,
		alt: 'Cañas de crema rellenas, espolvoreadas con coco y canela',
		caption: 'Cañas de crema',
	},
	{
		src: bollos,
		alt: 'Bollos de pan tiernos recién horneados, con uno abierto en primer plano',
		caption: 'Bollos de pan',
	},
	{
		src: berlinas,
		alt: 'Vitrina con berlinas bañadas en chocolate, napolitanas y dulces espolvoreados con azúcar',
		caption: 'Bollería',
	},
	{
		src: obrador,
		alt: 'Obrador de la panadería con cientos de bollos formados sobre la mesa y un panadero trabajando',
		caption: 'El obrador',
	},
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#5a2635" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Pastelería Peinado, Panadería Peinado Málaga, pastelería Pedro Gómez Chaix, panadería Cruz de Humilladero, roscos de reyes Málaga, panadería 29007"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería y pastelería artesanal en la calle Pedro Gómez Chaix, 29007 Málaga. Roscos de reyes por WhatsApp. 4,7 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Roscas de reyes de Panadería Pastelería Peinado en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#5a2635"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Panadería Pastelería Peinado, inicio">
					<span class="brand-mark" aria-hidden="true">P</span>
					<span class="brand-name">
						Peinado
						<small>Panadería · Pastelería</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-phone" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Cruz de Humilladero · 29007 Málaga</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-lede">
							Panadería y pastelería en la calle Pedro Gómez Chaix, 3. La ficha de Google le da
							4,7 sobre 5 con 70 reseñas y publica teléfono y un WhatsApp para encargar roscos
							de reyes.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="button button-ghost" href={BUSINESS.phoneHref}> Llamar al {BUSINESS.phone}</a>
						</div>
						<ul class="hero-facts">
							<li>
								<b>{ratingLabel} / 5</b>
								{BUSINESS.reviewsCount} reseñas en Google
							</li>
							<li>
								<b>L–V 8:00–20:30</b>
								Sábado hasta 15:00 · domingo hasta 14:30
							</li>
							<li>
								<b>Pedro Gómez Chaix, 3</b>
								Cruz de Humilladero, {BUSINESS.city}
							</li>
						</ul>
					</div>

					<figure class="hero-photo">
						<Image
							src={fachada}
							alt="Fachada de Panadería Pastelería Peinado con el rótulo de la casa, los escaparates y la puerta de marco rojo"
							widths={[480, 760, 1200]}
							sizes="(max-width: 980px) 92vw, 46vw"
							format="webp"
							quality={74}
							priority
							decoding="async"
						/>
						<figcaption>
							<span>Fotos del perfil de Google Maps de la casa</span>
							<a href={MAPS.place} target="_blank" rel="noreferrer">Ver ficha ↗</a>
						</figcaption>
					</figure>
				</div>
			</section>

			<section class="chips-wrap wrap" aria-label="Lo que publica la ficha de Google">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<p class="section-label"><span aria-hidden="true"></span> La casa</p>
				<div class="about-grid">
					<h2 id="about-title">Panadería y pastelería <em>en el mismo mostrador.</em></h2>
					<div class="about-copy">
						<p>
							Peinado es una panadería y pastelería de la calle Pedro Gómez Chaix, número 3, en
							el barrio de Cruz de Humilladero. Google la clasifica en las dos categorías y le da
							4,7 sobre 5 con 70 reseñas.
						</p>
						<p>
							El rótulo de la fachada, que se ve en la galería de la ficha, anuncia la casa
							desde 1994. La propia ficha la presenta como panadería pastelería artesanal y
							publica un WhatsApp, el {BUSINESS.whatsappDisplay}, para los pedidos de roscos de
							reyes.
						</p>
						<p>
							En la misma ficha la casa avisa de que también atiende en la calle del Ciprés, 2,
							frente a Carlos Haya, con el nombre de Panadería Peinado. Son dos tiendas del mismo
							obrador.
						</p>
						<p>
							La ficha no publica carta ni precios, así que esta página no los afirma: el
							surtido se consulta en el mostrador. El 1 de noviembre Google advierte de que el
							horario podría variar.
						</p>
						<div class="about-links">
							<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha en Google Maps <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href={MAPS.sisterShop} target="_blank" rel="noreferrer">
								La tienda del Ciprés <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="three" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas de la casa</p>
							<h2 id="three-title">Lo que sí <em>se sabe.</em></h2>
						</div>
						<p>
							Todo lo que sigue sale de la ficha pública de Google Maps: sin carta ni precios
							publicados, esto es lo que la página puede afirmar.
						</p>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="orders" aria-labelledby="orders-title">
				<div class="wrap orders-grid">
					<div>
						<p class="section-label section-label-light"><span aria-hidden="true"></span> Pedidos</p>
						<h2 id="orders-title">Roscos de reyes <em>por WhatsApp.</em></h2>
						<p class="orders-lede">
							Es el único encargo que la casa anuncia por escrito en su ficha de Google:
							pedidos de roscos de reyes al WhatsApp {BUSINESS.whatsappDisplay}. El resto del
							surtido se compra en el mostrador.
						</p>
						<div class="orders-actions">
							<a class="button button-wheat" href={BUSINESS.whatsapp} target="_blank" rel="noreferrer">
								Escribir por WhatsApp <span aria-hidden="true">↗</span>
							</a>
							<a class="button button-outline" href={BUSINESS.phoneHref}>
								Llamar al {BUSINESS.phone}
							</a>
						</div>
					</div>
					<figure class="orders-photo">
						<Image
							src={roscos}
							alt="Roscas de reyes con fruta escarchada y azúcar en la bandeja del obrador"
							widths={[420, 680, 1024]}
							sizes="(max-width: 980px) 92vw, 42vw"
							format="webp"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Roscas de la casa · foto de la galería de Google Maps</figcaption>
					</figure>
				</div>
			</section>

			<section class="gallery wrap" id="galeria" aria-labelledby="gallery-title">
				<div class="gallery-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Galería</p>
						<h2 id="gallery-title">La casa, <em>en fotos.</em></h2>
					</div>
					<p>
						Ocho imágenes de la galería del perfil de Google Maps de Peinado: las roscas de
						reyes, la vitrina de dulces, el pan y la bollería del día y el obrador. Se muestran
						como información del local.
					</p>
				</div>

				<div class="gallery-grid">
					{
						shots.map((shot) => (
							<figure class="shot">
								<Image
									src={shot.src}
									alt={shot.alt}
									widths={[420, 680, 1024]}
									sizes="(max-width: 700px) 92vw, (max-width: 980px) 46vw, 30vw"
									format="webp"
									quality={72}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>{shot.caption}</figcaption>
							</figure>
						))
					}
				</div>

				<p class="gallery-note">
					Fotografías descargadas de la galería pública de Google Maps (octubre de 2026) e
					incluidas como información del establecimiento.
				</p>
			</section>

			<section class="rating" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-figure" aria-hidden="true">
						<span class="rating-number">{ratingLabel}</span>
						<span class="rating-max">/ 5</span>
					</div>
					<div class="rating-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que dice Google</p>
						<h2 id="rating-title">Setenta reseñas, <em>casi cinco estrellas.</em></h2>
						<p>
							La ficha tiene una media de 4,7 sobre 5 con 70 reseñas. Aquí solo se reproduce la
							valoración publicada: las opiniones completas se leen en Google Maps.
						</p>
						<div class="rating-actions">
							<span class="stars stars-large" role="img" aria-label="4,7 de 5 estrellas"
								>★★★★★</span
							>
							<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
								Leer las reseñas en Google <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Visítanos</p>
					<h2 id="visit-title">En Pedro <em>Gómez Chaix.</em></h2>
					<p class="address">
						{BUSINESS.street}<br />
						{BUSINESS.district}<br />
						{BUSINESS.postalCode} {BUSINESS.city}
					</p>

					<table class="hours">
						<caption>Horario publicado en Google</caption>
						<tbody>
							{HOURS.map((row) => (
								<tr>
									<th scope="row">{row.day}</th>
									<td>{row.value}</td>
								</tr>
							))}
						</tbody>
					</table>
					<p class="hours-note">{HOURS_NOTE}</p>

					<div class="visit-links">
						<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-ghost" href={BUSINESS.phoneHref}> Llamar al {BUSINESS.phone}</a>
					</div>
					<p class="visit-note">
						Acceso para sillas de ruedas según la ficha; sin aparcamiento accesible reservado. No
						hay página web ni pedido online, solo teléfono y el WhatsApp de las roscas.
					</p>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Panadería Pastelería Peinado en la calle Pedro Gómez Chaix, Málaga"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Pedro Gómez Chaix, 3 · 29007
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>pasar.</em></h2>
				<div class="faq-list">
					{
						FAQ.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">P</span>
						<p>
							Panadería Pastelería Peinado
							<small>
								Desde 1994 · Panadería y pastelería<br />
								{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}
							</small>
						</p>
					</div>
					<nav aria-label="Enlaces de la panadería">
						<a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
						<a href={MAPS.reviews} target="_blank" rel="noreferrer">Reseñas ↗</a>
						<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a href={BUSINESS.whatsapp} target="_blank" rel="noreferrer">WhatsApp ↗</a>
						<a href="/panaderia-pasteleria-peinado/aviso-legal">Aviso legal</a>
					</nav>
				</div>
				<small class="legal">
					© {new Date().getFullYear()} {BUSINESS.name} · Datos y valoración de la ficha pública
					de Google Maps, consultada en octubre de 2026. Las fotografías proceden de la galería
					del perfil del establecimiento en Google Maps. La web no publica carta ni precios porque
					la ficha no los incluye.
				</small>
				<nav class="legal-links" aria-label="Información legal">
					<a href="/panaderia-pasteleria-peinado/aviso-legal">Aviso legal</a>
					<a href="/panaderia-pasteleria-peinado/aviso-legal#privacidad">Privacidad</a>
					<a href="/panaderia-pasteleria-peinado/aviso-legal#cookies">Cookies</a>
				</nav>
				<p class="credit">
					<small
						>Creado por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a>
						· sur-digital.vercel.app</small
					>
				</p>
			</div>
		</footer>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
