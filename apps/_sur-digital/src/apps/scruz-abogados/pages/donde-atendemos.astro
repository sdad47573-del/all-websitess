---
import SeoLegalPage from '../components/SeoLegalPage.astro';
import { CITY_LANDINGS } from '../data/CITY_LANDINGS';
import { MATERIAS_COBERTURA, materiaNombre, materiasDe } from '../data/COBERTURA';

/**
 * Mapa de cobertura: qué plaza atiende qué materia y desde qué despacho.
 *
 * La pregunta que responde es la de alguien que ya sabe qué le pasa y quiere
 * saber a quién llamar en su pueblo: no qué servicios hay en abstracto, sino
 * qué se hace en Estepona, en Cabra o en Almuñécar.
 *
 * Los datos salen de `src/data/cities/*.ts` a través de
 * `materiasDe()`, que lee el campo `matters` de cada ficha. Es una lectura por
 * palabras clave, no una declaración, y por eso la página enseña **el texto
 * original de la ficha** debajo de cada plaza: si una etiqueta parece rara, ahí
* está la frase que la produjo. Se explica en la cabecera de `COBERTURA.ts` y
 * también en la página, porque quien la lee tiene derecho a saber de dónde
 * sale lo que está leyendo.
 *
 * Las dos oficinas (Lucena y Málaga) no salen de `CITY_LANDINGS` porque están
 * fuera de él: se añaden aparte, con la diferencia de que en ellas sí hay
 * despacho abierto.
 */

const plazaDe = (c: (typeof CITY_LANDINGS)[number]) => ({
	ciudad: c.city,
	slug: c.slug,
	provincia: c.province,
	href: `/abogados-en-${c.slug}/`,
	oficina: c.office,
	viaje: c.travel,
	sectores: c.sectors,
	materias: c.matters,
	temas: materiasDe(c.matters),
});

const plazas = CITY_LANDINGS.map(plazaDe).sort((a, b) =>
	a.ciudad.localeCompare(b.ciudad, 'es'),
);

const oficinas = [
	{
		ciudad: 'Málaga',
		slug: 'malaga',
		href: '/abogados-en-malaga/',
		provincia: 'Málaga',
		nota: 'Oficina abierta en Málaga',
	},
	{
		ciudad: 'Lucena',
		slug: 'lucena',
		href: '/abogados-en-lucena/',
		provincia: 'Córdoba',
		nota: 'Oficina abierta en Lucena',
	},
];

const provincias = [...new Set(plazas.map((p) => p.provincia))].sort((a, b) =>
	a.localeCompare(b, 'es'),
);

/** Recuento por materia, para los chips y para el orden de la lista. */
const conteo = MATERIAS_COBERTURA.map((m) => ({
	...m,
	plazas: plazas.filter((p) => p.temas.includes(m.id)).length,
})).sort((a, b) => b.plazas - a.plazas);

const sections = [
	{
		title: 'Qué es una plaza y qué es una cobertura',
		content:
			'Una plaza es una localidad donde hay alguien que nos llama de forma recurrente. Una cobertura es que la atendemos, aunque no haya despacho abierto: la cita se cierra por escrito y la primera valoración se hace por videollamada. Confundir las dos cosas es el error más común en las webs de abogados de provincia, y aquí está dicho al revés de como se dice normalmente: de las plazas de esta página, en ninguna hay una oficina. Las dos oficinas son Lucena y Málaga.',
		points: [
			`${plazas.length} plazas con ficha, en ${provincias.length} provincias.`,
			'Dos oficinas abiertas: Lucena y Málaga. En el resto, cita cerrada y videollamada.',
			'Cada ficha da el tiempo real de carretera hasta la oficina que lo lleva.',
			'El detalle de si hay plazos corriendo ono lo dice la portada: lo dice la consulta.',
		],
	},
	{
		title: 'Por qué los municipios que van al mismo juzgado están juntos',
		content:
			'Porque así trabaja el partido judicial, y porque de ahí sale el tipo de caso. Almuñécar, Nerja y Torrox son tres economías distintas —turismo, pesca, agricultura de secano— pero comparten tribunal, y eso hace que muchas consultas se repitan: herencias de fincas, laboral agrario y familia. La ficha de cada plaza recoge los sectores económicos reales y las materias que más se acumulan, y ese es el contenido que se ve en esta página.',
		points: [
			'El tribunal agrupa municipios, no ciudades sueltas.',
			'Los sectores económicos de la zona explican qué casos aparecen.',
			'Lo social se tramita en la capital de provincia, no en el partido.',
			'El mapa de partidos judiciales está en otra página, con los municipios de cada uno.',
		],
	},
	{
		title: 'Lo que este mapa no promete',
		content:
			'No promete que el despacho gane el caso ni que atienda urgencias a las tres de la mañana. Promete lo comprobable: qué materias se consultan en cada plaza, desde qué oficina se atienden y cuánto se tarda en llegar. Lo que necesita un caso concreto —si hay plazo, si el órgano es el correcto, qué opciones hay— se responde en la primera consulta, que es gratuita y confidencial. Un mapa de cobertura es un punto de partida, no un resultado.',
		points: [
			'La primera consulta es gratuita y confidencial.',
			'Si hay un plazo corriendo, se dice en esa primera llamada.',
			'El detalle de cada plaza está en su ficha, enlazada desde cada tarjeta.',
			'Si tu municipio no está en la lista, también lo atendemos: escríbenos y lo miramos.',
		],
	},
];

const faqs = [
	{
		question: '¿Hay oficina en mi pueblo?',
		answer:
			'No. Este despacho tiene dos oficinas abiertas, en Lucena y en Málaga. Las demás plazas de la lista se atienden desde una de esas dos, con cita cerrada y primera valoración por videollamada. Si hace falta ir, se acuerda por escrito con antelación, y cada ficha dice cuánto se tarda.',
	},
	{
		question: '¿Atendéis pueblos que no salen en el mapa?',
		answer:
			'Sí. La lista recoge las plazas donde llega consulta de forma recurrente, no una frontera de trabajo. También se atiende a clientes de los partidos judiciales de las mismas provincias que no tienen ficha, y de cualquier otro lugar de España. Lo que cambia es la cercanía: en un pueblo sin consulta habitual se trabaja peor por teléfono, y eso se dice en la consulta.',
	},
	{
		question: '¿Cómo sabéis qué materias se consultan en cada plaza?',
		answer:
			'Por lo que llega a la consulta en esa plaza. Cada ficha recoge las materias que más se acumulan y los sectores económicos de la zona, y esta página las enseña tal cual. La etiqueta de cada materia sale de leer ese texto, no de un catálogo de servicios: es un resumen, y el detalle está en la ficha de cada plaza.',
	},
	{
		question: '¿El juicio social va al mismo juzgado que el resto?',
		answer:
			'No. La jurisdicción social no sigue al partido judicial: se tramita en la Sección de lo Social del Tribunal de Instancia de la capital de provincia. Es el error más común al buscar por internet. En la página de partidos judiciales está el detalle por plaza, con la capital de cada provincia.',
	},
	{
		question: '¿Cuánto cuesta la primera consulta?',
		answer:
			'Nada, y es confidencial. Se revisan los documentos, se identifica la materia, el órgano competente y si corre algún plazo, y se dan las opciones con su coste. Los honorarios se acordan después y por escrito, con presupuesto cerrado.',
	},
];

const related = [
	{
		label: 'Partidos judiciales',
		href: '/partidos-judiciales/',
		description: 'Qué partido cubre cada plaza y dónde va el juicio social.',
	},
	{
		label: 'Qué juzgado me corresponde',
		href: '/que-juzgado-me-corresponde/',
		description: 'Busca tu municipio y te dice el órgano competente.',
	},
	{
		label: 'Oficinas y ubicaciones',
		href: '/ubicaciones/',
		description: 'Lucena y Málaga, con direcciones y horarios.',
	},
	{
		label: 'Servicios',
		href: '/servicios/',
		description: 'Las materias del despacho, explicadas una a una.',
	},
	{
		label: 'Calculadora de plazos',
		href: '/calculadora-plazos/',
		description: 'Cuántos días te quedan, con el artículo al lado.',
	},
];
---

<SeoLegalPage
	title="Dónde atendemos y en qué materias | Scruz"
	description="Las plazas que cubrimos en Málaga, Córdoba, Cádiz, Granada, Jaén y Huelva: las materias que se consultan en cada una y el despacho que las lleva."
	breadcrumb={[
		{ label: 'Inicio', href: '/' },
		{ label: 'Ubicaciones', href: '/ubicaciones/' },
		{ label: 'Dónde atendemos', href: '/donde-atendemos/' },
	]}
	eyebrow="Cobertura"
	headline="Dónde atendemos y en qué materias"
	intro="Un mapa de la cobertura real: qué se consulta en cada plaza, qué oficina lleva el caso y cuánto se tarda en llegar. Sin plazas inventadas ni promesas de cercanía: si tu pueblo no sale, también lo atendemos."
	highlights={[
		`${plazas.length} plazas con ficha en ${provincias.length} provincias`,
		'Materias de cada plaza, con el texto de la ficha a la vista',
		'Las dos oficinas: Lucena y Málaga',
		'Tiempo real de coche, plaza por plaza',
	]}
	serviceType="Consulta sobre cobertura y plaza de atención"
	areaServed="Málaga, Córdoba, Cádiz, Granada, Huelva y Jaén"
	sections={sections}
	faqs={faqs}
	related={related}
	guides={['alquiler-de-habitaciones', 'despido-por-bajo-rendimiento', 'heredar-con-testamento']}
/>

<section class="bg-base-200 px-6 py-14 md:px-16">
	<div class="mx-auto max-w-4xl">
		<h2 class="mb-2 font-title text-2xl md:text-3xl">Las dos oficinas</h2>
		<p class="mb-6 max-w-3xl text-base-content/70">
			Esto es lo único que hay abierto. El resto de la cobertura sale de
			estas dos oficinas.
		</p>
		<div class="grid gap-4 sm:grid-cols-2">
			{
				oficinas.map((o) => (
					<a
						href={o.href}
						class="rounded-box border border-base-300 bg-base-100 p-5 transition hover:border-primary"
					>
						<h3 class="font-title text-xl">Abogados en {o.ciudad}</h3>
						<p class="text-sm text-base-content/70">{o.nota} · {o.provincia}</p>
					</a>
				))
			}
		</div>
	</div>
</section>

<section class="bg-base-100 px-6 py-14 md:px-16">
	<div class="mx-auto max-w-5xl">
		<h2 class="mb-2 font-title text-2xl md:text-3xl">Filtra por materia o por despacho</h2>
		<p class="mb-6 max-w-3xl text-base-content/70">
			Las materias salen de leer el campo de materias de cada ficha, que se
			enseña al final de cada tarjeta. Si una etiqueta te resulta rara, ahí
			está la frase que la produjo.
		</p>

		<div class="mb-4">
			<span class="mb-2 block text-sm font-semibold">Materia</span>
			<div class="flex flex-wrap gap-2" id="filtro-materias">
				<button class="btn btn-sm btn-primary" data-materia="todas">
					Todas
				</button>
				{
					conteo.map((m) => (
						<button class="btn btn-sm btn-ghost" data-materia={m.id}>
							{m.nombre} ({m.plazas})
						</button>
					))
				}
			</div>
		</div>

		<div class="mb-8">
			<span class="mb-2 block text-sm font-semibold">Despacho</span>
			<div class="flex flex-wrap gap-2" id="filtro-oficinas">
				<button class="btn btn-sm btn-outline btn-primary" data-oficina="todas">
					Todos
				</button>
				<button class="btn btn-sm btn-ghost" data-oficina="malaga">Málaga</button>
				<button class="btn btn-sm btn-ghost" data-oficina="lucena">Lucena</button>
			</div>
		</div>

		<p id="contador" class="mb-4 text-sm text-base-content/70"></p>

		<div class="grid gap-4 md:grid-cols-2" id="tarjetas">
			{
				plazas.map((p) => (
					<article class="rounded-box border border-base-300 bg-base-100 p-5" data-materias={p.temas.join(' ')} data-oficina={p.oficina}>
						<div class="flex flex-wrap items-baseline justify-between gap-2">
							<h3 class="font-title text-lg">
								<a class="link link-primary" href={p.href}>
									{p.ciudad}
								</a>
							</h3>
							<span class="text-sm opacity-60">{p.provincia}</span>
						</div>
						<p class="mt-1 text-sm">
							<span class="font-semibold">Desde</span>{' '}
							{p.oficina === 'malaga' ? 'Málaga' : 'Lucena'} — {p.viaje}
						</p>
						<p class="mt-1 text-sm">
							<span class="font-semibold">Sectores</span> {p.sectores}
						</p>
						<div class="mt-3 flex flex-wrap gap-1">
							{p.temas.map((t) => (
								<span class="badge badge-ghost badge-sm">{materiaNombre(t)}</span>
							))}
						</div>
						<p class="mt-3 border-t border-base-300 pt-2 text-xs opacity-70">
							Materias según la ficha de la plaza: {p.materias}
						</p>
					</article>
				))
			}
		</div>

		<p id="vacio" class="mt-6 hidden rounded-box border border-warning/40 bg-warning/10 p-4">
			No hay ninguna plaza con esa combinación de filtros. Pero eso no quiere
			decir que no lo atendamos: significa que no hay consulta registrada con
			esa materia en esa zona. Escríbenos y lo miramos.
		</p>
	</div>
</section>

<script>
	/**
	 * Filtro de la cobertura. Va en cliente porque son 29 tarjetas y filtrar el
	 * DOM es instantáneo; una página nueva por combinación sería absurdo.
	 */
	const botonesMateria = [...document.querySelectorAll<HTMLButtonElement>('[data-materia]')];
	const botonesOficina = [...document.querySelectorAll<HTMLButtonElement>('[data-oficina]')];
	const tarjetas = [...document.querySelectorAll<HTMLElement>('#tarjetas article')];
	const contador = document.getElementById('contador');
	const vacio = document.getElementById('vacio');

	let materia = 'todas';
	let oficina = 'todas';

	const filtrar = () => {
		let visibles = 0;
		for (const t of tarjetas) {
			const lista = (t.dataset.materias ?? '').split(' ');
			const encaja =
				(materia === 'todas' || lista.includes(materia)) &&
				(oficina === 'todas' || t.dataset.oficina === oficina);
			t.classList.toggle('hidden', !encaja);
			if (encaja) visibles += 1;
		}
		if (contador) {
			contador.textContent = `Mostrando ${visibles} de ${tarjetas.length} plazas.`;
		}
		vacio?.classList.toggle('hidden', visibles > 0);
	};

	for (const b of botonesMateria) {
		b.addEventListener('click', () => {
			materia = b.dataset.materia ?? 'todas';
			for (const otro of botonesMateria) otro.classList.remove('btn-primary');
			b.classList.add('btn-primary');
			filtros();
		});
	}
	for (const b of botonesOficina) {
		b.addEventListener('click', () => {
			oficina = b.dataset.oficina ?? 'todas';
			for (const otro of botonesOficina) {
				otro.classList.remove('btn-outline', 'btn-primary');
				otro.classList.add('btn-ghost');
			}
			b.classList.add('btn-outline', 'btn-primary');
			filtros();
		});
	}
	const filtros = () => filtrar();
	filtrar();
</script>
