---
import heroImg from '@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	TriangleAlert,
	Award,
	BadgePercent,
	BellRing,
	Briefcase,
	FileText,
	HandCoins,
	Hourglass,
	Scale,
	ShieldCheck,
	ShieldPlus,
	Users,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Tengo que denunciar para obtener una orden de protección?',
		answer:
			'No es imprescindible haber presentado denuncia previa. Puedes solicitar directamente una orden de protección ante el juzgado competente o a través del servicio de guardia. Nuestro equipo se encarga de redactar y presentar la solicitud, solicitando además las medidas civiles que necesites (custodia, uso de la vivienda, pensión de alimentos).',
	},
	{
		question: '¿Puedo cambiar de abogado durante el proceso penal?',
		answer:
			'Sí. Tienes pleno derecho a elegir y cambiar de abogado en cualquier momento del procedimiento. Si decides confiar en nosotros, nos haremos cargo del caso desde el estado en que se encuentre, solicitando las copias necesarias y revisando todas las actuaciones para reforzar tu defensa.',
	},
	{
		question: '¿Qué medidas urgentes puedo solicitar?',
		answer:
			'Entre las más habituales: orden de alejamiento, prohibición de comunicación, suspensión del régimen de visitas del agresor, atribución del uso de la vivienda familiar, custodia monoparental de los hijos, pensión de alimentos y, en casos graves, prisión provisional para el denunciado. Actuamos con la máxima rapidez para que estés protegida desde el primer momento.',
	},
	{
		question: '¿La asistencia jurídica es gratuita?',
		answer:
			'En violencia de género tienes derecho a asistencia jurídica gratuita con independencia de tu nivel de ingresos. Nosotros te ayudamos a solicitar el reconocimiento del derecho de asistencia jurídica gratuita ante el Colegio de Abogados correspondiente. Si ya se te ha reconocido, nuestros honorarios serán cubiertos por el turno de oficio.',
	},
	{
		question: '¿Qué pasa si el agresor incumple la orden de alejamiento?',
		answer:
			'Cualquier vulneración de la orden de protección o de alejamiento constituye un delito de quebrantamiento de condena, tipificado en el artículo 468 del Código Penal. Es fundamental que lo pongas inmediatamente en conocimiento de las fuerzas de seguridad y de tu abogado. Nos encargamos de solicitar las medidas cautelares necesarias y de personarnos como acusación para reforzar la respuesta penal.',
	},
	{
		question: '¿Puedo solicitar una indemnización por el daño sufrido?',
		answer:
			'Sí. La Ley Orgánica 1/2004 reconoce a las víctimas de violencia de género el derecho a una indemnización por los daños y perjuicios físicos, psíquicos y morales. Te asesoramos sobre las cuantías reclamables y los plazos para hacerlo, así como sobre las ayudas públicas autonómicas y estatales a las que puedes acceder.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};
---

<CustomLayout
	title="Abogado de Violencia de Género en Lucena | Atención 24 h"
	description="Atención confidencial para víctimas, también de urgencia y por videollamada: denuncia, orden de protección y recursos. Llama ahora: 666 329 155."
	keywords="abogado violencia de género, violencia género Lucena, orden de protección Córdoba, abogado Málaga violencia, asistencia jurídica gratuita víctima, asesoramiento legal violencia género"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Violencia de Género', url: '/violencia-genero/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/violencia-genero/#service`,
			serviceType: 'Derecho Penal y de Familia',
			name: 'Asistencia jurídica a víctimas de violencia de género',
			description:
				'Apoyo legal inmediato, confidencial y especializado. Denuncias, órdenes de protección y personación en causa penal.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Asistencia jurídica inmediata y confidencial para víctimas de violencia de género"
		supertitle="Urgencia · Confidencialidad · Justicia gratuita"
		description="Asistencia jurídica inmediata, confidencial y especializada. Primera consulta gratuita y, si acreditas insuficiencia de ingresos, justicia gratuita sin coste."
		gradient="warm"
		statsAppearance="light"
		whatsappHref="https://wa.me/34666329155?text=Hola%2C%20necesito%20asesor%C3%ADa%20urgente%20sobre%20violencia%20de%20g%C3%A9nero."
		stats={[
			{ Icon: BellRing, label: 'Plazo', value: '24h desde contacto' },
			{ Icon: BadgePercent, label: 'Coste', value: 'Justicia gratuita' },
			{ Icon: ShieldCheck, label: 'Privacidad', value: 'Confidencial total' },
		]}
	>
		<span slot="title">Abogado de violencia de género en Lucena: <span class="text-primary">no estás sola.</span></span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'<span class="text-primary">Atención urgente</span>, confidencialidad absoluta y acompañamiento integral.'}
		factboxSupertitle="Tus garantías"
		factboxTitle="Lo que puedes esperar"
		factboxTheme="success"
		factboxItems={[
			{
				Icon: BellRing,
				title: 'Atención inmediata',
				description:
					'Te escuchamos el mismo día en que contactas. Sin esperas ni derivaciones innecesarias.',
			},
			{
				Icon: Award,
				title: 'Turno de oficio',
				description:
					'En violencia de género la asistencia jurídica gratuita es un derecho. Te ayudamos a solicitarlo ante el Colegio de Abogados.',
			},
			{
				Icon: ShieldCheck,
				title: 'Confidencialidad',
				description:
					'Toda la información está protegida por el secreto profesional. Tu caso no sale de nuestro despacho.',
			},
		]}
	>
		<p class="mb-4">
			Ante la violencia de género, la ley está de tu lado y el tiempo es un factor decisivo.
			En Scruz Abogados ofrecemos un apoyo legal inmediato, confidencial y especializado, con
			letrados con experiencia acreditada en violencia machista que conocen los juzgados de
			Lucena, Córdoba y Málaga y el funcionamiento de los servicios de asistencia a la víctima.
		</p>
		<p class="mb-4">
			Te asistimos durante toda la denuncia, tramitamos las órdenes de protección necesarias
			para tu seguridad y la de tus hijos, y nos personamos como acusación particular para
			que tu voz sea escuchada en el proceso penal. Si ya hay procedimiento abierto, nos
			hacemos cargo desde el estado en que se encuentre, sin que tengas que empezar de cero.
		</p>
		<p>
			Nuestra prioridad absoluta es tu integridad física y emocional. Por eso, además del
			asesoramiento jurídico, te orientamos sobre los recursos públicos disponibles (centros
			de emergencia, pisos tutelados, ayudas autonómicas, intervención psicológica
			especializada) y trabajamos en coordinación con las fuerzas de seguridad y los servicios
			sociales cuando es necesario.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="En qué te protegemos"
		title="Actuamos en cada fase del proceso"
		description="Desde la primera consulta hasta el seguimiento posterior, cubrimos todas las fases de tu defensa: penal, civil y de protección."
		items={[
			{
				Icon: ShieldPlus,
				title: 'Orden de protección',
				description:
					'Solicitamos medidas cautelares urgentes: alejamiento, prohibición de comunicación, suspensión de armas y cualquier otra medida que garantice tu integridad y la de tus hijos.',
			},
			{
				Icon: FileText,
				title: 'Denuncia y asistencia letrada',
				description:
					'Te acompañamos en comisaría, ante el juzgado de guardia y durante todo el atestado, cuidando cada detalle para que la denuncia refleje fielmente los hechos.',
			},
			{
				Icon: Briefcase,
				title: 'Personación como acusación',
				description:
					'Nos personamos en la causa penal como acusación particular para velar por tus intereses y solicitar penas y responsabilidades civiles proporcionadas.',
			},
			{
				Icon: Users,
				title: 'Medidas civiles',
				description:
					'Custodia monoparental, régimen de visitas, pensión de alimentos, uso de la vivienda familiar y demás medidas para recuperar tu autonomía.',
			},
			{
				Icon: TriangleAlert,
				title: 'Incumplimientos y quebrantamientos',
				description:
					'Si el agresor incumple la orden de protección, actuamos de inmediato: denuncia por quebrantamiento de condena y solicitud de prisión provisional.',
			},
			{
				Icon: HandCoins,
				title: 'Indemnización y ayudas',
				description:
					'Reclamamos la indemnización por daños físicos, psíquicos y morales y te asesoramos sobre las ayudas públicas autonómicas y estatales.',
			},
		]}
	/>

	<EditorialMeasures
		supertitle="Lo que puedes solicitar"
		title="Medidas concretas a tu alcance"
		description="Una visión rápida de las principales medidas que podemos activar y los plazos o cuantías habituales. Cada caso se valora individualmente."
		valueFormat="single"
		valueColor="success"
		noteLabel="Información orientativa."
		disclaimer="Cifras y plazos orientativos. La valoración concreta depende de tu situación personal, familiar y económica — concertamos una cita confidencial para definirla."
		items={[
			{
				title: 'Orden de protección',
				value: 'Inmediata',
				note: 'Presentada y resuelta en un plazo de 72 horas por el juzgado de guardia.',
			},
			{
				title: 'Custodia monoparental',
				value: 'A acordar',
				note: 'Solicitada desde el primer momento; revisable en función del interés del menor.',
			},
			{
				title: 'Pensión de alimentos',
				value: '100 € — 1.500 €/mes',
				note: 'Cuantía mensual en función de los ingresos del obligado y las necesidades de los menores.',
			},
			{
				title: 'Uso de la vivienda familiar',
				value: 'Hasta sentencia',
				note: 'Atribución preferente para la víctima y, en su caso, para los hijos menores.',
			},
		]}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="Acompañamiento paso a paso"
		items={[
			{
				number: '01',
				title: 'Primera consulta confidencial',
				description:
					'Te escuchamos sin prisa, valoramos la urgencia y te explicamos las opciones reales desde el primer minuto. Toda la información está protegida por el secreto profesional.',
			},
			{
				number: '02',
				title: 'Plan de actuación inmediato',
				description:
					'Te presentamos una estrategia clara con las medidas urgentes a solicitar, los plazos y los recursos públicos disponibles. Nunca tomas decisiones a ciegas.',
			},
			{
				number: '03',
				title: 'Personación y defensa',
				description:
					'Actuamos en comisaría, en el juzgado de guardia y durante todo el proceso. Te acompañamos a cada comparecencia para que nunca vayas sola ante el agresor.',
			},
			{
				number: '04',
				title: 'Seguimiento continuo',
				description:
					'Te mantenemos informada de cada novedad, recurso y resolución, y revisamos junto a ti la estrategia cuando cambian las circunstancias.',
			},
		]}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Atención inmediata, confidencialidad absoluta."
		items={[
			{
				Icon: Scale,
				title: 'Especialistas en violencia de género',
				description:
					'Equipo con formación específica y experiencia contrastada en procedimientos penales y civiles derivados de violencia machista.',
			},
			{
				Icon: Hourglass,
				title: 'Actuación 24h',
				description:
					'Atendemos urgencias en menos de 24 horas. Si hay riesgo, activamos de inmediato la solicitud de orden de protección o el protocolo de emergencia.',
			},
			{
				Icon: Users,
				title: 'Red de recursos',
				description:
					'Trabajamos en coordinación con centros de la mujer, servicios sociales y asociaciones especializadas para darte una atención integral.',
			},
			{
				Icon: BadgePercent,
				title: 'Asistencia jurídica gratuita',
				description:
					'Te ayudamos a solicitar el derecho a asistencia jurídica gratuita. Nadie queda sin defensa por motivos económicos.',
			},
		]}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Resolvemos tus dudas"
		description="Las preguntas más habituales sobre órdenes de protección, asistencia gratuita y plazos."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Estamos a tu lado"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Te informamos de las opciones, los plazos y los recursos públicos. Si decides no continuar, no pagas nada."
		relatedLinks={[
			{ label: 'Derechos y recursos: guía', href: '/blog/asistencia-violencia-genero/' },
			{ label: 'Cómo poner la denuncia: guía', href: '/blog/denuncia-violencia-genero/' },
			{ label: 'Derecho penal', href: '/derecho-penal/' },
			{ label: 'Sobre nosotros', href: '/quienes-somos/' },
		]}
	/>
</CustomLayout>
