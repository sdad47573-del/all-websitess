---
import heroImg from '../@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	Ban,
	BookOpen,
	Car,
	Clock,
	Euro,
	FileCheck,
	Handshake,
	Landmark,
	Scale,
	ShieldCheck,
	Users,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Qué cubre el seguro agrario combinado?',
		answer:
			'Depende de la línea contratada y de las coberturas incluidas en la póliza. Con carácter general cubre daños por pedrisco, helada, lluvia, viento, incendio, inundación o ataque de fauna salvaje según el cultivo o la explotación ganadera asegurada. Cada póliza delimita los riesgos cubiertos, los plazos de comunicación del siniestro y las franquicias. Revisamos tu póliza para determinar qué siniestros están amparados antes de reclamar.',
	},
	{
		question: '¿Qué hago si la aseguradora rechaza mi siniestro o paga menos de lo debido?',
		answer:
			'Primero conviene impugnar la valoración pericial: si no estás de acuerdo con el perito de la aseguradora, puedes designar un perito de tu parte o solicitar la intervención de un tercero perito para dirimir la discrepancia. Si la entidad mantiene su postura o no paga, interponemos la reclamación extrajudicial y, en su caso, la demanda judicial para reclamar la indemnización completa más los intereses de demora.',
	},
	{
		question: '¿Cuánto tiempo tengo para reclamar a mi aseguradora?',
		answer:
			'Las acciones derivadas del contrato de seguro prescriben a los dos años desde el siniestro (artículo 23 de la Ley de Contrato de Seguro). Además, tu propia póliza suele fijar un plazo muy breve para comunicar el daño, por lo que recomendamos avisar a la aseguradora y a tu perito lo antes posible y conservar toda la documentación del siniestro.',
	},
	{
		question: '¿Qué son los intereses del artículo 20 de la Ley de Contrato de Seguro?',
		answer:
			'Es la sanción por la demora de la aseguradora en pagar la indemnización. Cuando la entidad no paga o consigna la cantidad debida dentro del plazo legal, se devenga un interés anual equivalente al interés legal del dinero incrementado en un 50%. Si el retraso supera los dos años desde el siniestro, el interés no puede ser inferior al 20% anual. Estos intereses pueden superar con creces la propia indemnización.',
	},
	{
		question: '¿La indemnización puede reducirse por infraseguro o por culpa del asegurado?',
		answer:
			'Sí. Si el valor asegurado en la póliza es inferior al valor real de la explotación o de los bienes asegurados (infraseguro), la aseguradora aplica la regla proporcional y reduce la indemnización. También pueden aplicarse reducciones si se incumplen deberes como la comunicación del siniestro en plazo o la conservación de los restos para su peritación. Te asesoramos sobre si la reducción aplicada es legítima o procede reclamarla.',
	},
	{
		question: '¿Qué documentación necesito para reclamar un siniestro agrario?',
		answer:
			'La póliza y sus condiciones particulares, la declaración de seguro, la comunicación del siniestro presentada, las fotografías y vídeos de los daños, el parte pericial, las facturas o valoraciones de los daños y, en su caso, los informes agronómicos o veterinarios. Con esa documentación analizamos tu caso, comprobamos la cobertura y calculamos si la oferta de la aseguradora se ajusta a lo que te corresponde.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: ShieldCheck, label: 'Especialidad', value: 'Seguros agrarios' },
	{ Icon: Landmark, label: 'Sedes', value: 'Lucena · Córdoba · Málaga' },
	{ Icon: Scale, label: 'Primera cita', value: 'Gratuita' },
];

const plazos = [
	{
		Icon: Clock,
		title: '2 años',
		description: 'Prescripción de las acciones del contrato de seguro (art. 23 LCS).',
	},
	{
		Icon: FileCheck,
		title: '3 meses',
		description: 'Plazo general de la aseguradora para pagar antes de los intereses de demora.',
	},
	{
		Icon: Euro,
		title: '+50 %',
		description: 'Interés de demora del art. 20 LCS sobre el interés legal por cada año de retraso.',
	},
];

const conceptos = [
	{
		Icon: Car,
		title: 'Siniestros en explotaciones agrarias',
		description:
			'Pedrisco, helada, sequía, lluvia, incendio o fauna salvaje en cultivos de olivar, cereal, frutales, hortícolas o en explotaciones ganaderas: analizamos la cobertura y reclamamos lo que te corresponde.',
	},
	{
		Icon: FileCheck,
		title: 'Impugnación de valoraciones periciales',
		description:
			'Cuando la peritación de la aseguradora valora el daño por debajo de la realidad, designamos perito de parte, instamos el peritaje contradictorio o la intervención de tercer perito.',
	},
	{
		Icon: Ban,
		title: 'Siniestros rechazados o mal pagados',
		description:
			'Reclamamos cuando la aseguradora deniega la cobertura o aplica reducciones injustificadas (infraseguro, franquicias, exclusiones mal interpretadas) y defendemos tu posición en juicio si es necesario.',
	},
	{
		Icon: Euro,
		title: 'Intereses de demora (art. 20 LCS)',
		description:
			'Reclamamos los intereses que la aseguradora debe abonar por cada día de retraso en el pago de la indemnización, que pueden superar la propia cantidad principal.',
	},
	{
		Icon: Users,
		title: 'Seguros ganaderos y otros ramos',
		description:
			'Cubrimos también las reclamaciones de pólizas ganaderas y de otros ramos vinculados a la actividad agraria o agroalimentaria de la comarca.',
	},
	{
		Icon: BookOpen,
		title: 'Revisión y contratación de pólizas',
		description:
			'Te asesoramos antes de asegurar: coberturas, capitales asegurados, franquicias y condiciones para evitar sustos cuando llega el siniestro.',
	},
];

const pasos = [
	{
		number: '01',
		title: 'Análisis del siniestro',
		description:
			'Revisamos tu póliza, la comunicación del siniestro y la valoración pericial para determinar la cobertura aplicable y la indemnización que te corresponde.',
	},
	{
		number: '02',
		title: 'Peritaje y reclamación extrajudicial',
		description:
			'Si la valoración no se ajusta al daño real, designamos perito de parte o instamos el peritaje contradictorio y presentamos la reclamación a la aseguradora.',
	},
	{
		number: '03',
		title: 'Vía judicial',
		description:
			'Si la entidad no paga o mantiene una oferta insuficiente, interponemos la demanda de reclamación de cantidad con los intereses del artículo 20 LCS.',
	},
	{
		number: '04',
		title: 'Cobro efectivo',
		description:
			'Si la aseguradora no cumple la sentencia, instamos su ejecución para que cobres la indemnización y los intereses de forma efectiva.',
	},
];

const why = [
	{
		Icon: ShieldCheck,
		title: 'Conocemos el seguro agrario',
		description:
			'Las pólizas agrarias tienen particularidades propias: líneas de seguro, coberturas por cultivo, plazos de comunicación y peritajes específicos. Sabemos cómo funcionan.',
	},
	{
		Icon: Handshake,
		title: 'Cercanía al agricultor y al ganadero',
		description:
			'En la comarca de Lucena la actividad agrícola y ganadera es el sustento de muchas familias. Te atendemos con conocimiento del terreno y del sector.',
	},
	{
		Icon: Euro,
		title: 'Reclamamos hasta el último euro',
		description:
			'No nos conformamos con la primera oferta de la aseguradora: reclamamos la indemnización íntegra y los intereses de demora cuando la entidad se retrasa injustificadamente.',
	},
];

const rangos = [
	{
		title: 'Prescripción de acciones',
		value: '2 años',
		note: 'Desde el siniestro (art. 23 de la Ley de Contrato de Seguro)',
	},
	{
		title: 'Pago de la indemnización',
		value: '3 meses',
		note: 'Plazo general de la aseguradora antes de devengarse intereses de demora',
	},
	{
		title: 'Peritaje contradictorio',
		value: 'Semanas',
		note: 'Valoración y discrepancias periciales según la normativa del seguro',
	},
	{
		title: 'Reclamación judicial',
		value: '6 — 12 meses',
		note: 'Juicio verbal u ordinario según la cuantía reclamada',
	},
];
---

<CustomLayout
	title="Abogado de Seguros Agrarios en Lucena | Scruz Abogados"
	description="Abogado de seguros agrarios en Lucena, Córdoba y Málaga. Reclamamos tu indemnización íntegra por pedrisco, helada o sequía. Consulta gratuita: 666 329 155."
	keywords="abogado seguros agrarios Lucena, reclamación seguros agrarios Córdoba, seguro agrario pedrisco, peritaje contradictorio, abogado aseguradoras agrarias, indemnización siniestro agrario, artículo 20 LCS, abogado seguros Málaga"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Seguros Agrarios', url: '/seguros-agrarios/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/seguros-agrarios/#service`,
			serviceType: 'Derecho de Seguros',
			name: 'Reclamaciones de seguros agrarios',
			description:
				'Reclamación de indemnizaciones por siniestros en explotaciones agrarias y ganaderas, impugnación de peritajes e intereses de demora en Lucena, Córdoba y Málaga.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Abogados especialistas en reclamaciones de seguros agrarios en Lucena, Córdoba y Málaga"
		supertitle="Derecho de Seguros · Seguros agrarios"
		description="Si tu explotación ha sufrido un siniestro y la aseguradora no paga o paga menos de lo debido, reclamamos lo que te corresponde."
		stats={heroStats}
	>
		<span slot="title">Abogado de seguros agrarios en Lucena: <span class="text-primary">tu cosecha no es un número.</span></span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'Cuando la aseguradora no responde, <span class="text-primary">reclamamos por ti</span>.'}
		factboxSupertitle="Claves del seguro agrario"
		factboxTitle="Lo que debes saber"
		factboxItems={plazos}
	>
		<p class="mb-4">
			Una pedrada que arrasa el olivar, una helada que daña la cosecha, la sequía que castiga el
			cereal o un siniestro en la explotación ganadera: cuando llega el momento de cobrar, no
			siempre es fácil. Las aseguradoras valoran los daños por debajo de la realidad, aplican
			reducciones o retrasan el pago confiando en que el agricultor no reclame.
		</p>
		<p class="mb-4">
			En Scruz Abogados defendemos a agricultores y ganaderos en las reclamaciones de sus
			pólizas agrarias: revisamos la cobertura del siniestro, impugnamos las valoraciones
			periciales insuficientes, reclamamos a la aseguradora la indemnización íntegra y, cuando
			es necesario, acudimos a los tribunales exigiendo además los intereses de demora del
			artículo 20 de la Ley de Contrato de Seguro.
		</p>
		<p>
			Actuar con rapidez marca la diferencia: comunica el siniestro en el plazo de tu póliza,
			conserva las pruebas de los daños y consulta antes de aceptar cualquier valoración.
			Analizamos tu caso en la primera consulta gratuita y te decimos con transparencia si tu
			reclamación tiene recorrido.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué tramitamos"
		title="Reclamaciones de seguros agrarios"
		description="Toda la defensa del asegurado agrario: siniestros, peritajes, indemnizaciones insuficientes e intereses de demora."
		items={conceptos}
	/>

	<EditorialMeasures
		supertitle="Tiempos y plazos"
		title="Plazos que debes conocer"
		description="Los plazos clave de la normativa de seguros aplicable a tu póliza agraria. La confirmación exacta depende de las condiciones de tu contrato."
		valueFormat="single-currency"
		noteLabel="Plazo orientativo."
		disclaimer="Plazos generales de la Ley de Contrato de Seguro. La cobertura concreta y los plazos de comunicación del siniestro dependen de las condiciones particulares de cada póliza."
		items={rangos}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="Cómo reclamamos tu siniestro"
		items={pasos}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="No aceptes la primera oferta: reclama lo que te corresponde."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Resolvemos tus dudas"
		description="Las preguntas más habituales sobre coberturas, peritajes, plazos e intereses en los seguros agrarios."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Estamos a tu lado"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Tráenos tu póliza y la documentación del siniestro y valoramos tu reclamación. Si decides no continuar, no pagas nada."
		relatedLinks={[
			{ label: 'Derecho civil', href: '/derecho-civil/' },
			{ label: 'Cobro de deudas e impagos', href: '/cobro-deudas-impagos/' },
			{ label: 'Empresas', href: '/empresas/' },
		]}
	/>
</CustomLayout>
