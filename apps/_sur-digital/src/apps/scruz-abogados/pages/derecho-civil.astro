---
import heroImg from '@assets/ABOGADOS/319e5a0c74c5c97198f1314428c7f399.webp';
import { SITE_URL } from '../data/site';
import {
	Ban,
	BookOpen,
	Car,
	Clock,
	FileCheck,
	FilePenLine,
	Handshake,
	House,
	Landmark,
	Scale,
	ShieldCheck,
	UserCheck,
	Users,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Qué asuntos abarca el Derecho Civil en Lucena?',
		answer:
			'El Derecho Civil es la rama más amplia del ordenamiento: contratos, compraventas, arrendamientos, desahucios, responsabilidad civil, consumo, seguros, propiedad, vecindad, reclamaciones de cantidad y obligaciones entre particulares. En Scruz Abogados te asesoramos en todos estos asuntos en Lucena, Córdoba y Málaga.',
	},
	{
		question: '¿Cuánto puedo reclamar por responsabilidad civil?',
		answer:
			'Depende del daño sufrido: daños materiales, lucro cesante, daños personales y morales. Si hay lesiones se aplica el baremo de tráfico vigente; en el resto de casos, los tribunales valoran la prueba del perjuicio. Analizamos tu caso en la primera consulta gratuita y te indicamos la cuantía orientativa y las posibilidades reales de éxito.',
	},
	{
		question: '¿Puedo reclamar como consumidor un producto o servicio defectuoso?',
		answer:
			'Sí. La normativa de consumo te protege frente a productos defectuosos, servicios deficientes, publicidad engañosa, cláusulas abusivas o prácticas comerciales desleales. El plazo general es de 5 años para la acción de anulabilidad por vicio del consentimiento y de 3 años para reclamar vicios ocultos. Te asesoramos sobre la vía más adecuada: reclamación extrajudicial, arbitraje de consumo o demanda.',
	},
	{
		question: '¿La compañía de seguros debe pagar mi indemnización?',
		answer:
			'La aseguradora debe responder dentro de la cobertura de la póliza y hasta los límites contratados. Cuando la negativa es injustificada o la oferta es claramente insuficiente, reclamamos judicialmente, incluidos los intereses de demora del artículo 20 de la Ley de Contrato de Seguro, que pueden encarecer notablemente la condena para la aseguradora.',
	},
	{
		question: '¿Qué hago ante un problema de urbanismo o vecindad?',
		answer:
			'Filtraciones, humedades, servidumbres, lindes, obras ilegales, comunidades de propietarios o reclamaciones a la administración por responsabilidad patrimonial. Analizamos el origen del problema, la documentación y las vías disponibles (civil, contencioso-administrativa o penal si hay daños), y buscamos primero la solución negociada.',
	},
	{
		question: '¿Cómo se reclama una deuda o impago entre particulares?',
		answer:
			'La reclamación de cantidad puede hacerse extrajudicialmente (requerimiento) o por vía judicial: juicio monitorio para deudas documentadas o juicio ordinario/verbal según la cuantía. Los intereses y las costas se suman a la deuda principal. Si el deudor no paga, se puede ejecutar el embargo de bienes.',
	},
	{
		question: '¿Necesito abogado para redactar un contrato?',
		answer:
			'Es muy recomendable. Un contrato bien redactado previene conflictos, delimita responsabilidades y protege tus derechos en compraventas, arrendamientos, préstamos, servicios o acuerdos entre particulares. También revisamos contratos ya firmados y cláusulas abusivas antes de aceptarlos.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: Scale, label: 'Ámbito', value: 'Civil y consumo' },
	{ Icon: Landmark, label: 'Sedes', value: 'Lucena · Córdoba · Málaga' },
	{ Icon: UserCheck, label: 'Primera cita', value: 'Gratuita' },
];

const plazos = [
	{
		Icon: Clock,
		title: '3 años',
		description: 'Para reclamar vicios ocultos y responsabilidad extracontractual.',
	},
	{
		Icon: FileCheck,
		title: '5 años',
		description: 'Para la acción de anulabilidad por vicio del consentimiento.',
	},
	{
		Icon: Scale,
		title: 'Interés del 20',
		description: 'Artículo 20 LCS: demora que paga la aseguradora que retrasa el pago.',
	},
];

const conceptos = [
	{
		Icon: FilePenLine,
		title: 'Contratos y compraventas',
		description:
			'Redacción, revisión y negociación de contratos entre particulares y empresas: compraventas, arrendamientos, préstamos, servicios y acuerdos civiles.',
	},
	{
		Icon: Ban,
		title: 'Responsabilidad civil',
		description:
			'Reclamamos daños y perjuicios por negligencia, accidentes fuera de la circulación, daños a terceros y responsabilidad patrimonial de la administración.',
	},
	{
		Icon: ShieldCheck,
		title: 'Derecho de consumo',
		description:
			'Defendemos tus derechos como consumidor frente a productos defectuosos, servicios deficientes, cláusulas abusivas y prácticas comerciales desleales.',
	},
	{
		Icon: Car,
		title: 'Reclamaciones a seguros',
		description:
			'Reclamamos a las compañías aseguradoras la indemnización que te corresponde, incluidos los intereses de demora cuando retrasan o deniegan el pago.',
	},
	{
		Icon: House,
		title: 'Urbanismo y vecindad',
		description:
			'Filtraciones, lindes, servidumbres, obras, comunidades de propietarios y reclamaciones por responsabilidad patrimonial de las administraciones públicas.',
		href: '/urbanismo/',
	},
	{
		Icon: Handshake,
		title: 'Reclamaciones de cantidad',
		description:
			'Reclamamos deudas e impagos entre particulares mediante requerimiento, juicio monitorio o procedimiento ordinario, con intereses y costas.',
	},
];

const pasos = [
	{
		number: '01',
		title: 'Estudio del caso',
		description:
			'Analizamos la documentación, los plazos aplicables y las posibilidades reales de éxito antes de proponerte una estrategia.',
	},
	{
		number: '02',
		title: 'Vía negociada',
		description:
			'Intentamos primero la reclamación extrajudicial: requerimiento, mediación o reclamación ante la compañía o el servicio de atención al cliente.',
	},
	{
		number: '03',
		title: 'Vía judicial',
		description:
			'Si no hay acuerdo, interponemos la demanda: monitorio, verbal, ordinario o contencioso-administrativo según la materia y la cuantía.',
	},
	{
		number: '04',
		title: 'Ejecución',
		description:
			'Si la sentencia no se cumple voluntariamente, instamos la ejecución con embargo de bienes, intereses y costas a tu favor.',
	},
];

const why = [
	{
		Icon: Users,
		title: 'Especialistas en civil y consumo',
		description:
			'Más de 20 años defendiendo asuntos civiles, de consumo, seguros y urbanismo en Lucena, Córdoba y Málaga.',
	},
	{
		Icon: Landmark,
		title: 'Cercanía y disponibilidad',
		description:
			'Atención presencial u online, con horario de oficina de lunes a viernes de 9:00 a 18:00 y atención de urgencias fuera de horario.',
	},
	{
		Icon: BookOpen,
		title: 'Estrategia clara y honesta',
		description:
			'Te explicamos con transparencia las vías disponibles, los plazos y las posibilidades reales de cada reclamación antes de actuar.',
	},
];

const rangos = [
	{
		title: 'Reclamación extrajudicial',
		value: '1 — 3 semanas',
		note: 'Requerimiento y negociación con la parte contraria',
	},
	{
		title: 'Juicio monitorio',
		value: '3 — 6 meses',
		note: 'Para deudas documentadas sin oposición',
	},
	{
		title: 'Juicio ordinario / verbal',
		value: '6 — 12 meses',
		note: 'Según la cuantía y la complejidad del asunto',
	},
	{
		title: 'Ejecución de sentencia',
		value: '3 — 6 meses',
		note: 'Embargo de bienes si no hay pago voluntario',
	},
];
---

<CustomLayout
	title="Abogado Civil en Lucena | Contratos y Responsabilidad Civil"
	description="Contratos, responsabilidad civil, consumo y seguros: reclamamos lo que te deben en Lucena y Córdoba. Consulta gratuita hoy: 666 329 155."
	keywords="abogado civil Lucena, abogado responsabilidad civil Lucena, abogado consumo Lucena, abogado seguros en Lucena, abogado urbanismo Lucena, abogado contratos Lucena, abogado testamentos Lucena, reclamación de cantidad, derecho civil Córdoba"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Derecho Civil', url: '/derecho-civil/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/derecho-civil/#service`,
			serviceType: 'Derecho Civil',
			name: 'Derecho Civil en Lucena y Córdoba',
			description:
				'Contratos, responsabilidad civil, consumo, seguros, urbanismo y reclamaciones de cantidad en Lucena, Córdoba y Málaga.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Abogados especialistas en Derecho Civil, responsabilidad civil y consumo en Lucena, Córdoba y Málaga"
		supertitle="Derecho Civil · Responsabilidad civil · Consumo"
		description="Defendemos tus derechos en contratos, responsabilidad civil, consumo, seguros, urbanismo y reclamaciones de cantidad. Primera consulta gratuita."
		stats={heroStats}
	>
		<span slot="title">Abogado civil en Lucena y Córdoba.</span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'Derecho Civil <span class="text-primary">cercano y eficaz</span> en Lucena, Córdoba y Málaga.'}
		factboxSupertitle="Plazos clave"
		factboxTitle="No dejes pasar los plazos"
		factboxItems={plazos}
	>
		<p class="mb-4">
			El Derecho Civil es la rama que regula la vida cotidiana: los contratos que firmas,
			la compra que no sale como esperabas, el seguro que no paga, la filtración del vecino
			o la deuda que no te devuelven. Son asuntos que afectan directamente a tu patrimonio
			y a tu tranquilidad, y en los que la rapidez y una estrategia bien planteada marcan
			la diferencia.
		</p>
		<p class="mb-4">
			En Scruz Abogados llevamos más de 20 años asesorando a particulares y empresas en
			asuntos civiles: redacción y revisión de contratos, reclamaciones de responsabilidad
			civil, defensa del consumidor, reclamaciones a compañías de seguros, conflictos de
			vecindad y urbanismo, y reclamaciones de cantidad por impagos.
		</p>
		<p>
			Te asesoramos primero sobre tus opciones reales, sin compromiso, y buscamos la
			solución negociada antes de acudir a los tribunales. Cuando el juicio es necesario,
			defendemos tu posición con rigor y transparencia hasta la ejecución de la sentencia.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué tramitamos"
		title="Servicios de Derecho Civil"
		description="Cobertura completa del asunto civil: contratos, responsabilidad civil, consumo, seguros, urbanismo y reclamaciones de cantidad."
		items={conceptos}
	/>

	<EditorialMeasures
		supertitle="Tiempos orientativos"
		title="Plazos según la vía elegida"
		description="Estimación realista de los plazos según el tipo de reclamación. La confirmación exacta se realiza tras la consulta inicial."
		valueFormat="single-currency"
		noteLabel="Plazo orientativo."
		disclaimer="Tiempos aproximados. La duración real depende de la complejidad del asunto, la carga de los juzgados y la actitud de la parte contraria."
		items={rangos}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="Cómo resolvemos tu asunto civil"
		items={pasos}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Rigor jurídico y trato cercano."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Resolvemos tus dudas"
		description="Las preguntas más habituales sobre Derecho Civil, responsabilidad civil, consumo, seguros y reclamaciones."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Estamos a tu lado"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Te informamos de las opciones, los plazos y los costes. Si decides no continuar, no pagas nada."
		relatedLinks={[
			{ label: 'Zonas tensionadas y alquiler: guía', href: '/blog/zonas-tensionadas-alquiler/' },
			{ label: 'MASC: negociación previa obligatoria', href: '/blog/masc-negociacion-obligatoria/' },
			{ label: 'Desahucio por impago: guía', href: '/blog/desahucio-por-impago-lucena/' },
			{ label: 'Contratos: guía', href: '/blog/contratos-lucena/' },
			{ label: 'Reclamar al seguro de hogar: guía', href: '/blog/reclamaciones-seguro-hogar/' },
			{ label: 'Consumo', href: '/consumo/' },
			{ label: 'Seguros agrarios', href: '/seguros-agrarios/' },
		]}
	/>
</CustomLayout>
