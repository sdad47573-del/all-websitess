---
import heroImg from '@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	Ban,
	BookOpen,
	Clock,
	Euro,
	FileCheck,
	Handshake,
	Landmark,
	Scale,
	ShieldCheck,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Qué es una cláusula abusiva y puedo reclamarla?',
		answer:
			'Una cláusula abusiva es aquella que, en contra de las exigencias de la buena fe, causa en tu perjuicio un desequilibrio importante entre los derechos y obligaciones de las partes, como cláusulas suelo, comisiones no informadas, gastos hipotecarios indebidos o intereses de demora desproporcionados. Si una cláusula es abusiva, es nula y se tiene por no puesta, con devolución de las cantidades pagadas en exceso. Analizamos tu contrato, préstamo o póliza y te indicamos si hay cláusulas reclamables.',
	},
	{
		question: '¿Puedo reclamar mi tarjeta revolving por intereses usurarios?',
		answer:
			'Sí. El Tribunal Supremo ha declarado usurarios los intereses de las tarjetas revolving que superan de forma notable el interés normal del dinero, lo que permite anular el contrato y reclamar la devolución de todo lo pagado en exceso. Cada caso se analiza comparando la TAE aplicada con el interés medio del mercado en el momento de la contratación. Si tu tarjeta tiene una TAE muy elevada, es probable que puedas reclamar.',
	},
	{
		question: 'Compré un producto defectuoso: ¿qué garantía tengo?',
		answer:
			'Los bienes de consumo tienen una garantía legal de 3 años desde la compra. Si el producto no es conforme con el contrato, puedes exigir la reparación, la sustitución, la rebaja del precio o la resolución de la compraventa, sin coste alguno. En los dos primeros años se presume que el defecto ya existía en la entrega, por lo que es el vendedor quien debe probar lo contrario. Te ayudamos a ejercer la garantía y a reclamar cuando la tienda la deniega.',
	},
	{
		question: '¿Cómo funciona el arbitraje de consumo?',
		answer:
			'El arbitraje de consumo es un sistema extrajudicial, gratuito y voluntario para resolver las reclamaciones entre consumidores y empresas ante las Juntas Arbitrales de Consumo. Si la empresa se adhiere, el laudo arbitral es vinculante y ejecutable como una sentencia. Cuando el arbitraje no es posible (por ejemplo, si la empresa no se adhiere), interponemos la reclamación judicial. Te asesoramos sobre cuál es la vía más rápida y efectiva para tu caso.',
	},
	{
		question: '¿Cuánto tiempo tengo para reclamar como consumidor?',
		answer:
			'Depende de la acción: la garantía legal de bienes de consumo es de 3 años; las acciones personales de reclamación de cantidades prescriben a los 5 años; y las acciones de anulabilidad por vicio del consentimiento, como las derivadas de cláusulas no negociadas, tienen sus propios plazos. Lo más prudente es actuar con rapidez: conserva contratos, facturas y comunicaciones, y consulta antes de que prescriba tu derecho. Revisamos tu caso y te confirmamos qué plazo te aplica.',
	},
	{
		question: '¿Qué hago ante una publicidad engañosa o un servicio deficiente?',
		answer:
			'La normativa de consumo protege frente a la publicidad engañosa, las prácticas comerciales desleales y los servicios que no se prestan conforme a lo contratado. Puedes reclamar la resolución del contrato, la devolución de lo pagado y, en su caso, una indemnización por los daños sufridos. Presentamos la reclamación ante la empresa, ante los organismos de consumo o directamente en sede judicial, según la vía más adecuada a tu caso.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: ShieldCheck, label: 'Especialidad', value: 'Consumo y banca' },
	{ Icon: Landmark, label: 'Sedes', value: 'Lucena · Córdoba · Málaga' },
	{ Icon: Scale, label: 'Primera cita', value: 'Gratuita' },
];

const plazos = [
	{
		Icon: Clock,
		title: '3 años',
		description: 'Garantía legal de los bienes de consumo: reparación, sustitución o devolución.',
	},
	{
		Icon: FileCheck,
		title: '5 años',
		description: 'Plazo general de las acciones personales para reclamar cantidades (art. 1964 CC).',
	},
	{
		Icon: Handshake,
		title: 'Gratuito',
		description: 'Arbitraje de consumo ante la Junta Arbitral, sin coste para el consumidor.',
	},
];

const conceptos = [
	{
		Icon: Ban,
		title: 'Cláusulas abusivas y su nulidad',
		description:
			'Cláusulas suelo, comisiones no informadas, gastos hipotecarios indebidos o intereses de demora desproporcionados: las declaramos nulas y reclamamos la devolución de lo pagado en exceso.',
	},
	{
		Icon: Euro,
		title: 'Tarjetas revolving y créditos usurarios',
		description:
			'Reclamamos la nulidad de los créditos y tarjetas con intereses abusivos conforme a la doctrina del Tribunal Supremo sobre usura, recuperando todo lo pagado por encima del capital.',
	},
	{
		Icon: FileCheck,
		title: 'Garantías y productos defectuosos',
		description:
			'Ejercitamos la garantía legal de 3 años: reparación, sustitución, rebaja del precio o resolución de la compraventa cuando el producto no es conforme con lo contratado.',
	},
	{
		Icon: BookOpen,
		title: 'Servicios deficientes y publicidad engañosa',
		description:
			'Reclamamos frente a servicios mal prestados, incumplimientos de lo contratado, publicidad engañosa y prácticas comerciales desleales que vulneran tus derechos como consumidor.',
	},
	{
		Icon: Handshake,
		title: 'Arbitraje y reclamaciones extrajudiciales',
		description:
			'Presentamos hojas de reclamaciones, gestionamos el arbitraje de consumo ante la Junta Arbitral y agotamos la vía negociada antes de acudir a los tribunales.',
	},
	{
		Icon: Scale,
		title: 'Defensa judicial del consumidor',
		description:
			'Cuando la empresa no responde, interponemos la demanda: juicio monitorio para cantidades determinadas o juicio verbal/ordinario, con intereses y costas a tu favor.',
	},
];

const pasos = [
	{
		number: '01',
		title: 'Análisis del caso',
		description:
			'Revisamos contratos, facturas, extractos y comunicaciones para identificar la cláusula o práctica reclamable y calcular las cantidades a recuperar.',
	},
	{
		number: '02',
		title: 'Reclamación extrajudicial',
		description:
			'Presentamos la hoja de reclamaciones o el escrito a la empresa y, si es posible, iniciamos el arbitraje de consumo ante la Junta Arbitral, sin coste para ti.',
	},
	{
		number: '03',
		title: 'Vía judicial',
		description:
			'Si no hay acuerdo, interponemos la demanda correspondiente: monitorio, verbal u ordinario según la cuantía, con nulidad de cláusulas y devolución de cantidades.',
	},
	{
		number: '04',
		title: 'Cobro efectivo',
		description:
			'Si la sentencia no se cumple voluntariamente, instamos su ejecución con intereses y costas para que recuperes tu dinero de forma efectiva.',
	},
];

const why = [
	{
		Icon: ShieldCheck,
		title: 'Especialistas en consumo y banca',
		description:
			'Cláusulas suelo, revolving, garantías y arbitraje de consumo: conocemos la doctrina del Tribunal Supremo y la normativa que protege al consumidor.',
	},
	{
		Icon: Handshake,
		title: 'Cercanía y disponibilidad',
		description:
			'Atención presencial u online en Lucena, Córdoba y Málaga, con horario de oficina de lunes a viernes de 9:00 a 18:00 y atención de urgencias fuera de horario.',
	},
	{
		Icon: Euro,
		title: 'Recuperamos tu dinero',
		description:
			'No te conformes con la negativa de la empresa: analizamos tu caso en la primera consulta gratuita y te decimos con transparencia si tu reclamación tiene recorrido.',
	},
];

const rangos = [
	{
		title: 'Reclamación extrajudicial',
		value: '2 — 6 semanas',
		note: 'Hoja de reclamaciones y negociación con la empresa',
	},
	{
		title: 'Arbitraje de consumo',
		value: '3 — 6 meses',
		note: 'Ante la Junta Arbitral de Consumo, sin coste',
	},
	{
		title: 'Juicio monitorio / verbal',
		value: '6 — 12 meses',
		note: 'Según la cuantía y la complejidad del asunto',
	},
	{
		title: 'Ejecución de sentencia',
		value: '3 — 6 meses',
		note: 'Embargo de bienes si no hay pago voluntario',
	},
];
---

<CustomLayout
	title="Abogado de Consumo en Lucena | Scruz Abogados"
	description="Abogado de consumo en Lucena, Córdoba y Málaga: cláusulas suelo, tarjetas revolving, garantías y arbitraje de consumo. Consulta gratuita: 666 329 155."
	keywords="abogado consumo Lucena, reclamación consumo Córdoba, cláusula suelo, tarjeta revolving, garantía producto, arbitraje consumo Andalucía, abogado consumidores Málaga, publicidad engañosa, hoja de reclamaciones"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Consumo', url: '/consumo/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/consumo/#service`,
			serviceType: 'Derecho de Consumo',
			name: 'Reclamaciones de consumo en Lucena y Córdoba',
			description:
				'Reclamación de cláusulas abusivas, tarjetas revolving, garantías de productos y arbitraje de consumo en Lucena, Córdoba y Málaga.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Abogados especialistas en derecho de consumo, reclamaciones y arbitraje en Lucena, Córdoba y Málaga"
		supertitle="Derecho de Consumo · Cláusulas abusivas · Revolving"
		description="Si una empresa te ha vendido un producto defectuoso, te ha aplicado una cláusula abusiva o un crédito con intereses abusivos, reclamamos por ti."
		stats={heroStats}
	>
		<span slot="title">Abogado de consumo en Lucena: <span class="text-primary">tus derechos, defendidos.</span></span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'Cuando la empresa no responde, <span class="text-primary">reclamamos por ti</span>.'}
		factboxSupertitle="Claves del derecho de consumo"
		factboxTitle="Lo que debes saber"
		factboxItems={plazos}
	>
		<p class="mb-4">
			Una tarjeta revolving con intereses desorbitados, una cláusula suelo en tu hipoteca, un
			producto que se rompe a los meses o un servicio que no se presta como se contrató: son
			situaciones más habituales de lo que parece, y en todas ellas la ley te protege como
			consumidor. El problema es que muchas empresas cuentan con que no reclames.
		</p>
		<p class="mb-4">
			En Scruz Abogados defendemos los derechos de los consumidores en Lucena, Córdoba y
			Málaga: declaramos nulas las cláusulas abusivas, reclamamos la devolución de lo pagado
			en exceso, ejercitamos las garantías y gestionamos el arbitraje de consumo ante la
			Junta Arbitral. Cuando la empresa se niega, interponemos la demanda judicial y
			ejecutamos la sentencia hasta que recuperes tu dinero. Las guías del blog explican el
			marco: la <a href="/scruz-abogados/blog/reforma-ley-consumidores/" class="link link-primary">reforma de la ley de consumidores</a>
			y sus garantías, la reclamación de
			<a href="/scruz-abogados/blog/tarjetas-revolving-usura/" class="link link-primary">tarjetas revolving por intereses usurarios</a>,
			las <a href="/scruz-abogados/blog/clausula-suelo-irph/" class="link link-primary">cláusulas suelo e IRPH</a> y las
			<a href="/scruz-abogados/blog/reclamaciones-consumo-lucena/" class="link link-primary">reclamaciones de consumo en Lucena</a>.
		</p>
		<p>
			No dejes pasar los plazos ni aceptes la primera negativa. Conserva contratos, facturas
			y extractos y consulta antes de firmar cualquier renuncia. Analizamos tu caso en la
			primera consulta gratuita y te decimos con transparencia si tu reclamación tiene
			recorrido.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué tramitamos"
		title="Reclamaciones de consumo"
		description="Toda la defensa del consumidor: cláusulas abusivas, banca, garantías, arbitraje y vía judicial."
		items={conceptos}
	/>

	<EditorialMeasures
		supertitle="Tiempos y plazos"
		title="Plazos que debes conocer"
		description="Los plazos clave de la normativa de consumo aplicable a tu reclamación. La confirmación exacta depende de la acción concreta."
		valueFormat="single-currency"
		noteLabel="Plazo orientativo."
		disclaimer="Tiempos aproximados. La duración real depende de la vía elegida, la carga de los juzgados y la actitud de la empresa reclamada. Los plazos de prescripción varían según la acción ejercitada."
		items={rangos}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="Cómo reclamamos tu caso"
		items={pasos}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="No aceptes la primera negativa: reclama lo que te corresponde."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Resolvemos tus dudas"
		description="Las preguntas más habituales sobre cláusulas abusivas, revolving, garantías, arbitraje y plazos."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Estamos a tu lado"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Tráenos tu contrato, facturas o extractos y valoramos tu reclamación. Si decides no continuar, no pagas nada."
		relatedLinks={[
			{ label: 'Reforma ley consumidores: guía', href: '/blog/reforma-ley-consumidores/' },
			{ label: 'Tarjetas revolving: guía', href: '/blog/tarjetas-revolving-usura/' },
			{ label: 'Cláusula suelo e IRPH: guía', href: '/blog/clausula-suelo-irph/' },
			{ label: 'Reclamaciones de consumo en Lucena: guía', href: '/blog/reclamaciones-consumo-lucena/' },
			{ label: 'Derecho civil', href: '/derecho-civil/' },
		]}
	/>
</CustomLayout>