---
import heroImg from '@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	Briefcase,
	Building2,
	Car,
	Clock,
	Heart,
	Landmark,
	MapPin,
	Phone,
	Scale,
	ShieldCheck,
	Users,
	Video,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Dónde está vuestro despacho en Lucena?',
		answer:
			'Estamos en el centro de Lucena, en la Calle El Agua, 19, 1º Izquierda (14900 Lucena, Córdoba). Es fácil llegar a pie desde el centro o en coche, y disponemos de atención con cita previa para que no esperes.',
	},
	{
		question: '¿Atendéis a clientes de otros pueblos de Córdoba?',
		answer:
			'Sí. Desde nuestra oficina de Lucena atendemos a clientes de toda la provincia de Córdoba —Cabra, Montilla, Puente Genil, Priego de Córdoba, Baena, Aguilar de la Frontera y la comarca—, bien desplazándonos con cita previa a despachos bajo demanda, bien por videollamada cuando el asunto no requiere presencialidad.',
	},
	{
		question: '¿Cuál es el horario de atención?',
		answer:
			'El horario de oficina es de lunes a viernes de 9:00 a 18:00. Fuera de ese horario atendemos urgencias legales (detenciones, órdenes de protección, accidentes) por teléfono o WhatsApp en el 666 329 155.',
	},
	{
		question: '¿La primera consulta es gratuita?',
		answer:
			'Sí. La primera consulta es gratuita y confidencial, presencial en Lucena o por videollamada. Te explicamos las opciones reales, los plazos y un presupuesto cerrado. Si decides no continuar, no pagas nada.',
	},
	{
		question: '¿Qué asuntos tramitáis en los juzgados de Lucena?',
		answer:
			'Llevamos habitualmente asuntos civiles, de familia, penales y de tráfico que se tramitan ante los juzgados de Lucena y su partido judicial. Según la materia (laboral, mercantil o contencioso-administrativo, entre otras), los procedimientos pueden tener su sede en Córdoba capital, donde también acudimos con normalidad.',
	},
	{
		question: '¿Ofrecéis asesoría jurídica general o solo casos judiciales?',
		answer:
			'Ofrecemos asesoría jurídica integral, no solo representación en juicio: revisión de contratos, consultas sobre compraventas, alquileres, herencias, deudas, sanciones y cualquier duda legal de particulares, autónomos y empresas de Lucena y la comarca. Si el asunto requiere procedimiento judicial, te llevamos también esa fase con el mismo equipo y sin cambiar de abogado.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: MapPin, label: 'Dirección', value: 'C. El Agua, 19 · Lucena' },
	{ Icon: Clock, label: 'Horario', value: 'L–V 9:00–18:00' },
	{ Icon: Phone, label: 'Urgencias', value: '24 h' },
];

const oficina = [
	{
		Icon: MapPin,
		title: 'Calle El Agua, 19, 1º Izq.',
		description: '14900 Lucena (Córdoba). Despacho en el centro, con cita previa.',
	},
	{
		Icon: Clock,
		title: 'Lunes a viernes, 9:00 – 18:00',
		description: 'Y urgencias fuera de horario por teléfono y WhatsApp.',
	},
	{
		Icon: Phone,
		title: '666 329 155 · 957 118 195',
		description: 'También en info@scruzabogados.es y por WhatsApp.',
	},
	{
		Icon: Video,
		title: 'Consultas online',
		description: 'Videollamada para toda la provincia y para toda España.',
	},
];

const areas = [
	{
		Icon: Heart,
		title: 'Familia: divorcios y custodia',
		description: 'Divorcios de mutuo acuerdo y contenciosos, custodias, pensiones y medidas paterno-filiales.',
		href: '/divorcios-separaciones/',
	},
	{
		Icon: Scale,
		title: 'Derecho civil y contratos',
		description: 'Contratos, responsabilidad civil, consumo, seguros y reclamaciones de cantidad.',
		href: '/derecho-civil/',
	},
	{
		Icon: Landmark,
		title: 'Herencias y testamentos',
		description: 'Herencia sin testamento, testamentos, particiones e impuesto de sucesiones.',
		href: '/herencias-testamentos/',
	},
	{
		Icon: Briefcase,
		title: 'Laboral: despidos e incapacidades',
		description: 'Despidos, accidentes de trabajo, incapacidad permanente y pensiones.',
		href: '/despidos/',
	},
	{
		Icon: Car,
		title: 'Seguros agrarios y accidentes',
		description: 'Reclamaciones por siniestros agrarios e indemnizaciones de tráfico.',
		href: '/seguros-agrarios/',
	},
	{
		Icon: ShieldCheck,
		title: 'Recursos y sanciones',
		description: 'Recursos administrativos y defensa frente a sanciones de la Administración.',
		href: '/recursos-administrativos/',
	},
];

const why = [
	{
		Icon: Users,
		title: 'Un despacho de proximidad',
		description:
			'Conoces al abogado que lleva tu asunto desde el primer día. Sin intermediarios, con cita previa y atención personal en el centro de Lucena.',
	},
	{
		Icon: Building2,
		title: 'Más de 20 años en la comarca',
		description:
			'Trayectoria consolidada ayudando a familias, agricultores, autónomos y empresas de Lucena y de toda la provincia de Córdoba.',
	},
	{
		Icon: ShieldCheck,
		title: 'Primera consulta gratuita',
		description:
			'Te informamos de las opciones reales y del presupuesto cerrado antes de empezar. Transparencia desde el primer contacto.',
	},
];
---

<CustomLayout
	title="Abogados en Lucena | Despacho Civil, Familia, Penal y Laboral"
	description="¿Buscas abogada o abogado en Lucena? Oficina en C. El Agua 19 y urgencias 24 h para particulares y empresas. Primera consulta gratuita: 666 329 155."
	keywords="despacho de abogados en lucena, abogados en lucena, abogado en lucena, abogados lucena córdoba, abogado centro lucena, asesoría jurídica lucena, Scruz Abogados"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Abogados en Lucena', url: '/abogados-en-lucena/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/abogados-en-lucena/#service`,
			serviceType: 'Despacho de abogados',
			name: 'Despacho de abogados en Lucena',
			description:
				'Despacho jurídico en el centro de Lucena (Córdoba) con atención presencial y online para toda la provincia.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Andalucía'],
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'Calle El Agua, 19, 1º Izq.',
				addressLocality: 'Lucena',
				addressRegion: 'Córdoba',
				postalCode: '14900',
				addressCountry: 'ES',
			},
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Despacho de abogados Scruz Abogados en el centro de Lucena, Córdoba"
		supertitle="Despacho en Lucena · Córdoba"
		description="Abogados en el centro de Lucena con más de 20 años de experiencia. Atención presencial y online para particulares, agricultores, autónomos y empresas."
		stats={heroStats}
	>
		<span slot="title">Tu abogado en Lucena: <span class="text-primary">asesoría jurídica general y despacho en el centro.</span></span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Visítanos en Lucena"
		title={'Cercanía real: <span class="text-primary">te atendemos en persona</span>, en el centro de Lucena.'}
		factboxSupertitle="Dónde estamos"
		factboxTitle="Oficina en Lucena"
		factboxItems={oficina}
	>
		<p class="mb-4">
			Nuestro despacho de Lucena está en la <strong>Calle El Agua, 19, 1º Izquierda</strong>, en
			pleno centro de la ciudad. Desde aquí atendemos a clientes de Lucena y de toda la comarca
			de la Subbética y de la provincia de Córdoba: Cabra, Montilla, Puente Genil, Priego de
			Córdoba, Baena, Aguilar de la Frontera y municipios cercanos.
		</p>
		<p class="mb-4">
			Trabajamos con cita previa para dedicarte el tiempo que tu asunto necesita, y si no puedes
			desplazarte, también te atendemos por videollamada o teléfono. Las urgencias legales
			(detenciones, órdenes de protección, accidentes graves) se atienden fuera del horario de
			oficina, porque un problema legal no espera.
		</p>
		<p>
			Si necesitas orientación sobre qué juzgado te corresponde, qué documentación aportar o qué
			vía es la más adecuada para tu caso, pide cita: la primera consulta es gratuita y
			confidencial.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué hacemos en Lucena"
		title="Todas las áreas del Derecho, a un paso de tu casa"
		description="El despacho de Lucena cubre las principales áreas de práctica para particulares, agricultores, autónomos y empresas de la comarca."
		items={areas}
		ctaLabel="Más información"
	/>

	<EditorialWhyUs
		supertitle="Por qué elegir nuestro despacho en Lucena"
		title="Un abogado que conoce Lucena y sus juzgados."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Información práctica sobre el despacho"
		description="Las dudas más habituales de los clientes que nos visitan en Lucena."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Estamos en Lucena"
		title={'Pide cita. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial en nuestro despacho de Lucena o por videollamada. Te informamos de las opciones, los plazos y los costes antes de empezar."
		relatedLinks={[
			{ label: 'Abogados en Rute', href: '/abogados-en-rute/' },
			{ label: 'Abogados en Málaga', href: '/abogados-en-malaga/' },
			{ label: 'Todas las ubicaciones', href: '/ubicaciones/' },
		]}
	/>
</CustomLayout>
