---
import heroImg from '@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	Briefcase,
	Clock,
	FileText,
	Heart,
	Scale,
	ShieldAlert,
	ShieldCheck,
	Stethoscope,
	Users,
	Wallet,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Qué hacer inmediatamente después de un accidente laboral?',
		answer:
			'1) Avisa a tu superior o al servicio de prevención. 2) Solicita asistencia médica de la mutua y guarda todos los partes e informes. 3) Si hay testigos, anota sus datos. 4) Conserva cualquier prueba del estado del lugar o equipos. 5) No firmes documentos ni propuestas sin asesoramiento legal. 6) Contacta con nosotros en las horas siguientes para que estudiemos el caso y activemos las prestaciones que correspondan.',
	},
	{
		question: '¿Puedo reclamar aunque haya sido mi culpa?',
		answer:
			'Sí, en muchos casos. La Ley General de la Seguridad Social cubre las contingencias profesionales (accidente de trabajo y enfermedad profesional) con independencia de la culpa del trabajador. Si terceros o la propia empresa han contribuido al accidente, cabe además reclamar indemnización complementaria por daños y perjuicios. Analizamos tu caso para identificar todas las vías posibles.',
	},
	{
		question: '¿Qué es el recargo de prestaciones?',
		answer:
			'Cuando el accidente se produce por incumplimiento empresarial grave de la normativa de prevención de riesgos laborales, la empresa debe abonar un recargo de entre el 30% y el 50% sobre todas las prestaciones de Seguridad Social. Es una sanción muy relevante que también tramitamos: denunciamos ante la Inspección de Trabajo y reclamamos el recargo cuando concurren los supuestos legales.',
	},
	{
		question: '¿Qué prestaciones cubre la mutua?',
		answer:
			'La mutua colaboradora con la Seguridad Social cubre la asistencia sanitaria, la incapacidad temporal (baja laboral), las prestaciones por incapacidad permanente según el grado y, en caso de fallecimiento, las pensiones de viudedad y orfandad. Estudiamos cada caso para que recibas la prestación íntegra y no se produzcan altas indebidas.',
	},
	{
		question: '¿Cuándo se considera accidente de trabajo?',
		answer:
			'El artículo 156 de la Ley General de la Seguridad Social define accidente de trabajo como toda lesión corporal que el trabajador sufra con ocasión o por consecuencia del trabajo. Incluye los accidentes in itinere (ida o vuelta al trabajo), los ocurridos en desplazamientos profesionales y las enfermedades catalogadas como profesionales. Te confirmamos si el tuyo se califica así.',
	},
	{
		question: '¿Tengo derecho a indemnización aunque cobre prestación?',
		answer:
			'Sí. La prestación pública es compatible con una indemnización civil cuando hay responsabilidad empresarial por incumplimiento de medidas de seguridad o por dolo. Calculamos la diferencia entre la prestación y la indemnización que correspondería por responsabilidad civil y reclamamos la cantidad complementaria.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: Stethoscope, label: 'Atención', value: 'Mutua + recargo' },
	{ Icon: ShieldCheck, label: 'Defensa', value: 'Inspección de Trabajo' },
	{ Icon: Wallet, label: 'Coste', value: 'Sin provisión inicial' },
];

const plazos = [
	{
		Icon: Clock,
		title: 'Parte de accidente',
		description: 'Comunícalo en 24 horas a la empresa y la mutua. Es clave para prestaciones.',
	},
	{
		Icon: ShieldAlert,
		title: 'Inspección de Trabajo',
		description: 'Si hay riesgo grave, denunciamos para activar el recargo de prestaciones.',
	},
	{
		Icon: Scale,
		title: 'Demanda social',
		description: '20 días hábiles para impugnar el alta indebida o reclamar deficiencias.',
	},
];

const conceptos = [
	{
		Icon: Stethoscope,
		title: 'Asistencia sanitaria',
		description:
			'Tratamiento médico, rehabilitación, farmacología y terapias a cargo de la mutua o, en su caso, del Servicio Público de Salud hasta la curación o estabilización.',
	},
	{
		Icon: Heart,
		title: 'Incapacidad temporal',
		description:
			'Baja laboral con prestación equivalente al 75% de la base reguladora desde el día siguiente al accidente. Revisamos altas indebidas y proponemos pruebas para mantenerla.',
	},
	{
		Icon: Users,
		title: 'Incapacidad permanente',
		description:
			'Trabajamos la solicitud de incapacidad permanente parcial, total, absoluta o gran invalidez cuando las secuelas limitan tu capacidad de ganancia.',
	},
	{
		Icon: ShieldAlert,
		title: 'Recargo de prestaciones',
		description:
			'Cuando la empresa incumple la normativa de prevención, reclamamos un recargo del 30% al 50% sobre todas las prestaciones del sistema.',
	},
	{
		Icon: Briefcase,
		title: 'Indemnización civil',
		description:
			'Reclamamos indemnización complementaria por daños y perjuicios cuando hay responsabilidad civil del empresario o de terceros.',
	},
	{
		Icon: FileText,
		title: 'Enfermedad profesional',
		description:
			'Tramitamos el reconocimiento de enfermedades profesionales cuando están catalogadas o cuando se demuestra su origen laboral.',
	},
];

const pasos = [
	{
		number: '01',
		title: 'Parte y asistencia médica',
		description:
			'Te guiamos en la cumplimentación del parte de accidente, la documentación de las lesiones y la obtención de todos los informes médicos.',
	},
	{
		number: '02',
		title: 'Valoración médica independiente',
		description:
			'Solicitamos los informes forenses o periciales privados que acrediten tus lesiones, secuelas y grados de incapacidad para defender tu caso.',
	},
	{
		number: '03',
		title: 'Reclamación previa',
		description:
			'Presentamos reclamación ante la mutua y, si procede, ante la Seguridad Social. En su caso, denunciamos ante la Inspección de Trabajo para activar el recargo.',
	},
	{
		number: '04',
		title: 'Vía judicial',
		description:
			'Si la mutua da el alta indebida o la Seguridad Social deniega la incapacidad, presentamos demanda ante el Juzgado de lo Social para defender tu derecho.',
	},
];

const why = [
	{
		Icon: Stethoscope,
		title: 'Red de peritos médicos',
		description:
			'Colaboramos con peritos médicos especialistas que elaboran informes rigurosos para acreditar lesiones, secuelas y grados de incapacidad.',
	},
	{
		Icon: ShieldCheck,
		title: 'Sin provisión inicial',
		description:
			'Estudiamos tu caso sin coste de inicio y solo cobramos cuando obtenemos una prestación o indemnización significativa para ti.',
	},
	{
		Icon: Wallet,
		title: 'Resultados medibles',
		description:
			'Más de 20 años defendiendo a trabajadores en Lucena, Córdoba y Málaga: conocemos los juzgados de lo social y los equipos de valoración.',
	},
];

const rangos = [
	{ title: 'Asistencia sanitaria', value: '100% cubierto', note: 'Mutua o Servicio Público de Salud' },
	{ title: 'Incapacidad temporal', value: '75% base', note: 'Desde el día siguiente al accidente' },
	{ title: 'Incapacidad permanente', value: 'Según grado', note: 'Parcial, total, absoluta, gran invalidez' },
	{ title: 'Recargo de prestaciones', value: '30% — 50%', note: 'Por incumplimiento empresarial grave' },
];
---

<CustomLayout
	title="Abogado de Accidentes Laborales en Lucena | Scruz Abogados"
	description="Abogado de accidentes laborales en Lucena, Córdoba y Málaga: prestaciones de la mutua, recargo e indemnizaciones. Consulta gratuita: 666 329 155."
	keywords="abogado accidente laboral Lucena, enfermedad profesional Córdoba, incapacidad laboral Málaga, mutua INSS, recargo prestaciones, abogado laboralista"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Accidente Laboral', url: '/accidente-laboral/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/accidente-laboral/#service`,
			url: `${SITE_URL}/accidente-laboral/`,
			name: 'Asesoramiento legal en accidentes laborales',
			description:
				'Reclamamos prestaciones e indemnizaciones por accidente laboral o enfermedad profesional en Lucena, Córdoba y Málaga.',
			serviceType: 'Accidentes laborales',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: [
				{ '@type': 'City', name: 'Lucena' },
				{ '@type': 'City', name: 'Córdoba' },
				{ '@type': 'City', name: 'Málaga' },
			],
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Asesoramiento legal tras accidente laboral o enfermedad profesional en Lucena, Córdoba y Málaga"
		supertitle="Derecho Laboral · Accidentes y enfermedades profesionales"
		description="Reclamamos las prestaciones que te corresponden tras un accidente laboral: asistencia, indemnizaciones y recargo si la empresa incumplió medidas de seguridad."
		stats={heroStats}
	>
		<span slot="title">Reclamamos las prestaciones que te corresponden.</span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'Tu accidente laboral, defendido con <span class="text-primary">rigor y experiencia</span>.'}
		factboxSupertitle="Plazos clave"
		factboxTitle="Lo que debes saber"
		factboxItems={plazos}
	>
		<p class="mb-4">
			Sufrir un accidente en el trabajo o contraer una enfermedad profesional da derecho a
			una serie de prestaciones y compensaciones que, en muchos casos, ni la mutua ni la
			empresa reconocen voluntariamente. Nos aseguramos de que la mutua o la empresa
			asuman su responsabilidad, reclamando desde la asistencia sanitaria hasta las
			indemnizaciones por secuelas o la solicitud de incapacidad permanente.
		</p>
		<p class="mb-4">
			Defendemos tus derechos como trabajador para que el accidente no suponga un
			perjuicio económico añadido. Cuando la empresa ha incumplido medidas de prevención
			de riesgos, reclamamos también el recargo de prestaciones, que puede oscilar entre
			el 30% y el 50% sobre todas las prestaciones del sistema. En casos graves,
			denunciamos ante la Inspección de Trabajo para activar este mecanismo sancionador.
		</p>
		<p>
			Te acompañamos en todo el proceso: asistencia inicial, valoración médica
			independiente, reclamaciones administrativas y, en última instancia, demanda ante
			el Juzgado de lo Social. Trabajamos con honorarios condicionados a resultado: solo
			cobramos cuando obtenemos una prestación o indemnización significativa para ti.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué reclamamos"
		title="Servicios ante accidente laboral"
		description="Cobertura completa del itinerario de un accidente laboral o enfermedad profesional: prestaciones, indemnizaciones y recargo."
		items={conceptos}
	/>

	<EditorialMeasures
		supertitle="Prestaciones e indemnizaciones"
		title="Cifras orientativas"
		description="Visión rápida de las principales cuantías y porcentajes que maneja la legislación española en contingencias profesionales."
		valueFormat="single-currency"
		noteLabel="Cifras indicativas."
		disclaimer="Cifras orientativas. La cuantía exacta depende del salario, el grado de secuelas y las circunstancias del accidente — concertamos una cita para calcularla."
		items={rangos}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="Del parte de accidente a la resolución"
		items={pasos}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Tu accidente laboral, en manos expertas."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Resolvemos tus dudas"
		description="Las preguntas más habituales sobre accidente laboral, mutua, prestaciones e indemnizaciones."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Estamos a tu lado"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Te informamos de las opciones, los plazos y los honorarios. Si decides no reclamar, no pagas nada."
		relatedLinks={[
			{ label: 'Accidente laboral: guía completa', href: '/blog/accidente-laboral-cordoba/' },
			{ label: 'Nueva Ley PRL 2027: qué cambia', href: '/blog/nueva-ley-prevencion-riesgos-laborales/' },
			{ label: 'Despidos', href: '/despidos/' },
			{ label: 'Incapacidad permanente', href: '/incapacidad-permanente/' },
		]}
	/>
</CustomLayout>
