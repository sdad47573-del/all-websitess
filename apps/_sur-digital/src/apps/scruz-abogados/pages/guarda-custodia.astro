---
import heroImg from '@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	Banknote,
	Calendar,
	Clock,
	Euro,
	FileText,
	Handshake,
	Heart,
	House,
	Landmark,
	Scale,
	ShieldCheck,
	Users,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Qué son las medidas paterno-filiales?',
		answer:
			'Son las medidas que se adoptan respecto de los hijos menores cuando sus progenitores se separan o dejan de convivir: atribución de la guarda y custodia, régimen de comunicación y estancias con el progenitor no custodio y pensión de alimentos. Se acuerdan en el convenio regulador de un divorcio o separación y también en el procedimiento específico de medidas paterno-filiales, que es la vía cuando los padres no estaban casados.',
	},
	{
		question: '¿Cuándo se concede la custodia compartida?',
		answer:
			'La ley no da preferencia a ninguno de los progenitores: la custodia se decide siempre por el interés del menor. En la práctica, los tribunales consideran la custodia compartida la opción más beneficiosa cuando ambos progenitores tienen aptitud para ejercerla, existe buena comunicación entre ellos y la cercanía de los domicilios lo hace viable. Analizamos tu caso concreto para valorar qué modalidad protege mejor al menor y, en su caso, solicitarla.',
	},
	{
		question: '¿Cómo se calcula la pensión de alimentos?',
		answer:
			'Se fija atendiendo a dos criterios: las necesidades del menor (alimentación, vivienda, educación, sanidad y ocio) y la capacidad económica del progenitor obligado a pagarla. Los tribunales suelen aplicar un porcentaje orientativo sobre los ingresos de ese progenitor, que varía según el número de hijos y las cargas familiares, y revisan el importe con cláusulas de actualización anual. Además, los gastos extraordinarios (médicos, educativos no ordinarios) suelen pagarse por mitad entre ambos progenitores.',
	},
	{
		question: '¿Puedo reclamar la pensión de alimentos sin estar divorciado o separado?',
		answer:
			'Sí. Si el otro progenitor no contribuye a la manutención de los hijos pese a existir obligación legal, se puede interponer una demanda de reclamación de alimentos o instar la ejecución del convenio o sentencia que ya la fijara. También cabe solicitar la pensión directamente en el procedimiento de medidas paterno-filiales cuando los progenitores nunca estuvieron casados.',
	},
	{
		question: '¿Qué puedo hacer si mi expareja no paga la pensión?',
		answer:
			'La pensión impagada se reclama por vía de ejecución: se insta el embargo de la nómina, las cuentas o los bienes del deudor y el abono de las mensualidades adeudadas con sus intereses. Además, el impago injustificado de la pensión de alimentos durante dos meses consecutivos (o cuatro no consecutivos) puede constituir un delito de abandono de familia, por lo que también cabe la vía penal.',
	},
	{
		question: '¿Se puede cambiar la custodia o la pensión después de la sentencia?',
		answer:
			'Sí, mediante el procedimiento de modificación de medidas. Para revisar la custodia, el régimen de visitas o la pensión es necesario acreditar una alteración sustancial de las circunstancias respecto de las que existían cuando se dictó la sentencia: cambio de domicilio, pérdida o mejora de empleo, nuevas necesidades de los hijos o incumplimientos reiterados.',
	},
	{
		question: '¿Qué pasa con la vivienda familiar cuando hay hijos menores?',
		answer:
			'La vivienda familiar se atribuye, con carácter general, al progenitor con el que quedan los hijos menores, como garantía de su estabilidad, salvo que el interés del menor aconseje otra solución. Se trata de una atribución temporal: puede revisarse cuando los hijos dejan de necesitar esa protección o cambian las circunstancias.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: Heart, label: 'Criterio', value: 'Interés del menor' },
	{ Icon: Users, label: 'Atención', value: 'Con cita previa' },
	{ Icon: Scale, label: 'Confidencialidad', value: 'Total' },
];

const plazos = [
	{
		Icon: Clock,
		title: '1 — 3 meses',
		description: 'Medidas de mutuo acuerdo bien preparadas.',
	},
	{
		Icon: Calendar,
		title: '4 — 9 meses',
		description: 'Promedio en procedimientos contenciosos de medidas.',
	},
	{
		Icon: ShieldCheck,
		title: 'Interés del menor',
		description: 'Criterio rector en toda decisión sobre custodia, visitas o alimentos.',
	},
];

const conceptos = [
	{
		Icon: Users,
		title: 'Custodia compartida o exclusiva',
		description:
			'Asesoramos sobre la modalidad de custodia más adecuada para tus hijos y la defendemos, ya sea de mutuo acuerdo o ante el juez.',
	},
	{
		Icon: Calendar,
		title: 'Régimen de visitas y estancias',
		description:
			'Diseñamos el régimen de comunicación y estancias del progenitor no custodio: fines de semana alternos, tardes entre semana, vacaciones y festivos.',
	},
	{
		Icon: Euro,
		title: 'Pensión de alimentos',
		description:
			'Calculamos y reclamamos la pensión de alimentos para tus hijos, con cláusulas de actualización y reparto de gastos extraordinarios.',
	},
	{
		Icon: Banknote,
		title: 'Reclamación y ejecución de pensiones',
		description:
			'Si el otro progenitor no paga, instamos la ejecución de la sentencia con embargo de nóminas y bienes, y valoramos la vía penal si procede.',
	},
	{
		Icon: FileText,
		title: 'Medidas para progenitores no casados',
		description:
			'Tramitamos el procedimiento de medidas paterno-filiales cuando los padres no están casados, para regular custodia, visitas y alimentos.',
	},
	{
		Icon: Landmark,
		title: 'Modificación de medidas',
		description:
			'Revisamos custodias, regímenes de visitas y pensiones cuando cambian sustancialmente las circunstancias de la familia.',
	},
];

const pasos = [
	{
		number: '01',
		title: 'Entrevista y diagnóstico',
		description:
			'Te escuchamos y analizamos la situación familiar: convivencia, domicilios, situación laboral y económica. Te explicamos las opciones reales y el procedimiento adecuado.',
	},
	{
		number: '02',
		title: 'Acuerdo o demanda',
		description:
			'Si es posible, negociamos un acuerdo completo con la otra parte. Si no lo es, preparamos la demanda de medidas con las propuestas que mejor protegen a tus hijos.',
	},
	{
		number: '03',
		title: 'Procedimiento y vista',
		description:
			'Te representamos en el procedimiento, aportamos las pruebas de idoneidad necesarias (informes, testigos) y defendemos tu propuesta en la vista.',
	},
	{
		number: '04',
		title: 'Ejecución y seguimiento',
		description:
			'Dictada la sentencia, velamos por su cumplimiento: reclamamos pensiones impagadas y gestionamos cualquier modificación posterior de medidas.',
	},
];

const why = [
	{
		Icon: Heart,
		title: 'El interés del menor, primero',
		description:
			'Cada estrategia se diseña pensando en el bienestar de los niños. Buscamos soluciones estables que protejan su día a día y su relación con ambos progenitores.',
	},
	{
		Icon: Handshake,
		title: 'Acuerdo antes que litigio',
		description:
			'Cuando existe voluntad de entendimiento, negociamos un convenio completo que evite el desgaste de un procedimiento contencioso para toda la familia.',
	},
	{
		Icon: House,
		title: 'Trato humano y discreto',
		description:
			'Los conflictos sobre hijos son especialmente sensibles. Mantenemos una comunicación cercana, sin tecnicismos, y cuidamos la confidencialidad de cada visita.',
	},
];

const rangos = [
	{
		title: 'Medidas de mutuo acuerdo',
		value: '1 — 3 meses',
		note: 'Con convenio bien preparado',
	},
	{
		title: 'Procedimiento contencioso',
		value: '4 — 9 meses',
		note: 'Según la carga del juzgado y las pruebas',
	},
	{
		title: 'Modificación de medidas',
		value: '3 — 6 meses',
		note: 'Para revisar custodias, visitas o pensiones',
	},
	{
		title: 'Ejecución por impago',
		value: '2 — 5 meses',
		note: 'Embargo de nóminas, cuentas o bienes',
	},
];
---

<CustomLayout
	title="Abogado de Guarda y Custodia en Lucena | Scruz Abogados"
	description="Abogado de guarda y custodia en Lucena: medidas paterno-filiales, custodia de hijos, régimen de visitas y pensión de alimentos. Consulta gratuita: 666 329 155."
	keywords="abogado guarda y custodia Lucena, medidas paterno filiales Lucena, abogado custodia hijos Córdoba, abogado reclamación de pensión Lucena, régimen de visitas Málaga, pensión alimentos, custodia compartida, abogado familia Andalucía"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Guarda y Custodia', url: '/guarda-custodia/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/guarda-custodia/#service`,
			serviceType: 'Derecho de Familia',
			name: 'Guarda y custodia y medidas paterno-filiales',
			description:
				'Custodia compartida o exclusiva, régimen de visitas, pensión de alimentos y medidas paterno-filiales en Lucena, Córdoba y Málaga.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Abogados especialistas en guarda y custodia y medidas paterno-filiales en Lucena, Córdoba y Málaga"
		supertitle="Derecho de Familia · Guarda y custodia"
		description="Defendemos la mejor solución para tus hijos: custodia, régimen de visitas y pensión de alimentos, con criterio jurídico y sensibilidad."
		stats={heroStats}
	>
		<span slot="title">Abogado de guarda y custodia en Lucena: <span class="text-primary">la protección de tus hijos.</span></span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'La custodia de tus hijos no se improvisa: <span class="text-primary">se decide con estrategia</span>.'}
		factboxSupertitle="Plazos y criterios"
		factboxTitle="Lo que debes saber"
		factboxItems={plazos}
	>
		<p class="mb-4">
			Cuando una pareja con hijos se separa, lo que está en juego no es solo la relación entre
			los adultos: son el día a día, la estabilidad y el bienestar de los menores. Por eso las
			decisiones sobre la guarda y custodia, el régimen de visitas y la pensión de alimentos
			deben tomarse con criterio jurídico sólido y, sobre todo, pensando en el interés del niño.
		</p>
		<p class="mb-4">
			En Scruz Abogados tramitamos tanto las medidas incluidas en un divorcio o separación como
			el procedimiento específico de medidas paterno-filiales cuando los progenitores no estaban
			casados. Te asesoramos sobre la modalidad de custodia más adecuada —compartida o
			exclusiva—, negociamos un régimen de visitas razonable y reclamamos o defendemos la
			pensión de alimentos que corresponde según las necesidades de los hijos y los ingresos de
			cada progenitor. Para preparar la conversación, en el blog tienes las guías de la
			<a href="/scruz-abogados/blog/custodia-compartida-cordoba/" class="link link-primary">custodia compartida</a>, el
			<a href="/scruz-abogados/blog/regimen-de-visitas/" class="link link-primary">régimen de visitas</a>, la
			<a href="/scruz-abogados/blog/pension-de-alimentos/" class="link link-primary">pensión de alimentos</a> y el
			<a href="/scruz-abogados/blog/cuanto-cuesta-un-divorcio/" class="link link-primary">coste real de un divorcio</a>.
		</p>
		<p>
			Nuestro compromiso es doble: proteger jurídicamente tus derechos como padre o madre y
			garantizar la estabilidad emocional de tus hijos. Buscamos primero el acuerdo y, cuando no
			es posible, defendemos tu propuesta ante los juzgados de familia de Lucena, Córdoba y
			Málaga con total firmeza.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué tramitamos"
		title="Medidas sobre los hijos"
		description="Cubrimos todas las medidas que pueden adoptarse respecto de los menores: custodia, comunicación y estancias, pensión de alimentos y su revisión posterior."
		items={conceptos}
	/>

	<EditorialMeasures
		supertitle="Tiempos orientativos"
		title="Plazos habituales"
		description="Una estimación realista de los plazos que manejan los juzgados de familia en Andalucía. Cada caso se confirma tras la consulta inicial."
		valueFormat="single-currency"
		noteLabel="Plazo orientativo."
		disclaimer="Tiempos aproximados. La duración real depende de la carga del juzgado, la complejidad del caso y la voluntad de acuerdo entre las partes."
		items={rangos}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="De la primera consulta a la sentencia"
		items={pasos}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Tus hijos merecen una decisión meditada, no una batalla."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Resolvemos tus dudas"
		description="Las preguntas más habituales sobre custodia, régimen de visitas, pensiones y medidas paterno-filiales."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Estamos a tu lado"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Te explicamos las opciones, los plazos y los costes para proteger a tus hijos. Si decides no continuar, no pagas nada."
		relatedLinks={[
			{ label: 'Custodia compartida: guía', href: '/blog/custodia-compartida-cordoba/' },
			{ label: 'Pensión de alimentos: guía', href: '/blog/pension-de-alimentos/' },
			{ label: 'Régimen de visitas: guía', href: '/blog/regimen-de-visitas/' },
			{ label: 'Cuánto cuesta un divorcio: guía', href: '/blog/cuanto-cuesta-un-divorcio/' },
			{ label: 'Divorcios y separaciones', href: '/divorcios-separaciones/' },
			{ label: 'Liquidación de gananciales', href: '/liquidacion-gananciales/' },
			{ label: 'Violencia de género', href: '/violencia-genero/' },
		]}
	/>
</CustomLayout>
