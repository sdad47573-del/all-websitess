---
import heroImg from '@assets/BANNER-SERVICIOS.webp';
import { SITE_URL } from '../data/site';
import {
	ArrowLeftRight,
	Award,
	BadgePercent,
	Briefcase,
	Calculator,
	Clock,
	Gavel,
	HandCoins,
	Heart,
	Landmark,
	MapPin,
	Ruler,
	Scale,
	ScrollText,
	ShieldAlert,
	Stethoscope,
	ShieldCheck,
	Users,
	Wallet,
} from '@lucide/astro';
import { SERVICES } from '../data/SERVICES';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialCategoriesGrid,
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialHero,
	EditorialIntro,
	EditorialWhyUs,
} from '../components/editorial';

const serviciosConIcono = [
	{ Icon: Scale, key: 'Derecho Civil' },
	{ Icon: Users, key: 'Guarda y Custodia y Medidas Paterno-Filiales' },
	{ Icon: Landmark, key: 'Recursos Administrativos' },
	{ Icon: Ruler, key: 'Urbanismo' },
	{ Icon: ShieldCheck, key: 'Seguros Agrarios' },
	{ Icon: BadgePercent, key: 'Indemnizaciones de Tráfico' },
	{ Icon: ScrollText, key: 'Herencias y Testamentos' },
	{ Icon: ScrollText, key: 'Testamentos en Córdoba' },
	{ Icon: Users, key: 'Divorcios y Separaciones' },
	{ Icon: Wallet, key: 'Cobro de deudas e Impagos' },
	{ Icon: Landmark, key: 'Reclamaciones Bancarias' },
	{ Icon: ArrowLeftRight, key: 'Compraventas de Empresas' },
	{ Icon: Gavel, key: 'Derecho Penal' },
	{ Icon: MapPin, key: 'Nacionalidad y Extranjería' },
	{ Icon: ShieldAlert, key: 'Violencia de Género' },
	{ Icon: Briefcase, key: 'Despidos' },
	{ Icon: Stethoscope, key: 'Incapacidad Permanente' },
	{ Icon: Heart, key: 'Accidente Laboral' },
	{ Icon: HandCoins, key: 'Complemento de Paternidad o Maternidad' },
	{ Icon: HandCoins, key: 'Liquidación de Gananciales' },
	{ Icon: ShieldCheck, key: 'Consumo' },
];

const listaServicios = serviciosConIcono.map(({ Icon, key }) => {
	const svc = SERVICES.find((s) => s.title === key)!;
	return { Icon, title: svc.title, description: svc.description, href: `${svc.path}/` };
});

const categorias: Array<{
	Icon: typeof Scale;
	title: string;
	description: string;
	links: Array<{ label: string; href: string }>;
}> = [
	{
		Icon: Users,
		title: 'Derecho de Familia',
		description:
			'Divorcios, separaciones, custodia, pensión alimenticia, liquidaciones de gananciales y más.',
		links: [
			{ label: 'Divorcios y Separaciones', href: '/divorcios-separaciones/' },
			{ label: 'Guarda y Custodia', href: '/guarda-custodia/' },
			{ label: 'Liquidación de Gananciales', href: '/liquidacion-gananciales/' },
			{ label: 'Violencia de Género', href: '/violencia-genero/' },
			{ label: 'Complemento de Paternidad o Maternidad', href: '/complemento-paternidad-maternidad/' },
		],
	},
	{
		Icon: Scale,
		title: 'Derecho Civil',
		description:
			'Contratos, responsabilidad civil, consumo, seguros agrarios, herencias y reclamaciones.',
		links: [
			{ label: 'Derecho Civil', href: '/derecho-civil/' },
			{ label: 'Consumo', href: '/consumo/' },
			{ label: 'Herencias y Testamentos', href: '/herencias-testamentos/' },
			{ label: 'Indemnizaciones de Tráfico', href: '/indemnizaciones-trafico/' },
			{ label: 'Cobro de deudas e Impagos', href: '/cobro-deudas-impagos/' },
			{ label: 'Seguros Agrarios', href: '/seguros-agrarios/' },
		],
	},
	{
		Icon: Landmark,
		title: 'Derecho Bancario',
		description:
			'Cláusulas suelo, multidivisa, revolving, IRPH y gastos hipotecarios abusivos.',
		links: [{ label: 'Reclamaciones Bancarias', href: '/reclamaciones-bancarias/' }],
	},
	{
		Icon: Gavel,
		title: 'Derecho Penal',
		description:
			'Defensa y acusación en todos los tipos de delitos, incluyendo violencia de género.',
		links: [{ label: 'Derecho Penal', href: '/derecho-penal/' }],
	},
	{
		Icon: Briefcase,
		title: 'Derecho Laboral',
		description:
			'Despidos, accidentes laborales, incapacidades y complemento de pensiones.',
		links: [
			{ label: 'Despidos', href: '/despidos/' },
			{ label: 'Accidente Laboral', href: '/accidente-laboral/' },
			{ label: 'Incapacidad Permanente', href: '/incapacidad-permanente/' },
			{ label: 'Complemento de Paternidad o Maternidad', href: '/complemento-paternidad-maternidad/' },
		],
	},
	{
		Icon: ArrowLeftRight,
		title: 'Derecho Mercantil y Extranjería',
		description:
			'Empresas, contratación mercantil, protección de datos, compraventas mercantiles, residencia, nacionalidad y reagrupación familiar.',
		links: [
			{ label: 'Compraventas de Empresas', href: '/compraventas-empresas/' },
			{ label: 'Empresas y Mercantil', href: '/empresas/' },
			{ label: 'Constitución de Sociedades', href: '/empresas/constitucion-sociedades/' },
			{ label: 'Contratos Mercantiles', href: '/empresas/contratos-mercantiles/' },
			{ label: 'Derecho Laboral de Empresa', href: '/empresas/derecho-laboral/' },
			{ label: 'Protección de Datos y RGPD', href: '/empresas/proteccion-de-datos/' },
			{ label: 'Nacionalidad y Extranjería', href: '/nacionalidad-extranjeria/' },
		],
	},
	{
		Icon: Landmark,
		title: 'Derecho Administrativo',
		description:
			'Recursos frente a la Administración, defensa en procedimientos sancionadores y urbanismo.',
		links: [
			{ label: 'Recursos Administrativos', href: '/recursos-administrativos/' },
			{ label: 'Urbanismo', href: '/urbanismo/' },
		],
	},
];
---

<CustomLayout
	title="Asesoría Jurídica en Lucena, Córdoba y Málaga | Scruz Abogados"
	description="Asesoría jurídica general en Lucena, Córdoba y Málaga: civil, familia, herencias, mercantil, penal y laboral. Consulta gratuita: 666 329 155."
	keywords="servicios jurídicos Lucena, abogado Lucena, abogado Córdoba, abogado Málaga, despacho multidisciplinar Andalucía, abogado guarda y custodia Lucena, recursos administrativos, seguros agrarios"
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'ItemList',
			'@id': `${SITE_URL}/servicios/#itemlist`,
			name: 'Áreas de práctica jurídica de Scruz Abogados',
			itemListElement: SERVICES.map((s, i) => ({
				'@type': 'ListItem',
				position: i + 1,
				url: `${SITE_URL}${s.path}/`,
				name: s.title,
			})),
		},
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Scruz Abogados - Despacho multidisciplinar en Lucena, Córdoba y Málaga. Todas las áreas del Derecho."
		supertitle="Despacho multidisciplinar · Andalucía"
		description="Asesoramiento jurídico integral para particulares y empresas en Lucena, Córdoba, Málaga y toda Andalucía. Más de 20 años de experiencia, primera consulta gratuita."
		whatsappHref="https://wa.me/34666329155?text=Hola%2C%20quisiera%20realizar%20una%20consulta%20legal%2C%20%C2%BFpodr%C3%ADamos%20agendar%20una%20cita%3F"
		stats={[
			{ Icon: Calculator, label: 'Áreas cubiertas', value: `${SERVICES.length} áreas de práctica` },
			{ Icon: Award, label: 'Trayectoria', value: '+20 años en Andalucía' },
			{ Icon: Clock, label: 'Atención', value: 'Presencial y online' },
		]}
	>
		<span slot="title">Todas las áreas del Derecho, en un solo bufete.</span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Áreas de práctica jurídica"
		title={'Podemos ayudarte con <span class="text-primary">cualquier área del Derecho</span>.'}
		factboxSupertitle="Nuestro alcance"
		factboxTitle="Para particulares y empresas"
		factboxItems={[
			{
				Icon: Users,
				title: 'Particulares y empresas',
				description:
					'Atención profesional adaptada a tu condición, sea persona física o jurídica.',
			},
			{
				Icon: Clock,
				title: 'Plazos transparentes',
				description:
					'Te informamos desde el inicio de los plazos previstos y costes asociados.',
			},
			{
				Icon: Award,
				title: 'Presupuesto cerrado',
				description:
					'Honorarios pactados por escrito, sin cláusulas sorpresa ni costes ocultos.',
			},
		]}
	>
		<p class="mb-4">
			Scruz Abogados es un bufete multidisciplinar con más de 20 años de experiencia
			acompañando a personas, familias y empresas en Andalucía. Atendemos de forma integral
			cualquier asunto jurídico, desde el ámbito civil y familiar hasta el mercantil, penal o
			laboral, con un único criterio: priorizar tus intereses y resolver tu caso con la máxima
			eficacia.
		</p>
		<p>
			En las siguientes secciones encontrarás un resumen de cada una de nuestras áreas de
			práctica y un acceso directo a la información detallada. Si no localizas tu caso o
			necesitas asesoramiento sobre un asunto distinto,
			<a href="/scruz-abogados/quienes-somos/" class="link link-primary">contacta con nosotros</a>
			y te orientaremos sin compromiso.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Listado completo"
		title="Todas nuestras áreas"
		description={`${listaServicios.length} áreas de práctica con detalle accesible. Desplázate o elige directamente la que mejor describa tu situación.`}
		ctaLabel="Más info"
		items={listaServicios}
	/>

	<EditorialCategoriesGrid
		supertitle="Encuentra tu área"
		title="Áreas agrupadas por familia jurídica"
		description="Si no tienes claro qué servicio necesitas, empieza por la rama del Derecho más próxima a tu problema."
		items={categorias}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Un bufete, todas las áreas."
		description="Cuando el caso toca varias ramas del Derecho (laboral + civil, penal + familia…), la coordinación entre especialistas marca la diferencia."
		items={[
			{
				Icon: Users,
				title: 'Equipo multidisciplinar',
				description:
					'Abogados especializados en cada rama del Derecho colaboran en un mismo bufete para darte una visión completa del caso, sin perder profundidad en ninguna materia.',
			},
			{
				Icon: Heart,
				title: 'Trato directo y confidencial',
				description:
					'Sin intermediarios ni sucursales deslocalizadas: hablas siempre con el abogado responsable de tu asunto, con cita previa cuando quieras.',
			},
			{
				Icon: BadgePercent,
				title: 'Cobertura integral',
				description:
					'Acompañamos todo el ciclo de un caso: consulta, extrajudicial, judicial, ejecución y cobro. No te dejamos a medias en ningún paso.',
			},
		]}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		appearance="light"
		supertitle="¿No encuentras tu caso?"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Atendemos asuntos jurídicos de toda índole. Si tu problema no encaja claramente en una de nuestras áreas listadas, llámanos o escríbenos por WhatsApp y te orientamos sin compromiso."
		relatedLinks={[
			{ label: 'Sobre nosotros', href: '/quienes-somos/' },
			{ label: 'Trayectoria', href: '/trayectoria/' },
			{ label: 'Ubicaciones', href: '/ubicaciones/' },
		]}
	/>
	<section class="mx-auto max-w-6xl px-4 pb-16" aria-labelledby="consultas-especificas">
		<h2 id="consultas-especificas" class="text-2xl font-bold">Consultas jurídicas específicas</h2>
		<p class="mt-2 max-w-2xl text-slate-600">Si tu caso tiene una cuestión concreta, puedes revisar información específica antes de solicitar una consulta.</p>
		<div class="mt-6 grid gap-4 md:grid-cols-3">
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/modificacion-medidas-paterno-filiales/"><strong>Modificar medidas de custodia y visitas</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/desahucio-por-impago/"><strong>Desahucio por impago de alquiler</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/disputas-herencias/"><strong>Disputas y partición de herencias</strong></a>
		</div>
	</section>
	<section class="mx-auto max-w-6xl px-4 pb-16" aria-labelledby="servicios-adicionales">
		<h2 id="servicios-adicionales" class="text-2xl font-bold">Otros servicios jurídicos</h2>
		<div class="mt-6 grid gap-4 md:grid-cols-3">
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/responsabilidad-civil/"><strong>Responsabilidad civil y daños</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/reclamacion-pensiones/"><strong>Reclamación de pensiones</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/impugnacion-sanciones-administrativas/"><strong>Impugnación de sanciones administrativas</strong></a>
		</div>
	</section>
	<section class="mx-auto max-w-6xl px-4 pb-16" aria-labelledby="servicios-jubilacion-trafico-alquiler">
		<h2 id="servicios-jubilacion-trafico-alquiler" class="text-2xl font-bold">Consultas de jubilación, tráfico y alquiler</h2>
		<div class="mt-6 grid gap-4 md:grid-cols-3">
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/jubilacion-parcial/"><strong>Jubilación parcial</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/reclamacion-multas-trafico/"><strong>Reclamación de multas de tráfico</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/alquiler-viviendas/"><strong>Alquiler de vivienda</strong></a>
		</div>
	</section>
	<section class="mx-auto max-w-6xl px-4 pb-16" aria-labelledby="servicios-contratos-seguros">
		<h2 id="servicios-contratos-seguros" class="text-2xl font-bold">Contratos, alimentos y seguros</h2>
		<div class="mt-6 grid gap-4 md:grid-cols-3">
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/contratos-laborales/"><strong>Contratos laborales</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/pension-de-alimentos/"><strong>Pensión de alimentos</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/reclamaciones-seguros/"><strong>Reclamaciones de seguros</strong></a>
		</div>
	</section>
	<section class="mx-auto max-w-6xl px-4 pb-16" aria-labelledby="servicios-empresarial-laboral">
		<h2 id="servicios-empresarial-laboral" class="text-2xl font-bold">Consultas para empresas y trabajadores</h2>
		<div class="mt-6 grid gap-4 md:grid-cols-3">
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/licencias-de-actividad/"><strong>Licencias de actividad</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/contratos-comerciales/"><strong>Contratos comerciales</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/reclamacion-comisiones-laborales/"><strong>Reclamación de comisiones</strong></a>
		</div>
	</section>
	<section class="mx-auto max-w-6xl px-4 pb-16" aria-labelledby="servicios-familia-seguridad">
		<h2 id="servicios-familia-seguridad" class="text-2xl font-bold">Familia y Seguridad Social</h2>
		<div class="mt-6 grid gap-4 md:grid-cols-3">
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/reconocimiento-paternidad/"><strong>Reconocimiento de paternidad</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/tutela-legal/"><strong>Tutela legal</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/reclamacion-jubilacion/"><strong>Reclamación de jubilación</strong></a>
		</div>
	</section>
	<section class="mx-auto max-w-6xl px-4 pb-16" aria-labelledby="herramientas">
		<h2 id="herramientas" class="text-2xl font-bold">Herramientas gratuitas</h2>
		<p class="mt-2 max-w-2xl text-slate-600">Utilidades con datos verificados, para resolver la duda que aparece antes de contratar a nadie: qué juzgado te toca, qué pasa en cada partido, hasta qué día tienes de plazo, cuánto se paga de tasa judicial y cómo se reparte una herencia.</p>
		<div class="mt-6 grid gap-4 md:grid-cols-3">
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/que-juzgado-me-corresponde/"><strong>¿Qué juzgado me corresponde?</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/partidos-judiciales/"><strong>Partidos judiciales</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/calculadora-plazos/"><strong>Calculadora de plazos</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/calculadora-tasa-judicial/"><strong>Calculadora de tasa judicial</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/reparto-herencia/"><strong>Reparto de herencia y legítima</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/impuestos-herencia/"><strong>ITPF de una herencia</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/donde-atendemos/"><strong>Dónde atendemos y en qué materias</strong></a>
		</div>
	</section>
	<section class="mx-auto max-w-6xl px-4 pb-16" aria-labelledby="servicios-contratos-societario">
		<h2 id="servicios-contratos-societario" class="text-2xl font-bold">Contratos y sociedades</h2>
		<div class="mt-6 grid gap-4 md:grid-cols-2">
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/nulidad-contrato/"><strong>Nulidad de contratos</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/incumplimiento-contrato/"><strong>Incumplimiento de contrato</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/reclamacion-dividendos/"><strong>Reclamación de dividendos</strong></a>
			<a class="rounded border border-slate-200 p-4" href="/scruz-abogados/modificacion-estatutos-sociedad/"><strong>Modificación de estatutos</strong></a>
		</div>
	</section>
</CustomLayout>
