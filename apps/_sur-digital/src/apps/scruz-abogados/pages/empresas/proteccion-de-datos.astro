---
import heroImg from '@assets/9.webp';
import { SITE_URL } from '../../data/site';
import {
	BadgeCheck,
	BellRing,
	Briefcase,
	Cookie,
	Euro,
	Gavel,
	Handshake,
	Lock,
	ScrollText,
	ShieldAlert,
	ShieldCheck,
	Timer,
	UserCheck,
} from '@lucide/astro';
import CustomLayout from '../../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialProcess,
	EditorialWhyUs,
} from '../../components/editorial';

const faqEntries = [
	{
		question: '¿Qué tengo que hacer si mi empresa sufre una brecha de seguridad?',
		answer:
			'Lo primero es contener el incidente y documentarlo: qué datos se han visto afectados, cuántas personas, cuándo se detectó y qué medidas se han tomado. Si la brecha supone un riesgo para los derechos de las personas, hay que notificarlo a la Agencia Española de Protección de Datos en un plazo de 72 horas desde que se tiene constancia, y comunicarlo a los afectados cuando el riesgo es alto. Notificar tarde o no notificar es una infracción autónoma, aunque la brecha en sí se haya gestionado bien.',
	},
	{
		question: '¿Mi empresa está obligada a tener un delegado de protección de datos?',
		answer:
			'El DPO solo es obligatorio en los supuestos del artículo 34 de la LOPDGDD: colegios profesionales, centros sanitarios, centros docentes, entidades financieras, aseguradoras, empresas de seguridad, empresas que tratan datos a gran escala con perfilado y quien gestione datos de salud o de menores, entre otros. Si no estás en esa lista, puedes nombrar un asesor externo o encargar la función sin necesidad de registrarlo como DPO; lo importante es que alguien con criterio jurídico revise el tratamiento.',
	},
	{
		question: '¿Puedo usar los datos de mis clientes para enviarles publicidad?',
		answer:
			'El RGPD permite el envío a clientes existentes para productos o servicios similares si se informó al recoger el dato y se ofrece una forma sencilla de darse de baja en cada comunicación. Fuera de ese supuesto —captación de clientes nuevos, sectores ajenos al servicio contratado— hace falta consentimiento previo y expreso. La LSSI añade que la publicidad electrónica no consentida es infracción, así que la base jurídica hay que elegirla antes de montar la campaña, no después.',
	},
	{
		question: '¿Qué debe incluir el contrato con mi asesoría o mi proveedor de nóminas?',
		answer:
			'Toda empresa que trate datos personales por cuenta de otra necesita un contrato de encargado del tratamiento firmado y con el contenido del artículo 28 del RGPD: objeto y duración, finalidad, tipo de datos y categorías de interesados, obligaciones del encargado, medidas de seguridad, subcontratación, asistencia en el ejercicio de derechos y en las brechas, y destino de los datos al terminar el servicio. Faltar en la acreditación de este contrato es una de las causas de sanción más habituales en inspecciones.',
	},
	{
		question: '¿Cuánto me puede sancionar la AEPD?',
		answer:
			'Las infracciones leves llegan a 40.000 €, las graves a 300.000 € y las muy graves a 20 millones de euros o, si es superior, al 4 % de la facturación anual mundial del ejercicio anterior. Además del importe, la sanción deja constancia pública del expediente y suele acompañarse de medidas correctivas con plazo. Prescriben al año las leves, a los dos años las graves y a los tres las muy graves, pero el expediente puede seguir en marcha mucho después de corregir el problema.',
	},
	{
		question: '¿Es obligatorio el aviso de cookies si solo tengo una web informativa?',
		answer:
			'Sí, siempre que uses cookies o tecnologías no necesarias: analítica, publicidad, mapas incrustados, píxeles de redes sociales o vídeos externos. El banner tiene que permitir aceptar y rechazar por categorías con el mismo nivel de visibilidad, sin casillas premarcadas ni muros de bloqueo, y el consentimiento debe poder retirarse tan fácilmente como se otorgó. Las cookies técnicas y las de personalización estricta no requieren consentimiento, pero sí información.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: Timer, label: 'Brecha', value: '72 horas para notificar' },
	{ Icon: ScrollText, label: 'Documentación', value: 'Registro de tratamientos' },
	{ Icon: Euro, label: 'Riesgo', value: 'Hasta 20 M€ o el 4 %' },
];

const plazos = [
	{
		Icon: BellRing,
		title: '72 horas',
		description:
			'Plazo para notificar a la AEPD una brecha de seguridad que suponga un riesgo para los derechos de las personas.',
	},
	{
		Icon: ShieldAlert,
		title: '1 mes',
		description:
			'Plazo para responder al ejercicio de derechos (acceso, rectificación, supresión…), ampliable dos meses más si el caso es complejo.',
	},
	{
		Icon: Gavel,
		title: '1 a 3 años',
		description:
			'Prescripción de las infracciones: un año las leves, dos las graves y tres las muy graves (art. 73 LOPDGDD).',
	},
	{
		Icon: Euro,
		title: '20 M€',
		description:
			'Tope de las sanciones muy graves, o el 4 % de la facturación anual mundial del ejercicio anterior si es superior.',
	},
];

const conceptos = [
	{
		Icon: ScrollText,
		title: 'Registro de actividades de tratamiento',
		description:
			'El inventario que exige el artículo 30 del RGPD: qué datos tratas, con qué finalidad, con qué base jurídica, quién los ve y durante cuánto tiempo los conservas.',
	},
	{
		Icon: Handshake,
		title: 'Contratos con encargados',
		description:
			'Cerramos los contratos con asesoría, nóminas, hosting, CRM y proveedores de marketing con el contenido del artículo 28, incluidos los subencargados y las transferencias internacionales.',
	},
	{
		Icon: Cookie,
		title: 'Política de cookies y web',
		description:
			'Revisamos el banner, las categorías de consentimiento, la política de privacidad y los formularios para que la web capte datos de forma lícita y acreditable.',
	},
	{
		Icon: Lock,
		title: 'Medidas de seguridad y análisis de riesgos',
		description:
			'Definimos las medidas técnicas y organizativas proporcionadas al riesgo: control de accesos, cifrado, copias, política de contraseñas y gestión de dispositivos.',
	},
	{
		Icon: UserCheck,
		title: 'Derechos de las personas',
		description:
			'Protocolo para atender solicitudes de acceso, rectificación, supresión, oposición, limitación y portabilidad dentro de plazo, con registro de cada respuesta dada.',
	},
	{
		Icon: ShieldAlert,
		title: 'Brechas y respuesta ante la AEPD',
		description:
			'Procedimiento de actuación ante un incidente, notificación en 72 horas, comunicación a los afectados y alegaciones si la Agencia abre expediente sancionador.',
	},
];

const pasos = [
	{
		number: '01',
		title: 'Diagnóstico del tratamiento',
		description:
			'Mapa real de datos: qué se recoge en cada área de la empresa (clientes, empleados, proveedores, web), dónde se guarda y quién tiene acceso. Sin esto, cualquier documento que se firme es decorativo.',
	},
	{
		number: '02',
		title: 'Documentación obligatoria',
		description:
			'Registro de actividades, cláusulas informativas, contratos de encargado, política de privacidad, política de cookies y análisis de riesgos, adaptados al tamaño y al sector de tu empresa.',
	},
	{
		number: '03',
		title: 'Medidas, formación y protocolos',
		description:
			'Implantamos las medidas técnicas y organizativas, y formamos al equipo en lo que de verdad importa: qué datos se pueden compartir, cómo atender un derecho y qué hacer ante un incidente.',
	},
	{
		number: '04',
		title: 'Mantenimiento y respuesta',
		description:
			'El cumplimiento no se firma una vez y se archiva: revisamos altas de proveedores, nuevas herramientas, campañas y brechas, y te representamos ante la AEPD si llega una inspección.',
	},
];

const why = [
	{
		Icon: Briefcase,
		title: 'Cumplimiento que sirve para algo',
		description:
			'No entregamos una carpeta de plantillas: montamos un sistema que aguanta una inspección y que además te sirve para negociar con clientes que exigen garantías de RGPD.',
	},
	{
		Icon: ShieldCheck,
		title: 'Prevenir la sanción, no negociarla después',
		description:
			'La mayoría de las multas llegan por falta de documentación o de contrato con el encargado, no por el incidente en sí. Revisamos eso primero, que es lo barato.',
	},
	{
		Icon: BadgeCheck,
		title: 'Un interlocutor, un presupuesto',
		description:
			'Llevas el cumplimiento con la misma persona desde la auditoría inicial, con presupuesto cerrado por escrito y sin sorpresas a mitad del proyecto.',
	},
];

const relatedGuides = [
	{ label: 'Verifactu y facturación electrónica', href: '/blog/verifactu-facturacion-electronica/' },
	{ label: 'Reforma de la Ley de consumidores', href: '/blog/reforma-ley-consumidores/' },
	{ label: 'Crear una empresa en Andalucía', href: '/blog/crear-empresa-andalucia/' },
];
---

<CustomLayout
	title="Protección de Datos y RGPD para Empresas | Scruz Abogados"
	description="RGPD y LOPDGDD para empresas en Lucena y Córdoba: registro de actividades, contratos con encargados y brechas de seguridad. Consulta gratuita: 666 329 155."
	keywords="rgpd empresas Lucena, protección de datos Córdoba, AEPD sanción, registro de actividades de tratamiento, encargado del tratamiento, delegado de protección de datos, política de cookies"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Empresas', url: '/empresas/' },
		{ name: 'Protección de Datos', url: '/empresas/proteccion-de-datos/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/empresas/proteccion-de-datos/#service`,
			url: `${SITE_URL}/empresas/proteccion-de-datos/`,
			name: 'Protección de datos y RGPD para empresas',
			description:
				'Adaptación al RGPD y a la LOPDGDD: registro de actividades, contratos con encargados, medidas de seguridad y respuesta ante brechas.',
			serviceType: 'Protección de datos y cumplimiento normativo',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
			isPartOf: { '@id': `${SITE_URL}/empresas/#service` },
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Abogado de protección de datos revisando el cumplimiento del RGPD de una empresa en Lucena"
		supertitle="Empresas · Protección de datos"
		description="Adaptamos tu empresa al RGPD y a la LOPDGDD con documentación real, contratos con proveedores y un protocolo claro para cuando algo se tuerce."
		stats={heroStats}
	>
		<span slot="title"
			>Protección de datos para empresas: <span class="text-primary"
				>cumplir antes de que llegue la inspección.</span
			></span
		>
	</EditorialHero>

	<EditorialIntro
		supertitle="Cumplimiento del RGPD"
		title={'Protege los datos <span class="text-primary">que ya estás tratando</span>.'}
		factboxSupertitle="Lo que debes saber"
		factboxTitle="Plazos y cifras que importan"
		factboxItems={plazos}
	>
		<p class="mb-4">
			Toda empresa trata datos personales, lo sepa o no: la nómina de la plantilla, los contactos
			comerciales, las cámaras del local, los currículums que se guardan «por si acaso» o el
			boletín de noticias de la web. El RGPD y la LOPDGDD se aplican a partir del primer dato,
			sin mínimo de plantilla ni de facturación, y la carga de demostrar que se cumple recae
			siempre en la empresa.
		</p>
		<p class="mb-4">
			Lo que sanciona la Agencia Española de Protección de Datos casi nunca es un hacker: es la
			falta de registro de actividades, la ausencia de contrato con el encargado del tratamiento,
			un banner de cookies que no permite rechazar o una solicitud de un cliente que se quedó sin
			contestar. Es decir, cosas que se arreglan con documentación y procedimientos, no con
			informática.
		</p>
		<p>
			Trabajamos con empresas de Lucena, Córdoba y Málaga que necesitan cumplir sin frenar su
			actividad: auditamos lo que ya se hace, cerramos los huecos y dejamos el sistema en
			mantenimiento. Si tu caso es más de contratos con proveedores o de plantilla,
			<a href="/scruz-abogados/empresas/">te cubrimos también esas áreas</a>.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué hacemos por tu empresa"
		title="Servicios de protección de datos"
		description="Del inventario de tratamientos a la respuesta ante la Agencia, con la documentación que de verdad pide una inspección."
		items={conceptos}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="Cómo implantamos el cumplimiento"
		items={pasos}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Cumplimiento con criterio jurídico."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Dudas de empresa sobre protección de datos"
		description="Las preguntas que más nos llegan de pymes y autónomos antes de adaptarse al RGPD o después de recibir un requerimiento."
		items={faqEntries}
	/>

	<ServiceBlogGuides supertitle="Guías para empresas" />

	<EditorialCtaFinal
		supertitle="Revisamos tu cumplimiento"
		title={'Una auditoría hoy, <span class="text-primary">un expediente menos mañana.</span>'}
		description="Primera consulta gratuita y confidencial. Revisamos cómo tratas los datos de clientes y empleados y te decimos qué te falta y qué riesgo real tienes."
		relatedLinks={[
			...relatedGuides,
			{ label: 'Empresas y mercantil', href: '/empresas/' },
			{ label: 'Constitución de sociedades', href: '/empresas/constitucion-sociedades/' },
			{ label: 'Derecho laboral para empresas', href: '/empresas/derecho-laboral/' },
			{ label: 'Contratos mercantiles', href: '/empresas/contratos-mercantiles/' },
		]}
	/>
</CustomLayout>
