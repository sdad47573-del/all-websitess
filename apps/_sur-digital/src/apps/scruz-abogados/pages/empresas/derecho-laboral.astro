---
import heroImg from '../../@assets/8.webp';
import { SITE_URL } from '../../data/site';
import {
	BadgeCheck,
	Briefcase,
	CalendarClock,
	ClipboardList,
	Euro,
	FileCheck,
	Gavel,
	HandCoins,
	Receipt,
	ShieldAlert,
	ShieldCheck,
	TriangleAlert,
	UserCog,
	Users,
} from '@lucide/astro';
import CustomLayout from '../../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialProcess,
	EditorialWhyUs,
} from '../../components/editorial';

const faqEntries = [
	{
		question: '¿Puedo despedir a un trabajador por bajo rendimiento?',
		answer:
			'El bajo rendimiento no basta por sí solo: para el despido disciplinario la ley exige una disminución continuada y voluntaria del rendimiento y el cumplimiento previo de los objetivos pactados. Lo que funciona es documentar el objetivo, advertir por escrito y dar un plazo de mejora. Si no mejora, se puede acudir a un despido objetivo por ineptitud sobrevenida o por causas organizativas, con 20 días por año trabajado, o asumir el despido improcedente con 33 días por año y un tope de 24 mensualidades. La elección entre una y otra vía es lo que decide el coste final.',
	},
	{
		question: '¿Cuánto me puede costar un despido mal hecho?',
		answer:
			'Un despido declarado improcedente se indemniza con 33 días de salario por año trabajado, con el límite de 24 mensualidades, y puede añadir los salarios de tramitación desde el despido hasta la sentencia cuando el trabajador no es representante legal. A eso hay que sumar el coste del proceso y el tiempo de la persona que se ocupa del caso. Revisar el expediente antes de comunicar el despido suele costar mucho menos que corregirlo después.',
	},
	{
		question: '¿Qué hago si mi empresa recibe una visita de la Inspección de Trabajo?',
		answer:
			'Antes de nada, ordenar la documentación que el inspector va a pedir: contratos y altas, nóminas, registro horario, partes de horas extra, evaluación de riesgos y formación en prevención, además de la documentación de autónomos societarios. Si la visita termina en acta de infracción, hay plazo para presentar alegaciones y, después, para recurrir en vía administrativa y contenciosa. La mayoría de actas se reducen o decaen por defectos de motivación o de cálculo, no por discutir los hechos.',
	},
	{
		question: '¿Es obligatorio el registro horario en todas las empresas?',
		answer:
			'Sí. Desde 2019 el artículo 34.9 del Estatuto de los Trabajadores obliga a registrar la jornada diaria de cada persona, con hora de inicio y de fin, tanto en contratos a tiempo completo como parcial. El registro debe conservarse cuatro años y estar a disposición de la persona trabajadora, de sus representantes y de la Inspección. No llevar registro, o llevarlo sin las horas extra, es una de las infracciones más habituales.',
	},
	{
		question: '¿Puedo reducir jornada o suspender contratos si baja el trabajo?',
		answer:
			'Sí, mediante un expediente de regulación temporal de empleo por causas económicas, técnicas, organizativas o de producción, que exige periodo de consultas con la representación de los trabajadores y comunicación a la autoridad laboral. Si la reducción es definitiva y afecta al umbral legal de trabajadores, la vía es el despido colectivo. Documentar bien la causa —cuentas, pedidos, evolución de la facturación— es lo que sostiene el expediente después.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: ClipboardList, label: 'Prevención', value: 'Auditoría laboral' },
	{ Icon: Gavel, label: 'Defensa', value: 'Inspección y juicio' },
	{ Icon: Euro, label: 'Coste', value: 'Presupuesto cerrado' },
];

const plazos = [
	{
		Icon: CalendarClock,
		title: '20 días hábiles',
		description:
			'Plazo del trabajador para impugnar un despido. En la empresa, es la ventana para revisar el expediente y preparar la defensa.',
	},
	{
		Icon: Receipt,
		title: '1 año',
		description:
			'Prescripción de la reclamación de cantidad: salarios, horas extra, dietas o complementos impagados.',
	},
	{
		Icon: ShieldAlert,
		title: '6 a 18 meses',
		description:
			'Prescripción de las infracciones laborales según su gravedad, y de sus sanciones en la misma escala (LISOS).',
	},
	{
		Icon: Briefcase,
		title: '4 años',
		description:
			'Plazo para reclamar cuotas a la Seguridad Social y para revisar periodos de cotización mal calculados.',
	},
];

const conceptos = [
	{
		Icon: FileCheck,
		title: 'Contratos y convenio aplicable',
		description:
			'Redactamos contratos ajustados al convenio de tu sector —con sus categorías, jornada y periodo de prueba— y revisamos los que ya tienes firmados, incluidos los de autónomos con dependencia y los fijos discontinuos.',
	},
	{
		Icon: TriangleAlert,
		title: 'Despidos y extinciones',
		description:
			'Analizamos la causa antes de comunicar nada, elegimos la vía (disciplinario, objetivo, fin de contrato) y calculamos la indemnización y los finiquitos para que el despido aguante un juicio.',
	},
	{
		Icon: Users,
		title: 'Expedientes de regulación',
		description:
			'Tramitamos ERTE y despidos colectivos: causas documentadas, periodo de consultas con la representación legal y comunicación a la autoridad laboral.',
	},
	{
		Icon: ShieldCheck,
		title: 'Inspección de Trabajo',
		description:
			'Preparamos la documentación antes de la visita, acompañamos durante la inspección y alegamos o recurrimos el acta de infracción en vía administrativa y contenciosa.',
	},
	{
		Icon: HandCoins,
		title: 'Reclamaciones de cantidad',
		description:
			'Defendemos a la empresa frente a reclamaciones de salarios, horas extra o diferencias de convenio, e impugnamos despidos y sanciones disciplinarias.',
	},
	{
		Icon: UserCog,
		title: 'Prevención y protocolos',
		description:
			'Plan de prevención, evaluación de riesgos psicosociales, registro horario, registro retributivo y protocolo frente al acoso: la documentación que evita sanciones.',
	},
];

const pasos = [
	{
		number: '01',
		title: 'Diagnóstico laboral',
		description:
			'Revisamos contratos, nóminas, registro horario y convenio aplicable para detectar los puntos débiles antes de que llegue una reclamación o una inspección.',
	},
	{
		number: '02',
		title: 'Documentación y protocolos',
		description:
			'Cerramos los huecos: objetivos por escrito, expedientes disciplinarios bien instruidos, registro horario y protocolos de prevención actualizados.',
	},
	{
		number: '03',
		title: 'Respuesta en plazo',
		description:
			'Ante un despido impugnado o un acta de infracción, presentamos alegaciones y la papeleta o demanda en los plazos legales, sin dejar caducar ninguna acción.',
	},
	{
		number: '04',
		title: 'Representación y resultado',
		description:
			'Negociamos en el SMAC cuando conviene y representamos a la empresa en el Juzgado de lo Social hasta la sentencia o el acuerdo.',
	},
];

const why = [
	{
		Icon: Briefcase,
		title: 'Conocemos los convenios de la zona',
		description:
			'Trabajamos a diario con los convenios de la industria agroalimentaria, el comercio y la hostelería de Lucena, Córdoba y Málaga: sabemos qué categorías y complementos se discuten de verdad.',
	},
	{
		Icon: ShieldCheck,
		title: 'Prevenir sale más barato que litigar',
		description:
			'Un expediente bien instruido y un registro horario al día evitan la mayoría de las condenas. Revisamos la documentación antes de que sea urgente.',
	},
	{
		Icon: BadgeCheck,
		title: 'Un interlocutor, no un buzón',
		description:
			'Llevas tu caso con el mismo abogado desde la primera consulta hasta el último escrito, sin que tengas que repetir tu historia a cuatro personas.',
	},
];

const relatedGuides = [
	{ label: 'Despido improcedente', href: '/blog/despido-improcedente/' },
	{ label: 'Jornada de 37,5 horas', href: '/blog/jornada-375-horas/' },
	{ label: 'Prevención de riesgos laborales', href: '/blog/nueva-ley-prevencion-riesgos-laborales/' },
];
---

<CustomLayout
	title="Abogado Laboral para Empresas en Lucena | Scruz Abogados"
	description="Asesoría laboral para empresas en Lucena y Córdoba: despidos, ERTE, convenios, inspección de trabajo y reclamaciones de cantidad. Consulta gratuita: 666 329 155."
	keywords="abogado laboral empresas Lucena, asesoría laboral Córdoba, despido improcedente empresa, ERTE, inspección de trabajo, convenio colectivo, registro horario, reclamación de cantidad"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Empresas', url: '/empresas/' },
		{ name: 'Derecho Laboral', url: '/empresas/derecho-laboral/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/empresas/derecho-laboral/#service`,
			url: `${SITE_URL}/empresas/derecho-laboral/`,
			name: 'Asesoría laboral para empresas',
			description:
				'Despidos, expedientes de regulación, contratos y convenios, inspección de trabajo y prevención de riesgos para empresas.',
			serviceType: 'Derecho laboral y de la Seguridad Social',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
			isPartOf: { '@id': `${SITE_URL}/empresas/#service` },
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Abogado laboral asesorando a una empresa en Lucena"
		supertitle="Empresas · Derecho laboral"
		description="Defendemos a la empresa en todo lo que afecta a su plantilla: contratos, despidos, expedientes y visitas de la Inspección de Trabajo."
		stats={heroStats}
	>
		<span slot="title"
			>Abogado laboral para empresas en Lucena: <span class="text-primary"
				>decisiones con respaldo jurídico.</span
			></span
		>
	</EditorialHero>

	<EditorialIntro
		supertitle="Asesoría laboral de empresa"
		title={'Gestionamos tu plantilla <span class="text-primary">antes del conflicto</span>.'}
		factboxSupertitle="Lo que debes saber"
		factboxTitle="Plazos que no se pueden perder"
		factboxItems={plazos}
	>
		<p class="mb-4">
			La relación laboral es el frente donde una empresa se juega más dinero sin darse cuenta: un
			despido mal comunicado, un contrato que no encaja con el convenio del sector o un registro
			horario incompleto se convierten en indemnizaciones, recargos y sanciones que se podían
			haber evitado con una revisión previa.
		</p>
		<p class="mb-4">
			Asesoramos a empresas y autónomos de Lucena, Córdoba y Málaga en las dos caras del derecho
			laboral: la preventiva —contratos, convenio aplicable, registro horario, registro
			retributivo, plan de prevención y protocolos— y la de defensa, cuando ya hay una
			reclamación, un despido impugnado o un acta de la Inspección de Trabajo sobre la mesa.
		</p>
		<p>
			Cada encargo se presupuesta por escrito antes de empezar y se lleva con un único
			interlocutor. Si además tu empresa necesita la parte mercantil,
			<a href="/scruz-abogados/empresas/">te cubrimos también esa pata</a>.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué hacemos por tu empresa"
		title="Servicios laborales"
		description="Cobertura completa del día a día de la plantilla, desde la firma del contrato hasta la sentencia del Juzgado de lo Social."
		items={conceptos}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="Cómo trabajamos la parte laboral"
		items={pasos}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Tu empresa, tratada como una empresa."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Dudas de empresa sobre laboral"
		description="Las preguntas que más nos hacen los empresarios antes de contratar, despedir o afrontar una inspección."
		items={faqEntries}
	/>

	<ServiceBlogGuides supertitle="Guías para empresas" />

	<EditorialCtaFinal
		supertitle="Hablemos de tu plantilla"
		title={'Un problema laboral, <span class="text-primary">resuelto a tiempo.</span>'}
		description="Primera consulta gratuita y confidencial. Revisamos tu caso o tu documentación laboral y te decimos qué riesgo real tienes y cómo reducirlo."
		relatedLinks={[
			...relatedGuides,
			{ label: 'Empresas y mercantil', href: '/empresas/' },
			{ label: 'Constitución de sociedades', href: '/empresas/constitucion-sociedades/' },
			{ label: 'Contratos mercantiles', href: '/empresas/contratos-mercantiles/' },
			{ label: 'Protección de datos y RGPD', href: '/empresas/proteccion-de-datos/' },
			{ label: 'Cobro de deudas e impagos', href: '/cobro-deudas-impagos/' },
		]}
	/>
</CustomLayout>
