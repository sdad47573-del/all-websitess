---
import heroImg from '../@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	Calendar,
	Clock,
	CreditCard,
	Euro,
	Heart,
	Landmark,
	ShieldCheck,
	TrendingUp,
	Users,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Quién tiene derecho a reclamar el complemento por maternidad/paternidad?',
		answer:
			'Tienen derecho las personas que entre el 1 de enero de 2016 y el 4 de febrero de 2021 hayan accedido a la pensión de jubilación, incapacidad permanente o viudedad y tengan uno o más hijos biológicos o adoptados vivos. También quienes tengan hijos en supuestos especiales (muerte del otro progenitor, abandono, violencia de género). Reclamamos incluso para pensiones ya reconocidas.',
	},
	{
		question: '¿Cuánto se cobra con el complemento?',
		answer:
			'El complemento es un porcentaje adicional sobre la base reguladora de la pensión, que oscila entre el 5% (1 hijo), el 10% (2 hijos), el 15% (3 hijos) y un 20% para cuatro o más hijos. Para una pensión media de 1.200 € al mes, el complemento puede suponer entre 60 € y 240 € mensuales, además de una atrasos de hasta 5 años.',
	},
	{
		question: '¿El complemento se puede pedir en cualquier momento?',
		answer:
			'Sí. El Tribunal Supremo y el TJUE han establecido que no hay plazo de prescripción para reclamar el complemento mientras la pensión siga vigente, siempre que se cumplan los requisitos. De hecho, el INSS sigue abonando nuevas solicitudes sin necesidad de acudir a los tribunales cuando los requisitos son claros.',
	},
	{
		question: '¿Qué pasa si el INSS me deniega la solicitud?',
		answer:
			'Si el INSS deniega el complemento, presentamos reclamación previa en el plazo de 30 días y, si vuelve a denegarse, demanda ante el Juzgado de lo Social. Los tribunales están dando la razón a los pensionistas en la gran mayoría de los casos, tanto el TS como el TJUE han confirmado el derecho en supuestos en los que el hombre también cumple los requisitos.',
	},
	{
		question: '¿Pueden solicitarlo los hombres?',
		answer:
			'Sí. El Tribunal de Justicia de la Unión Europea declaró en 2019 que la limitación inicial solo a madres era discriminatoria. Por tanto, también los padres con uno o más hijos pueden reclamar el complemento, con efectos desde su jubilación o reconocimiento de la pension.',
	},
	{
		question: '¿Cuánto tarda en resolverse la solicitud?',
		answer:
			'Si el expediente está bien documentado, el INSS suele resolver entre 3 y 6 meses. Cuando hay denegación y pleitamos, el procedimiento en el Juzgado de lo Social puede durar entre 1 y 2 años, aunque la sentencia prácticamente siempre favorable.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: TrendingUp, label: 'Incremento', value: '5% – 20%' },
	{ Icon: Euro, label: 'Atrasos', value: 'Hasta 5 años' },
	{ Icon: ShieldCheck, label: 'Jurisprudencia', value: 'Favorable' },
];

const plazos = [
	{
		Icon: Calendar,
		title: '2016 — 2021',
		description: 'Periodo en el que se accedió a la pensión para tener derecho al complemento.',
	},
	{
		Icon: Clock,
		title: 'Sin caducidad',
		description: 'Pueden reclamarse mientras la pensión siga vigente, con atrasos de hasta 5 años.',
	},
	{
		Icon: ShieldCheck,
		title: 'Doctrina TS y TJUE',
		description: 'El Supremo y la UE consideran discriminatorio excluir a los hombres con hijos.',
	},
];

const conceptos = [
	{
		Icon: Users,
		title: 'Hijos biológicos o adoptados',
		description:
			'Tienen derecho madres y padres con uno o más hijos vivos. También casos especiales: hijos fallecidos, parejas de hecho registradas, hijos en acogimiento familiar preadoptivo.',
	},
	{
		Icon: Euro,
		title: 'Pensión de jubilación',
		description:
			'Se aplica a la jubilación contributiva cuando se accedió al derecho entre 2016 y 2021. Se abona como porcentaje añadido a la base reguladora de la pensión.',
	},
	{
		Icon: Heart,
		title: 'Incapacidad permanente',
		description:
			'Tambien compatible con pensiones de incapacidad permanente reconocidas en el mismo periodo. En supuestos de viudedad, el complemento se aplica a la base reguladora de la pensión de viudedad.',
	},
	{
		Icon: TrendingUp,
		title: 'Porcentajes aplicables',
		description:
			'5 % por 1 hijo, 10 % por 2, 15 % por 3 y 20 % por 4 o más. Los porcentajes incrementan la base reguladora, lo que se traduce en un aumento permanente de la pensión.',
	},
	{
		Icon: Landmark,
		title: 'INSS y Seguridad Social',
		description:
			'Solicitamos el reconocimiento del complemento ante el INSS y, en su caso, la correspondiente reclamación administrativa. En última instancia, demandamos ante el Juzgado de lo Social.',
	},
	{
		Icon: Clock,
		title: 'Atrasos retroactivos',
		description:
			'Cuando se reconoce el derecho, el INSS abona los atrasos correspondientes a los últimos cinco años, lo que convierte esta reclamación en especialmente valiosa.',
	},
];

const pasos = [
	{
		number: '01',
		title: 'Estudio de viabilidad',
		description:
			'Analizamos tu expediente de pensión, número de hijos y situación personal para confirmar que cumples los requisitos y estimar el incremento esperable.',
	},
	{
		number: '02',
		title: 'Solicitud al INSS',
		description:
			'Preparamos y presentamos la solicitud formal del complemento ante la Dirección Provincial del INSS con toda la documentación requerida.',
	},
	{
		number: '03',
		title: 'Reclamación previa',
		description:
			'Si el INSS deniega o no contesta en plazo, presentamos reclamación previa en el plazo de 30 días para agotar la vía administrativa.',
	},
	{
		number: '04',
		title: 'Demanda y sentencia',
		description:
			'Cuando la reclamación se desestima, llevamos tu caso al Juzgado de lo Social. La jurisprudencia es muy favorable a los pensionistas en este ámbito.',
	},
];

const why = [
	{
		Icon: ShieldCheck,
		title: 'Especialistas en Seguridad Social',
		description:
			'Conocemos la jurisprudencia del Tribunal Supremo y del TJUE sobre este complemento y los criterios de los Juzgados de lo Social en Andalucía.',
	},
	{
		Icon: TrendingUp,
		title: 'Aumento permanente',
		description:
			'El incremento se consolida en tu pensión. Una vez concedido, lo cobrarás mes tras mes mientras dure la pensión y con sus revalorizaciones anuales.',
	},
	{
		Icon: CreditCard,
		title: 'Atrasos garantizados',
		description:
			'Cuando se reconoce el derecho, recibirás los atrasos correspondientes a los últimos cinco años. Es un ingreso importante que muchos pensionistas desconocen.',
	},
];

const rangos = [
	{ title: '1 hijo', value: '+5%', note: 'Incremento permanente sobre la base reguladora' },
	{ title: '2 hijos', value: '+10%', note: 'Incremento permanente sobre la base reguladora' },
	{ title: '3 hijos', value: '+15%', note: 'Incremento permanente sobre la base reguladora' },
	{ title: '4 o más hijos', value: '+20%', note: 'Incremento permanente sobre la base reguladora' },
];
---

<CustomLayout
	title="Reclamar el complemento de paternidad y maternidad"
	description="Abogado del complemento de paternidad o maternidad en Lucena, Córdoba y Málaga: aumentamos tu pensión de jubilación. Consulta gratuita: 666 329 155."
	keywords="complemento maternidad pensión, complemento paternidad Lucena, desigualdad género pensión Córdoba, INSS jubilación, atrasos complemento, abogado seguridad social Málaga"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Complemento Paternidad/Maternidad', url: '/complemento-paternidad-maternidad/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/complemento-paternidad-maternidad/#service`,
			serviceType: 'Derecho de la Seguridad Social',
			name: 'Solicitud y reclamación del complemento por maternidad/paternidad',
			description:
				'Tramitamos el complemento para aumentar la pensión de jubilación por haber tenido hijos.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Complemento por maternidad o paternidad para aumentar la pensión de jubilación"
		supertitle="Seguridad Social · Complemento por hijos"
		description="Te ayudamos a reclamar el complemento por maternidad o paternidad para que tu pensión refleje el esfuerzo de criar a tus hijos. Atrasos de hasta cinco años."
		stats={heroStats}
	>
		<span slot="title">Te ayudamos a aumentar tu pensión.</span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'Aumenta tu pensión con el <span class="text-primary">complemento por hijos</span>.'}
		factboxSupertitle="Requisitos clave"
		factboxTitle="Condiciones básicas"
		factboxItems={plazos}
	>
		<p class="mb-4">
			Como padre o madre que ha dedicado años al cuidado de tus hijos, has hecho una
			aportación invaluable a la sociedad y a tu familia. La Seguridad Social reconoce
			este esfuerzo para el cálculo de tu jubilación, pero durante años muchos
			pensionistas no solicitaron el complemento por desconocimiento.
		</p>
		<p class="mb-4">
			En Scruz Abogados te ayudamos a obtener el complemento de maternidad o paternidad,
			un incremento permanente en tu pensión que, según el número de hijos, oscila entre
			el 5% y el 20% de la base reguladora. Revisamos tu historial de cotización,
			reunimos la documentación necesaria y gestionamos la solicitud para que recibas
			cada euro que te pertenece, incluidos los atrasos correspondientes a los últimos
			cinco años.
		</p>
		<p>
			Cuando el INSS deniega la solicitud o no responde en plazo, recurrimos a la vía
			de reclamación previa y, en última instancia, al Juzgado de lo Social. La
			jurisprudencia del Tribunal Supremo y del TJUE está claramente a favor de los
			pensionistas, hombres y mujeres con hijos. Trabajamos con honorarios
			condicionados al resultado: solo cobramos si conseguimos el reconocimiento del
			complemento.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué tramitamos"
		title="El complemento por hijos"
		description="Cobertura completa del reconocimiento del complemento y, en su caso, defensa judicial frente a la negativa del INSS."
		items={conceptos}
	/>

	<EditorialMeasures
		supertitle="Cifras orientativas"
		title="Incremento sobre tu pensión"
		description="El porcentaje aplicable varía según el número de hijos. Incremento permanente que se revaloriza cada año con la pensión."
		valueFormat="single-currency"
		noteLabel="Porcentaje aplicable."
		disclaimer="Porcentajes legales vigentes. El importe exacto depende del número de hijos y de la base reguladora de tu pensión — calculamos tu incremento en una primera consulta."
		items={rangos}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="Del estudio del expediente al cobro de atrasos"
		items={pasos}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Tu complemento, en manos expertas."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Resolvemos tus dudas"
		description="Las preguntas más habituales sobre el complemento por maternidad/paternidad: requisitos, porcentajes y plazos."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Estamos a tu lado"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Te informamos de si cumples requisitos, cuánto podrías cobrar y cómo actuar. Sin compromiso y sin coste inicial."
		relatedLinks={[
			{ label: 'Jubilación 2027: guía', href: '/blog/jubilacion-2027/' },
			{ label: 'Incapacidad permanente', href: '/incapacidad-permanente/' },
			{ label: 'Accidente laboral', href: '/accidente-laboral/' },
			{ label: 'Sobre nosotros', href: '/quienes-somos/' },
		]}
	/>
</CustomLayout>
