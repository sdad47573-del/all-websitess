---
import heroImg from '../@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	Ban,
	Clock,
	Euro,
	FileCheck,
	Handshake,
	Landmark,
	Scale,
	ShieldCheck,
	Users,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Qué es la liquidación de la sociedad de gananciales?',
		answer:
			'Es el procedimiento por el que, tras disolverse el régimen económico de gananciales, se determinan los bienes y deudas comunes (inventario), se valoran y se reparten entre ambos cónyuges. El resultado final suele formalizarse en un cuaderno particional o en una escritura de adjudicación. Sin la liquidación, los bienes siguen en una comunidad que conviene cerrar cuanto antes para evitar conflictos y bloqueos.',
	},
	{
		question: '¿Cuándo se disuelve la sociedad de gananciales?',
		answer:
			'Las causas más habituales son el divorcio, la separación o la nulidad del matrimonio. También se disuelve en otros supuestos: separación de hecho, embargo de bienes de uno de los cónyuges, muerte de uno de ellos o por acuerdo en convenio regulador. Desde ese momento los gananciales quedan en estado de liquidación y cualquiera de las partes puede instar el reparto.',
	},
	{
		question: '¿Qué bienes y deudas entran en el inventario?',
		answer:
			'Entran los bienes gananciales: salarios, frutos y rentas, bienes adquiridos a título oneroso durante el matrimonio, explotaciones y negocios comunes, y los derechos de pensión en la parte ganancial. También las deudas gananciales: cargas familiares, hipotecas, préstamos comunes. Quedan fuera los bienes privativos de cada cónyuge (los adquiridos antes del matrimonio, por herencia o donación, o con carácter privativo). Identificar correctamente qué es ganancial y qué es privativo es la clave del reparto.',
	},
	{
		question: '¿Y si no llegamos a un acuerdo para repartir?',
		answer:
			'Si no hay acuerdo sobre el inventario o la adjudicación, se acude al procedimiento de liquidación judicial del artículo 810 de la Ley de Enjuiciamiento Civil: se forma el inventario con la intervención de ambos, se valora, y en caso de desacuerdo sobre los lotes se puede acudir a la subasta. Es una vía más larga y costosa; por eso siempre intentamos primero un acuerdo extrajudicial con inventario y avalúo previo.',
	},
	{
		question: '¿Puedo liquidar la sociedad de gananciales sin divorciarme?',
		answer:
			'Sí. La disolución y liquidación pueden pactarse en el convenio regulador del divorcio de mutuo acuerdo, pero también cabe disolver la sociedad de gananciales por separación de hecho o por otras causas sin divorcio. Si lo que quieres es simplemente regular la situación patrimonial, te asesoramos sobre la vía más adecuada en cada momento.',
	},
	{
		question: '¿Cuánto cuesta y cuánto tarda liquidar los gananciales?',
		answer:
			'Depende del patrimonio y de si hay acuerdo. Con acuerdo y un patrimonio ordenado, el inventario, la valoración y la adjudicación pueden completarse en unos meses. En Scruz Abogados preparamos un presupuesto cerrado con todas las gestiones incluidas y te explicamos los plazos reales antes de empezar. La primera consulta es gratuita.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: ShieldCheck, label: 'Especialidad', value: 'Sociedad de gananciales' },
	{ Icon: Landmark, label: 'Sedes', value: 'Lucena · Córdoba · Málaga' },
	{ Icon: Scale, label: 'Primera cita', value: 'Gratuita' },
];

const plazos = [
	{
		Icon: Clock,
		title: 'Sin plazo de caducidad',
		description:
			'La liquidación puede instarse en cualquier momento tras la disolución, pero conviene no demorarla para evitar bloqueos del patrimonio común.',
	},
	{
		Icon: FileCheck,
		title: 'Convenio regulador',
		description:
			'Vía pactada en el divorcio o separación de mutuo acuerdo: inventario, adjudicación y escritura en un solo proceso.',
	},
	{
		Icon: Scale,
		title: 'Vía judicial',
		description:
			'Procedimiento del art. 810 LEC cuando no hay acuerdo sobre el inventario o la adjudicación.',
	},
];

const conceptos = [
	{
		Icon: FileCheck,
		title: 'Inventario de bienes y deudas',
		description:
			'Relación completa de activos (vivienda, cuentas, vehículos, negocios, derechos) y pasivos (hipotecas, préstamos, cargas) para delimitar qué es ganancial y qué es privativo.',
	},
	{
		Icon: Ban,
		title: 'Disolución de la sociedad',
		description:
			'Tramitamos la disolución por divorcio, separación, nulidad o separación de hecho, y defendemos tus derechos desde el momento en que el régimen queda en liquidación.',
	},
	{
		Icon: Handshake,
		title: 'Reparto de mutuo acuerdo',
		description:
			'Negociamos y redactamos el convenio o la escritura de liquidación: adjudicación de lotes, compensaciones económicas y cuaderno particional sin pasar por el juzgado.',
	},
	{
		Icon: Scale,
		title: 'Liquidación judicial',
		description:
			'Cuando no hay acuerdo, instamos el procedimiento del art. 810 LEC: inventario judicial, avalúo, adjudicación y, en su caso, subasta de los bienes.',
	},
	{
		Icon: Euro,
		title: 'Valoración y compensaciones',
		description:
			'Coordinamos tasaciones y peritos para que la valoración sea justa y calculamos las compensaciones entre cónyuges cuando los lotes no son equivalentes.',
	},
	{
		Icon: Users,
		title: 'Protección de tu patrimonio',
		description:
			'Detectamos ocultaciones de bienes, impugnaciones de inventario y deudas discutibles para que el reparto sea real y no te perjudique.',
	},
];

const pasos = [
	{
		number: '01',
		title: 'Análisis del patrimonio',
		description:
			'Recopilamos y revisamos los bienes y deudas de la sociedad: escrituras, cuentas, vehículos, negocios, préstamos y cargas.',
	},
	{
		number: '02',
		title: 'Inventario y valoración',
		description:
			'Elaboramos el inventario definitivo, identificamos los bienes privativos y coordinamos la valoración de los gananciales con peritos si es necesario.',
	},
	{
		number: '03',
		title: 'Acuerdo o demanda',
		description:
			'Buscamos primero el acuerdo extrajudicial (convenio o escritura); si no es posible, interponemos la demanda de liquidación judicial.',
	},
	{
		number: '04',
		title: 'Adjudicación e inscripción',
		description:
			'Formalizamos la adjudicación de bienes en escritura pública, liquidamos las cargas y procedemos a la inscripción en el Registro de la Propiedad.',
	},
];

const why = [
	{
		Icon: Users,
		title: 'Especialistas en derecho de familia',
		description:
			'Divorcios, custodias y liquidaciones de gananciales son nuestro día a día: conocemos los juzgados de Lucena, Córdoba y Málaga y la práctica real de estos procedimientos.',
	},
	{
		Icon: Handshake,
		title: 'Buscamos primero el acuerdo',
		description:
			'Una liquidación pactada es más rápida y barata que un pleito. Intentamos siempre el acuerdo, y solo acudimos al juzgado cuando es necesario.',
	},
	{
		Icon: ShieldCheck,
		title: 'Discreción y presupuesto cerrado',
		description:
			'Tratamos los asuntos familiares con total confidencialidad. Te damos un presupuesto cerrado y la primera consulta es gratuita.',
	},
];

const rangos = [
	{
		title: 'Estudio del patrimonio',
		value: '2 — 4 semanas',
		note: 'Recopilación y análisis de bienes, deudas y documentación',
	},
	{
		title: 'Inventario y valoración',
		value: '1 — 3 meses',
		note: 'Según la complejidad del patrimonio y las tasaciones necesarias',
	},
	{
		title: 'Adjudicación y escritura',
		value: '3 — 6 meses',
		note: 'Con acuerdo de las partes y liquidación de cargas',
	},
	{
		title: 'Liquidación judicial',
		value: '12 — 24 meses',
		note: 'Procedimiento del art. 810 LEC si no hay acuerdo',
	},
];
---

<CustomLayout
	title="Abogado de Liquidación de Gananciales en Lucena"
	description="Abogado de liquidación de gananciales en Lucena, Córdoba y Málaga: inventario, adjudicación de bienes y reparto tras el divorcio. Consulta gratuita: 666 329 155."
	keywords="abogado liquidación de gananciales Lucena, liquidación de sociedad de gananciales, inventario ganancial, adjudicación de bienes divorcio, cuaderno particional, capitulaciones matrimoniales, abogado familia Córdoba, abogado divorcios Málaga"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Liquidación de Gananciales', url: '/liquidacion-gananciales/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/liquidacion-gananciales/#service`,
			serviceType: 'Derecho de Familia - Liquidación de gananciales',
			name: 'Liquidación de la sociedad de gananciales',
			description:
				'Inventario, valoración y reparto de la sociedad de gananciales tras divorcio o separación en Lucena, Córdoba y Málaga.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Abogado especialista en liquidación de la sociedad de gananciales en Lucena, Córdoba y Málaga"
		supertitle="Derecho de Familia · Sociedad de gananciales"
		description="Tras el divorcio o la separación, el reparto de la vivienda, las cuentas y las deudas es una de las partes más conflictivas. Te ayudamos a liquidar con orden y sin perder patrimonio."
		stats={heroStats}
	>
		<span slot="title">Abogado de liquidación de gananciales en Lucena.</span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'Liquidar los gananciales <span class="text-primary">sin conflicto innecesario</span>.'}
		factboxSupertitle="Claves de la liquidación"
		factboxTitle="Lo que debes saber"
		factboxItems={plazos}
	>
		<p class="mb-4">
			Cuando termina un matrimonio o una convivencia bajo régimen de gananciales, los bienes
			comunes no se reparten solos: hay que <strong>disolver la sociedad</strong> y, después,
			<strong>liquidarla</strong>. Esto significa hacer un inventario completo de lo que es
			ganancial y de lo que es privativo, valorar los bienes y las deudas, y adjudicar a cada
			parte lo que le corresponde. Es un proceso con muchas decisiones: qué entra y qué no en
			el reparto, cómo se valora la vivienda, qué ocurre con la hipoteca, qué pasa si uno de
			los dos oculta bienes.
		</p>
		<p class="mb-4">
			En Scruz Abogados llevamos liquidaciones de gananciales en Lucena, Córdoba y Málaga:
			preparamos el inventario con rigor, coordinamos las valoraciones, negociamos el reparto
			y, cuando no hay acuerdo, defendemos tu posición en el procedimiento judicial de
			liquidación. Nuestro objetivo es cerrar esta etapa con un reparto justo y con el menor
			desgaste posible.
		</p>
		<p>
			Cada caso es distinto: una vivienda con hipoteca, un negocio familiar, una cuenta
			conjunta, una herencia recibida durante el matrimonio... Analizamos tu situación en la
			primera consulta gratuita y te decimos con transparencia qué te corresponde y por qué.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué tramitamos"
		title="Servicios de liquidación de gananciales"
		description="Cobertura completa del proceso: disolución, inventario, valoración, acuerdo o vía judicial, e inscripción de los bienes."
		items={conceptos}
	/>

	<EditorialMeasures
		supertitle="Tiempos orientativos"
		title="Plazos según la vía elegida"
		description="Estimación realista de los tiempos según el tipo de patrimonio y si hay acuerdo. La confirmación exacta se realiza tras la consulta inicial."
		valueFormat="single-currency"
		noteLabel="Plazo orientativo."
		disclaimer="Tiempos aproximados. La duración real depende de la complejidad del patrimonio, la carga de los juzgados y la actitud de la otra parte."
		items={rangos}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="Cómo liquidamos tu sociedad de gananciales"
		items={pasos}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Un reparto justo, sin dejar nada atrás."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Resolvemos tus dudas"
		description="Las preguntas más habituales sobre la disolución y liquidación de la sociedad de gananciales."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Estamos a tu lado"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Tráenos la documentación del patrimonio común y te explicamos las opciones, los plazos y los costes. Si decides no continuar, no pagas nada."
		relatedLinks={[
			{ label: 'Divorcios y separaciones', href: '/divorcios-separaciones/' },
			{ label: 'Guarda y custodia', href: '/guarda-custodia/' },
			{ label: 'Herencias y testamentos', href: '/herencias-testamentos/' },
		]}
	/>
</CustomLayout>