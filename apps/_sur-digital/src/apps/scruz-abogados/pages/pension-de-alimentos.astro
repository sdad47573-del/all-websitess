---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Derecho de familia', href: '/divorcios-separaciones' },
	{ label: 'Pensión de alimentos', href: '/pension-de-alimentos' },
];

const highlights = [
	'Revisión de la situación económica y las necesidades básicas',
	'Análisis de la capacidad económica y de la cantidad reclamada',
	'Opciones de acuerdo, negociación o procedimiento familiar',
];

const sections = [
	{
		title: 'Asesoría sobre pensiones de alimentos',
		content: 'La pensión de alimentos puede solicitarse, fijarse, modificarse o reclamarse dentro de una separación, divorcio u otra situación familiar. El debate suele centrarse en las necesidades del beneficiario y en la situación económica de cada parte.',
		points: [
			'Necesidades de la persona beneficiaria y de los menores.',
			'Capacidad económica, ingresos y gastos acreditables.',
			'Acuerdos anteriores, sentencias y pagos realizados.',
			'Fijación, modificación o reclamación de cantidades.',
		],
	},
	{
		title: 'Cómo se determina la cantidad',
		content: 'La cantidad debe responder a las necesidades y a la capacidad económica. No basta con aplicar un porcentaje sin conocer la situación. Las nóminas, los extractos, los contratos, las sentencias y los justificantes de gastos ayudan a sustentar la petición.',
	},
	{
		title: 'Acuerdo y procedimiento',
		content: 'Si existe acuerdo entre las partes, puede formalizarse con las medidas adecuadas. Cuando hay desacuerdo, debe estudiarse el procedimiento correspondiente y la documentación necesaria. La estrategia debe priorizar las necesidades del menor o de la persona beneficiaria y la capacidad de la parte obligada.',
	},
	{
		title: 'Incumplimiento y reclamación',
		content: 'El impago o el incumplimiento de un acuerdo puede requerir una reclamación, una investigación sobre bienes o una actuación judicial. Antes de actuar conviene conocer las cantidades pendientes, los pagos realizados y la situación actual de la obligación.',
	},
	{
		title: 'Cómo se calcula la pensión de alimentos: qué valoran los tribunales',
		content: 'No existe una tabla que fije la cantidad: se ponderan las necesidades del beneficiario, sus gastos ordinarios y extraordinarios, y la capacidad económica de quien la paga. También influyen el tiempo de estancia con cada progenitor, las cargas familiares y otros deberes de alimentos. El resultado se explica con documentos, no con porcentajes sueltos.',
		points: [
			'Gastos ordinarios: vivienda, comida, ropa, colegio y salud.',
			'Gastos extraordinarios: sanitarios, actividades o refuerzo escolar.',
			'Capacidad económica: nóminas, actividad y patrimonio.',
			'Tiempo de convivencia y otras cargas familiares.',
		],
	},
	{
		title: 'Qué hacer si el progenitor no paga: reclamación y ejecución',
		content: 'El impago no se resuelve con reclamaciones verbales: conviene dejar constancia de las cantidades pendientes y del título que las impone. Desde ahí puede exigirse el cumplimiento, interesar la ejecución y, si es necesario, investigar bienes y rentas para localizar de dónde responder. Cuanto antes se ordene el historial de pagos, más sencillo resulta reclamar.',
		points: [
			'Reunir los justificantes de los pagos hechos y de los omitidos.',
			'Requerimiento formal antes de plantear cualquier ejecución.',
			'Ejecución de la resolución que fija la pensión.',
			'Investigación de bienes cuando no hay respuesta.',
		],
	},
	{
		title: 'Modificar la pensión cuando cambian los ingresos o las necesidades',
		content: 'La pensión no es definitiva: puede revisarse si se alteran de forma relevante los ingresos, la situación laboral, las necesidades del menor o el reparto de tiempos. La revisión se pide con prueba del cambio, no con la simple afirmación de que la situación ha variado. Si hay acuerdo, se documenta; si no lo hay, se plantea el procedimiento que corresponda.',
		points: [
			'Cambios relevantes y sobrevenidos, no simples ajustes.',
			'Prueba del cambio: laboral, económico o familiar.',
			'Revisión por acuerdo o por procedimiento judicial.',
			'Desde cuándo se aplica la nueva cantidad.',
		],
	},
];

const faqs = [
	{
		question: '¿Cómo se calcula la pensión de alimentos?',
		answer: 'La cantidad depende de las necesidades acreditadas, la capacidad económica de las partes y las circunstancias del caso. Un porcentaje orientativo no sustituye el estudio de la situación real.',
	},
	{
		question: '¿Puede reclamarse aunque haya un acuerdo?',
		answer: 'Sí, si el acuerdo no se cumple o las circunstancias han cambiado. Debe revisarse el título, los pagos realizados y la vía adecuada para solicitar el cumplimiento o la modificación.',
	},
	{
		question: '¿Qué pruebas económicas se necesitan?',
		answer: 'Ayuda reunir nóminas, extractos bancarios, contratos, facturas, informes y decisiones judiciales anteriores. La documentación debe estar relacionada con la situación económica actual.',
	},
	{
		question: '¿Se puede pedir una revisión de la cantidad?',
		answer: 'Puede estudiarse cuando existe un cambio relevante en las necesidades, los ingresos o los gastos. La forma de solicitarlo depende de la sentencia o acuerdo que se esté aplicando.',
	},
	{
		question: '¿Se pueden reclamar los atrasos de la pensión de alimentos?',
		answer: 'Las cantidades vencidas y no pagadas no desaparecen solas, pero su reclamación tiene un cómputo propio en el tiempo. Conviene reconstruir el historial con transferencias, recibos y comunicaciones para fijar lo pendiente antes de reclamar. Cada caso se revisa con la documentación completa.',
	},
];

const related = [
	{ label: 'Divorcios y separaciones', href: '/divorcios-separaciones', description: 'Proceso de separación y divorcio.' },
	{ label: 'Pensión de alimentos', href: '/blog/pension-de-alimentos', description: 'Guía informativa sobre la solicitud y su revisión.' },
	{ label: 'Modificación de medidas', href: '/modificacion-medidas-paterno-filiales', description: 'Cambios de custodia, visitas y alimentos.' },
];
---

<SeoLegalPage
	title="Abogado de Pensión de Alimentos en Córdoba y Lucena"
	description="Fijar, modificar o reclamar la pensión de alimentos: cálculo orientativo, impago y ejecución. Abogado de familia en Lucena y Córdoba: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho de familia"
	headline="Pensión de alimentos: fijación y reclamaciones"
	intro="La pensión de alimentos requiere estudiar las necesidades, la capacidad económica y las circunstancias de cada parte. Te ayudamos a organizar la documentación y valorar una solución adecuada."
	highlights={highlights}
	serviceType="Asesoría en pensiones de alimentos"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
	guides={['medidas-paterno-filiales', 'custodia-compartida-cordoba', 'regimen-de-visitas']}
/>
