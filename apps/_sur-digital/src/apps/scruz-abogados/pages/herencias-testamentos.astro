---
import heroImg from '../@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	Calculator,
	Clock,
	FileCheck,
	FilePenLine,
	FileText,
	Landmark,
	Percent,
	Scale,
	ShieldCheck,
	Users,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Qué pasa si no hay testamento?',
		answer:
			'Cuando alguien fallece sin testamento, la ley establece un orden de sucesión intestada: primero los hijos, después los padres, el cónyuge y, en última instancia, los hermanos y otros parientes. Para que los herederos puedan aceptar la herencia es preciso tramitar la declaración de herederos abintestato ante notario. Te acompañamos en todo el proceso.',
	},
	{
		question: '¿Puedo renunciar a una herencia con deudas?',
		answer:
			'Sí. Si la herencia tiene más deudas que bienes, puedes repudiarla siempre que no la hayas aceptado de forma expresa o tácita. La repudiación debe ser formal ante notario y beneficia a quienes habrían heredado en tu lugar. Te asesoramos sobre los plazos y la conveniencia de aceptar a beneficio de inventario.',
	},
	{
		question: '¿Cuándo hay que pagar el impuesto de sucesiones?',
		answer:
			'El plazo es de 6 meses desde el fallecimiento, con posibilidad de prórroga de 6 meses más si se solicita en los 5 primeros. Andalucía aplica bonificaciones del 99% para los grupos I y II (descendientes y cónyuge, ascendientes), que en la práctica dejan el impuesto en una cuantía simbólica para los herederos más cercanos. Te ayudamos a optimizar la tributación.',
	},
	{
		question: '¿Qué es la legítima?',
		answer:
			'La legítima es la parte de la herencia que la ley reserva forzosamente a determinados herederos (descendientes, ascendientes y cónyuge). En Andalucía se calcula sobre el tercio de legítima estricta y el tercio de mejora, dejando el tercio de libre disposición a la voluntad del testador. Te asesoramos sobre cómo testar sin perjudicar a los legitimarios.',
	},
	{
		question: '¿Se puede deshacer una donación en vida?',
		answer:
			'En ciertos supuestos sí: por incumplimiento de condiciones, por ingratitud del donatario, por superveniencia de hijos o, en caso de donaciones acumuladas, cuando superan la parte disponible. Estudiamos tu situación y, si es viable, te ayudamos a revertir la donación.',
	},
	{
		question: '¿Cómo se reparte la herencia si hay varios herederos?',
		answer:
			'Si hay testamento, se respeta su contenido siempre que respete las legítimas. Si no, se reparte conforme a los tramos legales. Cuando hay desacuerdo entre los coherederos, redactamos el cuaderno particional y, en última instancia, instamos la división judicial de la herencia (judicial partition).',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: Landmark, label: 'Tramitación', value: 'Integral' },
	{ Icon: Calculator, label: 'Fiscalidad', value: 'Optimizada' },
	{ Icon: Clock, label: 'Plazo fiscal', value: '6 meses' },
];

const plazos = [
	{
		Icon: Clock,
		title: '6 meses',
		description: 'Plazo para liquidar el impuesto de sucesiones (prorrogable 6 meses más).',
	},
	{
		Icon: FileCheck,
		title: '15 días',
		description: 'Para solicitar la prórroga y la primera declaración ante Hacienda.',
	},
	{
		Icon: Scale,
		title: 'Cuaderno particional',
		description: 'Documento privado o notarial que reparte los bienes entre herederos.',
	},
];

const conceptos = [
	{
		Icon: FilePenLine,
		title: 'Redacción de testamentos',
		description:
			'Testamento abierto notarial con cláusulas a medida: designaciones, legados, mejoras y cláusulas de sustitución para asegurar tu voluntad.',
	},
	{
		Icon: FileText,
		title: 'Declaración de herederos',
		description:
			'Tramitamos la declaración notarial de herederos abintestato cuando no hay testamento: descendientes, ascendientes, cónyuge o colaterales.',
	},
	{
		Icon: Landmark,
		title: 'Liquidación de impuestos',
		description:
			'Liquidación del impuesto de sucesiones y, en su caso, plusvalía municipal, con aplicación de bonificaciones autonómicas y reducciones.',
	},
	{
		Icon: Users,
		title: 'Aceptación y repudiación',
		description:
			'Te asesoramos sobre aceptar o repudiar la herencia, la aceptación a beneficio de inventario y el alcance de tu responsabilidad sobre las deudas del causante.',
	},
	{
		Icon: Percent,
		title: 'Optimización fiscal',
		description:
			'Aplicamos las bonificaciones autonómicas, reducciones por parentesco, vivienda habitual y empresa familiar para minimizar la tributación.',
	},
	{
		Icon: Scale,
		title: 'Conflictos familiares',
		description:
			'Mediación entre coherederos, redacción del cuaderno particional y defensa judicial en caso de desacuerdo o impugnación del testamento.',
	},
];

const pasos = [
	{
		number: '01',
		title: 'Certificados previos',
		description:
			'Solicitamos el certificado de defunción, el de últimas voluntades y el de seguros con cobertura de fallecimiento, paso previo a cualquier actuación.',
	},
	{
		number: '02',
		title: 'Testamento o declaración',
		description:
			'Obtenemos copia autorizada del testamento o, si no existe, tramitamos la declaración de herederos abintestato ante notario.',
	},
	{
		number: '03',
		title: 'Inventario y partición',
		description:
			'Reunimos a los herederos, inventariamos bienes y deudas, valoramos el caudal hereditario y redactamos el cuaderno particional.',
	},
	{
		number: '04',
		title: 'Liquidación e inscripción',
		description:
			'Liquidamos el impuesto de sucesiones y plusvalía y procedemos a la inscripción de los bienes en el Registro de la Propiedad a favor de los herederos.',
	},
];

const why = [
	{
		Icon: ShieldCheck,
		title: 'Acompañamiento integral',
		description:
			'Gestionamos todos los pasos por ti: notario, Hacienda, registros y bancos. No tienes que desplazarte innecesariamente.',
	},
	{
		Icon: Percent,
		title: 'Optimización fiscal',
		description:
			'Aplicamos todas las bonificaciones autonómicas y reducciones para que pagues lo mínimo posible respetando escrupulosamente la ley.',
	},
	{
		Icon: Scale,
		title: 'Mediación familiar',
		description:
			'Cuando hay tensiones familiares, mediamos para alcanzar acuerdos duraderos. Solo acudimos a la vía judicial cuando es estrictamente necesario.',
	},
];

const rangos = [
	{ title: 'Testamento simple', value: '1 — 2 semanas', note: 'Redacción y firma ante notario' },
	{ title: 'Declaración de herederos', value: '1 — 3 meses', note: 'Abintestato, con publicación en BOE' },
	{ title: 'Aceptación y liquidación', value: '3 — 6 meses', note: 'Desde la obtención del testamento' },
	{ title: 'Adjudicación de bienes', value: '6 — 12 meses', note: 'Inscripción en Registro de la Propiedad' },
];
---

<CustomLayout
	title="Abogado de Testamentos y Herencias en Lucena"
	description="Herencias con o sin testamento, declaración de herederos e impuesto de sucesiones en Andalucía. Primera consulta gratuita: 666 329 155."
	keywords="abogado herencias Lucena, testamento Córdoba, declaración herederos Málaga, impuesto sucesiones Andalucía, cuaderno particional, abogado sucesiones"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Herencias y Testamentos', url: '/herencias-testamentos/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/herencias-testamentos/#service`,
			serviceType: 'Derecho Sucesorio',
			name: 'Herencias y testamentos',
			description:
				'Gestión integral de herencias, redacción de testamentos, aceptación y adjudicación de bienes.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Abogados especialistas en herencias, testamentos y derecho sucesorio en Lucena, Córdoba y Málaga"
		supertitle="Derecho Sucesorio · Herencias y testamentos"
		description="Gestión integral de herencias y redacción de testamentos con la máxima seguridad jurídica. Optimización fiscal y mediación familiar."
		stats={heroStats}
	>
		<span slot="title">Abogado de testamentos, herencias y sucesiones en Lucena.</span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'Gestionamos herencias y redactamos testamentos <span class="text-primary">sin complicaciones</span>.'}
		factboxSupertitle="Plazos clave"
		factboxTitle="No dejes pasar los plazos"
		factboxItems={plazos}
	>
		<p class="mb-4">
			Gestionar una herencia o redactar un testamento es un proceso legalmente complejo y,
			a menudo, emocionalmente delicado. Te acompañamos en cada paso: aceptación de la
			herencia, declaración de herederos, liquidación de impuestos, adjudicación de bienes
			e inscripción en el Registro de la Propiedad, evitando conflictos familiares y
			asegurando que se cumpla la voluntad del fallecido.
		</p>
		<p class="mb-4">
			También redactamos tu testamento con la máxima seguridad jurídica: cláusulas
			a medida, designaciones, legados, mejoras y protección de la legítima. Un testamento
			bien hecho previene litigios entre herederos, optimiza la fiscalidad y garantiza el
			futuro de tus seres queridos con un documento claro y sólido. Para preparar la
			conversación, en el blog del despacho tienes guías prácticas: el
			<a href="/scruz-abogados/blog/impuesto-sucesiones-andalucia/" class="link link-primary">impuesto de sucesiones en Andalucía</a>
			con sus bonificaciones, el
			<a href="/scruz-abogados/blog/herencia-sin-testamento/" class="link link-primary">reparto cuando no hay testamento</a>,
			las herencias <a href="/scruz-abogados/blog/herencias-entre-hermanos/" class="link link-primary">entre hermanos</a> y el
			<a href="/scruz-abogados/blog/testamento-online-cordoba/" class="link link-primary">testamento ante notario en Córdoba</a>. Si ya sabes que quieres otorgarlo, el <a href="/scruz-abogados/testamentos-cordoba/" class="link link-primary">servicio de testamentos en Córdoba</a> explica cómo preparamos el borrador y te acompañamos a la notaría.
		</p>
		<p>
			Y si ya hay una herencia abierta, dos calculadoras con la norma al lado: el
			<a href="/scruz-abogados/reparto-herencia/" class="link link-primary">reparto y la legítima</a>
			según haya hijos o no, y el
			<a href="/scruz-abogados/impuestos-herencia/" class="link link-primary">plazo y las bonificaciones del ITPF</a>.
		</p>
		<p>
			Cuando hay tensiones familiares, mediamos entre los coherederos para alcanzar
			acuerdos duraderos que eviten litigios costosos. Solo acudimos a la vía judicial
			cuando la mediación fracasa y es estrictamente necesario. Tu legado, en las
			mejores manos.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué tramitamos"
		title="Servicios de derecho sucesorio"
		description="Cobertura completa del proceso hereditario: redacción de testamentos, declaraciones, liquidación fiscal y adjudicación de bienes."
		items={conceptos}
	/>

	<EditorialMeasures
		supertitle="Tiempos orientativos"
		title="Plazos del proceso sucesorio"
		description="Estimación realista de los plazos que maneja la administración y los registros. La confirmación exacta se realiza tras la consulta inicial."
		valueFormat="single-currency"
		noteLabel="Plazo orientativo."
		disclaimer="Tiempos aproximados. La duración real depende de la complejidad del caudal hereditario, el número de herederos y la carga de los organismos involucrados."
		items={rangos}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="El proceso sucesorio, paso a paso"
		items={pasos}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Tu herencia, gestionada con rigor."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Resolvemos tus dudas"
		description="Las preguntas más habituales sobre herencias, testamentos, impuestos y adjudicación de bienes."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Estamos a tu lado"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Te informamos de las opciones, los plazos y los costes. Si decides no continuar, no pagas nada."
		relatedLinks={[
			{ label: 'Herencias entre hermanos: guía', href: '/blog/herencias-entre-hermanos/' },
			{ label: 'Impuesto de sucesiones: guía', href: '/blog/impuesto-sucesiones-andalucia/' },
			{ label: 'Testamento online: guía', href: '/blog/testamento-online-cordoba/' },
			{ label: 'Herencia sin testamento: guía', href: '/blog/herencia-sin-testamento/' },
		]}
	/>
</CustomLayout>
