---
import heroImg from '@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	Activity,
	Clock,
	FileCheck,
	Heart,
	Scale,
	ShieldCheck,
	Stethoscope,
	Users,
	Wallet,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Qué enfermedades dan derecho a la incapacidad permanente?',
		answer:
			'Cualquier enfermedad o lesión que limite la capacidad del trabajador para ejercer su profesión habitual o cualquier actividad profesional puede dar derecho a una incapacidad permanente. Las más frecuentes son las dolencias musculoesqueléticas, las cardiopatías, las enfermedades mentales (depresión, ansiedad, burnout), las respiratorias crónicas y las secuelas neurológicas. Evaluamos tu caso concreto con un perito médico antes de iniciar la solicitud.',
	},
	{
		question: '¿Cuáles son los grados de incapacidad permanente?',
		answer:
			'La Ley distingue cuatro grados: parcial (disminución >33% del rendimiento en tu profesión sin impedir tareas fundamentales), total (inhabilita para tu profesión habitual pero puedes dedicarte a otra), absoluta (inhabilita para cualquier profesión u oficio) y gran invalidez (necesitas ayuda de tercera persona para actos esenciales de la vida). Cada grado llevaba asociada una prestación económica diferente.',
	},
	{
		question: '¿Cuánto se cobra según el grado de incapacidad?',
		answer:
			'El importe depende de la base reguladora y del porcentaje aplicable: parcial 24 mensualidades ordinarias, total 55% de la base, absoluta 100% y gran invalidez 100% más un complemento destinado a remunerar a la persona que asiste al pensionista. Te calculamos exactamente lo que te corresponde tras el estudio de tu caso.',
	},
	{
		question: '¿Puedo trabajar mientras cobro una incapacidad?',
		answer:
			'En la parcial y la total compatibles (esta última requiere >55 años) puedes compatibilizar la pensión con un trabajo adecuado a tus limitaciones. La absoluta y gran invalidez son incompatibles con cualquier actividad profesional retribuida. Te asesoramos sobre las compatibilidades y, en su caso, las posibilidades de revisión.',
	},
	{
		question: '¿Qué hago si el tribunal médico me da el alta?',
		answer:
			'Si el Equipo de Valoración de Incapacidades (EVI) emite un alta tras la revisión, tienes un plazo de 30 días naturales para presentar reclamación previa ante la Dirección Provincial del INSS. Si la resolución sigue siendo desfavorable, puedes demandar ante el Juzgado de lo Social en 30 días. Te acompañamos en todo el proceso y no te dejamos solo ante el tribunal médico.',
	},
	{
		question: '¿Me pueden quitar la pensión por revisión?',
		answer:
			'Sí, el INSS puede revisar la incapacidad cada 2 años o cuando haya indicios de mejoría. Es fundamental aportar nuevos informes médicos que mantengan acreditada la gravedad o aportar documentación que justifique el empeoramiento. Estudiamos cada revisión y, si procede, defendemos el mantenimiento de la pensión.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: Stethoscope, label: 'Grados', value: 'Parcial · Total · Absoluta' },
	{ Icon: ShieldCheck, label: 'Recurso', value: 'Sin coste inicial' },
	{ Icon: Wallet, label: 'Pago', value: 'Mensual garantizado' },
];

const plazos = [
	{
		Icon: Clock,
		title: '30 días',
		description: 'Para reclamar tras la resolución desfavorable del Equipo de Valoración (EVI).',
	},
	{
		Icon: FileCheck,
		title: '3 meses',
		description: 'Estimación del tiempo de resolución por el INSS tras la solicitud.',
	},
	{
		Icon: Scale,
		title: 'Demanda social',
		description: 'Última instancia ante el Juzgado de lo Social con sentencia firme.',
	},
];

const conceptos = [
	{
		Icon: Activity,
		title: 'Cuadro clínico acreditado',
		description:
			'Documentamos tu enfermedad o secuelas con informes médicos, pruebas diagnósticas y, cuando es necesario, peritaciones externas para reforzar el expediente.',
	},
	{
		Icon: Heart,
		title: 'Incapacidad total',
		description:
			'Inhabilita para tu profesión habitual pero permite otra actividad. Prestación equivalente al 55% de la base reguladora.',
	},
	{
		Icon: ShieldCheck,
		title: 'Incapacidad absoluta',
		description:
			'Inhabilita para cualquier profesión u oficio. Prestación equivalente al 100% de la base reguladora y cobertura de toda la vida.',
	},
	{
		Icon: Users,
		title: 'Gran invalidez',
		description:
			'Incapacidad absoluta más la necesidad de asistencia de otra persona para actos esenciales de la vida. Incremento del 45% sobre la pension absoluta.',
	},
	{
		Icon: Stethoscope,
		title: 'Baja médica prolongada',
		description:
			'Trabajamos con tu médico de cabecera y los especialistas para documentar correctamente la baja hasta el momento de la solicitud de incapacidad permanente.',
	},
	{
		Icon: Scale,
		title: 'Revisión y mantenimiento',
		description:
			'Defendemos tu pensión cuando el INSS intenta revisarla por mejoría: aportamos pruebas médicas actualizadas que acreditan la persistencia de las limitaciones.',
	},
];

const pasos = [
	{
		number: '01',
		title: 'Estudio del caso',
		description:
			'Analizamos tu historial clínico, profesión y situación laboral. Decidimos contigo si es viable solicitar la incapacidad y qué grado es alcanzable.',
	},
	{
		number: '02',
		title: 'Solicitud y tribunal médico',
		description:
			'Preparamos la solicitud con toda la documentación médica y laboral. Te acompañamos al reconocimiento del Equipo de Valoración de Incapacidades.',
	},
	{
		number: '03',
		title: 'Resolución y reclamación',
		description:
			'Si el INSS concede la incapacidad, calculamos la cuantía exacta. Si la deniega, presentamos reclamación previa en el plazo de 30 días.',
	},
	{
		number: '04',
		title: 'Demanda judicial',
		description:
			'Si la reclamación previa no prospera, presentamos demanda ante el Juzgado de lo Social con todo el soporte médico y pericial para conseguir la pensión.',
	},
];

const why = [
	{
		Icon: Stethoscope,
		title: 'Peritos médicos colaboradores',
		description:
			'Trabajamos con un equipo de peritos especialistas que elaboran informes rigurosos para acreditar tus limitaciones funcionales.',
	},
	{
		Icon: ShieldCheck,
		title: 'Evaluación realista',
		description:
			'Antes de iniciar el proceso, te informamos sobre las posibilidades reales de obtener el grado solicitado. Solo seguimos adelante si vemos opciones.',
	},
	{
		Icon: Scale,
		title: 'Experiencia en lo social',
		description:
			'Más de 20 años litigando en Juzgados de lo Social de Lucena, Córdoba y Málaga. Conocemos a los equipos de valoración y los criterios de los tribunales.',
	},
];

const rangos = [
	{ title: 'Incapacidad parcial', value: '24 mensualidades', note: 'Pago único, base reguladora' },
	{ title: 'Incapacidad total', value: '55% base', note: 'Compatible con otro trabajo a partir de 55 años' },
	{ title: 'Incapacidad absoluta', value: '100% base', note: 'Incompatible con trabajo retribuido' },
	{ title: 'Gran invalidez', value: '100% + 45%', note: 'Para asistencia de tercera persona' },
];
---

<CustomLayout
	title="Abogado de Incapacidad Permanente en Lucena | Scruz Abogados"
	description="Abogado de incapacidad permanente en Lucena, Córdoba y Málaga: solicitamos y reclamamos tu pensión ante el INSS. Consulta gratuita: 666 329 155."
	keywords="abogado incapacidad permanente Lucena, pensión invalidez Córdoba, incapacidad total Málaga, INSS, tribunales médicos, pensión absoluta"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Incapacidad Permanente', url: '/incapacidad-permanente/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/incapacidad-permanente/#service`,
			serviceType: 'Seguridad Social',
			name: 'Solicitud y reclamación de incapacidad permanente',
			description:
				'Solicitamos la pensión de incapacidad permanente (total, absoluta, Gran Invalidez) y reclamamos frente a las negativas del INSS.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Abogado especializado en incapacidad permanente en Lucena, Córdoba y Málaga"
		supertitle="Seguridad Social · Incapacidad permanente"
		description="Solicitamos y reclamamos tu pensión de incapacidad permanente. Defensa frente a las negativas del INSS en Andalucía."
		stats={heroStats}
	>
		<span slot="title">Abogado de incapacidad permanente en Lucena: <span class="text-primary">consigue tu pensión.</span></span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'Tu pensión de incapacidad permanente, <span class="text-primary">con la fuerza de un buen caso</span>.'}
		factboxSupertitle="Plazos clave"
		factboxTitle="No dejes pasar los plazos"
		factboxItems={plazos}
	>
		<p class="mb-4">
			Si una enfermedad o lesión te impide trabajar, tienes derecho a una pensión. Pero
			el proceso ante el INSS puede ser arduo y lleno de negativas. Nosotros
			presentamos y defendemos tu solicitud con todos los informes médicos y argumentos
			legales necesarios para demostrar tu incapacidad y conseguir la máxima prestación
			posible.
		</p>
		<p class="mb-4">
			Trabajamos con peritos médicos colaboradores y construimos un informe detallado
			que acredita tus limitaciones funcionales. Te acompañamos al reconocimiento del
			Equipo de Valoración de Incapacidades y, si la resolución es desfavorable,
			reclamamos en vía administrativa y, en última instancia, llevamos el caso al
			Juzgado de lo Social.
		</p>
		<p>
			Y lo más importante: solo cobramos si obtenemos una pensión o reconocimiento
			significativo. Antes de iniciar el proceso, te informamos del grado alcanzable y
			de la cuantía esperable, para que tomes decisiones con información completa.
			Centra tus energías en tu salud; nosotros nos ocupamos de lo legal.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué tramitamos"
		title="Servicios de incapacidad"
		description="Cobertura completa del proceso de solicitud, reclamación y defensa de pensiones por incapacidad permanente."
		items={conceptos}
	/>

	<EditorialMeasures
		supertitle="Cifras orientativas"
		title="Grados y cuantías"
		description="Una visión rápida de los cuatro grados de incapacidad y las prestaciones económicas que corresponden a cada uno."
		valueFormat="single-currency"
		noteLabel="Cifras indicativas."
		disclaimer="Cifras y porcentajes orientativos. La cuantía exacta depende de tu base reguladora, edad y otras circunstancias personales — calculamos tu caso en una cita personalizada."
		items={rangos}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="De la solicitud a la pensión"
		items={pasos}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Tu pensión, en manos expertas."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Resolvemos tus dudas"
		description="Las preguntas más habituales sobre incapacidad permanente, grados, cuantías y tribunales médicos."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Estamos a tu lado"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Te informamos de las opciones, los plazos y los planes de viabilidad. Si decides no reclamar, no pagas nada."
		relatedLinks={[
			{ label: 'Novedades pensiones 2027: guía', href: '/blog/novedades-pensiones-2027/' },
			{ label: 'Incapacidad permanente: guía', href: '/blog/incapacidad-permanente/' },
			{ label: 'Reforma discapacidad y dependencia', href: '/blog/reforma-discapacidad-dependencia/' },
			{ label: 'Accidente laboral', href: '/accidente-laboral/' },
		]}
	/>
</CustomLayout>
