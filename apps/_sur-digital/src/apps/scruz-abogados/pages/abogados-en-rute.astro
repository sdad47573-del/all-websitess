---
import heroImg from '../@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	Briefcase,
	Building2,
	Car,
	Clock,
	Heart,
	Landmark,
	MapPin,
	Phone,
	Scale,
	ShieldCheck,
	Users,
	Video,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Dónde estáis? ¿Hay que desplazarse a Lucena?',
		answer:
			'Nuestra oficina está en Lucena (Calle El Agua, 19, 1º Izquierda), a unos 15 minutos de Rute. En Rute te atendemos con cita previa, desplazándonos al municipio cuando el asunto lo requiere, o por videollamada para la mayoría de consultas. La primera consulta es gratuita, presencial u online.',
	},
	{
		question: '¿Qué juzgados me corresponden viviendo en Rute?',
		answer:
			'Rute pertenece al partido judicial de Lucena, así que la mayoría de los asuntos civiles, de familia, penales y de tráfico se tramitan en los juzgados de Lucena, donde está nuestra oficina. Es una ventaja práctica: conocemos los juzgados y los procedimientos de la comarca.',
	},
	{
		question: '¿Atendéis a agricultores y ganaderos de Rute?',
		answer:
			'Sí, es una parte importante de nuestro trabajo. Llevamos reclamaciones de seguros agrarios por pedrisco, helada o sequía, así como asuntos de contratos, impagos y sucesiones de explotaciones. Si tu cosecha o tu ganadería ha sufrido un siniestro, conviene revisar la póliza y la peritación cuanto antes.',
	},
	{
		question: '¿La primera consulta es gratuita?',
		answer:
			'Sí. La primera consulta es gratuita y confidencial, presencial en Lucena, desplazándonos a Rute con cita previa o por videollamada. Te explicamos las opciones reales, los plazos y un presupuesto cerrado. Si decides no continuar, no pagas nada.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: MapPin, label: 'Oficina', value: 'Lucena · a 15 min' },
	{ Icon: Clock, label: 'Cita en Rute', value: 'Con desplazamiento' },
	{ Icon: Phone, label: 'Urgencias', value: '24 h' },
];

const oficina = [
	{
		Icon: MapPin,
		title: 'Calle El Agua, 19, 1º Izq. (Lucena)',
		description: 'A unos 15 minutos de Rute. También nos desplazamos a Rute con cita previa.',
	},
	{
		Icon: Clock,
		title: 'Lunes a viernes, 9:00 – 18:00',
		description: 'Y urgencias fuera de horario por teléfono y WhatsApp.',
	},
	{
		Icon: Phone,
		title: '666 329 155 · 957 118 195',
		description: 'También en info@scruzabogados.es y por WhatsApp.',
	},
	{
		Icon: Video,
		title: 'Consultas online',
		description: 'Videollamada para Rute y para toda la provincia de Córdoba.',
	},
];

const areas = [
	{
		Icon: Heart,
		title: 'Familia: divorcios y custodia',
		description: 'Divorcios de mutuo acuerdo y contenciosos, custodias, pensiones y medidas paterno-filiales.',
		href: '/divorcios-separaciones/',
	},
	{
		Icon: Scale,
		title: 'Derecho civil y contratos',
		description: 'Contratos, responsabilidad civil, consumo, seguros y reclamaciones de cantidad.',
		href: '/derecho-civil/',
	},
	{
		Icon: Landmark,
		title: 'Herencias y testamentos',
		description: 'Herencia sin testamento, testamentos, particiones e impuesto de sucesiones.',
		href: '/herencias-testamentos/',
	},
	{
		Icon: Briefcase,
		title: 'Laboral: despidos e incapacidades',
		description: 'Despidos, accidentes de trabajo, incapacidad permanente y pensiones.',
		href: '/despidos/',
	},
	{
		Icon: Car,
		title: 'Seguros agrarios y accidentes',
		description: 'Reclamaciones por siniestros agrarios (pedrisco, helada, sequía) e indemnizaciones de tráfico.',
		href: '/seguros-agrarios/',
	},
	{
		Icon: ShieldCheck,
		title: 'Recursos y sanciones',
		description: 'Recursos administrativos y defensa frente a sanciones de la Administración.',
		href: '/recursos-administrativos/',
	},
];

const why = [
	{
		Icon: Users,
		title: 'Un despacho de la comarca',
		description:
			'Conoces al abogado que lleva tu asunto desde el primer día. Sin intermediarios y con atención personal, en Lucena o desplazándonos a Rute.',
	},
	{
		Icon: Building2,
		title: 'Más de 20 años en la zona',
		description:
			'Trayectoria consolidada ayudando a familias, agricultores, autónomos y empresas de Rute, Lucena y toda la Subbética.',
	},
	{
		Icon: ShieldCheck,
		title: 'Primera consulta gratuita',
		description:
			'Te informamos de las opciones reales y del presupuesto cerrado antes de empezar. Transparencia desde el primer contacto.',
	},
];
---

<CustomLayout
	title="Abogado en Rute (Córdoba) | Sergio Cruz Chacón"
	description="Abogado en Rute (Córdoba): Sergio Cruz Chacón, con oficina en Lucena a 15 minutos, atiende en Rute con cita previa. Primera consulta gratuita: 666 329 155."
	keywords="abogado en rute, abogados en rute córdoba, abogado partido judicial lucena, asesoría jurídica rute, despacho abogados subbética, Scruz Abogados"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Abogados en Rute', url: '/abogados-en-rute/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/abogados-en-rute/#service`,
			serviceType: 'Despacho de abogados',
			name: 'Abogado en Rute',
			description:
				'Despacho jurídico con oficina en Lucena que atiende a clientes de Rute (Córdoba) con cita previa, desplazamiento y consultas online.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Rute', 'Lucena', 'Subbética', 'Córdoba'],
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'Calle El Agua, 19, 1º Izq.',
				addressLocality: 'Lucena',
				addressRegion: 'Córdoba',
				postalCode: '14900',
				addressCountry: 'ES',
			},
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Despacho de abogados Scruz Abogados que atiende a clientes de Rute desde su oficina de Lucena, Córdoba"
		supertitle="Atención en Rute · Córdoba"
		description="Abogado con más de 20 años de experiencia atendiendo a clientes de Rute y de toda la Subbética. Atención presencial con cita previa, desplazamiento al municipio y consultas online."
		stats={heroStats}
	>
		<span slot="title">Tu abogado en Rute, <span class="text-primary">a 15 minutos de tu casa.</span></span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Cómo te atendemos en Rute"
		title={'Cercanía real: <span class="text-primary">te atendemos en persona</span>, en Rute o en nuestra oficina de Lucena.'}
		factboxSupertitle="Dónde estamos"
		factboxTitle="Oficina en Lucena"
		factboxItems={oficina}
	>
		<p class="mb-4">
			Nuestro despacho está en la <strong>Calle El Agua, 19, 1º Izquierda, en Lucena</strong>, a
			unos 15 minutos de Rute por la carretera de Cabra. Trabajamos con cita previa: si prefieres
			que nos veamos en Rute, nos desplazamos al municipio cuando el asunto lo requiere, y para la
			mayoría de consultas también te atendemos por videollamada.
		</p>
		<p class="mb-4">
			Rute pertenece al <strong>partido judicial de Lucena</strong>, así que los asuntos civiles,
			de familia, penales y de tráfico se tramitan en los juzgados de Lucena, donde tenemos la
			oficina y conocemos a fondo los procedimientos de la comarca. Eso se nota en rapidez y en
			que nunca pagas desplazamientos innecesarios.
		</p>
		<p>
			Si necesitas orientación sobre qué juzgado te corresponde, qué documentación aportar o qué
			vía es la más adecuada para tu caso, pide cita: la primera consulta es gratuita y
			confidencial.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué hacemos para Rute"
		title="Todas las áreas del Derecho, cerca de tu casa"
		description="Atendemos a particulares, agricultores, ganaderos, autónomos y empresas de Rute en todas las áreas de práctica habituales de la comarca."
		items={areas}
		ctaLabel="Más información"
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos desde Rute"
		title="Un abogado que conoce la Subbética y sus juzgados."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Información práctica para clientes de Rute"
		description="Las dudas más habituales de los vecinos de Rute y de la comarca que nos consultan."
		items={faqEntries}
	/>

	<EditorialCtaFinal
		supertitle="Te esperamos en Rute o en Lucena"
		title={'Pide cita. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial en Lucena, con desplazamiento a Rute, o por videollamada. Te informamos de las opciones, los plazos y los costes antes de empezar."
		relatedLinks={[
			{ label: 'Abogados en Lucena', href: '/abogados-en-lucena/' },
			{ label: 'Abogados en Málaga', href: '/abogados-en-malaga/' },
			{ label: 'Todas las ubicaciones', href: '/ubicaciones/' },
			{ label: 'Servicios jurídicos', href: '/servicios/' },
		]}
	/>
</CustomLayout>