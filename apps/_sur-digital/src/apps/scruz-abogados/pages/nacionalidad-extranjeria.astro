---
import heroImg from '../@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	Award,
	Briefcase,
	Calculator,
	Clock,
	FileText,
	Gavel,
	Landmark,
	Link as LinkIcon,
	Scale,
	ShieldCheck,
	Users,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Cuánto tarda en conseguirse la nacionalidad española por residencia?',
		answer:
			'El plazo legal general es de 10 años de residencia legal, continuada e inmediatamente anterior a la solicitud, aunque se reduce a 1 año para personas de origen iberoamericano, Andorra, Filipinas, Guinea Ecuatorial, Portugal o sefardíes; a 2 años para nacionales de países iberoamericanos, Andorra, Filipinas, Guinea Ecuatorial o Portugal; a 5 años para refugiados y a 2 años para casados con español. Una vez solicitada, el expediente tarda entre 1 y 3 años en resolverse dependiendo de la delegación del gobierno y del volumen acumulado.',
	},
	{
		question: '¿Cuáles son los requisitos para la reagrupación familiar?',
		answer:
			'El residente que solicita la reagrupación debe tener al menos un año de residencia y autorización para trabajar, acreditar medios económicos suficientes y disponer de vivienda adecuada. Los familiares reagrupables son cónyuge o pareja de hecho registrada, hijos menores de 18 años o hijos mayores a cargo incapaces de sostenerse por sí mismos, y ascendientes en línea recta si dependen económicamente del reagrupante. Te asesoramos sobre la documentación y resolvemos posibles requerimientos.',
	},
	{
		question: '¿Qué tipos de autorización de residencia existen?',
		answer:
			'Existen múltiples modalidades: residencia y trabajo por cuenta ajena o propia, residencia por circunstancias excepcionales (arraigo social, laboral, familiar, para víctimas de violencia de género, por razones humanitarias), residencia de larga duración, residencia no lucrativa, residencia para familiares de comunitarios y residencia para inversores. Cada una tiene sus propios requisitos y plazos. Te orientamos sobre la que mejor se adapta a tu situación.',
	},
	{
		question: '¿Y si me deniegan la solicitud?',
		answer:
			'Toda resolución administrativa tiene recurso. Frente a una denegación caben el recurso de reposición administrativo y, posteriormente, la vía contencioso-administrativa ante el Juzgado de lo Contencioso-Administrativo correspondiente. Es fundamental no agotar los plazos y actuar con rapidez. Estudiamos cada resolución, valoramos las posibilidades reales de éxito y, si procede, interponemos el recurso pertinente.',
	},
	{
		question: '¿Necesito abogado para presentar la solicitud?',
		answer:
			'La ley no obliga a estar asistido de abogado para las solicitudes iniciales, pero el asesoramiento profesional multiplica las posibilidades de éxito, evita errores formales y minimiza las contingencias. Además, ante un silencio administrativo o una denegación, contar con un abogado que conozca tu expediente desde el principio es clave para reaccionar a tiempo.',
	},
	{
		question: '¿La asistencia jurídica es gratuita?',
		answer:
			'Para personas con recursos económicos insuficientes, el derecho a la asistencia jurídica gratuita se extiende también a procedimientos administrativos de extranjería. Te ayudamos a solicitarlo ante el Colegio de Abogados correspondiente si cumples los requisitos. Cuando no procede, te presentamos un presupuesto cerrado con todas las gestiones incluidas.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};
---

<CustomLayout
	title="Abogado de Extranjería en Lucena | Nacionalidad y arraigo"
	description="Residencia, arraigo, visados, reagrupación y nacionalidad española en Lucena, Córdoba y Málaga. Consulta gratuita: 666 329 155."
	keywords="nacionalidad española, abogado extranjería Lucena, reagrupación familiar Córdoba, arraigo Málaga, residencia legal, visado de trabajo"
	ogImage={heroImg.src}
	alternates={[
		{ hreflang: 'es-ES', href: `${SITE_URL}/nacionalidad-extranjeria/` },
		{ hreflang: 'en', href: `${SITE_URL}/en/immigration-and-nationality/` },
		{ hreflang: 'x-default', href: `${SITE_URL}/nacionalidad-extranjeria/` },
	]}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Nacionalidad y Extranjería', url: '/nacionalidad-extranjeria/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/nacionalidad-extranjeria/#service`,
			serviceType: 'Derecho de Extranjería',
			name: 'Tramitación de nacionalidad y residencia',
			description:
				'Residencia, visado, reagrupación familiar y nacionalidad española.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Asesoramiento jurídico en extranjería y nacionalidad española en Lucena, Córdoba y Málaga"
		supertitle="Derecho de extranjería"
		description="Residencia, nacionalidad, reagrupación familiar o protección internacional. Tramitación completa, transparente y adaptada a tu caso."
		whatsappHref="https://wa.me/34666329155?text=Hola%2C%20quisiera%20realizar%20una%20consulta%20legal%2C%20%C2%BFpodr%C3%ADamos%20agendar%20una%20cita%3F"
		stats={[
			{ Icon: Scale, label: 'Honorarios', value: 'Presupuesto cerrado' },
			{ Icon: Award, label: 'Experiencia', value: '+20 años' },
			{ Icon: Calculator, label: 'Tramitación', value: 'Plazos optimizados' },
		]}
	>
		<span slot="title">Abogado de extranjería y nacionalidad en Lucena.</span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'Construye tu futuro en España con <span class="text-primary">tranquilidad y seguridad jurídica</span>.'}
		factboxSupertitle="Cómo abordamos tu caso"
		factboxTitle="De principio a fin"
		factboxItems={[
			{
				Icon: Clock,
				title: 'Estudio del caso',
				description:
					'Analizamos tu situación personal, familiar y administrativa para identificar la vía más rápida, segura y rentable.',
			},
			{
				Icon: FileText,
				title: 'Documentación',
				description:
					'Traducciones juradas, apostillas, formularios oficiales y pruebas de medios económicos, todo preparado para evitar requerimientos.',
			},
			{
				Icon: Award,
				title: 'Asesoramiento personalizado',
				description:
					'Trato directo con el abogado responsable. Sin intermediarios ni sucursales deslocalizadas.',
			},
		]}
	>
		<p class="mb-4">
			Gestionar tu situación legal en España no tiene por qué ser un laberinto burocrático.
			En Scruz Abogados te acompañamos en cada paso: obtención de residencia, visado de
			trabajo, reagrupación familiar, solicitudes de asilo, recursos frente a denegaciones o
			nacionalidad española por residencia, carta de naturaleza u opción.
		</p>
		<p class="mb-4">
			Conocemos los procedimientos ante las delegaciones y subdelegaciones del Gobierno, las
			oficinas de extranjería y los consulados. Nos encargamos de preparar la documentación,
			presentar la solicitud telemática o presencialmente, responder a los requerimientos y
			acudir a la entrevista correspondiente para asegurar que tu expediente esté impecable.
		</p>
		<p class="mb-4">
			La residencia se mantiene con calendario: la
			<a href="/scruz-abogados/blog/prorroga-estancia-y-renovacion/" class="link link-primary">prórroga de estancia y la renovación del TIE</a>
			se planifican 60 días antes de la caducidad, la actividad se justifica antes de que
			la pregunte la oficina, y si tu expediente se queda sin respuesta conviene saber qué
			rige el <a href="/scruz-abogados/blog/silencio-administrativo-positivo-negativo/" class="link link-primary">silencio administrativo</a>
			en tu trámite — en extranjería, casi siempre negativo.
		</p>
		<p>
			Además, te mantenemos informado de cada novedad y, si la administración no responde o
			deniega, contamos con un área especializada en recursos administrativos y
			contencioso-administrativos para defender tus intereses hasta las últimas instancias.
		</p>
		<p>
			<strong>Do you prefer English?</strong> Our
			<a
				class="link link-primary"
				href="/scruz-abogados/en/immigration-and-nationality/"
				hreflang="en"
				lang="en">immigration and nationality page in English</a
			>
			explains the same routes, documents and deadlines.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué tramitamos"
		title="Servicios de extranjería"
		description="Cubrimos todas las vías administrativas y judiciales para que tu expediente esté completo y bien defendido, desde la solicitud inicial hasta los recursos contencioso-administrativos."
		items={[
			{
				Icon: Briefcase,
				title: 'Residencia y trabajo',
				description:
					'Tramitamos la autorización inicial de residencia y trabajo por cuenta ajena o propia, su renovación y la conversión a residencia de larga duración.',
			},
			{
				Icon: LinkIcon,
				title: 'Arraigo social, laboral y familiar',
				description:
					'Solicitamos la residencia por circunstancias excepcionales cuando cumples los requisitos de permanencia en España y vínculo social, laboral o familiar.',
			},
			{
				Icon: Users,
				title: 'Reagrupación familiar',
				description:
					'Reunimos a tu familia en España: cónyuge, hijos menores y ascendientes a cargo. Tramitamos la solicitud y aportamos los informes de vivienda y medios económicos.',
			},
			{
				Icon: Award,
				title: 'Nacionalidad española',
				description:
					'Solicitamos la nacionalidad por residencia, carta de naturaleza u opción. Te preparamos para el examen CCSE y la entrevista con la administración.',
			},
			{
				Icon: ShieldCheck,
				title: 'Asilo y protección internacional',
				description:
					'Asesoramos y representamos a personas solicitantes de asilo, protección subsidiaria y razones humanitarias, en fase administrativa y judicial.',
			},
			{
				Icon: Gavel,
				title: 'Recursos y contencioso',
				description:
					'Interponemos recursos administrativos y demandas contencioso-administrativas frente a denegaciones, sanciones o expulsiones.',
			},
		]}
	/>

	<EditorialMeasures
		supertitle="Plazos administrativos típicos"
		title="¿Cuánto tarda tu expediente?"
		description="Los tiempos de resolución varían según la Delegación o Subdelegación del Gobierno, el volumen acumulado y la complejidad del expediente. Estos rangos son orientativos y se confirman tras el estudio de tu caso."
		valueFormat="single-currency"
		noteLabel="Plazo orientativo."
		disclaimer="Tiempos aproximados orientativos. Confirmamos la duración estimada tras la revisión de tu expediente concreto."
		items={[
			{
				title: 'Solicitud inicial de residencia',
				value: '3 — 6 meses',
				note: 'Resolución por la Delegación o Subdelegación del Gobierno',
			},
			{
				title: 'Resolución de recurso de reposición',
				value: '1 — 3 meses',
				note: 'Vía administrativa — plazo para interponer: 1 mes',
			},
			{
				title: 'Contencioso-administrativo',
				value: '6 — 18 meses',
				note: 'Primera instancia en Juzgados de lo Contencioso-Administrativo',
			},
			{
				title: 'Nacionalidad por residencia',
				value: '1 — 3 años',
				note: 'Desde solicitud hasta juramento (según oficina y volumen)',
			},
		]}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="Tu expediente, paso a paso"
		items={[
			{
				number: '01',
				title: 'Diagnóstico inicial',
				description:
					'Estudiamos tu situación personal, familiar y administrativa para identificar la vía más rápida, segura y rentable para ti.',
			},
			{
				number: '02',
				title: 'Preparación del expediente',
				description:
					'Recopilamos la documentación, cumplimentamos formularios y revisamos cada documento para evitar errores formales que retrasan la resolución.',
			},
			{
				number: '03',
				title: 'Presentación y seguimiento',
				description:
					'Registramos la solicitud telemática o presencialmente, respondemos a requerimientos y te representamos en las entrevistas que correspondan.',
			},
			{
				number: '04',
				title: 'Recursos si proceden',
				description:
					'Si hay silencio o denegación, preparamos e interponemos el recurso adecuado hasta agotar la vía administrativa o acudir a la jurisdicción contencioso-administrativa.',
			},
		]}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Tramitamos tu expediente con seguridad."
		items={[
			{
				Icon: Landmark,
				title: 'Especialistas en extranjería',
				description:
					'Conocemos la normativa actualizada, los criterios de las delegaciones del Gobierno y la jurisprudencia aplicable a cada tipo de solicitud.',
			},
			{
				Icon: Clock,
				title: 'Plazos ajustados',
				description:
					'Optimizamos cada fase del expediente para evitar demoras innecesarias y aprovechar todas las oportunidades de tu situación.',
			},
			{
				Icon: Award,
				title: 'Atención multilingüe',
				description:
					'Atendemos en español e inglés; bajo solicitud, podemos concertar traductores jurados para cualquier idioma.',
			},
		]}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Dudas frecuentes"
		description="Las preguntas más habituales sobre nacionalidad, residencia, plazos de tramitación y honorarios."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Empieza hoy"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Te informamos de las opciones, los plazos y los pasos a seguir. Si decides no continuar, no pagas nada."
		relatedLinks={[
			{ label: 'Prórroga de estancia y renovación del TIE: guía', href: '/blog/prorroga-estancia-y-renovacion/' },
			{ label: 'Guía: sanidad sin residencia legal', href: '/blog/sanidad-extranjeros-sin-residencia/' },
			{ label: 'Divorcios', href: '/divorcios-separaciones/' },
			{ label: 'Derecho penal', href: '/derecho-penal/' },
			{ label: 'Reclamaciones bancarias', href: '/reclamaciones-bancarias/' },
		]}
	/>
</CustomLayout>
