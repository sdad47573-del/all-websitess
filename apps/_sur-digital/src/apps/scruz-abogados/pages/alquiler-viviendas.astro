---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Derecho civil', href: '/derecho-civil' },
	{ label: 'Alquiler de viviendas', href: '/alquiler-viviendas' },
];

const highlights = [
	'Revisión del contrato, fianza, rentas y comunicaciones',
	'Análisis de incidencias entre propietario y arrendatario',
	'Opciones de acuerdo, reclamación o defensa',
];

const sections = [
	{
		title: 'Asesoría para alquileres de vivienda',
		content: 'Los problemas de alquiler pueden surgir por impagos, fianza, fugas, daños, obras, comunicaciones, prórrogas o desahucio. Cada caso parte de un contrato, de las comunicaciones y de la situación real de la vivienda, por lo que no conviene aplicar una solución general.',
		points: [
			'Fianza, garantía, rentas e impagos.',
			'Obras, reparaciones y comunicaciones sobre la vivienda.',
			'Prórroga, resolución y recuperación de la vivienda.',
			'Reclamaciones y defensa de propietarios o arrendatarios.',
		],
	},
	{
		title: 'Contrato y obligaciones de las partes',
		content: 'El contrato debe establecer la duración, la renta, la fianza, los gastos, las obras y las condiciones de resolución. Cualquier modificación debe quedar documentada. Cuando existe una discrepancia, conviene comparar el contrato con los hechos y las notificaciones realizadas.',
	},
	{
		title: 'Impago, fianza y daños',
		content: 'El impago de la renta, la retención indebida de la fianza o los daños en la vivienda requieren revisar el contrato, los pagos y las pruebas. La respuesta puede incluir una reclamación, una negociación o un procedimiento judicial, según el caso.',
	},
	{
		title: 'Desahucio y recuperación de la vivienda',
		content: 'La recuperación de una vivienda depende del estado del arrendamiento, de la ocupación y del procedimiento aplicable. Antes de actuar conviene revisar los avisos, el título contractual y la documentación de la deuda. La defensa debe centrarse en hechos y pruebas verificables.',
	},
	{
		title: 'Contrato, duración y actualización de la renta',
		content: 'La duración pactada, las prórrogas y la actualización anual de la renta son los puntos que más dudas generan. La revisión parte del contrato firmado y de las comunicaciones sobre la subida, porque una actualización mal aplicada o avisada fuera de plazo puede discutirse. También conviene comprobar qué gastos asume cada parte.',
		points: [
			'Duración, prórrogas y preaviso de salida.',
			'Comunicación de la subida y fecha de efecto.',
			'Gastos, suministros y comunidad.',
		],
	},
	{
		title: 'Fianza, obras y reparaciones: quién paga',
		content: 'La fianza responde del cumplimiento de lo pactado y no puede retenerse sin justificación. En las obras y reparaciones hay que distinguir la conservación necesaria de la mejora voluntaria, porque la primera corresponde al propietario y la segunda depende del acuerdo. Fotos, facturas y avisos escritos son las pruebas decisivas.',
		points: [
			'Estado de la vivienda al entrar y al salir.',
			'Avisos de avería y respuesta del propietario.',
			'Facturas de arreglos y criterio de reparto.',
		],
	},
	{
		title: 'Venta de la vivienda alquilada',
		content: 'Si se vende una vivienda en alquiler, el comprador puede quedar subrogado en el contrato y el arrendatario mantiene su derecho de uso en los términos pactados. Es habitual que la operación origine dudas sobre la fianza, el preaviso o una subida de renta, así que conviene documentar la transmisión y comunicarla por escrito.',
		points: [
			'Contrato vigente y duración restante.',
			'Fianza entregada y su traspaso al comprador.',
			'Adquisición preferente del arrendatario cuando proceda.',
		],
	},
];

const faqs = [
	{
		question: '¿Cuándo se puede pedir la devolución de la fianza?',
		answer: 'La devolución depende de la finalización del contrato, del estado de la vivienda y de lo pactado. Conviene revisar el inventario, las fotos y la comunicación de entrega.',
	},
	{
		question: '¿Puede el propietario entrar para hacer una reparación?',
		answer: 'La entrada requiere consentimiento o una base jurídica concreta. El derecho de acceso no es ilimitado y debe estudiarse teniendo en cuenta la situación del arrendatario y la normativa aplicable.',
	},
	{
		question: '¿Qué hago si me retraso con el alquiler?',
		answer: 'Debe solicitarse asesoramiento cuanto antes. Según la situación, puede ser posible negociar o establecer un plan de pago, pero no conviene asumir que cualquier acuerdo modifica el contrato sin dejar constancia.',
	},
	{
		question: '¿Se puede reclamar por una vivienda en mal estado?',
		answer: 'Puede estudiarse una reclamación si existen daños, falta de mantenimiento o incumplimiento de las condiciones pactadas. La documentación y las pruebas del estado del inmueble son importantes.',
	},
	{
		question: '¿Qué hago si no me devuelven la fianza?',
		answer: 'Conviene reclamarla por escrito, con el contrato, el inventario y las pruebas del estado en que quedó la vivienda. Si la retención no está justificada, puede estudiarse una reclamación de cantidad o una actuación judicial, según el motivo que alegue el propietario.',
	},
];

const related = [
	{ label: 'Desahucio por impago', href: '/desahucio-por-impago', description: 'Recuperación de una vivienda y defensa en casos de impago.' },
	{ label: 'Derecho civil', href: '/derecho-civil', description: 'Información general sobre contratos y obligaciones.' },
	{ label: 'Alquiler de piso en Málaga', href: '/blog/alquilar-piso-malaga', description: 'Guía sobre contrato, fianza y alquiler.' },
];
---

<SeoLegalPage
	title="Abogado de Alquiler de Vivienda en Lucena | Scruz Abogados"
	description="Fianza retenida, impagos, obras o daños en la vivienda: defendemos a propietarios e inquilinos en Lucena y Córdoba. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho civil y vivienda"
	headline="Problemas legales del alquiler de vivienda"
	intro="Una disputa de alquiler puede originarse en el contrato, la fianza, la renta, los daños, las obras o la recuperación de la vivienda. Revisamos los hechos y estudiamos la vía más adecuada."
	highlights={highlights}
	serviceType="Asesoría en alquileres de vivienda"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
	showBlogGuides
/>
