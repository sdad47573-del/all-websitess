---
import heroImg from '../@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	Award,
	Banknote,
	Calculator,
	Clock,
	CreditCard,
	Euro,
	FileSearch,
	FileText,
	Landmark,
	Link2,
	PiggyBank,
	Receipt,
	Scale,
	TrendingDown,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Qué es la cláusula suelo y cómo me afecta?',
		answer:
			'La cláusula suelo es una cláusula abusiva incluida en muchas hipotecas que fija un interés mínimo a pagar, con independencia de la evolución del euríbor. El Tribunal Supremo y el TJUE la han declarado nula en la mayoría de los casos, lo que obliga al banco a devolver todo lo cobrado de más, más los intereses legales. Si tu hipoteca tiene cláusula suelo, tienes derecho a recuperar miles de euros.',
	},
	{
		question: '¿Puedo reclamar la hipoteca multidivisa años después?',
		answer:
			'Sí. Las entidades bancarias comercializaron hipotecas en yenes, francos suizos u otras divisas sin informar adecuadamente del riesgo cambiario. El Tribunal Supremo considera nulas estas cláusulas por falta de transparencia, lo que permite reclamar la devolución del coste financiero total del préstamo más los intereses. No importa si firmaste hace 5, 10 o más años.',
	},
	{
		question: '¿Qué pasa con las tarjetas revolving?',
		answer:
			'Las tarjetas revolving aplican tipos de interés muy superiores a la media (frecuentemente por encima del 20% TAE), lo que el Supremo ha considerado usurario en múltiples sentencias. Si tienes o has tenido una tarjeta revolving (Wizink, Caixabank, Santander, Cofidis, etc.), podemos solicitar la nulidad del contrato y la devolución íntegra de los intereses pagados.',
	},
	{
		question: '¿Cuánto cuesta reclamar al banco?',
		answer:
			'Trabajamos con un sistema de honorarios condicionado: si no obtenemos una indemnización a tu favor, no pagas nada. Cuando ganamos, cobramos un porcentaje sobre las cantidades recuperadas, acordado previamente por escrito. Si acudes a través del turno de oficio o con seguro de defensa jurídica, nuestros honorarios se ajustan a las coberturas de cada póliza.',
	},
	{
		question: '¿Tengo que ir a juicio?',
		answer:
			'No siempre. En muchos casos, una reclamación extrajudicial bien fundamentada basta para que el banco ofrezca un acuerdo. Solo cuando la entidad niega toda responsabilidad acudimos a la vía judicial. En cualquier caso, te informamos de cada paso y valoramos contigo las opciones antes de tomar una decisión.',
	},
	{
		question: '¿Qué documentos necesito para empezar?',
		answer:
			'Para estudiar tu caso necesitamos: la escritura de préstamo o hipoteca, la oferta vinculante o folleto informativo, los recibos mensuales (al menos los últimos 12), la ficha de información precontractual (FIPRE) y cualquier comunicación del banco. Si no los localizas, los conseguimos nosotros.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};
---

<CustomLayout
	title="Abogado de Reclamaciones Bancarias en Lucena | Scruz Abogados"
	description="Abogado de reclamaciones bancarias en Lucena, Córdoba y Málaga: cláusulas suelo, tarjetas revolving e hipotecas. Consulta gratuita: 666 329 155."
	keywords="abogado cláusulas suelo, reclamación hipoteca multidivisa, tarjeta revolving abusiva, gastos hipotecarios, IRPH nulidad, abogado bancario Lucena Córdoba"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Reclamaciones Bancarias', url: '/reclamaciones-bancarias/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/reclamaciones-bancarias/#service`,
			serviceType: 'Derecho Bancario',
			name: 'Reclamaciones contra entidades bancarias',
			description:
				'Nulidad de cláusulas abusivas, devolución de cantidades y reclamación frente a entidades bancarias.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Despacho Scruz Abogados especializado en reclamaciones bancarias frente a entidades"
		supertitle="Derecho bancario · Reclamaciones a entidades"
		description="Anulamos cláusulas abusivas y conseguimos la devolución íntegra de lo cobrado de más. Honorarios solo si ganamos."
		stats={[
			{ Icon: Scale, label: 'Honorarios', value: 'Solo si ganamos' },
			{ Icon: Award, label: 'Experiencia', value: '+20 años' },
			{ Icon: Calculator, label: 'Reclamación', value: 'Sin coste inicial' },
		]}
	>
		<span slot="title">Reclamamos lo que el banco te debe.</span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'Defendemos tus derechos <span class="text-primary">frente a bancos y productos abusivos</span>.'}
		factboxSupertitle="Datos clave"
		factboxTitle="Cómo abordamos tu caso"
		factboxItems={[
			{
				Icon: Clock,
				title: 'Estudio individual',
				description: 'Cada caso se analiza en detalle antes de presentar cualquier reclamación.',
			},
			{
				Icon: FileText,
				title: 'Documentación',
				description:
					'Escritura, últimos recibos y folleto informativo son la base del caso.',
			},
			{
				Icon: FileSearch,
				title: 'Jurisprudencia del TJUE',
				description:
					'Las sentencias del Tribunal de Justicia de la UE son la base de la mayoría de nulidades bancarias en España.',
			},
		]}
	>
		<p class="mb-4">
			Las cláusulas suelo, las hipotecas multidivisa, las tarjetas revolving, los gastos de
			formalización o el IRPH han perjudicado a cientos de miles de familias y profesionales
			en España. Si crees que tu banco te vendió un producto sin la información adecuada o
			que te ha cobrado de más, tienes derecho a reclamar y a recuperar cantidades que en
			ocasiones suman miles de euros.
		</p>
		<p class="mb-4">
			En Scruz Abogados acumulamos experiencia en reclamaciones bancarias frente a las
			principales entidades del país. Estudiamos tu caso de forma individual, te explicamos
			qué opciones reales tienes y nos ocupamos de todo el procedimiento: reclamación
			extrajudicial, demanda judicial y, si procede, ejecución de sentencia hasta que el
			banco te devuelva cada euro.
		</p>
		<p>
			Trabajamos con honorarios condicionados: si no recuperamos nada, no pagas. Si ganamos,
			nuestros honorarios son un porcentaje acordado previamente sobre las cantidades
			obtenidas. Sin sorpresas, sin letra pequeña.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué reclamamos"
		title="Casos en los que podemos ayudarte"
		description="Anulamos cláusulas abusivas y conseguimos la devolución íntegra de lo cobrado de más: cláusulas suelo, multidivisa, revolving, IRPH, gastos y productos vinculados."
		items={[
			{
				Icon: Banknote,
				title: 'Cláusula suelo',
				description:
					'Reclamamos la nulidad de la cláusula suelo y la devolución de todos los intereses cobrados de más desde la firma del préstamo, más los intereses legales y las costas.',
			},
			{
				Icon: Euro,
				title: 'Hipoteca multidivisa',
				description:
					'Anulamos el contrato multidivisa por falta de transparencia y recalculamos el préstamo en euros, devolviéndote la diferencia con los intereses legales.',
			},
			{
				Icon: CreditCard,
				title: 'Tarjetas revolving',
				description:
					'Declaramos la nulidad por interés usurario y conseguimos la devolución íntegra de los intereses cobrados por encima del precio justo del dinero.',
			},
			{
				Icon: Receipt,
				title: 'Gastos hipotecarios',
				description:
					'Recuperamos los gastos de notaría, registro, gestoría y tasación abonados injustamente, conforme a la jurisprudencia del TJUE.',
			},
			{
				Icon: TrendingDown,
				title: 'IRPH y otros índices',
				description:
					'Estudiamos si la cláusula IRPH es reclamable según los últimos criterios del TJUE y valoramos transparencia y falta de información caso por caso.',
			},
			{
				Icon: Link2,
				title: 'Productos vinculados',
				description:
					'Seguros, tarjetas o cuentas asociadas impagadas al firmar la hipoteca. Reclamamos su nulidad y la devolución de los cobros realizados.',
			},
		]}
	/>

	<EditorialMeasures
		supertitle="Estimación orientativa"
		title="¿Cuánto podrías recuperar?"
		description="Las cantidades varían según el producto, el capital y los años transcurridos. Estos rangos ilustrativos proceden de casos reales tramitados por nuestro bufete frente a las principales entidades del país."
		valueFormat="currency"
		noteLabel="Cifras indicativas por caso."
		disclaimer="Cifras orientativas. El cálculo exacto requiere revisar tu escritura, la evolución de los índices y los recibos efectivamente abonados."
		items={[
			{
				title: 'Gastos hipotecarios',
				from: 1500,
				to: 3000,
				note: 'Notaría · Registro · Tasación · Gestoría',
			},
			{
				title: 'Cláusula suelo (vivienda media)',
				from: 3000,
				to: 15000,
				note: 'Según capital, años transcurridos y diferencial aplicado',
			},
			{
				title: 'Tarjeta revolving (consumo medio)',
				from: 2000,
				to: 8000,
				note: 'Devolución íntegra de los intereses usurarios',
			},
			{
				title: 'Hipoteca multidivisa (caso medio)',
				from: 8000,
				to: 30000,
				note: 'Recálculo en euros + intereses legales',
			},
		]}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="Tu caso, paso a paso"
		items={[
			{
				number: '01',
				title: 'Estudio del contrato',
				description:
					'Analizamos tu hipoteca, préstamo o tarjeta y te informamos de forma clara de si existe una cláusula abusiva y cuánto podrías recuperar.',
			},
			{
				number: '02',
				title: 'Reclamación extrajudicial',
				description:
					'Enviamos una reclamación formal al servicio de atención al cliente y, en su caso, al Defensor del Cliente. Muchos bancos llegan a un acuerdo antes del juicio.',
			},
			{
				number: '03',
				title: 'Demanda judicial',
				description:
					'Si no hay acuerdo, interponemos demanda de nulidad y devolución de cantidades frente al banco, con solicitud de intereses y costas procesales.',
			},
			{
				number: '04',
				title: 'Sentencia y cobro',
				description:
					'Te acompañamos hasta el cobro efectivo: solicitud de ejecución, embargo de cuentas y reclamación de los intereses de mora si el banco paga tarde.',
			},
		]}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Frente a las grandes entidades."
		items={[
			{
				Icon: PiggyBank,
				title: 'Honorarios condicionados',
				description:
					'Solo cobramos si ganamos. Un porcentaje acordado previamente sobre lo recuperado, con presupuesto cerrado y por escrito.',
			},
			{
				Icon: Landmark,
				title: 'Experiencia con la banca',
				description:
					'Conocemos los argumentos y la estrategia de las principales entidades. Eso nos permite anticiparnos y reducir los plazos.',
			},
			{
				Icon: Banknote,
				title: 'Devolución integral',
				description:
					'Reclamamos los importes cobrados de más más los intereses legales, para que tu recuperación económica sea completa.',
			},
		]}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Resolvemos tus dudas"
		description="Las preguntas más habituales sobre cláusulas abusivas, plazos de prescripción y honorarios."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Estamos a tu lado"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Estudiamos tu caso sin coste, te informamos de las opciones reales y, si decides no reclamar, no pagas nada."
		relatedLinks={[
			{ label: 'Cláusula suelo e IRPH: guía', href: '/blog/clausula-suelo-irph/' },
			{ label: 'Cobro de deudas', href: '/cobro-deudas-impagos/' },
			{ label: 'Herencias', href: '/herencias-testamentos/' },
		]}
	/>
</CustomLayout>
