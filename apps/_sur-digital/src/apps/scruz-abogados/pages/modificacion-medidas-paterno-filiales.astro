---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Derecho de familia', href: '/guarda-custodia' },
	{ label: 'Modificación de medidas', href: '/modificacion-medidas-paterno-filiales' },
];

const highlights = [
	'Estudio de la situación familiar y de las circunstancias actuales',
	'Estrategia procesal personalizada y revisión de la documentación',
	'Información clara sobre posibilidades, costes y calendario',
];

const sections = [
	{
		title: '¿Cuándo se pueden modificar las medidas?',
		content: 'Las medidas de guarda, convivencia y visitas pueden solicitarse que cambien cuando se produce una alteración relevante en la situación familiar. No existe una regla universal para todos los casos: el juez valora el interés superior del menor, su estabilidad y la necesidad de adaptar el régimen existente a hechos nuevos y verificables.',
		points: [
			'Cambios importantes en el horario o la convivencia con cada progenitor.',
			'Incumplimientos reiterados o cambios en el régimen de visitas.',
			'Cambios de domicilio, trabajo, salud o situación económica relevantes.',
			'Necesidades educativas, residenciales o de salud que requieren ajustes.',
		],
	},
	{
		title: 'Cómo se tramita una modificación de medidas',
		content: 'La solicitud debe explicar qué medida se pide modificar, qué hechos la justifican y cuál es la alternativa concreta que se considera adecuada. Acompañar la petición de pruebas y, cuando sea posible, de un plan de convivencia facilita la negociación y permite valorar cómo se cumplirá.',
		points: [
			'Revisión de la sentencia o convenio anterior y de su cumplimiento.',
			'Recopilación de nuevas pruebas y actualización de la documentación.',
			'Intento de acuerdo cuando resulte proporcionado y seguro.',
			'Presentación de la demanda y seguimiento del procedimiento.',
		],
	},
	{
		title: 'Custodia, visitas y alimentos',
		content: 'La expresión modificar medidas puede referirse a la guarda, al régimen de visitas, a la obligación de alimentos o a varios extremos relacionados. Cada aspecto debe estudiarse por separado. También es importante presentar una solicitud concreta, con una explicación clara del cambio que necesita la vida familiar.',
	},
	{
		title: 'Si existe acuerdo entre los progenitores',
		content: 'Un acuerdo puede formalizarse en un documento privado o ante el judicial, según resulte más conveniente. El documento debe ser claro, completo y realista. Las visitas, festividades, vacaciones, desplazamientos, comunicación y responsabilidad sobre la toma de decisiones son algunos de los extremos que conviene concretar para evitar conflictos posteriores.',
	},
	{
		title: 'Qué hechos suelen justificar la modificación (y cuáles no)',
		content: 'No basta con estar en desacuerdo con el régimen vigente ni con que la relación entre los progenitores se haya tensado. Lo que se valora son hechos nuevos, concretos y comprobables que alteren de verdad la vida del menor, junto con una propuesta que explique cómo se organizará la convivencia a partir de ahora.',
		points: [
			'Un cambio real de domicilio, de horario laboral o de disponibilidad cotidiana.',
			'Necesidades del menor que exigen otra distribución del tiempo.',
			'Incumplimientos sostenidos del régimen que ya estaba fijado.',
			'Un simple desacuerdo, sin hechos nuevos, no suele ser suficiente.',
		],
	},
	{
		title: 'Documentación y pruebas que conviene preparar',
		content: 'La calidad de la prueba decide buena parte del resultado, y hay pruebas que solo se pueden obtener durante un tiempo determinado. Reunir calendarios, mensajes, informes médicos o escolares y comprobantes de gastos desde el principio evita improvisar cuando el procedimiento ya está en marcha.',
		points: [
			'Resolución o convenio anterior y prueba de cómo se ha venido cumpliendo.',
			'Calendarios, mensajes y correos con fechas concretas.',
			'Informes escolares, médicos o de servicios sociales, si existen.',
			'Gastos, nóminas y cualquier documento económico relevante.',
		],
	},
	{
		title: 'Medidas urgentes: cuándo se piden y qué puede acordarse',
		content: 'Cuando existe una situación que no admite esperar, puede solicitarse una medida urgente o provisional mientras se tramita el cambio definitivo. No es una vía para cualquier discrepancia: hay que acreditar el motivo y explicar qué medida concreta se necesita y por qué no puede demorarse.',
		points: [
			'Riesgo para el menor o ruptura de la convivencia que se estaba aplicando.',
			'Suspensión o ajuste temporal del régimen de visitas.',
			'Fijación provisional de alimentos o del lugar de residencia.',
			'La medida urgente no sustituye al procedimiento de modificación.',
		],
	},
];

const faqs = [
	{
		question: '¿Puede pedirse una modificación aunque exista un convenio firmado?',
		answer: 'Sí. Un convenio no impide solicitar un cambio si han aparecido circunstancias nuevas y relevantes. Debe explicarse el cambio concreto, la causa y la propuesta de nueva distribución de tiempo y responsabilidades.',
	},
	{
		question: '¿Basta con que el otro progenitor no cumpla?',
		answer: 'Un incumplimiento puede ser relevante, pero conviene documentarlo con comunicaciones, fechas y contexto. La respuesta depende de la obligación incumplida, su gravedad y la forma en que se ha producido.',
	},
	{
		question: '¿Cuánto tiempo tarda un proceso de modificación?',
		answer: 'No existe un plazo único. La duración depende de la complejidad de la prueba, la posibilidad de acuerdo, la agenda judicial y si se solicitan medidas provisionales.',
	},
	{
		question: '¿Se puede pedir una medida urgente?',
		answer: 'En determinadas circunstancias puede solicitarse una medida urgente o provisional, pero debe existir una situación que justifique una respuesta inmediata. No toda discrepancia puede tramitarse por esa vía.',
	},
	{
		question: '¿Puede modificarse la pensión de alimentos sin cambiar la custodia?',
		answer: 'Sí. La guarda, las visitas y los alimentos son pronunciamientos distintos: si lo que ha cambiado es la situación económica o las necesidades del menor, puede plantearse solo el ajuste de la pensión. Para ello hay que explicar qué variación se ha producido y acompañarla de documentación que la acredite.',
	},
];

const related = [
	{ label: 'Guarda y custodia', href: '/guarda-custodia', description: 'Cómo se organiza la guarda y la responsabilidad de los progenitores.' },
	{ label: 'Régimen de visitas', href: '/blog/regimen-de-visitas', description: 'Aspectos prácticos del contacto con los menores.' },
	{ label: 'Divorcios y separaciones', href: '/divorcios-separaciones', description: 'Guía general sobre separación, consentimiento y litigios.' },
];
---

<SeoLegalPage
	title="Abogado de Medidas Paterno-Filiales en Lucena | Scruz"
	description="Modificación de medidas paterno-filiales en Lucena y Córdoba: guarda, visitas y alimentos cuando cambian las circunstancias. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho de familia"
	headline="Modificación de medidas de custodia y visitas"
	intro="Cuando las circunstancias cambian, puede ser necesario revisar el régimen de convivencia y visitas. Te ayudamos a identificar qué medidas pueden modificarse y cómo solicitarlo con una propuesta clara, prudente y centrada en el menor."
	highlights={highlights}
	serviceType="Asesoría para modificar medidas de custodia y visitas"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
	guides={['medidas-paterno-filiales', 'custodia-compartida-cordoba', 'pension-de-alimentos']}
/>
