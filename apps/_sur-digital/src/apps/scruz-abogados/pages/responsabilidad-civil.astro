---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Derecho civil', href: '/derecho-civil' },
	{ label: 'Responsabilidad civil', href: '/responsabilidad-civil' },
];

const highlights = [
	'Estudio del daño, la conducta y la relación entre ambos',
	'Identificación de las pruebas necesarias y cuantificación de daños',
	'Alternativas de negociación, reclamación o demanda',
];

const sections = [
	{
		title: '¿Qué es la responsabilidad civil?',
		content: 'La responsabilidad civil aparece cuando una persona, empresa o administración causa un daño que debe reparar. Puede estar relacionada con un contrato, un accidente, una propiedad defectuosa, una actuación profesional o el incumplimiento de una obligación legal.',
		points: [
			'Daños materiales: reparación, sustitución o restitución.',
			'Daños patrimoniales: gastos, ingresos o lucro cesante.',
			'Daños corporales o morales cuando corresponda.',
			'Reclamación frente a seguros, empresas o profesionales.',
		],
	},
	{
		title: 'Cómo se estudia un caso de responsabilidad',
		content: 'La viabilidad no depende solo de que exista un daño. También hay que analizar la conducta, la relación causal, las posibles causas concurrentes y los medios de prueba. Una revisión temprana ayuda a evitar reclamar sin fundamento suficiente o aceptar una propuesta antes de valorar correctamente los daños.',
		points: [
			'Recopilar contratos, facturas, fotografías, informes y comunicaciones.',
			'Identificar quién ha causado el daño o puede responder por él.',
			'Determinar si existe seguro, garantía o responsabilidad administrativa.',
			'Valorar las consecuencias y las alternativas de solución.',
		],
	},
	{
		title: 'Negociar o reclamar en los tribunales',
		content: 'En muchos casos es conveniente intentar una reclamación escrita, una negociación o una mediación antes de demandar. Si existe riesgo de prescripción o pérdida de pruebas, debe analizarse la vía procesal con rapidez. La reclamación debe pedir una solución concreta y explicar los daños documentados.',
	},
	{
		title: 'La importancia de los documentos',
		content: 'Las facturas, contratos, informes médicos, partes, fotografías, correos y mensajes pueden ser determinantes. También conviene guardar la fecha en que se produjo el daño, las comunicaciones con la parte contraria y cualquier reconocimiento de responsabilidad.',
	},
	{
		title: 'Qué daños se pueden reclamar y cómo se cuantifican',
		content: 'La reclamación debe concretar el daño y su traducción económica: reparar o reponer lo dañado, recuperar lo que se dejó de ingresar y compensar el perjuicio personal cuando sea valorable. No se trata de pedir una cifra redonda, sino de poder explicarla con facturas, informes y criterios de valoración.',
		points: [
			'Daño emergente: facturas de reparación, asistencia o sustitución.',
			'Lucro cesante: ingresos que se han dejado de percibir.',
			'Daño personal y moral: informes, partes y prueba del impacto.',
			'Cuantificación prudente: cada partida debe poder justificarse.',
		],
	},
	{
		title: 'Plazos y por qué las primeras semanas deciden el caso',
		content: 'El plazo para reclamar depende del origen del daño, de si existe contrato y de la fecha en que se produjo o se conoció. Por eso lo determinante suele ser lo que se hace en las primeras semanas: recopilar pruebas, pedir informes y comunicar formalmente la reclamación antes de que se deteriore la prueba. Los plazos son breves y conviene revisarlos desde el primer momento.',
		points: [
			'Conservar la prueba antes de que se degrade o desaparezca.',
			'Comunicación formal: dejar constancia de la fecha y del contenido.',
			'Los actos previos pueden interrumpir el plazo; hay que documentarlos.',
		],
	},
	{
		title: 'Casos típicos de responsabilidad civil en Lucena y su comarca',
		content: 'En la práctica vemos sobre todo cuatro familias de casos: accidentes y daños materiales, problemas de obras y de vecindad, productos o servicios defectuosos y actuación profesional negligente. Cada una exige una prueba distinta y se dirige frente a adversarios diferentes, muchas veces con una póliza de seguro de por medio. Analizamos el caso antes de reclamar.',
		points: [
			'Accidentes: partes, testigos, informes y valoración del daño.',
			'Obras y vecindad: actas, fotografías con fecha y peritaje.',
			'Productos o servicios: compra, garantía y reclamación previa.',
			'Actuación profesional: contrato, encargo y prueba del fallo.',
		],
	},
];

const faqs = [
	{
		question: '¿Puedo reclamar aunque no tenga un contrato firmado?',
		answer: 'La ausencia de contrato no siempre impide reclamar. También pueden ser relevantes otras pruebas, como facturas, mensajes, testigos o hechos acreditados. La vía depende del origen del daño.',
	},
	{
		question: '¿Cuánto tiempo tengo para reclamar?',
		answer: 'El plazo depende del tipo de responsabilidad, la fecha del daño y la legislación aplicable. Es importante revisar esta cuestión antes de negociar o presentar una reclamación.',
	},
	{
		question: '¿Se puede reclamar a una aseguradora?',
		answer: 'Puede existir una vía contractual o extracontractual frente a la aseguradora cuando el daño está cubierto. La póliza, el hecho, la notificación y los daños deben revisarse antes de dirigir la reclamación.',
	},
	{
		question: '¿Tengo que demandar para recuperar una cantidad?',
		answer: 'No necesariamente. Una reclamación, negociación o mediación puede resolver el caso. La demanda se valora cuando no existe acuerdo o cuando la vía judicial resulta necesaria.',
	},
	{
		question: '¿Cómo se cuantifica el daño antes de reclamar?',
		answer: 'Se parte de la prueba del daño: facturas, informes técnicos o médicos, valoraciones y justificantes de los gastos. Además se analiza lo que se dejó de ingresar y, si procede, el perjuicio personal. La cifra se defiende mucho mejor con criterios y documentos que con una estimación aproximada.',
	},
];

const related = [
	{ label: 'Derecho civil', href: '/derecho-civil', description: 'Información general sobre obligaciones y controversias civiles.' },
	{ label: 'Indemnizaciones de tráfico', href: '/indemnizaciones-trafico', description: 'Accidentes de tráfico y reclamación de indemnizaciones.' },
	{ label: 'Daños y perjuicios', href: '/blog/danos-y-perjuicios-reclamacion', description: 'Conceptos básicos para valorar y reclamar daños.' },
];
---

<SeoLegalPage
	title="Abogado de Responsabilidad Civil en Lucena | Reclama los Daños"
	description="Daños por accidente, obra, producto defectuoso o negligencia profesional: abogado de responsabilidad civil en Lucena y Córdoba. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho civil"
	headline="Responsabilidad civil y reclamación de daños"
	intro="Cuando una conducta causa un daño, puede existir una responsabilidad civil que deba repararse. Analizamos qué ocurrió, qué puede probarse y cómo reclamar una solución proporcionada."
	highlights={highlights}
	serviceType="Asesoría en responsabilidad civil y reclamación de daños"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
	guides={['danos-y-perjuicios-reclamacion', 'errores-accidente-trafico', 'indemnizacion-accidente-trafico']}
/>
