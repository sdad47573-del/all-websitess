---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Consumo', href: '/consumo' },
	{ label: 'Reclamaciones de seguros', href: '/reclamaciones-seguros' },
];

const highlights = [
	'Revisión de la póliza, el siniestro y la documentación',
	'Control de plazos, importes y posibles exclusiones',
	'Reclamación, negociación o revisión de la respuesta',
];

const sections = [
	{
		title: 'Reclamaciones de seguros',
		content: 'Una reclamación de seguro requiere revisar la póliza, el siniestro, la fecha del hecho, la documentación y la respuesta de la aseguradora. El resultado depende de la cobertura contratada, las exclusiones, el cumplimiento del contrato y la prueba del daño.',
		points: [
			'Póliza, número de contrato y comunicación del siniestro.',
			'Fechas, fotografías, informes y justificantes del daño.',
			'Peritación, valoración e indemnización solicitada.',
			'Reclamación administrativa o defensa frente a la negativa.',
		],
	},
	{
		title: 'Cómo preparar una reclamación',
		content: 'La reclamación debe identificar el siniestro, explicar el hecho, adjuntar la documentación necesaria y pedir una respuesta concreta. Conviene conservar el justificante de envío, las comunicaciones y los justificantes de pago. Si la aseguradora rechaza la cobertura, debe solicitarse una explicación precisa.',
	},
	{
		title: 'Negociación y vías de revisión',
		content: 'En algunos casos puede negociarse una solución o solicitarse una peritación alternativa. Si existe desacuerdo, la vía disponible depende de la póliza y de la situación. El seguimiento debe controlar las notificaciones y los plazos aplicables.',
	},
	{
		title: 'Seguros de hogar, salud, auto y otros',
		content: 'La forma de reclamar cambia según el tipo de seguro y el daño. En un seguro de hogar se revisan las reparaciones; en un seguro de salud, la cobertura y el gasto; y en otros seguros, las condiciones específicas del contrato.',
	},
	{
		title: 'Cómo se reclama a la aseguradora paso a paso',
		content: 'El circuito habitual es siempre el mismo: comunicar el siniestro dentro del plazo de la póliza, facilitar la documentación, atender la peritación de la entidad y esperar una oferta o una respuesta por escrito. A partir de ahí, si la valoración no se ajusta al daño, se abre la reclamación formal y, en su caso, la vía judicial. Guardar cada justificante es lo que permite discutir después la oferta.',
		points: [
			'Comunicación del siniestro: por escrito y con acuse.',
			'Peritación y oferta: revisar el informe, no solo la cifra.',
			'Reclamación formal a la aseguradora antes de ir más lejos.',
			'Seguimiento del expediente, las comunicaciones y los plazos.',
		],
	},
	{
		title: 'El peritaje contradictorio: cuándo conviene un perito propio',
		content: 'La aseguradora valora el daño con su propio perito, y esa valoración no es neutral. Si el importe ofrecido no cuadra con el alcance real del daño, cabe designar un perito de parte y plantear una tasación contradictoria. En daños importantes, la diferencia de criterio suele ser la clave del caso y se aprecia mucho mejor antes de aceptar la indemnización.',
		points: [
			'Designar perito propio cuando la oferta queda lejos del daño.',
			'La peritación contradictoria ordena el desacuerdo técnico.',
			'No aceptar la indemnización sin una segunda valoración.',
		],
	},
	{
		title: 'Los intereses por mora del artículo 20 de la Ley de Contrato de Seguro',
		content: 'Cuando la aseguradora retrasa el pago o la indemnización ofrecida queda por debajo de la que finalmente se reconoce, la Ley de Contrato de Seguro prevé en su artículo 20 unos intereses de demora a cargo de la entidad. Por eso la reclamación no debe limitarse a la cifra del siniestro: también se pide lo que la demora ha generado.',
		points: [
			'El retraso injustificado tiene un coste para la aseguradora.',
			'Los intereses de demora se acumulan a la indemnización.',
			'Conviene reclamarlos expresamente: no se conceden solos.',
		],
	},
];

const faqs = [
	{
		question: '¿Cuánto tiempo tengo para reclamar un siniestro?',
		answer: 'El plazo depende del tipo de seguro, la póliza y la normativa aplicable. Es importante comunicar el hecho y conservar el justificante dentro del plazo previsto.',
	},
	{
		question: '¿Puedo reclamar si la aseguradora rechaza la cobertura?',
		answer: 'Sí, puede solicitarse una explicación sobre los motivos de la negativa y estudiarse la vía de reclamación o recurso que corresponda al contrato.',
	},
	{
		question: '¿Qué documentación conviene guardar?',
		answer: 'Ayuda guardar la póliza, partes, fotos, facturas, informes, recibos y comunicaciones. También es importante identificar el número de expediente y las fechas de los hechos.',
	},
	{
		question: '¿Se puede reclamar por un daño cubierto por el seguro?',
		answer: 'Debe revisarse si el daño está cubierto, si se cumplen las condiciones del contrato y si existe prueba suficiente. El análisis debe hacerse con la póliza y la documentación completa.',
	},
	{
		question: '¿Conviene aceptar la oferta antes de consultar el caso?',
		answer: 'En daños pequeños y claros puede ser razonable. En siniestros con lesiones, con daños peritados por debajo de su alcance real o con coberturas discutidas, aceptar suele cerrar el expediente y dificultar la reclamación de la diferencia. Conviene revisar la póliza y la valoración antes de firmar.',
	},
];

const related = [
	{ label: 'Reclamaciones de consumo', href: '/consumo', description: 'Información general sobre reclamaciones de consumo.' },
	{ label: 'Reclamaciones bancarias', href: '/reclamaciones-bancarias', description: 'Reclamaciones relacionadas con productos y servicios bancarios.' },
	{ label: 'Seguro de hogar', href: '/blog/reclamaciones-seguro-hogar', description: 'Guía sobre daños y reclamaciones de seguros de hogar.' },
];
---

<SeoLegalPage
	title="Abogado de Seguros en Lucena | Reclama a tu Aseguradora"
	description="Indemnización denegada, peritaje bajo o póliza impagada: reclamamos a tu aseguradora en Lucena y Córdoba. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Consumo y seguros"
	headline="Reclamaciones de seguros"
	intro="Si una aseguradora rechaza, retrasa o reduce un siniestro, conviene revisar la póliza y la documentación. Analizamos la cobertura y preparamos una reclamación clara."
	highlights={highlights}
	serviceType="Asesoría en reclamaciones de seguros"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
	guides={['reclamaciones-seguro-hogar', 'reclamar-agroseguro', 'seguro-cultivos-agroseguro']}
/>
