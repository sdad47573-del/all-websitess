---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Empresas', href: '/empresas' },
	{ label: 'Modificación de estatutos', href: '/modificacion-estatutos-sociedad' },
];

const highlights = [
	'Revisión de la situación societaria y del cambio solicitado',
	'Preparación de la junta, acuerdo y documentación',
	'Asesoramiento sobre publicación y efectos',
];

const sections = [
	{
		title: 'Modificación de estatutos de una sociedad',
		content: 'Los estatutos recogen normas fundamentales de la sociedad. Su modificación puede ser necesaria para cambiar el objeto, el capital, el órgano de administración, las personas de la empresa o la forma de organizar la sociedad.',
		points: [
			'Objeto social, denominación y domicilio.',
			'Capital, participaciones y transmisiones.',
			'Órganos de administración y representación.',
			'Derechos de voto, protección y régimen de acuerdos.',
		],
	},
	{
		title: 'Cómo se tramita la modificación',
		content: 'La modificación suele requerir un acuerdo de la junta general en los términos previstos por la normativa y los estatutos. Deben vigilarse la convocatoria, el quórum, la mayoría y la documentación que se presenta.',
	},
	{
		title: 'Documentación y efectos',
		content: 'Después del acuerdo pueden ser necesarios la escritura, la firma, la presentación y la publicación. También debe comprobarse si el cambio afecta a registros, contratos, licencias o personas que actuaban por la empresa.',
	},
	{
		title: 'Asesoramiento preventivo',
		content: 'Antes de modificar los estatutos conviene revisar los pactos entre socios, los derechos preferentes y las consecuencias fiscales o administrativas. Una modificación mal preparada puede generar problemas posteriores.',
	},
	{
		title: 'Qué cambios exigen escritura e inscripción',
		content: 'No todo cambio interno obliga a modificar los estatutos. Los que afectan a la denominación, el domicilio, el objeto, el capital, la administración o la forma de organizar la sociedad sí requieren acuerdo de la junta, escritura pública e inscripción en el Registro Mercantil para ser oponibles frente a terceros. Los acuerdos que solo desarrollan los estatutos vigentes se resuelven en el acta correspondiente.',
		points: [
			'Denominación, domicilio y objeto social.',
			'Capital, participaciones y transmisiones.',
			'Administradores y forma de organizar el órgano.',
			'Inscripción para que el cambio sea oponible a terceros.',
		],
	},
	{
		title: 'Convocatoria, mayorías y acuerdo',
		content: 'La validez del acuerdo depende de tres piezas: que la junta se convoque conforme a la ley y a los estatutos, que exista el quórum requerido y que la votación alcance la mayoría que la ley exige para modificar estatutos. Esa mayoría es más exigente que la de un acuerdo ordinario y puede serlo aún más si los propios estatutos la elevan. Un acta incompleta obliga a repetir la junta y retrasa todo el proceso.',
		points: [
			'Convocatoria conforme a la ley y a los estatutos.',
			'Quórum y mayoría aplicables al acuerdo.',
			'Acta con el resultado exacto de la votación.',
			'Estatutos que exigen mayorías superiores.',
		],
	},
	{
		title: 'Cambio de objeto, capital y administradores',
		content: 'Cada modificación tiene su propia carga documental. El cambio de objeto exige describir con precisión la nueva actividad, porque de ella dependen licencias, seguros y contratos. La ampliación o reducción de capital obliga a cuidar la suscripción, los desembolsos y, en su caso, el derecho de preferencia de los socios. El cambio de administradores exige revisar el nombramiento, la aceptación del cargo y las facultades de representación.',
		points: [
			'Nueva actividad y su encaje en licencias y seguros.',
			'Suscripción, desembolsos y derecho de preferencia.',
			'Nombramiento, aceptación del cargo y facultades.',
			'Efectos sobre contratos y cuentas bancarias.',
		],
	},
];

const faqs = [
	{
		question: '¿Cuándo es obligatorio modificar los estatutos?',
		answer: 'Debe estudiarse cuando cambia un aspecto social básico o cuando la normativa lo exige. Esto puede incluir la actividad, el capital, los órganos o los socios.',
	},
	{
		question: '¿Quién puede aprobar una modificación?',
		answer: 'La aprobación corresponde al órgano competente según la normativa y los estatutos, normalmente la junta general. Deben respetarse la convocatoria, el quórum y la mayoría aplicable.',
	},
	{
		question: '¿Cuándo se publica la modificación?',
		answer: 'La comunicación o publicación depende del tipo de sociedad y del cambio realizado. Conviene revisar las obligaciones registrales y la comunicación a terceros.',
	},
	{
		question: '¿Puede modificarse un acuerdo de socios?',
		answer: 'Puede estudiarse si existe acuerdo y si la normativa permite modificarlo. Primero deben revisarse las condiciones de los pactos y las consecuencias para los socios.',
	},
	{
		question: '¿Hace falta junta para cambiar los estatutos?',
		answer: 'Sí, la modificación de estatutos es competencia de la junta general, que debe convocarse conforme a la ley y a los estatutos y aprobar el cambio con la mayoría aplicable. En sociedades con pocos socios suele resolverse en una sola junta, pero el acta y la votación deben quedar bien documentadas para elevarla a escritura pública.',
	},
];

const related = [
	{ label: 'Empresas', href: '/empresas', description: 'Servicios jurídicos para empresas y negocios.' },
	{ label: 'Constitución de sociedades', href: '/empresas/constitucion-sociedades', description: 'Asesoría para crear y organizar una sociedad.' },
	{ label: 'Pactos de socios', href: '/blog/pactos-de-socios-sl', description: 'Acuerdos y organizaciones internas.' },
];
---

<SeoLegalPage
	title="Abogado para Modificar Estatutos de Sociedad en Lucena | Scruz"
	description="Cambio de objeto, capital o administradores: preparamos la junta, el acuerdo y la escritura para modificar estatutos en Lucena. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho mercantil"
	headline="Modificación de estatutos de una sociedad"
	intro="Cambiar los estatutos puede afectar al gobierno, la propiedad y la actividad de una empresa. Te ayudamos a preparar el acuerdo y la documentación necesaria."
	highlights={highlights}
	serviceType="Asesoría para modificar estatutos sociales"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
	guides={['pactos-de-socios-sl', 'cuanto-cuesta-constituir-sl-2026', 'responsabilidad-administradores-sl']}
/>
