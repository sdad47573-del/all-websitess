---
import a1 from '../@assets/1.webp';
import { SITE_URL } from '../data/site';
import a989d02214a23b9fee68a2091ed7e3368 from '../@assets/989d02214a23b9fee68a2091ed7e3368.webp';
import { getImage, Image } from '../@astro-components/index.ts';
import SecondaryHero from '../components/SecondaryHero.astro';
import TrayectoryTimeline from '../components/TrayectoryTimeline.astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import CtaBand from '../components/CtaBand.astro';
import { Award, Check, Clock, ShieldCheck, UserRound } from '@lucide/astro';

const optimized = await getImage({ src: a1, width: 700, format: 'webp' });
---

<CustomLayout
	title="Nuestra trayectoria | +20 años defendiendo tus derechos"
	description="Más de dos décadas de experiencia jurídica en Andalucía. Conoce la trayectoria y los valores de Scruz Abogados."
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Trayectoria', url: '/trayectoria/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'AboutPage',
			'@id': `${SITE_URL}/trayectoria/#aboutpage`,
			url: `${SITE_URL}/trayectoria/`,
			name: 'Nuestra Trayectoria',
			description:
				'Más de 20 años de experiencia jurídica en Andalucía. Valores: integridad, cercanía, excelencia y compromiso.',
		},
	]}
>
	<SecondaryHero
		title="Nuestra Trayectoria"
		description="Más de dos décadas ofreciendo servicios jurídicos de calidad con un enfoque humano y profesional"
		background={optimized.src}
	/>
	<section id="experiencia" class="bg-white py-20">
		<div class="mx-auto max-w-7xl px-6 md:px-16">
			<div class="reveal grid items-center gap-12 lg:grid-cols-2">
				<div>
					<p class="eyebrow">Bufete Scruz Abogados</p>
					<h2 class="font-title mb-6 text-3xl font-bold leading-tight md:text-4xl lg:text-5xl">+20 Años de Experiencia</h2><p
						class="mb-8 text-xl text-gray-600"
					>
						Nuestro compromiso con la excelencia jurídica y la satisfacción del cliente nos ha
						posicionado como uno de los bufetes más confiables de la región.						</p><div class="reveal-pop mb-8 grid grid-cols-2 gap-8">
						<div class="text-center">
							<div class="text-primary mb-2 text-4xl font-bold">1000+</div><div
								class="text-gray-600"
							>
								Casos Resueltos
							</div>
						</div><div class="text-center">
							<div class="text-primary mb-2 text-4xl font-bold">98%</div><div class="text-gray-600">
								Satisfacción Cliente
							</div>
						</div><div class="text-center">
							<div class="text-primary mb-2 text-4xl font-bold">20+</div><div class="text-gray-600">
								Años Experiencia
							</div>
						</div><div class="text-center">
							<div class="text-primary mb-2 text-4xl font-bold">24/7</div><div
								class="text-gray-600"
							>
								Disponibilidad
							</div>
						</div>
					</div><div class="space-y-4">
						<div class="flex items-center">
							<Check class="mr-3 size-5 text-green-600" /><span class="text-gray-700"
								>Colegiado en el Ilustre Colegio de Abogados</span
							>
						</div><div class="flex items-center">
							<Check class="mr-3 size-5 text-green-600" /><span class="text-gray-700"
								>Especialización en múltiples áreas del derecho</span
							>
						</div><div class="flex items-center">
							<Check class="mr-3 size-5 text-green-600" /><span class="text-gray-700"
								>Formación continua y actualización jurídica</span
							>
						</div><div class="flex items-center">
							<Check class="mr-3 size-5 text-green-600" /><span class="text-gray-700"
								>Atención personalizada y cercana</span
							>
						</div>
					</div>					</div>{/*
						El retrato va sin animaciones a propósito: llevaba `reveal-pop`, que
						destapaba la foto con un barrido clip-path de 0,7 s y una escala de 0.97 a 1.
						Se mantiene `relative` porque el degradado de encima es `absolute inset-0`.
					*/}<div class="relative">
					{/*
						El original es un retrato vertical (940x1356). Al pedir width + height
						(900x600) Astro delega en sharp con fit=cover y recorta la imagen: se
						perdía la parte inferior y el señor no se veía completo. Dejamos que
						conserve su proporción natural para mostrar el retrato entero, como antes.
					*/}
					<Image
						alt="Abogado profesional"
						class="w-full rounded-xl shadow-2xl"
						src={a989d02214a23b9fee68a2091ed7e3368}
					/><div class="absolute inset-0 rounded-xl bg-gradient-to-t from-black/20 to-transparent">
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="py-20">
		<div class="mx-auto max-w-7xl px-6 md:px-16">				<div class="reveal-pop mb-20">
					<p class="eyebrow eyebrow--center mb-3">Cómo trabajamos</p>
				<h2 class="mb-12 text-center font-title text-3xl font-bold md:text-4xl lg:text-5xl">
					Nuestros Valores					</h2><div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>						<div class="reveal-pop text-center">
							<div
								class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100"
							>
								<ShieldCheck class="text-primary size-8" />
						</div><h3 class="mb-3 text-xl font-bold text-gray-900">Integridad</h3><p
							class="text-gray-600"
						>
							Actuamos con transparencia y honestidad en cada caso, manteniendo siempre los más
							altos estándares éticos.
						</p>
					</div>						<div class="reveal-pop text-center">
							<div
								class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100"
							>
								<UserRound class="text-primary size-8" />
						</div><h3 class="mb-3 text-xl font-bold text-gray-900">Cercanía</h3><p
							class="text-gray-600"
						>
							Tratamos a cada cliente como único, ofreciendo un servicio personalizado y humano.
						</p>
					</div>						<div class="reveal-pop text-center">
							<div
								class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100"
							>
								<Award class="text-primary size-8" />
						</div><h3 class="mb-3 text-xl font-bold text-gray-900">Excelencia</h3><p
							class="text-gray-600"
						>
							Buscamos constantemente la excelencia en nuestro trabajo, manteniéndonos actualizados
							en las últimas normativas.
						</p>
					</div>						<div class="reveal-pop text-center">
							<div
								class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100"
							>
								<Clock class="text-primary size-8" />
						</div><h3 class="mb-3 text-xl font-bold text-gray-900">Compromiso</h3><p
							class="text-gray-600"
						>
							Nos comprometemos con los plazos y resultados, trabajando incansablemente por nuestros
							clientes.
						</p>
					</div>
				</div>
			</div>
			<TrayectoryTimeline />				<div class="reveal-pop rounded-2xl bg-gray-50 p-8 md:p-12">
					<div class="text-center">
					<p class="eyebrow eyebrow--center mb-3">Nuestro compromiso</p>
					<h2 class="mb-6 font-title text-3xl font-bold md:text-4xl lg:text-5xl">Nuestra Misión</h2><p
						class="mx-auto mb-8 max-w-4xl text-xl text-gray-600"
					>
						Proporcionar servicios jurídicos de la más alta calidad, combinando experiencia,
						profesionalidad y cercanía humana. Nuestro objetivo es ser el socio legal de confianza
						que acompañe a nuestros clientes en cada etapa de sus vidas profesionales y personales.						</p><div class="reveal-pop mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
						<div class="text-center">
							<div class="text-primary mb-2 text-4xl font-bold">20+</div><div class="text-gray-600">
								Años de Experiencia
							</div>
						</div><div class="text-center">
							<div class="text-primary mb-2 text-4xl font-bold">2</div><div class="text-gray-600">
								Oficinas
							</div>
						</div><div class="text-center">
							<div class="text-primary mb-2 text-4xl font-bold">1000+</div><div
								class="text-gray-600"
							>
								Casos Resueltos
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<CtaBand
		eyebrow="Estamos a tu lado"
		title="¿Quieres conocer más?"
		description="Agenda una consulta gratuita y descubre cómo nuestro equipo puede ayudarte con tus necesidades legales."
		primary={{ label: 'Consulta gratuita', href: 'tel:+34666329155' }}
		secondary={{ label: 'Ver servicios', href: '/servicios/' }}
	/>

	<ServiceBlogGuides />
</CustomLayout>
