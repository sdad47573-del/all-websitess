---
import heroImg from '@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	Briefcase,
	Clock,
	Euro,
	FileCheck,
	FilePenLine,
	Gavel,
	PiggyBank,
	Receipt,
	Scale,
	ShieldAlert,
	Wallet,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Cuánto cuesta reclamar una deuda impagada?',
		answer:
			'Trabajamos con presupuestos cerrados según la cuantía y la vía procesal. En pequeños impagos el procedimiento monitorio tiene unos costes reducidos y la reclamación previa (burofax) es muy económica. Si el deudor se opone, los costes suben pero los intereses de demora suelen compensar la inversión. Te informamos por escrito de las opciones antes de empezar.',
	},
	{
		question: '¿Qué pasa si el deudor se declara insolvente?',
		answer:
			'Cuando el deudor no tiene bienes conocidos, investigamos su patrimonio: cuentas bancarias, inmuebles, vehículos, ingresos y deudas con otros acreedores. Si descubrimos bienes ocultos o alzamiento, podemos perseguir al deudor personal y reanudar la reclamación. También cabe la responsabilidad de administradores o representantes legales en el caso de empresas.',
	},
	{
		question: '¿Cuándo prescribe una factura impagada?',
		answer:
			'El plazo general de prescripción es de 5 años desde que la factura pudo ser exigida (normalmente desde la fecha de vencimiento pactada o, en su defecto, desde su emisión). Para deudas documentadas en cheques, pagarés o letras de cambio los plazos varían entre 3 meses y 5 años según el caso. Te confirmamos el plazo aplicable tras el estudio del documento.',
	},
	{
		question: '¿Puedo reclamar facturas sin firmar?',
		answer:
			'Sí. La firma en una factura no es imprescindible para reclamar la deuda, pero sí es muy útil: facilita la prueba del contrato y de la prestación. Cuando no hay firma, aportamos otros medios de prueba: correos, albaranes firmados, transferencias, fotos, testificales y cualquier documento que acredite la existencia de la deuda.',
	},
	{
		question: '¿Cómo funciona el procedimiento monitorio?',
		answer:
			'El monitorio permite reclamar deudas dinerarias (hasta 250.000 €) sin necesidad de abogado y procurador en primera instancia: presentas la solicitud con la factura y otros documentos, el juzgado requiere de pago al deudor y, si este no paga ni se opone, se despacha ejecución con embargos. Si se opone, el caso pasa a juicio verbal u ordinario.',
	},
	{
		question: '¿Qué intereses puedo reclamar?',
		answer:
			'Intereses de demora según Ley 3/2004 (3 puntos por encima del interés legal del dinero para empresas) y, en su caso, los intereses pactados en el contrato. Los tribunales también reconocen el derecho a reclamar el coste de los servicios jurídicos y de procurador cuando la deuda es de empresa a profesional o entre profesionales.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: Clock, label: 'Reclamación', value: 'Rápida y eficaz' },
	{ Icon: ShieldAlert, label: 'Vías', value: 'Extrajudicial + judicial' },
	{ Icon: Wallet, label: 'Coste', value: 'Presupuesto cerrado' },
];

const plazos = [
	{
		Icon: Clock,
		title: '5 años',
		description: 'Plazo general para reclamar deudas de dinero (art. 1966 CC).',
	},
	{
		Icon: FileCheck,
		title: '20 días',
		description: 'Para que el deudor pague o se oponga en el procedimiento monitorio.',
	},
	{
		Icon: Scale,
		title: '3 puntos',
		description: 'Interés de demora aplicable entre empresarios desde la Ley 3/2004.',
	},
];

const conceptos = [
	{
		Icon: FilePenLine,
		title: 'Requerimiento fehaciente',
		description:
			'Enviamos burofax con acuse de recibo y certificación de contenido para que conste fehacientemente la interpelación de pago. Es el primer paso antes de la vía judicial.',
	},
	{
		Icon: Gavel,
		title: 'Procedimiento monitorio',
		description:
			'Reclamación rápida para deudas dinerarias con documento que la acredite. Si el deudor no se opone, despachamos ejecución y embargamos sus cuentas y bienes.',
	},
	{
		Icon: Briefcase,
		title: 'Juicio verbal y ordinario',
		description:
			'Cuando el deudor se opone al monitorio o la cuantía supera su límite, promovemos el juicio que corresponda. Reclamamos principal, intereses y costas.',
	},
	{
		Icon: Receipt,
		title: 'Ejecución y embargo',
		description:
			'Logramos el embargo de cuentas corrientes, sueldos, vehículos, inmuebles y cualquier bien del deudor que aparezca en la investigación patrimonial.',
	},
	{
		Icon: PiggyBank,
		title: 'Investigación de solvencia',
		description:
			'Consultamos el Registro de la Propiedad, el catastral, el mercantil y otros registros públicos para localizar bienes del deudor y diseñar la mejor estrategia de ejecución.',
	},
	{
		Icon: Euro,
		title: 'Intereses de demora',
		description:
			'Reclamamos los intereses legales o los pactados en el contrato, cuando proceda. En operaciones entre empresas aplicamos el tipo previsto en la Ley 3/2004.',
	},
];

const pasos = [
	{
		number: '01',
		title: 'Análisis y viabilidad',
		description:
			'Estudiamos la documentación de la deuda, identificamos la vía procesal más rápida y te informamos de plazos y probabilidades de éxito.',
	},
	{
		number: '02',
		title: 'Requerimiento extrajudicial',
		description:
			'Enviamos burofax con interpelación de pago y adjuntamos la documentación. Muchos deudores pagan en cuanto reciben este requerimiento formal.',
	},
	{
		number: '03',
		title: 'Vía judicial',
		description:
			'Si el deudor no paga, iniciamos un monitorio o, si procede, un juicio verbal u ordinario. Reclamamos principal, intereses y costas procesales.',
	},
	{
		number: '04',
		title: 'Ejecución forzosa',
		description:
			'Una vez conseguida la sentencia o el decreto del monitorio, despachamos ejecución: embargos de cuentas, sueldos, vehículos e inmuebles hasta cobrar la totalidad.',
	},
];

const why = [
	{
		Icon: Clock,
		title: 'Rapidez de actuación',
		description:
			'Actuamos en las horas siguientes a tu primera consulta. En el mundo de la empresa, cada día que pasa es un día más sin cobrar.',
	},
	{
		Icon: PiggyBank,
		title: 'Investigación exhaustiva',
		description:
			'Realizamos una búsqueda patrimonial completa de tu deudor: cuentas, inmuebles, vehículos y vinculaciones societarias para garantizar el cobro.',
	},
	{
		Icon: Wallet,
		title: 'Alta tasa de recuperación',
		description:
			'Combinamos la presión extrajudicial con la estrategia procesal más eficaz. Nuestro objetivo es único: que cobres lo que es tuyo.',
	},
];

const rangos = [
	{ title: 'Reclamación amistosa', value: '1 — 4 semanas', note: 'Burofax y negociación' },
	{ title: 'Procedimiento monitorio', value: '2 — 6 meses', note: 'Hasta el decreto de ejecución' },
	{ title: 'Juicio verbal / ordinario', value: '4 — 12 meses', note: 'Hasta sentencia firme' },
	{ title: 'Ejecución y embargo', value: '3 — 9 meses', note: 'Cobro efectivo' },
];
---

<CustomLayout
	title="Abogado de Cobro de Deudas e Impagos en Lucena"
	description="Abogado de cobro de deudas e impagos en Lucena, Córdoba y Málaga: reclamación de cantidad, procedimiento monitorio y ejecución. Consulta gratuita: 666 329 155."
	keywords="cobro deudas Lucena, monitorio Córdoba, embargo impago Málaga, reclamación facturas, abogado deudas Andalucía, vía ejecutiva"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Cobro de Deudas', url: '/cobro-deudas-impagos/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/cobro-deudas-impagos/#service`,
			url: `${SITE_URL}/cobro-deudas-impagos/`,
			name: 'Reclamación extrajudicial y judicial de deudas',
			description:
				'Cobro de deudas impagadas mediante requerimientos extrajudiciales, procedimiento monitorio, ejecutivo y embargos.',
			serviceType: 'Reclamación de deudas',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Abogado especializado en reclamación de deudas e impagos"
		supertitle="Derecho de obligaciones · Cobro de deudas"
		description="Recuperamos tu dinero con todos los medios a nuestro alcance: requerimiento extrajudicial, monitorio, vía ejecutiva y embargos."
		stats={heroStats}
	>
		<span slot="title">Abogado de cobro de deudas e impagos en Lucena: <span class="text-primary">recupera tu dinero.</span></span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'Reclamamos tus impagados con <span class="text-primary">contundencia y agilidad</span>.'}
		factboxSupertitle="Lo que debes saber"
		factboxTitle="Plazos clave"
		factboxItems={plazos}
	>
		<p class="mb-4">
			Si un cliente, empresa o particular no paga, no esperes más. El impago corroe tu
			rentabilidad y puede llegar a poner en riesgo la continuidad de tu negocio o las
			necesidades de tu familia. Actuamos con contundencia y agilidad para recuperar lo
			que es tuyo, utilizando todas las vías legales a nuestro alcance.
		</p>
		<p class="mb-4">
			Nuestros servicios incluyen la reclamación amistosa profesional (burofax con
			acuse), el procedimiento monitorio para deudas acreditadas, la promoción de juicio
			verbal u ordinario cuando el deudor se opone, la investigación patrimonial
			completa y, en última instancia, la ejecución forzosa con embargo de cuentas,
			sueldos, vehículos e inmuebles hasta conseguir la recuperación efectiva.
		</p>
		<p>
			Además de la cantidad adeudada, reclamamos los intereses de demora, los intereses
			pactados en el contrato y las costas procesales cuando es posible. Cada caso lo
			tramitamos con presupuesto cerrado y, sobre todo, con el objetivo único de que
			recupere cada euro que te pertenece.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué reclamamos"
		title="Servicios de cobro"
		description="Cobertura completa del itinerario de una deuda impagada: reclamación amistosa, reclamación judicial y ejecución forzosa."
		items={conceptos}
	/>

	<EditorialMeasures
		supertitle="Tiempos orientativos"
		title="Plazos habituales del proceso"
		description="Estimación realista de los plazos que maneja cada fase del proceso de reclamación y ejecución. Cada caso se confirma tras el estudio inicial."
		valueFormat="single-currency"
		noteLabel="Plazo orientativo."
		disclaimer="Tiempos aproximados. La duración real depende de la complejidad de la deuda, la oposición del deudor y la carga de los juzgados."
		items={rangos}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="De la primera nota de impago al cobro"
		items={pasos}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Una deuda impagada, una deuda por cobrar."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Resolvemos tus dudas"
		description="Las preguntas más habituales sobre cobro de deudas, monitorio, intereses de demora y sentencias firmes."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Recupera lo que es tuyo"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Analizamos tu caso de impago, te informamos de las opciones y ponemos en marcha la estrategia más eficaz."
		relatedLinks={[
			{ label: 'Monitorio: guía completa', href: '/blog/reclamacion-deudas-monitorio/' },
			{ label: 'Empresas', href: '/empresas/' },
			{ label: 'Compraventas de empresas', href: '/compraventas-empresas/' },
		]}
	/>
</CustomLayout>
