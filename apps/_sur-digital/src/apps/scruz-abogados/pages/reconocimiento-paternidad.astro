---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Derecho de familia', href: '/divorcios-separaciones' },
	{ label: 'Reconocimiento de paternidad', href: '/reconocimiento-paternidad' },
];

const highlights = [
	'Revisión de las circunstancias y la vía de reconocimiento',
	'Preparación de la solicitud y de la documentación',
	'Asesoramiento sobre efectos familiares y medidas relacionadas',
];

const sections = [
	{
		title: 'Asesoría para el reconocimiento de paternidad',
		content: 'El reconocimiento de paternidad puede hacerse de forma voluntaria o mediante un procedimiento judicial. Antes de elegir la vía conviene revisar si existe un documento previo, la fecha de nacimiento, la identidad de las partes y la documentación disponible.',
		points: [
			'Documento privado, reconocimiento judicial o prueba genética.',
			'Efectos sobre la responsabilidad parental y económica.',
			'Relación con el procedimiento y la documentación.',
			'Acuerdos sobre alimentos, guarda y visitas.',
		],
	},
	{
		title: 'Reconocimiento voluntario y judicial',
		content: 'El reconocimiento voluntario exige revisar el documento y su eficacia. Si hay desacuerdo o no existe acuerdo, puede ser necesario un procedimiento judicial. En ambos casos, la prueba y la documentación deben estar orientadas a acreditar los hechos relevantes.',
	},
	{
		title: 'Efectos para el menor y la familia',
		content: 'El reconocimiento puede tener efectos importantes en la filiación, la responsabilidad parental y las obligaciones económicas. También puede ser necesario revisar medidas existentes. La estrategia debe tener en cuenta el interés del menor y la situación real de la familia.',
	},
	{
		title: 'Documentación y seguimiento',
		content: 'Conviene reunir documentos de identidad, partida o documentación del nacimiento, certificados, mensajes y cualquier acuerdo existente. Si hay una actuación judicial, deben controlarse las notificaciones, las pruebas y los plazos aplicables.',
	},
	{
		title: 'El reconocimiento voluntario ante el Registro Civil',
		content: 'El reconocimiento voluntario se formaliza en el Registro Civil o en el documento que la normativa admite, y exige comprobar antes qué requisitos se cumplen. En el caso de menores puede ser necesario el consentimiento de quien ostenta su representación legal, y el encargado del Registro revisa los requisitos antes de practicar la inscripción.',
		points: [
			'Identificación de las partes y documentación del nacimiento.',
			'Posible consentimiento del representante legal del menor.',
			'Revisión de los requisitos antes de firmar el documento.',
			'Comprobación de que no existe un reconocimiento previo incompatible.',
		],
	},
	{
		title: 'El reconocimiento judicial y las pruebas biológicas',
		content: 'Si existe oposición, silencio o duda sobre la filiación, el camino es un procedimiento judicial en el que se practican las pruebas que el juzgado admita. Las pruebas biológicas deben practicarse con las garantías que exige el proceso, así que no sirve cualquier muestra obtenida por cuenta propia: conviene plantearlo bien desde el inicio.',
		points: [
			'Demanda o solicitud con los hechos y la documentación disponibles.',
			'Pruebas biológicas con las garantías del procedimiento.',
			'Declaraciones, documentos y otras pruebas complementarias.',
			'Medidas sobre alimentos, guarda y visitas mientras se decide.',
		],
	},
	{
		title: 'Qué cambia tras el reconocimiento: apellidos, alimentos y herencia',
		content: 'El reconocimiento produce efectos en la filiación y, con ello, en los apellidos, en la responsabilidad parental y en las obligaciones de alimentos. También abre derechos sucesorios y puede obligar a revisar medidas ya acordadas o incluso repartos anteriores que se hicieron sin tener en cuenta al hijo.',
		points: [
			'Filiación e inscripción con los apellidos que correspondan.',
			'Alimentos, guarda y régimen de visitas que deban fijarse.',
			'Derechos hereditarios y su incidencia en una herencia ya repartida.',
			'Prestaciones o resoluciones administrativas que puedan revisarse.',
		],
	},
];

const faqs = [
	{
		question: '¿Puede reconocerse la paternidad de común acuerdo?',
		answer: 'Sí, puede estudiarse un reconocimiento voluntario mediante el documento y el procedimiento que correspondan. El documento debe ser válido y sus efectos deben explicarse claramente.',
	},
	{
		question: '¿Es necesaria una prueba genética?',
		answer: 'No siempre. La vía y las pruebas disponibles dependen de las circunstancias. Un profesional debe revisar si existe acuerdo, documentación o pruebas que permitan acreditar la filiación.',
	},
	{
		question: '¿Qué efectos tiene el reconocimiento?',
		answer: 'Puede producir efectos legales relacionados con la filiación, la responsabilidad parental y la economía familiar. La presentación y el alcance deben revisarse según el caso.',
	},
	{
		question: '¿Puede pedirse una prueba genética?',
		answer: 'Puede estudiarse si la vía y la normativa aplicables permiten solicitar una prueba. La solicitud debe plantearse con un motivo jurídico y la documentación adecuada.',
	},
	{
		question: '¿Hace falta el consentimiento del hijo mayor de edad?',
		answer: 'Sí. Cuando se reconoce a una persona mayor de edad es necesario su consentimiento expreso o tácito, porque se trata de una decisión que afecta directamente a su filiación. Sin ese consentimiento hay que valorar otras vías y estudiar qué procedimiento resulta adecuado.',
	},
];

const related = [
	{ label: 'Divorcios y separaciones', href: '/divorcios-separaciones', description: 'Procesos de separación y divorcio.' },
	{ label: 'Pensión de alimentos', href: '/pension-de-alimentos', description: 'Fijación y reclamación de alimentos.' },
	{ label: 'Guarda y custodia', href: '/guarda-custodia', description: 'Organización de la responsabilidad parental.' },
];
---

<SeoLegalPage
	title="Abogado de Reconocimiento de Paternidad en Lucena y Córdoba"
	description="Reconocimiento de paternidad voluntario o judicial: pruebas de ADN, documentos, plazos y efectos legales. Abogado de familia en Lucena: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho de familia"
	headline="Reconocimiento de paternidad"
	intro="El reconocimiento de paternidad puede ser voluntario o judicial y tiene efectos importantes para el menor y la familia. Revisamos tu situación y la documentación disponible."
	highlights={highlights}
	serviceType="Asesoría para reconocimiento de paternidad"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
	guides={['medidas-paterno-filiales', 'custodia-compartida-cordoba', 'pension-de-alimentos']}
/>
