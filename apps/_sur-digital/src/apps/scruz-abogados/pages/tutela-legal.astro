---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Derecho de familia', href: '/divorcios-separaciones' },
	{ label: 'Tutela legal', href: '/tutela-legal' },
];

const highlights = [
	'Revisión de la situación y de las medidas necesarias',
	'Asesoramiento sobre aceptación y responsabilidad del tutor',
	'Preparación de la solicitud y seguimiento del expediente',
];

const sections = [
	{
		title: 'Asesoría sobre tutela legal',
		content: 'La tutela legal es una medida de protección para menores o personas adultas que no pueden ejercer sus derechos por sí mismas. La solicitud debe valorar la situación, las personas disponibles y las medidas más adecuadas para proteger a la persona afectada.',
		points: [
			'Necesidad y alcance de la medida de protección.',
			'Documentación médica, familiar y administrativa.',
			'Elección y aceptación de la tutela.',
			'Responsabilidades económicas y relación con la persona tutelada.',
		],
	},
	{
		title: 'Solicitud y medidas de protección',
		content: 'Antes de solicitar una tutela conviene estudiar si existen medidas menos restrictivas y si hay un plan adecuado para la persona tutelada. La solicitud debe explicar la situación y aportar la documentación que permita valorarla correctamente.',
	},
	{
		title: 'Responsabilidad y administración',
		content: 'La persona tutelada debe recibir los cuidados y la protección adecuada. El tutor debe cumplir las obligaciones legales, administrar los bienes y presentar la información correspondiente según proceda. Las decisiones importantes deben revisarse y justificarse.',
	},
	{
		title: 'Revisión y seguimiento',
		content: 'La situación puede cambiar y exigir una revisión de la tutela. También pueden ser necesarias decisiones sobre salud, educación, propiedades o beneficios. Conviene controlar las notificaciones y el seguimiento del expediente.',
	},
	{
		title: 'Cuándo se necesita un tutor y quién puede promoverlo',
		content: 'La tutela se plantea cuando una persona menor de edad no tiene quien ejerza la patria potestad, o cuando una persona adulta no puede decidir ni administrar sus asuntos por sí misma. Pueden promoverla los familiares, el Ministerio Fiscal o la propia Administración cuando conoce la situación, y la iniciativa debe explicar por qué esa figura es la adecuada.',
		points: [
			'Menores sin patria potestad ejercida o en situación de desamparo.',
			'Personas adultas con dificultades para decidir o administrar sus bienes.',
			'Familiares, Ministerio Fiscal y otras entidades pueden promoverla.',
			'La propuesta debe valorar antes otras medidas de apoyo menos intensas.',
		],
	},
	{
		title: 'El procedimiento: solicitud, pruebas y audiencia',
		content: 'La solicitud se presenta con la documentación que acredita la situación y, una vez admitida, se practican las pruebas que el juzgado considera necesarias y se escucha a la persona afectada y a los implicados. El Ministerio Fiscal interviene en el expediente y la resolución final determina quién asume la tutela y con qué alcance.',
		points: [
			'Documentación médica, familiar y administrativa de la persona protegida.',
			'Propuesta motivada de tutor y aceptación de quien va a ejercerla.',
			'Audiencia de la persona afectada y de los familiares citados.',
			'Resolución, nombramiento e inscripción en el Registro Civil.',
		],
	},
	{
		title: 'Obligaciones del tutor y control de la tutela',
		content: 'El tutor debe cuidar a la persona tutelada, representarla cuando sea necesario y administrar sus bienes con la misma diligencia que si fueran propios. Su actuación está sujeta a control: determinados actos requieren autorización judicial y hay que rendir cuentas de la gestión, por lo que conviene documentar cada decisión relevante.',
		points: [
			'Cuidado y protección de la persona tutelada.',
			'Administración de los bienes y control de los ingresos y gastos.',
			'Autorización judicial para actos de especial relevancia.',
			'Rendición de cuentas y revisión de la situación cuando cambie.',
		],
	},
];

const faqs = [
	{
		question: '¿Quién puede solicitar una tutela legal?',
		answer: 'La solicitud depende de la situación y de la normativa aplicable. Debe estudiarse quién puede promoverla, qué pruebas son necesarias y qué medidas de protección resultan adecuadas.',
	},
	{
		question: '¿Una tutela puede ser temporal?',
		answer: 'La duración y la revisión dependen de las circunstancias de la persona protegida y de la resolución. Un profesional debe revisar el alcance y las condiciones concretas.',
	},
	{
		question: '¿Qué obligaciones tiene el tutor?',
		answer: 'El tutor debe proteger a la persona tutelada, cuidar de sus intereses y cumplir las obligaciones económicas y administrativas que correspondan. La actuación debe realizarse siempre dentro del ámbito de la tutela.',
	},
	{
		question: '¿Se puede revisar una tutela?',
		answer: 'Puede estudiarse una revisión si cambian las circunstancias o la situación de la persona tutelada. Hay que revisar la resolución y la vía correcta para solicitar cambios.',
	},
	{
		question: '¿Qué diferencia hay entre tutela y curatela?',
		answer: 'La tutela supone una representación amplia para quien no puede actuar por sí mismo; la curatela es una figura de apoyo para quien conserva capacidad pero necesita asistencia en determinados actos. La elección depende del grado de autonomía real de la persona y debe revisarse con la documentación del caso.',
	},
];

const related = [
	{ label: 'Derecho de familia', href: '/divorcios-separaciones', description: 'Información general sobre asuntos familiares.' },
	{ label: 'Modificación de medidas', href: '/modificacion-medidas-paterno-filiales', description: 'Cambios de custodia, visitas y alimentos.' },
	{ label: 'Recursos administrativos', href: '/recursos-administrativos', description: 'Procedimientos y reclamaciones administrativas.' },
];
---

<SeoLegalPage
	title="Abogado de Tutela Legal en Lucena y Córdoba | Scruz Abogados"
	description="Tutela legal de menores y personas adultas que no pueden valerse solas: solicitud, obligaciones del tutor y revisión. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho de familia"
	headline="Tutela legal y protección de menores"
	intro="La tutela legal protege a menores o personas adultas que no pueden ejercer sus derechos de forma adecuada. Te ayudamos a valorar la medida, preparar la solicitud y cumplir las obligaciones."
	highlights={highlights}
	serviceType="Asesoría en tutela legal"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
	guides={['tutela-curatela-discapacidad', 'reforma-discapacidad-dependencia', 'pension-de-alimentos']}
/>
