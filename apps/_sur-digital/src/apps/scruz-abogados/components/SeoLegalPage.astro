---
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from './ServiceBlogGuides.astro';
import defaultImage from '../@assets/OG-DEFAULT-1200x630.webp';

interface LinkItem {
	label: string;
	href: string;
	description: string;
}

interface SeoLegalPageProps {
	title: string;
	description: string;
	breadcrumb: Array<{ label: string; href?: string; name?: string; url?: string }>;
	eyebrow: string;
	headline: string;
	intro: string;
	highlights: string[];
	serviceType: string;
	areaServed: string;
	sections: Array<{
		title: string;
		content: string;
		points?: string[];
	}>;
	faqs: Array<{ question: string; answer: string }>;
	related: LinkItem[];
	image?: string;
	/**
	 * Monta la sección "Guías del blog" con los artículos que enlazan a esta
	 * página (derivados de BLOG_RELATED_SERVICES). Opt-in para no cambiar de
	 * golpe las páginas que aún no lo declaran.
	 */
	showBlogGuides?: boolean;
	/** Guías concretas para páginas sin entrada propia en el grafo de servicios. */
	guides?: string[];
}

const {
	title,
	description,
	breadcrumb,
	eyebrow,
	headline,
	intro,
	highlights,
	serviceType,
	areaServed,
	sections,
	faqs,
	related,
	image = defaultImage.src,
	showBlogGuides = false,
	guides,
}: SeoLegalPageProps = Astro.props as SeoLegalPageProps;

const siteOrigin = Astro.site ?? Astro.url.origin;
// La canonical del layout y la del schema deben coincidir: trailingSlash es
// 'always', así que se conserva la barra final en lugar de recortarla.
const canonical = new URL(Astro.url.pathname, siteOrigin);
const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: serviceType,
	description,
	url: canonical.toString(),
	areaServed,
	provider: {
		'@type': 'LegalService',
		name: 'Sergio Cruz Chacón Abogados',
		url: new URL('/', siteOrigin).toString(),
	},
};
const layoutBreadcrumb = breadcrumb.map((item) => ({
	...item,
	name: item.name ?? item.label,
	url: item.url ?? item.href,
}));

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: faq.answer,
		},
	})),
};
---

<CustomLayout
	{title}
	description={description}
	image={image}
	breadcrumb={layoutBreadcrumb}
	additionalSchemas={[serviceSchema, faqSchema]}
>
	<article class="legal-page">
		<header class="hero">
			<div class="wrap">
				<p class="eyebrow">{eyebrow}</p>
				<h1>{headline}</h1>
				<p class="lead">{intro}</p>
				<div class="actions">
					<a class="button primary" href="/scruz-abogados/#contacto">Solicitar consulta</a>
				</div>
			</div>
		</header>

		<section class="benefits" aria-label="Aspectos clave del servicio">
			<div class="wrap benefits-grid">
				{highlights.map((highlight) => (
					<div class="benefit">
						<span aria-hidden="true">✓</span>
						<p>{highlight}</p>
					</div>
				))}
			</div>
		</section>

		<div class="wrap content">
			{sections.map((section, index) => (
				<section class="content-section" id={index === 0 ? 'informacion' : `contenido-${index + 1}`}>
					<h2>{section.title}</h2>
					<p>{section.content}</p>
					{section.points && section.points.length > 0 && (
						<ul>
							{section.points.map((point) => <li>{point}</li>)}
						</ul>
					)}
				</section>
			))}
		</div>

		<section class="faq-section" aria-labelledby="preguntas-frecuentes">
			<div class="wrap narrow">
				<p class="eyebrow">Resolvemos tus dudas</p>
				<h2 id="preguntas-frecuentes">Preguntas frecuentes</h2>
				<div class="faqs">
					{faqs.map((faq, index) => (
						<details open={index === 0}>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</div>
		</section>

		{(showBlogGuides || (guides?.length ?? 0) > 0) && <ServiceBlogGuides slugs={guides} />}

		{related.length > 0 && (
			<nav class="related" aria-labelledby="temas-relacionados">
				<div class="wrap">
					<h2 id="temas-relacionados">También puede interesarte</h2>
					<div class="related-grid">
						{related.map((item) => (
							<a href={item.href}>
								<strong>{item.label}</strong>
								<span>{item.description}</span>
							</a>
						))}
					</div>
				</div>
			</nav>
		)}

		<aside class="disclaimer">
			<div class="wrap narrow">
				<p><strong>Información legal general.</strong> El contenido de esta página es orientativo y no sustituye el asesoramiento jurídico individualizado. Los plazos y consecuencias dependen de cada caso.</p>
			</div>
		</aside>
	</article>
</CustomLayout>

<style>
	.legal-page {
		color: var(--color-base-content);
		background: var(--color-base-100);
	}

	.wrap {
		width: min(1120px, calc(100% - 2rem));
		margin-inline: auto;
	}

	.narrow {
		max-width: 820px;
	}

	.hero {
		padding: clamp(4rem, 9vw, 7rem) 0;
		color: #fff;
		background:
			radial-gradient(circle at 85% 25%, rgb(198 163 91 / 35%), transparent 28rem),
			linear-gradient(135deg, #0d1c33, #193a5b);
	}

	.eyebrow {
		margin: 0 0 0.8rem;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: #c6a35b;
	}

	h1,
	h2 {
		font-family: var(--font-serif, Georgia, serif);
		line-height: 1.12;
	}

	h1 {
		max-width: 900px;
		margin: 0;
		font-size: clamp(2.4rem, 6vw, 4.7rem);
	}

	.lead {
		max-width: 780px;
		margin: 1.5rem 0 0;
		font-size: clamp(1.05rem, 2vw, 1.3rem);
		line-height: 1.7;
		color: #e6edf5;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 2rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 0.75rem 1.2rem;
		border: 1px solid transparent;
		border-radius: 4px;
		font-weight: 750;
		text-decoration: none;
	}

	.button.primary {
		color: #102039;
		background: #d5b56f;
	}

	.button.secondary {
		color: #fff;
		border-color: rgb(255 255 255 / 55%);
	}

	.benefits {
		background: var(--color-base-200);
		border-bottom: 1px solid var(--color-base-300);
	}

	.benefits-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		padding-block: 1.5rem;
	}

	.benefit {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
	}

	.benefit span {
		display: grid;
		flex: 0 0 1.7rem;
		place-items: center;
		width: 1.7rem;
		height: 1.7rem;
		border-radius: 50%;
		color: #fff;
		background: #315b65;
		font-weight: 800;
	}

	.benefit p {
		margin: 0.15rem 0 0;
		font-weight: 650;
	}

	.content {
		padding-block: clamp(3rem, 7vw, 5.5rem);
	}

	.content-section + .content-section {
		margin-top: 3.5rem;
		padding-top: 3.5rem;
		border-top: 1px solid var(--color-base-300);
	}

	h2 {
		margin: 0 0 1rem;
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		color: var(--color-base-content);
	}

	.content-section p,
	.faq-section p {
		font-size: 1.05rem;
		line-height: 1.8;
	}

	ul {
		display: grid;
		gap: 0.8rem;
		padding: 0;
		list-style: none;
	}

	li {
		position: relative;
		padding-left: 1.7rem;
		line-height: 1.7;
	}

	li::before {
		position: absolute;
		top: 0.35rem;
		left: 0;
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 50%;
		background: #c6a35b;
		content: '';
	}

	.faq-section {
		padding-block: clamp(3rem, 7vw, 5rem);
		background: #102039;
		color: #edf2f7;
	}

	.faq-section h2 {
		color: #fff;
	}

	.faqs {
		display: grid;
		gap: 0.8rem;
		margin-top: 2rem;
	}

	details {
		border: 1px solid rgb(255 255 255 / 22%);
		border-radius: 5px;
		background: rgb(255 255 255 / 5%);
	}

	summary {
		padding: 1.1rem 1.25rem;
		font-weight: 800;
		cursor: pointer;
	}

	details p {
		padding: 0 1.25rem 1.25rem;
		margin: 0;
		color: #dce5ee;
	}

	.related {
		padding-block: clamp(3rem, 6vw, 4.5rem);
		background: var(--color-base-200);
	}

	.related-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.related a {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		padding: 1.25rem;
		border: 1px solid var(--color-base-300);
		border-radius: 5px;
		color: var(--scruz-primary-ink);
		background: var(--color-base-100);
		text-decoration: none;
		box-shadow: 0 6px 22px rgb(16 32 57 / 6%);
	}

	.related a:hover {
		border-color: #c6a35b;
		transform: translateY(-2px);
	}

	.related span {
		font-size: 0.92rem;
		line-height: 1.55;
		color: color-mix(in oklab, var(--color-base-content) 72%, var(--color-base-100));
	}

	.disclaimer {
		padding-block: 1.5rem;
		font-size: 0.9rem;
		line-height: 1.6;
		background: var(--color-base-200);
	}

	@media (max-width: 760px) {
		.benefits-grid,
		.related-grid {
			grid-template-columns: 1fr;
		}

		.actions {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
