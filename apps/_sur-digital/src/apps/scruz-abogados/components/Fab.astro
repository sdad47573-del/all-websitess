---
import { WhatsappIcon } from '../@astro-icons/index.ts';
---

<!--
	transition:persist evita que el FAB desaparezca entre navegaciones SPA.
	Combinado con transition:name crearía morph contradictorio; usamos solo persist.
-->
<div class="fab z-40" transition:persist>
	<a
		target="_blank"
		rel="noopener noreferrer"
		href="https://wa.me/34666329155?text=Hola%2C%20quisiera%20realizar%20una%20consulta%20legal%2C%20%C2%BFpodr%C3%ADamos%20agendar%20una%20cita%3F"
		class="!visible !scale-none !opacity-100"
		aria-label="Contactar con Scruz Abogados por WhatsApp"
	>
		<WhatsappIcon />
	</a>
</div>
