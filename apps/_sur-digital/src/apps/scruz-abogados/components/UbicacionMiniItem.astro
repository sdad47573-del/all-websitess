---
import { RiIcon } from '../@astro-icons/index.ts';
import { twJoin } from 'tailwind-merge';

const { city, isMain, province, address, zip } = Astro.props;
---

<div class={twJoin('reveal-pop card-surface h-full rounded-2xl p-8', isMain && 'ring-primary ring-2')}>
	<h3 class="font-title mb-2 flex gap-2 text-2xl font-bold">
		{city}
		{
			isMain && (
				<div class="bg-primary text-primary-content inline-block rounded-full px-3 py-1 text-sm font-semibold">
					Oficina Principal
				</div>
			)
		}
	</h3>
	<p class="mb-4 text-base-content/70">{province}</p>
	<div class="flex items-start space-x-3">
		<div class="mt-0.5 flex h-5 w-5 items-center justify-center">
			<RiIcon name="mapPin" class="text-primary size-4" />
		</div>
		<div>
		<p class="font-medium">{address}</p>
		<p class="text-base-content/70">{zip}</p>
		</div>
	</div>
</div>
