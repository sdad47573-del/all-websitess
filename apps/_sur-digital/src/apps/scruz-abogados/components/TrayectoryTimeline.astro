---
import { RiIcon } from '../@astro-icons/index.ts';
import { twJoin } from 'tailwind-merge';

const DATA = [
	{
		title: 'Abogado procesalista',
		date: '2008',
		content: 'Adquiere experiencia en el ámbito procesalista en Carrillo Asesores.',
	},
	{
		title: 'Fundación del Despacho',
		date: '2011',
		content: 'Inicio de actividad en Málaga, especializándose en Derecho Civil y de Familia.',
	},
	{
		title: 'Más de 20 años',
		date: '2026',
		content: 'Consolidación como referente en servicios jurídicos integrales.',
	},
];
---

<ul class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical mb-20">
	{
		DATA.map((item, idx) => (
			<li>
				{idx > 0 && <hr class="bg-warning/50" />}
				<div class="timeline-middle text-2xl">
					<RiIcon name="focus" class="text-primary size-6" />
				</div>
				<div
					class={twJoin(
						'timeline-start mb-10 flex w-full flex-col items-center',
						idx % 2 === 0
							? 'timeline-start md:items-end md:text-end'
							: 'timeline-end md:items-start md:text-start',
					)}
				>
					<div class="reveal-pop card-surface rounded-2xl p-6">
						<div class="text-primary mb-2 text-lg font-bold">{item.date}</div>
						<h3 class="font-title mb-2 text-xl font-bold">{item.title}</h3>
						<p class="text-base-content/70">{item.content}</p>
					</div>
				</div>
				{DATA.length - 1 !== idx && <hr class="bg-warning/50" />}
			</li>
		))
	}
</ul>
