---
import type { LucideIcon } from '../../types/lucide';

/**
 * Sección intro editorial: 2 columnas (texto principal con drop-cap + aside factbox).
 * - factboxTheme: "warning" | "success" | "primary"  (cambia border + icon color)
 * - El título acepta HTML para permitir spans con clases de color inline (`<span class="text-primary">...`)
 * - El contenido del texto va en <slot />
 */
interface Props {
	supertitle: string;
	title: string;
	factboxSupertitle: string;
	factboxTitle: string;
	factboxItems: Array<{ Icon: LucideIcon; title: string; description: string }>;
	factboxTheme?: 'warning' | 'success' | 'primary';
}

const {
	supertitle,
	title,
	factboxSupertitle,
	factboxTitle,
	factboxItems,
	factboxTheme = 'warning',
} = Astro.props;

const borderClass =
	factboxTheme === 'success'
		? 'border-success'
		: factboxTheme === 'primary'
			? 'border-primary'
			: 'border-warning';

const iconBgClass =
	factboxTheme === 'success'
		? 'bg-success/15 text-success'
		: 'bg-primary/10 text-primary';
---

<section class="bg-base-100 px-6 pt-24 pb-16 md:px-16 md:pt-32 md:pb-24 lg:pt-36">
	<div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-3 lg:gap-16">
		<div class="reveal-pop lg:col-span-2">
			<p class="eyebrow">{supertitle}</p>
			<h2 class="mb-6 font-title text-3xl leading-tight md:text-4xl lg:text-5xl" set:html={title} />
			<div class="drop-cap text-base leading-relaxed text-base-content/80 md:text-lg">
				<slot />
			</div>
		</div>

		<aside
			class:list={[
				'reveal self-start rounded-md border-l-4 bg-base-200 p-6 md:p-8 lg:p-10',
				borderClass,
			]}
		>
			<p class="eyebrow">{factboxSupertitle}</p>
			<h3 class="font-title text-2xl mb-6 leading-tight">{factboxTitle}</h3>
			<ul class="space-y-5">
				{
					factboxItems.map(({ Icon, title: itemTitle, description }) => (
						<li class="flex items-start gap-4">
							<div
								class:list={[
									'flex size-9 shrink-0 items-center justify-center rounded-md',
									iconBgClass,
								]}
							>
								<Icon class="size-5" stroke-width="1.75" aria-hidden="true" />
							</div>
							<div>
								<p class="font-title text-base font-bold">{itemTitle}</p>
								<p class="text-sm leading-relaxed text-base-content/70">
									{description}
								</p>
							</div>
						</li>
					))
				}
			</ul>
		</aside>
	</div>
</section>
