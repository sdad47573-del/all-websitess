---
import type { ImageMetadata } from 'astro';
import { Image } from '../../@astro-components/index.ts';
import type { LucideIcon } from '../../types/lucide';

/**
 * Hero editorial con imagen a pantalla completa + CTAs (tel + WhatsApp)
 * y stats ribbon superpuesto (-mt-16). Variante:
 *   - gradient: "cool"  (azul→negro, default) | "warm" (azul→gold, usado en violencia-genero)
 *   - stats appearance: "dark" (sobre primary, icons warning) | "light" (sobre base-100, icons success)
 *   - El título llega por <slot name="title"> para permitir spans con clases de color inline.
 */
interface Props {
	image: ImageMetadata;
	imageAlt: string;
	supertitle: string;
	description: string;
	stats: Array<{ Icon: LucideIcon; label: string; value: string }>;
	whatsappHref?: string;
	gradient?: 'cool' | 'warm';
	statsAppearance?: 'dark' | 'light';
}

const {
	image,
	imageAlt,
	supertitle,
	description,
	stats,
	whatsappHref = 'https://wa.me/34666329155',
	gradient = 'cool',
	statsAppearance = 'dark',
} = Astro.props;

// En oscuro el overlay pasa a tinta nocturna: el primary del tema oscuro es un
// azul aclarado (para que funcione como texto sobre fondos oscuros) y el hero
// lleva texto blanco, así que la banda azul de marca no daría contraste.
const overlayClass =
	gradient === 'warm'
		? 'bg-gradient-to-br from-primary/85 via-primary/60 to-warning/35 dark:from-neutral/95 dark:via-neutral/85 dark:to-warning/25'
		: 'bg-gradient-to-br from-primary/85 via-primary/55 to-black/70 dark:from-neutral/95 dark:via-neutral/85 dark:to-black/90';
---

<section class="relative overflow-hidden">
	<div class="relative h-[78vh] min-h-[560px] md:h-[82vh]">
		<Image
			src={image}
			alt={imageAlt}
			class="absolute inset-0 h-full w-full object-cover"
			loading="eager"
			fetchpriority="high"
		/>
		<div class={overlayClass} aria-hidden="true"></div>
		<div
			class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-base-100 to-transparent"
			aria-hidden="true"
		></div>

		<div
			class="relative z-10 mx-auto flex h-full max-w-6xl flex-col items-start justify-center px-6 text-white md:px-16"
		>
			<p class="eyebrow animate-fade-in-up !text-warning">{supertitle}</p>
			<h1
				class="font-title animate-fade-in-up text-4xl font-bold leading-[1.05] sm:text-5xl md:text-6xl lg:text-7xl"
				style="animation-delay: 0.1s"
			>
				<slot name="title" />
			</h1>
			<p
				class="animate-fade-in-up mt-6 max-w-2xl text-base leading-relaxed text-white/90 sm:text-lg md:text-xl"
				style="animation-delay: 0.2s"
			>
				{description}
			</p>
			<div class="animate-fade-in-up mt-10 flex flex-wrap gap-3" style="animation-delay: 0.3s">
				<slot name="ctas">
					<a href="tel:+34666329155" class="btn btn-warning btn-md md:btn-lg">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="mr-2 size-5"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path
								d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
							></path>
						</svg>
						Llámanos ahora
					</a>
					<a
						href={whatsappHref}
						class="btn btn-outline btn-md md:btn-lg !border-white !bg-white/10 !text-white hover:!bg-white hover:!text-primary"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="mr-2 size-5"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
						</svg>
						WhatsApp directo
					</a>
				</slot>
			</div>
		</div>
	</div>

	<!-- Stats ribbon — anclas de credibilidad superpuestas -->
	<div class="reveal-pop relative z-20 mx-auto -mt-16 max-w-6xl px-6 md:px-16">
		<div
			class:list={[
				// Tres columnas solo desde `lg`: a 768 px cada celda quedaba en 212 px y
				// con el p-8 el rótulo se quedaba sin sitio (hasta +76 px), que el
				// `overflow-hidden` del ribbon recortaba en medio de la palabra.
				'grid grid-cols-1 overflow-hidden rounded-2xl shadow-strong lg:grid-cols-3',
				statsAppearance === 'light'
					? 'bg-base-100 ring-1 ring-base-300'
					: 'bg-primary text-primary-content dark:bg-neutral dark:text-neutral-content',
			]}
		>
			{
				stats.map(({ Icon, label, value }, idx) => (
					<div
						class:list={[
							'flex items-center gap-5 p-6 md:p-8 transition-transform duration-300 hover:scale-[1.02]',
							statsAppearance === 'light'
								? idx < stats.length - 1
									? 'border-b border-base-300 lg:border-b-0 lg:border-r'
									: ''
								: idx < stats.length - 1
									? 'border-b border-white/10 lg:border-b-0 lg:border-r'
									: '',
						]}
					>
						<div
							class:list={[
								'flex size-12 shrink-0 items-center justify-center rounded-lg',
								statsAppearance === 'light'
									? 'bg-success/15 text-success'
									: 'bg-white/10 text-warning',
							]}
						>
							<Icon class="size-6" stroke-width="1.75" aria-hidden="true" />
						</div>
						<div>
							<p
								class:list={[
									'text-[0.7rem] font-bold uppercase tracking-widest',
									statsAppearance === 'light' ? 'text-base-content/70' : 'text-white/70',
								]}
							>
								{label}
							</p>
							<p class="font-title text-xl font-bold md:text-2xl">{value}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
