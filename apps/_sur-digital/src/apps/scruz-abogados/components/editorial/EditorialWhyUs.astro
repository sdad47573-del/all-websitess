---
import type { LucideIcon } from '../../types/lucide';

/**
 * Sección "Por qué elegirnos" sobre bg-primary con decoración ambiental (blobs blurred).
 * Layout asimétrico 2fr/3fr. Soporta descripción opcional en el lado izquierdo (servicio.astro).
 */
interface Props {
	supertitle: string;
	title: string;
	description?: string;
	items: Array<{ Icon: LucideIcon; title: string; description: string }>;
}

const { supertitle, title, description, items } = Astro.props;
---

<section
	class="band band-primary bg-primary relative overflow-hidden text-primary-content"
>
	<div
		class="bg-warning/10 absolute -right-20 -top-20 size-80 rounded-full blur-3xl"
		aria-hidden="true"
	>
	</div>
	<div
		class="absolute -bottom-20 -left-20 size-80 rounded-full bg-white/5 blur-3xl"
		aria-hidden="true"
	>
	</div>

	<div
		class="reveal relative mx-auto grid max-w-6xl gap-12 lg:grid-cols-[2fr_3fr] lg:gap-16"
	>
		<div>
			<p class="eyebrow !text-warning">{supertitle}</p>
			<h2 class="font-title text-3xl leading-tight md:text-4xl lg:text-5xl">
				{title}
			</h2>
			<span class="editorial-rule mt-6 !ml-0"></span>
			{description && (
				<p class="mt-6 max-w-md text-sm leading-relaxed opacity-80">
					{description}
				</p>
			)}
		</div>

		<div>
			{
				items.map(({ Icon, title: itemTitle, description: itemDesc }, idx) => (
					<div
						class:list={[
							'reveal-pop flex gap-5 pb-6 pt-2 transition-colors duration-300 md:pb-7',
							idx < items.length - 1 ? 'border-b border-white/10' : '',
						]}
					>
						<div class="flex size-11 shrink-0 items-center justify-center rounded-md bg-warning/20 text-warning">
							<Icon class="size-5" stroke-width="2" aria-hidden="true" />
						</div>
						<div>
							<h3 class="font-title mb-2 text-xl font-bold">{itemTitle}</h3>
							<p class="text-sm leading-relaxed opacity-80">{itemDesc}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
