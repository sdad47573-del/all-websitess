---
import type { LucideIcon } from '../../types/lucide';

/**
 * Grid de categorías jurídicas con iconos warning y badges-links a sub-áreas.
 * Variante visual del grid editorial — usada exclusivamente en `servicio.astro`.
 */
interface Props {
	supertitle?: string;
	title: string;
	description?: string;
	items: Array<{
		Icon: LucideIcon;
		title: string;
		description: string;
		links: Array<{ label: string; href: string }>;
	}>;
}

const { supertitle, title, description, items } = Astro.props;
---

<section class="bg-base-100 px-6 py-16 md:px-16 md:py-24">
	<div class="mx-auto max-w-6xl">
		<div class="reveal-pop mb-12 max-w-3xl">
			{supertitle && <p class="eyebrow">{supertitle}</p>}
			<h2 class="mb-4 font-title text-3xl leading-tight md:text-4xl lg:text-5xl">
				{title}
			</h2>
			{description && (
				<p class="text-base leading-relaxed text-base-content/70 md:text-lg">
					{description}
				</p>
			)}
		</div>

		<div
			class="grid gap-px overflow-hidden rounded-2xl border border-base-300 bg-base-300 sm:grid-cols-2 lg:grid-cols-3"
			data-reveal-stagger
		>
			{
				items.map(({ Icon, title: catTitle, description: catDesc, links }) => (
					<article class="reveal-pop group relative h-full bg-base-100 p-8 md:p-10">
						<div
							class="mb-6 flex size-12 items-center justify-center rounded-md bg-warning/15 text-warning transition-colors duration-300 group-hover:bg-warning group-hover:text-primary"
						>
							<Icon class="size-6" stroke-width="1.5" aria-hidden="true" />
						</div>
						<h3 class="font-title mb-2 text-xl font-bold leading-tight">
							{catTitle}
						</h3>
						<p class="mb-5 text-sm leading-relaxed text-base-content/70">
							{catDesc}
						</p>
						<ul class="flex flex-wrap gap-2">
							{links.map(({ label, href }) => (
								<li>
									<a
										href={href}
										class="badge badge-outline badge-sm transition-colors duration-200 hover:badge-primary"
									>
										{label}
									</a>
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>
