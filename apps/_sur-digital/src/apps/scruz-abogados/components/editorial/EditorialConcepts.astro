---
import type { LucideIcon } from '../../types/lucide';

/**
 * Grid de conceptos con hairline dividers (gap-px sobre border bg-base-300).
 * - Cada item puede incluir `href` para renderizar un botón "Más info" abajo.
 *   Si NO hay href, la tarjeta cierra con el párrafo (estándar de páginas de detalle).
 * - `iconTheme`: "primary" (azul→gold hover) | "warning" (servicio.astro segunda grid).
 */
interface Props {
	supertitle: string;
	title: string;
	description?: string;
	iconTheme?: 'primary' | 'warning';
	ctaLabel?: string;
	items: Array<{
		Icon: LucideIcon;
		title: string;
		description: string;
		href?: string;
	}>;
}

const {
	supertitle,
	title,
	description,
	iconTheme = 'primary',
	ctaLabel = 'Más info',
	items,
} = Astro.props;

const iconBase =
	iconTheme === 'warning'
		? 'bg-warning/15 text-warning'
		: 'bg-primary/10 text-primary';
const iconHover = iconTheme === 'warning' ? 'bg-warning group-hover:text-primary' : 'bg-primary group-hover:text-primary-content';
---

<section class="bg-base-200 px-6 py-16 md:px-16 md:py-24">
	<div class="mx-auto max-w-6xl">
		<div class="reveal-pop mb-12 max-w-3xl">
			<p class="eyebrow">{supertitle}</p>
			<h2 class="mb-4 font-title text-3xl leading-tight md:text-4xl lg:text-5xl">
				{title}
			</h2>
			{description && (
				<p class="text-base leading-relaxed text-base-content/70 md:text-lg">
					{description}
				</p>
			)}
		</div>
		<div
			class="grid gap-px overflow-hidden rounded-2xl border border-base-300 bg-base-300 sm:grid-cols-2 lg:grid-cols-3"
			data-reveal-stagger
		>
			{
				items.map(({ Icon, title: itemTitle, description: itemDesc, href }) => (<article
							class:list={[
								'reveal-pop group relative bg-base-100 p-8 md:p-10',
								href ? 'hover-lift flex h-full flex-col' : '',
							]}
						>
						<div
							class:list={[
								'mb-6 flex size-12 items-center justify-center rounded-md transition-colors duration-300',
								iconBase,
								'group-hover:' + iconHover,
							]}
						>
							<Icon class="size-6" stroke-width="1.5" aria-hidden="true" />
						</div>
						<h3
							class:list={[
								'font-title mb-3 text-xl font-bold leading-tight transition-colors duration-300',
								iconTheme === 'primary' ? 'group-hover:text-primary' : '',
							]}
						>
							{itemTitle}
						</h3>
						<p class:list={['text-sm leading-relaxed text-base-content/70', href ? 'mb-6 grow' : '']}>
							{itemDesc}
						</p>
						{href && (
							<a href={href} class="btn btn-neutral btn-sm btn-wide self-start">
								{ctaLabel}
							</a>
						)}
					</article>
				))
			}
		</div>
	</div>
</section>
