---
/**
 * Timeline visual del proceso: 4 columnas, cada paso = círculo gold (size-24)
 * con número bold + título + párrafo. Línea conectora gold solo en desktop.
 */
interface Props {
	supertitle: string;
	title: string;
	items: Array<{ number: string; title: string; description: string }>;
}

const { supertitle, title, items } = Astro.props;
---

<section class="bg-base-200 px-6 py-16 md:px-16 md:py-24">
	<div class="mx-auto max-w-6xl">
		<div class="reveal-pop mb-12 max-w-3xl">
			<p class="eyebrow">{supertitle}</p>
			<h2 class="mb-4 font-title text-3xl leading-tight md:text-4xl lg:text-5xl">
				{title}
			</h2>
		</div>

		<!--
			Dos columnas en tablet y cuatro desde `lg`: a 768 px las cuatro columnas
			dejaban 142 px por paso y el párrafo rompía en ~10 líneas. La línea
			conectora solo tiene sentido con los cuatro pasos en fila, así que también
			pasa a `lg`.
		-->
		<ol class="relative grid gap-10 md:grid-cols-2 md:gap-6 lg:grid-cols-4 lg:gap-8" data-reveal-stagger>
			<div
				class="pointer-events-none absolute top-12 left-[12%] right-[12%] hidden h-px lg:block"
				aria-hidden="true"
			>
				<div
					class="h-full w-full bg-gradient-to-r from-transparent via-warning to-transparent"
				>
				</div>
			</div>

			{
				items.map(({ number, title: stepTitle, description }) => (
					<li class="reveal-pop relative flex flex-col items-start">
						<div class="mb-6 flex size-24 items-center justify-center rounded-full border-2 border-warning bg-base-100 shadow-strong">
							<span class="font-title text-3xl font-black text-primary">
								{number}
							</span>
						</div>
						<h3 class="font-title mb-3 text-xl font-bold leading-tight">
							{stepTitle}
						</h3>
						<p class="text-sm leading-relaxed text-base-content/70">
							{description}
						</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
