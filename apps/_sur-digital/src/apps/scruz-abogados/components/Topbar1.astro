---
import { Moon, Sun } from '@lucide/astro';
import { RiIcon } from '../@astro-icons/index.ts';
import { twJoin } from 'tailwind-merge';

import { SERVICES } from '../data/SERVICES';
import { EN_COUNTERPARTS, EN_HOME, ES_COUNTERPARTS, isEnglishRoute } from '../data/i18n';

const currentPath = Astro.url.pathname;

// Ruta normalizada con barra final: permite comparar por prefijo, de modo que
// /blog/<post>/ active "Blog" o /servicios/x/ active "Servicios". El topbar solo
// marcaba la sección con la URL exacta, así que los posts, las páginas de
// servicio y las de localidad (~55 de las 87 páginas del sitio) se quedaban sin
// ningún enlace activo.
const currentRoute = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;

// Selector de idioma: en las páginas con traducción lleva a su pareja y en el
// resto, a la landing inglesa de Málaga (la puerta del público expatriado).
// La etiqueta indica el idioma de DESTINO, no el de la página actual.
const onEnglishPage = isEnglishRoute(currentRoute);
const languageHref = onEnglishPage
	? (ES_COUNTERPARTS[currentRoute] ?? '/')
	: (EN_COUNTERPARTS[currentRoute] ?? EN_HOME);
const languageHreflang = onEnglishPage ? 'es-ES' : 'en';
const languageLabel = onEnglishPage ? 'ES' : 'EN';
const languageTitle = onEnglishPage ? 'Ver esta página en español' : 'View this page in English';

interface NavSection {
	name: string;
	href: string;
	// Prefijos extra que también activan la sección: rutas que agrupa sin ser
	// hijas suyas (cada servicio vive en la raíz, /despidos/ o /urbanismo/, y las
	// páginas de localidad cuelgan de /abogados-en-*).
	match?: string[];
}

// Solo LinkedIn se muestra en la barra superior: las páginas de Facebook e
// Instagram del despacho están sin actividad y enlazarlas restaba credibilidad
// (mismo criterio que SOCIAL_PROFILES en src/data/seo.ts).
const DATA = {
	// Sin NAP duplicado: el teléfono visible vive solo en el enlace tel: de este
	// archivo y el canónico (+34 666 329 155) en src/data/seo.ts (NAP).
	// El orden es el del menú móvil (lista todas) y el del desplegable "Más"
	// (las que no son primarias). /quienes-somos/ estaba fuera de la navegación
	// y solo la enlazaban 6 páginas desde el contenido: con 8 secciones cabe en
	// el desplegable sin afectar al ancho del topbar.
	sections: [
		{ name: 'Inicio', href: '/' },
		{ name: 'Sobre nosotros', href: '/quienes-somos/' },
		{ name: 'Trayectoria', href: '/trayectoria/' },
		{
			name: 'Servicios',
			href: '/servicios/',
			match: SERVICES.map(({ path }) => `${path}/`),
		},
		{ name: 'Ubicaciones', href: '/ubicaciones/', match: ['/abogados-en-'] },
		{ name: 'FAQ', href: '/faq/' },
		{ name: 'Blog', href: '/blog/' },
		{ name: 'Empresas', href: '/empresas/' },
	] as NavSection[],
};

// Nav de escritorio: con las 8 secciones el topbar desbordaba (scroll
// horizontal) en pantallas medianas. Se dejan en línea las primarias y el
// resto se agrupa en el desplegable "Más"; el menú móvil las conserva todas.
//
// **Por qué el corte es `lg` y no `md`:** entre 768 y 1023 px no caben las ocho
// secciones, y lo que pasaba era peor que un scroll: la fila se salía del
// padding y el botón de llamada quedaba pegado al borde de la pantalla. En ese
// rango ahora se sirve el menú desplegable completo (el mismo que el móvil),
// que además es lo que espera quien entra en una tablet: una lista, no una
// fila de enlaces que no entran. A partir de `lg` vuelve la fila con las
// primarias y "Más".
const primaryNames = ['Trayectoria', 'Servicios'];

// Una sección está activa cuando el prefijo que casa con la URL es el más
// específico de todas: así /blog/<post>/ marca Blog y no Inicio, y si dos
// secciones casaran (una página de servicio con nombre compartido) gana la del
// prefijo más largo en lugar de la primera del array. Inicio ('/') se compara
// por igualdad, porque como prefijo casaría con todo el sitio.
const scoreOf = ({ href, match = [] }: NavSection) =>
	href === '/'
		? currentRoute === '/'
			? 1
			: 0
		: [href, ...match].reduce(
				(best, prefix) =>
					currentRoute.startsWith(prefix) ? Math.max(best, prefix.length) : best,
				0,
			);

const scoredSections = DATA.sections.map((section) => ({ ...section, score: scoreOf(section) }));
const bestScore = Math.max(0, ...scoredSections.map((s) => s.score));
const sections = scoredSections.map((section) => ({
	...section,
	isActive: section.score > 0 && section.score === bestScore,
}));

const primarySections = sections.filter((s) => primaryNames.includes(s.name));
const moreSections = sections.filter((s) => !primaryNames.includes(s.name));
const isMoreActive = moreSections.some((s) => s.isActive);
---

<div class="bg-accent text-accent-content">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-2 md:px-16">
		<div class="flex items-center gap-2">
			<RiIcon name="phoneFill" class="size-4" /><span>Teléfono: </span><a
				href="tel:+34666329155"
				class="transition-colors hover:text-emerald-200 hover-lift-icon">+34 666 329 155</a
			>
		</div>
		<div class="flex gap-3">
			<a
				target="_blank"
				rel="noopener noreferrer"
				href="https://www.linkedin.com/in/sergio-cruz-chac%C3%B3n-75ba7a26"
				class="transition-colors hover:text-emerald-200 hover-lift-icon"
				aria-label="LinkedIn de Sergio Cruz Chacón"
				><RiIcon name="linkedin" class="size-4" /></a
			>
		</div>
	</div>
</div>
<header class="animate-header-in bg-base-100/90 sticky top-0 z-60 shadow-lg backdrop-blur-xl">
	<nav aria-label="Navegación principal" class="mx-auto max-w-6xl px-6 py-2 md:px-16">
		<div id="topbar-row" class="flex h-16 items-center justify-between">
			<div class="">
				<a href="/scruz-abogados/" class="font-title flex flex-col">
					<span class="text-primary text-center text-3xl leading-[25px]"> SCRUZ </span>
					<span class="block text-center text-lg leading-4"> ABOGADOS </span>
				</a>
			</div>

			<div class="mr-2 ml-6 hidden items-center lg:flex lg:ml-10">
				<div class="flex items-center space-x-1">
					{
						primarySections.map(({ name, href, isActive }) => {
							return (
								<a
									class={twJoin(
										'cursor-pointer rounded-md px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors',
										isActive
											? 'bg-primary text-primary-content'
											: 'hover:text-primary text-gray-700 hover:bg-blue-50',
									)}
									href={href}
									data-discover="true"
									aria-current={isActive ? 'page' : undefined}
								>
									{name}
								</a>
							);
						})
					}

					{/* Desplegable "Más": agrupa el resto de secciones para que el
					    topbar no desborde en pantallas medianas. Mismo patrón de
					    animación que el menú móvil (fade + slide con duration-300). */}
					<div class="relative" id="more-menu-root">
						<button
							id="more-toggle"
							type="button"
							class={twJoin(
								'inline-flex cursor-pointer items-center gap-1 rounded-md px-3 py-2 text-sm font-medium transition-colors',
								isMoreActive
									? 'bg-primary text-primary-content'
									: 'hover:text-primary text-gray-700 hover:bg-blue-50',
							)}
							aria-expanded="false"
							aria-controls="more-menu"
							aria-haspopup="true"
						>
							Más
							<RiIcon
								name="arrowDownS"
								class="size-4 transition-transform duration-300"
							/>
						</button>
						<div
							id="more-menu"
							class="border-base-300 bg-base-100 pointer-events-none absolute right-0 top-full z-50 mt-2 hidden w-52 -translate-y-2 rounded-xl border p-2 opacity-0 shadow-xl transition-all duration-300 ease-in-out"
						>
							{
								moreSections.map(({ name, href, isActive }) => {
									return (
										<a
											class={twJoin(
												'block cursor-pointer rounded-md px-3 py-2 text-sm font-medium transition-colors',
												isActive
													? 'bg-primary text-primary-content'
													: 'hover:text-primary text-gray-700 hover:bg-blue-50',
											)}
											href={href}
											data-discover="true"
											aria-current={isActive ? 'page' : undefined}
										>
											{name}
										</a>
									);
								})
							}
						</div>
					</div>
				</div>
			</div>
			<div class="hidden items-center gap-3 whitespace-nowrap lg:flex">
				<button
					type="button"
					data-theme-toggle
					class="hover:text-primary inline-flex cursor-pointer items-center justify-center rounded-md p-2 text-gray-700 hover:bg-blue-50"
					aria-label="Activar modo oscuro"
					aria-pressed="false"
				>
					<Moon class="size-5 dark:hidden" aria-hidden="true" />
					<Sun class="hidden size-5 dark:block" aria-hidden="true" />
				</button>
				<a
					class="hover:text-primary inline-flex cursor-pointer items-center justify-center rounded-md px-2 py-2 text-sm font-semibold text-gray-700 hover:bg-blue-50"
					href={languageHref}
					hreflang={languageHreflang}
					lang={languageHreflang}
					title={languageTitle}
					aria-label={languageTitle}
					data-discover="true">{languageLabel}</a
				>
				<a
					class="hover:text-primary inline-flex cursor-pointer items-center justify-center rounded-md p-2 text-gray-700 hover:bg-blue-50"
					href="/scruz-abogados/buscar/"
					aria-label="Buscar servicios jurídicos"
					data-discover="true"
				>
					<RiIcon name="search" class="size-5" />
				</a>
				<!--
					El texto del botón solo desde `lg`. La columna derecha de la fila
					de escritorio aparece a partir de `lg` (antes `md`), así que lo
					que se ve en cuanto hay fila es el icono con su aria-label, y el
					texto largo solo cuando ya cabe con todo lo demás.
				-->
				<a
					class="btn btn-primary btn-sm px-2 py-0 text-sm font-medium transition-colors lg:px-4"
					href="tel:+34666329155"
					aria-label="Llamar gratis al 666 329 155"
					data-discover="true"
				>
					<RiIcon name="phoneFill" class="size-4 lg:hidden" /><span class="hidden lg:inline">Consulta gratuita</span></a
					>
			</div>
			<div class="flex items-center gap-1 lg:hidden">
				<a
					class="hover:text-primary inline-flex cursor-pointer items-center justify-center rounded-md p-2 text-gray-700 hover:bg-blue-50"
					href="/scruz-abogados/buscar/"
					aria-label="Buscar servicios jurídicos"
					data-discover="true"
				>
					<RiIcon name="search" class="size-5" />
				</a>
				<a
					class="btn btn-primary btn-sm gap-2 px-3 font-medium"
					href="tel:+34666329155"
					aria-label="Llamar gratis al 666 329 155"
				>
					<RiIcon name="phoneFill" class="size-4" />
					<span>Llamar</span>
				</a>
				<button
					id="menu-toggle"
					type="button"
					class="hover:text-primary inline-flex cursor-pointer items-center justify-center rounded-md p-2 text-gray-700 hover:bg-blue-50"
					aria-label="Abrir menú de navegación"
					aria-controls="mobile-menu"
					aria-expanded="false"
					><div class="flex h-6 w-6 items-center justify-center">
						<RiIcon name="menu" class="size-5" />
					</div></button
				>
			</div>
		</div>
	</nav>
	<div aria-hidden="true" class="relative h-0.5 w-full overflow-hidden bg-transparent">
		<div id="scroll-progress" class="bg-primary h-full w-full origin-left"></div>
	</div>
	<div
		id="mobile-menu"
		class="border-base-300 bg-base-100 pointer-events-none absolute z-40 hidden w-full -translate-y-4 border-t p-4 opacity-0 shadow-lg transition-all duration-300 ease-in-out lg:hidden"
	>
		<nav aria-label="Navegación móvil" class="flex flex-col items-baseline">
			{
				sections.map(({ name, href, isActive }) => {
					return (
						<a
							class={twJoin(
								'cursor-pointer rounded-md px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors',
								isActive
									? 'bg-primary text-primary-content'
									: 'hover:text-primary text-gray-700 hover:bg-blue-50',
							)}
							href={href}
							data-discover="true"
							aria-current={isActive ? 'page' : undefined}
						>
							{name}
						</a>
					);
				})
			}
		</nav>
		<div class="mt-3 flex flex-col gap-2 border-t border-base-300 pt-3">
			<a
				class="btn btn-outline btn-neutral btn-sm w-full"
				href={languageHref}
				hreflang={languageHreflang}
				lang={languageHreflang}>{onEnglishPage ? 'Ver en español' : 'View in English'}</a
			>
			<a class="btn btn-primary btn-sm w-full" href="tel:+34666329155" data-discover="true"
				>Consulta gratuita: 666 329 155</a
			>
			<a
				class="btn btn-outline btn-neutral btn-sm w-full"
				href="https://wa.me/34666329155?text=Hola%2C%20quisiera%20realizar%20una%20consulta%20legal%2C%20%C2%BFpodr%C3%ADamos%20agendar%20una%20cita%3F"
				target="_blank"
				rel="noopener noreferrer"
				>Contactar por WhatsApp</a
			>
			<!-- Interruptor de tema del panel móvil: en la fila del header no cabe
			     (logo + buscador + Llamar + menú desbordan por debajo de 360 px). -->
			<button
				type="button"
				data-theme-toggle
				class="btn btn-outline btn-neutral btn-sm w-full justify-center gap-2"
				aria-label="Activar modo oscuro"
				aria-pressed="false"
			>
				<Moon class="size-4 dark:hidden" aria-hidden="true" />
				<Sun class="hidden size-4 dark:block" aria-hidden="true" />
				<span class="dark:hidden">Modo oscuro</span>
				<span class="hidden dark:inline">Modo claro</span>
			</button>
		</div>
	</div>
</header><!--
	`data-astro-rerun` hace que el script se vuelva a ejecutar en cada navegación SPA
	(y requiere tratamiento is:inline). El selector por id (#menu-toggle /
	#mobile-menu) sigue siendo válido porque Topbar re-renderiza al navegar (no
	usamos transition:persist en el Topbar para garantizar que el active-link y
	el estado del menú móvil se reinicien correctamente).
-->
<script is:inline data-astro-rerun>
	/* El topbar despliega su animación de entrada SOLO la primera vez que se ve
	 * (carga inicial). En navegaciones SPA el ClientRouter re-monta el Topbar y
	 * `animate-header-in` volvía a empezar desde opacity 0: durante 500 ms el
	 * header estaba transparente y, como el snapshot de la transición ya se
	 * había tomado sin él, el topbar se veía "tapado". Al quitar la clase, la
	 * animación tampoco se reanuda al retirar <html data-astro-transition>. */
	(() => {
		const header = document.querySelector('header.sticky');
		if (!header) return;
		if (window.__scruzTopbarIntro) header.classList.remove('animate-header-in');
		else window.__scruzTopbarIntro = true;
	})();

	/* Barra de progreso de lectura y estado compacto del header: un único
	 * listener con rAF. Actualizar transform es barato (compositor) y la pista ya
	 * reserva el alto; el header solo se toca al cruzar el umbral, cuando el CSS
	 * lo encoge 8 px y aligera la sombra (ver #topbar-row en index.css). */
	(() => {
		const bar = document.getElementById('scroll-progress');
		const header = document.querySelector('header.sticky');
		if (!bar && !header) return;

		let compact = null;
		let ticking = false;
		const update = () => {
			ticking = false;
			const doc = document.documentElement;
			const max = doc.scrollHeight - window.innerHeight;
			if (bar) bar.style.transform = `scaleX(${max > 0 ? Math.min(window.scrollY / max, 1) : 0})`;
			if (header) {
				const next = window.scrollY > 8;
				if (next !== compact) {
					compact = next;
					header.toggleAttribute('data-scrolled', next);
				}
			}
		};

		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true },
		);
		update();
	})();

	// El bloque va envuelto en IIFE para que `const toggleButton` no quede en el
	// ámbito global de la página: el script es `is:inline` y cualquier identificador
	// ya declarado (este archivo, otro script inline o un bundle) abortaba todo el
	// bloque con `Uncaught SyntaxError: Identifier 'toggleButton' has already been
	// declared`, dejando el menú móvil sin abrir.
	(() => {
		const toggleButton = document.getElementById('menu-toggle');
		const mobileMenu = document.getElementById('mobile-menu');
		const moreToggle = document.getElementById('more-toggle');
		const moreMenu = document.getElementById('more-menu');
		if (!toggleButton || !mobileMenu) return;

		const openMenu = () => {
			toggleButton.setAttribute('aria-expanded', 'true');
			mobileMenu.classList.remove('hidden', 'pointer-events-none');
			setTimeout(() => {
				mobileMenu.classList.remove('opacity-0', '-translate-y-4');
			}, 10);
		};

		const closeMenu = () => {
			toggleButton.setAttribute('aria-expanded', 'false');
			mobileMenu.classList.add('opacity-0', '-translate-y-4', 'pointer-events-none');
			setTimeout(() => {
				mobileMenu.classList.add('hidden');
			}, 300); // Igual a duration-300
		};

		const openMore = () => {
			if (!moreToggle || !moreMenu) return;
			moreToggle.setAttribute('aria-expanded', 'true');
			moreMenu.classList.remove('hidden', 'pointer-events-none');
			moreToggle.querySelector('svg')?.classList.add('rotate-180');
			// Doble rAF: garantiza que el navegador pinte el estado inicial (oculto
			// y desplazado) antes de quitar las clases, para que la transición corra.
			requestAnimationFrame(() => {
				requestAnimationFrame(() => {
					moreMenu.classList.remove('opacity-0', '-translate-y-2');
				});
			});
		};

		const closeMore = () => {
			if (!moreToggle || !moreMenu || moreMenu.classList.contains('hidden')) return;
			moreToggle.setAttribute('aria-expanded', 'false');
			moreMenu.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
			moreToggle.querySelector('svg')?.classList.remove('rotate-180');
			setTimeout(() => {
				moreMenu.classList.add('hidden');
			}, 300); // Igual a duration-300
		};

		toggleButton.addEventListener('click', (event) => {
			event.stopPropagation(); // Evita que el click cierre inmediatamente
			if (mobileMenu.classList.contains('hidden')) {
				closeMore();
				openMenu();
			} else {
				closeMenu();
			}
		});

		if (moreToggle && moreMenu) {
			moreToggle.addEventListener('click', (event) => {
				event.stopPropagation(); // Evita que el click fuera lo cierre al instante
				if (moreMenu.classList.contains('hidden')) {
					openMore();
				} else {
					closeMore();
				}
			});

			/* El desplegable se abre también al pasar el ratón, solo donde hay hover
			 * real: en táctil el pointerenter llega con el primer toque y el menú se
			 * cerraría (pointerleave) antes de poder pulsar un enlace. El cierre
			 * espera 150 ms para tolerar el salto entre el botón y el panel (mt-2). */
			if (window.matchMedia('(hover: hover)').matches) {
				let hoverTimer = 0;
				const root = document.getElementById('more-menu-root');
				root?.addEventListener('pointerenter', () => {
					clearTimeout(hoverTimer);
					openMore();
				});
				root?.addEventListener('pointerleave', () => {
					hoverTimer = setTimeout(closeMore, 150);
				});
			}

			/* El panel flota sobre el contenido (absolute + top-full): si la página se
			 * mueve se queda colgando donde estaba, así que se cierra con el scroll. */
			window.addEventListener(
				'scroll',
				() => {
					if (!moreMenu.classList.contains('hidden')) closeMore();
				},
				{ passive: true },
			);
		}

		/* Escape cierra el desplegable y el panel móvil. Si el foco estaba dentro
		 * del panel (usuario de teclado) vuelve al botón para no dejarlo perdido. */
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			closeMore();
			if (!mobileMenu.classList.contains('hidden')) {
				const focusWasInside = mobileMenu.contains(document.activeElement);
				closeMenu();
				if (focusWasInside) toggleButton.focus();
			}
		});

		/* El panel móvil tapa el contenido: al pulsar un enlace se cierra en el
		 * acto (con ClientRouter el Topbar se re-renderiza igualmente, pero una
		 * navegación normal del navegador no reinicia su estado). */
		mobileMenu.addEventListener('click', (event) => {
			if (event.target instanceof Element && event.target.closest('a')) closeMenu();
		});

		// Cerrar menús si se hace click fuera
		document.addEventListener('click', (event) => {
			if (
				!mobileMenu.contains(event.target) &&
				!toggleButton.contains(event.target) &&
				!mobileMenu.classList.contains('hidden')
			) {
				closeMenu();
			}
		if (
			moreToggle &&
			moreMenu &&
			!moreMenu.contains(event.target) &&
			!moreToggle.contains(event.target) &&
			!moreMenu.classList.contains('hidden')
		) {
			closeMore();
		}
	});
})();

/* Interruptor de tema. La fuente de verdad es <html data-theme>, que aplica el
 * script del layout antes del primer pintado (preferencia guardada o sistema);
 * aquí solo se cambia el atributo, se guarda la elección y se sincronizan los
 * dos botones (escritorio y panel móvil). Iconos y etiquetas se intercambian por
 * CSS con la variante dark:, así que el estado nunca depende del JS. */
(() => {
	const buttons = document.querySelectorAll('[data-theme-toggle]');
	if (!buttons.length) return;

	const sync = () => {
		const dark = document.documentElement.dataset.theme === 'theme-dark';
		for (const button of buttons) {
			button.setAttribute('aria-pressed', String(dark));
			button.setAttribute('aria-label', dark ? 'Activar modo claro' : 'Activar modo oscuro');
		}
	};

	sync();
	for (const button of buttons) {
		button.addEventListener('click', () => {
			const dark = document.documentElement.dataset.theme !== 'theme-dark';
			document.documentElement.dataset.theme = dark ? 'theme-dark' : 'theme';
			try {
				localStorage.setItem('scruz-theme', dark ? 'dark' : 'light');
			} catch {
				/* almacenamiento bloqueado: la elección no sobrevive al recargar */
			}
			document
				.querySelector('meta[name="theme-color"]')
				?.setAttribute('content', dark ? '#0e1620' : '#4b6e9f');
			sync();
		});
	}
})();
</script>
