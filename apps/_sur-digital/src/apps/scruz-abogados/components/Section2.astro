---
import { Image } from '../@astro-components/index.ts';

const { balImg, certImg, peopImg, hammImg } = Astro.props;
---

<div class="band band-primary bg-primary text-primary-content">
	<h2 class="pb-20 text-center text-5xl font-bold max-[380px]:break-words">
		¿Necesitas asesoramiento legal?
	</h2>
	<!--
		Rejilla de 4 columnas iguales. Antes era `flex ... md:justify-between` sin
		`flex-1` en los hijos, así que cada columna medía lo que medía su texto y el
		reparto quedaba desigual: los iconos no guardaban la misma distancia entre sí
		(el de "Más de 20 años de experiencia" es el rótulo más largo y empujaba la
		fila). Mismo caso que la banda "Siempre a tu lado" de index.astro.
		2 columnas en móvil/tablet y 4 desde lg: cuatro bloques de texto en una fila
		no caben antes de eso.
	-->
	<div class="mx-auto grid max-w-6xl gap-8 sm:grid-cols-2 lg:grid-cols-4">
		<div class="flex flex-col items-center gap-4">
			<Image
				src={balImg}
				alt="Balanza de justicia simbolizando más de 20 años de experiencia legal"
				class="size-20 object-contain"
			/>
			<p class="text-center text-xl">Más de 20 años de experiencia</p>
		</div>

		<div class="flex flex-col items-center gap-4">
			<Image
				src={certImg}
				alt="Certificado representando un equipo multidisciplinario de abogados"
				class="size-20 object-contain"
			/>

			<p class="text-center text-xl">Equipo multidisciplinar</p>
		</div>

		<div class="flex flex-col items-center gap-4">
			<Image
				src={peopImg}
				alt="Icono de persona indicando atención personalizada para clientes"
				class="size-20 object-contain"
			/>
			<p class="text-center text-xl">Atención personalizada</p>
		</div>

		<div class="flex flex-col items-center gap-4">
			<Image
				src={hammImg}
				alt="Martillo de juez simbolizando resultados garantizados en casos legales"
				class="size-20 object-contain"
			/>
			<p class="text-center text-xl">Resultados garantizados</p>
		</div>
	</div>
</div>
