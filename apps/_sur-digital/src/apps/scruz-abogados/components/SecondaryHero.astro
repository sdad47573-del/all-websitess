---
const { title, description, background } = Astro.props;
---

<!--
	transition:animate sólo en el slot principal del Layout; este header cambia
	de background entre páginas (URL distinta) por lo que no usamos transition:name
	para evitar un morph visual de imagen cruzada.
	Comparte lenguaje con EditorialHero: overlay azul→negro, contenido alineado a
	la izquierda sobre max-w-6xl y fundido inferior hacia base-100, de forma que
	las páginas clásicas abran igual que las fichas de servicio.
-->
<section
	class="relative bg-cover bg-center bg-no-repeat py-24"
	style={`background-image: url(${background});`}
>
	<div
		class="absolute inset-0 bg-gradient-to-br from-primary/85 via-primary/55 to-black/70 dark:from-neutral/95 dark:via-neutral/85 dark:to-black/90"
		aria-hidden="true"
	>
	</div>
	<div
		class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-base-100 to-transparent"
		aria-hidden="true"
	>
	</div>
	<div class="relative z-10 mx-auto w-full max-w-6xl px-6 text-white md:px-16">
		<h1 class="animate-fade-in-up font-title text-4xl font-bold leading-[1.05] sm:text-5xl md:text-6xl">
			{title}
		</h1>
		<p class="animate-fade-in-up mt-5 max-w-2xl text-base leading-relaxed text-white/90 sm:text-lg" style="animation-delay: 0.1s">
			{description}
		</p>
	</div>
</section>
