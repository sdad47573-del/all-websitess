---
/**
 * CTA compacto para guías del blog.
 *
 * Contexto: el tráfico orgánico entra por un artículo con una duda concreta y
 * la única llamada a la acción estaba al final de páginas de 2.000 palabras.
 * Este bloque va justo debajo del titular (arriba del primer scroll) y ofrece
 * las dos vías reales de contacto del despacho, sin tapar el contenido ni
 * competir con el hero de las landings de servicio.
 *
 * Se usa en `pages/blog/[slug].astro` (168 guías) y en las guías estáticas con
 * más impresiones en Search Console.
 */
import { PhoneCall } from '@lucide/astro';

interface Props {
	/** Clases extra; por defecto añade el margen inferior del bloque. */
	class?: string;
}

const { class: className = 'mb-10' } = Astro.props;
---

<div
	class:list={[
		'reveal-pop border-base-300 bg-base-200 mx-auto flex max-w-4xl flex-col gap-4 rounded-2xl border p-5 md:flex-row md:items-center md:justify-between md:p-6',
		className,
	]}
>
	<p class="text-base-content/80 text-base">
		<strong class="text-base-content">¿Es tu caso?</strong> Primera consulta gratuita y
		confidencial: te decimos qué plazo corre y qué opciones tienes antes de gastar nada.
	</p>
	<div class="flex shrink-0 flex-col gap-2 sm:flex-row">
		<a class="btn btn-primary btn-sm gap-2" href="tel:+34666329155">
			<PhoneCall class="size-4" aria-hidden="true" /> 666 329 155
		</a>
		<a
			class="btn btn-outline btn-neutral btn-sm gap-2"
			href="https://wa.me/34666329155?text=Hola%2C%20quisiera%20realizar%20una%20consulta%20legal%2C%20%C2%BFpodr%C3%ADamos%20agendar%20una%20cita%3F"
			target="_blank"
			rel="noopener noreferrer">WhatsApp</a
		>
	</div>
</div>
