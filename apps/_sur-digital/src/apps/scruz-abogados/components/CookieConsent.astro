---
/**
 * Banner de consentimiento de cookies.
 *
 * Qué cubre: la web no usa analítica ni publicidad, pero sí incrusta mapas de
 * Google (terceros) y guarda la preferencia de tema en `localStorage`. El banner
 * informa de ambas cosas y permite aceptar o rechazar con la misma visibilidad,
 * como exige la Guía de cookies de la AEPD.
 *
 * Cómo funciona:
 *  - Se renderiza oculto (`hidden`): sin JavaScript no aparece ni bloquea nada,
 *    y los mapas tampoco se cargan (ver `ConsentMap.astro`).
 *  - La decisión se guarda en `localStorage['scruz-cookies']` (`all` o
 *    `necessary`), igual que el tema, y se reaplica en cada navegación SPA
 *    porque el script lleva `data-astro-rerun`.
 *  - El botón "Configurar cookies" del pie (`[data-cookie-open]`) vuelve a
 *    abrirlo, de modo que retirar el consentimiento cuesta lo mismo que darlo.
 *
 * El listener se registra UNA vez en `document` (los elementos del banner y de
 * los mapas se reemplazan en cada navegación), y consulta el DOM en el momento
 * del clic, no en el de la carga.
 */
interface Props {
	/** Idioma del banner: `en` en las landings de /en/. */
	lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

const copy =
	lang === 'en'
		? {
				label: 'Cookie notice',
				title: 'Cookies and Google maps',
				body: 'This site uses no analytics or advertising. It only stores your theme preference in the browser and, if you accept, loads Google maps, which may set third-party cookies.',
				more: 'More information',
				accept: 'Accept all',
				reject: 'Essential only',
			}
		: {
				label: 'Aviso de cookies',
				title: 'Cookies y mapas de Google',
				body: 'Esta web no usa analítica ni publicidad. Solo guarda tu preferencia de tema en el navegador y, si lo aceptas, carga los mapas de Google, que pueden instalar cookies de terceros.',
				more: 'Más información',
				accept: 'Aceptar todas',
				reject: 'Solo necesarias',
			};
---

<div
	id="cookie-banner"
	class="border-base-300 bg-base-100 fixed inset-x-0 bottom-0 z-[70] hidden max-h-[70vh] overflow-y-auto border-t p-4 shadow-2xl md:p-6"
	role="region"
	aria-label={copy.label}
	data-cookie-banner
>
	<div class="mx-auto flex max-w-6xl flex-col gap-4 md:flex-row md:items-center md:justify-between">
		<div class="text-base-content/80 text-sm">
			<p class="text-base-content mb-1 font-semibold">{copy.title}</p>
			<p>
				{copy.body}
				<a class="link link-primary" href="/scruz-abogados/aviso-legal/#cookies">{copy.more}</a>.
			</p>
		</div>
		<div class="flex flex-col gap-2 sm:flex-row">
			<button type="button" class="btn btn-primary btn-sm" data-cookie-accept>{copy.accept}</button>
			<button type="button" class="btn btn-outline btn-neutral btn-sm" data-cookie-reject
				>{copy.reject}</button
			>
		</div>
	</div>
</div>

<script is:inline data-astro-rerun>
	(() => {
		const KEY = 'scruz-cookies';

		const read = () => {
			try {
				return localStorage.getItem(KEY);
			} catch {
				// Almacenamiento bloqueado (modo privado): se pregunta en cada página.
				return null;
			}
		};

		const save = (value) => {
			try {
				localStorage.setItem(KEY, value);
			} catch {
				/* sin persistencia, pero la decisión aplica a esta página */
			}
		};

		/* Consultas en el momento del uso: en navegaciones SPA el DOM es nuevo. */
		const banners = () => document.querySelectorAll('[data-cookie-banner]');
		const feeds = () => document.querySelectorAll('[data-consent-embed]');

		/* El FAB de WhatsApp vive fijo en la esquina inferior derecha y, con el
		 * banner abierto, tapaba el botón «Solo necesarias». Mientras hay banner
		 * visible se publica su altura en <html> y el CSS sube el FAB justo
		 * encima (regla `html[data-cookie-visible] .fab` en styles/index.css).
		 * Se mide después de quitar `hidden`, que es cuando ya tiene altura. */
		const syncFab = () => {
			const open = document.querySelector('[data-cookie-banner]:not(.hidden)');
			const root = document.documentElement;
			if (!open) {
				delete root.dataset.cookieVisible;
				root.style.removeProperty('--cookie-banner-h');
				return;
			}
			root.dataset.cookieVisible = '';
			root.style.setProperty('--cookie-banner-h', `${open.offsetHeight}px`);
		};

		const show = () => {
			banners().forEach((el) => el.classList.remove('hidden'));
			syncFab();
		};
		const hide = () => {
			banners().forEach((el) => el.classList.add('hidden'));
			syncFab();
		};

		const loadEmbed = (wrapper) => {
			const iframe = wrapper.querySelector('iframe[data-consent-src]');
			if (!iframe) return;
			iframe.src = iframe.dataset.consentSrc;
			iframe.removeAttribute('data-consent-src');
			wrapper.querySelector('[data-consent-placeholder]')?.remove();
		};

		const loadAll = () => feeds().forEach(loadEmbed);

		const apply = () => {
			const decision = read();
			if (decision === 'all') {
				loadAll();
				hide();
			} else if (decision === 'necessary') {
				hide();
			} else {
				show();
			}
		};

		apply();

		/* Un único listener por documento: el script se re-ejecuta en cada
		 * navegación SPA y, sin esta guarda, se acumularían handlers. */
		if (!window.__scruzCookieInit) {
			window.__scruzCookieInit = true;
			/* El alto del banner cambia al girar el móvil o redimensionar. */
			window.addEventListener('resize', syncFab);
			document.addEventListener('click', (event) => {
				const target = event.target instanceof Element ? event.target : null;
				if (!target) return;

				if (target.closest('[data-cookie-accept]')) {
					save('all');
					loadAll();
					hide();
					return;
				}
				if (target.closest('[data-cookie-reject]')) {
					save('necessary');
					hide();
					return;
				}
				if (target.closest('[data-cookie-open]')) {
					show();
					return;
				}
				if (target.closest('[data-cookie-load-map]')) {
					const wrapper = target.closest('[data-consent-embed]');
					if (wrapper) loadEmbed(wrapper);
				}
			});
		}
	})();
</script>
