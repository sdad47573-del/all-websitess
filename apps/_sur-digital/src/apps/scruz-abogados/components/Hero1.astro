---
import HeroBgImg from '@assets/hero-bg.webp';

import { getImage, Image } from '@astro-components';
import { RiIcon } from '@astro-icons';

import { twJoin } from 'tailwind-merge';
import { DATA } from '../data/data';
import { HERO_IMAGES } from './heroImages';

const optimized = await getImage({
	src: HeroBgImg,
	format: 'webp',
});
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<div
	class="relative overflow-hidden bg-top bg-repeat max-md:!bg-none dark:!bg-none"
	style={`background-image: url(${optimized.src});`}
>
	<picture class="absolute right-[-125px] bottom-0 z-[1] hidden h-[90%] w-auto object-contain md:block lg:right-0 xl:right-[10%]">
		<source srcset={HERO_IMAGES.desktop.avif.src} type="image/avif" media="(min-width: 768px)" />
		<source srcset={HERO_IMAGES.desktop.webp.src} type="image/webp" media="(min-width: 768px)" />
		<img
			src={HERO_IMAGES.mobile.webp.src}
			alt=""
			class="hero-portrait h-full w-auto object-contain"
			loading="lazy"
			decoding="async"
			width="800"
			height="1200"
		/>
	</picture>
	<div class="flex flex-col justify-between">
		<!--
			Retrato del hero en móvil, con encuadre determinista.

			La altura sale del ANCHO (aspect 5/4), no de `vh`: con `h-[60vh]` el
			recorte dependía de la proporción de la ventana y en ventanas anchas y bajas
			el bloque se quedaba corto, así que el `object-cover` cortaba la cara a la
			altura de la boca (medido: 41 % de la imagen visible, cuando la cabeza
			necesita hasta el 45 %).

			5/4 deja ver siempre el mismo tramo del original —de 0 a 53,3 %: aire sobre
			el pelo, cara completa (8–45 % del PNG, medido) y hombros— porque es el
			encuadre más cerrado que todavía contiene la cabeza entera. Al no depender
			de la altura de la ventana, el retrato se ve igual en cualquier móvil.
		-->
		<div class="relative aspect-[5/4] overflow-hidden md:hidden">
			<div class="h-full bg-top bg-repeat dark:!bg-none" style={`background-image: url(${optimized.src});`}>
				<picture class="relative z-[1] block h-full">
					<source srcset={HERO_IMAGES.mobile.avif.src} type="image/avif" />
					<source srcset={HERO_IMAGES.mobile.webp.src} type="image/webp" />
					<img
						src={HERO_IMAGES.mobile.webp.src}
						alt=""
						class="hero-portrait h-full w-full object-cover object-top"
						loading="lazy"
						decoding="async"
						width="412"
						height="618"
					/>
				</picture>
			</div>
			<!--
				Velo inferior: asienta la identidad sobre el retrato (los hombros son la
				zona ancha y estable del recorte) y funde el borde del bloque con el hero.
				`neutral` es la tinta de la casa en los dos temas: en oscuro el velo cae
				sobre el mismo azul del hero y en claro se lee como el degradado propio
				de la foto, en lugar del corte recto contra la superficie.
			-->
			<div
				class="pointer-events-none absolute inset-x-0 bottom-0 z-[2] h-[45%] bg-gradient-to-t from-neutral/95 via-neutral/75 to-transparent"
				aria-hidden="true">
			</div>
			<!--
				Identidad sobre el velo. El kicker no usa `.hero-kicker`: en claro esa
				clase es azul de marca, pensado para la textura clara, y aquí iría sobre
				un velo oscuro (fallaría el contraste). Sobre el velo el acento de la casa
				es el gold, el mismo que ya usa el kicker de escritorio en oscuro.
				El nombre, en `neutral-content`: blanco en claro y #e8edf4 en oscuro.
			-->
			<div class="absolute inset-x-0 bottom-0 z-[3] p-4 text-start">
				<p class="text-warning animate-fade-in-up text-base font-semibold">
					Despacho de abogados en Málaga
				</p>
				<p
					class="text-neutral-content font-title animate-fade-in-up text-3xl font-bold"
					style="animation-delay: 0.1s;"
				>
					Sergio Cruz Chacón
				</p>
			</div>
		</div>
	</div>

	<!--
		`relative` NO sobra: sin él el z-10 no se aplica (z-index solo actúa
		en elementos posicionados), el contenido se pinta en el flujo normal y
		la capa de tinta de oscuro —que es absoluta y va después en el DOM— lo
		tapaba. Con colores claros sobre ese velo, el hero se veía casi vacío en
		modo oscuro. Mismo patrón que Hero.astro y SecondaryHero.astro.
	-->
	<div
		class="relative z-10 mx-auto flex w-full flex-col gap-4 p-4 px-4 pb-16 text-center md:px-16 md:pt-16 md:pb-36 lg:max-w-6xl"
	>
		<div class="text-start md:max-w-md md:p-4 lg:max-w-xl">
			<p class="hero-kicker animate-fade-in-up hidden text-lg md:block">Despacho de abogados en Málaga</p>
			<p class="font-title animate-fade-in-up hidden text-4xl font-bold md:block" style="animation-delay: 0.1s;">Sergio Cruz Chacón</p>
			<h1 class="animate-fade-in-up text-2xl leading-snug" style="animation-delay: 0.15s;" set:html={piezas.portada.titulo} />
			<p class="animate-fade-in-up mt-2" style="animation-delay: 0.18s">
				Más de 20 años ofreciendo soluciones jurídicas eficaces en derecho civil, penal, laboral,
				mercantil y de familia.
			</p>
		</div>
		<!--
			En móvil los CTA van ANTES de las tarjetas (`max-md:order-*`): con las
			cuatro tarjetas delante quedaban a ~1.360 px del inicio, casi dos
			pantallas por debajo de un hero cuyo objetivo es llamar. En escritorio
			se mantiene el orden original (tarjetas y luego botones).
		-->
		<div
			class="animate-fade-in-up mt-6 grid grid-cols-1 justify-items-center gap-6 max-md:order-2 sm:grid-cols-2 sm:gap-8 md:mt-10 md:w-fit md:grid-cols-1 lg:grid-cols-2"
			style="animation-delay: 0.26s"
		>
			{
				DATA.heroServices.map(({ title, img, description }, idx) => (
					<div
						class={twJoin(
							'flex w-full min-w-0 max-w-72 flex-col items-center justify-between gap-4',
							idx % 2 === 0 ? 'lg:justify-self-end' : 'lg:justify-self-start',
						)}
					>
						<div class="flex flex-col items-center gap-2">
							<figure class="size-11">
								<Image
									src={img}
									alt={`Representación de ${title.toLowerCase()}`}
									class="hero-service-icon rounded-xl"
									width={44}
									height={44}
								/>
							</figure>
							<h2 class="card-title text-center">{title}</h2>
							<p class="text-center">{description} </p>
						</div>
					</div>
				))
			}
		</div>
		<div
			class="animate-fade-in-up mt-2 flex flex-col items-stretch justify-center gap-3 max-md:order-1 sm:flex-row sm:flex-wrap md:flex-col lg:ml-14 lg:flex-row lg:justify-start"
			style="animation-delay: 0.34s"
		>
			<a
				href="tel:+34666329155"
				class="btn btn-primary btn-lg gap-2 sm:btn-wide lg:w-fit"
				aria-label="Llamar ahora al 666 329 155 para tu consulta gratuita"
			>
				<RiIcon name="phoneFill" class="size-5" />
				Llamar: 666 329 155
			</a>
			<a
				href="https://wa.me/34666329155?text=Hola%2C%20quisiera%20realizar%20una%20consulta%20legal%2C%20%C2%BFpodr%C3%ADamos%20agendar%20una%20cita%3F"
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-outline btn-neutral btn-lg gap-2 sm:btn-wide lg:w-fit"
			>
				<RiIcon name="whatsapp" class="size-5" />
				WhatsApp
			</a>
			<a
				href="/scruz-abogados/servicios/"
				class="mt-1 inline-flex items-center justify-center gap-1 text-sm font-semibold text-gray-700 transition-colors hover:text-primary hover:underline sm:basis-full lg:ml-1 lg:mt-0 lg:justify-start"
				data-discover="true"
			>
				Ver todos los servicios
				<RiIcon name="arrowRight" class="size-4" />
			</a>
		</div>
	</div>

	<!--
		Modo oscuro: la textura de fondo del hero es clara y la tinta clara del
		tema no se leería sobre ella, así que en oscuro se apaga la textura
		(`dark:!bg-none` en el contenedor y en el bloque móvil) y esta capa aporta
		la profundidad del fondo.

		Todo lo que deba verse por encima tiene que ir POSICIONADO con su z-index:
		esta capa es absoluta, así que gana por orden de pintado a cualquier
		elemento del flujo normal. De ahí el `relative` del contenido, el z-[1] de
		los dos <picture> de la foto (un recorte con alfa que bajo el velo quedaba
		en mancha) y el z-[2] del fundido inferior del hero móvil, que va sobre la
		foto.
	-->
	<div
		class="pointer-events-none absolute inset-0 z-0 hidden bg-gradient-to-br from-neutral/95 via-neutral/80 to-neutral/45 dark:block"
		aria-hidden="true">
	</div>
</div>
