---
import { FAQ } from '../data/site';
---

<section id="faq" class="bg-base-200 border-base-300 border-t py-20 sm:py-24">
	<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
		<div class="text-center">
			<p class="text-secondary text-xs font-semibold tracking-[0.22em] uppercase">Preguntas frecuentes</p>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">Antes de venir</h2>
		</div>

		<div class="mt-10 space-y-3">
			{
				FAQ.map((item, index) => (
					<details class="border-base-300 bg-base-100 group rounded-2xl border" open={index === 0}>
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left font-semibold">
							{item.q}
							<i class="ri-add-line text-secondary shrink-0 text-xl transition-transform group-open:rotate-45" />
						</summary>
						<p class="text-base-content/70 px-5 pb-5 text-sm leading-relaxed">{item.a}</p>
					</details>
				))
			}
		</div>
	</div>
</section>
