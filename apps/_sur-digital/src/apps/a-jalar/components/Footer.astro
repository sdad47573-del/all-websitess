---
import { Image } from '@astro-components';
import { BUSINESS, HOURS, IMAGES, NAV, PAGE_NAV } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-neutral text-neutral-content">
	<div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
		<div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
			<div class="lg:col-span-2">
				<Image
					src={IMAGES.logo}
					alt="A JALAR, kebab artesanal en Málaga"
					widths={[200, 320, 440]}
					sizes="(min-width: 1024px) 260px, 220px"
					quality={90}
					class="h-11 w-auto"
				/>
				<p class="mt-5 max-w-md text-sm leading-relaxed text-white/70">{BUSINESS.summary}</p>
				<div class="mt-6 flex gap-3">
					<a
						href={BUSINESS.instagram}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Instagram de A JALAR"
						class="hover:bg-secondary flex size-10 items-center justify-center rounded-full bg-white/10 transition-colors"
					>
						<i class="ri-instagram-line text-lg"></i>
					</a>
					<a
						href={BUSINESS.facebook}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Facebook de A JALAR"
						class="hover:bg-secondary flex size-10 items-center justify-center rounded-full bg-white/10 transition-colors"
					>
						<i class="ri-facebook-circle-line text-lg"></i>
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="A JALAR en Google Maps"
						class="hover:bg-secondary flex size-10 items-center justify-center rounded-full bg-white/10 transition-colors"
					>
						<i class="ri-map-pin-line text-lg"></i>
					</a>
					<a
						href={BUSINESS.phoneHref}
						aria-label={`Llamar a A JALAR al ${BUSINESS.phoneDisplay}`}
						class="hover:bg-secondary flex size-10 items-center justify-center rounded-full bg-white/10 transition-colors"
					>
						<i class="ri-phone-line text-lg"></i>
					</a>
				</div>
			</div>

			<div>
				<h3 class="font-display text-lg font-semibold text-white">Secciones</h3>
				<ul class="mt-4 space-y-2 text-sm text-white/70">
					{
						NAV.map((item) => (
							<li>
								<a href={`/${item.href}`} class="hover:text-secondary transition-colors">
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
				<ul class="mt-4 space-y-2 border-t border-white/10 pt-4 text-sm text-white/70">
					{
						PAGE_NAV.map((item) => (
							<li>
								<a href={item.href} class="hover:text-secondary transition-colors">
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h3 class="font-display text-lg font-semibold text-white">Contacto</h3>
				<ul class="mt-4 space-y-3 text-sm text-white/70">
					<li class="flex items-start gap-2">
						<i class="ri-map-pin-line text-secondary mt-0.5"></i>
						<span>
							{BUSINESS.street}<br />
							{BUSINESS.postalCode}
							{BUSINESS.district}<br />
							{BUSINESS.city}
						</span>
					</li>
					<li class="flex items-center gap-2">
						<i class="ri-phone-line text-secondary"></i>
						<a href={BUSINESS.phoneHref} class="hover:text-secondary">{BUSINESS.phoneDisplay}</a>
					</li>
					<li class="flex items-center gap-2">
						<i class="ri-star-fill text-secondary"></i>
						<span>{BUSINESS.rating.value} / 5 · {BUSINESS.rating.count} reseñas</span>
					</li>
					{
						HOURS.filter((dia) => dia.hours !== 'Cerrado').map((dia) => (
							<li class="flex items-center gap-2">
								<i class="ri-time-line text-secondary" />
								<span>
									{dia.days}: {dia.hours}
								</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div
			class="mt-12 flex flex-col gap-6 border-t border-white/10 pt-8 text-xs text-white/50 lg:flex-row lg:items-center lg:justify-between"
		>
			<div class="flex flex-col gap-3">
				<nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Información legal">
					<a href="/a-jalar/aviso-legal" class="hover:text-secondary transition-colors">Aviso legal</a>
					<a href="/a-jalar/aviso-legal#privacidad" class="hover:text-secondary transition-colors"
						>Privacidad</a
					>
					<a href="/a-jalar/aviso-legal#cookies" class="hover:text-secondary transition-colors"
						>Cookies</a
					>
				</nav>
				<p>
					© {year} A JALAR. Todos los derechos reservados.
				</p>
			</div>

			<div class="flex flex-wrap items-center gap-x-6 gap-y-3">
				<a
					href={BUSINESS.googleMaps}
					target="_blank"
					rel="noopener noreferrer"
					class="hover:text-secondary transition-colors">Ver ficha en Google Maps</a
				>
				<p>
					Web creada por
					<a
						href="https://sur-digital.vercel.app/"
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-secondary font-medium transition-colors">Sur Digital</a
					>
				</p>
			</div>
		</div>
	</div>
</footer>
