---
import '../styles/global.css';
import { BUSINESS, MAPS, SERVICES, MENU, FAQ } from '../data/site';
import { Image } from 'astro:assets';
import HeroPhoto from '../assets/fotos/ruota-arroces-apaisada-05.jpg';
import DiningRoom from '../assets/fotos/ruota-arroces-apaisada-01.jpg';
import RicePhoto from '../assets/fotos/ruota-arroces-apaisada-03.jpg';
import MixedRice from '../assets/fotos/ruota-arroces-apaisada-07.jpg';
import PaellaPhoto from '../assets/fotos/ruota-arroces-apaisada-09.jpg';
import VerticalPhoto02 from '../assets/fotos/ruota-arroces-vertical-02.jpg';
import VerticalPhoto04 from '../assets/fotos/ruota-arroces-vertical-04.jpg';
import VerticalPhoto06 from '../assets/fotos/ruota-arroces-vertical-06.jpg';
import VerticalPhoto08 from '../assets/fotos/ruota-arroces-vertical-08.jpg';
import VerticalPhoto10 from '../assets/fotos/ruota-arroces-vertical-10.jpg';

const galleryPhotos = [
  { src: DiningRoom, alt: 'Comedor de RuOta Arroces en Bormujos' },
  { src: RicePhoto, alt: 'Arroz preparado en RuOta Arroces' },
  { src: MixedRice, alt: 'Plato con dos arroces de la casa' },
  { src: PaellaPhoto, alt: 'Paella valenciana preparada en RuOta' },
  { src: VerticalPhoto02, alt: 'Plato de la galería de RuOta Arroces' },
  { src: VerticalPhoto04, alt: 'Preparación de arroz fotografiada en el restaurante' },
  { src: VerticalPhoto06, alt: 'Arroz para compartir en RuOta' },
  { src: VerticalPhoto08, alt: 'Una especialidad de la arrocería de Bormujos' },
  { src: VerticalPhoto10, alt: 'Otra imagen del perfil público de RuOta en Google Maps' },
];

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: BUSINESS.name,
  alternateName: 'RuOta Arroces',
  description: BUSINESS.description,
  url: `${BUSINESS.siteUrl}/`,
  telephone: '+34648878619',
  servesCuisine: ['Arroz valenciano', 'Paella', 'Fideuá', 'Cocina tradicional'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.street,
    addressLocality: BUSINESS.city,
    addressRegion: BUSINESS.region,
    postalCode: BUSINESS.postalCode,
    addressCountry: BUSINESS.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: BUSINESS.geo.lat, longitude: BUSINESS.geo.lng },
  hasMap: MAPS.place,
  sameAs: [MAPS.instagram],
  openingHours: 'Tu-Su 13:00-17:00',
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RuOta Arroces | Paellas y arroces para llevar en Bormujos</title>
    <meta name="description" content={BUSINESS.description} />
    <meta name="keywords" content="RuOta Arroces, arroces Bormujos, paella Bormujos, arroz valenciano Sevilla, comida para llevar" />
    <meta name="theme-color" content="#263d2e" />
    <link rel="canonical" href={`${BUSINESS.siteUrl}/`} />
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:title" content="RuOta Arroces | Paellas y arroces para llevar en Bormujos" />
    <meta property="og:description" content={BUSINESS.description} />
    <meta property="og:url" content={`${BUSINESS.siteUrl}/`} />
    <meta property="og:image" content={`${BUSINESS.siteUrl}/og.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/ruota-arroces/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="topbar">
      <div class="topbar-inner wrap">
        <a class="brand" href="#inicio" aria-label="RuOta Arroces, inicio"><span class="brand-mark" aria-hidden="true">{BUSINESS.mark}</span><span class="brand-name">RuOta<small>Arroces · Bormujos</small></span></a>
        <nav aria-label="Navegación principal"><a href="#arroces">La casa</a><a href="#carta">Especialidades</a><a href="#galeria">Galería</a><a href="#visitanos">Cómo llegar</a></nav>
        <a class="topbar-phone" href={BUSINESS.phoneHref}>Llamar · 648 87 86 19</a>
      </div>
    </header>
    <main id="contenido">
      <section class="hero wrap" id="inicio">
        <div>
          <p class="eyebrow"><span aria-hidden="true"></span> Arrocería · Bormujos</p>
          <h1 set:html={piezas.portada.titulo} />
          <p class="hero-lede">En RuOta, Alessandro Rudas cocina arroces valencianos, paellas y fideuás para disfrutar en el local o encargar para recoger. Recetas para compartir, con sabor mediterráneo en el Aljarafe.</p>
          <div class="hero-actions"><a class="button button-primary" href={BUSINESS.phoneHref}>Encarga tu arroz <span aria-hidden="true">↗</span></a><a class="button button-ghost" href="#carta">Descubre las especialidades</a></div>
          <ul class="hero-facts" aria-label="Información de RuOta"><li><b>Más de 20</b>tipos de arroz</li><li><b>Mar–dom</b>13:00–17:00</li><li><b>Bormujos</b>Aljarafe, Sevilla</li></ul>
        </div>
        <figure class="hero-photo"><span class="hero-tag">Arroces para compartir</span><Image src={HeroPhoto} alt="Arroz de la galería pública de RuOta Arroces en Bormujos" widths={[480,720,960]} sizes="(max-width: 899px) 100vw, 46vw" format="webp" quality={78} loading="eager" fetchpriority="high" /><figcaption><span>Arroces hechos al momento</span><a href={MAPS.place} target="_blank" rel="noopener noreferrer">Fotos de Google Maps ↗</a></figcaption></figure>
      </section>
      <section class="wrap" aria-label="Servicios de RuOta"><ul class="chips">{SERVICES.map((service) => <li>{service}</li>)}</ul></section>

      <section class="about section-pad wrap" id="arroces">
        <p class="section-label"><span aria-hidden="true"></span> Arroces con historia</p>
        <div class="about-grid"><h2>Tradición valenciana con acento del Aljarafe.</h2><div class="about-copy"><p>RuOta es una arrocería de Bormujos capitaneada por Alessandro Rudas. La pasión por el arroz viene de familia: aprendió los secretos de la paella de su suegro, el maestro arrocero Carlos Otaola.</p><p>La cocina ofrece arroces secos, caldosos y fideuás, además de platos tradicionales. Puedes disfrutarlos en el restaurante o encargarlos para recoger.</p><p class="about-note">La carta, variedades y precios pueden cambiar. Llama para consultar qué arroces hay disponibles y cuánto tiempo necesita tu encargo.</p><div class="about-links"><a class="simple-link" href={MAPS.instagram} target="_blank" rel="noopener noreferrer">Instagram de RuOta ↗</a><a class="simple-link" href={MAPS.place} target="_blank" rel="noopener noreferrer">Ver ficha en Google Maps ↗</a></div></div></div>
      </section>

      <section class="wrap" aria-label="Lo que hace especial a RuOta"><div class="highlights"><article><h3>Arroces valencianos</h3><p>Una selección de más de veinte variedades para diferentes gustos y ocasiones.</p></article><article><h3>Hechos para compartir</h3><p>Paellas, arroces caldosos y fideuás preparados para disfrutar en buena compañía.</p></article><article><h3>Para comer o recoger</h3><p>Quédate a comer en RuOta o haz tu encargo para recoger y compartir en casa.</p></article></div></section>

      <section class="menu" id="carta"><div class="wrap"><div class="menu-head"><div><p class="eyebrow"><span aria-hidden="true"></span> Especialidades de la casa</p><h2>El arroz es<br /><em>el protagonista.</em></h2></div><div><p>Una veintena de arroces, fideuás y recetas tradicionales. Consulta la carta actual, los formatos para compartir y los encargos disponibles directamente con RuOta.</p><a class="button button-primary" href={BUSINESS.phoneHref}>Llama para consultar · 648 87 86 19</a></div></div><div class="menu-groups">{MENU.map((group) => <div class="menu-group"><h3>{group.title}</h3><ul class="dishes">{group.items.map((item) => <li><span class="dish">{item.name}<em>{item.note}</em></span></li>)}</ul></div>)}</div><p class="menu-note">Los platos, precios y encargos están sujetos a disponibilidad. Llama antes para consultar variedades y tiempos de preparación.</p></div></section>

      <section class="gallery section-pad wrap" id="galeria"><div class="gallery-head"><div><p class="eyebrow"><span aria-hidden="true"></span> Desde la cocina de RuOta</p><h2>Un arroz que<br /><em>entra por los ojos.</em></h2></div><div><p>Fotografías descargadas del perfil público del restaurante en Google Maps. Visita la ficha para ver más imágenes y consultar novedades.</p><a class="button button-primary" href={MAPS.place} target="_blank" rel="noopener noreferrer">Abrir ficha de Google Maps ↗</a></div></div><div class="gallery-grid">{galleryPhotos.map((photo) => <figure class="shot"><Image src={photo.src} alt={photo.alt} widths={[320,480,640]} sizes="(max-width: 640px) 92vw, (max-width: 980px) 45vw, 23vw" format="webp" quality={65} loading="lazy" decoding="async" /></figure>)}</div><p class="gallery-note">Imágenes del perfil público de RuOta en Google Maps.</p></section>

      <section class="visit section-pad" id="visitanos"><div class="wrap visit-grid"><div class="visit-copy"><p class="eyebrow"><span aria-hidden="true"></span> Ven a disfrutar</p><h2>Nos vemos en <em>Bormujos.</em></h2><p class="address">{BUSINESS.street}<br />{BUSINESS.postalCode} {BUSINESS.city}, {BUSINESS.region}</p><p class="hours-note"><strong>Martes a domingo, 13:00–17:00.</strong> Horario publicado en el perfil del restaurante; confirma disponibilidad y servicio antes de desplazarte.</p><a class="phone-link" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a><div class="visit-links"><a class="button button-primary" href={MAPS.directions} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a><a class="button button-ghost" href={MAPS.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a></div><p class="reserve-note">Llama para reservas, encargos de arroz y recogidas: algunas especialidades requieren preparación por encargo.</p></div><div class="map-frame"><iframe title="Mapa de RuOta Arroces en Calle Conde de Barcelona, Bormujos" src={MAPS.embed} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><a class="map-label" href={MAPS.directions} target="_blank" rel="noopener noreferrer">⌖ Abrir ruta</a></div></div></section>

      <section class="faq section-pad wrap" id="preguntas"><p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{FAQ.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></section>
    </main>
    <footer class="site-footer"><div class="wrap"><div class="footer-grid"><div class="footer-brand"><span class="brand-mark" aria-hidden="true">R</span><div><p>RuOta Arroces</p><small>{BUSINESS.street} · {BUSINESS.city}</small></div></div><nav aria-label="Enlaces del pie"><a href="#inicio">Inicio</a><a href={MAPS.place} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={MAPS.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href="/ruota-arroces/aviso-legal">Aviso legal</a></nav></div><span class="legal">Arroces para compartir · Bormujos, Sevilla</span><p class="credit">Creado por <a href="https://www.sur-digital.com" target="_blank" rel="noopener noreferrer">Sur Digital</a></p></div></footer>
    <a class="mobile-call" href={BUSINESS.phoneHref}>Llamar a RuOta · 648 87 86 19</a>
  <!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34648878619?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Ruota%20Arroces%20y%20Comida%20para%20Llevar." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Ruota Arroces y Comida para Llevar"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
