---
import Casa from '../components/Casa.astro';
import Cocina from '../components/Cocina.astro';
import Contact from '../components/Contact.astro';
import Fab from '../components/Fab.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Galeria from '../components/Galeria.astro';
import Hero from '../components/Hero.astro';
import Highlights from '../components/Highlights.astro';
import Opiniones from '../components/Opiniones.astro';
import Topbar from '../components/Topbar.astro';
import { breadcrumbs } from '../data/schema';
import Layout from '../layouts/Layout.astro';
---

<Layout schema={[breadcrumbs([{ name: 'Inicio', path: '/' }])]}>
	<Topbar />
	<main>
		<Hero />
		<Highlights />
		<Casa />
		<Cocina />
		<Galeria />
		<Opiniones />
		<Contact />
		<Faq />
	</main>
	<Footer />
	<Fab />
<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34651560835?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Restaurante%20Dos%20Caridad." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Restaurante Dos Caridad"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
</Layout>
