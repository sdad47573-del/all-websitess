---
import { BUSINESS } from '../data/site';
---

<section id="contacto" class="bg-base-200 scroll-mt-20 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">Visítanos</span>
			<h2 class="font-display mt-3 text-4xl font-semibold sm:text-5xl">Dónde estamos</h2>
			<div class="bg-secondary mx-auto mt-5 h-0.5 w-24"></div>
			<p class="text-base-content/70 mt-6">
				En el Callejón Alto de las Cuevas, 2, en Sanlúcar de Barrameda. Abrimos de martes a
				domingo; los lunes, cerrado.
			</p>
		</div>

		<div class="mt-14 grid gap-6 lg:grid-cols-2">
			<div class="space-y-6">
				<div class="border-base-300 bg-base-100 rounded-lg border p-7">
					<h3 class="font-display text-2xl font-semibold">Horario</h3>
					<div class="mt-5 space-y-3 text-sm">
						{
							BUSINESS.hours.map((tramo) => (
								<div class="border-base-300 flex items-baseline justify-between gap-4 border-b pb-3">
									<span class="font-semibold">{tramo.days}</span>
									<span class="text-base-content/70 text-right">{tramo.hours}</span>
								</div>
							))
						}
					</div>
					<p class="text-base-content/55 mt-4 text-xs leading-relaxed">{BUSINESS.hoursNote}</p>
				</div>

				<div class="border-base-300 bg-base-100 rounded-lg border p-7">
					<h3 class="font-display text-2xl font-semibold">Contacto</h3>
					<address class="mt-4 space-y-3 text-sm not-italic">
						<p class="flex gap-3">
							<i class="ri-map-pin-line text-primary mt-0.5"></i>
							<span>
								{BUSINESS.street}<br />
								{BUSINESS.postalCode} {BUSINESS.city}<br />
								{BUSINESS.region}
							</span>
						</p>
						<p class="flex gap-3">
							<i class="ri-phone-line text-primary mt-0.5"></i>
							<a class="font-semibold hover:underline" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
						</p>
					</address>
					<div class="mt-6 flex flex-wrap gap-3">
						<a href={BUSINESS.phoneHref} class="btn btn-primary gap-2 rounded-full">
							<i class="ri-phone-line"></i> Llamar
						</a>
						<a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline gap-2 rounded-full"
						>
							<i class="ri-google-fill"></i> Ficha de Google
						</a>
					</div>
				</div>
			</div>

			<div class="border-base-300 bg-base-100 overflow-hidden rounded-lg border shadow-sm">
				<iframe
					title="Mapa de Restaurante Dos Caridad en Sanlúcar de Barrameda"
					src={BUSINESS.googleMapsEmbed}
					class="h-full min-h-[440px] w-full border-0"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
			</div>
		</div>
	</div>
</section>
