---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	directionsUrl,
	facebookUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
	webOficialUrl,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Panaceite Centro · Taberna en Jaén junto a la Catedral';
const description =
	'Taberna y cocina española en la C. Bernabé Soriano, 1 de Jaén. 4,4 sobre 5 con 5.589 reseñas; abierto todos los días de 6:00 a 2:00 (8:00 el fin de semana).';
const keywords =
	'Panaceite Centro, Panaceite Jaén, taberna Jaén, Bernabé Soriano, tapear en Jaén, desayunos Jaén, cocina española Jaén, Panaceite teléfono';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas diez fotografías, así que no se inventa una
 * descripción y todos los `alt` avisan solo de dónde salen.
 */
const altFoto = 'Fotografía publicada en la ficha de Google Maps de Panaceite Centro, en Jaén';
const altOg = 'Fotografía de Panaceite Centro publicada en su ficha de Google Maps';

/**
 * Galería completa: las diez fotografías de la ficha.
 *
 * El manifiesto de la descarga no trajo autora, así que se publican sin pie y sin atribución: no
 * hay nada que citar.
 */
const galeria = [
	'panaceite-centro-panoramica-01.jpg',
	'panaceite-centro-vertical-02.jpg',
	'panaceite-centro-vertical-03.jpg',
	'panaceite-centro-vertical-04.jpg',
	'panaceite-centro-apaisada-05.jpg',
	'panaceite-centro-vertical-06.jpg',
	'panaceite-centro-apaisada-07.jpg',
	'panaceite-centro-apaisada-08.jpg',
	'panaceite-centro-apaisada-09.jpg',
	'panaceite-centro-apaisada-10.jpg',
];

/** Tres fotos de avance en el collage de la portada (también están en la galería). */
const collage = [
	{ name: 'panaceite-centro-apaisada-05.jpg', clase: 'collage-item collage-item-a' },
	{ name: 'panaceite-centro-vertical-02.jpg', clase: 'collage-item collage-item-b' },
	{ name: 'panaceite-centro-vertical-03.jpg', clase: 'collage-item collage-item-c' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#3a2a17" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-JA" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/panaceite-centro/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">
					P
				</span>
				<span class="brand-text">
					Panaceite Centro
					<small>Bernabé Soriano · Jaén</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#local">La taberna</a>
				<a href="#fotos">Las fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Jaén · C. Bernabé Soriano, 1</p>
						<h1 id="hero-title">
							Taberna y tapeo
							<br />
							<em>junto a la Catedral.</em>
						</h1>
						<p class="hero-lede">
							Panaceite Centro está en la C. Bernabé Soriano, 1, con código postal 23001, en el
							centro de Jaén, a un paso de la Catedral. Google lo clasifica como taberna y
							restaurante de cocina española, y le da {business.rating.toLocaleString('es-ES')}
							{' '}sobre 5 con {business.reviewCount.toLocaleString('es-ES')} reseñas. Abre
							todos los días, desde primera hora de la mañana hasta la madrugada.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>
								Llamar al {business.phone}
							</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas
								</strong>
							</li>
						</ul>
					</div>

					<div class="hero-collage">
						{collage.map((item, index) => (
							<figure class={item.clase}>
								<Image
									src={foto(item.name)}
									alt={altFoto}
									widths={index === 0 ? [640, 900, 1200] : [320, 480, 640]}
									sizes={
										index === 0
											? '(max-width: 1080px) 92vw, 46vw'
											: '(max-width: 1080px) 45vw, 23vw'
									}
									format="avif"
									quality={68}
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : undefined}
									decoding="async"
								/>
							</figure>
						))}
					</div>
				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
					{business.reviewCount.toLocaleString('es-ES')} reseñas
				</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>{hoursSummary}</span>
				<span>Teléfono {business.phone}</span>
			</div>

			<section class="section" id="local" aria-labelledby="local-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">La taberna</p>
						<h2 class="title" id="local-title">
							Cocina de Jaén
							<br />
							<em>a cualquier hora.</em>
						</h2>
						<p>
							Google lo clasifica como taberna y restaurante de cocina española, y le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas. Está en la C. Bernabé
							Soriano, 1, con código postal 23001, y la ficha publica su plus code Q686+GF
							Jaén.
						</p>
						<p>
							La ficha publica un horario que cruza la medianoche: abre a las 6:00 de lunes a
							viernes y a las 8:00 el sábado y el domingo, y cierra a las 2:00 de la
							madrugada, los siete días de la semana.
						</p>
						<p class="bar-note">
							Esta web se ha preparado solo con lo que publica la ficha, consultada el{' '}
							{site.consultado}: nombre, dirección, teléfono, categorías, horario,
							valoración, servicios de accesibilidad, las tres reseñas que destaca y sus
							propias fotografías. La ficha no publica la carta ni los precios, así que aquí
							no se reproduce ninguno.
						</p>
						<div class="bar-links">
							<a href={webOficialUrl} target="_blank" rel="noopener noreferrer">
								Web oficial del grupo ↗
							</a>
							<a href={instagramUrl} target="_blank" rel="noopener noreferrer">
								Instagram ↗
							</a>
							<a href={facebookUrl} target="_blank" rel="noopener noreferrer">
								Facebook ↗
							</a>
						</div>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>{business.reviewCount.toLocaleString('es-ES')} reseñas en Google Maps</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
								Ver todas ↗
							</a>
						</div>
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									<strong>{review.rating} sobre 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section cocina" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						La taberna <em>por dentro.</em>
					</h2>
					<p class="lead">
						Son las diez fotografías que Panaceite Centro publica en su ficha de Google Maps. La
						ficha no trae una descripción del contenido de estas fotos, así que no se inventa
						ninguna y los textos alternativos solo avisan de dónde salen.
					</p>
					<div class="cocina-grid">
						{galeria.map((name) => (
							<figure class="cocina-item">
								<Image
									src={foto(name)}
									alt={altFoto}
									widths={[380, 560, 800]}
									sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
									format="avif"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))}
					</div>
					<p class="cocina-note">
						La ficha no publica la carta ni los precios, así que esta web no los reproduce. Para
						saber qué hay hoy, lo más rápido es{' '}
						<a href={phoneHref}>llamar al {business.phone}</a> o mirar las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos y reseñas de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							C. Bernabé Soriano, 1,
							<br />
							<em>23001 Jaén.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							El cierre de las 2:00 es de la madrugada siguiente. Es el horario que publica la
							ficha consultada el {site.consultado}, con el aviso de que el lunes 12, Fiesta
							Nacional de España, podría ser diferente. La web oficial del grupo publica otro
							rango, de 7:00 a 1:00 con cocina ininterrumpida desde las 10:00, así que conviene
							confirmar por teléfono.
						</p>
						<ul class="access-list">
							{accesibilidad.map((item) => (
								<li class:list={[{ 'is-no': !item.disponible }]}>{item.label}</li>
							))}
						</ul>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
						 src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>llamar.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">
						P
					</span>
					<span>
						Panaceite Centro
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={webOficialUrl} target="_blank" rel="noopener noreferrer">
						Web oficial ↗
					</a>
					<a href={instagramUrl} target="_blank" rel="noopener noreferrer">
						Instagram ↗
					</a>
					<a href={facebookUrl} target="_blank" rel="noopener noreferrer">
						Facebook ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Panaceite Centro · C. Bernabé Soriano, 1 (23001 Jaén). Web
					informativa elaborada con los datos y las fotografías que el local publica en su ficha
					de Google Maps, consultada el {site.consultado}. Confirma horario y disponibilidad por
					teléfono antes de salir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/panaceite-centro/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/panaceite-centro/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/panaceite-centro/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a Panaceite <span>{business.phone}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/panaceite-centro/aviso-legal">Aviso legal</a>
			<a href="/panaceite-centro/aviso-legal#privacidad">Privacidad</a>
			<a href="/panaceite-centro/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>


