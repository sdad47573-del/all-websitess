---
import '../styles/global.css';
import { BUSINESS, MAPS, RATING } from '../data/site';
import foto from '../assets/fotos/platos-preparados-el-corte-ingles-01.jpg';

const title = `${BUSINESS.name} · ${BUSINESS.locality}, Madrid`;
const description = BUSINESS.description;
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/platos-preparados-el-corte-ingles/favicon.svg" type="image/svg+xml" />
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Restaurant",
	"@id": "https://www.sur-digital.com/platos-preparados-el-corte-ingles/#negocio",
	"name": "Platos preparados - El Corte Inglés",
	"url": "https://www.sur-digital.com/platos-preparados-el-corte-ingles/",
	"description": "Platos preparados - El Corte Inglés Sanchinarro, en C. de Margarita de Parma, 1 (Hortaleza, 28050 Madrid). Establecimiento de comida preparada según su ficha de Google Maps.",
	"image": "https://www.sur-digital.com/platos-preparados-el-corte-ingles/og.jpg",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 40.4975398,
		"longitude": -3.6600607
	},
	"hasMap": "https://www.google.com/maps/place/Platos+preparados-El+Corte+Ingl%C3%A9s/@40.4975398,-3.6600607,17z/data=!4m6!3m5!1s0xd422d05636a1079:0xa726951e09b095be!8m2!3d40.4975398!4d-3.6600607!16s%2Fg%2F11j_3y1lnn?authuser=0&hl=es&entry=ttu"
}
</script>
		<meta property="og:image" content="https://www.sur-digital.com/platos-preparados-el-corte-ingles/og.jpg" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta property="og:url" content="https://www.sur-digital.com/platos-preparados-el-corte-ingles/" />
		<meta property="og:locale" content="es_ES" />
			<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
	</head>
	<body>
		<header class="site-header">
			<h1 set:html={piezas.portada.titulo} />
			<p>{BUSINESS.tagline}</p>
		</header>
		<main>
			<img src={foto.src} width={foto.width} height={foto.height} alt={`Foto de ${BUSINESS.name}`} />
			<section>
				<h2>Dirección</h2>
				<p>{BUSINESS.street}, {BUSINESS.postalCode} {BUSINESS.locality}, {BUSINESS.city}</p>
				<p>Valoración en Google Maps: {RATING.label}</p>
				<p><a href={MAPS.place} target="_blank" rel="noreferrer">Ver en Google Maps</a> · <a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar</a></p>
			</section>
		</main>
		<footer class="site-footer">
			<p>© {new Date().getFullYear()} {BUSINESS.fullName}</p>
			<small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small>
		</footer>
	</body>
</html>
