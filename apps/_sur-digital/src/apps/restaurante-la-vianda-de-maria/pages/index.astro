---
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	facebookUrl,
	faqSchema,
	faqs,
	hours,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	highlights,
} from '../lib/business';

const title = 'La Vianda de María | Restaurante cordobés en Córdoba centro';
const description =
	'La Vianda de María, cocina tradicional cordobesa en Avenida Doctor Fleming, 1, Córdoba. Salmorejo, rabo de toro, croquetas caseras y asados. Reserva: 957 00 82 01.';
const keywordList =
	'La Vianda de María Córdoba, restaurante en Córdoba centro, cocina cordobesa, cocina tradicional Córdoba, restaurante Avenida Doctor Fleming, salmorejo Córdoba, rabo de toro Córdoba, croquetas caseras Córdoba, reservas restaurante Córdoba';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#27231d" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywordList} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/restaurante-la-vianda-de-maria/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="La Vianda de María, cocina cordobesa en Córdoba centro" />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<meta name="twitter:image:alt" content="La Vianda de María, cocina cordobesa en Córdoba centro" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="La Vianda de María, inicio">
				<span class="brand-mark" aria-hidden="true">V</span>
				<span class="brand-name">La Vianda de María <small>Cocina cordobesa · Córdoba</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cocina">La cocina</a>
				<a href="#carta">Especialidades</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 957 00 82 01</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Av. Doctor Fleming · Córdoba</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-intro">
						Sabores cordobeses, recetas caseras y una mesa acogedora en pleno centro. Ven a disfrutar de un buen salmorejo, croquetas de la casa, asados y cocina tradicional en La Vianda de María.
					</p>
					<div class="hero-actions">
						<a class="button button-rust" href={phoneHref}>Llamar y reservar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={mapsUrl} target="_blank" rel="noreferrer">Ver Google Maps <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Dirección</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div>
						<div><small>Reservas</small><a href={phoneHref}>{business.phone}</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración artística de un plato de cocina cordobesa">
					<span class="plate-dot" aria-hidden="true"></span>
					<div class="plate" aria-hidden="true"><div class="dish"></div></div>
					<div class="art-copy"><strong>Sabor de casa</strong><span>Cocina cordobesa</span></div>
				</div>
			</section>

			<div class="facts" aria-label="Cocina y servicios de La Vianda de María">
				<span>Cocina cordobesa y mediterránea</span>
				<span>Recetas tradicionales</span>
				<span>Terraza</span>
				<span>Reservas por teléfono</span>
			</div>

			<section class="story section-pad" id="cocina" aria-labelledby="story-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Restaurante en Córdoba centro</p>
					<h2 id="story-title">Un rincón para<br /><em>comer como en casa.</em></h2>
				</div>
				<div class="story-copy">
					<p>
						La Vianda de María está en la Avenida Doctor Fleming, 1, cerca de la Puerta de Almodóvar y de la Judería. Su cocina apuesta por recetas tradicionales y platos caseros, con una carta amplia para compartir o sentarse a la mesa sin prisas.
					</p>
					<p>
						Entre las especialidades que se citan en guías gastronómicas y reseñas están el salmorejo, la mazamorra, las croquetas de carrillada o rabo de toro, los asados, los guisos y los postres caseros. La oferta puede variar según el día.
					</p>
					<p class="story-note">
						¿Vienes en fin de semana o en grupo? Llama para preguntar por la disponibilidad y reservar mesa. El horario y la carta pueden cambiar en festivos o por temporada.
					</p>
				</div>
			</section>

			<section class="menu section-pad" id="carta" aria-labelledby="menu-title">
				<div class="section-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Cocina española y mediterránea</p>
						<h2 id="menu-title">Para abrir boca,<br /><em>compartir y disfrutar.</em></h2>
					</div>
					<p>Una muestra de platos y sabores mencionados en publicaciones y reseñas. Consulta la carta del día en el restaurante para conocer precios y disponibilidad.</p>
				</div>
				<div class="menu-grid">
					{highlights.map((item, index) => (
						<article class="menu-card">
							<small>0{index + 1} · {item.kicker}</small>
							<h3>{item.name}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
				<p class="menu-note">Los platos y precios pueden variar. Llama al <a href={phoneHref}>957 00 82 01</a> para consultar la carta y reservar.</p>
			</section>

			<section class="gallery section-pad" id="fotos" aria-labelledby="gallery-title">
				<div>
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> La Vianda de María · Córdoba</p>
					<h2 id="gallery-title">Descubre el local<br /><em>y sus fotos reales.</em></h2>
					<div class="gallery-copy">
						<p>Consulta las fotografías más recientes del restaurante y las imágenes compartidas por sus clientes en la ficha de Google Maps o en los perfiles oficiales del negocio.</p>
						<div class="gallery-links">
							<a class="button button-rust" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a>
							<a class="social-link" href={instagramUrl} target="_blank" rel="noreferrer">Instagram del restaurante ↗</a>
							<a class="social-link" href={facebookUrl} target="_blank" rel="noreferrer">Facebook del restaurante ↗</a>
						</div>
					</div>
				</div>
				<div class="map-preview">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
						title="Ubicación de Restaurante La Vianda de María en Córdoba; visita Google Maps para ver su galería de fotos"
					 src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<div class="map-caption"><span>Av. Doctor Fleming, 1 · Córdoba</span><a href={mapsUrl} target="_blank" rel="noreferrer">Abrir la ficha ↗</a></div>
				</div>
				<p class="gallery-note">Las fotos y reseñas pertenecen a la ficha y a los perfiles oficiales del restaurante. Consulta sus galerías originales y aportaciones recientes.</p>
			</section>

			<section class="visit section-pad" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Centro de Córdoba · 14004</p>
					<h2 id="visit-title">Tu mesa te espera<br /><em>en el centro.</em></h2>
					<address>{business.streetAddress}<br />{business.district}, {business.postalCode} {business.city}, España</address>
					<table class="hours">
						<caption>Horario publicado</caption>
						<tbody>
							{hours.map((item) => (
								<tr><th scope="row">{item.day}</th><td>{item.open && item.close ? `${item.open} – ${item.close}` : 'Cerrado'}</td></tr>
							))}
						</tbody>
					</table>
					<p class="hours-note">Horario publicado por fuentes locales y directorios; puede cambiar en festivos. Confirma por teléfono antes de venir.</p>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={mapsUrl} target="_blank" rel="noreferrer">Ficha de Google Maps</a>
					</div>
					<a class="visit-phone" href={phoneHref}>Reservas: {business.phone}</a>
				</div>
				<div class="map-card">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
						title="Mapa de La Vianda de María en Avenida Doctor Fleming, 1, Córdoba"
					 src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<div class="map-label"><div><strong>{business.name}</strong><small>{business.streetAddress} · Córdoba</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
			<Galeria nombre="Restaurante La Vianda de María" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="footer-brand" href="#inicio" aria-label="La Vianda de María, volver al inicio">
				<span class="brand-mark" aria-hidden="true">V</span>
				<span>La Vianda de María<small>{business.streetAddress} · {business.postalCode} {business.city}</small></span>
			</a>
			<nav class="footer-nav" aria-label="Perfiles y contacto del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} La Vianda de María · Córdoba. Carta, horarios y disponibilidad sujetos a cambios; confirma por teléfono antes de tu visita.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/restaurante-la-vianda-de-maria/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/restaurante-la-vianda-de-maria/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/restaurante-la-vianda-de-maria/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar para reservar <span>957 00 82 01</span></a>
						<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34957008201?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Restaurante%20La%20Vianda%20de%20Mar%C3%ADa." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Restaurante La Vianda de María"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>


