---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import fachada from '../assets/fotos/panaderia-guiles-cuadrada-03.jpg';
import vitrinaDulces from '../assets/fotos/panaderia-guiles-cuadrada-01.jpg';
import vitrinaBollos from '../assets/fotos/panaderia-guiles-cuadrada-02.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Panadería Guiles · C. Virgen de la Fuensanta, 26 (Málaga)';
const description =
	'Panadería Guiles en la calle Virgen de la Fuensanta, 26 (Cruz de Humilladero, 29007 Málaga). Panadería y confitería de barrio, con horario partido y domingo por la mañana. Teléfono 609 23 96 52.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#guiles`,
	name: BUSINESS.name,
	alternateName: ['Guiles', 'Panadería Guiles Málaga', 'Panadería Confitería Guiles'],
	description:
		'Panadería y confitería en la calle Virgen de la Fuensanta, 26, Cruz de Humilladero (29007 Málaga).',
	url: `${BUSINESS.siteUrl}/`,
	telephone: BUSINESS.phone,
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday'],
			opens: '08:00',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:00',
			closes: '14:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '17:00',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '08:00',
			closes: '14:00',
		},
	],
	amenityFeature: {
		'@type': 'LocationFeatureSpecification',
		name: 'Acceso para sillas de ruedas',
		value: true,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Horario', href: '#horario' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Dónde está', href: '#visitanos' },
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#f9f4e8" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Guiles, panadería Virgen de la Fuensanta, confitería Cruz de Humilladero, panadería Málaga 29007, panadería de barrio Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería y confitería en Cruz de Humilladero: horario partido de martes a sábado y domingo por la mañana."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de Panadería Guiles con su rótulo rojo de panadería confitería"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#f9f4e8"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Panadería Guiles, inicio">
					<span class="brand-mark" aria-hidden="true">G</span>
					<span class="brand-name">
						Panadería Guiles
						<small>Cruz de Humilladero · Málaga</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-phone" href={BUSINESS.phoneHref}>
					<span aria-hidden="true">☎</span> {BUSINESS.phone}
				</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> C. Virgen de la Fuensanta, 26 · 29007</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-lede">
							Un obrador de Cruz de Humilladero con vitrina de bollería y dulces. Abre de martes a
							sábado en dos franjas, el lunes de corrido y el domingo por la mañana.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={BUSINESS.phoneHref}>
								<span aria-hidden="true">☎</span> Llamar · {BUSINESS.phone}
							</a>
							<a class="button button-ghost" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<p class="hero-note">
							<span>La ficha no publica web ni redes.</span> Este sitio solo recoge lo que aparece
							en Google: nombre, dirección, teléfono, horario, valoración y fotos.
						</p>
					</div>

					<figure class="hero-media">
						<Image
							src={fachada}
							alt="La esquina del local con el rótulo rojo de Panadería Guiles Confitería sobre la puerta y el toldo de la entrada"
							widths={[440, 640, 880, 1024]}
							sizes="(max-width: 900px) 92vw, 46vw"
							format="webp"
							quality={74}
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>
						<figcaption>
							<span>La fachada, en la esquina</span>
							<span>Foto de la ficha de Google</span>
						</figcaption>
						<span class="hero-badge" aria-hidden="true">
							<strong>{RATING.label}</strong>
							<small>{RATING.count} reseñas<br />en Google</small>
						</span>
					</figure>
				</div>
			</section>

			<section class="chips-wrap wrap" aria-label="Lo que publica la ficha de Google">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<div class="about-copy">
					<p class="section-label"><span aria-hidden="true"></span> La casa</p>
					<h2 id="about-title">Una panadería <em>con vitrina.</em></h2>
					<p>
						Guiles está en la calle Virgen de la Fuensanta, número 26, en Cruz de Humilladero. Google
						la clasifica como panadería, y el rótulo rojo de la fachada añade confitería: al
						escaparate y a la vitrina de dulces se asoma el barrio desde primera hora.
					</p>
					<p>
						La ficha no publica descripción del negocio, carta ni precios, así que no hay un
						catálogo oficial que contar. Lo que sí muestran sus fotos son bandejas de bollería,
						dulces, croissants y tartaletas, y una de las reseñas habla de las empanadas y de los
						dulces.
					</p>
					<p>
						El local tiene acceso para sillas de ruedas según la ficha. No hay página web ni
						perfiles sociales: el teléfono es el único canal publicado, y es el mismo que aparece
						enlazado en esta página.
					</p>
					<div class="about-links">
						<a class="simple-link" href={BUSINESS.phoneHref}>Llamar al {BUSINESS.phone}</a>
						<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
							Ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section class="hours" id="horario" aria-labelledby="hours-title">
				<div class="wrap hours-grid">
					<div class="hours-copy">
						<p class="section-label"><span aria-hidden="true"></span> Horario</p>
						<h2 id="hours-title">De lunes <em>a domingo.</em></h2>
						<p class="hours-lede">
							La ficha no marca ningún día de cierre. El lunes aparece de corrido, de 8:00 a 20:30;
							el resto de la semana se parte en dos franjas y el domingo se queda en la mañana.
						</p>
						<ul class="hours-facts">
							<li>
								<span>Martes a sábado</span>
								8:00–14:00 y 17:00–20:30
							</li>
							<li>
								<span>Lunes</span>
								8:00–20:30, sin cerrar a mediodía
							</li>
							<li>
								<span>Domingo</span>
								8:00–14:00
							</li>
						</ul>
						<p class="hours-note">
							<strong>Festivos.</strong> {HORARIO_AVISO}
						</p>
						<a class="hours-link" href={MAPS.place} target="_blank" rel="noreferrer">
							Comprobar en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>

					<div class="hours-card">
						<p class="hours-card-title">Horario publicado</p>
						<table class="hours-table">
							<caption class="visually-hidden">
								Horario de Panadería Guiles publicado en la ficha de Google
							</caption>
							<tbody>
								{
									HORARIO.map((row) => (
										<tr>
											<th scope="row">{row.dia}</th>
											<td>{row.tramos}</td>
										</tr>
									))
								}
							</tbody>
						</table>
						<p class="hours-card-foot">
							Datos de la ficha pública de Google, consultada en octubre de 2026.
						</p>
					</div>
				</div>
			</section>

			<section class="three" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas de la ficha</p>
							<h2 id="three-title">Lo que sí <em>consta.</em></h2>
						</div>
						<p>
							La ficha es corta: sin descripción, sin web y sin carta. Estos tres datos son los que
							más pesan a la hora de acercarse, y están tal cual los publica Google.
						</p>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="fotos wrap" id="fotos" aria-labelledby="fotos-title">
				<div class="fotos-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Fotos</p>
						<h2 id="fotos-title">La fachada <em>y el mostrador.</em></h2>
					</div>
					<p>
						La galería de Google tiene cuatro fotos. Estas tres son del local y su vitrina; la
						cuarta, con una persona en primer plano en la acera, se ha dejado fuera para no publicar
						la imagen de nadie sin su permiso.
					</p>
				</div>

				<div class="fotos-grid">
					<figure class="foto foto-large">
						<Image
							src={vitrinaBollos}
							alt="La vitrina con donuts, bollos rellenos, azucarados, napolitanas y bandejas de bollería"
							widths={[480, 720, 1024]}
							sizes="(max-width: 900px) 92vw, 58vw"
							format="webp"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Donuts, bollos y napolitanas</figcaption>
					</figure>
					<figure class="foto">
						<Image
							src={vitrinaDulces}
							alt="Otra vista de la vitrina, con tartaletas, cruasanes y dulces en bandejas"
							widths={[380, 560, 760]}
							sizes="(max-width: 900px) 92vw, 32vw"
							format="webp"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Dulces y tartaletas</figcaption>
					</figure>
				</div>
			</section>

			<section class="rating" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,6 sobre 5, <em>con matices.</em></h2>
						<p>
							La media es de 4,6 con 15 reseñas (octubre de 2026). Google destaca dos: una de cinco
							estrellas y otra de una. Se resumen aquí con palabras propias; el texto completo está
							en su ficha.
						</p>
						<ul class="review-list">
							{
								RESENAS.map((item) => (
									<li>
										<span class="review-rating" aria-label={`${item.rating} de 5 estrellas`}>
											{item.rating} / 5
										</span>
										<span class="review-tema">{item.tema}</span>
										<p>{item.resumen}</p>
									</li>
								))
							}
						</ul>
						<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer las reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-figure">
						<span class="rating-value">{RATING.label}</span>
						<span class="rating-stars" aria-hidden="true">★★★★<span>★</span></span>
						<span class="rating-count">{RATING.count} reseñas publicadas</span>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Dónde está</p>
					<h2 id="visit-title">Virgen de la <em>Fuensanta, 26.</em></h2>
					<p class="address">
						{BUSINESS.street}<br />
						{BUSINESS.district}<br />
						{BUSINESS.postalCode} {BUSINESS.city}
					</p>

					<p class="visit-note">
						<strong>Sin página web ni redes sociales.</strong> El teléfono que publica la ficha es
						el {BUSINESS.phone} y no hay otro canal de contacto.
					</p>

					<ul class="visit-list">
						<li>
							<span>Teléfono</span>
							<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
						</li>
						<li>
							<span>Acceso</span>
							Para sillas de ruedas, según Google.
						</li>
						<li>
							<span>Plus Code</span>
							{BUSINESS.plusCode}
						</li>
					</ul>

					<div class="visit-links">
						<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
							Ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Panadería Guiles en la calle Virgen de la Fuensanta, 26, Málaga"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Virgen de la Fuensanta, 26
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>acercarte.</em></h2>
				<div class="faq-list">
					{
						FAQ.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">G</span>
						<p>
							Panadería Guiles
							<small>
								Panadería y confitería<br />
								{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}
							</small>
						</p>
					</div>
					<nav aria-label="Enlaces del establecimiento">
						<a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
						<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
						<a href="/panaderia-guiles/aviso-legal">Aviso legal</a>
					</nav>
				</div>
				<small class="legal">
					© {new Date().getFullYear()} {BUSINESS.name} · Datos y fotografías de la ficha pública de
					Google Maps, consultada en octubre de 2026. Las fotos de esta página salen de la galería
					de esa ficha. La web no publica carta, precios ni descripción del negocio porque la ficha
					no los incluye.
				</small>
				<nav class="legal-links" aria-label="Información legal">
					<a href="/panaderia-guiles/aviso-legal">Aviso legal</a>
					<a href="/panaderia-guiles/aviso-legal#privacidad">Privacidad</a>
					<a href="/panaderia-guiles/aviso-legal#cookies">Cookies</a>
				</nav>
				<p class="credit">
					<small
						>Creado por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a>
						</small
					>
				</p>
			</div>
		</footer>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
