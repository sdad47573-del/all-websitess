---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/arando-taberna-vertical-04.jpg';
import terraza from '../assets/fotos/arando-taberna-vertical-02.jpg';
import mesaPlatos from '../assets/fotos/arando-taberna-vertical-05.jpg';
import zamburinas from '../assets/fotos/arando-taberna-apaisada-10.jpg';
import carneSalsa from '../assets/fotos/arando-taberna-vertical-06.jpg';
import entrecot from '../assets/fotos/arando-taberna-vertical-07.jpg';
import cazuelaMarisco from '../assets/fotos/arando-taberna-vertical-08.jpg';
import ensalada from '../assets/fotos/arando-taberna-vertical-09.jpg';
import platoCasa from '../assets/fotos/arando-taberna-apaisada-03.jpg';
import torrija from '../assets/fotos/arando-taberna-vertical-01.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Arando Taberna, restaurante en Euskadi Etorbidea, 53, Trintxerpe (20110 Pasaia, Gipuzkoa). Menú del día de martes a domingo, risottos de hongos y txipis, calamares y zamburiñas, también para llevar. Tel. 943 40 10 34.';

const galeria = [
	{
		src: mesaPlatos,
		alt: 'Mesa de Arando Taberna con croquetas, patatas fritas, huevo con jamón, pimientos gratinados y una cazuela de marisco',
	},
	{
		src: zamburinas,
		alt: 'Zamburiñas a la plancha en su concha, servidas en una bandeja blanca',
	},
	{
		src: carneSalsa,
		alt: 'Carne guisada en salsa con patatas fritas y una cesta de pan al fondo',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la plancha con sal en escamas, patatas fritas y salsa',
	},
	{
		src: cazuelaMarisco,
		alt: 'Cazuela de marisco en salsa de tomate servida en una fuente de barro',
	},
	{
		src: ensalada,
		alt: 'Ensalada con rodajas de tomate, lechuga, zanahoria rallada y bacon',
	},
	{
		src: platoCasa,
		alt: 'Pieza a la plancha sobre pan tostado, con salsa roja y aceite de hierbas',
	},
	{
		src: torrija,
		alt: 'Torrija dorada con helado de nata y salsa de caramelo',
	},
	{
		src: terraza,
		alt: 'Terraza de Arando Taberna con un vaso y una lata sobre la mesa, frente a la fachada acristalada',
	},
	{
		src: fachada,
		alt: 'Fachada de Arando Taberna en Euskadi Etorbidea, con su rótulo y la terraza de mesas y sillas',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#arando`,
	name: BUSINESS.name,
	alternateName: ['Arando', 'Arando Taberna Trintxerpe', 'Arando Pasaia'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 943 40 10 34',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Tradicional', 'Vasca', 'Marisco'],
	areaServed: [
		{ '@type': 'City', name: 'Pasaia' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Sunday'],
			opens: '09:30',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Friday',
			opens: '09:30',
			closes: '00:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '10:00',
			closes: '01:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody:
				'La dueña es un sol, el café bueno, el jamón exquisito y la tortilla deliciosa.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody:
				'La camarera de pelo rojo muy muy simpática Por más camareras así',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Arando Taberna · Menú del día en Trintxerpe, Pasaia';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1d4148" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Arando Taberna, restaurante Trintxerpe, comer en Pasaia, menú del día Pasaia, risottos Trintxerpe, zamburiñas Pasaia, calamares Trintxerpe, Arando Taberna Pasaia"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Menú del día de martes a domingo, risottos de hongos y txipis, calamares y zamburiñas, también para llevar. Euskadi Etorbidea, 53 (Trintxerpe, Pasaia). Tel. 943 40 10 34."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Zamburiñas a la plancha en su concha, servidas en Arando Taberna"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1d4148"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34943401034"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Trintxerpe, Pasaia"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/arando-taberna/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Arando"
			subtitle="Taberna · Trintxerpe"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Euskadi Etorbidea, 53 · Trintxerpe, Pasaia"
				title="Menú del día<br /><em>en Trintxerpe.</em>"
				lede={`Arando Taberna es un restaurante de barrio en Euskadi Etorbidea, 53, en Trintxerpe (Pasaia, Gipuzkoa). Menú del día de martes a domingo, risottos de hongos y de txipis, calamares y zamburiñas, y también comida para llevar. Abre todos los días, desde las 9:30 (el sábado, desde las 10:00). Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={fachada}
				imageAlt="Fachada de Arando Taberna en Euskadi Etorbidea, con su rótulo y la terraza de mesas y sillas"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5</b> en Google · 229 reseñas' },
					{ label: 'Menú', html: '<b>Martes a domingo</b> al mediodía' },
					{ label: 'Horario', html: '<b>Todos los días</b> desde las 9:30' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Arando Taberna" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una taberna<br /><em>con terraza.</em>"
				paragraphs={[
					'Arando Taberna está en Euskadi Etorbidea, 53, en el barrio de Trintxerpe, dentro del término municipal de Pasaia (Gipuzkoa). Un local de barrio con terraza a pie de calle, mesas de madera y una carta que se mueve entre la cocina de todos los días y el marisco.',
					'La casa se presenta así en su ficha de Google: «Arando taberna les ofrece calidad y precio tanto en establecimiento como para llevar». Y añade: «No puedes dejar de probar nuestros maravillosos risottos tanto de hongos como de Txipis así como los calamares y zamburiñas».',
					'Sirve menú del día de martes a domingo y abre todas las jornadas de la semana, con horario más largo el viernes y el sábado. Google lo clasifica como restaurante, lo marca como brunch y le da 4,5 sobre 5 con 229 reseñas.',
					'Sus reseñas hablan sobre todo del trato y del género: «la dueña es un sol, el café bueno, el jamón exquisito y la tortilla deliciosa», «todo muy rico» y una camarera «muy muy simpática».',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «La dueña es un sol, el café bueno, el jamón exquisito y la tortilla deliciosa».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Del marisco<br /><em>al menú del día.</em>"
				description="La ficha de Google no publica precios ni una carta completa, y el local no tiene web propia. Esto es lo que anuncia la propia casa y lo que citan sus reseñas."
				cta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados ni reserva online. Llama al 943 40 10 34 para preguntar por el menú del día, encargar para llevar o saber si queda mesa."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La mesa<br /><em>y la terraza.</em>"
				description="Estas fotografías proceden del perfil de Arando Taberna en Google Maps: la fachada y la terraza, la mesa con croquetas y huevos con jamón, las zamburiñas, la carne en salsa, el entrecot, la cazuela de marisco, la ensalada y la torrija."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en Trintxerpe.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} Trintxerpe · ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: de lunes a jueves y el domingo de 9:30 a 23:00; viernes de 9:30 a 0:30; sábado de 10:00 a 1:00. Abre todos los días."
				mapTitle="Mapa de Arando Taberna en Euskadi Etorbidea, 53, Trintxerpe (Pasaia, Gipuzkoa)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Arando Taberna · Trintxerpe"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se atiende por teléfono en el 943 40 10 34. La ficha de Google marca acceso para sillas de ruedas y asientos adaptados, y no publica datos de aparcamiento adaptado."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} Trintxerpe, ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/arando-taberna/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Arando Taberna"
		/>
	</body>
</html>
