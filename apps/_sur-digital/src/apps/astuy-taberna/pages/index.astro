---
import { Image } from 'astro:assets';
import '../styles/global.css';
import { BUSINESS, FAQ, FICHA, HIGHLIGHTS, MAPS, RATING, SERVICIOS } from '../data/site';

import hero from '../assets/fotos/astuy-taberna-cuadrada-06.jpg';
import barra from '../assets/fotos/astuy-taberna-apaisada-01.jpg';
import burgerQueso from '../assets/fotos/astuy-taberna-cuadrada-03.jpg';
import burgerDoble from '../assets/fotos/astuy-taberna-vertical-10.jpg';
import patatas from '../assets/fotos/astuy-taberna-vertical-08.jpg';
import croquetas from '../assets/fotos/astuy-taberna-vertical-09.jpg';
import patatasMesa from '../assets/fotos/astuy-taberna-vista-5-05.jpg';

const title = `${BUSINESS.name} · ${BUSINESS.city}`;
const description = BUSINESS.description;
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
const year = new Date().getFullYear();

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La ficha', href: '#ficha' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Dónde está', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={`${BUSINESS.siteUrl}/`} />
		<meta name="theme-color" content="#123c36" />
		<link rel="icon" href="/astuy-taberna/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Mulish:wght@400;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Restaurant",
	"@id": "https://www.sur-digital.com/astuy-taberna/#negocio",
	"name": "Astuy Taberna",
	"url": "https://www.sur-digital.com/astuy-taberna/",
	"description": "Astuy Taberna, taberna y hamburguesería en De la Cosa Juan Kalea, 8 (48004 Bilbao, Bizkaia). Según su ficha de Google Maps, hamburguesería.",
	"image": "https://www.sur-digital.com/astuy-taberna/og.jpg",
	"telephone": "+34944051363",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 43.251577,
		"longitude": -2.913393
	},
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "De la Cosa Juan Kalea, 8",
		"addressLocality": "Bilbao",
		"addressRegion": "Bizkaia",
		"postalCode": "48004",
		"addressCountry": "ES"
	},
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": 4.2,
		"bestRating": 5,
		"worstRating": 1
	},
	"servesCuisine": "Hamburguesas",
	"hasMap": "https://www.google.com/maps/place/Astuy+Taberna/@43.251577,-2.913393,17z/data=!3m1!4b1!4m6!3m5!1s0xd4e4e4b76e4dcf9:0x49f9a5fe1bab88ab!8m2!3d43.251577!4d-2.913393!16s%2Fg%2F1thvt_z2?authuser=0&hl=es&entry=ttu"
}
</script>
		<meta property="og:image" content="https://www.sur-digital.com/astuy-taberna/og.jpg" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta property="og:url" content="https://www.sur-digital.com/astuy-taberna/" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label={`${BUSINESS.name}, inicio`}>
					<span class="brand-mark" aria-hidden="true">{BUSINESS.mark}</span>
					<span class="brand-name">
						Astuy Taberna
						<small>Hamburguesería · Bilbao</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-phone" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero wrap" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> De la Cosa Juan Kalea, 8 · Bilbao</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Astuy Taberna está en el número 8 de De la Cosa Juan Kalea, en Bilbao. La ficha de
						Google lo clasifica como hamburguesería y le da un 4,2 sobre 5. Esta página reúne
						los datos que publica esa ficha y el teléfono del local.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href={BUSINESS.phoneHref}>
							Llamar · {BUSINESS.phone}
						</a>
						<a class="button button-ghost" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<ul class="hero-facts">
						<li><b>{RATING.label}</b> sobre 5 en Google Maps</li>
						<li><b>Hamburguesería</b> categoría de la ficha</li>
						<li><b>{BUSINESS.phone}</b> teléfono del local</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={hero}
						alt="Hamburguesa con bacon, queso y salsa servida en un plato"
						widths={[480, 720, 1024]}
						sizes="(max-width: 900px) 92vw, 46vw"
						format="webp"
						quality={74}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto del perfil de Google</span>
						<a href={MAPS.place} target="_blank" rel="noreferrer">Ver la ficha ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="wrap" aria-label="Lo que publica la ficha de Google">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="about" id="casa" aria-labelledby="about-title">
				<div class="wrap">
					<div class="about-grid">
						<h2 id="about-title">Una taberna de barrio <em>con la hamburguesa delante.</em></h2>
						<div class="about-copy">
							<p>
								El nombre lo dice: Astuy Taberna. La ficha de Google lo clasifica como
								hamburguesería y lo sitúa en el número 8 de De la Cosa Juan Kalea, en Bilbao
								(48004, Bizkaia).
							</p>
							<p>
								De la ficha salen la dirección, el teléfono 944 05 13 63 y una valoración media
								de 4,2 sobre 5. No hay más datos públicos que esta web pueda afirmar: aquí no se
								publican carta, precios ni horario completo.
							</p>
							<p>
								Las fotografías de la página proceden del perfil público del establecimiento en
								Google Maps. Si eres titular de alguna y quieres que se retire, avisa en el
								teléfono del local y se quitará.
							</p>
							<p class="about-note">
								Para saber qué hay hoy, si queda mesa o cuánto cuesta, lo más directo es llamar
								al <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>.
							</p>
							<div class="about-links">
								<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
									Ficha en Google Maps <span aria-hidden="true">↗</span>
								</a>
								<a class="simple-link" href="#ficha">Ver lo que publica la ficha</a>
							</div>
						</div>
					</div>

					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li class={index === HIGHLIGHTS.length - 1 ? 'highlight-wide' : undefined}>
									<span class="highlight-mark">{String(index + 1).padStart(2, '0')}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<section class="menu" id="ficha" aria-labelledby="ficha-title">
				<div class="wrap">
					<div class="menu-head">
						<div>
							<p class="section-label"><span aria-hidden="true"></span> La ficha</p>
							<h2 id="ficha-title">Lo que Google <em>publica del local.</em></h2>
						</div>
						<div>
							<p>
								Estos son los datos que aparecen en la ficha pública: los únicos que esta web
								puede dar sin inventar nada.
							</p>
							<a class="button button-primary" href={MAPS.place} target="_blank" rel="noreferrer">
								Ver la ficha en Google <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>

					<div class="menu-groups">
						<div class="menu-group">
							<h3>Datos publicados</h3>
							<ul class="dishes">
								{
									FICHA.map((item) => (
										<li>
											<span class="dish">
												{item.label}
												<em>{item.value}</em>
											</span>
										</li>
									))
								}
							</ul>
						</div>
						<div class="menu-group">
							<h3>Contacto y mapa</h3>
							<ul class="dishes">
								<li>
									<span class="dish">
										Teléfono
										<em><a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>, el que publica la ficha</em>
									</span>
								</li>
								<li>
									<span class="dish">
										Cómo llegar
										<em><a href={MAPS.directions} target="_blank" rel="noreferrer">Ruta en Google Maps ↗</a></em>
									</span>
								</li>
								<li>
									<span class="dish">
										Ficha del local
										<em><a href={MAPS.place} target="_blank" rel="noreferrer">Astuy Taberna en Google Maps ↗</a></em>
									</span>
								</li>
							</ul>
						</div>
					</div>

					<p class="menu-note">
						Sin carta y sin precios en esta página: si necesitas saber qué hay hoy, llama al
						<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>.
					</p>
				</div>
			</section>

			<section class="rating-section" id="opiniones" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> Opiniones</p>
						<h2 id="rating-title">Cuatro y dos <em>en la ficha.</em></h2>
						<p>
							Es la valoración media que publica Google Maps para Astuy Taberna en el momento de
							consultarla (noviembre de 2026). Esta página no reproduce reseñas de terceros: para
							leerlas todas, abre la ficha del local.
						</p>
					</div>
					<div class="rating-badge">
						<strong>{RATING.label}</strong>
						<span aria-hidden="true">★★★★☆</span>
						<small>Valoración en la ficha de Google · sobre 5</small>
					</div>
				</div>
			</section>

			<section class="section-pad" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<div class="gallery-head">
						<div>
							<p class="section-label"><span aria-hidden="true"></span> Fotos del perfil</p>
							<h2 id="fotos-title">El local y lo que sale <em>de la cocina.</em></h2>
						</div>
						<p>
							Imágenes del perfil público de Astuy Taberna en Google Maps: la barra, las
							hamburguesas y los platos que aparecen en su galería.
						</p>
					</div>
					<div class="gallery-grid">
						<figure class="shot">
							<Image
								src={barra}
								alt="El interior de Astuy Taberna, con la barra, las neveras y la iluminación azul"
								widths={[480, 720]}
								sizes="(max-width: 900px) 92vw, 72rem"
								format="webp"
								quality={70}
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<figure class="shot">
							<Image
								src={burgerQueso}
								alt="Hamburguesa con queso, lechuga, tomate y cebolla"
								widths={[320, 480, 640]}
								sizes="(max-width: 900px) 46vw, 24vw"
								format="webp"
								quality={68}
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<figure class="shot">
							<Image
								src={burgerDoble}
								alt="Hamburguesa con queso y verduras servida en un plato"
								widths={[320, 480, 640]}
								sizes="(max-width: 900px) 46vw, 24vw"
								format="webp"
								quality={68}
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<figure class="shot">
							<Image
								src={patatas}
								alt="Patatas con jamón y queso servidas en una sartén"
								widths={[320, 480, 640]}
								sizes="(max-width: 900px) 46vw, 24vw"
								format="webp"
								quality={68}
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<figure class="shot">
							<Image
								src={croquetas}
								alt="Croquetas en un cucurucho de papel de cuadros"
								widths={[320, 480, 640]}
								sizes="(max-width: 900px) 46vw, 24vw"
								format="webp"
								quality={68}
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<figure class="shot">
							<Image
								src={patatasMesa}
								alt="Patatas con jamón y queso gratinadas en la mesa"
								widths={[640, 960, 1280]}
								sizes="(max-width: 900px) 92vw, 48vw"
								format="webp"
								quality={68}
								loading="lazy"
								decoding="async"
							/>
						</figure>
					</div>
					<p class="gallery-note">
						Imágenes alojadas en esta página y tomadas del perfil del establecimiento en Google
						Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos.
					</p>
				</div>
			</section>

			<section class="visit" id="visitanos" aria-labelledby="visit-title">
				<div class="wrap visit-grid">
					<div class="visit-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> Dónde está</p>
						<h2 id="visit-title">En De la Cosa Juan Kalea, <em>8.</em></h2>
						<p class="address">
							{BUSINESS.street}<br />
							{BUSINESS.postalCode} {BUSINESS.city}<br />
							{BUSINESS.region}
						</p>
						<p class="hours-note">
							El teléfono es el que publica la ficha. Esta página no tramita pedidos ni reservas.
						</p>
						<a class="phone-link" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
						<div class="visit-links">
							<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha en Google Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>

					<div class="map-frame">
						<iframe
							title={`Mapa de ${BUSINESS.name} en ${BUSINESS.street}, ${BUSINESS.city}`}
							src={MAPS.embed}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
						<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
							<span aria-hidden="true">⌖</span> {BUSINESS.street}
						</a>
					</div>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
					<h2 id="faq-title">Antes de <em>venir.</em></h2>
					<div class="faq-list">
						{
							FAQ.map((item) => (
								<details>
									<summary>{item.q}</summary>
									<p>{item.a}</p>
								</details>
							))
						}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">{BUSINESS.mark}</span>
						<p>
							{BUSINESS.name}
							<small>
								Hamburguesería · De la Cosa Juan Kalea, 8<br />
								{BUSINESS.postalCode} {BUSINESS.city}
							</small>
						</p>
					</div>
					<nav aria-label="Enlaces del establecimiento">
						<a href={BUSINESS.phoneHref}>Llamar</a>
						<a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
						<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a href="/astuy-taberna/aviso-legal">Aviso legal</a>
					</nav>
				</div>
				<small class="legal">
					© {year}
					{BUSINESS.name} · Datos de la ficha pública de Google Maps, consultada en noviembre de
					2026. Las fotografías proceden del mismo perfil.
				</small>
				<nav class="legal-links" aria-label="Información legal">
					<a href="/astuy-taberna/aviso-legal">Aviso legal</a>
					<a href="/astuy-taberna/aviso-legal#privacidad">Privacidad</a>
					<a href="/astuy-taberna/aviso-legal#cookies">Cookies</a>
				</nav>
				<p class="credit">
					Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a>
				</p>
			</div>
		</footer>

		<a class="mobile-call" href={BUSINESS.phoneHref}>Llamar <span>{BUSINESS.phone}</span></a>

		<!-- contacto-rapido -->
		<style>
			.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
			.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
			.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
			.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
			.contact-fabs .fab-wa { background: #25d366; }
			.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
			@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
			@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
		</style>
		<nav class="contact-fabs" aria-label="Contacto rápido">
			<a class="fab-wa" href="https://wa.me/34944051363?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Astuy%20Taberna." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Astuy Taberna"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
		</nav>
	</body>
</html>
