---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/la-taberna-de-gaby-apaisada-01.jpg';
import cortina from '../assets/fotos/la-taberna-de-gaby-vertical-02.jpg';
import barra from '../assets/fotos/la-taberna-de-gaby-vertical-03.jpg';
import almuerzo from '../assets/fotos/la-taberna-de-gaby-vertical-04.jpg';
import vaso from '../assets/fotos/la-taberna-de-gaby-vista-5-05.jpg';
import postre from '../assets/fotos/la-taberna-de-gaby-apaisada-06.jpg';
import brasas from '../assets/fotos/la-taberna-de-gaby-vertical-07.jpg';
import quemadillo from '../assets/fotos/la-taberna-de-gaby-vertical-08.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
} from '../data/site';

const title = "La Taberna de Gaby · Taberna en la Vall d'Alba, Castellón";
const description = BUSINESS.description;

const galeria = [
	{
		src: fachada,
		alt: 'Fachada amarilla de La Taberna de Gaby en la plaça la Concordia, con el rótulo negro de letras blancas sobre la puerta, el zócalo de ladrillo visto y la acera en primer término',
	},
	{
		src: barra,
		alt: 'Interior de La Taberna de Gaby visto desde la puerta: barra con frente de mármol, taburetes de madera, mesas y sillas de respaldo alto, suelo de gres y una clienta tras la barra',
	},
	{
		src: almuerzo,
		alt: 'Cuatro platos de almuerzo servidos a la vez en La Taberna de Gaby, con huevos fritos, patatas fritas, longaniza y carne',
	},
	{
		src: brasas,
		alt: 'Brasas de leña encendidas en la chimenea de ladrillo de La Taberna de Gaby, con la parrilla al lado y un vaso sobre la barra de hierro',
	},
	{
		src: cortina,
		alt: 'Cortina de cuentas de madera recogida en el marco de la puerta de La Taberna de Gaby, con la pared amarilla y el zócalo de ladrillo al fondo',
	},
	{
		src: postre,
		alt: 'Postre en copa de cristal cubierto de nata montada y salsa de chocolate, servido sobre la mesa de mármol de La Taberna de Gaby',
	},
	{
		src: quemadillo,
		alt: 'Vaso de cristal en la barra de La Taberna de Gaby, con la bebida encendida en llamas y una cucharilla larga, delante de la cafetera',
	},
	{
		src: vaso,
		alt: 'Primer plano de un vaso servido en su plato en La Taberna de Gaby, con la bebida en dos tonos y una piel de limón en la superficie',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-taberna-de-gaby`,
	name: BUSINESS.name,
	alternateName: ['Taberna de Gaby', "La Taberna de Gaby la Vall d'Alba"],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'De mercado'],
	areaServed: [
		{ '@type': 'City', name: "la Vall d'Alba" },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:00',
			closes: '14:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '18:00',
			closes: '00:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-taberna-de-gaby-apaisada-01.jpg": fachada,
	"la-taberna-de-gaby-vertical-03.jpg": barra,
	"la-taberna-de-gaby-vertical-04.jpg": almuerzo,
	"la-taberna-de-gaby-vertical-07.jpg": brasas,
	"la-taberna-de-gaby-vertical-02.jpg": cortina,
	"la-taberna-de-gaby-apaisada-06.jpg": postre,
	"la-taberna-de-gaby-vertical-08.jpg": quemadillo,
	"la-taberna-de-gaby-vista-5-05.jpg": vaso,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#26201b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Taberna de Gaby, taberna la Vall d'Alba, bar la Vall d'Alba, almuerzos la Vall d'Alba, desayunos la Vall d'Alba, brasa Castellón, dónde comer en la Vall d'Alba, plaça la Concordia 11"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Desayunos desde las 8:00, almuerzos y brasa de leña los viernes y sábados por la noche. Plaça la Concordia 11, la Vall d'Alba (Castellón)."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Fachada de La Taberna de Gaby en la Vall d'Alba"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#26201b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion={BUSINESS.geoRegion}
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="la Vall d'Alba, Castellón"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/la-taberna-de-gaby/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Taberna de Gaby"
			subtitle="la Vall d'Alba · Castellón"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y oferta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de La Taberna de Gaby"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34642876240?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20la%20Vall%20d." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a la Vall d"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
