---
import { Image } from 'astro:assets';

const mapsUrl =
	'https://www.google.com/maps/place/Bar+Restaurante+Avenida/@37.9184829,-1.4154084,17z/data=!3m1!4b1!4m6!3m5!1s0xd64890f9487314f:0xec4d9f8d6520f439!8m2!3d37.9184829!4d-1.4154084!16s%2Fg%2F11by_h78s2?authuser=0&hl=es&entry=ttu&g_ep=EgoyMDI2MTAxOC4wIKXMDSoASAFQAw%3D%3D';

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.{jpg,jpeg,png}', { eager: true });
const galeria = Object.entries(fotos).map(([ruta, modulo]) => ({ ruta, src: modulo.default }));
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Bar Restaurante Avenida | Región de Murcia</title>
		<meta
			name="description"
			content="Bar Restaurante Avenida, en la Región de Murcia. Galería de fotos del local y enlace a su ficha de Google Maps para consultar horarios y cómo llegar."
		/>
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href="https://www.sur-digital.com/bar-restaurante-avenida-murcia/" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Bar Restaurante Avenida" />
		<meta property="og:title" content="Bar Restaurante Avenida | Región de Murcia" />
		<meta
			property="og:description"
			content="Bar Restaurante Avenida, en la Región de Murcia. Galería de fotos del local y enlace a su ficha de Google Maps para consultar horarios y cómo llegar."
		/>
		<meta property="og:url" content="https://www.sur-digital.com/bar-restaurante-avenida-murcia/" />
		<meta property="og:image" content="https://www.sur-digital.com/bar-restaurante-avenida-murcia/og.jpg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<style is:global>
			:root {
				--ink: #1d1a16;
				--paper: #faf7f2;
				--accent: #8a5a2b;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
				color: var(--ink);
				background: var(--paper);
				line-height: 1.6;
			}
			header,
			main,
			footer {
				max-width: 1100px;
				margin: 0 auto;
				padding: 1.5rem;
			}
			h1 {
				font-size: 2.5rem;
				margin: 0.5rem 0;
			}
			.boton {
				display: inline-block;
				margin-top: 1rem;
				padding: 0.75rem 1.25rem;
				background: var(--accent);
				color: #fff;
				border-radius: 999px;
				text-decoration: none;
				font-weight: 600;
			}
			.galeria {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 0.75rem;
			}
			.galeria img {
				width: 100%;
				height: 240px;
				object-fit: cover;
				border-radius: 8px;
				display: block;
			}
			footer {
				border-top: 1px solid #e5ddd0;
				font-size: 0.875rem;
				opacity: 0.85;
			}
			footer a {
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<header>
			<h1>Bar Restaurante Avenida</h1>
			<p>Bar y restaurante en la Región de Murcia.</p>
			<a class="boton" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver en Google Maps</a>
		</header>

		<main>
			<h2>Galería</h2>
			<div class="galeria">
				{galeria.map((foto) => <Image src={foto.src} alt="Foto de Bar Restaurante Avenida" loading="lazy" />)}
			</div>
		</main>

		<footer>
			<p>
				Creado por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> · <a
					href="https://sur-digital.vercel.app/"
					rel="noopener">sur-digital.vercel.app</a
				>
			</p>
			<p>Fotos de la ficha pública de Google Maps.</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/bar-restaurante-avenida-murcia/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/bar-restaurante-avenida-murcia/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/bar-restaurante-avenida-murcia/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>
	</body>
</html>
