---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../data/site';
import 'remixicon/fonts/remixicon.css';
import '../styles/index.css';

import { BUSINESS, IMAGES, SCHEMA } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	/** Ruta de la página, para el canonical y el og:url. */
	path?: string;
	/** Palabras clave propias de la página (por defecto, las de la portada). */
	keywords?: string;
	/** Datos estructurados extra de la página: migas de pan, FAQ… */
	schema?: unknown[];
	noIndex?: boolean;
}

const {
	title = `${BUSINESS.name} · Salón de uñas en ${BUSINESS.city}`,
	description = `Salón de uñas en Plaza del Teatro, 6 (centro de Málaga): manicura, pedicura, semipermanente y acrílico, sin cita. ${BUSINESS.ratingDisplay}★ con ${BUSINESS.reviewsCount} reseñas. Tel. ${BUSINESS.phoneDisplay}.`,
	path = '/merci-nails/',
	keywords = 'Merci Nails Málaga, salón de uñas Málaga, manicura Málaga centro, pedicura Málaga, uñas acrílicas Málaga, semipermanente Málaga, nail art Málaga, salón de uñas sin cita previa Málaga, Plaza del Teatro Málaga, uñas centro histórico Málaga',
	schema = [],
	noIndex = false,
} = Astro.props;

const canonical = new URL(path, BUSINESS.siteUrl).toString();
const ogImage = new URL(IMAGES.fotoSalon.src, BUSINESS.siteUrl).toString();

// `max-image-preview:large` habilita las miniaturas grandes en Google y
// `max-snippet:-1` permite descripciones largas.
const robots = noIndex
	? 'noindex, follow'
	: 'index, follow, max-image-preview:large, max-snippet:-1';

// El JSON-LD del negocio va en todas las páginas; cada página puede añadir el suyo.
// `image` lleva un array con todas las fotos de la ficha: Google indexa mejor un local con varias
// imágenes que con una sola.
const imagenesSchema = Object.values(IMAGES).map((imagen) =>
	new URL(imagen.src, BUSINESS.siteUrl).toString(),
);

// La página como `WebPage` le dice a Google que este documento es la portada de un sitio concreto
// y no una página suelta, lo que ayuda a asociar el resto de URL del dominio con este negocio.
const webPage = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	'@id': `${canonical}#webpage`,
	url: canonical,
	name: title,
	description,
	isPartOf: {
		'@type': 'WebSite',
		'@id': `${BUSINESS.siteUrl}/#website`,
		name: BUSINESS.name,
		url: `${BUSINESS.siteUrl}/`,
	},
	about: { '@id': SCHEMA['@id'] },
	inLanguage: 'es',
	primaryImageOfPage: imagenesSchema[0],
};

const datosEstructurados = [{ ...SCHEMA, image: imagenesSchema }, webPage, ...schema];
---

<!doctype html>
<html lang="es" data-theme="merci" prefix="og: https://ogp.me/ns# place: https://ogp.me/ns/place#">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/merci-nails/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={BUSINESS.name} />
		<meta name="robots" content={robots} />
		<meta name="theme-color" content="#5B2144" />
		<link rel="canonical" href={canonical} />

		<!-- Open Graph (Facebook, WhatsApp, LinkedIn…) -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={BUSINESS.name} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content={String(IMAGES.fotoSalon.width)} />
		<meta property="og:image:height" content={String(IMAGES.fotoSalon.height)} />
		<meta
			property="og:image:alt"
			content={`Salón de uñas ${BUSINESS.name} en la Plaza del Teatro (${BUSINESS.city})`}
		/>
		<meta property="og:locale" content="es_ES" />
		<meta property="og:street-address" content={`${BUSINESS.street}, ${BUSINESS.district}`} />
		<meta property="og:locality" content={BUSINESS.city} />
		<meta property="og:region" content={BUSINESS.region} />
		<meta property="og:postal-code" content={BUSINESS.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content="+34673187934" />
		<meta property="place:location:latitude" content={String(BUSINESS.geo.lat)} />
		<meta property="place:location:longitude" content={String(BUSINESS.geo.lng)} />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta
			name="twitter:image:alt"
			content={`Salón de uñas ${BUSINESS.name} en el centro de ${BUSINESS.city}`}
		/>

		<!-- SEO local -->
		<meta name="geo.region" content="ES-AN" />
		<meta name="geo.placename" content={BUSINESS.city} />
		<meta name="geo.position" content={`${BUSINESS.geo.lat};${BUSINESS.geo.lng}`} />
		<meta name="ICBM" content={`${BUSINESS.geo.lat}, ${BUSINESS.geo.lng}`} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!--
	Las tipografías se cargan sin bloquear el primer render: media="print" evita que el navegador
	espere a la hoja de Google para pintar, y onload la activa al llegar. Sin JavaScript, la
	etiqueta <noscript> mantiene las fuentes.
-->
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:wght@500;600;700;800&display=swap"
			rel="stylesheet"
			media="print"
			onload="this.media='all'"
		/>
		<noscript
			><link
				href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:wght@500;600;700;800&display=swap"
				rel="stylesheet"
			/></noscript
		>

		{
			datosEstructurados.map((bloque) => (
				<script type="application/ld+json" is:inline set:html={JSON.stringify(bloque)} />
			))
		}
	</head>
	<body class="bg-base-100 text-base-content font-sans antialiased">
		<slot />
	<WhatsappFab phone={datos.BUSINESS.phoneHref} name={datos.BUSINESS?.name} />
	</body>
</html>
