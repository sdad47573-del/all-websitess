---
import '../styles/global.css';
import { Image } from 'astro:assets';
import g1 from '../assets/galeria/gal-01.jpg';
import g2 from '../assets/galeria/gal-02.jpg';
import g3 from '../assets/galeria/gal-03.jpg';
import g4 from '../assets/galeria/gal-04.jpg';
import g5 from '../assets/galeria/gal-05.jpg';
import g6 from '../assets/galeria/gal-06.jpg';
import {
	business,
	directionsUrl,
	emailHref,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	servicios,
	site,
} from '../data/site';
import heroA from '../assets/hero/hero-guiso.jpg';
import heroB from '../assets/hero/hero-barra.jpg';
import heroC from '../assets/hero/hero-brindis.jpg';

const title = 'Rio-Oja Restaurante · Cazuelitas en el Casco Viejo';
const description =
	'Rio-Oja Restaurante, cocina vasca en Calle del Perro 4, Bilbao. Cazuelitas, bacalao y chipirones. Teléfono 944 15 08 71.';
const keywords =
	'Rio-Oja, Rio Oja Bilbao, restaurante Casco Viejo Bilbao, cazuelitas Bilbao, Calle del Perro';

const galeria = [
	{ img: g1, alt: 'Plato de la carta (fotografía de archivo)', caption: 'De la carta' },
	{ img: g2, alt: 'Fritos variados (fotografía de archivo)', caption: 'Fritos' },
	{ img: g3, alt: 'Cocinando con producto fresco (fotografía de archivo)', caption: 'La cocina' },
	{ img: g4, alt: 'Comedor de restaurante (fotografía de archivo)', caption: 'El comedor' },
	{ img: g5, alt: 'Plato de arroz (fotografía de archivo)', caption: 'De cuchara' },
	{ img: g6, alt: 'Postre de chocolate (fotografía de archivo)', caption: 'El postre' },
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#5d2b1f" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-BI" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/rio-oja/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración propia de Rio-Oja Restaurante en Bilbao; no es una foto del local" />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content="Ilustración propia de Rio-Oja Restaurante en Bilbao; no es una foto del local" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">RO</span>
				<span class="brand-text">
					Rio-Oja
					<small>Casco Viejo · Bilbao</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#local">La casa</a>
				<a href="#fotos">Fotos</a>
				<a href="#visita">Visita</a>
				<a href="#carta">Carta</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Casco Viejo · Calle del Perro, 4</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-lede">
							Bar restaurante de cocina vasca en la Calle del Perro, 4 (48005 Bilbao),
							con 67 años y tres generaciones de familia. Cazuelas de barro,
							chipirones en su tinta y bacalao al pilpil, con precio orientativo de
							20 a 30 €. {hoursSummary}.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>Llamar al {business.phone}</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 ·{' '}
									{business.reviewCount.toLocaleString('es-ES')} opiniones en Tripadvisor
								</strong>
							</li>
						</ul>
					</div>

										<div class="hero-collage">
					<figure class="collage-item collage-item-a">
						<Image
						src={heroA}
						alt="Guiso tradicional en olla (fotografía de archivo)"
						widths={[640, 900, 1200]}
						sizes="(max-width: 1080px) 92vw, 46vw"
						format="webp"
						quality={68}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					</figure>
					<figure class="collage-item collage-item-b">
						<Image
						src={heroB}
						alt="Barra de taberna con taburetes (fotografía de archivo)"
						widths={[320, 480, 640]}
						sizes="(max-width: 1080px) 45vw, 23vw"
						format="webp"
						quality={68}
						loading="lazy"
						decoding="async"
					/>
					</figure>
					<figure class="collage-item collage-item-c">
						<Image
						src={heroC}
						alt="Brindis con cervezas (fotografía de archivo)"
						widths={[320, 480, 640]}
						sizes="(max-width: 1080px) 45vw, 23vw"
						format="webp"
						quality={68}
						loading="lazy"
						decoding="async"
					/>
					</figure>
					</div>
					<p class="hero-photo-note">Fotos de portada: banco de imágenes (Unsplash).</p>
				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 en Tripadvisor
				</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>Teléfono {business.phone}</span>
			</div>

						<section class="section carta" id="carta" aria-labelledby="carta-title">
				<div class="wrap">
					<p class="kicker">La carta</p>
					<h2 class="title" id="carta-title">
						Lo típico <em>de la casa.</em>
					</h2>
					<ul class="carta-list">
						<li>Cazuelitas de barro</li>
						<li>Chipirones en su tinta y bacalao al pilpil</li>
						<li>Casquería y carrilleras</li>
						<li>Precio orientativo: de 20 a 30 euros</li>
					</ul>
					<p class="carta-note">La carta del día puede cambiar: confirma por teléfono antes de ir.</p>
				</div>
			</section>

<section class="section" id="local" aria-labelledby="local-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">La casa</p>
						<h2 class="title" id="local-title">
							De Bilbao,
							<br />
							<em>de toda la vida.</em>
						</h2>
						<p>
							Rio-Oja es un bar restaurante del Casco Viejo con barra larga para el
							txikito y comedor para sentarse. Negocio familiar de padres, abuelos y
							primos, con premio Surbisa al local reformado y diez años en la guía
							Michelin. Sus imprescindibles: las cazuelitas, los chipirones y el bacalao.
						</p>
						<p>
							Esta web se ha preparado con datos públicos consultados el{' '}
							{site.consultado}: ficha de Google Maps, web oficial del local y guías
							gastronómicas. La carta del día puede cambiar, así que conviene confirmar
							por teléfono antes de ir.
						</p>
						<p class="bar-note">
							Nota sobre las fotos: las imágenes de la ficha de Google Maps tienen
							derechos de sus autores y no se pueden copiar aquí. Las ilustraciones
							de esta web son de archivo (Unsplash): haz tus propias fotos para sustituirlas (ver README). por fotos propias del local.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>{business.reviewCount.toLocaleString('es-ES')} opiniones en Tripadvisor</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver ficha ↗</a>
						</div>
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									<strong>{review.rating} sobre 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section cocina" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Fotos</p>
					<h2 class="title" id="fotos-title">
						La casa <em>en imágenes.</em>
					</h2>
					<p class="lead">
						Fotos de ambiente de archivo (Unsplash). Cuando tengas fotos propias del local
						y sus platos, sustitúyelas en <code>src/assets/galeria/</code> (ver README).
					</p>
					<div class="cocina-grid">
						{galeria.map((foto) => (
							<figure class="cocina-item">
								<Image
								src={foto.img}
								alt={foto.alt}
								widths={[380, 560, 800]}
								sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
								format="webp"
								quality={68}
								loading="lazy"
								decoding="async"
							/>
								<figcaption>{foto.caption}</figcaption>
							</figure>
						))}
					</div>
					<p class="cocina-note">
						Para saber qué hay hoy, lo más rápido es{' '}
						<a href={phoneHref}>llamar al {business.phone}</a> o mirar su{' '}
						<a href={business.web} target="_blank" rel="noopener noreferrer">
							web oficial ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="visita" aria-labelledby="visita-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="visita-title">
							Calle del Perro, 4,
							<br />
							<em>48005 Bilbao.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city} ({business.zone})
							<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario publicado en su web oficial</caption>
							<tbody>
								{hours.map((item) => (
									<tr class:list={[{ 'is-closed': item.service === 'Cerrado' }]}>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							El <strong>lunes cierra</strong>; de martes a domingo abre de{' '}
							<strong>9:00 a 23:00</strong>. En festivos conviene confirmar por
							teléfono antes de ir.
						</p>
						<ul class="access-list">
							{servicios.map((item) => (
								<li>{item.label}</li>
							))}
						</ul>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<br />
						<a class="contact-line contact-mail" href={emailHref}>
							<small>Correo</small>
							<strong class="mail">{business.email}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="transport-list" aria-label="Cómo llegar">
							<li>En el Casco Viejo: metro y tranvía cercanos.</li>
							<li>A pie, por las Siete Calles de Bilbao.</li>
						</ul>
					</div>
					<div class="map-card">
						<div class="map-facade" data-map-src={mapEmbedUrl}>
							<svg viewBox="0 0 120 90" width="120" height="90" role="img" aria-label="Vista previa del mapa">
							<rect width="120" height="90" rx="10" fill="#e9dfc9" />
							<g stroke="#d3c5a3" stroke-width="5">
								<path d="M0 30 H120 M0 62 H120 M35 0 V90 M78 0 V90" />
							</g>
							<g stroke="#ffffff" stroke-width="2">
								<path d="M0 30 H120 M0 62 H120 M35 0 V90 M78 0 V90" />
							</g>
							<path d="M60 60 c-9 0 -15 -7 -15 -15 c0 -9 7 -16 15 -16 s15 7 15 16 c0 8 -6 15 -15 15 z" fill="#a83e4a" />
							<circle cx="60" cy="44" r="6" fill="#faf7f0" />
						</svg>
							<p>El mapa interactivo se carga solo si lo pides.</p>
							<button class="btn btn-solid map-load" type="button">Cargar mapa interactivo</button>
						</div>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>llamar.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">RO</span>
					<span>
						Rio-Oja Restaurante
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={emailHref}>{business.email}</a>
					<a href={business.web} target="_blank" rel="noopener noreferrer">
						Web oficial ↗
					</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Rio-Oja Restaurante · {business.streetAddress} ({business.postalCode} {business.city}).
					Web informativa no oficial elaborada con datos públicos consultados el {site.consultado}. Las fotos son ilustraciones propias.
					Confirma horario y disponibilidad por teléfono antes de salir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/rio-oja/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/rio-oja/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/rio-oja/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a Rio-Oja <span>{business.phone}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/rio-oja/aviso-legal">Aviso legal</a>
			<a href="/rio-oja/aviso-legal#privacidad">Privacidad</a>
			<a href="/rio-oja/aviso-legal#cookies">Cookies</a>
			<button class="share-link" id="compartir" type="button">Compartir</button>
		</nav>
	
	<script is:inline>
		const shareBtn = document.getElementById("compartir");
		shareBtn?.addEventListener("click", async () => {
			const url = location.href;
			if (navigator.share) {
				try { await navigator.share({ title: document.title, url }); } catch (e) {}
			} else {
				try {
					await navigator.clipboard.writeText(url);
					shareBtn.textContent = "Enlace copiado";
					setTimeout(() => { shareBtn.textContent = "Compartir"; }, 2000);
				} catch (e) {}
			}
		});
	</script>
	<script is:inline>
		const load = document.querySelector('.map-load');
		if (load) {
			load.addEventListener('click', () => {
				const box = load.parentElement;
				const src = box.getAttribute('data-map-src');
				const frame = document.createElement('iframe');
				frame.src = src;
				frame.title = 'Mapa interactivo de Google Maps';
				frame.loading = 'lazy';
				frame.referrerPolicy = 'no-referrer-when-downgrade';
				frame.allowFullscreen = true;
				box.replaceChildren(frame);
			});
		}
	</script>
<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
