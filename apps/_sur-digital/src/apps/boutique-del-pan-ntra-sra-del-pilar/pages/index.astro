---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import fachada from '../assets/fotos/boutique-del-pan-ntra-sra-del-pilar-apaisada-01.jpg';
import esquina from '../assets/fotos/boutique-del-pan-ntra-sra-del-pilar-apaisada-02.jpg';
import escaparate from '../assets/fotos/boutique-del-pan-ntra-sra-del-pilar-apaisada-03.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HOURS, MAPS, SERVICIOS, STREET_VIEW } from '../data/site';

const title = 'Ntra. Sra. del Pilar · Boutique del Pan · Málaga';
const description =
	'Pastelería Ntra. Sra. del Pilar - Boutique del Pan, en la Carretera de Cádiz, 29004 Málaga. Pan y pastelería con 5,0 sobre 5 en Google. Horario, mapa y vistas de la calle.';
const ratingLabel = BUSINESS.rating.toFixed(1).replace('.', ',');

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#boutique-del-pan`,
	name: BUSINESS.name,
	alternateName: [
		'Ntra. Sra. del Pilar Pastelería',
		'Boutique del Pan Málaga',
		'Pastelería Boutique del Pan',
	],
	description:
		'Panadería y pastelería en la Carretera de Cádiz, 29004 Málaga. La ficha de Google le da 5,0 sobre 5 con 2 reseñas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:00',
			closes: '14:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '17:00',
			closes: '20:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '08:00',
			closes: '14:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '10:30',
			closes: '14:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El local', href: '#local' },
	{ label: 'Horario', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2a1914" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Ntra. Sra. Del Pilar Pasteleria, Boutique del Pan Málaga, pastelería Carretera de Cádiz, panadería 29004, panadería Málaga, pastelería Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pastelería y boutique del pan en la Carretera de Cádiz, 29004 Málaga. 5,0 sobre 5 en Google. Horario, mapa y vistas de la calle."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tarjeta de Ntra. Sra. del Pilar, Pastelería y Boutique del Pan, en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2a1914"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/boutique-del-pan-ntra-sra-del-pilar/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Ntra. Sra. del Pilar, inicio">
					<span class="brand-mark" aria-hidden="true">P</span>
					<span class="brand-name">
						Ntra. Sra. del Pilar
						<small>Pastelería · Boutique del Pan</small>
					</span>
				</a>
				<nav class="nav" aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-cta" href={MAPS.directions} target="_blank" rel="noreferrer">
					Cómo llegar <span aria-hidden="true">↗</span>
				</a>
			</div>
			<nav class="mobile-nav wrap" aria-label="Navegación principal en móvil">
				{nav.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Carretera de Cádiz · 29004 Málaga</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-lede">
							Una panadería y pastelería de barrio en la Carretera de Cádiz. La ficha de
							Google le da 5,0 sobre 5 con 2 reseñas y publica un horario partido, con
							mañana y tarde de lunes a viernes.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha y reseñas <span aria-hidden="true">↗</span>
							</a>
						</div>
						<p class="hero-note">
							<span>Sin teléfono ni web publicados.</span> La ficha de Google tampoco
							incluye fotos del perfil ni carta de precios.
						</p>
					</div>

					<aside class="hero-ticket" aria-label="Datos publicados en la ficha de Google">
						<p class="ticket-top">Málaga · Carretera de Cádiz</p>
						<p class="ticket-rating">
							<span class="ticket-number">{ratingLabel}</span>
							<span class="ticket-meta">
								<span class="stars" role="img" aria-label="5 de 5 estrellas">★★★★★</span>
								<span>{BUSINESS.reviewsCount} reseñas en Google</span>
							</span>
						</p>
						<div class="ticket-rule" aria-hidden="true"><span>✦</span></div>
						<dl class="ticket-data">
							<div>
								<dt>Dirección</dt>
								<dd>{BUSINESS.street}<br />{BUSINESS.postalCode} {BUSINESS.city}</dd>
							</div>
							<div>
								<dt>Horario</dt>
								<dd>
									L–V · 8:00–14:30 / 17:00–20:00<br />
									Sábado · 8:00–14:30<br />
									Domingo · 10:30–14:00
								</dd>
							</div>
							<div>
								<dt>Acceso</dt>
								<dd>Para sillas de ruedas</dd>
							</div>
						</dl>
						<a class="ticket-link" href={MAPS.place} target="_blank" rel="noreferrer">
							Abrir en Google Maps <span aria-hidden="true">↗</span>
						</a>
						<span class="ticket-stamp" aria-hidden="true">Boutique<br />del Pan</span>
					</aside>
				</div>
				<div class="hero-wheat" aria-hidden="true">
					<svg viewBox="0 0 120 220" role="presentation">
						<path d="M60 214V86" />
						<path d="M60 84c-18-10-24-28-20-46 16 6 24 22 20 46Z" />
						<path d="M60 84c18-10 24-28 20-46-16 6-24 22-20 46Z" />
						<path d="M60 126c-18-10-24-28-20-46 16 6 24 22 20 46Z" />
						<path d="M60 126c18-10 24-28 20-46-16 6-24 22-20 46Z" />
						<path d="M60 168c-18-10-24-28-20-46 16 6 24 22 20 46Z" />
						<path d="M60 168c18-10 24-28 20-46-16 6-24 22-20 46Z" />
					</svg>
				</div>
			</section>

			<section class="fact-strip" aria-label="Datos de la ficha">
				<div class="wrap fact-grid">
					<div class="fact">
						<span class="fact-kicker">Google</span>
						<strong>{ratingLabel} <span class="small">/ 5</span></strong>
						<span class="fact-note">2 reseñas</span>
					</div>
					<div class="fact">
						<span class="fact-kicker">Lunes a viernes</span>
						<strong>8:00–14:30</strong>
						<span class="fact-note">y 17:00–20:00</span>
					</div>
					<div class="fact">
						<span class="fact-kicker">Sábado y domingo</span>
						<strong>8:00–14:30</strong>
						<span class="fact-note">domingo 10:30–14:00</span>
					</div>
					<div class="fact">
						<span class="fact-kicker">La casa</span>
						<strong>Pan y pastelería</strong>
						<span class="fact-note">sin carta publicada</span>
					</div>
				</div>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<p class="section-label"><span aria-hidden="true"></span> La casa</p>
				<div class="about-grid">
					<h2 id="about-title">Pan y pastelería <em>en la Carretera de Cádiz.</em></h2>
					<div class="about-copy">
						<p>
							La ficha pública de Google sitúa este negocio en la Carretera de Cádiz,
							29004 Málaga, sin número de portal. Lo clasifica como panadería y le da
							5,0 sobre 5 con 2 reseñas.
						</p>
						<p>
							El nombre reúne dos enseñas: «Ntra. Sra. Del Pilar Pasteleria» y «Boutique
							Del Pan». La ficha no publica descripción, teléfono, página web, carta ni
							precios, así que esta página no rellena esos huecos.
						</p>
						<p>
							Las tres imágenes son vistas de Google Street View de agosto de 2024. En la
							esquina se lee «FUENTEMAR · Boutique del Pan», un rótulo que puede ser
							anterior al nombre que hoy muestra Google. Se muestran identificadas y sin
							hacerlas pasar por fotos del interior.
						</p>
						<p>
							Para llegar, el mapa de «Visítanos» abre las coordenadas exactas y el botón
							de indicaciones lanza la ruta en Google Maps. El horario puede cambiar en
							festivos: conviene confirmarlo antes de desplazarse.
						</p>
						<div class="about-links">
							<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha en Google Maps <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="chips-wrap wrap" aria-label="Lo que anuncia la casa">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="highlights" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Tres cosas claras</p>
					<div class="highlights-head">
						<h2 id="highlights-title">Lo que sí <em>se sabe.</em></h2>
						<p>
							Sin carta ni fotos del perfil, la información se reduce a lo que publica
							Google y a lo que se ve en la calle. Esto es lo que se puede afirmar.
						</p>
					</div>
					<div class="highlights-grid">
						{
							HIGHLIGHTS.map((item) => (
								<article class="highlight">
									<span class="highlight-number">{item.number}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="local wrap" id="local" aria-labelledby="local-title">
				<div class="local-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> El local</p>
						<h2 id="local-title">La esquina, <em>en tres vistas.</em></h2>
					</div>
					<p>
						La ficha no tiene fotos del perfil. Estas tres vistas de Google Street View
						enseñan la fachada, el cruce y el escaparate. Están tomadas en agosto de 2024
						y se muestran como imágenes del entorno, no del interior.
					</p>
				</div>

				<div class="local-grid">
					<figure class="local-main">
						<Image
							src={fachada}
							alt="Fachada de la pastelería en la esquina de la Carretera de Cádiz, con el rótulo Fuentemar Boutique del Pan, en Google Street View"
							widths={[480, 720, 1024]}
							sizes="(max-width: 900px) 92vw, 58vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>
							<span>La fachada desde la Carretera de Cádiz</span>
							<span>Google Street View · {STREET_VIEW.date}</span>
						</figcaption>
					</figure>
					<div class="local-side">
						<figure>
							<Image
								src={esquina}
								alt="La esquina del local con el paso de peatones y los edificios de la Carretera de Cádiz, en Google Street View"
								widths={[420, 640, 1024]}
								sizes="(max-width: 900px) 92vw, 36vw"
								format="avif"
								quality={72}
								loading="lazy"
								decoding="async"
							/>
							<figcaption>El cruce y la acera de la esquina</figcaption>
						</figure>
						<figure>
							<Image
								src={escaparate}
								alt="Vista lateral de la fachada, con el rótulo de la boutique a la derecha y un portal contiguo, en Google Street View"
								widths={[420, 640, 1024]}
								sizes="(max-width: 900px) 92vw, 36vw"
								format="avif"
								quality={72}
								loading="lazy"
								decoding="async"
							/>
							<figcaption>El rótulo desde el otro lado</figcaption>
						</figure>
					</div>
				</div>

				<div class="local-note">
					<p>
						<strong>El rótulo dice «FUENTEMAR · Boutique del Pan».</strong> La ficha actual
						se llama Ntra. Sra. Del Pilar Pasteleria - Boutique Del Pan. El rótulo puede
						ser anterior al nombre que figura en Google; con los datos públicos no se
						puede confirmar el cambio. No se ha tomado ninguna imagen de otro perfil de Google: la vista es la que la ficha asocia a este negocio.
					</p>
					<a class="simple-link" href={MAPS.streetView} target="_blank" rel="noreferrer">
						Abrir Street View <span aria-hidden="true">↗</span>
					</a>
				</div>
			</section>

			<section class="rating" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-figure" aria-hidden="true">
						<span class="rating-number">{ratingLabel}</span>
						<span class="rating-max">/ 5</span>
					</div>
					<div class="rating-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que dice Google</p>
						<h2 id="rating-title">Dos reseñas, <em>cinco estrellas.</em></h2>
						<p>
							La ficha tiene 2 reseñas y una media de 5,0 sobre 5. Aquí solo se reproduce
							la valoración publicada: las opiniones completas se leen en Google Maps.
						</p>
						<div class="rating-actions">
							<span class="stars stars-large" role="img" aria-label="5 de 5 estrellas">★★★★★</span>
							<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
								Leer las reseñas en Google <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Visítanos</p>
					<h2 id="visit-title">En la Carretera <em>de Cádiz.</em></h2>
					<p class="address">
						{BUSINESS.street}<br />
						{BUSINESS.postalCode} {BUSINESS.city}<br />
						<span>La ficha no publica número de portal.</span>
					</p>

					<table class="hours">
						<caption>Horario publicado en Google</caption>
						<tbody>
							{
								HOURS.map((row) => (
									<tr>
										<th scope="row">{row.day}</th>
										<td>{row.value}</td>
									</tr>
								))
							}
						</tbody>
					</table>
					<p class="hours-note">
						Consultado el 28 de octubre de 2026. El 1 de noviembre, Día de Todos los
						Santos, la ficha advierte de que el horario podría ser diferente. Confirma
						antes de ir.
					</p>

					<div class="visit-links">
						<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
							Ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
					<p class="visit-note">
						Sin teléfono ni página web publicados. La atención es en el propio
						establecimiento. La ficha solo indica acceso para sillas de ruedas.
					</p>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Ntra. Sra. Del Pilar Pasteleria - Boutique Del Pan en la Carretera de Cádiz, Málaga"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Carretera de Cádiz · 29004
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>pasar.</em></h2>
				<div class="faq-list">
					{
						FAQ.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">P</span>
						<p>
							Ntra. Sra. del Pilar
							<small>Pastelería · Boutique del Pan<br />{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}</small>
						</p>
					</div>
					<nav aria-label="Enlaces de la pastelería">
						<a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
						<a href={MAPS.reviews} target="_blank" rel="noreferrer">Reseñas ↗</a>
						<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a href="/boutique-del-pan-ntra-sra-del-pilar/aviso-legal">Aviso legal</a>
					</nav>
				</div>
				<small class="legal">
					© {new Date().getFullYear()} {BUSINESS.name} · Datos y valoración de la ficha
					pública de Google Maps, consultada en octubre de 2026. Imágenes de Google Street
					View (agosto de 2024), identificadas como tales. Sin teléfono, carta ni precios
					publicados por el establecimiento.
				</small>
				<nav class="legal-links" aria-label="Información legal">
					<a href="/boutique-del-pan-ntra-sra-del-pilar/aviso-legal">Aviso legal</a>
					<a href="/boutique-del-pan-ntra-sra-del-pilar/aviso-legal#privacidad">Privacidad</a>
					<a href="/boutique-del-pan-ntra-sra-del-pilar/aviso-legal#cookies">Cookies</a>
				</nav>
				<p class="credit">
