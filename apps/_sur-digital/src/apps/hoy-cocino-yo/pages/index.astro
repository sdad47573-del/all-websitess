---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachadaNoche from '../assets/fotos/hoy-cocino-yo-apaisada-01.jpg';
import tarrinas from '../assets/fotos/hoy-cocino-yo-vertical-02.jpg';
import vitrina from '../assets/fotos/hoy-cocino-yo-apaisada-03.jpg';
import fachadaDia from '../assets/fotos/hoy-cocino-yo-apaisada-04.jpg';
import pollo from '../assets/fotos/hoy-cocino-yo-vertical-05.jpg';
import interiorCliente from '../assets/fotos/hoy-cocino-yo-apaisada-06.jpg';
import ensaladaGarbanzos from '../assets/fotos/hoy-cocino-yo-cuadrada-07.jpg';
import ensaladilla from '../assets/fotos/hoy-cocino-yo-cuadrada-08.jpg';
import interiorCocina from '../assets/fotos/hoy-cocino-yo-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Hoy cocino yo! · Comida casera para llevar en Málaga-Este';
const description =
	'Hoy cocino yo!, comida casera para llevar y a domicilio en C. Fernando Camino, 11 (Málaga-Este, 29016 Málaga). Conos de pescado frito, pollo asado, bocadillos, ensaladas y platos del día.';

const galeria = [
	{
		src: fachadaNoche,
		alt: 'La fachada de Hoy cocino yo! de noche, con el rótulo en neón y la vitrina iluminada junto a la calle',
	},
	{
		src: vitrina,
		alt: 'La vitrina del local con empanadas, empanadillas, bocadillos, tartas y tarrinas de ensalada',
	},
	{
		src: tarrinas,
		alt: 'Tarrinas de ensalada con tomate, queso fresco, garbanzos y pepino, y ensaladilla con huevo',
	},
	{
		src: pollo,
		alt: 'Cuartos de pollo asado dorados en una bandeja de aluminio',
	},
	{
		src: ensaladaGarbanzos,
		alt: 'Ensalada de garbanzos con tomate, pepino, queso fresco y cebolla morada en un bol de cartón',
	},
	{
		src: ensaladilla,
		alt: 'Ensaladilla rusa con patata, atún, aceitunas, huevo cocido y pimiento en un bol de cartón',
	},
	{
		src: fachadaDia,
		alt: 'La fachada de Hoy cocino yo! de día, con el rótulo negro y una clienta entrando en el local',
	},
	{
		src: interiorCliente,
		alt: 'Una clienta en la vitrina del local, con los cocineros al fondo y las lámparas amarillas',
	},
	{
		src: interiorCocina,
		alt: 'El interior de Hoy cocino yo! con la vitrina, los cocineros, la máquina de refrescos y el techo de hexágonos',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Hoy cocino yo!',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#hoy-cocino-yo`,
	name: BUSINESS.name,
	alternateName: ['Hoy cocino yo Málaga', 'Hoy Cocino Yo takeaway', 'Comida casera Fernando Camino'],
	description:
		'Comida casera para llevar y a domicilio en la calle Fernando Camino, 11 (Málaga-Este, 29016 Málaga). Conos de pescado frito, bocadillos, pollo asado, ensaladas y platos del día.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34673183255',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Pescado frito', 'Comida para llevar'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '10:00',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '10:00',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: false,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"hoy-cocino-yo-apaisada-01.jpg": fachadaNoche,
	"hoy-cocino-yo-apaisada-03.jpg": vitrina,
	"hoy-cocino-yo-vertical-02.jpg": tarrinas,
	"hoy-cocino-yo-vertical-05.jpg": pollo,
	"hoy-cocino-yo-cuadrada-07.jpg": ensaladaGarbanzos,
	"hoy-cocino-yo-cuadrada-08.jpg": ensaladilla,
	"hoy-cocino-yo-apaisada-04.jpg": fachadaDia,
	"hoy-cocino-yo-apaisada-06.jpg": interiorCliente,
	"hoy-cocino-yo-vertical-10.jpg": interiorCocina,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f3d34" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Hoy cocino yo Málaga, comida para llevar Málaga-Este, comida casera Málaga, conos de pescado frito, bocadillos Málaga, pollo asado Málaga, ensaladas para llevar, comida a domicilio Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar y a domicilio en Fernando Camino, 11. Conos de pescado frito, bocadillos, pollo asado, ensaladas y platos del día."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada iluminada de Hoy cocino yo! en Málaga-Este"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#1f3d34"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachadaNoche]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Hoy cocino yo!"
			subtitle="Comida casera para llevar · Málaga-Este"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario, descripción y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma horario y disponibilidad antes de encargar."
			ctaLabel="Llamar a Hoy cocino yo!"
			navAriaLabel="Enlaces de Hoy cocino yo!"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34673183255?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carta%20de%20Hoy%20cocino%20yo!." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carta de Hoy cocino yo!"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
