---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import { business, directionsUrl, mapEmbedUrl, mapsUrl, phoneHref, restaurantSchema } from '../lib/business';
import { content } from '../lib/content';
import { Image } from 'astro:assets';
import Galeria from './Galeria.astro';
import heroPhoto from '../assets/fotos/benavra-apaisada-01.jpg';
import galleryTall from '../assets/fotos/benavra-vertical-04.jpg';
import galleryTop from '../assets/fotos/benavra-apaisada-03.jpg';
import galleryBottom from '../assets/fotos/benavra-vista-2-02.jpg';
import cuisinePhoto from '../assets/fotos/benavra-vertical-06.jpg';

interface Props {
	locale: 'es' | 'en';
}

const { locale } = Astro.props;
const page = content[locale];
const canonical = `${business.site}${page.path}`;
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: page.faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang={page.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#183d35" />
		<meta name="description" content={page.description} />
		<meta name="keywords" content={page.keywords} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="La Cala de Mijas, Torrenueva" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="es" href={`${business.site}/`} />
		<link rel="alternate" hreflang="en" href={`${business.site}/en/`} />
		<link rel="alternate" hreflang="x-default" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/benavra/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://maps.googleapis.com" />
		<link rel="preconnect" href="https://maps.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
			rel="stylesheet"
		/>
		<title>{page.title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content={page.locale} />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={page.title} />
		<meta property="og:description" content={page.description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={`${business.site}/social-card.svg`} />
		<meta property="og:image:alt" content="Benavra, family restaurant in Torrenueva, La Cala de Mijas" />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="Spain" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={page.title} />
		<meta name="twitter:description" content={page.description} />
		<meta name="twitter:image" content={`${business.site}/social-card.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#main">{page.skip}</a>
		<header class="topbar">
			<a class="brand" href={page.path} aria-label="Benavra · home">
				<span class="brand-mark" aria-hidden="true">B.</span>
				<span class="brand-name">Benavra<small>TORRENUEVA · COSTA DEL SOL</small></span>
			</a>
			<nav aria-label={page.navLabel}>
				{page.nav.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
			<div class="header-actions">
				<a class="language" href={page.languageHref} lang={locale === 'es' ? 'en' : 'es'}>{page.languageLabel}</a>
				<a class="header-book" href={phoneHref}><span aria-hidden="true">↗</span> {page.primaryCta}</a>
			</div>
		</header>

		<main id="main">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span class="eyebrow-dot"></span>{page.eyebrow}</p>
					<h1 id="hero-title">{page.titleLines[0]}<br /><em>{page.titleLines[1]}</em><br />{page.titleLines[2]}</h1>
					<p class="hero-lede">{page.intro}</p>
					<div class="hero-actions">
						<a class="button button-primary" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">{page.secondaryCta}<span aria-hidden="true">↗</span></a>
					</div>
					<p class="hero-footnote"><span aria-hidden="true">✳</span>{page.heroNote}</p>
				</div>
				<div class="hero-art">
					<Image
						src={heroPhoto}
						alt={page.photoAlt}
						widths={[420, 640, 960]}
						sizes="(max-width: 900px) 92vw, 480px"
						format="webp"
						quality={70}
						loading="eager"
						fetchpriority="high"
						class="hero-photo-img"
					/>
					<span class="art-scrim" aria-hidden="true"></span>
					<div class="art-label"><span>BENAVRA</span><span>36°29'45.4&quot;N<br />4°41'27.9&quot;W</span></div>
					<a class="art-open" href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label={page.photosCta}><span aria-hidden="true">↗</span></a>
					<p class="art-caption">{page.photoCaption}<a href={mapsUrl} target="_blank" rel="noopener noreferrer">{page.photosCta} ↗</a></p>
				</div>
				<div class="hero-side-note" aria-hidden="true">BUILT WITH CARE · MIJAS COSTA</div>
			</section>

			<section class="intro section-wrap" id={locale === 'es' ? 'experiencia' : 'experience'}>
				<div class="intro-index"><span>01</span><i></i>{page.experienceLabel}</div>
				<div class="intro-body"><h2>{page.experienceTitle}</h2><div class="intro-copy"><p>{page.experienceText}</p><p>{page.experienceDetail}</p></div></div>
				<div class="values">
					{page.values.map((item) => <article class="value"><span>{item.number}</span><h3>{item.title}</h3><p>{item.detail}</p></article>)}
				</div>
			</section>

			<section class="food-section" id={locale === 'es' ? 'cocina' : 'food'}>
				<div class="food-grid section-wrap">
					<div class="food-art">
						<Image
							src={cuisinePhoto}
							alt={page.cuisinePhotoAlt}
							widths={[360, 480, 720]}
							sizes="(max-width: 900px) 74vw, 385px"
							format="webp"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<span class="food-art-scrim" aria-hidden="true"></span>
						<p class="food-art-note" aria-hidden="true">FRESH<br />LOCAL<br />HOMEMADE</p>
					</div>
					<div class="food-copy"><p class="eyebrow eyebrow-dark"><span class="eyebrow-dot"></span>{page.cuisineEyebrow}</p><h2>{page.cuisineTitle}</h2><p>{page.cuisineText}</p><ul class="cuisine-tags">{page.cuisineTags.map((tag) => <li>{tag}</li>)}</ul><a class="text-link" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a></div>
				</div>
			</section>

			<section class="gallery-section section-wrap">
				<div class="gallery-copy"><p class="eyebrow"><span class="eyebrow-dot"></span>{page.photosEyebrow}</p><h2>{page.photosTitle}</h2><p>{page.photosText}</p><a class="button button-primary" href={mapsUrl} target="_blank" rel="noopener noreferrer">{page.photosCta}<span aria-hidden="true">↗</span></a></div>
				<div class="gallery-card">
					<div class="gallery-mosaic">
						<Image src={galleryTall} alt={page.photoAlt} widths={[320, 480, 720]} sizes="(max-width: 900px) 60vw, 26vw" format="webp" quality={65} loading="lazy" decoding="async" />
						<Image src={galleryTop} alt={page.photoAlt} widths={[320, 480, 720]} sizes="(max-width: 900px) 40vw, 20vw" format="webp" quality={65} loading="lazy" decoding="async" />
						<Image src={galleryBottom} alt={page.photoAlt} widths={[320, 480, 720]} sizes="(max-width: 900px) 40vw, 20vw" format="webp" quality={65} loading="lazy" decoding="async" />
					</div>
					<span class="gallery-scrim" aria-hidden="true"></span>
					<div class="gallery-card-footer"><span>{page.photoCaption}</span><a href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label={page.photosCta}>↗</a></div></div>
			</section>
			<p class="photo-credit section-wrap">{page.photoDisclaimer}</p>

			<section class="visit-section" id={locale === 'es' ? 'visitanos' : 'visit'}>
				<div class="visit-grid section-wrap">
					<div class="visit-copy"><p class="eyebrow"><span class="eyebrow-dot"></span>{page.visitEyebrow}</p><h2>{page.visitTitle}</h2>
						<div class="visit-details"><div><span class="detail-icon" aria-hidden="true">⌖</span><p><small>{page.addressLabel}</small>{business.streetAddress}<br />{business.postalCode} {business.city}<br />{business.region}</p></div><div><span class="detail-icon" aria-hidden="true">↗</span><p><small>{page.phoneLabel}</small><a href={phoneHref}>{business.phone}</a></p></div><div><span class="detail-icon" aria-hidden="true">◷</span><p><small>{page.hoursLabel}</small>{page.hoursText}</p></div></div>
						<a class="social-link" href={phoneHref}>{page.primaryCta}<span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-panel"><div class="map-topline"><span><i></i> MIJAS COSTA · ANDALUCÍA</span><a href={mapsUrl} target="_blank" rel="noopener noreferrer">{page.mapOpen} ↗</a></div><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title={page.mapTitle} src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">{locale === 'en' ? 'Directions in Google Maps ↗' : 'Cómo llegar en Google Maps ↗'}</a></p>
						</noscript>
					</div><a class="map-bottom" href={directionsUrl} target="_blank" rel="noopener noreferrer"><span class="map-pin" aria-hidden="true">⌖</span><span><strong>Benavra</strong><small>{business.streetAddress} · {business.city}</small></span><b>{page.mapDirections} ↗</b></a></div>
				</div>
			</section>

			<section class="faq-section section-wrap">
				<div class="faq-heading"><p class="eyebrow eyebrow-dark"><span class="eyebrow-dot"></span>{page.faqEyebrow}</p><h2>{page.faqTitle}</h2></div>
				<div class="faq-list">{page.faqs.map((faq) => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div>
			</section>
			<Galeria nombre="Benavra" mapsUrl={mapsUrl} locale={locale} />
		</main>

		<footer class="footer"><a class="brand" href={page.path} aria-label="Benavra · home"><span class="brand-mark" aria-hidden="true">B.</span><span class="brand-name">Benavra<small>TORRENUEVA · COSTA DEL SOL</small></span></a><p>{page.footerNote}<br />{business.streetAddress}, {business.city}</p><div class="footer-links"><a href={business.instagram} target="_blank" rel="noopener noreferrer">{page.instagramLabel} ↗</a><a href={business.facebook} target="_blank" rel="noopener noreferrer">{page.facebookLabel} ↗</a><a href={page.languageHref}>{page.languageLabel}</a><a href="/benavra/aviso-legal">Aviso legal</a> <a href="/benavra/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a> · <a href="/benavra/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a> </div><small class="footer-legal">© {new Date().getFullYear()} Benavra · {business.city}</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>
		<a class="mobile-cta" href={phoneHref}><span aria-hidden="true">↗</span>{page.primaryCta}<strong>{business.phone}</strong></a>
	<WhatsappFab phone={datos.phoneHref} name={datos.business?.name} />
	</body>
</html>


