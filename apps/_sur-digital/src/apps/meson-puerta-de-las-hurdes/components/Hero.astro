---
import { Image } from 'astro:assets';
import { BUSINESS, IMAGES } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
---

<section id="inicio" class="hero-puerta relative overflow-hidden">
	<div class="relative mx-auto max-w-4xl px-4 pt-14 text-center sm:px-6 sm:pt-20 lg:px-8">
		<p
			class="text-primary/70 inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase"
		>
			<span><i class="ri-map-pin-line"></i> Pozuelo de Zarzón</span>
			<span class="text-base-content/35">Valle del Alagón · Cáceres</span>
		</p>

		<h1
			class="font-display mt-4 text-5xl leading-[0.95] font-medium text-balance text-primary sm:text-6xl lg:text-7xl"
		>
			Puerta de las <span class="text-secondary">Hurdes</span>
		</h1>

		<p class="text-base-content/70 mx-auto mt-6 max-w-xl text-base leading-relaxed sm:text-lg">
			Un mesón familiar de pueblo con cocina casera, terraza, zona de juegos y noches de karaoke, en
			el Valle del Alagón y a la puerta de Las Hurdes.
		</p>

		<div class="mt-7 flex flex-wrap items-center justify-center gap-3">
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="badge badge-lg border-primary/15 bg-primary/5 text-primary gap-2 px-4 py-3 text-sm font-semibold"
			>
				<span class="text-secondary tracking-tight" aria-hidden="true">
					{estrellas.map((n) => (
						<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
					))}
				</span>
				{BUSINESS.rating.toString().replace('.', ',')} · {BUSINESS.reviewCount} reseñas en Google
			</a>
		</div>

		<div class="mt-8 flex flex-wrap justify-center gap-3">
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-secondary btn-lg gap-2 rounded-full"
			>
				<i class="ri-route-line text-xl"></i>
				Cómo llegar
			</a>
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-outline btn-lg gap-2 rounded-full"
			>
				<i class="ri-google-fill"></i>
				Ver ficha de Google
			</a>
		</div>
	</div>

	<div class="relative mx-auto max-w-6xl px-4 pt-12 pb-24 sm:px-6 sm:pt-16 lg:px-8">
		<div class="grid grid-cols-3 items-start gap-2 sm:gap-4">
			<figure class="mt-6 overflow-hidden rounded-2xl shadow-xl">
				<Image
					src={IMAGES.fotoVertical3}
					alt="Interior del Mesón Puerta de las Hurdes"
					widths={[220, 420, 620]}
					sizes="(min-width: 640px) 30vw, 31vw"
					quality={85}
					loading="eager"
					class="foto-calida aspect-[3/4] w-full object-cover"
				/>
			</figure>
			<figure class="overflow-hidden rounded-2xl shadow-2xl">
				<Image
					src={IMAGES.fotoVertical6}
					alt="Mesón Puerta de las Hurdes, en Pozuelo de Zarzón"
					widths={[240, 460, 680]}
					sizes="(min-width: 640px) 32vw, 33vw"
					quality={85}
					loading="eager"
					fetchpriority="high"
					class="foto-calida aspect-[3/4] w-full object-cover"
				/>
			</figure>
			<figure class="mt-10 overflow-hidden rounded-2xl shadow-xl">
				<Image
					src={IMAGES.fotoVertical5}
					alt="Un plato del Mesón Puerta de las Hurdes"
					widths={[220, 420, 620]}
					sizes="(min-width: 640px) 30vw, 31vw"
					quality={85}
					loading="lazy"
					class="foto-calida aspect-[3/4] w-full object-cover"
				/>
			</figure>
		</div>

		<dl
			class="border-base-300 bg-base-100 relative z-10 mx-auto -mt-14 grid max-w-3xl divide-y divide-base-200 rounded-2xl border shadow-2xl sm:-mt-16 sm:grid-cols-3 sm:divide-x sm:divide-y-0"
		>
			<div class="px-5 py-5 text-center">
				<dt class="text-base-content/50 text-[0.65rem] tracking-[0.18em] uppercase">Dónde</dt>
				<dd class="mt-1 text-sm font-bold">Pozuelo de Zarzón</dd>
				<dd class="text-base-content/55 text-xs">Junto a la carretera, a la salida del pueblo</dd>
			</div>
			<div class="px-5 py-5 text-center">
				<dt class="text-base-content/50 text-[0.65rem] tracking-[0.18em] uppercase">La cocina</dt>
				<dd class="mt-1 text-sm font-bold">Casera y de bar</dd>
				<dd class="text-base-content/55 text-xs">Cachopo, magro y platos combinados</dd>
			</div>
			<div class="px-5 py-5 text-center">
				<dt class="text-base-content/50 text-[0.65rem] tracking-[0.18em] uppercase">Servicios</dt>
				<dd class="mt-1 text-sm font-bold">Terraza y juegos</dd>
				<dd class="text-base-content/55 text-xs">Karaoke y comida para llevar</dd>
			</div>
		</dl>
	</div>

	<div class="cenefa-puerta relative h-3 w-full"></div>
</section>
