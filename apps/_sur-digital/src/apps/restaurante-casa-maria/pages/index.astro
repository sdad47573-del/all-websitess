---
import { Image } from 'astro:assets';
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/restaurante-casa-maria-vertical-09.jpg';
import tarta from '../assets/fotos/restaurante-casa-maria-vertical-02.jpg';
import codillo from '../assets/fotos/restaurante-casa-maria-vertical-03.jpg';
import decoracion from '../assets/fotos/restaurante-casa-maria-apaisada-04.jpg';
import ensalada from '../assets/fotos/restaurante-casa-maria-vertical-05.jpg';
import cochinillo from '../assets/fotos/restaurante-casa-maria-apaisada-06.jpg';
import pisto from '../assets/fotos/restaurante-casa-maria-vertical-07.jpg';
import berenjena from '../assets/fotos/restaurante-casa-maria-cuadrada-08.jpg';
import tomate from '../assets/fotos/restaurante-casa-maria-cuadrada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description = BUSINESS.description;

const galeria = [
	{
		src: cochinillo,
		alt: 'Dos medios cochinillos asados en bandeja, con guarnición, en Restaurante Casa Maria',
	},
	{
		src: tarta,
		alt: 'Tarta de queso al horno con salsa de frutos rojos en Restaurante Casa Maria',
	},
	{
		src: codillo,
		alt: 'Codillo asado con su jugo, patatas fritas y pimiento rojo en Restaurante Casa Maria',
	},
	{
		src: berenjena,
		alt: 'Rodajas de berenjena frita con miel y semillas de girasol',
	},
	{
		src: pisto,
		alt: 'Pisto de verduras con huevo frito y jamón curado en Restaurante Casa Maria',
	},
	{
		src: ensalada,
		alt: 'Ensalada con atún, huevo, tomate y aceitunas en Restaurante Casa Maria',
	},
	{
		src: decoracion,
		alt: 'Pared del comedor con una bicicleta antigua, herramientas y el espejo de Casa Maria',
	},
	{
		src: tomate,
		alt: 'Ensalada de tomate con ventresca y vinagre balsámico en Restaurante Casa Maria',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	acceptsReservations: true,
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['Casa Maria', 'Casa María l\'Alcora', 'Restaurante Casa María'],
	slogan: 'Comida casera de lunes a viernes',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 964 36 78 35',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Mediterránea', 'Casera'],
	areaServed: [
		{ '@type': 'City', name: "l'Alcora" },
		{ '@type': 'AdministrativeArea', name: 'Castellón' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:00',
			closes: '17:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((body) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
		reviewBody: body,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Grupos', href: '#grupos' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const title = "Restaurante Casa Maria · Comida casera en l'Alcora (Castellón)";
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#24497a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Lora:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Casa Maria, Casa María l'Alcora, comida casera l'Alcora, menú del día l'Alcora, restaurante polígono l'Alcora, canelón de codillo, fideuá l'Alcora, cochinillo asado Castellón"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Restaurante Casa Maria · Comida casera en l'Alcora"
			ogDescription="Menú del día de lunes a viernes, cocina casera, asados para grupos y postres al horno. 4,1 en Google con 378 reseñas. Tel. 964 36 78 35."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Cochinillo asado en bandeja de Restaurante Casa Maria, l'Alcora"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#24497a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone="+34964367835"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'España',
				phone: '+34 964 36 78 35',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[comedor]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Comida casera · l'Alcora"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Camí Foyes Ferraes · Polígon de l'Alcora · Castellón"
				title={piezas.portada.titulo}
				lede="Casa Maria es el comedor de cada día en el polígono de l'Alcora: desayunos y almuerzos desde las 8:00, menú completo a mediodía y cocina casera española y mediterránea. Abre de lunes a viernes; los fines de semana, cierra."
				image={comedor}
				imageAlt="Comedor de Restaurante Casa Maria con mesas de cuadros, estufa de leña y la barra al fondo"
				primaryCta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Cocina casera · Menú del día"
				facts={[
					{ label: 'Nota', html: '<b>4,1 en Google</b> con 378 reseñas' },
					{ label: 'Mediodía', html: '<b>Menú completo</b> de lunes a viernes' },
					{ label: 'Horario', html: '<b>08:00 – 17:00</b> de lunes a viernes' },
					{ label: 'Fin de semana', html: '<b>Cerrado</b> sábados y domingos' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Restaurante Casa Maria" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="El comedor del polígono,<br /><em>con mantel de cuadros.</em>"
				paragraphs={[
					"Restaurante Casa Maria está en el Camí Foyes Ferraes, entre las naves del polígono de l'Alcora, la capital cerámica de Castellón. El comedor es amplio, con manteles de cuadros, estufa de leña en el centro, sillas de madera, paredes con herramientas antiguas, una bicicleta colgada y un espejo con el nombre de la casa.",
					'La cocina es casera, española y mediterránea, con menú del día de lunes a viernes. Pasan por la mesa el canelón de codillo, la fideuá, el codillo asado, el secreto, las ensaladas con tomate de la huerta y el pisto con huevo y jamón. Y los postres, con la tarta de queso al horno como la más citada.',
					'En las fotos del comedor aparecen asados de celebración, como el cochinillo, que se sirven para las comidas de grupo. El local está en una zona de naves, con calles amplias donde aparcar, y tiene acceso, aseo y asientos adaptados para sillas de ruedas. La ficha de Google suma 378 reseñas con un 4,1.',
				]}
				note="«Canelón de codillo, fideuá y tarta de queso casera al horno», resume una reseña de Google. Otra destaca a las «camareras muy atentas y trabajadoras». También hay opiniones que piden más ración en algunos platos: conviene preguntar por el tamaño antes de pedir para compartir."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Menú del día,<br />asados<br /><em>y postres al horno.</em>"
				description="La ficha de Google no publica una carta con precios: estos platos salen de las fotos del perfil, de lo que citan las reseñas y de las fichas gastronómicas locales."
				cta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="El precio del menú cambia con el día y no está publicado en Google; las fichas locales lo sitúan alrededor de 14,50 €, pero confírmalo al llamar. Lo mismo con el cochinillo y los asados de grupo: se acuerdan por teléfono según el número de comensales."
			/>

			<section class="groups section-pad" id="grupos" aria-labelledby="groups-title">
				<div class="wrap groups-grid">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Comidas de grupo</p>
						<h2 id="groups-title">Un asado<br /><em>para celebrar.</em></h2>
						<p>
							El comedor de Casa Maria es también el sitio donde las empresas del polígono cierran
							un trato y las familias celebran un bautizo. Hay mesas grandes, espacio entre mesas
							y un menú de grupo que se acuerda por teléfono.
						</p>
						<p>
							En las fotos del perfil aparece el cochinillo asado, servido en bandeja para
							compartir, junto a la fideuá, el canelón de codillo y la tarta de queso. Para una
							celebración, llama con antelación y acordad platos, número de comensales y precio.
						</p>
						<div class="about-links">
							<a class="simple-link" href={BUSINESS.phoneHref}
								>Reservar: {BUSINESS.phoneDisplay}</a
							>
							<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer"
								>Ver fotos en Google <span aria-hidden="true">↗</span></a
							>
						</div>
					</div>
					<figure class="groups-photo">
						<Image
							src={cochinillo}
							alt="Dos medios cochinillos asados en bandeja, con guarnición, en Restaurante Casa Maria"
							widths={[480, 720, 960]}
							sizes="(max-width: 980px) 92vw, 44vw"
							format="webp"
							quality={68}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Cochinillo asado, en una foto del perfil de Casa Maria en Google Maps.</figcaption>
					</figure>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Los asados,<br />los guisos<br /><em>y el comedor.</em>"
				description="Estas fotografías proceden del perfil de Restaurante Casa Maria en Google Maps: el cochinillo, la tarta de queso, el codillo, la berenjena con miel, el pisto con huevo, la ensalada de atún, la pared de herramientas y la ensalada de tomate."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Camí Foyes Ferraes, s/n · 12110 l'Alcora · Castellón"
				title="En el polígono de l'Alcora,<br /><em>solo entre semana.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Castellón · Comunitat Valenciana']}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="De lunes a viernes de 08:00 a 17:00 y cerrado sábados y domingos. La cocina puede cerrar antes de las 17:00; si vienes a última hora del mediodía, llama antes al 964 36 78 35."
				mapTitle="Mapa de Restaurante Casa Maria en el Camí Foyes Ferraes, l'Alcora"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Restaurante Casa Maria · l'Alcora"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva por teléfono, en el 964 36 78 35. El local marca acceso, aseo y asientos adaptados para sillas de ruedas. Para grupos y celebraciones, llama con antelación y acordad el menú."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>comer.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, platos y precios antes de la visita."
			ctaLabel="Llamar a Restaurante Casa Maria"
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34964367835?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20l." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a l"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
