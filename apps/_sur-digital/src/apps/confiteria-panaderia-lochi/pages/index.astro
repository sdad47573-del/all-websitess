---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import esquina from '../assets/fotos/confiteria-panaderia-lochi-street-01.jpg';
import acera from '../assets/fotos/confiteria-panaderia-lochi-street-02.jpg';
import cruce from '../assets/fotos/confiteria-panaderia-lochi-street-03.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HOURS, HOURS_NOTE, MAPS, SERVICIOS, STREET_VIEW } from '../data/site';

const title = 'Confitería Panadería Lochi · Bailén-Miraflores, Málaga';
const description =
	'Confitería Panadería Lochi en C. Eugenio Gross, 11, Loc 1 (Bailén-Miraflores, 29010 Málaga). Panadería de barrio con 5,0 sobre 5 en Google. Horario partido, mapa y vistas de la calle.';
const ratingLabel = BUSINESS.rating.toFixed(1).replace('.', ',');

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#lochi`,
	name: BUSINESS.name,
	alternateName: ['Lochi', 'Panadería Lochi', 'Confitería Lochi'],
	description:
		'Panadería y confitería en la calle Eugenio Gross, 29010 Málaga. La ficha de Google le da 5,0 sobre 5 con 3 reseñas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:00',
			closes: '14:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '17:00',
			closes: '20:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El local', href: '#local' },
	{ label: 'Horario', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1e3f4d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Confitería Panadería Lochi, panadería Bailén-Miraflores, confitería Málaga, panadería Eugenio Gross, panadería 29010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería y confitería en la calle Eugenio Gross, 29010 Málaga. 5,0 sobre 5 en Google. Horario partido y mapa."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La esquina de la calle Eugenio Gross donde está Confitería Panadería Lochi, en Google Street View"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1e3f4d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[esquina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Confitería Panadería Lochi, inicio">
					<span class="brand-mark" aria-hidden="true">L</span>
					<span class="brand-name">
						Lochi
						<small>Panadería · Confitería</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-cta" href={MAPS.directions} target="_blank" rel="noreferrer">
					Cómo llegar <span aria-hidden="true">↗</span>
				</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Bailén-Miraflores · 29010 Málaga</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-lede">
							Una panadería de barrio en la calle Eugenio Gross, 11. La ficha de Google le da
							5,0 sobre 5 con 3 reseñas y publica un horario partido, con mañana y tarde de
							lunes a sábado.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha y reseñas <span aria-hidden="true">↗</span>
							</a>
						</div>
						<p class="hero-note">
							<span>Sin teléfono ni web publicados.</span> La ficha de Google no incluye
							descripción, redes sociales ni fotos del perfil: las imágenes de esta página son
							vistas de la calle en Street View.
						</p>
					</div>

					<aside class="hero-ticket" aria-label="Datos publicados en la ficha de Google">
						<p class="ticket-top">Málaga · Bailén-Miraflores</p>
						<p class="ticket-rating">
							<span class="ticket-number">{ratingLabel}</span>
							<span class="ticket-meta">
								<span class="stars" role="img" aria-label="5 de 5 estrellas">★★★★★</span>
								<span>{BUSINESS.reviewsCount} reseñas en Google</span>
							</span>
						</p>
						<div class="ticket-rule" aria-hidden="true"><span>✦</span></div>
						<dl class="ticket-data">
							<div>
								<dt>Dirección</dt>
								<dd>{BUSINESS.street}<br />{BUSINESS.postalCode} {BUSINESS.city}</dd>
							</div>
							<div>
								<dt>Horario</dt>
								<dd>Lunes a sábado · 8:00–14:30 / 17:00–20:30<br />Domingo · cerrado</dd>
							</div>
							<div>
								<dt>Contacto</dt>
								<dd>Sin teléfono ni web en la ficha</dd>
							</div>
						</dl>
						<a class="ticket-link" href={MAPS.place} target="_blank" rel="noreferrer">
							Abrir en Google Maps <span aria-hidden="true">↗</span>
						</a>
						<span class="ticket-stamp" aria-hidden="true">Pan<br />& Dulces</span>
					</aside>
				</div>
			</section>

			<section class="chips-wrap wrap" aria-label="Lo que publica la ficha de Google">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<p class="section-label"><span aria-hidden="true"></span> La casa</p>
				<div class="about-grid">
					<h2 id="about-title">Panadería y confitería <em>de barrio.</em></h2>
					<div class="about-copy">
						<p>
							Lochi está en la calle Eugenio Gross, número 11, local 1, en el barrio de
							Bailén-Miraflores. Google la clasifica como panadería y le da 5,0 sobre 5 con 3
							reseñas.
						</p>
						<p>
							El nombre de la casa reúne panadería y confitería, y el horario que publica la
							ficha es de doble turno: mañana de 8:00 a 14:30 y tarde de 17:00 a 20:30, de lunes
							a sábado. El domingo figura cerrado.
						</p>
						<p>
							La ficha no publica descripción, teléfono, página web, redes sociales, surtido ni
							precios. Esta página no rellena esos huecos: se limita a la dirección, el horario,
							la valoración y las vistas de la calle.
						</p>
						<p>
							Para llegar, el mapa de «Visítanos» abre las coordenadas exactas y el botón de
							indicaciones lanza la ruta en Google Maps. El 1 de noviembre (Día de Todos los
							Santos) el horario podría variar.
						</p>
						<div class="about-links">
							<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha en Google Maps <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="three" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas de la casa</p>
							<h2 id="three-title">Lo que sí <em>se sabe.</em></h2>
						</div>
						<p>
							La ficha es corta: sin descripción, teléfono ni fotos. Esto es lo que publica
							Google y lo único que la página puede afirmar.
						</p>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="local wrap" id="local" aria-labelledby="local-title">
				<div class="local-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> El local</p>
						<h2 id="local-title">La esquina, <em>en tres vistas.</em></h2>
					</div>
					<p>
						La ficha no tiene fotos del perfil. Estas tres vistas de Google Street View, tomadas
						en {STREET_VIEW.date}, enseñan la esquina y la planta baja donde está el local. Se
						muestran como imágenes del entorno, no del interior.
					</p>
				</div>

				<div class="local-grid">
					<figure class="local-main">
						<Image
							src={esquina}
							alt="La esquina de la calle Eugenio Gross con el local en la planta baja del edificio, en Google Street View"
							widths={[480, 720, 1024]}
							sizes="(max-width: 900px) 92vw, 58vw"
							format="avif"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>
							<span>La esquina desde la avenida</span>
							<span>Google Street View · {STREET_VIEW.date}</span>
						</figcaption>
					</figure>
					<div class="local-side">
						<figure>
							<Image
								src={acera}
								alt="La acera y la fachada del edificio donde está la panadería, vistos desde la calle en Google Street View"
								widths={[420, 640, 1024]}
								sizes="(max-width: 900px) 92vw, 36vw"
								format="avif"
								quality={72}
								loading="lazy"
								decoding="async"
							/>
							<figcaption>La acera y la fachada</figcaption>
						</figure>
						<figure>
							<Image
								src={cruce}
								alt="El cruce y los árboles de la calle junto al edificio del local, en Google Street View"
								widths={[420, 640, 1024]}
								sizes="(max-width: 900px) 92vw, 36vw"
								format="avif"
								quality={72}
								loading="lazy"
								decoding="async"
							/>
							<figcaption>El cruce y los árboles</figcaption>
						</figure>
					</div>
				</div>

				<div class="local-note">
					<p>
						<strong>Son vistas de la calle, no del negocio.</strong> Google no publica fotos del
						perfil de esta ficha; el panorama de Street View es el que la propia ficha asocia al
						local. No se usa ninguna imagen de otro perfil de Google, y no se afirma qué dice el
						rótulo de la fachada porque en estas vistas no se lee.
					</p>
					<a class="simple-link" href={MAPS.streetView} target="_blank" rel="noreferrer">
						Abrir Street View <span aria-hidden="true">↗</span>
					</a>
				</div>
			</section>

			<section class="rating" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-figure" aria-hidden="true">
						<span class="rating-number">{ratingLabel}</span>
						<span class="rating-max">/ 5</span>
					</div>
					<div class="rating-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que dice Google</p>
						<h2 id="rating-title">Tres reseñas, <em>cinco estrellas.</em></h2>
						<p>
							La ficha tiene una media de 5,0 sobre 5 con 3 reseñas. Aquí solo se reproduce la
							valoración publicada: las opiniones completas se leen en Google Maps.
						</p>
						<div class="rating-actions">
							<span class="stars stars-large" role="img" aria-label="5 de 5 estrellas">★★★★★</span>
							<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
								Leer las reseñas en Google <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Visítanos</p>
					<h2 id="visit-title">En Eugenio <em>Gross.</em></h2>
					<p class="address">
						{BUSINESS.street}<br />
						{BUSINESS.district}<br />
						{BUSINESS.postalCode} {BUSINESS.city}
					</p>

					<table class="hours">
						<caption>Horario publicado en Google</caption>
						<tbody>
							{HOURS.map((row) => (
								<tr class={row.value === 'Cerrado' ? 'closed' : undefined}>
									<th scope="row">{row.day}</th>
									<td>{row.value}</td>
								</tr>
							))}
						</tbody>
					</table>
					<p class="hours-note">{HOURS_NOTE}</p>

					<div class="visit-links">
						<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
							Ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
					<p class="visit-note">
						Sin teléfono ni página web publicados. La atención es en el propio establecimiento, en
						horario de mañana o de tarde.
					</p>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Confitería Panadería Lochi en la calle Eugenio Gross, Málaga"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Eugenio Gross, 11 · 29010
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>pasar.</em></h2>
				<div class="faq-list">
					{
						FAQ.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">L</span>
						<p>
							Confitería Panadería Lochi
							<small>
								Panadería · Confitería<br />
								{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}
							</small>
						</p>
					</div>
					<nav aria-label="Enlaces de la panadería">
						<a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
						<a href={MAPS.reviews} target="_blank" rel="noreferrer">Reseñas ↗</a>
						<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a href="/confiteria-panaderia-lochi/aviso-legal">Aviso legal</a>
					</nav>
				</div>
				<small class="legal">
					© {new Date().getFullYear()} {BUSINESS.name} · Datos y valoración de la ficha pública
					de Google Maps, consultada en octubre de 2026. Las imágenes son vistas de Google Street
					View ({STREET_VIEW.date}), identificadas como tales. La web no publica teléfono, carta ni
					precios porque la ficha no los incluye.
				</small>
				<nav class="legal-links" aria-label="Información legal">
					<a href="/confiteria-panaderia-lochi/aviso-legal">Aviso legal</a>
					<a href="/confiteria-panaderia-lochi/aviso-legal#privacidad">Privacidad</a>
					<a href="/confiteria-panaderia-lochi/aviso-legal#cookies">Cookies</a>
				</nav>
				<p class="credit">
					<small
						>Creado por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a>
						· sur-digital.vercel.app</small
					>
				</p>
			</div>
		</footer>
	</body>
</html>
