---
import WhatsappFab from '../components/WhatsappFab.astro';
import '../styles/global.css';

const business = {
	name: 'Taberna de la Mata',
	street: 'Calle Orfila, 8',
	city: 'Málaga',
	postalCode: '29002',
	phone: '+34 666 31 06 91',
	latitude: 36.7070208,
	longitude: -4.4313743,
	site: 'https://www.sur-digital.com/taberna-de-la-mata',
};

const mapsUrl =
	'https://www.google.com/maps/place/Taberna+de+la+Mata/@36.7131892,-4.4740987,14z/data=!4m10!1m2!2m1!1sRestaurantes!3m6!1s0xd72f7b3a3551fbf:0xf965fa6016b4a7f4!8m2!3d36.7070208!4d-4.4313743!15sCgxSZXN0YXVyYW50ZXNaDiIMcmVzdGF1cmFudGVzkgEKcmVzdGF1cmFudJoBRENpOURRVWxSUVVOdlpFTm9kSGxqUmpsdlQycE5kRll3U205V00yUlFVMVUxVFZsV1ZsTmxhMHBoV1ZoS2JHTkZSUkFC4AEA-gEECAAQLw!16s%2Fg%2F11mt50bvcw?entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34666310691';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurant`,
	name: business.name,
	description:
		'Taberna de tapas y cocina casera en Málaga, cerca del Parque de Huelin. En Calle Orfila, 8.',
	url: `${business.site}/`,
	telephone: business.phone,
	servesCuisine: ['Cocina española', 'Tapas'],
	areaServed: { '@type': 'City', name: 'Málaga' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		postalCode: business.postalCode,
		addressRegion: 'Andalucía',
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#17392f" />
		<meta
			name="description"
			content="Descubre Taberna de la Mata, taberna de tapas y cocina casera en Málaga. Estamos en Calle Orfila, 8, junto al Parque de Huelin. Consulta fotos y cómo llegar."
		/>
		<meta
			name="keywords"
			content="Taberna de la Mata, taberna Málaga, tapas en Málaga, cocina casera Málaga, dónde comer en Huelin, restaurantes Huelin, Calle Orfila 8, torreznos Málaga, croquetas Málaga, boquerones en vinagre"
		/>
		<meta name="author" content="Taberna de la Mata" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta
			name="robots"
			content="index, follow, max-image-preview:large, max-snippet:-1"
		/>
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/taberna-de-la-mata/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap"
			rel="stylesheet"
		/>
		<title>Taberna de la Mata | Tapas y cocina casera en Málaga</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Taberna de la Mata | Tapas en Málaga" />
		<meta
			property="og:description"
			content="Tapas y cocina casera cerca del Parque de Huelin. Calle Orfila, 8, Málaga."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Taberna de la Mata, taberna de Málaga" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Taberna de la Mata | Tapas en Málaga" />
		<meta
			name="twitter:description"
			content="Tapas y cocina casera cerca del Parque de Huelin. Calle Orfila, 8, Málaga."
		/>
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.region" content="ES-MA" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7070208;-4.4313743" />
		<meta name="ICBM" content="36.7070208, -4.4313743" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="wordmark" href="#inicio" aria-label="Taberna de la Mata, inicio">
				<span class="wordmark-icon" aria-hidden="true">M</span>
				<span>Taberna <b>de la Mata</b></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cocina">La cocina</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}>Llámanos <span>↗</span></a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> Málaga · barrio de Huelin</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Una taberna para comer a gusto, compartir unas tapas y disfrutar de la cocina casera en Málaga.
					</p>
					<div class="hero-actions">
						<a class="button button-gold" href={phoneHref}>Llamar para consultar <span aria-hidden="true">↗</span></a>
						<a class="quiet-link" href="#cocina">Conócenos <span aria-hidden="true">↓</span></a>
					</div>
					<a class="hero-address" href={directionsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Calle Orfila, 8 · 29002 Málaga
					</a>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración de una mesa de taberna con aceitunas y una copa">
					<div class="art-window"><span class="window-sun"></span><span class="window-sill"></span></div>
					<div class="art-table"></div>
					<div class="art-plate"><span class="plate-food"></span></div>
					<div class="art-glass"><span></span></div>
					<div class="art-olive olive-one"></div><div class="art-olive olive-two"></div>
					<p class="art-caption">Una mesa<br />y buen rato.</p>
					<span class="art-mark">TABERNA · MÁLAGA</span>
				</div>
				<div class="hero-seal" aria-hidden="true"><span>BUEN<br />PROVECHO</span><i>✳</i></div>
			</section>

			<section class="intro section-pad" id="cocina">
				<p class="section-label"><span class="short-rule"></span> Cocina casera · Málaga</p>
				<div class="intro-grid">
					<h2>Tapas para<br />compartir. <em>Sabores</em><br /><em>para recordar.</em></h2>
					<div class="intro-copy">
						<p>
							En Taberna de la Mata, en Málaga, la propuesta gira alrededor del tapeo y los platos de cocina española. Una parada de barrio para disfrutar sin complicaciones.
						</p>
						<p>
							En las reseñas públicas se mencionan especialmente los torreznos, las croquetas y los boquerones en vinagre. La carta puede cambiar: consulta al restaurante qué tienen hoy.
						</p>
						<a class="underline-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver reseñas y novedades en Google Maps <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" aria-labelledby="specialties-title">
				<div class="specialties-heading">
					<div><p class="eyebrow eyebrow-dark"><span></span> De lo que se habla</p><h2 id="specialties-title">Para pedir<br />al <em>centro.</em></h2></div>
					<p>Ideas que aparecen en las opiniones del local. Pregunta por disponibilidad y carta actualizada.</p>
				</div>
				<div class="dish-list">
					<article><span class="dish-symbol">01</span><h3>Torreznos</h3><p>Crujientes, para arrancar el tapeo.</p><span class="dish-arrow" aria-hidden="true">↗</span></article>
					<article><span class="dish-symbol">02</span><h3>Croquetas</h3><p>Un clásico que siempre encuentra sitio en la mesa.</p><span class="dish-arrow" aria-hidden="true">↗</span></article>
					<article><span class="dish-symbol">03</span><h3>Boquerones en vinagre</h3><p>Un sabor muy de Málaga, mencionado por visitantes.</p><span class="dish-arrow" aria-hidden="true">↗</span></article>
				</div>
				<p class="menu-disclaimer">No es una carta oficial. Platos, disponibilidad y precios pueden variar; consúltalos en el local.</p>
			</section>

			<section class="photos section-pad" id="fotos">
				<div class="photo-copy">
					<p class="eyebrow eyebrow-dark"><span></span> La taberna por dentro</p>
					<h2>Abre la puerta<br />y <em>asómate.</em></h2>
					<p>Consulta las fotos reales que visitantes han compartido en la ficha de Taberna de la Mata en Google Maps. La imagen de esta tarjeta es una ilustración decorativa.</p>
					<a class="button button-forest" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos reales en Google Maps <span aria-hidden="true">↗</span></a>
				</div>
				<a class="photo-card" href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Abrir las fotos de Taberna de la Mata en Google Maps">
					<div class="photo-card-art" aria-hidden="true"><span class="photo-arch"></span><span class="photo-plate"></span><span class="photo-flower">✳</span></div>
					<span class="photo-card-label"><span>Ilustración · no es foto del local</span><b>Ver fotos reales ↗</b></span>
				</a>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span></span> Huelin · Málaga</p>
					<h2>Nos vemos<br /><em>en la taberna.</em></h2>
					<p class="address">Calle Orfila, 8<br />29002 Málaga, España</p>
					<div class="visit-actions">
						<a class="button button-gold" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="visit-phone" href={phoneHref}>+34 666 31 06 91</a>
					</div>
					<p class="hours-note">Consulta el horario actualizado en Google Maps antes de venir.</p>
				</div>
				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
						title="Mapa de Taberna de la Mata en Calle Orfila, Málaga"
					 src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span>⌖</span> Taberna de la Mata · Málaga</a>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="wordmark" href="#inicio"><span class="wordmark-icon" aria-hidden="true">M</span><span>Taberna <b>de la Mata</b></span></a>
			<p>Tapas y cocina casera en Málaga</p>
			<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps <span aria-hidden="true">↗</span></a>
			<small>© {new Date().getFullYear()} Taberna de la Mata</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
	<a href="/taberna-de-la-mata/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
	<a href="/taberna-de-la-mata/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
	<a href="/taberna-de-la-mata/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
</nav>
</footer>
		<a class="mobile-call" href={phoneHref}>Llamar a la taberna <span>666 31 06 91</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/taberna-de-la-mata/aviso-legal">Aviso legal</a>
					<a href="/taberna-de-la-mata/aviso-legal#privacidad">Privacidad</a>
					<a href="/taberna-de-la-mata/aviso-legal#cookies">Cookies</a>
				</nav>
						<WhatsappFab phone={phoneHref} />
						</body>
</html>


