---
import { Image } from 'astro:assets';
import '../styles/global.css';
import { fotos } from '../data/fotos';
import {
  business,
  directionsUrl,
  faqs,
  faqSchema,
  hours,
  hoursNote,
  hoursSource,
  hoursSummary,
  mapEmbedUrl,
  mapsUrl,
  phoneHref,
  restaurantSchema,
  reviewsUrl,
  site,
} from '../data/site';

const title = "Doner Kebab Albir · Döner kebab en l'Albir (Alicante)";
const description =
  "Doner Kebab Albir, restaurante especializado en döner kebab en la avenida de l'Albir, 80, local 5 (03580 L'Alfàs del Pi, Alicante). Teléfono 965 05 30 19, horario publicado, fotos y mapa. Web informativa no oficial.";
const keywords =
  "Doner Kebab Albir, kebab l'Albir, döner kebab Alfàs del Pi, comer en l'Albir, kebab para llevar Alicante, avenida de l'Albir 80";

const [terraza, kebab, rollo] = fotos;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e4b57" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={business.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="geo.region" content="ES-VC" />
    <meta name="geo.placename" content={business.district} />
    <meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
    <meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
    <link rel="canonical" href={`${site.siteUrl}/`} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/doner-kebab-albir/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={business.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site.siteUrl}/`} />
    <meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="place:location:latitude" content={String(business.latitude)} />
    <meta property="place:location:longitude" content={String(business.longitude)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="topbar">
      <a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
        <span class="brand-text">Doner Kebab Albir<small>L'Albir · L'Alfàs del Pi</small></span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="#local">La casa</a>
        <a href="#carta">Qué hay</a>
        <a href="#fotos">Fotos</a>
        <a href="#horario">Horario</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
      <a class="topbar-phone" href={phoneHref}><span aria-hidden="true">☎</span>{business.phone}</a>
    </header>

    <main id="contenido">
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">L'Albir · Avenida de l'Albir, 80</p>
            <h1 id="hero-title">Döner kebab,<br /><em>en l'Albir.</em></h1>
            <p class="hero-lede">
              {business.name} está en la avenida de l'Albir, 80, local 5, con terraza en la acera y
              sala para comer dentro. La ficha pública lo clasifica como restaurante especializado en
              döner kebab, le da un 4,2 sobre 5 y publica un horario de 12:00 a 24:00. Web
              informativa no oficial: teléfono, horario, fotos y mapa.
            </p>
            <div class="hero-actions">
              <a class="btn btn-solid" href={phoneHref}>Llamar: {business.phone}</a>
              <a class="btn btn-ghost" href={directionsUrl} target="_blank" rel="noopener noreferrer">
                Cómo llegar <span aria-hidden="true">↗</span>
              </a>
            </div>
            <ul class="hero-facts">
              <li><small>Dirección</small><strong>{business.streetAddress} · {business.postalCode} {business.city}</strong></li>
              <li><small>Horario</small><strong>{hoursSummary}</strong></li>
              <li><small>Teléfono</small><strong>{business.phone}</strong></li>
            </ul>
          </div>

          <div class="hero-media">
            <div class="hero-collage">
              <figure class="collage-item collage-item-main">
                <Image src={terraza.src} alt={terraza.alt} loading="eager" fetchpriority="high" />
              </figure>
              <figure class="collage-item collage-item-top">
                <Image src={kebab.src} alt={kebab.alt} loading="eager" />
              </figure>
              <figure class="collage-item collage-item-bottom">
                <Image src={rollo.src} alt={rollo.alt} loading="eager" />
              </figure>
            </div>
            <p class="hero-stamp" aria-hidden="true"><span>L'Albir</span><strong>Kebab</strong><span>Av. 80</span></p>
          </div>
        </div>
      </section>

      <div class="band">
        <span>{business.streetAddress} · {business.postalCode} {business.city}</span>
        <span>{hoursSummary}</span>
        <span>Teléfono: {business.phone}</span>
      </div>

      <section class="section local" id="local" aria-labelledby="local-title">
        <div class="wrap local-grid">
          <div class="local-text">
            <p class="kicker">La casa</p>
            <h2 class="title" id="local-title">Kebab, terraza<br /><em>y sala.</em></h2>
            <p>
              El local está en el número 80 de la avenida de l'Albir, en un bajo con terraza sobre
              césped artificial y toldo en la acera. El rótulo de la terraza anuncia cafetería, bar,
              pizza y kebab, y las mesas dan a la avenida.
            </p>
            <p>
              Dentro hay dos ambientes: la sala de mesas de madera, con la barra y el mural de la
              carta al fondo, y la pared verde con el mural de fotos de platos junto a las neveras y
              el arcón de helados. La ficha de Google lo clasifica como restaurante especializado en
              döner kebab y le da un 4,2 sobre 5.
            </p>
            <p>
              No hay carta ni precios publicados en la ficha de Google. El cartel de menús del local
              muestra pita, rollo, plato, alitas, nuggets, hamburguesa, box menú y menú familiar, y
              en las fotos aparecen además pizzas y helados. Lo que haya cada día se pregunta por
              teléfono.
            </p>
            <ul class="category-list" aria-label="Categorías">
              {business.categories.map((c) => <li>{c}</li>)}
              <li>Terraza</li>
              <li>Helados</li>
            </ul>
            <p class="local-note">
              Las fotos de esta web proceden del perfil público del local en Google Maps y se
              muestran como referencia; si eres el titular y quieres retirar alguna, escríbenos y la
              quitamos. Para ver la ficha completa, usa la
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer">ficha en Google Maps ↗</a>.
            </p>
          </div>
          <div class="quote-row">
            <div class="quote-score">
              <strong>{business.phone}</strong>
              <span>Döner kebab, menús y terraza en l'Albir</span>
              <a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver ficha en Maps ↗</a>
            </div>
            <blockquote class="quote">
              <p>4,2 sobre 5 en la ficha pública del local.</p>
              <footer><strong>Valoración</strong><span>{hoursSource}</span></footer>
            </blockquote>
          </div>
        </div>
      </section>

      <section class="section carta" id="carta" aria-labelledby="carta-title">
        <div class="wrap">
          <p class="kicker">Qué hay</p>
          <h2 class="title" id="carta-title">Menús y platos,<br /><em>sin precios inventados.</em></h2>
          <p class="lead">
            Lo que anuncia el cartel del local y lo que se ve en las fotos. La ficha de Google no
            publica carta ni precios, así que aquí no se copian tarifas: se pregunta al llamar.
          </p>
          <div class="platos-grid">
            <article class="plato-card">
              <h3>Kebab</h3>
              <ul>
                <li><strong>Pita</strong><span>Carne de ternera o pollo con verduras y salsa, en pan de pita.</span></li>
                <li><strong>Rollo</strong><span>El mismo relleno enrollado en tortilla fina, como el de la foto.</span></li>
                <li><strong>Plato</strong><span>Carne, patatas y ensalada servidos en plato.</span></li>
              </ul>
            </article>
            <article class="plato-card">
              <h3>Menús</h3>
              <ul>
                <li><strong>Menú pita y menú rollo</strong><span>Con patatas y bebida, según el cartel del local.</span></li>
                <li><strong>Menú plato</strong><span>El plato de kebab en formato menú.</span></li>
                <li><strong>Menú alitas y menú nuggets</strong><span>Con patatas y bebida.</span></li>
                <li><strong>Box menú y menú familiar</strong><span>Para pedir en grupo o para llevar.</span></li>
              </ul>
            </article>
            <article class="plato-card">
              <h3>También</h3>
              <ul>
                <li><strong>Hamburguesa</strong><span>En el cartel de menús, también como menú.</span></li>
                <li><strong>Pizza</strong><span>El rótulo de la terraza anuncia cafetería, bar, pizza y kebab.</span></li>
                <li><strong>Helados</strong><span>Arcón de helados en la sala, junto a las neveras.</span></li>
              </ul>
            </article>
          </div>
          <p class="platos-note">
            Lista elaborada a partir del cartel de menús que aparece en las fotos del perfil público y
            del rótulo de la terraza. No es una carta oficial ni incluye precios: para saber qué hay
            hoy y cuánto cuesta, <a href={phoneHref}>llama al {business.phone}</a>.
          </p>
        </div>
      </section>

      <section class="section fotos" id="fotos" aria-labelledby="fotos-title">
        <div class="wrap">
          <p class="kicker">Las fotos</p>
          <h2 class="title" id="fotos-title">La terraza, la sala <em>y el kebab.</em></h2>
          <p class="lead">
            Imágenes del perfil público del local en Google Maps: la terraza en la avenida, el
            comedor, el mural de platos, el cartel de menús, el arcón de helados y el kebab servido.
          </p>
          <div class="fotos-grid">
            {fotos.map((foto) => (
              <figure class="foto-item">
                <Image src={foto.src} alt={foto.alt} loading="lazy" />
                <figcaption>{foto.pie}</figcaption>
              </figure>
            ))}
          </div>
          <p class="fotos-note">
            ¿Quieres ver más? Mira la
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer">ficha con fotos en Google Maps ↗</a>
            o <a href={phoneHref}>llama al {business.phone}</a>.
          </p>
        </div>
      </section>

      <section class="section horario" id="horario" aria-labelledby="horario-title">
        <div class="wrap horario-grid">
          <div>
            <p class="kicker">Horario y ubicación</p>
            <h2 class="title" id="horario-title">Avenida de l'Albir, 80,<br /><em>local 5.</em></h2>
            <address>{business.streetAddress}<br />{business.postalCode} {business.district} · {business.municipality}<br />{business.province} · España</address>
            <table class="hours-table">
              <caption>Horario publicado · {hoursSource}</caption>
              <tbody>
                {hours.map((item) => (
                  <tr><th scope="row">{item.day}</th><td>{item.service}</td></tr>
                ))}
              </tbody>
            </table>
            <p class="hours-note">{hoursNote}</p>
            <a class="contact-line" href={phoneHref}><small>Teléfono</small><strong>{business.phone}</strong></a>
            <div class="place-actions">
              <a class="btn btn-solid" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a>
              <a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver la ficha en Maps ↗</a>
            </div>
          </div>
          <div class="map-card">
            <iframe title={`Mapa de ${business.name} en ${business.district}`} src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
            <div class="map-tag">
              <div><strong>{business.shortName}</strong><small>{business.streetAddress} · {business.postalCode} {business.city}</small></div>
              <a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
            </div>
          </div>
        </div>
      </section>

      <section class="section faq" id="preguntas" aria-labelledby="faq-title">
        <div class="wrap">
          <p class="kicker">Preguntas frecuentes</p>
          <h2 class="title" id="faq-title">Antes de <em>llamar.</em></h2>
          <div class="faq-list">
            {faqs.map((faq) => (
              <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-top">
        <a class="footer-brand" href="#inicio" aria-label={`${business.shortName}, volver al inicio`}>
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          <span>{business.name}<small>{business.streetAddress} · {business.postalCode} {business.city}</small></span>
        </a>
        <nav class="footer-nav" aria-label="Contacto y ficha del local">
          <a href={phoneHref}>Llamar: {business.phone}</a>
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Ficha en Google Maps ↗</a>
        </nav>
        <small class="footer-note">
          © {new Date().getFullYear()} {business.name} · {business.streetAddress} ({business.postalCode} {business.city}).
          Web informativa no oficial con datos públicos del local, consultados el {site.consultado}. Confirma horario y precios por teléfono.
        </small>
      </div>
      <p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
      <nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
        <a href="/doner-kebab-albir/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
        <a href="/doner-kebab-albir/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
        <a href="/doner-kebab-albir/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
      </nav>
    </footer>

    <a class="mobile-call" href={phoneHref}>Llamar a Doner Kebab Albir <span>{business.phone}</span></a>

    <style>
      .platos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        gap: 1.3rem;
        margin-top: 2.2rem;
      }
      .plato-card {
        padding: 1.3rem 1.35rem;
        border: 1px solid var(--linea);
        border-radius: 0.35rem;
        background: #fffdf8;
      }
      .plato-card h3 {
        margin: 0 0 0.9rem;
        padding-bottom: 0.55rem;
        border-bottom: 2px solid var(--oro);
        font-family: var(--display);
        font-size: 1.35rem;
        font-weight: 500;
        color: var(--marino-oscuro);
      }
      .plato-card ul {
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: 0.9rem;
      }
      .plato-card li {
        padding: 0.45rem 0;
        border-bottom: 1px dashed rgb(34 42 38 / 0.12);
      }
      .plato-card li:last-child {
        border-bottom: 0;
      }
      .plato-card strong {
        display: block;
        color: var(--terracota-oscuro);
        font-size: 0.86rem;
        letter-spacing: 0.01em;
      }
      .plato-card span {
        display: block;
        margin-top: 0.15rem;
        color: var(--tinta-suave);
        line-height: 1.6;
      }
      .platos-note {
        max-width: 48rem;
        margin-top: 1.6rem;
        color: var(--apagado);
        font-size: 0.84rem;
        line-height: 1.7;
      }
      .platos-note a {
        color: var(--terracota-oscuro);
        font-weight: 600;
        border-bottom: 1px solid var(--terracota);
      }
    </style>
  </body>
</html>
