---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/la-cocina-de-cris-cuadrada-01.jpg';
import bacalao from '../assets/fotos/la-cocina-de-cris-apaisada-02.jpg';
import ensalada from '../assets/fotos/la-cocina-de-cris-apaisada-03.jpg';
import arrozNegro from '../assets/fotos/la-cocina-de-cris-apaisada-04.jpg';
import brocoli from '../assets/fotos/la-cocina-de-cris-cuadrada-05.jpg';
import fideua from '../assets/fotos/la-cocina-de-cris-apaisada-06.jpg';
import calle from '../assets/fotos/la-cocina-de-cris-apaisada-07.jpg';
import paella from '../assets/fotos/la-cocina-de-cris-apaisada-08.jpg';
import croquetas from '../assets/fotos/la-cocina-de-cris-apaisada-09.jpg';
import empanadas from '../assets/fotos/la-cocina-de-cris-apaisada-10.jpg';

import {
	BUSINESS,
	ENCARGOS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'La Cocina de Cris · Comida casera para llevar en Málaga';
const description =
	'La Cocina de Cris, en C. Ntra. Sra. de las Candelas, 24 (29004 Málaga). Comida casera para llevar, paellas y empanadas por encargo. De martes a domingo, mediodía.';

const galeria = [
	{
		src: calle,
		alt: 'La fachada de La Cocina de Cris en la calle, con el rótulo amarillo, el toldo de comida casera y el escaparate del local',
	},
	{
		src: paella,
		alt: 'Paella amarilla con verduras y tiras de pimiento rojo, rodeada de gajos de limón',
	},
	{
		src: empanadas,
		alt: 'Bandeja de empanadas gallegas recién hechas, con una pinza de servir',
	},
	{
		src: croquetas,
		alt: 'Croquetas caseras apiladas en un plato blanco sobre una mesa de madera',
	},
	{
		src: arrozNegro,
		alt: 'Arroz negro con pimientos rojos asados y limón en la paellera',
	},
	{
		src: fideua,
		alt: 'Fideuá de fideos finos con gambas y trozos de verdura',
	},
	{
		src: bacalao,
		alt: 'Lomos de bacalao en salsa de tomate con láminas de ajo doradas',
	},
	{
		src: ensalada,
		alt: 'Ensalada de brotes verdes con mango, queso feta y nueces en una fuente blanca',
	},
	{
		src: brocoli,
		alt: 'Brócoli salteado con láminas de ajo crujiente',
	},
	{
		src: fachada,
		alt: 'La entrada de La Cocina de Cris con la pizarra de tiza y la vitrina de comida casera al fondo',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de La Cocina de Cris',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-cocina-de-cris`,
	name: BUSINESS.name,
	alternateName: ['La Cocina de Cris Food', 'Cocina de Cris Málaga'],
	description:
		'Comida casera para llevar y encargos para eventos en la calle Ntra. Sra. de las Candelas, 24, local 4 (Carretera de Cádiz, 29004 Málaga). Paellas, empanadas y platos elaborados por encargo.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, MAPS.facebook],
	telephone: '+34951080918',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Paellas', 'Empanadas'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Tuesday',
			opens: '11:30',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday'],
			opens: '11:00',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '11:00',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Encargos', href: '#encargos' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-cocina-de-cris-cuadrada-01.jpg": fachada,
	"la-cocina-de-cris-apaisada-07.jpg": calle,
	"la-cocina-de-cris-apaisada-08.jpg": paella,
	"la-cocina-de-cris-apaisada-10.jpg": empanadas,
	"la-cocina-de-cris-apaisada-09.jpg": croquetas,
	"la-cocina-de-cris-apaisada-04.jpg": arrozNegro,
	"la-cocina-de-cris-apaisada-06.jpg": fideua,
	"la-cocina-de-cris-apaisada-02.jpg": bacalao,
	"la-cocina-de-cris-apaisada-03.jpg": ensalada,
	"la-cocina-de-cris-cuadrada-05.jpg": brocoli,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#232e1e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Karla:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Cocina de Cris, comida casera Málaga, comida para llevar Málaga, paellas por encargo Málaga, empanadas Málaga, catering Málaga, Carretera de Cádiz, Candelas 24"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar y encargos para eventos en Carretera de Cádiz, Málaga. Paellas, empanadas y platos elaborados por encargo."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Paella amarilla con verduras y pimientos de La Cocina de Cris, en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#232e1e"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Cocina de Cris"
			subtitle="Comida casera · Carretera de Cádiz"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Facebook ↗', href: MAPS.facebook, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma disponibilidad, precios y horario antes de la visita."
			ctaLabel="Llamar a La Cocina de Cris"
			navAriaLabel="Enlaces de La Cocina de Cris"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34951080918?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carta%20de%20La%20Cocina%20de%20Cris." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carta de La Cocina de Cris"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
