---
import '../styles/global.css';

const business = {
	name: 'Restaurante Los Lunares',
	short: 'Los Lunares',
	street: 'C/ Cádiz, 3',
	city: 'Conil de la Frontera',
	postalCode: '11140',
	phone: '+34 692 20 61 57',
	latitude: 36.275278,
	longitude: -6.0898687,
	site: 'https://www.sur-digital.com/restaurante-los-lunares',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+Los+Lunares/data=!4m7!3m6!1s0xd0c3901b34018fb:0x7e2896695bb8a961!8m2!3d36.275278!4d-6.0898687!16s%2Fg%2F12qh700g_!19sChIJ-xhAswE5DA0RYam4W2mWKH4?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34692206157';
const instagramUrl = 'https://www.instagram.com/loslunaresconil/';

const specialties = [
	{
		kicker: 'Recomendado',
		title: 'Tartar de atún',
		text: 'El plato más recomendado por la clientela, con pescado de la zona.',
	},
	{
		kicker: 'De la casa',
		title: 'Tortilla de patatas',
		text: 'Receta casera de las que vuelven a la mesa en cada visita.',
	},
	{
		kicker: 'Frescas',
		title: 'Ensaladas',
		text: 'Ensaladas como la de atún rojo, dentro de un menú de aperitivos.',
	},
	{
		kicker: 'Casera',
		title: 'Comida tradicional',
		text: 'Sitio familiar donde la comida parece casera, con sangría de la casa.',
	},
	{
		kicker: 'Cómodo',
		title: 'Tarjeta y niños',
		text: 'Aceptan tarjetas de crédito y débito; local apto para niños.',
	},
	{
		kicker: 'Reserva',
		title: '692 20 61 57',
		text: 'Reserva en el 692 20 61 57, sobre todo en temporada en Conil.',
	},
];

const gallery = [
	{ src: '/fotos/fachada.svg', alt: 'Ilustración del restaurante — sustituye por foto propia' },
	{ src: '/fotos/tartar.svg', alt: 'Ilustración de tartar de atún — sustituye por foto propia' },
	{ src: '/fotos/tortilla.svg', alt: 'Ilustración de tortilla — sustituye por foto propia' },
	{ src: '/fotos/comedor.svg', alt: 'Ilustración del comedor — sustituye por foto propia' },
	{ src: '/fotos/ensalada.svg', alt: 'Ilustración de ensaladas — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Los Lunares?',
		a: 'En C/ Cádiz, 3, 11140 Conil de la Frontera (Cádiz), según su web oficial y directorios.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'No hay horario verificado publicado: confirma en el 692 20 61 57 antes de venir.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'En temporada en Conil conviene reservar en el 692 20 61 57.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Comida tradicional casera: tartar de atún, tortilla de patatas, ensaladas, aperitivos y postres típicos.',
	},
	{
		q: '¿Aceptan tarjeta? ¿Pueden ir niños?',
		a: 'Sí: aceptan tarjetas de crédito y débito y el local es apto para niños, según su web.',
	},
];

const description =
	'Restaurante Los Lunares: comida casera tradicional en C/ Cádiz 3, Conil. Tartar de atún, tortilla y ensaladas. Tel. 692 20 61 57.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 692 20 61 57',
	image: [`${business.site}/fotos/fachada.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Andaluza', 'Mediterránea'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [instagramUrl],
	acceptsReservations: 'True',
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="Los Lunares: restaurante familiar en C/ Cádiz 3, Conil. Tartar de atún, tortilla y ensaladas. 692 20 61 57." />
		<meta name="keywords" content="Los Lunares Conil, restaurante Conil, Cádiz 3 Conil, tartar atún Conil, comida casera Cádiz" />
		<meta name="author" content="Restaurante Los Lunares" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/restaurante-los-lunares/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>Los Lunares | Restaurante familiar en Conil</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Los Lunares · Comida casera en Conil" />
		<meta property="og:description" content="Tradición familiar en C/ Cádiz 3: tartar de atún, tortilla y ensaladas." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/fachada.svg`} />
		<meta property="og:image:alt" content="Restaurante Los Lunares, Conil de la Frontera" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Los Lunares · Restaurante familiar en Conil" />
		<meta name="twitter:description" content="Tartar de atún y tortilla en C/ Cádiz 3, Conil." />
		<meta name="twitter:image" content={`${business.site}/fotos/fachada.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Conil de la Frontera" />
		<meta name="geo.position" content="36.275278;-6.0898687" />
		<meta name="ICBM" content="36.275278, -6.0898687" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Los Lunares, inicio">
				<span class="brand-mark" aria-hidden="true">LL</span>
				<span class="brand-name">Los Lunares <small>Conil de la Frontera</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">El restaurante</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>692 20 61 57</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C/ Cádiz, 3 · Conil</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante familiar en Conil: comida casera tradicional, tartar de atún,
						tortilla de patatas y trato cercano.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 692 20 61 57</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>Familiar</b> y casero</li>
						<li>Tartar de atún</li>
						<li>Tortilla</li>
						<li>Tarjeta OK</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/restaurante-los-lunares/fotos/fachada.svg" alt="Ilustración de Restaurante Los Lunares, Conil de la Frontera" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>C/ Cádiz 3 · Conil</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>4,4</b><span>Tripadvisor</span></div>
					<div><b>Casera</b><span>Cocina</span></div>
					<div><b>Conil</b><span>Cádiz</span></div>
				</div>
				<ul class="services">
					<li>Tartar de atún</li>
					<li>Tortilla</li>
					<li>Ensaladas</li>
					<li>Sangría casera</li>
					<li>Tarjeta</li>
					<li>Niños OK</li>
				</ul>
			</section>

			<section class="about section-pad" id="restaurante">
				<p class="section-label"><span aria-hidden="true"></span> El restaurante</p>
				<div class="about-grid">
					<h2>Tradición<br />que <em>cuida.</em></h2>
					<div class="about-copy">
						<p>
							«En Los Lunares cuidamos a nuestros clientes», dice la casa en su web: restaurante en
							C/ Cádiz, 3 (11140 Conil), con coordenadas 36.275278, -6.0898687.
						</p>
						<p>
							Mezclan comida tradicional con servicio ejemplar: recetas caseras a precio económico,
							con cervezas, aperitivos y postres típicos. La clientela destaca el tartar, la sangría
							casera y los precios buenos.
						</p>
						<p class="about-note">
							No publicamos horario por falta de fuente verificable: confirma en el 692 20 61 57 antes
							de venir, y reserva en temporada.
						</p>
						<div class="about-links">
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">Instagram @loslunaresconil <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales según su web y reseñas. Confirma la carta del día
						en el propio restaurante.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>La casa<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del restaurante.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C/ Cádiz, 3</p>
					<h2>Ven a Conil<br /><em>a comer.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<p class="hours-note">Horario sin fuente verificable. Confirma en el 692 20 61 57 antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al restaurante ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 692 20 61 57</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de Los Lunares en C/ Cádiz 3, Conil" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Los Lunares · Conil</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">LL</span>
				<p>Los Lunares<small>{business.street} · {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Los Lunares · Conil de la Frontera. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/restaurante-los-lunares/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/restaurante-los-lunares/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/restaurante-los-lunares/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>692 20 61 57</span></a>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34692206157?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Restaurante%20Los%20Lunares." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Restaurante Los Lunares"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
