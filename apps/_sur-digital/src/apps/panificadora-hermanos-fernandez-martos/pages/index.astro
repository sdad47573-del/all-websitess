---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/panificadora-hermanos-fernandez-martos-vertical-01.jpg';
import terraza from '../assets/fotos/panificadora-hermanos-fernandez-martos-apaisada-03.jpg';
import desayuno from '../assets/fotos/panificadora-hermanos-fernandez-martos-apaisada-07.jpg';
import barras from '../assets/fotos/panificadora-hermanos-fernandez-martos-cuadrada-09.jpg';
import hogazas from '../assets/fotos/panificadora-hermanos-fernandez-martos-cuadrada-08.jpg';
import roscón from '../assets/fotos/panificadora-hermanos-fernandez-martos-apaisada-10.jpg';
import donuts from '../assets/fotos/panificadora-hermanos-fernandez-martos-vertical-04.jpg';
import barrasCesta from '../assets/fotos/panificadora-hermanos-fernandez-martos-vertical-05.jpg';
import donutDetalle from '../assets/fotos/panificadora-hermanos-fernandez-martos-vertical-06.jpg';
import donutMano from '../assets/fotos/panificadora-hermanos-fernandez-martos-vista-2-02.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const title = 'Hermanos Fernández Martos · Panadería en Málaga';
const description =
	'Panificadora Hermanos Fernández Martos, en la plaza Moreno Villa, 5 (Carretera de Cádiz, 29002 Málaga). Pan del día, bollería, dulces y pasteles, con bocadillos y café. Teléfono 952 32 71 05.';

const galeria = [
	{
		src: terraza,
		alt: 'Terraza de la panadería con toldo amarillo y mesas blancas en la plaza',
	},
	{
		src: barras,
		alt: 'Barras de pan recién hechas en la cesta del obrador',
	},
	{
		src: desayuno,
		alt: 'Café en vaso y bocadillo tostado servidos en la mesa de la terraza',
	},
	{
		src: roscón,
		alt: 'Bollo grande de fruta confitada en su caja de cartón',
	},
	{
		src: donuts,
		alt: 'Bandeja de donuts glaseados recién hechos en la vitrina',
	},
	{
		src: barrasCesta,
		alt: 'Barras largas de pan apiladas en las cestas metálicas',
	},
	{
		src: hogazas,
		alt: 'Hogazas de pan integral en el cesto con su cartel de pizarra',
	},
	{
		src: donutDetalle,
		alt: 'Detalle de un donut glaseado junto a la bandeja de bollería',
	},
	{
		src: donutMano,
		alt: 'Donut glaseado sujeto con la mano sobre el fondo verde',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#fernandez-martos`,
	name: BUSINESS.name,
	alternateName: [
		'Hermanos Fernández Martos',
		'Panadería Hermanos Fernández Martos',
		'Panadería Fernández Martos',
	],
	description:
		'Panificadora con pan del día, bollería, dulces y pasteles, y barra con bocadillos y café, en la plaza Moreno Villa, 5 (Carretera de Cádiz, 29002 Málaga).',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 952 32 71 05',
	currenciesAccepted: 'EUR',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '06:30',
			closes: '14:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '07:00',
			closes: '14:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#f6d373" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600&family=Barlow:ital,wght@0,400;0,500;0,600;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panificadora Hermanos Fernández Martos, panadería Málaga, pan del día Carretera de Cádiz, bollería Málaga, bocadillos y café 29002, plaza Moreno Villa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan del día, bollería, dulces y pasteles, y barra con bocadillos y café en la plaza Moreno Villa, 5 (Málaga). De lunes a sábado por la mañana."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Terraza con toldo amarillo de la panadería Hermanos Fernández Martos, en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#f6d373"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/panificadora-hermanos-fernandez-martos/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Fernández Martos"
			subtitle="Panadería · Confitería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<div class="band band-butter">
				<LocalHero
					eyebrow="Pl. Moreno Villa, 5 · Carretera de Cádiz, Málaga"
					title={piezas.portada.titulo}
					lede={`La panificadora de los Hermanos Fernández Martos está en la plaza Moreno Villa, 5. Pan recién hecho, bollería, dulces y pasteles, y una barra con bocadillos y café en la misma esquina. Tiene ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
					image={fachada}
					imageAlt="Fachada de la panadería con el rótulo de Hermanos Fernández Martos y la puerta de madera abierta"
					primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
					facts={[
						{ label: 'Nota', html: '<b>4,6</b> en Google · 109 reseñas' },
						{ label: 'Horario', html: '<b>6:30–14:30</b> de lunes a viernes' },
						{ label: 'Barrio', html: '<b>Carretera de Cádiz</b>, Málaga' },
					]}
					galleryHref={MAPS.place}
					photoCredit="Foto del perfil de Google Maps"
					galleryLinkLabel="Ver la galería"
					tag="Abre a las 6:30"
				/>

				<LocalChips label="Lo que ofrece la panificadora" items={SERVICIOS} />
			</div>

			<div class="band band-flour">
				<LocalAbout
					label="La casa"
					title="Pan y café <br /><em>en la misma esquina.</em>"
					paragraphs={[
						'La panificadora está en la plaza Moreno Villa, 5, con el rótulo de Hermanos Fernández Martos sobre la puerta de madera y el toldo de rayas. Google la clasifica como panadería.',
						'El pan es lo que más se repite en las reseñas: «el mejor pan, los mejores dulces y sobre todo, un ambiente familiar muy guay», escribe un cliente; otro lo resume en «buenísimo el pan y pasteles». En las fotos del perfil aparecen las barras, las hogazas integrales con su cartel de pizarra y la bandeja de donuts.',
						'También hay barra: una reseña habla de «buenos bocadillos, buen café», y la terraza de la esquina se anuncia con un toldo de café-churros. La ficha no publica carta ni precios.',
						'Abre de lunes a sábado por la mañana y cierra los domingos. De accesibilidad, la ficha solo indica que no hay aparcamiento adaptado, así que esta página no afirma nada sobre la entrada.',
					]}
					note="4,6 sobre 5 con 109 reseñas en Google. «El mejor pan, los mejores dulces y sobre todo, un ambiente familiar muy guay»."
					links={[
						{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
						{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					]}
				/>
			</div>

			<div class="band band-flour">
				<LocalMenu
					eyebrow="El mostrador"
					title="Del horno <br /><em>a la barra.</em>"
					description="La ficha no publica carta ni precios. Estas familias son las que citan las reseñas y las fotos del perfil."
					cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					groups={MENU}
					note="Sin precios publicados: la panificadora no tiene web ni carta online en su ficha. Para saber qué hay cada día —y a qué precio—, lo mejor es llamar al 952 32 71 05 o pasarse por el mostrador."
				/>
			</div>

			<div class="band band-flour">
				<LocalGallery
					eyebrow="Fotos del perfil de Google Maps"
					title="Barras, hogazas <br /><em>y bollería.</em>"
					description="Nueve fotografías del perfil: la terraza y el desayuno, las barras en las cestas, las hogazas integrales, el bollo de fruta confitada y la bandeja de donuts. La fachada abre esta página."
					images={galeria}
					cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
					note="Imágenes alojadas en esta página y procedentes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
				/>
			</div>

			<div class="band band-butter-soft">
				<LocalVisit
					eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
					title="En la plaza, <br /><em>por la mañana.</em>"
					addressLines={[
						BUSINESS.street,
						BUSINESS.district,
						`${BUSINESS.postalCode} ${BUSINESS.city}`,
					]}
					hours={HOURS}
					hoursCaption="Horario"
					hoursNote="Horario publicado en la ficha de Google: de lunes a viernes desde las 6:30 y el sábado desde las 7:00, siempre hasta las 14:30. El domingo cierra. En festivos puede cambiar."
					mapTitle="Mapa de la Panificadora Hermanos Fernández Martos en la plaza Moreno Villa, Málaga"
					mapEmbedUrl={MAPS.embed}
					mapLabel="Fernández Martos · Carretera de Cádiz"
					mapHref={MAPS.place}
					links={[
						{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref, variant: 'primary' },
						{ label: 'Cómo llegar', href: MAPS.directions, external: true },
						{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					]}
					contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					reserveNote="No hay web propia ni pedidos online: se atiende en el mostrador, en la barra y por teléfono. De accesibilidad, la ficha solo indica que no hay aparcamiento adaptado."
				/>
			</div>

			<div class="band band-flour">
				<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
			</div>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos y fotografías de la ficha pública de Google Maps. Sin carta ni precios publicados por el establecimiento."
			ctaLabel="Llamar a Fernández Martos"
			navAriaLabel="Enlaces de la Panificadora Hermanos Fernández Martos"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34952327105?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20M%C3%A1laga." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Málaga"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
