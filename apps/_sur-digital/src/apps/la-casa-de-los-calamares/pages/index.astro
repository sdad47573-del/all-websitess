---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import paella from '../assets/fotos/la-casa-de-los-calamares-apaisada-01.jpg';
import bocadilloMesa from '../assets/fotos/la-casa-de-los-calamares-apaisada-04.jpg';
import boquerones from '../assets/fotos/la-casa-de-los-calamares-apaisada-07.jpg';
import bocadillo from '../assets/fotos/la-casa-de-los-calamares-apaisada-08.jpg';
import cartaBebidas from '../assets/fotos/la-casa-de-los-calamares-vertical-02.jpg';
import cana from '../assets/fotos/la-casa-de-los-calamares-vertical-03.jpg';
import mesaCanas from '../assets/fotos/la-casa-de-los-calamares-vertical-05.jpg';
import fritura from '../assets/fotos/la-casa-de-los-calamares-vertical-06.jpg';
import oreja from '../assets/fotos/la-casa-de-los-calamares-vertical-09.jpg';
import mesaFritura from '../assets/fotos/la-casa-de-los-calamares-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'La Casa de los Calamares · frituras y bocadillos de calamar en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: fritura,
		alt: 'Fritura variada de calamares, boquerones y cazón recién hecha, con gajo de limón',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo de calamares en barra de pan, con las anillas asomando',
	},
	{
		src: boquerones,
		alt: 'Boquerones fritos a la andaluza con limón, en plato de borde azul',
	},
	{
		src: paella,
		alt: 'Paella de marisco con gambas grandes y limón sobre mesa de mantel azul',
	},
	{
		src: cana,
		alt: 'Caña de cerveza Calatrava servida en jarra de cristal con asa',
	},
	{
		src: mesaCanas,
		alt: 'Mesa roja con tres cañas Calatrava y una sartén para compartir con palitos de pan',
	},
	{
		src: oreja,
		alt: 'Trozos de cerdo fritos con hierbas sobre plato de borde azul',
	},
	{
		src: mesaFritura,
		alt: 'Mesa con plato de fritura, limón y media caña Calatrava',
	},
	{
		src: bocadilloMesa,
		alt: 'Bocadillo de calamares partido en dos sobre plato blanco y mesa roja',
	},
	{
		src: cartaBebidas,
		alt: 'Carta de bebidas y licores de la casa, con los precios de barra y mesa',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#casa-de-los-calamares`,
	name: BUSINESS.name,
	alternateName: ['Casa de los Calamares', 'Los Calamares Ciudad Real'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Frituras de pescado', 'Tapas', 'Bocadillos', 'Cocina andaluza'],
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.channel },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Entrada adaptada', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-casa-de-los-calamares-vertical-06.jpg": fritura,
	"la-casa-de-los-calamares-apaisada-08.jpg": bocadillo,
	"la-casa-de-los-calamares-apaisada-07.jpg": boquerones,
	"la-casa-de-los-calamares-apaisada-01.jpg": paella,
	"la-casa-de-los-calamares-vertical-03.jpg": cana,
	"la-casa-de-los-calamares-vertical-05.jpg": mesaCanas,
	"la-casa-de-los-calamares-vertical-09.jpg": oreja,
	"la-casa-de-los-calamares-vertical-10.jpg": mesaFritura,
	"la-casa-de-los-calamares-apaisada-04.jpg": bocadilloMesa,
	"la-casa-de-los-calamares-vertical-02.jpg": cartaBebidas,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0d1d2a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Casa de los Calamares Ciudad Real, bocadillo de calamares calle de Toledo, frituras de pescado Ciudad Real, boquerones fritos, caña Calatrava, bar restaurante 13003, tapas Ciudad Real"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Frituras de pescado, bocadillo de calamar, sardinas y cañas Calatrava en la calle de Toledo, 81, de Ciudad Real. 3,7 sobre 5 con 115 reseñas. Teléfono 642 38 41 02."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fritura variada de La Casa de los Calamares"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#0d1d2a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[fritura]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/la-casa-de-los-calamares/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Frituras y cañas en la calle de Toledo"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y precios antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de La Casa de los Calamares"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34642384102?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Ciudad%20Real." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Ciudad Real"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
