---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import bife from '../assets/fotos/restaurante-costa-vicentina-apaisada-06.jpg';
import terraza from '../assets/fotos/restaurante-costa-vicentina-vertical-09.jpg';
import paella from '../assets/fotos/restaurante-costa-vicentina-vertical-05.jpg';
import polvo from '../assets/fotos/restaurante-costa-vicentina-vista-2-02.jpg';
import cataplana from '../assets/fotos/restaurante-costa-vicentina-vertical-10.jpg';
import copas from '../assets/fotos/restaurante-costa-vicentina-vertical-07.jpg';
import fachadaNoche from '../assets/fotos/restaurante-costa-vicentina-vertical-01.jpg';
import fachadaDia from '../assets/fotos/restaurante-costa-vicentina-vertical-03.jpg';
import calle from '../assets/fotos/restaurante-costa-vicentina-vertical-08.jpg';
import comedor from '../assets/fotos/restaurante-costa-vicentina-vertical-04.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
} from '../data/site';

const description = BUSINESS.description;

const galeria = [
	{
		src: terraza,
		alt: 'Terraza de BonaVentura en la Rua dos Correeiros, con manteles estampados de azulejo y sombrilla azul',
	},
	{
		src: paella,
		alt: 'Arroz de marisco en paellera negra con limón, y detrás un plato de pulpo a la parrilla',
	},
	{
		src: polvo,
		alt: 'Polvo grelhado con patata cocida, cebolla y aceite de oliva en un plato blanco',
	},
	{
		src: cataplana,
		alt: 'Cataplana de cobre con patata, almejas y mejillones, con cilantro y pan al lado',
	},
	{
		src: copas,
		alt: 'Jarra de cerveza Super Bock y copa de vino blanco en una mesa de la terraza',
	},
	{
		src: fachadaNoche,
		alt: 'Fachada de BonaVentura Wine & Food de noche, en la Rua dos Correeiros, con el comedor al fondo',
	},
	{
		src: fachadaDia,
		alt: 'Terraza y escaparate de BonaVentura Wine & Food a la luz del día, con el cajero automático al lado',
	},
	{
		src: calle,
		alt: 'Pizarra de la casa en la Rua dos Correeiros con los platos a la brasa y mesas preparadas',
	},
	{
		src: comedor,
		alt: 'Comedor interior con azulejo, lámparas de cuerda y un gran reloj de pared sobre la pared de mosaico',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.fullName,
	alternateName: [
		BUSINESS.name,
		BUSINESS.alsoKnownAs,
		'Restaurante Costa Vicentina Lisboa',
		'BonaVentura Rua dos Correeiros',
	],
	slogan: 'Wine & food en la Baixa',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 21 346 0905',
	currenciesAccepted: 'EUR',
	priceRange: '€€',
	servesCuisine: ['Portuguesa', 'Marisco', 'Internacional'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Baixa pombalina' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:45',
			closes: '23:45',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Costa Vicentina · Marisco y brasa en la Baixa (Lisboa)';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-costa-vicentina-apaisada-06.jpg": bife,
	"restaurante-costa-vicentina-vertical-09.jpg": terraza,
	"restaurante-costa-vicentina-vertical-05.jpg": paella,
	"restaurante-costa-vicentina-vista-2-02.jpg": polvo,
	"restaurante-costa-vicentina-vertical-10.jpg": cataplana,
	"restaurante-costa-vicentina-vertical-07.jpg": copas,
	"restaurante-costa-vicentina-vertical-01.jpg": fachadaNoche,
	"restaurante-costa-vicentina-vertical-03.jpg": fachadaDia,
	"restaurante-costa-vicentina-vertical-08.jpg": calle,
	"restaurante-costa-vicentina-vertical-04.jpg": comedor,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#173a5e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Source+Sans+3:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Costa Vicentina, Restaurante Costa Vicentina, BonaVentura Wine & Food, restaurante Rua dos Correeiros, comer en la Baixa Lisboa, arroz de marisco Lisboa, polvo grelhado Lisboa, cataplana Lisboa, restaurante Baixa pombalina, Rua dos Correeiros 37, marisco Lisboa centro"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Costa Vicentina · Marisco y brasa en la Baixa"
			ogDescription="Arroz de marisco, polvo grelhado, cataplana y bifes a la brasa en la Rua dos Correeiros 37. De martes a domingo, de 11:45 a 23:45. Tel. 21 346 0905."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bife a la parrilla con patatas fritas y vino en Costa Vicentina, Rua dos Correeiros 37, Lisboa"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#173a5e"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone="+351213460905"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.municipality}`}
			countryName="Portugal"
			contact={{
				street: BUSINESS.street,
				locality: `${BUSINESS.city}, ${BUSINESS.municipality}`,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				phone: '+351 21 346 0905',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[bife]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Wine & food · Baixa"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Costa Vicentina"
			creditLabel="Creado por"
			creditName="Sur Digital"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/351213460905?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Lisboa." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Lisboa"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
