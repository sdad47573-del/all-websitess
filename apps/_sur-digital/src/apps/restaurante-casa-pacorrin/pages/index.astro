---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/restaurante-casa-pacorrin-apaisada-05.jpg';
import foto1 from '../assets/fotos/restaurante-casa-pacorrin-apaisada-07.jpg';
import foto2 from '../assets/fotos/restaurante-casa-pacorrin-vertical-01.jpg';
import foto3 from '../assets/fotos/restaurante-casa-pacorrin-vertical-03.jpg';
import foto4 from '../assets/fotos/restaurante-casa-pacorrin-apaisada-09.jpg';
import foto5 from '../assets/fotos/restaurante-casa-pacorrin-vertical-06.jpg';

const business = {
	name: 'Restaurante Casa Pacorrín',
	short: 'Casa Pacorrín',
	street: 'Cam. Huerta de Abajo, 131',
	city: 'Las Torres de Cotillas',
	region: 'Región de Murcia',
	province: 'Murcia',
	postalCode: '30565',
	phone: '+34 968 62 79 77',
	latitude: 38.029702,
	longitude: -1.2270929,
	site: 'https://www.sur-digital.com/restaurante-casa-pacorrin',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+Casa+Pacorr%C3%ADn/@38.029702,-1.2270929,17z/data=!3m1!4b1!4m6!3m5!1s0xd647f6c1cf05c4b:0x4737b28bbdf6c149!8m2!3d38.029702!4d-1.2270929!16s%2Fg%2F11b6lj2br4?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34968627977';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'La casa',
		title: 'Arroces y cocina mediterránea',
		text: 'La ficha lo define así: «Restaurante comida mediterránea, arroces y carnes a la brasa». Esa es la carta de la casa.',
	},
	{
		kicker: 'La brasa',
		title: 'Carnes a la brasa',
		text: '«Carne a la brasa, raciones abundantes», resume una reseña. Pollo, conejo y brasas aparecen en los comentarios.',
	},
	{
		kicker: 'Todo casero',
		title: 'Cocina de casa',
		text: '«Carnes… pollo… conejo… todo casero y brasas, buen sitio», cuenta otro cliente de la casa.',
	},
	{
		kicker: 'Celebraciones',
		title: 'Salones para eventos',
		text: 'El local es también salón para eventos: «excelentes salones de celebraciones», según las reseñas.',
	},
	{
		kicker: 'El equipo',
		title: 'Profesionales y cercanos',
		text: '«Profesionales tanto dueños como camareros»: el trato del equipo aparece entre lo más valorado.',
	},
	{
		kicker: 'Raciones',
		title: 'Abundantes',
		text: '«Raciones abundantes» es una de las frases que más se repiten al describir la mesa de Casa Pacorrín.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de Restaurante Casa Pacorrín publicada en su ficha de Google Maps' },
	{ src: photos.foto2, alt: 'Imagen de Casa Pacorrín en Las Torres de Cotillas tomada de su galería de Google Maps' },
	{ src: photos.foto3, alt: 'Fotografía de Casa Pacorrín en el camino Huerta de Abajo, 131' },
	{ src: photos.foto4, alt: 'Imagen de Restaurante Casa Pacorrín subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Vista de Casa Pacorrín según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está Casa Pacorrín?',
		a: 'En el camino Huerta de Abajo, 131, 30565 Las Torres de Cotillas (Murcia). Coordenadas 38.029702, -1.2270929.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Lunes de 9:00 a 17:00 y miércoles de 11:00 a 17:00; jueves, viernes y sábado de 11:00 a 17:00 y de 20:00 a 23:50; domingo de 9:00 a 17:30. El martes cierra.',
	},
	{
		q: '¿Se puede celebrar un evento?',
		a: 'Sí, la ficha lo incluye como salón para eventos. Las reseñas hablan de «excelentes salones de celebraciones». Llama al 968 62 79 77 para consultar disponibilidad.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Cocina mediterránea, arroces y carnes a la brasa. Las reseñas citan pollo, conejo, brasas y raciones abundantes, con cocina casera.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso, aparcamiento, aseo y asientos adaptados para sillas de ruedas.',
	},
	{
		q: '¿Cómo se reserva?',
		a: 'La ficha no ofrece reservas en línea. Llama al 968 62 79 77 para reservar mesa o consultar un evento.',
	},
];

const description =
	'Casa Pacorrín, cocina mediterránea, arroces y carnes a la brasa en Las Torres de Cotillas (Murcia). Salones para celebraciones. Llama al 968 62 79 77.';

const images = [
	`${business.site}/og.jpg`,
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: business.short,
	description,
	url: `${business.site}/`,
	telephone: business.phone,
	image: images,
	servesCuisine: ['Mediterránea', 'Española', 'Arroces', 'Parrilla'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Monday', opens: '09:00', closes: '17:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Wednesday', opens: '11:00', closes: '17:00' },
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday', 'Friday', 'Saturday'],
			opens: '11:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday', 'Friday', 'Saturday'],
			opens: '20:00',
			closes: '23:50',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '09:00', closes: '17:30' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.2,
		reviewCount: 1208,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#3a1d27" />
		<meta
			name="description"
			content="Casa Pacorrín, cocina mediterránea, arroces y carnes a la brasa en Las Torres de Cotillas (Murcia). Salones para celebraciones. Llama al 968 62 79 77."
		/>
		<meta
			name="keywords"
			content="Casa Pacorrín, restaurante Las Torres de Cotillas, arroces Murcia, carnes a la brasa, salón de celebraciones, eventos Murcia"
		/>
		<meta name="author" content="Restaurante Casa Pacorrín" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/restaurante-casa-pacorrin/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Karla:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap"
			rel="stylesheet"
		/>
		<title>Casa Pacorrín | Arroces y brasa en Las Torres de Cotillas</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Casa Pacorrín · Arroces, brasa y celebraciones" />
		<meta
			property="og:description"
			content="Cocina mediterránea, arroces y carnes a la brasa en Las Torres de Cotillas (Murcia), con salones para eventos."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.jpg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Restaurante Casa Pacorrín, en Las Torres de Cotillas (Murcia)" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Casa Pacorrín · Arroces, brasa y celebraciones" />
		<meta
			name="twitter:description"
			content="Cocina mediterránea, arroces y carnes a la brasa en Las Torres de Cotillas (Murcia)."
		/>
		<meta name="twitter:image" content={`${business.site}/og.jpg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Las Torres de Cotillas" />
		<meta name="geo.position" content="38.029702;-1.2270929" />
		<meta name="ICBM" content="38.029702, -1.2270929" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Restaurante Casa Pacorrín, inicio">
				<span class="brand-mark" aria-hidden="true">CP</span>
				<span class="brand-name">Casa Pacorrín <small>Las Torres de Cotillas · Murcia</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">La casa</a>
				<a href="#mesa">La mesa</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>968 62 79 77</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Cam. Huerta de Abajo, 131 · Las Torres</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante Casa Pacorrín, cocina mediterránea en Las Torres de Cotillas (Murcia). Arroces,
						carnes a la brasa, cocina casera y salones para eventos.
					</p>
					<div class="hero-actions">
						<a class="button button-wine" href={phoneHref}>Llamar 968 62 79 77</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,2</b> en Google (1.208 reseñas)</li>
						<li>Arroces y brasa</li>
						<li>Salón de eventos</li>
						<li>Las Torres de Cotillas</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						alt="Restaurante Casa Pacorrín, arroces y carnes a la brasa en Las Torres de Cotillas"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,2</b><span>Google</span></div>
					<div><b>1.208</b><span>Reseñas</span></div>
					<div><b>6/7</b><span>Días</span></div>
				</div>
				<ul class="services">
					<li>Cocina mediterránea</li>
					<li>Arroces</li>
					<li>Carnes a la brasa</li>
					<li>Salón de eventos</li>
					<li>Local accesible</li>
					<li>Aparcamiento adaptado</li>
				</ul>
			</section>

			<section class="about section-pad" id="restaurante">
				<p class="section-label"><span aria-hidden="true"></span> Restaurante y salón de eventos</p>
				<div class="about-grid">
					<h2>La mesa<br />de siempre,<br /><em>en Las Torres.</em></h2>
					<div class="about-copy">
						<p>
							Casa Pacorrín está en el camino Huerta de Abajo, 131, en Las Torres de Cotillas (Murcia).
							Restaurante de cocina mediterránea y española, con arroces y carnes a la brasa.
						</p>
						<p>
							La ficha lo define como «restaurante comida mediterránea, arroces y carnes a la brasa». Las
							reseñas hablan de raciones abundantes, cocina casera, pollo y conejo a la brasa, y de unos
							salones excelentes para celebraciones.
						</p>
						<p class="about-note">
							También es salón para eventos. Llama al 968 62 79 77 para reservar mesa o consultar una
							celebración.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="mesa">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Lo que se pide</p>
						<h2>Del arroz<br />a la <em>brasa.</em></h2>
					</div>
					<p>
						Cocina mediterránea, arroces y carnes a la brasa. Esto es lo que destacan la ficha y las reseñas
						de sus clientes.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>Casa Pacorrín<br /><em>en imágenes.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Restaurante Casa Pacorrín. En la
							ficha encontrarás la galería completa, con aportaciones de clientes, y las reseñas
							actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="avif"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres el
					titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Cam. Huerta de Abajo, 131</p>
					<h2>Ven a Las<br /><em>Torres.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes</th>
								<td>9:00 – 17:00</td>
							</tr>
							<tr>
								<th scope="row">Martes</th>
								<td>Cerrado</td>
							</tr>
							<tr>
								<th scope="row">Miércoles</th>
								<td>11:00 – 17:00</td>
							</tr>
							<tr>
								<th scope="row">Jueves a sábado</th>
								<td>11:00 – 17:00 · 20:00 – 23:50</td>
							</tr>
							<tr>
								<th scope="row">Domingo</th>
								<td>9:00 – 17:30</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o para un evento, llama antes de venir.
					</p>

					<div class="visit-links">
						<a class="button button-wine" href={phoneHref}>Llamar 968 62 79 77</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 968 62 79 77</a>

					<ul class="access">
						<li>Acceso adaptado</li>
						<li>Aparcamiento adaptado</li>
						<li>Aseo adaptado</li>
						<li>Asientos adaptados</li>
					</ul>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Restaurante Casa Pacorrín en el camino Huerta de Abajo, 131, Las Torres de Cotillas"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;">
								<a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a>
							</p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Casa Pacorrín · Las Torres
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">CP</span>
				<p>Casa Pacorrín<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Restaurante Casa Pacorrín · Las Torres de Cotillas, Murcia. Fotografías
				procedentes de la ficha del restaurante en Google Maps.
			</small>

			<p class="footer-credit">
				Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
				<a href="https://sur-digital.vercel.app/" rel="noopener">sur-digital.vercel.app</a>
			</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
