---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES, NAV, PAGE_NAV } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-neutral text-neutral-content">
	<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
			<div class="lg:col-span-2">
				<a href="/a-style-beauty-salon/#inicio" class="flex items-center gap-3" aria-label={`${BUSINESS.name}, inicio`}>
					<Image
						src={IMAGES.logo}
						alt=""
						width={48}
						height={48}
						quality={90}
						format="webp"
						class="size-11 shrink-0 rounded-md object-cover"
					/>
					<span>
						<span class="font-display block text-xl font-bold text-white">{BUSINESS.name}</span>
						<span class="text-xs tracking-[0.2em] text-white/50 uppercase">
							Cruz de Humilladero · Málaga
						</span>
					</span>
				</a>
				<p class="mt-5 max-w-md text-sm leading-relaxed text-white/70">{BUSINESS.summary}</p>
				<p class="mt-4 text-xs leading-relaxed text-white/50">
					Lunes de 9:00 a 20:00, martes a viernes de 10:00 a 20:00 y sábado de 10:00 a 15:00.
					Domingo cerrado. Cita previa por teléfono; el horario puede variar en festivos.
				</p>
			</div>
			<div>
				<h2 class="text-lg font-semibold text-white">Secciones</h2>
				<ul class="mt-4 space-y-2 text-sm text-white/70">
					{
						NAV.map((item) => (
							<li>
								<a href={`/${item.href}`} class="hover:text-accent transition-colors">
									{item.label}
								</a>
							</li>
						))
					}
					{
						PAGE_NAV.map((item) => (
							<li>
								<a href={item.href} class="hover:text-accent transition-colors">
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<h2 class="text-lg font-semibold text-white">Contacto y ubicación</h2>
				<address class="mt-4 space-y-3 text-sm text-white/70 not-italic">
					<p>
						{BUSINESS.street}<br />{BUSINESS.postalCode}
						{BUSINESS.district}<br />{BUSINESS.city}
					</p>
					<p>
						<a href={BUSINESS.phoneHref} class="hover:text-accent">{BUSINESS.phoneDisplay}</a>
					</p>
					<p>
						<a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="hover:text-accent">Abrir ficha en Google Maps</a
						>
					</p>
				</address>
			</div>
		</div>
		<div
			class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-6 text-xs text-white/50 sm:flex-row"
		>
			<p>© {year} {BUSINESS.name}.</p>
			<a href="/a-style-beauty-salon/aviso-legal" class="hover:text-accent">Aviso legal y privacidad</a> <a href="/a-style-beauty-salon/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a> 
		</div>
		<p class="mt-6 text-center text-base text-white/70">
			Web creada por{' '}
			<a href="https://sur-digital.vercel.app/" class="font-semibold text-accent hover:underline" rel="noopener">Sur Digital</a>
		</p>
	</div>
</footer>
