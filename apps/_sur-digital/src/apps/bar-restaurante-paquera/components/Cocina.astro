---
import { BUSINESS, SERVICIOS, VENTAJAS } from '../data/site';
---

<section id="cocina" class="trama-paquera bg-base-200 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
			<div>
				<p class="text-secondary text-xs font-semibold tracking-[0.22em] uppercase">La cocina</p>
				<h2 class="font-display mt-3 text-3xl leading-tight font-bold sm:text-4xl">
					Comida casera, pescado y marisco
				</h2>
				<p class="text-base-content/70 mt-4 max-w-xl leading-relaxed">
					Lo que se cocina cada día, con el pescado y el marisco de la costa y las recetas de siempre.
					Pregunta por el menú del día cuando te sientes a la mesa.
				</p>
			</div>
			<a href={BUSINESS.phoneHref} class="btn btn-primary shrink-0 gap-2 rounded-full">
				<i class="ri-phone-line"></i> Reservar mesa
			</a>
		</div>

		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{
				SERVICIOS.map((plato, index) => (
					<article class="border-base-300 bg-base-100 relative flex flex-col rounded-xl border p-6 transition-shadow hover:shadow-lg">
						<span class="font-display text-primary/25 text-4xl leading-none font-bold">
							{String(index + 1).padStart(2, '0')}
						</span>
						<h3 class="font-display mt-4 text-xl font-bold">{plato.title}</h3>
						<p class="text-base-content/65 mt-2 flex-1 text-sm leading-relaxed">{plato.text}</p>
						<span class="text-primary mt-5 inline-flex size-9 items-center justify-center rounded-full bg-primary/10">
							<i class={`${plato.icon} text-lg`} />
						</span>
					</article>
				))
			}
		</div>

		<div class="bg-neutral mt-6 grid gap-8 rounded-xl px-6 py-8 text-white sm:px-10 lg:grid-cols-[1fr_auto] lg:items-center">
			<div>
				<h3 class="font-display text-xl font-bold sm:text-2xl">
					¿Vienes a desayunar, a comer o a quedarte?
				</h3>
				<p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/70">
					Abrimos a las siete. Si vienes en grupo o quieres reservar mesa, llama y te lo dejamos
					listo: {BUSINESS.phone}.
				</p>
			</div>
			<div class="flex flex-wrap gap-2">
				{
					VENTAJAS.map((v) => (
						<span class="badge gap-1.5 rounded-full border-white/20 bg-white/10 px-3 py-3 text-xs text-white">
							<i class={`${v.icon} text-accent`} /> {v.title}
						</span>
					))
				}
			</div>
		</div>
	</div>
</section>
