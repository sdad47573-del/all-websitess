---
import '../styles/global.css';
import { Image, getImage } from 'astro:assets';
import fotoPrincipal from '../assets/fotos/talleres-caldado-apaisada-01.jpg';
import { business, directionsUrl, emailHref, mapEmbedUrl, mapsUrl, phoneHref, structuredData } from '../lib/business';
import Galeria from '../components/Galeria.astro';

const title = 'Talleres Caldado | Taller de coches en Málaga';
const description =
	'Talleres Caldado en Málaga. Encuéntranos en avenida Carlos Haya, 163. Llama al 952 30 68 10 o escribe a tallerescaldado@eurotaller.com. Consulta cómo llegar.';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;

// Imagen para redes y JSON-LD: se genera a partir de la foto local. Antes se
// enlazaba la URL de lh3.googleusercontent.com, que Google responde con 403
// (bloquea el hotlinking), así que la tarjeta social salía sin imagen.
const ogImage = new URL(
	(await getImage({ src: fotoPrincipal, width: 1200, height: 630, format: 'jpg', fit: 'cover' })).src,
	business.site,
).href;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#242624" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/talleres-caldado/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content="Fotografía de Talleres Caldado en su perfil de Google Maps" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify({ ...structuredData, image: ogImage })}
		/>
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7250617;-4.4583111" />
		<meta name="ICBM" content="36.7250617, -4.4583111" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Talleres Caldado, inicio">
				<span class="brand-mark" aria-hidden="true"><span>TC</span><i></i></span>
				<span class="brand-name">Talleres Caldado <small>Taller · Málaga</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#taller">El taller</a>
				<a href="#ubicacion">Contacto</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}><span aria-hidden="true">↗</span> 952 30 68 10</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span class="signal-mark" aria-hidden="true"></span> Avda. Carlos Haya · Málaga</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Taller en Málaga, en la avenida Carlos Haya. Contacta con nosotros o consulta la ubicación
						antes de venir.
					</p>
					<div class="hero-actions">
						<a class="button button-orange" href={phoneHref}><span aria-hidden="true">↗</span> Llamar al taller</a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="hero-contact">
						<span class="contact-rule" aria-hidden="true"></span>
						<p><small>ENCUÉNTRANOS EN</small><strong>{business.streetAddress} · {business.city}</strong></p>
					</div>
				</div>

				<figure class="hero-photo">
					<div class="photo-frame">
						<span class="photo-label"><i aria-hidden="true"></i> TALLER · MÁLAGA</span>
						<Image
							src={fotoPrincipal}
							alt="Fotografía de Talleres Caldado compartida en su ficha de Google Maps, Málaga"
							widths={[600, 900, 1200, 1600]}
							sizes="(max-width: 900px) 92vw, 46vw"
							format="webp"
							quality={70}
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>
						<span class="photo-corner photo-corner-tl" aria-hidden="true"></span>
						<span class="photo-corner photo-corner-br" aria-hidden="true"></span>
					</div>
					<figcaption><span>Foto de la ficha de Google Maps</span><a href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos y ficha ↗</a></figcaption>
				</figure>
				<div class="body-panel" aria-hidden="true"></div>
			</section>

			<section class="identity-strip" id="taller" aria-label="Datos de Talleres Caldado">
				<div class="identity-mark" aria-hidden="true">TC<span>·</span></div>
				<p><small>NEGOCIO</small><strong>Talleres Caldado</strong></p>
				<span class="strip-rule" aria-hidden="true"></span>
				<p><small>DIRECCIÓN</small><strong>{business.streetAddress}</strong></p>
				<span class="strip-rule" aria-hidden="true"></span>
				<p><small>LOCALIDAD</small><strong>{business.postalCode} {business.city}</strong></p>
			</section>

			<section class="contact section-pad" id="ubicacion" aria-labelledby="contact-title">
				<div class="contact-copy">
					<p class="eyebrow dark"><span class="signal-mark" aria-hidden="true"></span> Estamos aquí</p>
					<h2 id="contact-title">Carlos Haya,<br /><em>Málaga.</em></h2>
					<p class="contact-lede">
						Visítanos en avenida Carlos Haya, 163. Para confirmar cualquier información antes de
						desplazarte, ponte en contacto con el taller.
					</p>
					<address>
						<span class="address-icon" aria-hidden="true">⌖</span>
						<span><strong>{business.streetAddress}</strong><small>{business.postalCode} {business.city}, España</small></span>
					</address>
					<a class="contact-detail" href={phoneHref}><small>TELÉFONO</small><strong>952 30 68 10</strong></a>
					<a class="contact-detail email-detail" href={emailHref}><small>CORREO</small><strong>{business.email}</strong></a>
					<div class="contact-actions">
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">
							Abrir indicaciones <span aria-hidden="true">↗</span>
						</a>
						<a class="text-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Google Maps ↗</a>
					</div>
				</div>

				<div class="map-shell">
					<div class="map-head"><span><i aria-hidden="true"></i> UBICACIÓN DEL TALLER</span><span>MÁLAGA · ES</span></div>
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
						title="Mapa de Talleres Caldado en avenida Carlos Haya, 163, Málaga"
					 src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-tag" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Talleres Caldado</a>
				</div>
			</section>
			<Galeria nombre="Talleres Caldado" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio" aria-label="Talleres Caldado, volver al inicio">
				<span class="brand-mark" aria-hidden="true"><span>TC</span><i></i></span>
				<span class="brand-name">Talleres Caldado <small>Taller · Málaga</small></span>
			</a>
			<p>{business.streetAddress} · {business.postalCode} {business.city}</p>
			<a class="footer-phone" href={phoneHref}>952 30 68 10 <span aria-hidden="true">↗</span></a>
			<small>© {new Date().getFullYear()} {business.name}. Información de contacto y ubicación.</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small>
			</p>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/talleres-caldado/aviso-legal">Aviso legal</a>
			<a href="/talleres-caldado/aviso-legal#privacidad">Privacidad</a>
			<a href="/talleres-caldado/aviso-legal#cookies">Cookies</a>
		</nav>
	</footer>

		<a class="mobile-call" href={phoneHref}><span aria-hidden="true">↗</span> Llamar a Caldado <strong>952 30 68 10</strong></a>

						<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34952306810?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Talleres%20Caldado." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Talleres Caldado"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>


