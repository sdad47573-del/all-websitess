---
import { Image } from 'astro:assets';
import '../styles/global.css';
import fotoTortilla from '../assets/fotos/can-cosmi-santa-agnes-vertical-02.jpg';
import fotoCocktail from '../assets/fotos/can-cosmi-santa-agnes-vertical-03.jpg';
import fotoTortillaCerveza from '../assets/fotos/can-cosmi-santa-agnes-vertical-04.jpg';
import fotoPasta from '../assets/fotos/can-cosmi-santa-agnes-vertical-06.jpg';
import fotoTerraza from '../assets/fotos/can-cosmi-santa-agnes-vertical-08.jpg';
import fotoPollo from '../assets/fotos/can-cosmi-santa-agnes-vertical-10.jpg';
import fotoIglesia from '../assets/fotos/can-cosmi-santa-agnes-apaisada-05.jpg';
import fotoComedor from '../assets/fotos/can-cosmi-santa-agnes-apaisada-01.jpg';
import fotoTortillaMesa from '../assets/fotos/can-cosmi-santa-agnes-apaisada-09.jpg';
import fotoAltar from '../assets/fotos/can-cosmi-santa-agnes-cuadrada-07.jpg';
import {
	business,
	directionsUrl,
	faqSchema,
	faqs,
	googleReviewsUrl,
	hours,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	specialties,
} from '../lib/business';

const title = 'Can Cosmi | Tortilla paisana y taberna en Santa Agnès';
const description =
	'Can Cosmi, taberna y colmado de 1951 en Santa Agnès de Corona, Ibiza. Tortilla paisana, cocina casera y terraza frente a la iglesia. Tel. 971 80 50 20.';
const keywords =
	'Can Cosmi Ibiza, tortilla paisana Santa Agnès, restaurante Santa Agnès de Corona, taberna ibicenca, colmado Can Cosmi, comer en Santa Agnès, Can Cosmi teléfono';

/** Fotografías descargadas de la ficha pública de Google Maps del restaurante. */
const galeria = [
	{
		src: fotoTortilla,
		alt: 'Tortilla paisana recién hecha con ensalada de verduras en la terraza de Can Cosmi',
		caption: 'Tortilla paisana',
	},
	{
		src: fotoComedor,
		alt: 'Comedor interior de Can Cosmi con mesas de madera, lámparas y suelo de baldosa',
		caption: 'El comedor',
	},
	{
		src: fotoAltar,
		alt: 'Altar de la iglesia de Santa Agnès, con retablo y flores',
		caption: 'La iglesia',
	},
	{
		src: fotoTortillaCerveza,
		alt: 'Tortilla paisana y un vaso de cerveza en una mesa de la terraza',
		caption: 'Tortilla y cerveza',
	},
	{
		src: fotoPasta,
		alt: 'Pasta con salsa de tomate y albahaca en la terraza, con una cerveza al fondo',
		caption: 'Pasta de la casa',
	},
	{
		src: fotoTerraza,
		alt: 'Terraza de Can Cosmi con sillas de madera, palmera y la calle del pueblo',
		caption: 'La terraza',
	},
	{
		src: fotoPollo,
		alt: 'Pollo a la plancha con patatas y pimientos, junto a una tortilla, en la mesa',
		caption: 'Pollo y patatas',
	},
	{
		src: fotoCocktail,
		alt: 'Cóctel rojo con apio y limón en la terraza de Can Cosmi',
		caption: 'En la terraza',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f8f2e4" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="Can Cosmi" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-IB" />
		<meta name="geo.placename" content="Santa Agnès de Corona" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/can-cosmi-santa-agnes/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@300..700&family=Instrument+Serif:ital@0;1&family=Space+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Can Cosmi" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Tortilla paisana de Can Cosmi en la terraza de Santa Agnès" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.jpg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Can Cosmi, inicio">
				<span class="brand-mark" aria-hidden="true">CC</span>
				<span class="brand-copy">
					<strong>Can Cosmi</strong>
					<small>Santa Agnès · Eivissa · 1951</small>
				</span>
			</a>
			<nav class="site-nav" aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">Carta</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
					<path d="M6.6 3.5 9 4.9l-1.3 3.3a13 13 0 0 0 6.1 6.1l3.3-1.3 1.4 2.4c.4.7.2 1.6-.5 2l-1.6.9c-1.8 1-4.2.2-7.2-2.6-3-3-3.9-5.4-2.9-7.2l.9-1.6c.4-.7 1.3-.9 2-.5Z" />
				</svg>
				971 80 50 20
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap">
					<div class="hero-head">
						<p class="eyebrow">Santa Agnès de Corona · Desde 1951</p>
						<h1 id="hero-title">La tortilla que<br /><em>reúne al pueblo.</em></h1>
						<p class="hero-intro">
							Taberna, restaurante y colmado en la plaza de Santa Agnès. La tortilla paisana de siempre,
							cocina casera y una terraza frente a la iglesia para comer sin mirar el reloj.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={phoneHref}>
								Llamar y reservar
								<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M3 13 13 3M6 3h7v7" />
								</svg>
							</a>
							<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">
								Cómo llegar
								<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M8 14s5-4.6 5-8A5 5 0 0 0 3 6c0 3.4 5 8 5 8Z" /><circle cx="8" cy="6" r="1.6" />
								</svg>
							</a>
							<span class="hero-rating">
								<strong>4,2 ★</strong>
								<a href={googleReviewsUrl} target="_blank" rel="noreferrer">685 reseñas en Google</a>
							</span>
						</div>
					</div>

					<div class="hero-collage">
						<figure class="hero-figure hero-figure--church">
							<Image
								src={fotoIglesia}
								alt="Iglesia blanca de Santa Agnès de Corona con un almendro en flor delante y cielo azul"
								format="webp"
								quality={82}
								widths={[640, 960, 1280]}
								sizes="(min-width: 861px) 60vw, 100vw"
								loading="eager"
								fetchpriority="high"
							/>
							<figcaption>
								<span>La plaza y la iglesia</span>
								<span>Santa Agnès de Corona</span>
							</figcaption>
						</figure>
						<figure class="hero-figure hero-figure--tortilla">
							<Image
								src={fotoTortillaMesa}
								alt="Tortilla paisana en un plato blanco sobre una mesa de la terraza, con un vaso de cerveza"
								format="webp"
								quality={82}
								widths={[480, 720, 960]}
								sizes="(min-width: 861px) 36vw, 100vw"
								loading="eager"
								fetchpriority="high"
							/>
							<figcaption>
								<span>La tortilla paisana</span>
								<span>Patata y verduras</span>
							</figcaption>
						</figure>
						<span class="hero-stamp" aria-hidden="true">1951<small>Colmado · Bar</small></span>
					</div>
				</div>
			</section>

			<div class="band" aria-label="Señas de identidad de Can Cosmi">
				<div class="wrap">
					<ul>
						<li>Tortilla paisana</li>
						<li>Colmado desde 1951</li>
						<li>Terraza frente a la iglesia</li>
						<li>Martes cerrado</li>
					</ul>
				</div>
			</div>

			<section class="section story" id="casa" aria-labelledby="story-title">
				<div class="wrap">
					<div class="story-grid">
						<div>
							<p class="section-label">La casa</p>
							<h2 id="story-title">Una casa de pueblo,<br /><em>sin prisa.</em></h2>
							<p class="story-year">1951</p>
							<span class="story-year-label">Año de apertura · Santa Agnès de Corona</span>
						</div>
						<div class="story-copy">
							<p>
								Can Cosmi abrió en 1951 como colmado y bar de pueblo. Los vecinos del Pla de Corona venían a
								tomar un chato de vino, vender la cosecha de almendras y algarrobas o comprar lo básico. Lo
								pusieron en marcha María Costa y Pep Boned, y la casa sigue en manos de la familia.
							</p>
							<p>
								Con los primeros turistas llegaron las tortillas paisanas de María, que hoy siguen siendo el
								motivo de muchas excursiones a Santa Agnès. La terraza mira a la iglesia; dentro, el comedor
								mantiene las mesas de madera, el suelo de baldosa y el aire de taberna de siempre.
							</p>
							<blockquote class="story-quote">
								«Restaurante pagés con toque andaluz.»
								<cite>Descripción del restaurante en Google</cite>
							</blockquote>
							<p>
								Al lado del bar sigue el colmado, uno de los más antiguos de Corona: productos envasados,
								fruta y verdura, alpargatas y cestas tradicionales. Es la otra mitad de Can Cosmi, y también
								forma parte de la visita.
							</p>
							<p class="story-signature">La misma plaza, la misma tortilla, otra generación.</p>
							<p class="source-note">
								Historia y datos de Ibiza 5 Sentidos, la ficha pública de Google Maps y el perfil de Instagram
								del restaurante, consultados en octubre de 2026. La selección de platos es orientativa; no es
								la carta oficial.
							</p>
						</div>
					</div>

					<div class="facts">
						<div class="fact"><strong>1951</strong><span>Colmado y bar de pueblo</span></div>
						<div class="fact"><strong>4,2 / 5</strong><span>685 reseñas en Google</span></div>
						<div class="fact"><strong>Santa Agnès</strong><span>Pla de Corona · Eivissa</span></div>
					</div>

					<div class="shop-strip">
						<div>
							<p class="section-label">El colmado</p>
							<h3>La tienda de siempre.</h3>
						</div>
						<div>
							<p>
								Junto al comedor, el colmado conserva el aire de las tiendas de antes. Merece la pena entrar
								a mirar antes de sentarse a la mesa.
							</p>
							<div class="shop-tags">
								<span>Productos envasados</span>
								<span>Fruta y verdura</span>
								<span>Alpargatas</span>
								<span>Cestas tradicionales</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="section menu-section" id="carta" aria-labelledby="menu-title">
				<div class="wrap">
					<div class="menu-head">
						<div>
							<p class="section-label">La carta</p>
							<h2 id="menu-title">Cocina de casa,<br /><em>de la plaza.</em></h2>
						</div>
						<p>
							Platos sencillos y caseros, con la tortilla paisana como protagonista. Precios, disponibilidad y
							alérgenos se consultan en el local o por teléfono.
						</p>
					</div>
					<div class="menu-layout">
						<div class="menu-sheet">
							<div class="menu-sheet-head">
								<strong>Carta de taberna</strong>
								<small>Can Cosmi · Santa Agnès</small>
							</div>
							<div class="menu-grid">
								{specialties.map((dish) => (
									<article class="menu-item">
										<small>{dish.category}</small>
										<h3>{dish.name}</h3>
										<p>{dish.description}</p>
									</article>
								))}
							</div>
						</div>
						<aside class="menu-aside">
							<span class="aside-mark" aria-hidden="true">“</span>
							<h3>La tortilla manda.</h3>
							<p>
								Patata, huevo y verduras. Es el plato que hizo famoso al pueblo y el que sigue pidiendo casi
								todo el mundo al sentarse en la terraza.
							</p>
							<ul>
								<li><strong>Cenas amenizadas</strong>Jueves y domingos, 20:00–22:00</li>
								<li><strong>Martes</strong>Cerrado</li>
								<li><strong>Reservas</strong>971 80 50 20</li>
							</ul>
						</aside>
					</div>
					<p class="menu-note">
						La carta cambia con la temporada y el mercado. Llama al <a href={phoneHref}>{business.phone}</a>
						para preguntar por los platos del día, el menú infantil o la disponibilidad de mesa.
					</p>
				</div>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<div class="wrap">
					<div class="gallery-head">
						<div>
							<p class="section-label">La plaza</p>
							<h2 id="gallery-title">La mesa, la iglesia<br /><em>y el colmado.</em></h2>
						</div>
						<p>
							Ocho imágenes de la ficha pública de Can Cosmi: la tortilla, el comedor, la terraza y la iglesia
							que da nombre a la plaza.
						</p>
					</div>
					<div class="gallery-grid">
						{galeria.map((foto, index) => (
							<figure class="gallery-photo">
								<Image
									src={foto.src}
									alt={foto.alt}
									format="webp"
									quality={78}
									widths={index === 0 ? [640, 960, 1200] : [320, 480, 720]}
									sizes={index === 0 ? '(min-width: 861px) 66vw, 100vw' : '(min-width: 861px) 33vw, 50vw'}
									loading="lazy"
								/>
								<figcaption>{foto.caption}</figcaption>
							</figure>
						))}
						<div class="gallery-quote">
							<p>La misma plaza, la misma tortilla, otra generación.</p>
							<small>Can Cosmi · Santa Agnès · 1951</small>
						</div>
					</div>
					<div class="gallery-foot">
						<div class="gallery-links">
							<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
							<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
						</div>
						<p class="gallery-note">
							Fotografías alojadas desde la ficha pública del restaurante en Google Maps. Si eres el titular y
							quieres retirar alguna, escríbenos y la quitamos.
						</p>
					</div>
				</div>
			</section>

			<section class="section reviews" aria-labelledby="reviews-title">
				<div class="wrap">
					<div class="reviews-head">
						<div>
							<p class="section-label">Lo que se dice en la plaza</p>
							<h2 id="reviews-title">La mesa, <em>palabra a palabra.</em></h2>
						</div>
						<div class="reviews-score">
							<strong>4,2</strong>
							<small>
								<span class="stars" aria-hidden="true">★★★★★</span><br />
								685 reseñas en Google<br />
								<a href={googleReviewsUrl} target="_blank" rel="noreferrer">Leerlas en Google ↗</a>
							</small>
						</div>
					</div>
					<div class="review-grid">
						{reviews.map((review) => (
							<article class="review">
								<blockquote>«{review.quote}»</blockquote>
								<footer>
									<span aria-label={`${review.rating} de 5 estrellas`}>{'★'.repeat(review.rating)}</span>
									<a href={googleReviewsUrl} target="_blank" rel="noreferrer">Reseña en Google ↗</a>
								</footer>
							</article>
						))}
					</div>
					<p class="reviews-note">
						Comentarios publicados por clientes en Google. Se reproducen de forma literal o ligeramente
						resumida; la valoración media corresponde a Google en octubre de 2026.
					</p>
				</div>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div class="wrap visit-grid">
					<div>
						<p class="section-label">Visítanos</p>
						<h2 id="visit-title">En la plaza,<br /><em>frente a la iglesia.</em></h2>
						<address>
							<strong>Can Cosmi</strong><br />
							Plaza de la Església, s/n<br />
							07828 Santa Agnès de Corona · Sant Antoni de Portmany
						</address>
						<ul class="hours" aria-label="Horario de Can Cosmi">
							{hours.map((row) => (
								<li><span>{row.day}</span><span>{row.hours}</span></li>
							))}
						</ul>
						<div class="contact-lines">
							<span><a href={phoneHref}>{business.phone}</a></span>
							<span><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a> · <a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps</a></span>
						</div>
						<div class="visit-actions">
							<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">
								Cómo llegar
								<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M3 13 13 3M6 3h7v7" />
								</svg>
							</a>
							<a class="button button-ghost" href={phoneHref}>Llamar para reservar</a>
						</div>
						<p class="visit-note">
							Según la ficha del restaurante, hay cenas amenizadas los jueves y domingos de 20:00 a 22:00. En
							invierno el horario se acorta y el local suele cerrar por vacaciones; confirma por teléfono antes
							de venir.
						</p>
					</div>
					<div class="map-card">
						<iframe
							title="Mapa de Can Cosmi en la Plaza de la Església, Santa Agnès de Corona"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<div class="map-label">
							<div>
								<strong>Can Cosmi</strong><br />
								<small>Plaza de la Església, s/n · Santa Agnès</small>
							</div>
							<a href={mapsUrl} target="_blank" rel="noreferrer">Abrir en Maps ↗</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="section-label">Antes de venir</p>
					<h2 id="faq-title">Preguntas <em>frecuentes.</em></h2>
					<div class="faq-grid">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-top">
					<div class="footer-brand">
						<a class="brand" href="#inicio" aria-label="Can Cosmi, volver al inicio">
							<span class="brand-mark" aria-hidden="true">CC</span>
							<span class="brand-copy">
								<strong>Can Cosmi</strong>
								<small>Santa Agnès · Eivissa · 1951</small>
							</span>
						</a>
						<p>
							Taberna, restaurante y colmado en Santa Agnès de Corona. Tortilla paisana, cocina casera y
							terraza frente a la iglesia.
						</p>
					</div>
					<div class="footer-col">
						<h2>Explorar</h2>
						<ul>
							<li><a href="#casa">La casa</a></li>
							<li><a href="#carta">Carta</a></li>
							<li><a href="#fotos">Fotos</a></li>
							<li><a href="#preguntas">Preguntas frecuentes</a></li>
						</ul>
					</div>
					<div class="footer-col">
						<h2>Contacto</h2>
						<ul>
							<li><address>Plaza de la Església, s/n<br />07828 Santa Agnès de Corona</address></li>
							<li><a href={phoneHref}>{business.phone}</a></li>
							<li><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a></li>
							<li><a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps</a></li>
						</ul>
					</div>
				</div>
				<div class="footer-bottom">
