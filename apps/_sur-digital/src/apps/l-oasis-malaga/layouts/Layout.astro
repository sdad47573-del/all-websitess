---
import 'remixicon/fonts/remixicon.css';
import '../styles/index.css';

import { BUSINESS, OG_IMAGE, buildSchemaGraph } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	/** Ruta de la página, para el canonical y el og:url. */
	path?: string;
	noIndex?: boolean;
	/** Entidades extra de schema.org específicas de esta página. */
	schema?: Record<string, unknown>[];
	/** Imagen para las tarjetas sociales. */
	ogImage?: string;
}

const {
	title = `${BUSINESS.fullName} | Restaurante halal en Málaga`,
	description = `Cocina halal y cafetería en el Paseo de los Tilos, Málaga, a 2 min de la estación María Zambrano. Desayunos de 8:00 a 15:00, comida y cena. Abierto los 7 días.`,
	path = '/l-oasis-malaga/',
	noIndex = false,
	schema = [],
	ogImage = OG_IMAGE,
} = Astro.props;

const canonical = new URL(path, BUSINESS.mapUrl).toString();
const ogImageUrl = new URL(ogImage, BUSINESS.mapUrl).toString();
const keywords =
	"L'Oasis Málaga, restaurante halal Málaga, cafetería halal Cruz de Humilladero, desayunos Málaga, comida halal Paseo de los Tilos, L'OASIS Restaurante & Cafetería, cerca de la estación María Zambrano, café halal Málaga";

/**
 * `robots` con las directivas de previsualizacion. Se declara como constante
 * porque el ternario inline dentro de `content={...}` lo rompe el parser de
 * atributos de Astro cuando la cadena lleva varios `-1` seguidos.
 */
const robots = noIndex
	? 'noindex, follow'
	: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// El grafo une WebPage + BreadcrumbList + Restaurant + WebSite con @id,
// de modo que Google entiende la relación entre las páginas y el negocio.
const graph = buildSchemaGraph({ name: title, path, description }, schema);
---

<!doctype html>
<html lang="es" data-theme="oasis">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/l-oasis-malaga/favicon.svg" />
		<link rel="apple-touch-icon" href="/l-oasis-malaga/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="Jose Aguilar" />
		<meta name="robots" content={robots} />
		<meta name="theme-color" content="#0F6B52" />
		<meta name="language" content="Spanish" />
		<meta name="rating" content="general" />

		<!-- SEO local: coordenadas, región y vicinity para buscadores y directorios -->
		<meta name="geo.region" content="ES-AN" />
		<meta name="geo.placename" content={BUSINESS.city} />
		<meta name="geo.position" content={`${BUSINESS.geo.lat};${BUSINESS.geo.lng}`} />
		<meta name="ICBM" content={`${BUSINESS.geo.lat}, ${BUSINESS.geo.lng}`} />

		<link rel="canonical" href={canonical} />

		<!-- Open Graph -->
		<meta property="og:type" content="restaurant" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={BUSINESS.fullName} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content={`${BUSINESS.fullName}, ${BUSINESS.street}, ${BUSINESS.city}`}
		/>
		<meta property="og:locale" content="es_ES" />
		<meta property="og:street-address" content={`${BUSINESS.street}, ${BUSINESS.district}`} />
		<meta property="og:locality" content={BUSINESS.city} />
		<meta property="og:region" content={BUSINESS.region} />
		<meta property="og:postal-code" content={BUSINESS.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:latitude" content={String(BUSINESS.geo.lat)} />
		<meta property="og:longitude" content={String(BUSINESS.geo.lng)} />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta
			name="twitter:image:alt"
			content={`${BUSINESS.fullName}, ${BUSINESS.street}, ${BUSINESS.city}`}
		/>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Mulish:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<!-- El mapa incrustado es el recurso de terceros más pesado: adelanta su conexión -->
		<link rel="preconnect" href="https://maps.google.com" />

		<script type="application/ld+json" set:html={JSON.stringify(graph)} />
	</head>
	<body class="bg-base-100 text-base-content font-sans antialiased">
		<slot />
	</body>
</html>
