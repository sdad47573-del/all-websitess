---
import { BUSINESS, NAV, PAGE_NAV } from '../data/site';
---

<header class="fixed inset-x-0 top-0 z-50">
	<div class="navbar bg-base-100/85 backdrop-blur-md shadow-sm min-h-16">
		<div class="navbar-start">
			<div class="dropdown lg:hidden">
				<div tabindex="0" role="button" class="btn btn-ghost btn-square" aria-label="Abrir menú">
					<i class="ri-menu-line text-2xl"></i>
				</div>
				<ul
					tabindex="0"
					class="menu dropdown-content menu-sm mt-3 w-56 rounded-box bg-base-100 p-2 shadow-lg"
				>
					{NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
					{PAGE_NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
				</ul>
			</div>
			<a href="/l-oasis-malaga/" class="btn btn-ghost px-2 text-xl font-display">
				<span class="text-primary">L'</span>Oasis
				<span class="hidden text-xs font-normal opacity-60 sm:inline">Málaga</span>
			</a>
		</div>

		<nav class="navbar-center hidden lg:flex">
			<ul class="menu menu-horizontal gap-1 px-1">
				{NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
			</ul>
		</nav>

		<div class="navbar-end gap-2">
			<a
				href={BUSINESS.instagram}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-ghost btn-square btn-sm hidden sm:inline-flex"
				aria-label="Instagram de L’Oasis"
			>
				<i class="ri-instagram-line text-xl"></i>
			</a>
			<a href={BUSINESS.phoneHref} class="btn btn-primary btn-sm gap-2">
				<i class="ri-phone-line"></i>
				<span class="hidden sm:inline">{BUSINESS.phoneDisplay}</span>
				<span class="sm:hidden">Llamar</span>
			</a>
		</div>
	</div>
</header>
