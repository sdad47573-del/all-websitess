---
import { BUSINESS, MENU } from '../data/site';

interface Props {
	/** Muestra todas las categorías en vez de las pestañas. */
	full?: boolean;
	title?: string;
	description?: string;
}

const { full = false, title, description } = Astro.props;

const sectionTitle = title ?? 'La carta';
const sectionDescription =
	description ??
	'Platos de desayuno, entrantes para compartir, fondos de cocina mediterránea y bebidas. Sin alcohol en toda la carta.';
---

<section id="carta" class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
	<header class="max-w-2xl">
		<p class="mb-3 text-sm font-semibold tracking-widest uppercase text-primary">Cocina</p>
		<h2 class="font-display text-3xl font-semibold sm:text-4xl">{sectionTitle}</h2>
		<p class="mt-4 leading-relaxed opacity-80">{sectionDescription}</p>
	</header>

	{
		full ? (
			<div class="mt-10 grid gap-6 md:grid-cols-2">
				{MENU.map((section) => (
					<article class="card card-border bg-base-200/50 shadow-sm">
						<div class="card-body">
							<h3 class="card-title font-display text-xl">
								<i class={`${section.icon} text-primary`} />
								{section.name}
							</h3>
							<ul class="mt-2 divide-y divide-base-300">
								{section.items.map((item) => (
									<li class="py-3">
										<div class="flex items-start justify-between gap-3">
											<span class="font-medium">{item.name}</span>
											{item.tags?.map((tag) => (
												<span class="badge badge-sm badge-outline whitespace-nowrap">{tag}</span>
											))}
										</div>
										{item.description && (
											<p class="mt-1 text-sm opacity-70">{item.description}</p>
										)}
									</li>
								))}
							</ul>
						</div>
					</article>
				))}
			</div>
		) : (
			<div class="mt-10">
				<div role="tablist" class="tabs tabs-box mb-8 w-fit">
					{MENU.map((section, i) => (
						<button
							role="tab"
							class={`tab ${i === 0 ? 'tab-active' : ''}`}
							data-tab={section.name}
						>
							{section.name}
						</button>
					))}
				</div>

				{MENU.map((section, i) => (
					<div role="tabpanel" class:list={['tab-panel', { hidden: i !== 0 }]}>
						<h3 class="mb-4 font-display text-xl">
							<i class={`${section.icon} text-primary`} />
							{section.name}
						</h3>
						<ul class="grid gap-4 sm:grid-cols-2">
							{section.items.map((item) => (
								<li class="rounded-box border border-base-300 bg-base-200/40 p-4">
									<div class="flex items-start justify-between gap-3">
										<span class="font-medium">{item.name}</span>
										{item.tags?.map((tag) => (
											<span class="badge badge-sm badge-outline whitespace-nowrap">{tag}</span>
										))}
									</div>
									{item.description && <p class="mt-1 text-sm opacity-70">{item.description}</p>}
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		)
	}

	<div class="mt-10 flex flex-wrap items-center gap-3">
		<a href="/l-oasis-malaga/carta" class="btn btn-primary gap-2">
			<i class="ri-file-list-3-line"></i>
			Ver la carta completa
		</a>
		<a href={BUSINESS.phoneHref} class="btn btn-ghost gap-2">
			<i class="ri-phone-line"></i>
			Preguntar por precios: {BUSINESS.phoneDisplay}
		</a>
	</div>
</section>

{
	!full && (
		<script>
			const tabs = document.querySelectorAll<HTMLButtonElement>('[role="tablist"] .tab');
			const panels = document.querySelectorAll<HTMLElement>('.tab-panel');

			for (const tab of tabs) {
				tab.addEventListener('click', () => {
					const name = tab.dataset.tab;
					for (const other of tabs) other.classList.toggle('tab-active', other === tab);
					for (const panel of panels) panel.hidden = panel.querySelector('h3')?.textContent?.trim() !== name;
				});
			}
		</script>
	)
}
