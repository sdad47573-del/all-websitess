---
import { HALAL } from '../data/site';
---

<section id="halal" class="bg-primary text-primary-content">
	<div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:py-24 lg:grid-cols-[1.2fr_1fr] lg:items-center">
		<div>
			<p class="mb-3 text-sm font-semibold tracking-widest uppercase opacity-75">
				{HALAL.eyebrow}
			</p>
			<h2 class="font-display text-3xl font-semibold sm:text-4xl">{HALAL.title}</h2>
			<p class="mt-5 max-w-xl leading-relaxed opacity-90">{HALAL.text}</p>

			<a href="/l-oasis-malaga/carta" class="btn btn-secondary mt-8 gap-2">
				<i class="ri-file-list-3-line"></i>
				Ver la carta
			</a>
		</div>

		<ul class="grid gap-3 sm:grid-cols-2">
			{
				HALAL.puntos.map((punto) => (
					<li class="flex items-center gap-3 rounded-box bg-white/10 p-4">
						<i class="ri-checkbox-circle-fill text-secondary" />
						<span class="font-medium">{punto}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>
