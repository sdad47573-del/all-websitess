---
import { DESAYUNOS, IMAGES } from '../data/site';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<section id="desayunos" class={`bg-base-200 ${className ?? ''}`}>
	<div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:py-24 lg:grid-cols-2 lg:items-center">
		<div class="order-2 lg:order-1">
			<p class="mb-3 text-sm font-semibold tracking-widest uppercase text-primary">
				{DESAYUNOS.eyebrow}
			</p>
			<h2 class="font-display text-3xl font-semibold sm:text-4xl">{DESAYUNOS.title}</h2>
			<p class="mt-4 max-w-lg leading-relaxed opacity-80">{DESAYUNOS.text}</p>

			<ul class="mt-8 space-y-3">
				{
					DESAYUNOS.items.map((item) => (
						<li class="flex gap-3 rounded-box bg-base-100/70 p-4">
							<i class="ri-arrow-right-line mt-0.5 text-primary" />
							<div>
								<span class="font-semibold">{item.name}</span>
								<span class="text-sm opacity-75"> — {item.text}</span>
							</div>
						</li>
					))
				}
			</ul>

			<p class="mt-6 text-sm italic opacity-60">{DESAYUNOS.nota}</p>
		</div>

		<div class="order-1 lg:order-2">
			<figure class="card overflow-hidden shadow-xl">
				<img
					src={IMAGES.streetview90.src}
					alt="Fachada de L’Oasis, cafetería halal en el Paseo de los Tilos de Málaga"
					class="h-80 w-full object-cover sm:h-96"
					loading="lazy" decoding="async"
				/>
				<figcaption class="card-body bg-base-100 py-4 text-xs opacity-60">
					P.º de los Tilos, 37 · Fotografía: Google Street View
				</figcaption>
			</figure>
		</div>
	</div>
</section>
