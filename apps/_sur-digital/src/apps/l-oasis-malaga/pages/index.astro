---
import Contact from '../components/Contact.astro';
import Desayunos from '../components/Desayunos.astro';
import Fab from '../components/Fab.astro';
import Faq from '../components/Faq.astro';
import Features from '../components/Features.astro';
import Footer from '../components/Footer.astro';
import Gallery from '../components/Gallery.astro';
import Halal from '../components/Halal.astro';
import Hero from '../components/Hero.astro';
import Highlights from '../components/Highlights.astro';
import Menu from '../components/Menu.astro';
import Reviews from '../components/Reviews.astro';
import Specialties from '../components/Specialties.astro';
import Topbar from '../components/Topbar.astro';
import { FAQ_SCHEMA } from '../data/site';
import Layout from '../layouts/Layout.astro';
---

<Layout schema={[FAQ_SCHEMA]}>
	<Topbar />
	<main>
		<Hero />
		<Highlights />
		<Features />
		<Desayunos class="bg-base-200" />
		<Halal />
		<Menu />
		<Specialties />
		<Gallery />
		<Reviews />
		<Faq />
		<Contact />
	</main>
	<Footer />
	<Fab />
</Layout>
