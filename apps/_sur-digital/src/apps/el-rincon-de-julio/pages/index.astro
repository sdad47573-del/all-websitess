---
const business = {
	name: 'El Rincón de Julio',
	street: 'Calle Navas, 27',
	city: 'Granada',
	region: 'Granada',
	postalCode: '18009',
	country: 'ES',
	phone: '+34 615 13 29 30',
	latitude: 37.1737173,
	longitude: -3.5984221,
	site: 'https://www.sur-digital.com/el-rincon-de-julio',
};

const mapsUrl = 'https://www.google.com/maps/place/El+Rinc%C3%B3n+de+Julio/data=!4m7!3m6!1s0xd71fd53fc5cdecf:0x428f206065f158e3!8m2!3d37.1737173!4d-3.5984221!16s%2Fg%2F11nmj999zr!19sChIJz95c_FP9cQ0R41jxZWAgj0I?hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(`${business.name}, ${business.street}, ${business.city}`)}&ll=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34615132930';
const instagramUrl = 'https://www.instagram.com/elrincondejuliogranada/';
const facebookUrl = 'https://www.facebook.com/elrincondejuliogranada/';
const siteUrl = `${business.site}/`;
const description = 'El Rincón de Julio, en la calle Navas de Granada: cocina andaluza, croquetas caseras, pulpo y rabo de toro. Consulta horario, fotos de Google Maps y reserva por teléfono.';

const hours = [
	{ day: 'Lunes', value: '12:30–15:00 · 19:30–22:00' },
	{ day: 'Martes', value: '12:30–15:00 · 19:30–22:00' },
	{ day: 'Miércoles', value: '12:30–15:00 · 19:30–22:00' },
	{ day: 'Jueves', value: '12:30–15:00 · 19:30–22:00' },
	{ day: 'Viernes', value: '12:30–15:00 · 19:30–22:00' },
	{ day: 'Sábado', value: 'Cerrado' },
	{ day: 'Domingo', value: 'Cerrado' },
];

const faqs = [
	{
		question: '¿Dónde está El Rincón de Julio?',
		answer: 'Está en la calle Navas, 27, 18009 Granada, en pleno centro de la ciudad y en una de las calles más conocidas para salir de tapas.',
	},
	{
		question: '¿Cuál es el teléfono para reservar?',
		answer: 'El perfil de Instagram del restaurante publica el teléfono +34 615 13 29 30 para reservas. Puedes llamar y confirmar directamente con el equipo.',
	},
	{
		question: '¿Qué platos son populares en El Rincón de Julio?',
		answer: 'Entre los platos que destacan las guías y reseñas públicas están las croquetas caseras, el pulpo, el rabo de toro y el codillo. Pregunta por la carta y las sugerencias actuales, ya que pueden cambiar.',
	},
	{
		question: '¿Cuál es el horario?',
		answer: 'Los horarios publicados en directorios indican servicio de lunes a viernes de 12:30 a 15:00 y de 19:30 a 22:00, con cierre los sábados y domingos. Los horarios pueden variar: confirma antes de desplazarte.',
	},
	{
		question: '¿Dónde puedo ver fotos del restaurante?',
		answer: 'Abre la ficha de El Rincón de Julio en Google Maps desde esta página para consultar fotos de sus platos y del restaurante publicadas por el local y sus visitantes.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${siteUrl}#restaurant`,
	name: business.name,
	description,
	url: siteUrl,
	telephone: business.phone,
	priceRange: '20–30 €',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Andaluza', 'Española', 'Mediterránea'],
	acceptsReservations: true,
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: business.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [mapsUrl, instagramUrl, facebookUrl],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '12:30',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '19:30',
			closes: '22:00',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

import Galeria from '../components/Galeria.astro';---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#422a22" />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" type="image/svg+xml" href="/el-rincon-de-julio/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" />
		<title>El Rincón de Julio en Granada | Cocina andaluza en Calle Navas</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="El Rincón de Julio · Cocina andaluza en Granada" />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${business.site}/og.svg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="El Rincón de Julio, cocina andaluza en Calle Navas, Granada" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.region" content="ES-GR" />
		<meta name="geo.placename" content="Granada" />
		<meta name="geo.position" content="37.1737173;-3.5984221" />
		<meta name="ICBM" content="37.1737173, -3.5984221" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="El Rincón de Julio, inicio"><span class="brand-mark" aria-hidden="true">J</span><span>El Rincón <small>de Julio · Granada</small></span></a>
			<nav aria-label="Navegación principal"><a href="#cocina">La cocina</a><a href="#fotos">Fotos</a><a href="#horario">Horario</a><a href="#visitanos">Cómo llegar</a></nav>
			<a class="header-call" href={phoneHref}>Reservas · 615 13 29 30</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span>Granada · Calle Navas</span><i aria-hidden="true"></i> Cocina andaluza</p>
					<h1 id="hero-title">Sabores de casa,<br />en el corazón <em>de Granada.</em></h1>
					<p class="lede">En la mítica calle Navas, El Rincón de Julio sirve cocina española de tradición, buen vino y una bienvenida cercana. Un rincón pequeño para sentarse, compartir y disfrutar sin prisa.</p>
					<div class="actions"><a class="button button-gold" href={phoneHref}>Llamar para reservar <span aria-hidden="true">↗</span></a><a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-details"><span>⌖ Calle Navas, 27 · Granada</span><span>✦ Tradición andaluza</span></div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración original de un plato andaluz y una copa de vino en una mesa acogedora">
					<div class="tile tile-one"></div><div class="tile tile-two"></div><div class="tile tile-three"></div><div class="arch"></div><div class="shelf"></div>
					<div class="table"></div><div class="plate"><div class="food"><span class="meat"></span><span class="potato"></span><span class="greens"></span><span class="sauce"></span></div></div>
					<div class="wine-glass"><span></span></div><div class="art-note">Hecho con cariño<br /><b>y sabor de casa</b></div><span class="star star-a">✦</span><span class="star star-b">✧</span>
				</div>
			</section>

			<div class="ticker" aria-label="Especialidades de la casa"><span>Croquetas caseras</span><b>✳</b><span>Pulpo</span><b>✳</b><span>Rabo de toro</span><b>✳</b><span>Cocina andaluza</span><b>✳</b><span>Buen vino</span></div>

			<section class="intro section-wrap" id="cocina"><div><p class="eyebrow eyebrow-dark">Un rincón en la calle Navas</p><h2>Una mesa pequeña.<br /><em>Grandes momentos.</em></h2></div><div class="intro-copy"><p>En pleno centro de Granada, El Rincón de Julio combina recetas tradicionales, ambiente acogedor y trato cercano. Julio recibe a quienes se acercan y recomienda especialidades de la casa para disfrutar de una comida con sabor andaluz.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver reseñas y fotos en Google Maps ↗</a></div></section>

			<section class="specialties section-wrap" aria-labelledby="specialties-title"><div class="section-heading"><p class="eyebrow eyebrow-dark">Recetas con historia</p><h2 id="specialties-title">Un sabor que<br /><em>invita a volver.</em></h2><p>Algunas especialidades destacadas por las guías y reseñas públicas. Consulta en el local la carta y disponibilidad actuales.</p></div>
				<div class="special-grid">
					<article class="special-card special-croquetas"><span class="special-icon" aria-hidden="true">✿</span><span class="card-kicker">PARA EMPEZAR</span><h3>Croquetas caseras</h3><p>Variadas, recién hechas y con receta familiar. Un comienzo muy de casa.</p></article>
					<article class="special-card special-pulpo"><span class="special-icon" aria-hidden="true">≈</span><span class="card-kicker">SABOR DEL MAR</span><h3>Pulpo</h3><p>Una de las recomendaciones más repetidas para disfrutar y compartir.</p></article>
					<article class="special-card special-rabo"><span class="special-icon" aria-hidden="true">♨</span><span class="card-kicker">COCINA LENTA</span><h3>Rabo de toro</h3><p>Tierno y meloso, un clásico andaluz señalado por quienes ya han venido.</p></article>
					<article class="special-card special-codillo"><span class="special-icon" aria-hidden="true">✦</span><span class="card-kicker">DE LA CASA</span><h3>Codillo y guisos</h3><p>Platos reconfortantes de cocina española tradicional, según la carta del día.</p></article>
				</div><p class="menu-note">La oferta puede cambiar según temporada y disponibilidad. Para consultar precios y platos de hoy, llama al restaurante.</p>
			</section>

			<section class="photo-section" id="fotos"><div class="photo-copy"><p class="eyebrow">El Rincón de Julio en Google Maps</p><h2>Un vistazo antes<br />de <em>sentarte.</em></h2><p>Descubre las fotos del restaurante, sus platos y el ambiente en la ficha de Google Maps. Allí también puedes consultar opiniones recientes y confirmar los datos para tu visita.</p><a class="button button-gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a><a class="instagram-link" href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram del restaurante ↗</a></div>
				<div class="map-photo"><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Google Maps: El Rincón de Julio en Calle Navas, Granada" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
					<noscript>
						<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
					</noscript>
				</div><a class="map-caption" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span>⌖</span><span><b>El Rincón de Julio</b><small>Calle Navas, Granada · Ver ficha y fotos ↗</small></span></a></div>
			</section>

			<section class="visit section-wrap" id="visitanos"><div class="visit-copy"><p class="eyebrow eyebrow-dark">En el centro de Granada</p><h2>Nos vemos<br /><em>en Calle Navas.</em></h2><p>Ven a disfrutar de la cocina de Julio en una de las calles de tapas más conocidas de Granada.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button button-dark" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Reservar · 615 13 29 30</a></div></div>
				<div class="hours-card" id="horario"><div class="hours-title"><span class="clock" aria-hidden="true">◷</span><div><p class="eyebrow eyebrow-dark">Planifica tu visita</p><h3>Horario</h3></div></div><dl>{hours.map(({ day, value }) => <div class:list={[{ closed: value === 'Cerrado' }]}><dt>{day}</dt><dd>{value}</dd></div>)}</dl><p class="hours-note">Horario publicado en directorios y sujeto a cambios. Recomendamos llamar para confirmar, especialmente en festivos o fechas especiales.</p></div>
			</section>

			<section class="faq-section section-wrap" id="preguntas"><p class="eyebrow eyebrow-dark">Todo lo que necesitas saber</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
			<Galeria nombre="El Rincón de Julio" mapsUrl={mapsUrl} />
		</main>

		<footer class="footer"><div class="footer-top"><a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">J</span><span>El Rincón <small>de Julio · Granada</small></span></a><p>Cocina de siempre<br />en la calle Navas.</p><nav aria-label="Enlaces del restaurante"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={facebookUrl} target="_blank" rel="noopener noreferrer">Facebook ↗</a><a href={phoneHref}>615 13 29 30</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} El Rincón de Julio · Granada</span><a href="/el-rincon-de-julio/aviso-legal/">Aviso legal y privacidad</a> <a href="/el-rincon-de-julio/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a> · <span>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Sur Digital</a></span> <span>Confirma horario, carta y disponibilidad directamente con el restaurante.</span></div></footer>
		<a class="mobile-call" href={phoneHref}>Reservar <span>615 13 29 30</span></a>
	</body>
</html>

<style is:global>
	:root{font-family:'DM Sans',sans-serif;color:#352b28;background:#faf5eb;font-synthesis:none;text-rendering:optimizeLegibility;--wine:#54251f;--wine2:#71382d;--gold:#d9ad60;--cream:#faf5eb;--ink:#352b28;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid #d9ad60;outline-offset:4px}.skip-link{position:absolute;z-index:99;top:-60px;left:16px;padding:12px 16px;background:var(--gold);color:var(--wine)}.skip-link:focus{top:12px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:22px;background:#422a22;color:#fbf6ed}.brand{display:flex;align-items:center;gap:11px;font-size:15px;font-weight:700}.brand small{display:block;margin-top:4px;color:#e1cfc0;font-size:9px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--gold);border-radius:50%;color:#e5c784;font:700 23px var(--display)}.topbar nav{display:flex;gap:clamp(14px,2.5vw,32px);color:#f0e6d8;font-size:12px}.topbar nav a:hover,.footer a:hover{color:#e5c784}.header-call{padding:11px 17px;border:1px solid #ffffff50;border-radius:99px;font-size:11px;font-weight:700}.hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:560px;background:#422a22;color:#fbf6ed;overflow:hidden}.hero-copy{padding:73px 4vw 64px 9vw;align-self:center}.eyebrow{margin:0 0 19px;color:#ddc796;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase}.eyebrow i{display:inline-block;width:22px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.section-heading h2,.photo-copy h2,.visit h2,.faq-section h2{margin:0;font:600 clamp(39px,4.8vw,64px)/1.08 var(--display);letter-spacing:-1.2px}.hero h1 em,.intro h2 em,.section-heading h2 em,.photo-copy h2 em,.visit h2 em,.faq-secti