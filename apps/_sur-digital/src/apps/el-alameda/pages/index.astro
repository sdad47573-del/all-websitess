---
import { Image } from 'astro:assets';
import '../styles/global.css';
import { BUSINESS, FAQ, FICHA, HIGHLIGHTS, HOURS, MAPS, RATING, SERVICIOS } from '../data/site';

import interior from '../assets/fotos/el-alameda-vertical-01.jpg';
import preparando from '../assets/fotos/el-alameda-apaisada-07.jpg';
import felipada from '../assets/fotos/el-alameda-apaisada-03.jpg';
import felipadaVino from '../assets/fotos/el-alameda-apaisada-04.jpg';
import pintxos from '../assets/fotos/el-alameda-panoramica-08.jpg';
import pulpo from '../assets/fotos/el-alameda-vertical-02.jpg';
import chuleta from '../assets/fotos/el-alameda-vertical-10.jpg';

const title = `${BUSINESS.name} · Bar en Abando, ${BUSINESS.city}`;
const description = BUSINESS.description;
const year = new Date().getFullYear();

const nav = [
  { label: 'La casa', href: '#casa' },
  { label: 'La ficha', href: '#ficha' },
  { label: 'Fotos', href: '#fotos' },
  { label: 'Dónde está', href: '#visitanos' },
  { label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${BUSINESS.siteUrl}/`} />
    <meta name="theme-color" content="#123c36" />
    <link rel="icon" href="/el-alameda/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Mulish:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BarOrPub",
        "@id": "https://www.sur-digital.com/el-alameda/#negocio",
        "name": "El Alameda",
        "url": "https://www.sur-digital.com/el-alameda/",
        "description": "El Alameda, bar en Urkixo Zumarkalea, 40 (Abando, 48011 Bilbao, Bizkaia). Clásico bar popular con barra de pintxos y cocina casera conocido por sándwiches, según su ficha de Google Maps.",
        "image": "https://www.sur-digital.com/el-alameda/og.jpg",
        "telephone": "+34944435008",
        "priceRange": "1–10 €",
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 43.2605019,
          "longitude": -2.9378471
        },
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Urkixo Zumarkalea, 40",
          "addressLocality": "Bilbao",
          "addressRegion": "Bizkaia",
          "postalCode": "48011",
          "addressCountry": "ES"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": 4.3,
          "reviewCount": 600,
          "bestRating": 5,
          "worstRating": 1
        },
        "servesCuisine": "Pintxos, sándwiches y cocina casera",
        "hasMap": "https://www.google.com/maps/place/El+Alameda/@43.2605019,-2.9378471,16z/data=!3m1!4b1!4m6!3m5!1s0xd4e50282aac27b1:0x843c6130bcf8449!8m2!3d43.2605019!4d-2.9378471!16s%2Fg%2F1v_ndtsg",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday"],
            "opens": "10:00",
            "closes": "22:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": "Friday",
            "opens": "10:00",
            "closes": "22:30"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": "Saturday",
            "opens": "11:00",
            "closes": "22:30"
          }
        ]
      }
    </script>
    <meta property="og:image" content="https://www.sur-digital.com/el-alameda/og.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:url" content="https://www.sur-digital.com/el-alameda/" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="topbar">
      <div class="topbar-inner wrap">
        <a class="brand" href="#inicio" aria-label={`${BUSINESS.name}, inicio`}>
          <span class="brand-mark" aria-hidden="true">{BUSINESS.mark}</span>
          <span class="brand-name">
            El Alameda
            <small>Bar · Pintxos · Abando</small>
          </span>
        </a>
        <nav aria-label="Navegación principal">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <a class="topbar-phone" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
      </div>
    </header>

    <main id="contenido">
      <section class="hero wrap" id="inicio" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span aria-hidden="true"></span> Urkixo Zumarkalea, 40 · Abando · Bilbao</p>
          <h1 id="hero-title">Pintxos y sándwiches <em>de toda la vida.</em></h1>
          <p class="hero-lede">
            El Alameda es un bar de barra en pleno Abando, a un paso de la plaza Bizkaia y de
            Azkuna Zentroa. Conocido por sus sándwiches —la felipada delante—, por la ensaladilla y
            por una cocina casera que la ficha de Google resume en una frase: clásico bar popular.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href={BUSINESS.phoneHref}>
              Llamar · {BUSINESS.phone}
            </a>
            <a class="button button-ghost" href={MAPS.directions} target="_blank" rel="noreferrer">
              Cómo llegar <span aria-hidden="true">↗</span>
            </a>
          </div>
          <ul class="hero-facts">
            <li><b>{RATING.label}</b> sobre 5 · {RATING.count} reseñas</li>
            <li><b>1–10 €</b> precio medio publicado</li>
            <li><b>10:00–22:00</b> lunes a jueves</li>
          </ul>
        </div>

        <figure class="hero-photo">
          <Image
            src={interior}
            alt="Interior de El Alameda: paredes azules, barra de acero y taburetes rojos"
            widths={[480, 720, 1024]}
            sizes="(max-width: 900px) 92vw, 46vw"
            format="webp"
            quality={74}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>
            <span>Foto del perfil de Google</span>
            <a href={MAPS.place} target="_blank" rel="noreferrer">Ver la ficha ↗</a>
          </figcaption>
        </figure>
      </section>

      <section class="wrap" aria-label="Lo que publica la ficha de Google">
        <ul class="chips">
          {SERVICIOS.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="about" id="casa" aria-labelledby="about-title">
        <div class="wrap">
          <div class="about-grid">
            <h2 id="about-title">La barra azul <em>de Abando.</em></h2>
            <div class="about-copy">
              <p>
                Paredes azules, lámparas amarillas y una barra de acero con taburetes rojos. El
                Alameda ocupa el número 40 de Urkixo Zumarkalea, en el barrio de Abando, y lleva
                años siendo parada de pintxo rápido y sándwich de los que se piden de pie.
              </p>
              <p>
                La ficha pública de Google lo clasifica como «bar», le da un {RATING.label} sobre 5
                con {RATING.count} reseñas y un precio medio de 1 a 10 €. Ahí están también el
                teléfono, el horario y los servicios: comer dentro, para llevar y reparto.
              </p>
              <p>
                Bilbao Turismo destaca cuatro cosas de la casa: la felipada, la anchoa rellena de
                calabacín con cebolla pochada, la ensaladilla rusa y el «bilbainito». El resto —la
                barra, los pintxos, el pulpo, la carne— se ve en las fotos de esta página.
              </p>
              <p class="about-note">
                Esta web no es la web oficial del local y no tiene carta con precios. Para saber qué
                hay hoy o cuánto cuesta, lo más directo es llamar al
                <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>.
              </p>
              <div class="about-links">
                <a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
                  Ficha en Google Maps <span aria-hidden="true">↗</span>
                </a>
                <a class="simple-link" href="#ficha">Ver lo que publica la ficha</a>
              </div>
            </div>
          </div>

          <ul class="highlights">
            {
              HIGHLIGHTS.map((item, index) => (
                <li class={index === HIGHLIGHTS.length - 1 ? 'highlight-wide' : undefined}>
                  <span class="highlight-mark">{String(index + 1).padStart(2, '0')}</span>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="menu" id="ficha" aria-labelledby="ficha-title">
        <div class="wrap">
          <div class="menu-head">
            <div>
              <p class="section-label"><span aria-hidden="true"></span> La ficha</p>
              <h2 id="ficha-title">Lo que Google <em>publica del local.</em></h2>
            </div>
            <div>
              <p>
                Los datos de la ficha pública, sin añadidos: categoría, nota, precio medio,
                servicios y horario. El resto se pregunta en la barra.
              </p>
              <a class="button button-primary" href={MAPS.place} target="_blank" rel="noreferrer">
                Ver la ficha en Google <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <div class="menu-groups">
            <div class="menu-group">
              <h3>Datos publicados</h3>
              <ul class="dishes">
                {
                  FICHA.map((item) => (
                    <li>
                      <span class="dish">
                        {item.label}
                        <em>{item.value}</em>
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="menu-group">
              <h3>Contacto y mapa</h3>
              <ul class="dishes">
                <li>
                  <span class="dish">
                    Teléfono
                    <em><a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>, el que publica la ficha</em>
                  </span>
                </li>
                <li>
                  <span class="dish">
                    Dirección
                    <em>Urkixo Zumarkalea, 40 · 48011 Bilbao</em>
                  </span>
                </li>
                <li>
                  <span class="dish">
                    Cómo llegar
                    <em><a href={MAPS.directions} target="_blank" rel="noreferrer">Ruta en Google Maps ↗</a></em>
                  </span>
                </li>
                <li>
                  <span class="dish">
                    Ficha del local
                    <em><a href={MAPS.place} target="_blank" rel="noreferrer">El Alameda en Google Maps ↗</a></em>
                  </span>
                </li>
              </ul>
            </div>
          </div>

          <p class="menu-note">
            Sin carta y sin precios en esta página: si necesitas saber qué hay hoy, llama al
            <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>.
          </p>
        </div>
      </section>

      <section class="rating-section" id="opiniones" aria-labelledby="rating-title">
        <div class="wrap rating-grid">
          <div class="rating-copy">
            <p class="section-label"><span aria-hidden="true"></span> Opiniones</p>
            <h2 id="rating-title">Cuatro y tres <em>en la ficha.</em></h2>
            <p>
              Es la valoración media que publica Google Maps para El Alameda al consultarla
              (noviembre de 2026), con unas {RATING.count} reseñas. Esta página no reproduce
              reseñas de terceros: para leerlas todas, abre la ficha del local.
            </p>
          </div>
          <div class="rating-badge">
            <strong>{RATING.label}</strong>
            <span aria-hidden="true">★★★★☆</span>
            <small>Valoración en la ficha de Google · sobre 5</small>
          </div>
        </div>
      </section>

      <section class="section-pad" id="fotos" aria-labelledby="fotos-title">
        <div class="wrap">
          <div class="gallery-head">
            <div>
              <p class="section-label"><span aria-hidden="true"></span> Fotos del perfil</p>
              <h2 id="fotos-title">La barra y lo que sale <em>de ella.</em></h2>
            </div>
            <p>
              Imágenes del perfil público de El Alameda en Google Maps: el interior, la preparación
              de los sándwiches, la felipada, los pintxos y algún plato de la casa.
            </p>
          </div>
          <div class="gallery-grid">
            <figure class="shot">
              <Image
                src={preparando}
                alt="Camarero con pajarita preparando sándwiches en la barra de El Alameda"
                widths={[640, 960, 1280]}
                sizes="(max-width: 900px) 92vw, 72rem"
                format="webp"
                quality={70}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <figure class="shot">
              <Image
                src={felipada}
                alt="La felipada de El Alameda, sándwich de anchoa y lechuga, servida en un plato"
                widths={[320, 480, 640]}
                sizes="(max-width: 900px) 46vw, 24vw"
                format="webp"
                quality={68}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <figure class="shot">
              <Image
                src={felipadaVino}
                alt="Sándwich de la casa con una copa de vino blanco en la mesa"
                widths={[320, 480, 640]}
                sizes="(max-width: 900px) 46vw, 24vw"
                format="webp"
                quality={68}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <figure class="shot">
              <Image
                src={pintxos}
                alt="Bandeja de pintxos de ensaladilla con aceitunas en la barra"
                widths={[320, 480, 640]}
                sizes="(max-width: 900px) 46vw, 24vw"
                format="webp"
                quality={68}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <figure class="shot">
              <Image
                src={pulpo}
                alt="Pulpo con patata y pimentón servido en un plato"
                widths={[640, 960, 1280]}
                sizes="(max-width: 900px) 92vw, 48vw"
                format="webp"
                quality={68}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <figure class="shot">
              <Image
                src={chuleta}
                alt="Chuleta a la parrilla en un plato, lista para servir"
                widths={[320, 480, 640]}
                sizes="(max-width: 900px) 46vw, 24vw"
                format="webp"
                quality={68}
                loading="lazy"
                decoding="async"
              />
            </figure>
          </div>
          <p class="gallery-note">
            Imágenes alojadas en esta página y tomadas del perfil del establecimiento en Google
            Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos.
          </p>
        </div>
      </section>

      <section class="visit" id="visitanos" aria-labelledby="visit-title">
        <div class="wrap visit-grid">
          <div class="visit-copy">
            <p class="section-label section-label-light"><span aria-hidden="true"></span> Dónde está</p>
            <h2 id="visit-title">En Urkixo Zumarkalea, <em>40.</em></h2>
            <p class="address">
              {BUSINESS.street}<br />
              {BUSINESS.postalCode} {BUSINESS.city}<br />
              {BUSINESS.region}
            </p>
            <table class="hours">
              <caption>Horario publicado</caption>
              <tbody>
                {
                  HOURS.map((item) => (
                    <tr>
                      <th scope="row">{item.day}</th>
                      <td>{item.value}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <p class="hours-note">
              Horario que publica la ficha de Google en noviembre de 2026; puede cambiar en
              festivos. El teléfono es el del local: esta página no tramita reservas ni pedidos.
            </p>
            <a class="phone-link" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
            <div class="visit-links">
              <a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
                Cómo llegar <span aria-hidden="true">↗</span>
              </a>
              <a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
                Ficha en Google Maps <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <div class="map-frame">
            <iframe
              title={`Mapa de ${BUSINESS.name} en ${BUSINESS.street}, ${BUSINESS.city}`}
              src={MAPS.embed}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen></iframe>
            <a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
              <span aria-hidden="true">⌖</span> {BUSINESS.street}
            </a>
          </div>
        </div>
      </section>

      <section class="faq section-pad" id="preguntas" aria-labelledby="faq-title">
        <div class="wrap">
          <p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
          <h2 id="faq-title">Antes de <em>venir.</em></h2>
          <div class="faq-list">
            {
              FAQ.map((item) => (
                <details>
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <span class="brand-mark" aria-hidden="true">{BUSINESS.mark}</span>
            <p>
              {BUSINESS.name}
              <small>
                Bar · Pintxos y cocina casera<br />
                {BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}
              </small>
            </p>
          </div>
          <nav aria-label="Enlaces del establecimiento">
            <a href={BUSINESS.phoneHref}>Llamar</a>
            <a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
            <a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
            <a href="/el-alameda/aviso-legal">Aviso legal</a>
          </nav>
        </div>
        <small class="legal">
          © {year}
          {BUSINESS.name} · Datos de la ficha pública de Google Maps, consultada en noviembre de
          2026. Las fotografías proceden del mismo perfil.
        </small>
        <nav class="legal-links" aria-label="Información legal">
          <a href="/el-alameda/aviso-legal">Aviso legal</a>
          <a href="/el-alameda/aviso-legal#privacidad">Privacidad</a>
          <a href="/el-alameda/aviso-legal#cookies">Cookies</a>
        </nav>
        <p class="credit">
          Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a>
        </p>
      </div>
    </footer>

    <a class="mobile-call" href={BUSINESS.phoneHref}>Llamar <span>{BUSINESS.phone}</span></a>
  </body>
</html>
