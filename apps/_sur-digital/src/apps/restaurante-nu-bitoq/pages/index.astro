---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/restaurante-nu-bitoq-vertical-01.jpg';
import panela from '../assets/fotos/restaurante-nu-bitoq-apaisada-07.jpg';
import mesa from '../assets/fotos/restaurante-nu-bitoq-apaisada-06.jpg';
import cocktails from '../assets/fotos/restaurante-nu-bitoq-apaisada-10.jpg';
import picanha from '../assets/fotos/restaurante-nu-bitoq-cuadrada-03.jpg';
import cerveja from '../assets/fotos/restaurante-nu-bitoq-cuadrada-04.jpg';
import closeup from '../assets/fotos/restaurante-nu-bitoq-vertical-02.jpg';
import portobello from '../assets/fotos/restaurante-nu-bitoq-vertical-05.jpg';
import morango from '../assets/fotos/restaurante-nu-bitoq-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	PASSOS,
	REVIEWS,
	SERVICOS,
} from '../data/site';

const title = 'Nu Bitoq · bitoques em Amora, Seixal';
const description =
	'Restaurante de especialidade em bitoques em Amora, Seixal: treze versões em frigideira, entradas e cocktails. Praceta 5 de Outubro, 9. Reservas pelo 934 718 760.';

const galeria = [
	{
		src: panela,
		alt: 'Bitoque numa frigideira de inox com batata frita e ovo estrelado, numa mesa de esplanada',
	},
	{
		src: closeup,
		alt: 'Bitoque com presunto, ovo estrelado, batata frita e molho cremoso visto de perto',
	},
	{
		src: morango,
		alt: 'Cocktail de morango com hortelã e um cesto de pão ao lado, sobre a toalha',
	},
	{
		src: mesa,
		alt: 'Mesa posta com cesto de pão, dois cocktails verdes e um prato com pão barrado',
	},
	{
		src: cerveja,
		alt: 'Bitoque com batata frita, ovo e arroz numa frigideira, com uma cerveja ao lado',
	},
	{
		src: picanha,
		alt: 'Carne fatiada com ovo estrelado, batata em rodelas e molho verde na frigideira',
	},
	{
		src: portobello,
		alt: 'Cogumelo portobello com ovo e molho cremoso, acompanhado de batata-doce frita',
	},
	{
		src: cocktails,
		alt: 'Três cocktails em copos altos com lima e canudos, na esplanada à noite',
	},
];

const dayNames = [
	'Monday',
	'Tuesday',
	'Wednesday',
	'Thursday',
	'Friday',
	'Saturday',
	'Sunday',
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#nu-bitoq`,
	name: BUSINESS.name,
	alternateName: ['Nu Bitoq Amora', 'RESTAURANTE NU BITOQ', 'Nu Bitoque'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 934 718 760',
	priceRange: '15–25 €',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Bitoques', 'Cozinha portuguesa', 'Cozinha de autor'],
	acceptsReservations: BUSINESS.phoneHref,
	areaServed: [
		{ '@type': 'City', name: 'Amora' },
		{ '@type': 'City', name: 'Seixal' },
		{ '@type': 'AdministrativeArea', name: 'Distrito de Setúbal' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: dayNames.slice(1),
			opens: '12:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '19:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Lugares para pessoas em cadeiras de rodas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-nu-bitoq-vertical-01.jpg": fachada,
	"restaurante-nu-bitoq-apaisada-07.jpg": panela,
	"restaurante-nu-bitoq-vertical-02.jpg": closeup,
	"restaurante-nu-bitoq-vertical-09.jpg": morango,
	"restaurante-nu-bitoq-apaisada-06.jpg": mesa,
	"restaurante-nu-bitoq-cuadrada-04.jpg": cerveja,
	"restaurante-nu-bitoq-cuadrada-03.jpg": picanha,
	"restaurante-nu-bitoq-vertical-05.jpg": portobello,
	"restaurante-nu-bitoq-apaisada-10.jpg": cocktails,
};
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#141311" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Nu Bitoq, Nu Bitoq Amora, restaurante Amora, bitoques Amora, bitoque Seixal, restaurante Seixal, bitoque de alcatra, comer em Amora, Praceta 5 de Outubro"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Treze bitoques em frigideira, entradas e cocktails na Praceta 5 de Outubro, 9 · Amora. Reservas pelo 934 718 760."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada do Nu Bitoq à noite, com o letreiro iluminado sobre a porta e plantas às portas"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#141311"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-15"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Amora"
			locale="pt_PT"
			countryName="Portugal"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/restaurante-nu-bitoq/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Nu Bitoq"
			subtitle="Bitoques · Amora"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
				reviews={REVIEWS}
				googleMaps={MAPS.place}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Como chegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Informação elaborada a partir de fontes públicas; confirma horário, carta e preços antes da visita."
			ctaLabel="Ligar ao Nu Bitoq"
			navAriaLabel="Ligações do Nu Bitoq"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/351934718760?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Amora." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Amora"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
