---
/**
 * Adaptador: la sección vive en `LocalServicios` (@astro-components); aquí
 * solo se conecta con los datos de esta web.
 */
import { LocalServicios } from '@astro-components';
import { BUSINESS, SERVICIOS, VENTAJAS } from '../data/site';
---

<LocalServicios
	items={SERVICIOS}
	advantages={VENTAJAS}
	business={{ name: BUSINESS.name, city: BUSINESS.city, googleMaps: BUSINESS.googleMaps }}
/>
