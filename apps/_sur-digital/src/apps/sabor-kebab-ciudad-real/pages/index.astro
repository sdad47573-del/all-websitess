---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import durumPlato from '../assets/fotos/sabor-kebab-ciudad-real-apaisada-03.jpg';
import pinchos from '../assets/fotos/sabor-kebab-ciudad-real-apaisada-04.jpg';
import barra from '../assets/fotos/sabor-kebab-ciudad-real-vertical-01.jpg';
import pinchosCercanos from '../assets/fotos/sabor-kebab-ciudad-real-vertical-02.jpg';
import guiso from '../assets/fotos/sabor-kebab-ciudad-real-vertical-05.jpg';
import bandejaCarne from '../assets/fotos/sabor-kebab-ciudad-real-vertical-06.jpg';
import durumPlancha from '../assets/fotos/sabor-kebab-ciudad-real-vertical-07.jpg';
import comedor from '../assets/fotos/sabor-kebab-ciudad-real-vertical-08.jpg';
import fachadaNoche from '../assets/fotos/sabor-kebab-ciudad-real-vertical-09.jpg';
import fachadaDia from '../assets/fotos/sabor-kebab-ciudad-real-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Sabor Kebab Ciudad Real · dürüm, kebab y combos en el centro';
const description = BUSINESS.description;

const galeria = [
	{
		src: durumPlancha,
		alt: 'Dürüm marcado en la plancha sobre una bandeja, con patatas fritas, lechuga, tomate y pepinillos',
	},
	{
		src: pinchosCercanos,
		alt: 'Los dos pinchos de kebab girando en la máquina, con bandejas de lechuga y tomate en primer plano',
	},
	{
		src: pinchos,
		alt: 'Pinchos de pollo y de carne en el asador vertical del local, junto a la plancha',
	},
	{
		src: barra,
		alt: 'Barra del local con taburetes altos, la máquina de kebab y las campanas de la cocina al fondo',
	},
	{
		src: guiso,
		alt: 'Plato de carne turca guisada con tomate, pimiento verde y especias, con ensalada al lado',
	},
	{
		src: bandejaCarne,
		alt: 'Bandeja de carne especiada con cebolla en aros y caldo, recién hecha',
	},
	{
		src: comedor,
		alt: 'Comedor del local con mesas negras, sillones blancos y el mural de fotos de comida',
	},
	{
		src: fachadaNoche,
		alt: 'Rótulo luminoso de Sabor Kebab en la fachada, de noche, con el teléfono de pedidos',
	},
	{
		src: fachadaDia,
		alt: 'Fachada de día con el cartel de Sabor Kebab, el póster de la carta y el cartel de ofertas con precios',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#sabor-kebab-ciudad-real`,
	name: BUSINESS.name,
	alternateName: ['Sabor Kebab', 'Kebab Sabor Ciudad Real', 'Sabor Kebab Corazón de María'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Turca', 'Kebab', 'Dürüm'],
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.channel },
	],
	priceRange: '€',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '01:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"sabor-kebab-ciudad-real-apaisada-03.jpg": durumPlato,
	"sabor-kebab-ciudad-real-vertical-07.jpg": durumPlancha,
	"sabor-kebab-ciudad-real-vertical-02.jpg": pinchosCercanos,
	"sabor-kebab-ciudad-real-apaisada-04.jpg": pinchos,
	"sabor-kebab-ciudad-real-vertical-01.jpg": barra,
	"sabor-kebab-ciudad-real-vertical-05.jpg": guiso,
	"sabor-kebab-ciudad-real-vertical-06.jpg": bandejaCarne,
	"sabor-kebab-ciudad-real-vertical-08.jpg": comedor,
	"sabor-kebab-ciudad-real-vertical-09.jpg": fachadaNoche,
	"sabor-kebab-ciudad-real-vertical-10.jpg": fachadaDia,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17130f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Sabor Kebab Ciudad Real, kebab Ciudad Real centro, dürüm Ciudad Real, restaurante turco Ciudad Real, Corazón de María 3, kebab hasta la 1:00, combos kebab Ciudad Real, kebab 13003"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Dürums, kebab y combos con patatas y bebida en la calle Corazón de María, 3, de Ciudad Real. De 13:00 a 1:00 todos los días. 3,4 sobre 5 con 128 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Dürüm de Sabor Kebab Ciudad Real con patatas y verduras"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#17130f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[durumPlato]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/sabor-kebab-ciudad-real/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Dürüm · kebab · combos"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Precios del cartel de la fachada; pueden cambiar. Confirma carta y horario antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Sabor Kebab Ciudad Real"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://www.sur-digital.com/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34926093934?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Ciudad%20Real." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Ciudad Real"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
