---
import { HIGHLIGHTS } from '../data/site';
---

<section class="relative z-10 -mt-9 px-4 sm:px-6 lg:px-8">
	<div
		class="border-base-300 bg-base-100 mx-auto grid max-w-6xl overflow-hidden rounded-2xl border shadow-xl sm:grid-cols-2 lg:grid-cols-4"
	>
		{
			HIGHLIGHTS.map((item) => (
				<div class="border-base-200 flex gap-3 border-b p-5 last:border-b-0 sm:border-r sm:[&:nth-child(2)]:border-r-0 lg:border-b-0 lg:[&:nth-child(2)]:border-r lg:last:border-r-0">
					<span class="bg-secondary/10 text-secondary flex size-10 shrink-0 items-center justify-center rounded-full">
						<i class={`${item.icon} text-lg`} />
					</span>
					<div>
						<h2 class="text-sm font-bold">{item.title}</h2>
						<p class="text-base-content/65 mt-1 text-xs leading-relaxed">{item.text}</p>
					</div>
				</div>
			))
		}
	</div>
</section>
