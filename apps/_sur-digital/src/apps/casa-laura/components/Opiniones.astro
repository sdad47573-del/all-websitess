---
import { BUSINESS, REVIEWS } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
const media = Math.floor(BUSINESS.rating * 2) / 2;
---

<section id="opiniones" class="trama-casa bg-base-200 border-base-300 border-y py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-8 lg:grid-cols-[0.78fr_1.22fr] lg:gap-12">
			<div class="bg-primary text-primary-content relative overflow-hidden rounded-2xl p-7 sm:p-9">
				<div
					class="pointer-events-none absolute -right-16 -bottom-20 size-56 rounded-full border border-white/10"
					aria-hidden="true"
				></div>
				<p class="text-accent text-xs font-semibold tracking-[0.22em] uppercase">Opiniones</p>
				<h2 class="font-display mt-3 text-3xl leading-tight font-normal sm:text-4xl">
					La valoración de la casa
				</h2>

				<div class="mt-8 flex items-end gap-4">
					<span class="font-display text-7xl leading-none font-semibold">
						{BUSINESS.rating.toString().replace('.', ',')}
					</span>
					<div class="pb-1">
						<div class="text-accent text-lg tracking-tight" aria-hidden="true">
							{
								estrellas.map((n) => (
									<i
										class={
											n <= media
												? 'ri-star-fill'
												: n - media === 0.5
													? 'ri-star-half-fill'
													: 'ri-star-line'
										}
									/>
								))
							}
						</div>
						<p class="mt-1 text-xs text-white/60">
							{BUSINESS.reviewCount.toLocaleString('es-ES')} reseñas en Google Maps
						</p>
					</div>
				</div>

				<p class="mt-6 text-sm leading-relaxed text-white/70">
					Lo que más se repite cuando se habla de Casa Laura: el pulpo roquero, la brasa y
					la comida casera de todos los días.
				</p>

				<a
					href={BUSINESS.googleMaps}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-accent btn-sm mt-7 w-full gap-2 rounded-full"
				>
					<i class="ri-google-fill"></i> Leer las reseñas en Google
				</a>

				<div class="mt-8 border-t border-white/15 pt-6">
					<p class="text-[0.65rem] font-semibold tracking-[0.2em] text-white/45 uppercase">
						Para venir
					</p>
					<ul class="mt-4 space-y-3 text-sm text-white/75">
						<li class="flex gap-2">
							<i class="ri-time-line text-accent mt-0.5"></i>
							<span>Abre a las 8:00 · lunes y domingos hasta las 17:00</span>
						</li>
						<li class="flex gap-2">
							<i class="ri-phone-line text-accent mt-0.5"></i>
							<a href={BUSINESS.phoneHref} class="transition-colors hover:text-white">
								{BUSINESS.phone}
							</a>
						</li>
						<li class="flex gap-2">
							<i class="ri-map-pin-line text-accent mt-0.5"></i>
							<span>{BUSINESS.street}<br />{BUSINESS.postalCode} {BUSINESS.city}</span>
						</li>
					</ul>
				</div>
			</div>

			<div>
				<div class="flex flex-col gap-4">
					{
						REVIEWS.map((resena, index) => (
							<article class="border-base-300 bg-base-100 rounded-2xl border p-6">
								<div class="flex items-start gap-4">
									<span class="font-display text-secondary/30 text-4xl leading-none font-semibold">
										{String(index + 1).padStart(2, '0')}
									</span>
									<div>
										<h3 class="font-display text-xl font-semibold">{resena.title}</h3>
										<p class="text-base-content/70 mt-2 text-sm leading-relaxed">
											{resena.text}
										</p>
										<p class="text-base-content/45 mt-3 flex items-center gap-2 text-[0.65rem]">
											<i class="ri-google-fill" aria-hidden="true"></i>
											{resena.author}
										</p>
									</div>
								</div>
							</article>
						))
					}
				</div>
				<p class="text-base-content/45 mt-4 text-xs leading-relaxed">
					Resumen elaborado a partir de opiniones públicas de Google y de la información
					gastronómica publicada sobre la casa. No son citas literales. Valoración de
					octubre de 2026.
				</p>
			</div>
		</div>
	</div>
</section>
