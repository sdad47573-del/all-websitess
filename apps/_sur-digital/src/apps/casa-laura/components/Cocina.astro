---
import { Image } from 'astro:assets';
import { BUSINESS, IMAGES, PLATOS, VENTAJAS } from '../data/site';
---

<section id="cocina" class="bg-primary text-primary-content py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
			<div>
				<p class="text-accent text-xs font-semibold tracking-[0.22em] uppercase">La mesa</p>
				<h2
					class="font-display mt-3 text-3xl leading-[1.05] font-normal tracking-tight sm:text-4xl lg:text-5xl"
				>
					Lo que sale de la <span class="text-accent italic">cocina</span>
				</h2>
				<p class="mt-4 max-w-xl leading-relaxed text-white/70">
					Brasa, guisos y tapas de siempre. Lo que más se repite en las reseñas y lo que
					mejor cuenta lo que es esta casa.
				</p>
			</div>
			<a href={BUSINESS.phoneHref} class="btn btn-accent shrink-0 gap-2 rounded-full">
				<i class="ri-phone-line"></i> Preguntar por el menú
			</a>
		</div>

		<div class="mt-12 grid gap-6 lg:grid-cols-[0.82fr_1.18fr] lg:gap-8">
			<div class="relative">
				<div class="grid grid-cols-5 gap-4">
					<div class="arco-casa col-span-3 overflow-hidden shadow-2xl">
						<Image
							src={IMAGES.fotoPulpo}
							alt="Pulpo roquero a la brasa con patata y pimentón"
							widths={[320, 520, 760]}
							sizes="(min-width: 1024px) 24vw, 52vw"
							quality={82}
							loading="lazy"
							class="foto-calida aspect-[3/4] h-full w-full object-cover"
						/>
					</div>
					<div class="col-span-2 flex flex-col gap-4">
						<div class="overflow-hidden rounded-2xl shadow-xl">
							<Image
								src={IMAGES.fotoBrasa}
								alt="Pollo y carne a la brasa de Casa Laura"
								widths={[220, 380, 520]}
								sizes="(min-width: 1024px) 16vw, 36vw"
								quality={82}
								loading="lazy"
								class="foto-calida aspect-square w-full object-cover"
							/>
						</div>
						<div
							class="bg-accent text-accent-content flex flex-1 flex-col justify-center rounded-2xl px-4 py-5 text-center"
						>
							<i class="ri-fire-line text-3xl" aria-hidden="true"></i>
							<p class="font-display mt-2 text-xl leading-none font-semibold">A la brasa</p>
							<p class="mt-2 text-[0.65rem] leading-snug font-semibold tracking-[0.1em] uppercase">
								pollo · cordero<br />chuletas
							</p>
						</div>
					</div>
				</div>

				<div
					class="mt-4 flex flex-wrap items-center gap-3 rounded-2xl border border-white/15 bg-white/5 px-4 py-3 text-xs text-white/70"
				>
					<i class="ri-information-line text-accent text-base"></i>
					La carta cambia. El menú del día y los precios se consultan en el local o por
					teléfono.
				</div>
			</div>

			<div class="bg-base-100 text-base-content rounded-2xl p-6 shadow-2xl sm:p-8">
				<div class="flex items-center justify-between gap-4 border-b border-base-300 pb-5">
					<div>
						<p class="text-secondary text-[0.65rem] font-bold tracking-[0.2em] uppercase">
							Especialidades
						</p>
						<h3 class="font-display mt-1 text-2xl font-semibold">De la barra a la mesa</h3>
					</div>
					<span class="font-display text-base-300 hidden text-4xl leading-none font-semibold sm:block">
						6
					</span>
				</div>

				<ul class="divide-base-200 divide-y">
					{
						PLATOS.map((plato) => (
							<li class="flex gap-4 py-4 first:pt-5 last:pb-0">
								<span class="bg-secondary/10 text-secondary mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-full">
									<i class={`${plato.icon} text-lg`} />
								</span>
								<div>
									<h4 class="font-display text-lg leading-tight font-semibold">{plato.title}</h4>
									<p class="text-base-content/65 mt-1 text-sm leading-relaxed">{plato.text}</p>
								</div>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="mt-10 flex flex-wrap gap-2 border-t border-white/15 pt-8">
			{
				VENTAJAS.map((v) => (
					<span class="badge gap-1.5 rounded-full border-white/20 bg-white/5 px-3 py-3 text-xs text-white">
						<i class={`${v.icon} text-accent`} /> {v.title}
					</span>
				))
			}
		</div>
	</div>
</section>
