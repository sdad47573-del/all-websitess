---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import fachada from '../assets/fotos/panaderia-confiteria-lochi-vertical-03.jpg';
import entrada from '../assets/fotos/panaderia-confiteria-lochi-vertical-02.jpg';
import vitrina from '../assets/fotos/panaderia-confiteria-lochi-apaisada-04.jpg';
import donutsCereza from '../assets/fotos/panaderia-confiteria-lochi-vertical-08.jpg';
import donutsAzucar from '../assets/fotos/panaderia-confiteria-lochi-panoramica-05.jpg';
import bolsas from '../assets/fotos/panaderia-confiteria-lochi-panoramica-06.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, MAPS, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Panadería Confitería Lochi · Av. de Carlos Haya (Málaga)';
const description =
	'Panadería Confitería Lochi en la avenida de Carlos Haya (Cruz de Humilladero, 29010 Málaga). Donuts, bollería y tartas, de lunes a domingo de 8:00 a 14:30. Teléfono 952 39 16 41.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#lochi-avenida`,
	name: BUSINESS.name,
	alternateName: ['Lochi', 'Panadería Confitería Lochi Málaga', 'Confitería Lochi Carlos Haya'],
	description:
		'Panadería y confitería en la avenida de Carlos Haya, Cruz de Humilladero (29010 Málaga). Bollería, donuts y tartas, de 8:00 a 14:30 todos los días.',
	url: `${BUSINESS.siteUrl}/`,
	telephone: BUSINESS.phone,
	sameAs: [MAPS.place],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	openingHoursSpecification: {
		'@type': 'OpeningHoursSpecification',
		dayOfWeek: [
			'Monday',
			'Tuesday',
			'Wednesday',
			'Thursday',
			'Friday',
			'Saturday',
			'Sunday',
		],
		opens: '08:00',
		closes: '14:30',
	},
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	priceRange: undefined,
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Horario', href: '#horario' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Dónde está', href: '#visitanos' },
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#fbf6ef" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..600;1,6..96,400..500&family=Manrope:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Confitería Lochi, panadería Av. de Carlos Haya, confitería Cruz de Humilladero, donuts Málaga 29010, tartas por encargo Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería y confitería en la avenida de Carlos Haya: bollería, donuts y tartas, todos los días de 8:00 a 14:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de Panadería Confitería Lochi en la avenida de Carlos Haya"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#fbf6ef"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Panadería Confitería Lochi, inicio">
					<span class="brand-mark" aria-hidden="true">L</span>
					<span class="brand-name">
						Panadería Confitería Lochi
						<small>Av. de Carlos Haya · Málaga</small>
					</span>
				</a>
				<nav aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-phone" href={BUSINESS.phoneHref}>
					<span aria-hidden="true">☎</span> {BUSINESS.phone}
				</a>
			</div>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Cruz de Humilladero · 29010 Málaga</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-lede">
							Una confitería de barrio en la avenida de Carlos Haya, con vitrina de bollería,
							donuts y tartas. Abre todas las mañanas, de 8:00 a 14:30, y atiende por teléfono.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={BUSINESS.phoneHref}>
								<span aria-hidden="true">☎</span> Llamar · {BUSINESS.phone}
							</a>
							<a class="button button-ghost" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<p class="hero-note">
							<span>La ficha no publica página web ni redes.</span> El teléfono y el horario son
							los que aparecen en Google; aquí no se añade nada que no conste.
						</p>
					</div>

					<figure class="hero-media">
						<Image
							src={fachada}
							alt="La fachada del local desde la acera de enfrente, con el rótulo Panadería Confitería Lochi sobre el escaparate"
							widths={[420, 640, 900, 1124]}
							sizes="(max-width: 900px) 92vw, 44vw"
							format="webp"
							quality={74}
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>
						<figcaption>
							<span>La fachada en la avenida</span>
							<span>Foto de la ficha de Google</span>
						</figcaption>
						<span class="hero-badge" aria-hidden="true">
							<strong>{RATING.label}</strong>
							<small>{RATING.count} reseñas<br />en Google</small>
						</span>
					</figure>
				</div>
			</section>

			<section class="morning" aria-labelledby="morning-title">
				<div class="wrap morning-inner">
					<p class="morning-label" id="morning-title">Horario de la casa</p>
					<p class="morning-time">{HORARIO.todos}</p>
					<p class="morning-days">{HORARIO.dias} · sin día de cierre</p>
					<a class="morning-link" href={MAPS.place} target="_blank" rel="noreferrer">
						Ver en Google Maps <span aria-hidden="true">↗</span>
					</a>
				</div>
			</section>

			<section class="chips-wrap wrap" aria-label="Lo que publica la ficha de Google">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="about wrap" id="casa" aria-labelledby="about-title">
				<div class="about-media">
					<Image
						src={vitrina}
						alt="La vitrina del local con bandejas de bollería, tartas, hojaldres y dulces"
						widths={[480, 720, 1024]}
						sizes="(max-width: 900px) 92vw, 48vw"
						format="webp"
						quality={72}
						loading="lazy"
						decoding="async"
					/>
					<p class="about-caption">La vitrina, en la galería de la ficha</p>
				</div>

				<div class="about-copy">
					<p class="section-label"><span aria-hidden="true"></span> La casa</p>
					<h2 id="about-title">La confitería de <em>la avenida.</em></h2>
					<p>
						Google clasifica Lochi como panadería y su nombre añade confitería. En las fotos de la
						ficha se ve el rótulo completo sobre un escaparate de mármol oscuro, y dentro, la
						vitrina con bandejas de bollería, hojaldres, tartas y dulces.
					</p>
					<p>
						El local está en la avenida de Carlos Haya, en Cruz de Humilladero. La dirección de la
						ficha indica la avenida y el código postal, sin número de portal: esta página no lo
						completa por su cuenta, solo enlaza las coordenadas exactas.
					</p>
					<p>
						La ficha publica teléfono, horario, accesibilidad y 30 reseñas, pero no tiene página
						web, redes sociales, descripción del negocio ni carta con precios. Tampoco detalla qué
						tartas se encargan ni con cuánta antelación: para eso hay que llamar.
					</p>
					<div class="about-links">
						<a class="simple-link" href={BUSINESS.phoneHref}>Llamar al {BUSINESS.phone}</a>
						<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
							Ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section class="three" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas de la ficha</p>
							<h2 id="three-title">Lo que sí <em>consta.</em></h2>
						</div>
						<p>
							Sin carta ni descripción del negocio, esto es lo que la ficha pública permite contar
							sin inventar: el género que muestran sus fotos, un encargo mencionado en una reseña y
							un horario de mañana para los siete días.
						</p>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="hours wrap" id="horario" aria-labelledby="hours-title">
				<div class="hours-copy">
					<p class="section-label"><span aria-hidden="true"></span> Horario</p>
					<h2 id="hours-title">Siete mañanas <em>seguidas.</em></h2>
					<p>
						La ficha publica la misma franja para todos los días de la semana, sin ningún día de
						cierre. No hay turno de tarde ni horario distinto el fin de semana.
					</p>
					<p class="hours-note">
						<strong>Festivos.</strong> {HORARIO.aviso}
					</p>
					<div class="hours-actions">
						<a class="button button-primary" href={BUSINESS.phoneHref}>
							<span aria-hidden="true">☎</span> {BUSINESS.phone}
						</a>
					</div>
				</div>

				<div class="hours-card">
					<p class="hours-card-label">Todos los días</p>
					<p class="hours-card-time">8:00<span>—</span>14:30</p>
					<ul class="hours-days">
						<li>Lunes</li>
						<li>Martes</li>
						<li>Miércoles</li>
						<li>Jueves</li>
						<li>Viernes</li>
						<li>Sábado</li>
						<li>Domingo</li>
					</ul>
					<p class="hours-card-foot">
						Horario publicado en Google, consultado en octubre de 2026.
					</p>
				</div>
			</section>

			<section class="fotos wrap" id="fotos" aria-labelledby="fotos-title">
				<div class="fotos-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Fotos</p>
						<h2 id="fotos-title">De la acera <em>a la vitrina.</em></h2>
					</div>
					<p>
						Seis imágenes de la galería de Google: la fachada, la entrada, la vitrina, dos bandejas
						de donuts y el envoltorio de la casa. No hay fotos del interior de la tienda ni del
						obrador.
					</p>
				</div>

				<div class="fotos-grid">
					<figure class="foto foto-tall">
						<Image
							src={entrada}
							alt="La entrada del local desde la acera, con el rótulo Panadería Confitería Lochi y el escaparate iluminado"
							widths={[360, 540, 760]}
							sizes="(max-width: 900px) 92vw, 28vw"
							format="webp"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>La entrada</figcaption>
					</figure>
					<figure class="foto foto-square">
						<Image
							src={donutsCereza}
							alt="Una bandeja dorada de donuts glaseados con una cereza en el centro"
							widths={[360, 540, 760]}
							sizes="(max-width: 900px) 92vw, 28vw"
							format="webp"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Donuts glaseados con cereza</figcaption>
					</figure>
					<figure class="foto foto-square">
						<Image
							src={donutsAzucar}
							alt="Una bandeja de donuts rebozados en azúcar, junto a una caja de bollería"
							widths={[360, 540, 760]}
							sizes="(max-width: 900px) 92vw, 28vw"
							format="webp"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Donuts rebozados</figcaption>
					</figure>
					<figure class="foto foto-wide">
						<Image
							src={bolsas}
							alt="Bolsas de papel de la casa, con el nombre Lochi impreso en rosa, sobre una mesa"
							widths={[560, 800, 1120]}
							sizes="(max-width: 900px) 92vw, 44vw"
							format="webp"
							quality={72}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>El envoltorio de la casa</figcaption>
					</figure>
				</div>
			</section>

			<section class="rating" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-figure">
						<span class="rating-value">{RATING.label}</span>
						<span class="rating-stars" aria-hidden="true">★★★<span>★★</span></span>
						<span class="rating-count">{RATING.count} reseñas en Google</span>
					</div>
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> Las reseñas</p>
						<h2 id="rating-title">Opiniones <em>variadas.</em></h2>
						<p>
							La media es de 3,7 sobre 5 con 30 reseñas (octubre de 2026). La ficha destaca tres
							opiniones: dos de cinco estrellas y una de cuatro. Estos son sus temas, contados con
							palabras propias.
						</p>
						<ul class="review-list">
							{
								RESENAS.map((item) => (
									<li>
										<span class="review-rating" aria-label={`${item.rating} de 5 estrellas`}>
											{item.rating} / 5
										</span>
										<span class="review-tema">{item.tema}</span>
										<p>{item.resumen}</p>
									</li>
								))
							}
						</ul>
						<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer las reseñas completas <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Dónde está</p>
					<h2 id="visit-title">Avenida de <em>Carlos Haya.</em></h2>
					<p class="address">
						{BUSINESS.street}<br />
						{BUSINESS.district}<br />
						{BUSINESS.postalCode} {BUSINESS.city}
					</p>

					<p class="visit-note">
						<strong>La ficha no indica número de portal.</strong> Tampoco publica página web ni
						redes sociales. El teléfono sí consta y es la vía más directa para preguntar por
						encargos.
					</p>

					<ul class="visit-list">
						<li>
							<span>Horario</span>
							{HORARIO.dias}, {HORARIO.todos}
						</li>
						<li>
							<span>Teléfono</span>
							<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
						</li>
						<li>
							<span>Acceso</span>
							Para sillas de ruedas. Sin aparcamiento adaptado.
						</li>
						<li>
							<span>Plus Code</span>
							{BUSINESS.plusCode}
						</li>
					</ul>

					<div class="visit-links">
						<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-ghost" href={MAPS.place} target="_blank" rel="noreferrer">
							Ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Panadería Confitería Lochi en la avenida de Carlos Haya, Málaga"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Av. de Carlos Haya · 29010
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>llamar.</em></h2>
				<div class="faq-list">
					{
						FAQ.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">L</span>
						<p>
							Panadería Confitería Lochi
							<small>
								Panadería y confitería<br />
								{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}
							</small>
						</p>
					</div>
					<nav aria-label="Enlaces del establecimiento">
						<a href={MAPS.place} target="_blank" rel="noreferrer">Google Maps ↗</a>
						<a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
						<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
						<a href="/panaderia-confiteria-lochi/aviso-legal">Aviso legal</a>
					</nav>
				</div>
				<small class="legal">
					© {new Date().getFullYear()} {BUSINESS.name} · Datos y fotografías de la ficha pública de
					Google Maps, consultada en octubre de 2026. Las fotos de esta página salen de la galería
					de esa ficha. La web no publica carta, precios ni número de portal porque la ficha no los
					incluye.
				</small>
				<nav class="legal-links" aria-label="Información legal">
					<a href="/panaderia-confiteria-lochi/aviso-legal">Aviso legal</a>
					<a href="/panaderia-confiteria-lochi/aviso-legal#privacidad">Privacidad</a>
					<a href="/panaderia-confiteria-lochi/aviso-legal#cookies">Cookies</a>
				</nav>
				<p class="credit">
					<small
						>Creado por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a>
						· sur-digital.vercel.app</small
					>
				</p>
			</div>
		</footer>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
