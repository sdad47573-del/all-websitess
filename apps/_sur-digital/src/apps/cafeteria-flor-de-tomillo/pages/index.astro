---
import { Image } from 'astro:assets';
import '../styles/global.css';
import { fotos } from '../data/fotos';
import {
  business,
  cafeSchema,
  directionsUrl,
  faqs,
  faqSchema,
  hours,
  hoursSource,
  hoursSummary,
  mapEmbedUrl,
  mapsUrl,
  phoneHref,
  site,
} from '../data/site';

const title = 'Cafetería Flor de Tomillo · Ciudad Real';
const description =
  'Cafetería Flor de Tomillo en C. Paloma, 3, Loc 1, 13001 Ciudad Real. Bocadillos, platos del día y raciones. Teléfono 657 27 44 86, horario, mapa y preguntas. Web informativa no oficial.';
const keywords = 'Cafetería Flor de Tomillo, cafetería Ciudad Real, bocadillos Ciudad Real, calle Paloma, menú del día Ciudad Real';

const [fachada, bocadillos, plato] = fotos;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e4b57" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={business.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="geo.region" content="ES-CM" />
    <meta name="geo.placename" content={business.city} />
    <meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
    <meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
    <link rel="canonical" href={`${site.siteUrl}/`} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/cafeteria-flor-de-tomillo/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={business.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site.siteUrl}/`} />
    <meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="place:location:latitude" content={String(business.latitude)} />
    <meta property="place:location:longitude" content={String(business.longitude)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(cafeSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="topbar">
      <a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
        <span class="brand-text">Flor de Tomillo<small>Cafetería · Ciudad Real</small></span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="#local">La casa</a>
        <a href="#fotos">Fotos</a>
        <a href="#horario">Horario</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
      <a class="topbar-phone" href={phoneHref}><span aria-hidden="true">☎</span>{business.phone}</a>
    </header>

    <main id="contenido">
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Ciudad Real · C. Paloma, 3</p>
            <h1 id="hero-title">Flor de<br /><em>Tomillo.</em></h1>
            <p class="hero-lede">
              {business.name} está en {business.streetAddress}, {business.postalCode} {business.city}:
              cafetería de barrio con bocadillos, platos del día y raciones. Web informativa no
              oficial con teléfono, horario, mapa y fotos del perfil público del local en Google Maps.
            </p>
            <div class="hero-actions">
              <a class="btn btn-solid" href={phoneHref}>Llamar: {business.phone}</a>
              <a class="btn btn-ghost" href={directionsUrl} target="_blank" rel="noopener noreferrer">
                Cómo llegar <span aria-hidden="true">↗</span>
              </a>
            </div>
            <ul class="hero-facts">
              <li><small>Dirección</small><strong>{business.streetAddress} · {business.postalCode} {business.city}</strong></li>
              <li><small>Horario</small><strong>{hoursSummary}</strong></li>
              <li><small>Google</small><strong>{business.rating} · {business.reviewCount} reseñas</strong></li>
            </ul>
          </div>

          <div class="hero-media">
            <div class="hero-collage">
              <figure class="collage-item collage-item-main">
                <Image src={fachada.src} alt={fachada.alt} loading="eager" fetchpriority="high" />
              </figure>
              <figure class="collage-item collage-item-top">
                <Image src={bocadillos.src} alt={bocadillos.alt} loading="eager" />
              </figure>
              <figure class="collage-item collage-item-bottom">
                <Image src={plato.src} alt={plato.alt} loading="eager" />
              </figure>
            </div>
            <p class="hero-stamp" aria-hidden="true"><span>Ciudad Real</span><strong>Flor de Tomillo</strong><span>Paloma, 3</span></p>
          </div>
        </div>
      </section>

      <div class="band">
        <span>{business.streetAddress} · {business.postalCode} {business.city}</span>
        <span>{hoursSummary}</span>
        <span>Teléfono {business.phone}</span>
      </div>

      <section class="section local" id="local" aria-labelledby="local-title">
        <div class="wrap local-grid">
          <div class="local-text">
            <p class="kicker">La casa</p>
            <h2 class="title" id="local-title">Cafetería de barrio,<br /><em>cocina de cada día.</em></h2>
            <p>
              {business.name} está en {business.streetAddress} ({business.postalCode} {business.city},
              {business.region}), a pie de calle y con el rótulo rosa sobre la puerta. Su ficha
              pública la clasifica como cafetería.
            </p>
            <p>
              En las fotos de su perfil se ven bocadillos de tortilla y de fiambre en la vitrina,
              platos del día recién emplatados y raciones para compartir. La ficha reúne
              {' '}{business.reviewCount} reseñas, con una valoración de {business.rating} sobre 5.
            </p>
            <ul class="category-list" aria-label="Qué se puede encontrar">
              {business.categories.map((c) => <li>{c}</li>)}
            </ul>
            <p class="local-note">
              Las fotos de esta web proceden del perfil público del local en Google Maps y se muestran
              como referencia; si eres el titular y quieres retirar alguna, escríbenos y la quitamos.
              Para ver las opiniones, usa la
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer">ficha en Google Maps ↗</a>.
            </p>
          </div>
          <div class="quote-row">
            <div class="quote-score">
              <strong>{business.rating}</strong>
              <span>sobre 5 con {business.reviewCount} reseñas en Google</span>
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver reseñas en Maps ↗</a>
            </div>
            <blockquote class="quote">
              <p>Abre de lunes a sábado al mediodía y cierra los domingos.</p>
              <footer><strong>Horario</strong><span>{hoursSource}</span></footer>
            </blockquote>
          </div>
        </div>
      </section>

      <section class="section fotos" id="fotos" aria-labelledby="fotos-title">
        <div class="wrap">
          <p class="kicker">Las fotos</p>
          <h2 class="title" id="fotos-title">La barra, la vitrina <em>y los platos.</em></h2>
          <p class="lead">
            Imágenes alojadas en esta web procedentes del perfil público del local en Google Maps: la
            fachada, el mostrador y los platos que salen de la cocina. Si eres el titular y quieres
            retirar alguna, escríbenos y la quitamos.
          </p>
          <div class="fotos-grid">
            {fotos.map((foto) => (
              <figure class="foto-item">
                <Image src={foto.src} alt={foto.alt} loading="lazy" />
                <figcaption>{foto.pie}</figcaption>
              </figure>
            ))}
          </div>
          <p class="fotos-note">
            ¿Quieres ver más? Mira la
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer">ficha con fotos en Google Maps ↗</a>
            o <a href={phoneHref}>llama al {business.phone}</a>.
          </p>
        </div>
      </section>

      <section class="section horario" id="horario" aria-labelledby="horario-title">
        <div class="wrap horario-grid">
          <div>
            <p class="kicker">Horario y ubicación</p>
            <h2 class="title" id="horario-title">Calle Paloma,<br /><em>13001 Ciudad Real.</em></h2>
            <address>{business.streetAddress}<br />{business.postalCode} {business.city}<br />{business.province} · España</address>
            <table class="hours-table">
              <caption>Horario de la ficha pública · {hoursSource}</caption>
              <tbody>
                {hours.map((item) => (
                  <tr><th scope="row">{item.day}</th><td>{item.service}</td></tr>
                ))}
              </tbody>
            </table>
            <p class="hours-note">Llama al {business.phone} para confirmar festivos y puentes.</p>
            <a class="contact-line" href={phoneHref}><small>Teléfono</small><strong>{business.phone}</strong></a>
            <div class="place-actions">
              <a class="btn btn-solid" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a>
              <a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver la ficha en Maps ↗</a>
            </div>
          </div>
          <div class="map-card">
            <iframe title={`Mapa de ${business.name} en ${business.city}`} src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
            <div class="map-tag">
              <div><strong>{business.shortName}</strong><small>{business.streetAddress} · {business.postalCode} {business.city}</small></div>
              <a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
            </div>
          </div>
        </div>
      </section>

      <section class="section faq" id="preguntas" aria-labelledby="faq-title">
        <div class="wrap">
          <p class="kicker">Preguntas frecuentes</p>
          <h2 class="title" id="faq-title">Antes de <em>venir.</em></h2>
          <div class="faq-list">
            {faqs.map((faq) => (
              <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-top">
        <a class="footer-brand" href="#inicio" aria-label={`${business.shortName}, volver al inicio`}>
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          <span>{business.name}<small>{business.streetAddress} · {business.postalCode} {business.city}</small></span>
        </a>
        <nav class="footer-nav" aria-label="Contacto y ficha del local">
          <a href={phoneHref}>Llamar: {business.phone}</a>
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Ficha en Google Maps ↗</a>
        </nav>
        <small class="footer-note">
          © {new Date().getFullYear()} {business.name} · {business.streetAddress} ({business.postalCode} {business.city}).
          Web informativa no oficial con datos públicos de la ficha de Google Maps. Confirma horario por teléfono.
        </small>
      </div>
      <p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
      <nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
        <a href="/cafeteria-flor-de-tomillo/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
        <a href="/cafeteria-flor-de-tomillo/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
        <a href="/cafeteria-flor-de-tomillo/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
      </nav>
    </footer>

    <a class="mobile-call" href={phoneHref}>Llamar a Flor de Tomillo <span>{business.phone}</span></a>
  </body>
</html>
