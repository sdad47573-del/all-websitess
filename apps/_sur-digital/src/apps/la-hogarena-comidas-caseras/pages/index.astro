---
import f01 from '../assets/fotos/la-hogarena-comidas-caseras-vertical-01.jpg';

const fotos = [f01];

const MAPS_URL =
	'https://www.google.com/maps/place/La+Hogare%C3%B1a+Comidas+Caseras./@37.9629287,-1.0868541,17z/data=!3m1!4b1!4m6!3m5!1s0xd6378700293e0cb:0x7c1dd21d79297612!8m2!3d37.9629287!4d-1.0868541!16s%2Fg%2F11cs2xncf9?authuser=0&hl=es&entry=ttu';
const CREDIT_URL = 'https://www.sur-digital.com/';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>La Hogareña Comidas Caseras</title>
		<meta name="description" content="La Hogareña Comidas Caseras." />
		<link rel="canonical" href="https://www.sur-digital.com/la-hogarena-comidas-caseras/" />
		<meta name="robots" content="index, follow" />
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Restaurant",
	"@id": "https://www.sur-digital.com/la-hogarena-comidas-caseras/#negocio",
	"name": "La hogarena comidas caseras",
	"url": "https://www.sur-digital.com/la-hogarena-comidas-caseras/",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 37.9629287,
		"longitude": -1.0868541
	},
	"hasMap": "https://www.google.com/maps/place/La+Hogare%C3%B1a+Comidas+Caseras./@37.9629287,-1.0868541,17z/data=!3m1!4b1!4m6!3m5!1s0xd6378700293e0cb:0x7c1dd21d79297612!8m2!3d37.9629287!4d-1.0868541!16s%2Fg%2F11cs2xncf9?authuser=0&hl=es&entry=ttu"
}
</script>
		<meta property="og:image" content="https://www.sur-digital.com/la-hogarena-comidas-caseras/og.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
			<meta property="og:url" content="https://www.sur-digital.com/la-hogarena-comidas-caseras/" />
		<meta property="og:locale" content="es_ES" />
			<meta property="og:title" content="La Hogareña Comidas Caseras" />
		<meta property="og:description" content="La Hogareña Comidas Caseras." />
	</head>
	<body>
		<header>
			<h1 set:html={piezas.portada.titulo} />
			<a href={MAPS_URL} rel="noopener" target="_blank">Ver en Google Maps</a>
		</header>

		<main>
			<section>
				{fotos.map((foto) => (
					<img src={foto.src} width={foto.width} height={foto.height} alt="La Hogareña Comidas Caseras" loading="lazy" decoding="async" />
				))}
			</section>
		</main>

		<footer>
			<p>
				Creado por <a href={CREDIT_URL} rel="noopener">Sur Digital</a>
			</p>
		</footer>
	</body>
</html>
