		<link rel="canonical" href={`${site}/aviso-legal/`} />
		<link rel="icon" type="image/svg+xml" href="/restaurante-la-rusticana/favicon.svg" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Restaurante La Rusticana" />
		<meta property="og:title" content="Aviso legal y privacidad | Restaurante La Rusticana" />
		<meta property="og:description" content="Información legal y política de privacidad de Restaurante La Rusticana en Cartagena." />
