const today = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Información legal y política de privacidad de Restaurante La Rusticana en Cartagena." />
