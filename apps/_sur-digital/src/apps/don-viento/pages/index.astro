---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	directionsUrl,
	distintivo,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Don Viento · Bar y cafetería en Sanlúcar de Barrameda';
const description =
	'Don Viento, bar y cafetería en la calle Director Julián Cerdán, 4 de Sanlúcar de Barrameda. 4,2 sobre 5 con 512 reseñas; abre todos los días desde las 12:00 hasta la 01:30 (viernes y sábados, 02:30).';
const keywords =
	'Don Viento, bar Sanlúcar de Barrameda, cafetería Sanlúcar, Don Viento Sanlúcar, Director Julián Cerdán, bar Cádiz, cafetería Cádiz, Don Viento teléfono, puesta de sol Sanlúcar, Doñana Sanlúcar';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas diez fotografías y el manifiesto de la descarga no
 * atribuye autor, así que no se inventa una descripción ni una atribución: los `alt` avisan solo
 * de dónde salen.
 */
const altFoto =
	'Fotografía publicada en la ficha de Google Maps de Don Viento, en Sanlúcar de Barrameda';
const altOg = 'Fotografía de Don Viento publicada en su ficha de Google Maps';

/** Galería completa: las diez fotografías de la ficha, en el orden en que se descargaron. */
const galeria = [
	{ name: 'don-viento-vertical-01.jpg', clase: '' },
	{ name: 'don-viento-apaisada-05.jpg', clase: 'es-apaisada' },
	{ name: 'don-viento-vertical-02.jpg', clase: '' },
	{ name: 'don-viento-apaisada-06.jpg', clase: 'es-apaisada' },
	{ name: 'don-viento-vertical-03.jpg', clase: '' },
	{ name: 'don-viento-apaisada-07.jpg', clase: 'es-apaisada' },
	{ name: 'don-viento-vertical-04.jpg', clase: '' },
	{ name: 'don-viento-apaisada-08.jpg', clase: 'es-apaisada' },
	{ name: 'don-viento-apaisada-09.jpg', clase: 'es-apaisada' },
	{ name: 'don-viento-vertical-10.jpg', clase: '' },
];

/**
 * Tres fotos de avance en el collage de la portada (también están en la galería).
 *
 * Arriba va la apaisada 05 y abajo las verticales 01 y 02, con las proporciones por defecto del
 * repositorio (16/9 y 4/5).
 */
const collage = [
	{ name: 'don-viento-apaisada-05.jpg', clase: 'collage-item collage-item-a' },
	{ name: 'don-viento-vertical-01.jpg', clase: 'collage-item collage-item-b' },
	{ name: 'don-viento-vertical-02.jpg', clase: 'collage-item collage-item-c' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#241a2b" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CA" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/don-viento/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400;1,6..96,500&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">
					DV
				</span>
				<span class="brand-text">
					Don Viento
					<small>Sanlúcar de Barrameda</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#local">El local</a>
				<a href="#vistas">Las vistas</a>
				<a href="#fotos">Las fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<div class="hero-tags">
							<p class="eyebrow">Sanlúcar de Barrameda · Cádiz</p>
							<span class="badge-pill">{distintivo}</span>
						</div>
						<h1 id="hero-title">
							Don Viento
							<em>Bar y cafetería en Sanlúcar de Barrameda.</em>
						</h1>
						<p class="hero-lede">
							En la calle Director Julián Cerdán, 4. Google lo clasifica como bar y cafetería, le da{' '}
							<strong>{business.rating.toLocaleString('es-ES')} sobre 5</strong> con{' '}
							<strong>{business.reviewCount.toLocaleString('es-ES')} reseñas</strong> y publica un
							horario continuo: abre a las 12:00 y cierra a la 01:30, salvo los viernes y sábados,
							que alarga hasta las 02:30.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>
								Llamar al {business.phone}
							</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas en Google
								</strong>
							</li>
						</ul>
					</div>

					<div class="hero-collage">
						{collage.map((item, index) => (
							<figure class={item.clase}>
								<Image
									src={foto(item.name)}
									alt={altFoto}
									widths={index === 0 ? [640, 900, 1200] : [320, 480, 640]}
									sizes={
										index === 0
											? '(max-width: 1080px) 92vw, 46vw'
											: '(max-width: 1080px) 45vw, 23vw'
									}
									format="avif"
									quality={68}
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : undefined}
									decoding="async"
								/>
								{index === 0 && <figcaption class="collage-caption">Fotos de la ficha</figcaption>}
							</figure>
						))}
					</div>
				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
					{business.reviewCount.toLocaleString('es-ES')} reseñas
				</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>Abierto todos los días desde las 12:00</span>
				<span>
					{distintivo} · Teléfono {business.phone}
				</span>
			</div>

			<section class="section" id="local" aria-labelledby="local-title">
				<div class="wrap casa-grid">
					<div class="casa-text">
						<p class="kicker">El local</p>
						<h2 class="title" id="local-title">
							Bar y cafetería,
							<br />
							<em>de mediodía a madrugada.</em>
						</h2>
						<p>
							Don Viento está en la calle Director Julián Cerdán, 4, en Sanlúcar de Barrameda
							(Cádiz). Google lo clasifica con dos categorías, <strong>bar</strong> y{' '}
							<strong>cafetería</strong>, y en la ficha consultada el {site.consultado} tenía{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas.
						</p>
						<p>
							El horario que publica la ficha no tiene turnos partidos: abre todos los días a las
							12:00 y cierra a la 01:30, salvo los viernes y los sábados, que alarga hasta las
							02:30. En las reseñas destacadas se habla de café, de merendar, de cenar y de tapear,
							así que el mismo local cubre la sobremesa y la última copa.
						</p>
						<p>
							La ficha no publica carta, precios ni descripción del titular, así que esta web no
							reproduce ninguna: para saber qué hay hoy, lo más rápido es llamar al{' '}
							<a href={phoneHref}>
								<strong>{business.phone}</strong>
							</a>
							. Sí publica cuatro datos de accesibilidad y el distintivo{' '}
							<strong>«{distintivo}»</strong>.
						</p>
						<ul class="tag-list" aria-label="Datos que publica la ficha">
							<li>{business.category}</li>
							<li>Cafetería</li>
							<li>{distintivo}</li>
							<li>Abierto todos los días</li>
							<li>Acceso adaptado</li>
							<li>Aparcamiento adaptado</li>
						</ul>

						<div class="quote-row">
							<div class="quote-score">
								<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
								<span>{business.reviewCount.toLocaleString('es-ES')} reseñas en Google Maps</span>
								<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
									Ver todas ↗
								</a>
							</div>
							{reviews.map((review) => (
								<blockquote class="quote">
									<p>«{review.text}»</p>
									<footer>
										<strong>{review.rating} sobre 5</strong>
										<span>{review.source}</span>
									</footer>
								</blockquote>
							))}
						</div>
					</div>

					<figure class="casa-figure">
						<Image
							src={foto('don-viento-vertical-03.jpg')}
							alt={altFoto}
							widths={[420, 640, 900]}
							sizes="(max-width: 1080px) 92vw, 42vw"
							format="avif"
							quality={70}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>
							Fotografía de la ficha de Google Maps de Don Viento, en Sanlúcar de Barrameda.
						</figcaption>
					</figure>
				</div>
			</section>

			<section class="section vistas" id="vistas" aria-labelledby="vistas-title">
				<div class="wrap vistas-grid">
					<figure class="vistas-figure">
						<Image
							src={foto('don-viento-apaisada-07.jpg')}
							alt={altFoto}
							widths={[560, 840, 1200]}
							sizes="(max-width: 1080px) 92vw, 48vw"
							format="avif"
							quality={70}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>Imagen publicada por el local en su ficha de Google Maps.</figcaption>
					</figure>
					<div class="vistas-text">
						<p class="kicker">Lo que cuentan las reseñas</p>
						<h2 class="title" id="vistas-title">
							Café, cerveza y
							<br />
							<em>la puesta de sol.</em>
						</h2>
						<p>
							La ficha de Google no describe el local, pero las reseñas que destaca sí hablan de lo
							que se ve desde él: la puesta de sol, las vistas y el coto de Doñana. Se citan tal
							cual, como opiniones de clientes.
						</p>
						<div class="vistas-card">
							<p>
								<strong>Aviso de la casa</strong>
								Estas vistas no son una promesa de Don Viento: son tres comentarios de clientes que
								Google destaca en la ficha. La luz cambia con la hora y la época del año, así que si
								vienes por la puesta de sol, confirma antes por teléfono y pregúntales a qué hora se
								ve mejor.
							</p>
						</div>
						<p class="vistas-action">
							<a class="btn btn-solid" href={phoneHref}>
								Preguntar al {business.phone}
							</a>
						</p>
					</div>
				</div>
			</section>

			<section class="section galeria" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						Don Viento <em>en diez imágenes.</em>
					</h2>
					<p class="lead">
						Son las diez fotografías que el local publica en su ficha de Google Maps. La ficha no
						describe su contenido y el manifiesto de la descarga no atribuye autor, así que se
						muestran sin pie de autor y sin una descripción inventada.
					</p>
					<div class="galeria-grid">
						{galeria.map((item) => (
							<figure class:list={['galeria-item', item.clase]}>
								<Image
									src={foto(item.name)}
									alt={altFoto}
									widths={[380, 560, 800]}
									sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
									format="avif"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))}
					</div>
					<p class="galeria-note">
						La ficha no publica la carta ni los precios, así que esta web no los reproduce. Para
						saber qué hay hoy, llama al <a href={phoneHref}>{business.phone}</a> o mira las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos y reseñas de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Director Julián Cerdán, 4,
							<br />
							<em>11540 Sanlúcar.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							El local abre <strong>todos los días</strong> a las 12:00 y cierra a la 01:30, salvo
							los <strong>viernes y sábados</strong>, que cierra a las 02:30. Es el horario de la
							ficha consultada el {site.consultado}; conviene confirmarlo por teléfono antes de ir,
							sobre todo en festivos.
						</p>
						<p class="access-title">Accesibilidad publicada en la ficha</p>
						<ul class="access-list">
							{accesibilidad.map((item) => (
								<li class:list={[{ 'is-no': !item.disponible }]}>{item.label}</li>
							))}
						</ul>
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>llamar.</em>
					</h2>
					<p class="lead">
						{business.reviewCount.toLocaleString('es-ES')} reseñas, un distintivo y cuatro datos de
						accesibilidad: todo lo que la ficha publica, resumido sin añadir nada.
					</p>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">
						DV
					</span>
					<span>
						Don Viento
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Don Viento · {business.streetAddress} ({business.postalCode}
					{business.city}). Web informativa elaborada con los datos y las fotografías que el local
					publica en su ficha de Google Maps, consultada el {site.consultado}. Confirma horario y
					disponibilidad por teléfono antes de salir.
				</small>
			</div>
			<a class="mobile-call" href={phoneHref}>
				Llamar a Don Viento <span>{business.phone}</span>
			</a>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
