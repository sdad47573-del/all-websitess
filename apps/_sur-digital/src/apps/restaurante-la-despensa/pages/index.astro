---
import '../styles/global.css';

const business = {
	name: 'Restaurante La Despensa',
	street: 'Calle Escritor Ramón Solís, 9',
	city: 'Cádiz',
	postalCode: '11008',
	phone: '+34 956 46 60 44',
	latitude: 36.517306,
	longitude: -6.285592,
	site: 'https://www.sur-digital.com/restaurante-la-despensa',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+La+Despensa/@36.517306,-6.285592,17z/data=!3m1!4b1!4m6!3m5!1s0xd0dd3ce78acdcdf:0xba5c1bfe925e265a!8m2!3d36.517306!4d-6.285592!16s%2Fg%2F1wn34y51?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const phoneHref = 'tel:+34956466044';
const websiteUrl = 'https://restauranteladespensa.es/';
const instagramUrl = 'https://www.instagram.com/la_despensa_cadiz/';
const facebookUrl = 'https://www.facebook.com/restauranteladespensacadiz/';

const specialties = [
	{
		kicker: 'Para compartir',
		title: 'Croquetas de gambas',
		text: 'Croquetas caseras de gambas al ajillo con patatas fritas. Las más citadas de su carta de invierno.',
	},
	{
		kicker: 'De la abuela',
		title: 'Albóndigas en Jerez',
		text: 'Las auténticas albóndigas de la abuela Mamen en salsa de vino de Jerez, con patatas en aceite de oliva.',
	},
	{
		kicker: 'De cuchara',
		title: 'Sopas de la casa',
		text: 'Sopa hilada La Despensa con costrones y sobrasada, sopa de pescado trabada estilo Donosti y cocido madrileño de temporada.',
	},
	{
		kicker: 'Pescados',
		title: 'Merluza al azafrán',
		text: 'Lomos de merluza en salsa de azafrán, bacalao a la mantequilla de pimientos y volcán de sepia con arroz.',
	},
	{
		kicker: 'Carnes',
		title: 'Ibérico y rabo',
		text: 'Solomillitos de ibérico en salsa de foie, rabo al más puro estilo cordobés y entrecot con salsa de Cabrales.',
	},
	{
		kicker: 'Para todos',
		title: 'Carta para celíacos',
		text: 'Cocina española con opciones vegetarianas, veganas y carta específica para celíacos. Pregunta por las sugerencias de temporada.',
	},
];

const gallery = [
	{ src: '/fotos/salon.svg', alt: 'Ilustración del comedor de Restaurante La Despensa — sustituye por foto propia' },
	{ src: '/fotos/croquetas.svg', alt: 'Ilustración de las croquetas de gambas al ajillo — sustituye por foto propia' },
	{ src: '/fotos/albondigas.svg', alt: 'Ilustración de las albóndigas en salsa de Jerez — sustituye por foto propia' },
	{ src: '/fotos/merluza.svg', alt: 'Ilustración de la merluza en salsa de azafrán — sustituye por foto propia' },
	{ src: '/fotos/solomillo.svg', alt: 'Ilustración de los solomillitos ibéricos en salsa de foie — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Restaurante La Despensa?',
		a: 'En Calle Escritor Ramón Solís, 9 (plaza Escritor Ramón Solís 9 y 10), 11008 Cádiz, en la zona de Puerta Tierra.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De lunes a jueves de 13:00 a 16:00 y de 20:00 a 23:00; viernes y sábado de 13:00 a 16:30 y de 20:30 a 23:30; domingos de 13:00 a 16:30 y de 20:00 a 23:00, salvo festivos y vísperas. Confírmalo en el 956 46 60 44.',
	},
	{
		q: '¿Se puede reservar mesa?',
		a: 'Sí. Se puede reservar por teléfono en el 956 46 60 44 y a través de su web oficial, enlazada en esta página.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Cocina española casera con carta de invierno y sugerencias de temporada: croquetas de gambas al ajillo, buñuelitos de patata, albóndigas en Jerez, merluza al azafrán, solomillitos ibéricos, rabo cordobés y cocido madrileño.',
	},
	{
		q: '¿Hay opciones para celíacos y vegetarianos?',
		a: 'Sí, el local publica carta específica para celíacos y ofrece opciones vegetarianas y veganas. Avísales al reservar.',
	},
];

const description =
	'Restaurante La Despensa: cocina española casera en Calle Escritor Ramón Solís, 9 (Cádiz). Croquetas de gambas, albóndigas en Jerez, pescados y carnes. Reserva en el 956 46 60 44.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 956 46 60 44',
	image: [`${business.site}/fotos/salon.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Mediterránea', 'Casera'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [websiteUrl, instagramUrl, facebookUrl],
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '13:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '20:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '13:00',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '20:30',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '13:00',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '20:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Carta para celíacos', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Opciones vegetarianas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Comida para llevar', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.1,
		reviewCount: 538,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#3d2c1e" />
		<meta name="description" content="Restaurante La Despensa: cocina española casera en Calle Escritor Ramón Solís, 9 (Cádiz). Croquetas de gambas, albóndigas en Jerez y pescados. Reserva en el 956 46 60 44." />
		<meta name="keywords" content="Restaurante La Despensa Cádiz, comer Cádiz Puerta Tierra, croquetas gambas Cádiz, albóndigas Jerez, merluza azafrán, Escritor Ramón Solís 9, reservar mesa Cádiz" />
		<meta name="author" content="Restaurante La Despensa" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/restaurante-la-despensa/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz:wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>Restaurante La Despensa | Cocina casera en Cádiz</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Restaurante La Despensa · Cocina española casera en Cádiz" />
		<meta property="og:description" content="Croquetas de gambas, albóndigas en Jerez, merluza al azafrán y carnes en Escritor Ramón Solís, 9 (Cádiz). Todos los días, mediodía y noche." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/salon.svg`} />
		<meta property="og:image:alt" content="Restaurante La Despensa, cocina casera en Cádiz" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Restaurante La Despensa · Cocina casera en Cádiz" />
		<meta name="twitter:description" content="Cocina española casera en Escritor Ramón Solís, 9, Cádiz. Reserva en el 956 46 60 44." />
		<meta name="twitter:image" content={`${business.site}/fotos/salon.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Cádiz" />
		<meta name="geo.position" content="36.517306;-6.285592" />
		<meta name="ICBM" content="36.517306, -6.285592" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Restaurante La Despensa, inicio">
				<span class="brand-mark" aria-hidden="true">D</span>
				<span class="brand-name">Restaurante La Despensa <small>Cádiz · Puerta Tierra</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">El restaurante</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>956 46 60 44</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Escritor Ramón Solís, 9 · Cádiz</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante de barrio en Puerta Tierra: croquetas de gambas al ajillo, albóndigas en Jerez,
						merluza al azafrán y carnes. Carta de invierno, sugerencias de temporada y carta para celíacos.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={websiteUrl} target="_blank" rel="noreferrer">Ver carta oficial ↗</a>
						<a class="button button-ghost" href={phoneHref}>Llamar 956 46 60 44</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,1</b> en Google (538 reseñas)</li>
						<li>Todos los días</li>
						<li>20–30 €/persona</li>
						<li>Carta celíacos</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/restaurante-la-despensa/fotos/salon.svg" alt="Ilustración del comedor de Restaurante La Despensa en Cádiz" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Escritor Ramón Solís 9 · Cádiz</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>4,1</b><span>Google</span></div>
					<div><b>4,4</b><span>Facebook</span></div>
					<div><b>7d</b><span>Apertura semanal</span></div>
				</div>
				<ul class="services">
					<li>Comedor</li>
					<li>Carta celíacos</li>
					<li>Vegetariano</li>
					<li>Para llevar</li>
					<li>Reservas</li>
					<li>Temporada</li>
				</ul>
			</section>

			<section class="about section-pad" id="restaurante">
				<p class="section-label"><span aria-hidden="true"></span> Un clásico de Puerta Tierra</p>
				<div class="about-grid">
					<h2>Guisos, cuchara<br />y platos <em>de siempre.</em></h2>
					<div class="about-copy">
						<p>
							Restaurante La Despensa está en Calle Escritor Ramón Solís, 9, en Cádiz. Cocina española
							casera con carta de invierno, sugerencias de temporada que anuncian a diario y una bodega
							propia para acompañar.
						</p>
						<p>
							De su carta: croquetas de gambas al ajillo, buñuelitos de patata al chorizo, albóndigas en
							salsa de Jerez, merluza en salsa de azafrán, solomillitos ibéricos en salsa de foie, rabo
							cordobés y cocido madrileño en temporada.
						</p>
						<p class="about-note">
							Abre todos los días en dos turnos, mediodía y noche, con horarios algo distintos en fin de
							semana. Precio medio orientativo de 20 a 30 € por persona. Llama antes en festivos y vísperas.
						</p>
						<div class="about-links">
							<a class="simple-link" href={websiteUrl} target="_blank" rel="noreferrer">Web oficial <span aria-hidden="true">↗</span></a>
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">Instagram <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su carta</p>
						<h2>Lo que más<br />se pide <em>en la mesa.</em></h2>
					</div>
					<p>
						Platos de la carta de invierno publicada por el propio restaurante. La carta y las sugerencias
						cambian por temporada: confirma disponibilidad y precios en el local.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>La Despensa<br /><em>por dentro.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del restaurante.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Escritor Ramón Solís, 9</p>
					<h2>Ven a comer<br /><em>como en casa.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes a jueves</th>
								<td>13:00 – 16:00 · 20:00 – 23:00</td>
							</tr>
							<tr>
								<th scope="row">Viernes y sábado</th>
								<td>13:00 – 16:30 · 20:30 – 23:30</td>
							</tr>
							<tr>
								<th scope="row">Domingo</th>
								<td>13:00 – 16:30 · 20:00 – 23:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Horario publicado por el propio local. Salvo festivos y vísperas: llama antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={websiteUrl} target="_blank" rel="noreferrer">Carta oficial ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 956 46 60 44</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de Restaurante La Despensa en Escritor Ramón Solís, 9, Cádiz" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Restaurante La Despensa · Cádiz</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">D</span>
				<p>Restaurante La Despensa<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={websiteUrl} target="_blank" rel="noreferrer">Web oficial ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Restaurante La Despensa · Cádiz. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://www.sur-digital.com/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/restaurante-la-despensa/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/restaurante-la-despensa/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/restaurante-la-despensa/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>956 46 60 44</span></a>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
