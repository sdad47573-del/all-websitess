---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/namaste-ibiza-restaurante-vista-1-01.jpg';
import naanCurry from '../assets/fotos/namaste-ibiza-restaurante-vertical-02.jpg';
import entrantes from '../assets/fotos/namaste-ibiza-restaurante-vista-3-03.jpg';
import tandoori from '../assets/fotos/namaste-ibiza-restaurante-apaisada-04.jpg';
import surtido from '../assets/fotos/namaste-ibiza-restaurante-apaisada-05.jpg';
import mesa from '../assets/fotos/namaste-ibiza-restaurante-apaisada-06.jpg';
import naanCuenco from '../assets/fotos/namaste-ibiza-restaurante-vertical-07.jpg';
import raita from '../assets/fotos/namaste-ibiza-restaurante-vertical-08.jpg';
import cesta from '../assets/fotos/namaste-ibiza-restaurante-vertical-09.jpg';
import bolitas from '../assets/fotos/namaste-ibiza-restaurante-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Namaste Ibiza Restaurante, en Passatge de Castaví, 1 (07800 Eivissa). Cocina casera nepalí e india: curries, tandoor, naan y arroces. Tel. 871 51 85 02.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de Namaste Ibiza en Passatge de Castaví, con el rótulo de neón del loto, ventanales y terraza de mesas altas en la acera',
	},
	{
		src: tandoori,
		alt: 'Pollo tandoori con ensalada de col, arroz basmati con azafrán, cesta de naan y un cuenco de curry sobre mantel blanco',
	},
	{
		src: surtido,
		alt: 'Surtido sobre una bandeja de lino: pollo tandoori, chicken tikka con salsas, samosas, naan y dos cuencos de curry',
	},
	{
		src: entrantes,
		alt: 'Samosas doradas en una fuente blanca y un plato de bolitas fritas con yogur y tamarindo, con cesta de poppadoms al fondo',
	},
	{
		src: bolitas,
		alt: 'Bolitas fritas con yogur, salsa de tamarindo, cilantro y virutas crujientes en un plato blanco',
	},
	{
		src: mesa,
		alt: 'Mesa con pollo tandoori, arroz basmati, cesta de naan y un curry oscuro de carne',
	},
	{
		src: naanCurry,
		alt: 'Cesta de pan naan con semillas y cuencos de curry con salsa de menta en la mesa',
	},
	{
		src: naanCuenco,
		alt: 'Naan caliente en una cesta de mimbre junto a un cuenco de curry con cilantro fresco',
	},
	{
		src: raita,
		alt: 'Cesta de naan con hierbas, cuenco de raita con verduras, arroz basmati y un refresco',
	},
	{
		src: cesta,
		alt: 'Cesta de mimbre con naan recién hecho y dos cuencos de salsa al fondo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#namaste`,
	name: BUSINESS.name,
	alternateName: ['Namaste Ibiza', 'Namaste', 'Namaste Restaurante Ibiza', 'Namaste Eivissa'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 871 51 85 02',
	currenciesAccepted: 'EUR',
	servesCuisine: ['India', 'Nepalí', 'Tibetana', 'Asiática'],
	areaServed: [
		{ '@type': 'City', name: 'Eivissa' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '13:00',
			closes: '15:45',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '19:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Namaste Ibiza · Cocina india y nepalí en Eivissa';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#6b2d4f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Namaste Ibiza, restaurante indio Ibiza, restaurante nepalí Eivissa, comer en Ibiza centro, curry Ibiza, naan Ibiza, cocina nepalí Ibiza, restaurante vegetariano Ibiza, Passatge de Castaví"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Namaste Ibiza · Cocina india y nepalí en Eivissa"
			ogDescription="Cocina casera nepalí e india en el centro de Eivissa: curries, tandoor, naan y arroces basmati. Passatge de Castaví, 1. Tel. 871 51 85 02."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Namaste Ibiza en Passatge de Castaví, con el rótulo del loto y la terraza en la acera"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#6b2d4f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			phone="+34871518502"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/namaste-ibiza-restaurante/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Namaste Ibiza"
			subtitle="Cocina india y nepalí · Eivissa"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Passatge de Castaví, 1 · Eivissa"
				title="Cocina de Nepal<br /><em>en el centro de Ibiza.</em>"
				lede={`Namaste Ibiza es un restaurante indio y nepalí en Passatge de Castaví, 1, en pleno centro de Eivissa. Cocina casera del Himalaya con recetas que vienen de Nepal y de la fusión con la India, Tíbet, Tailandia y China: curries, tandoor, naan recién hecho y arroces basmati. Sirve comidas de 13:00 a 15:45 y cenas de 19:00 a 23:00; el miércoles cierra. Teléfono: ${BUSINESS.phoneDisplay}.`}
				image={fachada}
				imageAlt="Fachada de Namaste Ibiza en Passatge de Castaví, con el rótulo de neón del loto, ventanales y terraza de mesas altas en la acera"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)` },
					{ label: 'Cocina', html: 'Nepalí e india · curries, tandoor y naan' },
					{ label: 'Horario', html: '13:00–15:45 · 19:00–23:00 · miércoles cerrado' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Namaste Ibiza" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="El Himalaya<br /><em>a dos pasos del puerto.</em>"
				paragraphs={[
					'Namaste Ibiza está en Passatge de Castaví, 1, en el centro de Eivissa, a un paso del puerto y de la entrada a Dalt Vila. Google lo clasifica como restaurante indio y restaurante nepalí. La fachada es oscura, con el loto de Namaste en neón sobre la puerta, grandes ventanales con lámparas naranjas dentro y una terraza de mesas altas en la acera.',
					'La ficha del negocio lo presenta así: «Bienvenid@s a nuestro nuevo restaurante asiático: disfruta de la mejor cocina casera Nepalí/Hindi en Ibiza: la más sana, natural y auténtica». Y añade: «nuestras recetas les acompañarán a tener la misma experiencia de sabores que ustedes podrían disfrutar en Nepal. Muchos platos tienen su origen en la fusión con la gastronomía del Tibet, India, Tailandesa así como también de la China».',
					'En las fotos del perfil se ven samosas, poppadoms, bolitas crujientes con yogur y tamarindo, pollo tandoori, chicken tikka, curries de pollo, de carne y de verduras, raita, arroz basmati con azafrán y cestas de naan recién hecho: la mesa se comparte, con el pan y los cuencos en el centro.',
					'Sus reseñas destacan la comida, el precio y el servicio: «me hicieron una variedad de vegetales veganos con arroz», «hemos ido varias veces y volveremos a repetir» y «buena comida, buenos precios y buen servicio... volveré». Google le da 4,9 sobre 5 con 666 reseñas.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google. Una de ellas: «${REVIEWS[1]}»`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Curries, tandoor<br /><em>y pan recién hecho.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que aparece en las fotos del perfil, lo que cuenta la descripción del negocio y lo que citan sus reseñas."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. Llama al 871 51 85 02 para reservar mesa, preguntar por las opciones vegetarianas y veganas o encargar el curry del día."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La mesa,<br /><em>el naan y los curries.</em>"
				description="Estas fotografías proceden del perfil de Namaste Ibiza Restaurante en Google Maps: la fachada y la terraza, el pollo tandoori, el chicken tikka, las samosas, las bolitas con yogur y tamarindo, los curries, la raita, el arroz basmati y el naan."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en Eivissa.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: comidas de 13:00 a 15:45 y cenas de 19:00 a 23:00, de domingo a martes y de jueves a sábado; miércoles cerrado. Conviene llamar antes en temporada alta."
				mapTitle="Mapa de Namaste Ibiza Restaurante en Passatge de Castaví, Eivissa"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Namaste Ibiza · Eivissa"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 871 51 85 02. La ficha de Google marca acceso para sillas de ruedas, aseo adaptado y asientos adaptados."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/namaste-ibiza-restaurante/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Namaste"
		/>
	</body>
</html>
