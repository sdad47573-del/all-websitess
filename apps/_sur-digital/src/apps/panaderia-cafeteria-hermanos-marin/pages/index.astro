---
import { Image } from 'astro:assets';
import { LocalSeo } from '@astro-components';

import '../styles/global.css';

import fachada from '../assets/fotos/panaderia-cafeteria-hermanos-marin-apaisada-09.jpg';
import escaparate from '../assets/fotos/panaderia-cafeteria-hermanos-marin-apaisada-01.jpg';
import pasillo from '../assets/fotos/panaderia-cafeteria-hermanos-marin-vertical-07.jpg';
import mostrador from '../assets/fotos/panaderia-cafeteria-hermanos-marin-vertical-06.jpg';
import sala from '../assets/fotos/panaderia-cafeteria-hermanos-marin-panoramica-10.jpg';
import vitrina from '../assets/fotos/panaderia-cafeteria-hermanos-marin-vertical-04.jpg';
import tienda from '../assets/fotos/panaderia-cafeteria-hermanos-marin-vertical-08.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const title = 'Hermanos Marín · Panadería y cafetería en Teatinos';
const description =
	'Panadería Cafetería Hermanos Marín, en C. Robinson Crusoe, 13 (Teatinos-Universidad, 29006 Málaga). Pan artesano, bocadillos y café desde 1967. Teléfono 672 75 19 21.';
const ratingLabel = BUSINESS.rating.toFixed(1).replace('.', ',');

const galeria = [
	{
		src: fachada,
		alt: 'Esquina de la panadería Hermanos Marín en la calle Robinson Crusoe, con el rótulo Panadería Pastelería Hnos. Marín y el cartel de tradición familiar desde 1967',
		caption: 'La esquina de Robinson Crusoe, con el rótulo de 1967',
		className: 'gallery-wide',
	},
	{
		src: escaparate,
		alt: 'Escaparate de la panadería con el marco dorado y la puerta de doble hoja, en la calle Robinson Crusoe',
		caption: 'El escaparate y la puerta de la panadería',
		className: 'gallery-half',
	},
	{
		src: pasillo,
		alt: 'Pasillo interior de la cafetería con suelo a cuadros blancos y negros, mesas altas de madera y ventanales a la calle',
		caption: 'El pasillo de mesas altas y el suelo a cuadros',
		className: 'gallery-tall',
	},
	{
		src: mostrador,
		alt: 'Mostrador de la panadería con la vitrina de pan y las estanterías de hogazas al fondo',
		caption: 'El mostrador y la vitrina del pan',
		className: 'gallery-tall',
	},
	{
		src: sala,
		alt: 'Sala de la cafetería con mesas y sillas negras, pizarra de Cafetería Hermanos Marín y suelo a cuadros',
		caption: 'La sala y la pizarra de la cafetería',
		className: 'gallery-tall',
	},
	{
		src: vitrina,
		alt: 'Vitrina de la pastelería y cartel de la casa junto a la puerta interior del local',
		caption: 'La vitrina de la pastelería',
		className: 'gallery-half',
	},
	{
		src: tienda,
		alt: 'Fondo del local con estanterías, neveras de bebidas y el arco de acceso a la trastienda',
		caption: 'El fondo del local y las neveras',
		className: 'gallery-half',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#hermanos-marin`,
	name: BUSINESS.name,
	alternateName: ['Hermanos Marín', 'Panadería Hermanos Marín', 'Cafetería Hermanos Marín'],
	description:
		'Panadería, pastelería y cafetería familiar en C. Robinson Crusoe, 13 (Teatinos-Universidad, 29006 Málaga). Pan artesano, bocadillos y café desde 1967.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 672 75 19 21',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '22:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '08:00',
			closes: '22:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#mostrador' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#193027" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Hermanos Marín, panadería Teatinos, cafetería Teatinos, pan artesano Málaga, bocadillos Teatinos, Robinson Crusoe 13, panadería desde 1967"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería, pastelería y cafetería familiar en Teatinos desde 1967. Pan artesano, bocadillos y café en C. Robinson Crusoe, 13. Teléfono 672 75 19 21."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de la Panadería Cafetería Hermanos Marín en Teatinos, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#193027"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/panaderia-cafeteria-hermanos-marin/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<div class="topbar-inner wrap">
				<a class="brand" href="#inicio" aria-label="Hermanos Marín, inicio">
					<span class="brand-mark" aria-hidden="true">HM</span>
					<span class="brand-name">
						Hermanos Marín
						<small>Panadería · Pastelería · Cafetería</small>
					</span>
				</a>
				<nav class="nav" aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="topbar-phone" href={BUSINESS.phoneHref}>
					<span class="topbar-phone-label">Llamar</span> {BUSINESS.phone}
				</a>
			</div>
			<nav class="mobile-nav wrap" aria-label="Navegación principal en móvil">
				{nav.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Teatinos · Málaga · desde 1967</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-lede">
							En la calle Robinson Crusoe, 13, la familia Marín lleva el oficio del pan
							desde 1967. Hoy es panadería, pastelería y cafetería: pan artesano,
							bocadillos y café en Teatinos.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="button button-ghost" href={BUSINESS.phoneHref}>
								Llamar · {BUSINESS.phone}
							</a>
						</div>
						<div class="hero-facts">
							<div>
								<span>Google</span>
								<strong>{ratingLabel} / 5</strong>
								<small>{BUSINESS.reviewsCount} reseñas</small>
							</div>
							<div>
								<span>Horario</span>
								<strong>7:00–22:00</strong>
								<small>fin de semana, 8:00–22:00</small>
							</div>
							<div>
								<span>Acceso</span>
								<strong>Sillas de ruedas</strong>
								<small>según la ficha</small>
							</div>
						</div>
					</div>

					<figure class="hero-photo">
						<Image
							src={fachada}
							alt="Fachada de la Panadería Cafetería Hermanos Marín en la esquina de la calle Robinson Crusoe, con el rótulo de 1967 y la esquina de la calle al fondo"
							widths={[480, 720, 960, 1200]}
							sizes="(max-width: 980px) 92vw, 44vw"
							format="webp"
							quality={74}
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>
						<span class="photo-stamp" aria-hidden="true">
							<span>Desde</span>
							<strong>1967</strong>
							<span>Teatinos</span>
						</span>
						<figcaption>
							<span>Foto del perfil de Google Maps</span>
							<a href={MAPS.place} target="_blank" rel="noreferrer">Ver la ficha ↗</a>
						</figcaption>
					</figure>
				</div>
				<div class="checker" aria-hidden="true"></div>
			</section>

			<section class="facts" aria-label="Datos de la ficha">
				<div class="wrap facts-grid">
					<div class="fact">
						<span class="fact-kicker">La casa</span>
						<strong>Desde 1967</strong>
						<p>Una tradición familiar que empezó en Comares.</p>
					</div>
					<div class="fact">
						<span class="fact-kicker">El mostrador</span>
						<strong>Pan y café</strong>
						<p>Panadería, pastelería y cafetería en Teatinos.</p>
					</div>
					<div class="fact">
						<span class="fact-kicker">La ficha</span>
						<strong>{ratingLabel} / 5</strong>
						<p>{BUSINESS.reviewsCount} reseñas en Google.</p>
					</div>
					<div class="fact">
						<span class="fact-kicker">El teléfono</span>
						<strong><a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a></strong>
						<p>El número publicado en Google.</p>
					</div>
				</div>
			</section>

			<section class="story wrap" id="casa" aria-labelledby="story-title">
				<div class="story-head">
					<p class="section-label"><span aria-hidden="true"></span> La casa</p>
					<h2 id="story-title">El pan que empezó <em>en Comares.</em></h2>
				</div>
				<div class="story-grid">
					<div class="story-copy">
						<p class="story-lead">
							La ficha de Google cuenta la historia: en 1967, José María Marín empezó a
							repartir pan con ocho años por los senderos y calles de Comares, en la
							provincia de Málaga, con un burro. De aquel oficio nació una tradición
							familiar.
						</p>
						<p>
							La casa se llama Hermanos Marín y en la fachada luce el rótulo
							«Panadería · Pastelería Hnos. Marín», junto al cartel de «50 años» y
							«Tradición familiar desde 1967». En Teatinos, el local es también
							cafetería.
						</p>
						<p>
							El suelo a cuadros, la madera y las vitrinas de pan se ven en las fotos
							del perfil. La ficha no publica carta ni precios; los productos de esta
							web son los que citan las reseñas y muestran las imágenes.
						</p>
						<div class="story-links">
							<a class="simple-link" href={MAPS.place} target="_blank" rel="noreferrer">
								Ficha y reseñas en Google <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href="#fotos">Ver las fotos <span aria-hidden="true">↓</span></a>
						</div>
					</div>

					<aside class="timeline" aria-label="Dos fechas de la casa">
						<div class="timeline-item">
							<span class="timeline-year">1967</span>
							<span class="timeline-place">Comares</span>
							<p>
								José María Marín reparte pan a sus ocho años por los caminos del
								pueblo con un burro.
							</p>
						</div>
						<div class="timeline-line" aria-hidden="true"></div>
						<div class="timeline-item">
							<span class="timeline-year">Hoy</span>
							<span class="timeline-place">Teatinos</span>
							<p>
								La familia atiende la panadería, pastelería y cafetería en la calle
								Robinson Crusoe, 13.
							</p>
						</div>
					</aside>
				</div>
			</section>

			<section class="chips-wrap wrap" aria-label="Lo que ofrece Hermanos Marín">
				<ul class="chips">
					{SERVICIOS.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="highlights" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Tres cosas claras</p>
					<div class="highlights-head">
						<h2 id="highlights-title">Lo que hay <em>en la casa.</em></h2>
						<p>
							La ficha es concreta: una panadería familiar, un teléfono y un horario
							amplio. El resto se ve en el mostrador y en las fotos.
						</p>
					</div>
					<div class="highlights-grid">
						{
							HIGHLIGHTS.map((item) => (
								<article class="highlight">
									<span class="highlight-number">{item.number}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="counter" id="mostrador" aria-labelledby="counter-title">
				<div class="wrap">
					<div class="counter-head">
						<div>
							<p class="section-label"><span aria-hidden="true"></span> El mostrador</p>
							<h2 id="counter-title">Pan, café <em>y bocadillos.</em></h2>
						</div>
						<p>
							Sin carta ni precios publicados. Esto es lo que aparece en las reseñas de
							Google, en el rótulo de la fachada y en las fotografías del perfil.
						</p>
					</div>

					<div class="menu-grid">
						{
							MENU.map((group) => (
								<article class="menu-card">
									<span class="menu-kicker">{group.kicker}</span>
									<h3>{group.title}</h3>
									<ul>
										{group.items.map((item) => (
											<li>
												<strong>{item.name}</strong>
												<span>{item.note}</span>
											</li>
										))}
									</ul>
								</article>
							))
						}
					</div>

					<div class="counter-note">
						<p>
							<strong>No hay precios en esta página.</strong> La panadería no publica
							carta ni web propia. Para saber qué hay cada día, llama al
							<a href={BUSINESS.phoneHref}> {BUSINESS.phone}</a> o pasa por el mostrador.
						</p>
						<a class="button button-primary" href={BUSINESS.phoneHref}>
							Llamar a Hermanos Marín
						</a>
					</div>
				</div>
			</section>

			<section class="gallery wrap" id="fotos" aria-labelledby="gallery-title">
				<div class="gallery-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> La casa en fotos</p>
						<h2 id="gallery-title">El local, <em>por dentro.</em></h2>
					</div>
					<p>
						Siete fotografías del perfil de Google Maps: la esquina, el escaparate, el
						pasillo de mesas altas, el mostrador del pan, la sala y las vitrinas. Son
						imágenes del establecimiento, no de un banco de fotos.
					</p>
				</div>

				<div class="gallery-grid">
					{
						galeria.map((photo) => (
							<figure class:list={['gallery-item', photo.className]}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[420, 640, 960, 1200]}
									sizes="(max-width: 700px) 92vw, (max-width: 980px) 46vw, 30vw"
									format="webp"
									quality={72}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>{photo.caption}</figcaption>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Imágenes del perfil del establecimiento en Google Maps. Si eres titular de
					alguna y quieres retirarla, escríbenos y la borramos.
				</p>
			</section>

			<section class="reviews" aria-labelledby="reviews-title">
				<div class="wrap reviews-grid">
					<div class="reviews-score">
						<span class="score-number">{ratingLabel}</span>
						<span class="score-stars" role="img" aria-label="4,4 de 5 estrellas">★★★★☆</span>
						<span class="score-count">{BUSINESS.reviewsCount} reseñas en Google</span>
					</div>
					<div class="reviews-copy">
						<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que dicen</p>
						<h2 id="reviews-title">«Pan artesano <em>buenísimo</em>»</h2>
						<div class="review-list">
							{
								REVIEWS.map((review) => (
									<figure class="review">
										<blockquote>«{review.text}»</blockquote>
										<figcaption>Reseña de {review.rating} estrellas en Google Maps</figcaption>
									</figure>
								))
							}
						</div>
						<a class="reviews-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer las 31 reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section class="visit wrap" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Visítanos</p>
					<h2 id="visit-title">A un paso <em>de la universidad.</em></h2>
					<p class="address">
						{BUSINESS.street}<br />
						{BUSINESS.district}<br />
						{BUSINESS.postalCode} {BUSINESS.city}
					</p>

					<table class="hours">
						<caption>Horario publicado en Google</caption>
						<tbody>
							{
								HOURS.map((row) => (
									<tr>
										<th scope="row">{row.day}</th>
										<td>{row.value}</td>
									</tr>
								))
							}
						</tbody>
					</table>
					<p class="hours-note">
						Consultado el 28 de octubre de 2026. El 1 de noviembre, Día de Todos los
						Santos, la ficha advierte de que el horario podría ser diferente.
					</p>

					<div class="visit-phone">
						<span>Teléfono</span>
						<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
					</div>

					<div class="visit-links">
						<a class="button button-primary" href={BUSINESS.phoneHref}>Llamar ahora</a>
						<a class="button button-ghost" href={MAPS.directions} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<p class="visit-note">
						La ficha indica acceso para sillas de ruedas. No publica información sobre
						aparcamiento adaptado ni servicio a domicilio.
					</p>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa de Panadería Cafetería Hermanos Marín en la calle Robinson Crusoe, 13, Teatinos, Málaga"
						src={MAPS.embed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={MAPS.place} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Robinson Crusoe, 13 · Teatinos
					</a>
				</div>
			</section>

			<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>entrar.</em></h2>
				<div class="faq-list">
					{
						FAQ.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div class="footer-brand">
						<span class="brand-mark" aria-hidden="true">HM</span>
