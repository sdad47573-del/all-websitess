---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import comedor from '../assets/fotos/bar-taberna-la-new-vertical-01.jpg';
import collage from '../assets/fotos/bar-taberna-la-new-vertical-02.jpg';
import tartar from '../assets/fotos/bar-taberna-la-new-vertical-03.jpg';
import timbale from '../assets/fotos/bar-taberna-la-new-vertical-04.jpg';
import ventanal from '../assets/fotos/bar-taberna-la-new-vertical-05.jpg';
import lomo from '../assets/fotos/bar-taberna-la-new-vertical-06.jpg';
import letrero from '../assets/fotos/bar-taberna-la-new-vertical-07.jpg';
import guiso from '../assets/fotos/bar-taberna-la-new-vertical-08.jpg';
import ostras from '../assets/fotos/bar-taberna-la-new-vertical-09.jpg';
import alcachofas from '../assets/fotos/bar-taberna-la-new-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
} from '../data/site';

const title = 'Taberna la New · Restaurante en Teatinos, Málaga';
const description = BUSINESS.description;

const galeria = [
	{
		src: letrero,
		alt: 'Letrero iluminado de Taberna la New, con el logotipo del león, el lema «Tradición & Actualidad» y una firma, con dos personas preparando una mesa delante',
	},
	{
		src: comedor,
		alt: 'Comedor de Taberna la New con mesas de tablero claro, sillas de terciopelo granate, lámparas de tubo de madera y el letrero del local enmarcado en la pared',
	},
	{
		src: ventanal,
		alt: 'Mesa de Taberna la New junto al ventanal, con vajilla de peces, copas de vino, sillas de terciopelo granate y una lámpara de madera',
	},
	{
		src: alcachofas,
		alt: 'Plato con corazones de alcachofa cubiertos de lonchas de jamón y sésamo negro sobre un fondo de salsa',
	},
	{
		src: tartar,
		alt: 'Tartar con base de aguacate sobre plato de porcelana, con aliño de aioli, migas negras y brotes',
	},
	{
		src: timbale,
		alt: 'Timbale de gambas con salsa rosa y una capa de tartar por encima, con cebollino y sésamo negro, junto a un pan fino',
	},
	{
		src: ostras,
		alt: 'Bola de bronce con ostras abiertas sobre hielo y un cuchillo de abrir, sostenida por una mano con guante negro',
	},
	{
		src: guiso,
		alt: 'Plato de carne guisada con su salsa sobre patatas fritas y una rama de tomillo, con panecillos al fondo',
	},
	{
		src: lomo,
		alt: 'Mesa de Taberna la New con un plato de lonchas de lomo y una porción de mostaza, cesta de pan, botella de Coca-Cola y copas de vino',
	},
	{
		src: collage,
		alt: 'Composición de seis fotografías de la casa: corte de jamón, platos de jamón, estantería de botellas, servicio de copa de vino y ostras sobre hielo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#taberna-la-new`,
	name: BUSINESS.name,
	alternateName: ['La New', 'Taberna la New Málaga', 'Taberna la New Teatinos'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Mediterránea', 'De mercado'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: `${BUSINESS.street}, ${BUSINESS.local}`,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '12:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '20:00',
			closes: '24:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"bar-taberna-la-new-vertical-01.jpg": comedor,
	"bar-taberna-la-new-vertical-07.jpg": letrero,
	"bar-taberna-la-new-vertical-05.jpg": ventanal,
	"bar-taberna-la-new-vertical-10.jpg": alcachofas,
	"bar-taberna-la-new-vertical-03.jpg": tartar,
	"bar-taberna-la-new-vertical-04.jpg": timbale,
	"bar-taberna-la-new-vertical-09.jpg": ostras,
	"bar-taberna-la-new-vertical-08.jpg": guiso,
	"bar-taberna-la-new-vertical-06.jpg": lomo,
	"bar-taberna-la-new-vertical-02.jpg": collage,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#48102a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;0,6..96,700;1,6..96,500&family=Jost:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Taberna la New, Taberna la New Málaga, restaurante Teatinos, restaurante Málaga, comer en Teatinos, jamón cortado a cuchillo Málaga, ostras Málaga, Av. de Gregorio Prieto 19"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina de taberna en la Av. de Gregorio Prieto 19, local 2, en Teatinos (Málaga). Todos los días de 12:00 a 16:00 y de 20:00 a 24:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Comedor de Taberna la New con el letrero iluminado del local"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#48102a"
			street={`${BUSINESS.street}, ${BUSINESS.local}`}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Teatinos, Málaga"
			locale="es_ES"
			countryName="España"
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/bar-taberna-la-new/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Taberna la New"
			subtitle="Teatinos · Málaga"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y oferta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Taberna la New"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34611672197?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20M%C3%A1laga." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Málaga"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
