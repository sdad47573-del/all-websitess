---
import { Image } from 'astro:assets';
import { BUSINESS, IMAGES } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
---

<section id="inicio" class="hero-fonda relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.fotoApaisada4}
			alt="La Fonda, en Alagón del Río"
			widths={[640, 1100, 1600]}
			sizes="100vw"
			quality={68}
			loading="eager"
			fetchpriority="high"
			class="h-full w-full object-cover opacity-25"
		/>
		<div class="from-neutral/95 via-neutral/70 absolute inset-0 bg-gradient-to-r"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
		<div class="grid items-center gap-14 lg:grid-cols-[1fr_0.9fr]">
			<div>
				<p class="text-accent inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase">
					<span>
						<i class="ri-map-pin-line"></i> Alagón del Río · Cáceres
					</span>
					<span class="text-white/50">Valle del Alagón</span>
				</p>

				<h1 class="font-display mt-4 text-6xl leading-[0.95] sm:text-7xl lg:text-8xl">
					La <span class="text-accent">Fonda</span>
				</h1>

				<p class="mt-6 max-w-xl text-base leading-relaxed text-white/80 sm:text-lg">
					El bar de siempre en la calle Guadalquivir: café y cerveza en la barra, cocina casera
					cuando abre la mesa y sobremesa hasta la medianoche.
				</p>

				<div class="mt-7 flex flex-wrap items-center gap-3">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="badge badge-lg gap-2 border-white/20 bg-white/10 px-4 py-3 text-sm font-semibold text-white"
					>
						<span class="text-accent tracking-tight" aria-hidden="true">
							{estrellas.map((n) => (
								<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
							))}
						</span>
						{BUSINESS.rating.toString().replace('.', ',')} · {BUSINESS.reviewCount} reseñas en
						Google
					</a>
				</div>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-secondary btn-lg gap-2 rounded-full">
						<i class="ri-phone-line text-xl"></i>
						{BUSINESS.phone}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-lg gap-2 rounded-full border-white/35 bg-transparent text-white hover:border-white hover:bg-white hover:text-neutral"
					>
						<i class="ri-google-fill"></i>
						Ver ficha de Google
					</a>
				</div>

				<dl class="mt-10 grid gap-x-6 gap-y-5 border-t border-white/15 pt-7 sm:grid-cols-3">
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Horario</dt>
						<dd class="mt-1 text-base font-bold">12:00 – 24:00</dd>
						<dd class="text-xs text-white/55">Martes a domingo · lunes cerrado</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">La barra</dt>
						<dd class="mt-1 text-base font-bold">Café y copas</dd>
						<dd class="text-xs text-white/55">Cocina casera y tapas</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Dónde</dt>
						<dd class="mt-1 text-base font-bold">{BUSINESS.street}</dd>
						<dd class="text-xs text-white/55">
							{BUSINESS.postalCode} {BUSINESS.city}
						</dd>
					</div>
				</dl>
			</div>

			<figure class="relative mx-auto w-full max-w-md pb-10 lg:max-w-none">
				<div class="relative rotate-[-2deg] rounded-sm border-8 border-base-100 bg-base-100 shadow-2xl">
					<Image
						src={IMAGES.fotoApaisada2}
						alt="Interior de La Fonda en Alagón del Río"
						widths={[420, 720]}
						sizes="(min-width: 1024px) 36vw, 88vw"
						quality={85}
						loading="eager"
						class="foto-calida aspect-[4/3] w-full object-cover"
					/>
					<figcaption class="text-neutral/60 px-1 pt-2 pb-1 text-[0.65rem] tracking-wide">
						La barra, a media tarde
					</figcaption>
				</div>

				<div class="border-base-100 bg-base-100 absolute -bottom-2 left-1 w-32 rotate-[4deg] rounded-sm border-8 shadow-xl sm:-left-3 sm:w-40">
					<Image
						src={IMAGES.fotoVertical6}
						alt="Rincón de La Fonda"
						widths={[200, 320]}
						sizes="160px"
						quality={85}
						loading="lazy"
						class="foto-calida aspect-[3/4] w-full object-cover"
					/>
				</div>

				<div class="sello-fonda bg-primary absolute -top-6 right-0 flex size-24 rotate-6 flex-col items-center justify-center rounded-full text-center sm:-right-4 sm:size-28">
					<i class="ri-sun-line text-accent text-2xl" aria-hidden="true"></i>
					<span class="mt-1 text-[0.55rem] leading-tight tracking-[0.14em] text-white/75 uppercase">
						desde
						<br />
						el mediodía
					</span>
				</div>
			</figure>
		</div>
	</div>

	<div class="cenefa-fonda relative h-3 w-full"></div>
</section>
