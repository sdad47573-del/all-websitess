		<meta property="og:locale" content="es_ES" />
			<meta property="og:title" content="La Casa del Pulpo" />
		<meta property="og:description" content="La Casa del Pulpo." />
	</head>
	<body>
		<header>
			<h1 set:html={piezas.portada.titulo} />
			<a href={MAPS_URL} rel="noopener" target="_blank">Ver en Google Maps</a>
		</header>

		<main>
			<section class="galeria">
				{fotos.map((foto) => <Image src={foto} alt="La Casa del Pulpo" loading="lazy" />)}
