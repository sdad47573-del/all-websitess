---
import { Image } from 'astro:assets';
import foto02 from '../assets/fotos/la-casa-del-pulpo-apaisada-02.jpg';
import foto05 from '../assets/fotos/la-casa-del-pulpo-panoramica-05.jpg';
import foto10 from '../assets/fotos/la-casa-del-pulpo-panoramica-10.jpg';
import foto03 from '../assets/fotos/la-casa-del-pulpo-vertical-03.jpg';
import foto04 from '../assets/fotos/la-casa-del-pulpo-vertical-04.jpg';
import foto06 from '../assets/fotos/la-casa-del-pulpo-vertical-06.jpg';
import foto07 from '../assets/fotos/la-casa-del-pulpo-vertical-07.jpg';
import foto08 from '../assets/fotos/la-casa-del-pulpo-vertical-08.jpg';
import foto09 from '../assets/fotos/la-casa-del-pulpo-vertical-09.jpg';
import foto01 from '../assets/fotos/la-casa-del-pulpo-vista-1-01.jpg';

const fotos = [foto01, foto02, foto05, foto10, foto03, foto04, foto06, foto07, foto08, foto09];

const MAPS_URL =
	'https://www.google.com/maps/place/La+Casa+del+Pulpo/@38.0287778,-1.2452405,17z/data=!3m1!4b1!4m6!3m5!1s0xd647fd129126a49:0x2615c67de8d49cf3!8m2!3d38.0287778!4d-1.2452405!16s%2Fg%2F11g0hm_nnz?authuser=0&hl=es&entry=ttu';
const CREDIT_URL = 'https://sur-digital.vercel.app/';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>La Casa del Pulpo</title>
		<meta name="description" content="La Casa del Pulpo." />
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"@id": "https://www.sur-digital.com/la-casa-del-pulpo/#negocio",
	"name": "La casa del pulpo",
	"url": "https://www.sur-digital.com/la-casa-del-pulpo/",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 38.0287778,
		"longitude": -1.2452405
	},
	"hasMap": "https://www.google.com/maps/place/La+Casa+del+Pulpo/@38.0287778,-1.2452405,17z/data=!3m1!4b1!4m6!3m5!1s0xd647fd129126a49:0x2615c67de8d49cf3!8m2!3d38.0287778!4d-1.2452405!16s%2Fg%2F11g0hm_nnz?authuser=0&hl=es&entry=ttu"
}
</script>
		<meta property="og:image" content="https://www.sur-digital.com/la-casa-del-pulpo/og.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
