---
import Contact from '../components/Contact.astro';
import Fab from '../components/Fab.astro';
import Footer from '../components/Footer.astro';
import Topbar from '../components/Topbar.astro';
import { breadcrumbs } from '../data/schema';
import { BUSINESS, SERVICIOS_DETALLE } from '../data/site';
import Layout from '../layouts/Layout.astro';

const titulo = 'La casa · Bodega de Jesús, Zaragoza';
const descripcion = `Tapas, raciones y vino en Rodrigo Díaz de Vivar 4 (Zaragoza). La carta del día, en el local.`;
const h1 = 'La casa';

const catalogoSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: `${BUSINESS.name}: servicios`,
	itemListElement: SERVICIOS_DETALLE.flatMap((seccion, indiceSeccion) =>
		seccion.items.map((item, indice) => ({
			'@type': 'ListItem',
			position: indiceSeccion * 100 + indice + 1,
			item: {
				'@type': 'Service',
				name: item.nombre,
				description: `${item.nombre} en ${BUSINESS.name}`,
				areaServed: BUSINESS.city,
				provider: { "@type": "BeautySalon", name: BUSINESS.name },
			},
		})),
	),
};
---

<Layout
	title={titulo}
	description={descripcion}
	path="/la-bodega-de-jesus/servicios"
	keywords={`${titulo}, taberna Zaragoza, tapas Rodrigo Díaz`}
	schema={[
		breadcrumbs([
			{ name: 'Inicio', path: '/la-bodega-de-jesus/' },
			{ name: h1, path: '/la-bodega-de-jesus/servicios' },
		]),
		catalogoSchema,
	]}
>
	<Topbar base="/la-bodega-de-jesus/" />
	<main>
		<section class="hero-astyle text-white">
			<div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
				<nav class="mb-6 text-xs text-white/60" aria-label="Migas de pan">
					<a href="/la-bodega-de-jesus/" class="hover:text-accent">Inicio</a><span class="mx-2">/</span><span
						class="text-white/90">{h1}</span
					>
				</nav>
				<span class="text-accent text-xs font-semibold tracking-[0.2em] uppercase">
					{BUSINESS.district} · {BUSINESS.city}
				</span>
				<h1 class="font-display mt-3 text-4xl font-bold sm:text-5xl">{h1}</h1>
				<p class="font-display mt-3 text-xl font-semibold text-white/85">
					{BUSINESS.name}, en {BUSINESS.city}
				</p>
				<p class="mt-5 max-w-2xl leading-relaxed text-white/75">
					Sin carta online: los precios están en el local.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-secondary gap-2 rounded-full"
					>
						<i class="ri-google-fill"></i> Ver ficha de Google
					</a>
					<a
						href="/la-bodega-de-jesus/#contacto"
						class="btn btn-outline hover:text-neutral rounded-full border-white/40 bg-white/5 text-white hover:border-white hover:bg-white"
					>
						<i class="ri-map-pin-line"></i> Cómo llegar
					</a>
				</div>
			</div>
		</section>

		<div class="bg-base-200 py-14 sm:py-20">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				{
					SERVICIOS_DETALLE.map((seccion) => (
						<div class="mb-14 last:mb-0">
							<h2 class="font-display text-3xl font-bold sm:text-4xl">{seccion.grupo}</h2>
							<div class="astyle-divider mt-4 h-px w-24" />
							<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
								{seccion.items.map((item) => (
									<article class="etiqueta-astyle rounded-box border-base-300 bg-base-100 border p-6">
										<h3 class="text-lg font-bold">{item.nombre}</h3>
										<p class="text-primary mt-2 text-sm font-bold">{item.precio}</p>
									</article>
								))}
							</div>
						</div>
					))
				}
			</div>
		</div>

		<Contact />
	</main>
	<Footer />
	<Fab />
</Layout>
