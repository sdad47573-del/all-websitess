		<meta property="og:site_name" content="Restaurante La Barbacana" />
		<meta property="og:title" content="Aviso legal y privacidad | Restaurante La Barbacana" />
		<meta property="og:description" content="Información legal y política de privacidad del Restaurante La Barbacana en Marbella." />
