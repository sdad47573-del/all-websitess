---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/bar-restaurante-belartza-apaisada-03.jpg';
import salon from '../assets/fotos/bar-restaurante-belartza-vertical-01.jpg';
import albondigas from '../assets/fotos/bar-restaurante-belartza-vertical-02.jpg';
import guisantes from '../assets/fotos/bar-restaurante-belartza-vertical-04.jpg';
import entrecot from '../assets/fotos/bar-restaurante-belartza-vertical-05.jpg';
import torreznos from '../assets/fotos/bar-restaurante-belartza-vertical-06.jpg';
import arrozLeche from '../assets/fotos/bar-restaurante-belartza-vertical-07.jpg';
import pizarra from '../assets/fotos/bar-restaurante-belartza-vertical-09.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Bar Restaurante Belartza, en Gurutzegi Kalea 15 (polígono Belartza, Donostia). Desayunos, pintxos, platos combinados y menú del día por 16 €. Tel. 943 53 98 49.';

const title = 'Bar Restaurante Belartza · Menú del día en Donostia';

const galeria = [
	{
		src: comedor,
		alt: 'Comedor del Bar Restaurante Belartza con mesas de madera, sillas grises y barra de obra al fondo',
	},
	{
		src: pizarra,
		alt: 'Pizarra del menú del día de Belartza con primeros, segundos y postre, pan y bebida por 16 euros',
	},
	{
		src: albondigas,
		alt: 'Albóndigas en salsa con patatas servidas en un plato hondo del Bar Restaurante Belartza',
	},
	{
		src: entrecot,
		alt: 'Entrecot con salsa de queso, patatas fritas y pimientos del piquillo en Belartza',
	},
	{
		src: salon,
		alt: 'Mesas y sillas del salón de Belartza bajo el techo negro con lámparas colgantes',
	},
	{
		src: guisantes,
		alt: 'Patatas y guisantes estofados en un plato blanco del menú del día de Belartza',
	},
	{
		src: torreznos,
		alt: 'Torreznos de cerdo crujientes servidos en un plato blanco en la terraza de Belartza',
	},
	{
		src: arrozLeche,
		alt: 'Arroz con leche casero con canela en una copa de cristal, postre del menú de Belartza',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#belartza`,
	name: BUSINESS.name,
	alternateName: ['Belartza', 'Bar Belartza', 'Bar Restaurante Belartza SL'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 943 53 98 49',
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Vasca', 'Española', 'Cocina de bar'],
	areaServed: [
		{ '@type': 'City', name: 'Donostia / San Sebastián' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: `${BUSINESS.city} / ${BUSINESS.municipality}`,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:00',
			closes: '18:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Se admiten perros',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const nota = BUSINESS.rating.toFixed(1).replace('.', ',');
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f5459" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Bar Restaurante Belartza, bar polígono Belartza, menú del día Donostia, comer en Belartza, desayunos Donostia, pintxos Donostia, platos combinados San Sebastián, bar para trabajadores Donostia"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Bar Restaurante Belartza · Menú del día en Donostia"
			ogDescription="Desayunos, pintxos, platos combinados y menú del día por 16 € en Gurutzegi Kalea 15, polígono Belartza (Donostia). Tel. 943 53 98 49."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Comedor del Bar Restaurante Belartza en el polígono Belartza de Donostia"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2f5459"
			street={BUSINESS.street}
			city={`${BUSINESS.city} / ${BUSINESS.municipality}`}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34943539849"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city} / ${BUSINESS.municipality}`}
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="BAR RESTAURANTE BELARTZA"
			subtitle="Polígono Belartza · Donostia"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Gurutzegi Kalea, 15 · Polígono Belartza"
				title="Desayunos, pintxos<br /><em>y menú del día.</em>"
				lede={`Bar Restaurante Belartza es el bar de Gurutzegi Kalea, 15, en el polígono Belartza de Donostia. Desayunos desde las 8:00, pinchos, bocadillos, platos combinados y menú del día casero por 16 € con postre, pan y bebida. Abre de lunes a viernes. ${nota} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={comedor}
				imageAlt="Comedor del Bar Restaurante Belartza con mesas de madera, sillas grises y barra de obra al fondo"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${nota}</b> en Google (${BUSINESS.reviewsCount} reseñas)` },
					{ label: 'Menú', html: '<b>16 €</b> con postre, pan y bebida' },
					{ label: 'Horario', html: 'L–V de 8:00 a 18:30 · fin de semana cerrado' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece el Bar Restaurante Belartza" items={[...SERVICIOS]} />

			<LocalAbout
				label="La casa"
				title="El bar del polígono,<br /><em>a la hora de comer.</em>"
				paragraphs={[
					'El Bar Restaurante Belartza está en Gurutzegi Kalea, 15, bajo local A4, en el 20018 Donostia / San Sebastián. Se presenta como uno de los bares de referencia del polígono Belartza, la zona industrial de la ciudad, y trabaja con los turnos de la jornada laboral: desayunos desde primera hora y comida al mediodía para trabajadores y empresas.',
					'Abre de lunes a viernes, de 8:00 a 18:30, y cierra sábados y domingos. El comedor es amplio, con mesas de madera, sillas grises, barra de obra con botellas a la vista, techo negro con lámparas colgantes y una pantalla encendida al fondo.',
					'La cocina es de casa. Su pizarra anuncia el menú del día por 16 € con postre, pan y bebida, y por ella pasan primeros como lentejas, espaguetis a la carbonara, ensalada mixta, templada de gulas o menestra de verduras, y segundos como filete con patatas, pechugas con ensalada, hamburguesa con patatas y ensalada o pimientos rellenos de bacalao.',
					'En las fotos de su perfil de Google aparecen también las albóndigas en salsa, el entrecot con salsa de queso y pimientos del piquillo, las patatas con guisantes, los torreznos y el arroz con leche. La ficha marca acceso para sillas de ruedas, aparcamiento adaptado y que se admiten perros.',
					`Tiene ${nota} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google. Las publicadas hablan de «buena comida, buenos pintxos y buen café» y de volver.`,
				]}
				note="La ficha de Google no publica carta ni precios: el menú de 16 € y los platos de esta página son los que aparecen en la pizarra y en las fotos del propio establecimiento. El menú cambia cada día."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Desayunos,<br /><em>menú y barra.</em>"
				description="La ficha de Google no publica carta. Esto es lo que el bar anuncia en su descripción, lo que anota en su pizarra y lo que se ve en sus fotos; el menú del día cambia cada jornada."
				cta={{ label: `Preguntar el menú: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={[...MENU]}
				note="El menú del día cuesta 16 € con postre, pan y bebida, según la pizarra del propio bar y un ticket de junio de 2026 que aparece entre sus fotos. Confirma el menú y el precio del día al llamar."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor,<br /><em>la pizarra y los platos.</em>"
				description="Estas fotografías proceden del perfil del Bar Restaurante Belartza en Google Maps: el comedor con su barra, la pizarra del menú, las albóndigas, el entrecot, las patatas con guisantes, los torreznos y el arroz con leche."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Gurutzegi Kalea, 15,<br /><em>en Belartza.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city} / ${BUSINESS.municipality}`,
					'Gipuzkoa · País Vasco',
				]}
				hours={[...HOURS]}
				hoursNote="Horario de la ficha de Google: de lunes a viernes, de 8:00 a 18:30, y cerrado sábados y domingos. Sigue el calendario laboral del polígono, así que puede cambiar en festivos; conviene llamar antes."
				mapTitle="Mapa del Bar Restaurante Belartza en Gurutzegi Kalea, 15, polígono Belartza (Donostia)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Bar Restaurante Belartza · Donostia"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 943 53 98 49. La ficha de Google marca acceso para sillas de ruedas y aparcamiento adaptado, y añade que se admiten perros. El bar está en una calle del polígono Belartza, con el aparcamiento habitual de la zona industrial."
			/>

			<LocalFaq items={[...FAQ]} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/bar-restaurante-belartza/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, menú y precios antes de la visita."
			ctaLabel="Llamar a Belartza"
		/>
	</body>
</html>
