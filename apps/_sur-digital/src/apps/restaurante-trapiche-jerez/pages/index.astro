---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/restaurante-trapiche-jerez-apaisada-01.jpg';
import foto1 from '../assets/fotos/restaurante-trapiche-jerez-apaisada-02.jpg';
import foto2 from '../assets/fotos/restaurante-trapiche-jerez-apaisada-03.jpg';
import foto3 from '../assets/fotos/restaurante-trapiche-jerez-apaisada-04.jpg';
import foto4 from '../assets/fotos/restaurante-trapiche-jerez-vertical-06.jpg';
import foto5 from '../assets/fotos/restaurante-trapiche-jerez-apaisada-05.jpg';

const business = {
	name: 'Restaurante TRAPICHE',
	street: 'Pl. Rafael Rivero, 3',
	city: 'Jerez de la Frontera',
	region: 'Andalucía',
	province: 'Cádiz',
	postalCode: '11403',
	phone: '+34 646 50 66 87',
	latitude: 36.6859281,
	longitude: -6.1378635,
	site: 'https://www.sur-digital.com/restaurante-trapiche-jerez',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+TRAPICHE/data=!4m7!3m6!1s0xd0dc696f4d14d31:0xc99146936f4a4941!8m2!3d36.6859281!4d-6.1378635!16s%2Fg%2F11f55zygzc!19sChIJMU3R9JbGDQ0RQUlKb5NGkck?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34646506687';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'El que citan',
		title: 'Pollo al chimichurri',
		text: 'Pollo al chimichurri con unas papas: la comida que sus clientes dicen que estuvo muy rica.',
	},
	{
		kicker: 'Generosas',
		title: 'Medias raciones enormes',
		text: 'Precios económicos y medias raciones enormes: ideal para compartir en la plaza Rafael Rivero.',
	},
	{
		kicker: 'Caseras',
		title: 'Albóndigas',
		text: 'Ricas albóndigas con buen precio y buen trato: cocina sencilla que cumple.',
	},
	{
		kicker: 'La casa',
		title: 'Cocina argentina',
		text: 'Restaurante argentino en pleno centro de Jerez: carnes, papas y raciones para compartir.',
	},
	{
		kicker: 'A diario',
		title: 'Mediodía y noche',
		text: 'De lunes a sábado abre de 12:00 a 16:30 y de 20:00 a 23:30; el domingo, de 12:00 a 17:00.',
	},
	{
		kicker: 'Aviso',
		title: 'Domingo solo mediodía',
		text: 'El domingo cierra por la tarde (12:00–17:00). Si vienes en festivo, llama antes.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de Restaurante TRAPICHE publicada en su ficha de Google Maps (Jerez de la Frontera)' },
	{ src: photos.foto2, alt: 'Interior de Restaurante TRAPICHE, en la plaza Rafael Rivero, Jerez' },
	{ src: photos.foto3, alt: 'Fotografía de Restaurante TRAPICHE en Jerez de la Frontera, desde Google Maps' },
	{ src: photos.foto4, alt: 'Imagen de Restaurante TRAPICHE (Jerez) subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Detalle de Restaurante TRAPICHE según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está Restaurante TRAPICHE?',
		a: 'En la plaza Rafael Rivero, 3, 11403 Jerez de la Frontera (Cádiz). Coordenadas 36.6859281, -6.1378635.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De lunes a sábado de 12:00 a 16:30 y de 20:00 a 23:30. Domingo de 12:00 a 17:00. Confirma festivos por teléfono.',
	},
	{
		q: '¿Cómo reservo mesa?',
		a: 'Llamando al 646 50 66 87. Con medias raciones enormes y precios económicos, para grupos conviene llamar con antelación.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Cocina argentina: pollo al chimichurri con papas, ricas albóndigas y medias raciones enormes para compartir.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca asientos y aparcamiento adaptados para sillas de ruedas. Para necesidades concretas, llama antes.',
	},
];

const images = [
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'Restaurante TRAPICHE en Jerez (plaza Rafael Rivero, 3): cocina argentina, pollo al chimichurri y raciones enormes. Reserva en el 646 50 66 87.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 646 50 66 87',
	image: images,
	priceRange: '€',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo, tarjeta de crédito',
	servesCuisine: ['Argentina', 'Parrilla', 'Española', 'Tapas'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '12:00',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '20:00',
			closes: '23:30',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '12:00', closes: '17:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Ideal para grupos', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.4,
		reviewCount: 211,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1b1714" />
		<meta
			name="description"
			content="Restaurante TRAPICHE en Jerez: cocina argentina, pollo al chimichurri y raciones enormes en la plaza Rafael Rivero, 3. Reserva en el 646 50 66 87."
		/>
		<meta
			name="keywords"
			content="Restaurante TRAPICHE Jerez, plaza Rafael Rivero restaurante, cocina argentina Jerez, pollo chimichurri, medias raciones Jerez"
		/>
		<meta name="author" content="Restaurante TRAPICHE" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/restaurante-trapiche-jerez/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Restaurante TRAPICHE | Cocina argentina en Jerez</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Restaurante TRAPICHE · Cocina argentina en Jerez" />
		<meta
			property="og:description"
			content="Pollo al chimichurri, albóndigas y medias raciones enormes en la plaza Rafael Rivero, 3 (Jerez)."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="Restaurante TRAPICHE, en Jerez de la Frontera" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Restaurante TRAPICHE · Cocina argentina en Jerez" />
		<meta
			name="twitter:description"
			content="Cocina argentina en la plaza Rafael Rivero, 3 (Jerez): chimichurri y raciones enormes."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Jerez de la Frontera" />
		<meta name="geo.position" content="36.6859281;-6.1378635" />
		<meta name="ICBM" content="36.6859281, -6.1378635" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Restaurante TRAPICHE, inicio">
				<span class="brand-mark" aria-hidden="true">T</span>
				<span class="brand-name">Restaurante TRAPICHE <small>Jerez · Rivero</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#trapiche">Trapiche</a>
				<a href="#especialidades">Especialidades</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>646 50 66 87</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Plaza Rivero · Jerez</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante TRAPICHE en la plaza Rafael Rivero: pollo al chimichurri con papas, ricas albóndigas y
						medias raciones enormes a precios económicos. Para compartir en el centro.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>
							Reservar 646 50 66 87
						</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,4</b> en Google (211 reseñas)</li>
						<li>Chimichurri</li>
						<li>Raciones enormes</li>
						<li>Económico</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="webp"
						quality={70}
						alt="Fotografía de Restaurante TRAPICHE publicada en su ficha de Google Maps (Jerez de la Frontera)"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,4</b><span>Google</span></div>
					<div><b>211</b><span>Reseñas</span></div>
					<div><b>7/7</b><span>Días</span></div>
				</div>
				<ul class="services">
					<li>Argentina</li>
					<li>Parrilla</li>
					<li>Local accesible</li>
					<li>Grupos</li>
					<li>Reservas</li>
					<li>Terraza</li>
				</ul>
			</section>

			<section class="about section-pad" id="trapiche">
				<p class="section-label"><span aria-hidden="true"></span> Un argentino en Jerez</p>
				<div class="about-grid">
					<h2>Rico y económico<br />en la plaza Rivero<br /><em>para compartir.</em></h2>
					<div class="about-copy">
						<p>
							Restaurante TRAPICHE está en la plaza Rafael Rivero, 3, 11403 Jerez de la Frontera (Cádiz).
							Restaurante argentino en pleno centro.
						</p>
						<p>
							Lo que más citan sus clientes: comida muy rica con pollo al chimichurri y papas, precios económicos
							con medias raciones enormes, y buen precio, buen trato y ricas albóndigas.
						</p>
						<p class="about-note">
							Sobre el horario: la ficha de Google Maps marca de lunes a sábado de 12:00 a 16:30 y de 20:00 a 23:30,
							y domingo de 12:00 a 17:00. Si vienes en festivo, llama antes.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="especialidades">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su carta</p>
						<h2>Lo que más<br />se pide <em>en la mesa.</em></h2>
					</div>
					<p>
						Platos citados en las reseñas de sus clientes. La carta cambia, así que confirma disponibilidad al
						reservar.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>Trapiche<br /><em>por dentro.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Restaurante TRAPICHE. En la ficha
							encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="webp"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres
					el titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Pl. Rafael Rivero, 3</p>
					<h2>Ven al Trapiche<br /><em>a Jerez.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes a sábado</th>
								<td>12:00 – 16:30 · 20:00 – 23:30</td>
							</tr>
							<tr>
								<th scope="row">Domingo</th>
								<td>12:00 – 17:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, llama antes de
						venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>
							Llamar 646 50 66 87
						</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 646 50 66 87</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Restaurante TRAPICHE en la plaza Rafael Rivero, 3, Jerez de la Frontera"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Restaurante TRAPICHE · Jerez
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">T</span>
				<p>Restaurante TRAPICHE<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Restaurante TRAPICHE · Jerez de la Frontera. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>

			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/restaurante-trapiche-jerez/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/restaurante-trapiche-jerez/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/restaurante-trapiche-jerez/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al Trapiche <span>646 50 66 87</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/restaurante-trapiche-jerez/aviso-legal">Aviso legal</a>
			<a href="/restaurante-trapiche-jerez/aviso-legal#privacidad">Privacidad</a>
			<a href="/restaurante-trapiche-jerez/aviso-legal#cookies">Cookies</a>
		</nav>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
