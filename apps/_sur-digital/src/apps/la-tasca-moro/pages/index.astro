---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import mariscada from '../assets/fotos/la-tasca-moro-panoramica-01.jpg';
import bocadillo from '../assets/fotos/la-tasca-moro-apaisada-02.jpg';
import calamares from '../assets/fotos/la-tasca-moro-apaisada-04.jpg';
import parrillada from '../assets/fotos/la-tasca-moro-apaisada-06.jpg';
import pescado from '../assets/fotos/la-tasca-moro-apaisada-08.jpg';
import fideua from '../assets/fotos/la-tasca-moro-vertical-03.jpg';
import pulpo from '../assets/fotos/la-tasca-moro-vertical-05.jpg';
import huevos from '../assets/fotos/la-tasca-moro-vertical-07.jpg';

import { cidUrl, mapsUrl, placeId, reviewsUrl } from '../maps';

const business = {
	name: 'La Tasca',
	brand: 'La Tasca',
	street: "Carrer d'Àngel Pallarés, 14",
	city: 'Sant Joan de Moró',
	region: 'Castelló',
	postalCode: '12130',
	phone: '623 11 60 45',
	latitude: 40.0585697,
	longitude: -0.1357897,
	rating: 4.4,
	reviewsCount: 269,
	site: 'https://www.sur-digital.com/la-tasca-moro',
};

const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34623116045';

const description =
	'La Tasca, bar restaurante familiar en Sant Joan de Moró (Castelló): menú diario de 9 €, almuerzo a la brasa de 5 € y cocina casera.';

const servicios = [
	'Menú del día',
	'Almuerzos',
	'Brasa y parrillada',
	'Mariscos',
	'Fideuà y arroces',
	'Cocina casera',
	'Montaditos',
	'Bar familiar',
	'Reservas por teléfono',
];

const grupos = [
	{
		title: 'El menú del día',
		items: [
			{
				name: 'Menú diario',
				note: '9 €, según la descripción del propio local en su ficha de Google',
			},
			{
				name: 'Platos del día',
				note: 'cambia cada jornada; la ficha no detalla la lista de cada día',
			},
		],
	},
	{
		title: 'Almuerzos',
		items: [
			{
				name: 'Almuerzo a la brasa',
				note: '5 €, según la ficha del restaurante',
			},
			{
				name: 'Montaditos, jamón y morro de cerdo',
				note: 'un día a la semana, por cuenta de la casa, como anuncia el local',
			},
		],
	},
	{
		title: 'De la brasa',
		items: [
			{
				name: 'Parrillada',
				note: 'carnes a la brasa para compartir; «la parrillada exquisita», dice una reseña',
			},
			{
				name: 'Sepia con patatas',
				note: 'a la plancha, con patatas; la recomienda otra reseña',
			},
		],
	},
	{
		title: 'Del mar y del horno',
		items: [
			{
				name: 'Mariscada',
				note: 'gambas, cigalas, mejillones y calamar en bandeja, para compartir',
			},
			{
				name: 'Fideuà',
				note: 'fideos finos con marisco, servida en su paella',
			},
			{
				name: 'Pulpo a la gallega',
				note: 'con patata y pimentón, en plato hondo',
			},
			{
				name: 'Huevos con pimientos y embutido',
				note: 'a la plancha, en fuentes para el centro de la mesa',
			},
		],
	},
	{
		title: 'Ensaladas y postre',
		items: [
			{
				name: 'Ensalada de la casa',
				note: 'con tomate, cebolla y olivas; «una muy buena ensalada», según las reseñas',
			},
			{
				name: 'Postres caseros',
				note: 'y café o copa para terminar; la ficha no publica la lista',
			},
		],
	},
];

const galeria = [
	{
		src: parrillada,
		alt: 'Parrillada de carnes a la brasa con tomates asados en La Tasca, Sant Joan de Moró',
	},
	{
		src: fideua,
		alt: 'Fideuà de marisco con gambas y mejillones en su paella, en La Tasca',
	},
	{
		src: pulpo,
		alt: 'Pulpo a la gallega con pimentón en La Tasca, Sant Joan de Moró',
	},
	{
		src: calamares,
		alt: 'Calamar y gambas a la plancha con ensalada en La Tasca',
	},
	{
		src: pescado,
		alt: 'Lomo de pescado a la plancha con patatas y ensalada en La Tasca',
	},
	{
		src: huevos,
		alt: 'Fuente de huevos fritos con pimientos y embutido en La Tasca',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo de embutido con queso en La Tasca, Sant Joan de Moró',
	},
];

const faqs = [
	{
		q: '¿Dónde está La Tasca?',
		a: "En el número 14 de la calle Àngel Pallarés, en Sant Joan de Moró (12130), en la Plana Alta. Es un bar restaurante familiar de pueblo, con comedor y mesas para grupos. El botón «Cómo llegar» abre la ruta exacta en Google Maps.",
	},
	{
		q: '¿Cuánto cuesta comer?',
		a: 'El local lo indica en su propia ficha de Google: el menú diario cuesta 9 € y el almuerzo a la brasa, 5 €. El resto de la carta no está publicada, así que las raciones, los mariscos y las parrilladas se consultan por teléfono o en el local. Esta web no inventa precios.',
	},
	{
		q: '¿Qué horario tiene?',
		a: 'El lunes abre de 8:30 a 13:30; de martes a jueves, de 8:30 a 16:00; y de viernes a domingo, de 8:30 a 24:00. Es horario corrido, sin cierre a mediodía, y los fines de semana alarga hasta la noche. En fiestas del pueblo conviene llamar antes al 623 11 60 45.',
	},
	{
		q: '¿Qué se come en La Tasca?',
		a: 'Cocina casera de bar restaurante: menú del día, almuerzos a la brasa, parrillada de carnes, mariscada, fideuà, pulpo a la gallega, sepia con patatas, pescado a la plancha, huevos con pimientos y embutido, y ensaladas. Las reseñas destacan las raciones generosas y el precio razonable.',
	},
	{
		q: '¿Hay menú del día todos los días?',
		a: 'Sí, el menú diario forma parte de la oferta habitual del local, a 9 €. Los platos cambian cada jornada y no están publicados en Google, así que lo que toque ese día se pregunta al llegar o por teléfono.',
	},
	{
		q: '¿Se puede reservar?',
		a: 'Por teléfono, en el 623 11 60 45. No hay reserva online ni formulario en esta web. El comedor admite grupos, así que para una mesa grande o un fin de semana conviene llamar con tiempo.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'La ficha de Google marca acceso, aseo y asientos adaptados para sillas de ruedas. No marca plaza de aparcamiento adaptada, así que el aparcamiento es el de la calle.',
	},
	{
		q: '¿Dónde se aparca?',
		a: 'El local no anuncia aparcamiento propio: se aparca en la calle Àngel Pallarés y en las calles del entorno, en superficie. Al estar en el casco de Sant Joan de Moró, salvo a la hora del almuerzo suele haber sitio cerca.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': ['BarOrPub', 'Restaurant'],
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['La Tasca Sant Joan de Moró', 'Bar La Tasca Moró'],
	slogan: 'Comida casera, menú del día y brasa',
	description,
	url: `${business.site}/`,
	telephone: '+34 623 11 60 45',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Cocina casera', 'Cocina española', 'Brasa', 'Marisco', 'Arroces'],
	areaServed: [
		{ '@type': 'City', name: 'Sant Joan de Moró' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: '0xd5ffd02099b788b:0xbf1fd19179e4dfda' },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday'],
			opens: '08:30',
			closes: '13:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday'],
			opens: '08:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday', 'Sunday'],
			opens: '08:30',
			closes: '23:59',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
	hasMenu: {
		'@type': 'Menu',
		name: 'Menú del día',
		description: 'Menú diario de 9 € y almuerzo a la brasa de 5 €, según la ficha del restaurante.',
		hasMenuSection: [
			{
				'@type': 'MenuSection',
				name: 'Menú del día',
				hasMenuItem: {
					'@type': 'MenuItem',
					name: 'Menú diario',
					offers: { '@type': 'Offer', price: '9.00', priceCurrency: 'EUR' },
				},
			},
			{
				'@type': 'MenuSection',
				name: 'Almuerzos',
				hasMenuItem: {
					'@type': 'MenuItem',
					name: 'Almuerzo a la brasa',
					offers: { '@type': 'Offer', price: '5.00', priceCurrency: 'EUR' },
				},
			},
		],
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>La Tasca · Menú del día en Sant Joan de Moró</title>
		<meta name="theme-color" content="#7a2b30" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="La Tasca, bar restaurante Sant Joan de Moró, menú del día Sant Joan de Moró, almuerzos Plana Alta, brasa, parrillada, mariscada, fideuà, Castellón"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="La Tasca · Menú del día en Sant Joan de Moró"
			ogDescription="Bar restaurante familiar: menú diario de 9 €, almuerzo a la brasa de 5 €, parrillada y mariscada. 4,4 en Google con 269 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Mariscada con gambas, cigalas y calamar de La Tasca, en Sant Joan de Moró"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#7a2b30"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Sant Joan de Moró, Castelló"
			contact={{
				street: business.street,
				locality: business.city,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[mariscada]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="LT"
			name={business.brand}
			subtitle="Bar restaurante · Sant Joan de Moró"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer d'Àngel Pallarés, 14 · Sant Joan de Moró"
				title="Comida casera<br />de menú<br /><em>y de brasa.</em>"
				lede="La Tasca es el bar restaurante familiar de Sant Joan de Moró: menú del día, almuerzos a la brasa, parrillada de carnes y mariscada para el centro de la mesa. Se abre a las 8:30 y los fines de semana alarga hasta la noche."
				image={mariscada}
				imageAlt="Mariscada con gambas, cigalas y calamar de La Tasca, en Sant Joan de Moró"
				primaryCta={{ label: 'Llamar 623 11 60 45', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4 en Google</b> con 269 reseñas' },
					{ label: 'Menú diario', html: '<b>9 €</b>' },
					{ label: 'Almuerzo a la brasa', html: '<b>5 €</b>' },
					{ label: 'Viernes a domingo', html: '<b>hasta las 24:00</b>' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece La Tasca" items={servicios} />

			<LocalAbout
				label="Bar restaurante familiar"
				title="La mesa larga,<br />la brasa encendida<br /><em>y el menú del día.</em>"
				paragraphs={[
					'En el número 14 de la calle Àngel Pallarés, en pleno Sant Joan de Moró, La Tasca funciona como el bar restaurante de siempre: cocina casera, menú del día y una parrilla que no se apaga. En su ficha se presenta como un negocio familiar, y las reseñas lo confirman por el trato y por las raciones.',
					'La oferta está resumida por el propio local en Google: menú diario por 9 € y almuerzo a la brasa por 5 €. Además, según anuncia, un día a la semana pone montaditos, jamón y morro de cerdo por cuenta de la casa. Los platos del menú cambian cada jornada y no están publicados.',
					'La carta se completa con lo que aparece en sus fotos y en sus reseñas: parrillada de carnes, mariscada, fideuà, pulpo a la gallega, sepia con patatas, pescado a la plancha, huevos con pimientos y embutido, y ensaladas. El horario es corrido: de 8:30 a 16:00 de martes a jueves y hasta medianoche de viernes a domingo.',
				]}
				note="«Las raciones generosas a un precio razonable», resume una reseña. Otras: «recomendable la sepia con patatas y una muy buena ensalada» y «trato excelente y la parrillada exquisita»."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Nueve euros<br /><em>de menú.</em>"
				description="Los dos precios que aparecen aquí los publica el propio restaurante en su ficha de Google: el menú diario a 9 € y el almuerzo a la brasa a 5 €. El resto de la selección sale de sus fotos y de lo que citan las reseñas, sin importes inventados."
				cta={{ label: 'Preguntar el menú de hoy', href: phoneHref }}
				groups={grupos}
				note="Los platos del menú cambian cada día y la ficha no publica ni la lista ni el precio del resto de la carta. Para saber qué hay hoy, llama al 623 11 60 45."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La brasa,<br />el mar<br /><em>y la mesa larga.</em>"
				description="Estas fotografías proceden del perfil de La Tasca en Google Maps: la parrillada de carnes, la fideuà, el pulpo a la gallega, el calamar y las gambas a la plancha, el pescado con patatas, los huevos con pimientos y embutido, y el bocadillo de la barra."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer d'Àngel Pallarés, 14 · 12130 Sant Joan de Moró"
				title="Te esperamos<br /><em>en La Tasca.</em>"
				addressLines={[business.street, `${business.postalCode} ${business.city}`, 'Castelló, España']}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: '8:30 – 13:30' },
					{ day: 'Martes', value: '8:30 – 16:00' },
					{ day: 'Miércoles', value: '8:30 – 16:00' },
					{ day: 'Jueves', value: '8:30 – 16:00' },
					{ day: 'Viernes', value: '8:30 – 24:00' },
					{ day: 'Sábado', value: '8:30 – 24:00' },
					{ day: 'Domingo', value: '8:30 – 24:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google: lunes de 8:30 a 13:30, de martes a jueves de 8:30 a 16:00 y de viernes a domingo hasta las 24:00, siempre sin cerrar a mediodía. En fiestas del pueblo cambia: llama antes."
				mapTitle="Mapa de La Tasca en la calle Àngel Pallarés, 14, Sant Joan de Moró"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="La Tasca · Sant Joan de Moró"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Se reserva por teléfono, llamando al 623 11 60 45: no hay reserva online ni formulario en esta web. Para mesas grandes, celebraciones o fin de semana conviene avisar con un día."
			/>

			<LocalFaq items={faqs} title="Antes de <em>sentarse.</em>" />
		</main>

		<LocalFooter
			mark="LT"
			name="La Tasca"
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a La Tasca"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
