---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	directionsUrl,
	hours,
	mapEmbedUrl,
	mapsUrl,
	resenas,
	site,
} from '../data/site';

// Fotos descargadas de la ficha de Google Maps, en `src/assets/fotos`, servidas con `<Image>`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const listaFotos = Object.keys(fotos)
	.sort()
	.map((ruta) => fotos[ruta].default);

const title = 'Bar Babylon CR · Bar en Ciudad Real';
const description =
	'Bar Babylon CR, bar restaurante en la Calle Palma, 9 de Ciudad Real. 4,3 sobre 5 con 121 reseñas.';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/bar-babylon-cr/favicon.svg" type="image/svg+xml" />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta name="robots" content="index, follow" />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:card" content="summary_large_image" />
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Restaurant",
	"@id": "https://www.sur-digital.com/bar-babylon-cr/#negocio",
	"name": "Bar Babylon CR",
	"url": "https://www.sur-digital.com/bar-babylon-cr/",
	"description": "Bar Babylon CR, bar restaurante en la Calle Palma, 9 de Ciudad Real. 4,3 sobre 5 con 121 reseñas.",
	"image": "https://www.sur-digital.com/bar-babylon-cr/og.jpg",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 38.983663,
		"longitude": -3.924518
	},
	"hasMap": "https://www.google.com/maps/place/Bar+Babylon+CR/@38.983663,-3.924518,17z/data=!3m1!4b1!4m6!3m5!1s0xd6bc346d3edf3bb:0x3756f48feedb8749!8m2!3d38.983663!4d-3.924518!16s%2Fg%2F11ny1krsg7?hl=es",
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": 4.3,
		"reviewCount": 121
	}
}
</script>
</head>
	<body>
		<header class="hero" id="inicio">
			<div class="hero-grid">
				<div class="hero-copy">
					<p class="eyebrow">{business.category} · Ciudad Real</p>
					<h1 set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Bar restaurante en la Calle Palma, 9. Valoración de 4,3 sobre 5 con {business.reviewCount} reseñas en Google.
					</p>
					<div class="hero-actions">
						<a class="button" href={mapsUrl} rel="noopener">Ver ficha en Google Maps</a>
						<a class="button secondary" href={directionsUrl} rel="noopener">Cómo llegar</a>
					</div>
				</div>
				{listaFotos[0] && (
					<Image src={listaFotos[0]} alt={`Fotografía de ${business.name} publicada en Google Maps`} widths={[640, 960]} sizes="(min-width: 800px) 50vw, 100vw" />
				)}
			</div>
		</header>

		<main>
			<section class="section" id="local" aria-labelledby="local-title">
				<h2 id="local-title">Dónde estamos</h2>
				<p>{business.streetAddress}, {business.postalCode} {business.city}.</p>
				<p>
					<a href={mapsUrl} rel="noopener">Abrir en Google Maps</a> ·
					<a href={directionsUrl} rel="noopener">Cómo llegar</a>
				</p>
				<iframe
					title={`Mapa de ${business.name}`}
					src={mapEmbedUrl}
					width="100%"
					height="320"
					style="border:0"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
			</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<h2 id="horario-title">Horario</h2>
				<table>
					<tbody>
						{hours.map((item) => (
							<tr>
								<th scope="row">{item.day}</th>
								<td>{item.service}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>

			<section class="section" id="resenas" aria-labelledby="resenas-title">
				<h2 id="resenas-title">Lo que dicen</h2>
				<p>Valoración en Google: 4,3 sobre 5 con {business.reviewCount} reseñas.</p>
				{resenas.map((r) => (
					<blockquote>« {r.texto} »</blockquote>
				))}
				<p>Accesibilidad publicada en la ficha: {accesibilidad.join('; ')}.</p>
			</section>

			{listaFotos.length > 1 && (
				<section class="section" id="fotos" aria-labelledby="fotos-title">
					<h2 id="fotos-title">Fotos</h2>
					<div class="galeria">
						{listaFotos.map((foto) => (
							<Image src={foto} alt={`Fotografía de ${business.name} publicada en Google Maps`} widths={[480, 800]} sizes="(min-width: 800px) 33vw, 50vw" />
						))}
					</div>
				</section>
			)}
		</main>

		<footer class="site-footer">
			<p>
				© {new Date().getFullYear()} {business.name}. Datos tomados de la ficha pública de Google Maps el {site.consultado}.
			</p>
			<p>
				<small>Creado por <a href="https://www.sur-digital.com" rel="noopener">Sur Digital</a></small>
			</p>
		</footer>
	</body>
</html>
