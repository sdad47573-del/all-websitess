---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/restaurante-colombinos-apaisada-01.jpg';
import foto1 from '../assets/fotos/restaurante-colombinos-apaisada-02.jpg';
import foto2 from '../assets/fotos/restaurante-colombinos-apaisada-03.jpg';
import foto3 from '../assets/fotos/restaurante-colombinos-vertical-05.jpg';
import foto4 from '../assets/fotos/restaurante-colombinos-apaisada-07.jpg';
import foto5 from '../assets/fotos/restaurante-colombinos-panoramica-04.jpg';

const business = {
	name: "Restaurante Colombino's",
	short: "Colombino's",
	street: 'C. Escuelas-Cn, 21',
	city: 'Casas Nuevas',
	region: 'Región de Murcia',
	province: 'Murcia',
	postalCode: '30177',
	phone: '+34 636 60 96 96',
	latitude: 37.9227304,
	longitude: -1.5982308,
	site: 'https://restaurante-colombinos.vercel.app',
};

const mapsUrl =
	"https://www.google.com/maps/place/Restaurante+Colombino's/@37.9227304,-1.5982308,17z/data=!3m1!4b1!4m6!3m5!1s0xd64f51b6199c169:0xb66288d6a8872963!8m2!3d37.9227304!4d-1.5982308!16s%2Fg%2F11qhg9f11g?authuser=0&hl=es";
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34636609696';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'La brasa',
		title: 'Carne a la brasa',
		text: '«Buen sitio para comer carne a la brasa y buena calidad», cuenta una de las reseñas de la ficha de Google Maps.',
	},
	{
		kicker: 'El producto',
		title: 'Buen género',
		text: '«Buen género»: es lo primero que destaca un cliente al hablar de la materia prima con la que trabaja la casa.',
	},
	{
		kicker: 'Para empezar',
		title: 'Bebida fría y aperitivo',
		text: '«Bebida fría acompañada de aperitivo»: el tapeo de la barra, tal y como lo describen sus clientes.',
	},
	{
		kicker: 'El postre',
		title: 'Postres caseros',
		text: 'Los postres caseros aparecen en las reseñas junto al aperitivo. Cocina de casa para terminar la comida.',
	},
	{
		kicker: 'El trato',
		title: 'Buena gente, buen trato',
		text: '«Buenísimo, buena gente, buen trato, buena comida, no se puede pedir más», resume otra de las reseñas.',
	},
	{
		kicker: 'El horario',
		title: 'Brasa hasta la madrugada',
		text: 'Abre a las 7:30. De jueves a domingo alarga el servicio: el jueves hasta las 24:00 y el fin de semana hasta las 0:30.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: "Fotografía de Restaurante Colombino's publicada en su ficha de Google Maps" },
	{ src: photos.foto2, alt: 'Imagen del restaurante en Casas Nuevas tomada de su galería de Google Maps' },
	{ src: photos.foto3, alt: 'Fotografía de Colombino\'s en la calle Escuelas-Cn, 21, Casas Nuevas' },
	{ src: photos.foto4, alt: "Imagen de Restaurante Colombino's subida a su perfil de Google Maps" },
	{ src: photos.foto5, alt: "Panorámica de Restaurante Colombino's según las fotos de su ficha de Google Maps" },
];

const faqs = [
	{
		q: "¿Dónde está Restaurante Colombino's?",
		a: 'En la calle Escuelas-Cn, 21, 30177 Casas Nuevas (Murcia). Coordenadas 37.9227304, -1.5982308.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Martes y miércoles de 7:30 a 17:00; jueves de 7:30 a 24:00; viernes, sábado y domingo de 7:30 a 0:30. El lunes cierra, según su ficha de Google Maps.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Cocina española, con carne a la brasa como plato más citado en las reseñas. También aperitivos, bebida fría, buena materia prima y postres caseros.',
	},
	{
		q: '¿Se puede reservar?',
		a: 'La ficha no ofrece reservas en línea. Para consultar disponibilidad o encargar comida, llama al 636 60 96 96.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso, aparcamiento, aseo y asientos adaptados para sillas de ruedas.',
	},
	{
		q: '¿Cómo se llega?',
		a: 'Está en Casas Nuevas (Murcia), en la calle Escuelas-Cn, 21. Puedes trazar la ruta desde el botón «Cómo llegar» de esta web.',
	},
];

const description =
	"Restaurante Colombino's, cocina española y carne a la brasa en Casas Nuevas (Murcia). Aperitivos, postres caseros y un trato cercano. Llama al 636 60 96 96.";

const images = [
	`${business.site}/og.jpg`,
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: business.short,
	description,
	url: `${business.site}/`,
	telephone: business.phone,
	image: images,
	servesCuisine: ['Española', 'Parrilla'],
	areaServed: [{ '@type': 'City', name: 'Murcia' }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday'],
			opens: '07:30',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Thursday',
			opens: '07:30',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday', 'Sunday'],
			opens: '07:30',
			closes: '00:30',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.4,
		reviewCount: 214,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#221c18" />
		<meta
			name="description"
			content="Restaurante Colombino's, cocina española y carne a la brasa en Casas Nuevas (Murcia). Aperitivos, postres caseros y un trato cercano. Llama al 636 60 96 96."
		/>
		<meta
			name="keywords"
			content="Colombino's, restaurante Casas Nuevas, carne a la brasa Murcia, cocina española Casas Nuevas, postres caseros, aperitivos"
		/>
		<meta name="author" content="Restaurante Colombino's" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,500;0,600;0,700;1,500&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Restaurante Colombino's | Carne a la brasa en Casas Nuevas</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Restaurante Colombino's · Carne a la brasa en Casas Nuevas" />
		<meta
			property="og:description"
			content="Cocina española y carne a la brasa en Casas Nuevas (Murcia). Aperitivos, postres caseros y buen trato."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.jpg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Restaurante Colombino's, en Casas Nuevas (Murcia)" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Restaurante Colombino's · Carne a la brasa en Casas Nuevas" />
		<meta
			name="twitter:description"
			content="Cocina española y carne a la brasa en Casas Nuevas (Murcia). Llama al 636 60 96 96."
		/>
		<meta name="twitter:image" content={`${business.site}/og.jpg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Casas Nuevas" />
		<meta name="geo.position" content="37.9227304;-1.5982308" />
		<meta name="ICBM" content="37.9227304, -1.5982308" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Restaurante Colombino's, inicio">
				<span class="brand-mark" aria-hidden="true">C</span>
				<span class="brand-name">Colombino's <small>Casas Nuevas · Murcia</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">El restaurante</a>
				<a href="#carta">La brasa</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>636 60 96 96</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C. Escuelas-Cn, 21 · Casas Nuevas</p>
					<h1 id="hero-title">Brasa,<br />buen género<br /><em>y buen trato.</em></h1>
					<p class="hero-lede">
						Restaurante Colombino's, cocina española en Casas Nuevas (Murcia). Carne a la brasa, aperitivos,
						bebida fría y postres caseros, con un trato cercano.
					</p>
					<div class="hero-actions">
						<a class="button button-fire" href={phoneHref}>Llamar 636 60 96 96</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,4</b> en Google (214 reseñas)</li>
						<li>Carne a la brasa</li>
						<li>Postres caseros</li>
						<li>Casas Nuevas</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						alt="Restaurante Colombino's, cocina española y brasa en Casas Nuevas"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,4</b><span>Google</span></div>
					<div><b>214</b><span>Reseñas</span></div>
					<div><b>6/7</b><span>Días</span></div>
				</div>
				<ul class="services">
					<li>Cocina española</li>
					<li>Carne a la brasa</li>
					<li>Aperitivos</li>
					<li>Postres caseros</li>
					<li>Local accesible</li>
					<li>Aparcamiento adaptado</li>
				</ul>
			</section>

			<section class="about section-pad" id="restaurante">
				<p class="section-label"><span aria-hidden="true"></span> Cocina española en Casas Nuevas</p>
				<div class="about-grid">
					<h2>El fuego,<br />la mesa<br /><em>y la gente.</em></h2>
					<div class="about-copy">
						<p>
							Restaurante Colombino's está en la calle Escuelas-Cn, 21, en Casas Nuevas, pedanía de Murcia.
							Cocina española con la carne a la brasa como protagonista de la casa.
						</p>
						<p>
							Las reseñas de Google Maps hablan de buen género, buena calidad, aperitivos con la bebida
							fría, postres caseros y un trato cercano. «No se puede pedir más», resume uno de sus
							clientes.
						</p>
						<p class="about-note">
							Abre de martes a domingo desde las 7:30. El lunes cierra. Llama al 636 60 96 96 para
							consultar o encargar.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Lo que se pide</p>
						<h2>De la brasa<br />a la <em>mesa.</em></h2>
					</div>
					<p>
						Carne a la brasa, buen producto y cocina de casa. Esto es lo que más repiten sus clientes en las
						reseñas, junto al trato y a la bebida bien fría.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>Colombino's<br /><em>en imágenes.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Restaurante Colombino's. En la ficha
							encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="avif"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres el
					titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> C. Escuelas-Cn, 21</p>
					<h2>Ven a Casas<br /><em>Nuevas.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes</th>
								<td>Cerrado</td>
							</tr>
							<tr>
								<th scope="row">Martes y miércoles</th>
								<td>7:30 – 17:00</td>
							</tr>
							<tr>
								<th scope="row">Jueves</th>
								<td>7:30 – 24:00</td>
							</tr>
							<tr>
								<th scope="row">Viernes, sábado y domingo</th>
								<td>7:30 – 0:30</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, llama antes de venir.
					</p>

					<div class="visit-links">
						<a class="button button-fire" href={phoneHref}>Llamar 636 60 96 96</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 636 60 96 96</a>

					<ul class="access">
						<li>Acceso adaptado</li>
						<li>Aparcamiento adaptado</li>
						<li>Aseo adaptado</li>
						<li>Asientos adaptados</li>
					</ul>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Restaurante Colombino's en la calle Escuelas-Cn, 21, Casas Nuevas"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;">
								<a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a>
							</p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Colombino's · Casas Nuevas
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">C</span>
				<p>Colombino's<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Restaurante Colombino's · Casas Nuevas, Murcia. Fotografías procedentes de la
				ficha del restaurante en Google Maps.
			</small>

			<p class="footer-credit">
				Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
				<a href="https://sur-digital.vercel.app/" rel="noopener">sur-digital.vercel.app</a>
			</p>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar a Colombino's <span>636 60 96 96</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
