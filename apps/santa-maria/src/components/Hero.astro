---
import { Image } from 'astro:assets';
import { BUSINESS, IMAGES } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
const media = Math.round(BUSINESS.rating * 2) / 2;
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<section id="inicio" class="hero-santa relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.fotoComedor}
			alt=""
			widths={[640, 1100, 1600]}
			sizes="100vw"
			quality={70}
			loading="eager"
			fetchpriority="high"
			class="h-full w-full object-cover opacity-20"
		/>
		<div class="from-neutral/95 via-neutral/80 absolute inset-0 bg-gradient-to-r"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
		<div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
			<div>
				<p
					class="text-accent inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase"
				>
					<span><i class="ri-restaurant-2-line"></i> Cocina española</span>
					<span class="text-white/50">Fortuna · Murcia</span>
				</p>

				<h1 class="font-display mt-4 text-5xl leading-[0.95] font-bold sm:text-6xl lg:text-7xl" set:html={piezas.portada.titulo} />
				<p class="font-display text-accent mt-2 text-xl sm:text-2xl">Casa de comidas y desayunos</p>

				<p class="mt-6 max-w-xl text-base leading-relaxed text-white/80 sm:text-lg">
					Un restaurante de cocina española en el polígono de Fortuna. Desayunos desde
					primera hora, comidas de mediodía y salón para celebraciones, con la carne a la
					piedra y los guisos de la casa.
				</p>

				<div class="mt-7 flex flex-wrap items-center gap-3">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="badge badge-lg gap-2 border-white/20 bg-white/10 px-4 py-3 text-sm font-semibold text-white"
					>
						<span class="text-accent tracking-tight" aria-hidden="true">
							{
								estrellas.map((n) => (
									<i
										class={
											n <= media
												? 'ri-star-fill'
												: n - media === 0.5
													? 'ri-star-half-fill'
													: 'ri-star-line'
										}
									/>
								))
							}
						</span>
						{BUSINESS.rating.toString().replace('.', ',')} · {BUSINESS.reviewCount} reseñas en Google
					</a>
				</div>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-accent btn-lg gap-2 rounded-full">
						<i class="ri-phone-line text-xl"></i>
						{BUSINESS.phone}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-lg gap-2 rounded-full border-white/35 bg-transparent text-white hover:border-white hover:bg-white hover:text-neutral"
					>
						<i class="ri-google-fill"></i>
						Ver ficha de Google
					</a>
				</div>

				<dl class="mt-10 grid gap-x-6 gap-y-5 border-t border-white/15 pt-7 sm:grid-cols-3">
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Mañanas</dt>
						<dd class="mt-1 text-base font-bold">7:15 – 17:00</dd>
						<dd class="text-xs text-white/55">Lunes a viernes</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Sábado</dt>
						<dd class="mt-1 text-base font-bold">8:00 – 13:00</dd>
						<dd class="text-xs text-white/55">Domingo cerrado</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Dónde</dt>
						<dd class="mt-1 text-base font-bold">Sodales, 18</dd>
						<dd class="text-xs text-white/55">30620 Fortuna · Murcia</dd>
					</div>
				</dl>
			</div>

			<figure class="relative mx-auto w-full max-w-md lg:max-w-none">
				<div class="border-accent/40 absolute -inset-2 rotate-2 rounded-2xl border"></div>
				<div class="relative grid grid-cols-5 gap-3">
					<div class="col-span-3 overflow-hidden rounded-2xl shadow-2xl">
						<Image
							src={IMAGES.fotoEntrecot}
							alt="Entrecot a la parrilla con patatas en Santa María"
							widths={[360, 620]}
							sizes="(min-width: 1024px) 22vw, 55vw"
							quality={85}
							loading="eager"
							class="foto-calida aspect-[3/4] w-full object-cover"
						/>
					</div>
					<div class="col-span-2 flex flex-col gap-3">
						<div class="overflow-hidden rounded-2xl shadow-xl">
							<Image
								src={IMAGES.fotoDesayuno}
								alt="Tortilla y zumo de naranja en el desayuno de Santa María"
								widths={[260, 440]}
								sizes="(min-width: 1024px) 15vw, 38vw"
								quality={85}
								loading="lazy"
								class="foto-calida aspect-square w-full object-cover"
							/>
						</div>
						<div
							class="sello-santa bg-primary/85 flex flex-1 flex-col items-center justify-center rounded-full px-3 py-6 text-center"
						>
							<span class="font-display text-accent text-4xl leading-none font-bold">7:15</span>
							<span class="mt-2 text-[0.6rem] leading-tight tracking-[0.14em] text-white/70 uppercase">
								abrimos<br />temprano
							</span>
						</div>
					</div>
				</div>
				<figcaption
					class="text-accent-content bg-accent mt-5 inline-flex items-center gap-2 rounded-full px-4 py-2 text-xs font-bold shadow-lg"
				>
					<i class="ri-map-pin-line"></i> Polígono de Fortuna
				</figcaption>
			</figure>
		</div>
	</div>

	<div class="cenefa-santa relative h-2 w-full"></div>
</section>
