---
import { Image } from 'astro:assets';
import { GALLERY } from '../data/site';

const [principal, ...resto] = GALLERY;
---

<section id="galeria" class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="text-secondary text-xs font-semibold tracking-[0.22em] uppercase">Galería</p>
				<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">Así es Santa María</h2>
			</div>
			<p class="text-base-content/60 max-w-sm text-sm">
				Fotos reales de la casa y de la mesa, publicadas en la ficha de Google del
				restaurante.
			</p>
		</div>

		<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			<figure class="relative overflow-hidden rounded-2xl sm:col-span-2 sm:row-span-2">
				<Image
					src={principal.src}
					alt={principal.alt}
					widths={[520, 800, 1100]}
					sizes="(min-width: 1024px) 48vw, 92vw"
					quality={80}
					loading="lazy"
					class="foto-calida aspect-[4/3] h-full w-full object-cover transition-transform duration-500 hover:scale-[1.03] sm:aspect-auto"
				/>
			</figure>
			{
				resto.map((foto) => (
					<figure class="overflow-hidden rounded-2xl">
						<Image
							src={foto.src}
							alt={foto.alt}
							widths={[280, 460, 640]}
							sizes="(min-width: 1024px) 24vw, (min-width: 640px) 46vw, 92vw"
							quality={78}
							loading="lazy"
							class="foto-calida aspect-square w-full object-cover transition-transform duration-500 hover:scale-105"
						/>
					</figure>
				))
			}
		</div>
	</div>
</section>
