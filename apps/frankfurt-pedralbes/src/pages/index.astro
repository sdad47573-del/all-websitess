---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import kiosco from '../assets/fotos/frankfurt-pedralbes-apaisada-06.jpg';
import frankfurt from '../assets/fotos/frankfurt-pedralbes-apaisada-02.jpg';
import plazaNoche from '../assets/fotos/frankfurt-pedralbes-apaisada-05.jpg';
import patatas from '../assets/fotos/frankfurt-pedralbes-vertical-03.jpg';
import franks from '../assets/fotos/frankfurt-pedralbes-vertical-04.jpg';
import cerveza from '../assets/fotos/frankfurt-pedralbes-vertical-07.jpg';
import barra from '../assets/fotos/frankfurt-pedralbes-vertical-08.jpg';
import coche from '../assets/fotos/frankfurt-pedralbes-vertical-10.jpg';
import fachada from '../assets/fotos/frankfurt-pedralbes-vista-1-01.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, MENU_NOTE, RATING, SERVICIOS } from '../data/site';

const title = 'Frankfurt Pedralbes · Frankfurts y comida rápida en Andorra la Vella';
const description = BUSINESS.description;

const galeria = [
	{
		src: fachada,
		alt: 'Fachada amarilla de Frankfurt Pedralbes en la calle de la Borda, con el rótulo en letra gótica y la terraza',
	},
	{
		src: frankfurt,
		alt: 'Frankfurt de Frankfurt Pedralbes en pan de barra con queso y bacon sobre el papel del local',
	},
	{
		src: franks,
		alt: 'Dos frankfurts en pan con una ración de batatas fritas sobre la mesa del bar',
	},
	{
		src: patatas,
		alt: 'Patatas fritas de Frankfurt Pedralbes cubiertas de carne picada y salsa de queso cheddar',
	},
	{
		src: cerveza,
		alt: 'Botella de cerveza Borís Golden Ale de Andorra junto a una copa vacía en la barra',
	},
	{
		src: barra,
		alt: 'Barra de madera de Frankfurt Pedralbes con taburetes, copas colgadas y lámparas industriales',
	},
	{
		src: coche,
		alt: 'Seat 600 amarillo pintado con el nombre Pedralbes Frankfurt en la cubierta del kiosco, visto de noche',
	},
	{
		src: plazaNoche,
		alt: 'Plaza de Andorra la Vella de noche con las letras iluminadas de ANDORRA',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#frankfurt-pedralbes`,
	name: BUSINESS.name,
	alternateName: ['Frankfurt Pedralbes', 'Frankfurt Pedralbes Andorra', 'Pedralbes Frankfurt'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida rápida', 'Frankfurts'],
	hasMenu: {
		'@type': 'Menu',
		name: 'Carta de Frankfurt Pedralbes',
		inLanguage: 'es-ES',
		hasMenuSection: MENU.map((group) => ({
			'@type': 'MenuSection',
			name: group.title,
			hasMenuItem: group.items.map((item) => ({
				'@type': 'MenuItem',
				name: item.name,
				description: item.note,
			})),
		})),
	},
	areaServed: [
		{ '@type': 'City', name: 'Andorra la Vella' },
		{ '@type': 'AdministrativeArea', name: 'Parroquia de Andorra la Vella' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.parish,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google Maps feature ID', value: BUSINESS.featureId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Sunday'],
			opens: '12:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '12:00',
			closes: '23:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Bar', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Qué se pide', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#16140f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Karla:wght@400;500;600;700&family=UnifrakturCook:wght@700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Frankfurt Pedralbes, frankfurt Andorra la Vella, comida rápida Andorra, bar Carrer de la Borda, frankfurts baratos Andorra, patatas con cheddar Andorra, comer en Andorra la Vella, terraza Andorra la Vella"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Bar y comida rápida en la calle de la Borda, 5, de Andorra la Vella. Frankfurts, patatas con carne y cheddar y terraza con el Seat 600 amarillo. De martes a domingo desde las 12:00. 3,8 sobre 5 con 1.160 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Kiosco amarillo de Frankfurt Pedralbes con el Seat 600 pintado en la cubierta"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#16140f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.parish}
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Andorra la Vella"
			countryName="Andorra"
			preload={[kiosco]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Frankfurt Pedralbes"
			subtitle="Bar · Comida rápida"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.city}`}
				title="Frankfurts <br /><em>de barrio.</em>"
				lede={`Frankfurt Pedralbes es el bar de comida rápida de la calle de la Borda, 5, en el centro de Andorra la Vella: frankfurts en pan de barra, patatas con carne y cheddar y una terraza con un Seat 600 amarillo en el tejado. Abre de martes a domingo desde las 12:00 y cierra los lunes. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				image={kiosco}
				imageAlt="Kiosco amarillo de Frankfurt Pedralbes con el Seat 600 pintado en la cubierta y la terraza acristalada"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>12:00–23:00</b><br />Martes a domingo' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b><br />Consultas y grupos` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Low cost"
			/>

			<LocalChips label="Señas de Frankfurt Pedralbes" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Amarillo por fuera, <br /><em>brasa por dentro.</em>"
				paragraphs={[
					'Frankfurt Pedralbes está en la calle de la Borda, 5, en Andorra la Vella. Se encuentra sin buscar: la fachada es amarilla de arriba abajo, con el nombre en letra gótica y dos leones flanqueando el escudo de la casa.',
					'Delante hay una terraza de madera y cristal, con toldo amarillo y mesas altas dentro y fuera. En la cubierta, mirando a la calle, hay un Seat 600 amarillo pintado con el nombre Pedralbes Frankfurt y el león de la marca. Es la foto que más se repite en el perfil de Google.',
					'Dentro el local es un bar de toda la vida: barra larga de madera, taburetes, copas colgadas, lámparas industriales y una cafetera al fondo. La ficha lo clasifica como bar y restaurante de comida rápida.',
					`La propia ficha se presenta en el nombre como «rollo low cost está genial». Abre de martes a domingo: de 12:00 a 23:00 de martes a jueves y el domingo, y hasta las 23:30 los viernes y sábados. Los lunes cierra. La nota media es de ${RATING.label} sobre 5 con ${RATING.count} reseñas.`,
				]}
				note="La información sale de la ficha pública de Google Maps y de las fotografías del perfil del establecimiento. La carta y los precios no están publicados: confírmalos en el local o por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="Qué se pide"
				title="Frankfurt, patatas <br /><em>y cerveza.</em>"
				description="La ficha no publica la carta, así que aquí solo aparecen los productos que se ven en las fotos del perfil: frankfurts en pan de barra, patatas con carne y cheddar, batatas y cerveza Borís."
				cta={{ label: 'Consultar por teléfono', href: BUSINESS.phoneHref }}
				groups={MENU}
				note={MENU_NOTE}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Ocho fotos <br /><em>del local.</em>"
				description="La fachada amarilla, el frankfurt con queso y bacon, la ración de batatas, las patatas con cheddar, la cerveza Borís, la barra y el Seat 600 de la terraza."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la <br /><em>calle de la Borda.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Andorra']}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: lunes cerrado; de martes a jueves y el domingo, de 12:00 a 23:00; viernes y sábados, de 12:00 a 23:30. En festivos puede cambiar."
				mapTitle="Mapa de Frankfurt Pedralbes en la calle de la Borda 5, Andorra la Vella"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Frankfurt Pedralbes"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. Se atiende en barra y terraza; para grupos o consultas, el teléfono publicado es el +376 862 666."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Frankfurt Pedralbes"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
