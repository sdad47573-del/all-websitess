---
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	facebookPhotosUrl,
	facebookUrl,
	faqSchema,
	faqs,
	instagramUrl,
	mapEmbedUrl,
	mapsPhotosUrl,
	mapsUrl,
	openingHours,
	phoneHref,
	restaurantSchema,
	specialties,
	tripadvisorUrl,
	turismoCordobaUrl,
} from '../lib/business';

const title = 'Mesón San Basilio | Cocina tradicional cordobesa en el casco histórico';
const description =
	'Mesón San Basilio en Córdoba: cocina casera tradicional cordobesa en el barrio de San Basilio. Salmorejo, berenjenas fritas, pescaíto frito y rabo de toro. Patio cordobés, terraza y salones para grupos. Reserva: 957 29 70 07.';
const keywords =
	'Mesón San Basilio Córdoba, comer en San Basilio Córdoba, cocina tradicional cordobesa, salmorejo Córdoba, berenjenas fritas Córdoba, pescaíto frito, rabo de toro Córdoba, restaurantes casco histórico Córdoba, Calle San Basilio 19 Córdoba, flamenco Ruta por las Tabernas Córdoba';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#2b5d8a" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Marcellus&family=Lato:wght@400;700;900&family=Spline+Sans+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración original de un patio cordobés con arcos para Mesón San Basilio; no es una fotografía del establecimiento" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Mesón San Basilio, inicio">
				<span class="brand-mark" aria-hidden="true">SB</span>
				<span class="brand-copy">San Basilio <small>Mesón · Córdoba</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">El mesón</a>
				<a href="#carta">La carta</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 957 29 70 07</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> San Basilio · Casco histórico · Córdoba</p>
					<h1 id="hero-title">Comida cordobesa<br /><em>bajo el patio.</em></h1>
					<p class="hero-intro">Mesón San Basilio ocupa una casa tradicional cordobesa de principios del siglo XIX en pleno casco histórico. Salmorejo, berenjenas fritas, pescaíto frito y rabo de toro, servidos en salones independientes, bodega y patio cordobés, a dos pasos de la Mezquita.</p>
					<div class="hero-actions">
						<a class="button button-blue" href={phoneHref}>Reservar por teléfono <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-blue" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Nos encontrarás en</small><address>{business.streetAddress}<br />{business.postalCode} · Córdoba</address></div>
						<div><small>Reservas</small><a href={phoneHref}>{business.phone}</a><br /><a href={mapsUrl} target="_blank" rel="noreferrer">Ficha en Google Maps ↗</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración original de un patio cordobés con arcos y farol; no es una fotografía del establecimiento">
					<span class="art-tile" aria-hidden="true"></span>
					<div class="patio" aria-hidden="true">
						<span class="farol"></span>
						<span class="arco a"></span><span class="arco b"></span><span class="arco c"></span>
						<span class="suelo"></span>
					</div>
					<div class="patio-tag" aria-hidden="true"><small>En el mesón</small><strong>Patio y terraza</strong><span>Flamenco en invierno</span></div>
					<div class="art-caption"><strong>San Basilio</strong>Cocina cordobesa</div>
				</div>
			</section>

			<div class="promise" aria-label="Información de Mesón San Basilio">
				<span>Cocina tradicional cordobesa</span><span>Patio cordobés</span><span>Salones para grupos</span><span>Ciclo de flamenco en invierno</span>
			</div>

			<section class="section intro" id="casa" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Una casa del casco antiguo</p>
					<h2 id="intro-title">Cien comensales<br /><em>bajo los arcos.</em></h2>
				</div>
				<div class="intro-copy">
					<p>El Mesón San Basilio está en el barrio de San Basilio, también conocido como Alcázar Viejo, dentro del casco histórico. El edificio es una casa de arquitectura tradicional cordobesa de principios del siglo XIX, con patio comedor, bodega y varios salones independientes con capacidad para alrededor de cien personas.</p>
					<p>Su carta se apoya en la cocina casera tradicional cordobesa, con producto de mercado y recetas de siempre. En invierno, además, el mesón es una de las sedes del ciclo de flamenco Ruta por las Tabernas, donde los artistas cordobeses interpretan sus cantes en directo.</p>
					<p class="source-note">La información de esta página procede de la ficha de Google Maps, de los perfiles oficiales del mesón y de guías de turismo y restaurantes. La carta y los horarios pueden cambiar: confirma antes de tu visita.</p>
				</div>
			</section>

			<section class="section carta" id="carta" aria-labelledby="carta-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> La carta de siempre</p>
						<h2 id="carta-title">Platos que<br /><em>definen un mesón.</em></h2>
					</div>
					<p>Una selección orientativa de las especialidades que las guías y los clientes citan de forma reiterada. No sustituye la carta vigente.</p>
				</div>
				<div class="carta-grid">
					{specialties.map((dish, index) => (
						<article class="carta-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<div class="carta-extra">
					<p><strong>Espacios:</strong> terraza, patio cordobés, bodega y salones independientes, con capacidad total próxima a cien personas. Ideal para grupos y celebraciones.</p>
					<p><strong>Servicios:</strong> admite reservas, acceso para personas con movilidad reducida, tarjetas de crédito y servicio de mesa.</p>
					<p class="menu-note">Consulta la carta, los platos del día y los alérgenos con el mesón. <a href={phoneHref}>Llama al 957 29 70 07</a>.</p>
				</div>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<div class="gallery-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Imágenes del mesón</p>
						<h2 id="gallery-title">San Basilio,<br /><em>en fotos.</em></h2>
					</div>
					<p>Consulta fotos reales del local, del patio y de los platos en la ficha de Google Maps, en Instagram, en Facebook y en Tripadvisor.</p>
				</div>
				<div class="gallery-grid">
					<a class="photo-card" href={mapsPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Mesón San Basilio en Google Maps">
						<span class="photo-label">Fotos de la ficha</span><span class="photo-title">Google Maps <span aria-hidden="true">↗</span></span>
					</a>
					<a class="photo-card alt" href={instagramUrl} target="_blank" rel="noreferrer" aria-label="Ver el Instagram oficial de Mesón San Basilio">
						<span class="photo-label">Perfil oficial</span><span class="photo-title">Instagram <span aria-hidden="true">↗</span></span>
					</a>
					<a class="photo-card alt2" href={facebookPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Mesón San Basilio en Facebook">
						<span class="photo-label">Página del negocio</span><span class="photo-title">Facebook <span aria-hidden="true">↗</span></span>
					</a>
				</div>
				<p class="gallery-note">El enlace de Google Maps identifica la ficha, pero no expone URLs directas a los archivos de imagen, por lo que las fotos se consultan en las galerías enlazadas. Las ilustraciones de esta web son gráficos originales, no fotografías del establecimiento.</p>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14004 · Casco histórico, Córdoba</p>
					<h2 id="visit-title">Te esperamos<br /><em>en San Basilio.</em></h2>
					<address>{business.streetAddress}<br />{business.postalCode} {business.locality}<br />{business.province}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Reservas y consultas</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Ubicación</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Redes y guías</small><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a> · <a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a> · <a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar y reservar</a>
					</div>
					<p class="hours-note">Los horarios pueden variar en festivos y en temporada alta. El domingo por la noche el mesón permanece cerrado: llama antes de desplazarte.</p>
				</div>
				<div class="visit-side">
					<div class="hours-card">
						<h3>Horario orientativo</h3>
						<ul>
							{openingHours.map((slot) => (
								<li><span>{slot.day}</span><strong>{slot.hours}</strong></li>
							))}
						</ul>
					</div>
					<div class="map-card">
						<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Mesón San Basilio en Calle San Basilio, Córdoba" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-label"><div><strong>Mesón San Basilio</strong><small>San Basilio, 19 · Córdoba</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
					</div>
					<p class="nearby-note">A poca distancia: Mezquita-Catedral, Alcázar de los Reyes Cristianos, Caballerizas Reales y la iglesia de San Basilio. Ficha en <a href={turismoCordobaUrl} target="_blank" rel="noreferrer">Turismo de Córdoba</a>.</p>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
			<Galeria nombre="Mesón San Basilio" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="Mesón San Basilio, volver al inicio">
				<span class="brand-mark" aria-hidden="true">SB</span><span class="brand-copy">San Basilio <small>Mesón · Casco histórico</small></span>
			</a>
			<nav class="footer-nav" aria-label="Fuentes y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Mesón San Basilio · Córdoba. Consulta horarios, carta y alérgenos directamente con el establecimiento.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>
		<a class="mobile-call" href={phoneHref}>Reservar en San Basilio <span>957 29 70 07</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>


