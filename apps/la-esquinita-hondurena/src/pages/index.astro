---
const business = {
	name: 'Restaurante y Cafetería La Esquinita Hondureña',
	shortName: 'La Esquinita Hondureña',
	street: 'Travesía Huerta de los Cristales, 2, local 3E',
	city: 'Marbella',
	region: 'Málaga',
	postalCode: '29603',
	country: 'ES',
	phone: '+34 673 77 50 81',
	latitude: 36.5106954,
	longitude: -4.8795631,
	site: 'https://la-esquinita-hondurena.vercel.app',
};

const mapsUrl = 'https://www.google.com/maps/place/Restaurante+Y+Cafeteria+La+Esquinita+Hondure%C3%B1a/@36.5106954,-4.8795631,17z/data=!4m6!3m5!1s0xd73277ecf6ed099:0x271e5dca5a25079c!8m2!3d36.5106954!4d-4.8795631!16s%2Fg%2F11sfqtjcv8?hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(`${business.name}, ${business.city}`)}&ll=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const instagramUrl = 'https://www.instagram.com/la_esquinita_hondurena/';
const phoneHref = 'tel:+34673775081';
const description = 'Prueba comida hondureña casera en La Esquinita Hondureña, en Marbella: baleadas, pollo con tajadas, enchiladas y café. Consulta cómo llegar, horario y teléfono.';
const siteUrl = `${business.site}/`;

const openingHours = [
	{ day: 'Lunes', value: 'Cerrado' },
	{ day: 'Martes', value: '09:30–18:00' },
	{ day: 'Miércoles', value: '09:00–18:00' },
	{ day: 'Jueves', value: '09:30–18:00' },
	{ day: 'Viernes', value: '09:30–20:00' },
	{ day: 'Sábado', value: '09:30–20:00' },
	{ day: 'Domingo', value: '09:30–17:00' },
];

const faqs = [
	{
		question: '¿Dónde está La Esquinita Hondureña?',
		answer: 'El restaurante está en Travesía Huerta de los Cristales, 2, local 3E, 29603 Marbella (Málaga). Abre la ficha de Google Maps para ver el mapa y las indicaciones.',
	},
	{
		question: '¿Qué platos hondureños puedo probar?',
		answer: 'Entre los platos hondureños que aparecen asociados al restaurante están las baleadas, las enchiladas, la tortilla con quesillo, el pollo con tajadas y el desayuno catracho. La oferta puede cambiar: pregunta en el local qué hay disponible ese día.',
	},
	{
		question: '¿Cuál es el teléfono para llamar o reservar?',
		answer: 'Puedes llamar al +34 673 77 50 81 para consultar disponibilidad, hacer una reserva o confirmar el horario antes de ir.',
	},
	{
		question: '¿Cuál es el horario de apertura?',
		answer: 'Los horarios publicados indican cierre los lunes, apertura de martes a jueves por la mañana y hasta la tarde, y servicio más largo de viernes a domingo. El horario mostrado en esta web es orientativo: confirma posibles cambios o festivos por teléfono o en Google Maps.',
	},
	{
		question: '¿Dónde puedo ver fotos del restaurante y sus platos?',
		answer: 'La ficha del restaurante en Google Maps reúne fotos del local y de la comida subidas por el establecimiento y sus visitantes. También puedes visitar la cuenta de Instagram oficial.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${siteUrl}#restaurant`,
	name: business.name,
	alternateName: business.shortName,
	description,
	url: siteUrl,
	telephone: business.phone,
	priceRange: '10–20 €',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Hondureña', 'Centroamericana', 'Latinoamericana'],
	acceptsReservations: true,
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: business.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [mapsUrl, instagramUrl],
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Tuesday', opens: '09:30', closes: '18:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Wednesday', opens: '09:00', closes: '18:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Thursday', opens: '09:30', closes: '18:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday', 'Saturday'], opens: '09:30', closes: '20:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '09:30', closes: '17:00' },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

import Galeria from '../components/Galeria.astro';---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#173e36" />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet" />
		<title>Comida hondureña en Marbella | La Esquinita Hondureña</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.shortName} />
		<meta property="og:title" content="La Esquinita Hondureña · Comida catracha en Marbella" />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${business.site}/og.svg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="La Esquinita Hondureña, cocina catracha en Marbella" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="Marbella" />
		<meta name="geo.position" content="36.5106954;-4.8795631" />
		<meta name="ICBM" content="36.5106954, -4.8795631" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="La Esquinita Hondureña, inicio">
				<span class="brand-mark" aria-hidden="true">E</span>
				<span>La Esquinita <small>Hondureña · Marbella</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#sabores">Sabores</a>
				<a href="#fotos">Fotos</a>
				<a href="#horario">Horario</a>
				<a href="#visitanos">Cómo llegar</a>
			</nav>
			<a class="header-call" href={phoneHref}>Llamar · 673 77 50 81</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span>Marbella · Málaga</span> <i aria-hidden="true"></i> Un rincón catracho</p>
					<h1 id="hero-title">Sabor de Honduras,<br />hecho en casa <em>y cerca.</em></h1>
					<p class="lede">Baleadas, enchiladas y cocina hondureña casera en el corazón de Marbella. Ven a probar sabores catrachos, desayunos con calma y platos para compartir en La Esquinita.</p>
					<div class="actions">
						<a class="button button-yellow" href={phoneHref}>Llámanos <span aria-hidden="true">↗</span></a>
						<a class="button button-clear" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<p class="hero-address"><span aria-hidden="true">⌖</span> Travesía Huerta de los Cristales, 2 · Marbella</p>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración decorativa de inspiración hondureña con un plato típico y paisaje tropical">
					<div class="sun"></div><div class="palm palm-one">♧</div><div class="palm palm-two">♧</div>
					<div class="hills hills-back"></div><div class="hills hills-front"></div>
					<div class="plate"><span class="plate-leaf">✿</span><span class="plate-tortilla"></span><span class="plate-beans"></span><span class="plate-cream"></span><span class="plate-caption">Sazón catracha</span></div>
					<span class="art-tag">Hecho con cariño <b>♥</b></span>
					<span class="art-note">Un pedacito<br />de Honduras</span>
				</div>
			</section>

			<div class="ticker" aria-label="Especialidades hondureñas"><span>Baleadas</span><b>✳</b><span>Enchiladas</span><b>✳</b><span>Pollo con tajadas</span><b>✳</b><span>Desayuno catracho</span><b>✳</b><span>Café</span></div>

			<section class="intro section-wrap" id="sabores">
				<div class="intro-title"><p class="eyebrow eyebrow-dark">Un viaje por el sabor</p><h2>Tradición hondureña.<br /><em>Una mesa para todos.</em></h2></div>
				<div class="intro-copy"><p>En La Esquinita Hondureña te esperan recetas caseras y el sabor auténtico de Centroamérica, servidos con cercanía en Marbella. Tanto si ya conoces la cocina catracha como si la vas a descubrir, aquí tienes una buena primera parada.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Mira las opiniones en Google Maps <span aria-hidden="true">↗</span></a></div>
			</section>

			<section class="dishes section-wrap" aria-labelledby="dishes-title">
				<div class="section-heading"><p class="eyebrow eyebrow-dark">Para descubrir y compartir</p><h2 id="dishes-title">Un primer bocado <em>catracho.</em></h2><p>Algunas especialidades hondureñas asociadas a la casa. Pregunta por los platos y la disponibilidad del día.</p></div>
				<div class="dish-grid">
					<article class="dish-card dish-baleada"><span class="dish-number">01 / CLÁSICO</span><span class="dish-emoji" aria-hidden="true">◉</span><h3>Baleadas</h3><p>Tortilla de harina doblada con relleno sabroso, un clásico irresistible de Honduras.</p></article>
					<article class="dish-card dish-enchilada"><span class="dish-number">02 / TRADICIÓN</span><span class="dish-emoji" aria-hidden="true">✿</span><h3>Enchiladas</h3><p>Color, textura y sabor en un plato típico que siempre invita a probar algo nuevo.</p></article>
					<article class="dish-card dish-tajadas"><span class="dish-number">03 / PARA COMPARTIR</span><span class="dish-emoji" aria-hidden="true">⌁</span><h3>Pollo con tajadas</h3><p>Una combinación hondureña muy querida: pollo y crujientes tajadas de plátano.</p></article>
					<article class="dish-card dish-breakfast"><span class="dish-number">04 / POR LA MAÑANA</span><span class="dish-emoji" aria-hidden="true">☀</span><h3>Desayuno catracho</h3><p>Empieza el día con un desayuno completo y un café en un ambiente acogedor.</p></article>
				</div>
				<p class="menu-note">Los platos y su disponibilidad pueden cambiar. Para conocer la carta y precios actuales, consulta directamente con el restaurante.</p>
			</section>

			<section class="photo-section" id="fotos">
				<div class="photo-copy"><p class="eyebrow">Fotos del restaurante</p><h2>Una probadita<br />antes de <em>venir.</em></h2><p>Explora las fotos del local y sus platos publicadas en la ficha del establecimiento en Google Maps. La vista de Google puede mostrar el mapa y el contenido fotográfico asociado al perfil.</p><a class="button button-yellow" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a><a class="instagram-link" href={instagramUrl} target="_blank" rel="noopener noreferrer">También estamos en Instagram ↗</a></div>
				<div class="map-photo"><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Google Maps: La Esquinita Hondureña en Marbella, ubicación y ficha del restaurante" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
					<noscript>
						<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
					</noscript>
				</div><a class="map-caption" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span>⌖</span><span><b>La Esquinita Hondureña</b><small>Ver ficha, ubicación y fotos en Google Maps ↗</small></span></a></div>
			</section>

			<section class="visit section-wrap" id="visitanos">
				<div class="visit-copy"><p class="eyebrow eyebrow-dark">Estamos en Marbella</p><h2>Tu próxima mesa<br />está <em>aquí.</em></h2><p>Acércate a probar la cocina hondureña de La Esquinita. Estamos a pocos minutos del centro de Marbella.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button button-green" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Llamar al 673 77 50 81</a></div></div>
				<div class="hours-card" id="horario"><div class="hours-title"><span class="clock" aria-hidden="true">◷</span><div><p class="eyebrow eyebrow-dark">Planea tu visita</p><h3>Horario</h3></div></div><dl>{openingHours.map(({ day, value }) => <div class:list={[{ closed: value === 'Cerrado' }]}><dt>{day}</dt><dd>{value}</dd></div>)}</dl><p class="hours-note">Horario publicado en directorios y sujeto a cambios. Confírmalo por teléfono o en Google Maps, especialmente en festivos.</p></div>
			</section>

			<section class="faq-section section-wrap" id="preguntas"><p class="eyebrow eyebrow-dark">Lo que nos preguntáis</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
			<Galeria nombre="Restaurante y Cafetería La Esquinita Hondureña" mapsUrl={mapsUrl} />
		</main>

		<footer class="footer"><div class="footer-top"><a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">E</span><span>La Esquinita <small>Hondureña · Marbella</small></span></a><p>Un pedacito de Honduras<br />en la Costa del Sol. <span>♥</span></p><nav aria-label="Enlaces del restaurante"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={phoneHref}>673 77 50 81</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} La Esquinita Hondureña · Marbella</span><a href="/aviso-legal/">Aviso legal y privacidad</a><span>Información orientativa. Confirma horario y carta con el local.</span></div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar <span>673 77 50 81</span></a>
	</body>
</html>

<style is:global>
	:root{font-family:'DM Sans',sans-serif;color:#1d332e;background:#fbf8ef;font-synthesis:none;text-rendering:optimizeLegibility;--green:#173e36;--green2:#24584a;--yellow:#f6c84b;--coral:#e47756;--cream:#fbf8ef;--ink:#1d332e;--muted:#64736b;--display:'Fraunces',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}img{display:block;max-width:100%}a:focus-visible,summary:focus-visible{outline:3px solid var(--coral);outline-offset:4px}.skip-link{position:absolute;z-index:99;top:-60px;left:16px;padding:12px 16px;background:var(--yellow);color:var(--ink)}.skip-link:focus{top:12px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:22px;background:var(--green);color:white}.brand{display:flex;align-items:center;gap:11px;font-weight:700;font-size:15px}.brand small{display:block;margin-top:4px;color:#d5dfcc;font-size:9px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border-radius:50%;background:var(--yellow);color:var(--green);font:700 22px var(--display)}.topbar nav{display:flex;gap:clamp(14px,2.5vw,32px);font-size:12px;color:#eef0e5}.topbar nav a:hover,.footer a:hover{color:var(--yellow)}.header-call{padding:11px 17px;border:1px solid #ffffff66;border-radius:99px;font-size:11px;font-weight:700}.hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:560px;background:var(--green);color:white;overflow:hidden}.hero-copy{padding:75px 4vw 65px 9vw;align-self:center}.eyebrow{margin:0 0 20px;color:#d3e0bd;font-size:10px;font-weight:700;letter-spacing:1.7px;text-transform:uppercase}.eyebrow i{display:inline-block;width:22px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.section-heading h2,.photo-copy h2,.visit h2,.faq-section h2{margin:0;font:600 clamp(39px,5vw,66px)/1.02 var(--display);letter-spacing:-1.5px}.hero h1 em