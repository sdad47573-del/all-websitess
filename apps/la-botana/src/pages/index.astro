---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import sala from '../assets/fotos/la-botana-apaisada-01.jpg';
import bar from '../assets/fotos/la-botana-vertical-02.jpg';
import guacamole from '../assets/fotos/la-botana-vertical-03.jpg';
import tacos from '../assets/fotos/la-botana-apaisada-04.jpg';
import margarita from '../assets/fotos/la-botana-vertical-05.jpg';
import burrito from '../assets/fotos/la-botana-apaisada-06.jpg';
import mural from '../assets/fotos/la-botana-vertical-07.jpg';
import calavera from '../assets/fotos/la-botana-vertical-08.jpg';
import nachos from '../assets/fotos/la-botana-vertical-09.jpg';
import tacosPlate from '../assets/fotos/la-botana-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICOS,
} from '../data/site';

const title = 'La Botana · Restaurante mexicano em Lisboa';
const description = BUSINESS.description;

const galeria = [
	{
		src: guacamole,
		alt: 'Guacamole servido num molcajete de pedra com rodelas de jalapeño e palitos crocantes, ao lado de meio abacate e de uma garrafa de Corona Extra com lima',
	},
	{
		src: tacos,
		alt: 'Dois tacos de tortilha de milho com carne, ananás, cebola roxa, coentros e molho vermelho, num prato escuro, com uma quesadilla e uma tostada ao fundo',
	},
	{
		src: nachos,
		alt: 'Duas panelas de nachos gratinados com queijo, tomate, coentros e natas sobre bases de ráfia, com uma garrafa de cola e uma margarita na mesa',
	},
	{
		src: burrito,
		alt: 'Burrito cortado ao meio num prato escuro, com uma tigela de guacamole e outra de totopos de milho',
	},
	{
		src: tacosPlate,
		alt: 'Dois tacos de carne com ananás e coentros sobre um prato escuro, com um cubo de ananás cortado em forma de H',
	},
	{
		src: margarita,
		alt: 'Margarita em copete com bordo de sal e uma rodela de lima seca, sobre uma mesa de latão, com o banco corrido verde ao fundo',
	},
	{
		src: sala,
		alt: 'Sala da La Botana com lâmpadas de vime, plantas suspensas, mezanino de grade preta, balcão de metal canelado e um cato esculpido à esquerda',
	},
	{
		src: bar,
		alt: 'Bar da La Botana com mural de cores vivas, prateleiras de madeira com quadros e figuras, copos de barro vermelho e mesas brancas à frente',
	},
	{
		src: mural,
		alt: 'Mural da parede do bar com uma figura pré-hispânica amarela, um dragão verde e espirais vermelhas e azuis sobre fundo cor de rosa',
	},
	{
		src: calavera,
		alt: 'Mural de uma caveira do Dia dos Mortos com flores de cempasúchil numa parede da sala, com uma escada e material de montagem à frente',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-botana`,
	name: BUSINESS.name,
	alternateName: ['La Botana Lisboa', 'La Botana Duque de Loulé'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mexicana', 'Latino-americana'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Avenidas Novas' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-botana-apaisada-01.jpg": sala,
	"la-botana-vertical-03.jpg": guacamole,
	"la-botana-apaisada-04.jpg": tacos,
	"la-botana-vertical-09.jpg": nachos,
	"la-botana-apaisada-06.jpg": burrito,
	"la-botana-vertical-10.jpg": tacosPlate,
	"la-botana-vertical-05.jpg": margarita,
	"la-botana-vertical-02.jpg": bar,
	"la-botana-vertical-07.jpg": mural,
	"la-botana-vertical-08.jpg": calavera,
};
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#3a1030" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,700;1,500;1,700&family=Outfit:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Botana, La Botana Lisboa, restaurante mexicano Lisboa, tacos Lisboa, guacamole Lisboa, burrito Lisboa, margaritas Lisboa, Av. Duque de Loulé"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cozinha mexicana na Av. Duque de Loulé 1E, em Lisboa. Guacamole, tacos, burritos e margaritas, com 4,7 sobre 5 no Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Sala da La Botana com plantas suspensas, lâmpadas de vime e mezanino"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#3a1030"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Avenidas Novas, Lisboa"
			locale="pt_PT"
			countryName="Portugal"
			preload={[sala]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Botana"
			subtitle="Mexicano · Lisboa"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Informação elaborada a partir de fontes públicas; confirma horário e oferta antes da visita."
			ctaLabel="Ligar"
			navAriaLabel="Ligações da La Botana"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
