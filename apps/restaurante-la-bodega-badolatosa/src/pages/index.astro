---
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	facebookPhotosUrl,
	facebookUrl,
	faqSchema,
	faqs,
	mapEmbedUrl,
	mapsPhotosUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
} from '../lib/business';

const title = 'Restaurante La Bodega en Badolatosa | Cocina tradicional';
const description =
	'Restaurante La Bodega en Badolatosa, Sevilla. Cafetería-restaurante de cocina tradicional en Avenida de Cuba, 50. Consulta la ubicación y llama al 954 01 80 62.';
const keywords =
	'Restaurante La Bodega Badolatosa, restaurante en Badolatosa, cocina tradicional Badolatosa, cafetería restaurante Sevilla, Avenida de Cuba 50, restaurantes Sevilla';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#173d35" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-SE" />
		<meta name="geo.placename" content="Badolatosa, Sevilla" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración original de cocina tradicional para La Bodega; no es una fotografía del restaurante" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante La Bodega, inicio">
				<span class="brand-mark" aria-hidden="true">B</span>
				<span class="brand-copy">La Bodega <small>Cocina tradicional · Badolatosa</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">El restaurante</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Dónde estamos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 954 01 80 62</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Badolatosa · Sevilla</p>
					<h1 id="hero-title">La cocina de siempre,<br /><em>en buena compañía.</em></h1>
					<p class="hero-intro">Restaurante La Bodega es una cafetería-restaurante de cocina tradicional en el corazón de Badolatosa. Acércate a Avenida de Cuba y consulta directamente con el establecimiento su propuesta del día.</p>
					<div class="hero-actions">
						<a class="button button-coral" href={phoneHref}>Llamar al restaurante <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Dirección</small><address>{business.streetAddress}<br />{business.postalCode} · Badolatosa</address></div>
						<div><small>Teléfono</small><a href={phoneHref}>{business.phone}</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración original de un plato de cocina tradicional; no es una fotografía del restaurante">
					<span class="art-stamp">AVENIDA DE CUBA · 50</span>
					<div class="plate" aria-hidden="true"><div class="dish"><span></span><span></span><span></span></div></div>
					<div class="art-caption"><strong>La Bodega</strong>Cocina tradicional</div>
				</div>
			</section>

			<div class="promise" aria-label="Información de Restaurante La Bodega">
				<span>Cocina tradicional</span><span>Cafetería-restaurante</span><span>En Badolatosa</span><span>Avenida de Cuba, 50</span>
			</div>

			<section class="section intro" id="restaurante" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Restaurante en Badolatosa</p>
					<h2 id="intro-title">Una mesa en<br /><em>el pueblo.</em></h2>
				</div>
				<div class="intro-copy">
					<p>En Avenida de Cuba, Restaurante La Bodega reúne servicio de cafetería y restaurante con cocina tradicional. Una referencia local para hacer una pausa, reunirse a la mesa y disfrutar de la hostelería de Badolatosa.</p>
					<p>La información disponible identifica el establecimiento como cafetería-restaurante de cocina tradicional. Para conocer la carta actual, el servicio del día o consultar ingredientes y alérgenos, lo mejor es llamar directamente.</p>
					<p class="source-note">La dirección y el teléfono se han contrastado en varios directorios. Los horarios publicados no coinciden, por lo que recomendamos confirmar la apertura antes de desplazarte.</p>
				</div>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<div class="gallery-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Imágenes del establecimiento</p>
						<h2 id="gallery-title">La Bodega,<br /><em>en fotos.</em></h2>
					</div>
					<p>Consulta las fotos reales en la ficha de Google Maps y en la página de Facebook del restaurante.</p>
				</div>
				<div class="gallery-grid">
					<a class="photo-link maps-photo" href={mapsPhotosUrl} target="_blank" rel="noreferrer" aria-label="Abrir ficha y fotos de Restaurante La Bodega en Google Maps">
						<span class="photo-label">Fotos de clientes y del local</span><span class="photo-title">Google Maps <span aria-hidden="true">↗</span></span>
					</a>
					<a class="photo-link facebook-photo" href={facebookPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Restaurante La Bodega en Facebook">
						<span class="photo-label">Página del negocio</span><span class="photo-title">Facebook <span aria-hidden="true">↗</span></span>
					</a>
					<a class="gallery-info" href={mapsUrl} target="_blank" rel="noreferrer">
						<span class="gallery-icon" aria-hidden="true">⌖</span><strong>Conoce el lugar</strong><span>Abre la ficha para ver más información, indicaciones y aportaciones recientes.</span><span class="text-link">Ver ficha en Maps ↗</span>
					</a>
				</div>
				<p class="gallery-note">El enlace proporcionado de Maps no contiene archivos de imagen directos para insertar en esta web. Las fotos auténticas están en las galerías enlazadas; la ilustración de portada es un gráfico original, no una foto del restaurante.</p>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 41570 · Sevilla</p>
					<h2 id="visit-title">Nos vemos<br /><em>en La Bodega.</em></h2>
					<address>{business.streetAddress}<br />{business.postalCode} {business.locality}<br />{business.province}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Teléfono</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Ubicación</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Redes</small><a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar ahora</a>
					</div>
					<p class="hours-note">Los horarios consultados en directorios son dispares. Llama para confirmar la apertura.</p>
				</div>
				<div class="map-card">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Restaurante La Bodega en Avenida de Cuba, Badolatosa" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<div class="map-label"><div><strong>Restaurante La Bodega</strong><small>Av. de Cuba, 50 · Badolatosa</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Información útil</p>
				<h2 id="faq-title">Preguntas <em>frecuentes.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
			<Galeria nombre="Restaurante La Bodega" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="Restaurante La Bodega, volver al inicio">
				<span class="brand-mark" aria-hidden="true">B</span><span class="brand-copy">La Bodega <small>Cocina tradicional · Badolatosa</small></span>
			</a>
			<nav class="footer-nav" aria-label="Enlaces de contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Restaurante La Bodega · Badolatosa, Sevilla. Consulta directamente horarios y carta.</small>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>954 01 80 62</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>


