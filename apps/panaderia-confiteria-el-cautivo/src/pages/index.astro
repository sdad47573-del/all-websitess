---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/panaderia-confiteria-el-cautivo-apaisada-01.jpg';
import fruta from '../assets/fotos/panaderia-confiteria-el-cautivo-vertical-02.jpg';
import quesos from '../assets/fotos/panaderia-confiteria-el-cautivo-vertical-05.jpg';
import bizcocho from '../assets/fotos/panaderia-confiteria-el-cautivo-apaisada-06.jpg';
import dulces from '../assets/fotos/panaderia-confiteria-el-cautivo-vertical-07.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería confitería El Cautivo · Carlos Haya, Málaga';
const description =
	'Panadería confitería El Cautivo, en Av. de Carlos Haya, 192 (Bailén-Miraflores, 29010 Málaga). Pan, dulces, comestibles, charcutería y congelados. Teléfono 951 73 15 16.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#el-cautivo`,
	name: BUSINESS.name,
	alternateName: ['El Cautivo', 'Panadería El Cautivo', 'Confitería El Cautivo Málaga'],
	description:
		'Panadería, confitería y tienda de comestibles en Av. de Carlos Haya, 192 (Bailén-Miraflores, 29010 Málaga). Pan, dulces, charcutería, congelados, fruta y quesos.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34951731516',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '08:30',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '17:00',
			closes: '20:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Friday',
			opens: '08:30',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '09:00',
			closes: '14:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada roja de Panadería confitería El Cautivo, con el rótulo azul, el toldo y el número 192',
	},
	{
		src: fruta,
		alt: 'Expositor de fruta con plátanos, naranjas, mandarinas, limones, manzanas, kiwis y melón',
	},
	{
		src: quesos,
		alt: 'Quesos envasados al vacío de Santa María del Cerro sobre el mostrador',
	},
	{
		src: bizcocho,
		alt: 'Bizcocho cortado en porciones sobre papel de horno',
	},
	{
		src: dulces,
		alt: 'Mantecados, roscos envueltos, pasteles de chocolate y dulces envasados en el mostrador',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#8e2f28" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400;0,600;1,400&family=Source+Sans+3:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería confitería El Cautivo, panadería Málaga, confitería Carlos Haya, comestibles Bailén-Miraflores, charcutería Málaga, congelados, hielo, 29010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería, confitería y tienda de comestibles en Carlos Haya, 192. Dulces, fruta, quesos, charcutería y congelados. 4,7 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de la Panadería confitería El Cautivo en la avenida de Carlos Haya, 192, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#8e2f28"
			phone="+34951731516"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Cautivo"
			subtitle="Panadería · Confitería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. de Carlos Haya, 192 · Bailén-Miraflores"
				title="Panadería, tienda <br /><em>y confitería.</em>"
				lede={`El Cautivo está en la avenida de Carlos Haya, 192, con el número bien visible al lado de la puerta. La fachada es roja y el rótulo azul anuncia «El Cautivo · Comestibles - Charcutería - Congelados», mientras el toldo dice «Panadería Confitería». Dentro hay mostrador de dulces, un expositor de fruta, quesos envasados y hielo. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={fachada}
				imageAlt="Fachada roja de Panadería confitería El Cautivo, con el rótulo azul, el toldo y el número 192"
				primaryCta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,7</b> en Google · 23 reseñas' },
					{ label: 'Horario', html: '<b>L–J 8:30–15:00</b> y 17:00–20:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b>` },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Pan · dulces · tienda"
			/>

			<LocalChips label="Lo que hay en El Cautivo" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una tienda <br /><em>con obrador.</em>"
				paragraphs={[
					'Panadería confitería El Cautivo está en la avenida de Carlos Haya, 192, en Bailén-Miraflores. La fachada es roja, con un rótulo azul que anuncia «Comestibles - Charcutería - Congelados» y un toldo que añade «Panadería Confitería». En el escaparate se anuncia también la venta de cubitos de hielo.',
					'Dentro, el local es tienda y obrador a la vez. En las fotos del perfil se ve el expositor de fruta con plátanos, naranjas, mandarinas, limones, manzanas, kiwis y melón, junto a quesos envasados al vacío de Santa María del Cerro y productos de comestibles.',
					'La parte dulce está en el mostrador: bizcocho cortado en porciones, pasteles de chocolate, mantecados, roscos envueltos y otros dulces envasados. La ficha de Google clasifica el negocio como panadería y le da 4,7 sobre 5 con 23 reseñas.',
					'Abre de lunes a jueves de 8:30 a 15:00 y de 17:00 a 20:00; el viernes solo por la mañana, de 8:30 a 15:00, y el sábado de 9:00 a 14:00. El domingo cierra. La ficha no publica carta, precios ni página web, así que aquí no encontrarás importes.',
				]}
				note="Sin carta ni precios publicados: el mostrador recoge solo lo que muestran las fotos del perfil y lo que anuncian el rótulo y el toldo de la fachada."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Horno, tienda <br />
							<em>y mostrador.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que hay <br /><em>en la tienda.</em>"
				description="Sin carta ni precios publicados: esto es lo que muestran las fotos del local y lo que anuncian el rótulo y el toldo de la fachada."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU_GROUPS}
				note="La ficha no recoge precios ni métodos de pago, así que esta web no publica importes. El surtido cambia a lo largo del día. Para saber qué hay, llama al 951 73 15 16."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La casa, <br /><em>por dentro.</em>"
				description="Cinco fotos de la ficha de Google Maps: la fachada, el expositor de fruta, los quesos, el bizcocho y los dulces envasados."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Carlos Haya, <br /><em>número 192.</em>"
				addressLines={[
					BUSINESS.street,
					BUSINESS.district,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
				]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de Panadería confitería El Cautivo en la avenida de Carlos Haya, 192, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="El Cautivo · Carlos Haya"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phone, href: BUSINESS.phoneHref }}
				reserveNote="La ficha indica que el local tiene acceso para sillas de ruedas, pero no aparcamiento adaptado. No publica información sobre el mostrador o el aseo. El contacto es en el local o por teléfono."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar a El Cautivo"
			navAriaLabel="Enlaces de Panadería confitería El Cautivo"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
