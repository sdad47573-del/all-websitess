---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import vitrina from '../assets/fotos/cocino-para-ti-apaisada-05.jpg';
import bandejas from '../assets/fotos/cocino-para-ti-apaisada-08.jpg';
import fachada from '../assets/fotos/cocino-para-ti-vertical-01.jpg';
import ensaladaLangostinos from '../assets/fotos/cocino-para-ti-vertical-03.jpg';
import catering from '../assets/fotos/cocino-para-ti-vertical-04.jpg';
import fachadaPuerta from '../assets/fotos/cocino-para-ti-vertical-06.jpg';
import vitrinaEmpanadas from '../assets/fotos/cocino-para-ti-vertical-07.jpg';
import ensaladilla from '../assets/fotos/cocino-para-ti-vertical-09.jpg';
import pescados from '../assets/fotos/cocino-para-ti-vertical-10.jpg';
import paella from '../assets/fotos/cocino-para-ti-vista-2-02.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Cocino para ti · Comida preparada en Retiro, Madrid';
const description =
	'Cocino para ti, en Calle de Narciso Serra, 17 (28007 Madrid, Retiro). Comida preparada para llevar, catering y pollería: guisos, albóndigas, tortillas y postres caseros.';

const galeria = [
	{
		src: bandejas,
		alt: 'Bandejas de carnes asadas, lasaña, pisto y pasta en el mostrador de Cocino para ti',
	},
	{
		src: fachada,
		alt: 'La fachada de Cocino para ti con el toldo verde y los carteles de menús y catering',
	},
	{
		src: paella,
		alt: 'Una paella de verduras en su paellera',
	},
	{
		src: pescados,
		alt: 'Bandejas de pescado gratinado, salmón y patatas panadera',
	},
	{
		src: catering,
		alt: 'Una mesa de catering con croquetas, tortilla, bocadillos y tarta',
	},
	{
		src: ensaladaLangostinos,
		alt: 'Una ensalada de langostinos con mayonesa y huevo sobre lechuga',
	},
	{
		src: ensaladilla,
		alt: 'Ensaladilla con mayonesa, huevo y aceitunas junto a una bandeja de croquetas',
	},
	{
		src: vitrinaEmpanadas,
		alt: 'La vitrina con empanadas, tortillas, bandejas de albóndigas y pastas',
	},
	{
		src: vitrina,
		alt: 'La vitrina de Cocino para ti con bandejas de pasta, ensaladilla, carnes y empanadillas',
	},
	{
		src: fachadaPuerta,
		alt: 'La fachada de Cocino para ti con la puerta abierta y los carteles del local',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Cocino para ti',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#cocino-para-ti`,
	name: BUSINESS.fullName,
	alternateName: ['Cocino para ti Madrid', 'Cocino para ti Retiro', 'Cocino para ti Narciso Serra'],
	description:
		'Comida preparada para llevar, catering y pollería en la calle de Narciso Serra, 17 (Retiro, 28007 Madrid). Guisos, albóndigas, tortillas y postres caseros.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34918313861',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida preparada', 'Comida para llevar', 'Cocina española'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Retiro' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '09:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '09:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"cocino-para-ti-apaisada-05.jpg": vitrina,
	"cocino-para-ti-apaisada-08.jpg": bandejas,
	"cocino-para-ti-vertical-01.jpg": fachada,
	"cocino-para-ti-vista-2-02.jpg": paella,
	"cocino-para-ti-vertical-10.jpg": pescados,
	"cocino-para-ti-vertical-04.jpg": catering,
	"cocino-para-ti-vertical-03.jpg": ensaladaLangostinos,
	"cocino-para-ti-vertical-09.jpg": ensaladilla,
	"cocino-para-ti-vertical-07.jpg": vitrinaEmpanadas,
	"cocino-para-ti-vertical-06.jpg": fachadaPuerta,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#223a54" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400..700;1,400&family=Assistant:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Cocino para ti Madrid, comida preparada Retiro, comida para llevar Narciso Serra, catering Madrid Retiro, pollos asados Madrid, albóndigas caseras Retiro"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida preparada para llevar, catering y pollería en la calle de Narciso Serra, 17 (Retiro). Guisos, albóndigas, tortillas y postres caseros, de lunes a domingo."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La vitrina de Cocino para ti con bandejas de comida preparada"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#223a54"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Retiro"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Cocino para ti"
			subtitle="Comida preparada · Retiro"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma platos y horario antes de la visita."
			ctaLabel="Llamar a Cocino para ti"
			navAriaLabel="Enlaces de Cocino para ti"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
