# ---- Servidor (Bun + Hono) ----

# Puerto del API. Vite hace de proxy de /api a este puerto en desarrollo.
PORT=8787

# Ruta del fichero SQLite. Por defecto ./data/patitas.sqlite
# (server/schema.sql se aplica solo al arrancar).
DATABASE_URL=./data/patitas.sqlite

# Secreto con el que se firman los JWT de sesión. OBLIGATORIO en producción:
# genera uno con `openssl rand -base64 32`.
AUTH_SECRET=

# Vida de la sesión, en segundos (30 días por defecto).
SESSION_TTL_SECONDS=2592000

# Vida del código de acceso por email, en segundos (15 minutos por defecto).
OTP_TTL_SECONDS=900

# Origen permitido para CORS en desarrollo (solo si sirves el front aparte).
DEV_ORIGIN=http://localhost:5173

# URL pública de la app. Se usa en los enlaces de los emails.
APP_URL=http://localhost:5173

# ---- Emails ----

# Sin RESEND_API_KEY los emails no se envían: se registran en consola y la app
# sigue funcionando con las notificaciones in-app.
RESEND_API_KEY=

# ---- Login ----

# Clave y URL del servicio de envío de OTP. Si no se pone, se usan los
# valores por defecto del servicio de freebuff.
VLY_OTP_API_KEY=
VLY_OTP_URL=https://auth.freebuff.app/send_otp
VLY_APP_NAME=Patitas · Peluquería Canina

# Emisor y JWKS de freebuff.com, para el acceso con un token ya emitido allí.
VLY_AUTH_ISSUER=https://freebuff.com
VLY_JWKS_URL=https://freebuff.com/api/web/.well-known/jwks.json

# ---- Migrar datos desde Convex (solo una vez) ----
# Se usa con `bun run migrate:convex`.
CONVEX_URL=
