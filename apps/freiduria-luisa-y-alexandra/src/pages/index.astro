---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/freiduria-luisa-y-alexandra-vertical-09.jpg';
import cucurucho from '../assets/fotos/freiduria-luisa-y-alexandra-apaisada-01.jpg';
import mostrador from '../assets/fotos/freiduria-luisa-y-alexandra-vertical-02.jpg';
import bandeja from '../assets/fotos/freiduria-luisa-y-alexandra-vertical-03.jpg';
import platoBoquerones from '../assets/fotos/freiduria-luisa-y-alexandra-apaisada-08.jpg';
import croquetasPatatas from '../assets/fotos/freiduria-luisa-y-alexandra-apaisada-05.jpg';
import croquetasMahonesa from '../assets/fotos/freiduria-luisa-y-alexandra-vertical-10.jpg';
import bolsaBascula from '../assets/fotos/freiduria-luisa-y-alexandra-vertical-06.jpg';
import flanes from '../assets/fotos/freiduria-luisa-y-alexandra-apaisada-04.jpg';
import tartaQueso from '../assets/fotos/freiduria-luisa-y-alexandra-apaisada-07.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, REVIEWS, SERVICIOS } from '../data/site';

const title = 'Freiduría Luisa y Alexandra · Pescado frito para llevar en Sevilla';
const description = BUSINESS.description;

const galeria = [
	{
		src: mostrador,
		alt: 'Mesa con bandejas de fritos variados: calamares, gambas, boquerones, salmonetes, croquetas y tortillitas, todas con su rodaja de limón',
	},
	{
		src: cucurucho,
		alt: 'Boquerones fritos en un cucurucho de papel abierto sobre una bandeja de aluminio, con un gajo de limón',
	},
	{
		src: bandeja,
		alt: 'Bandeja con frito variado: calamares, boquerones, aletrías, patatas y limón',
	},
	{
		src: platoBoquerones,
		alt: 'Cuatro boquerones fritos sobre un plato blanco con una rodaja de limón',
	},
	{
		src: croquetasPatatas,
		alt: 'Seis croquetas caseras junto a una ración de patatas fritas en un plato blanco',
	},
	{
		src: croquetasMahonesa,
		alt: 'Plato de croquetas fritas doradas con una cucharada de mahonesa al lado',
	},
	{
		src: bolsaBascula,
		alt: 'Bolsa de papel con boquerones fritos recién pesados en la báscula del local, que marca 203 gramos',
	},
	{
		src: flanes,
		alt: 'Cinco vasitos de flan casero con chocolate rallado por encima',
	},
	{
		src: tartaQueso,
		alt: 'Vasito de tarta de queso con mermelada de frutos rojos y láminas de almendra',
	},
];

const carta = [
	{
		title: 'Del frito',
		items: [
			{ name: 'Pescado frito variado', note: 'la bandeja que una reseña pide «para dos personas»' },
			{ name: 'Chocos', note: 'los que una reseña destacada llama deliciosos' },
			{ name: 'Boquerones', note: 'en cucurucho de papel, con limón' },
			{ name: 'Salmonetes', note: 'en la bandeja de frito, tal y como se ven en las fotos' },
		],
	},
	{
		title: 'Para picar',
		items: [
			{ name: 'Croquetas', note: 'caseras, servidas con patatas o con mahonesa' },
			{ name: 'Patatas fritas', note: 'Google clasifica el local como tienda de pescado y papas fritas' },
			{ name: 'Calamares y gambas', note: 'en la mesa de fritos que el local publica en su perfil' },
		],
	},
	{
		title: 'Postre y para llevar',
		items: [
			{ name: 'Flan casero con chocolate', note: 'en vasitos, recién preparado' },
			{ name: 'Tarta de queso con frutos rojos', note: 'también en vasito, con almendra' },
			{ name: 'Cucurucho o bandeja', note: 'el frito va en papel o en bandeja de aluminio' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'FastFoodRestaurant',
	'@id': `${BUSINESS.siteUrl}/#freiduria`,
	name: BUSINESS.name,
	alternateName: [
		'Freiduría Luisa y Alexandra',
		'Freiduria Luisa Alexandra',
		'Freiduría Emilio Lemos',
	],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pescado frito', 'Freiduría', 'Comida para llevar'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Sevilla Este, Sevilla' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '01:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0b1a20" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:ital,wght@0,500;0,700;0,800;1,700&family=Karla:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Freiduría Luisa y Alexandra, freiduría Sevilla, pescado frito para llevar Sevilla, papas fritas para llevar 41020, freiduría Emilio Lemos, frito variado Sevilla Este, chocos fritos Sevilla, boquerones fritos para llevar, freiduría avenida de Emilio Lemos 19"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Freiduría para llevar en la avenida de Emilio Lemos 19, local 5C1, Sevilla. Pescado frito, chocos y papas fritas todos los días de 13:00 a 17:00 y de 20:00 a 1:00. Pedidos en el 642 98 38 13."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Rótulo de Freiduría Luisa y Alexandra con la bandeja de fritos y el teléfono de pedidos"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#0b1a20"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Emilio Lemos, Sevilla"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Freiduría Luisa y Alexandra"
			subtitle="Pescado frito · Emilio Lemos"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="El frito de siempre, <br /><em>para llevar.</em>"
				lede="Freiduría Luisa y Alexandra está en la avenida de Emilio Lemos 19, local 5C1, y lo dice en su propio rótulo: «Freiduría Luisa y Alexandra · comida para llevar», con el teléfono 642 98 38 13 al lado. Abre todos los días de 13:00 a 17:00 y de 20:00 a 1:00, con pescado frito variado, chocos, boquerones y papas fritas."
				image={fachada}
				imageAlt="Fachada de la Freiduría Luisa y Alexandra con el rótulo de comida para llevar y el teléfono de pedidos sobre las puertas de cristal"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>3,8</b> en Google · 50 reseñas' },
					{ label: 'Horario', html: '<b>13:00–17:00 · 20:00–1:00</b><br />Todos los días de la semana' },
					{ label: 'Pedidos', html: `<b>${BUSINESS.phone}</b> comida para llevar` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de la Freiduría Luisa y Alexandra" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una freiduría <br /><em>de barrio.</em>"
				paragraphs={[
					'La freiduría está en la avenida de Emilio Lemos 19, local 5C1, en el 41020 de Sevilla. La fachada es blanca y sencilla, con dos puertas de cristal y el rótulo corrido encima: el nombre de la casa, «comida para llevar» y el teléfono de pedidos, 642 98 38 13. Dentro, el mostrador de vitrina y la barra quedan al fondo, como se ve en la foto del perfil.',
					'Google la clasifica como «tienda de pescado y papas fritas para llevar» y el negocio lo resume igual en su ficha: «Freiduria para llevar». Aquí no se sirve en mesa: se encarga, se fríe y se recoge, en cucurucho de papel o en bandeja de aluminio, siempre con su rodaja de limón.',
					'Las fotos del local enseñan lo que sale de la freidora: una mesa entera de bandejas con calamares, gambas, boquerones, salmonetes y croquetas; boquerones en cucurucho recién pesados en la báscula; y también el flan casero y la tarta de queso en vasito para cerrar la comida.',
					'El horario es partido y no descansa ningún día: de 13:00 a 17:00 para la comida y de 20:00 a 1:00 para la cena. Una de las reseñas que Google destaca habla de pedir «frito para dos personas» y de lo abundante que sale, y otra de los chocos.',
				]}
				note="La ficha no publica carta con precios ni web propia. Los productos de esta página salen de la categoría de Google, de la descripción del negocio, de las fotos de su perfil y de las reseñas destacadas: no hay importes que mostrar sin inventarlos."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Frito, chocos <br /><em>y papas.</em>"
				description="Sin precios publicados en la ficha, así que aquí va solo lo que el negocio declara, lo que se ve en sus fotos y lo que repiten las reseñas: el frito de cada día."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={carta}
				note="Esta lista sale de la categoría de Google, de la descripción del negocio, de las fotografías del perfil y de las reseñas destacadas. No hay carta ni precios públicos: la disponibilidad del día se confirma en el mostrador o llamando al 642 98 38 13."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
					<div class="reviews-head">
						<h2 id="resenas-title">Limpieza, pescado <br /><em>y amabilidad.</em></h2>
						<p>
							La ficha tiene 50 reseñas y una media de 3,8. Estas son tres de las que Google destaca,
							con la puntuación que les dio su autor.
						</p>
					</div>
					<div class="review-grid">
						{
							REVIEWS.map((review) => (
								<figure class="review-card">
									<p class="review-stars" aria-label={`${review.rating} sobre 5`}>
										{'★'.repeat(review.rating)}
										<span aria-hidden="true">{'★'.repeat(5 - review.rating)}</span>
									</p>
									<blockquote>{review.quote}</blockquote>
									<figcaption>Reseña publicada en Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="review-note">
						Citas de las reseñas públicas del local, con la puntuación del autor. En la ficha de Google
						están todas, incluidas las que puntúan por debajo.
					</p>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Nueve fotos <br /><em>de la freidora.</em>"
				description="Del perfil del local: la mesa de fritos variados, los boquerones en cucurucho, las croquetas con patatas, la bolsa recién pesada y los postres en vasito, además de la fachada."
				images={galeria}
				cta={{ label: 'Ver todas en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · Emilio Lemos`}
				title="A dos pasos <br /><em>de casa.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'España']}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: todos los días de 13:00 a 17:00 y de 20:00 a 1:00, sin día de cierre. En festivos puede cambiar; llama antes si vas en día señalado."
				mapTitle="Mapa de la Freiduría Luisa y Alexandra en la avenida de Emilio Lemos 19, Sevilla"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Freiduría Luisa y Alexandra"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Pedidos: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="Aquí se pide por teléfono y se recoge en el local: el rótulo de la fachada anuncia «comida para llevar» y el 642 98 38 13. La ficha marca acceso para sillas de ruedas pero no asientos adaptados, y no enlaza ninguna plataforma de reparto. Esta página no tramita pedidos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>llamar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Freiduría Luisa y Alexandra"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías tomados de la ficha y del perfil públicos del local en Google Maps. Sin carta de precios publicada: confirma horario, disponibilidad y reparto antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de la Freiduría Luisa y Alexandra"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
