---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import comedor from '../assets/fotos/restaurante-chino-dragon-apaisada-01.jpg';
import tallarines from '../assets/fotos/restaurante-chino-dragon-apaisada-02.jpg';
import arrozGambas from '../assets/fotos/restaurante-chino-dragon-apaisada-03.jpg';
import ternera from '../assets/fotos/restaurante-chino-dragon-apaisada-04.jpg';
import rollo from '../assets/fotos/restaurante-chino-dragon-apaisada-05.jpg';
import cartaMenu from '../assets/fotos/restaurante-chino-dragon-vertical-06.jpg';
import mesaCompartir from '../assets/fotos/restaurante-chino-dragon-apaisada-07.jpg';
import pollo from '../assets/fotos/restaurante-chino-dragon-apaisada-08.jpg';
import comedor2 from '../assets/fotos/restaurante-chino-dragon-apaisada-09.jpg';
import salteado from '../assets/fotos/restaurante-chino-dragon-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
} from '../data/site';

const title = 'Restaurante Chino Dragón · Cocina china en Teatinos, Málaga';
const description = BUSINESS.description;

const galeria = [
	{
		src: tallarines,
		alt: 'Plato de tallarines fritos con tiras de carne, col y salsa brillante, servido en un plato ovalado de borde rojo y blanco',
	},
	{
		src: arrozGambas,
		alt: 'Arroz frito tres delicias con huevo, jamón, guisantes y zanahoria, junto a gambas rebozadas con salsa agridulce',
	},
	{
		src: mesaCompartir,
		alt: 'Mesa con un cestillo de galletas de gambas, arroz frito, pollo agridulce con pimiento y piña, tallarines y un rollo de primavera',
	},
	{
		src: ternera,
		alt: 'Ternera con setas y bambú en salsa oscura, servida en un plato ovalado con borde de dragón rojo',
	},
	{
		src: pollo,
		alt: 'Pollo con setas, bambú y zanahoria salteado al wok en un plato de borde rojo decorado',
	},
	{
		src: salteado,
		alt: 'Salteado de col, pimiento verde y tiras de carne con salsa, en primer plano sobre la mesa',
	},
	{
		src: rollo,
		alt: 'Rollo de primavera abierto con el tenedor, con el relleno de col y salsa agridulce por encima',
	},
	{
		src: cartaMenu,
		alt: 'Carta del menú del día del Restaurante Chino Dragón, con el precio de 8,75 euros y los platos a elegir',
	},
	{
		src: comedor2,
		alt: 'Comedor del restaurante con mesas vestidas de blanco y dorado, sillas rojas, ventilador y biombos al fondo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante-chino-dragon`,
	name: BUSINESS.name,
	alternateName: ['Dragón Teatinos', 'Chino Dragón Málaga', 'Restaurante Dragón'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['China', 'Asiática'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '12:30',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '20:00',
			closes: '24:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
	hasMenu: {
		'@type': 'Menu',
		name: 'Menú del día',
		hasMenuSection: {
			'@type': 'MenuSection',
			name: 'Menú del día',
			hasMenuItem: MENU[0].items.map((item) => ({
				'@type': 'MenuItem',
				name: item.name,
				description: item.note,
			})),
		},
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-chino-dragon-apaisada-01.jpg": comedor,
	"restaurante-chino-dragon-apaisada-02.jpg": tallarines,
	"restaurante-chino-dragon-apaisada-03.jpg": arrozGambas,
	"restaurante-chino-dragon-apaisada-07.jpg": mesaCompartir,
	"restaurante-chino-dragon-apaisada-04.jpg": ternera,
	"restaurante-chino-dragon-apaisada-08.jpg": pollo,
	"restaurante-chino-dragon-apaisada-10.jpg": salteado,
	"restaurante-chino-dragon-apaisada-05.jpg": rollo,
	"restaurante-chino-dragon-vertical-06.jpg": cartaMenu,
	"restaurante-chino-dragon-apaisada-09.jpg": comedor2,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17120f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Chino Dragón, chino Teatinos Málaga, restaurante chino Málaga, C. Andrómeda 24, menú del día Málaga, comida china para llevar Teatinos, arroz tres delicias Málaga, pollo agridulce Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina china en la calle Andrómeda 24, Teatinos-Universidad. Menú del día de 8,75 € y horario partido todos los días: 12:30–16:30 y 20:00–24:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Comedor del Restaurante Chino Dragón, con lámpara de cristal y mesas con servilletas rojas"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#17120f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Teatinos, Málaga"
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Dragón"
			subtitle="Cocina china · Teatinos"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces del Restaurante Chino Dragón"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
