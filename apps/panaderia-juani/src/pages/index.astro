---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/panaderia-juani-apaisada-01.jpg';
import polvillo from '../assets/fotos/panaderia-juani-apaisada-02.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería Juani · Pan y confitería en Córdoba';
const description =
	'Panadería Juani, panadería y confitería en la calle Libertador Hidalgo y Costilla, 1 (barrio Sur, 14013 Córdoba). Pan del día, bollería, dulces y reparto. De lunes a viernes de 7:30 a 15:00 y de 17:30 a 21:00.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#juani`,
	name: BUSINESS.name,
	alternateName: ['Juani', 'Confitería Juani', 'Panadería Juani Córdoba'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	currenciesAccepted: 'EUR',
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:30',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '17:30',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '09:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '08:00',
			closes: '14:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Genial, buen pan y buen trato',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Muy buen pan y calentito tienen de todo',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Cumplen los plazos de entrega, te lo notifican y muy buen trato personal',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de la Panadería Juani en Córdoba, con los rótulos de Rico Pan y Confitería Juani y los escaparates',
	},
	{
		src: polvillo,
		alt: 'Logotipo de Polvillo con un panadero y una cesta de panes, en el escaparate del local',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#142c66" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=DM+Sans:wght@400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Juani, Confitería Juani, panadería Córdoba, panadería barrio Sur, pan del día Córdoba, Polvillo, bollería Córdoba, Libertador Hidalgo y Costilla, 14013"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan y confitería en la calle Libertador Hidalgo y Costilla, 1. Pan del día, bollería, dulces y reparto. De lunes a viernes de 7:30 a 15:00 y de 17:30 a 21:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de la Panadería Juani con los rótulos de Rico Pan y Confitería Juani"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#142c66"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Juani"
			subtitle="Panadería · Confitería"
			nav={nav}
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Libertador Hidalgo y Costilla, 1 · Sur, Córdoba"
				title="Pan calentito <br /><em>y dulces de confitería.</em>"
				lede={`Panadería Juani está en la calle Libertador Hidalgo y Costilla, 1, en el barrio Sur de Córdoba. En la fachada conviven el rótulo de Rico Pan, con el logotipo de Polvillo, y el de Confitería Juani. Hay pan del día, bollería y dulces, y una reseña de Google habla de los plazos de entrega. Abre de lunes a viernes de 7:30 a 15:00 y de 17:30 a 21:00. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={fachada}
				imageAlt="Fachada de la Panadería Juani con los rótulos de Rico Pan y Confitería Juani y los escaparates"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,9</b> en Google · 23 reseñas' },
					{ label: 'Horario', html: '<b>7:30–15:00</b> y 17:30–21:00' },
					{ label: 'Domingo', html: '<b>8:00–14:00</b> también abierto' },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Pan · bollería · dulces"
			/>

			<LocalChips label="Lo que hay en Juani" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Pan y confitería <br /><em>en el barrio Sur.</em>"
				paragraphs={[
					'Panadería Juani está en la calle Libertador Hidalgo y Costilla, 1, en el barrio Sur de Córdoba (14013). La fachada reúne dos rótulos: a un lado, Rico Pan, con el logotipo de Polvillo en el escaparate; al otro, Confitería Juani, con sus escaparates de dulces y productos.',
					'En las fotos del perfil se ven las vitrinas de la confitería, las estanterías del interior y el cartel de Polvillo con un panadero y una cesta de panes: «Nuestro buen pan de cada día».',
					'La ficha de Google la clasifica como panadería y le da 4,9 sobre 5 con 23 reseñas. Las reseñas hablan del pan y del trato: «Genial, buen pan y buen trato», «Muy buen pan y calentito tienen de todo».',
					'Otra reseña menciona el reparto: «Cumplen los plazos de entrega, te lo notifican y muy buen trato personal». La ficha no publica teléfono, web, redes ni condiciones del reparto, así que las consultas y los encargos se hablan en el local.',
				]}
				note="La ficha de Google no publica carta ni precios. Esta página solo cuenta lo que muestran las fotos del perfil, lo que dicen los rótulos del local y lo que cuentan las reseñas."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Pan, dulces <br />
							<em>y reparto.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que sale <br /><em>del horno.</em>"
				description="Sin carta ni precios publicados: esto es lo que muestran las fotos del local y lo que cuentan las reseñas de Google."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={MENU_GROUPS}
				note="La ficha no recoge precios ni métodos de pago, así que esta web no publica importes. El surtido cambia a lo largo del día: de lunes a viernes la panadería vuelve a abrir por la tarde."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La casa, <br /><em>a pie de calle.</em>"
				description="Las dos fotos de la ficha de Google Maps: la fachada con los rótulos de Rico Pan y Confitería Juani, y el logotipo de Polvillo del escaparate."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En el barrio <br /><em>Sur de Córdoba.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`,
				]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de Panadería Juani en la calle Libertador Hidalgo y Costilla, 1, Córdoba"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Juani · Barrio Sur"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Street View', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: 'Abrir en Google Maps ↗', href: MAPS.place, external: true }}
				reserveNote="La ficha de Google no publica teléfono ni web: las consultas y los encargos se hablan en el local. Indica acceso para sillas de ruedas, pero no aparcamiento adaptado; tampoco detalla el mostrador ni el aseo."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone=""
			phoneHref=""
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Ver en Google Maps"
			navAriaLabel="Enlaces de Panadería Juani"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
