---
import '../styles/global.css';
import {
  LocalAbout,
  LocalChips,
  LocalFaq,
  LocalFooter,
  LocalGallery,
  LocalHero,
  LocalMenu,
  LocalSeo,
  LocalTopbar,
  LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/m-encanta-comidas-para-llevar-apaisada-01.jpg';
import aperitivos from '../assets/fotos/m-encanta-comidas-para-llevar-apaisada-02.jpg';
import chicharrones from '../assets/fotos/m-encanta-comidas-para-llevar-apaisada-03.jpg';
import caracoles from '../assets/fotos/m-encanta-comidas-para-llevar-apaisada-04.jpg';
import patio from '../assets/fotos/m-encanta-comidas-para-llevar-vertical-05.jpg';
import carta from '../assets/fotos/m-encanta-comidas-para-llevar-vertical-06.jpg';
import patioMesas from '../assets/fotos/m-encanta-comidas-para-llevar-apaisada-07.jpg';
import terraza from '../assets/fotos/m-encanta-comidas-para-llevar-apaisada-08.jpg';
import terrazaInterior from '../assets/fotos/m-encanta-comidas-para-llevar-apaisada-09.jpg';
import arroz from '../assets/fotos/m-encanta-comidas-para-llevar-apaisada-10.jpg';

import { BUSINESS, FAQ, MAPS, MENU, SERVICES } from '../data/site';

const title = "M'encanta · Comidas caseras para llevar en Salteras";
const description = BUSINESS.description;
const gallery = [
  { src: fachada, alt: 'Fachada del establecimiento M’encanta en Salteras' },
  { src: carta, alt: 'Carta fotografiada de M’encanta con tapas, pescado frito, precios y teléfono de pedidos' },
  { src: aperitivos, alt: 'Bandeja de aperitivos variados preparada para compartir' },
  { src: chicharrones, alt: 'Chicharrones servidos en una bandeja' },
  { src: caracoles, alt: 'Caracoles en salsa, uno de los platos de temporada anunciados en la carta' },
  { src: arroz, alt: 'Arroz servido en una paellera' },
  { src: patio, alt: 'Terraza con mesas y sillas en M’encanta' },
  { src: patioMesas, alt: 'Mesas de la terraza interior de M’encanta' },
  { src: terraza, alt: 'Terraza exterior preparada para recibir comensales' },
  { src: terrazaInterior, alt: 'Vista de la terraza y el comedor exterior' },
];

const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: BUSINESS.name,
  description,
  url: `${BUSINESS.siteUrl}/`,
  telephone: '+34658694133',
  servesCuisine: ['Comida casera', 'Cocina española', 'Pescado frito'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.street,
    addressLocality: BUSINESS.city,
    addressRegion: BUSINESS.region,
    postalCode: BUSINESS.postalCode,
    addressCountry: BUSINESS.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: BUSINESS.geo.lat,
    longitude: BUSINESS.geo.lng,
  },
  sameAs: [MAPS.place, MAPS.facebook],
  image: [`${BUSINESS.siteUrl}/og.jpg`],
};

const nav = [
  { label: 'La casa', href: '#casa' },
  { label: 'Carta', href: '#carta' },
  { label: 'Fotos', href: '#galeria' },
  { label: 'Encuéntranos', href: '#visitanos' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <LocalSeo
      name={BUSINESS.name}
      description={description}
      keywords="M'encanta, comida para llevar Salteras, comidas caseras, guisos, pollos asados, catering Salteras"
      canonical={`${BUSINESS.siteUrl}/`}
      site={BUSINESS.siteUrl}
      ogTitle={title}
      ogDescription="Guisos caseros, pollos asados, tapas y menú semanal en Salteras. Pregunta por el reparto y el catering."
      ogImage={`${BUSINESS.siteUrl}/og.jpg`}
      ogImageAlt="Fachada de M’encanta Comidas para Llevar en Salteras"
      ogImageWidth={1200}
      ogImageHeight={630}
      author={BUSINESS.name}
      themeColor="#274537"
      street={BUSINESS.street}
      city={BUSINESS.city}
      region={BUSINESS.region}
      geoRegion="ES-SE"
      postalCode={BUSINESS.postalCode}
      phone={BUSINESS.phone}
      latitude={BUSINESS.geo.lat}
      longitude={BUSINESS.geo.lng}
      placeName="Salteras"
      locale="es_ES"
      countryName="España"
      contact={{
        street: BUSINESS.street,
        locality: BUSINESS.city,
        region: BUSINESS.region,
        postalCode: BUSINESS.postalCode,
        country: BUSINESS.country,
        phone: BUSINESS.phone,
        latitude: BUSINESS.geo.lat,
        longitude: BUSINESS.geo.lng,
      }}
      preload={[fachada]}
      schemas={[restaurantSchema]}
    />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <LocalTopbar
      mark={BUSINESS.mark}
      name={BUSINESS.shortName}
      subtitle="Comida casera · Salteras"
      phone={BUSINESS.phone}
      phoneHref={BUSINESS.phoneHref}
      nav={nav}
      homeLabel="inicio"
      navAriaLabel="Navegación principal"
    />

    <main id="contenido">
      <LocalHero
        eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
        title="Comida de casa, <br /><em>hecha con cariño.</em>"
        lede="Guisos, fritos, tortillas y pollos asados para llevar. En M’encanta también preparan menú semanal, reparto a domicilio y catering para compartir en familia o con el equipo."
        image={fachada}
        imageAlt="Fachada de M’encanta Comidas para Llevar en Salteras"
        primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
        secondaryCta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
        facts={[
          { label: 'Especialidad', html: '<b>Comida casera</b>' },
          { label: 'Para disfrutar', html: 'En casa o en <b>celebraciones</b>' },
          { label: 'Carta', html: '<b>Consulta disponibilidad</b>' },
        ]}
        galleryHref={MAPS.place}
        photoCredit="Foto del perfil público en Google Maps"
        galleryLinkLabel="Ver ficha y fotos"
        tag="Cocina casera · Salteras"
      />

      <LocalChips label="Servicios de M’encanta" items={SERVICES} />

      <LocalAbout
        label="La casa"
        title="Tu cocina de confianza <br /><em>en Salteras.</em>"
        paragraphs={[
          'En M’encanta preparan comida casera para llevar: guisos, pescado frito, tortillas y platos para compartir. La carta fotografiada recoge opciones para pedir y clásicos que apetecen cualquier día.',
          '¿Tienes una celebración a la vista? También ofrecen catering para bautizos, comuniones, comidas de empresa y reuniones familiares. Y si prefieres disfrutarlo en casa, pregunta por el reparto a domicilio.',
          'Llama para consultar el menú semanal, los platos disponibles y organizar tu pedido con tiempo.',
        ]}
        note="La carta visible en las fotografías está fechada en diciembre de 2025; los platos de temporada y los precios pueden variar. Confirma la información al llamar."
        links={[
          { label: 'Ver la carta fotografiada', href: '#galeria' },
          { label: 'Abrir Google Maps', href: MAPS.place, external: true },
          { label: 'Seguir en Facebook', href: MAPS.facebook, external: true },
        ]}
      />

      <section class="highlights" aria-label="Lo que puedes pedir">
        <article>
          <h3>El menú de cada semana</h3>
          <p>Pregunta por la propuesta semanal y los platos disponibles hoy.</p>
        </article>
        <article>
          <h3>Para compartir</h3>
          <p>Encargos y catering para reuniones, celebraciones y comidas de grupo.</p>
        </article>
        <article>
          <h3>En casa, sin cocinar</h3>
          <p>Comida para llevar y reparto a domicilio. Consulta condiciones y zona.</p>
        </article>
      </section>

      <LocalMenu
        eyebrow="De la carta y la cocina de casa"
        title="Un antojo para <br /><em>cada ocasión.</em>"
        description="Tapas, pescado frito, tortillas y platos para compartir. Consulta por teléfono la disponibilidad del día y la carta vigente."
        cta={{ label: `Consultar por teléfono · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
        groups={MENU}
        note="Los precios de la carta fotografiada son de diciembre de 2025 y pueden haber cambiado. Las especialidades de temporada y la disponibilidad varían: confirma siempre al hacer tu pedido."
      />

      <LocalGallery
        eyebrow="Desde la ficha de Google Maps"
        title="Un vistazo a <br /><em>M’encanta.</em>"
        description="La fachada, la carta, algunos platos y los espacios del establecimiento."
        images={gallery}
        cta={{ label: 'Abrir M’encanta en Google Maps', href: MAPS.place }}
        note="Fotografías descargadas del perfil público de M’encanta en Google Maps y servidas desde esta página."
      />

      <LocalVisit
        eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
        title="Ven a vernos <br /><em>a Salteras.</em>"
        addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Sevilla']}
        hours={[]}
        hoursCaption=""
        hoursNote="No publicamos un horario porque no hemos podido verificarlo. Llama antes de desplazarte para confirmar que está abierto."
        mapTitle="Mapa de M’encanta Comidas para Llevar en Salteras"
        mapEmbedUrl={MAPS.embed}
        mapLabel="C/ Cuatrovientos, 15 · Salteras"
        mapHref={MAPS.place}
        links={[
          { label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
          { label: 'Ficha en Google Maps', href: MAPS.place, external: true },
        ]}
        contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
        reserveNote="La carta fotografiada indica este teléfono para pedidos, consultas y reservas. Confirma por llamada el horario, los precios y la disponibilidad."
      />

      <LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Lo que necesitas <em>saber.</em>" />
    </main>

    <LocalFooter
      mark={BUSINESS.mark}
      name={BUSINESS.name}
      address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
      links={[
        { label: 'Google Maps ↗', href: MAPS.place, external: true },
        { label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
        { label: 'Facebook ↗', href: MAPS.facebook, external: true },
        { label: 'Aviso legal', href: '/aviso-legal' },
      ]}
      phone={BUSINESS.phone}
      phoneHref={BUSINESS.phoneHref}
      legal="Información basada en la carta fotografiada y los perfiles públicos del establecimiento. Confirma teléfono, horario, precios y disponibilidad antes de pedir."
      ctaLabel="Llamar a M’encanta"
      navAriaLabel="Enlaces de M’encanta"
      legalLinks={[
        { label: 'Aviso legal', href: '/aviso-legal' },
        { label: 'Privacidad', href: '/aviso-legal#privacidad' },
        { label: 'Cookies', href: '/aviso-legal#cookies' },
      ]}
      creditLabel="Creado por"
      creditName="Sur Digital"
      creditHref="https://sur-digital.vercel.app/"
      creditNote="sur-digital.vercel.app"
    />
  </body>
</html>
