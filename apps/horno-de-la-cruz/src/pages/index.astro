---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/horno-de-la-cruz-apaisada-01.jpg';
import interior from '../assets/fotos/horno-de-la-cruz-apaisada-09.jpg';
import flores from '../assets/fotos/horno-de-la-cruz-vertical-02.jpg';
import empanada from '../assets/fotos/horno-de-la-cruz-apaisada-08.jpg';
import borrachuelos from '../assets/fotos/horno-de-la-cruz-vertical-05.jpg';
import porcion from '../assets/fotos/horno-de-la-cruz-panoramica-07.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Horno de la Cruz · Panadería y confitería desde 1850 en Córdoba';
const description = BUSINESS.description;

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#horno-de-la-cruz`,
	name: BUSINESS.name,
	alternateName: ['Horno de la Cruz Córdoba', 'Confitería Horno de la Cruz'],
	description:
		'Horno y confitería artesana desde 1850 en el Centro de Córdoba: pan del día, empanadas, pastel cordobés, flores y borrachuelos.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 957 49 16 29',
	foundingDate: '1850',
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '14:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '17:00',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '09:00',
			closes: '14:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La vitrina', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: interior,
		alt: 'Interior del obrador con el mostrador, las estanterías de pan y el cartel «Más de un siglo a su servicio»',
	},
	{
		src: flores,
		alt: 'Vitrina de Horno de la Cruz con flores de almendra y nueces y su cartel de precios',
	},
	{
		src: empanada,
		alt: 'Mitad de empanada de jamón sobre el papel amarillo del obrador',
	},
	{
		src: borrachuelos,
		alt: 'Borrachuelos con gloria envueltos en la vitrina, junto al cartel de precio',
	},
	{
		src: porcion,
		alt: 'Porción de tarta cubierta de azúcar glas servida en un plato',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#571f28" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400..700;1,400..700&family=Jost:wght@300..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Horno de la Cruz Córdoba, panadería Centro Córdoba, confitería Córdoba, pastel cordobés, empanadas Córdoba, borrachuelos con gloria, Calle Góngora"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Horno y confitería artesana desde 1850 en el Centro de Córdoba (14002): pan, empanadas, pastel cordobés, flores y borrachuelos. De lunes a viernes en dos turnos; sábados por la mañana."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Horno de la Cruz en la calle Góngora, con el rótulo rojo y el escaparate de dulces"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#571f28"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Horno · Confitería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Centro · 14002 Córdoba"
				title="Horno de la Cruz, <br /><em>desde 1850.</em>"
				lede={`En la calle Góngora, 2, con el rótulo rojo sobre el toldo y una placa que dice «Artesanos desde 1850». Dentro, el escaparate y las vitrinas de este horno y confitería muestran pan, empanadas, flores, borrachuelos y dulces de siempre. Abre de lunes a viernes en dos turnos y el sábado por la mañana; el domingo descansa. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={fachada}
				imageAlt="Fachada de Horno de la Cruz en la calle Góngora, con el rótulo rojo, el toldo y el escaparate lleno de dulces"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5</b> en Google · 169 reseñas' },
					{ label: 'Horario', html: '<b>L–V</b> 9:00–14:30 y 17:00–21:00' },
					{ label: 'Dirección', html: '<b>Calle Góngora, 2</b> · Centro' },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Desde 1850 · Córdoba"
			/>

			<LocalChips label="Lo que hay en Horno de la Cruz" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un horno <br /><em>de 1850.</em>"
				paragraphs={[
					'Horno de la Cruz está en la calle Góngora, 2, en el Centro de Córdoba (14002). La fachada conserva el rótulo rojo sobre el toldo y una placa ovalada junto a la puerta con el lema «Artesanos desde 1850».',
					'Dentro, el cartel de la pared lo repite: «Más de un siglo a su servicio». Las fotos del perfil enseñan el mostrador de madera, las estanterías de pan y las vitrinas con bandejas de dulces, empanadas y flores.',
					'Las reseñas hablan del pan, las empanadas y la confitería: «empanadas exquisitas, pan y dulces muy bien elaborados», «buenísima la hoja fina y buenísimo el cabello de ángel, suave y poca azúcar» y «compré unas tortas de aceite y un pastel cordobés y estaban deliciosos». Son 169 opiniones y 4,5 sobre 5.',
					'El horario parte el día: de lunes a viernes abre de 9:00 a 14:30 y vuelve por la tarde, de 17:00 a 21:00. El sábado solo por la mañana, de 9:00 a 14:30, y el domingo cierra.',
				]}
				note="La ficha de Google no publica descripción, web propia, correo, redes, carta ni precios. Lo que se cuenta aquí sale de la ficha, de las reseñas y de las fotos de su galería. Los precios que aparecen en los carteles de las fotos cambian, así que esta web no los repite."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Pan, dulces <br />
							<em>y vitrina.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="La vitrina"
				title="Lo que sale <br /><em>del obrador.</em>"
				description="Sin precios publicados: esto es lo que cuentan las reseñas de Google y lo que se ve en las fotos del perfil."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={MENU_GROUPS}
				note="La ficha no publica carta ni precios, así que esta web no indica importes. El cartel de los borrachuelos que aparece en una foto marca 0,85 € la unidad, pero puede cambiar: confírmalo en el mostrador."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="El horno, <br /><em>por dentro.</em>"
				description="Cinco fotos de la ficha de Google Maps: el interior, la vitrina, la empanada y los dulces."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la calle <br /><em>Góngora.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de Horno de la Cruz en el Centro de Córdoba"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Horno de la Cruz · Calle Góngora, 2"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Abrir en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{
					label: `Llamar al ${BUSINESS.phone}`,
					href: BUSINESS.phoneHref,
					external: true,
				}}
				reserveNote="La ficha de Google marca acceso para sillas de ruedas, pero no aparcamiento adaptado. No publica más datos sobre el local ni sobre encargos, así que conviene llamar antes de ir."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.district}, ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Horno de la Cruz"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
