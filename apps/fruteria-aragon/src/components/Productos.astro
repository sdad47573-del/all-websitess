---
import { BUSINESS, PRODUCTOS } from '../data/site';
---

<section id="productos" class="bg-base-200 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase"
				>Frutería de barrio</span
			><h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">
				Fruta, verdura y atención cercana
			</h2><div class="aragon-divider mx-auto mt-5 h-px w-32"></div><p
				class="text-base-content/70 mt-6 leading-relaxed"
			>
				Consulta directamente con la tienda qué productos están disponibles hoy y pregunta por el
				reparto en tu zona.
			</p>
		</div><div class="mt-12 grid gap-4 sm:grid-cols-3">
			{
				PRODUCTOS.map((product) => (
					<article class="rounded-box border-base-300 bg-base-100 group border p-6 transition-shadow hover:shadow-lg">
						<>
							<span class="bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-content flex size-12 items-center justify-center rounded-xl transition-colors">
								<i class={`${product.icon} text-2xl`} />
							</span>
							<h3 class="font-display mt-5 text-xl font-bold">{product.title}</h3>
							<p class="text-base-content/65 mt-2 text-sm leading-relaxed">{product.text}</p>
						</>
					</article>
				))
			}
		</div><div
			id="reparto"
			class="border-base-300 bg-base-100 rounded-box mt-12 grid scroll-mt-24 gap-6 border p-7 sm:grid-cols-[1fr_auto] sm:items-center sm:p-9"
		>
			<div>
				<h3 class="font-display text-2xl font-bold">¿Vives cerca de Calle Castilla?</h3><p
					class="text-base-content/70 mt-2 max-w-2xl text-sm leading-relaxed"
				>
					El perfil de Facebook del comercio anuncia servicio a domicilio hasta aproximadamente 1
					km. Consulta disponibilidad y condiciones directamente.
				</p>
			</div><div class="flex flex-wrap gap-3">
				<a href={BUSINESS.phoneHref} class="btn btn-primary gap-2 rounded-full"
					><i class="ri-phone-line"></i>Consultar reparto</a
				><a
					href={BUSINESS.facebook}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-outline gap-2 rounded-full"
					><i class="ri-facebook-circle-line"></i>Facebook</a
				>
			</div>
		</div>
	</div>
</section>
