---
import { BUSINESS } from '../data/site';
---

<section id="ubicacion" class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">Visítanos</span
			><h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">
				Frutería Aragón en Calle Castilla
			</h2><div class="aragon-divider mx-auto mt-5 h-px w-32"></div><p
				class="text-base-content/70 mt-6"
			>
				Estamos en Calle Castilla, 25, Málaga. No encontramos un horario fiable publicado; llama
				para confirmar antes de venir.
			</p>
		</div><div class="mt-12 grid gap-8 lg:grid-cols-2">
			<div class="space-y-6">
				<div class="rounded-box border-base-300 bg-base-200 border p-7">
					<h3 class="font-display text-xl font-semibold">Dirección y teléfono</h3><ul
						class="mt-5 space-y-5 text-sm"
					>
						<li class="flex items-start gap-4">
							<span
								class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl"
								><i class="ri-map-pin-line text-xl"></i></span
							><div>
								<p class="font-semibold">Dirección</p><p class="text-base-content/70">
									{BUSINESS.street}<br />{BUSINESS.postalCode}
									{BUSINESS.district}, {BUSINESS.city}
								</p>
							</div>
						</li><li class="flex items-start gap-4">
							<span
								class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl"
								><i class="ri-phone-line text-xl"></i></span
							><div>
								<p class="font-semibold">Teléfono</p><a
									href={BUSINESS.phoneHref}
									class="text-base-content/70 hover:text-primary">{BUSINESS.phoneDisplay}</a
								>
							</div>
						</li>
					</ul><div class="mt-6 flex flex-wrap gap-3">
						<a href={BUSINESS.phoneHref} class="btn btn-primary gap-2 rounded-full"
							><i class="ri-phone-line"></i>Llamar</a
						><a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline gap-2 rounded-full"
							><i class="ri-map-pin-line"></i>Google Maps</a
						>
					</div>
				</div><div class="rounded-box border-base-300 bg-base-200 border p-6">
					<h3 class="font-display font-semibold">Perfil del comercio</h3><p
						class="text-base-content/70 mt-2 text-sm"
					>
						Consulta información y servicio a domicilio en la página de Facebook.
					</p><a
						href={BUSINESS.facebook}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline btn-sm mt-4 gap-2 rounded-full"
						><i class="ri-facebook-circle-line"></i>Visitar Facebook</a
					>
				</div>
			</div><div
				class="rounded-box border-base-300 bg-base-200 min-h-[420px] overflow-hidden border"
			>
				<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
				 src={BUSINESS.googleMapsEmbed}
					title={`Mapa de ${BUSINESS.name}, ${BUSINESS.street}, Málaga`}
					width="100%"
					height="100%"
					style="border: 0; min-height: 420px;"
					loading="lazy"
					allowfullscreen
					referrerpolicy="no-referrer-when-downgrade"></iframe>
				</div>
			</div>
		</div>
	</div>
</section>


