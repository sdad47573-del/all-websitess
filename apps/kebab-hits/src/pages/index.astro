---
import '../styles/global.css';
import { LocalAbout, LocalChips, LocalFaq, LocalFooter, LocalGallery, LocalHero, LocalMenu, LocalSeo, LocalTopbar, LocalVisit } from '@astro-components';
import foto01 from '../assets/fotos/kebab-hits-cuadrada-01.jpg';
import foto02 from '../assets/fotos/kebab-hits-vertical-02.jpg';
import foto03 from '../assets/fotos/kebab-hits-vista-3-03.jpg';
import foto04 from '../assets/fotos/kebab-hits-apaisada-04.jpg';
import foto05 from '../assets/fotos/kebab-hits-vertical-05.jpg';
import foto06 from '../assets/fotos/kebab-hits-panoramica-06.jpg';
import foto07 from '../assets/fotos/kebab-hits-vista-7-07.jpg';
import foto08 from '../assets/fotos/kebab-hits-vertical-08.jpg';
import foto09 from '../assets/fotos/kebab-hits-vertical-09.jpg';
import foto10 from '../assets/fotos/kebab-hits-apaisada-10.jpg';
import { BUSINESS, FAQ, HORARIO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Kebab Hits · Kebab, durum y pizza turca en Teatinos, Málaga';
const description = 'Kebab Hits en Av. Plutarco, 28, local 2, Teatinos-Universidad, Málaga. Fotos, horario de Google Maps, opiniones y cómo llegar.';
const gallery = [
	{ src: foto01, alt: 'Rótulo de Kebab Hits sobre la fachada de la avenida Plutarco, Málaga.' },
	{ src: foto02, alt: 'Bandeja con kebab, verduras frescas y salsa en el mostrador de Kebab Hits.' },
	{ src: foto03, alt: 'Pizza turca con carne, tomate, verduras y hierbas.' },
	{ src: foto04, alt: 'Preparación de kebab con carne, lechuga, tomate y salsa.' },
	{ src: foto05, alt: 'Rollo de kebab con pollo, vegetales y salsa.' },
	{ src: foto06, alt: 'Cartel con platos y ofertas de Kebab Hits en el interior del local.' },
	{ src: foto07, alt: 'Durum de kebab acompañado de patatas fritas.' },
	{ src: foto08, alt: 'Kebab servido con vegetales y salsa en una bandeja.' },
	{ src: foto09, alt: 'Comedor de Kebab Hits con mesas para comer en el local.' },
	{ src: foto10, alt: 'Bandejas de kebab y verduras en la barra de Kebab Hits.' },
];
const businessSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#kebab-hits`,
	name: BUSINESS.name,
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	servesCuisine: ['Cocina turca', 'Kebab', 'Comida halal', 'Comida rápida'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: { '@type': 'GeoCoordinates', latitude: BUSINESS.geo.lat, longitude: BUSINESS.geo.lng },
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	aggregateRating: { '@type': 'AggregateRating', ratingValue: RATING.value, reviewCount: RATING.count, bestRating: 5, worstRating: 1 },
	review: RESENAS.map((review) => ({ '@type': 'Review', reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 }, reviewBody: review.texto })),
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: FAQ.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};
const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Especialidades', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];
---
<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17130f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,400&display=swap" rel="stylesheet" />
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Kebab Hits Málaga, kebab Teatinos, durum, rollo kebab, pizza turca, restaurante halal Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Kebab, rollo, durum y pizza turca en Teatinos-Universidad. Descubre las fotos y cómo llegar a Kebab Hits."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Kebab Hits en la avenida Plutarco, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#17130f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[foto01]}
			schemas={[businessSchema, faqSchema]}
		/>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<LocalTopbar mark={BUSINESS.mark} name={BUSINESS.name} subtitle="Kebab · Teatinos" nav={nav} cta={{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true }} />
		<main id="contenido">
			<LocalHero
				eyebrow="Av. Plutarco, 28 · Teatinos-Universidad"
				title="Kebab Hits <br /><em>en Teatinos.</em>"
				lede={`Rollo kebab, Super Durum y pizza turca en la avenida Plutarco. La ficha de Google muestra ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				image={foto01}
				imageAlt="Rótulo de Kebab Hits sobre la fachada del local en la avenida Plutarco"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Valoración', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Tipo', html: '<b>Kebab y cocina turca</b>' },
					{ label: 'Zona', html: '<b>Teatinos</b> · Málaga' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Kebab · durum · pizza turca"
			/>
			<LocalChips label="Especialidades y servicios de Kebab Hits" items={SERVICIOS} />
			<LocalAbout
				label="El local"
				title="Sabor callejero, <br /><em>en Plutarco.</em>"
				paragraphs={[
					'Kebab Hits está en la avenida Plutarco, 28, local 2, en Teatinos-Universidad. Su fachada, con el rótulo rojo y blanco, queda a pie de calle.',
					'La descripción publicada por el establecimiento invita a probar su rollo kebab, el Super Durum y la pizza turca. La ficha lo clasifica como restaurante de comida rápida, kebab, halal y cocina turca.',
					'En las fotos del perfil aparecen la barra, el comedor, las verduras frescas y distintos kebabs y platos preparados. Google Maps recoge una valoración de 4,2 sobre 5, basada en 663 reseñas al consultar la ficha.',
				]}
				note="La ficha pública consultada no indica teléfono ni página web. El horario varía según el día y los festivos pueden tener cambios; confirma los datos en Google Maps antes de salir."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>
			<ul class="highlights">
				<li><h3>Rollo Kebab</h3><p>Uno de los platos recomendados en la descripción del propio establecimiento.</p></li>
				<li><h3>Super Durum</h3><p>Una de las especialidades que destaca Kebab Hits en la descripción de su ficha.</p></li>
				<li><h3>Pizza turca</h3><p>La ficha también invita a probar su pizza turca, junto al rollo kebab y el durum.</p></li>
			</ul>
			<LocalMenu
				eyebrow="Especialidades"
				title="Del rollo <br /><em>a la pizza.</em>"
				description="La descripción de Google menciona rollo kebab, Super Durum y pizza turca. La ficha no facilita precios verificables, así que no añadimos importes." 
				cta={{ label: 'Ver ficha en Google', href: MAPS.place }}
				groups={MENU}
				note="Los nombres proceden de la descripción pública de Kebab Hits. Para conocer la carta completa, los precios y las ofertas vigentes, consulta el local o la ficha del establecimiento."
			/>
			<LocalGallery
				eyebrow="Fotos del perfil de Google Maps"
				title="Una mirada <br /><em>a Hits.</em>"
				description="Diez imágenes del perfil del establecimiento: la fachada, el comedor, el mostrador, la carta y varios kebabs preparados."
				images={gallery}
				cta={{ label: 'Ver el perfil en Google Maps', href: MAPS.place }}
				note="Fotografías descargadas de la ficha pública de Kebab Hits en Google Maps y alojadas localmente. Si tienes los derechos de alguna y quieres retirarla, contacta para solicitar su eliminación."
			/>
			<section class="notas" aria-labelledby="opiniones-title">
				<div class="wrap notas-grid">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="opiniones-title">{RATING.label} <em>de 5.</em></h2>
						<p class="notas-score"><strong>{RATING.label}</strong><span><b>★★★★★</b>{RATING.count} reseñas<br />en Google</span></p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">Ver las reseñas ↗</a>
					</div>
					<div class="notas-copy">
						<ul class="reviews">
							{RESENAS.map((review) => <li><p>«{review.texto}»</p><span aria-label={`${review.valor} de 5 estrellas`}>{'★'.repeat(review.valor)}{'☆'.repeat(5-review.valor)} <small>Reseña publicada en Google</small></span></li>)}
						</ul>
						<p class="notas-foot">La ficha muestra 4,2 sobre 5 con 663 reseñas en la fecha de consulta. La puntuación puede variar; <a href={MAPS.reviews} target="_blank" rel="noreferrer">consulta las opiniones actuales en Google ↗</a>.</p>
					</div>
				</div>
			</section>
			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Avenida <br /><em>Plutarco.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas }))}
				hoursCaption="Horario publicado en Google"
				hoursNote="Horario consultado en octubre de 2026; puede cambiar y variar en días festivos. Verifica la ficha de Google Maps antes de desplazarte."
				mapTitle="Mapa de Kebab Hits en avenida Plutarco, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Av. Plutarco, 28 · local 2"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: 'Abrir la ficha en Google Maps ↗', href: MAPS.place, external: true }}
				reserveNote="La ficha consultada no publica teléfono ni página web. Para confirmar horarios, ofertas y opciones disponibles, consulta directamente el perfil de Google o el establecimiento."
			/>
			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>
		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps consultada en octubre de 2026. Confirma horario y ofertas antes de la visita."
			ctaLabel="Ver en Google Maps"
			navAriaLabel="Enlaces de Kebab Hits"
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
