---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import tortilla from '../assets/fotos/dulce-paladar-apaisada-10.jpg';
import carne from '../assets/fotos/dulce-paladar-apaisada-03.jpg';
import champinones from '../assets/fotos/dulce-paladar-apaisada-06.jpg';
import vitrina from '../assets/fotos/dulce-paladar-vertical-02.jpg';
import patatas from '../assets/fotos/dulce-paladar-vertical-04.jpg';
import polloGuisado from '../assets/fotos/dulce-paladar-vertical-07.jpg';
import polloAsado from '../assets/fotos/dulce-paladar-vertical-08.jpg';
import pisto from '../assets/fotos/dulce-paladar-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Dulce paladar · Comida casera para llevar en Sevilla';
const description =
	'Dulce paladar, comida casera para llevar en Av. de Alemania, 5 (41012 Sevilla). Tortilla de berenjenas, salmorejo, guisos y platos de cuchara. Horario, teléfono y reseñas.';

const galeria = [
	{ src: tortilla, alt: 'Tortilla de patata entera recién cuajada en una sartén' },
	{ src: carne, alt: 'Fuente rosa con carne guisada en salsa sobre un mantel de cuadros' },
	{ src: champinones, alt: 'Bandeja con champiñones guisados en salsa' },
	{ src: patatas, alt: 'Bandeja de patatas en salsa cubiertas de alioli' },
	{ src: polloGuisado, alt: 'Plato de pollo guisado con su salsa y pasas' },
	{ src: pisto, alt: 'Cuenco de pisto con tomate, pimiento y calabacín' },
	{ src: vitrina, alt: 'Vitrina del local con las bandejas de comida preparada para llevar' },
	{ src: polloAsado, alt: 'Pollo asado entero en una bandeja, listo para llevar' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Oferta de Dulce paladar',
	inLanguage: 'es-ES',
	description:
		'Selección orientativa basada en las reseñas y las fotografías públicas del establecimiento; no es una carta oficial.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#dulce-paladar`,
	name: BUSINESS.name,
	alternateName: ['Dulce Paladar Sevilla', 'Dulce Paladar comidas para llevar'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34646632776',
	servesCuisine: ['Comida casera', 'Comida para llevar', 'Cocina andaluza'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Oferta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"dulce-paladar-apaisada-10.jpg": tortilla,
	"dulce-paladar-apaisada-03.jpg": carne,
	"dulce-paladar-apaisada-06.jpg": champinones,
	"dulce-paladar-vertical-04.jpg": patatas,
	"dulce-paladar-vertical-07.jpg": polloGuisado,
	"dulce-paladar-vertical-09.jpg": pisto,
	"dulce-paladar-vertical-02.jpg": vitrina,
	"dulce-paladar-vertical-08.jpg": polloAsado,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Dulce paladar Sevilla, comida para llevar Sevilla, Av. de Alemania 5, tortilla de berenjenas, comida casera Sevilla, salmorejo"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar en Av. de Alemania, 5, Sevilla. Tortilla de berenjenas, salmorejo y guisos de cuchara. De martes a domingo a mediodía."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tortilla de patata entera cuajada en sartén, en Dulce paladar"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#4a1f2c"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Sevilla"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[tortilla]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Dulce paladar"
			subtitle="Comida casera · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma horario, menú y disponibilidad con el establecimiento."
			ctaLabel="Llamar a Dulce paladar"
			navAriaLabel="Enlaces de Dulce paladar"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
