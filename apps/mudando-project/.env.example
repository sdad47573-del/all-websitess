# Puerto en el que sirve la API de Hono. El proxy de Vite apunta aquí por
# defecto; cámbialo también con API_URL si mueves el servidor.
PORT=8787

# Clave de Resend para enviar el presupuesto por email. Sin ella el endpoint
# responde { "skipped": true } y explica que falta, en vez de fallar: así la app
# funciona en local sin necesidad de una cuenta de Resend.
RESEND_API_KEY=
