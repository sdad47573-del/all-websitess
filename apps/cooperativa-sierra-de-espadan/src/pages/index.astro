---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import terrazaHero from '../assets/fotos/cooperativa-sierra-de-espadan-apaisada-01.jpg';
import terrazaDia from '../assets/fotos/cooperativa-sierra-de-espadan-apaisada-07.jpg';
import carne from '../assets/fotos/cooperativa-sierra-de-espadan-apaisada-03.jpg';
import guiso from '../assets/fotos/cooperativa-sierra-de-espadan-apaisada-09.jpg';
import plazaNoche from '../assets/fotos/cooperativa-sierra-de-espadan-apaisada-04.jpg';
import cafe from '../assets/fotos/cooperativa-sierra-de-espadan-vertical-05.jpg';
import bocadillo from '../assets/fotos/cooperativa-sierra-de-espadan-vertical-06.jpg';
import dulces from '../assets/fotos/cooperativa-sierra-de-espadan-vertical-10.jpg';
import musica from '../assets/fotos/cooperativa-sierra-de-espadan-apaisada-08.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description = BUSINESS.description;

const galeria = [
	{
		src: terrazaDia,
		alt: 'Terraza de la Cooperativa con mesas y sillas negras y las montañas de la Sierra de Espadán al fondo',
	},
	{
		src: carne,
		alt: 'Carne a la brasa con patatas fritas y pan en un plato blanco, en la Cooperativa',
	},
	{
		src: guiso,
		alt: 'Guiso de cuchara con patata, carne y verduras servido en un plato hondo',
	},
	{
		src: plazaNoche,
		alt: 'Plaza de la Fuente de noche durante las fiestas, con la hoguera y la fachada de la Cooperativa Agrícola Sierra Espadán iluminada',
	},
	{
		src: cafe,
		alt: 'Café saliendo del portafiltros de la cafetera a un vaso de cristal en la barra',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo de longaniza con pimientos asados en un plato, con aceitunas y altramuces en la mesa',
	},
	{
		src: dulces,
		alt: 'Bandejas de repostería con buñuelos, tartaletas, brownies y rodajas de kiwi',
	},
	{
		src: musica,
		alt: 'Músicos tocando la guitarra y el acordeón en la terraza de la Cooperativa una noche de verano',
	},
];

const estrellas = (nota: number) => '★'.repeat(nota) + '☆'.repeat(5 - nota);

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	acceptsReservations: true,
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.fullName,
	alternateName: ['Cooperativa Sierra de Espadán', 'Bar Cooperativa Algimia', 'La Cooperativa Algimia de Almonacid'],
	slogan: BUSINESS.tagline,
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34617025914',
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Española', 'Casera', 'Mediterránea', 'Carnes a la brasa'],
	areaServed: [
		{ '@type': 'City', name: 'Algimia de Almonacid' },
		{ '@type': 'AdministrativeArea', name: 'Alto Palancia' },
		{ '@type': 'AdministrativeArea', name: 'Sierra de Espadán' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.province,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	foundingDate: String(BUSINESS.openedYear),
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Sunday'],
			opens: '08:00',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday'],
			opens: '08:00',
			closes: '13:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '08:00',
			closes: '23:59',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Opiniones', href: '#opiniones' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Cooperativa Sierra de Espadán · Cocina casera en Algimia de Almonacid';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f4a3c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,600;1,6..72,300;1,6..72,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Cooperativa Sierra de Espadán, bar restaurante Algimia de Almonacid, restaurante Sierra de Espadán, cocina casera Alto Palancia, menú del día Algimia, terraza plaza de la Fuente, carnes a la brasa Castellón, bocadillos Algimia, Plaza de la Fuente 24"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Cooperativa Sierra de Espadán · Cocina casera en la plaza"
			ogDescription="Cocina casera, menú del día, carnes a la brasa y terraza con vistas en Algimia de Almonacid. 4,4 en Google con 201 reseñas. Tel. 617 02 59 14."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Terraza de la Cooperativa Sierra de Espadán con las montañas al fondo"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#2f4a3c"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.province}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone="+34617025914"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Algimia de Almonacid, Castellón"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: `${BUSINESS.city}, ${BUSINESS.province}`,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'España',
				phone: '+34 617 02 59 14',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[terrazaHero]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Cooperativa"
			subtitle="Sierra de Espadán · Algimia"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Pl. de la Fuente, 24 · Algimia de Almonacid"
				title="La Cooperativa<br /><em>Sierra de Espadán.</em>"
				lede="El bar restaurante del pueblo, en la plaza de la Fuente, con las montañas de la Sierra de Espadán enfrente. Cocina casera y menú del día, carnes a la brasa, tapas, bocadillos y una terraza con sombrillas rojas donde el café de las ocho se alarga hasta la noche."
				image={terrazaHero}
				imageAlt="Terraza de la Cooperativa Sierra de Espadán con una sombrilla roja y las montañas de Algimia al fondo"
				primaryCta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Terraza con vistas"
				facts={[
					{ label: 'Nota', html: '<b>4,4 en Google</b> con 201 reseñas' },
					{ label: 'Todos los días', html: '<b>Desde las 8:00</b>' },
					{ label: 'Viernes y sábado', html: '<b>Hasta las 24:00</b>' },
					{ label: 'Martes', html: '<b>Solo mañana</b>' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Qué ofrece la Cooperativa" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="El bar del pueblo,<br /><em>desde 2018.</em>"
				paragraphs={[
					'La Cooperativa está en la plaza de la Fuente, 24, en el centro de Algimia de Almonacid, en la comarca del Alto Palancia y a la entrada del parque natural de la Sierra de Espadán. Es el edificio de la Cooperativa Agrícola Sierra Espadán, que reabrió como bar restaurante en julio de 2018, y su terraza mira directamente a las montañas.',
					'La cocina es la de casa: menú del día de primero, segundo y postre que cambia cada jornada, guisos de cuchara, arroces y fideuà, y carnes a la brasa con patatas. En la barra y en la terraza hay tapas, raciones, embutidos y bocadillos variados, y la cafetera no para desde primera hora.',
					'El ritmo es el de un pueblo: abre a las 8:00 para el café y el almuerzo, sirve el menú a mediodía y los viernes y sábados alarga la noche hasta las 24:00. En fiestas, la plaza se llena de mesas, hogueras y música en directo, y la Cooperativa es el punto de encuentro de vecinos y excursionistas.',
				]}
				note="La ficha de Google reúne una nota de 4,4 sobre 5 con 201 reseñas. El local indica acceso, aseo y asientos adaptados para sillas de ruedas. No hay reserva online: se reserva por teléfono, y para grupos conviene avisar con antelación."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Lo de cada día,<br /><em>hecho en casa.</em>"
				description="La Cooperativa no publica una carta cerrada con precios: el menú cambia cada día y se consulta en la barra o por teléfono. Estos son los platos y las familias que repiten quienes vienen al pueblo."
				cta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. El menú del día incluye primero, segundo y postre; para saber qué hay hoy, llama al 617 02 59 14 o pregunta en la barra. Hay opciones para picar y bocadillos a cualquier hora del servicio."
			/>

			<section class="opiniones section-pad" id="opiniones" aria-labelledby="opiniones-titulo">
				<div class="wrap">
					<div class="opiniones-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Opiniones en Google</p>
							<h2 id="opiniones-titulo">Lo que se dice<br /><em>en la plaza.</em></h2>
						</div>
						<div class="opiniones-nota">
							<span class="nota">4,4 <span aria-hidden="true">★</span></span>
							<p>201 reseñas en la ficha de Google Maps. La terraza, el menú y el trato son lo que más se repite.</p>
							<a href={MAPS.reviews} target="_blank" rel="noreferrer">Leer todas las reseñas ↗</a>
						</div>
					</div>
					<ul class="opiniones-grid">
						{
							REVIEWS.map((review) => (
								<li>
									<blockquote>
										<p>“{review.text}”</p>
										<footer>
											<span class="estrellas" aria-label={`${review.rating} de 5 estrellas`}>
												{estrellas(review.rating)}
											</span>
											<span>· Reseña en Google</span>
										</footer>
									</blockquote>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La terraza,<br />la plaza<br /><em>y la mesa.</em>"
				description="Estas fotografías proceden del perfil de la Cooperativa en Google Maps: la terraza con las montañas, la carne a la brasa, el guiso de cuchara, la plaza en fiestas, el café de la barra, el bocadillo, la repostería y la música en directo."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil público del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Pl. de la Fuente, 24 · 12414 Algimia de Almonacid"
				title="En la plaza,<br /><em>al pie de la sierra.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.province} · ${BUSINESS.landmark}`,
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="Abre todos los días a las 8:00. El martes cierra a las 13:00, de lunes a jueves y el domingo a las 21:00, y los viernes y sábados a las 24:00. En fiestas y puentes el horario puede cambiar; si vienes de lejos, llama antes."
				mapTitle="Mapa de la Cooperativa Sierra de Espadán en la plaza de la Fuente, Algimia de Almonacid"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Cooperativa · Algimia de Almonacid"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 617 02 59 14. La terraza está en la plaza de la Fuente y en verano se llena; para grupos y comidas familiares conviene avisar con antelación. El local tiene acceso, aseo y asientos adaptados para sillas de ruedas."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>subir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, menú y precios antes de la visita."
			ctaLabel="Llamar a la Cooperativa"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
