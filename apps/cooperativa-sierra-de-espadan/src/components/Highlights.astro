---
import { HIGHLIGHTS } from '../data/site';
---

<section class="border-base-300 bg-base-300 border-y" aria-label="Lo que encontrarás">
	<div class="mx-auto grid max-w-7xl grid-cols-1 gap-px sm:grid-cols-2 lg:grid-cols-4">
		{HIGHLIGHTS.map((item, index) => (
			<article class="bg-base-100 group relative px-6 py-8 sm:px-7">
				<div class="flex items-start justify-between gap-4">
					<span class="bg-primary/8 text-primary flex size-10 shrink-0 items-center justify-center rounded-sm">
						<i class={`${item.icon} text-xl`} aria-hidden="true" />
					</span>
					<span class="font-display text-base-300 text-2xl leading-none italic">
						0{index + 1}
					</span>
				</div>
				<h2 class="font-display mt-5 text-xl font-semibold">{item.title}</h2>
				<p class="text-base-content/65 mt-2 text-sm leading-relaxed">{item.text}</p>
			</article>
		))}
	</div>
</section>
