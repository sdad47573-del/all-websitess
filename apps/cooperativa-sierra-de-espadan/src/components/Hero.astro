---
import { Image } from 'astro:assets';
import { BUSINESS, IMAGES } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
---

<section id="inicio" class="bg-base-100 relative overflow-hidden">
	<div class="topo pointer-events-none absolute inset-0 opacity-80" aria-hidden="true"></div>

	<div
		class="relative mx-auto grid max-w-7xl gap-12 px-4 pt-12 pb-16 sm:px-6 sm:pt-16 lg:grid-cols-[1.04fr_0.96fr] lg:items-center lg:gap-14 lg:px-8 lg:pt-20 lg:pb-24"
	>
		<div>
			<p class="eyebrow text-secondary">
				Bar restaurante · Algimia de Almonacid
			</p>

			<h1
				class="font-display mt-5 text-[3.4rem] leading-[0.9] font-light tracking-[-0.025em] sm:text-7xl lg:text-[5.4rem]"
			>
				Cooperativa<br />
				<span class="text-primary italic">Sierra de</span><br />
				Espadán
			</h1>

			<p class="text-base-content/70 mt-6 max-w-lg text-base leading-relaxed sm:text-lg">
				Cocina casera en la plaza de la Fuente, con la sierra de fondo. Menú del día, carnes a
				la brasa, bocadillos y una terraza para quedarse.
			</p>

			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-7 inline-flex flex-wrap items-center gap-x-3 gap-y-1"
			>
				<span class="text-accent-content text-sm tracking-tight" aria-hidden="true">
					{estrellas.map((n) => (
						<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
					))}
				</span>
				<span class="text-sm font-bold">
					{BUSINESS.rating.toString().replace('.', ',')}
				</span>
				<span class="text-base-content/55 text-sm">
					· {BUSINESS.reviewCount} reseñas en Google
				</span>
			</a>

			<div class="mt-8 flex flex-wrap gap-3">
				<a
					href={BUSINESS.phoneHref}
					class="btn btn-primary btn-lg h-13 gap-2 rounded-sm px-6 text-sm font-bold"
				>
					<i class="ri-phone-line text-lg" aria-hidden="true"></i>
					{BUSINESS.phone}
				</a>
				<a
					href={BUSINESS.googleMaps}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-outline btn-lg h-13 gap-2 rounded-sm border-base-300 px-6 text-sm font-bold hover:border-primary hover:bg-primary hover:text-primary-content"
				>
					<i class="ri-map-pin-line text-lg" aria-hidden="true"></i>
					Cómo llegar
				</a>
			</div>

			<dl
				class="border-base-300 mt-10 grid grid-cols-2 gap-x-6 gap-y-5 border-t pt-7 sm:grid-cols-3"
			>
				<div>
					<dt class="text-base-content/45 text-[0.6rem] font-bold tracking-[0.18em] uppercase">
						Horario
					</dt>
					<dd class="mt-1.5 text-sm font-bold">Todos los días desde las 8:00</dd>
					<dd class="text-base-content/55 text-xs">Viernes y sábados, hasta las 24:00</dd>
				</div>
				<div>
					<dt class="text-base-content/45 text-[0.6rem] font-bold tracking-[0.18em] uppercase">
						La casa
					</dt>
					<dd class="mt-1.5 text-sm font-bold">Cocina casera</dd>
					<dd class="text-base-content/55 text-xs">Menú del día y terraza</dd>
				</div>
				<div class="col-span-2 sm:col-span-1">
					<dt class="text-base-content/45 text-[0.6rem] font-bold tracking-[0.18em] uppercase">
						Dónde
					</dt>
					<dd class="mt-1.5 text-sm font-bold">{BUSINESS.street}</dd>
					<dd class="text-base-content/55 text-xs">
						{BUSINESS.postalCode} {BUSINESS.city}
					</dd>
				</div>
			</dl>
		</div>

		<div class="relative mx-auto w-full max-w-md pb-8 lg:max-w-none lg:pb-0">
			<div class="border-base-300/70 bg-base-200 absolute -top-3 -right-3 bottom-5 left-3 rotate-2 rounded-t-[999px] rounded-b-md border"></div>

			<figure class="relative">
				<div class="arch border-base-300/80 relative overflow-hidden border shadow-[0_24px_60px_-30px_rgba(31,52,43,0.55)]">
					<Image
						src={IMAGES.fotoApaisada1}
						alt="Terraza de la Cooperativa Sierra de Espadán con sombrillas rojas y las montañas al fondo"
						widths={[520, 820, 1200]}
						sizes="(min-width: 1024px) 44vw, 92vw"
						quality={82}
						loading="eager"
						fetchpriority="high"
						class="foto-sierra aspect-[4/5] w-full object-cover"
					/>
					<div
						class="from-neutral/45 pointer-events-none absolute inset-0 bg-gradient-to-t via-transparent to-transparent"
						aria-hidden="true"
					></div>
					<figcaption
						class="absolute right-4 bottom-4 left-4 flex items-center justify-between gap-3 text-[0.68rem] font-semibold text-white/85"
					>
						<span class="inline-flex items-center gap-2">
							<i class="ri-sun-line text-accent" aria-hidden="true"></i>
							La terraza, en la plaza de la Fuente
						</span>
						<span class="text-white/50">Oct. 2026</span>
					</figcaption>
				</div>

				<div
					class="absolute -bottom-1 -left-3 w-32 rotate-[-4deg] border-[6px] border-base-100 shadow-xl sm:-left-6 sm:w-40"
				>
					<Image
						src={IMAGES.fotoApaisada4}
						alt="Fachada de la Cooperativa Agrícola Sierra Espadán durante la fiesta, con una hoguera en la plaza"
						widths={[260, 420]}
						sizes="(min-width: 640px) 10rem, 8rem"
						quality={82}
						loading="lazy"
						class="foto-sierra aspect-square w-full object-cover"
					/>
				</div>

				<div
					class="sello bg-neutral absolute -top-4 right-4 flex size-24 -rotate-6 flex-col items-center justify-center rounded-full text-center text-neutral-content sm:-right-4 sm:size-28"
				>
					<span class="text-accent flex gap-0.5 text-[0.55rem]" aria-hidden="true">
						{estrellas.map((n) => (
							<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
						))}
					</span>
					<span class="font-display mt-0.5 text-2xl leading-none font-semibold">
						{BUSINESS.rating.toString().replace('.', ',')}
					</span>
					<span class="mt-1 text-[0.5rem] font-bold tracking-[0.16em] uppercase text-white/60">
						{BUSINESS.reviewCount} reseñas
					</span>
				</div>
			</figure>
		</div>
	</div>

	<div class="cinta h-2.5 w-full" aria-hidden="true"></div>
</section>
