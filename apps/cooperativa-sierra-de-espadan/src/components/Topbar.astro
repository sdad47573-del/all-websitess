---
import { BUSINESS, NAV } from '../data/site';

interface Props {
	base?: string;
}

const { base = '' } = Astro.props;
---

<div class="border-base-300/70 bg-base-100/90 sticky top-0 z-50 border-b backdrop-blur-md">
	<header
		class="mx-auto flex h-[4.5rem] max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
	>
		<a href={`${base}#inicio`} class="flex items-center gap-3" aria-label={BUSINESS.name}>
			<svg viewBox="0 0 48 48" class="size-11 shrink-0" aria-hidden="true">
				<rect width="48" height="48" rx="7" fill="#2c4a3b"></rect>
				<circle cx="33" cy="15" r="4" fill="#d8b25e"></circle>
				<path
					d="M13 39V25a11 11 0 0 1 22 0v14"
					fill="none"
					stroke="#f4ecdd"
					stroke-width="1.6"
					stroke-linecap="round"></path>
				<path
					d="M9 38l8.5-9 5.5 5 5-6.5L38 38"
					fill="none"
					stroke="#f4ecdd"
					stroke-width="1.6"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
				<path d="M9 42h30" stroke="#b45c36" stroke-width="2" stroke-linecap="round"></path>
			</svg>
			<span class="leading-none">
				<span class="font-display block text-xl font-semibold tracking-tight">La Cooperativa</span>
				<span class="text-base-content/55 mt-1.5 block text-[0.58rem] font-semibold tracking-[0.2em] uppercase">
					Sierra de Espadán · Algimia
				</span>
			</span>
		</a>

		<nav class="hidden items-center gap-6 lg:flex" aria-label="Navegación principal">
			{NAV.map((item) => (
				<a
					href={`${base}${item.href}`}
					class="text-base-content/70 hover:text-secondary text-[0.8rem] font-semibold transition-colors"
				>
					{item.label}
				</a>
			))}
		</nav>

		<div class="flex items-center gap-2">
			<a
				href={BUSINESS.phoneHref}
				class="text-base-content/70 hover:text-primary hidden items-center gap-2 text-sm font-semibold transition-colors sm:inline-flex"
			>
				<i class="ri-phone-line text-base" aria-hidden="true"></i>
				<span class="hidden xl:inline">{BUSINESS.phone}</span>
				<span class="xl:hidden">Llamar</span>
			</a>
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-primary btn-sm h-10 gap-2 rounded-sm px-4 text-[0.78rem] font-bold"
			>
				<i class="ri-route-line text-base" aria-hidden="true"></i>
				<span class="hidden sm:inline">Cómo llegar</span>
				<span class="sm:hidden">Ruta</span>
			</a>
			<details class="dropdown dropdown-end lg:hidden">
				<summary class="btn btn-ghost btn-sm h-10 rounded-sm" aria-label="Abrir menú">
					<i class="ri-menu-line text-xl" aria-hidden="true"></i>
				</summary>
				<ul
					class="menu dropdown-content rounded-box border-base-300 bg-base-100 z-50 mt-2 w-64 border p-2 shadow-xl"
				>
					{NAV.map((item) => (
						<li>
							<a href={`${base}${item.href}`}>{item.label}</a>
						</li>
					))}
					<li>
						<a href={`${base}aviso-legal`}>Aviso legal y privacidad</a>
					</li>
					<li>
						<a href={BUSINESS.phoneHref}>
							<i class="ri-phone-line" aria-hidden="true"></i> {BUSINESS.phone}
						</a>
					</li>
				</ul>
			</details>
		</div>
	</header>
</div>
