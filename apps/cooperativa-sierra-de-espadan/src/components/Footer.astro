---
import { BUSINESS, NAV, SUR_DIGITAL_URL } from '../data/site';

interface Props {
	base?: string;
}

const { base = '' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-neutral text-neutral-content relative overflow-hidden">
	<div class="topo-light pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-7xl px-4 pt-14 pb-28 sm:px-6 sm:pb-14 lg:px-8">
		<div
			class="flex flex-col gap-6 border-b border-white/10 pb-10 sm:flex-row sm:items-end sm:justify-between"
		>
			<div>
				<p class="text-accent text-[0.62rem] font-bold tracking-[0.22em] uppercase">
					{BUSINESS.landmark}
				</p>
				<p class="font-display mt-2 text-3xl leading-tight font-light sm:text-4xl">
					Nos vemos <span class="text-accent italic">en la plaza</span>.
				</p>
			</div>
			<a
				href={BUSINESS.phoneHref}
				class="btn btn-accent btn-sm h-11 w-fit gap-2 rounded-sm px-5 text-[0.78rem] font-bold"
			>
				<i class="ri-phone-line text-base" aria-hidden="true"></i>
				{BUSINESS.phone}
			</a>
		</div>

		<div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
			<div class="sm:col-span-2 lg:col-span-1">
				<p class="font-display text-2xl font-semibold">La Cooperativa</p>
				<p class="mt-1 text-[0.6rem] font-bold tracking-[0.2em] text-white/45 uppercase">
					Sierra de Espadán · Algimia
				</p>
				<p class="mt-4 max-w-xs text-sm leading-relaxed text-white/60">
					Bar restaurante de la cooperativa agrícola, en la plaza de la Fuente. Cocina casera,
					menú del día y terraza en el corazón de Algimia de Almonacid.
				</p>
				<div class="text-accent mt-5 flex items-center gap-2 text-sm">
					<i class="ri-star-fill" aria-hidden="true"></i>
					<span class="font-bold text-white">
						{BUSINESS.rating.toString().replace('.', ',')}
					</span>
					<span class="text-white/45">· {BUSINESS.reviewCount} reseñas en Google</span>
				</div>
			</div>

			<div>
				<h2 class="text-[0.62rem] font-bold tracking-[0.2em] text-white/40 uppercase">La casa</h2>
				<ul class="mt-4 space-y-2.5 text-sm">
					{NAV.map((item) => (
						<li>
							<a
								href={`${base}${item.href}`}
								class="text-white/70 transition-colors hover:text-white"
							>
								{item.label}
							</a>
						</li>
					))}
					<li>
						<a
							href={`${base}aviso-legal`}
							class="text-white/70 transition-colors hover:text-white"
						>
							Aviso legal y privacidad
						</a>
					</li>
				</ul>
			</div>

			<div>
				<h2 class="text-[0.62rem] font-bold tracking-[0.2em] text-white/40 uppercase">Horario</h2>
				<ul class="mt-4 space-y-1.5 text-xs">
					{BUSINESS.hours.map((row) => (
						<li class="flex items-baseline justify-between gap-3">
							<span class="text-white/55">{row.days}</span>
							<span class="font-semibold text-white/80">{row.hours}</span>
						</li>
					))}
				</ul>
			</div>

			<div>
				<h2 class="text-[0.62rem] font-bold tracking-[0.2em] text-white/40 uppercase">
					Contacto
				</h2>
				<ul class="mt-4 space-y-3 text-sm">
					<li class="flex gap-2">
						<i class="ri-map-pin-line text-accent mt-0.5" aria-hidden="true"></i>
						<a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="text-white/70 transition-colors hover:text-white"
						>
							{BUSINESS.street}
							<br />
							{BUSINESS.postalCode} {BUSINESS.city}
							<br />
							{BUSINESS.region}
						</a>
					</li>
					<li class="flex gap-2">
						<i class="ri-phone-line text-accent mt-0.5" aria-hidden="true"></i>
						<a
							href={BUSINESS.phoneHref}
							class="text-white/70 transition-colors hover:text-white"
						>
							{BUSINESS.phone}
						</a>
					</li>
					<li class="flex gap-2">
						<i class="ri-google-fill text-accent mt-0.5" aria-hidden="true"></i>
						<a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="text-white/70 transition-colors hover:text-white"
						>
							Ficha y reseñas en Google
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div
			class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-white/40 lg:flex-row lg:items-center lg:justify-between"
		>
			<p>© {year} {BUSINESS.name} · {BUSINESS.city}</p>
			<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
				<a href={`${base}aviso-legal`} class="transition-colors hover:text-white">
					Aviso legal
				</a>
				<a
					href={`${base}aviso-legal#cookies`}
					class="transition-colors hover:text-white"
				>
					Cookies
				</a>
				<span class="hidden text-white/20 sm:inline">|</span>
				<p>
					Creado por Sur Digital ·
					<a
						href={SUR_DIGITAL_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-accent font-semibold text-white underline decoration-white/30 underline-offset-2 transition-colors"
					>
						sur-digital.vercel.app
					</a>
				</p>
			</div>
		</div>
	</div>
</footer>
