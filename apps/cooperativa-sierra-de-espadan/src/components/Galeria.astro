---
import { Image } from 'astro:assets';
import { BUSINESS, GALLERY } from '../data/site';
---

<section id="galeria" class="bg-base-200/60 border-base-300 border-y py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="eyebrow text-secondary">Galería</p>
				<h2
					class="font-display mt-4 text-4xl leading-[1.02] font-light tracking-tight sm:text-5xl"
				>
					La plaza, la mesa <span class="text-primary italic">y la sierra</span>
				</h2>
			</div>
			<p class="text-base-content/60 max-w-xs text-sm leading-relaxed">
				Fotos de la ficha pública de la cooperativa en Google Maps: terraza, cocina y fiestas
				de pueblo.
			</p>
		</div>

		<div class="mt-10 columns-2 gap-4 md:columns-3">
			{GALLERY.map((foto, index) => (
				<figure class="group relative mb-4 break-inside-avoid overflow-hidden bg-base-300">
					<Image
						src={foto.src}
						alt={foto.alt}
						widths={[320, 520, 760]}
						sizes="(min-width: 768px) 30vw, 46vw"
						quality={78}
						loading="lazy"
						class="foto-sierra h-auto w-full transition-transform duration-700 group-hover:scale-[1.03]"
					/>
					<div
						class="from-neutral/80 pointer-events-none absolute inset-0 bg-gradient-to-t via-transparent to-transparent opacity-70 transition-opacity duration-300 group-hover:opacity-90"
						aria-hidden="true"
					></div>
					<figcaption
						class="absolute right-3 bottom-3 left-3 flex items-end justify-between gap-3 text-white"
					>
						<span class="text-[0.72rem] font-semibold tracking-wide">{foto.caption}</span>
						<span class="font-display text-[0.65rem] text-white/50 italic">
							{String(index + 1).padStart(2, '0')}
						</span>
					</figcaption>
				</figure>
			))}
		</div>

		<p class="text-base-content/45 mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
			<i class="ri-google-fill" aria-hidden="true"></i>
			Imágenes publicadas en la ficha de {BUSINESS.name}. Si eres el titular y quieres
			retirarlas, escríbenos.
		</p>
	</div>
</section>
