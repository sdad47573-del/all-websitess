---
import { BUSINESS, REVIEWS } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
---

<section id="opiniones" class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
			<div>
				<p class="eyebrow text-secondary">Opiniones</p>
				<h2
					class="font-display mt-4 text-4xl leading-[1.02] font-light tracking-tight sm:text-5xl"
				>
					Lo que se dice <span class="text-primary italic">en la plaza</span>
				</h2>
				<p class="text-base-content/65 mt-5 max-w-sm text-sm leading-relaxed">
					Tres reseñas de la ficha de Google: la terraza, el menú y el trato.
				</p>

				<div class="border-base-300 bg-base-200/50 mt-7 border p-6">
					<div class="flex items-end gap-4">
						<span class="font-display text-6xl leading-none font-light">
							{BUSINESS.rating.toString().replace('.', ',')}
						</span>
						<div class="pb-1">
							<div class="text-secondary text-base tracking-tight" aria-hidden="true">
								{estrellas.map((n) => (
									<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
								))}
							</div>
							<p class="text-base-content/55 mt-1 text-xs">
								{BUSINESS.reviewCount} reseñas en Google Maps
							</p>
						</div>
					</div>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline btn-sm mt-5 h-10 w-full gap-2 rounded-sm border-base-300 text-xs font-bold hover:border-primary hover:bg-primary hover:text-primary-content"
					>
						<i class="ri-google-fill" aria-hidden="true"></i> Leer todas las reseñas
					</a>
					<p class="text-base-content/40 mt-3 text-center text-[0.62rem]">
						Valoración de la ficha de Google en octubre de 2026.
					</p>
				</div>
			</div>

			<div class="grid gap-4 sm:grid-cols-2">
				{REVIEWS.map((resena, index) => (
					<blockquote
						class={`border-base-300 bg-base-100 relative flex flex-col border p-6 ${
							index === 0 ? 'sm:col-span-2 sm:p-8' : ''
						}`}
					>
						<span
							class="font-display text-base-300 pointer-events-none absolute top-2 right-5 text-6xl leading-none select-none"
							aria-hidden="true"
						>
							”
						</span>
						<div
							class="text-secondary relative text-xs tracking-tight"
							role="img"
							aria-label={`${resena.rating} de 5 estrellas`}
						>
							{Array.from({ length: resena.rating }).map(() => (
								<i class="ri-star-fill" />
							))}
						</div>
						<p
							class={`font-display relative mt-3 flex-1 leading-relaxed ${
								index === 0 ? 'text-xl sm:text-2xl' : 'text-lg'
							}`}
						>
							«{resena.text}»
						</p>
						<footer class="border-base-300 mt-5 flex items-center gap-3 border-t pt-3">
							<span
								class="bg-primary text-primary-content flex size-7 items-center justify-center rounded-full text-[0.65rem] font-bold"
							>
								G
							</span>
							<span class="text-base-content/60 text-[0.7rem] font-semibold">
								{resena.author}
							</span>
							<span class="text-base-content/35 ml-auto text-[0.6rem]">Google</span>
						</footer>
					</blockquote>
				))}
			</div>
		</div>
	</div>
</section>
