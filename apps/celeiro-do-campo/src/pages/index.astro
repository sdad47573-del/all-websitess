---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import buffet from '../assets/fotos/celeiro-do-campo-apaisada-02.jpg';
import sopa from '../assets/fotos/celeiro-do-campo-apaisada-03.jpg';
import guiso from '../assets/fotos/celeiro-do-campo-apaisada-06.jpg';
import plato from '../assets/fotos/celeiro-do-campo-apaisada-08.jpg';
import postre from '../assets/fotos/celeiro-do-campo-apaisada-10.jpg';
import comedor from '../assets/fotos/celeiro-do-campo-vertical-01.jpg';
import barra from '../assets/fotos/celeiro-do-campo-vertical-04.jpg';
import bandeja from '../assets/fotos/celeiro-do-campo-vertical-07.jpg';
import calientes from '../assets/fotos/celeiro-do-campo-vertical-09.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Restaurante Celeiro do Campo, buffet de mediodía en la Av. Luísa Todi 121 (2900-324 Setúbal): sopa, barra de saladas, platos calientes y postre, de lunes a viernes de 12:00 a 15:00. 4,7 en Google con 146 reseñas.';

const galeria = [
	{
		src: buffet,
		alt: 'Barra de saladas del Celeiro do Campo con kiwi, piña, fresa, zanahoria y olivas',
	},
	{
		src: comedor,
		alt: 'Comedor del Celeiro do Campo con lámpara de mimbre, mesas altas y sillas blancas',
	},
	{
		src: barra,
		alt: 'Barra del buffet del Celeiro do Campo con el cartel sobre la pared verde',
	},
	{
		src: sopa,
		alt: 'Cuenco de sopa de verduras con un vaso de zumo en el Celeiro do Campo',
	},
	{
		src: guiso,
		alt: 'Plato del buffet con setas y castañas en salsa cremosa, patata asada y espinacas',
	},
	{
		src: plato,
		alt: 'Bandeja del Celeiro do Campo con patata, arroz, zanahoria rallada, castañas y fruta',
	},
	{
		src: calientes,
		alt: 'Plato con judías verdes, croquetas, hamburguesa, papaya y postre de castañas',
	},
	{
		src: bandeja,
		alt: 'Bandeja con melón, ensalada de remolacha, empanada de queso y castañas en el Celeiro do Campo',
	},
	{
		src: postre,
		alt: 'Postre de crema dulce con coco rallado servido en copa azul en el Celeiro do Campo',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['Celeiro do Campo', 'Celeiro do Campo Setúbal', 'Restaurante Celeiro do Campo'],
	slogan: 'Buffet de mediodía en el centro de Setúbal',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	currenciesAccepted: 'EUR',
	servesCuisine: ['Portuguesa', 'Buffet'],
	areaServed: [
		{ '@type': 'City', name: 'Setúbal' },
		{ '@type': 'AdministrativeArea', name: 'Setúbal' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '12:00',
			closes: '15:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos accesibles para sillas de ruedas',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Buffet', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El buffet', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Celeiro do Campo · Buffet de mediodía en Setúbal';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#3f5233" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Celeiro do Campo Setúbal, buffet Setúbal, restaurante Setúbal, comida de mediodía Setúbal, Av. Luísa Todi, restaurante centro Setúbal, buffet de saladas Setúbal, menú del día Setúbal"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Celeiro do Campo · Buffet de mediodía en Setúbal"
			ogDescription="Sopa, barra de saladas, platos calientes y postre, de lunes a viernes de 12:00 a 15:00. 4,7 en Google con 146 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Barra de saladas del restaurante Celeiro do Campo, Setúbal"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#3f5233"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-15"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.regionName}`}
			countryName="Portugal"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[buffet]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Buffet de mediodía · Setúbal"
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. Luísa Todi, 121 · Setúbal"
				title="El buffet del campo,<br /><em>en el centro de Setúbal.</em>"
				lede="El Celeiro do Campo está en la Av. Luísa Todi, 121, y sirve buffet al mediodía: sopa, barra de saladas, platos calientes y postre, con bandeja y sin esperas. Abre de lunes a viernes, de 12:00 a 15:00, y cierra el fin de semana."
				image={buffet}
				imageAlt="Barra de saladas del Celeiro do Campo con kiwi, piña, fresa, zanahoria y olivas"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Buffet"
				facts={[
					{ label: 'Nota', html: '<b>4,7 en Google</b> con 146 reseñas' },
					{ label: 'Solo mediodía', html: '<b>12:00 – 15:00</b>' },
					{ label: 'Lunes a viernes', html: '<b>5 días</b>' },
					{ label: 'Fin de semana', html: '<b>Cerrado</b>' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece el Celeiro do Campo" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un buffet de barrio,<br /><em>sin prisas y sin sorpresas.</em>"
				paragraphs={[
					'El Celeiro do Campo ocupa un local amplio en la Av. Luísa Todi, 121, en pleno centro de Setúbal. El comedor es luminoso y sencillo: paredes verdes, sillas y mesas blancas de madera, lámpara de mimbre sobre la sala y una barra larga con el cartel del nombre presidiendo la pared.',
					'A mediodía funciona como buffet: se coge la bandeja y se pasa por la sopa, la barra de saladas —lechuga, tomate, zanahoria, remolacha, kiwi, piña y fresa— y las bandejas de platos calientes, con guisos, patata asada, arroz y verdura salteada. Se termina con fruta fresca o el postre del día.',
					'Es un sitio de trabajo y de barrio: se come rápido, se repite si apetece y se sale por poco dinero. Las fotos del perfil muestran las bandejas con papel, los platos ya montados y la crema dulce con coco del postre, servida en copa.',
				]}
				note="La ficha de Google no publica descripción del local, teléfono ni web: solo la dirección, el horario de mediodía, la categoría «Restaurante» y la nota de 4,7 con 146 reseñas. Todo lo que cuenta esta página sale de ahí y de las fotos del perfil."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="El buffet"
				title="Sopa,<br />saladas y<br /><em>platos calientes.</em>"
				description="La ficha no publica carta ni precios: lo que sigue se ve en las fotos del perfil del restaurante, con la barra de saladas, las bandejas del buffet y los platos ya servidos."
				cta={{ label: 'Cómo llegar', href: MAPS.directions }}
				groups={MENU}
				note="El Celeiro do Campo no publica precios en Google y esta web no los inventa. Al ser buffet, el menú cambia cada día: la sopa, los guisos y el postre dependen de lo que se cocine esa mañana. Si buscas una opción concreta, lo mejor es preguntar en la barra."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor,<br />la barra<br /><em>y los platos.</em>"
				description="Estas fotografías proceden del perfil del Celeiro do Campo en Google Maps: la barra de saladas, el comedor con la lámpara de mimbre, la sopa, los guisos del buffet, las bandejas y el postre de coco."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Av. Luísa Todi, 121 · 2900-324 Setúbal"
				title="Solo al mediodía,<br /><em>de lunes a viernes.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Portugal']}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="Abre de 12:00 a 15:00 de lunes a viernes. Sábados y domingos cierra. La ficha avisa de que el horario puede cambiar en festivos, así que conviene mirarla antes de ir."
				mapTitle="Mapa del Celeiro do Campo en la Av. Luísa Todi, 121, Setúbal"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Celeiro do Campo · Setúbal"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: 'Ver en Google Maps ↗', href: MAPS.place, external: true }}
				reserveNote="El restaurante no publica teléfono ni reserva online: la ficha de Google es su único canal público. Se come por turnos de mediodía, así que lo más sencillo es acercarse dentro del horario. La ficha marca entrada y asientos accesibles para sillas de ruedas."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, platos y precios antes de la visita."
			ctaLabel="Cómo llegar"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
