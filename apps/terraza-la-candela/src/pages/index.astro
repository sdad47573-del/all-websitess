---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import entrada from '../assets/fotos/terraza-la-candela-apaisada-07.jpg';
import pisto from '../assets/fotos/terraza-la-candela-apaisada-08.jpg';
import ensalada from '../assets/fotos/terraza-la-candela-apaisada-10.jpg';
import huevos from '../assets/fotos/terraza-la-candela-panoramica-03.jpg';
import hojaldre from '../assets/fotos/terraza-la-candela-panoramica-04.jpg';
import guiso from '../assets/fotos/terraza-la-candela-panoramica-06.jpg';
import tartaChocolate from '../assets/fotos/terraza-la-candela-panoramica-09.jpg';
import solomillo from '../assets/fotos/terraza-la-candela-vertical-01.jpg';
import paella from '../assets/fotos/terraza-la-candela-vertical-05.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Terraza La Candela · cocina española y terraza en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: huevos,
		alt: 'Dos huevos fritos con lonchas de jamón sobre patatas panadera, en un plato de borde calado',
	},
	{
		src: paella,
		alt: 'Paella en paellera de acero con arroz y tropezones de carne, con cuchara negra de servir',
	},
	{
		src: solomillo,
		alt: 'Medallones de solomillo cubiertos de salsa cremosa con perejil, sobre patatas panadera',
	},
	{
		src: guiso,
		alt: 'Carne guisada en salsa con patatas en rodajas, en un plato hondo de borde calado',
	},
	{
		src: pisto,
		alt: 'Pisto de berenjena, calabacín, judía verde, zanahoria y tomate, en un plato blanco con aceite',
	},
	{
		src: ensalada,
		alt: 'Ensalada mixta con lechuga, tomate, cebolla, atún, huevo duro, maíz y zanahoria',
	},
	{
		src: hojaldre,
		alt: 'Postre de hojaldre en forma de flor con helado sobre crema pastelera y canela',
	},
	{
		src: tartaChocolate,
		alt: 'Tarta de chocolate con nata montada y salsa de chocolate sobre el plato',
	},
	{
		src: entrada,
		alt: 'Entrada de La Terraza de La Candela bajo un gran toldo, con el rótulo sobre la puerta y las pizarras de la carta',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#terraza-la-candela`,
	name: BUSINESS.name,
	alternateName: ['La Candela Ciudad Real', 'La Terraza de La Candela', 'Restaurante La Candela'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina española', 'Cocina manchega', 'Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.channel },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"terraza-la-candela-apaisada-07.jpg": entrada,
	"terraza-la-candela-panoramica-03.jpg": huevos,
	"terraza-la-candela-vertical-05.jpg": paella,
	"terraza-la-candela-vertical-01.jpg": solomillo,
	"terraza-la-candela-panoramica-06.jpg": guiso,
	"terraza-la-candela-apaisada-08.jpg": pisto,
	"terraza-la-candela-apaisada-10.jpg": ensalada,
	"terraza-la-candela-panoramica-04.jpg": hojaldre,
	"terraza-la-candela-panoramica-09.jpg": tartaChocolate,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17130f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Terraza La Candela Ciudad Real, restaurante cocina española Ciudad Real, Avenida de los Reyes Católicos 7, terraza para comer Ciudad Real, raciones y guisos Ciudad Real, restaurante 13005, paella Ciudad Real"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina española, guisos y terraza con toldo en la Avenida de los Reyes Católicos, 7, de Ciudad Real. Carta variada y postres caseros. 3,4 sobre 5 con 274 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Huevos fritos con jamón sobre patatas de la Terraza La Candela"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#17130f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[entrada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Cocina española · terraza"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Terraza La Candela"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
