---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import entrada from '../assets/fotos/terraza-la-candela-apaisada-07.jpg';
import pisto from '../assets/fotos/terraza-la-candela-apaisada-08.jpg';
import ensalada from '../assets/fotos/terraza-la-candela-apaisada-10.jpg';
import huevos from '../assets/fotos/terraza-la-candela-panoramica-03.jpg';
import hojaldre from '../assets/fotos/terraza-la-candela-panoramica-04.jpg';
import guiso from '../assets/fotos/terraza-la-candela-panoramica-06.jpg';
import tartaChocolate from '../assets/fotos/terraza-la-candela-panoramica-09.jpg';
import solomillo from '../assets/fotos/terraza-la-candela-vertical-01.jpg';
import paella from '../assets/fotos/terraza-la-candela-vertical-05.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, RATING, SERVICIOS } from '../data/site';

const title = 'Terraza La Candela · cocina española y terraza en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: huevos,
		alt: 'Dos huevos fritos con lonchas de jamón sobre patatas panadera, en un plato de borde calado',
	},
	{
		src: paella,
		alt: 'Paella en paellera de acero con arroz y tropezones de carne, con cuchara negra de servir',
	},
	{
		src: solomillo,
		alt: 'Medallones de solomillo cubiertos de salsa cremosa con perejil, sobre patatas panadera',
	},
	{
		src: guiso,
		alt: 'Carne guisada en salsa con patatas en rodajas, en un plato hondo de borde calado',
	},
	{
		src: pisto,
		alt: 'Pisto de berenjena, calabacín, judía verde, zanahoria y tomate, en un plato blanco con aceite',
	},
	{
		src: ensalada,
		alt: 'Ensalada mixta con lechuga, tomate, cebolla, atún, huevo duro, maíz y zanahoria',
	},
	{
		src: hojaldre,
		alt: 'Postre de hojaldre en forma de flor con helado sobre crema pastelera y canela',
	},
	{
		src: tartaChocolate,
		alt: 'Tarta de chocolate con nata montada y salsa de chocolate sobre el plato',
	},
	{
		src: entrada,
		alt: 'Entrada de La Terraza de La Candela bajo un gran toldo, con el rótulo sobre la puerta y las pizarras de la carta',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#terraza-la-candela`,
	name: BUSINESS.name,
	alternateName: ['La Candela Ciudad Real', 'La Terraza de La Candela', 'Restaurante La Candela'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina española', 'Cocina manchega', 'Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.channel },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17130f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Terraza La Candela Ciudad Real, restaurante cocina española Ciudad Real, Avenida de los Reyes Católicos 7, terraza para comer Ciudad Real, raciones y guisos Ciudad Real, restaurante 13005, paella Ciudad Real"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina española, guisos y terraza con toldo en la Avenida de los Reyes Católicos, 7, de Ciudad Real. Carta variada y postres caseros. 3,4 sobre 5 con 274 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Huevos fritos con jamón sobre patatas de la Terraza La Candela"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#17130f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[entrada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Cocina española · terraza"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Cocina de casa <br /><em>bajo el toldo.</em>"
				lede={`La Terraza de La Candela está en la Avenida de los Reyes Católicos, 7, de Ciudad Real. Cocina española de siempre —guisos con patatas, huevos con jamón, solomillo en salsa, arroces y postres caseros— servida en un local con terraza cubierta por un gran toldo. La ficha de Google le da 3,4 sobre 5 con 274 reseñas.`}
				image={entrada}
				imageAlt="Entrada de La Terraza de La Candela bajo un gran toldo, con el rótulo sobre la puerta y las pizarras de la carta"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>3,4</b> en Google · 274 reseñas' },
					{
						label: 'Horario',
						html: '<b>No publicado</b><br />La ficha solo indica si está abierta ahora',
					},
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> horario y reservas` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Terraza La Candela" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una terraza <br /><em>de mantel.</em>"
				paragraphs={[
					'La Candela ocupa el número 7 de la Avenida de los Reyes Católicos, en Ciudad Real, con la puerta bajo un gran toldo y el rótulo «La Terraza de La Candela» escrito en cursiva. A los lados de la entrada cuelgan las pizarras con la carta del día, escritas a mano.',
					'Dentro, las mesas se ponen con mantel blanco y plato de borde calado; fuera, las sillas de terraza se colocan bajo el toldo, que es lo que da nombre al local. Google lo clasifica como restaurante de cocina española y le añade la etiqueta «Brunch».',
					'La cocina que enseñan las fotos del perfil es la de siempre: huevos fritos con jamón sobre patatas panadera, solomillo con salsa cremosa, carne guisada en su jugo, pisto de verduras, ensalada mixta, paella en paellera y postres de hojaldre con helado o tarta de chocolate. Una reseña lo resume así: «carta variada, raciones adecuadas, muy buen producto y bien elaborado».',
					'La ficha marca acceso, aseo y asientos adaptados para sillas de ruedas, y no publica horario semanal ni web propia. Esa ausencia es la primera cosa que se nota al buscar el local: aquí no se rellena con horas inventadas.',
				]}
				note="Los datos salen de la ficha pública de Google Maps, de las reseñas destacadas y de las fotos del perfil. Ni la carta ni el horario están publicados por el establecimiento: si algo cambia, manda lo que digan en el local o por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver la terraza en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Guisos, arroces <br /><em>y postres.</em>"
				description="Los platos que aparecen aquí son los que enseñan las fotos del perfil y los que nombran las reseñas. La carta existe —está en las pizarras de la entrada—, pero el local no la tiene publicada."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="Esta página no publica precios: la ficha no tiene carta con importes y las pizarras de la entrada no se leen con nitidez en la foto. Lo que hay cada día se pregunta en el local o en el 926 92 20 83."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Nueve fotos <br /><em>de la mesa.</em>"
				description="Las fotografías del perfil de Terraza La Candela en Google Maps: los huevos con jamón, la paella, los guisos, el pisto, la ensalada, los postres y la entrada con su toldo."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a los <br /><em>Reyes Católicos.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Castilla-La Mancha, España',
				]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="La ficha de Google no publica el horario semanal de este local: solo muestra si está abierto en el momento de la consulta. Antes de venir, llama al 926 92 20 83 para confirmar la apertura de ese día; en festivos y temporada de terraza puede cambiar."
				mapTitle="Mapa de Terraza La Candela en la Avenida de los Reyes Católicos 7, Ciudad Real"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Terraza La Candela"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. El local no publica web propia ni sistema de reservas, así que el teléfono es el canal directo para reservar mesa, preguntar por la terraza o conocer el horario del día."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Terraza La Candela"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
