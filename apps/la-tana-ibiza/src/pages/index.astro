---
import { Image } from 'astro:assets';
import '../styles/global.css';
import fotoFachada from '../assets/fotos/la-tana-ibiza-apaisada-01.jpg';
import fotoPastaDorada from '../assets/fotos/la-tana-ibiza-apaisada-06.jpg';
import fotoPostre from '../assets/fotos/la-tana-ibiza-vertical-02.jpg';
import fotoSolomillo from '../assets/fotos/la-tana-ibiza-vertical-03.jpg';
import fotoCalle from '../assets/fotos/la-tana-ibiza-vertical-04.jpg';
import fotoPastas from '../assets/fotos/la-tana-ibiza-vertical-05.jpg';
import fotoPastaAmarilla from '../assets/fotos/la-tana-ibiza-vertical-07.jpg';
import fotoPastaTrufa from '../assets/fotos/la-tana-ibiza-vertical-08.jpg';
import fotoFocaccia from '../assets/fotos/la-tana-ibiza-vertical-09.jpg';
import fotoVieiras from '../assets/fotos/la-tana-ibiza-vertical-10.jpg';
import {
	business,
	directionsUrl,
	facebookUrl,
	faqSchema,
	faqs,
	googleReviewsUrl,
	hours,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	specialties,
	tripadvisorUrl,
} from '../lib/business';

const title = 'La Tana | Trattoria siciliana en Dalt Vila, Ibiza';
const description =
	'La Tana, trattoria siciliana en Carrer del Passadís, 3, en el casco antiguo de Eivissa. Pasta fresca, pescado y carnes. Reservas: +34 630 25 89 84. Abre de 19:30 a 02:00.';
const keywords =
	'La Tana Ibiza, restaurante italiano Ibiza, trattoria Dalt Vila, pasta fresca Ibiza, restaurante casco antiguo Eivissa, reservar La Tana Ibiza, Carrer del Passadís';

/** Fotografías descargadas de la ficha pública de Google Maps del restaurante. */
const galeria = [
	{
		src: fotoSolomillo,
		alt: 'Solomillo poco hecho con láminas de trufa, setas y flores comestibles en un plato blanco',
		caption: 'Solomillo y trufa',
		sizes: '(min-width: 861px) 23vw, 46vw',
		widths: [320, 480, 640],
	},
	{
		src: fotoPastas,
		alt: 'Tres platos de pasta y marisco de La Tana servidos en vajilla de flores azules',
		caption: 'Pasta y marisco',
		sizes: '(min-width: 861px) 23vw, 46vw',
		widths: [320, 480, 640],
	},
	{
		src: fotoFocaccia,
		alt: 'Focaccia con aceite de oliva en el centro de una mesa de madera, con cesta de pan y aceitunas',
		caption: 'Focaccia de la casa',
		sizes: '(min-width: 861px) 23vw, 46vw',
		widths: [320, 480, 640],
	},
	{
		src: fotoPostre,
		alt: 'Postre cubierto de pistacho en un plato negro, junto a una vela encendida',
		caption: 'Dulce de pistacho',
		sizes: '(min-width: 861px) 23vw, 46vw',
		widths: [320, 480, 640],
	},
	{
		src: fotoCalle,
		alt: 'Terraza nocturna en una calle del casco antiguo de Eivissa, con luces de colores',
		caption: 'Dalt Vila, de noche',
		sizes: '(min-width: 861px) 48vw, 100vw',
		widths: [480, 720, 960, 1200],
	},
	{
		src: fotoPastaAmarilla,
		alt: 'Pasta fresca amarilla con trufa rallada servida en un plato de flores azules',
		caption: 'Pasta fresca',
		sizes: '(min-width: 861px) 23vw, 46vw',
		widths: [320, 480, 640],
	},
	{
		src: fotoPastaTrufa,
		alt: 'Pasta con trufa servida en la mesa, con una cuchara y una vela encendida',
		caption: 'Trufa en la mesa',
		sizes: '(min-width: 861px) 23vw, 46vw',
		widths: [320, 480, 640],
	},
	{
		src: fotoVieiras,
		alt: 'Entrante de vieiras con frutos rojos, hierbas y chips crujientes',
		caption: 'Vieiras',
		sizes: '(min-width: 861px) 23vw, 46vw',
		widths: [320, 480, 640],
	},
	{
		src: fotoPastaDorada,
		alt: 'Pasta fresca en salsa dorada con láminas de parmesano en un plato blanco',
		caption: 'Salsa dorada',
		sizes: '(min-width: 861px) 23vw, 46vw',
		widths: [320, 480, 640],
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f4ecdc" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="La Tana" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-IB" />
		<meta name="geo.placename" content="Eivissa" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..600&family=IBM+Plex+Mono:wght@400;500&family=Karla:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="La Tana" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Fachada de La Tana en Carrer del Passadís, Dalt Vila, Eivissa" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.jpg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="La Tana, inicio">
				<span class="brand-mark" aria-hidden="true">LT</span>
				<span class="brand-copy">
					<strong>La Tana</strong>
					<small>Trattoria · Dalt Vila · Eivissa</small>
				</span>
			</a>
			<nav class="site-nav" aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">Carta</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
					<path d="M6.6 3.5 9 4.9l-1.3 3.3a13 13 0 0 0 6.1 6.1l3.3-1.3 1.4 2.4c.4.7.2 1.6-.5 2l-1.6.9c-1.8 1-4.2.2-7.2-2.6-3-3-3.9-5.4-2.9-7.2l.9-1.6c.4-.7 1.3-.9 2-.5Z" />
				</svg>
				630 25 89 84
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Cucina siciliana · Casco antiguo de Eivissa</p>
						<h1 id="hero-title">La Sicilia,<br />al fondo del <em>callejón.</em></h1>
						<p class="hero-intro">
							Una trattoria recogida en el corazón de Dalt Vila. Pasta fresca, pescado del día, carnes y
							postres italianos, con la calma de un callejón peatonal y la mesa puesta hasta la madrugada.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href={phoneHref}>
								Llamar y reservar
								<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M3 13 13 3M6 3h7v7" />
								</svg>
							</a>
							<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">
								Cómo llegar
								<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M8 14s5-4.6 5-8A5 5 0 0 0 3 6c0 3.4 5 8 5 8Z" /><circle cx="8" cy="6" r="1.6" />
								</svg>
							</a>
						</div>
						<div class="hero-meta">
							<div>
								<small>Nos encontrarás</small>
								<address>
									Carrer del Passadís, 3<br />
									07800 Eivissa · Illes Balears
								</address>
							</div>
							<div>
								<small>Cada día</small>
								<p>19:30 – 02:00<br /><a href={phoneHref}>{business.phone}</a></p>
							</div>
						</div>
					</div>

					<div class="hero-media">
						<div class="hero-photo">
							<Image
								src={fotoFachada}
								alt="Fachada blanca de La Tana en Carrer del Passadís, con el rótulo del restaurante, hiedra y jaulas de mimbre"
								format="webp"
								quality={82}
								widths={[560, 840, 1120, 1400]}
								sizes="(min-width: 861px) 44vw, 100vw"
								loading="eager"
								fetchpriority="high"
							/>
						</div>
						<span class="hero-vertical" aria-hidden="true">Dalt Vila · 38.9088° N</span>
						<div class="rating-card">
							<strong>4,4 <span aria-hidden="true">★</span></strong>
							<small>325 reseñas en <a href={googleReviewsUrl} target="_blank" rel="noreferrer">Google</a></small>
						</div>
					</div>
				</div>
			</section>

			<div class="band" aria-label="Especialidades de La Tana">
				<div class="wrap">
					<ul>
						<li>Pasta fresca</li>
						<li>Pescado del día</li>
						<li>Focacce y pan de la casa</li>
						<li>Limoncello casero</li>
					</ul>
				</div>
			</div>

			<section class="section story" id="casa" aria-labelledby="story-title">
				<div class="wrap">
					<div class="story-grid">
						<div>
							<p class="section-label">La casa</p>
							<h2 id="story-title">Una <em>tana</em> es<br />un escondite.</h2>
						</div>
						<div class="story-copy">
							<p>
								En italiano, <em>tana</em> es la guarida: el sitio recogido donde uno se mete para estar a
								gusto. Ese es el gesto de esta trattoria en Carrer del Passadís, 3, en pleno casco antiguo de
								Eivissa.
							</p>
							<p>
								La cocina parte de Sicilia y mira al Mediterráneo. Pasta, pan y focacce de la casa, pescado
								fresco, carnes y postres italianos; también limoncello casero y coctelería para alargar la
								sobremesa. La carta se mueve con el mercado, así que conviene preguntar por lo que hay ese día.
							</p>
							<p class="story-signature">Pasta, pescado y una mesa sin prisa.</p>
							<p class="source-note">
								Datos de la ficha pública de Google Maps, del perfil de Instagram del restaurante y de su
								página de Facebook, consultados en octubre de 2026. La selección de platos es orientativa; no
								es la carta oficial.
							</p>
						</div>
					</div>
					<div class="facts">
						<div class="fact"><strong>Sicilia</strong><span>El origen de la cocina</span></div>
						<div class="fact"><strong>2:00</strong><span>Hora de cierre, todos los días</span></div>
						<div class="fact"><strong>4,4 / 5</strong><span>325 reseñas en Google</span></div>
					</div>
				</div>
			</section>

			<section class="section menu-section" id="carta" aria-labelledby="menu-title">
				<div class="wrap">
					<div class="menu-head">
						<div>
							<p class="section-label">La carta</p>
							<h2 id="menu-title">De Sicilia<br />a <em>la mesa.</em></h2>
						</div>
						<p>
							Una selección orientativa de lo que aparece en las reseñas y en la descripción pública del
							restaurante. Precios, platos del día y alérgenos se consultan al reservar.
						</p>
					</div>
					<div class="menu-grid">
						{specialties.map((dish, index) => (
							<article class="menu-item">
								<span class="menu-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
								<small>{dish.category}</small>
								<h3>{dish.name}</h3>
								<p>{dish.description}</p>
							</article>
						))}
					</div>
					<p class="menu-note">
						La carta cambia según el mercado y la temporada. Llama al <a href={phoneHref}>{business.phone}</a>
						para preguntar por los platos del día, las opciones vegetarianas o la disponibilidad de mesa.
					</p>
				</div>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<div class="wrap">
					<div class="gallery-head">
						<div>
							<p class="section-label">La mesa</p>
							<h2 id="gallery-title">Del plato<br />al <em>callejón.</em></h2>
						</div>
						<p>
							Nueve imágenes de la ficha pública de La Tana: pasta, focaccia, carne, postre y el casco antiguo
							de Eivissa cuando cae la noche.
						</p>
					</div>
					<div class="gallery-grid">
						{galeria.map((foto) => (
							<figure class="gallery-photo">
								<Image
									src={foto.src}
									alt={foto.alt}
									format="webp"
									quality={78}
									widths={foto.widths}
									sizes={foto.sizes}
									loading="lazy"
								/>
								<figcaption>{foto.caption}</figcaption>
							</figure>
						))}
					</div>
					<div class="gallery-foot">
						<div class="gallery-links">
							<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
							<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
							<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
						</div>
						<p class="gallery-note">
							Fotografías alojadas desde la ficha pública del restaurante en Google Maps. Si eres el titular y
							quieres retirar alguna, escríbenos y la quitamos.
						</p>
					</div>
				</div>
			</section>

			<section class="section reviews" aria-labelledby="reviews-title">
				<div class="wrap">
					<div class="reviews-head">
						<div>
							<p class="section-label">Quien ha venido</p>
							<h2 id="reviews-title">La mesa, <em>palabra a palabra.</em></h2>
						</div>
						<div class="reviews-score">
							<strong>4,4</strong>
							<small>
								<span class="stars" aria-hidden="true">★★★★★</span><br />
								325 reseñas en Google<br />
								<a href={googleReviewsUrl} target="_blank" rel="noreferrer">Leerlas en Google ↗</a>
							</small>
						</div>
					</div>
					<div class="review-grid">
						{reviews.map((review) => (
							<article class="review">
								<blockquote>«{review.quote}»</blockquote>
								<footer>
									<span aria-label={`${review.rating} de 5 estrellas`}>
										{'★'.repeat(review.rating)}
									</span>
									{review.source === 'Google' ? (
										<a href={googleReviewsUrl} target="_blank" rel="noreferrer">Reseña en Google ↗</a>
									) : (
										<a href={tripadvisorUrl} target="_blank" rel="noreferrer">Reseña en Tripadvisor ↗</a>
									)}
								</footer>
							</article>
						))}
					</div>
					<p class="reviews-note">
						Comentarios publicados por clientes en Google y Tripadvisor. Se reproducen de forma literal o
						ligeramente resumida; la valoración media corresponde a Google en octubre de 2026.
					</p>
				</div>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div class="wrap visit-grid">
					<div>
						<p class="section-label">Visítanos</p>
						<h2 id="visit-title">Un callejón<br />en <em>Dalt Vila.</em></h2>
						<address>
							<strong>La Tana</strong><br />
							Carrer del Passadís, 3<br />
							07800 Eivissa · Illes Balears
						</address>
						<ul class="hours" aria-label="Horario de La Tana">
							{hours.map((row) => (
								<li><span>{row.day}</span><span>{row.time}</span></li>
							))}
						</ul>
						<div class="contact-lines">
							<span><a href={phoneHref}>{business.phone}</a></span>
							<span>
								<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a> ·
								<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a> ·
								<a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor</a>
							</span>
						</div>
						<div class="visit-actions">
							<a class="button button-primary" href={directionsUrl} target="_blank" rel="noreferrer">
								Cómo llegar
								<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M3 13 13 3M6 3h7v7" />
								</svg>
							</a>
							<a class="button button-ghost" href={phoneHref}>Llamar para reservar</a>
						</div>
						<p class="visit-note">
							Horario publicado por el restaurante. En festivos y en temporada alta puede variar: confirma por
							teléfono antes de venir.
						</p>
					</div>
					<div class="map-card">
						<iframe
							title="Mapa de La Tana en Carrer del Passadís, 3, Eivissa"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<div class="map-label">
							<div>
								<strong>La Tana</strong><br />
								<small>Carrer del Passadís, 3 · Eivissa</small>
							</div>
							<a href={mapsUrl} target="_blank" rel="noreferrer">Abrir en Maps ↗</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="section-label">Antes de venir</p>
					<h2 id="faq-title">Preguntas <em>frecuentes.</em></h2>
					<div class="faq-grid">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-top">
					<div class="footer-brand">
						<a class="brand" href="#inicio" aria-label="La Tana, volver al inicio">
							<span class="brand-mark" aria-hidden="true">LT</span>
							<span class="brand-copy">
								<strong>La Tana</strong>
								<small>Trattoria · Dalt Vila · Eivissa</small>
							</span>
						</a>
						<p>
							Cocina siciliana en el casco antiguo de Eivissa. Pasta fresca, pescado, carnes y postres
							italianos en Carrer del Passadís, 3.
						</p>
					</div>
					<div class="footer-col">
						<h2>Explorar</h2>
						<ul>
							<li><a href="#casa">La casa</a></li>
							<li><a href="#carta">Carta</a></li>
							<li><a href="#fotos">Fotos</a></li>
							<li><a href="#preguntas">Preguntas frecuentes</a></li>
						</ul>
					</div>
					<div class="footer-col">
						<h2>Contacto</h2>
						<ul>
							<li><address>Carrer del Passadís, 3<br />07800 Eivissa</address></li>
							<li><a href={phoneHref}>{business.phone}</a></li>
							<li><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a></li>
							<li><a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a></li>
							<li><a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor</a></li>
						</ul>
					</div>
				</div>
				<div class="footer-bottom">
					<small class="copyright">
						© {new Date().getFullYear()} La Tana · Eivissa. Horarios y carta orientativos; confirma con el
						restaurante.
					</small>
					<nav class="legal-links" aria-label="Información legal">
						<a href="/aviso-legal">Aviso legal</a>
						<a href="/aviso-legal#privacidad">Privacidad</a>
						<a href="/aviso-legal#cookies">Cookies</a>
					</nav>
					<small class="credit">
						Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
						sur-digital.vercel.app
					</small>
				</div>
			</div>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar y reservar <span>{business.phone}</span></a>
	</body>
</html>
