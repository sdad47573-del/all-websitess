---
import '../styles/global.css';

const business = {
	name: 'Restaurante Casa Alfonso',
	street: 'Calle Sófocles, 8',
	district: 'Teatinos-Universidad',
	city: 'Málaga',
	postalCode: '29010',
	phone: '+34 952 10 29 56',
	latitude: 36.7210747,
	longitude: -4.4832018,
	site: 'https://casa-alfonso-teatinos.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+Casa+Alfonso/@36.7210747,-4.5213106,14z/data=!4m7!3m6!1s0xd72f0caff031965:0xfaa4a986e9ea1a5c!8m2!3d36.7210747!4d-4.4832018!15sCgxSZXN0YXVyYW50ZXNaDiIMcmVzdGF1cmFudGVzkgEKcmVzdGF1cmFudJoBI0NoWkRTVWhOTUc5blMwVkpRMEZuU1VOd2JGQmZla05uRUFF4AEA-gEECAAQPg!16s%2Fg%2F11b6djk4x3?entry=tts';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34952102956';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurant`,
	name: business.name,
	description:
		'Restaurante de cocina casera española en Teatinos, Málaga. En Calle Sófocles, 8.',
	url: `${business.site}/`,
	telephone: business.phone,
	servesCuisine: ['Cocina española', 'Cocina casera'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#244336" />
		<meta
			name="description"
			content="Restaurante Casa Alfonso: cocina casera española en Teatinos, Málaga. Estamos en Calle Sófocles, 8. Consulta cómo llegar, teléfono y fotos de Google Maps."
		/>
		<meta
			name="keywords"
			content="Restaurante Casa Alfonso Málaga, Casa Alfonso Teatinos, restaurantes en Teatinos, cocina casera Málaga, comida casera Teatinos, menú del día Teatinos, Calle Sófocles 8, restaurante Málaga"
		/>
		<meta name="author" content="Restaurante Casa Alfonso" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap"
			rel="stylesheet"
		/>
		<title>Restaurante Casa Alfonso | Cocina casera en Teatinos, Málaga</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Restaurante Casa Alfonso · Teatinos, Málaga" />
		<meta
			property="og:description"
			content="Cocina casera y trato familiar en Calle Sófocles, 8. Teatinos, Málaga."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.svg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Restaurante Casa Alfonso en Teatinos, Málaga" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Restaurante Casa Alfonso · Teatinos, Málaga" />
		<meta
			name="twitter:description"
			content="Cocina casera y trato familiar en Calle Sófocles, 8. Teatinos, Málaga."
		/>
		<meta name="twitter:image" content={`${business.site}/og.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante Casa Alfonso, inicio">
				<span class="brand-emblem" aria-hidden="true">A</span>
				<span class="brand-title">Casa Alfonso<small>Restaurante · Teatinos</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#cocina">La cocina</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Cómo llegar</a>
			</nav>
			<a class="header-phone" href={phoneHref}>952 10 29 56 <span>↗</span></a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> Teatinos · Málaga</p>
					<h1 id="hero-title">Comer como<br />en <em>casa.</em></h1>
					<p class="hero-lede">
						Una casa de comidas de barrio, cocina española y mesas para compartir el día sin prisa.
					</p>
					<div class="hero-actions">
						<a class="button button-gold" href={phoneHref}>Llamar al restaurante <span aria-hidden="true">↗</span></a>
						<a class="text-link" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<p class="hero-address"><span aria-hidden="true">⌖</span> Calle Sófocles, 8 · 29010 Málaga</p>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración editorial de una mesa de restaurante con un plato casero">
					<div class="art-window"><span class="sun"></span><span class="window-frame"></span></div>
					<div class="art-poster"><span>BUENA MESA</span><b>BUEN RATO</b><i>TEATINOS · MÁLAGA</i></div>
					<div class="art-table"></div>
					<div class="plate"><span class="plate-dish"><i></i><i></i><i></i><i></i></span></div>
					<div class="glass"><span></span></div>
					<div class="cutlery"></div>
					<span class="art-label">ILUSTRACIÓN · NO ES FOTO DEL LOCAL</span>
				</div>
				<div class="hero-stamp" aria-hidden="true"><span>CASA<br />ALFONSO</span><i>✳</i></div>
			</section>

			<section class="story section-pad" id="casa">
				<p class="section-label"><span></span> Una casa de comidas en Teatinos</p>
				<div class="story-grid">
					<h2>Los sabores<br />de <em>toda la vida.</em></h2>
					<div class="story-copy">
						<p>
							Casa Alfonso es un restaurante de cocina española en el barrio de Teatinos-Universidad, en Málaga. Un punto de encuentro cercano para desayunar, almorzar o sentarse a la mesa en compañía.
						</p>
						<p>
							Visitantes destacan la cocina casera y el trato familiar. Consulta la carta y la disponibilidad directamente con el restaurante, ya que los platos pueden cambiar.
						</p>
						<a class="simple-link" href={mapsUrl} target="_blank" rel="noreferrer">Leer opiniones recientes en Google Maps <span aria-hidden="true">↗</span></a>
					</div>
				</div>
				<div class="story-rule"><span>CASA ALFONSO</span><i></i><span>DESDE TEATINOS, MÁLAGA</span></div>
			</section>

			<section class="kitchen section-pad" id="cocina">
				<div class="kitchen-heading">
					<div><p class="eyebrow dark"><span></span> Platos mencionados por clientes</p><h2>De los que<br />piden <em>repetir.</em></h2></div>
					<p>Ideas inspiradas en reseñas públicas. No es una carta oficial: pregunta por los platos y precios disponibles hoy.</p>
				</div>
				<div class="dish-grid">
					<article class="dish-card dish-albondigas"><span class="dish-kicker">Cocina de casa</span><div class="dish-illustration meatballs" aria-hidden="true"><i></i><i></i><i></i><i></i></div><h3>Albóndigas</h3><p>Un guiso que sabe a recuerdo.</p></article>
					<article class="dish-card dish-snails"><span class="dish-kicker">Para compartir</span><div class="dish-illustration snails" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div><h3>Caracoles</h3><p>Una de las recomendaciones de los comensales.</p></article>
					<article class="dish-card dish-fish"><span class="dish-kicker">Sabor de Málaga</span><div class="dish-illustration fish" aria-hidden="true"><i></i><i></i><i></i></div><h3>Pescado y calamar</h3><p>Consulta la selección del día en el restaurante.</p></article>
				</div>
				<p class="menu-note">Platos sujetos a disponibilidad. No se muestran precios porque no hay una carta oficial verificable.</p>
			</section>

			<section class="gallery section-pad" id="fotos">
				<div class="gallery-copy">
					<p class="eyebrow dark"><span></span> Fotos originales del restaurante</p>
					<h2>La casa,<br />a través de <em>tu mirada.</em></h2>
					<p>Abre la ficha de Google Maps para ver las fotos compartidas por clientes. La ilustración es decorativa, no representa el local.</p>
					<a class="button button-forest" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a>
				</div>
				<a class="gallery-art" href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Ver la ficha y fotos de Restaurante Casa Alfonso en Google Maps">
					<div class="gallery-art-scene" aria-hidden="true"><span class="gallery-window"></span><span class="gallery-table"></span><span class="gallery-plate"></span><span class="gallery-sun">✳</span></div>
					<span class="gallery-caption"><span>Ilustración decorativa</span><b>Ver fotos reales ↗</b></span>
				</a>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span></span> Teatinos-Universidad</p>
					<h2>Nos vemos<br /><em>en Casa Alfonso.</em></h2>
					<p class="address">Calle Sófocles, 8<br />29010 Málaga, España</p>
					<div class="visit-links"><a class="button button-gold" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a><a class="phone-link" href={phoneHref}>+34 952 10 29 56</a></div>
					<p class="hours-note">El horario publicado en directorios puede variar. Confírmalo llamando antes de venir.</p>
				</div>
				<div class="map-frame">
					<iframe
						title="Mapa de Restaurante Casa Alfonso en Calle Sófocles, Teatinos, Málaga"
						src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span>⌖</span> Restaurante Casa Alfonso · Málaga</a>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio"><span class="brand-emblem" aria-hidden="true">A</span><span class="brand-title">Casa Alfonso<small>Restaurante · Teatinos</small></span></a>
			<p>Cocina casera española en Málaga</p>
			<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps <span aria-hidden="true">↗</span></a>
			<small>© {new Date().getFullYear()} Restaurante Casa Alfonso</small>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>952 10 29 56</span></a>
	</body>
</html>
