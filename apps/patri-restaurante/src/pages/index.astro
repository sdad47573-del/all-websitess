---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/patri-restaurante-apaisada-01.jpg';
import torrija from '../assets/fotos/patri-restaurante-vertical-02.jpg';
import pescadoAjo from '../assets/fotos/patri-restaurante-apaisada-03.jpg';
import pescadoSalsa from '../assets/fotos/patri-restaurante-vertical-04.jpg';
import ensalada from '../assets/fotos/patri-restaurante-vertical-05.jpg';
import calle from '../assets/fotos/patri-restaurante-vertical-06.jpg';
import exterior from '../assets/fotos/patri-restaurante-apaisada-07.jpg';
import pared from '../assets/fotos/patri-restaurante-apaisada-08.jpg';
import iglesia from '../assets/fotos/patri-restaurante-apaisada-09.jpg';
import mousse from '../assets/fotos/patri-restaurante-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'PATRI Restaurante, cocina casera en Kale Nagusia 14, Usurbil (Gipuzkoa). Menú del día, pescado y carne. Comidas de 11:00 a 16:00. Tel. 943 36 27 25.';

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de PATRI Restaurante con vigas de madera, paredes de piedra encalada y manteles azules',
	},
	{
		src: exterior,
		alt: 'Exterior de PATRI Restaurante en Usurbil, con la fachada blanca, el rótulo Bar Patri Jatetxea y el porche',
	},
	{
		src: pescadoAjo,
		alt: 'Pescado con ajo y perejil en aceite servido en PATRI Restaurante',
	},
	{
		src: pescadoSalsa,
		alt: 'Pescado en salsa blanca con patatas en rodajas en PATRI Restaurante',
	},
	{
		src: calle,
		alt: 'Calle de Usurbil con el rótulo colgante de Bar Patri Jatetxea y un arco de piedra al fondo',
	},
	{
		src: iglesia,
		alt: 'Iglesia de piedra junto a la fachada blanca de PATRI Restaurante, con el cartel de Jatetxea',
	},
	{
		src: ensalada,
		alt: 'Ensalada mixta con atún, huevo, espárragos y aceitunas en PATRI Restaurante',
	},
	{
		src: torrija,
		alt: 'Torrija con salsa de chocolate en un plato de PATRI Restaurante',
	},
	{
		src: mousse,
		alt: 'Mousse de chocolate con nata montada en un cuenco de cristal en PATRI Restaurante',
	},
	{
		src: pared,
		alt: 'Pared blanca del comedor de PATRI Restaurante decorada con pájaros y mariposas de metal',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#patri`,
	name: BUSINESS.name,
	alternateName: ['Patri', 'Bar Patri', 'Bar Patri Jatetxea', 'Patri Usurbil'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 943 36 27 25',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Vasca', 'Española', 'Casera'],
	areaServed: [
		{ '@type': 'City', name: 'Usurbil' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '19:00',
			closes: '23:59',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'La comida casera era muy rica, la camarera muy amable y atenta.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody:
				'Comimos ensalada de tomate con bonito y chuleta con pimientos y patatas.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 4, bestRating: 5 },
			reviewBody:
				'El arroz con hongos y huevo muy rico y el filete con roquefort super jugoso.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'PATRI Restaurante · Comida casera en Usurbil';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#24544f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="PATRI Restaurante Usurbil, Bar Patri Usurbil, comer en Usurbil, menú del día Usurbil, restaurante Usurbil, comida casera Gipuzkoa, restaurante Kale Nagusia, cenar en Usurbil"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="PATRI Restaurante · Comida casera en Usurbil"
			ogDescription="Cocina casera, menú del día, pescado y carne en Kale Nagusia 14 (Usurbil). Comidas de 11:00 a 16:00 y cenas viernes y sábado. Tel. 943 36 27 25."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Comedor de PATRI Restaurante con vigas de madera y paredes de piedra encalada"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#24544f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34943362725"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="PATRI"
			subtitle="Restaurante · Usurbil"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Kale Nagusia Kalea, 14 · Usurbil"
				title="Comida casera<br /><em>en Usurbil.</em>"
				lede={`PATRI Restaurante es un restaurante de cocina casera en Kale Nagusia Kalea, 14, de Usurbil (Gipuzkoa), junto a la iglesia. Menú del día, pescado, carne y postres en un comedor de piedra encalada y vigas de madera. Come todos los días de 11:00 a 16:00 y cena viernes y sábado, de 19:00 a 24:00. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={comedor}
				imageAlt="Comedor de PATRI Restaurante con vigas de madera y paredes de piedra encalada"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)`,
					},
					{ label: 'Comidas', html: 'Todos los días · 11:00–16:00' },
					{ label: 'Cenas', html: 'Viernes y sábado · 19:00–24:00' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece PATRI Restaurante" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Piedra, madera<br /><em>y mantel azul.</em>"
				paragraphs={[
					'PATRI Restaurante está en Kale Nagusia Kalea, 14, de Usurbil (Gipuzkoa), en una casa de piedra encalada con tejado a dos aguas y el rótulo «BAR PATRI JATETXEA». Delante, un porche con barandilla de madera y mesas; al lado, la iglesia del pueblo.',
					'Dentro, el comedor conserva la estructura de la casa: vigas y pilares de madera oscura, paredes de piedra encalada y una barra contra la pared turquesa. Las mesas van con mantel azul y servilleta roja, y de las vigas cuelgan lámparas de hierro y de mimbre.',
					'En una de las paredes hay un mural de pájaros y mariposas de metal, y en otra, un cuadro de un arroyo entre piedras. Google lo clasifica como restaurante y le da 4,7 sobre 5 con 460 reseñas.',
					'Sus reseñas hablan de comida casera, de una camarera «muy amable y atenta» y de platos como la ensalada de tomate con bonito, la chuleta con pimientos y patatas, el arroz con hongos y huevo o el filete con roquefort.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «la comida casera era muy rica, la camarera muy amable y atenta».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="De la casa<br /><em>y de la brasa.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que citan sus reseñas y lo que aparece en sus fotos. El menú del día cambia cada jornada."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Los precios no están publicados en la ficha. Llama al 943 36 27 25 para saber el menú de hoy y si queda mesa."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor,<br /><em>la mesa y el postre.</em>"
				description="Estas fotografías proceden del perfil de PATRI Restaurante en Google Maps: el comedor con vigas y manteles azules, la fachada con el rótulo de Bar Patri Jatetxea, la calle, el pescado, la ensalada y los postres."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>a la mesa.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: comidas de 11:00 a 16:00 todos los días; cenas de 19:00 a 24:00 solo viernes y sábados. Para grupos conviene llamar antes."
				mapTitle="Mapa de PATRI Restaurante en Kale Nagusia Kalea, 14, Usurbil (Gipuzkoa)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="PATRI Restaurante · Usurbil"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva llamando al 943 36 27 25. La ficha de Google marca acceso para sillas de ruedas y asientos adaptados; no publica datos de aparcamiento adaptado. Está en Kale Nagusia Kalea, 14, de Usurbil."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a PATRI Restaurante"
		/>
	</body>
</html>
