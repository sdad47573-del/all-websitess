---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/guisando-comida-para-llevar-apaisada-01.jpg';
import vitrina from '../assets/fotos/guisando-comida-para-llevar-apaisada-02.jpg';
import arroz from '../assets/fotos/guisando-comida-para-llevar-vista-3-03.jpg';
import cartel from '../assets/fotos/guisando-comida-para-llevar-vista-4-04.jpg';
import fritos from '../assets/fotos/guisando-comida-para-llevar-vista-5-05.jpg';
import pastaEnsalada from '../assets/fotos/guisando-comida-para-llevar-vertical-06.jpg';
import empanadas from '../assets/fotos/guisando-comida-para-llevar-apaisada-07.jpg';
import ensaladaAtun from '../assets/fotos/guisando-comida-para-llevar-vertical-08.jpg';
import ensaladilla from '../assets/fotos/guisando-comida-para-llevar-vertical-09.jpg';
import hojaldres from '../assets/fotos/guisando-comida-para-llevar-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Guisando Comida para Llevar · Arroces y comida casera en Málaga';
const description =
	'Guisando Comida para Llevar, arrocería en C. de la Era, 25, Málaga-Este. Fotos, ubicación, teléfono y reseñas. Consulta por teléfono los platos y el horario.';

const galeria = [
	{ src: vitrina, alt: 'Vitrina de Guisando con bandejas de comida preparada para llevar' },
	{ src: arroz, alt: 'Paella mixta con gambas, carne, guisantes y pimientos' },
	{ src: fritos, alt: 'Piezas de pescado frito doradas dispuestas en bandejas negras' },
	{ src: pastaEnsalada, alt: 'Ensalada de pasta con atún, aceitunas, maíz y huevo cocido' },
	{ src: empanadas, alt: 'Empanadas doradas listas para llevar' },
	{ src: ensaladaAtun, alt: 'Ensalada con atún, huevo cocido, pimiento y aceitunas negras' },
	{ src: ensaladilla, alt: 'Ensaladilla preparada en una bandeja redonda' },
	{ src: hojaldres, alt: 'Bandejas de hojaldres y piezas de repostería salada' },
	{ src: cartel, alt: 'Cartel exterior de Guisando con teléfonos, correo y servicios anunciados' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Oferta de Guisando Comida para Llevar',
	inLanguage: 'es-ES',
	description: 'Selección orientativa basada en la categoría, el rótulo y las fotografías públicas; no es una carta oficial.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#guisando`,
	name: BUSINESS.name,
	alternateName: ['Guisando Málaga', 'Guisando Comida para Llevar Málaga'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34605227111',
	servesCuisine: ['Arroces', 'Comida para llevar'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Oferta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"guisando-comida-para-llevar-apaisada-01.jpg": fachada,
	"guisando-comida-para-llevar-apaisada-02.jpg": vitrina,
	"guisando-comida-para-llevar-vista-3-03.jpg": arroz,
	"guisando-comida-para-llevar-vista-5-05.jpg": fritos,
	"guisando-comida-para-llevar-vertical-06.jpg": pastaEnsalada,
	"guisando-comida-para-llevar-apaisada-07.jpg": empanadas,
	"guisando-comida-para-llevar-vertical-08.jpg": ensaladaAtun,
	"guisando-comida-para-llevar-vertical-09.jpg": ensaladilla,
	"guisando-comida-para-llevar-vertical-10.jpg": hojaldres,
	"guisando-comida-para-llevar-vista-4-04.jpg": cartel,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Guisando Comida para Llevar, arrocería Málaga Este, comida casera para llevar Málaga, C. de la Era 25, arroces Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Arrocería y comida para llevar en C. de la Era, 25, Málaga-Este. Consulta ubicación, fotos, reseñas y teléfono."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Guisando Comida para Llevar en Málaga-Este"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#263d33"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga-Este"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Guisando"
			subtitle="Comida para llevar · Málaga-Este"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma horario y disponibilidad con el establecimiento."
			ctaLabel="Llamar a Guisando"
			navAriaLabel="Enlaces de Guisando"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
