---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/restaurant-mon-asiatic-apaisada-06.jpg';
import fachada from '../assets/fotos/restaurant-mon-asiatic-vertical-01.jpg';
import sala from '../assets/fotos/restaurant-mon-asiatic-apaisada-09.jpg';
import salteado from '../assets/fotos/restaurant-mon-asiatic-apaisada-04.jpg';
import tallarines from '../assets/fotos/restaurant-mon-asiatic-apaisada-05.jpg';
import tempura from '../assets/fotos/restaurant-mon-asiatic-cuadrada-10.jpg';
import dimsum from '../assets/fotos/restaurant-mon-asiatic-vertical-02.jpg';
import sopa from '../assets/fotos/restaurant-mon-asiatic-vertical-03.jpg';
import entrantes from '../assets/fotos/restaurant-mon-asiatic-vertical-07.jpg';

import { BUSINESS, CARTA, CARTA_NOTE, FAQ, HOURS, MAPS, RATING, SERVICIOS } from '../data/site';

const title = 'Restaurant Món Asiàtic · Cocina asiática en Escaldes-Engordany';
const description = BUSINESS.description;

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de Restaurant Món Asiàtic con el rótulo dorado, la puerta roja, el toldo de Bar Restaurant Santa Anna y los teléfonos 845 394 y 841 668',
	},
	{
		src: sala,
		alt: 'Segundo comedor de Món Asiàtic con mesas de mármol amarillo, sillas de bistró negras y paredes de ladrillo y madera',
	},
	{
		src: entrantes,
		alt: 'Rollitos de primavera con lechuga y salsa, gyozas a la plancha y samosas fritas en Món Asiàtic',
	},
	{
		src: dimsum,
		alt: 'Canastilla de bambú con dim sum al vapor sobre hojas de col en Món Asiàtic',
	},
	{
		src: salteado,
		alt: 'Salteado de carne con brócoli y cebolla en un plato de cuadros, con un cuenco de fideos detrás',
	},
	{
		src: tallarines,
		alt: 'Tallarines salteados con pollo, zanahoria y cebolla en un cuenco de cuadros',
	},
	{
		src: sopa,
		alt: 'Sopa de fideos con bok choy y zanahoria en un cuenco de cuadros de Món Asiàtic',
	},
	{
		src: tempura,
		alt: 'Tempura de verduras y gambas con un cuenco de salsa de soja en Món Asiàtic',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#mon-asiatic`,
	name: BUSINESS.name,
	alternateName: ['Món Asiàtic', 'Mon Asiatic', 'Restaurante Món Asiàtic Andorra'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Asiática'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.parish,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google Maps feature ID', value: BUSINESS.featureId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday', 'Friday', 'Saturday'],
			opens: '13:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday', 'Friday', 'Saturday'],
			opens: '20:00',
			closes: '23:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
		{ '@type': 'LocationFeatureSpecification', name: 'Bucle magnético asistencial', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Qué se come', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#14110f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurant Món Asiàtic, restaurante asiático Andorra, comida asiática Escaldes-Engordany, menú del día Andorra, dim sum Andorra, tallarines Escaldes, Santa Anna 10"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida asiática recién hecha en la calle Santa Anna, 10, de Escaldes-Engordany. Jueves, viernes y sábado de 13:00 a 16:00 y de 20:00 a 23:00. 4,7 sobre 5 con 141 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Comedor de Restaurant Món Asiàtic con mesas negras, platos rojos y un mural de flor"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#14110f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.parish}
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Escaldes-Engordany"
			countryName="Andorra"
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Món Asiàtic"
			subtitle="Cuina casolana · Escaldes"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Cocina asiática <br /><em>recién hecha.</em>"
				lede={`Restaurant Món Asiàtic está en la calle Santa Anna, 10, de Escaldes-Engordany. Platos a la carta y menús de mediodía en un comedor para 60 o 70 comensales, con cocina «recién hecha y casera» según la propia casa. Abre jueves, viernes y sábado de 13:00 a 16:00 y de 20:00 a 23:00. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				image={comedor}
				imageAlt="Comedor de Món Asiàtic con mesas negras, platos rojos y sillas de madera bajo un mural de flor roja"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>13:00–16:00</b><br />y 20:00–23:00, jue–sáb' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b><br />Sin reservas en línea` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Menús de mediodía"
			/>

			<LocalChips label="Señas de Món Asiàtic" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un comedor <br /><em>familiar.</em>"
				paragraphs={[
					'Restaurant Món Asiàtic está en la calle Santa Anna, 10, de Escaldes-Engordany. La fachada es de piedra, con toldo de Bar Restaurant Santa Anna, puerta y ventanales rojos, y un rótulo dorado que se presenta como «Restaurant Món Asiàtic · cuina casolana», con los teléfonos 845 394 y 841 668 pintados al lado.',
					'La casa se describe así: «Somos un restaurante asiático ubicada a la parroquia de Escaldes-Engordany Andorra, cabe unos 60 a 70 comenzales. Ofrecemos platos a la carta donde puedes probar comida recién hecha y casera. Además disponemos menús a los martes, jueves y viernes al mediodía».',
					'El local tiene dos salas: una con mesas negras, platos rojos y un gran mural de flor, y otra con mesas de mármol amarillo, sillas de bistró y paredes de ladrillo y madera. La casa resume el trato que quiere dar: «muy transparente, agradable y familiar».',
					`Abre jueves, viernes y sábado de 13:00 a 16:00 y de 20:00 a 23:00; lunes, martes, miércoles y domingo figuran cerrados. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas.`,
				]}
				note="La información sale de la ficha pública de Google Maps, de la descripción escrita por el restaurante y de las fotografías de su perfil. La ficha no publica carta con precios: los platos que se citan son los que aparecen en las fotos."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="Qué se come"
				title="Del vapor <br /><em>y del wok.</em>"
				description="La ficha no publica la carta. Esto es lo que se ve en las fotos del perfil y lo que anuncia la casa: entrantes para compartir, salteados y menús de mediodía."
				cta={{ label: 'Preguntar por teléfono', href: BUSINESS.phoneHref }}
				groups={CARTA}
				note={CARTA_NOTE}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Ocho fotos <br /><em>de la mesa.</em>"
				description="La fachada, las dos salas del comedor, los rollitos y las gyozas, el dim sum al vapor, el salteado de carne, los tallarines, la sopa de bok choy y la tempura."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Santa Anna, 10, <br /><em>Escaldes.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Andorra']}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: jueves a sábado de 13:00 a 16:00 y de 20:00 a 23:00; de lunes a miércoles y el domingo, cerrado. La descripción del restaurante habla además de menús los martes al mediodía, así que conviene confirmarlo por teléfono."
				mapTitle="Mapa de Restaurant Món Asiàtic en la calle Santa Anna 10, Escaldes-Engordany"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Món Asiàtic"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Teléfono: ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. La ficha solo publica el teléfono +376 845 394, que es la vía para preguntar por mesa o por el menú del día."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de venir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Món Asiàtic"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
