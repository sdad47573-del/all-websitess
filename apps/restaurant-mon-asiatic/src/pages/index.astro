---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import comedor from '../assets/fotos/restaurant-mon-asiatic-apaisada-06.jpg';
import fachada from '../assets/fotos/restaurant-mon-asiatic-vertical-01.jpg';
import sala from '../assets/fotos/restaurant-mon-asiatic-apaisada-09.jpg';
import salteado from '../assets/fotos/restaurant-mon-asiatic-apaisada-04.jpg';
import tallarines from '../assets/fotos/restaurant-mon-asiatic-apaisada-05.jpg';
import tempura from '../assets/fotos/restaurant-mon-asiatic-cuadrada-10.jpg';
import dimsum from '../assets/fotos/restaurant-mon-asiatic-vertical-02.jpg';
import sopa from '../assets/fotos/restaurant-mon-asiatic-vertical-03.jpg';
import entrantes from '../assets/fotos/restaurant-mon-asiatic-vertical-07.jpg';

import {
	BUSINESS,
	CARTA,
	CARTA_NOTE,
	FAQ,
	HOURS,
	MAPS,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Restaurant Món Asiàtic · Cocina asiática en Escaldes-Engordany';
const description = BUSINESS.description;

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de Restaurant Món Asiàtic con el rótulo dorado, la puerta roja, el toldo de Bar Restaurant Santa Anna y los teléfonos 845 394 y 841 668',
	},
	{
		src: sala,
		alt: 'Segundo comedor de Món Asiàtic con mesas de mármol amarillo, sillas de bistró negras y paredes de ladrillo y madera',
	},
	{
		src: entrantes,
		alt: 'Rollitos de primavera con lechuga y salsa, gyozas a la plancha y samosas fritas en Món Asiàtic',
	},
	{
		src: dimsum,
		alt: 'Canastilla de bambú con dim sum al vapor sobre hojas de col en Món Asiàtic',
	},
	{
		src: salteado,
		alt: 'Salteado de carne con brócoli y cebolla en un plato de cuadros, con un cuenco de fideos detrás',
	},
	{
		src: tallarines,
		alt: 'Tallarines salteados con pollo, zanahoria y cebolla en un cuenco de cuadros',
	},
	{
		src: sopa,
		alt: 'Sopa de fideos con bok choy y zanahoria en un cuenco de cuadros de Món Asiàtic',
	},
	{
		src: tempura,
		alt: 'Tempura de verduras y gambas con un cuenco de salsa de soja en Món Asiàtic',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#mon-asiatic`,
	name: BUSINESS.name,
	alternateName: ['Món Asiàtic', 'Mon Asiatic', 'Restaurante Món Asiàtic Andorra'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Asiática'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.parish,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google Maps feature ID', value: BUSINESS.featureId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday', 'Friday', 'Saturday'],
			opens: '13:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday', 'Friday', 'Saturday'],
			opens: '20:00',
			closes: '23:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
		{ '@type': 'LocationFeatureSpecification', name: 'Bucle magnético asistencial', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Qué se come', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurant-mon-asiatic-apaisada-06.jpg": comedor,
	"restaurant-mon-asiatic-vertical-01.jpg": fachada,
	"restaurant-mon-asiatic-apaisada-09.jpg": sala,
	"restaurant-mon-asiatic-vertical-07.jpg": entrantes,
	"restaurant-mon-asiatic-vertical-02.jpg": dimsum,
	"restaurant-mon-asiatic-apaisada-04.jpg": salteado,
	"restaurant-mon-asiatic-apaisada-05.jpg": tallarines,
	"restaurant-mon-asiatic-vertical-03.jpg": sopa,
	"restaurant-mon-asiatic-cuadrada-10.jpg": tempura,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#14110f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurant Món Asiàtic, restaurante asiático Andorra, comida asiática Escaldes-Engordany, menú del día Andorra, dim sum Andorra, tallarines Escaldes, Santa Anna 10"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida asiática recién hecha en la calle Santa Anna, 10, de Escaldes-Engordany. Jueves, viernes y sábado de 13:00 a 16:00 y de 20:00 a 23:00. 4,7 sobre 5 con 141 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Comedor de Restaurant Món Asiàtic con mesas negras, platos rojos y un mural de flor"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#14110f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.parish}
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Escaldes-Engordany"
			countryName="Andorra"
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Món Asiàtic"
			subtitle="Cuina casolana · Escaldes"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de venir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Món Asiàtic"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34376845394?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Google%20Place%20ID." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Google Place ID"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
