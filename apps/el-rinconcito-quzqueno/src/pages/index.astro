---
import '../styles/global.css';
import { BUSINESS, MAPS, RATING } from '../data/site';
import foto from '../assets/fotos/el-rinconcito-quzqueno-01.jpg';

const title = `${BUSINESS.name} · ${BUSINESS.city}, Madrid`;
const description = BUSINESS.description;
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Restaurant",
	"@id": "https://el-rinconcito-quzqueno.vercel.app/#negocio",
	"name": "El Rinconcito Quzqueño",
	"url": "https://el-rinconcito-quzqueno.vercel.app/",
	"description": "El Rinconcito Quzqueño, asador de pollos y comida para llevar y a domicilio, en C. de la Marquesa Viuda de Aldama, 44 (28100 Alcobendas, Madrid). Restaurante peruano según su ficha de Google Maps.",
	"image": "https://el-rinconcito-quzqueno.vercel.app/og.jpg",
	"telephone": "+34910065266",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 40.5422926,
		"longitude": -3.6305267
	},
	"hasMap": "https://www.google.com/maps/place/El+Rinconcito+Quzqueño+Asador+de+pollos+y+comida+para+llevar+y+a+domicilio/@40.5422926,-3.6305267,17z/data=!3m1!4b1!4m6!3m5!1s0xd422d14bbddc329:0x8ccbd09407654fa8!8m2!3d40.5422926!4d-3.6305267!16s%2Fg%2F11r90_qjlk?authuser=0&hl=es&entry=ttu"
}
</script>
</head>
	<body>
		<header class="site-header">
			<h1 set:html={piezas.portada.titulo} />
			<p>{BUSINESS.tagline}</p>
		</header>
		<main>
			<img src={foto.src} width={foto.width} height={foto.height} alt={`Foto de ${BUSINESS.name}`} />
			<section>
				<h2>Dirección</h2>
				<p>{BUSINESS.street}, {BUSINESS.postalCode} {BUSINESS.city}</p>
				<p>Teléfono: <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a></p>
				<p>Valoración en Google Maps: {RATING.label}</p>
				<p><a href={MAPS.place} target="_blank" rel="noreferrer">Ver en Google Maps</a> · <a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar</a></p>
			</section>
		</main>
		<footer class="site-footer">
			<p>© {new Date().getFullYear()} {BUSINESS.fullName}</p>
			<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> · sur-digital.vercel.app</small>
		</footer>
	</body>
</html>
