---
import '../styles/global.css';
import { business, directionsUrl, mapEmbedUrl, mapsUrl, openingHours, phoneHref, structuredData } from '../lib/business';
import { galleryPhotos } from '../lib/gallery';
import { Image } from 'astro:assets';

const galleryHeading = 'El taller, por dentro';
const galleryDescription = 'Fotos del taller Auto Moto Miguel en Málaga.';

const title = 'Auto Moto Miguel | Taller de motos en Málaga';
const description =
	'Auto Moto Miguel, taller de reparación de motos en Málaga. Estamos en Calle Antonio Raíz, 6. Llama al 952 30 99 54 y consulta cómo llegar.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#202522" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${galleryPhotos[0].src.src}`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1440" />
		<meta property="og:image:height" content="810" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}${galleryPhotos[0].src.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7243892;-4.4680198" />
		<meta name="ICBM" content="36.7243892, -4.4680198" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Auto Moto Miguel, inicio">
				<span class="brand-mark" aria-hidden="true"><span>AM</span><i></i></span>
				<span class="brand-name">Auto Moto Miguel <small>Taller de motos · Málaga</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#taller">El taller</a>
				<a href="#horario">Horario</a>
				<a href="#ubicacion">Ubicación</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}><span aria-hidden="true">↗</span> 952 30 99 54</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="blueprint" aria-hidden="true"></div>
				<div class="hero-copy">
					<p class="eyebrow"><span class="status-mark" aria-hidden="true"></span> Calle Antonio Raíz · Málaga</p>
					<h1 id="hero-title">Auto Moto<br /><em>Miguel.</em></h1>
					<p class="hero-lede">
						Taller de reparación de motos en Málaga. Estamos en Calle Antonio Raíz, 6. Llámanos para
						consultar antes de venir.
					</p>
					<div class="hero-actions">
						<a class="button button-amber" href={phoneHref}><span aria-hidden="true">↗</span> Llamar al taller</a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="hero-address">
						<span class="address-mark" aria-hidden="true">⌖</span>
						<span><small>ENCUÉNTRANOS EN</small><strong>{business.streetAddress} · {business.city}</strong></span>
					</div>
				</div>

				<div class="hero-art" aria-label="Ilustración técnica original de una motocicleta, no es una fotografía del taller">
					<div class="art-label art-label-top">TALLER DE MOTOS <span>·</span> MÁLAGA</div>
					<div class="art-label art-label-bottom">AM / SERVICIO LOCAL</div>
					<div class="orbit orbit-a"></div>
					<div class="orbit orbit-b"></div>
					<div class="wheel wheel-back"></div>
					<div class="wheel wheel-front"></div>
					<div class="bike-frame"><span></span><i></i><b></b><em></em></div>
					<div class="bike-tank"></div>
					<div class="bike-seat"></div>
					<div class="bike-fork fork-one"></div>
					<div class="bike-fork fork-two"></div>
					<div class="bike-handle"></div>
					<div class="bike-light"></div>
					<div class="road-line"></div>
				</div>
			</section>

			<section class="workshop-gallery section-pad" aria-labelledby="gallery-title">
				<div class="gallery-heading">
					<div>
						<p class="eyebrow"><span class="status-mark" aria-hidden="true"></span> Auto Moto Miguel · Málaga</p>
						<h2 id="gallery-title">{galleryHeading}</h2>
						<p>{galleryDescription}</p>
					</div>
					<a class="gallery-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a>
				</div>
				<div class="gallery-grid">
					{galleryPhotos.map(({ src, alt }, index) => (
						<figure class:list={[`gallery-photo gallery-photo-${index + 1}`]}>
							<Image
								src={src}
								alt={alt}
								widths={[320, 480, 640]}
								sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
								format="avif"
								quality={65}
								loading="lazy"
								decoding="async"
							/>
						</figure>
					))}
				</div>
			</section>

			<section class="identity-strip" id="taller" aria-label="Datos de Auto Moto Miguel">
				<div class="identity-mark" aria-hidden="true">AM<span>.</span></div>
				<p><small>ACTIVIDAD</small><strong>{business.businessType}</strong></p>
				<span class="strip-rule" aria-hidden="true"></span>
				<p><small>DIRECCIÓN</small><strong>{business.streetAddress}</strong></p>
				<span class="strip-rule" aria-hidden="true"></span>
				<p><small>LOCALIDAD</small><strong>{business.postalCode} {business.city}</strong></p>
			</section>

			<section class="hours-section section-pad" id="horario" aria-labelledby="hours-title">
				<div class="hours-copy">
					<p class="eyebrow dark"><span class="eyebrow-line" aria-hidden="true"></span> Información para tu visita</p>
					<h2 id="hours-title">Pasa por<br /><em>el taller.</em></h2>
					<p>Atención de lunes a viernes en horario partido. Confirma por teléfono antes de desplazarte, especialmente en festivos.</p>
				</div>
				<div class="hours-card">
					<div class="hours-card-head"><span>HORARIO PUBLICADO</span><span>ORIENTATIVO</span></div>
					<div class="hours-row"><strong>Lunes a viernes</strong><span>{openingHours.weekdays}</span></div>
					<div class="hours-row"><strong>Sábado y domingo</strong><span>Cerrado</span></div>
					<p>{openingHours.note}</p>
					<a href={phoneHref}>Confirmar por teléfono <span aria-hidden="true">↗</span></a>
				</div>
			</section>

			<section class="location section-pad" id="ubicacion" aria-labelledby="location-title">
				<div class="location-copy">
					<p class="eyebrow dark"><span class="eyebrow-line" aria-hidden="true"></span> Cómo llegar</p>
					<h2 id="location-title">Calle Antonio<br /><em>Raíz, Málaga.</em></h2>
					<p class="location-lede">Auto Moto Miguel está en el número 6 de la calle Antonio Raíz, en Málaga.</p>
					<address>
						<span class="pin-box" aria-hidden="true">⌖</span>
						<span><strong>{business.streetAddress}</strong><small>{business.postalCode} {business.city}, España</small></span>
					</address>
					<a class="phone-number" href={phoneHref}><small>TELÉFONO</small><strong>952 30 99 54</strong></a>
					<div class="location-actions">
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
						<a class="text-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha y galería de Maps ↗</a>
					</div>

				</div>
				<div class="map-shell">
					<div class="map-head"><span><i aria-hidden="true"></i> UBICACIÓN DEL TALLER</span><span>MÁLAGA · ES</span></div>
					<iframe
						title="Mapa de Auto Moto Miguel en Calle Antonio Raíz, 6, Málaga"
						src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-tag" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Auto Moto Miguel · Málaga</a>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio" aria-label="Auto Moto Miguel, volver al inicio">
				<span class="brand-mark" aria-hidden="true"><span>AM</span><i></i></span>
				<span class="brand-name">Auto Moto Miguel <small>Taller de motos · Málaga</small></span>
			</a>
			<p>{business.streetAddress} · {business.postalCode} {business.city}</p>
			<a class="footer-phone" href={phoneHref}>952 30 99 54 <span aria-hidden="true">↗</span></a>
			<small>© {new Date().getFullYear()} {business.name}. Información de contacto y ubicación.</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
</footer>

		<a class="mobile-call" href={phoneHref}><span aria-hidden="true">↗</span> Llamar al taller <strong>952 30 99 54</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>
