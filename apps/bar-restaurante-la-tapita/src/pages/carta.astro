---
import Contact from '../components/Contact.astro';
import Fab from '../components/Fab.astro';
import Footer from '../components/Footer.astro';
import Topbar from '../components/Topbar.astro';
import { breadcrumbs } from '../data/schema';
import { BUSINESS } from '../data/site';
import Layout from '../layouts/Layout.astro';

const titulo = 'Carta y precios de La Tapita · Sanlúcar';
const descripcion =
	'La carta de Bar restaurante La Tapita se consulta en el local. Platos citados en sus reseñas de Google y teléfono para preguntar por el menú del día.';

const mencionados = [
	{
		icon: 'ri-oil-line',
		title: 'Boquerones',
		text: 'Uno de los platos que aparecen en las reseñas de Google del local.',
	},
	{
		icon: 'ri-bowl-line',
		title: 'Ensaladilla',
		text: 'Citada por los clientes entre las tapas de la casa.',
	},
	{
		icon: 'ri-restaurant-2-line',
		title: 'Flamenquín',
		text: 'Mencionado en las opiniones publicadas en la ficha del bar.',
	},
	{
		icon: 'ri-restaurant-line',
		title: 'Arroces',
		text: 'Una reseña destaca el arroz que preparan, también los domingos.',
	},
];

const catalogoSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: `${BUSINESS.name}: platos citados en reseñas`,
	itemListElement: mencionados.map((item, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		item: {
			'@type': 'MenuItem',
			name: item.title,
			description: item.text,
			url: new URL('/carta', BUSINESS.siteUrl).toString(),
		},
	})),
};
---

<Layout
	title={titulo}
	description={descripcion}
	path="/carta"
	keywords="carta La Tapita Sanlúcar, tapas Sanlúcar de Barrameda, precios bar La Tapita"
	schema={[
		breadcrumbs([
			{ name: 'Inicio', path: '/' },
			{ name: 'Carta y precios', path: '/carta' },
		]),
		catalogoSchema,
	]}
>
	<Topbar base="/" />
	<main>
		<section class="hero-tapita text-white">
			<div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
				<nav class="mb-6 text-xs text-white/60" aria-label="Migas de pan">
					<a href="/" class="hover:text-accent">Inicio</a><span class="mx-2">/</span><span
						class="text-white/90">Carta y precios</span
					>
				</nav>
				<span class="text-accent text-xs font-semibold tracking-[0.2em] uppercase">
					{BUSINESS.city} · {BUSINESS.region}
				</span>
				<h1 class="font-display mt-3 text-4xl font-bold sm:text-5xl">La carta, en el local</h1>
				<p class="font-display mt-3 text-xl font-semibold text-white/85">
					{BUSINESS.name}
				</p>
				<p class="mt-5 max-w-2xl leading-relaxed text-white/75">
					Esta web no publica una carta con precios porque no hay una confirmada. En el bar
					tienes la carta completa, y por teléfono te resuelven cualquier duda sobre el menú
					del día.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-accent gap-2 rounded-full">
						<i class="ri-phone-line"></i> {BUSINESS.phone}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn gap-2 rounded-full border-white/35 bg-transparent text-white hover:border-white hover:bg-white hover:text-neutral"
					>
						<i class="ri-google-fill"></i> Ver ficha de Google
					</a>
				</div>
			</div>
		</section>

		<div class="bg-base-200 py-16 sm:py-20">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="mx-auto max-w-2xl text-center">
					<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">
						Lo que se comenta
					</span>
					<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">Platos citados en sus reseñas</h2>
					<div class="bg-secondary mx-auto mt-5 h-0.5 w-24"></div>
					<p class="text-base-content/70 mt-6 leading-relaxed">
						Estos son los platos que los clientes mencionan en Google. No son una carta
						cerrada ni llevan precio: sirven para hacerte una idea antes de ir.
					</p>
				</div>

				<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
					{
						mencionados.map((plato) => (
							<article class="border-base-300 bg-base-100 rounded-lg border p-6">
								<span class="bg-primary/10 text-primary flex size-11 items-center justify-center rounded-full">
									<i class={`${plato.icon} text-xl`} />
								</span>
								<h3 class="font-display mt-4 text-xl font-bold">{plato.title}</h3>
								<p class="text-base-content/65 mt-2 text-sm leading-relaxed">{plato.text}</p>
							</article>
						))
					}
				</div>

				<div class="border-base-300 bg-base-100 mt-10 grid gap-6 rounded-lg border p-8 lg:grid-cols-[1.4fr_1fr] lg:items-center">
					<div>
						<h2 class="font-display text-2xl font-bold">Menú del día y precios</h2>
						<p class="text-base-content/70 mt-3 text-sm leading-relaxed">
							Los precios cambian y esta web no publica importes sin confirmar. Llama al
							local para saber el menú del día, las raciones disponibles o si hacen reservas.
						</p>
					</div>
					<div class="flex flex-wrap gap-3 lg:justify-end">
						<a href={BUSINESS.phoneHref} class="btn btn-primary gap-2 rounded-full">
							<i class="ri-phone-line"></i> Llamar
						</a>
						<a href="/#contacto" class="btn btn-outline gap-2 rounded-full">
							<i class="ri-map-pin-line"></i> Cómo llegar
						</a>
					</div>
				</div>
			</div>
		</div>

		<Contact />
	</main>
	<Footer />
	<Fab />
</Layout>
