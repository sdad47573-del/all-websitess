---
import { BUSINESS, REVIEWS } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
---

<section id="opiniones" class="bg-base-100 scroll-mt-20 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
			<div>
				<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">Opiniones</span>
				<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">Lo que se cuenta en Google</h2>
				<div class="bg-secondary mt-5 h-0.5 w-24"></div>
			</div>
			<div class="flex flex-wrap items-center gap-x-8 gap-y-4">
				<div>
					<p class="font-display text-5xl leading-none font-bold">
						{BUSINESS.rating.toString().replace('.', ',')}
					</p>
					<p class="text-accent-content mt-2 text-sm">
						<span class="text-primary tracking-tight" aria-hidden="true">
							{
								estrellas.map((n) => (
									<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
								))
							}
						</span>
						<span class="text-base-content/60 ml-2">{BUSINESS.reviewCount} reseñas</span>
					</p>
				</div>
				<p class="text-base-content/70 max-w-sm text-sm leading-relaxed">
					Valoración media de la ficha pública del local en Google, consultada en octubre de
					2026. Las opiniones cambian con el tiempo.
				</p>
			</div>
		</div>

		<div class="mt-12 grid gap-4 md:grid-cols-3">
			{
				REVIEWS.map((review) => (
					<figure class="border-base-300 bg-base-200 trama-tapita flex h-full flex-col rounded-lg border p-7">
						<i class="ri-quote-text text-secondary/40 text-3xl" aria-hidden="true" />
						<blockquote class="font-display mt-4 flex-1 text-xl leading-snug font-medium">
							{review.text}
						</blockquote>
						<figcaption class="border-base-300 mt-6 flex items-center justify-between gap-3 border-t pt-4">
							<span class="text-base-content/60 text-xs font-semibold tracking-[0.12em] uppercase">
								{review.author}
							</span>
							<span class="text-primary text-sm" aria-label={`${review.rating} de 5 estrellas`}>
								{estrellas.map((n) => (
									<i class={n <= review.rating ? 'ri-star-fill' : 'ri-star-line'} />
								))}
							</span>
						</figcaption>
					</figure>
				))
			}
		</div>

		<p class="mt-8 text-center text-sm">
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="text-primary font-semibold underline underline-offset-4"
			>
				Leer todas las reseñas en Google Maps
			</a>
		</p>
	</div>
</section>
