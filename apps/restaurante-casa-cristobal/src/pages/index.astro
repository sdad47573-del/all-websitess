---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	distintivos,
	mapEmbedUrl,
	mapsUrl,
	ownerDescription,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'Restaurante Casa Cristobal · Restaurante en Cáceres';
const description =
	'Casa Cristobal, restaurante-bar en la Av. de Portugal, 3 de Cáceres. 4,1 sobre 5 con 163 reseñas; pescados, carnes, raciones, arroz con bogavante y desayunos. De martes a domingo.';
const keywords =
	'Restaurante Casa Cristobal, Casa Cristobal Cáceres, restaurante Cáceres, Av. de Portugal';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas diez fotografías, así que no se inventa una
 * descripción y todos los `alt` avisan solo de dónde salen.
 */
const altFoto = 'Fotografía publicada en la ficha de Google Maps de Restaurante Casa Cristobal, en Cáceres';
const altOg = 'Fotografía de Restaurante Casa Cristobal publicada en su ficha de Google Maps';

/**
 * Galería completa: las diez fotografías de la ficha, en el orden en que se descargaron (las diez
 * apaisadas). El manifiesto no atribuye autor a ninguna, así que no llevan pie.
 */
const galeria = [
	'restaurante-casa-cristobal-apaisada-01.jpg',
	'restaurante-casa-cristobal-apaisada-02.jpg',
	'restaurante-casa-cristobal-apaisada-03.jpg',
	'restaurante-casa-cristobal-apaisada-04.jpg',
	'restaurante-casa-cristobal-apaisada-05.jpg',
	'restaurante-casa-cristobal-apaisada-06.jpg',
	'restaurante-casa-cristobal-apaisada-07.jpg',
	'restaurante-casa-cristobal-apaisada-08.jpg',
	'restaurante-casa-cristobal-apaisada-09.jpg',
	'restaurante-casa-cristobal-apaisada-10.jpg',
];

/**
 * Tres fotos de avance en el collage de la portada (también están en la galería): una vertical que
 * ocupa toda la altura y dos apaisadas en la columna derecha.
 */
const collage = [
	{ name: 'restaurante-casa-cristobal-apaisada-01.jpg', clase: 'collage-item collage-item-main' },
	{ name: 'restaurante-casa-cristobal-apaisada-02.jpg', clase: 'collage-item collage-item-top' },
	{ name: 'restaurante-casa-cristobal-apaisada-03.jpg', clase: 'collage-item collage-item-bottom' },
];

/**
 * Número de reseñas destacadas que publica la ficha.
 *
 * Se cuenta en vez de escribirlo a mano para que el texto no se desincronice si la ficha cambia.
 */
const numeroResenas = reviews.length;

/** La ficha solo declara la categoría principal, así que no hay cocinas que listar aparte. */
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1e4b57" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CC" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.shortName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.shortName}, inicio`}>
				<span class="brand-mark" aria-hidden="true">
					<span></span><span></span><span></span><span></span>
				</span>
				<span class="brand-text">
					Casa Cristobal
					<small>Av. de Portugal · Cáceres</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#local">La casa</a>
				<a href="#fotos">Las fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phone}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Cáceres · Av. de Portugal, 3</p>
						<h1 id="hero-title">
							Restaurante Casa Cristobal,
							<br />
							<em>en Cáceres.</em>
						</h1>
						<p class="hero-lede">
							Casa Cristobal está en la Av. de Portugal, 3, con código postal
							10001, en el Centro-Casco Antiguo de Cáceres (Extremadura). Google lo clasifica
							como restaurante, y le da
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas. Las reseñas que destaca hablan de
							chocos fritos con croquetas de setas, de cachopo y de tapeo con patatas alioli,
							y abre de martes a domingo en jornada continua.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>Llamar al {business.phone}</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas
								</strong>
							</li>
						</ul>
					</div>

					<div class="hero-media">
						<div class="hero-collage">
							{collage.map((item, index) => (
								<figure class={item.clase}>
									<Image
										src={foto(item.name)}
										alt={altFoto}
										widths={index === 0 ? [420, 640, 900] : [420, 640, 860]}
										sizes={
											index === 0
												? '(max-width: 1080px) 46vw, 27vw'
												: '(max-width: 1080px) 46vw, 20vw'
										}
										format="avif"
										quality={68}
										loading={index === 0 ? 'eager' : 'lazy'}
										fetchpriority={index === 0 ? 'high' : undefined}
										decoding="async"
									/>
								</figure>
							))}
						</div>
						<p class="hero-stamp" aria-hidden="true">
							<span>Restaurante</span>
							<strong>Cristobal</strong>
							<span>Cáceres</span>
						</p>
					</div>
				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
					{business.reviewCount.toLocaleString('es-ES')} reseñas
				</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>{hoursSummary}</span>
				<span>Teléfono {business.phone}</span>
			</div>

			<section class="section local" id="local" aria-labelledby="local-title">
				<div class="wrap local-grid">
					<div class="local-text">
						<p class="kicker">La casa</p>
						<h2 class="title" id="local-title">
							Restaurante-bar,
							<br />
							<em>en el centro.</em>
						</h2>
						<p>
							Casa Cristobal está en la Av. de Portugal, 3, con código postal
							10001, en el Centro-Casco Antiguo de Cáceres (Extremadura). Google lo clasifica
							como restaurante, y le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas. La ficha publica
							además su plus code {business.plusCode} y las coordenadas{' '}
							{business.latitude}, {business.longitude}.
						</p>
						<ul class="category-list" aria-label="Categoría que publica la ficha">
							<li>{business.category}</li>
						</ul>
						<p>
							Es la descripción que el propio local publica en su ficha, copiada literalmente
							y por párrafos:
						</p>
						<blockquote class="owner-desc">
							{ownerDescription.split('\n').map((parrafo) => (
								<p>{parrafo}</p>
							))}
						</blockquote>
						<p>
							Abre de martes a domingo en jornada continua de 8:30 a 24:00; el lunes cierra.
							En accesibilidad declara el acceso y los asientos adaptados para sillas de
							ruedas como disponibles. La ficha también publica este distintivo: {distintivos.join(' · ')}.
						</p>
						<p class="local-note">
							Esta web se ha preparado solo con lo que publica la ficha de Google Maps,
							consultada el {site.consultado}: nombre, dirección, teléfono, categoría, la descripción del titular, el distintivo,
							valoración, horario, accesibilidad, las {numeroResenas} reseñas que destaca
							y sus propias fotografías. La ficha no publica carta, precios ni web propia,
							así que aquí no se reproducen.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>
								{business.reviewCount.toLocaleString('es-ES')} reseñas en Google Maps
							</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
								Ver todas ↗
							</a>
						</div>
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									<strong>{review.rating} sobre 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section fotos" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						La mesa <em>y la casa.</em>
					</h2>
					<p class="lead">
						Son las diez fotografías que el restaurante publica en su ficha de Google
						Maps. El manifiesto de la descarga no atribuye autor a ninguna, así que no
						llevan pie. La ficha tampoco describe su contenido, de modo que no se inventa
						ninguna descripción y los textos alternativos solo avisan de dónde salen.
					</p>
					<div class="fotos-grid">
						{galeria.map((name) => (
							<figure class="foto-item">
								<Image
									src={foto(name)}
									alt={altFoto}
									widths={[380, 560, 800]}
									sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
									format="avif"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))}
					</div>
					<p class="fotos-note">
						La ficha no publica la carta ni los precios, así que esta web no los reproduce.
						Para saber qué hay hoy, lo más rápido es{' '}
						<a href={phoneHref}>llamar al {business.phone}</a> o mirar las{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							fotos y reseñas de la ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section horario" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Av. de Portugal, 3,
							<br />
							<em>10001 Cáceres.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							De martes a domingo abre jornada continua de 8:30 a 24:00; el lunes está
							cerrado. Es el horario de la ficha consultada el {site.consultado}; puede
							cambiar, así que conviene confirmarlo por teléfono.
						</p>
						{accesibilidad.length > 0 ? (
							<ul class="access-list">
								{accesibilidad.map((item) => (
									<li class:list={[{ 'is-no': !item.disponible }]}>{item.label}</li>
								))}
							</ul>
						) : (
							<p class="hours-note">La ficha no publica datos de accesibilidad.</p>
						)}
						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phone}</strong>
						</a>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>venir.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.shortName}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">
						<span></span><span></span><span></span><span></span>
					</span>							<span>
							Restaurante Casa Cristobal
							<small>
								{business.streetAddress} · {business.postalCode} {business.city}
							</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phone}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Restaurante Casa Cristobal · Av. de Portugal, 3 (10001 Cáceres).
					Web informativa elaborada con los datos, las reseñas destacadas y las fotografías que
					el local publica en su ficha de Google Maps, consultada el {site.consultado}.
					Confirma horario y disponibilidad por teléfono antes de salir.
				</small>
			</div>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a Casa Cristobal <span>{business.phone}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
