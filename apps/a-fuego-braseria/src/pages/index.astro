---
import '../styles/global.css';
import {
	business,
	directionsUrl,
	facebookPhotosUrl,
	facebookUrl,
	faqSchema,
	faqs,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	specialties,
	tripadvisorUrl,
} from '../lib/business';

const title = 'A Fuego Brasería | Carnes a la brasa de encina en Córdoba';
const description =
	'A Fuego Brasería, en Avenida Al-Nasir, Córdoba: carnes, pescados y verduras a la parrilla de carbón de encina. Consulta y reserva: 957 84 71 36.';
const keywords =
	'A Fuego Brasería Córdoba, brasería Córdoba, carne a la brasa Córdoba, parrilla de encina, pescados a la brasa Córdoba, Avenida Al Nasir, reservar A Fuego Brasería';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#2d211c" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración original de una pieza de carne a la brasa para A Fuego Brasería; no es una foto del restaurante" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="A Fuego Brasería, inicio">
				<span class="brand-mark" aria-hidden="true">F</span>
				<span class="brand-copy">A Fuego Brasería <small>Carbón de encina · Córdoba</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cocina">La parrilla</a>
				<a href="#filosofia">La casa</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 957 84 71 36</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Córdoba · Parrilla de carbón de encina</p>
					<h1 id="hero-title">El fuego hace<br />su <em>parte.</em></h1>
					<p class="hero-intro">En A Fuego Brasería, la encina aporta carácter a una selección de carnes, pescados y verduras. Producto, brasa y tiempo para disfrutar la mesa como se merece.</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar y reservar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Nos encontrarás</small><address>Av. Al-Nasir, esquina C/ Martín Gaite<br />14006 · Córdoba</address></div>
						<div><small>Reservas</small><a href={phoneHref}>{business.phone}</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración vectorial original de un corte a la brasa, no es una fotografía del restaurante">
					<span class="plate-dot" aria-hidden="true"></span><div class="plate" aria-hidden="true"><div class="steak"></div></div>
					<div class="art-caption"><strong>Brasa de encina</strong>Carne · mar · huerta</div>
				</div>
			</section>

			<div class="promise" aria-label="Especialidades de A Fuego Brasería">
				<span>Carbón de encina</span><span>Carnes seleccionadas</span><span>Pescados a la brasa</span><span>Verduras al fuego</span>
			</div>

			<section class="section intro" id="filosofia" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Brasería en Córdoba</p>
					<h2 id="intro-title">La encina,<br />el producto y <em>la mesa.</em></h2>
				</div>
				<div class="intro-copy">
					<p>A Fuego Brasería está en la zona de Avenida Al-Nasir, en Córdoba. Su propuesta gira en torno a la parrilla de carbón de encina, donde preparan una selección de carnes, pescados y verduras con el sabor propio de la brasa.</p>
					<p>Una cocina directa, pensada para compartir: desde cortes de vacuno y cerdo ibérico hasta platos de la huerta y del mar. La disponibilidad y los cortes pueden variar; consulta la carta del día al reservar.</p>
					<p class="source-note">La dirección aparece en algunas fuentes como Av. Al-Nasir, 11 y en otras como C/ Martín Gaite, 2. La ficha de Maps y los perfiles del negocio sirven como referencia de ubicación; confirma cualquier duda por teléfono.</p>
				</div>
			</section>

			<section class="section menu-section" id="cocina" aria-labelledby="menu-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Del carbón a la mesa</p>
						<h2 id="menu-title">Una carta que<br /><em>pide brasa.</em></h2>
					</div>
					<p>Selección orientativa basada en los perfiles públicos del restaurante y directorios gastronómicos. No es una carta oficial: consulta cortes, disponibilidad, precios y alérgenos al hacer la reserva.</p>
				</div>
				<div class="menu-grid">
					{specialties.map((dish, index) => (
						<article class="menu-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<p class="menu-note">Pregunta por los cortes disponibles y el punto de cocción. <a href={phoneHref}>Reserva por teléfono</a>.</p>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<p class="section-label"><span aria-hidden="true"></span> A Fuego en imágenes</p>
				<h2 id="gallery-title">Mira la brasa<br /><em>de cerca.</em></h2>
				<p class="gallery-copy">La URL de Google Maps identifica la ficha pero no contiene enlaces directos a archivos de foto. Abre las galerías del negocio para ver imágenes reales de la parrilla, los platos y el local.</p>
				<div class="gallery-grid">
					<a class="gallery-card" href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Ver ficha y fotos de A Fuego Brasería en Google Maps">
						<span class="gallery-tag">Fotos de la ficha</span><span class="gallery-title">Google Maps <span aria-hidden="true">↗</span></span>
					</a>
					<a class="gallery-card" href={instagramUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos y publicaciones del Instagram oficial de A Fuego Brasería">
						<span class="gallery-tag">Perfil oficial</span><span class="gallery-title">Instagram <span aria-hidden="true">↗</span></span>
					</a>
					<a class="gallery-card" href={facebookPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de A Fuego Brasería en Facebook">
						<span class="gallery-tag">Página del negocio</span><span class="gallery-title">Facebook <span aria-hidden="true">↗</span></span>
					</a>
				</div>
				<p class="gallery-note">La ilustración de portada y los fondos de las tarjetas son gráficos vectoriales originales, no fotografías del establecimiento. Las fotos auténticas se abren en las galerías externas.</p>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14006 · Córdoba</p>
					<h2 id="visit-title">Acércate<br /><em>a la brasa.</em></h2>
					<address>{business.streetAddress}<br />{business.postalCode} {business.city}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Reservas y consultas</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Cómo llegar</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Redes del restaurante</small><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a> · <a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar para reservar</a>
					</div>
					<p class="menu-note">Los horarios varían entre directorios. Confirma apertura y disponibilidad por teléfono.</p>
				</div>
				<div class="map-card">
					<iframe title="Mapa de A Fuego Brasería en Córdoba, Avenida Al-Nasir" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
					<div class="map-label"><div><strong>A Fuego Brasería</strong><small>Avenida Al-Nasir · Córdoba</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="A Fuego Brasería, volver al inicio">
				<span class="brand-mark" aria-hidden="true">F</span><span class="brand-copy">A Fuego Brasería <small>Carbón de encina · Córdoba</small></span>
			</a>
			<nav class="footer-nav" aria-label="Perfiles y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} A Fuego Brasería · Córdoba. Consulta carta y horarios con el restaurante.</small>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar y reservar <span>957 84 71 36</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>
