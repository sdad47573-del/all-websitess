---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import Hero from '../components/Hero.astro';
import Ritmo from '../components/Ritmo.astro';
import Casa from '../components/Casa.astro';
import Carta from '../components/Carta.astro';
import Galeria from '../components/Galeria.astro';
import Opiniones from '../components/Opiniones.astro';
import Visitanos from '../components/Visitanos.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Fab from '../components/Fab.astro';
import { breadcrumbs, faqSchema } from '../data/schema';
---

<Layout
	title="Antic - Restaurante · Cafetería y pizzería en Castelló"
	description="Antic - Restaurante, cafetería y pizzería en el centre de Castelló. Desayunos desde las 7:30, menú del día, pizzas, hamburguesas, bocadillos y terraza en la calle Herrero. Tel. 691 78 62 50."
	path="/"
	schema={[faqSchema, breadcrumbs([{ name: 'Inicio', path: '/' }])]}
>
	<Topbar />
	<main id="contenido">
		<Hero />
		<Ritmo />
		<Casa />
		<Carta />
		<Galeria />
		<Opiniones />
		<Visitanos />
		<Faq />
	</main>
	<Footer />
	<Fab />
</Layout>
