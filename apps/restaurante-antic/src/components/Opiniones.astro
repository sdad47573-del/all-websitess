---
import { BUSINESS, REVIEWS } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
---

<section id="opiniones" class="bg-base-200 border-base-300 border-t py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-10 lg:grid-cols-[0.78fr_1.22fr] lg:gap-16">
			<div class="lg:sticky lg:top-28 lg:self-start">
				<p class="label text-primary">— Opiniones</p>
				<h2 class="font-display mt-3 text-4xl leading-[0.98] font-semibold tracking-[-0.03em] sm:text-5xl">
					Lo que cuentan<br />
					<span class="text-primary italic">en Google</span>
				</h2>

				<div class="mt-7 flex items-end gap-4">
					<span class="font-display text-7xl leading-none font-semibold tracking-[-0.04em]">
						{BUSINESS.rating.toString().replace('.', ',')}
					</span>
					<div class="pb-2">
						<span class="text-primary flex gap-0.5 text-base" aria-hidden="true">
							{estrellas.map((n) => (
								<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
							))}
						</span>
						<p class="text-base-content/50 mt-1 text-xs">{BUSINESS.reviewCount} reseñas en Google</p>
					</div>
				</div>

				<p class="text-base-content/60 mt-5 max-w-xs text-sm leading-relaxed">
					Los bocadillos, las paellas y el trato en sala son lo que más se repite. Estas son tres
					reseñas textuales.
				</p>

				<a
					href={BUSINESS.googleMaps}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-outline border-base-300 hover:border-neutral hover:bg-neutral hover:text-neutral-content mt-6 h-11 gap-2 rounded-sm px-4 text-[0.65rem] font-bold tracking-[0.1em] uppercase"
				>
					<i class="ri-google-fill" aria-hidden="true"></i> Leer todas
				</a>
			</div>

			<div>
				{REVIEWS.map((resena, index) => (
					<blockquote
						class:list={[
							'grid gap-3 py-7 sm:grid-cols-[2.5rem_1fr] sm:gap-5',
							index === 0 ? 'pt-0' : 'border-base-300 border-t',
						]}
					>
						<span class="font-display text-primary/30 text-3xl leading-none" aria-hidden="true">
							”
						</span>
						<div>
							<p class="font-display text-xl leading-snug font-medium sm:text-2xl">
								«{resena.text}»
							</p>
							<footer class="mt-3 flex items-center gap-3">
								<span
									class="flex gap-0.5 text-[0.6rem] text-primary"
									role="img"
									aria-label={`${resena.rating} de 5 estrellas`}
								>
									{Array.from({ length: resena.rating }).map(() => (
										<i class="ri-star-fill" />
									))}
								</span>
								<span class="label text-base-content/40 text-[0.46rem]">
									Reseña en {resena.source}
								</span>
							</footer>
						</div>
					</blockquote>
				))}

				<p class="border-base-300 text-base-content/40 mt-2 border-t pt-4 text-xs">
					Reseñas públicas de Google Maps recogidas en octubre de 2026. La valoración y el número
					de reseñas cambian con el tiempo.
				</p>
			</div>
		</div>
	</div>
</section>
