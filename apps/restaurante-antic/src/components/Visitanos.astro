---
import { BUSINESS } from '../data/site';

const accesibilidad = [
	'Acceso adaptado',
	'Aseo adaptado',
	'Asientos adaptados',
	'Aparcamiento adaptado',
];
---

<section id="visitanos" class="bg-base-100 border-base-300 border-t py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-14">
			<div>
				<p class="label text-primary">— Visítanos</p>
				<h2 class="font-display mt-3 text-4xl leading-[0.98] font-semibold tracking-[-0.03em] sm:text-5xl">
					En el centro,<br />
					<span class="text-primary italic">calle Herrero</span>
				</h2>
				<p class="text-base-content/65 mt-5 max-w-md text-sm leading-relaxed">
					Entre el Mercat y la plaza, con la terraza a pie de acera. Abrimos todos los días: de
					lunes a viernes desde las 7:30, el fin de semana desde las 9:00.
				</p>

				<div class="mt-7 grid gap-3 sm:grid-cols-2">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="border-base-300 hover:border-primary flex items-start gap-3 border p-4 transition-colors"
					>
						<i class="ri-map-pin-2-line text-primary mt-0.5 text-lg" aria-hidden="true"></i>
						<span>
							<span class="label text-base-content/40 text-[0.46rem]">Dirección</span>
							<span class="mt-1 block text-sm font-semibold">{BUSINESS.street}</span>
							<span class="text-base-content/55 block text-xs">
								{BUSINESS.postalCode} {BUSINESS.city}
							</span>
						</span>
					</a>

					<a
						href={BUSINESS.phoneHref}
						class="border-base-300 hover:border-primary flex items-start gap-3 border p-4 transition-colors"
					>
						<i class="ri-phone-line text-primary mt-0.5 text-lg" aria-hidden="true"></i>
						<span>
							<span class="label text-base-content/40 text-[0.46rem]">Teléfono</span>
							<span class="mt-1 block text-sm font-semibold">{BUSINESS.phone}</span>
							<span class="text-base-content/55 block text-xs">Mesas y grupos</span>
						</span>
					</a>
				</div>

				<div class="border-base-300 mt-3 border">
					<h3 class="border-base-300 flex items-center gap-2 border-b px-4 py-3">
						<i class="ri-time-line text-primary text-lg" aria-hidden="true"></i>
						<span class="label text-[0.5rem]">Horario</span>
						<span class="label ml-auto text-[0.44rem] text-base-content/35">Todos los días</span>
					</h3>
					<ul class="divide-base-200 divide-y px-4 py-1">
						{BUSINESS.hours.map((row) => (
							<li class="flex items-center justify-between gap-4 py-2.5 text-sm">
								<span class="font-medium">{row.days}</span>
								<span class="text-base-content/65">{row.hours}</span>
							</li>
						))}
					</ul>
					<p class="text-base-content/45 px-4 pt-1 pb-4 text-xs leading-relaxed">
						{BUSINESS.hoursNote}
					</p>
				</div>

				<div class="mt-3 flex flex-wrap gap-1.5">
					{accesibilidad.map((item) => (
						<span class="label border-base-300 text-base-content/55 inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1.5 text-[0.44rem]">
							<i class="ri-wheelchair-line text-primary" aria-hidden="true"></i>
							{item}
						</span>
					))}
					<span class="label border-base-300 text-base-content/55 inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1.5 text-[0.44rem]">
						<i class="ri-sun-line text-primary" aria-hidden="true"></i> Terraza
					</span>
				</div>

				<a
					href={BUSINESS.googleMaps}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-primary mt-4 h-12 w-full gap-2 rounded-sm text-sm font-semibold"
				>
					<i class="ri-route-line text-base" aria-hidden="true"></i> Abrir ruta en Google Maps
				</a>
			</div>

			<div class="flex flex-col">
				<div
					class="map-grid border-base-300 relative min-h-[27rem] flex-1 overflow-hidden border"
					data-map-src={BUSINESS.googleMapsEmbed}
				>
					<div
						class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_45%,transparent_0%,rgba(245,240,230,0.55)_70%)]"
						aria-hidden="true"
					>
					</div>
					<div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center">
						<span class="bg-primary text-primary-content flex size-12 items-center justify-center rounded-full shadow-lg">
							<i class="ri-map-pin-2-fill text-2xl" aria-hidden="true"></i>
						</span>
						<p class="font-display mt-4 text-2xl font-semibold">Antic</p>
						<p class="text-base-content/60 mt-1 text-sm">
							{BUSINESS.street} · {BUSINESS.postalCode} {BUSINESS.city}
						</p>
						<p class="text-base-content/45 mt-3 max-w-xs text-xs leading-relaxed">
							El mapa interactivo se carga solo si lo pides, para no instalar cookies de Google
							sin permiso.
						</p>
						<button
							class="map-load btn btn-neutral mt-4 h-11 gap-2 rounded-sm px-4 text-[0.62rem] font-bold tracking-[0.1em] uppercase"
							type="button"
						>
							<i class="ri-map-2-line text-base" aria-hidden="true"></i> Cargar mapa
						</button>
						<noscript>
							<a href={BUSINESS.googleMaps} class="mt-3 text-xs underline">
								Abrir el mapa en Google
							</a>
						</noscript>
					</div>
				</div>

				<div class="border-base-300 bg-base-200 grid grid-cols-2 gap-px border border-t-0">
					<div class="p-4">
						<p class="label text-base-content/40 text-[0.44rem]">Plus Code</p>
						<p class="font-display mt-1 text-lg leading-none font-semibold">{BUSINESS.plusCode}</p>
						<p class="text-base-content/50 mt-1 text-xs">Centre de Castelló</p>
					</div>
					<div class="border-base-300 border-l p-4">
						<p class="label text-base-content/40 text-[0.44rem]">Cómo venir</p>
						<p class="mt-1 text-sm font-semibold">A pie o en coche</p>
						<p class="text-base-content/50 mt-1 text-xs">Aparcamiento adaptado en la zona</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const load = document.querySelector<HTMLButtonElement>('.map-load');
	const facade = document.querySelector<HTMLElement>('[data-map-src]');
	if (load && facade) {
		load.addEventListener('click', () => {
			const src = facade.dataset.mapSrc;
			if (!src) return;
			const frame = document.createElement('iframe');
			frame.src = src;
			frame.title = 'Mapa de Antic - Restaurante en Castelló de la Plana';
			frame.loading = 'lazy';
			frame.referrerPolicy = 'no-referrer-when-downgrade';
			frame.allowFullscreen = true;
			frame.className = 'h-full min-h-[27rem] w-full';
			frame.style.border = '0';
			facade.replaceChildren(frame);
		});
	}
</script>
