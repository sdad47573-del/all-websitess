---
import { Image } from 'astro:assets';
import { BUSINESS, IMAGES, MARQUEE } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<section id="inicio" class="bg-base-100 relative overflow-hidden">
	<div
		class="pointer-events-none absolute top-0 right-0 h-72 w-72 translate-x-1/3 -translate-y-1/3 rounded-full bg-accent/15 blur-2xl"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 pt-9 pb-12 sm:px-6 sm:pt-12 lg:px-8 lg:pt-16 lg:pb-16">
		<div class="grid gap-10 lg:grid-cols-[1.04fr_0.96fr] lg:items-center lg:gap-14">
			<div class="relative z-10">
				<div class="flex flex-wrap items-center gap-2">
					<span class="bg-secondary text-secondary-content label rounded-sm px-2.5 py-1.5 text-[0.5rem]">
						Castelló de la Plana
					</span>
					<span class="border-base-300 text-base-content/55 label rounded-sm border px-2.5 py-1.5 text-[0.5rem]">
						Cafetería · Restaurante · Pizzería
					</span>
				</div>

				<h1 class="hero-title font-display mt-6" set:html={piezas.portada.titulo} />

				<p class="font-display text-primary mt-4 text-2xl leading-tight italic sm:text-3xl">
					{BUSINESS.claim}
				</p>

				<p class="text-base-content/70 mt-5 max-w-md text-base leading-relaxed">
					Cafetería a primera hora, menú del día al mediodía, terraza por la tarde y pizzas al
					anochecer. Cocina sencilla y moderna en el centre de Castelló, en la calle Herrero.
				</p>

				<div class="mt-7 flex flex-wrap items-center gap-2.5">
					<a href="#carta" class="btn btn-primary h-12 gap-2 rounded-sm px-5 text-sm font-semibold">
						Ver la carta
						<i class="ri-arrow-down-line text-base" aria-hidden="true"></i>
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline border-base-300 hover:border-neutral hover:bg-neutral hover:text-neutral-content h-12 gap-2 rounded-sm px-5 text-sm font-semibold"
					>
						<i class="ri-route-line text-base" aria-hidden="true"></i> Cómo llegar
					</a>
				</div>

				<div class="border-base-300 mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 border-t pt-5">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="group flex items-center gap-2"
						aria-label={`${BUSINESS.rating} de 5 estrellas y ${BUSINESS.reviewCount} reseñas en Google`}
					>
						<span class="text-primary flex gap-0.5 text-sm" aria-hidden="true">
							{estrellas.map((n) => (
								<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
							))}
						</span>
						<span class="text-sm font-bold">{BUSINESS.rating.toString().replace('.', ',')}</span>
						<span class="text-base-content/45 text-xs group-hover:text-primary transition-colors">
							· {BUSINESS.reviewCount} reseñas
						</span>
					</a>
					<span class="bg-base-300 hidden size-1 rounded-full sm:block" aria-hidden="true"></span>
					<p class="text-base-content/55 text-xs">
						<i class="ri-time-line mr-1 align-[-2px]" aria-hidden="true"></i>
						Lun–Vie 7:30–23:00 · Sáb hasta 24:00
					</p>
				</div>
			</div>

			<div class="offset-frame relative">
				<figure class="relative overflow-hidden bg-base-200">
					<Image
						src={IMAGES.fotoTerraza}
						alt="Terraza de Antic en la calle Herrero, con sombrilla blanca, veladores y la fachada negra del local"
						widths={[520, 780, 1040]}
						sizes="(min-width: 1024px) 46vw, 100vw"
						class="aspect-[4/5] w-full object-cover sm:aspect-[5/5]"
						loading="eager"
						fetchpriority="high"
					/>
					<figcaption
						class="bg-neutral text-neutral-content absolute inset-x-0 bottom-0 flex items-center justify-between gap-3 px-4 py-3"
					>
						<span class="label text-[0.5rem]">Terraza · Carrer d'Herrero</span>
						<i class="ri-map-pin-line text-accent" aria-hidden="true"></i>
					</figcaption>
				</figure>
				<div
					class="stamp bg-primary text-primary-content absolute -top-5 -right-4 border-4 border-base-100 sm:-right-6"
				>
					<span class="label text-[0.5rem] leading-none">Google</span>
					<span class="font-display mt-0.5 text-2xl leading-none font-bold">
						{BUSINESS.rating.toString().replace('.', ',')}
					</span>
					<span class="mt-0.5 text-[0.55rem] leading-none opacity-80">
						{BUSINESS.reviewCount} reseñas
					</span>
				</div>
			</div>
		</div>
	</div>

	<div class="bg-neutral text-neutral-content overflow-hidden">
		<div class="marquee py-3">
			{Array.from({ length: 2 }).map(() => (
				<div class="flex shrink-0 items-center">
					{MARQUEE.map((item) => (
						<span class="label flex items-center gap-5 px-5 text-[0.56rem]">
							{item}
							<span class="bg-accent size-1.5 rounded-full" aria-hidden="true"></span>
						</span>
					))}
				</div>
			))}
		</div>
	</div>
</section>
