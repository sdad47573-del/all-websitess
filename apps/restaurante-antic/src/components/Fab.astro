---
import { BUSINESS } from '../data/site';
---

<div class="fixed inset-x-0 bottom-0 z-40 p-3 sm:hidden">
	<div class="flex gap-2">
		<a
			href={BUSINESS.phoneHref}
			class="btn btn-primary grow gap-2 rounded-sm shadow-xl"
			aria-label={`Llamar a ${BUSINESS.name}`}
		>
			<i class="ri-phone-line text-lg" aria-hidden="true"></i> Llamar
		</a>
		<a
			href={BUSINESS.googleMaps}
			target="_blank"
			rel="noopener noreferrer"
			class="btn btn-neutral gap-2 rounded-sm shadow-xl"
			aria-label={`Cómo llegar a ${BUSINESS.name}`}
		>
			<i class="ri-route-line text-lg" aria-hidden="true"></i> Ruta
		</a>
	</div>
</div>
