---
import { MOMENTS } from '../data/site';
---

<section class="bg-base-100 py-16 sm:py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="label text-primary">— Un día en Antic</p>
				<h2 class="font-display mt-2 text-3xl leading-[1.02] font-semibold tracking-[-0.03em] sm:text-4xl">
					La jornada, <span class="text-primary italic">por horas</span>
				</h2>
			</div>
			<p class="text-base-content/55 max-w-sm text-sm leading-relaxed">
				Abrimos a las 7:30 y no cerramos hasta la noche. Cada hora tiene su propia carta.
			</p>
		</div>

		<div class="mt-10 grid gap-7 md:grid-cols-4 md:gap-6">
			{MOMENTS.map((momento) => (
				<article class="moment pt-5 md:pt-0">
					<div class="flex items-baseline justify-between gap-3">
						<p class="font-display text-4xl leading-none font-semibold tracking-[-0.03em] sm:text-5xl">
							{momento.time}
						</p>
						<i class={`${momento.icon} text-primary text-xl`} aria-hidden="true"></i>
					</div>
					<h3 class="label mt-4 text-[0.58rem]">{momento.title}</h3>
					<p class="text-base-content/60 mt-2 text-sm leading-relaxed">{momento.text}</p>
				</article>
			))}
		</div>
	</div>
</section>
