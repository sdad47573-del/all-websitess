---
import { Image } from 'astro:assets';
import { GALLERY } from '../data/site';
---

<section id="galeria" class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="label text-primary">— Galería</p>
				<h2 class="font-display mt-2 text-4xl leading-[0.98] font-semibold tracking-[-0.03em] sm:text-5xl">
					Lo que sale de <span class="text-primary italic">la cocina</span>
				</h2>
			</div>
			<p class="text-base-content/55 max-w-xs text-sm leading-relaxed">
				Fotos de la ficha de Google: la fachada, la terraza y los platos que se repiten.
			</p>
		</div>

		<div class="mt-9 grid grid-cols-2 gap-2.5 sm:gap-3 lg:grid-cols-3 lg:auto-rows-[15rem]">
			{GALLERY.map((foto, index) => (
				<figure
					class:list={[
						'gallery-tile group relative h-full overflow-hidden bg-base-200',
						index === 0 ? 'col-span-2 aspect-[2/1] lg:col-span-2' : 'aspect-square',
					]}
				>
					<Image
						src={foto.src}
						alt={foto.alt}
						widths={index === 0 ? [560, 840, 1120] : [300, 460, 620]}
						sizes={index === 0 ? '(min-width: 1024px) 62vw, 100vw' : '(min-width: 1024px) 30vw, 50vw'}
						class="h-full w-full object-cover"
						loading="lazy"
					/>
					<figcaption
						class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-2 bg-gradient-to-t from-black/75 via-black/25 to-transparent px-3 pt-8 pb-2.5"
					>
						<span class="label text-[0.48rem] text-white/90">{foto.caption}</span>
						<i class="ri-expand-diagonal-line text-xs text-white/50" aria-hidden="true"></i>
					</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>
