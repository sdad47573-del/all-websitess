---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import paella from '../assets/fotos/calidad-diaz-vertical-08.jpg';
import alitas from '../assets/fotos/calidad-diaz-vista-4-04.jpg';
import marinadas from '../assets/fotos/calidad-diaz-vertical-06.jpg';
import expositor from '../assets/fotos/calidad-diaz-cuadrada-05.jpg';
import polloEntero from '../assets/fotos/calidad-diaz-vista-7-07.jpg';
import piezas from '../assets/fotos/calidad-diaz-apaisada-09.jpg';
import troceado from '../assets/fotos/calidad-diaz-apaisada-10.jpg';
import muslos from '../assets/fotos/calidad-diaz-apaisada-03.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const title = 'Calidad Díaz · Pollería y comida para llevar en Villa de Vallecas';
const description = BUSINESS.description;

const galeria = [
	{
		src: alitas,
		alt: 'Fuente de alitas de pollo asadas con su jugo y pimentón',
	},
	{
		src: paella,
		alt: 'Paella de pollo y verduras con tiras de pimiento rojo en la paellera',
	},
	{
		src: expositor,
		alt: 'Muslos de pollo frescos en el expositor del local, con las luces del fondo',
	},
	{
		src: marinadas,
		alt: 'Alitas de pollo marinadas y sazonadas con pimienta, listas para el horno',
	},
	{
		src: polloEntero,
		alt: 'Pollo entero fresco sobre una tabla de madera, con sal gruesa al fondo',
	},
	{
		src: piezas,
		alt: 'Piezas de pollo frescas preparadas sobre tablas de madera con perejil',
	},
	{
		src: troceado,
		alt: 'Pollo troceado fresco sobre una pizarra oscura',
	},
	{
		src: muslos,
		alt: 'Muslos de pollo crudos con tomate cherry y especias',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Productos de Calidad Díaz',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': ['Store', 'Restaurant'],
	'@id': `${BUSINESS.siteUrl}/#calidad-diaz`,
	name: BUSINESS.name,
	alternateName: ['Calidad Diaz', 'Calidad Díaz Villa de Vallecas', 'Pollería Calidad Díaz'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phoneHref,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollería', 'Casera', 'Española'],
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Villa de Vallecas' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	hasDeliveryMethod: { '@type': 'DeliveryMethod', name: 'Reparto a domicilio' },
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '00:00',
			closes: '23:59',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '07:00',
			closes: '14:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Productos', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#131a24" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Calidad Díaz Villa de Vallecas, pollería Luis I, pollo fresco Madrid 28031, alitas de pollo, croquetas caseras, albóndigas, mollejas, huevos de corral, comida para llevar Villa de Vallecas, reparto a domicilio, artículos de hostelería"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo fresco para asar, alitas, muslos, mollejas, croquetas y albóndigas de casa, huevos de corral y reparto a domicilio en la calle Luis I, 56-58, Nave 6A, Villa de Vallecas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Paella de pollo y verduras con pimiento rojo, una de las elaboraciones de Calidad Díaz"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#131a24"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Villa de Vallecas, Madrid"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[paella]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Calidad Díaz"
			subtitle="Pollería · Villa de Vallecas"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.neighbourhood}, ${BUSINESS.city}`}
				title="Pollo fresco <br /><em>y casa de comer.</em>"
				lede={`Calidad Díaz es pollería y tienda de alimentación en la calle Luis I, 56-58, Nave 6A, en Villa de Vallecas. Pollo entero para asar, alitas, muslos, pechuga y mollejas, carne fresca y embutidos, huevos de corral y elaborados de receta casera: croquetas, albóndigas, salchichas, hamburguesas, alitas asadas y paella. También suministra a bares y restaurantes, y reparte a domicilio. Google le da ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas.`}
				image={paella}
				imageAlt="Paella de pollo y verduras con tiras de pimiento en la paellera, preparada en Calidad Díaz"
				primaryCta={{ label: `Llamar · ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				secondaryCta={{ label: 'Ver productos y fotos', href: '#carta' }}
				facts={[
					{ label: 'Nota', html: '<b>5,0</b> en Google · 6 reseñas' },
					{ label: 'Horario', html: '<b>24 h</b><br />L-V · sábado 7:00–14:00' },
					{ label: 'Reparto', html: '<b>A domicilio</b><br />Villa de Vallecas' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Al peso o listo para llevar"
			/>

			<LocalChips label="Lo que se puede encontrar en Calidad Díaz" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="La pollería <br /><em>de Villa de Vallecas.</em>"
				paragraphs={[
					'Calidad Díaz está en la calle Luis I, 56-58, Nave 6A, en Villa de Vallecas (28031 Madrid), en una nave con expositor de pollo fresco y mostrador de carne. La ficha lo clasifica a la vez como pollería, restaurante de alas de pollo, comida a domicilio y tienda de artículos de hostelería, y esa mezcla explica lo que hace: vender el género fresco y resolver la comida del día.',
					'Al mostrador se pide pollo entero para asar, alitas, muslos, contramuslos, pechuga y mollejas, además de carne fresca, salchichas y hamburguesas de la casa, embutidos y huevos de corral. Las mollejas son las que más mencionan quienes buscan el sabor de la cocina de antes.',
					'La parte de elaborados es la que se lleva las reseñas: croquetas y albóndigas de receta casera, alitas asadas, paella de pollo y verduras y guisos en bandeja. También se preparan pedidos con bandejas separadas por producto y presentaciones para congelar, algo que los clientes agradecen en las opiniones.',
					'El horario que publica la ficha es amplio: de lunes a viernes, 24 horas, y el sábado de 7:00 a 14:00, con el domingo cerrado. Hay reparto a domicilio en la zona y, según las reseñas, los pedidos también se cierran por WhatsApp. El teléfono es el 669 65 24 95.',
				]}
				note="Los datos salen de la ficha pública de Google Maps y de los resúmenes públicos del negocio que recogen sus reseñas. Esto no es un canal oficial de pedidos: precios, disponibilidad del día y reparto se confirman por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<LocalMenu
				eyebrow="Productos"
				title="Pollo, carne <br /><em>y elaborados.</em>"
				description="Lo que hay en el mostrador y en las bandejas del día. El género fresco se corta al momento y las elaboraciones cambian según la jornada."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				groups={MENU}
				note="Sin precios: Calidad Díaz no publica tarifas y las bandejas del día varían. El precio del pollo al peso y de cada elaboración se consulta en el 669 65 24 95. Para hostelería, se preparan bandejas y formatos a medida."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Alitas, paella <br /><em>y pollo fresco.</em>"
				description="Ocho fotografías del perfil de Calidad Díaz en Google Maps: las alitas asadas, la paella de pollo y verduras, el pollo fresco del expositor, las alitas marinadas, el pollo entero, las piezas preparadas sobre tabla y el pollo troceado."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<section class="reviews-band section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<div>
						<p class="reviews-kicker">La ficha de Google</p>
						<h2 id="resenas-title">5,0 sobre 5 <br /><em>en Google.</em></h2>
						<p class="reviews-rating">
							<strong>5,0</strong>
							<span>★★★★★<br />6 reseñas en Google</span>
						</p>
						<p class="reviews-note">
							Las reseñas hablan de la diferencia con el supermercado, del trato en el
							mostrador y de las croquetas y albóndigas. No se reproducen testimonios
							literalmente: se leen enteros en la ficha de Google.
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<ul class="reviews-list">
						<li class="review-card">
							<p>
								Quien compraba en grandes superficies y ha probado el género de aquí
								coincide en las opiniones: la frescura y el sabor no tienen comparación.
							</p>
							<footer>
								<span class="stars" aria-hidden="true">★★★★★</span>
								<span>Resumen de las reseñas publicadas en Google</span>
							</footer>
						</li>
						<li class="review-card">
							<p>
								Las croquetas y las albóndigas se comparan en los comentarios con las de
								un buen bar, y se destaca que el pedido llega con la presentación
								cuidada y en bandejas separadas.
							</p>
							<footer>
								<span class="stars" aria-hidden="true">★★★★★</span>
								<span>Resumen de las reseñas publicadas en Google</span>
							</footer>
						</li>
					</ul>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Villa de Vallecas, <br /><em>calle Luis I.</em>"
				addressLines={[BUSINESS.street, BUSINESS.neighbourhood, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: de lunes a viernes las 24 horas y el sábado de 7:00 a 14:00, con el domingo cerrado. En festivos puede cambiar."
				mapTitle="Mapa de Calidad Díaz en la calle Luis I, 56-58, Nave 6A, Villa de Vallecas, Madrid"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. de Luis I, 56-58, Nave 6A"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="No hay pedidos ni pagos online en esta página. El teléfono es el canal que consta para encargar pollo, bandejas o reparto; según las reseñas también se atienden pedidos por WhatsApp. El local no dispone de acceso adaptado, así que para la compra sin desplazarse lo práctico es el reparto."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>encargar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.neighbourhood}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías de la ficha pública de Google Maps y de resúmenes públicos del negocio, consultados en octubre de 2026. Los productos y la disponibilidad cambian a diario."
			ctaLabel="Llamar a Calidad Díaz"
			navAriaLabel="Enlaces de Calidad Díaz"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
