---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import paella from '../assets/fotos/restaurante-monte-cristina-apaisada-05.jpg';
import terraza from '../assets/fotos/restaurante-monte-cristina-apaisada-04.jpg';
import sepia from '../assets/fotos/restaurante-monte-cristina-vertical-10.jpg';
import comedor from '../assets/fotos/restaurante-monte-cristina-apaisada-01.jpg';
import carne from '../assets/fotos/restaurante-monte-cristina-vertical-07.jpg';
import carajillo from '../assets/fotos/restaurante-monte-cristina-vertical-03.jpg';
import ensalada from '../assets/fotos/restaurante-monte-cristina-vista-6-06.jpg';
import chimenea from '../assets/fotos/restaurante-monte-cristina-vertical-09.jpg';
import carajillosBarro from '../assets/fotos/restaurante-monte-cristina-vertical-08.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description = BUSINESS.description;

const galeria = [
	{
		src: terraza,
		alt: 'Terraza de Monte Cristina con mesas y sillas verdes bajo los pinos, en Borriol',
	},
	{
		src: sepia,
		alt: 'Sepia a la plancha con champiñones y perejil, servida en un plato de loza azul y blanca',
	},
	{
		src: comedor,
		alt: 'Comedor rústico de Monte Cristina con manteles rojos, sillas de madera y una gran chimenea de piedra',
	},
	{
		src: carne,
		alt: 'Carne a la brasa con patatas fritas y calabacín en un plato de loza decorada',
	},
	{
		src: carajillo,
		alt: 'Carajillo servido en un vaso de cristal sobre el mantel de cuadros del comedor',
	},
	{
		src: ensalada,
		alt: 'Ensalada de la casa con lechuga, tomate, remolacha, aceitunas y pimientos asados',
	},
	{
		src: chimenea,
		alt: 'Mesas vestidas de rojo junto a la chimenea del comedor de Monte Cristina',
	},
	{
		src: carajillosBarro,
		alt: 'Dos carajillos de ron quemado en vasos de barro con su jarra de leche, en la mesa de Monte Cristina',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.fullName,
	alternateName: ['Monte Cristina', 'Restaurante Monte Cristina Borriol', 'Monte Cristina Borriol'],
	slogan: BUSINESS.tagline,
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34643221168',
	currenciesAccepted: 'EUR',
	priceRange: '€€',
	servesCuisine: ['Española', 'Mediterránea', 'Arroces y paellas', 'Carnes a la brasa'],
	areaServed: [
		{ '@type': 'City', name: 'Borriol' },
		{ '@type': 'City', name: 'Castellón de la Plana' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Castellón' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.province,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '17:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Zona para niños',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Restaurante Monte Cristina · Arroces a la leña en Borriol';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#4a5638" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400;1,9..144,600&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Restaurante Monte Cristina, Monte Cristina Borriol, paella a la leña Borriol, arroces Castellón, carnes a la brasa Borriol, menú del día Borriol, restaurante Borriol, Urbanización Monte Cristina, restaurante mediterráneo Castellón"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Monte Cristina · Arroces a la leña y brasa en Borriol"
			ogDescription="Paellas y arroces a la leña, carnes a la brasa y menú del día en la Urbanización Monte Cristina, 2 (Borriol). 4,2 en Google con 783 reseñas. Tel. 643 22 11 68."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Paella valenciana cocinándose a la leña en Restaurante Monte Cristina, Borriol"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#4a5638"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.province}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone="+34643221168"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Borriol, Castellón"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: `${BUSINESS.city}, ${BUSINESS.province}`,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'España',
				phone: '+34 643 22 11 68',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[paella]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Cocina casera española · Borriol"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Urbanización Monte Cristina, 2 · Borriol (Castellón)"
				title="Arroces a la leña<br /><em>en Borriol.</em>"
				lede="Monte Cristina es la casa de comidas del kilómetro 16 de la carretera de Castellón a Alcora: paellas y arroces al fuego de leña, chuletones y carnes a la brasa, pulpo y sepia a la plancha y un menú del día que la casa anuncia por 9 €. Un comedor rústico con chimenea y una terraza bajo las moreras para comer sin prisa."
				image={paella}
				imageAlt="Paella valenciana con caracoles y pimiento rojo cocinándose sobre brasas de leña en Monte Cristina"
				primaryCta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Arroz a la leña"
				facts={[
					{ label: 'Nota', html: '<b>4,2 en Google</b> con 783 reseñas' },
					{ label: 'Martes a domingo', html: '<b>9:00 – 17:00</b>' },
					{ label: 'Jueves y domingo', html: '<b>Paella a la leña</b>' },
					{ label: 'Lunes', html: '<b>Cerrado</b>' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Qué ofrece Monte Cristina" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una casa de comidas<br /><em>camino de Alcora.</em>"
				paragraphs={[
					'El restaurante está en la Urbanización Monte Cristina, 2, en el término de Borriol, a la altura del kilómetro 16 de la carretera que une Castellón con Alcora. Es una casa apartada del ruido de la ciudad, con aparcamiento junto al local, un comedor rústico de techos altos y una terraza cubierta y descubierta bajo la sombra de las moreras.',
					'La cocina es la de siempre, la de casa: paellas y arroces de marisco que se hacen a la leña, fideuàs, carnes a la brasa —chuletón de ternera, entrecot, cordero y conejo— y pescado a la plancha, con el pulpo y la sepia entre los platos que más repiten quienes vienen de Castellón. La casa anuncia paella valenciana a la leña los jueves y los domingos, dentro del menú de fin de semana.',
					'El menú diario incluye primero, segundo, postre, una bebida, pan, ensalada y café por 9 €, y el de fin de semana cuesta 15 €. Para terminar, el carajillo de ron quemado servido en vaso de barro se ha convertido en la seña de identidad de la casa: hay quien viene solo a por él.',
				]}
				note="La ficha de Google reúne una nota de 4,2 sobre 5 con 783 reseñas. El local tiene aseos y asientos adaptados para sillas de ruedas; los clientes explican que se puede subir con el coche hasta la entrada. No hay reserva online: se reserva por teléfono."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Del fuego<br />a la mesa."
				description="La casa no publica una carta cerrada con todos los precios. Esto es lo que anuncia en su web y lo que más se repite en las reseñas: arroces a la leña, carnes a la brasa y los menús de cada día."
				cta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Precios de los menús según la web del restaurante: 9 € el diario y 15 € el de fin de semana. La carta cambia con la temporada y el mercado, así que confirma platos y precios al llamar al 643 22 11 68. Hay servicio de barra para bocadillos y raciones a media mañana."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La leña,<br />la mesa<br /><em>y la terraza.</em>"
				description="Estas fotografías proceden del perfil de Monte Cristina en Google Maps: la paella sobre las brasas, la terraza entre pinos, la sepia a la plancha, el comedor con su chimenea, la carne a la brasa, el carajillo de la casa y la ensalada del menú."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil público del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Urbanización Monte Cristina, 2 · 12190 Borriol"
				title="En el km 16,<br /><em>camino de Alcora.</em>"
				addressLines={[
					BUSINESS.street,
					BUSINESS.area,
					`${BUSINESS.postalCode} ${BUSINESS.city} · ${BUSINESS.province}`,
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="Abre de martes a domingo de 9:00 a 17:00 y cierra los lunes. En festivos y puentes el horario puede cambiar; si vas a última hora o en grupo, llama antes al 643 22 11 68."
				mapTitle="Mapa de Restaurante Monte Cristina en la Urbanización Monte Cristina, 2, Borriol"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Monte Cristina · Borriol"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 643 22 11 68. La casa tiene terraza, comedor con chimenea y zona para que jueguen los niños, y admite mesas grandes de familia y de amigos. En fin de semana conviene reservar, sobre todo si se quiere paella."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Monte Cristina"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
