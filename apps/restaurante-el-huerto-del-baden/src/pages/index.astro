---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/restaurante-el-huerto-del-baden-apaisada-01.jpg';
import foto1 from '../assets/fotos/restaurante-el-huerto-del-baden-apaisada-03.jpg';
import foto2 from '../assets/fotos/restaurante-el-huerto-del-baden-vertical-05.jpg';
import foto3 from '../assets/fotos/restaurante-el-huerto-del-baden-apaisada-06.jpg';
import foto4 from '../assets/fotos/restaurante-el-huerto-del-baden-vertical-07.jpg';
import foto5 from '../assets/fotos/restaurante-el-huerto-del-baden-cuadrada-09.jpg';

const business = {
	name: 'Restaurante El Huerto del Badén',
	short: 'El Huerto del Badén',
	street: 'Cam. del Badén, 78',
	city: 'Murcia',
	region: 'Región de Murcia',
	province: 'Murcia',
	postalCode: '30010',
	phone: '+34 968 26 12 33',
	latitude: 37.9715358,
	longitude: -1.1487009,
	site: 'https://restaurante-el-huerto-del-baden.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+El+Huerto+del+Bad%C3%A9n/@37.9715358,-1.1487009,17z/data=!4m6!3m5!1s0xd637f5efacd0667:0xb108ac2632bdb8e0!8m2!3d37.9715358!4d-1.1487009!16s%2Fg%2F1tflns8k?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34968261233';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'La cocina',
		title: 'Cocina mediterránea',
		text: 'Cocina mediterránea y española, con el producto de la huerta murciana y los platos de siempre bien hechos.',
	},
	{
		kicker: 'En la mesa',
		title: 'Raciones generosas',
		text: '«Buen trato y buena calidad, raciones generosas»: así resumen los clientes lo que se encuentra al sentarse a la mesa.',
	},
	{
		kicker: 'El sitio',
		title: 'Ambiente familiar',
		text: 'La ficha de Google Maps lo describe como un restaurante con un ambiente muy familiar, en pleno corazón de la huerta.',
	},
	{
		kicker: 'La cuenta',
		title: 'Precios muy buenos',
		text: 'Buena atención, buena carta, buena cocina y precios muy buenos: lo que más se repite en las reseñas del restaurante.',
	},
	{
		kicker: 'Mediodía',
		title: 'Comidas de martes a domingo',
		text: 'Servicio de mediodía todos los días salvo el lunes, desde las 13:30. El domingo se alarga hasta las 19:00.',
	},
	{
		kicker: 'Cenas',
		title: 'Viernes y sábado',
		text: 'Cenas de 19:30 a 23:30 el viernes y de 19:00 a 23:30 el sábado, para terminar la semana en la huerta.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de Restaurante El Huerto del Badén publicada en su ficha de Google Maps' },
	{ src: photos.foto2, alt: 'Imagen de El Huerto del Badén en Murcia tomada de su galería de Google Maps' },
	{ src: photos.foto3, alt: 'Fotografía del restaurante en el camino del Badén, 78, Murcia' },
	{ src: photos.foto4, alt: 'Imagen de Restaurante El Huerto del Badén subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Vista de El Huerto del Badén según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está El Huerto del Badén?',
		a: 'En el camino del Badén, 78, 30010 Murcia. Coordenadas 37.9715358, -1.1487009, en pleno corazón de la huerta.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De martes a viernes abre de 13:30 a 16:00; el sábado de 13:30 a 17:00 y el domingo de 13:30 a 19:00. Viernes y sábado también hay cena. El lunes cierra.',
	},
	{
		q: '¿Qué tipo de cocina sirve?',
		a: 'Cocina mediterránea y española, con bar de tapas. Las reseñas destacan las raciones generosas y la buena relación entre calidad y precio.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso, aparcamiento, aseo y asientos adaptados para sillas de ruedas. Para necesidades concretas, llama antes.',
	},
	{
		q: '¿Cómo se contacta?',
		a: 'Llamando al 968 26 12 33. Si vienes en festivo o quieres confirmar el horario, es mejor llamar antes.',
	},
];

const images = [
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'Restaurante El Huerto del Badén, en la huerta de Murcia: cocina mediterránea y española, raciones generosas y ambiente familiar. Llama al 968 26 12 33.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: business.phone,
	image: images,
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Española', 'Tapas'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '13:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Friday',
			opens: '19:30',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '13:30',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '19:00',
			closes: '23:30',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '13:30', closes: '19:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Ambiente familiar', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.3,
		reviewCount: 1606,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#23281d" />
		<meta
			name="description"
			content="Restaurante El Huerto del Badén, en la huerta de Murcia: cocina mediterránea y española, raciones generosas y ambiente familiar. Llama al 968 26 12 33."
		/>
		<meta
			name="keywords"
			content="El Huerto del Badén, restaurante Murcia, cocina de huerta, restaurante mediterráneo Murcia, camino del Badén, bar de tapas Murcia"
		/>
		<meta name="author" content="Restaurante El Huerto del Badén" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Restaurante El Huerto del Badén | Cocina de huerta en Murcia</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="El Huerto del Badén · Cocina de huerta en Murcia" />
		<meta
			property="og:description"
			content="Cocina mediterránea y española, raciones generosas y ambiente familiar en el camino del Badén, 78 (Murcia)."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="Restaurante El Huerto del Badén, en la huerta de Murcia" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="El Huerto del Badén · Cocina de huerta en Murcia" />
		<meta
			name="twitter:description"
			content="Cocina mediterránea y española en el camino del Badén, 78 (Murcia). Llama al 968 26 12 33."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Murcia" />
		<meta name="geo.position" content="37.9715358;-1.1487009" />
		<meta name="ICBM" content="37.9715358, -1.1487009" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Restaurante El Huerto del Badén, inicio">
				<span class="brand-mark" aria-hidden="true">H</span>
				<span class="brand-name">El Huerto del Badén <small>Camino del Badén · Murcia</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">El restaurante</a>
				<a href="#cocina">La cocina</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>968 26 12 33</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Cam. del Badén, 78 · Murcia</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
					Restaurante El Huerto del Badén, en pleno corazón de la huerta de Murcia. Cocina mediterránea y
					española, raciones generosas y un ambiente familiar, con servicio de mediodía de martes a domingo y
					cenas los viernes y sábados.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 968 26 12 33</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,3</b> en Google (1.606 reseñas)</li>
						<li>Cocina mediterránea</li>
						<li>Raciones generosas</li>
						<li>Ambiente familiar</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						alt="Restaurante El Huerto del Badén, en la huerta de Murcia"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,3</b><span>Google</span></div>
					<div><b>1.606</b><span>Reseñas</span></div>
					<div><b>6/7</b><span>Días</span></div>
				</div>
				<ul class="services">
					<li>Cocina mediterránea</li>
					<li>Cocina española</li>
					<li>Tapas</li>
					<li>Raciones</li>
					<li>Ambiente familiar</li>
					<li>Local accesible</li>
				</ul>
			</section>

			<section class="about section-pad" id="restaurante">
				<p class="section-label"><span aria-hidden="true"></span> En pleno corazón de la huerta</p>
				<div class="about-grid">
					<h2>Un restaurante<br />de huerta y<br /><em>familia.</em></h2>
					<div class="about-copy">
						<p>
							Restaurante El Huerto del Badén está en el camino del Badén, 78, en Murcia. Cocina
							mediterránea y española, bar de tapas y un ambiente familiar, en pleno corazón de la huerta.
						</p>
						<p>
							Las reseñas destacan el trato, la calidad, las raciones generosas y unos precios buenos.
							También la atención del equipo, que aparece con nombres propios en los comentarios de Google
							Maps.
						</p>
						<p class="about-note">
							Abre de martes a domingo al mediodía: de 13:30 a 16:00 de martes a viernes, hasta las 17:00 el
							sábado y hasta las 19:00 el domingo. Viernes y sábado también hay cena. El lunes cierra.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="cocina">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Lo que dicen sus clientes</p>
						<h2>Cocina de siempre<br />en la <em>huerta.</em></h2>
					</div>
					<p>
						Cocina mediterránea y española, tapas y raciones. Lo que más se repite en las reseñas es el
						trato, la calidad, el tamaño de las raciones y la buena relación entre precio y comida.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>El restaurante<br /><em>en imágenes.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Restaurante El Huerto del Badén. En
							la ficha encontrarás la galería completa, con aportaciones de clientes, y las reseñas
							actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="avif"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres el
					titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Cam. del Badén, 78</p>
					<h2>Ven a comer<br /><em>a la huerta.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes</th>
								<td>Cerrado</td>
							</tr>
							<tr>
								<th scope="row">Martes a jueves</th>
								<td>13:30 – 16:00</td>
							</tr>
							<tr>
								<th scope="row">Viernes</th>
								<td>13:30 – 16:00 · 19:30 – 23:30</td>
							</tr>
							<tr>
								<th scope="row">Sábado</th>
								<td>13:30 – 17:00 · 19:00 – 23:30</td>
							</tr>
							<tr>
								<th scope="row">Domingo</th>
								<td>13:30 – 19:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, llama antes de venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar 968 26 12 33</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 968 26 12 33</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Restaurante El Huerto del Badén en el camino del Badén, 78, Murcia"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> El Huerto del Badén · Murcia
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">H</span>
				<p>El Huerto del Badén<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Restaurante El Huerto del Badén · Murcia. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>

			<p class="footer-credit">
				Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
				<a href="https://sur-digital.vercel.app/" rel="noopener">sur-digital.vercel.app</a>
			</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
