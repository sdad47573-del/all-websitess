---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import arrozConejo from '../assets/fotos/pache-comidas-caseras-almoradi-vista-1-01.jpg';
import vitrina from '../assets/fotos/pache-comidas-caseras-almoradi-cuadrada-02.jpg';
import tortilla from '../assets/fotos/pache-comidas-caseras-almoradi-cuadrada-03.jpg';
import pimientos from '../assets/fotos/pache-comidas-caseras-almoradi-vista-4-04.jpg';
import arrozEmpanado from '../assets/fotos/pache-comidas-caseras-almoradi-apaisada-05.jpg';
import huevos from '../assets/fotos/pache-comidas-caseras-almoradi-vertical-06.jpg';
import pescado from '../assets/fotos/pache-comidas-caseras-almoradi-vertical-07.jpg';
import ensalada from '../assets/fotos/pache-comidas-caseras-almoradi-vertical-08.jpg';
import guiso from '../assets/fotos/pache-comidas-caseras-almoradi-vertical-09.jpg';
import cazuela from '../assets/fotos/pache-comidas-caseras-almoradi-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Pache · Comida casera para llevar en Almoradí';
const description =
	'Pache, comida casera para llevar en C. Canalejas, 44 (03160 Almoradí, Alicante). Menú de mediodía de lunes a viernes, de 10:00 a 15:00.';

const galeria = [
	{
		src: vitrina,
		alt: 'La vitrina de Pache con bandejas de caracoles, albóndigas, garbanzos con espinacas, ensaladilla, berenjenas gratinadas y pasta',
	},
	{
		src: arrozConejo,
		alt: 'Una paella de arroz amarillo con conejo y tiras de pimiento rojo, recién hecha',
	},
	{
		src: guiso,
		alt: 'Una cazuela de guiso de carne con patatas en salsa de tomate, con la cuchara dentro',
	},
	{
		src: pescado,
		alt: 'Una bandeja de merluza rebozada sobre salsa de tomate en la vitrina',
	},
	{
		src: pimientos,
		alt: 'Una bandeja de pimientos rojos asados con cebollas asadas y patatas',
	},
	{
		src: huevos,
		alt: 'Huevos fritos con la yema líquida sobre pimientos y cebolla asada en una bandeja',
	},
	{
		src: tortilla,
		alt: 'Una tortilla con chorizo cuajada en la sartén, dorada por encima',
	},
	{
		src: arrozEmpanado,
		alt: 'Un plato de arroz con guisantes y maíz con filetes de pollo empanado, sobre un mantel azul',
	},
	{
		src: ensalada,
		alt: 'Una ensalada grande de atún con aceitunas negras, huevo, patata, tomate y cebolla',
	},
	{
		src: cazuela,
		alt: 'Una cazuela hirviendo con un guiso amarillo de azafrán, recién removido',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#pache`,
	name: BUSINESS.fullName,
	alternateName: ['Pache Almoradí', 'Pache comidas caseras', 'Comidas caseras para llevar Pache'],
	description:
		'Comida casera para llevar en la calle Canalejas, 44 (03160 Almoradí, Alicante): vitrina de guisos, arroces, pescado rebozado y postres, de lunes a viernes al mediodía.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34604420521',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina casera', 'Cocina valenciana', 'Comida para llevar'],
	hasMenu: {
		'@type': 'Menu',
		name: 'Carta de Pache',
		inLanguage: 'es-ES',
		hasMenuSection: MENU.map((group) => ({
			'@type': 'MenuSection',
			name: group.title,
			hasMenuItem: group.items.map((item) => ({
				'@type': 'MenuItem',
				name: item.name,
				description: item.note,
			})),
		})),
	},
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Almoradí' },
		{ '@type': 'AdministrativeArea', name: 'Comunidad Valenciana' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '10:00',
			closes: '15:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"pache-comidas-caseras-almoradi-cuadrada-02.jpg": vitrina,
	"pache-comidas-caseras-almoradi-vista-1-01.jpg": arrozConejo,
	"pache-comidas-caseras-almoradi-vertical-09.jpg": guiso,
	"pache-comidas-caseras-almoradi-vertical-07.jpg": pescado,
	"pache-comidas-caseras-almoradi-vista-4-04.jpg": pimientos,
	"pache-comidas-caseras-almoradi-vertical-06.jpg": huevos,
	"pache-comidas-caseras-almoradi-cuadrada-03.jpg": tortilla,
	"pache-comidas-caseras-almoradi-apaisada-05.jpg": arrozEmpanado,
	"pache-comidas-caseras-almoradi-vertical-08.jpg": ensalada,
	"pache-comidas-caseras-almoradi-vertical-10.jpg": cazuela,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#7b2d3b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;500;700&family=DM+Serif+Display&family=Sacramento&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Pache Almoradí, comidas caseras para llevar Almoradí, menú del día Almoradí, comida para llevar Canalejas, guisos caseros Vega Baja, tarta de tres chocolates 03160"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Guisos, arroces, pescado rebozado y postres caseros para llevar en C. Canalejas, 44, Almoradí. De lunes a viernes, de 10:00 a 15:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La vitrina de guisos caseros de Pache, en Almoradí"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#7b2d3b"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Almoradí, Alicante"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Pache"
			subtitle="Comidas caseras · Almoradí"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultados en noviembre de 2026. La ficha no publica carta con precios: confirma el menú y el horario antes de ir."
			ctaLabel="Llamar a Pache"
			navAriaLabel="Enlaces de Pache comidas caseras"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34604420521?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carta%20de%20Pache." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carta de Pache"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
