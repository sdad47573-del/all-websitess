---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/moremar-comidas-para-llevar-panoramica-01.jpg';
import asado from '../assets/fotos/moremar-comidas-para-llevar-apaisada-02.jpg';
import mostrador from '../assets/fotos/moremar-comidas-para-llevar-apaisada-03.jpg';
import habas from '../assets/fotos/moremar-comidas-para-llevar-vertical-04.jpg';
import sirviendo from '../assets/fotos/moremar-comidas-para-llevar-apaisada-05.jpg';
import lentejas from '../assets/fotos/moremar-comidas-para-llevar-vertical-06.jpg';
import pizarra from '../assets/fotos/moremar-comidas-para-llevar-apaisada-07.jpg';
import barra from '../assets/fotos/moremar-comidas-para-llevar-apaisada-08.jpg';
import asadoBandejas from '../assets/fotos/moremar-comidas-para-llevar-apaisada-09.jpg';
import pinchos from '../assets/fotos/moremar-comidas-para-llevar-apaisada-10.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Moremar · Comidas caseras y asados en Fuente Álamo';
const description =
	'Moremar comidas para llevar, en Ronda de Levante (30320 Fuente Álamo, Murcia). Cocina casera, raciones abundantes y asados los fines de semana, de 7:00 a 17:00.';

const galeria = [
	{
		src: comedor,
		alt: 'El comedor de Moremar con mesas de mantel rojo, sillas de madera, suelo de damero y la estantería de vinos',
	},
	{
		src: asado,
		alt: 'Un plato de asado con patatas al horno, tomate asado, ajos y dos croquetas',
	},
	{
		src: sirviendo,
		alt: 'Una empleada de Moremar sirviendo en la barra, con bandejas de patatas, pinchos morunos, caracoles y verdura',
	},
	{
		src: pizarra,
		alt: 'La pizarra del menú del día de Moremar con caldo de gallina, callos con garbanzos, paella, conejo, rabas, cordero y pollo asado',
	},
	{
		src: mostrador,
		alt: 'El mostrador de Moremar con bandejas de asado con patatas y tomate, un guiso y la vitrina de bebidas',
	},
	{
		src: habas,
		alt: 'Un plato de habas guisadas con chorizo y morcilla sobre mantel de cuadros azules',
	},
	{
		src: lentejas,
		alt: 'Un plato de lentejas con patata y zanahoria en una mesa de mantel rojo, con una ensalada al fondo',
	},
	{
		src: asadoBandejas,
		alt: 'Bandejas de asado con patatas panadera y tomate asado en el mostrador caliente',
	},
	{
		src: pinchos,
		alt: 'Un plato con pinchos morunos y un trozo de tortilla, con las bandejas del mostrador detrás',
	},
	{
		src: barra,
		alt: 'La barra de azulejos de Moremar vista desde una mesa con mantel de cuadros rojos y blancos',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#moremar`,
	name: BUSINESS.fullName,
	alternateName: ['Moremar', 'Moremar Fuente Álamo', 'Comidas para llevar Moremar'],
	description:
		'Cocina casera, raciones y asados para llevar en la Ronda de Levante (30320 Fuente Álamo, Murcia), con comedor y barra. Abre de 7:00 a 17:00, con el martes cerrado.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34669232605',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina española', 'Cocina casera', 'Asados', 'Comida para llevar'],
	hasMenu: {
		'@type': 'Menu',
		name: 'Carta de Moremar',
		inLanguage: 'es-ES',
		hasMenuSection: MENU.map((group) => ({
			'@type': 'MenuSection',
			name: group.title,
			hasMenuItem: group.items.map((item) => ({
				'@type': 'MenuItem',
				name: item.name,
				description: item.note,
			})),
		})),
	},
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Fuente Álamo de Murcia' },
		{ '@type': 'AdministrativeArea', name: 'Región de Murcia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '07:00',
			closes: '17:00',
		},
	],
	isAccessibleForFree: true,
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f5566" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Marcellus&family=Parisienne&family=Public+Sans:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Moremar Fuente Álamo, comidas para llevar Fuente Álamo, comida casera Ronda de Levante, asados fin de semana Murcia, menú del día Fuente Álamo, bar 30320, pollo asado Murcia"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina casera, raciones abundantes y asados los fines de semana en Ronda de Levante, Fuente Álamo. Comedor, barra y comida para llevar, de 7:00 a 17:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Un plato de asado con patatas y croquetas de Moremar, en Fuente Álamo"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1f5566"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Fuente Álamo de Murcia"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Moremar"
			subtitle="Comidas caseras · Fuente Álamo"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Ronda de Levante · Fuente Álamo"
				title="Comida de casa, <br /><em>para llevar.</em>"
				lede={`Moremar está en la Ronda de Levante, en Fuente Álamo, y abre a las 7:00 para desayuno, almuerzo y comida. La ficha lo clasifica como restaurante de cocina española y bar; las reseñas hablan de «muy buena cocina y raciones abundantes» y de «excelentes asados los fines de semana». Hay comedor con manteles rojos y barra, y ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={comedor}
				imageAlt="El comedor de Moremar con mesas de mantel rojo, sillas de madera y suelo de damero"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>7:00–17:00</b> · martes cerrado' },
					{ label: 'Especialidad', html: '<b>Asados</b> · los fines de semana' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Comida casera"
			/>

			<LocalChips label="Lo que ofrece Moremar" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="La cocina <br /><em>de cada día.</em>"
				paragraphs={[
					'Moremar está en la Ronda de Levante, en Fuente Álamo. Abre a las 7:00 y no cierra hasta las 17:00, de lunes a domingo salvo los martes: sirve desayunos, almuerzos y comidas en el mismo horario, con barra y comedor.',
					'Dentro, las mesas se visten de rojo y el suelo es de damero; al fondo está la barra de azulejos y la estantería de vinos. En el mostrador se alinean las bandejas del día: asado con patatas y tomate, guisos de cuchara, croquetas, caracoles, pinchos morunos, verdura y tortilla.',
					'La pizarra manda. En la que aparece en las fotos del perfil se leen caldo de gallina, callos con garbanzos, gazpacho, paella, conejo, rabas, bacalao, cordero, chuletillas, cochillo, dorada, pollo asado y ternera. Cada día se reescribe.',
					`Las reseñas lo cuentan en dos líneas: «Muy buena cocina y raciones abundantes» y «buena comida casera y excelentes asados los fines de semana». La ficha reúne ${RATING.count} opiniones con una media de ${RATING.label}.`,
				]}
				note="La ficha no publica carta con precios, formas de pago, reparto a domicilio ni redes sociales. Los platos de esta página salen de la pizarra y del mostrador que aparecen en las fotos del perfil, y de las reseñas destacadas; los precios se consultan por teléfono. El horario puede cambiar en festivos."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que se lleva la gente</p>
					<h2 id="highlights-title">Cuchara, brasa <br /><em>y mostrador.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La comida"
				title="La pizarra <br /><em>y el mostrador.</em>"
				description="Platos y guisos tomados de la pizarra del local y de las bandejas que aparecen en las fotos del perfil. La lista cambia cada día y no hay precios publicados."
				cta={{ label: `Preguntar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La ficha y las fotos no publican precios, así que aquí no hay importes. Qué se asa, qué guiso hay ese día y cuánto cuesta se confirma en el 669 23 26 05. Los asados se anuncian especialmente los fines de semana."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor, el mostrador <br /><em>y la pizarra.</em>"
				description="Diez fotografías del perfil de Moremar: el comedor con manteles rojos, el asado con patatas, la barra con las bandejas, la pizarra del menú, los guisos de habas y lentejas, los pinchos y la barra de azulejos."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,4 sobre 5, <em>con 185 reseñas.</em></h2>
						<p>
							Google publica una media de 4,4 con 185 opiniones (noviembre de 2026). Las reseñas
							que se ven aquí elogian la cocina casera, las raciones y los asados del fin de
							semana; la de una estrella critica los fritos de tomate. Son las que destaca la
							ficha; hay muchas más opiniones en Google.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,4</strong>
						<span>★★★★★</span>
						<small>185 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En Fuente Álamo, <br /><em>Ronda de Levante.</em>"
				addressLines={[BUSINESS.street, BUSINESS.postalCode, `${BUSINESS.district}, ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha: de 7:00 a 17:00, con el martes cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Moremar comidas para llevar en la Ronda de Levante, Fuente Álamo"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Ronda de Levante · Fuente Álamo"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote={`Pedidos por teléfono en el ${BUSINESS.phone}, para recoger o para comer en el comedor. La ficha declara acceso para sillas de ruedas y aseo adaptado, y no publica reparto a domicilio ni reserva online.`}
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>llamar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultados en noviembre de 2026. La ficha no publica carta con precios: confirma platos, precios y horario antes de la visita."
			ctaLabel="Llamar a Moremar"
			navAriaLabel="Enlaces de Moremar comidas para llevar"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
