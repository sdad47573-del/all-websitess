---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import vitrina from '../assets/fotos/la-miga-panaderia-pasteleria-apaisada-01.jpg';
import vitrinaAncha from '../assets/fotos/la-miga-panaderia-pasteleria-apaisada-07.jpg';
import torrijas from '../assets/fotos/la-miga-panaderia-pasteleria-apaisada-03.jpg';
import donuts from '../assets/fotos/la-miga-panaderia-pasteleria-vertical-05.jpg';
import tarta from '../assets/fotos/la-miga-panaderia-pasteleria-cuadrada-06.jpg';
import chocolate from '../assets/fotos/la-miga-panaderia-pasteleria-vista-9-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'La Miga Panadería y Pastelería · Masa madre y dulces en Córdoba';
const description = BUSINESS.description;

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#la-miga`,
	name: BUSINESS.name,
	alternateName: ['La Miga Córdoba', 'La Miga panadería', 'La Miga pastelería Córdoba'],
	description:
		'Panadería y pastelería en la Avenida de Rabanales, 16 (Levante, 14007 Córdoba): pan de masa madre, pan del día, torrijas, bollería y tartas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 722 79 88 48',
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '09:00',
			closes: '14:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '17:00',
			closes: '20:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '09:00',
			closes: '14:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: vitrinaAncha,
		alt: 'Vitrina de La Miga con tartas, torrijas, pasteles y bandejas de dulces',
	},
	{
		src: torrijas,
		alt: 'Bandeja de torrijas glaseadas y torrijas con azúcar en la vitrina',
	},
	{
		src: donuts,
		alt: 'Donuts y piezas de bollería cubiertas de chocolate blanco y azúcar glas',
	},
	{
		src: tarta,
		alt: 'Tarta de chocolate con la palabra «Felicidades» escrita en blanco',
	},
	{
		src: chocolate,
		alt: 'Figuras de chocolate de conejo y huevo de Pascua envueltas individualmente',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f4e4a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Miga Córdoba, panadería Levante Córdoba, pastelería Avenida de Rabanales, pan de masa madre Córdoba, torrijas Córdoba, tartas 14007"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería y pastelería en la Avenida de Rabanales, 16 (Levante, 14007 Córdoba): pan de masa madre, torrijas, bollería y tartas. De martes a sábado en dos turnos; domingos por la mañana."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Vitrina de La Miga con tartas, torrijas y bandejas de dulces"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1f4e4a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Panadería · Pastelería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Levante · 14007 Córdoba"
				title="La Miga, <br /><em>pan y pastelería.</em>"
				lede={`En la Avenida de Rabanales, 16, en el Levante de Córdoba. La vitrina de La Miga junta el pan de masa madre con las torrijas, los donuts, las tartas de chocolate y los dulces de temporada. Abre de martes a sábado en dos turnos y el domingo por la mañana; el lunes descansa. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google y teléfono propio: ${BUSINESS.phone}.`}
				image={vitrina}
				imageAlt="Vitrina de La Miga con tartas, torrijas y bandejas de dulces, y el rótulo del obrador al fondo"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>5,0</b> en Google · 4 reseñas' },
					{ label: 'Horario', html: '<b>M–S</b> 9:00–14:00 y 17:00–20:00' },
					{ label: 'Teléfono', html: '<b>722 79 88 48</b>' },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Masa madre · Dulces"
			/>

			<LocalChips label="Lo que hay en La Miga" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un obrador <br /><em>de barrio.</em>"
				paragraphs={[
					'La Miga está en la Avenida de Rabanales, 16, en el distrito Levante de Córdoba (14007). La ficha de Google la clasifica como panadería y pastelería y publica un teléfono propio, el 722 79 88 48.',
					'Las fotos del perfil enseñan la vitrina: bandejas de torrijas glaseadas y con azúcar, donuts y piezas cubiertas de chocolate, tartas de chocolate y pasteles con nata. En una de las fotos se ven también figuras de chocolate de conejo y huevo de Pascua envueltas una a una.',
					'Las reseñas hablan del pan y del trato: «magnífico pan de masa madre y dulces, magnífico trato de quien lo lleva ahora» y «hemos probado mi familia y yo varios en varias ocasiones y nos ha enamorado». Son 4 opiniones y 5 sobre 5.',
					'El horario parte el día: de martes a sábado abre de 9:00 a 14:00 y vuelve por la tarde, de 17:00 a 20:00. El domingo solo por la mañana, de 9:00 a 14:00, y el lunes cierra.',
				]}
				note="La ficha de Google no publica descripción, web propia, correo, redes, carta ni precios. Lo que se cuenta aquí sale de la ficha, de las reseñas y de las fotos de su galería. Los carteles de precio que aparecen en las fotos cambian, así que esta web no repite importes."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Masa madre, <br />
							<em>vitrina y trato.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El mostrador"
				title="Lo que sale <br /><em>del obrador.</em>"
				description="Sin precios publicados: esto es lo que cuentan las reseñas de Google y lo que se ve en las fotos del perfil."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={MENU_GROUPS}
				note="La ficha no publica carta ni precios, así que esta web no indica importes. Los carteles de las fotos marcan precios por pieza, pero cambian: confírmalos en el mostrador."
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="La vitrina, <br /><em>en detalle.</em>"
				description="Cinco fotos de la ficha de Google Maps: la vitrina, las torrijas, los donuts, la tarta y el chocolate."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la Avenida <br /><em>de Rabanales.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.district} · ${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de La Miga Panadería y Pastelería en el Levante de Córdoba"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Miga · Av. de Rabanales, 16"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Abrir en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{
					label: `Llamar al ${BUSINESS.phone}`,
					href: BUSINESS.phoneHref,
					external: true,
				}}
				reserveNote="La ficha de Google marca acceso para sillas de ruedas, pero no publica datos sobre el aseo ni el aparcamiento. Tampoco detalla encargos ni reparto, así que conviene llamar antes de ir."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.district}, ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de La Miga"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
