---
import '../styles/global.css';
import {
	business,
	directionsUrl,
	facebookAlbumUrl,
	facebookPhotosUrl,
	facebookUrl,
	faqSchema,
	faqs,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	specialties,
	tripadvisorUrl,
} from '../lib/business';

const title = 'Restaurante Miranda | Cocina casera en Aldea Quintana, Córdoba';
const description =
	'Restaurante Miranda en Aldea Quintana, junto a la carretera Madrid-Cádiz, km 424. Cocina casera, carnes a la brasa y desayunos. Llama para consultar y reservar.';
const keywords =
	'Restaurante Miranda Aldea Quintana, restaurante Córdoba carretera A-4, cocina casera Córdoba, carnes a la brasa, menú del día Aldea Quintana, Ctra Madrid Cádiz km 424, reservar Restaurante Miranda';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#2d2c23" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Aldea Quintana, Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración vectorial original de un plato de brasa para Restaurante Miranda; no es una foto del local" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante Miranda, inicio">
				<span class="brand-mark" aria-hidden="true">M</span>
				<span class="brand-copy">Restaurante Miranda <small>Cocina casera · Aldea Quintana</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cocina">La cocina</a>
				<a href="#parada">La parada</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Cómo llegar</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 699 15 72 79</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Aldea Quintana · Carretera Madrid-Cádiz</p>
					<h1 id="hero-title">Una parada<br />con sabor <em>a casa.</em></h1>
					<p class="hero-intro">En Restaurante Miranda, junto al km 424, la cocina casera y las carnes a la brasa hacen que el camino merezca una pausa. Ven a desayunar o consulta el servicio disponible antes de llegar.</p>
					<div class="hero-actions">
						<a class="button button-rust" href={phoneHref}>Llamar y consultar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>A pie de carretera</small><address>{business.streetAddress}<br />{business.locality} · Córdoba</address></div>
						<div><small>Reservas</small><a href={phoneHref}>{business.phone}</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración original de un plato de brasa, no es una fotografía del restaurante">
					<span class="plate-dot" aria-hidden="true"></span><div class="plate" aria-hidden="true"><div class="roast"></div></div>
					<div class="art-caption"><strong>Sabores de siempre</strong>Desayuno · brasa · cocina casera</div>
				</div>
			</section>

			<div class="promise" aria-label="Qué ofrece Restaurante Miranda">
				<span>Cocina casera</span><span>Carnes a la brasa</span><span>Desayunos</span><span>Parada en ruta</span>
			</div>

			<section class="section intro" id="parada" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Aldea Quintana · Córdoba</p>
					<h2 id="intro-title">El camino también<br /><em>sabe a hogar.</em></h2>
				</div>
				<div class="intro-copy">
					<p>Restaurante Miranda está a pie de la carretera Madrid-Cádiz, en el km 424, junto a Aldea Quintana. Su cocina de siempre, el trato familiar y el servicio de desayunos lo convierten en una parada conocida para quienes viajan y trabajan por la zona.</p>
					<p>La especialidad que destaca el propio restaurante son las carnes a la brasa. También se mencionan platos caseros y recetas andaluzas como salmorejo, flamenquín y guisos. Consulta qué está disponible hoy antes de desplazarte.</p>
					<p class="source-note">Los directorios consultados muestran horarios distintos y parte de la información puede estar desactualizada. Llama al restaurante para confirmar apertura, servicio de comidas y reservas.</p>
				</div>
			</section>

			<section class="section menu-section" id="cocina" aria-labelledby="menu-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Cocina casera · sabor cordobés</p>
						<h2 id="menu-title">De la brasa<br /><em>a la cuchara.</em></h2>
					</div>
					<p>Una selección orientativa de platos y servicios citados en los perfiles y reseñas del restaurante. No es una carta oficial: confirma el menú, precios y disponibilidad por teléfono.</p>
				</div>
				<div class="menu-grid">
					{specialties.map((dish, index) => (
						<article class="menu-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<p class="menu-note">Platos sujetos a carta y temporada. <a href={phoneHref}>Llama para consultar el servicio del día</a>.</p>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<p class="section-label"><span aria-hidden="true"></span> Restaurante Miranda en imágenes</p>
				<h2 id="gallery-title">Asómate a<br /><em>la parada.</em></h2>
				<p class="gallery-copy">El enlace de Maps abre la ficha, pero no incluye URLs directas de las fotografías. Desde aquí puedes acceder a las imágenes reales del local compartidas en Google Maps y Facebook.</p>
				<div class="gallery-grid">
					<a class="gallery-card" href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Restaurante Miranda en Google Maps">
						<span class="gallery-tag">Fotos de la ficha</span><span class="gallery-title">Google Maps <span aria-hidden="true">↗</span></span>
					</a>
					<a class="gallery-card" href={facebookPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver las fotos de la página de Facebook de Restaurante Miranda">
						<span class="gallery-tag">Página del negocio</span><span class="gallery-title">Facebook <span aria-hidden="true">↗</span></span>
					</a>
					<a class="gallery-card" href={facebookAlbumUrl} target="_blank" rel="noreferrer" aria-label="Abrir un álbum público de Restaurante Miranda en Facebook">
						<span class="gallery-tag">Álbum público</span><span class="gallery-title">Fotos del mesón <span aria-hidden="true">↗</span></span>
					</a>
				</div>
				<p class="gallery-note">La ilustración de portada y los fondos de las tarjetas son gráficos originales, no fotografías del restaurante. Las fotos reales se consultan en los enlaces externos.</p>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14140 · Aldea Quintana</p>
					<h2 id="visit-title">Haz un alto<br /><em>en el km 424.</em></h2>
					<address>{business.streetAddress}<br />{business.locality} · {business.postalCode}<br />{business.province}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Teléfono móvil publicado</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Cómo llegar</small><a href={mapsUrl} target="_blank" rel="noreferrer">Abrir ubicación en Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Facebook oficial</small><a href={facebookUrl} target="_blank" rel="noreferrer">Ver publicaciones y novedades ↗</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar para consultar</a>
					</div>
					<p class="menu-note">Confirma días, horarios y servicio del día por teléfono, especialmente si viajas desde lejos.</p>
				</div>
				<div class="map-card">
					<iframe title="Mapa de Restaurante Miranda en Aldea Quintana, Córdoba, carretera Madrid-Cádiz km 424" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
					<div class="map-label"><div><strong>Restaurante Miranda</strong><small>Aldea Quintana · Córdoba</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>llegar.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="Restaurante Miranda, volver al inicio">
				<span class="brand-mark" aria-hidden="true">M</span><span class="brand-copy">Restaurante Miranda <small>Aldea Quintana · Córdoba</small></span>
			</a>
			<nav class="footer-nav" aria-label="Perfiles y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Restaurante Miranda · Aldea Quintana, Córdoba. Confirma horario y carta con el establecimiento.</small>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar para consultar <span>699 15 72 79</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>
