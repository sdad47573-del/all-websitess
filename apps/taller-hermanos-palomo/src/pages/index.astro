---
import '../styles/global.css';
import { business, directionsUrl, mapEmbedUrl, mapsUrl, phoneHref, structuredData } from '../lib/business';
import Galeria from '../components/Galeria.astro';

const title = 'Taller mecánico Hermanos Palomo | Málaga';
const description =
	'Taller mecánico Hermanos Palomo en Málaga. Consulta la dirección en C/ Padre Martín, 23 y llama al 951 25 16 47. Cómo llegar y ubicación en Google Maps.';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#202522" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://taller-hermanos-palomo.vercel.app/og.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7290797;-4.4507428" />
		<meta name="ICBM" content="36.7290797, -4.4507428" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Taller Hermanos Palomo, inicio">
				<span class="brand-mark" aria-hidden="true"><span>HP</span></span>
				<span class="brand-name">Hermanos Palomo <small>Taller mecánico · Málaga</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#taller">El taller</a>
				<a href="#ubicacion">Ubicación</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}><span aria-hidden="true">↗</span> 951 25 16 47</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid" aria-hidden="true"></div>
				<div class="hero-copy">
					<p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> C/ Padre Martín · Málaga</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Un taller mecánico en Málaga. Estamos en la calle Padre Martín, 23: llámanos o consulta la
						ubicación antes de venir.
					</p>
					<div class="hero-actions">
						<a class="button button-amber" href={phoneHref}>
							<span class="button-icon" aria-hidden="true">↗</span> Llamar al taller
						</a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="hero-contact">
						<span class="contact-line" aria-hidden="true"></span>
						<p><small>ENCUÉNTRANOS EN</small><strong>{business.streetAddress} · {business.city}</strong></p>
					</div>
				</div>

				<div class="hero-art" aria-label="Ilustración gráfica de un pistón mecánico">
					<div class="art-coordinate art-coordinate-top">TALLER · MÁLAGA</div>
					<div class="art-coordinate art-coordinate-bottom">36°43'44.7&quot;N&nbsp; 4°27'02.7&quot;W</div>
					<div class="art-orbit orbit-one"></div>
					<div class="art-orbit orbit-two"></div>
					<div class="art-glow"></div>
					<svg class="piston" viewBox="0 0 440 520" role="img" aria-label="Ilustración de pistón, pieza mecánica">
						<defs>
							<linearGradient id="metal" x1="0" y1="0" x2="1" y2="1">
								<stop offset="0" stop-color="#e5e6de" />
								<stop offset=".36" stop-color="#7c8680" />
								<stop offset=".62" stop-color="#c4c8bf" />
								<stop offset="1" stop-color="#515c56" />
							</linearGradient>
							<linearGradient id="stem" x1="0" y1="0" x2="1" y2="0">
								<stop stop-color="#5b655f" />
								<stop offset=".48" stop-color="#e0e1d9" />
								<stop offset="1" stop-color="#606b65" />
							</linearGradient>
							<filter id="shadow" x="-30%" y="-20%" width="160%" height="160%">
								<feDropShadow dx="0" dy="18" stdDeviation="14" flood-color="#000" flood-opacity=".45" />
							</filter>
						</defs>
						<g filter="url(#shadow)" stroke="#202522" stroke-width="5" stroke-linejoin="round">
							<path d="M178 250h84l21 202a22 22 0 0 1-22 24h-82a22 22 0 0 1-22-24z" fill="url(#stem)" />
							<ellipse cx="220" cy="454" rx="42" ry="28" fill="#89918b" />
							<ellipse cx="220" cy="454" rx="21" ry="12" fill="#252b27" />
							<path d="M108 121h224v111c0 42-34 76-76 76h-72c-42 0-76-34-76-76z" fill="url(#metal)" />
							<path d="M116 172h208v27H116zm5 43h198v22H121z" fill="#333b36" />
							<path d="M105 106q0-29 29-29h166q29 0 29 29v27H105z" fill="#b5bbb4" />
							<path d="M127 81 145 48h144l20 33z" fill="#59645d" />
							<path d="M135 120h170" stroke="#f3a940" stroke-width="7" />
							<circle cx="220" cy="274" r="23" fill="#353d38" />
							<circle cx="220" cy="274" r="9" fill="#e3a23c" stroke="none" />
						</g>
						<path d="M166 338h108M170 358h100" stroke="#f5f1e7" stroke-opacity=".36" stroke-width="3" />
					</svg>
					<span class="art-index" aria-hidden="true">HP<span> / TALLER MECÁNICO</span></span>
				</div>
			</section>

			<section class="identity-strip" id="taller" aria-label="Datos del taller">
				<div class="identity-mark" aria-hidden="true">HP<span>·</span></div>
				<p><small>ACTIVIDAD</small><strong>Taller mecánico</strong></p>
				<span class="strip-rule" aria-hidden="true"></span>
				<p><small>DIRECCIÓN</small><strong>{business.streetAddress}, {business.postalCode}</strong></p>
				<span class="strip-rule" aria-hidden="true"></span>
				<p><small>LOCALIDAD</small><strong>{business.city}, España</strong></p>
			</section>

			<section class="location section-pad" id="ubicacion" aria-labelledby="location-title">
				<div class="location-copy">
					<p class="eyebrow dark"><span class="eyebrow-line" aria-hidden="true"></span> Dónde encontrarnos</p>
					<h2 id="location-title">Estamos en<br /><em>tu barrio.</em></h2>
					<p class="location-lede">
						Visítanos en C/ Padre Martín, 23, en Málaga. Para confirmar información antes de desplazarte,
						llama al taller.
					</p>
					<address>
						<span class="address-icon" aria-hidden="true">⌖</span>
						<span><strong>{business.streetAddress}</strong><small>{business.postalCode} {business.city}, España</small></span>
					</address>
					<a class="phone-number" href={phoneHref}>
						<small>TELÉFONO</small><strong>951 25 16 47</strong>
					</a>
					<div class="location-actions">
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">
							Abrir indicaciones <span aria-hidden="true">↗</span>
						</a>
						<a class="text-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Google Maps ↗</a>
					</div>
					<p class="verification-note">Consulta por teléfono los servicios y el horario antes de acudir.</p>
				</div>
				<div class="map-shell">
					<div class="map-head"><span><i aria-hidden="true"></i> UBICACIÓN DEL TALLER</span><span>MÁLAGA · ES</span></div>
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
						title="Mapa de ubicación del Taller mecánica Hermanos Palomo en C/ Padre Martín, 23, Málaga"
					 src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-tag" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Hermanos Palomo
					</a>
				</div>
			</section>
			<Galeria nombre="Taller mecánica Hermanos Palomo" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio" aria-label="Hermanos Palomo, volver al inicio">
				<span class="brand-mark" aria-hidden="true"><span>HP</span></span>
				<span class="brand-name">Hermanos Palomo <small>Taller mecánico · Málaga</small></span>
			</a>
			<p>{business.streetAddress} · {business.postalCode} {business.city}</p>
			<a class="footer-phone" href={phoneHref}>951 25 16 47 <span aria-hidden="true">↗</span></a>
			<small>© {new Date().getFullYear()} {business.name}. Información de ubicación y contacto.</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
	<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
	<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
	<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
</nav>
</footer>

		<a class="mobile-call" href={phoneHref}><span aria-hidden="true">↗</span> Llamar al taller <strong>951 25 16 47</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34951251647?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Taller%20mec%C3%A1nica%20Hermanos%20Palomo." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Taller mecánica Hermanos Palomo"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>


