---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import pollo from '../assets/fotos/el-manjar-cr-apaisada-02.jpg';
import albondigas from '../assets/fotos/el-manjar-cr-apaisada-03.jpg';
import ensaladilla from '../assets/fotos/el-manjar-cr-apaisada-04.jpg';
import ensaladaPasta from '../assets/fotos/el-manjar-cr-cuadrada-01.jpg';
import logo from '../assets/fotos/el-manjar-cr-panoramica-06.jpg';
import cartel from '../assets/fotos/el-manjar-cr-vertical-05.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	INSTAGRAM,
	MAPS,
	MENU,
	MENU_PRECIO,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'El manjar Cr · Comida casera para llevar en Ciudad Real';
const description =
	'El manjar Cr, en C. de la Mata, 4 (13004 Ciudad Real). Menú diario por 7 € con pan y postre, pollo asado, guisos y postres caseros, para llevar y a domicilio.';

const galeria = [
	{
		src: pollo,
		alt: 'Trozos de pollo asado dorados, recién sacados del horno, en una bandeja',
	},
	{
		src: albondigas,
		alt: 'Una cazuela de albóndigas en salsa amarilla con guisantes y tomate',
	},
	{
		src: ensaladilla,
		alt: 'Ensaladilla rusa con patata, zanahoria, aceitunas y tiras de pimiento rojo asado',
	},
	{
		src: ensaladaPasta,
		alt: 'Ensalada de pasta tricolor con maíz, aceitunas negras, huevo cocido y atún',
	},
	{
		src: cartel,
		alt: 'El cartel del menú diario de El manjar Cr: primero, segundo, pan y postre por 7 €',
	},
	{
		src: logo,
		alt: 'El rótulo de El manjar Cr, con el gorro de cocinero y el lema «Comida y derivados para llevar»',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-manjar-cr`,
	name: BUSINESS.fullName,
	alternateName: ['El Manjar Cr', 'El Manjar Ciudad Real', 'El Manjar comida para llevar'],
	description:
		'Tienda de comida casera para llevar y a domicilio en la calle de la Mata, 4 (13004 Ciudad Real): menú diario por 7 € con pan y postre, pollo asado, guisos y postres de casa.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, INSTAGRAM.href],
	telephone: '+34615434670',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina casera', 'Cocina manchega', 'Comida para llevar'],
	hasMenu: {
		'@type': 'Menu',
		name: 'Menú diario de El manjar Cr',
		inLanguage: 'es-ES',
		hasMenuSection: MENU.map((group) => ({
			'@type': 'MenuSection',
			name: group.title,
			hasMenuItem: group.items.map((item) => ({
				'@type': 'MenuItem',
				name: item.name,
				description: item.note,
			})),
		})),
	},
	hasTakeaway: true,
	hasDeliveryMethod: 'http://purl.org/goodrelations/v1#DeliveryModeOwnFleet',
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday'],
			opens: '11:45',
			closes: '15:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El menú', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"el-manjar-cr-apaisada-02.jpg": pollo,
	"el-manjar-cr-apaisada-03.jpg": albondigas,
	"el-manjar-cr-apaisada-04.jpg": ensaladilla,
	"el-manjar-cr-cuadrada-01.jpg": ensaladaPasta,
	"el-manjar-cr-vertical-05.jpg": cartel,
	"el-manjar-cr-panoramica-06.jpg": logo,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#46263c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Prata&family=Mulish:wght@400;600;700&family=Reenie+Beanie&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El manjar Cr Ciudad Real, comida casera para llevar Ciudad Real, menú diario 7 euros, pollo asado Ciudad Real, comida a domicilio Ciudad Real, calle de la Mata 4, 13004"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Menú diario por 7 € con primero, segundo, pan y postre. Pollo asado, guisos y postres caseros en la calle de la Mata, 4, Ciudad Real. También a domicilio."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Pollo asado de El manjar Cr, comida casera para llevar en Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#46263c"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[pollo]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El manjar Cr"
			subtitle="Comida casera · Ciudad Real"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Instagram ↗', href: INSTAGRAM.href, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultados en noviembre de 2026. El precio del menú es el del cartel del propio local y puede cambiar."
			ctaLabel="Llamar a El manjar Cr"
			navAriaLabel="Enlaces de El manjar Cr"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
