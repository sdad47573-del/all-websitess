---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import espetada from '../assets/fotos/aicha-african-food-vertical-09.jpg';
import frangoArroz from '../assets/fotos/aicha-african-food-vista-1-01.jpg';
import doisPratos from '../assets/fotos/aicha-african-food-vista-3-03.jpg';
import arrozGuisado from '../assets/fotos/aicha-african-food-apaisada-04.jpg';
import frangoCuscuz from '../assets/fotos/aicha-african-food-vertical-05.jpg';
import carneEstufada from '../assets/fotos/aicha-african-food-apaisada-06.jpg';
import peixeGrelhado from '../assets/fotos/aicha-african-food-vertical-07.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICOS } from '../data/site';

const title = 'Aicha African food · Cozinha africana em Lisboa';
const description = BUSINESS.description;

const galeria = [
	{
		src: carneEstufada,
		alt: 'Dois pedaços de carne estufada com arroz, batata cozida e cenoura num prato branco',
	},
	{
		src: frangoArroz,
		alt: 'Arroz temperado com frango assado e couve cozida, servido numa bandeja azul',
	},
	{
		src: doisPratos,
		alt: 'Dois pratos de arroz branco e duas tigelas de guisado de carne, uma delas com batata e cenoura',
	},
	{
		src: arrozGuisado,
		alt: 'Arroz branco ao lado de uma tigela de guisado verde de legumes com carne',
	},
	{
		src: frangoCuscuz,
		alt: 'Perna de frango grelhada com cebola salteada sobre cuscuz, com pepino e tomate às rodelas',
	},
	{
		src: peixeGrelhado,
		alt: 'Posta de peixe grelhado com feijão-verde, cenoura, batata cozida e cebola',
	},
	{
		src: espetada,
		alt: 'Espetada de carne grelhada com pimento verde e cebola, acompanhada de arroz branco',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#aicha`,
	name: BUSINESS.name,
	alternateName: ['Aicha', 'Aicha African food Lisboa'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 920 063 381',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Africana'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Área Metropolitana de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '11:00',
			closes: '22:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A cozinha', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#7a2e1d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Aicha African food, restaurante africano Lisboa, comida africana Lisboa, restaurante Rua do Arco da Graça, onde comer africano em Lisboa, cozinha africana Lisboa, restaurante Lisboa centro"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Restaurante africano na Rua do Arco da Graça, 14, em Lisboa. Aberto todos os dias das 11:00 às 22:00. Tel. +351 920 063 381."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Carne estufada com arroz, batata e cenoura no Aicha African food"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#7a2e1d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone="+351920063381"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lisboa"
			locale="pt_PT"
			countryName="Portugal"
			preload={[carneEstufada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Aicha"
			subtitle="African food · Lisboa"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow="Rua do Arco da Graça, 14 · Lisboa"
				title="Cozinha africana <br /><em>em Lisboa.</em>"
				lede={`O Aicha African food é um restaurante africano na Rua do Arco da Graça, 14, em Lisboa. Está aberto todos os dias, das 11:00 às 22:00, e o telefone é o ${BUSINESS.phoneDisplay}. A ficha de Google dá-lhe 4,6 sobre 5 com 72 críticas.`}
				image={carneEstufada}
				imageAlt="Dois pedaços de carne estufada com arroz, batata cozida e cenoura num prato branco"
				primaryCta={{ label: 'Como chegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha e críticas no Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> no Google · 72 críticas' },
					{ label: 'Horário', html: '<b>11:00–22:00</b> todos os dias' },
					{ label: 'Cozinha', html: '<b>Africana</b> em Lisboa' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto do perfil de Google Maps"
				galleryLinkLabel="Ver a galeria"
			/>

			<LocalChips label="O que encontras no Aicha African food" items={SERVICOS} />

			<LocalAbout
				label="A casa"
				title="Uma cozinha africana <br /><em>na Rua do Arco da Graça.</em>"
				paragraphs={[
					'O Aicha African food fica na Rua do Arco da Graça, 14, em Lisboa, com o código postal 1150-320. É um restaurante de bairro, aberto todos os dias às 11:00 e a fechar às 22:00, sem pausa entre o almoço e o jantar.',
					'A Google classifica o espaço como restaurante africano. É a única descrição oficial que existe: a ficha não tem site próprio, não publica carta nem preços e não inclui uma apresentação escrita pelo próprio estabelecimento.',
					'A ficha tem 4,6 sobre 5 com 72 críticas. As fotografias do perfil mostram pratos do dia a dia — arroz com frango, carne estufada com batata, guisados de legumes, peixe grelhado e espetadas — servidos em pratos brancos e bandejas, ao estilo de uma casa de comida caseira.',
					'Esta página reúne apenas o que está publicado na ficha: morada, horário, telefone e fotografias. Não inventa pratos, preços nem serviços, e não promete reservas online porque a ficha não as tem.',
				]}
				note={`Tem ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 com ${BUSINESS.reviewsCount} críticas no Google. O telefone publicado é o ${BUSINESS.phoneDisplay}.`}
				links={[
					{ label: 'Ficha e críticas no Google', href: MAPS.reviews, external: true },
					{ label: `Ligar para ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="A cozinha"
				title="O que se sabe <br /><em>da casa.</em>"
				description="A ficha de Google não publica carta, pratos nem preços, e o restaurante não tem site próprio. O que segue é só o que consta na ficha: a cozinha, o horário e o contacto."
				cta={{ label: `Telefonar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Não há carta nem preços publicados. Para saber o que há hoje, o caminho é ligar para o +351 920 063 381 ou passar à porta."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Sete fotografias <br /><em>da mesa.</em>"
				description="As fotografias do perfil do Aicha African food em Google Maps: arroz com frango, carne estufada com batata e cenoura, guisados de legumes, peixe grelhado, espetadas e pastéis fritos."
				images={galeria}
				cta={{ label: 'Ver tudo no Google Maps', href: MAPS.place }}
				note="Imagens alojadas nesta página e provenientes do perfil do estabelecimento em Google Maps. Se tens os direitos de alguma e queres retirá-la, diz-nos e apagamo-la."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Passa pela <br /><em>Arco da Graça.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Lisboa, Portugal']}
				hours={HOURS}
				hoursCaption="Horário"
				hoursNote="Horário publicado na ficha de Google: todos os dias, das 11:00 às 22:00. A própria ficha avisa que em feriados o horário pode ser diferente, por isso convém confirmar por telefone antes de ir."
				mapTitle="Mapa do Aicha African food na Rua do Arco da Graça, 14, Lisboa"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Aicha African food · Lisboa"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Como chegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Telefone: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				reserveNote="Não há reserva online: a ficha não tem site nem sistema de reservas, por isso o telefone é o único canal publicado. A ficha consultada também não indica informação sobre acessibilidade nem serviços como esplanada ou take-away."
			/>

			<LocalFaq items={FAQ} eyebrow="Perguntas frequentes" title="Antes de <em>vir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Informação elaborada a partir de fontes públicas; confirma horário e oferta antes da visita."
			ctaLabel="Ligar para o Aicha African food"
			navAriaLabel="Ligações do Aicha African food"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
