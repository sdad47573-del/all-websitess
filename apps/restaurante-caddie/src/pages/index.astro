---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import barra from '../assets/fotos/restaurante-caddie-apaisada-09.jpg';
import comedor from '../assets/fotos/restaurante-caddie-vertical-01.jpg';
import ensalada from '../assets/fotos/restaurante-caddie-panoramica-03.jpg';
import rebozado from '../assets/fotos/restaurante-caddie-panoramica-07.jpg';
import entrecotHuevo from '../assets/fotos/restaurante-caddie-vertical-02.jpg';
import tartaQueso from '../assets/fotos/restaurante-caddie-vertical-04.jpg';
import rotulo from '../assets/fotos/restaurante-caddie-vertical-05.jpg';
import entrecotGuiso from '../assets/fotos/restaurante-caddie-vertical-06.jpg';
import pintxosSetas from '../assets/fotos/restaurante-caddie-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Restaurante Caddie, en Plaza Caddie 3 (Lasarte-Oria). Pinchos, raciones, platos combinados y menú del día. Cierra los martes. Tel. 943 37 07 04.';

const title = 'Restaurante Caddie · Taberna y menú del día en Lasarte';

const galeria = [
	{
		src: barra,
		alt: 'Barra del Restaurante Caddie con bandejas de pintxos, montaditos, croquetas y mini hamburguesas',
	},
	{
		src: ensalada,
		alt: 'Ensalada completa con arroz, pasta, lechuga, tomate, maíz, zanahoria y huevo en el Restaurante Caddie',
	},
	{
		src: rebozado,
		alt: 'Plato combinado con un rebozado grande y patatas fritas en el Restaurante Caddie',
	},
	{
		src: comedor,
		alt: 'Comedor del Restaurante Caddie con mesas y sillas de madera junto a las ventanas',
	},
	{
		src: rotulo,
		alt: 'Rótulo de Caddie con la figura de un caddie sobre fondo verde en la fachada del restaurante',
	},
	{
		src: entrecotHuevo,
		alt: 'Entrecot con huevo frito y patatas fritas servido en el Restaurante Caddie',
	},
	{
		src: entrecotGuiso,
		alt: 'Entrecot con patatas y un guiso de carne con puré en dos platos del Restaurante Caddie',
	},
	{
		src: pintxosSetas,
		alt: 'Tostadas de setas con pimiento y cebolleta en la barra del Restaurante Caddie',
	},
	{
		src: tartaQueso,
		alt: 'Porción de tarta de queso casera con un postre de cuchara en vaso en el Restaurante Caddie',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#caddie`,
	name: BUSINESS.name,
	alternateName: ['Caddie', 'Bar Caddie', 'Restaurante Caddie Lasarte'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 943 37 07 04',
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Vasca', 'Española', 'Cocina de taberna'],
	areaServed: [
		{ '@type': 'City', name: 'Lasarte-Oria' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday'],
			opens: '06:30',
			closes: '22:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '06:30',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '09:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '09:00',
			closes: '22:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const nota = BUSINESS.rating.toFixed(1).replace('.', ',');

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-caddie-apaisada-09.jpg": barra,
	"restaurante-caddie-panoramica-03.jpg": ensalada,
	"restaurante-caddie-panoramica-07.jpg": rebozado,
	"restaurante-caddie-vertical-01.jpg": comedor,
	"restaurante-caddie-vertical-05.jpg": rotulo,
	"restaurante-caddie-vertical-02.jpg": entrecotHuevo,
	"restaurante-caddie-vertical-06.jpg": entrecotGuiso,
	"restaurante-caddie-vertical-10.jpg": pintxosSetas,
	"restaurante-caddie-vertical-04.jpg": tartaQueso,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#5a2530" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Caddie, Caddie Lasarte, taberna Lasarte-Oria, menú del día Lasarte, pinchos Lasarte, platos combinados Gipuzkoa, comer en Lasarte, bar Plaza Caddie"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Restaurante Caddie · Taberna y menú del día en Lasarte"
			ogDescription="Pinchos, tapas, raciones, platos combinados y menú del día en Plaza Caddie 3 (Lasarte-Oria). Cierra los martes. Tel. 943 37 07 04."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Barra de pintxos del Restaurante Caddie en Lasarte-Oria"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#5a2530"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34943370704"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.city}
			preload={[barra]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="RESTAURANTE CADDIE"
			subtitle="Plaza Caddie · Lasarte-Oria"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Caddie"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34943370704?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Lasarte-Oria." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Lasarte-Oria"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
