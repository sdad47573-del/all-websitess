---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import barra from '../assets/fotos/restaurante-caddie-apaisada-09.jpg';
import comedor from '../assets/fotos/restaurante-caddie-vertical-01.jpg';
import ensalada from '../assets/fotos/restaurante-caddie-panoramica-03.jpg';
import rebozado from '../assets/fotos/restaurante-caddie-panoramica-07.jpg';
import entrecotHuevo from '../assets/fotos/restaurante-caddie-vertical-02.jpg';
import tartaQueso from '../assets/fotos/restaurante-caddie-vertical-04.jpg';
import rotulo from '../assets/fotos/restaurante-caddie-vertical-05.jpg';
import entrecotGuiso from '../assets/fotos/restaurante-caddie-vertical-06.jpg';
import pintxosSetas from '../assets/fotos/restaurante-caddie-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Restaurante Caddie, en Plaza Caddie 3 (Lasarte-Oria). Pinchos, raciones, platos combinados y menú del día. Cierra los martes. Tel. 943 37 07 04.';

const title = 'Restaurante Caddie · Taberna y menú del día en Lasarte';

const galeria = [
	{
		src: barra,
		alt: 'Barra del Restaurante Caddie con bandejas de pintxos, montaditos, croquetas y mini hamburguesas',
	},
	{
		src: ensalada,
		alt: 'Ensalada completa con arroz, pasta, lechuga, tomate, maíz, zanahoria y huevo en el Restaurante Caddie',
	},
	{
		src: rebozado,
		alt: 'Plato combinado con un rebozado grande y patatas fritas en el Restaurante Caddie',
	},
	{
		src: comedor,
		alt: 'Comedor del Restaurante Caddie con mesas y sillas de madera junto a las ventanas',
	},
	{
		src: rotulo,
		alt: 'Rótulo de Caddie con la figura de un caddie sobre fondo verde en la fachada del restaurante',
	},
	{
		src: entrecotHuevo,
		alt: 'Entrecot con huevo frito y patatas fritas servido en el Restaurante Caddie',
	},
	{
		src: entrecotGuiso,
		alt: 'Entrecot con patatas y un guiso de carne con puré en dos platos del Restaurante Caddie',
	},
	{
		src: pintxosSetas,
		alt: 'Tostadas de setas con pimiento y cebolleta en la barra del Restaurante Caddie',
	},
	{
		src: tartaQueso,
		alt: 'Porción de tarta de queso casera con un postre de cuchara en vaso en el Restaurante Caddie',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#caddie`,
	name: BUSINESS.name,
	alternateName: ['Caddie', 'Bar Caddie', 'Restaurante Caddie Lasarte'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 943 37 07 04',
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Vasca', 'Española', 'Cocina de taberna'],
	areaServed: [
		{ '@type': 'City', name: 'Lasarte-Oria' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday'],
			opens: '06:30',
			closes: '22:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '06:30',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '09:00',
			closes: '24:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '09:00',
			closes: '22:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const nota = BUSINESS.rating.toFixed(1).replace('.', ',');
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#5a2530" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Caddie, Caddie Lasarte, taberna Lasarte-Oria, menú del día Lasarte, pinchos Lasarte, platos combinados Gipuzkoa, comer en Lasarte, bar Plaza Caddie"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Restaurante Caddie · Taberna y menú del día en Lasarte"
			ogDescription="Pinchos, tapas, raciones, platos combinados y menú del día en Plaza Caddie 3 (Lasarte-Oria). Cierra los martes. Tel. 943 37 07 04."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Barra de pintxos del Restaurante Caddie en Lasarte-Oria"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#5a2530"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34943370704"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.city}
			preload={[barra]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="RESTAURANTE CADDIE"
			subtitle="Plaza Caddie · Lasarte-Oria"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Plaza Caddie, 3 · Lasarte-Oria"
				title="La taberna<br /><em>de Plaza Caddie.</em>"
				lede={`Restaurante Caddie es la taberna de Plaza Caddie, 3, en Lasarte-Oria. Abre a las 6:30 para el desayuno, y a lo largo del día sirve pinchos y tapas en la barra, raciones, bocadillos, platos combinados y menú del día. Cierra los martes. ${nota} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={barra}
				imageAlt="Barra del Restaurante Caddie con bandejas de pintxos, montaditos, croquetas y mini hamburguesas"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${nota}</b> en Google (${BUSINESS.reviewsCount} reseñas)` },
					{ label: 'Barra', html: 'Pinchos, tapas, raciones y bocadillos' },
					{ label: 'Horario', html: 'Desde las 6:30 · cierra martes' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece el Restaurante Caddie" items={[...SERVICIOS]} />

			<LocalAbout
				label="La casa"
				title="Barra, mesa<br /><em>y menú del día.</em>"
				paragraphs={[
					'El Restaurante Caddie está en Plaza Caddie, 3, en el 20160 Lasarte-Oria (Gipuzkoa). Google lo clasifica como restaurante y taberna, y su rótulo de fachada, con la figura de un caddie sobre una silueta verde, es la seña de la casa antes de entrar.',
					'Abre todos los días menos el martes. De lunes a viernes empieza a las 6:30 y cierra a las 22:00, salvo el viernes, que alarga hasta medianoche; el sábado va de 9:00 a 24:00 y el domingo, de 9:00 a 22:00. Es el horario que publica su ficha de Google y puede cambiar, así que conviene confirmarlo por teléfono.',
					'Dentro hay un comedor de mesas y sillas de madera junto a las ventanas, con la barra al fondo. Allí se sirven tapas, pinchos, raciones y bocadillos, y a la mesa pasan los platos combinados y el menú del día que anuncian sus reseñas.',
					'Las reseñas publicadas hablan de una ensalada «completísima», de un plato combinado con merluza rebozada y de la hamburguesa con patatas alioli. En las fotos del perfil aparecen además el entrecot con patatas —también con huevo frito—, un guiso de carne con puré, los pintxos de setas de la barra y la tarta de queso de postre.',
					`Tiene ${nota} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google. La ficha marca acceso para sillas de ruedas y asientos adaptados.`,
				]}
				note="La ficha de Google no publica carta ni precios: los platos de esta página son los que citan las reseñas y los que muestran las fotos del propio restaurante. La carta cambia, así que conviene preguntar al llegar."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="La barra,<br /><em>la mesa y el día.</em>"
				description="La ficha de Google no publica carta. Esto es lo que citan sus reseñas y lo que aparece en las fotos del restaurante; el menú del día cambia cada jornada."
				cta={{ label: `Preguntar el menú: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={[...MENU]}
				note="El menú del día no tiene precio publicado en la ficha de Google. Se consulta llamando al 943 37 07 04 y cambia cada día."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La barra,<br /><em>el comedor y los platos.</em>"
				description="Estas fotografías proceden del perfil del Restaurante Caddie en Google Maps: la barra de pintxos, el comedor, el rótulo de la fachada, la ensalada, el rebozado con patatas, el entrecot, el guiso, los pintxos de setas y la tarta de queso."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Plaza Caddie, 3,<br /><em>en Lasarte-Oria.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Gipuzkoa · País Vasco',
				]}
				hours={[...HOURS]}
				hoursNote="Horario de la ficha de Google: cierra los martes; de lunes a viernes abre a las 6:30 y cierra a las 22:00 (el viernes, a medianoche); el sábado, de 9:00 a 24:00, y el domingo, de 9:00 a 22:00. Puede cambiar, así que conviene llamar antes."
				mapTitle="Mapa del Restaurante Caddie en Plaza Caddie, 3, Lasarte-Oria"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Restaurante Caddie · Lasarte-Oria"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 943 37 07 04. La ficha de Google marca acceso para sillas de ruedas y asientos adaptados, y el comedor tiene mesas y sillas de madera junto a las ventanas."
			/>

			<LocalFaq items={[...FAQ]} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Caddie"
		/>
	</body>
</html>
