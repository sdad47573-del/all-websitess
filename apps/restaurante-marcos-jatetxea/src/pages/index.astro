---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import filetes from '../assets/fotos/restaurante-marcos-jatetxea-apaisada-01.jpg';
import menuDia from '../assets/fotos/restaurante-marcos-jatetxea-vertical-02.jpg';
import cafe from '../assets/fotos/restaurante-marcos-jatetxea-vertical-03.jpg';
import tortilla from '../assets/fotos/restaurante-marcos-jatetxea-apaisada-04.jpg';
import ensalada from '../assets/fotos/restaurante-marcos-jatetxea-apaisada-05.jpg';
import crema from '../assets/fotos/restaurante-marcos-jatetxea-apaisada-06.jpg';
import cafesTerraza from '../assets/fotos/restaurante-marcos-jatetxea-vertical-07.jpg';
import espaguetis from '../assets/fotos/restaurante-marcos-jatetxea-apaisada-08.jpg';
import berza from '../assets/fotos/restaurante-marcos-jatetxea-apaisada-09.jpg';
import flan from '../assets/fotos/restaurante-marcos-jatetxea-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Restaurante Marcos Jatetxea, en Ugaldetxo (20180 Oiartzun). Menú del día de 12 € con primero, segundo y postre, pintxos, raciones y bocadillos. Abre a las 7:30. Tel. 943 49 43 90.';

const galeria = [
	{
		src: berza,
		alt: 'Berza con patatas y zanahoria en un plato de Restaurante Marcos Jatetxea',
	},
	{ src: filetes, alt: 'Dos filetes empanados con patatas fritas en un plato' },
	{
		src: menuDia,
		alt: 'Hoja del menú del día de Marcos Jatetxea con primeros, segundos y postre por 12 euros',
	},
	{ src: espaguetis, alt: 'Espaguetis en salsa de tomate en un plato hondo' },
	{
		src: crema,
		alt: 'Postre de crema amarilla espolvoreado con cacao en un cuenco de cristal',
	},
	{ src: tortilla, alt: 'Porción de tortilla con un café con leche en la mesa' },
	{
		src: ensalada,
		alt: 'Ensalada mixta con atún, huevo y tomate, con cesta de pan y agua en la mesa',
	},
	{ src: flan, alt: 'Flan con nata y caramelo en un plato' },
	{
		src: cafesTerraza,
		alt: 'Dos cafés con sobre de azúcar y una onza de chocolate en la terraza',
	},
	{ src: cafe, alt: 'Café solo en vaso de cristal con sobre de azúcar Baqué' },
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#marcos`,
	name: BUSINESS.name,
	alternateName: ['Marcos Jatetxea', 'Restaurante Marcos', 'Marcos Oiartzun'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 943 49 43 90',
	currenciesAccepted: 'EUR',
	priceRange: '12 €',
	servesCuisine: ['Vasca', 'Española', 'Casera'],
	areaServed: [
		{ '@type': 'City', name: 'Oiartzun' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:30',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '07:30',
			closes: '15:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Trato excelente y familiar. pintxos,raciones ,menú.. todo muy bueno',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 4, bestRating: 5 },
			reviewBody: 'Excelente café,pinchos , bocadillos . variedad y precio de menú del día.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Trato agradable y camareras y camareros simpaticos y educafos',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Restaurante Marcos Jatetxea · Menú del día en Oiartzun';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#3a2f22" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Marcos Jatetxea, comer en Oiartzun, menú del día Oiartzun, restaurante Ugaldetxo, jatetxea Oiartzun, pintxos Oiartzun, menú del día barato Gipuzkoa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Restaurante Marcos Jatetxea · Menú del día en Oiartzun"
			ogDescription="Menú del día por 12 € en Marcos Jatetxea (Ugaldetxo, Oiartzun): primero, segundo y postre. Pintxos, raciones y bocadillos. Tel. 943 49 43 90."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Ensalada mixta con atún en la mesa de Restaurante Marcos Jatetxea"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#3a2f22"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34943494390"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[ensalada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="MARCOS JATETXEA"
			subtitle="Restaurante · Oiartzun"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Ugaldetxo · 20180 Oiartzun"
				title="Menú del día<br /><em>en Ugaldetxo.</em>"
				lede={`Marcos Jatetxea es un restaurante de menú del día en el barrio de Ugaldetxo, en Oiartzun (Gipuzkoa). El menú cuesta 12 euros e incluye un primero, un segundo y postre, según la hoja que aparece en su ficha de Google. Además tiene barra de pintxos, raciones y bocadillos. Abre a las 7:30 y cierra el domingo. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={ensalada}
				imageAlt="Ensalada mixta con atún, huevo y tomate, con cesta de pan y agua en la mesa"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)`,
					},
					{ label: 'Menú del día', html: 'Primero, segundo y postre · 12 €' },
					{ label: 'Horario', html: 'L–V 7:30–21:00 · Sáb 7:30–15:30' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Restaurante Marcos Jatetxea" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un menú de casa<br /><em>y una barra.</em>"
				paragraphs={[
					'Marcos Jatetxea está en el barrio de Ugaldetxo, en Oiartzun (Gipuzkoa). Google lo clasifica como restaurante y lo sitúa con el código plus 74W9+X9 Ugaldetxo, Elizalde; su ficha no publica una dirección con calle, así que lo más práctico para llegar es abrir «Cómo llegar» en el mapa.',
					'El menú del día aparece fotografiado en su perfil de Google: 12 euros con un primero, un segundo y postre. Entre los primeros hay lentejas con txorizo y morcilla, arroz negro con ali oli, berza con patatas, puré de verduras, ensalada de tomate con bonito, ensalada mixta, espárragos vinagreta y cogollos vinagreta.',
					'Los segundos son txuleta de cerdo, lomo asado relleno de ciruela, callos, gallo a la plancha, costilla de cerdo asada, pollo asado, filete de ternera, lomo a la plancha y pechuga de pollo, todos con patatas. En las fotos del perfil se ven también la berza, los espaguetis, los filetes empanados, la tortilla, el flan y la crema de postre.',
					'Google le da 4,4 sobre 5 con 87 reseñas. Las publicadas hablan de «trato excelente y familiar», de los pintxos, raciones y bocadillos y del «precio de menú del día».',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «Trato excelente y familiar. pintxos,raciones ,menú.. todo muy bueno».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="El menú del día,<br /><em>por 12 euros.</em>"
				description="Esta es la hoja del menú que aparece fotografiada en el perfil de Google: un primero de la lista, un segundo y postre, por 12 euros. La ficha no publica el resto de la carta ni el precio de los pintxos."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="El menú cambia a diario. Llama al 943 49 43 90 para saber el de hoy y si hace falta reservar. La ficha de Google no publica la carta de pintxos ni de raciones."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El menú,<br /><em>la mesa y la barra.</em>"
				description="Estas fotografías proceden del perfil de Restaurante Marcos Jatetxea en Google Maps: la hoja del menú del día, la berza, los espaguetis, los filetes empanados, la tortilla, la ensalada, los postres y los cafés."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`Ugaldetxo · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>a la mesa.</em>"
				addressLines={[
					'Barrio de Ugaldetxo',
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: de lunes a viernes de 7:30 a 21:00, sábado de 7:30 a 15:30 y domingo cerrado. Para grupos conviene llamar antes."
				mapTitle="Mapa de Restaurante Marcos Jatetxea en Ugaldetxo, Oiartzun (Gipuzkoa)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Marcos Jatetxea · Oiartzun"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 943 49 43 90. Google no publica una dirección con calle para esta ficha —da el código postal 20180 y el código plus 74W9+X9 Ugaldetxo, Elizalde—, así que lo más práctico es abrir «Cómo llegar». La ficha marca acceso para sillas de ruedas, asientos adaptados y aparcamiento adaptado."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`Ugaldetxo · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Marcos Jatetxea"
		/>
	</body>
</html>
