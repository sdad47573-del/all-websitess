---
import 'remixicon/fonts/remixicon.css';
import '../styles/index.css';
import { BUSINESS, SCHEMA } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	path?: string;
	keywords?: string;
	schema?: unknown[];
}

const {
	title = 'Frutería y Congelados Teatinos | Fruta fresca en Málaga',
	description = `Frutería y congelados en Calle Béla Bartók, Teatinos, Málaga. Fruta, verduras y congelados para tu compra diaria. Tel. ${BUSINESS.phoneDisplay}.`,
	path = '/',
	keywords = 'frutería Teatinos, fruta fresca Málaga, verduras Teatinos, congelados Málaga, Frutería y Congelados Teatinos, Calle Béla Bartók',
	schema = [],
} = Astro.props;

const canonical = new URL(path, BUSINESS.siteUrl).toString();
const socialImage = new URL('/social-card.svg', BUSINESS.siteUrl).toString();
---

<!doctype html>
<html lang="es" data-theme="teatinos-fruta">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={BUSINESS.name} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#28613e" />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={BUSINESS.name} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${BUSINESS.name}, frutería en Teatinos, Málaga`} />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:street-address" content={BUSINESS.street} />
		<meta property="og:locality" content={BUSINESS.city} />
		<meta property="og:region" content={BUSINESS.region} />
		<meta property="og:postal-code" content={BUSINESS.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content="+34 660 63 65 88" />
		<meta property="place:location:latitude" content={String(BUSINESS.geo.lat)} />
		<meta property="place:location:longitude" content={String(BUSINESS.geo.lng)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<meta name="geo.region" content="ES-AN" />
		<meta name="geo.placename" content={BUSINESS.city} />
		<meta name="geo.position" content={`${BUSINESS.geo.lat};${BUSINESS.geo.lng}`} />
		<meta name="ICBM" content={`${BUSINESS.geo.lat}, ${BUSINESS.geo.lng}`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Outfit:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		{
			[{ ...SCHEMA, image: socialImage }, ...schema].map((block) => (
				<script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
			))
		}
	</head>
	<body class="bg-base-100 text-base-content font-sans antialiased">
		<slot />
	</body>
</html>
