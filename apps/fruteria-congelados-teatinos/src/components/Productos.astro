---
import { BUSINESS, PRODUCTOS } from '../data/site';
---

<section id="productos" class="bg-base-200 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase"
				>Qué encontrarás</span
			>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">
				Productos para llenar tu cesta
			</h2>
			<div class="fresh-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/70 mt-6 leading-relaxed">
				Fruta, verduras y congelados en Teatinos. La selección cambia según temporada y
				disponibilidad; contacta para consultar algún producto concreto.
			</p>
		</div>
		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{
				PRODUCTOS.map((product) => (
					<article class="rounded-box border-base-300 bg-base-100 group border p-6 transition-shadow hover:shadow-lg">
						<>
							<span class="bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-content flex size-12 items-center justify-center rounded-xl transition-colors">
								<i class={`${product.icon} text-2xl`} />
							</span>
							<h3 class="font-display mt-5 text-xl font-bold">{product.title}</h3>
							<p class="text-base-content/65 mt-2 text-sm leading-relaxed">{product.text}</p>
						</>
					</article>
				))
			}
		</div>
		<div class="border-base-300 bg-base-100 rounded-box mt-12 border p-7 text-center sm:p-9">
			<h3 class="font-display text-2xl font-bold">¿Buscas algo en particular?</h3><p
				class="text-base-content/70 mx-auto mt-3 max-w-xl text-sm leading-relaxed"
			>
				Llama a {BUSINESS.name} y consulta disponibilidad antes de acercarte.
			</p><a href={BUSINESS.phoneHref} class="btn btn-secondary mt-5 gap-2 rounded-full"
				><i class="ri-phone-line"></i>Llamar al {BUSINESS.phoneDisplay}</a
			>
		</div>
	</div>
</section>
