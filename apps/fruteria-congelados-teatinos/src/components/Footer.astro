---
import { BUSINESS, NAV } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-neutral text-neutral-content">
	<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
			<div class="lg:col-span-2">
				<a href="/#inicio" class="flex items-center gap-3"
					><span class="bg-primary flex size-11 items-center justify-center rounded-xl"
						><i class="ri-apple-fill text-xl text-white"></i></span
					><span
						><span class="font-display block text-xl font-bold text-white">{BUSINESS.name}</span
						><span class="text-xs tracking-[0.2em] text-white/50 uppercase">Teatinos · Málaga</span
						></span
					></a
				><p class="mt-5 max-w-md text-sm leading-relaxed text-white/70">{BUSINESS.summary}</p><div
					class="mt-5 flex gap-3"
				>
					<a
						href={BUSINESS.facebook}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Facebook"
						class="hover:bg-primary flex size-10 items-center justify-center rounded-full bg-white/10"
						><i class="ri-facebook-circle-line text-lg"></i></a
					><a
						href={BUSINESS.instagram}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Instagram"
						class="hover:bg-primary flex size-10 items-center justify-center rounded-full bg-white/10"
						><i class="ri-instagram-line text-lg"></i></a
					>
				</div>
			</div>
			<div>
				<h2 class="font-display text-lg font-semibold text-white">Secciones</h2><ul
					class="mt-4 space-y-2 text-sm text-white/70"
				>
					{
						NAV.map((item) => (
							<li>
								<a href={`/${item.href}`} class="hover:text-secondary">
									{item.label}
								</a>
							</li>
						))
					}<li><a href="/contacto" class="hover:text-secondary">Contacto</a></li><li>
						<a href="/aviso-legal" class="hover:text-secondary">Aviso legal y privacidad</a> <a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a> 
					</li>
				</ul>
			</div>
			<div>
				<h2 class="font-display text-lg font-semibold text-white">Contacto</h2><address
					class="mt-4 space-y-3 text-sm text-white/70 not-italic"
				>
					<p>
						{BUSINESS.street}<br />{BUSINESS.postalCode}
						{BUSINESS.district}<br />{BUSINESS.city}
					</p><p>
						<a href={BUSINESS.phoneHref} class="hover:text-secondary">{BUSINESS.phoneDisplay}</a>
					</p><p>
						<a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="hover:text-secondary">Ver ubicación en Google Maps</a
						>
					</p>
				</address>
			</div>
		</div>
		<div
			class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-6 text-xs text-white/50 sm:flex-row"
		>
			<p>© {year} {BUSINESS.name}.</p><a href="/aviso-legal" class="hover:text-secondary"
				>Aviso legal y privacidad</a
			>
		</div>
	</div>

			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
</footer>
