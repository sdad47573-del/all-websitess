---
const highlights = [
	{ icon: 'ri-leaf-line', title: 'Fruta fresca', text: 'Compra diaria y de temporada' },
	{ icon: 'ri-plant-line', title: 'Verduras', text: 'Para tus recetas de cada día' },
	{ icon: 'ri-snowflake-line', title: 'Congelados', text: 'Variedad para tener a mano' },
	{ icon: 'ri-map-pin-line', title: 'En Teatinos', text: 'Calle Béla Bartók, Málaga' },
];
---

<section class="border-base-300 bg-base-200 border-b py-8">
	<div class="mx-auto grid max-w-7xl gap-6 px-4 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">
		{
			highlights.map((item) => (
				<div class="flex items-center gap-4">
					<>
						<span class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl">
							<i class={`${item.icon} text-xl`} />
						</span>
						<div>
							<>
								<h2 class="font-display font-bold">{item.title}</h2>
								<p class="text-base-content/60 mt-1 text-xs">{item.text}</p>
							</>
						</div>
					</>
				</div>
			))
		}
	</div>
</section>
