---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import alitas from '../assets/fotos/restaurant-fiesta-manila-alitas.jpg';
import fachada from '../assets/fotos/restaurant-fiesta-manila-fachada.jpg';
import arrozCerdo from '../assets/fotos/restaurant-fiesta-manila-arroz-cerdo.jpg';
import siomai from '../assets/fotos/restaurant-fiesta-manila-siomai.jpg';
import arrozPollo from '../assets/fotos/restaurant-fiesta-manila-arroz-pollo.jpg';
import edamame from '../assets/fotos/restaurant-fiesta-manila-edamame.jpg';
import curry from '../assets/fotos/restaurant-fiesta-manila-curry.jpg';
import fideosVerdura from '../assets/fotos/restaurant-fiesta-manila-fideos-verdura.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Fiesta Manila · Restaurante filipino en Encamp (Andorra)';
const description =
	'Restaurant Fiesta Manila, Av. de Joan Martí, 98 (AD200 Encamp). Cocina filipina para compartir: arroces, fideos, pollo, cerdo y entrantes. 4,8 sobre 5 con 526 reseñas. Martes cerrado.';

const galeria = [
	{
		src: fachada,
		alt: 'Entrada de Fiesta Manila con el rótulo del restaurante y las mesas de la terraza',
	},
	{
		src: arrozCerdo,
		alt: 'Arroz blanco con cerdo guisado y un huevo frito encima',
	},
	{
		src: siomai,
		alt: 'Cuatro siomai con salsa oscura en una cesta de bambú',
	},
	{
		src: arrozPollo,
		alt: 'Arroz salteado con pollo a la plancha y cebolleta en un plato blanco',
	},
	{
		src: edamame,
		alt: 'Vainas de edamame y rollitos fritos con un cuenco de salsa dulce',
	},
	{
		src: curry,
		alt: 'Curry filipino con ternera, pimiento y patata, con arroz blanco al lado',
	},
	{
		src: fideosVerdura,
		alt: 'Fideos de cristal salteados con calabacín, shitake y zanahoria',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Los platos de Fiesta Manila',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	acceptsReservations: true,
	'@id': `${BUSINESS.siteUrl}/#fiesta-manila`,
	name: BUSINESS.fullName,
	alternateName: ['Fiesta Manila', 'Fiesta Manila Encamp', 'Restaurant Fiesta Manila Andorra'],
	description:
		'Restaurante filipino en Encamp (Andorra): arroces, fideos, pollo y cerdo guisados, siomai y entrantes para compartir, en un comedor amplio.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376851129',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Filipina', 'Asiática'],
	petsAllowed: true,
	areaServed: [
		{ '@type': 'City', name: 'Encamp' },
		{ '@type': 'AdministrativeArea', name: 'Andorra' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '22:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurant-fiesta-manila-alitas.jpg": alitas,
	"restaurant-fiesta-manila-fachada.jpg": fachada,
	"restaurant-fiesta-manila-arroz-cerdo.jpg": arrozCerdo,
	"restaurant-fiesta-manila-siomai.jpg": siomai,
	"restaurant-fiesta-manila-arroz-pollo.jpg": arrozPollo,
	"restaurant-fiesta-manila-edamame.jpg": edamame,
	"restaurant-fiesta-manila-curry.jpg": curry,
	"restaurant-fiesta-manila-fideos-verdura.jpg": fideosVerdura,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#173330" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Fiesta Manila Andorra, restaurante filipino Encamp, comida filipina Andorra, restaurante asiático Encamp, Joan Martí 98 Encamp, comida para compartir Andorra"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina filipina para compartir en Encamp: arroces, fideos, guisos y entrantes. 4,8 en Google con 526 reseñas. Martes cerrado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Arroz salteado con pollo de Fiesta Manila"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#173330"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-02"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[alitas]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Fiesta Manila"
			subtitle="Restaurante filipino · Encamp"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma carta, precios y horario antes de ir."
			ctaLabel="Llamar a Fiesta Manila"
			navAriaLabel="Enlaces de Fiesta Manila"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
