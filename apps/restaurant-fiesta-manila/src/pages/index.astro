---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import alitas from '../assets/fotos/restaurant-fiesta-manila-alitas.jpg';
import fachada from '../assets/fotos/restaurant-fiesta-manila-fachada.jpg';
import arrozCerdo from '../assets/fotos/restaurant-fiesta-manila-arroz-cerdo.jpg';
import siomai from '../assets/fotos/restaurant-fiesta-manila-siomai.jpg';
import arrozPollo from '../assets/fotos/restaurant-fiesta-manila-arroz-pollo.jpg';
import edamame from '../assets/fotos/restaurant-fiesta-manila-edamame.jpg';
import curry from '../assets/fotos/restaurant-fiesta-manila-curry.jpg';
import fideosVerdura from '../assets/fotos/restaurant-fiesta-manila-fideos-verdura.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Fiesta Manila · Restaurante filipino en Encamp (Andorra)';
const description =
	'Restaurant Fiesta Manila, Av. de Joan Martí, 98 (AD200 Encamp). Cocina filipina para compartir: arroces, fideos, pollo, cerdo y entrantes. 4,8 sobre 5 con 526 reseñas. Martes cerrado.';

const galeria = [
	{
		src: fachada,
		alt: 'Entrada de Fiesta Manila con el rótulo del restaurante y las mesas de la terraza',
	},
	{
		src: arrozCerdo,
		alt: 'Arroz blanco con cerdo guisado y un huevo frito encima',
	},
	{
		src: siomai,
		alt: 'Cuatro siomai con salsa oscura en una cesta de bambú',
	},
	{
		src: arrozPollo,
		alt: 'Arroz salteado con pollo a la plancha y cebolleta en un plato blanco',
	},
	{
		src: edamame,
		alt: 'Vainas de edamame y rollitos fritos con un cuenco de salsa dulce',
	},
	{
		src: curry,
		alt: 'Curry filipino con ternera, pimiento y patata, con arroz blanco al lado',
	},
	{
		src: fideosVerdura,
		alt: 'Fideos de cristal salteados con calabacín, shitake y zanahoria',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Los platos de Fiesta Manila',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#fiesta-manila`,
	name: BUSINESS.fullName,
	alternateName: ['Fiesta Manila', 'Fiesta Manila Encamp', 'Restaurant Fiesta Manila Andorra'],
	description:
		'Restaurante filipino en Encamp (Andorra): arroces, fideos, pollo y cerdo guisados, siomai y entrantes para compartir, en un comedor amplio.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376851129',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Filipina', 'Asiática'],
	petsAllowed: true,
	areaServed: [
		{ '@type': 'City', name: 'Encamp' },
		{ '@type': 'AdministrativeArea', name: 'Andorra' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '22:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#173330" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Fiesta Manila Andorra, restaurante filipino Encamp, comida filipina Andorra, restaurante asiático Encamp, Joan Martí 98 Encamp, comida para compartir Andorra"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina filipina para compartir en Encamp: arroces, fideos, guisos y entrantes. 4,8 en Google con 526 reseñas. Martes cerrado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Arroz salteado con pollo de Fiesta Manila"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#173330"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-02"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[alitas]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Fiesta Manila"
			subtitle="Restaurante filipino · Encamp"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. de Joan Martí, 98 · Encamp"
				title="Filipino, <br /><em>para compartir.</em>"
				lede={`Fiesta Manila es el restaurante filipino de Encamp: arroces, fideos, guisos de pollo y cerdo, siomai y entrantes fritos que se ponen en el centro de la mesa. Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas, una de las fichas más sólidas de la parroquia. Abre de 12:30 a 16:00 y de 20:00 a 22:30; el martes cierra.`}
				image={alitas}
				imageAlt="Alitas de pollo glaseadas con sésamo de Fiesta Manila"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>12:30–16:00</b> · y 20:00–22:30' },
					{ label: 'Cocina', html: '<b>Filipina</b> · para compartir' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Asiàtic i Mediterrani"
			/>

			<LocalChips label="Lo que ofrece Fiesta Manila" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Joan Martí, 98. <br /><em>Encamp.</em>"
				paragraphs={[
					'Fiesta Manila está en el número 98 de la Avenida de Joan Martí, en Encamp, en la planta baja de un edificio de piedra. La ficha de Google lo sitúa en las coordenadas 42.5323732, 1.5741895. El teléfono es un fijo andorrano, el +376 851 129.',
					'En la fachada hay dos rótulos: el del restaurante, con el nombre y la leyenda «Restaurant Asiàtic i Mediterrani», y otro en la puerta que dice «Fiesta Manila. Filipino». La ficha de Google lo clasifica como restaurante filipino, y la carta de las fotos es asiática: arroces, fideos, guisos y entrantes.',
					'La forma de comer es filipina: se piden varios platos y se comparten. En las fotos del perfil aparecen alitas glaseadas con sésamo, siomai al vapor con salsa, arroz blanco con cerdo guisado y huevo frito, arroz salteado con pollo, fideos de cristal con shitake y calabacín, curry con ternera y patata, y edamame con rollitos.',
					`Google recoge además dos atributos útiles: se admiten perros y el negocio es amigable con la comunidad LGBTQ+. Con ${RATING.count} reseñas y una media de ${RATING.label} sobre 5 (noviembre de 2026), es una de las mesas mejor valoradas de Encamp.`,
				]}
				note="La ficha no publica carta ni precios, y en las fotos del perfil no aparece la carta impresa. Los platos que se citan son los que se ven en esas fotos; los nombres exactos y los importes se confirman en el local."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> La mesa</p>
					<h2 id="highlights-title">Platos al centro, <br /><em>como en Manila.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Arroces, guisos <br /><em>y entrantes.</em>"
				description="Una selección de lo que aparece en las fotos del perfil, en cuatro bloques. No es la carta completa: la ficha no la publica y cambia con el día."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note={`Para reservar o preguntar por la carta y el menú, el teléfono es el ${BUSINESS.phone}. Los precios no se copian aquí porque la ficha no los publica.`}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La mesa filipina <br /><em>de Encamp.</em>"
				description="Siete fotografías del perfil de Fiesta Manila: la entrada con la terraza, el arroz con cerdo y huevo, los siomai al vapor, el arroz con pollo, el edamame con rollitos, el curry con arroz y los fideos de cristal con verduras."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,8 sobre 5, <em>con 526 reseñas.</em></h2>
						<p>
							Una ficha con recorrido: más de quinientas opiniones y una media de 4,8. El local se
							clasifica como restaurante filipino y la ficha marca que admite perros y que es
							amigable con la comunidad LGBTQ+.
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer todas las reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,8</strong>
						<span>★★★★★</span>
						<small>526 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la avenida <br /><em>de Encamp.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city} (parroquia de Encamp)`,
					'Principado de Andorra',
				]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de 12:30 a 16:00 y de 20:00 a 22:30 todos los días, con el martes cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Fiesta Manila en la Avenida de Joan Martí, Encamp"
				mapEmbedUrl={MAPS.embed}
				mapLabel={`${BUSINESS.street} · Encamp`}
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote={`Se reserva por teléfono, en el ${BUSINESS.phone}: el local no tiene web propia ni reservas online. La ficha no da datos de aparcamiento propio; al estar en la avenida de Encamp, lo habitual es aparcar en la calle o en los aparcamientos del pueblo.`}
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma carta, precios y horario antes de ir."
			ctaLabel="Llamar a Fiesta Manila"
			navAriaLabel="Enlaces de Fiesta Manila"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
