---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/restaurante-bar-tolosa-apaisada-01.jpg';
import pollo from '../assets/fotos/restaurante-bar-tolosa-apaisada-02.jpg';
import fachadaDetalle from '../assets/fotos/restaurante-bar-tolosa-apaisada-03.jpg';
import fachada from '../assets/fotos/restaurante-bar-tolosa-vertical-04.jpg';
import arroz from '../assets/fotos/restaurante-bar-tolosa-apaisada-05.jpg';
import garbanzos from '../assets/fotos/restaurante-bar-tolosa-vertical-06.jpg';
import alubias from '../assets/fotos/restaurante-bar-tolosa-vertical-07.jpg';
import merluza from '../assets/fotos/restaurante-bar-tolosa-vertical-08.jpg';
import entrecot from '../assets/fotos/restaurante-bar-tolosa-vertical-09.jpg';
import ensalada from '../assets/fotos/restaurante-bar-tolosa-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Restaurante Bar Tolosa, bar restaurante en Paseo Doctor José Begiristain, 90, Donostia. Pintxos, raciones y platos combinados, con 4,3 sobre 5 en Google. Teléfono 943 45 93 97.';

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de Restaurante Bar Tolosa con paredes rojas, manteles blancos y sillas de madera',
	},
	{
		src: pollo,
		alt: 'Pollo asado con puré de patata en un plato blanco',
	},
	{
		src: fachadaDetalle,
		alt: 'Fachada de piedra de Taberna Tolosa con el cartel de Borda 1929 Berri y flores rojas',
	},
	{
		src: fachada,
		alt: 'Fachada de Taberna Tolosa Jatetxea con el toldo y la terraza',
	},
	{
		src: arroz,
		alt: 'Arroz con marisco, mejillones y carne en un plato hondo',
	},
	{
		src: garbanzos,
		alt: 'Potaje de garbanzos con chorizo junto a una jarra de vino',
	},
	{
		src: alubias,
		alt: 'Potaje de alubias rojas con chorizo, guindillas y pan',
	},
	{
		src: merluza,
		alt: 'Merluza con guisantes y patatas en una fuente de loza',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la plancha con patatas fritas',
	},
	{
		src: ensalada,
		alt: 'Ensalada mixta con atún, huevo, tomate y maíz',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#tolosa`,
	name: BUSINESS.name,
	alternateName: ['Bar Tolosa', 'Taberna Tolosa', 'Tolosa Jatetxea', 'Restaurante Tolosa Donostia'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: `+34 ${BUSINESS.phone}`,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina casera', 'Platos combinados'],
	areaServed: [
		{ '@type': 'City', name: 'Donostia / San Sebastián' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '18:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '10:00',
			closes: '18:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La barra', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Restaurante Bar Tolosa · Cocina casera en Donostia';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#6b1f2a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700&family=Gloock&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Bar Tolosa, Bar Tolosa Donostia, Taberna Tolosa, comer en Donostia, pintxos Donostia, platos combinados Donostia, Paseo Doctor José Begiristain, Tolosa Jatetxea"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Bar restaurante en Paseo Doctor José Begiristain, 90 (Donostia). Pintxos, raciones y platos combinados, con 4,3 sobre 5 en Google. Teléfono 943 45 93 97."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Comedor de Restaurante Bar Tolosa con paredes rojas y manteles blancos"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#6b1f2a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Donostia / San Sebastián"
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Bar Tolosa"
			subtitle="Restaurante · Donostia"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Paseo Doctor José Begiristain, 90 · Donostia"
				title="Comida casera <br /><em>de siempre.</em>"
				lede={`Restaurante Bar Tolosa está en Paseo Doctor José Begiristain, 90, en Donostia. Un bar restaurante de comedor clásico, con pintxos, raciones y platos combinados, 4,3 sobre 5 en Google y 1.029 reseñas. Abre de lunes a sábado y cierra los domingos: para venir, llama al ${BUSINESS.phone}.`}
				image={comedor}
				imageAlt="Comedor de Restaurante Bar Tolosa con paredes rojas, manteles blancos y sillas de madera"
				primaryCta={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,3</b> en Google · 1.029 reseñas' },
					{ label: 'La casa', html: '<b>Pintxos</b> y platos combinados' },
					{ label: 'Horario', html: '<b>Domingo</b> cerrado' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Restaurante Bar Tolosa" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un comedor <br /><em>de toda la vida.</em>"
				paragraphs={[
					'Restaurante Bar Tolosa está en Paseo Doctor José Begiristain, 90, en Donostia: un bar restaurante con comedor de paredes rojas, manteles blancos, sillas de madera y lámparas de latón, en un edificio de piedra con el rótulo Taberna Tolosa Jatetxea.',
					'Google lo clasifica como restaurante y le da 4,3 sobre 5 con 1.029 reseñas. Su ficha publica teléfono y horario, pero no carta, precios, correo ni web propia, así que esta web no inventa nada de eso.',
					'Sus reseñas hablan de «comida casera muy rica» y de unas camareras «atentas y muy simpáticas». También citan pintxos, bocadillos, raciones, ensaladas, platos combinados y postres, con «el precio asequible».',
					'Abre de lunes a viernes de 9:00 a 18:30 y el sábado de 10:00 a 18:30. Los domingos cierra.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount.toLocaleString('es-ES')} opiniones en Google. Una reseña lo resume así: «Los pinchos y los bocadillos, super sabrosos y el precio asequible».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La barra"
				title="Pintxos, raciones <br /><em>y platos combinados.</em>"
				description="La ficha de Google no publica carta ni precios y el local no tiene web propia. Esto es lo que citan sus reseñas."
				cta={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados ni carta en la ficha. Para saber qué hay hoy, lo más directo es llamar al 943 45 93 97."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Diez fotos <br /><em>de la casa.</em>"
				description="Las diez fotografías publicadas en el perfil de Restaurante Bar Tolosa en Google Maps: el comedor, la fachada y sus platos."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a Donostia <br /><em>a comer casero.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, `${BUSINESS.regionName}, España`]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario de la ficha de Google: de lunes a viernes de 9:00 a 18:30; el sábado de 10:00 a 18:30. Los domingos cierra."
				mapTitle="Mapa de Restaurante Bar Tolosa en Paseo Doctor José Begiristain, 90, Donostia"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Restaurante Bar Tolosa · Donostia"
				mapHref={MAPS.cid}
				links={[
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref, variant: 'primary' },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="El teléfono 943 45 93 97 es el único canal de contacto que publica la ficha de Google: no hay correo ni web propia. La ficha marca acceso, asientos, aseo y aparcamiento adaptados."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Bar Tolosa"
		/>
	</body>
</html>
