---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import comedor from '../assets/fotos/restaurante-bar-tolosa-apaisada-01.jpg';
import pollo from '../assets/fotos/restaurante-bar-tolosa-apaisada-02.jpg';
import fachadaDetalle from '../assets/fotos/restaurante-bar-tolosa-apaisada-03.jpg';
import fachada from '../assets/fotos/restaurante-bar-tolosa-vertical-04.jpg';
import arroz from '../assets/fotos/restaurante-bar-tolosa-apaisada-05.jpg';
import garbanzos from '../assets/fotos/restaurante-bar-tolosa-vertical-06.jpg';
import alubias from '../assets/fotos/restaurante-bar-tolosa-vertical-07.jpg';
import merluza from '../assets/fotos/restaurante-bar-tolosa-vertical-08.jpg';
import entrecot from '../assets/fotos/restaurante-bar-tolosa-vertical-09.jpg';
import ensalada from '../assets/fotos/restaurante-bar-tolosa-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Restaurante Bar Tolosa, bar restaurante en Paseo Doctor José Begiristain, 90, Donostia. Pintxos, raciones y platos combinados, con 4,3 sobre 5 en Google. Teléfono 943 45 93 97.';

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de Restaurante Bar Tolosa con paredes rojas, manteles blancos y sillas de madera',
	},
	{
		src: pollo,
		alt: 'Pollo asado con puré de patata en un plato blanco',
	},
	{
		src: fachadaDetalle,
		alt: 'Fachada de piedra de Taberna Tolosa con el cartel de Borda 1929 Berri y flores rojas',
	},
	{
		src: fachada,
		alt: 'Fachada de Taberna Tolosa Jatetxea con el toldo y la terraza',
	},
	{
		src: arroz,
		alt: 'Arroz con marisco, mejillones y carne en un plato hondo',
	},
	{
		src: garbanzos,
		alt: 'Potaje de garbanzos con chorizo junto a una jarra de vino',
	},
	{
		src: alubias,
		alt: 'Potaje de alubias rojas con chorizo, guindillas y pan',
	},
	{
		src: merluza,
		alt: 'Merluza con guisantes y patatas en una fuente de loza',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la plancha con patatas fritas',
	},
	{
		src: ensalada,
		alt: 'Ensalada mixta con atún, huevo, tomate y maíz',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#tolosa`,
	name: BUSINESS.name,
	alternateName: ['Bar Tolosa', 'Taberna Tolosa', 'Tolosa Jatetxea', 'Restaurante Tolosa Donostia'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: `+34 ${BUSINESS.phone}`,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina casera', 'Platos combinados'],
	areaServed: [
		{ '@type': 'City', name: 'Donostia / San Sebastián' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '18:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '10:00',
			closes: '18:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La barra', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Restaurante Bar Tolosa · Cocina casera en Donostia';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-bar-tolosa-apaisada-01.jpg": comedor,
	"restaurante-bar-tolosa-apaisada-02.jpg": pollo,
	"restaurante-bar-tolosa-apaisada-03.jpg": fachadaDetalle,
	"restaurante-bar-tolosa-vertical-04.jpg": fachada,
	"restaurante-bar-tolosa-apaisada-05.jpg": arroz,
	"restaurante-bar-tolosa-vertical-06.jpg": garbanzos,
	"restaurante-bar-tolosa-vertical-07.jpg": alubias,
	"restaurante-bar-tolosa-vertical-08.jpg": merluza,
	"restaurante-bar-tolosa-vertical-09.jpg": entrecot,
	"restaurante-bar-tolosa-apaisada-10.jpg": ensalada,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#6b1f2a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700&family=Gloock&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Bar Tolosa, Bar Tolosa Donostia, Taberna Tolosa, comer en Donostia, pintxos Donostia, platos combinados Donostia, Paseo Doctor José Begiristain, Tolosa Jatetxea"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Bar restaurante en Paseo Doctor José Begiristain, 90 (Donostia). Pintxos, raciones y platos combinados, con 4,3 sobre 5 en Google. Teléfono 943 45 93 97."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Comedor de Restaurante Bar Tolosa con paredes rojas y manteles blancos"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#6b1f2a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Donostia / San Sebastián"
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Bar Tolosa"
			subtitle="Restaurante · Donostia"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Bar Tolosa"
		/>
	</body>
</html>
