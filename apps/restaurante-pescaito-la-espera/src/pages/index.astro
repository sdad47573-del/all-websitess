---
const business = {
	name: 'Restaurante Pescaíto La Espera',
	street: 'Plaza Nueva, Cuesta de Gomérez, 1',
	city: 'Granada',
	region: 'Granada',
	postalCode: '18009',
	country: 'ES',
	phone: '+34 958 06 90 12',
	latitude: 37.1766818,
	longitude: -3.5957706,
	site: 'https://restaurante-pescaito-la-espera-granada.vercel.app',
};

const mapsUrl = 'https://www.google.com/maps/place/Restaurante:+Pesca%C3%ADto+La+Espera/@37.1766818,-3.5957706,17z/data=!3m1!4b1!4m6!3m5!1s0xd71fcb8c885855f:0x558b8d84ac5135e8!8m2!3d37.1766818!4d-3.5957706!16s%2Fg%2F11bx1s0sk5?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34958069012';
const siteUrl = `${business.site}/`;
const description = 'Pescaíto La Espera en Plaza Nueva, Granada: tapas, pescado y raciones para compartir junto a Cuesta de Gomérez. Consulta ubicación, teléfono, fotos y reseñas en Google Maps.';

const faqs = [
	{
		question: '¿Dónde está Pescaíto La Espera?',
		answer: 'El restaurante figura en Plaza Nueva, Cuesta de Gomérez, 1, 18009 Granada. Desde esta página puedes abrir Google Maps y consultar la ruta hasta el local.',
	},
	{
		question: '¿Cuál es el teléfono del restaurante?',
		answer: 'El teléfono publicado para Pescaíto La Espera es el 958 06 90 12. Llama para consultar disponibilidad, reservas, horario del día y platos actuales.',
	},
	{
		question: '¿Qué tipo de comida ofrece?',
		answer: 'Las fuentes públicas lo describen como un bar con tapas y raciones, y su nombre hace referencia a su propuesta de pescaíto. Consulta la carta, los platos disponibles y los alérgenos directamente con el establecimiento.',
	},
	{
		question: '¿Cuál es el horario de apertura?',
		answer: 'Los horarios disponibles en directorios públicos pueden variar. Comprueba el horario actualizado en Google Maps o llama al 958 06 90 12 antes de desplazarte.',
	},
	{
		question: '¿Dónde puedo ver fotos y reseñas?',
		answer: 'Abre la ficha de Pescaíto La Espera en Google Maps desde el botón de esta página para ver fotos, reseñas y otros datos publicados en la ficha.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${siteUrl}#restaurant`,
	name: business.name,
	description,
	url: siteUrl,
	telephone: business.phone,
	servesCuisine: ['Pescado', 'Tapas', 'Cocina española'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: business.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

import Galeria from '../components/Galeria.astro';---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#173744" />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" />
		<title>Pescaíto La Espera en Granada | Tapas y pescado en Plaza Nueva</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Pescaíto La Espera · Tapas en Plaza Nueva, Granada" />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${business.site}/og.svg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Restaurante Pescaíto La Espera en Plaza Nueva, Granada" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.region" content="ES-GR" />
		<meta name="geo.placename" content="Granada" />
		<meta name="geo.position" content="37.1766818;-3.5957706" />
		<meta name="ICBM" content="37.1766818, -3.5957706" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Pescaíto La Espera, inicio"><span class="brand-mark" aria-hidden="true">E</span><span>La Espera<small>Pescaíto · Granada</small></span></a>
			<nav aria-label="Navegación principal"><a href="#restaurante">El restaurante</a><a href="#fotos">Fotos</a><a href="#visita">Cómo llegar</a></nav>
			<a class="header-call" href={phoneHref}>Llamar · 958 06 90 12</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span>Plaza Nueva · Granada</span><i aria-hidden="true"></i> Centro histórico</p>
					<h1>Una pausa con<br /><em>sabor a mar.</em></h1>
					<p class="lede">Pescaíto La Espera te espera junto a Plaza Nueva y Cuesta de Gomérez. Un bar en pleno centro de Granada para disfrutar de tapas y raciones; consulta la carta del día y organiza tu visita directamente con el restaurante.</p>
					<div class="actions"><a class="button button-gold" href={phoneHref}>Llamar al restaurante <span aria-hidden="true">↗</span></a><a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-details"><span>⌖ Plaza Nueva, Cuesta de Gomérez, 1</span><span>✦ Tapas · pescado · raciones</span></div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración original de una mesa de pescado y tapas cerca del centro histórico de Granada">
					<div class="sun"></div><div class="skyline skyline-back"></div><div class="tower"><span></span><i></i></div><div class="skyline skyline-front"></div><div class="arch"><span></span></div><div class="table"></div><div class="table-top"></div><div class="plate"><span class="fish fish-one"></span><span class="fish fish-two"></span><span class="lemon"></span><span class="greens"></span></div><div class="glass"><span></span></div><div class="art-label">Granada<br /><b>tapeo sin prisa</b></div><span class="sparkle sparkle-one">✦</span><span class="sparkle sparkle-two">✧</span>
				</div>
			</section>

			<div class="ticker" aria-label="Restaurante Pescaíto La Espera en Granada"><span>Pescaíto La Espera</span><b>✳</b><span>Tapas y raciones</span><b>✳</b><span>Plaza Nueva · Granada</span><b>✳</b><span>Centro histórico</span></div>

			<section class="intro section-wrap" id="restaurante"><div><p class="eyebrow eyebrow-dark">En el corazón de Granada</p><h2>Buen tapeo<br /><em>en Plaza Nueva.</em></h2></div><div class="intro-copy"><p>Restaurante Pescaíto La Espera está en Plaza Nueva, en la Cuesta de Gomérez, a pocos pasos de las calles del centro histórico granadino. Las fichas públicas lo describen como un bar de tapas y raciones con una propuesta centrada en el pescado.</p><p>La carta y el horario pueden cambiar. Llama para confirmar qué hay hoy, consultar opciones y preguntar por disponibilidad.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver ficha, fotos y reseñas en Google Maps ↗</a></div></section>

			<section class="specialties section-wrap" aria-labelledby="specialties-title"><div class="section-heading"><p class="eyebrow eyebrow-dark">Pide al centro y disfruta</p><h2 id="specialties-title">Un plan para<br /><em>abrir el apetito.</em></h2><p>Tapas, pescado y raciones en pleno centro. Consulta con el restaurante las especialidades disponibles y la carta actual.</p></div>
				<div class="special-grid">
					<article class="special-card"><span class="special-icon" aria-hidden="true">✦</span><span class="card-kicker">LA CASA</span><h3>Pescaíto</h3><p>Una propuesta de pescado para disfrutar en una parada de tapeo por Granada.</p></article>
					<article class="special-card card-blue"><span class="special-icon" aria-hidden="true">◉</span><span class="card-kicker">PARA COMPARTIR</span><h3>Tapas y raciones</h3><p>Platos para pedir al centro y compartir durante la comida o una salida por el centro.</p></article>
					<article class="special-card card-gold"><span class="special-icon" aria-hidden="true">♨</span><span class="card-kicker">CERCA DE TODO</span><h3>Una mesa en Plaza Nueva</h3><p>Haz una pausa en una zona céntrica y continúa descubriendo Granada a pie.</p></article>
				</div><p class="menu-note">Descripción orientativa basada en fichas públicas. Consulta ingredientes, alérgenos, disponibilidad y precios directamente con el establecimiento.</p>
			</section>

			<section class="photo-section" id="fotos"><div class="photo-copy"><p class="eyebrow">Pescaíto La Espera en Google Maps</p><h2>¿Quieres ver<br />sus <em>fotos?</em></h2><p>Abre la ficha para consultar las imágenes del restaurante, leer reseñas recientes y comprobar los datos actualizados en Google Maps.</p><a class="button button-gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a><p class="photo-note">Las fotos se consultan en la ficha de Google; no se descargan ni se alojan en esta web.</p></div>
				<div class="map-photo"><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Google de Restaurante Pescaíto La Espera en Plaza Nueva, Granada" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
					<noscript>
						<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
					</noscript>
				</div><a class="map-caption" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">⌖</span><span><b>Pescaíto La Espera</b><small>Plaza Nueva · Ver ficha y fotos ↗</small></span></a></div>
			</section>

			<section class="visit section-wrap" id="visita"><div class="visit-copy"><p class="eyebrow eyebrow-dark">Una dirección céntrica</p><h2>Nos vemos<br /><em>en Plaza Nueva.</em></h2><p>El local figura en la Cuesta de Gomérez, junto a Plaza Nueva. Abre indicaciones para planificar el camino y llama antes de ir para confirmar la apertura y la disponibilidad.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button button-dark" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Llamar · 958 06 90 12</a></div></div>
				<div class="visit-card"><div class="visit-title"><span class="visit-icon" aria-hidden="true">⌖</span><div><p class="eyebrow eyebrow-dark">Ubicación y contacto</p><h3>Granada centro</h3></div></div><dl><div><dt>Dirección</dt><dd>Plaza Nueva, Cuesta de Gomérez, 1<br />18009 Granada</dd></div><div><dt>Teléfono</dt><dd><a href={phoneHref}>958 06 90 12</a></dd></div><div><dt>Horario</dt><dd>Comprueba la ficha<br />o confirma por teléfono</dd></div></dl><p class="visit-note">Los datos de horario pueden variar. Llama antes de desplazarte para confirmar la apertura de hoy.</p><a class="visit-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Abrir ficha de Google Maps ↗</a></div>
			</section>

			<section class="faq-section section-wrap" id="preguntas"><p class="eyebrow eyebrow-dark">Preguntas frecuentes</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
			<Galeria nombre="Restaurante Pescaíto La Espera" mapsUrl={mapsUrl} />
		</main>

		<footer class="footer"><div class="footer-top"><a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">E</span><span>La Espera<small>Pescaíto · Granada</small></span></a><p>Tapas y pescado<br />en Plaza Nueva.</p><nav aria-label="Enlaces de Pescaíto La Espera"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={phoneHref}>958 06 90 12</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Restaurante Pescaíto La Espera · Granada</span><a href="/aviso-legal/">Aviso legal y privacidad</a> <a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a> <span>Confirma directamente horario, carta y disponibilidad.</span></div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar <span>958 06 90 12</span></a>
	</body>
</html>

<style is:global>
	:root{font-family:'DM Sans',sans-serif;color:#2e3940;background:#f6f2e8;font-synthesis:none;text-rendering:optimizeLegibility;--sea:#173744;--sea-light:#315d68;--gold:#e6b868;--cream:#f6f2e8;--ink:#2e3940;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid #e6b868;outline-offset:4px}.skip-link{position:absolute;z-index:99;top:-60px;left:16px;padding:12px 16px;background:var(--gold);color:var(--sea)}.skip-link:focus{top:12px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:22px;background:var(--sea);color:#fcf8ef}.brand{display:flex;align-items:center;gap:11px;font-size:15px;font-weight:700}.brand small{display:block;margin-top:4px;color:#d6e1de;font-size:9px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--gold);border-radius:50%;color:#f1d18d;font:700 23px var(--display)}.topbar nav{display:flex;gap:clamp(14px,2.5vw,32px);color:#e7efeb;font-size:12px}.topbar nav a:hover,.footer a:hover{color:#f1d18d}.header-call{padding:11px 17px;border:1px solid #ffffff55;border-radius:99px;font-size:11px;font-weight:700}.hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:560px;background:var(--sea);color:#fcf8ef;overflow:hidden}.hero-copy{padding:73px 4vw 64px 9vw;align-self:center}.eyebrow{margin:0 0 19px;color:#efce88;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase}.eyebrow i{display:inline-block;width:22px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.section-heading h2,.photo-copy h2,.visit h2,.faq-section h2{margin:0;font:600 clamp(39px,4.8vw,64px)/1.08 var(--display);letter-spacing:-1.2px}.hero h1 em,.intro h2 em,.section-heading h2 em,.photo-copy h2 em,.visit h2 em,.f