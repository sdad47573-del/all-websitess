---
import WhatsappFab from '../components/WhatsappFab.astro';
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/mister-rice-malaga.jpg';
import foto1 from '../assets/fotos/mister-rice-malaga-foto-1.jpg';
import foto2 from '../assets/fotos/mister-rice-malaga-foto-2.jpg';
import foto3 from '../assets/fotos/mister-rice-malaga-foto-3.jpg';
import foto4 from '../assets/fotos/mister-rice-malaga-foto-4.jpg';
import foto5 from '../assets/fotos/mister-rice-malaga-foto-5.jpg';
import foto6 from '../assets/fotos/mister-rice-malaga-foto-6.jpg';
import foto7 from '../assets/fotos/mister-rice-malaga-foto-7.jpg';
import foto8 from '../assets/fotos/mister-rice-malaga-foto-8.jpg';
import foto9 from '../assets/fotos/mister-rice-malaga-foto-9.jpg';
import foto10 from '../assets/fotos/mister-rice-malaga-foto-10.jpg';
import foto11 from '../assets/fotos/mister-rice-malaga-foto-11.jpg';
import foto12 from '../assets/fotos/mister-rice-malaga-foto-12.jpg';
import foto13 from '../assets/fotos/mister-rice-malaga-foto-13.jpg';
import foto14 from '../assets/fotos/mister-rice-malaga-foto-14.jpg';
import foto15 from '../assets/fotos/mister-rice-malaga-foto-15.jpg';

const business = {
	name: 'Restaurante Mister Rice',
	tagline: 'Cocina china en Teatinos',
	street: 'Av. de Lope de Vega, 19',
	district: 'Teatinos-Universidad',
	city: 'Málaga',
	postalCode: '29010',
	phone: '673 79 17 37',
	latitude: 36.730282,
	longitude: -4.4682278,
	plusCode: 'PGJJ+4P Málaga',
	site: 'https://mister-rice.vercel.app',
};

const cid = '0xd72f711d3ee1fb3:0xb07578f8bdb6f31f';
const placeId = 'ChIJsx_u0xH3cg0RH_O2vfh4dbA';

const mapsUrl = `https://www.google.com/maps/place/Restaurante+Mister+Rice/@${business.latitude},${business.longitude},17z/data=!3m1!4b1!4m6!3m5!1s${cid}!8m2!3d${business.latitude}!4d${business.longitude}!16s%2Fg%2F11sz3qnz4r`;
const cidUrl = `https://www.google.com/maps?cid=${cid}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&q=Restaurante+Mister+Rice&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34673791737';

const description =
	'Mister Rice, restaurante chino en Teatinos (Málaga): arroz tres delicias, pollo al limón, pollo con almendras y rollitos de primavera. Av. Lope de Vega 19. Tel. 673 79 17 37. Para llevar y a domicilio.';

const servicios = [
	'Cocina china',
	'Para llevar',
	'Reparto a domicilio',
	'Menú del día',
	'Terraza y sala interior',
	'Comida y cena',
	'Tofu y opciones vegetarianas',
	'Aparcamiento gratuito cerca',
];

const platos = [
	{
		name: 'Arroz tres delicias',
		note: 'el arroz cantonés más citado por los clientes, en sus dos versiones (tres delicias y tallarines tres delicias)',
	},
	{
		name: 'Pollo al limón',
		note: 'especialidad de la casa, recomendada por quienes repiten visita',
	},
	{
		name: 'Rollitos de primavera',
		note: 'grandes y bien rellenos, de los entrantes que más se piden',
	},
	{ name: 'Pollo con almendras', note: 'clásico de la carta china, muy pedido en las reseñas' },
	{
		name: 'Ternera con bambú y setas chinas',
		note: 'plato de ternera con salsa suave, de los mejor valorados',
	},
	{
		name: 'Ternera en salsa de ostras',
		note: 'una de las preparaciones de carne más pedidas, también para llevar',
	},
	{
		name: 'Pollo agridulce',
		note: 'el clásico de la cocina china, con salsa dulce y ácida',
	},
	{ name: 'Familia feliz', note: 'plato para compartir, muy recomendado en grupos' },
	{
		name: 'Tofu salteado',
		note: 'sorprende a los clientes; mejor con arroz blanco si pica',
	},
	{ name: 'Arroz chino', note: 'el básico imprescindible de cualquier mesa china' },
	{
		name: 'Ensalada china',
		note: 'para empezar o acompañar, en las reseñas se repite mucho',
	},
	{ name: 'Flan chino', note: 'el postre de la casa, con nota de dulce por encima de la media' },
];

const galeria = [
	{
		src: foto1,
		alt: 'Interior de Restaurante Mister Rice en la avenida de Lope de Vega, Teatinos (Málaga)',
	},
	{
		src: foto3,
		alt: 'Platos de Mister Rice, restaurante chino en Teatinos-Universidad, Málaga',
	},
	{
		src: foto2,
		alt: 'Mesa servida en Mister Rice, fotografía de su ficha de Google Maps',
	},
	{
		src: foto7,
		alt: 'Comida china servida en Mister Rice, Lope de Vega 19, Málaga',
	},
	{
		src: foto4,
		alt: 'Detalle de la carta y los platos de Mister Rice en Teatinos, Málaga',
	},
	{
		src: foto8,
		alt: 'Fachada y acceso de Restaurante Mister Rice en Teatinos-Universidad, Málaga',
	},
	{
		src: foto5,
		alt: 'Imagen de Mister Rice publicada en Google Maps, restaurante chino en Málaga',
	},
	{
		src: foto9,
		alt: 'Arroz, tallarines y carne de Mister Rice, cocina china en Málaga',
	},
	{
		src: foto6,
		alt: 'Mesa de Mister Rice con rollitos de primavera y platos de la carta',
	},
	{
		src: foto10,
		alt: 'Ambiente y terraza de Restaurante Mister Rice, Teatinos, Málaga',
	},
	{
		src: foto11,
		alt: 'Servicio de Mister Rice, comida china para llevar en Málaga',
	},
	{
		src: foto12,
		alt: 'Entrantes de Mister Rice, restaurante chino en la avenida de Lope de Vega',
	},
	{
		src: foto13,
		alt: 'Fotografía de Google Maps del Restaurante Mister Rice en Teatinos, Málaga',
	},
	{ src: foto14, alt: 'Postre y bebida en Mister Rice, restaurante chino en Teatinos' },
	{
		src: foto15,
		alt: 'Sala de Mister Rice, restaurante chino en Teatinos-Universidad, Málaga',
	},
];

const faqs = [
	{
		q: '¿Dónde está Mister Rice en Málaga?',
		a: 'En la avenida de Lope de Vega, 19, en el barrio de Teatinos-Universidad (29010 Málaga), muy cerca del campus universitario y de la Ciudad de la Justicia. En la zona hay además aparcamiento gratuito, algo poco habitual en este barrio de la ciudad.',
	},
	{
		q: '¿Cuál es el horario de Mister Rice?',
		a: 'El restaurante abre de miércoles a domingo en dos turnos, de 13:00 a 16:15 y de 20:00 a 23:30, y también los lunes con el mismo horario. El martes solo ofrece el servicio de comida, de 13:00 a 16:15, y por la noche está cerrado.',
	},
	{
		q: '¿Qué se come en Mister Rice?',
		a: 'Es un restaurante de cocina china con carta bastante amplia y más renovada que la de un chino de barrio clásico. Entre los platos que los clientes destacan están el arroz tres delicias, los tallarines tres delicias, el pollo al limón, el pollo con almendras, la ternera con bambú y setas chinas, el pollo agridulce, el plato «familia feliz», los rollitos de primavera, la ensalada china y el flan. También hay platos de tofu y verduras para los que buscan opciones vegetarianas.',
	},
	{
		q: '¿Hay menú del día?',
		a: 'Sí. Hay menú del día con varios platos, bebida y postre. Como la carta puede variar, conviene confirmar la disponibilidad por teléfono al 673 79 17 37.',
	},
	{
		q: '¿Mister Rice sirve para llevar o a domicilio?',
		a: 'Sí. El local ofrece servicio para llevar y reparto a domicilio, y su propia descripción en Google destaca que se pueden pedir los platos desde casa. Para pedidos, llama al 673 79 17 37 y pregunta por la disponibilidad de cada día.',
	},
	{
		q: '¿Hay opciones vegetarianas?',
		a: 'Sí. La ficha del negocio recoge como información añadida que hay «tofu y verduras salteadas, entre otros muchos platos». En la carta china clásica siempre hay alternativas con verduras, arroz y tallarines, aunque conviene avisar al pedir para adaptar el picante.',
	},
	{
		q: '¿El ambiente es tranquilo y hay terraza?',
		a: 'Mister Rice cuenta con sala interior y zona exterior. Varias reseñas señalan que el aire acondicionado no llega igual a todas las mesas y que al principio de la sala se pasa algo de calor, así que si vas en verano conviene pedir mesa hacia el fondo o en la zona exterior.',
	},
	{
		q: '¿Cómo se llega y se aparca?',
		a: 'Está en Lope de Vega, 19, a pocos minutos del campus de Teatinos. Se puede llegar en coche, bus o taxi, y en la ficha del negocio se indica que hay muchas plazas libres y aparcamiento gratuito en la zona, una ventaja en el centro de Málaga.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: 'Mister Rice',
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 673 79 17 37',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['China', 'Cocina asiática', 'Comida para llevar', 'Restaurante chino'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	acceptsReservations: 'False',
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: business.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '16:15',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday'],
			opens: '13:00',
			closes: '16:15',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Comida para llevar', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Reparto a domicilio', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Opciones vegetarianas', value: true },
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento gratuito en la zona',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Aire acondicionado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Menú del día', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.1,
		reviewCount: 187,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Qué pedir', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Mister Rice | Restaurante chino en Teatinos (Málaga)</title>
		<meta name="theme-color" content="#1a1014" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Mister Rice, restaurante chino Teatinos Málaga, comida china Lope de Vega, comida para llevar Teatinos, pollo al limón Málaga, arroz tres delicias, restaurante chino 29010, cena china Teatinos, comida china a domicilio Málaga, Lope de Vega 19 Málaga, restaurante chino Málaga"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Mister Rice · Restaurante chino en Teatinos (Málaga)"
			ogDescription="Arroz tres delicias, pollo al limón, pollo con almendras, rollitos de primavera y flan. Av. de Lope de Vega, 19 (Teatinos, Málaga). Comida, cena, para llevar y a domicilio."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Mister Rice, restaurante chino en la avenida de Lope de Vega 19, Teatinos, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#1a1014"
			street={business.street}
			city={business.city}
			region="Andalucía"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Teatinos-Universidad, Málaga"
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta property="og:image" content="https://mister-rice.vercel.app/og.png" />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.730282;-4.4682278" />
		<meta name="ICBM" content="36.730282, -4.4682278" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="M"
			name={business.name}
			subtitle="Restaurante chino · Teatinos, Málaga"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Teatinos-Universidad · Málaga"
				title="Cocina china<br />que no es<br /><em>de barrio.</em>"
				lede="Restaurante chino en la avenida de Lope de Vega, junto al campus de Teatinos. Una carta amplia y más renovada que la de un chino clásico: arroz tres delicias, pollo al limón, pollo con almendras, rollitos de primavera y flan. Para comer allí, para llevar o a domicilio."
				image={heroImage}
				imageAlt="Fotografía de Restaurante Mister Rice publicada en su perfil de Google Maps (restaurante chino en Teatinos, Málaga)"
				primaryCta={{ label: 'Llamar 673 79 17 37', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,1</b> en Google (187 reseñas)' },
					{ label: 'Menú', html: 'Menú del día disponible' },
					{ label: 'Servicios', html: 'Para llevar y a domicilio' },
					{ label: 'Horario', html: 'Cierra a las 23:30 entre semana' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Mister Rice" items={servicios} />

			<LocalAbout
				label="Un chino distinto en Teatinos"
				title="De barrio,<br />con carta<br /><em>de verdad.</em>"
				paragraphs={[
					'Mister Rice está en Lope de Vega, 19, a dos pasos del campus universitario de Teatinos. Es de esos chinos que no se limitan a los clásicos: tiene una carta larga y con platos menos previsibles; la especialidad de la casa es precisamente esa variedad.',
					'Se puede comer en la sala, en la zona exterior o pedir para llevar. El local sirve comida de 13:00 a 16:15 y cena de 20:00 a 23:30 casi todos los días, y también trae el pedido a domicilio. En la ficha se destaca además que hay varias opciones con tofu y verduras salteadas.',
					'Un detalle que los clientes destacan: al sentarse te sirven pan de gamba de cortesía. No es lo único, pero es de esos gestos que hacen que un chino de barrio se recuerde.',
				]}
				note="Lo que se repite en las reseñas de Google: raciones abundantes, buen arroz, personal cordial y servicio rápido. También hay críticas, y conviene conocerlas: algunos clientes señalan que el servicio llega los platos demasiado seguidos, que el aire acondicionado no llega igual a todas las mesas y que algún plato les ha Salgado más caro o más amargo de lo esperado. La nota media del local es de 4,1 sobre 187 opiniones."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="Lo más pedido"
				title="Qué pedir<br /><em>en Mister Rice.</em>"
				description="Selección hecha a partir de los platos que los clientes mencionan en las reseñas de Google y de los que el propio negocio destaca en su ficha. La carta es extensa y puede cambiar, así que pregunta por los platos del día al llamar o al llegar."
				cta={{ label: 'Pedir información', href: phoneHref }}
				groups={[{ title: 'La carta', items: platos }]}
				note="La carta es extensa y puede cambiar, así que pregunta por los platos del día al llamar o al llegar."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La carta,<br /><em>servida.</em>"
				description="Estas fotografías proceden del perfil de Mister Rice en Google Maps, con la galería de clientes y las fotos de sus platos. En la ficha están todas las imágenes y las reseñas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Av. de Lope de Vega 19 · 29010 Málaga"
				title="Nos vemos<br /><em>en Teatinos.</em>"
				addressLines={[
					business.street,
					business.district,
					`${business.postalCode} ${business.city}, España`,
					`Plus Code: ${business.plusCode}`,
				]}
				hours={[
					{ day: 'Lunes', value: '13:00 – 16:15 · 20:00 – 23:30' },
					{ day: 'Martes', value: '13:00 – 16:15' },
					{ day: 'Miércoles', value: '13:00 – 16:15 · 20:00 – 23:30' },
					{ day: 'Jueves', value: '13:00 – 16:15 · 20:00 – 23:30' },
					{ day: 'Viernes', value: '13:00 – 16:15 · 20:00 – 23:30' },
					{ day: 'Sábado', value: '13:00 – 16:15 · 20:00 – 23:30' },
					{ day: 'Domingo', value: '13:00 – 16:15 · 20:00 – 23:30' },
				]}
				hoursNote="Horario publicado en la ficha de Google Maps. El martes por la noche el local permanece cerrado. Puede cambiar en festivos: llama antes al 673 79 17 37 para confirmar, sobre todo si vienes a cenar."
				mapTitle="Mapa de Mister Rice en la avenida de Lope de Vega, 19, Teatinos-Universidad, Málaga"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Mister Rice · Teatinos, Málaga"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Pedir para llevar', href: phoneHref },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="No hace falta reservar: se atiende por orden de llegada. Para pedidos a domicilio o para recoger, llama al 673 79 17 37. En la ficha se indica que en la zona hay aparcamiento gratuito y muchas plazas libres."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="M"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Mister Rice"
		/>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
		<WhatsappFab phone={phoneHref} />
	</body>
</html>
