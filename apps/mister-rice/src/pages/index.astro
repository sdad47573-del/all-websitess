---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/mister-rice-apaisada-01.jpg';
import verduras from '../assets/fotos/mister-rice-apaisada-02.jpg';
import rollitos from '../assets/fotos/mister-rice-apaisada-05.jpg';
import ensalada from '../assets/fotos/mister-rice-apaisada-07.jpg';
import ternera from '../assets/fotos/mister-rice-apaisada-08.jpg';
import gyozas from '../assets/fotos/mister-rice-apaisada-10.jpg';
import arroz from '../assets/fotos/mister-rice-vertical-03.jpg';
import pollo from '../assets/fotos/mister-rice-vertical-04.jpg';
import tallarines from '../assets/fotos/mister-rice-vertical-06.jpg';
import helado from '../assets/fotos/mister-rice-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Mister Rice · Restaurante chino en Teatinos (Málaga)';
const description =
	'Restaurante Mister Rice, en la Av. de Lope de Vega, 19, Teatinos (29010 Málaga). Cocina china con arroz, tallarines y platos salteados. 4,1 sobre 5 con 190 reseñas. Comidas de 13:00 a 16:15 y cenas de 20:00 a 23:30; martes solo mediodía. Teléfono 673 79 17 37.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de Mister Rice en la avenida de Lope de Vega, con el toldo verde, el rótulo de restaurante chino y la terraza de mesas en la acera',
	},
	{
		src: rollitos,
		alt: 'Ocho rollitos de primavera fritos en un plato verde con un vaso de salsa agridulce',
	},
	{
		src: gyozas,
		alt: 'Empanadillas chinas a la plancha con semillas de sésamo y cebollino, alineadas en un plato verde',
	},
	{
		src: verduras,
		alt: 'Verduras salteadas con setas shiitake y hojas verdes en un plato hondo blanco',
	},
	{
		src: arroz,
		alt: 'Un plato de arroz frito con huevo, zanahoria y jamón, con cuchara, sobre mantel blanco',
	},
	{
		src: tallarines,
		alt: 'Tallarines fritos con ternera, col y verdura en un plato blanco, con una cerveza Alhambra al fondo',
	},
	{
		src: pollo,
		alt: 'Pollo salteado con anacardos, zanahoria y puerro en salsa, con platos de arroz y tallarines al fondo',
	},
	{
		src: ternera,
		alt: 'Ternera en salsa con pimiento verde, cebolla y zanahoria en un plato blanco',
	},
	{
		src: ensalada,
		alt: 'Ensalada de lechuga iceberg con tiras de jamón y zanahoria rallada en un bol de cerámica',
	},
	{
		src: helado,
		alt: 'Una bola de helado de chocolate en una copa metálica sobre un plato blanco',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#mister-rice`,
	name: BUSINESS.fullName,
	alternateName: ['Mister Rice Málaga', 'Mister Rice Teatinos', 'Restaurante Mister Rice Lope de Vega'],
	description:
		'Restaurante chino en la Av. de Lope de Vega, 19, Teatinos (29010 Málaga). Arroz, tallarines y platos salteados, con servicio de mediodía y noche.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34673791737',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina china', 'Cocina asiática'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '16:15',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '23:30',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Tuesday', opens: '13:00', closes: '16:15' },
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#16171a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Mister Rice Málaga, restaurante chino Teatinos, comida china Lope de Vega, arroz tres delicias Málaga, tallarines fritos Teatinos, restaurante chino 29010, cenar Teatinos, Mister Rice Málaga opiniones"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina china en la Av. de Lope de Vega, 19, Teatinos. 4,1 sobre 5 con 190 reseñas en Google. Comidas de 13:00 a 16:15 y cenas de 20:00 a 23:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de Mister Rice en Teatinos, con el toldo verde y el rótulo de restaurante chino"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#16171a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Mister Rice"
			subtitle="Chino · Teatinos, Málaga"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. de Lope de Vega, 19 · Teatinos, Málaga"
				title="Arroz y wok <br /><em>en Teatinos.</em>"
				lede={`Mister Rice es el chino de la avenida de Lope de Vega, en pleno Teatinos-Universidad: toldo verde, terraza con mesas en la acera y una carta que se ve en las fotos —rollitos, gyozas, arroz frito, tallarines con ternera y pollo con anacardos—. Sirve a mediodía y por la noche, y Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				image={fachada}
				imageAlt="La fachada de Mister Rice en la avenida de Lope de Vega, con el toldo verde, el rótulo de restaurante chino y la terraza de mesas en la acera"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>13:00–16:15</b> · y 20:00–23:30' },
					{ label: 'Martes', html: '<b>Solo mediodía</b> · sin cena' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Chino · Málaga"
			/>

			<LocalChips label="Lo que ofrece Restaurante Mister Rice" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Lope de Vega, 19. <br /><em>Wok y mantel.</em>"
				paragraphs={[
					'El restaurante ocupa un bajo de la Av. de Lope de Vega, 19, en Teatinos-Universidad, la zona de facultades y hospitales de Málaga. La fachada tiene un toldo verde con el nombre en letras rojas y el cartel de «Restaurante chino», y delante se monta una terraza con mesas y sillas de mimbre entre jardineras.',
					'Dentro, el servicio es de mantel y mesa, con dos turnos: comida de 13:00 a 16:15 y cena de 20:00 a 23:30. Los martes solo abre a mediodía, y la ficha avisa de que en festivos el horario puede cambiar.',
					'Las fotos del perfil enseñan la carta en la mesa: rollitos de primavera con salsa agridulce, empanadillas a la plancha con sésamo, verduras salteadas con shiitake, arroz frito con huevo y zanahoria, tallarines con ternera, pollo con anacardos y ternera en salsa con pimiento verde. De postre, helado.',
					`Google lo clasifica como «Restaurante chino» y marca el acceso para sillas de ruedas. La valoración es de ${RATING.label} sobre 5 con ${RATING.count} reseñas (noviembre de 2026), una media amplia para un local de barrio.`,
				]}
				note="La ficha de Google no publica carta con precios ni menú del día, y tampoco dice si hay reparto a domicilio o comida para llevar. Los platos de esta página son los que aparecen en las fotos del perfil; precios y servicios se preguntan en el 673 79 17 37."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> La casa</p>
					<h2 id="highlights-title">Dos turnos, <br /><em>una terraza.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El toldo verde <br /><em>y la mesa.</em>"
				description="Diez fotografías del perfil de Mister Rice en Google Maps: la fachada con la terraza, los rollitos de primavera, las gyozas a la plancha, las verduras con shiitake, el arroz frito, los tallarines con ternera, el pollo con anacardos, la ternera en salsa, la ensalada y el helado."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,1 sobre 5, <em>con 190 reseñas.</em></h2>
						<p>
							Ciento noventa opiniones y una media de 4,1 sobre 5 (consultada el 1 de noviembre de
							2026). Es un chino de barrio con clientela de la zona: hay reseñas muy buenas del
							arroz y del servicio, y alguna que otra más fría.
						</p>
						<p>
							Esta web no copia reseñas sueltas: para leerlas con sus fechas y sus respuestas, abre
							la ficha en Google.
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver las 190 reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,1</strong>
						<span>★★★★☆</span>
						<small>190 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Teatinos, <br /><em>Lope de Vega 19.</em>"
				addressLines={[BUSINESS.street, 'Teatinos-Universidad', `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de 13:00 a 16:15 y de 20:00 a 23:30, salvo el martes, que solo sirve a mediodía. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Restaurante Mister Rice en la Av. de Lope de Vega, 19, Teatinos, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Lope de Vega, 19 · Teatinos"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Reservas y consultas por teléfono, en el 673 79 17 37: la ficha no publica reservas online ni pedidos por la web. Google marca el acceso para sillas de ruedas, pero no publica datos de aparcamiento."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>sentarse.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Mister Rice"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario, valoración y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. La ficha no publica carta ni precios: confírmalos por teléfono."
			ctaLabel="Llamar a Mister Rice"
			navAriaLabel="Enlaces de Restaurante Mister Rice"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
