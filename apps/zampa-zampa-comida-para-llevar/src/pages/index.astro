---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/zampa-zampa-comida-para-llevar-apaisada-01.jpg';
import mostrador from '../assets/fotos/zampa-zampa-comida-para-llevar-apaisada-05.jpg';
import ensaladilla from '../assets/fotos/zampa-zampa-comida-para-llevar-cuadrada-02.jpg';
import pimientos from '../assets/fotos/zampa-zampa-comida-para-llevar-cuadrada-06.jpg';
import strudel from '../assets/fotos/zampa-zampa-comida-para-llevar-cuadrada-07.jpg';
import pizarra from '../assets/fotos/zampa-zampa-comida-para-llevar-vertical-03.jpg';
import interior from '../assets/fotos/zampa-zampa-comida-para-llevar-vertical-04.jpg';
import pollo from '../assets/fotos/zampa-zampa-comida-para-llevar-vertical-09.jpg';
import albondigas from '../assets/fotos/zampa-zampa-comida-para-llevar-vertical-10.jpg';
import crema from '../assets/fotos/zampa-zampa-comida-para-llevar-vista-8-08.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Zampa Zampa · Comida casera para llevar en Chamartín';
const description =
	'Zampa Zampa, en Calle del Sauce, 14 (28016 Madrid, Chamartín). Comida casera para llevar con carta del día: ensaladilla, callos, cazón y postres caseros.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de Zampa Zampa en la calle del Sauce, 14, con el toldo rojo y blanco y el rótulo de comida casera para llevar',
	},
	{
		src: pizarra,
		alt: 'La pizarra de Zampa Zampa con la carta del sábado 31 de octubre y los precios de cada ración',
	},
	{
		src: ensaladilla,
		alt: 'Un plato de ensaladilla rusa de Zampa Zampa con huevo cocido y cebollino',
	},
	{
		src: albondigas,
		alt: 'Albóndigas en salsa de tomate con perejil en un plato de borde azul',
	},
	{
		src: pollo,
		alt: 'Pollo guisado con champiñones y perejil en un plato de Zampa Zampa',
	},
	{
		src: pimientos,
		alt: 'Pimientos rojos rellenos con su salsa en un plato de borde azul',
	},
	{
		src: strudel,
		alt: 'Un trozo de strudel de manzana con cebollino en un plato de Zampa Zampa',
	},
	{
		src: crema,
		alt: 'Un cuenco de crema de verduras con judías verdes y una cuchara',
	},
	{
		src: mostrador,
		alt: 'El mostrador de Zampa Zampa con las salsas, la ensaladilla, la pasta y los guisos del día',
	},
	{
		src: interior,
		alt: 'El interior de Zampa Zampa con la vitrina, las lámparas de mimbre y el rótulo de la pared',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta del día de Zampa Zampa',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#zampa-zampa`,
	name: BUSINESS.fullName,
	alternateName: ['Zampa Zampa Madrid', 'Zampa Zampa Chamartín', 'Zampa Zampa Sauce'],
	description:
		'Comida casera para llevar en la calle del Sauce, 14 (Chamartín, 28016 Madrid). Carta del día con raciones, guisos, ensaladas y postres caseros.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34629385988',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Comida para llevar', 'Cocina española'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Chamartín' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday'],
			opens: '11:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '10:30',
			closes: '14:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La tienda', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f5138" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Sans:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Zampa Zampa Madrid, comida casera para llevar Chamartín, comida para llevar Sauce, carta del día Chamartín, callos con garbanzos Madrid, ensaladilla rusa Chamartín"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar en la calle del Sauce, 14 (Chamartín). Carta del día con raciones, guisos y postres caseros. De miércoles a sábado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de Zampa Zampa en la calle del Sauce, 14"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2f5138"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Chamartín"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Zampa Zampa"
			subtitle="Comida casera · Chamartín"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Calle del Sauce, 14 · Chamartín, Madrid"
				title="Comida de casa <br /><em>para zampa.</em>"
				lede={`Zampa Zampa es una tienda de comida casera para llevar en la calle del Sauce. Cada día pone su carta en la pizarra: raciones de ensaladilla, ensaladas, guisos como los callos con garbanzos o el cazón encebollado, y postres de cuchara. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas, y abre de miércoles a sábado.`}
				image={fachada}
				imageAlt="La fachada de Zampa Zampa en la calle del Sauce, 14, con el toldo rojo y blanco y el rótulo de comida casera para llevar"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>11:00–16:00</b> · sábado 10:30–14:00' },
					{ label: 'Servicio', html: '<b>Para llevar</b> · carta del día' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Carta del día"
			/>

			<LocalChips label="Lo que ofrece Zampa Zampa" items={SERVICIOS} />

			<LocalAbout
				label="La tienda"
				title="Sauce, 14. <br /><em>Comida de casa.</em>"
				paragraphs={[
					'Zampa Zampa está en la calle del Sauce, 14, en el distrito de Chamartín. La fachada conserva el toldo rojo y blanco y el rótulo de mimbre con el nombre; dentro, una vitrina con las bandejas del día y unas lámparas de mimbre sobre el mostrador.',
					'La ficha de Google la describe como «tienda de comida casera para llevar». Cada día se escribe la carta en una pizarra: entrantes y ensaladas, platos de cuchara, guisos y postres, casi todo por ración.',
					'En las fotos del perfil aparece la pizarra del sábado 31 de octubre, con diecisiete platos: salmorejo, crema de verduras, ensaladilla rusa, boquerones en vinagre, callos con garbanzos, albóndigas de pollo con salsa tikka masala, costillas al horno con puré de boniato, cazón encebollado, arroz con leche o strudel de manzana, entre otros.',
					`Las reseñas de Google insisten en lo mismo: raciones abundantes y buen precio. La ficha le da ${RATING.label} sobre 5 con ${RATING.count} opiniones (octubre de 2026), abre de miércoles a viernes de 11:00 a 16:00 y el sábado de 10:30 a 14:00, y atiende los pedidos en el ${BUSINESS.phone}.`,
				]}
				note="La ficha no publica una carta fija ni datos de accesibilidad. La carta de esta página es la que aparece en la pizarra fotografiada en el perfil de Google (sábado 31 de octubre de 2026): cambia cada día, así que confirma platos y precios por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> La pizarra del día</p>
					<h2 id="highlights-title">Una carta que <br /><em>cambia cada día.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Lo que hay <br /><em>hoy en la pizarra.</em>"
				description="Esta es la carta que se ve en la foto de la pizarra del perfil de Google, la del sábado 31 de octubre de 2026. Los precios son por ración salvo donde se indica."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La pizarra se reescribe cada día y la ficha no publica una carta fija. Si vas a por un plato concreto, llama antes al 629 38 59 88 y pregunta qué hay y cuánto cuesta."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La tienda, la pizarra <br /><em>y los platos.</em>"
				description="Diez fotografías del perfil de Zampa Zampa en Google Maps: la fachada, la pizarra con la carta, la ensaladilla, las albóndigas, el pollo guisado, los pimientos rellenos, el strudel, la crema de verduras y el mostrador."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,9 sobre 5, <em>con 42 reseñas.</em></h2>
						<p>
							Google publica una media de 4,9 con 42 opiniones (octubre de 2026). Las reseñas
							que se ven aquí hablan de las raciones, del precio y de que la comida es casera.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,9</strong>
						<span>★★★★★</span>
						<small>42 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En Chamartín, <br /><em>Sauce 14.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de miércoles a viernes, de 11:00 a 16:00, y el sábado de 10:30 a 14:00, con domingo, lunes y martes cerrados. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Zampa Zampa en la calle del Sauce, 14, Chamartín, Madrid"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Sauce, 14 · Chamartín"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos y consultas por teléfono: la ficha no publica reservas, pedidos online ni reparto a domicilio. Tampoco publica datos de accesibilidad, así que conviene llamar antes si necesitas acceso para silla de ruedas."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma la carta y el horario antes de la visita."
			ctaLabel="Llamar a Zampa Zampa"
			navAriaLabel="Enlaces de Zampa Zampa"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
