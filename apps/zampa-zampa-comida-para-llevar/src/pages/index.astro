---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/zampa-zampa-comida-para-llevar-apaisada-01.jpg';
import mostrador from '../assets/fotos/zampa-zampa-comida-para-llevar-apaisada-05.jpg';
import ensaladilla from '../assets/fotos/zampa-zampa-comida-para-llevar-cuadrada-02.jpg';
import pimientos from '../assets/fotos/zampa-zampa-comida-para-llevar-cuadrada-06.jpg';
import strudel from '../assets/fotos/zampa-zampa-comida-para-llevar-cuadrada-07.jpg';
import pizarra from '../assets/fotos/zampa-zampa-comida-para-llevar-vertical-03.jpg';
import interior from '../assets/fotos/zampa-zampa-comida-para-llevar-vertical-04.jpg';
import pollo from '../assets/fotos/zampa-zampa-comida-para-llevar-vertical-09.jpg';
import albondigas from '../assets/fotos/zampa-zampa-comida-para-llevar-vertical-10.jpg';
import crema from '../assets/fotos/zampa-zampa-comida-para-llevar-vista-8-08.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Zampa Zampa · Comida casera para llevar en Chamartín';
const description =
	'Zampa Zampa, en Calle del Sauce, 14 (28016 Madrid, Chamartín). Comida casera para llevar con carta del día: ensaladilla, callos, cazón y postres caseros.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de Zampa Zampa en la calle del Sauce, 14, con el toldo rojo y blanco y el rótulo de comida casera para llevar',
	},
	{
		src: pizarra,
		alt: 'La pizarra de Zampa Zampa con la carta del sábado 31 de octubre y los precios de cada ración',
	},
	{
		src: ensaladilla,
		alt: 'Un plato de ensaladilla rusa de Zampa Zampa con huevo cocido y cebollino',
	},
	{
		src: albondigas,
		alt: 'Albóndigas en salsa de tomate con perejil en un plato de borde azul',
	},
	{
		src: pollo,
		alt: 'Pollo guisado con champiñones y perejil en un plato de Zampa Zampa',
	},
	{
		src: pimientos,
		alt: 'Pimientos rojos rellenos con su salsa en un plato de borde azul',
	},
	{
		src: strudel,
		alt: 'Un trozo de strudel de manzana con cebollino en un plato de Zampa Zampa',
	},
	{
		src: crema,
		alt: 'Un cuenco de crema de verduras con judías verdes y una cuchara',
	},
	{
		src: mostrador,
		alt: 'El mostrador de Zampa Zampa con las salsas, la ensaladilla, la pasta y los guisos del día',
	},
	{
		src: interior,
		alt: 'El interior de Zampa Zampa con la vitrina, las lámparas de mimbre y el rótulo de la pared',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta del día de Zampa Zampa',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#zampa-zampa`,
	name: BUSINESS.fullName,
	alternateName: ['Zampa Zampa Madrid', 'Zampa Zampa Chamartín', 'Zampa Zampa Sauce'],
	description:
		'Comida casera para llevar en la calle del Sauce, 14 (Chamartín, 28016 Madrid). Carta del día con raciones, guisos, ensaladas y postres caseros.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34629385988',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida casera', 'Comida para llevar', 'Cocina española'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Chamartín' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday'],
			opens: '11:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '10:30',
			closes: '14:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La tienda', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"zampa-zampa-comida-para-llevar-apaisada-01.jpg": fachada,
	"zampa-zampa-comida-para-llevar-vertical-03.jpg": pizarra,
	"zampa-zampa-comida-para-llevar-cuadrada-02.jpg": ensaladilla,
	"zampa-zampa-comida-para-llevar-vertical-10.jpg": albondigas,
	"zampa-zampa-comida-para-llevar-vertical-09.jpg": pollo,
	"zampa-zampa-comida-para-llevar-cuadrada-06.jpg": pimientos,
	"zampa-zampa-comida-para-llevar-cuadrada-07.jpg": strudel,
	"zampa-zampa-comida-para-llevar-vista-8-08.jpg": crema,
	"zampa-zampa-comida-para-llevar-apaisada-05.jpg": mostrador,
	"zampa-zampa-comida-para-llevar-vertical-04.jpg": interior,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f5138" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Sans:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Zampa Zampa Madrid, comida casera para llevar Chamartín, comida para llevar Sauce, carta del día Chamartín, callos con garbanzos Madrid, ensaladilla rusa Chamartín"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar en la calle del Sauce, 14 (Chamartín). Carta del día con raciones, guisos y postres caseros. De miércoles a sábado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de Zampa Zampa en la calle del Sauce, 14"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2f5138"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Chamartín"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Zampa Zampa"
			subtitle="Comida casera · Chamartín"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma la carta y el horario antes de la visita."
			ctaLabel="Llamar a Zampa Zampa"
			navAriaLabel="Enlaces de Zampa Zampa"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34629385988?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carta%20del%20d%C3%ADa%20de%20Zampa%20Zampa." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carta del día de Zampa Zampa"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
