---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import interior from '../assets/fotos/bordatxo-apaisada-01.jpg';
import barril from '../assets/fotos/bordatxo-vertical-02.jpg';
import barraPintxos from '../assets/fotos/bordatxo-apaisada-03.jpg';
import desayuno from '../assets/fotos/bordatxo-apaisada-04.jpg';
import panceta from '../assets/fotos/bordatxo-apaisada-05.jpg';
import cafe from '../assets/fotos/bordatxo-cuadrada-06.jpg';
import jamon from '../assets/fotos/bordatxo-vertical-07.jpg';
import chorizo from '../assets/fotos/bordatxo-vertical-08.jpg';
import exterior from '../assets/fotos/bordatxo-vertical-09.jpg';
import croquetas from '../assets/fotos/bordatxo-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Bar de tapas BORDATXO, Zubiaurrenea Kalea 5 (Usurbil). Pintxos, raciones y desayunos desde las 7:00, con terraza en la plaza. Abierto todos los días hasta la 1:00. Tel. 943 37 10 42.';

const galeria = [
	{
		src: interior,
		alt: 'Interior de BORDATXO con la barra roja, taburetes de madera y botellas en las estanterías',
	},
	{
		src: jamon,
		alt: 'Pintxo de jamón curado sobre pan en un plato de BORDATXO',
	},
	{
		src: chorizo,
		alt: 'Pintxo de chorizo a la plancha sobre pan en la barra de BORDATXO',
	},
	{
		src: croquetas,
		alt: 'Tres croquetas en un plato sobre la mesa de la terraza de BORDATXO',
	},
	{
		src: exterior,
		alt: 'Terraza de BORDATXO en la plaza, con el rótulo en la fachada y mesas de metal',
	},
	{
		src: barraPintxos,
		alt: 'Bandeja de la barra con pintxos y bocadillos de tortilla y jamón',
	},
	{
		src: desayuno,
		alt: 'Desayuno en la terraza: café con leche, bocadillo y pan en una mesa de madera',
	},
	{
		src: panceta,
		alt: 'Plato de panceta a la plancha con patatas fritas y huevos fritos',
	},
	{
		src: barril,
		alt: 'Barril de madera de cerveza en la barra roja de BORDATXO',
	},
	{ src: cafe, alt: 'Taza de café con leche en la barra de BORDATXO' },
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#bordatxo`,
	name: BUSINESS.name,
	alternateName: ['Bordatxo taberna', 'Bar Bordatxo', 'Bordatxo Usurbil'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 943 37 10 42',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Tapas', 'Vasca', 'Española'],
	areaServed: [
		{ '@type': 'City', name: 'Usurbil' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '01:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '08:00',
			closes: '01:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Se admiten perros',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Llegamos por casualidad y nos quedamos al ver sus pintxos y el ambientazo.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 4, bestRating: 5 },
			reviewBody: 'Ambiente familiar y de cuadrillas, con buena carta de pintxos y raciones.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Buen trato, camareros agradables y buen sitios para desayunar y comer pintxo.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La barra', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'BORDATXO · Bar de tapas en Usurbil';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#6d2320" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="BORDATXO Usurbil, bordatxo taberna, bar de tapas Usurbil, pintxos Usurbil, desayunar en Usurbil, bar de pintxos Gipuzkoa, terraza Usurbil, Zubiaurrenea Kalea"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="BORDATXO · Bar de tapas en Usurbil"
			ogDescription="Pintxos, raciones y desayunos desde las 7:00 en BORDATXO, Zubiaurrenea Kalea 5 (Usurbil). Terraza en la plaza y perros admitidos. Tel. 943 37 10 42."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Interior de BORDATXO con la barra roja y los taburetes de madera"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#6d2320"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone="+34943371042"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[interior]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="BORDATXO"
			subtitle="Bar de tapas · Usurbil"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Zubiaurrenea Kalea, 5 · Usurbil"
				title="BORDATXO,<br /><em>bar de tapas en Usurbil.</em>"
				lede={`Bar de tapas en Zubiaurrenea Kalea, 5, en Usurbil (Gipuzkoa). Pintxos y raciones en la barra, croquetas, platos como la panceta con patatas y huevos, y desayunos desde las 7:00. Terraza en la plaza y todos los días abierto hasta la 1:00. Reservas y encargos en el ${BUSINESS.phoneDisplay}.`}
				image={interior}
				imageAlt="Interior de BORDATXO con la barra roja, taburetes de madera y botellas en las estanterías"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)`,
					},
					{ label: 'Horario', html: 'L–V 7:00–1:00 · S–D 8:00–1:00' },
					{ label: 'Perros', html: 'Se admiten perros' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece BORDATXO" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una barra roja<br /><em>y pintxos en la plaza.</em>"
				paragraphs={[
					'BORDATXO es un bar de tapas en Zubiaurrenea Kalea, 5, en Usurbil (Gipuzkoa). En su ficha de Google aparece también como «Bordatxo taberna» y está clasificado como bar de tapas: pintxos y raciones en la barra, además de desayunos y platos para comer o cenar.',
					'Dentro, la barra roja recorre el local con taburetes de madera, botellas en las estanterías y lámparas de tubo colgadas del techo. Al fondo, junto al ventanal, hay mesas y sillas altas. Fuera, la terraza ocupa la plaza empedrada donde está el bar, con mesas y sillas de metal.',
					'En las fotos de su perfil aparecen los pintxos de jamón y de chorizo, la bandeja de bocadillos y pintxos de tortilla, las croquetas, el plato de panceta con patatas y huevos, el café con leche y el barril de madera de la barra.',
					'Google le da 4,4 sobre 5 con 523 reseñas. Las que se publican hablan de «ambientazo», de un sitio de «ambiente familiar y de cuadrillas» con buena carta de pintxos y raciones, y de «camareros agradables».',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «Llegamos por casualidad y nos quedamos al ver sus pintxos y el ambientazo».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La barra"
				title="Pintxos, raciones<br /><em>y desayunos.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que citan sus reseñas y lo que aparece en las fotos del perfil. La bandeja de la barra cambia a lo largo del día."
				cta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. Pregunta en la barra o llama al 943 37 10 42 para saber qué pintxos hay hoy y si queda sitio en la terraza."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La barra,<br /><em>los pintxos y la plaza.</em>"
				description="Estas fotografías proceden del perfil de BORDATXO en Google Maps: la barra roja, los pintxos de jamón y chorizo, las croquetas, el desayuno y la terraza en la plaza."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en la barra.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: de lunes a viernes de 7:00 a 1:00 y los fines de semana de 8:00 a 1:00. Para grupos conviene llamar antes."
				mapTitle="Mapa de BORDATXO en Zubiaurrenea Kalea, 5, Usurbil (Gipuzkoa)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="BORDATXO · Usurbil"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 943 37 10 42. Hay terraza en la plaza y la ficha de Google marca acceso para sillas de ruedas, aseo adaptado y asientos adaptados. Se admiten perros."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a BORDATXO"
		/>
	</body>
</html>
