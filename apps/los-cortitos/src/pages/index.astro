---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Los Cortitos · Pollo asado para llevar en La Fortuna';
const description = BUSINESS.description;

import fachada from '../assets/fotos/los-cortitos-vertical-01.jpg';
import vitrina from '../assets/fotos/los-cortitos-vertical-04.jpg';
import local from '../assets/fotos/los-cortitos-apaisada-06.jpg';
import plato from '../assets/fotos/los-cortitos-apaisada-10.jpg';

const galeria: { src: ImageMetadata; alt: string }[] = [
	{ src: fachada, alt: 'Interior de Los Cortitos con el mostrador y la vitrina de frío' },
	{ src: vitrina, alt: 'Vitrina con bandejas de comida preparada para llevar' },
	{ src: local, alt: 'Pollo empanado servido en bandeja' },
	{ src: plato, alt: 'Bandeja de comida casera de Los Cortitos' },
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#los-cortitos`,
	name: BUSINESS.name,
	alternateName: ['Asador de Pollos Los Cortitos', 'Los Cortitos La Fortuna'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34910104397',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Comida preparada', 'Paella'],
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Comunidad de Madrid' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.locality,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: { '@type': 'GeoCoordinates', latitude: BUSINESS.geo.lat, longitude: BUSINESS.geo.lng },
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId }],
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '10:30', closes: '16:00' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#123c36" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400..700;1,400..700&family=Mulish:ital,wght@0,400..700;1,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Los Cortitos, La Fortuna, asador de pollos La Fortuna, pollo asado para llevar, comida para llevar San Amado, encargos de paella"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado para llevar en C. de San Amado, 18 (La Fortuna, Madrid)."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tarjeta de Los Cortitos con su nombre sobre fondo verde esmeralda"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#123c36"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="La Fortuna"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Los Cortitos"
			subtitle="Asador de pollos · La Fortuna"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. de San Amado, 18 · La Fortuna, Madrid"
				title="Pollo asado <br /><em>para llevar.</em>"
				lede={`Los Cortitos es asador de pollos y comida para llevar en La Fortuna. Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>Jue–dom</b> 10:30–16:00 · <b>Lun–mié</b> cerrado' },
					{ label: 'Servicio', html: '<b>Para llevar</b> · encargos' },
				]}
				image={fachada}
				imageAlt="Fachada de Los Cortitos en la calle de San Amado, en La Fortuna"
				galleryHref={MAPS.place}
				photoCredit="Ficha de Google Maps"
				galleryLinkLabel="Ver en Google Maps"
				tag="Pollo asado · paella por encargo"
			/>

			<LocalChips label="Lo que ofrece Los Cortitos" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Asador de pollos <br /><em>de barrio.</em>"
				paragraphs={[
					'Los Cortitos está en la calle de San Amado, 18, en La Fortuna. Su ficha lo describe como asador de pollos y comida para llevar, con pollo asado como especialidad.',
					'Las reseñas de la ficha destacan el pollo con sus patatas, la sepia y el buen trato.',
					'Por encargo se pueden reservar paellas, codillo, pierna de cordero o cochinillo.',
				]}
				note="La ficha no publica página web, redes sociales, carta con precios ni reparto a domicilio. Para precios concretos y encargos, llama al 910 10 43 97."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El local <br /><em>y la cocina.</em>"
				description="Interior del local, vitrina de comida preparada y platos de la casa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Las fotos de la carta y de los platos de otros locales no se publican. Si tienes los derechos de alguna imagen y quieres retirarla, dilo y la eliminamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En La Fortuna, <br /><em>San Amado.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, BUSINESS.region]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.horas === 'Cerrado' }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: jueves a domingo de 10:30 a 16:00, y de lunes a miércoles cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Los Cortitos en la calle de San Amado, 18, La Fortuna, Madrid"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. de San Amado, 18"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="La ficha no publica reparto a domicilio, encargos ni pedidos online: se concreta todo por teléfono, en el 602 41 54 72. No da datos de accesibilidad, así que conviene llamar antes si necesitas algo concreto."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>ir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Los Cortitos"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma horario antes de la visita."
			ctaLabel="Llamar a Los Cortitos"
			navAriaLabel="Enlaces de Los Cortitos"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
