---
const business = {
	name: 'Mesón El Cordobés de José Peregrina',
	street: 'Calle Artesano Molero, 5',
	city: 'Granada',
	region: 'Granada',
	postalCode: '18004',
	country: 'ES',
	phone: '+34 958 20 80 08',
	latitude: 37.180963,
	longitude: -3.6146884,
	site: 'https://meson-el-cordobes-jose-peregrina.vercel.app',
};

const mapsUrl = 'https://www.google.com/maps/place/Mes%C3%B3n+el+Cordob%C3%A9s+de+Jos%C3%A9+Peregrina/@37.180963,-3.6146884,17z/data=!3m1!4b1!4m6!3m5!1s0xd71fcf3a8a5fbc1:0x2ad5f96be1343bb6!8m2!3d37.180963!4d-3.6146884!16s%2Fg%2F1tdygzy7?hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(`${business.name}, ${business.street}, ${business.city}`)}&ll=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34958208008';
const facebookUrl = 'https://www.facebook.com/p/Restaurante-El-Cordob%C3%A9s-de-Jos%C3%A9-Peregrina-100065363895153/';
const siteUrl = `${business.site}/`;
const description = 'Mesón El Cordobés de José Peregrina en Granada: carnes a la parrilla, asados, pescados, mariscos y recetas tradicionales. Consulta fotos de Google Maps, horario y reservas.';

const openingHours = [
	{ day: 'Lunes', value: 'Cerrado' },
	{ day: 'Martes', value: '13:30–17:30 · 20:15–00:15' },
	{ day: 'Miércoles', value: '13:30–17:30 · 20:15–00:15' },
	{ day: 'Jueves', value: '13:30–17:30 · 20:15–00:15' },
	{ day: 'Viernes', value: '13:30–17:30 · 20:15–00:15' },
	{ day: 'Sábado', value: '13:30–17:30 · 20:15–00:15' },
	{ day: 'Domingo', value: 'Cerrado' },
];

const faqs = [
	{
		question: '¿Dónde está el Mesón El Cordobés de José Peregrina?',
		answer: 'El mesón está en la calle Artesano Molero, 5, 18004 Granada, en la zona de Ronda. Puedes abrir las indicaciones de Google Maps desde esta página.',
	},
	{
		question: '¿Cuál es el teléfono para reservar?',
		answer: 'El teléfono público del mesón es el +34 958 20 80 08. Llama para consultar disponibilidad y reservar mesa.',
	},
	{
		question: '¿Qué tipo de cocina ofrece?',
		answer: 'Su propuesta combina cocina andaluza y española con carnes rojas a la parrilla, asados, pescados, mariscos y recetas tradicionales. Algunas reseñas destacan el rabo de toro, los arroces y los productos del mar.',
	},
	{
		question: '¿Cuál es el horario del mesón?',
		answer: 'Los horarios publicados indican cierre los lunes y domingos. De martes a sábado, el servicio figura de 13:30 a 17:30 y de 20:15 a 00:15. El horario puede cambiar; confirma por teléfono antes de desplazarte.',
	},
	{
		question: '¿Dónde puedo ver fotos de sus platos y del local?',
		answer: 'Abre la ficha del Mesón El Cordobés de José Peregrina en Google Maps desde el enlace de esta página para consultar las imágenes del establecimiento y las fotos publicadas por sus visitantes.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${siteUrl}#restaurant`,
	name: business.name,
	description,
	url: siteUrl,
	telephone: business.phone,
	priceRange: '20–60 €',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Andaluza', 'Española', 'Mediterránea', 'Parrilla', 'Mariscos'],
	acceptsReservations: true,
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: business.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [mapsUrl, facebookUrl],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '13:30',
			closes: '17:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '20:15',
			closes: '23:59',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

import Galeria from '../components/Galeria.astro';---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#35241d" />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" />
		<title>Mesón El Cordobés de José Peregrina | Granada</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Mesón El Cordobés de José Peregrina · Granada" />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${business.site}/og.svg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Mesón El Cordobés de José Peregrina, cocina tradicional en Granada" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.region" content="ES-GR" />
		<meta name="geo.placename" content="Granada" />
		<meta name="geo.position" content="37.180963;-3.6146884" />
		<meta name="ICBM" content="37.180963, -3.6146884" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Mesón El Cordobés de José Peregrina, inicio"><span class="brand-mark" aria-hidden="true">C</span><span>El Cordobés <small>de José Peregrina · Granada</small></span></a>
			<nav aria-label="Navegación principal"><a href="#cocina">La cocina</a><a href="#especialidades">Especialidades</a><a href="#fotos">Fotos</a><a href="#visitanos">Cómo llegar</a></nav>
			<a class="header-call" href={phoneHref}>Reservas · 958 20 80 08</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span>Granada · Andalucía</span><i aria-hidden="true"></i> Mesón tradicional</p>
					<h1 id="hero-title">El sabor de la brasa,<br />con alma <em>andaluza.</em></h1>
					<p class="lede">Carnes a la parrilla, pescados y mariscos en el Mesón El Cordobés de José Peregrina. Cocina de tradición y producto para disfrutar en familia, en el barrio de Ronda de Granada.</p>
					<div class="actions"><a class="button button-gold" href={phoneHref}>Llamar para reservar <span aria-hidden="true">↗</span></a><a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-details"><span>⌖ Calle Artesano Molero, 5</span><span>♨ Parrilla · pescado · marisco</span></div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración original de una parrilla con carnes, verduras y brasas encendidas">
					<div class="flame flame-one"></div><div class="flame flame-two"></div><div class="flame flame-three"></div><div class="ember ember-one"></div><div class="ember ember-two"></div><div class="ember ember-three"></div>
					<div class="grill"><div class="grill-mesh"></div><div class="food food-one"></div><div class="food food-two"></div><div class="food food-three"></div><span class="pepper pepper-one"></span><span class="pepper pepper-two"></span><span class="herb">✿</span></div>
					<div class="art-label"><b>Fuego y tradición</b><span>Una mesa con sabor de casa</span></div><div class="art-stamp">GRANADA<br /><strong>DESDE SIEMPRE</strong></div>
				</div>
			</section>

			<div class="ticker" aria-label="Especialidades del mesón"><span>Carnes a la parrilla</span><b>✳</b><span>Pescados</span><b>✳</b><span>Mariscos</span><b>✳</b><span>Arroces</span><b>✳</b><span>Recetas cordobesas</span></div>

			<section class="intro section-wrap" id="cocina"><div><p class="eyebrow eyebrow-dark">Un mesón de los de siempre</p><h2>Buen producto.<br /><em>Mesa compartida.</em></h2></div><div class="intro-copy"><p>José Peregrina da nombre a una casa de cocina española y andaluza en Granada. Un mesón tradicional donde conviven el fuego de la parrilla, el pescado fresco, los mariscos y los guisos de siempre, con una atención cercana que hace sentir a gusto.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Consultar reseñas y fotos en Google Maps ↗</a></div></section>

			<section class="specialties section-wrap" id="especialidades" aria-labelledby="specialties-title"><div class="section-heading"><p class="eyebrow eyebrow-dark">Tradición que se saborea</p><h2 id="specialties-title">De la parrilla<br /><em>a la sobremesa.</em></h2><p>Algunas propuestas y platos destacados en fuentes públicas y reseñas. Pregunta por la carta de temporada y la disponibilidad actual.</p></div>
				<div class="special-grid">
					<article class="special-card special-grill"><span class="special-icon" aria-hidden="true">♨</span><span class="card-kicker">A LA BRASA</span><h3>Carnes y asados</h3><p>Carnes rojas a la parrilla y asados para disfrutar con calma y buena compañía.</p></article>
					<article class="special-card special-sea"><span class="special-icon" aria-hidden="true">≈</span><span class="card-kicker">DEL MAR</span><h3>Pescado y marisco</h3><p>Producto fresco, gambas al ajillo, pulpo, calamar y sabores del Mediterráneo.</p></article>
					<article class="special-card special-rice"><span class="special-icon" aria-hidden="true">◉</span><span class="card-kicker">PARA COMPARTIR</span><h3>Arroces y paellas</h3><p>Arroces para reunirse en torno a la mesa. Consulta las variedades disponibles.</p></article>
					<article class="special-card special-stew"><span class="special-icon" aria-hidden="true">✦</span><span class="card-kicker">COCINA LENTA</span><h3>Guisos de la casa</h3><p>Recetas tradicionales como el rabo de toro, cocinadas con sabor a Andalucía.</p></article>
				</div><p class="menu-note">La carta, los precios y la disponibilidad pueden variar. Llama al mesón antes de tu visita para consultar platos y hacer una reserva.</p>
			</section>

			<section class="photo-section" id="fotos"><div class="photo-copy"><p class="eyebrow">Fotos del Mesón en Google Maps</p><h2>Asómate a la mesa<br />antes de <em>llegar.</em></h2><p>En la ficha de Google Maps puedes explorar las fotografías del salón y de sus platos, además de consultar reseñas y datos recientes del establecimiento.</p><a class="button button-gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver fotos y ficha en Google Maps <span aria-hidden="true">↗</span></a><a class="social-link" href={facebookUrl} target="_blank" rel="noopener noreferrer">Facebook del restaurante ↗</a></div>
				<div class="map-photo"><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Google Maps: ubicación del Mesón El Cordobés de José Peregrina en Granada" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
					<noscript>
						<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
					</noscript>
				</div><a class="map-caption" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span>⌖</span><span><b>Mesón El Cordobés de José Peregrina</b><small>Calle Artesano Molero, 5 · Ver fotos ↗</small></span></a></div>
			</section>

			<section class="visit section-wrap" id="visitanos"><div class="visit-copy"><p class="eyebrow eyebrow-dark">En el barrio de Ronda</p><h2>Nos vemos<br /><em>en Granada.</em></h2><p>Acércate al mesón para disfrutar de cocina tradicional, producto de mercado y una mesa para compartir.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button button-dark" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Reservar · 958 20 80 08</a></div></div>
				<div class="hours-card" id="horario"><div class="hours-title"><span class="clock" aria-hidden="true">◷</span><div><p class="eyebrow eyebrow-dark">Organiza tu visita</p><h3>Horario</h3></div></div><dl>{openingHours.map(({ day, value }) => <div class:list={[{ closed: value === 'Cerrado' }]}><dt>{day}</dt><dd>{value}</dd></div>)}</dl><p class="hours-note">Horario publicado en directorios y sujeto a cambios. Confirma el servicio por teléfono, especialmente en festivos.</p></div>
			</section>

			<section class="faq-section section-wrap" id="preguntas"><p class="eyebrow eyebrow-dark">Preguntas frecuentes</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
			<Galeria nombre="Mesón El Cordobés de José Peregrina" mapsUrl={mapsUrl} />
		</main>

		<footer class="footer"><div class="footer-top"><a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">C</span><span>El Cordobés <small>de José Peregrina · Granada</small></span></a><p>Tradición andaluza<br />y sabor a la brasa.</p><nav aria-label="Enlaces del mesón"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={facebookUrl} target="_blank" rel="noopener noreferrer">Facebook ↗</a><a href={phoneHref}>958 20 80 08</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Mesón El Cordobés de José Peregrina · Granada</span><a href="/aviso-legal/">Aviso legal y privacidad</a> <a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a> <span>Confirma horario, carta y disponibilidad con el establecimiento.</span></div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>
		<a class="mobile-call" href={phoneHref}>Reservar <span>958 20 80 08</span></a>
	</body>
</html>

<style is:global>
	:root{font-family:'DM Sans',sans-serif;color:#332b26;background:#f8f4eb;font-synthesis:none;text-rendering:optimizeLegibility;--brown:#35241d;--brown2:#57362a;--gold:#d7aa57;--cream:#f8f4eb;--ink:#332b26;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid #d7aa57;outline-offset:4px}.skip-link{position:absolute;z-index:99;top:-60px;left:16px;padding:12px 16px;background:var(--gold);color:var(--brown)}.skip-link:focus{top:12px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:22px;background:var(--brown);color:#fbf7ef}.brand{display:flex;align-items:center;gap:11px;font-size:15px;font-weight:700}.brand small{display:block;margin-top:4px;color:#decebb;font-size:9px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--gold);border-radius:50%;color:#e2c17c;font:700 23px var(--display)}.topbar nav{display:flex;gap:clamp(14px,2.5vw,32px);color:#eee6d9;font-size:12px}.topbar nav a:hover,.footer a:hover{color:#e2c17c}.header-call{padding:11px 17px;border:1px solid #ffffff50;border-radius:99px;font-size:11px;font-weight:700}.hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:560px;background:var(--brown);color:#fbf7ef;overflow:hidden}.hero-copy{padding:73px 4vw 64px 9vw;align-self:center}.eyebrow{margin:0 0 19px;color:#dcc28d;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase}.eyebrow i{display:inline-block;width:22px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.section-heading h2,.photo-copy h2,.visit h2,.faq-section h2{margin:0;font:600 clamp(39px,4.8vw,64px)/1.08 var(--display);letter-spacing:-1.2px}.hero h1 em,.intro h2 em,.section-heading h2 em,.photo-copy h2 em,.visit h2 