---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/el-turko-kebab-pizzeria-vertical-05.jpg';
import sala from '../assets/fotos/el-turko-kebab-pizzeria-apaisada-01.jpg';
import bandeja from '../assets/fotos/el-turko-kebab-pizzeria-apaisada-03.jpg';
import calle from '../assets/fotos/el-turko-kebab-pizzeria-apaisada-09.jpg';
import racion from '../assets/fotos/el-turko-kebab-pizzeria-vertical-02.jpg';
import plato from '../assets/fotos/el-turko-kebab-pizzeria-vertical-04.jpg';
import mostrador from '../assets/fotos/el-turko-kebab-pizzeria-vertical-06.jpg';
import bocadito from '../assets/fotos/el-turko-kebab-pizzeria-vertical-07.jpg';
import pincho from '../assets/fotos/el-turko-kebab-pizzeria-vertical-08.jpg';
import escaparate from '../assets/fotos/el-turko-kebab-pizzeria-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'EL TURKO KEBAB PIZZERIA · Döner kebab y pizza en Escaldes-Engordany';
const description =
	'EL TURKO KEBAB PIZZERIA, en la Av. Carlemany, 53, de Escaldes-Engordany (AD700). Döner kebab, platos de kebab y pizza, todos los días de 11:30 a 24:00. 4,1 sobre 5 con 658 reseñas. Teléfono +376 838 127.';

/** Importes leídos en la pizarra del mostrador y en el cartel de la fachada. */
const MENU = [
	{
		title: 'Kebab y platos',
		items: [
			{ name: 'Durum', note: 'kebab enrollado en tortilla, del cartel del local', price: '6,50 €' },
			{ name: 'Piat Kebab', note: 'plato de kebab con sus guarniciones', price: '11,50 €' },
			{ name: 'Piat Alotes', note: 'el plato con alitas de pollo', price: '11,50 €' },
			{ name: 'Kapsalon', note: 'patatas, kebab y gratinado', price: '11,50 €' },
		],
	},
	{
		title: 'Pizza Napoli',
		items: [
			{ name: 'Margarita', note: 'salsa de tomate, mozzarella y orégano', price: '7,90 €' },
			{ name: 'Atún', note: 'salsa de tomate, mozzarella, atún, cebolla y orégano', price: '9,90 €' },
			{ name: 'Quatro Quesos', note: 'salsa de tomate, cuatro quesos y orégano', price: '9,90 €' },
			{ name: 'Kebab', note: 'salsa de tomate, mozzarella, carne kebab mixto y orégano', price: '10,90 €' },
			{
				name: 'Fruits de Mar',
				note: 'salsa de tomate, mozzarella, gambas, atún y calamares',
				price: '12,90 €',
			},
		],
	},
];

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de El Turko en la Av. Carlemany, con el toldo rojo de «El Turko Döner Kebab», el teléfono 838 127 y el cartel de servei a domicili',
	},
	{
		src: mostrador,
		alt: 'El mostrador de El Turko con los dos pinchos de döner girando, la vitrina de ingredientes y la pizarra de pizzas iluminada',
	},
	{
		src: escaparate,
		alt: 'El escaparate del local de noche, con el cartel luminoso de kebab y pizza, el menú con los precios y los panes en la vitrina',
	},
	{
		src: sala,
		alt: 'El comedor de El Turko: paredes rosas, arcos de piedra oscura, mesas de madera y sillas de listones con mantelería',
	},
	{
		src: pincho,
		alt: 'Detalle del pincho de döner de pollo dorado en el asador vertical del local',
	},
	{
		src: racion,
		alt: 'Una bandeja de kebab con patatas fritas, alita, ensalada de col y tomate, y un durum en primer plano envuelto en papel',
	},
	{
		src: plato,
		alt: 'Un plato de ensalada con lechuga, col lombarda, zanahoria, tomate y queso fresco, junto a dos durums envueltos en papel de aluminio',
	},
	{
		src: bandeja,
		alt: 'Una bandeja para llevar con alitas de pollo, patatas fritas, hamburguesa, ensalada y un vasito de salsa blanca',
	},
	{
		src: bocadito,
		alt: 'Un durum mordido en la mano, con la carne de kebab, lechuga y salsa a la vista',
	},
	{
		src: calle,
		alt: 'La avenida Carlemany vista desde la acera, con los edificios de Escaldes-Engordany y el cartel de restaurante turco al fondo',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de El Turko',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			offers: {
				'@type': 'Offer',
				price: item.price.replace(' €', '').replace(',', '.'),
				priceCurrency: 'EUR',
			},
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-turko`,
	name: BUSINESS.fullName,
	alternateName: ['El Turko', 'El Turko Kebab', 'El Turko Döner Kebab', 'El Turko Escaldes'],
	description:
		'Restaurante de döner kebab y pizza en la Av. Carlemany, 53, de Escaldes-Engordany, abierto todos los días de 11:30 a 24:00.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376838127',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Döner kebab', 'Pizza', 'Cocina turca'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:30',
			closes: '24:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"el-turko-kebab-pizzeria-apaisada-01.jpg": sala,
	"el-turko-kebab-pizzeria-vertical-05.jpg": fachada,
	"el-turko-kebab-pizzeria-vertical-06.jpg": mostrador,
	"el-turko-kebab-pizzeria-vertical-10.jpg": escaparate,
	"el-turko-kebab-pizzeria-vertical-08.jpg": pincho,
	"el-turko-kebab-pizzeria-vertical-02.jpg": racion,
	"el-turko-kebab-pizzeria-vertical-04.jpg": plato,
	"el-turko-kebab-pizzeria-apaisada-03.jpg": bandeja,
	"el-turko-kebab-pizzeria-vertical-07.jpg": bocadito,
	"el-turko-kebab-pizzeria-apaisada-09.jpg": calle,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#241318" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Manrope:wght@400;600;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="El Turko Andorra, kebab Escaldes-Engordany, döner kebab Andorra, pizza Escaldes, Av. Carlemany 53, El Turko Döner Kebab, kebab a domicilio Escaldes"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Döner kebab, platos de kebab y pizza en la Av. Carlemany, 53, Escaldes-Engordany. 4,1 sobre 5 con 658 reseñas. Todos los días de 11:30 a 24:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de El Turko Döner Kebab en la avenida Carlemany de Escaldes-Engordany"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#241318"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="AD-08"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.city}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[sala]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Turko"
			subtitle="Döner kebab · Escaldes"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="El Turko"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario, valoración, precios y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Los importes son los del cartel del local: confírmalos por teléfono."
			ctaLabel="Llamar a El Turko"
			navAriaLabel="Enlaces de EL TURKO KEBAB PIZZERIA"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
