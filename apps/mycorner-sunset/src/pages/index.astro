---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/mycorner-sunset-fachada.jpg';
import brunch from '../assets/fotos/mycorner-sunset-brunch-salmon.jpg';
import gofre from '../assets/fotos/mycorner-sunset-gofre.jpg';
import colada from '../assets/fotos/mycorner-sunset-pina-colada.jpg';
import mesa from '../assets/fotos/mycorner-sunset-mesa-brunch.jpg';
import matcha from '../assets/fotos/mycorner-sunset-matcha.jpg';
import bocadillo from '../assets/fotos/mycorner-sunset-bocadillo.jpg';
import cafes from '../assets/fotos/mycorner-sunset-cafes.jpg';
import compartir from '../assets/fotos/mycorner-sunset-brunch-compartir.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'MYCORNER SUNSET · Brunch y cócteles en Andorra la Vella';
const description =
	"MYCORNER SUNSET • Brunch & Cocktails, Av. Consell d'Europa, 14 (Edifici Quars, planta baja), AD500 Andorra la Vella. Brunch todo el día, gofres, matcha y cócteles. 4,7 sobre 5 con 90 reseñas. Abre todos los días de 9:30 a 21:30.";

const galeria = [
	{
		src: brunch,
		alt: 'Plato de brunch con dos huevos, salmón ahumado, aguacate, tostadas y ensalada',
	},
	{
		src: gofre,
		alt: 'Gofre con chocolate, crema de cacahuete, fresas y azúcar glas',
	},
	{
		src: colada,
		alt: 'Piña colada en vaso alto con piña deshidratada, junto a otros cócteles',
	},
	{
		src: compartir,
		alt: 'Mesa con platos de brunch, hamburguesa con patatas y zumos verdes',
	},
	{
		src: matcha,
		alt: 'Matcha latte con dibujo de flor en la espuma, en taza de MYCORNER',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo de ciabatta con patatas fritas y ensalada',
	},
	{
		src: cafes,
		alt: 'Dos cafés en bandeja de madera: matcha latte y flat white',
	},
	{
		src: mesa,
		alt: 'Mesa de mármol verde con el brunch de la casa, junto a los sofás del local',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que se sirve en MYCORNER SUNSET',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#mycorner-sunset`,
	name: BUSINESS.fullName,
	alternateName: ['MYCORNER SUNSET', 'My Corner Sunset', 'MYCORNER Andorra'],
	description:
		"Brunch y coctelería en Andorra la Vella: huevos con salmón y aguacate, gofres, bocadillos, matcha y cócteles en un local acristalado de la Avinguda del Consell d'Europa.",
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376828800',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Brunch', 'Café', 'Cócteles'],
	areaServed: [
		{ '@type': 'City', name: 'Andorra la Vella' },
		{ '@type': 'AdministrativeArea', name: 'Andorra' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:30',
			closes: '21:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f2438" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=DM+Serif+Display:ital@0;1&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="MYCORNER SUNSET Andorra, brunch Andorra la Vella, cocktails Andorra, brunch todo el día Andorra, matcha Andorra, gofres Andorra la Vella, Consell d'Europa brunch"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Brunch todo el día, gofres, matcha y cócteles en un local acristalado de Andorra la Vella. 4,7 en Google con 90 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Mesa de brunch de MYCORNER SUNSET con huevos, salmón, tostadas y zumos verdes"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#2f2438"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-07"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="MYCORNER SUNSET"
			subtitle="Brunch & Cocktails · Andorra la Vella"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. Consell d'Europa, 14 · Andorra la Vella"
				title="Brunch de día, <br /><em>cócteles al atardecer.</em>"
				lede={`MYCORNER SUNSET es el local acristalado de la Avinguda del Consell d'Europa, con el neón rosa en el ventanal y sofás junto al cristal. Sirve brunch de 9:30 a 21:30 sin descanso: huevos con salmón y aguacate, gofres, bocadillos, matcha y cócteles. Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				image={fachada}
				imageAlt="Fachada acristalada de MYCORNER SUNSET con el neón rosa al atardecer"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>9:30–21:30</b> · todos los días' },
					{ label: 'Servicio', html: '<b>Brunch</b> · y cócteles' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Brunch & Cocktails"
			/>

			<LocalChips label="Lo que ofrece MYCORNER SUNSET" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Cristal, neón rosa <br /><em>y sofás.</em>"
				paragraphs={[
					"MYCORNER SUNSET está en la planta baja del Edifici Quars, en la Avinguda del Consell d'Europa, 14, en Andorra la Vella. La ficha de Google lo sitúa en las coordenadas 42.508846, 1.529973. El teléfono es un fijo andorrano, el +376 828 800.",
					'El local es una esquina acristalada a pie de calle: el ventanal ocupa toda la fachada, con un letrero de neón rosa que dice MYCORNER y una guirnalda de luces onduladas por dentro. Al fondo hay una barra de madera, y junto al cristal, un banco corrido con cojines grises y mesas de mármol verde.',
					'La cocina es de brunch y no se limita a la mañana: huevos fritos con salmón ahumado, aguacate y tostadas; huevos sobre pan de semillas; bocadillos de ciabatta con patatas; hamburguesa con patatas y zanahoria frita. Para el dulce, el gofre con chocolate, crema de cacahuete y fresas.',
					`Para beber hay café de especialidad y matcha latte con dibujo en la espuma, además de la coctelería que da nombre al local: piña colada, margaritas y cócteles de fruta. La ficha lo clasifica como restaurante de brunch, con ${RATING.count} reseñas y una media de ${RATING.label} sobre 5 (noviembre de 2026).`,
				]}
				note="La ficha no publica carta ni precios. Los platos y bebidas que aparecen en esta página son los que se ven en las fotos del perfil; los importes y la disponibilidad se confirman en el local."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> La casa</p>
					<h2 id="highlights-title">Brunch, café <br /><em>y coctelería.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Huevos, gofres <br /><em>y piña colada.</em>"
				description="Una selección de lo que aparece en las fotos del perfil del local, en cuatro bloques. No es la carta completa: cambia con la temporada y no está publicada."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note={`Para preguntar por la carta del día, alérgenos o reservas, el teléfono es el ${BUSINESS.phone}. Los precios no se copian aquí porque la ficha no los publica y pueden cambiar.`}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El brunch, los cafés <br /><em>y los cócteles.</em>"
				description="Ocho fotografías del perfil de MYCORNER SUNSET: el plato de huevos con salmón y aguacate, el gofre, la piña colada, la mesa de brunch para compartir, el matcha latte, el bocadillo de ciabatta, los dos cafés y la mesa junto a los sofás."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,7 sobre 5, <em>con 90 reseñas.</em></h2>
						<p>
							Una ficha joven, con 90 opiniones: suficiente para saber que el brunch y el trato
							funcionan, pero todavía con margen. El local se clasifica como restaurante de brunch y
							abre todos los días de la semana.
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer todas las reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,7</strong>
						<span>★★★★★</span>
						<small>90 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Consell d'Europa, <br /><em>a pie de calle.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Principado de Andorra',
				]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de 9:30 a 21:30 todos los días de la semana, sin día de descanso. ${HORARIO_AVISO}`}
				mapTitle="Mapa de MYCORNER SUNSET en la Avinguda del Consell d'Europa, Andorra la Vella"
				mapEmbedUrl={MAPS.embed}
				mapLabel={`${BUSINESS.street} · Andorra la Vella`}
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote={`Se atiende por teléfono en el ${BUSINESS.phone}: el local no tiene web propia ni reservas online. La ficha no da datos de aparcamiento; al estar en el centro de Andorra la Vella, lo práctico es ir andando.`}
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma carta, precios y horario antes de ir."
			ctaLabel="Llamar a MYCORNER SUNSET"
			navAriaLabel="Enlaces de MYCORNER SUNSET"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
