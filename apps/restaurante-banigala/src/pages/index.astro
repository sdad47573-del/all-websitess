---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import mesa from '../assets/fotos/restaurante-banigala-apaisada-06.jpg';
import fachadaNoite from '../assets/fotos/restaurante-banigala-apaisada-01.jpg';
import fachadaDia from '../assets/fotos/restaurante-banigala-vertical-05.jpg';
import letreiro from '../assets/fotos/restaurante-banigala-apaisada-03.jpg';
import ruaNoite from '../assets/fotos/restaurante-banigala-vertical-08.jpg';
import tandoori from '../assets/fotos/restaurante-banigala-vertical-04.jpg';
import caril from '../assets/fotos/restaurante-banigala-apaisada-10.jpg';
import doces from '../assets/fotos/restaurante-banigala-apaisada-07.jpg';
import cartaz from '../assets/fotos/restaurante-banigala-vertical-09.jpg';
import cliente from '../assets/fotos/restaurante-banigala-vertical-02.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICOS } from '../data/site';

const title = 'BaniGala · Paquistanês halal na Mouraria, Lisboa';
const description =
	'BaniGala RESTAURANTE Lisbon, na Rua do Benformoso, 230, na Mouraria. Cozinha paquistanesa halal: biryani, caril, daal e tandoori por 5 €, todos os dias.';

const galeria = [
	{
		src: fachadaNoite,
		alt: 'Fachada do BaniGala à noite na Rua do Benformoso, com o letreiro iluminado e cartazes de comida',
	},
	{
		src: cartaz,
		alt: 'Cartaz do BaniGala com os pratos a 5 euros, as bebidas e os doces da casa',
	},
	{
		src: tandoori,
		alt: 'Pedaços de frango tandoori numa travessa preta, com coentros por cima',
	},
	{
		src: caril,
		alt: 'Tigela de caril com coentros, prato de salada e uma tigela de raita numa mesa escura',
	},
	{
		src: cliente,
		alt: 'Cliente à mesa junto à janela do BaniGala, com um mural de arquitetura mogol ao fundo',
	},
	{
		src: fachadaDia,
		alt: 'Entrada do BaniGala de dia, com o letreiro da casa e os cartazes de pratos na parede',
	},
	{
		src: doces,
		alt: 'Vitrine de doces com barras de leite, halwa e bolinhas em calda, na entrada do restaurante',
	},
	{
		src: letreiro,
		alt: 'Letreiro do BaniGala com a morada, a Rua do Benformoso, 230, em Lisboa',
	},
	{
		src: ruaNoite,
		alt: 'Rua do Benformoso à noite, com o letreiro do BaniGala ao fundo e um homem em primeiro plano',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta do BaniGala',
	inLanguage: 'pt-PT',
	url: `${BUSINESS.siteUrl}/#carta`,
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#banigala`,
	name: 'BaniGala RESTAURANTE Lisbon',
	alternateName: ['BaniGala', 'Bani Gala Lisbon', 'Restaurante BaniGala'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 939 201 733',
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Cozinha paquistanesa', 'Cozinha asiática'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Distrito de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:15',
			closes: '23:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Lugares para pessoas em cadeiras de rodas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'WC acessível a pessoas em cadeiras de rodas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0b2f1a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Rozha+One&family=DM+Sans:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name="BaniGala RESTAURANTE Lisbon"
			description={description}
			keywords="BaniGala, Bani Gala Lisboa, restaurante paquistanês Lisboa, comida halal Mouraria, biryani Lisboa, caril paquistanês, tandoori Mouraria, Rua do Benformoso"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cozinha paquistanesa halal na Rua do Benformoso, 230, na Mouraria. Biryani, caril, daal e tandoori por 5 euros, com três pães do tandoor."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Mesa do BaniGala com caris, naan, arroz e frango tandoori"
			ogImageWidth={1200}
			ogImageHeight={630}
			author="BaniGala RESTAURANTE Lisbon"
			themeColor="#0b2f1a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lisboa"
			locale="pt_PT"
			countryName="Portugal"
			preload={[mesa]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="BaniGala"
			subtitle="Paquistanês · Mouraria"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow="Rua do Benformoso, 230 · Mouraria, Lisboa"
				title="Biryani, caril <br /><em>e pão do tandoor.</em>"
				lede="O BaniGala está na Rua do Benformoso, 230, na Mouraria, entre o Martim Moniz e o Intendente. Cozinha paquistanesa halal: qualquer prato por 5 €, com três pães do tandoor incluídos. Todos os dias, das 09:15 às 23:30, com 4,6 sobre 5 no Google."
				image={mesa}
				imageAlt="Mesa do BaniGala com tigelas de caril, naan, arroz basmati e frango tandoori"
				primaryCta={{ label: `Ligar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha e críticas no Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> no Google · 754 críticas' },
					{ label: 'Horário', html: '<b>09:15–23:30</b> todos os dias' },
					{ label: 'Preço', html: '<b>5 €</b> por prato, com 3 pães do tandoor' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto do perfil de Google Maps"
				galleryLinkLabel="Ver a galeria"
			/>

			<LocalChips label="O que oferece o BaniGala" items={SERVICOS} />

			<LocalAbout
				label="A casa"
				title="Uma casa <br /><em>da Mouraria.</em>"
				paragraphs={[
					'O BaniGala fica na Rua do Benformoso, 230, na Mouraria, uma rua conhecida pelos restaurantes do sul da Ásia, a poucos minutos do Martim Moniz. Na fachada, um letreiro preto com o nome da casa, o retrato de um homem e o nome também em urdu; na parede ao lado, cartazes com os pratos.',
					'Lá dentro, a sala é simples, de mesas de tampo escuro, e há um mural com uma construção de arcadas. À entrada, uma vitrine mostra os doces do dia: barras de leite, bolinhas em calda e halwa.',
					'A cozinha é paquistanesa e halal, como a casa se descreve na ficha de Google. O cartaz da porta resume a proposta: «any dish in €5 including 3 tandoori bread» — biryani de frango, caril de frango, caril de borrego, daal maash, daal chana e legumes, todos a 5 euros, com três pães do tandoor.',
					'As críticas destacam as doses e o preço: «comida muito boa, doses generosas e empregados muito simpáticos e disponíveis» e «restaurante típico com muito bom preço».',
				]}
				note="4,6 sobre 5 com 754 críticas no Google. A casa descreve-se na ficha como restaurante halal."
				links={[
					{ label: 'Ficha e críticas no Google', href: MAPS.reviews, external: true },
					{ label: 'Como chegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="A carta"
				title="Tudo a 5 €, <br /><em>com pão.</em>"
				description="O cartaz da casa: biryani, caris, lentilhas, grão-de-bico e legumes, cada prato por 5 euros e com três pães do tandoor. As bebidas e os doces fecham a lista."
				cta={{ label: `Ligar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Preços copiados do cartaz exposto pela casa, em euros. Cada prato da lista de 5 euros inclui três pães do tandoor. O frango tandoori e os doces aparecem nas fotografias sem preço no cartaz: os doces são vendidos ao quilograma. Confirma a carta no restaurante."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Nove fotografias <br /><em>da casa.</em>"
				description="As fotografias do perfil do BaniGala no Google Maps: a fachada à noite, o cartaz dos preços, o frango tandoori, o caril, a sala, a vitrine dos doces e a rua."
				images={galeria}
				cta={{ label: 'Ver tudo no Google Maps', href: MAPS.place }}
				note="Imagens alojadas nesta página e provenientes do perfil do estabelecimento em Google Maps. Se tens os direitos de alguma e queres retirá-la, diz-nos e apagamo-la."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="À mesa, <br /><em>na Mouraria.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Lisboa, Portugal']}
				hours={HOURS}
				hoursCaption="Horário"
				hoursNote="Horário publicado na ficha de Google: todos os dias, das 09:15 às 23:30, sem dia de fecho. Convém confirmá-lo antes de ir, sobretudo em feriados."
				mapTitle="Mapa do BaniGala na Rua do Benformoso, 230, em Lisboa"
				mapEmbedUrl={MAPS.embed}
				mapLabel="BaniGala · Rua do Benformoso"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Como chegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Críticas no Google', href: MAPS.reviews, external: true },
				]}
				contactLink={{ label: `Ligar para o ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="A casa não tem página de reservas online: o contacto publicado na ficha é o telefone, que o cartaz indica também para chamadas e WhatsApp. A ficha assinala lugares e WC acessíveis a pessoas em cadeiras de rodas."
			/>

			<LocalFaq items={FAQ} eyebrow="Perguntas frequentes" title="Antes de <em>vir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="BaniGala RESTAURANTE Lisbon"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografias do perfil do estabelecimento em Google Maps. Carta e preços do cartaz da casa; confirma horário e valores antes da visita."
			ctaLabel="Ligar ao BaniGala"
			navAriaLabel="Ligações do BaniGala"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
