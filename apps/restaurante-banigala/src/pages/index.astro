---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import mesa from '../assets/fotos/restaurante-banigala-apaisada-06.jpg';
import fachadaNoite from '../assets/fotos/restaurante-banigala-apaisada-01.jpg';
import fachadaDia from '../assets/fotos/restaurante-banigala-vertical-05.jpg';
import letreiro from '../assets/fotos/restaurante-banigala-apaisada-03.jpg';
import ruaNoite from '../assets/fotos/restaurante-banigala-vertical-08.jpg';
import tandoori from '../assets/fotos/restaurante-banigala-vertical-04.jpg';
import caril from '../assets/fotos/restaurante-banigala-apaisada-10.jpg';
import doces from '../assets/fotos/restaurante-banigala-apaisada-07.jpg';
import cartaz from '../assets/fotos/restaurante-banigala-vertical-09.jpg';
import cliente from '../assets/fotos/restaurante-banigala-vertical-02.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICOS,
} from '../data/site';

const title = 'BaniGala · Paquistanês halal na Mouraria, Lisboa';
const description =
	'BaniGala RESTAURANTE Lisbon, na Rua do Benformoso, 230, na Mouraria. Cozinha paquistanesa halal: biryani, caril, daal e tandoori por 5 €, todos os dias.';

const galeria = [
	{
		src: fachadaNoite,
		alt: 'Fachada do BaniGala à noite na Rua do Benformoso, com o letreiro iluminado e cartazes de comida',
	},
	{
		src: cartaz,
		alt: 'Cartaz do BaniGala com os pratos a 5 euros, as bebidas e os doces da casa',
	},
	{
		src: tandoori,
		alt: 'Pedaços de frango tandoori numa travessa preta, com coentros por cima',
	},
	{
		src: caril,
		alt: 'Tigela de caril com coentros, prato de salada e uma tigela de raita numa mesa escura',
	},
	{
		src: cliente,
		alt: 'Cliente à mesa junto à janela do BaniGala, com um mural de arquitetura mogol ao fundo',
	},
	{
		src: fachadaDia,
		alt: 'Entrada do BaniGala de dia, com o letreiro da casa e os cartazes de pratos na parede',
	},
	{
		src: doces,
		alt: 'Vitrine de doces com barras de leite, halwa e bolinhas em calda, na entrada do restaurante',
	},
	{
		src: letreiro,
		alt: 'Letreiro do BaniGala com a morada, a Rua do Benformoso, 230, em Lisboa',
	},
	{
		src: ruaNoite,
		alt: 'Rua do Benformoso à noite, com o letreiro do BaniGala ao fundo e um homem em primeiro plano',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta do BaniGala',
	inLanguage: 'pt-PT',
	url: `${BUSINESS.siteUrl}/#carta`,
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#banigala`,
	name: 'BaniGala RESTAURANTE Lisbon',
	alternateName: ['BaniGala', 'Bani Gala Lisbon', 'Restaurante BaniGala'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 939 201 733',
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Cozinha paquistanesa', 'Cozinha asiática'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Distrito de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:15',
			closes: '23:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Lugares para pessoas em cadeiras de rodas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'WC acessível a pessoas em cadeiras de rodas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-banigala-apaisada-06.jpg": mesa,
	"restaurante-banigala-apaisada-01.jpg": fachadaNoite,
	"restaurante-banigala-vertical-09.jpg": cartaz,
	"restaurante-banigala-vertical-04.jpg": tandoori,
	"restaurante-banigala-apaisada-10.jpg": caril,
	"restaurante-banigala-vertical-02.jpg": cliente,
	"restaurante-banigala-vertical-05.jpg": fachadaDia,
	"restaurante-banigala-apaisada-07.jpg": doces,
	"restaurante-banigala-apaisada-03.jpg": letreiro,
	"restaurante-banigala-vertical-08.jpg": ruaNoite,
};
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0b2f1a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Rozha+One&family=DM+Sans:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name="BaniGala RESTAURANTE Lisbon"
			description={description}
			keywords="BaniGala, Bani Gala Lisboa, restaurante paquistanês Lisboa, comida halal Mouraria, biryani Lisboa, caril paquistanês, tandoori Mouraria, Rua do Benformoso"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cozinha paquistanesa halal na Rua do Benformoso, 230, na Mouraria. Biryani, caril, daal e tandoori por 5 euros, com três pães do tandoor."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Mesa do BaniGala com caris, naan, arroz e frango tandoori"
			ogImageWidth={1200}
			ogImageHeight={630}
			author="BaniGala RESTAURANTE Lisbon"
			themeColor="#0b2f1a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lisboa"
			locale="pt_PT"
			countryName="Portugal"
			preload={[mesa]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="BaniGala"
			subtitle="Paquistanês · Mouraria"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="BaniGala RESTAURANTE Lisbon"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografias do perfil do estabelecimento em Google Maps. Carta e preços do cartaz da casa; confirma horário e valores antes da visita."
			ctaLabel="Ligar ao BaniGala"
			navAriaLabel="Ligações do BaniGala"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
