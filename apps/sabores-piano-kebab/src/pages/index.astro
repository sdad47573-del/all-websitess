---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import cocina from '../assets/fotos/sabores-piano-kebab-apaisada-01.jpg';
import mostrador from '../assets/fotos/sabores-piano-kebab-apaisada-02.jpg';
import calzones from '../assets/fotos/sabores-piano-kebab-apaisada-10.jpg';
import calzone from '../assets/fotos/sabores-piano-kebab-cuadrada-03.jpg';
import platoKebab from '../assets/fotos/sabores-piano-kebab-vertical-04.jpg';
import pincho from '../assets/fotos/sabores-piano-kebab-vertical-05.jpg';
import durumCoche from '../assets/fotos/sabores-piano-kebab-vertical-06.jpg';
import durum from '../assets/fotos/sabores-piano-kebab-vertical-07.jpg';
import pollo from '../assets/fotos/sabores-piano-kebab-vertical-08.jpg';
import curry from '../assets/fotos/sabores-piano-kebab-vertical-09.jpg';

import { BUSINESS, FAQ, HOURS, HORARIO_AVISO, MAPS, MENU, RATING, SERVICIOS } from '../data/site';

const title = 'Sabores Piano Kebab · kebab, dürüm y calzone en la Ronda de Calatrava, Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: platoKebab,
		alt: 'Plato de kebab con carne de döner, patatas fritas, ensalada y salsa de ajo y picante',
	},
	{
		src: pincho,
		alt: 'Pincho de döner girando junto a la campana de la cocina, con la carne dorada',
	},
	{
		src: calzone,
		alt: 'Calzone recién horneado con la masa dorada y espolvoreado de orégano',
	},
	{
		src: calzones,
		alt: 'Dos calzones en sus cajas abiertas con una bandeja de patatas y dos refrescos',
	},
	{
		src: durum,
		alt: 'Dürüm de kebab abierto por la mitad, con carne, lechuga y tomate',
	},
	{
		src: durumCoche,
		alt: 'Dürüm de kebab envuelto en papel, con la carne y la verdura a la vista',
	},
	{
		src: pollo,
		alt: 'Medio pollo a la brasa con arroz, patatas y ensalada en el mismo plato',
	},
	{
		src: curry,
		alt: 'Curry de pollo con verduras, pan naan y ensalada de cebolla morada',
	},
	{
		src: mostrador,
		alt: 'Barra del local bajo los carteles de precios, con la freidora y la caja registradora',
	},
	{
		src: cocina,
		alt: 'Cocina con el pincho de döner en el asador y el mostrador de trabajo al fondo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#sabores-piano-kebab`,
	name: BUSINESS.name,
	alternateName: ['Piano Kebab', 'Sabores Piano Kebab Ciudad Real'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Turca', 'Kebab', 'Pizza', 'Bocadillos'],
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Feature ID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google kgmid', value: BUSINESS.channel },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#16181f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Sabores Piano Kebab Ciudad Real, kebab Ronda de Calatrava, dürüm Ciudad Real, calzone Ciudad Real, pizza kebab 13003, restaurante turco Ciudad Real, falafel, pollo a la brasa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Kebab, dürüm, calzone y pizza en la Ronda de Calatrava, 14, de Ciudad Real. 2,8 sobre 5 con 811 reseñas en Google. Teléfono 926 92 22 87."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Plato de kebab de Sabores Piano Kebab"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#16181f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[platoKebab]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Kebab, dürüm y calzone en la Ronda"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Kebab <br /><em>al corte.</em>"
				lede={`Sabores Piano Kebab está en la Ronda de Calatrava, 14, en Ciudad Real. Restaurante turco y bocatería: döner en plato, dürüm y bocadillo, calzone y pizza de horno, falafel, pollo a la brasa y curry con pan naan. La ficha de Google le da 2,8 sobre 5 con 811 reseñas.`}
				image={platoKebab}
				imageAlt="Plato de kebab con carne de döner, patatas, ensalada y salsa de ajo y picante"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>2,8</b> en Google · 811 reseñas' },
					{
						label: 'Horario',
						html: '<b>No publicado</b><br />La ficha no da horas: llama antes',
					},
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> mesa y encargos` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Sabores Piano Kebab" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Turco <br /><em>y bocatería.</em>"
				paragraphs={[
					'Sabores Piano Kebab ocupa el número 14 de la Ronda de Calatrava, en Ciudad Real, en la acera de los bloques que bajan hacia la ronda. Google lo clasifica con dos etiquetas, «Restaurante turco» y «Bocatería», y la ficha no publica horario, carta con precios ni web propia.',
					'El centro del local es el asador: dos fotos del perfil enseñan el pincho de döner girando junto a la campana, con la carne ya dorada por fuera. De ahí salen el plato de kebab con patatas, ensalada y las dos salsas de siempre, el dürüm enrollado en tortilla de trigo y el bocadillo en pan de barra.',
					'El horno tiene su propia parroquia: calzone de masa cerrada y rellena, que se sirve en menú con patatas y refresco, y pizzas. Una de las reseñas destacadas lo cuenta con cifras: «Dos menús calzone grandes que incluyen patatas con dos salsas y refrescos, 22€». También hay patty, alitas, nuggets y aros para completar la mesa.',
					'Fuera del kebab, la casa hace pollo a la brasa con arroz y ensalada, curry de pollo con pan naan y un dürüm de falafel para quien no come carne. La media de la ficha es 2,8 sobre 5 con 811 reseñas, baja para el volumen que tiene: las tres que Google destaca son de cuatro y cinco estrellas, y esta web deja la nota tal cual para que cada uno lea el conjunto.',
				]}
				note="Los datos salen de la ficha pública de Google Maps y de las fotos y reseñas del perfil. La ficha no publica horario ni carta con precios: esta web no se los inventa. Para horario y encargos, el teléfono es el 926 92 22 87."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Döner, horno <br /><em>y brasa.</em>"
				description="Los platos que aparecen aquí son los que enseñan las fotos del perfil, los carteles de la pared y las reseñas. El local no publica la carta con precios."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="La ficha de Google no publica precios y esta página no los inventa. La única cifra que aparece en el perfil es la de una reseña (dos menús de calzone por 22 €), que se cita como opinión y no como tarifa."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Diez fotos <br /><em>del local.</em>"
				description="Las fotografías del perfil de Sabores Piano Kebab en Google Maps: el pincho de döner, el plato de kebab, los dürüm, los calzones, el pollo a la brasa, el curry con naan y la barra con los carteles de precios."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ronda de <br /><em>Calatrava.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Castilla-La Mancha, España']}
				hours={HOURS}
				hoursCaption="Horario y datos"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de Sabores Piano Kebab en la Ronda de Calatrava 14, Ciudad Real"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Sabores Piano Kebab"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. El local no publica web propia ni sistema de reservas, así que el teléfono es el canal directo para preguntar horario, reservar mesa o encargar kebab y calzone para llevar."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y precios antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Sabores Piano Kebab"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
