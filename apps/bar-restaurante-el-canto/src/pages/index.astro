---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/bar-restaurante-el-canto-apaisada-01.jpg';
import comedor from '../assets/fotos/bar-restaurante-el-canto-apaisada-06.jpg';
import bocadillo from '../assets/fotos/bar-restaurante-el-canto-apaisada-04.jpg';
import filete from '../assets/fotos/bar-restaurante-el-canto-vertical-05.jpg';
import olivas from '../assets/fotos/bar-restaurante-el-canto-panoramica-09.jpg';
import almendras from '../assets/fotos/bar-restaurante-el-canto-apaisada-10.jpg';
import carajillo from '../assets/fotos/bar-restaurante-el-canto-vertical-03.jpg';
import postre from '../assets/fotos/bar-restaurante-el-canto-apaisada-02.jpg';

import { cidUrl, mapsUrl, placeId, reviewsUrl } from '../maps';

const business = {
	name: 'Bar Restaurante El Cantó',
	brand: 'El Cantó',
	street: 'Carrer la Via, 6',
	city: 'Les Alqueries',
	region: 'Castelló',
	postalCode: '12530',
	phone: '964 51 36 47',
	latitude: 39.8977408,
	longitude: -0.1038519,
	rating: 4.4,
	reviewsCount: 232,
	site: 'https://bar-restaurante-el-canto.vercel.app',
};

const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34964513647';

const description =
	'Bar Restaurante El Cantó, en Les Alqueries (Castelló): almuerzos, cocina casera, arroces y plancha hasta las cuatro, con terraza y comedor.';

const servicios = [
	'Almuerzos',
	'Cocina casera',
	'Arroces',
	'Sepia a la plancha',
	'Carnes a la plancha',
	'Bocadillos',
	'Café y carajillo',
	'Terraza',
	'Comedor',
	'Reservas por teléfono',
];

const grupos = [
	{
		title: 'Para picar',
		items: [
			{
				name: 'Olivas de la casa',
				note: 'en aceitera metálica, lo primero que llega a la mesa',
			},
			{
				name: 'Almendras tostadas',
				note: 'en plato pequeño, con la primera bebida',
			},
		],
	},
	{
		title: 'Almuerzos y bocadillos',
		items: [
			{
				name: 'Bocadillo de la barra',
				note: 'en pan de pueblo, con el relleno del día; la ficha no publica la lista',
			},
			{
				name: 'Almuerzo con huevo y patatas',
				note: 'el clásico de media mañana en la comarca, a cualquier hora de la mañana',
			},
		],
	},
	{
		title: 'De cuchara y de arroz',
		items: [
			{
				name: 'Arroces de la casa',
				note: '«recomiendo arroces y sepia», resume una reseña de la ficha',
			},
			{
				name: 'Cocina casera del día',
				note: 'guisos de temporada; lo que hay cada día se pregunta en la barra',
			},
		],
	},
	{
		title: 'A la plancha',
		items: [
			{
				name: 'Filete con patatas',
				note: 'a la plancha, con salsa de la casa y patatas fritas',
			},
			{
				name: 'Sepia a la plancha',
				note: 'a la plancha con alioli; la citan varias reseñas',
			},
		],
	},
	{
		title: 'Postre y café',
		items: [
			{
				name: 'Postre de crema de la casa',
				note: 'crema fría servida en cuenco de cristal, con galleta',
			},
			{
				name: 'Carajillo',
				note: 'en vaso de caña, el café de después de comer en la barra',
			},
		],
	},
];

const galeria = [
	{
		src: comedor,
		alt: "Comedor de Bar Restaurante El Cantó con mesas de madera y la barra al fondo, en Les Alqueries",
	},
	{
		src: bocadillo,
		alt: "Bocadillo de la barra en pan de pueblo servido en un plato, en El Cantó",
	},
	{
		src: filete,
		alt: "Filete a la plancha con salsa y patatas fritas en Bar Restaurante El Cantó",
	},
	{
		src: olivas,
		alt: "Olivas en aceitera metálica en la mesa de Bar Restaurante El Cantó",
	},
	{
		src: almendras,
		alt: "Almendras tostadas en un plato alargado, el aperitivo de la barra de El Cantó",
	},
	{
		src: postre,
		alt: "Postre de crema fría con galleta en cuenco de cristal, en El Cantó",
	},
	{
		src: carajillo,
		alt: "Carajillo en vaso de caña sobre su plato, en Bar Restaurante El Cantó",
	},
];

const faqs = [
	{
		q: '¿Dónde está Bar Restaurante El Cantó?',
		a: "En el número 6 de la calle la Via, en Les Alqueries (12530), en la Plana Baixa. Es un bajo de ladrillo con el rótulo rojo de «Bar Rte. El Cantó», terraza delante y un árbol dando sombra a las mesas de fuera. El botón «Cómo llegar» abre la ruta exacta en Google Maps.",
	},
	{
		q: '¿Qué horario tiene?',
		a: 'Abre de lunes a viernes de 6:00 a 16:00 y el sábado de 6:00 a 13:00. Los domingos cierra. Es horario de mañana y mediodía: se desayuna, se almuerza y se come antes de las cuatro, y no hay servicio de cena. En fiestas del pueblo conviene llamar antes al 964 51 36 47.',
	},
	{
		q: '¿Hay carta y precios?',
		a: 'La ficha de Google no publica carta ni precios, y esta web no inventa importes: los platos que aparecen aquí son los de sus propias fotos y los que citan las reseñas. Los arroces, la sepia, el menú del día y su precio se consultan por teléfono o directamente en la barra.',
	},
	{
		q: '¿Qué se come en El Cantó?',
		a: 'Cocina española casera. La ficha lo clasifica como restaurante de cocina española y bar, y en sus fotos aparecen el bocadillo de la barra, el filete con patatas, las olivas, las almendras tostadas, el postre de crema y el carajillo. Las reseñas hablan de arroces, sepia a la plancha y comida casera.',
	},
	{
		q: '¿Se puede reservar?',
		a: 'Por teléfono, en el 964 51 36 47. No hay reserva online ni formulario en esta web. El comedor es amplio y tiene terraza, así que para grupos o para el domingo de fiestas conviene llamar con tiempo.',
	},
	{
		q: '¿Tiene terraza?',
		a: 'Sí. En las fotos de la ficha se ven mesas y sillas blancas delante de la fachada, a pie de calle y a la sombra de un árbol. No hay reserva de terraza: se ocupa según llegada.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'La ficha de Google marca acceso, aseo y asientos adaptados para sillas de ruedas. No marca plaza de aparcamiento adaptada, así que el aparcamiento es el de la calle.',
	},
	{
		q: '¿Dónde se aparca?',
		a: 'El local no tiene aparcamiento propio: se aparca en la misma calle la Via y en las calles del entorno, en superficie. Al ser un pueblo, salvo a la hora del almuerzo suele haber sitio cerca.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': ['BarOrPub', 'Restaurant'],
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['El Cantó', 'Bar El Cantó', 'Bar Restaurante El Cantó Les Alqueries'],
	slogan: 'La cocina de cada día en Les Alqueries',
	description,
	url: `${business.site}/`,
	telephone: '+34 964 51 36 47',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Cocina española', 'Cocina casera', 'Arroces', 'Pescado', 'Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Les Alqueries' },
		{ '@type': 'AdministrativeArea', name: 'Plana Baixa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: '0xd60042815296d83:0x96b2383f0b1f865' },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '06:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '06:00',
			closes: '13:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La cocina', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>El Cantó · Bar restaurante en Les Alqueries</title>
		<meta name="theme-color" content="#2c5b46" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Karla:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="El Cantó, bar Les Alqueries, restaurante Les Alqueries, almuerzos Plana Baixa, arroces Les Alqueries, sepia a la plancha, cocina casera Castellón, Carrer la Via 6, Alquerías"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="El Cantó · Bar restaurante en Les Alqueries"
			ogDescription="Almuerzos, cocina casera, arroces y plancha hasta las cuatro, con terraza delante de la fachada. 4,4 en Google con 232 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Fachada de ladrillo y terraza de Bar Restaurante El Cantó, en Les Alqueries"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#2c5b46"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Les Alqueries, Castelló"
			contact={{
				street: business.street,
				locality: business.city,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[fachada]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="EC"
			name={business.brand}
			subtitle="Bar restaurante · Les Alqueries"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer la Via, 6 · Les Alqueries"
				title="Cocina de cada día<br />desde las seis<br /><em>de la mañana.</em>"
				lede="El Cantó es bar y restaurante en Les Alqueries: se abre a las seis para el café y el almuerzo, y la cocina sigue hasta las cuatro con arroces, sepia a la plancha y guisos caseros. Delante, la terraza con las sillas blancas y el árbol que da sombra."
				image={fachada}
				imageAlt="Fachada de ladrillo y terraza de Bar Restaurante El Cantó, en Les Alqueries"
				primaryCta={{ label: 'Llamar 964 51 36 47', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4 en Google</b> con 232 reseñas' },
					{ label: 'De lunes a viernes', html: '<b>6:00 – 16:00</b>' },
					{ label: 'Sábado', html: '<b>6:00 – 13:00</b>' },
					{ label: 'Domingo', html: '<b>Cerrado</b>' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece El Cantó" items={servicios} />

			<LocalAbout
				label="Bar restaurante en la Plana Baixa"
				title="La barra a las seis,<br />la mesa puesta<br /><em>hasta las cuatro.</em>"
				paragraphs={[
					'En el número 6 de la calle la Via, con la fachada de ladrillo, el rótulo rojo de «Bar Rte. El Cantó» y la terraza de sillas blancas a pie de calle, El Cantó hace las dos cosas que se le piden a un bar de pueblo: abrir cuando todavía es de noche para el café y el almuerzo, y poner mesa a mediodía para comer con calma.',
					'La ficha de Google lo clasifica como restaurante de cocina española y bar. En sus fotos están el bocadillo de la barra, el filete con patatas, las olivas en aceitera metálica, las almendras tostadas del aperitivo, el postre de crema de la casa y el carajillo en vaso de caña. De la cocina salen además los arroces y la sepia a la plancha que repiten sus reseñas.',
					'El horario es de mañana y mediodía: de lunes a viernes de 6:00 a 16:00 y el sábado hasta la una, con el domingo cerrado. La ficha suma 232 opiniones con un 4,4, y las reseñas coinciden en la calidad de la cocina y en el trato.',
				]}
				note="«Buen sitio para comer, excelente calidad y buen trato», dice una reseña. Otra: «comida casera muy buena, trato excelente y muy buena atención»."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La cocina"
				title="De la barra<br /><em>a la mesa.</em>"
				description="La ficha de Google no publica carta con precios, así que esta selección sale de lo que aparece en sus fotos y de lo que citan sus reseñas: el bocadillo de la barra, las olivas y almendras del aperitivo, los arroces, la sepia a la plancha, el filete con patatas y el postre de crema."
				cta={{ label: 'Preguntar qué hay hoy', href: phoneHref }}
				groups={grupos}
				note="Sin precios: la ficha no los publica y esta web no los inventa. El menú del día, las raciones y los importes se consultan por teléfono en el 964 51 36 47."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor,<br />la barra<br /><em>y la terraza.</em>"
				description="Estas fotografías proceden del perfil de Bar Restaurante El Cantó en Google Maps: el comedor con la barra al fondo, el bocadillo de la barra, el filete con patatas, las olivas y las almendras del aperitivo, el postre de crema y el carajillo."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer la Via, 6 · 12530 Les Alqueries"
				title="Te esperamos<br /><em>en la terraza.</em>"
				addressLines={[business.street, `${business.postalCode} ${business.city}`, 'Castelló, España']}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: '6:00 – 16:00' },
					{ day: 'Martes', value: '6:00 – 16:00' },
					{ day: 'Miércoles', value: '6:00 – 16:00' },
					{ day: 'Jueves', value: '6:00 – 16:00' },
					{ day: 'Viernes', value: '6:00 – 16:00' },
					{ day: 'Sábado', value: '6:00 – 13:00' },
					{ day: 'Domingo', value: 'Cerrado', closed: true },
				]}
				hoursNote="Horario publicado en la ficha de Google: de lunes a viernes de 6:00 a 16:00 y el sábado de 6:00 a 13:00. Domingo cerrado y sin cenas. En fiestas del pueblo cambia: llama antes."
				mapTitle="Mapa de Bar Restaurante El Cantó en la calle la Via, 6, Les Alqueries"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="El Cantó · Les Alqueries"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Se reserva por teléfono, llamando al 964 51 36 47: no hay reserva online ni formulario en esta web. El comedor es amplio y tiene terraza, así que para grupos conviene avisar con un día."
			/>

			<LocalFaq items={faqs} title="Antes de <em>sentarse.</em>" />
		</main>

		<LocalFooter
			mark="EC"
			name="Bar Restaurante El Cantó"
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a El Cantó"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
