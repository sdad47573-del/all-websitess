---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/bar-restaurante-el-canto-apaisada-01.jpg';
import postre from '../assets/fotos/bar-restaurante-el-canto-apaisada-02.jpg';
import bocadillo from '../assets/fotos/bar-restaurante-el-canto-apaisada-04.jpg';
import comedor from '../assets/fotos/bar-restaurante-el-canto-apaisada-06.jpg';
import esquina from '../assets/fotos/bar-restaurante-el-canto-apaisada-07.jpg';
import terraza from '../assets/fotos/bar-restaurante-el-canto-apaisada-08.jpg';
import almendras from '../assets/fotos/bar-restaurante-el-canto-apaisada-10.jpg';
import olivas from '../assets/fotos/bar-restaurante-el-canto-panoramica-09.jpg';
import carajillo from '../assets/fotos/bar-restaurante-el-canto-vertical-03.jpg';
import filete from '../assets/fotos/bar-restaurante-el-canto-vertical-05.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description = BUSINESS.description;

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de El Cantó con mesas de madera, sillas crema y la barra al fondo',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo de la barra en pan de pueblo con relleno de tortilla, servido en un plato',
	},
	{
		src: filete,
		alt: 'Filete a la plancha con salsa y patatas fritas en Bar Restaurante El Cantó',
	},
	{
		src: postre,
		alt: 'Postre de crema fría con galleta en cuenco de cristal',
	},
	{
		src: almendras,
		alt: 'Olivas en aceitera metálica y almendras tostadas en la mesa de El Cantó',
	},
	{
		src: carajillo,
		alt: 'Carajillo en vaso de caña sobre su plato, en El Cantó',
	},
	{
		src: olivas,
		alt: 'Olivas y almendras tostadas en la mesa de Bar Restaurante El Cantó',
	},
	{
		src: esquina,
		alt: 'Terraza de El Cantó en la esquina de la calle, con sillas blancas y el árbol',
	},
	{
		src: terraza,
		alt: 'Fachada de ladrillo de Bar Restaurante El Cantó con el rótulo rojo y la terraza',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': ['BarOrPub', 'Restaurant'],
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.fullName,
	alternateName: ['El Cantó', 'Bar El Cantó', 'Bar Restaurante El Cantó Les Alqueries'],
	slogan: BUSINESS.tagline,
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34964513647',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Cocina española', 'Cocina casera', 'Arroces', 'Pescado', 'Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Les Alqueries' },
		{ '@type': 'AdministrativeArea', name: 'Plana Baixa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.province,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '06:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '06:00',
			closes: '13:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La cocina', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'El Cantó · Bar restaurante en Les Alqueries';
const cita = REVIEWS[0];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#a63f2f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="El Cantó, bar Les Alqueries, restaurante Les Alqueries, almuerzos Plana Baixa, arroces Les Alqueries, sepia a la plancha, cocina casera Castellón, Carrer la Via 6, Alquerías"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="El Cantó · Bar restaurante en Les Alqueries"
			ogDescription="Almuerzos, cocina casera, arroces y plancha hasta las cuatro, con terraza delante de la fachada. 4,4 en Google con 232 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de ladrillo y terraza de Bar Restaurante El Cantó, en Les Alqueries"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#a63f2f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.province}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone="+34964513647"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Les Alqueries, Castelló"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'España',
				phone: '+34 964 51 36 47',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Bar restaurante · Les Alqueries"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer la Via, 6 · Les Alqueries"
				title="Cocina de cada día<br />desde las seis<br /><em>de la mañana.</em>"
				lede="El Cantó es bar y restaurante en Les Alqueries: se abre a las seis para el café y el almuerzo, y la cocina sigue hasta las cuatro con arroces, sepia a la plancha y guisos caseros. Delante, la terraza con las sillas blancas y el árbol que da sombra."
				image={fachada}
				imageAlt="Fachada de ladrillo y terraza de Bar Restaurante El Cantó, en Les Alqueries"
				primaryCta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Desde las 6:00"
				facts={[
					{ label: 'Nota', html: '<b>4,4 en Google</b> con 232 reseñas' },
					{ label: 'De lunes a viernes', html: '<b>6:00 – 16:00</b>' },
					{ label: 'Sábado', html: '<b>6:00 – 13:00</b>' },
					{ label: 'Domingo', html: '<b>Cerrado</b>' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Qué ofrece El Cantó" items={SERVICIOS} />

			<LocalAbout
				label="Bar restaurante en la Plana Baixa"
				title="La barra a las seis,<br />la mesa puesta<br /><em>hasta las cuatro.</em>"
				paragraphs={[
					'En el número 6 de la calle la Via, con la fachada de ladrillo, el rótulo rojo de «Bar Rte. El Cantó» y la terraza de sillas blancas a pie de calle, El Cantó hace las dos cosas que se le piden a un bar de pueblo: abrir cuando todavía es de noche para el café y el almuerzo, y poner mesa a mediodía para comer con calma.',
					'La ficha de Google lo clasifica como restaurante de cocina española y bar. En sus fotos están el bocadillo de la barra, el filete con patatas, las olivas en aceitera metálica, las almendras tostadas del aperitivo, el postre de crema de la casa y el carajillo en vaso de caña. De la cocina salen además los arroces y la sepia a la plancha que repiten sus reseñas.',
					'El horario es de mañana y mediodía: de lunes a viernes de 6:00 a 16:00 y el sábado hasta la una, con el domingo cerrado. La ficha suma 232 opiniones con un 4,4, y las reseñas coinciden en la calidad de la cocina y en el trato.',
				]}
				note="«Buen sitio para comer, excelente calidad y buen trato», dice una reseña. Otra: «comida casera muy buena, trato excelente y muy buena atención»."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La cocina"
				title="De la barra<br /><em>a la mesa.</em>"
				description="La ficha de Google no publica carta con precios, así que esta selección sale de lo que aparece en sus fotos y de lo que citan sus reseñas: el bocadillo de la barra, las olivas y almendras del aperitivo, los arroces, la sepia a la plancha, el filete con patatas y el postre de crema."
				cta={{ label: 'Preguntar qué hay hoy', href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Sin precios: la ficha no los publica y esta web no los inventa. El menú del día, las raciones y los importes se consultan por teléfono en el 964 51 36 47."
			/>

			<section class="cita" aria-label="Opinión destacada en Google">
				<div class="wrap">
					<blockquote>
						<p>“{cita.text}”</p>
						<footer>Reseña en Google · {cita.rating} estrellas</footer>
					</blockquote>
					<div class="cita-nota">
						<b>4,4</b>
						232 reseñas en Google
						<a href={MAPS.reviews} target="_blank" rel="noreferrer">Leerlas todas ↗</a>
					</div>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor,<br />la barra<br /><em>y la terraza.</em>"
				description="Estas fotografías proceden del perfil de Bar Restaurante El Cantó en Google Maps: el comedor con la barra al fondo, el bocadillo de la barra, el filete con patatas, el postre de crema, las olivas y las almendras del aperitivo, el carajillo y la terraza de la esquina."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer la Via, 6 · 12530 Les Alqueries"
				title="Te esperamos<br /><em>en la terraza.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Castelló · Plana Baixa']}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="Horario publicado en la ficha de Google: de lunes a viernes de 6:00 a 16:00 y el sábado de 6:00 a 13:00. Domingo cerrado y sin cenas. En fiestas del pueblo cambia: llama antes."
				mapTitle="Mapa de Bar Restaurante El Cantó en la calle la Via, 6, Les Alqueries"
				mapEmbedUrl={MAPS.embed}
				mapLabel="El Cantó · Les Alqueries"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="Se reserva por teléfono, llamando al 964 51 36 47: no hay reserva online ni formulario en esta web. El comedor es amplio y tiene terraza, así que para grupos conviene avisar con un día."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>sentarse.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a El Cantó"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
