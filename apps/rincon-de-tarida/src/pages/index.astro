---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/rincon-de-tarida-panoramica-01.jpg';
import fachadaLateral from '../assets/fotos/rincon-de-tarida-apaisada-04.jpg';
import paella from '../assets/fotos/rincon-de-tarida-vertical-05.jpg';
import arrozNegro from '../assets/fotos/rincon-de-tarida-vertical-07.jpg';
import calamar from '../assets/fotos/rincon-de-tarida-vertical-08.jpg';
import calamarQueso from '../assets/fotos/rincon-de-tarida-vertical-02.jpg';
import pescado from '../assets/fotos/rincon-de-tarida-apaisada-03.jpg';
import ensalada from '../assets/fotos/rincon-de-tarida-apaisada-06.jpg';
import carne from '../assets/fotos/rincon-de-tarida-panoramica-09.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Bar-Restaurante Rincón de Tarida, cocina mediterránea y arroces en Cala Tarida (Ibiza). Desayunos, paellas y pescado con terraza. Tel. 971 80 64 45.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada blanca de dos plantas del Rincón de Tarida, con el rótulo «RESTAURANTE Rincón de Tarida» y arcos en la planta baja',
	},
	{
		src: fachadaLateral,
		alt: 'Vista lateral del Rincón de Tarida en la plaza, con los arcos, la terraza y la escalera de entrada',
	},
	{
		src: paella,
		alt: 'Paella de marisco en la paellera, con langostinos, mejillones y gajos de limón',
	},
	{
		src: arrozNegro,
		alt: 'Arroz negro con calamares y alioli servido en la paellera sobre una mesa de madera',
	},
	{
		src: calamar,
		alt: 'Calamar a la plancha relleno con patatas, ensalada y limón en un plato blanco',
	},
	{
		src: calamarQueso,
		alt: 'Calamar con queso gratinado, tomate y calabacín a la brasa en un plato de barro',
	},
	{
		src: pescado,
		alt: 'Pescado al horno con limón, pimiento y calabacín asado en una fuente',
	},
	{
		src: ensalada,
		alt: 'Ensalada con queso de cabra a la plancha, tomate y hinojo en un plato blanco',
	},
	{
		src: carne,
		alt: 'Carne a la plancha con patatas paja y ensalada en un plato blanco',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#rincon-de-tarida`,
	name: BUSINESS.name,
	alternateName: [
		'Rincón de Tarida',
		'Rincon de Tarida',
		'Bar Rincón de Tarida',
		'Restaurante Rincón de Tarida',
	],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 971 80 64 45',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Arroces', 'Pescado', 'Bar'],
	areaServed: [
		{ '@type': 'City', name: 'Sant Josep de sa Talaia' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '08:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Rincón de Tarida · Bar restaurante en Cala Tarida';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1b5f7a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Marcellus&family=Mulish:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Rincón de Tarida, Rincon de Tarida Ibiza, bar restaurante Cala Tarida, comer en Cala Tarida, paella Cala Tarida, restaurante mediterráneo Ibiza, desayunos Cala Tarida, Plaza del Mar Cala Tarida"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Rincón de Tarida · Bar restaurante en Cala Tarida"
			ogDescription="Cocina mediterránea, arroces y pescado en Cala Tarida (Ibiza). Desayunos desde las 8:00 y bar hasta las 23:00. Tel. 971 80 64 45."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada blanca del Rincón de Tarida con el rótulo del restaurante y los arcos de la terraza"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1b5f7a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			phone="+34971806445"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Rincón de Tarida"
			subtitle="Bar restaurante · Cala Tarida"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Plaza del Mar, 1 · Cala Tarida"
				title="Arroces y pescado<br /><em>frente a la cala.</em>"
				lede={`El Rincón de Tarida es un bar restaurante de cocina mediterránea en Plaza del Mar, 1 (Edif. Montercarlos), en Cala Tarida, Sant Josep de sa Talaia (Ibiza). Su fachada blanca de arcos abre a la plaza a pocos metros de la playa: dentro y en la terraza salen la paella de pescado y marisco, el arroz negro con calamares, el calamar a la plancha, el pescado al horno con verduras, las ensaladas y la carne a la plancha. Abre todos los días de 8:00 a 23:00, así que sirve desayunos, comidas, meriendas y copas. Teléfono: ${BUSINESS.phoneDisplay}.`}
				image={fachada}
				imageAlt="Fachada blanca de dos plantas del Rincón de Tarida, con el rótulo «RESTAURANTE Rincón de Tarida» y arcos en la planta baja"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)`,
					},
					{ label: 'Cocina', html: 'Mediterránea · arroces y pescado' },
					{ label: 'Horario', html: 'Todos los días · 8:00–23:00' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece el Rincón de Tarida" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una casa blanca<br /><em>de arcos y sombra.</em>"
				paragraphs={[
					'El Rincón de Tarida está en Plaza del Mar, 1, en el edificio Montercarlos, en Cala Tarida (Sant Josep de sa Talaia). Es una construcción blanca de dos plantas, con arcos en la planta baja, ventanas de madera y el rótulo «RESTAURANTE Rincón de Tarida» sobre la entrada. Delante, el porche con mesas y sillas ocupa la acera de la plaza, a pocos metros de la arena.',
					'Google lo clasifica como bar restaurante y restaurante mediterráneo, y el propio negocio lo resume en su ficha: «restaurante familiar y acogedor». Abre de 8:00 a 23:00 todos los días, de modo que la jornada empieza con café y tostadas y termina con cervezas y copas.',
					'La cocina va de los arroces al pescado: paella de pescado y marisco con langostinos y mejillones, arroz negro con calamares y alioli, calamar a la plancha relleno con patatas panadera, pescado al horno con verduras y ensaladas como la de queso de cabra a la plancha.',
					'Sus reseñas hablan de la mesa: «la paella de pescado y marisco deliciosa», «pedimos de entrante las croquetas de pollo» y «buen café y tostadas... y por la noche unas cervezas». Google le da 4,1 sobre 5 con 683 reseñas.',
				]}
				note={`${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google. Una de ellas: «${REVIEWS[0]}»`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Paella, arroz negro<br /><em>y pescado al horno.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que aparece en las fotos del perfil y lo que citan sus reseñas."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. Llama al 971 80 64 45 para reservar mesa o preguntar por los arroces y el pescado del día."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La fachada,<br /><em>la paellera y la mesa.</em>"
				description="Estas fotografías proceden del perfil de Bar-Restaurante Rincón de Tarida en Google Maps: la fachada blanca con los arcos, la terraza de la plaza, la paella de marisco, el arroz negro con calamares, el calamar a la plancha, el pescado al horno, la ensalada de queso de cabra y la carne con patatas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en la plaza.</em>"
				addressLines={[
					'Plaza del Mar, 1 · Edif. Montercarlos',
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Sant Josep de sa Talaia · Islas Baleares',
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: todos los días de 8:00 a 23:00. En temporada alta conviene llamar antes para mesa en la terraza."
				mapTitle="Mapa del Bar-Restaurante Rincón de Tarida en Plaza del Mar, Cala Tarida"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Rincón de Tarida · Cala Tarida"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 971 80 64 45. La ficha de Google marca asientos adaptados para sillas de ruedas."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Rincón de Tarida"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar al Rincón de Tarida"
		/>
	</body>
</html>
