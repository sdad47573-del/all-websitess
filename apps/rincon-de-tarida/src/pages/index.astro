---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/rincon-de-tarida-panoramica-01.jpg';
import fachadaLateral from '../assets/fotos/rincon-de-tarida-apaisada-04.jpg';
import paella from '../assets/fotos/rincon-de-tarida-vertical-05.jpg';
import arrozNegro from '../assets/fotos/rincon-de-tarida-vertical-07.jpg';
import calamar from '../assets/fotos/rincon-de-tarida-vertical-08.jpg';
import calamarQueso from '../assets/fotos/rincon-de-tarida-vertical-02.jpg';
import pescado from '../assets/fotos/rincon-de-tarida-apaisada-03.jpg';
import ensalada from '../assets/fotos/rincon-de-tarida-apaisada-06.jpg';
import carne from '../assets/fotos/rincon-de-tarida-panoramica-09.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Bar-Restaurante Rincón de Tarida, cocina mediterránea y arroces en Cala Tarida (Ibiza). Desayunos, paellas y pescado con terraza. Tel. 971 80 64 45.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada blanca de dos plantas del Rincón de Tarida, con el rótulo «RESTAURANTE Rincón de Tarida» y arcos en la planta baja',
	},
	{
		src: fachadaLateral,
		alt: 'Vista lateral del Rincón de Tarida en la plaza, con los arcos, la terraza y la escalera de entrada',
	},
	{
		src: paella,
		alt: 'Paella de marisco en la paellera, con langostinos, mejillones y gajos de limón',
	},
	{
		src: arrozNegro,
		alt: 'Arroz negro con calamares y alioli servido en la paellera sobre una mesa de madera',
	},
	{
		src: calamar,
		alt: 'Calamar a la plancha relleno con patatas, ensalada y limón en un plato blanco',
	},
	{
		src: calamarQueso,
		alt: 'Calamar con queso gratinado, tomate y calabacín a la brasa en un plato de barro',
	},
	{
		src: pescado,
		alt: 'Pescado al horno con limón, pimiento y calabacín asado en una fuente',
	},
	{
		src: ensalada,
		alt: 'Ensalada con queso de cabra a la plancha, tomate y hinojo en un plato blanco',
	},
	{
		src: carne,
		alt: 'Carne a la plancha con patatas paja y ensalada en un plato blanco',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#rincon-de-tarida`,
	name: BUSINESS.name,
	alternateName: [
		'Rincón de Tarida',
		'Rincon de Tarida',
		'Bar Rincón de Tarida',
		'Restaurante Rincón de Tarida',
	],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 971 80 64 45',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Arroces', 'Pescado', 'Bar'],
	areaServed: [
		{ '@type': 'City', name: 'Sant Josep de sa Talaia' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '08:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Rincón de Tarida · Bar restaurante en Cala Tarida';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"rincon-de-tarida-panoramica-01.jpg": fachada,
	"rincon-de-tarida-apaisada-04.jpg": fachadaLateral,
	"rincon-de-tarida-vertical-05.jpg": paella,
	"rincon-de-tarida-vertical-07.jpg": arrozNegro,
	"rincon-de-tarida-vertical-08.jpg": calamar,
	"rincon-de-tarida-vertical-02.jpg": calamarQueso,
	"rincon-de-tarida-apaisada-03.jpg": pescado,
	"rincon-de-tarida-apaisada-06.jpg": ensalada,
	"rincon-de-tarida-panoramica-09.jpg": carne,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1b5f7a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Marcellus&family=Mulish:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Rincón de Tarida, Rincon de Tarida Ibiza, bar restaurante Cala Tarida, comer en Cala Tarida, paella Cala Tarida, restaurante mediterráneo Ibiza, desayunos Cala Tarida, Plaza del Mar Cala Tarida"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Rincón de Tarida · Bar restaurante en Cala Tarida"
			ogDescription="Cocina mediterránea, arroces y pescado en Cala Tarida (Ibiza). Desayunos desde las 8:00 y bar hasta las 23:00. Tel. 971 80 64 45."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada blanca del Rincón de Tarida con el rótulo del restaurante y los arcos de la terraza"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1b5f7a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			phone="+34971806445"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Rincón de Tarida"
			subtitle="Bar restaurante · Cala Tarida"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Rincón de Tarida"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar al Rincón de Tarida"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34971806445?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Sant%20Josep%20de%20sa%20Talaia." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Sant Josep de sa Talaia"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
