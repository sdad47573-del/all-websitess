---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/el-jardin-de-la-abadia-vertical-04.jpg';
import escaparate from '../assets/fotos/el-jardin-de-la-abadia-apaisada-01.jpg';
import paella from '../assets/fotos/el-jardin-de-la-abadia-apaisada-03.jpg';
import vitrina from '../assets/fotos/el-jardin-de-la-abadia-apaisada-05.jpg';
import buffet from '../assets/fotos/el-jardin-de-la-abadia-apaisada-06.jpg';
import patatasChorizo from '../assets/fotos/el-jardin-de-la-abadia-apaisada-07.jpg';
import garbanzos from '../assets/fotos/el-jardin-de-la-abadia-apaisada-08.jpg';
import tortillas from '../assets/fotos/el-jardin-de-la-abadia-apaisada-10.jpg';
import bandejas from '../assets/fotos/el-jardin-de-la-abadia-vertical-02.jpg';
import mesaEventos from '../assets/fotos/el-jardin-de-la-abadia-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	PLATOS_DIA,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'El Jardín de la Abadía · Comida casera en Carretera de Cádiz, Málaga';
const description =
	'El Jardín de la Abadía, comida casera en Pl. Murillo Carrera, 6, Carretera de Cádiz (Málaga). Platos preparados para llevar y a domicilio. Fotos, horario, teléfono y opiniones.';

const galeria = [
	{ src: escaparate, alt: 'Escaparate de El Jardín de la Abadía con el rótulo de comida casera y su teléfono' },
	{ src: fachada, alt: 'Fachada del local con el cartel de platos del día en el cristal' },
	{ src: vitrina, alt: 'Bandejas de la vitrina con carnes, pimientos, arroz y patatas' },
	{ src: bandejas, alt: 'Bandejas de pollo, albóndigas en salsa, morcilla y tomate' },
	{ src: tortillas, alt: 'Tortillas de patata en la vitrina con guisos de carne y patatas debajo' },
	{ src: paella, alt: 'Arroz amarillo con pimiento y guisantes en una paellera grande' },
	{ src: patatasChorizo, alt: 'Patatas con chorizo y bacon en una sartén grande' },
	{ src: garbanzos, alt: 'Bandeja de garbanzos con carne y chorizo en salsa' },
	{ src: buffet, alt: 'Mesa de catering con empanadillas, croquetas y buñuelos' },
	{ src: mesaEventos, alt: 'Mesa dulce preparada con tartaletas y brochetas para una celebración' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Oferta de El Jardín de la Abadía',
	inLanguage: 'es-ES',
	description:
		'Selección orientativa basada en la categoría de Google, las reseñas públicas y las fotografías de la ficha; no es una carta oficial ni incluye precios.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-jardin-de-la-abadia`,
	name: BUSINESS.name,
	alternateName: ['Jardín de la Abadía', 'El Jardín de la Abadía Málaga'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34695044727',
	servesCuisine: ['Comida casera', 'Comida para llevar', 'Comida a domicilio'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:00',
			closes: '16:00',
		},
	],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Oferta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"el-jardin-de-la-abadia-vertical-04.jpg": fachada,
	"el-jardin-de-la-abadia-apaisada-01.jpg": escaparate,
	"el-jardin-de-la-abadia-apaisada-05.jpg": vitrina,
	"el-jardin-de-la-abadia-vertical-02.jpg": bandejas,
	"el-jardin-de-la-abadia-apaisada-10.jpg": tortillas,
	"el-jardin-de-la-abadia-apaisada-03.jpg": paella,
	"el-jardin-de-la-abadia-apaisada-07.jpg": patatasChorizo,
	"el-jardin-de-la-abadia-apaisada-08.jpg": garbanzos,
	"el-jardin-de-la-abadia-apaisada-06.jpg": buffet,
	"el-jardin-de-la-abadia-vertical-09.jpg": mesaEventos,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Marcellus&family=Mulish:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="El Jardín de la Abadía, comida casera Málaga, comida para llevar Carretera de Cádiz, comida a domicilio Málaga, Murillo Carrera 6, platos preparados Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera para llevar y a domicilio en la Carretera de Cádiz. Consulta fotos, horario, teléfono y opiniones."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de El Jardín de la Abadía, comida casera en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#2c4034"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Carretera de Cádiz, Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Jardín de la Abadía"
			subtitle="Comida casera · Málaga"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma horario, platos y precios con el establecimiento."
			ctaLabel="Llamar a El Jardín de la Abadía"
			navAriaLabel="Enlaces de El Jardín de la Abadía"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34695044727?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Oferta%20de%20El%20Jard%C3%ADn%20de%20la%20Abad%C3%ADa." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Oferta de El Jardín de la Abadía"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
