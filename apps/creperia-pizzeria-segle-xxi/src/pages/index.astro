---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import interior from '../assets/fotos/creperia-pizzeria-segle-xxi-apaisada-01.jpg';
import crepeChocolate from '../assets/fotos/creperia-pizzeria-segle-xxi-apaisada-02.jpg';
import pizzas from '../assets/fotos/creperia-pizzeria-segle-xxi-apaisada-03.jpg';
import galette from '../assets/fotos/creperia-pizzeria-segle-xxi-apaisada-04.jpg';
import ventanal from '../assets/fotos/creperia-pizzeria-segle-xxi-apaisada-07.jpg';
import crepeFlameado from '../assets/fotos/creperia-pizzeria-segle-xxi-vertical-08.jpg';
import carta from '../assets/fotos/creperia-pizzeria-segle-xxi-vertical-09.jpg';
import crepeNutella from '../assets/fotos/creperia-pizzeria-segle-xxi-vertical-05.jpg';
import crepeCabra from '../assets/fotos/creperia-pizzeria-segle-xxi-vertical-06.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'CREPERIA PIZZERIA SEGLE XXI · Crepería y pizzería en Encamp (Andorra)';
const description =
	'CREPERIA PIZZERIA SEGLE XXI, en la Av. de Joan Martí, 74, de Encamp (AD200, Andorra). Crepes salados y dulces, pizzas y desayunos. 4,4 sobre 5 con 190 reseñas. Abre de 7:00 a 22:30 entre semana y de 13:00 a 22:30 el fin de semana. Teléfono +376 832 690.';

/** Carta transcrita de la foto del menú publicada en el perfil de Google Maps. */
const MENU = [
	{
		title: 'Creps salades',
		items: [
			{ name: 'Mantega s/ sal', note: 'Mantequilla sin sal', price: '1,50 €' },
			{ name: 'Formatge', note: 'Queso', price: '2,80 €' },
			{ name: 'Pernil', note: 'Jamón', price: '2,80 €' },
			{ name: 'Roquefort', note: 'Queso roquefort', price: '3,80 €' },
			{ name: 'Cabra', note: 'Queso de cabra', price: '3,60 €' },
			{ name: 'Pernil-formatge', note: 'Jamón y queso', price: '4,00 €' },
			{ name: 'Pernil-sucre', note: 'Jamón y azúcar', price: '4,00 €' },
			{ name: 'Ou-formatge', note: 'Huevo y queso', price: '4,00 €' },
			{ name: 'Negre', note: 'Bacon, huevo y queso', price: '4,90 €' },
			{ name: 'Complete', note: 'Huevo, jamón y queso', price: '4,90 €' },
			{ name: 'Cabrito', note: 'Queso de cabra y nueces', price: '4,90 €' },
			{ name: 'Rodo', note: 'Jamón, roquefort y nueces', price: '5,60 €' },
			{ name: 'Querol', note: 'Jamón, huevo, queso y tomate', price: '5,60 €' },
			{ name: 'Rabassa', note: 'Huevo, jamón, queso y setas', price: '5,60 €' },
		],
	},
	{
		title: 'Creps dolces',
		items: [
			{ name: 'Sucre', note: 'Azúcar', price: '1,50 €' },
			{ name: 'Melmelades a escollir', note: 'Mermeladas a elegir', price: '2,00 €' },
			{ name: 'Mel', note: 'Miel', price: '2,50 €' },
			{ name: 'Flambejada', note: 'Flameada', price: '2,80 €' },
			{ name: 'Xocolata feta a casa', note: 'Chocolate hecho en casa', price: '2,80 €' },
			{
				name: 'Caramel a la mantega al sal',
				note: 'Caramelo a la mantequilla salada, hecho en casa',
				price: '2,80 €',
			},
			{ name: 'Nutella', note: 'Crepe de Nutella', price: '2,80 €' },
			{ name: 'Mel i nous', note: 'Miel y nueces', price: '3,00 €' },
			{
				name: 'Xocolata i nous o avellanes',
				note: 'Chocolate casero con nueces, avellanas, almendras o coco',
				price: '3,20 €',
			},
			{ name: 'Xocolata i xantillí', note: 'Chocolate casero y nata', price: '3,30 €' },
			{ name: 'Plàtan i xocolata', note: 'Plátano y chocolate casero', price: '3,50 €' },
			{
				name: 'Martiniquesa',
				note: 'Plátano, chocolate casero y nata',
				price: '4,00 €',
			},
			{
				name: 'Daoulas',
				note: 'Plátano, chocolate casero, helado de chocolate y nata',
				price: '4,50 €',
			},
			{
				name: 'Ecoisse',
				note: 'Helado de vainilla, helado de chocolate casero y nata',
				price: '5,00 €',
			},
			{
				name: 'Norvégienne',
				note: 'Helado de vainilla, helado de fresa, salsa de fresas y nata',
				price: '5,00 €',
			},
			{
				name: 'Antillaise',
				note: 'Plátano, chocolate casero, pasas y flambeado al ron',
				price: '5,50 €',
			},
			{
				name: 'Amandine',
				note: 'Chocolate casero, almendras tostadas y flambeado al Grand Marnier',
				price: '5,50 €',
			},
			{
				name: 'Bounty',
				note: 'Helado de vainilla, helado de chocolate, coco rallado, chocolate casero y nata',
				price: '5,50 €',
			},
		],
	},
	{
		title: 'Per a acompanyar',
		items: [
			{ name: 'La bolée de cidra', note: 'Vaso de sidra', price: '1,50 €' },
			{ name: 'La bouteille', note: 'Botella de sidra', price: '7,00 €' },
			{ name: 'Kir breton', note: 'Kir bretón', price: '2,00 €' },
			{ name: 'Suplement de xantillí', note: 'Suplemento de nata', price: '1,00 €' },
			{ name: 'Suplement de gelat', note: 'Suplemento de bola de helado', price: '1,50 €' },
		],
	},
];

const galeria = [
	{
		src: interior,
		alt: 'El interior de la crepería, con la barra a la izquierda, el mural rojo y naranja de la pared y las mesas junto al ventanal',
	},
	{
		src: pizzas,
		alt: 'Dos pizzas en la mesa: una de queso y orégano y otra con pimiento verde, tomate y huevo, con cervezas al lado',
	},
	{
		src: galette,
		alt: 'Una galette de trigo sarraceno con jamón y queso gratinado, servida en un plato cuadrado',
	},
	{
		src: ventanal,
		alt: 'El ventanal del local con cortinas naranjas y la avenida de Encamp al otro lado, con mesas y sillas altas',
	},
	{
		src: carta,
		alt: 'La carta de crepes del establecimiento, titulada Segle XXI, con los creps salades y los creps dolces y sus precios',
	},
	{
		src: crepeChocolate,
		alt: 'Un crepe abierto con chocolate y rodajas de plátano en un plato blanco sobre mantel individual azul',
	},
	{
		src: crepeNutella,
		alt: 'Un crepe doblado en triángulo con Nutella y plátano, en un plato de borde naranja',
	},
	{
		src: crepeCabra,
		alt: 'Un crepe con queso de cabra y nueces sobre un mantel individual de cuadros',
	},
	{
		src: crepeFlameado,
		alt: 'Un crepe de chocolate y plátano flameado con un hierro caliente en la mesa, con pasas y nata',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de crepes de la Creperia Pizzeria Segle XXI',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#creperia-pizzeria-segle-xxi`,
	name: BUSINESS.fullName,
	alternateName: [
		'Segle XXI Encamp',
		'Creperia Segle XXI',
		'Pizzeria Segle XXI',
		'Crepería Segle XXI Andorra',
	],
	description:
		'Crepería y pizzería en la Av. de Joan Martí, 74, de Encamp (Andorra). Crepes salados y dulces, pizzas y desayunos, con servicio de comidas y cenas todos los días.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376832690',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Crepes', 'Pizza', 'Cocina francesa'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '22:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '13:00',
			closes: '22:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#10201f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Work+Sans:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="crepería Encamp, CREPERIA PIZZERIA SEGLE XXI, crepes Andorra, pizzería Encamp, crepes salados Encamp, desayunos Encamp, Av. de Joan Martí Encamp"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Crepería y pizzería en la Av. de Joan Martí, 74, de Encamp. 4,4 sobre 5 con 190 reseñas en Google. De 7:00 a 22:30 entre semana."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Un crepe abierto con chocolate y plátano en la Creperia Pizzeria Segle XXI de Encamp"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#10201f"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-03"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[crepeChocolate]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Segle XXI"
			subtitle="Crepería · Encamp"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. de Joan Martí, 74 · Encamp, AD200"
				title="Crepes y pizza <br /><em>en Encamp.</em>"
				lede={`Segle XXI es la crepería de la Av. de Joan Martí, 74, en Encamp, con el rótulo de pizzería en la puerta. De lunes a viernes abre a las 7:00 —desayunos, comidas, meriendas y cenas— y el fin de semana empieza a las 13:00. Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				image={crepeChocolate}
				imageAlt="Un crepe abierto con chocolate y rodajas de plátano en un plato blanco, sobre mantel individual azul"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>7:00–22:30</b> · de lunes a viernes' },
					{ label: 'Fin de semana', html: '<b>13:00–22:30</b> · sábado y domingo' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Crepería · Andorra"
			/>

			<LocalChips label="Lo que ofrece CREPERIA PIZZERIA SEGLE XXI" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Joan Martí, 74. <br /><em>Crepes y horno.</em>"
				paragraphs={[
					'El local está en la Av. de Joan Martí, 74, la avenida que cruza Encamp, la parroquia andorrana del norte, entre Andorra la Vella y Canillo. Tiene un ventanal grande a la calle, con cortinas naranjas, y dentro un mural rojo y naranja sobre la pared del fondo.',
					'El nombre comercial es «Creperia Pizzeria Segle XXI»: crepes y pizza en el mismo sitio. La ficha de Google la clasifica como «Crepería», «Cafetería», «Restaurante de comida para llevar» y «Pizzería», aunque no publica la carta de pizzas.',
					'La carta fotografiada en el perfil es una carta de crepes completa: los salados van desde la mantequilla o el queso hasta combinaciones como la Rabassa (huevo, jamón, queso y setas) o el Rodo (jamón, roquefort y nueces), y los dulces van del azúcar y la miel al Bounty con coco, helado y chocolate casero. También tiene sidra y kir bretón.',
					`Los horarios son de día entero: de 7:00 a 22:30 de lunes a viernes y de 13:00 a 22:30 los sábados y domingos, sin día de cierre semanal en la ficha. La valoración es de ${RATING.label} sobre 5 con ${RATING.count} reseñas (noviembre de 2026).`,
				]}
				note="La ficha de Google no publica carta de pizzas, precios de bebidas ni si hay terraza o reparto. La carta de crepes de esta página es la que aparece fotografiada en el perfil; para el resto, llama al +376 832 690."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> La casa</p>
					<h2 id="highlights-title">Del desayuno <br /><em>a la cena.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Crepes salados, <br /><em>crepes dulces.</em>"
				description="Esta es la carta de crepes que aparece fotografiada en el perfil de Google Maps, con sus precios. Los nombres van en catalán, como están escritos en el menú, y la traducción al castellano va debajo."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Carta transcrita de la fotografía del menú publicada en el perfil de Google Maps (consultada el 2 de noviembre de 2026). Los precios son los de esa foto y pueden haber cambiado; la ficha no publica la carta de pizzas ni el precio de las bebidas fuera de la sidra y el kir."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El local, la mesa <br /><em>y la carta.</em>"
				description="Nueve fotografías del perfil de Segle XXI en Google Maps: el interior con el mural rojo, la terraza interior del ventanal, las pizzas, la galette de trigo sarraceno, la carta de crepes, el crepe de chocolate y plátano, el de Nutella, el de queso de cabra con nueces y el flameado con hierro."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,4 sobre 5, <em>con 190 reseñas.</em></h2>
						<p>
							Ciento noventa opiniones dan una media bastante estable: 4,4 sobre 5
							(consultada el 2 de noviembre de 2026). No es un 5 perfecto, y quien busque un local
							de crepes en Encamp hará bien en leer las reseñas enteras antes de decidir.
						</p>
						<p>
							Esta web no copia reseñas sueltas: para verlas con sus fechas y sus respuestas, abre
							la ficha en Google.
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver las 190 reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,4</strong>
						<span>★★★★☆</span>
						<small>190 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En la avenida <br /><em>de Encamp.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} · Andorra`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de 7:00 a 22:30 de lunes a viernes y de 13:00 a 22:30 el sábado y el domingo. ${HORARIO_AVISO}`}
				mapTitle="Mapa de CREPERIA PIZZERIA SEGLE XXI en la Av. de Joan Martí, 74, Encamp"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Joan Martí, 74 · Encamp"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Reservas y consultas por teléfono, en el +376 832 690: la ficha no publica reservas online ni pedidos por la web, y tampoco dice si hay terraza o reparto. Si vas en grupo, llama antes."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Segle XXI"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario, valoración, carta y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Los precios son los de la carta fotografiada en el perfil: confírmalos por teléfono."
			ctaLabel="Llamar a Segle XXI"
			navAriaLabel="Enlaces de CREPERIA PIZZERIA SEGLE XXI"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
