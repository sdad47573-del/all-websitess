---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import interior from '../assets/fotos/creperia-pizzeria-segle-xxi-apaisada-01.jpg';
import crepeChocolate from '../assets/fotos/creperia-pizzeria-segle-xxi-apaisada-02.jpg';
import pizzas from '../assets/fotos/creperia-pizzeria-segle-xxi-apaisada-03.jpg';
import galette from '../assets/fotos/creperia-pizzeria-segle-xxi-apaisada-04.jpg';
import ventanal from '../assets/fotos/creperia-pizzeria-segle-xxi-apaisada-07.jpg';
import crepeFlameado from '../assets/fotos/creperia-pizzeria-segle-xxi-vertical-08.jpg';
import carta from '../assets/fotos/creperia-pizzeria-segle-xxi-vertical-09.jpg';
import crepeNutella from '../assets/fotos/creperia-pizzeria-segle-xxi-vertical-05.jpg';
import crepeCabra from '../assets/fotos/creperia-pizzeria-segle-xxi-vertical-06.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'CREPERIA PIZZERIA SEGLE XXI · Crepería y pizzería en Encamp (Andorra)';
const description =
	'CREPERIA PIZZERIA SEGLE XXI, en la Av. de Joan Martí, 74, de Encamp (AD200, Andorra). Crepes salados y dulces, pizzas y desayunos. 4,4 sobre 5 con 190 reseñas. Abre de 7:00 a 22:30 entre semana y de 13:00 a 22:30 el fin de semana. Teléfono +376 832 690.';

/** Carta transcrita de la foto del menú publicada en el perfil de Google Maps. */
const MENU = [
	{
		title: 'Creps salades',
		items: [
			{ name: 'Mantega s/ sal', note: 'Mantequilla sin sal', price: '1,50 €' },
			{ name: 'Formatge', note: 'Queso', price: '2,80 €' },
			{ name: 'Pernil', note: 'Jamón', price: '2,80 €' },
			{ name: 'Roquefort', note: 'Queso roquefort', price: '3,80 €' },
			{ name: 'Cabra', note: 'Queso de cabra', price: '3,60 €' },
			{ name: 'Pernil-formatge', note: 'Jamón y queso', price: '4,00 €' },
			{ name: 'Pernil-sucre', note: 'Jamón y azúcar', price: '4,00 €' },
			{ name: 'Ou-formatge', note: 'Huevo y queso', price: '4,00 €' },
			{ name: 'Negre', note: 'Bacon, huevo y queso', price: '4,90 €' },
			{ name: 'Complete', note: 'Huevo, jamón y queso', price: '4,90 €' },
			{ name: 'Cabrito', note: 'Queso de cabra y nueces', price: '4,90 €' },
			{ name: 'Rodo', note: 'Jamón, roquefort y nueces', price: '5,60 €' },
			{ name: 'Querol', note: 'Jamón, huevo, queso y tomate', price: '5,60 €' },
			{ name: 'Rabassa', note: 'Huevo, jamón, queso y setas', price: '5,60 €' },
		],
	},
	{
		title: 'Creps dolces',
		items: [
			{ name: 'Sucre', note: 'Azúcar', price: '1,50 €' },
			{ name: 'Melmelades a escollir', note: 'Mermeladas a elegir', price: '2,00 €' },
			{ name: 'Mel', note: 'Miel', price: '2,50 €' },
			{ name: 'Flambejada', note: 'Flameada', price: '2,80 €' },
			{ name: 'Xocolata feta a casa', note: 'Chocolate hecho en casa', price: '2,80 €' },
			{
				name: 'Caramel a la mantega al sal',
				note: 'Caramelo a la mantequilla salada, hecho en casa',
				price: '2,80 €',
			},
			{ name: 'Nutella', note: 'Crepe de Nutella', price: '2,80 €' },
			{ name: 'Mel i nous', note: 'Miel y nueces', price: '3,00 €' },
			{
				name: 'Xocolata i nous o avellanes',
				note: 'Chocolate casero con nueces, avellanas, almendras o coco',
				price: '3,20 €',
			},
			{ name: 'Xocolata i xantillí', note: 'Chocolate casero y nata', price: '3,30 €' },
			{ name: 'Plàtan i xocolata', note: 'Plátano y chocolate casero', price: '3,50 €' },
			{
				name: 'Martiniquesa',
				note: 'Plátano, chocolate casero y nata',
				price: '4,00 €',
			},
			{
				name: 'Daoulas',
				note: 'Plátano, chocolate casero, helado de chocolate y nata',
				price: '4,50 €',
			},
			{
				name: 'Ecoisse',
				note: 'Helado de vainilla, helado de chocolate casero y nata',
				price: '5,00 €',
			},
			{
				name: 'Norvégienne',
				note: 'Helado de vainilla, helado de fresa, salsa de fresas y nata',
				price: '5,00 €',
			},
			{
				name: 'Antillaise',
				note: 'Plátano, chocolate casero, pasas y flambeado al ron',
				price: '5,50 €',
			},
			{
				name: 'Amandine',
				note: 'Chocolate casero, almendras tostadas y flambeado al Grand Marnier',
				price: '5,50 €',
			},
			{
				name: 'Bounty',
				note: 'Helado de vainilla, helado de chocolate, coco rallado, chocolate casero y nata',
				price: '5,50 €',
			},
		],
	},
	{
		title: 'Per a acompanyar',
		items: [
			{ name: 'La bolée de cidra', note: 'Vaso de sidra', price: '1,50 €' },
			{ name: 'La bouteille', note: 'Botella de sidra', price: '7,00 €' },
			{ name: 'Kir breton', note: 'Kir bretón', price: '2,00 €' },
			{ name: 'Suplement de xantillí', note: 'Suplemento de nata', price: '1,00 €' },
			{ name: 'Suplement de gelat', note: 'Suplemento de bola de helado', price: '1,50 €' },
		],
	},
];

const galeria = [
	{
		src: interior,
		alt: 'El interior de la crepería, con la barra a la izquierda, el mural rojo y naranja de la pared y las mesas junto al ventanal',
	},
	{
		src: pizzas,
		alt: 'Dos pizzas en la mesa: una de queso y orégano y otra con pimiento verde, tomate y huevo, con cervezas al lado',
	},
	{
		src: galette,
		alt: 'Una galette de trigo sarraceno con jamón y queso gratinado, servida en un plato cuadrado',
	},
	{
		src: ventanal,
		alt: 'El ventanal del local con cortinas naranjas y la avenida de Encamp al otro lado, con mesas y sillas altas',
	},
	{
		src: carta,
		alt: 'La carta de crepes del establecimiento, titulada Segle XXI, con los creps salades y los creps dolces y sus precios',
	},
	{
		src: crepeChocolate,
		alt: 'Un crepe abierto con chocolate y rodajas de plátano en un plato blanco sobre mantel individual azul',
	},
	{
		src: crepeNutella,
		alt: 'Un crepe doblado en triángulo con Nutella y plátano, en un plato de borde naranja',
	},
	{
		src: crepeCabra,
		alt: 'Un crepe con queso de cabra y nueces sobre un mantel individual de cuadros',
	},
	{
		src: crepeFlameado,
		alt: 'Un crepe de chocolate y plátano flameado con un hierro caliente en la mesa, con pasas y nata',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de crepes de la Creperia Pizzeria Segle XXI',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#creperia-pizzeria-segle-xxi`,
	name: BUSINESS.fullName,
	alternateName: [
		'Segle XXI Encamp',
		'Creperia Segle XXI',
		'Pizzeria Segle XXI',
		'Crepería Segle XXI Andorra',
	],
	description:
		'Crepería y pizzería en la Av. de Joan Martí, 74, de Encamp (Andorra). Crepes salados y dulces, pizzas y desayunos, con servicio de comidas y cenas todos los días.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376832690',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Crepes', 'Pizza', 'Cocina francesa'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '22:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '13:00',
			closes: '22:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"creperia-pizzeria-segle-xxi-apaisada-02.jpg": crepeChocolate,
	"creperia-pizzeria-segle-xxi-apaisada-01.jpg": interior,
	"creperia-pizzeria-segle-xxi-apaisada-03.jpg": pizzas,
	"creperia-pizzeria-segle-xxi-apaisada-04.jpg": galette,
	"creperia-pizzeria-segle-xxi-apaisada-07.jpg": ventanal,
	"creperia-pizzeria-segle-xxi-vertical-09.jpg": carta,
	"creperia-pizzeria-segle-xxi-vertical-05.jpg": crepeNutella,
	"creperia-pizzeria-segle-xxi-vertical-06.jpg": crepeCabra,
	"creperia-pizzeria-segle-xxi-vertical-08.jpg": crepeFlameado,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#10201f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Work+Sans:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="crepería Encamp, CREPERIA PIZZERIA SEGLE XXI, crepes Andorra, pizzería Encamp, crepes salados Encamp, desayunos Encamp, Av. de Joan Martí Encamp"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Crepería y pizzería en la Av. de Joan Martí, 74, de Encamp. 4,4 sobre 5 con 190 reseñas en Google. De 7:00 a 22:30 entre semana."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Un crepe abierto con chocolate y plátano en la Creperia Pizzeria Segle XXI de Encamp"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#10201f"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-03"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[crepeChocolate]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Segle XXI"
			subtitle="Crepería · Encamp"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Segle XXI"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario, valoración, carta y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Los precios son los de la carta fotografiada en el perfil: confírmalos por teléfono."
			ctaLabel="Llamar a Segle XXI"
			navAriaLabel="Enlaces de CREPERIA PIZZERIA SEGLE XXI"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34376832690?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Mantega%20s%2F%20sal." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Mantega s/ sal"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
