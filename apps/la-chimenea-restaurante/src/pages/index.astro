---
import { Image } from 'astro:assets';
import WhatsappFab from '../components/WhatsappFab.astro';
import '../styles/global.css';

import imgHero from '../assets/fotos/la-chimenea-restaurante-malaga.jpg';
import img1 from '../assets/fotos/la-chimenea-restaurante-malaga-foto-1.jpg';
import img2 from '../assets/fotos/la-chimenea-restaurante-malaga-foto-2.jpg';
import img3 from '../assets/fotos/la-chimenea-restaurante-malaga-foto-3.jpg';
import img4 from '../assets/fotos/la-chimenea-restaurante-malaga-foto-4.jpg';
import img5 from '../assets/fotos/la-chimenea-restaurante-malaga-foto-5.jpg';
import img6 from '../assets/fotos/la-chimenea-restaurante-malaga-foto-6.jpg';
import img7 from '../assets/fotos/la-chimenea-restaurante-malaga-foto-7.jpg';

const business = {
	name: 'La Chimenea Restaurante',
	tagline: 'Parrilla y asador en Teatinos',
	street: 'C. Juan de Rihuerga, 29',
	district: 'Teatinos-Universidad (Colonia Santa Inés)',
	city: 'Málaga',
	postalCode: '29010',
	phone: '675 05 71 43',
	latitude: 36.7260373,
	longitude: -4.4662599,
	site: 'https://la-chimenea-restaurante.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/La+Chimenea+Restaurante/@36.7260373,-4.4662599,17z/data=!3m1!4b1!4m6!3m5!1s0xd72f73bc525c3cb:0x5668f66204fd227a!8m2!3d36.7260373!4d-4.4662599!16s%2Fg%2F12qfcxs13';
const cidUrl = 'https://www.google.com/maps?cid=6226497385690636922';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34675057143';
const instagramUrl = 'https://www.instagram.com/lachimenea_restaurante/';
const facebookUrl =
	'https://www.facebook.com/p/Restaurante-la-chimenea-malaga-teatinos-100040737676241/';

const photos = {
	hero: imgHero,
	foto1: img1,
	foto2: img2,
	foto3: img3,
	foto4: img4,
	foto5: img5,
	foto6: img6,
	foto7: img7,
};

const servicios = [
	'Brasa de carbón vegetal',
	'Carnes a la parrilla',
	'Croquetas caseras',
	'Quesos y tablas',
	'Comidas y cenas',
	'Reservas por teléfono',
	'Grupos y celebraciones',
	'Accesible para sillas de ruedas',
	'Para llevar',
];

const loMasPedido = [
	{ nombre: 'Chuletón a la brasa', nota: 'piezas grandes para compartir, al punto que pidas' },
	{ nombre: 'Entrecot de vaca madurada', nota: 'uno de los platos más citados en las reseñas' },
	{ nombre: 'Croquetas caseras de rabo de toro', nota: 'el entrante que más se repite en las opiniones' },
	{ nombre: 'Presa y carnes rojas', nota: 'servidas en plato caliente, con selección de sales' },
	{ nombre: 'Chistorra y morcilla de Burgos', nota: 'para picar antes de la carne' },
	{ nombre: 'Queso payoyo', nota: 'tabla de quesos para empezar' },
	{ nombre: 'Patatas asadas con alioli', nota: 'guarnición clásica de la casa' },
	{ nombre: 'Postres caseros', nota: 'coulant, milhojas y tarta según el día' },
];

const galeria = [
	{
		src: photos.foto1,
		w: 1600,
		h: 1066,
		alt: 'Fotografía de La Chimenea Restaurante publicada en su ficha de Google Maps (Málaga)',
	},
	{
		src: photos.foto2,
		w: 1600,
		h: 1066,
		alt: 'Imagen de La Chimenea Restaurante, parrilla en Teatinos, Málaga',
	},
	{
		src: photos.foto3,
		w: 1600,
		h: 1200,
		alt: 'Foto de La Chimenea Restaurante en la calle Juan de Rihuerga, Málaga, desde Google Maps',
	},
	{
		src: photos.foto4,
		w: 1600,
		h: 900,
		alt: 'Detalle de La Chimenea Restaurante (Málaga) según su perfil de Google Maps',
	},
	{
		src: photos.foto5,
		w: 1600,
		h: 898,
		alt: 'Fotografía de La Chimenea Restaurante, asador de carnes en Málaga',
	},
	{
		src: photos.foto6,
		w: 1170,
		h: 1600,
		alt: 'Imagen de La Chimenea Restaurante en Teatinos-Universidad, Málaga',
	},
	{
		src: photos.foto7,
		w: 898,
		h: 1600,
		alt: 'Foto de La Chimenea Restaurante en la zona de la Colonia Santa Inés, Málaga',
	},
];

const faqs = [
	{
		q: '¿Dónde está La Chimenea Restaurante en Málaga?',
		a: 'En la calle Juan de Rihuerga, 29, en Teatinos-Universidad (29010 Málaga), junto a la zona de la Colonia Santa Inés. Es una calle secundaria del barrio, a unos minutos del campus universitario, así que conviene mirar el mapa antes de la primera visita.',
	},
	{
		q: '¿Cuál es el horario de La Chimenea?',
		a: 'Según los datos públicos del restaurante, abre todos los días para comidas de 13:00 a 17:00, y los viernes y sábados también ofrece cenas desde las 20:30 hasta la medianoche. En festivos, puentes y temporadas especiales conviene llamar antes al 675 05 71 43 para confirmar.',
	},
	{
		q: '¿Qué se come en La Chimenea Restaurante?',
		a: 'Es una parrilla especializada en carnes a la brasa de carbón vegetal: chuletón, entrecot, presa y distintas piezas de vaca, servidas en plato caliente y con selección de sales. Los entrantes más citados en las reseñas son las croquetas caseras (rabo de toro, puchero o boletus), la chistorra, la morcilla y las tablas de queso.',
	},
	{
		q: '¿Hay que reservar mesa?',
		a: 'Es recomendable, sobre todo los fines de semana, en festivos y para grupos. El local es familiar y en horas punta se llena, además de que algunas piezas de carne pueden agotarse. Las reservas se gestionan por teléfono.',
	},
	{
		q: '¿Se puede pagar con tarjeta?',
		a: 'Varias reseñas de Google advierten de que puede que no acepten tarjeta y recomiendan llevar efectivo. Lo más práctico es preguntar al llamar para reservar y llevar algo de dinero en metálico por si acaso.',
	},
	{
		q: '¿Hay opciones sin gluten o para celíacos?',
		a: 'Sí. Hay entrantes, guarniciones y postres sin gluten y las patatas se fríen en freidora aparte para evitar contaminación cruzada. Conviene avisar al personal al llegar o al reservar para que lo tengan en cuenta.',
	},
	{
		q: '¿El restaurante es accesible y tiene terraza?',
		a: 'La ficha de Google indica acceso para sillas de ruedas y asientos adaptados, y distingue entre comer allí o para llevar. Varias fichas públicas mencionan también asientos al aire libre; si buscas terraza, confírmalo al reservar.',
	},
];

const description =
	'La Chimenea Restaurante, parrilla de carnes a la brasa en Teatinos-Universidad (Málaga): chuletón, entrecot, presa, croquetas caseras de rabo de toro y tablas de queso. Calle Juan de Rihuerga, 29. Reservas en el 675 05 71 43.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: 'La Chimenea Málaga',
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 675 05 71 43',
	image: [
		`${business.site}${photos.hero.src}`,
		`${business.site}${photos.foto1.src}`,
		`${business.site}${photos.foto2.src}`,
		`${business.site}${photos.foto3.src}`,
	],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Barbacoa', 'Parrilla', 'Carnes a la brasa', 'Asador', 'Cocina española'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [instagramUrl, facebookUrl, cidUrl],
	acceptsReservations: 'True',
	menu: cidUrl,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Sunday'],
			opens: '13:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '13:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '20:30',
			closes: '00:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Carnes a la brasa', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Reservas por teléfono', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Opciones sin gluten', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 3.9,
		reviewCount: 530,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#14100e" />
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="La Chimenea Restaurante, parrilla Teatinos Málaga, carnes a la brasa Málaga, chuletón Málaga, asador Teatinos, croquetas de rabo de toro Málaga, restaurante Juan de Rihuerga 29, comer en Teatinos, barbacoa 29010 Málaga, Colonia Santa Inés"
		/>
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,600&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>La Chimenea | Parrilla y carnes a la brasa en Teatinos, Málaga</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta
			property="og:title"
			content="La Chimenea Restaurante · Parrilla de carnes a la brasa en Teatinos"
		/>
		<meta
			property="og:description"
			content="Chuletón, entrecot, presa y croquetas caseras en un asador de barrio con brasa de carbón. C. Juan de Rihuerga, 29 (Teatinos-Universidad, Málaga)."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content="1600" />
		<meta property="og:image:height" content="1066" />
		<meta
			property="og:image:alt"
			content="La Chimenea Restaurante, parrilla de carnes a la brasa en Teatinos, Málaga"
		/>
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta
			name="twitter:title"
			content="La Chimenea Restaurante · Brasa de carbón en Teatinos (Málaga)"
		/>
		<meta
			name="twitter:description"
			content="Parrilla de carnes en la calle Juan de Rihuerga, 29 (Málaga). Chuletón, entrecot, croquetas caseras y tablas de queso."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7260373;-4.4662599" />
		<meta name="ICBM" content="36.7260373, -4.4662599" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="La Chimenea Restaurante, inicio">
				<span class="brand-mark" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none">
						<path d="M12 3c3.6 3.6 5.2 6 5.2 8.8a5.2 5.2 0 0 1-10.4 0C6.8 9 8.4 6.6 12 3z" fill="#e2571f" />
						<path d="M12 8.5c2 2 2.8 3.2 2.8 4.8a2.8 2.8 0 0 1-5.6 0c0-1.6.8-2.8 2.8-4.8z" fill="#f6c66b" />
					</svg>
				</span>
				<span class="brand-name">
					La Chimenea <small>Restaurante · Teatinos, Málaga</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">Qué pedir</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>675 05 71 43</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-glow" aria-hidden="true"></div>
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Teatinos-Universidad · Málaga</p>
					<h1 id="hero-title">
						Carne a la brasa<br />de carbón,<br /><em>al punto que pidas.</em>
					</h1>
					<p class="hero-lede">
						Parrilla de barrio en la calle Juan de Rihuerga, junto a la Colonia Santa Inés.
						Chuletón, entrecot, presa y croquetas caseras en un local sencillo donde lo que
						importa es la carne y cómo se hace.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 675 05 71 43</a>
						<a class="button button-ghost" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
					<ul class="hero-facts">
						<li><b>3,9</b> en Google (530 reseñas)</li>
						<li>Brasa de carbón vegetal</li>
						<li>Croquetas caseras</li>
						<li>Comidas y cenas de viernes y sábado</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						alt="Fotografía de La Chimenea Restaurante publicada en su ficha de Google Maps (Málaga)"
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver las 574 fotos ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Servicios de La Chimenea Restaurante">
				<ul class="chips">
					{servicios.map((servicio) => <li>{servicio}</li>)}
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> Un asador de barrio en Teatinos</p>
				<div class="about-grid">
					<h2>Poca carta,<br />mucha brasa<br /><em>y paciencia.</em></h2>
					<div class="about-copy">
						<p>
							La Chimenea es de esos sitios que se descubren por recomendación: un local familiar
							en una calle tranquila de Teatinos, junto a la Colonia Santa Inés, con el asador a
							la vista y las piezas de carne como protagonistas absolutas. Nada de cartas
							kilométricas: lo que hay, se hace en la brasa.
						</p>
						<p>
							Aquí se viene a comer carne. Chuletón, entrecot, presa o costillar, servidos en plato
							caliente con una selección de sales para que cada uno se ajuste al gusto. Antes,
							entrantes de los de siempre —croquetas caseras, chistorra, morcilla, tabla de
							quesos— y de guarnición, patatas asadas con alioli.
						</p>
						<p class="about-note">
							Lo que más se repite en las reseñas públicas: la carne está tierna y bien hecha, y
							merece la pena dejarse aconsejar por el personal. También se repite un aviso
							práctico: conviene llevar efectivo, porque puede que no acepten tarjeta.
						</p>
						<div class="about-links">
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">
								Instagram del restaurante <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href={facebookUrl} target="_blank" rel="noreferrer">
								Página de Facebook <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href={mapsUrl} target="_blank" rel="noreferrer">
								Leer reseñas en Google <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="menu section-pad" id="carta">
				<div class="menu-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Lo más pedido</p>
						<h2>Qué pedir<br />en <em>La Chimenea.</em></h2>
					</div>
					<div>
						<p>
							Selección hecha a partir de las reseñas públicas y de las menciones que Google
							destaca de la ficha del restaurante. La carta real depende de las piezas de carne
							disponibles cada día, así que pídela en el local y pregunta por las carnes del día.
						</p>
						<a class="button button-outline" href={phoneHref}>Preguntar por la carta</a>
					</div>
				</div>

				<ul class="dishes">
					{
						loMasPedido.map((plato) => (
							<li>
								<span class="dish">
									{plato.nombre}
									<em>{plato.nota}</em>
								</span>
							</li>
						))
					}
				</ul>
				<p class="menu-note">
					Muchas carnes se cobran al peso y la disponibilidad cambia a diario, así que la carta detallada se consulta en el local.
				</p>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>El asador,<br /><em>por dentro.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de La Chimenea Restaurante. En
							la ficha está la galería completa, con más de 570 fotos y las aportaciones de otros
							clientes.
						</p>
						<a class="button button-ember" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver todo en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						galeria.map((foto) => (
							<figure class="shot">
								<Image
									src={foto.src}
									alt={foto.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="avif"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Imágenes alojadas en esta web procedentes de la ficha de Google Maps del restaurante. Si
					eres el titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow dark"><span aria-hidden="true"></span> C. Juan de Rihuerga, 29 · 29010 Málaga</p>
					<h2>Nos vemos<br /><em>en Teatinos.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.district}<br />
						{business.postalCode} {business.city}, España<br />
						<span class="plus-code">Plus Code: PGGM+CF Málaga</span>
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr><th scope="row">Lunes</th><td>13:00 – 17:00</td></tr>
							<tr><th scope="row">Martes</th><td>13:00 – 17:00</td></tr>
