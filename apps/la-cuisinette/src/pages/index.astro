---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import interior from '../assets/fotos/la-cuisinette-apaisada-01.jpg';
import helado from '../assets/fotos/la-cuisinette-vertical-02.jpg';
import sencillo from '../assets/fotos/la-cuisinette-apaisada-03.jpg';
import coco from '../assets/fotos/la-cuisinette-apaisada-04.jpg';
import chocolate from '../assets/fotos/la-cuisinette-vertical-05.jpg';
import nutella from '../assets/fotos/la-cuisinette-apaisada-06.jpg';
import cabra from '../assets/fotos/la-cuisinette-apaisada-07.jpg';
import albaricoque from '../assets/fotos/la-cuisinette-apaisada-08.jpg';
import completa from '../assets/fotos/la-cuisinette-vertical-09.jpg';
import bacon from '../assets/fotos/la-cuisinette-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Crepería en Jaraíz de la Vera (Cáceres): crepes dulces y salados, galettes y café, solo por las noches. Av. de la Constitución, 24. Tel. 600 07 30 98.';

const galeria = [
	{
		src: interior,
		alt: 'Interior de La Cuisinette con la barra de madera, la cafetera, paredes naranjas y verdes y mesas con mantel de cuadros',
	},
	{
		src: completa,
		alt: 'Galette de La Cuisinette con jamón, champiñones, queso fundido y un huevo, servida en un plato negro',
	},
	{
		src: nutella,
		alt: 'Crepe de chocolate de La Cuisinette con virutas de frutos secos por encima',
	},
	{
		src: cabra,
		alt: 'Galette de trigo sarraceno con queso de cabra, bacon, nueces y ensalada de canónigos',
	},
	{
		src: helado,
		alt: 'Crepe de La Cuisinette con dos bolas de helado, caramelo y azúcar flameado',
	},
	{
		src: chocolate,
		alt: 'Crepe cuadrado cubierto de chocolate con una bola de helado en el centro',
	},
	{
		src: albaricoque,
		alt: 'Crepe de La Cuisinette con mermelada de albaricoque y un punto de llama azul',
	},
	{
		src: bacon,
		alt: 'Galette de La Cuisinette con bacon y queso fundido, servida en un plato metálico',
	},
	{
		src: coco,
		alt: 'Crepe doblado de La Cuisinette cubierto de coco rallado en un plato azul',
	},
	{
		src: sencillo,
		alt: 'Crepe doblado y dorado de La Cuisinette servido en un plato gris',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-cuisinette`,
	name: BUSINESS.name,
	alternateName: ['La Cuisinette', 'Creperia La Cuisinette', 'La Cuisinette Café Creperia'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 600 07 30 98',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Crepes', 'Francesa', 'Bretona'],
	areaServed: [
		{ '@type': 'City', name: 'Jaraíz de la Vera' },
		{ '@type': 'AdministrativeArea', name: 'La Vera' },
		{ '@type': 'AdministrativeArea', name: 'Cáceres' },
		{ '@type': 'AdministrativeArea', name: 'Extremadura' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Thursday', 'Sunday'],
			opens: '20:00',
			closes: '22:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '20:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody:
				'Buena atención y unos crepes muy ricos y variados tanto salados como dulces.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 4, bestRating: 5 },
			reviewBody: 'Muy buenos crepes y buen trato de la camarera',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Sitio totalmente recomendable, limpio y dueños encantadores.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'La Cuisinette · Crepería en Jaraíz de la Vera';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#23456b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Cuisinette Jaraíz de la Vera, crepería Jaraíz de la Vera, crepes Jaraíz de la Vera, galettes La Vera, cenar en Jaraíz de la Vera, crepes dulces y salados Cáceres, Av. de la Constitución Jaraíz, crepería cerca de Cuacos de Yuste"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="La Cuisinette · Crepería en Jaraíz de la Vera"
			ogDescription="Crepes dulces y salados, galettes y café en la avenida de la Constitución, 24 (Jaraíz de la Vera). Cenas de 20:00 a 23:00. Tel. 600 07 30 98."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Interior de La Cuisinette Café Crepería con mesas de mantel de cuadros"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#23456b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-EX"
			postalCode={BUSINESS.postalCode}
			phone="+34600073098"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[interior]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Cuisinette"
			subtitle="Café y crepería · Jaraíz de la Vera"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. de la Constitución, 24 · Jaraíz de la Vera"
				title="Crepes dulces<br /><em>y salados.</em>"
				lede={`La Cuisinette es café y crepería en la avenida de la Constitución, 24, de Jaraíz de la Vera (Cáceres), en plena comarca de La Vera. Crepes dulces y salados, galettes y café, en un local pequeño de paredes naranjas y verdes con manteles de cuadros. Abre para cenar, de 20:00 a 22:30 o 23:00 según el día. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={interior}
				imageAlt="Interior de La Cuisinette con la barra de madera, la cafetera y mesas con mantel de cuadros"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)`,
					},
					{ label: 'Horario', html: 'Cenas · 20:00–23:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phoneDisplay}</b>` },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece La Cuisinette Café Crepería" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un rincón<br /><em>bretón.</em>"
				paragraphs={[
					'La Cuisinette Café Crepería está en la avenida de la Constitución, 24, de Jaraíz de la Vera (Cáceres), en plena comarca de La Vera. Google la clasifica como crepería y la describe como un sitio «indicado para meriendas y cenas», aunque el horario que publica es solo de noche.',
					'El local es pequeño y de colores: paredes naranjas y verdes, barra de madera con cafetera, taburetes altos con asientos de ganchillo rojo y mesas vestidas con manteles de cuadros. En las paredes, carteles y mapas; en las fotos, crepes y galettes servidos en platos de cerámica y metal.',
					'Su ficha de Google reúne 166 reseñas y una nota media de 4,8 sobre 5. Lo que más se repite en ellas es el trato del personal y la variedad de crepes, «tanto salados como dulces».',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «buena atención y unos crepes muy ricos y variados tanto salados como dulces».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Dulces<br /><em>y salados.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que aparece en las fotos de su perfil y lo que nombran sus reseñas."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Sin carta publicada, la oferta cambia según el día. Llama al 600 07 30 98 para saber qué crepes hay esa noche y si queda mesa."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Crepes, galettes<br /><em>y sobremesa.</em>"
				description="Estas fotografías proceden del perfil de La Cuisinette en Google Maps: el interior con manteles de cuadros, los crepes dulces con chocolate, coco o helado, y las galettes saladas con queso de cabra, bacon o huevo."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>a la noche.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: solo cenas. Lunes, jueves y domingos de 20:00 a 22:30; viernes y sábados de 20:00 a 23:00. Martes y miércoles cierra."
				mapTitle="Mapa de La Cuisinette Café Crepería en la avenida de la Constitución, 24, Jaraíz de la Vera (Cáceres)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Cuisinette Café Crepería · Jaraíz de la Vera"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva llamando al 600 07 30 98. La ficha de Google marca acceso para sillas de ruedas; no marca aparcamiento ni aseo adaptados. Está en la avenida de la Constitución, 24, de Jaraíz de la Vera."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios y carta antes de la visita."
			ctaLabel="Llamar a La Cuisinette"
		/>
	</body>
</html>
