---
import '../styles/global.css';

const business = {
	name: 'Restaurante El Palenque',
	short: 'El Palenque',
	street: 'San Francisco 1',
	city: 'Barbate',
	postalCode: '11160',
	phone: '+34 956 45 17 04',
	latitude: 36.25414,
	longitude: -5.9659145,
	site: 'https://restaurante-el-palenque.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+El+Palenque/@36.25414,-5.9659145,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c45c8eab9b5c3:0x3c1e1a30f87fdfdc!8m2!3d36.25414!4d-5.9659145!16s%2Fg%2F11cnb7q8fv?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const phoneHref = 'tel:+34956451704';

const specialties = [
	{
		kicker: 'En el centro',
		title: 'Junto al teatro',
		text: 'Restaurante de barrio junto al teatro y al Hotel Convento San Francisco.',
	},
	{
		kicker: 'Del mar',
		title: 'Mar de Barbate',
		text: 'Zona de pesca y almadraba: confirma el pescado del día en el local.',
	},
	{
		kicker: 'De siempre',
		title: 'Cocina tradicional',
		text: 'Cocina tradicional a precio medio (€10–20 según resultados de Google).',
	},
	{
		kicker: 'De barrio',
		title: 'Barra y salón',
		text: 'Barra para el día a día y salón para comer tranquilo.',
	},
	{
		kicker: 'Contacto',
		title: '956 45 17 04',
		text: 'Llama para confirmar carta y horario antes de venir.',
	},
	{
		kicker: 'Aviso',
		title: 'Sin horario publicado',
		text: 'No publicamos horario por falta de fuente sólida y verificable.',
	},
];

const gallery = [
	{ src: '/fotos/fachada.svg', alt: 'Ilustración de la fachada — sustituye por foto propia' },
	{ src: '/fotos/salon.svg', alt: 'Ilustración del salón — sustituye por foto propia' },
	{ src: '/fotos/mar.svg', alt: 'Ilustración del mar — sustituye por foto propia' },
	{ src: '/fotos/barra.svg', alt: 'Ilustración de la barra — sustituye por foto propia' },
	{ src: '/fotos/teatro.svg', alt: 'Ilustración del teatro — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está El Palenque?',
		a: 'En San Francisco 1, 11160 Barbate (Cádiz), junto al teatro y al Hotel Convento San Francisco.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'El horario no está publicado en una fuente sólida. Confirma en el 956 45 17 04 antes de venir.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Restaurante tradicional de Barbate. Confirma la carta del día en el propio local.',
	},
	{
		q: '¿Cuánto cuesta?',
		a: 'Los resultados de Google lo sitúan en un rango medio de €10–20. Confirma precios en el local.',
	},
	{
		q: '¿Cómo llego?',
		a: 'En pleno centro de Barbate, en la calle San Francisco. Usa el botón «Cómo llegar» para abrir la ruta en Google Maps.',
	},
];

const description =
	'Restaurante El Palenque en San Francisco 1, Barbate. Restaurante tradicional junto al teatro. Tel. 956 45 17 04.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 956 45 17 04',
	image: [`${business.site}/fotos/fachada.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Andaluza'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="El Palenque: restaurante tradicional en San Francisco 1, Barbate, junto al teatro. 956 45 17 04." />
		<meta name="keywords" content="El Palenque Barbate, comer Barbate centro, San Francisco Barbate restaurante" />
		<meta name="author" content="El Palenque" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>El Palenque | Restaurante tradicional en Barbate</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="El Palenque · Tradicional en Barbate" />
		<meta property="og:description" content="Restaurante de barrio en San Francisco 1, junto al teatro." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/fachada.svg`} />
		<meta property="og:image:alt" content="El Palenque, Barbate" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="El Palenque · Restaurante en Barbate" />
		<meta name="twitter:description" content="San Francisco 1: tradicional junto al teatro." />
		<meta name="twitter:image" content={`${business.site}/fotos/fachada.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Barbate" />
		<meta name="geo.position" content="36.25414;-5.9659145" />
		<meta name="ICBM" content="36.25414, -5.9659145" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="El Palenque, inicio">
				<span class="brand-mark" aria-hidden="true">EP</span>
				<span class="brand-name">El Palenque <small>Barbate · Centro</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">El restaurante</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>956 45 17 04</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> San Francisco 1 · Barbate</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante tradicional en el centro de Barbate, junto al teatro:
						barra para el día a día y salón para comer tranquilo.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 956 45 17 04</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>Centro</b> Barbate</li>
						<li><b>Teatro</b> al lado</li>
						<li>€10–20</li>
						<li>Tradicional</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/fotos/fachada.svg" alt="Ilustración de El Palenque, Barbate" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>San Francisco 1 · Barbate</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>Centro</b><span>Barbate</span></div>
					<div><b>€10–20</b><span>Rango medio</span></div>
					<div><b>1</b><span>San Francisco</span></div>
				</div>
				<ul class="services">
					<li>Tradicional</li>
					<li>Barra</li>
					<li>Salón</li>
					<li>Centro</li>
					<li>Teatro</li>
					<li>Reservas</li>
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> El restaurante</p>
				<div class="about-grid">
					<h2>En San Francisco,<br />junto <em>al teatro.</em></h2>
					<div class="about-copy">
						<p>
							El Palenque está en San Francisco 1 (11160 Barbate),
							con coordenadas 36.25414, -5.9659145, junto al teatro
							y al Hotel Convento San Francisco.
						</p>
						<p>
							Restaurante tradicional de centro, con barra y salón, en rango
							medio de precios según los resultados de Google.
						</p>
						<p class="about-note">
							Horario y carta sin fuente sólida publicada. Confirma en el
							956 45 17 04 antes de venir.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales de restaurante tradicional. Confirma la carta del día
						en el propio local.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El centro<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del restaurante.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> San Francisco 1</p>
					<h2>Ven al centro<br /><em>a comer.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Horario</th>
								<td>A confirmar: 956 45 17 04</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Sin horario publicado en fuente sólida. Llama antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al restaurante ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 956 45 17 04</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de El Palenque en San Francisco 1, Barbate" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> El Palenque · Barbate</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">EP</span>
				<p>El Palenque<small>{business.street} · {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} El Palenque · Barbate. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>956 45 17 04</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
