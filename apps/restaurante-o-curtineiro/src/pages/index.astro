---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import comedor from '../assets/fotos/restaurante-o-curtineiro-apaisada-01.jpg';
import jarrete from '../assets/fotos/restaurante-o-curtineiro-vertical-02.jpg';
import postres from '../assets/fotos/restaurante-o-curtineiro-vista-3-03.jpg';
import letreros from '../assets/fotos/restaurante-o-curtineiro-cuadrada-04.jpg';
import fachada from '../assets/fotos/restaurante-o-curtineiro-apaisada-05.jpg';
import barra from '../assets/fotos/restaurante-o-curtineiro-apaisada-06.jpg';
import asado from '../assets/fotos/restaurante-o-curtineiro-apaisada-07.jpg';
import potaje from '../assets/fotos/restaurante-o-curtineiro-cuadrada-09.jpg';
import guisado from '../assets/fotos/restaurante-o-curtineiro-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Restaurante O Curtiñeiro, en Praza da Fonte 6 (32740 Parada de Sil, Ourense). Cocina gallega, menú del día y raciones en la Ribeira Sacra. Terraza en la plaza. Sin reserva. Tel. 619 02 07 01.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de piedra de Restaurante O Curtiñeiro en la Praza da Fonte, con dos toldos rojos y las mesas altas de la terraza delante',
	},
	{
		src: comedor,
		alt: 'Comedor de paredes de granito con mesas de madera vestidas, sillas con cojín rojo y un ventanuco al fondo',
	},
	{
		src: barra,
		alt: 'Interior del restaurante con vigas de madera, barra de piedra, taburetes y banderines del Celta colgados del techo',
	},
	{
		src: letreros,
		alt: 'Dos letreros de pizarra de Restaurante O Curtiñeiro sobre el muro de granito, rodeados de macetas de flores',
	},
	{
		src: jarrete,
		alt: 'Jarrete de ternera con patatas cocidas en un plato blanco',
	},
	{
		src: asado,
		alt: 'Fuente de carne asada con patatas fritas para compartir en el centro de la mesa',
	},
	{
		src: guisado,
		alt: 'Plato de carne guisada con zanahoria y patatas fritas cortadas en bastones',
	},
	{
		src: potaje,
		alt: 'Cuenco de potaje de legumbres con cuchara y un vaso de agua al lado',
	},
	{
		src: postres,
		alt: 'Bandeja de postres caseros con porciones de flan, tocino de cielo y tarta',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#o-curtineiro`,
	name: BUSINESS.name,
	alternateName: ['O Curtiñeiro', 'Restaurante O Curtiñeiro Parada de Sil', 'O Curtiñeiro Parada de Sil'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 619 02 07 01',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Gallega', 'Española', 'Casera'],
	areaServed: [
		{ '@type': 'City', name: 'Parada de Sil' },
		{ '@type': 'AdministrativeArea', name: 'Ourense' },
		{ '@type': 'AdministrativeArea', name: 'Galicia' },
		{ '@type': 'AdministrativeArea', name: 'Ribeira Sacra' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '08:00',
			closes: '22:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Restaurante O Curtiñeiro · Cocina gallega en Parada de Sil';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-o-curtineiro-apaisada-05.jpg": fachada,
	"restaurante-o-curtineiro-apaisada-01.jpg": comedor,
	"restaurante-o-curtineiro-apaisada-06.jpg": barra,
	"restaurante-o-curtineiro-cuadrada-04.jpg": letreros,
	"restaurante-o-curtineiro-vertical-02.jpg": jarrete,
	"restaurante-o-curtineiro-apaisada-07.jpg": asado,
	"restaurante-o-curtineiro-apaisada-10.jpg": guisado,
	"restaurante-o-curtineiro-cuadrada-09.jpg": potaje,
	"restaurante-o-curtineiro-vista-3-03.jpg": postres,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#7d2d28" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante O Curtiñeiro, O Curtiñeiro Parada de Sil, comer en Parada de Sil, restaurante Ribeira Sacra, menú del día Parada de Sil, cocina gallega Ourense, restaurante Praza da Fonte"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Restaurante O Curtiñeiro · Cocina gallega en Parada de Sil"
			ogDescription="Menú del día y raciones de cocina gallega en la Praza da Fonte de Parada de Sil (Ourense). Terraza bajo los toldos rojos. Sin reserva. Tel. 619 02 07 01."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de piedra de Restaurante O Curtiñeiro con sus toldos rojos en Parada de Sil"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#7d2d28"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-GA"
			postalCode={BUSINESS.postalCode}
			phone="+34619020701"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="O CURTIÑEIRO"
			subtitle="Cocina gallega · Parada de Sil"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a O Curtiñeiro"
		/>
	</body>
</html>
