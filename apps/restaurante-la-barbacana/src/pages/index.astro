---
const business = {
	name: 'Restaurante La Barbacana',
	street: 'Calle Juan Alameda, s/n',
	city: 'Marbella',
	region: 'Málaga',
	postalCode: '29601',
	country: 'ES',
	phone: '+34 670 51 83 00',
	latitude: 36.5166487,
	longitude: -4.8861775,
	site: 'https://restaurante-la-barbacana.vercel.app',
};

const mapsUrl = 'https://www.google.com/maps/place/Restaurante+La+Barbacana/@36.5166487,-4.8861775,17z/data=!4m6!3m5!1s0xd72d807d01e993b:0x69835668435ef8ee!8m2!3d36.5166487!4d-4.8861775!16s%2Fg%2F1hd_5dzb_?hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(`${business.name}, ${business.city}`)}&ll=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34670518300';
const instagramUrl = 'https://www.instagram.com/restaurantelabarbacanamarbella/';
const facebookUrl = 'https://www.facebook.com/restaurantelabarbacana';
const siteUrl = `${business.site}/`;
const description = 'Restaurante La Barbacana en Marbella: carnes a la brasa, pescados, paellas y menú diario. Consulta el horario, llama para reservar y encuentra cómo llegar desde el centro.';

const openingHours = [
	{ day: 'Lunes', value: 'Cerrado' },
	{ day: 'Martes', value: '12:00–16:00 · 20:00–23:30' },
	{ day: 'Miércoles', value: '12:00–16:00 · 20:00–23:30' },
	{ day: 'Jueves', value: '12:00–16:00 · 20:00–23:30' },
	{ day: 'Viernes', value: '12:00–16:00 · 20:00–23:30' },
	{ day: 'Sábado', value: '12:00–16:00 · 20:00–23:30' },
	{ day: 'Domingo', value: '12:00–16:30' },
];

const faqs = [
	{
		question: '¿Dónde está el Restaurante La Barbacana?',
		answer: 'Está en la calle Juan Alameda, s/n, 29601 Marbella (Málaga). Consulta el mapa de Google Maps para ver la ubicación exacta y obtener indicaciones.',
	},
	{
		question: '¿Qué tipo de comida sirven?',
		answer: 'La Barbacana ofrece cocina a la brasa y marinera: carnes, pescados, parrilladas, paellas, ensaladas y platos de cocina mediterránea y española. La carta y la disponibilidad pueden variar.',
	},
	{
		question: '¿Hay menú del día?',
		answer: 'El restaurante anuncia menús de martes a viernes. Para conocer el menú del día, el precio y las opciones disponibles, lo mejor es llamar antes de ir.',
	},
	{
		question: '¿Cuál es el horario?',
		answer: 'El horario publicado indica cierre los lunes; de martes a sábado, servicio de 12:00 a 16:00 y de 20:00 a 23:30; y los domingos de 12:00 a 16:30. Puede cambiar en festivos, así que conviene confirmar por teléfono.',
	},
	{
		question: '¿Cómo puedo reservar mesa?',
		answer: 'Llama al +34 670 51 83 00 para consultar disponibilidad y reservar directamente con el restaurante.',
	},
	{
		question: '¿Dónde puedo ver fotos del restaurante?',
		answer: 'Puedes consultar las fotos de la ficha del restaurante en Google Maps desde el enlace de esta página. También encontrarás publicaciones en sus cuentas sociales.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${siteUrl}#restaurant`,
	name: business.name,
	description,
	url: siteUrl,
	telephone: business.phone,
	priceRange: '20–30 €',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Mediterránea', 'Cocina a la brasa', 'Cocina marinera'],
	acceptsReservations: true,
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: business.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [mapsUrl, instagramUrl, facebookUrl],
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '12:00', closes: '16:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '20:00', closes: '23:30' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '12:00', closes: '16:30' },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

import Galeria from '../components/Galeria.astro';---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#292c28" />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" />
		<title>Restaurante La Barbacana en Marbella | Brasa, pescado y paella</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Restaurante La Barbacana · Brasa y cocina marinera en Marbella" />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${business.site}/og.svg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Restaurante La Barbacana en Marbella, carnes y pescados a la brasa" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="Marbella" />
		<meta name="geo.position" content="36.5166487;-4.8861775" />
		<meta name="ICBM" content="36.5166487, -4.8861775" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Restaurante La Barbacana, inicio">
				<span class="brand-mark" aria-hidden="true">B</span>
				<span>La Barbacana <small>Restaurante · Marbella</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cocina">La cocina</a>
				<a href="#fotos">Fotos</a>
				<a href="#horario">Horario</a>
				<a href="#visitanos">Cómo llegar</a>
			</nav>
			<a class="header-call" href={phoneHref}>Llamar · 670 51 83 00</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span>Marbella · Málaga</span><i aria-hidden="true"></i> Cocina a la brasa</p>
					<h1 id="hero-title">La brasa en su punto.<br />Marbella <em>a la mesa.</em></h1>
					<p class="lede">Carnes a la brasa, pescados frescos y paellas para disfrutar en el Restaurante La Barbacana, en Marbella. Cocina de tradición, buen producto y un menú diario para saborear entre semana.</p>
					<div class="actions">
						<a class="button button-gold" href={phoneHref}>Llamar para reservar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-details"><span>⌖ Calle Juan Alameda, s/n</span><span>♨ Carnes y pescados a la brasa</span></div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración decorativa de una parrilla encendida con brasas y hierbas aromáticas">
					<div class="glow"></div><div class="smoke smoke-one"></div><div class="smoke smoke-two"></div>
					<div class="ember ember-one"></div><div class="ember ember-two"></div><div class="ember ember-three"></div>
					<div class="grill"><div class="grill-lines"></div><div class="grill-food food-one"></div><div class="grill-food food-two"></div><div class="grill-food food-three"></div><div class="herb herb-one">✳</div><div class="herb herb-two">✿</div></div>
					<div class="art-label"><b>Fuego lento</b><span>Buen producto · sabor de verdad</span></div>
					<div class="art-stamp">DESDE<br /><strong>2016</strong></div>
				</div>
			</section>

			<div class="ticker" aria-label="Especialidades"><span>Carne a la brasa</span><b>✳</b><span>Pescado fresco</span><b>✳</b><span>Paellas</span><b>✳</b><span>Menú diario</span><b>✳</b><span>Parrilladas</span></div>

			<section class="intro section-wrap" id="cocina">
				<div><p class="eyebrow eyebrow-dark">Tradición con sabor a brasa</p><h2>El fuego reúne.<br /><em>La mesa lo celebra.</em></h2></div>
				<div class="intro-copy"><p>En La Barbacana, la brasa marca el ritmo de una cocina que combina carnes, pescados y recetas de inspiración mediterránea. Un restaurante en Marbella para disfrutar de una parrillada, compartir una paella o hacer una pausa con el menú del día.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Lee opiniones y consulta la ficha en Google Maps ↗</a></div>
			</section>

			<section class="specialties section-wrap" aria-labelledby="specialties-title">
				<div class="section-heading"><p class="eyebrow eyebrow-dark">Producto, fuego y sobremesa</p><h2 id="specialties-title">De la parrilla<br /><em>a tu mesa.</em></h2><p>Una selección de las especialidades anunciadas por el restaurante. La carta, los precios y la disponibilidad pueden variar.</p></div>
				<div class="special-grid">
					<article class="special-card special-meat"><span class="special-icon" aria-hidden="true">♨</span><span class="card-kicker">EL FUEGO</span><h3>Carnes a la brasa</h3><p>Parrilladas y asados con ese aroma inconfundible que abre el apetito.</p></article>
					<article class="special-card special-fish"><span class="special-icon" aria-hidden="true">≈</span><span class="card-kicker">DEL MAR</span><h3>Pescados y parrilladas</h3><p>Sabores marineros, pescado frito y parrilladas para compartir.</p></article>
					<article class="special-card special-paella"><span class="special-icon" aria-hidden="true">◉</span><span class="card-kicker">PARA COMPARTIR</span><h3>Paellas</h3><p>Arroz y buenos momentos alrededor de la mesa, en el corazón de Marbella.</p></article>
					<article class="special-card special-menu"><span class="special-icon" aria-hidden="true">☼</span><span class="card-kicker">ENTRE SEMANA</span><h3>Menú diario</h3><p>Una propuesta de martes a viernes. Consulta el menú y las opciones del día.</p></article>
				</div>
				<p class="menu-note">Para confirmar platos, precios y disponibilidad, llama al restaurante antes de tu visita.</p>
			</section>

			<section class="photo-section" id="fotos">
				<div class="photo-copy"><p class="eyebrow">La Barbacana en Google Maps</p><h2>Conoce el lugar<br />antes de <em>llegar.</em></h2><p>Abre la ficha del restaurante para ver las fotos de sus platos, el interior y el ambiente publicadas en Google Maps, además de las reseñas y los datos actualizados.</p><a class="button button-gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver fotos y ficha en Google Maps <span aria-hidden="true">↗</span></a><a class="instagram-link" href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram del restaurante ↗</a></div>
				<div class="map-photo"><iframe title="Google Maps: ubicación del Restaurante La Barbacana en Marbella" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><a class="map-caption" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span>⌖</span><span><b>Restaurante La Barbacana</b><small>Ubicación, fotos y reseñas en Google Maps ↗</small></span></a></div>
			</section>

			<section class="visit section-wrap" id="visitanos">
				<div class="visit-copy"><p class="eyebrow eyebrow-dark">Estamos en Marbella</p><h2>Nos vemos<br /><em>alrededor del fuego.</em></h2><p>Ven a disfrutar de la brasa, el pescado y una buena paella en el Restaurante La Barbacana.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button button-dark" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Llamar · 670 51 83 00</a></div></div>
				<div class="hours-card" id="horario"><div class="hours-title"><span class="clock" aria-hidden="true">◷</span><div><p class="eyebrow eyebrow-dark">Organiza tu visita</p><h3>Horario</h3></div></div><dl>{openingHours.map(({ day, value }) => <div class:list={[{ closed: value === 'Cerrado' }]}><dt>{day}</dt><dd>{value}</dd></div>)}</dl><p class="hours-note">Horario publicado en directorios. Puede cambiar en festivos o por temporada; confirma por teléfono antes de desplazarte.</p></div>
			</section>

			<section class="faq-section section-wrap" id="preguntas"><p class="eyebrow eyebrow-dark">Preguntas frecuentes</p><h2>Todo listo <em>para venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
			<Galeria nombre="Restaurante La Barbacana" mapsUrl={mapsUrl} />
		</main>

		<footer class="footer"><div class="footer-top"><a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">B</span><span>La Barbacana <small>Restaurante · Marbella</small></span></a><p>Brasa, mar y buena mesa<br />en Marbella.</p><nav aria-label="Enlaces del restaurante"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={facebookUrl} target="_blank" rel="noopener noreferrer">Facebook ↗</a><a href={phoneHref}>670 51 83 00</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Restaurante La Barbacana · Marbella</span><a href="/aviso-legal/">Aviso legal y privacidad</a><span>Consulta con el establecimiento la información actualizada.</span></div></footer>
		<a class="mobile-call" href={phoneHref}>Llamar <span>670 51 83 00</span></a>
	</body>
</html>

<style is:global>
	:root{font-family:'DM Sans',sans-serif;color:#292e2a;background:#f8f5ed;font-synthesis:none;text-rendering:optimizeLegibility;--charcoal:#292c28;--dark:#20231f;--olive:#707a4a;--gold:#d6a94e;--cream:#f8f5ed;--ink:#292e2a;--muted:#72756d;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid #d6a94e;outline-offset:4px}.skip-link{position:absolute;z-index:99;top:-60px;left:16px;padding:12px 16px;background:var(--gold);color:#20231f}.skip-link:focus{top:12px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:22px;background:var(--charcoal);color:#faf7ef}.brand{display:flex;align-items:center;gap:11px;font-size:15px;font-weight:700}.brand small{display:block;margin-top:4px;color:#cbc9bb;font-size:9px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid #d6a94e;border-radius:50%;color:#e0bc6e;font:700 23px var(--display)}.topbar nav{display:flex;gap:clamp(14px,2.5vw,32px);color:#e3e0d5;font-size:12px}.topbar nav a:hover,.footer a:hover{color:#e0bc6e}.header-call{padding:11px 17px;border:1px solid #ffffff50;border-radius:99px;font-size:11px;font-weight:700}.hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:560px;background:var(--charcoal);color:#faf7ef;overflow:hidden}.hero-copy{padding:73px 4vw 64px 9vw;align-self:center}.eyebrow{margin:0 0 19px;color:#cbbb8b;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase}.eyebrow i{display:inline-block;width:22px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.section-heading h2,.photo-copy h2,.visit h2,.faq-section h2{margin:0;font:600 clamp(39px,4.8vw,64px)/1.08 var(--display);letter-spacing:-1.2px}.hero h1 em,.intro h2 em,.section-heading h2 e