---
import '../styles/global.css';
import { business, directionsUrl, mapEmbedUrl, mapsUrl, phoneHref, structuredData } from '../lib/business';

const title = 'Ricardo Román García | Taller mecánico en Málaga';
const description =
	'Taller mecánico Ricardo Román García en Málaga. Encuéntranos en Calle Los Millones, 7. Llama al 952 30 65 35 o consulta cómo llegar en Google Maps.';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#202522" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://ricardo-roman-garcia.vercel.app/og.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7246234;-4.4445532" />
		<meta name="ICBM" content="36.7246234, -4.4445532" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Ricardo Román García, inicio">
				<span class="brand-mark" aria-hidden="true"><span>RR</span><i></i></span>
				<span class="brand-name">Ricardo Román García <small>Taller mecánico · Málaga</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#taller">El taller</a>
				<a href="#ubicacion">Ubicación</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}><span aria-hidden="true">↗</span> 952 30 65 35</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="blueprint" aria-hidden="true"></div>
				<div class="hero-copy">
					<p class="eyebrow"><span class="status-mark" aria-hidden="true"></span> Calle Los Millones · Málaga</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Ricardo Román García, taller mecánico en la zona de Los Millones. Consulta la ubicación y
					llama antes de venir.
					</p>
					<div class="hero-actions">
						<a class="button button-amber" href={phoneHref}><span aria-hidden="true">↗</span> Llamar al taller</a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="hero-address">
						<span class="address-mark" aria-hidden="true">⌖</span>
						<span><small>ENCUÉNTRANOS EN</small><strong>{business.streetAddress} · {business.city}</strong></span>
					</div>
				</div>

				<div class="hero-art" aria-label="Ilustración técnica decorativa de motor, no fotografía del taller">
					<div class="art-label art-label-top">TALLER MECÁNICO <span>·</span> MÁLAGA</div>
					<div class="art-label art-label-bottom">RR / SERVICIO LOCAL</div>
					<div class="orbit orbit-a"></div>
					<div class="orbit orbit-b"></div>
					<div class="gear gear-large"><i></i><b></b></div>
					<div class="gear gear-small"><i></i><b></b></div>
					<div class="engine-block">
						<span class="engine-cap"></span>
						<span class="engine-top"></span>
						<span class="engine-body"><i></i><i></i><i></i></span>
						<span class="engine-foot"></span>
					</div>
					<span class="measure measure-one" aria-hidden="true"></span>
					<span class="measure measure-two" aria-hidden="true"></span>
				</div>
			</section>

			<section class="identity-strip" id="taller" aria-label="Datos del taller">
				<div class="identity-mark" aria-hidden="true">RR<span>.</span></div>
				<p><small>ACTIVIDAD</small><strong>{business.businessType}</strong></p>
				<span class="strip-rule" aria-hidden="true"></span>
				<p><small>DIRECCIÓN</small><strong>{business.streetAddress}</strong></p>
				<span class="strip-rule" aria-hidden="true"></span>
				<p><small>LOCALIDAD</small><strong>{business.postalCode} {business.city}</strong></p>
			</section>

			<section class="location section-pad" id="ubicacion" aria-labelledby="location-title">
				<div class="location-copy">
					<p class="eyebrow dark"><span class="eyebrow-line" aria-hidden="true"></span> Cómo llegar</p>
					<h2 id="location-title">Nos vemos<br /><em>en Los Millones.</em></h2>
					<p class="location-lede">
						El taller se encuentra en Calle Los Millones, 7, en Málaga. Llama para consultar cualquier
						información antes de desplazarte.
					</p>
					<address>
						<span class="pin-box" aria-hidden="true">⌖</span>
						<span><strong>{business.streetAddress}</strong><small>{business.postalCode} {business.city}, España</small></span>
					</address>
					<a class="phone-number" href={phoneHref}><small>TELÉFONO</small><strong>952 30 65 35</strong></a>
					<div class="location-actions">
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
						<a class="text-link" href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha de Google Maps ↗</a>
					</div>
					<p class="note">Consulta directamente con el taller los servicios disponibles y el horario actual.</p>
				</div>
				<div class="map-shell">
					<div class="map-head"><span><i aria-hidden="true"></i> UBICACIÓN</span><span>MÁLAGA · ES</span></div>
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
						title="Mapa de Ricardo Román García, taller mecánico en Calle Los Millones, 7, Málaga"
					 src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-tag" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Ricardo Román García</a>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio" aria-label="Ricardo Román García, volver al inicio">
				<span class="brand-mark" aria-hidden="true"><span>RR</span><i></i></span>
				<span class="brand-name">Ricardo Román García <small>Taller mecánico · Málaga</small></span>
			</a>
			<p>{business.streetAddress} · {business.postalCode} {business.city}</p>
			<a class="footer-phone" href={phoneHref}>952 30 65 35 <span aria-hidden="true">↗</span></a>
			<small>© {new Date().getFullYear()} {business.name}. Información de contacto y ubicación.</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
	<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
	<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
	<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
</nav>
</footer>

		<a class="mobile-call" href={phoneHref}><span aria-hidden="true">↗</span> Llamar al taller <strong>952 30 65 35</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34952306535?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Ricardo%20Rom%C3%A1n%20Garc%C3%ADa." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Ricardo Román García"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>


