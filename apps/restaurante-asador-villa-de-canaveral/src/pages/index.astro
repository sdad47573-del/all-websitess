---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/restaurante-asador-villa-de-canaveral-apaisada-04.jpg';
import comedorPiedra from '../assets/fotos/restaurante-asador-villa-de-canaveral-apaisada-01.jpg';
import cordero from '../assets/fotos/restaurante-asador-villa-de-canaveral-vertical-03.jpg';
import corderoPatatas from '../assets/fotos/restaurante-asador-villa-de-canaveral-vertical-10.jpg';
import ensaladaMarisco from '../assets/fotos/restaurante-asador-villa-de-canaveral-vertical-05.jpg';
import ensaladaJamon from '../assets/fotos/restaurante-asador-villa-de-canaveral-vertical-06.jpg';
import pechuga from '../assets/fotos/restaurante-asador-villa-de-canaveral-vertical-07.jpg';
import alubias from '../assets/fotos/restaurante-asador-villa-de-canaveral-vertical-08.jpg';
import brocheta from '../assets/fotos/restaurante-asador-villa-de-canaveral-vertical-09.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Restaurante Asador Villa de Cañaveral, chuletillas de cordero a la brasa y cocina casera en la Avenida Dr. Boticario (Cañaveral, Cáceres). Platos de cuchara, marisco y postres caseros. Reservas en el 609 18 64 73.';

const galeria = [
	{ src: comedorPiedra, alt: 'Comedor de paredes de piedra y mesas de madera del Asador Villa de Cañaveral' },
	{ src: cordero, alt: 'Chuletillas de cordero a la brasa con patatas y pimiento asado del Asador Villa de Cañaveral' },
	{ src: corderoPatatas, alt: 'Chuletillas de cordero con patatas y pimiento rojo asado en Cañaveral' },
	{ src: brocheta, alt: 'Brocheta de langostinos y vieiras con patata del Asador Villa de Cañaveral' },
	{ src: pechuga, alt: 'Pechuga a la plancha con patatas y pimiento rojo del Asador Villa de Cañaveral' },
	{ src: alubias, alt: 'Alubias con jamón, plato de cuchara del Asador Villa de Cañaveral' },
	{ src: ensaladaJamon, alt: 'Ensalada con jamón, frutos secos y queso del Asador Villa de Cañaveral' },
	{ src: ensaladaMarisco, alt: 'Ensalada de marisco con langostinos y aceitunas del Asador Villa de Cañaveral' },
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#asador`,
	name: BUSINESS.name,
	alternateName: [
		'Asador Villa de Cañaveral',
		'Villa de Cañaveral',
		'Restaurante Asador Cañaveral',
	],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 609 18 64 73',
	priceRange: BUSINESS.priceRange,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Asador', 'Extremeña', 'Cocina casera'],
	areaServed: [
		{ '@type': 'City', name: 'Cañaveral' },
		{ '@type': 'AdministrativeArea', name: 'Cáceres' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId }],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:30',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '20:00',
			closes: '21:30',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Comedor rústico', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Bodega a la vista', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Reserva por teléfono', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El asador', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Asador Villa de Cañaveral · Cordero y cocina casera en Cañaveral (Cáceres)';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#4a3226" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.shortName}
			description={description}
			keywords="Asador Villa de Cañaveral, restaurante Cañaveral Cáceres, asador Cañaveral, chuletillas de cordero Cáceres, comer en Cañaveral, Monfragüe restaurante, Avenida Dr. Boticario, cocina casera Cáceres"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Asador Villa de Cañaveral · Cordero a la brasa y cocina casera"
			ogDescription="Chuletillas de cordero, brochetas de langostinos, platos de cuchara y postres caseros en un comedor de piedra y madera de Cañaveral (Cáceres). 4,2 en Google con 680 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Chuletillas de cordero a la brasa del Asador Villa de Cañaveral"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.shortName}
			themeColor="#4a3226"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			postalCode={BUSINESS.postalCode}
			phone="+34609186473"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Villa de Cañaveral"
			subtitle="Asador · Cáceres"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. Dr. Boticario · Cañaveral"
				title="Cordero a la brasa<br /><em>en Cañaveral.</em>"
				lede={`Chuletillas de cordero, brochetas de langostinos y platos de cuchara en un comedor de madera y piedra, con la bodega a la vista. Comidas y cenas de lunes a sábado; domingo solo a mediodía y miércoles cerrado. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={comedor}
				imageAlt="Comedor de mesas de madera y puerta de bodega del Asador Villa de Cañaveral"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)` },
					{ label: 'Horario', html: 'Lun–Sáb · 12:30 y 20:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phoneDisplay}</b>` },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece el Asador Villa de Cañaveral" items={SERVICIOS} />

			<LocalAbout
				label="El asador"
				title="Brasa, bodega<br /><em>y mantel.</em>"
				paragraphs={[
					`El Asador Villa de Cañaveral está en la Avenida Dr. Boticario, en Cañaveral (${BUSINESS.postalCode}, Cáceres), en la comarca de Monfragüe. Comedor de mesas de madera, paredes de piedra y una puerta de bodega con las botellas a la vista.`,
					'La brasa es la protagonista: chuletillas de cordero con patatas y pimiento asado, brochetas de langostinos y pechuga a la plancha. También platos de cuchara como las alubias con jamón, ensaladas y una tosta de jamón al corte que sale en las reseñas. Y postres caseros.',
					'La ficha de Google no publica carta ni precios, así que aquí no se inventan: esta web resume lo que se ve en sus fotos y lo que cuentan sus clientes. Para precios y disponibilidad se llama al restaurante.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Se repiten la comida casera, los postres caseros, la tosta de jamón al corte y el buen trato.`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.cid, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Cordero, brasa<br /><em>y cuchara.</em>"
				description="Resumen de lo que se sirve, sacado de las fotos de la ficha de Google Maps y de las reseñas. No es la carta completa ni tiene precios: se consultan en el asador."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La carta cambia con el mercado y la temporada. Si vas por un plato concreto, llama antes: no publicamos precios porque el restaurante no los tiene publicados."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor<br /><em>y la mesa.</em>"
				description="Estas fotografías proceden del perfil del Asador Villa de Cañaveral en Google Maps: el comedor de piedra y madera, el cordero a la brasa, la brocheta de langostinos y los platos de cuchara."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Nos vemos<br /><em>en la avenida.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google. De lunes a sábado hay dos servicios, 12:30–15:30 y 20:00–21:30; el domingo solo a mediodía y el miércoles cierra."
				mapTitle="Mapa del Asador Villa de Cañaveral en la Avenida Dr. Boticario, Cañaveral (Cáceres)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Asador Villa de Cañaveral"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva llamando al asador. La ficha de Google solo marca asientos adaptados, así que si necesitas acceso o aseo adaptados conviene preguntar antes por teléfono."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Asador Villa de Cañaveral"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.cid, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar al Asador Villa de Cañaveral"
		/>
	</body>
</html>
