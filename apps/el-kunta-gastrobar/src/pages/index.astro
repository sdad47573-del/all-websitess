---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	descripcionLocal,
	directionsUrl,
	faqSchema,
	faqs,
	horarioNota,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const title = 'El kunta gastrobar · Tapas y comidas en Puebla de Guzmán';
const description =
	'El kunta gastrobar, restaurante andaluz en la Av. Constitución, 4 de Puebla de Guzmán. 4,7 sobre 5 con 25 reseñas; desayunos, tapas y comidas según el titular.';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas nueve fotografías, así que no se inventa una
 * descripción y todos los `alt` avisan solo de dónde salen.
 */
const altFoto =
	'Fotografía publicada en la ficha de Google Maps de El kunta gastrobar, en Puebla de Guzmán';
const altOg = 'Fotografía de El kunta gastrobar publicada en su ficha de Google Maps';

/** Galería completa: las nueve fotografías de la ficha, en el orden en que se descargaron. */
const galeria = [
	'el-kunta-gastrobar-vertical-01.jpg',
	'el-kunta-gastrobar-vertical-02.jpg',
	'el-kunta-gastrobar-vertical-03.jpg',
	'el-kunta-gastrobar-vertical-04.jpg',
	'el-kunta-gastrobar-vertical-05.jpg',
	'el-kunta-gastrobar-vertical-06.jpg',
	'el-kunta-gastrobar-vertical-07.jpg',
	'el-kunta-gastrobar-apaisada-08.jpg',
	'el-kunta-gastrobar-vertical-09.jpg',
];

/**
 * Tres fotos de avance en el collage de la portada (también están en la galería).
 *
 * La ficha trae **una sola apaisada** y ocho verticales, así que arriba va la apaisada 08, que es
 * la que encaja en el hueco de 16/9 sin recorte apreciable, y abajo van dos verticales, la 01 y
 * la 02.
 */
const collage = [
	{ name: 'el-kunta-gastrobar-apaisada-08.jpg', clase: 'collage-item collage-item-a' },
	{ name: 'el-kunta-gastrobar-vertical-01.jpg', clase: 'collage-item collage-item-b' },
	{ name: 'el-kunta-gastrobar-vertical-02.jpg', clase: 'collage-item collage-item-c' },
];

/**
 * Número de reseñas destacadas que publica la ficha.
 *
 * Aquí son tres, pero se cuenta en vez de escribirlo a mano para que el texto no se desincronice
 * si la ficha cambia.
 */
const numeroResenas = reviews.length;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#14201c" />
		<meta name="description" content={description} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-H" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">EK</span>
				<span class="brand-text">
					El kunta gastrobar
					<small>Puebla de Guzmán · Huelva</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#local">El local</a>
				<a href="#palabras">En sus palabras</a>
				<a href="#fotos">Las fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-cta" href={directionsUrl} target="_blank" rel="noopener noreferrer">
				<span aria-hidden="true">➤</span>
				Cómo llegar
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Puebla de Guzmán · Av. Constitución, 4</p>
						<h1 id="hero-title">
							El kunta gastrobar,
							<br />
							<em>desayunos, tapas y comidas.</em>
						</h1>
						<p class="hero-lede">
							El kunta gastrobar está en la Av. Constitución, 4, con código postal 21550, en
							Puebla de Guzmán (Huelva). Google lo clasifica como restaurante andaluz y le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas. La ficha no publica
							horario ni teléfono: Google muestra en su lugar las sugerencias «Añadir
							horario» y «Añadir teléfono».
						</p>
						<div class="hero-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode} {business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
									{business.reviewCount.toLocaleString('es-ES')} reseñas
								</strong>
							</li>
						</ul>
					</div>

					<div class="hero-collage">
						{collage.map((item, index) => (
							<figure class={item.clase}>
								<Image
									src={foto(item.name)}
									alt={altFoto}
									widths={index === 0 ? [640, 900, 1200] : [320, 480, 640]}
									sizes={
										index === 0
											? '(max-width: 1080px) 92vw, 46vw'
											: '(max-width: 1080px) 45vw, 23vw'
									}
									format="avif"
									quality={68}
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : undefined}
									decoding="async"
								/>
							</figure>
						))}
					</div>
				</div>
			</section>

			<div class="band">
				<span>
					{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
					{business.reviewCount.toLocaleString('es-ES')} reseñas
				</span>
				<span>
					{business.streetAddress} · {business.postalCode} {business.city}
				</span>
				<span>{hoursSummary}</span>
				<span>Plus code {business.plusCode}</span>
			</div>

			<section class="section" id="local" aria-labelledby="local-title">
				<div class="wrap bar-grid">
					<div class="bar-text">
						<p class="kicker">El local</p>
						<h2 class="title" id="local-title">
							Un gastrobar en la travesía
							<br />
							<em>de Puebla de Guzmán.</em>
						</h2>
						<p>
							Google lo clasifica como restaurante andaluz y le da{' '}
							{business.rating.toLocaleString('es-ES')} sobre 5 con{' '}
							{business.reviewCount.toLocaleString('es-ES')} reseñas. Está en la Av.
							Constitución, 4, con código postal 21550, y la ficha publica su plus code
							JP6X+J7 Puebla de Guzmán.
						</p>
						<p>
							Según la descripción del titular, el local ofrece «desayunos tapas y comidas» y
							cuenta con «aparcamientos privados». En las reseñas que destaca la ficha se
							habla de comida casera, de atún con tomate y de ensaladilla, y una de ellas
							señala que le vendría bien algo más de cantidad.
						</p>
						<p>
							Esta web se ha preparado solo con lo que publica la ficha, consultada el{' '}
							{site.consultado}: nombre, dirección, categoría, la descripción del titular,
							valoración, el único dato de accesibilidad que publica, las {numeroResenas}{' '}
							reseñas que destaca y sus propias fotografías. La ficha no publica horario,
							teléfono, carta, precios, web propia ni distintivo, así que aquí no se
							reproduce nada de eso.
						</p>
					</div>
					<div class="quote-row">
						<div class="quote-score">
							<strong>{business.rating.toLocaleString('es-ES')} / 5</strong>
							<span>{business.reviewCount.toLocaleString('es-ES')} reseñas en Google Maps</span>
							<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver todas ↗</a>
						</div>
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									<strong>{review.rating} sobre 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>

			<section class="section palabras" id="palabras" aria-labelledby="palabras-title">
				<div class="wrap">
					<p class="kicker">En sus palabras</p>
					<h2 class="title" id="palabras-title">
						La ficha, <em>palabra por palabra.</em>
					</h2>
					<p class="lead">
						Descripción que el propio local publica en su ficha de Google Maps, reproducida
						literal: con sus espacios sueltos antes de las comas y su punto seguido de
						minúscula. Esta web no la corrige ni la amplía.
					</p>
					<div class="descripcion-local">{descripcionLocal}</div>
				</div>
			</section>

			<section class="section cocina" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						El local <em>por dentro.</em>
					</h2>
					<p class="lead">
						Son las nueve fotografías que El kunta gastrobar publica en su ficha de Google
						Maps: una apaisada y ocho verticales. La descarga no atribuye autor a ninguna de
						ellas, así que van sin pie; la ficha tampoco describe su contenido y aquí no se
						inventa ninguna descripción.
					</p>
					<div class="cocina-grid">
						{galeria.map((name) => (
							<figure class="cocina-item">
								<Image
									src={foto(name)}
									alt={altFoto}
									widths={[380, 560, 800]}
									sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 30vw"
									format="avif"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))}
					</div>
					<p class="cocina-note">
						La ficha no publica la carta ni los precios, así que esta web no los reproduce.
						Tampoco publica teléfono con el que preguntar: la vía publicada es la propia{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							ficha del local en Google Maps ↗
						</a>
						, con sus fotos y sus reseñas.
					</p>
				</div>
			</section>

			<section class="section" id="horario" aria-labelledby="horario-title">
				<div class="wrap horario-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Av. Constitución, 4,
							<br />
							<em>21550 Puebla de Guzmán.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.province} · España
						</address>
						<p class="hours-note">{horarioNota}</p>
						<p class="hours-note">
							Tampoco hay un teléfono que reproducir: la ficha no publica ninguno y esta web
							no se lo inventa. El contacto publicado es el botón de la ficha en Google Maps,
							donde además están las reseñas y las fotos.
						</p>
						<p class="access-note">Accesibilidad que publica la ficha:</p>
						<ul class="access-list">
							{accesibilidad.map((item) => (
								<li class:list={[{ 'is-no': !item.disponible }]}>{item.label}</li>
							))}
						</ul>
						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="map-card">
						<iframe
							title={`Mapa de ${business.name} en ${business.city}, ${business.province}`}
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen></iframe>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>ir.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">EK</span>
					<span>
						El kunta gastrobar
						<small>
							{business.streetAddress} · {business.postalCode} {business.city}
						</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Ubicación y ficha del local">
					<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
						Cómo llegar ↗
					</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} El kunta gastrobar · Av. Constitución, 4 (21550 Puebla
					de Guzmán). Web informativa elaborada con los datos y las fotografías que el local
					publica en su ficha de Google Maps, consultada el {site.consultado}. La ficha no
					publica horario ni teléfono: confirma esos datos en la propia ficha antes de ir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
