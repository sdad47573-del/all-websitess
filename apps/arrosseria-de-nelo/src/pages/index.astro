---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/arrosseria-de-nelo-apaisada-01.jpg';
import marisco from '../assets/fotos/arrosseria-de-nelo-vertical-05.jpg';
import secreto from '../assets/fotos/arrosseria-de-nelo-vertical-09.jpg';
import pulpo from '../assets/fotos/arrosseria-de-nelo-vertical-03.jpg';
import pollo from '../assets/fotos/arrosseria-de-nelo-apaisada-07.jpg';
import pescado from '../assets/fotos/arrosseria-de-nelo-vertical-02.jpg';
import postre from '../assets/fotos/arrosseria-de-nelo-vertical-06.jpg';

import { cidUrl, mapsUrl, placeId, reviewsUrl } from '../maps';

const business = {
	name: "L'Arrosseria de Nelo",
	brand: "Nelo's",
	street: 'Carrer de Campoamor, 34',
	city: 'Castelló de la Plana',
	region: 'Castelló',
	postalCode: '12001',
	phone: '964 72 36 77',
	latitude: 39.9842304,
	longitude: -0.0362978,
	rating: 4.4,
	reviewsCount: 892,
	site: 'https://arrosseria-de-nelo.vercel.app',
};

const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34964723677';

const description =
	"L'Arrosseria de Nelo, arrocería y tapería en la calle Campoamor, 34, Castellón: paellas, arroces melosos y caldosos, pescado y carnes a la piedra.";

const servicios = [
	'Arrocería',
	'Paellas',
	'Arroces melosos y caldosos',
	'Cocina española',
	'Mediterránea',
	'Pescado de temporada',
	'Carnes a la piedra',
	'Comida casera',
	'Reservas por teléfono',
	'Acceso adaptado',
];

const grupos = [
	{
		title: 'Los arroces',
		items: [
			{
				name: 'Paella de marisco',
				note: 'con gambas, mejillones y calamar, judía verde y alcachofa',
			},
			{
				name: 'Arroz de secreto y setas',
				note: '«increíble, ración generosa y un sabor muy rico», dice una reseña',
			},
			{
				name: 'Paella de pollo y verduras',
				note: 'pollo de corral y judía verde, en la paella de siempre',
			},
			{
				name: 'Melosos y caldosos',
				note: 'la casa los hace en todas sus variedades; el del día se pregunta al reservar',
			},
		],
	},
	{
		title: 'Para empezar',
		items: [
			{
				name: 'Pulpo a la gallega',
				note: 'sobre patata, con pimentón y aceite de oliva',
			},
			{
				name: 'Boquerones con adobo y fritos',
				note: 'el entrante que citan las reseñas, con un hilo de módena',
			},
			{
				name: 'Ensalada caprese',
				note: 'tomate, mozzarella, albahaca y aceitunas negras',
			},
			{
				name: 'Salmorejo',
				note: '«nos pedimos salmorejo y boquerones», cuenta una reseña',
			},
		],
	},
	{
		title: 'De la piedra y la plancha',
		items: [
			{
				name: 'Carnes a la piedra',
				note: 'la especialidad que, según su ficha, les ha dado fama',
			},
			{
				name: 'Pescado de temporada a la plancha',
				note: 'con patatas panadera, según el pescado del día',
			},
		],
	},
	{
		title: 'Postres',
		items: [
			{
				name: 'Sorbet con nata',
				note: 'con frutos secos y un hilo de caramelo',
			},
		],
	},
];

const galeria = [
	{
		src: marisco,
		alt: 'Paella de marisco con gambas, mejillones y calamar en L\'Arrosseria de Nelo',
	},
	{
		src: secreto,
		alt: 'Arroz de secreto y setas en su paella en L\'Arrosseria de Nelo, Castellón',
	},
	{
		src: pulpo,
		alt: 'Raciones de pulpo a la gallega sobre patata en L\'Arrosseria de Nelo',
	},
	{
		src: pollo,
		alt: 'Paella de pollo y judía verde de L\'Arrosseria de Nelo',
	},
	{
		src: pescado,
		alt: 'Pescado a la plancha con patatas panadera en L\'Arrosseria de Nelo',
	},
	{
		src: postre,
		alt: 'Sorbet con nata y frutos secos de L\'Arrosseria de Nelo',
	},
];

const faqs = [
	{
		q: '¿Dónde está L\'Arrosseria de Nelo?',
		a: 'En el número 34 de la calle Campoamor, en Castellón de la Plana (12001), con el toldo negro y el rótulo naranja de «arrocería Nelo\'s tapería». La ficha de Google marca aparcamiento adaptado para sillas de ruedas. El botón «Cómo llegar» abre la ruta exacta en Google Maps.',
	},
	{
		q: '¿Qué horario tiene?',
		a: 'Solo abre a mediodía. De jueves a sábado, de 12:30 a 16:30; el domingo, de 12:00 a 16:30. Cierra lunes, martes y miércoles, y no hay servicio de cena ningún día de la semana. En fiestas y en verano los horarios cambian: conviene llamar antes al 964 72 36 77.',
	},
	{
		q: '¿Qué arroces hacen?',
		a: 'La casa lo cuenta en su propia ficha: arroces en todas sus variedades, en paella, melosos, caldosos o al estilo tradicional. Entre sus fotos están la paella de marisco con gambas, mejillones y calamar, la paella de pollo y verduras y el arroz de secreto y setas que destaca una reseña. El arroz del día se confirma al reservar.',
	},
	{
		q: '¿Se puede comer carne?',
		a: 'Sí. Además de los arroces y del pescado de temporada, la ficha presenta las carnes a la piedra como la especialidad que les ha dado fama. En la selección de la carta están también los entrantes de siempre: pulpo a la gallega, boquerones con adobo, salmorejo o ensalada caprese.',
	},
	{
		q: '¿Tienen menú del día y cuánto cuesta?',
		a: 'La ficha de Google no publica la carta ni los precios, y esta web no inventa importes: la selección de platos sale de sus fotos y de lo que citan sus reseñas, sin precio. El menú del día, las raciones y el precio por comensal se consultan al reservar, en el 964 72 36 77.',
	},
	{
		q: '¿Cómo se reserva?',
		a: 'Por teléfono, en el 964 72 36 77, que es el número que el propio restaurante indica en su ficha para reservas. No hay reserva online ni formulario en esta web. Como el comedor es pequeño y solo sirven a mediodía, los fines de semana conviene llamar con unos días.',
	},
	{
		q: '¿Se puede ir a cenar?',
		a: 'No. Tanto la ficha como esta web indican un único servicio, el de mediodía: la cocina abre a las 12:00 o 12:30 y cierra a las 16:30. Para cenar arroces en la zona hay que buscar otro local; aquí el arroz se come con luz de día.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'La ficha marca acceso, aseo, asientos y aparcamiento adaptados para sillas de ruedas. El comedor está a pie de calle, y si necesitas ayuda para entrar o una mesa concreta, avisa al reservar por teléfono y se prepara.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ["Nelo's", 'Arrocería Nelo', "Nelo's Castellón", 'Arrosseria de Nelo'],
	slogan: 'Arroces de la terreta en Castellón',
	description,
	url: `${business.site}/`,
	telephone: '+34 964 72 36 77',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Arroces', 'Paella', 'Cocina española', 'Mediterránea', 'Pescado de temporada'],
	areaServed: [
		{ '@type': 'City', name: 'Castelló de la Plana' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: '0xd5ffe2ae452d635:0x48c91bd16d010df5' },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Thursday', 'Friday', 'Saturday'],
			opens: '12:30',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '12:00',
			closes: '16:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Los arroces', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>L'Arrosseria de Nelo · Arroces y paellas en Castellón</title>
		<meta name="theme-color" content="#235c57" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="L'Arrosseria de Nelo, Nelo's Castellón, arrocería Castellón, paella Castellón, arroz meloso, arroz caldoso, carnes a la piedra, calle Campoamor 34, Plana Alta, cocina española"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="L'Arrosseria de Nelo · Arroces y paellas en Castellón"
			ogDescription="Paellas, arroces melosos y caldosos, pescado de temporada y carnes a la piedra en la calle Campoamor. 4,4 en Google con 892 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Paella de marisco de L'Arrosseria de Nelo en Castellón"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#235c57"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Castelló de la Plana, Castelló"
			contact={{
				street: business.street,
				locality: business.city,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[fachada]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="N"
			name={business.brand}
			subtitle="Arrocería · Tapería · Castellón"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer de Campoamor, 34 · Castelló"
				title="Arroces de la terreta,<br /><em>como en casa.</em>"
				lede="L'Arrosseria de Nelo es arrocería y tapería en la calle Campoamor: paellas, arroces melosos y caldosos, recetas marineras con pescado de temporada y carnes a la piedra, en un comedor pequeño que solo abre a mediodía y que huele a azafrán desde las doce."
				image={fachada}
				imageAlt="Fachada de arrocería y tapería Nelo's en la calle Campoamor, 34, Castellón"
				primaryCta={{ label: 'Reservar 964 72 36 77', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4 en Google</b> con 892 reseñas' },
					{ label: 'Solo mediodías', html: '<b>12:30 – 16:30</b>' },
					{ label: 'Domingo', html: '<b>Desde las 12:00</b>' },
					{ label: 'Lunes a miércoles', html: '<b>Cerrado</b>' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece L'Arrosseria de Nelo" items={servicios} />

			<LocalAbout
				label="Arrocería de barrio"
				title="El arroz<br />de la terreta,<br /><em>sin ceremonias.</em>"
				paragraphs={[
					'En el número 34 de la calle Campoamor, detrás del toldo negro y del rótulo naranja de «arrocería Nelo\'s tapería», hay una arrocería de barrio con el comedor a pie de calle, las mesas verde azulado y la paella saliendo en su bandeja de acero. Nada que no esté puesto al servicio del arroz.',
					'La casa define su cocina en su propia ficha: arroces en todas sus variedades —paella, melosos, caldosos o al estilo tradicional—, recetas marineras con pescado de temporada y carnes a la piedra, que son la especialidad que les ha dado fama. La paella de marisco, el arroz de secreto y setas y la paella de pollo y verduras son los tres arroces que aparecen en sus fotos.',
					'Solo abren a mediodía: de jueves a sábado de 12:30 a 16:30 y el domingo desde las 12:00, con lunes, martes y miércoles de descanso. La ficha suma 892 opiniones con un 4,4, y las reseñas repiten dos ideas: raciones generosas y sabor casero.',
				]}
				note="«Arroz de secreto y setas increíble, ración generosa y un sabor muy rico», dice una reseña. Otra: «comida casera, arroces de la terreta a cual mejor, sabrosos y raciones generosas»."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Paella, meloso<br /><em>o caldoso.</em>"
				description="La ficha de Google no publica la carta con precios, así que esta selección sale de lo que aparece en sus fotos y de lo que citan sus reseñas: los arroces de la casa, los entrantes de siempre y las carnes a la piedra."
				cta={{ label: 'Preguntar el arroz del día', href: phoneHref }}
				groups={grupos}
				note="Sin precios: la ficha no los publica y esta web no los inventa. El arroz del día, las raciones y el importe por comensal se consultan al reservar, en el 964 72 36 77."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La paella,<br />el arroz<br /><em>y la mesa.</em>"
				description="Estas fotografías proceden del perfil de L'Arrosseria de Nelo en Google Maps: la paella de marisco, el arroz de secreto y setas, las raciones de pulpo a la gallega recién montadas, la paella de pollo y verduras, el pescado a la plancha y el postre."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer de Campoamor, 34 · 12001 Castelló"
				title="Nos vemos<br /><em>a la hora de comer.</em>"
				addressLines={[business.street, `${business.postalCode} ${business.city}`, 'Castelló, España']}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: 'Cerrado', closed: true },
					{ day: 'Miércoles', value: 'Cerrado', closed: true },
					{ day: 'Jueves', value: '12:30 – 16:30' },
					{ day: 'Viernes', value: '12:30 – 16:30' },
					{ day: 'Sábado', value: '12:30 – 16:30' },
					{ day: 'Domingo', value: '12:00 – 16:30' },
				]}
				hoursNote="Horario publicado en la ficha de Google: solo servicio de mediodía, de jueves a domingo, y cerrado de lunes a miércoles. No hay cenas. En fiestas y en agosto suele cambiar, así que conviene llamar antes."
				mapTitle="Mapa de L'Arrosseria de Nelo en la calle Campoamor, 34, Castellón"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Nelo's · Castellón"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Las reservas se hacen por teléfono, en el 964 72 36 77, el número que el restaurante indica en su ficha: no hay reserva online ni formulario en esta web. La ficha marca acceso, aseo, asientos y aparcamiento adaptados."
			/>

			<LocalFaq items={faqs} title="Antes de <em>la mesa.</em>" />
		</main>

		<LocalFooter
			mark="N"
			name="L'Arrosseria de Nelo"
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Nelo's"
		/>
	</body>
</html>
