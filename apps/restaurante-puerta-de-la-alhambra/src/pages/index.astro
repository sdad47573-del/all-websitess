---
import { Image } from 'astro:assets';
// Las fotografias de src/assets/fotos/ las trae scripts/fetch-maps-photos.mjs de
// la ficha publica del restaurante en Google Maps. Los nombres dicen la proporcion
// porque todavia no se han revisado una a una: ver el "Pendiente de revision visual"
// del README antes de publicar.
import foto01 from '../assets/fotos/restaurante-puerta-de-la-alhambra-apaisada-01.jpg';
import foto02 from '../assets/fotos/restaurante-puerta-de-la-alhambra-vertical-02.jpg';
import foto03 from '../assets/fotos/restaurante-puerta-de-la-alhambra-vertical-03.jpg';
import foto04 from '../assets/fotos/restaurante-puerta-de-la-alhambra-apaisada-04.jpg';
import foto05 from '../assets/fotos/restaurante-puerta-de-la-alhambra-vertical-05.jpg';
import foto06 from '../assets/fotos/restaurante-puerta-de-la-alhambra-apaisada-06.jpg';
import foto07 from '../assets/fotos/restaurante-puerta-de-la-alhambra-vertical-07.jpg';
import foto08 from '../assets/fotos/restaurante-puerta-de-la-alhambra-vertical-08.jpg';
import foto09 from '../assets/fotos/restaurante-puerta-de-la-alhambra-vertical-09.jpg';
import foto10 from '../assets/fotos/restaurante-puerta-de-la-alhambra-vertical-10.jpg';

const business = {
	name: 'Restaurante Puerta de la Alhambra',
	street: 'Calle Rauda, 2',
	city: 'Granada',
	region: 'Granada',
	postalCode: '18008',
	country: 'ES',
	phone: '+34 958 16 47 01',
	latitude: 37.1640279,
	longitude: -3.5720224,
	site: 'https://restaurante-puerta-de-la-alhambra-granada.vercel.app',
};
const mapsUrl = 'https://www.google.com/maps/place/Restaurante+Puerta+de+la+Alhambra/@37.1640279,-3.5720224,17z/data=!3m1!4b1!4m6!3m5!1s0xd71e350ba653683:0xeb0c03316ccebfa4!8m2!3d37.1640279!4d-3.5720224!16s%2Fg%2F11f50l3ypl?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&hl=es&output=embed`;
const officialUrl = 'https://restaurante-puerta-de-la-alhambra.eatbu.com/?lang=es';
const facebookUrl = 'https://www.facebook.com/100057579604258/';
const phoneHref = 'tel:+34958164701';
const siteUrl = `${business.site}/`;
const description = 'Restaurante Puerta de la Alhambra en Granada: cocina mediterránea y española, tapas y menú del día en calle Rauda, 2. Teléfono, horario publicado, mapa y fotos de Google Maps.';
const hours = [
	{ day: 'Lunes', value: '07:00–00:00' }, { day: 'Martes', value: '07:00–00:00' },
	{ day: 'Miércoles', value: '07:00–00:00' }, { day: 'Jueves', value: '07:00–00:00' },
	{ day: 'Viernes', value: '07:00–00:00' }, { day: 'Sábado', value: '07:00–00:00' },
	{ day: 'Domingo', value: '07:00–00:00' },
];
const faqs = [
	{ question: '¿Dónde está el Restaurante Puerta de la Alhambra?', answer: 'El restaurante se encuentra en Calle Rauda, 2, 18008 Granada. Abre las indicaciones de Google Maps desde esta página para consultar el trayecto.' },
	{ question: '¿Cuál es el teléfono del restaurante?', answer: 'El teléfono publicado en la web del establecimiento es el 958 16 47 01. Llama para consultar reservas y disponibilidad.' },
	{ question: '¿Qué tipo de cocina ofrece?', answer: 'La web del restaurante describe una propuesta de cocina mediterránea y española, con tapas, platos locales y opciones para brunch, almuerzo y cena.' },
	{ question: '¿Cuál es el horario de apertura?', answer: 'La web del restaurante publica horario diario de 07:00 a 00:00. Puede cambiar en festivos o por temporada, así que conviene confirmarlo por teléfono antes de ir.' },
	{ question: '¿Dónde puedo ver fotos del restaurante?', answer: 'Abre la ficha de Restaurante Puerta de la Alhambra en Google Maps para consultar las imágenes y reseñas publicadas allí.' },
];
// Orden estable para la galeria: primero las apaisadas, que rinden mejor como
// cabecera de fila, y dentro de cada grupo la mas ancha.
const galeria = [foto01, foto02, foto03, foto04, foto05, foto06, foto07, foto08, foto09, foto10].sort(
	(a, b) => b.width / b.height - a.width / a.height || b.width - a.width,
);
const altDe = (indice: number) =>
	`Fotografía ${indice + 1} de ${galeria.length} del Restaurante Puerta de la Alhambra en Granada`;
const restaurantSchema = {
	'@context': 'https://schema.org', '@type': 'Restaurant', '@id': `${siteUrl}#restaurant`,
	name: business.name, description, url: siteUrl, telephone: business.phone,
	servesCuisine: ['Mediterránea', 'Española'],
	address: { '@type': 'PostalAddress', streetAddress: business.street, addressLocality: business.city, addressRegion: business.region, postalCode: business.postalCode, addressCountry: business.country },
	geo: { '@type': 'GeoCoordinates', latitude: business.latitude, longitude: business.longitude },
	hasMap: mapsUrl, sameAs: [mapsUrl, officialUrl, facebookUrl],
	openingHoursSpecification: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'].map((dayOfWeek) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek, opens: '07:00', closes: '23:59' })),
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) };
---
<!doctype html>
<html lang="es">
<head>
	<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="description" content={description} /><meta name="robots" content="index, follow, max-image-preview:large" /><meta name="theme-color" content="#34433c" />
	<link rel="canonical" href={siteUrl} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />
	<title>Restaurante Puerta de la Alhambra | Cocina en Granada</title>
	<meta property="og:type" content="restaurant.restaurant" /><meta property="og:locale" content="es_ES" /><meta property="og:site_name" content={business.name} />
	<meta property="og:title" content="Puerta de la Alhambra · Cocina española y mediterránea" /><meta property="og:description" content={description} /><meta property="og:url" content={siteUrl} />
	<meta property="og:image" content={`${business.site}/og.svg`} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Restaurante Puerta de la Alhambra en Granada" /><meta name="twitter:card" content="summary_large_image" />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} /><script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} /><link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.region" content="ES-GR" />
		<meta name="geo.placename" content="Granada" />
		<meta name="geo.position" content="37.1640279;-3.5720224" />
		<meta name="ICBM" content="37.1640279, -3.5720224" />
	</head>
<body>
	<a class="skip" href="#contenido">Saltar al contenido</a>
	<header class="topbar"><a class="brand" href="#inicio"><span class="mark">P</span><span>Puerta de la Alhambra<small>Restaurante · Granada</small></span></a><nav aria-label="Navegación principal"><a href="#restaurante">El restaurante</a><a href="#cocina">La cocina</a><a href="#fotos">Fotos</a><a href="#visita">Cómo llegar</a></nav><a class="call-top" href={phoneHref}>Llamar · 958 16 47 01</a></header>
	<main id="contenido">
		<section class="hero" id="inicio"><div class="hero-copy"><p class="eyebrow">Granada <i></i> Cocina española y mediterránea</p><h1>Una mesa para<br /><em>saborear Granada.</em></h1><p class="lede">En Restaurante Puerta de la Alhambra te esperan sabores mediterráneos y españoles en un ambiente acogedor. Disfruta de tapas, platos locales y una pausa en tu día en la calle Rauda.</p><div class="actions"><a class="button gold" href={phoneHref}>Llamar para consultar ↗</a><a class="button outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a></div><div class="details"><span>⌖ Calle Rauda, 2 · Granada</span><span>✦ Mediterránea · española · tapas</span></div></div><figure class="hero-art"><Image class="hero-photo" src={foto01} alt="Fachada de Restaurante Puerta de la Alhambra y su terraza en Granada" widths={[480, 720, 960, 1280]} sizes="(max-width:700px) 100vw, 46vw" loading="eager" fetchpriority="high" /><span class="hero-photo-shade" aria-hidden="true"></span><figcaption class="label">Granada<br /><b>en buena compañía</b></figcaption><span class="spark" aria-hidden="true">✦</span></figure></section>
		<div class="ticker"><span>Cocina mediterránea</span><b>✳</b><span>Tapas y platos locales</span><b>✳</b><span>Brunch · almuerzo · cena</span><b>✳</b><span>Granada</span></div>
		<section class="intro section" id="restaurante"><div><p class="eyebrow dark">Un restaurante para cada momento</p><h2>Tradición local,<br /><em>mesa acogedora.</em></h2></div><div class="intro-copy"><p>La web del restaurante presenta una propuesta de cocina española y mediterránea, con tapas, platos regionales y opciones para brunch, almuerzo y cena.</p><p>¿Planeas una visita o un evento privado? Contacta directamente con el restaurante para consultar disponibilidad, menú y detalles.</p><a class="text-link" href={officialUrl} target="_blank" rel="noopener noreferrer">Visitar la web del restaurante ↗</a></div></section>
		<section class="food section" id="cocina"><div class="heading"><p class="eyebrow dark">Sabores para disfrutar</p><h2>De las tapas<br /><em>a la sobremesa.</em></h2><p>Una propuesta mediterránea con opciones para distintos momentos del día.</p></div><div class="cards"><article><span>✦</span><small>PARA COMPARTIR</small><h3>Tapas y platos locales</h3><p>Sabores regionales y opciones para disfrutar en compañía.</p></article><article class="olive"><span>☕</span><small>EMPIEZA EL DÍA</small><h3>Brunch y desayuno</h3><p>Una pausa tranquila con bebidas y propuestas de la casa.</p></article><article class="clay"><span>♨</span><small>AL MEDIODÍA O NOCHE</small><h3>Almuerzo y cena</h3><p>Cocina española y mediterránea para una comida completa.</p></article></div><p class="note">La carta y disponibilidad pueden cambiar. Consulta ingredientes, alérgenos y precios directamente con el restaurante.</p></section>
		<section class="gallery section" id="fotos"><div class="gallery-head"><p class="eyebrow dark">El restaurante</p><h2>El local<br /><em>por dentro.</em></h2><p>Las fotografías que el propio restaurante publica en su ficha de Google Maps.</p></div><ul class="gallery-grid">{galeria.map((foto, indice) => (<li><Image src={foto} alt={altDe(indice)} widths={[420, 840, 1280]} sizes="(max-width:700px) 92vw, (max-width:1100px) 46vw, 30vw" loading="lazy" /></li>))}</ul><p class="note">Imágenes de la ficha pública del restaurante en Google Maps; los derechos de las fotografías siguen perteneciendo a sus autores. Si el titular pide retirarlas, se sustituyen.</p></section>
		<section class="photo-section" id="mapa"><div class="photo-copy"><p class="eyebrow">Puerta de la Alhambra en Google Maps</p><h2>Prepara tu<br /><em>visita.</em></h2><p>La ficha del restaurante en Google Maps tiene el horario actualizado, las reseñas de sus visitantes y las indicaciones de cómo llegar.</p><a class="button gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver ficha en Google Maps ↗</a><p class="photo-note">El horario publicado en la web puede cambiar: confirma por teléfono antes de ir.</p></div><div class="map"><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Google del Restaurante Puerta de la Alhambra en Granada" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
			<noscript>
				<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
			</noscript>
		</div><a class="map-card" href={mapsUrl} target="_blank" rel="noopener noreferrer"><b>Restaurante Puerta de la Alhambra</b><small>Rauda, 2 · Ver ficha y fotos ↗</small></a></div></section>
		<section class="visit section" id="visita"><div class="visit-copy"><p class="eyebrow dark">Planifica tu visita</p><h2>Te esperamos<br /><em>en Granada.</em></h2><p>La web del restaurante publica apertura todos los días de 07:00 a 00:00. Confirma el horario y la disponibilidad por teléfono, especialmente en festivos o cambios de temporada.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button dark-button" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Llamar · 958 16 47 01</a></div></div><div class="info-card"><p class="eyebrow dark">Ubicación, contacto y horario</p><h3>Información para tu visita</h3><dl><div><dt>Dirección</dt><dd>Calle Rauda, 2<br />18008 Granada</dd></div><div><dt>Teléfono</dt><dd><a href={phoneHref}>958 16 47 01</a></dd></div>{hours.map(({ day, value }) => <div><dt>{day}</dt><dd>{value}</dd></div>)}</dl><p class="note">Horario publicado en la web del restaurante; puede cambiar. Llama para confirmar antes de ir.</p><a class="text-link" href={officialUrl} target="_blank" rel="noopener noreferrer">Consultar sitio oficial ↗</a></div></section>
		<section class="faq section" id="preguntas"><p class="eyebrow dark">Preguntas frecuentes</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
	</main>
	<footer class="footer"><div class="footer-top"><a class="brand" href="#inicio"><span class="mark">P</span><span>Puerta de la Alhambra<small>Restaurante · Granada</small></span></a><p>Cocina mediterránea<br />y española en Granada.</p><nav aria-label="Enlaces del restaurante"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={officialUrl} target="_blank" rel="noopener noreferrer">Web ↗</a><a href={phoneHref}>958 16 47 01</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Restaurante Puerta de la Alhambra · Granada</span><a href="/aviso-legal/">Aviso legal y privacidad</a><span>Confirma disponibilidad y horario directamente con el restaurante.</span></div>
		<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
	</footer><a class="mobile-call" href={phoneHref}>Llamar <span>958 16 47 01</span></a>
</body>
</html>
<style is:global>
:root{font-family:'DM Sans',sans-serif;color:#343b37;background:#f7f3e9;font-synthesis:none;text-rendering:optimizeLegibility;--green:#34433c;--gold:#d8b579;--cream:#f7f3e9;--brown:#42342a;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid var(--gold);outline-offset:4px}.skip{position:absolute;top:-60px;left:16px;padding:12px;background:var(--gold)}.skip:focus{top:10px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:18px;background:var(--green);color:#fcf8ef}.brand{display:flex;align-items:center;gap:11px;font-weight:700}.brand small{display:block;margin-top:4px;color:#dce2d9;font-size:9px;font-weight:500;letter-spacing:1.2px;text-transform:uppercase}.mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--gold);border-radius:50%;color:#ecd19a;font:700 23px var(--display)}.topbar nav,.footer nav{display:flex;gap:clamp(10px,2vw,22px);font-size:11px}.topbar nav a:hover,.footer a:hover{color:#ecd19a}.call-top{padding:10px 14px;border:1px solid #ffffff55;border-radius:99px;font-size:10px;font-weight:700}.hero{display:grid;grid-template-columns:1.06fr .94fr;min-height:540px;background:var(--green);color:#fcf8ef;overflow:hidden}.hero-copy{align-self:center;padding:60px 4vw 55px 9vw}.eyebrow{margin:0 0 18px;color:#e6ce98;font-size:10px;font-weight:700;letter-spacing:1.7px;text-transform:uppercase}.eyebrow i{display:inline-block;width:20px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.heading h2,.photo-copy h2,.visit h2,.faq h2{margin:0;font:600 clamp(38px,4.8vw,62px)/1.08 var(--display);letter-spacing:-1px}.hero h1 em,.intro h2 em,.heading h2 em,.photo-copy h2 em,.visit h2 em,.faq h2 em{color:var(--gold);font-style:italic}.lede{max-width:470px;margin:22px 0 0;color:#e2e8df;font-size