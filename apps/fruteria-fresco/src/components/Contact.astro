---
import { BUSINESS } from '../data/site';
---

<section id="ubicacion" class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">Visítanos</span
			><h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">
				Frutería Fresco en Teatinos, Málaga
			</h2><div class="fresco-divider mx-auto mt-5 h-px w-32"></div><p
				class="text-base-content/70 mt-6"
			>
				Te esperamos en Calle Juan de Robles, 61. Consulta el horario orientativo y llama antes de
				venir si tienes dudas.
			</p>
		</div>
		<div class="mt-12 grid gap-8 lg:grid-cols-2">
			<div class="space-y-6">
				<div id="horario" class="rounded-box border-base-300 bg-base-200 scroll-mt-24 border p-7">
					<h3 class="font-display text-xl font-semibold">Horario publicado</h3><ul
						class="divide-base-300 mt-4 divide-y text-sm"
					>
						{
							BUSINESS.hours.map((hours) => (
								<li class="flex items-baseline justify-between gap-4 py-3">
									<>
										<span class="font-semibold">{hours.days}</span>
										<span class="text-base-content/70 text-right">
											{hours.morning}
											{hours.evening && <span class="block">{hours.evening}</span>}
										</span>
									</>
								</li>
							))
						}
					</ul><p class="text-base-content/55 mt-3 text-xs leading-relaxed">
						Referencia de Cylex/Yably, actualizada en julio de 2026. Páginas Amarillas publica un
						horario diferente; confirma por teléfono.
					</p>
				</div>
				<div class="rounded-box border-base-300 bg-base-200 border p-7">
					<h3 class="font-display text-xl font-semibold">Dirección y contacto</h3><ul
						class="mt-5 space-y-5 text-sm"
					>
						<li class="flex items-start gap-4">
							<span
								class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl"
								><i class="ri-map-pin-line text-xl"></i></span
							><div>
								<p class="font-semibold">Dirección</p><p class="text-base-content/70">
									{BUSINESS.street}<br />{BUSINESS.postalCode}
									{BUSINESS.district}, {BUSINESS.city}
								</p>
							</div>
						</li><li class="flex items-start gap-4">
							<span
								class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl"
								><i class="ri-phone-line text-xl"></i></span
							><div>
								<p class="font-semibold">Teléfono</p><a
									href={BUSINESS.phoneHref}
									class="text-base-content/70 hover:text-primary">{BUSINESS.phoneDisplay}</a
								>
							</div>
						</li>
					</ul><div class="mt-6 flex flex-wrap gap-3">
						<a href={BUSINESS.phoneHref} class="btn btn-primary gap-2 rounded-full"
							><i class="ri-phone-line"></i>Llamar</a
						><a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline gap-2 rounded-full"
							><i class="ri-map-pin-line"></i>Google Maps</a
						>
					</div>
				</div>
				<div class="rounded-box border-base-300 bg-base-200 border p-6">
					<h3 class="font-display font-semibold">Más de Frutería Fresco</h3><div
						class="mt-4 flex flex-wrap gap-3"
					>
						<a
							href={BUSINESS.website}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline btn-sm gap-2 rounded-full"
							><i class="ri-global-line"></i>Web oficial</a
						><a
							href={BUSINESS.instagram}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline btn-sm gap-2 rounded-full"
							><i class="ri-instagram-line"></i>Instagram</a
						><a
							href={BUSINESS.linktree}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline btn-sm gap-2 rounded-full"
							><i class="ri-whatsapp-line"></i>Pedidos</a
						>
					</div>
				</div>
			</div>
			<div class="rounded-box border-base-300 bg-base-200 min-h-[420px] overflow-hidden border">
				<div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
					<button type="button" data-cargar-mapa aria-label="Cargar mapa interactivo" style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
						<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
						<strong style="font-size:1rem;">Cargar mapa interactivo</strong>
						<small style="opacity:0.65;">Se carga solo al pulsar</small>
					</button>
<iframe
				 data-src={BUSINESS.googleMapsEmbed}
					title={`Mapa de ${BUSINESS.name}, ${BUSINESS.street}, Málaga`}
					width="100%"
					height="100%"
					style="border: 0; min-height: 420px;"
					loading="lazy"
					allowfullscreen
					referrerpolicy="no-referrer-when-downgrade"></iframe>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
// mapa-fachada: la URL del iframe vive en data-src y solo se asigna al pulsar (ahorra ~1MB de JS).
document.addEventListener('click', function (e) {
	var t = e.target && e.target.closest ? e.target.closest('[data-cargar-mapa]') : null;
	if (!t) return;
	var w = t.closest('[data-mapa-fachada]');
	if (!w || w.dataset.cargado) return;
	var f = w.querySelector('iframe');
	if (!f || !f.dataset.src || f.getAttribute('src')) return;
	w.dataset.cargado = '1';
	f.setAttribute('src', f.dataset.src);
	t.remove();
});
</script>
