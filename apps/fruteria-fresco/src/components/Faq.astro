---
import { BUSINESS, FAQ } from '../data/site';
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	inLanguage: 'es',
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};
---

<section id="faq" class="bg-base-200 py-20 sm:py-24">
	<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
		<div class="text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase"
				>Preguntas frecuentes</span
			><h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">
				Información útil para tu visita
			</h2><div class="fresco-divider mx-auto mt-5 h-px w-32"></div><p
				class="text-base-content/70 mt-6"
			>
				¿Te queda alguna duda? Llama al <a
					class="text-primary font-semibold"
					href={BUSINESS.phoneHref}>{BUSINESS.phoneDisplay}</a
				>.
			</p>
		</div>
		<div class="mt-12 space-y-3">
			{
				FAQ.map((item) => (
					<details class="collapse-arrow border-base-300 bg-base-100 collapse border">
						<>
							<summary class="collapse-title font-display text-lg font-semibold">{item.q}</summary>
							<div class="collapse-content">
								<p class="text-base-content/75 text-sm leading-relaxed">{item.a}</p>
							</div>
						</>
					</details>
				))
			}
		</div>
	</div>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
</section>
