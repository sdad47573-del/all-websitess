---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/panaderia-el-ayo-pasteleria-apaisada-01.jpg';
import bunuelos from '../assets/fotos/panaderia-el-ayo-pasteleria-apaisada-02.jpg';
import vitrina from '../assets/fotos/panaderia-el-ayo-pasteleria-apaisada-03.jpg';
import estanterias from '../assets/fotos/panaderia-el-ayo-pasteleria-apaisada-04.jpg';
import pastaGlaseada from '../assets/fotos/panaderia-el-ayo-pasteleria-vertical-05.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	REVIEW_QUOTE,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería El Ayo - Pastelería · Bailén-Miraflores, Málaga';
const description =
	'Panadería El Ayo - Pastelería, en C. Sondalezas, 2 (Bailén-Miraflores, 29010 Málaga). Pan, tartas, pasteles, bollería y empanadas. Encargos para celebraciones. Teléfono 636 76 09 70.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#el-ayo`,
	name: BUSINESS.name,
	alternateName: ['Panadería El Ayo', 'Pastelería El Ayo', 'El Ayo Málaga'],
	description:
		'Panadería y pastelería en C. Sondalezas, 2 (Bailén-Miraflores, 29010 Málaga). Pan, tartas, pasteles, bollería, empanadas y encargos para celebraciones.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place, MAPS.instagram],
	telephone: '+34636760970',
	email: BUSINESS.email,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:30',
			closes: '20:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '07:30',
			closes: '14:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada roja de la Panadería El Ayo, con los rótulos de panadería y pastelería y el escaparate lleno de pan',
	},
	{
		src: vitrina,
		alt: 'Mostrador de cristal con tartas de fruta, porciones de tarta, pasteles de chocolate y bandejas de bollería',
	},
	{
		src: estanterias,
		alt: 'Estanterías de madera con hogazas, baguettes, barras y panecillos, y barras de pan envasadas',
	},
	{
		src: bunuelos,
		alt: 'Pasteles fritos rebozados de azúcar, apilados sobre un plato de papel',
	},
	{
		src: pastaGlaseada,
		alt: 'Pastel redondo con baño glaseado de color naranja sobre una servilleta de papel',
	},
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"panaderia-el-ayo-pasteleria-apaisada-01.jpg": fachada,
	"panaderia-el-ayo-pasteleria-apaisada-03.jpg": vitrina,
	"panaderia-el-ayo-pasteleria-apaisada-04.jpg": estanterias,
	"panaderia-el-ayo-pasteleria-apaisada-02.jpg": bunuelos,
	"panaderia-el-ayo-pasteleria-vertical-05.jpg": pastaGlaseada,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#7a2e18" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=Manrope:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería El Ayo, pastelería Málaga, panadería Bailén-Miraflores, panadería Sondalezas, tartas Málaga, encargos celebraciones Málaga, empanadas Málaga, 29010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan, tartas, pasteles, bollería y empanadas en Bailén-Miraflores. Encargos para celebraciones. 4,8 sobre 5 con 45 reseñas en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada roja de la Panadería El Ayo en la calle Sondalezas, 2, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#7a2e18"
			phone="+34636760970"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Ayo"
			subtitle="Panadería · Pastelería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Instagram ↗', href: MAPS.instagram, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar a El Ayo"
			navAriaLabel="Enlaces de la Panadería El Ayo"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
