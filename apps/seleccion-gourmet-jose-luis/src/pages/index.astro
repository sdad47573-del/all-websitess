---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import { BUSINESS, FAQ, HORARIO, HORARIO_AVISO, MAPS, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Selección Gourmet José Luis · Carnicería y pollería en Retiro';
const description = BUSINESS.description;

import fachada from '../assets/fotos/seleccion-gourmet-jose-luis-apaisada-01.jpg';
import rotulo from '../assets/fotos/seleccion-gourmet-jose-luis-apaisada-10.jpg';
import carne from '../assets/fotos/seleccion-gourmet-jose-luis-cuadrada-02.jpg';
import ternera from '../assets/fotos/seleccion-gourmet-jose-luis-cuadrada-04.jpg';
import embutido from '../assets/fotos/seleccion-gourmet-jose-luis-cuadrada-05.jpg';
import pollo from '../assets/fotos/seleccion-gourmet-jose-luis-cuadrada-07.jpg';
import jamon from '../assets/fotos/seleccion-gourmet-jose-luis-cuadrada-08.jpg';
import interior from '../assets/fotos/seleccion-gourmet-jose-luis-vertical-09.jpg';

const galeria: { src: ImageMetadata; alt: string }[] = [
	{ src: fachada, alt: 'Fachada de Selección Gourmet José Luis, con su rótulo y escaparate' },
	{ src: rotulo, alt: 'Rótulo de José Luis con la leyenda de fiambres y pollos' },
	{ src: carne, alt: 'Pieza de carne de cerdo sobre pizarra con perejil' },
	{ src: ternera, alt: 'Carne de ternera sobre tabla de madera' },
	{ src: embutido, alt: 'Embutido curado cortado en lonchas sobre tabla' },
	{ src: pollo, alt: 'Alitas de pollo sobre tabla de madera' },
	{ src: jamon, alt: 'Jamón ibérico en su jamonero' },
	{ src: interior, alt: 'Mostrador de carnicería con piezas colgadas y vitrina iluminada' },
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#seleccion-gourmet-jose-luis`,
	name: BUSINESS.name,
	alternateName: ['Selección Gourmet Jose Luis', 'José Luis carnicería Retiro'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phoneHref.replace('tel:', ''),
	currenciesAccepted: 'EUR',
	servesCuisine: ['Carnicería', 'Pollería', 'Productos gourmet'],
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Comunidad de Madrid' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.locality,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: { '@type': 'GeoCoordinates', latitude: BUSINESS.geo.lat, longitude: BUSINESS.geo.lng },
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId }],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '14:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '17:30',
			closes: '20:30',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday'], opens: '09:00', closes: '14:00' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La tienda', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#123c36" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400..700;1,400..700&family=Mulish:ital,wght@0,400..700;1,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Selección Gourmet José Luis, carnicería Retiro, pollería Retiro, productos gourmet Madrid"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Carnicería, pollería y productos gourmet en C. de Abtao, 22 (Retiro, Madrid)."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tarjeta de Selección Gourmet José Luis con su nombre sobre fondo verde esmeralda"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#123c36"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Retiro"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Selección Gourmet José Luis"
			subtitle="Carnicería y pollería · Retiro"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. de Abtao, 22 · Retiro, Madrid"
				title="Productos gourmet <br /><em>en Retiro.</em>"
				lede={`Selección Gourmet José Luis es carnicería, pollería y productos gourmet en Retiro. Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>Lun–vie</b> 9:00–14:00 y 17:30–20:30 · <b>Dom</b> cerrado' },
					{ label: 'Servicio', html: '<b>A domicilio o en tienda</b>' },
				]}
				image={fachada}
				imageAlt="Fachada de Selección Gourmet José Luis en la calle de Abtao, en Retiro"
				galleryHref={MAPS.place}
				photoCredit="Ficha de Google Maps"
				galleryLinkLabel="Ver en Google Maps"
				tag="Carnicería y pollería"
			/>

			<LocalChips label="Lo que ofrece Selección Gourmet José Luis" items={SERVICIOS} />

			<LocalAbout
				label="La tienda"
				title="Carnicería y <br /><em>productos gourmet.</em>"
				paragraphs={[
					'Selección Gourmet José Luis está en la C. de Abtao, 22, en Retiro. Su ficha de Google Maps la clasifica como carnicería y pollería, con comida a domicilio.',
					'La ficha indica que se pueden pedir productos gourmet a domicilio o comprarlos en tienda.',
				]}
				note="La ficha no publica página web, redes sociales, carta con precios ni datos de accesibilidad. Para precios concretos y pedidos, llama al 915 01 13 30."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El local <br /><em>y sus productos.</em>"
				description="Fachada, rótulo, piezas de carne, embutidos, pollo y el mostrador de la tienda."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna imagen y quieres retirarla, dilo y la eliminamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Retiro, <br /><em>C. de Abtao.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, BUSINESS.region]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.horas === 'Cerrado' }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: lunes a viernes de 9:00 a 14:00 y de 17:30 a 20:30; sábado de 9:00 a 14:00; domingo cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Selección Gourmet José Luis en la C. de Abtao, 22, Retiro, Madrid"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. de Abtao, 22"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="La ficha no publica página web ni pedidos online: se concreta todo por teléfono, en el 915 01 13 30. No da datos de accesibilidad, así que conviene llamar antes si necesitas algo concreto."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>ir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Selección Gourmet José Luis"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma horario antes de la visita."
			ctaLabel="Llamar a Selección Gourmet José Luis"
			navAriaLabel="Enlaces de Selección Gourmet José Luis"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
