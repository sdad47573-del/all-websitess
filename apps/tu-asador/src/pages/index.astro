---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/tu-asador-apaisada-07.jpg';
import mesa from '../assets/fotos/tu-asador-apaisada-03.jpg';
import mostrador from '../assets/fotos/tu-asador-apaisada-01.jpg';
import polloPatatas from '../assets/fotos/tu-asador-apaisada-02.jpg';
import carneSalsa from '../assets/fotos/tu-asador-apaisada-05.jpg';
import bandejaCarne from '../assets/fotos/tu-asador-apaisada-10.jpg';
import postre from '../assets/fotos/tu-asador-vertical-09.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const title = 'Tu Asador · Pollo asado y comida para llevar en Sevilla';
const description = BUSINESS.description;

const galeria = [
	{
		src: mesa,
		alt: 'Mesa con un pollo asado entero sobre tabla de madera, tortilla de patatas, ensalada, croquetas, patatas fritas y ensaladilla de marisco',
	},
	{
		src: mostrador,
		alt: 'Mostrador de Tu Asador con el horno asador al fondo, tortillas y empanadas sobre el cristal y tarrinas de comida preparada',
	},
	{
		src: polloPatatas,
		alt: 'Primer plano de pollo asado con patatas amarillas y su jugo, recién sacado del horno',
	},
	{
		src: carneSalsa,
		alt: 'Lomo asado en rodajas con salsa y tiras de pimiento rojo en un plato blanco',
	},
	{
		src: bandejaCarne,
		alt: 'Carne en salsa dentro de una bandeja de aluminio, lista para llevar',
	},
	{
		src: postre,
		alt: 'Arroz con leche en tarro de cristal con canela y una rodaja de limón, sobre una mesa de madera',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#tu-asador`,
	name: BUSINESS.fullName,
	alternateName: ['Tu Asador Sevilla', 'Asador de pollos Pueblo Saharaui', 'Tu Asador pollos y carnes'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Asador', 'Casera', 'Comida para llevar'],
	areaServed: [
		{ '@type': 'City', name: 'Sevilla' },
		{ '@type': 'AdministrativeArea', name: 'Av. Pueblo Saharaui' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	acceptsReservations: false,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:00',
			closes: '15:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#161210" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:wght@500;600;700&family=Manrope:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Tu Asador Sevilla, pollo asado Sevilla, asador de pollos Pueblo Saharaui, comida para llevar Sevilla, pollo con patatas, tortilla casera Sevilla, carnes asadas Sevilla"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollos, carnes y otras delicias en la avenida Pueblo Saharaui, frente al Aldi. Pollo asado, tortilla, croquetas y postres caseros para llevar. 4,7 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Tu Asador en la avenida Pueblo Saharaui, con el rótulo de pollos y carnes"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#161210"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Av. Pueblo Saharaui, Sevilla"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Tu Asador"
			subtitle="Pollos y carnes · Sevilla"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Pollos, carnes <br /><em>y otras delicias.</em>"
				lede="En la avenida Pueblo Saharaui, frente al Aldi, un asador de pollos y comida para llevar: pollo asado con patatas, tortillas, croquetas, carnes en salsa y postres caseros. Abre de miércoles a domingo de 9:00 a 15:00 y la ficha de Google le da 4,7 sobre 5 con 128 reseñas."
				image={fachada}
				imageAlt="Fachada de Tu Asador en la avenida Pueblo Saharaui, con el rótulo de pollos, carnes y otras delicias sobre el escaparate"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,7</b> en Google · 128 reseñas' },
					{ label: 'Horario', html: '<b>9:00–15:00</b><br />Miércoles a domingo' },
					{ label: 'Teléfono', html: `<b>955 09 86 84</b> encargos y consultas` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Tu Asador" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="El horno <br /><em>y el mostrador.</em>"
				paragraphs={[
					'Tu Asador está en la avenida Pueblo Saharaui, frente al Aldi, con el rótulo de «Pollos / carnes y otras delicias» sobre un escaparate grande y el obrador al fondo. La ficha de Google lo clasifica como restaurante especializado en pollo y restaurante de comida para llevar.',
					'La casa trabaja el pollo asado: sale del horno para llevarlo entero, con patatas o por raciones. En el mostrador hay además tortilla de patatas, croquetas, ensaladilla, empanadas y carnes en salsa, y entre los postres aparece el arroz con leche en tarro de cristal, con canela y una rodaja de limón.',
					'Las reseñas de Google lo resumen bien: «buena materia prima, buen trato y precios económicos». Otra va directa a la tortilla: «la mejor tortilla casera que he probado en mi vida». No todas son perfectas —hay quien se queja del tamaño del pollo—, pero el balance de la ficha es 4,7 sobre 5 con 128 reseñas.',
					'Abre de miércoles a domingo de 9:00 a 15:00: es un asador de mediodía, pensado para recoger la comida y comer en casa. Cierra lunes y martes, y la ficha avisa de que en festivos el horario puede cambiar.',
				]}
				note="La información sale de la ficha pública de Google Maps y de las fotos del perfil del establecimiento. No hay web oficial ni carta con precios publicada: confirma platos, precios y disponibilidad por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver la casa en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Pollo asado <br /><em>y mostrador.</em>"
				description="La ficha no publica carta con precios. Esta lista recoge lo que aparece en las fotos del perfil y lo que repiten las reseñas de la casa: pollo asado, carnes, tortilla, croquetas y postres."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="No hay carta oficial publicada ni precios del local, así que esta lista es orientativa: sirve para reconocer lo que se cocina aquí, no para cerrar una cuenta. Para saber qué hay ese día y cuánto cuesta, llama al asador."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El horno <br /><em>y el mostrador.</em>"
				description="Las fotografías del perfil de Tu Asador: la mesa con el pollo y la tortilla, el obrador con el horno, el pollo con patatas, las carnes en salsa y el arroz con leche."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a <br /><em>Pueblo Saharaui.</em>"
				addressLines={[
					'Av. Pueblo Saharaui, frente al Aldi',
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Sevilla, España',
				]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: miércoles a domingo de 9:00 a 15:00, con lunes y martes cerrados. En festivos puede cambiar; la ficha avisa, por ejemplo, del día de Todos los Santos."
				mapTitle="Mapa de Tu Asador en la avenida Pueblo Saharaui, frente al Aldi, Sevilla"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Pueblo Saharaui · Sevilla"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. Para encargar pollos, una bandeja o preguntar qué hay hoy, llama al teléfono del local: es el canal directo."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Tu Asador"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
