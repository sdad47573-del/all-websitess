---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import asador from '../assets/fotos/sabor-kebab-halal-apaisada-10.jpg';
import vitrina from '../assets/fotos/sabor-kebab-halal-apaisada-01.jpg';
import hamburguesa from '../assets/fotos/sabor-kebab-halal-apaisada-05.jpg';
import burgerQueso from '../assets/fotos/sabor-kebab-halal-vertical-09.jpg';
import patatas from '../assets/fotos/sabor-kebab-halal-vertical-02.jpg';
import plato from '../assets/fotos/sabor-kebab-halal-vertical-03.jpg';
import durum from '../assets/fotos/sabor-kebab-halal-vertical-04.jpg';
import interior from '../assets/fotos/sabor-kebab-halal-vertical-06.jpg';
import kebabPan from '../assets/fotos/sabor-kebab-halal-vertical-08.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	MENU_NOTE,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Sabor Kebab Halal · Kebab y comida rápida en Andorra la Vella';
const description = BUSINESS.description;

const galeria = [
	{
		src: vitrina,
		alt: 'Vitrina de Sabor Kebab con bandejas de pollo, falafel, patatas, arroz y verduras, y bebidas debajo',
	},
	{
		src: hamburguesa,
		alt: 'Hamburguesa de pollo crujiente de Sabor Kebab con pan de sésamo, lechuga, cebolla roja y tomate',
	},
	{
		src: kebabPan,
		alt: 'Kebab en pan abierto con carne de pollo, tomate, cebolla morada, lechuga y salsa blanca',
	},
	{
		src: durum,
		alt: 'Durum a la plancha de Sabor Kebab cortado, con un cuenco de salsa blanca al lado',
	},
	{
		src: plato,
		alt: 'Plato de kebab con pollo, alitas, nuggets, patatas y ensalada de col, zanahoria y tomate',
	},
	{
		src: patatas,
		alt: 'Ración de patatas fritas de Sabor Kebab servida sobre el papel del local',
	},
	{
		src: burgerQueso,
		alt: 'Hamburguesa de Sabor Kebab con queso fundido y lechuga en pan de sésamo',
	},
	{
		src: interior,
		alt: 'Interior de Sabor Kebab con la barra naranja, el asador y mesas con sillas rojas',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#sabor-kebab`,
	name: BUSINESS.name,
	alternateName: ['Sabor Kebab', 'Sabor Kebab Andorra', 'Sabor Kebab Halal Andorra la Vella'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Kebab', 'Turca', 'Comida rápida', 'Halal'],
	hasMenu: {
		'@type': 'Menu',
		name: 'Carta de Sabor Kebab Halal',
		inLanguage: 'es-ES',
		hasMenuSection: MENU.map((group) => ({
			'@type': 'MenuSection',
			name: group.title,
			hasMenuItem: group.items.map((item) => ({
				'@type': 'MenuItem',
				name: item.name,
				description: item.note,
			})),
		})),
	},
	hasDeliveryMethod: 'http://purl.org/goodrelations/v1#DeliveryModeOwnFleet',
	areaServed: [
		{ '@type': 'City', name: 'Andorra la Vella' },
		{ '@type': 'City', name: 'Escaldes-Engordany' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.parish,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google Maps feature ID', value: BUSINESS.featureId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '11:30',
			closes: '23:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Para llevar', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Servicio a domicilio', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Qué se pide', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"sabor-kebab-halal-apaisada-10.jpg": asador,
	"sabor-kebab-halal-apaisada-01.jpg": vitrina,
	"sabor-kebab-halal-apaisada-05.jpg": hamburguesa,
	"sabor-kebab-halal-vertical-08.jpg": kebabPan,
	"sabor-kebab-halal-vertical-04.jpg": durum,
	"sabor-kebab-halal-vertical-03.jpg": plato,
	"sabor-kebab-halal-vertical-02.jpg": patatas,
	"sabor-kebab-halal-vertical-09.jpg": burgerQueso,
	"sabor-kebab-halal-vertical-06.jpg": interior,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#14211c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Karla:wght@400;500;600;700&family=Sora:wght@600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Sabor Kebab Halal, kebab Andorra la Vella, kebab halal Andorra, durum Andorra, hamburguesas Andorra la Vella, pizza Andorra, kebab a domicilio Andorra, Mossèn Cinto Verdaguer, comida rápida Andorra"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Kebab, durum, hamburguesas y pizzas en la calle Mossèn Cinto Verdaguer 5, en el centro de Andorra la Vella. Todos los días de 11:30 a 23:30, con reparto a domicilio. 3,7 sobre 5 con 140 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Asador vertical de Sabor Kebab con los pinchos de carne y la vitrina de verduras"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#14211c"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.parish}
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Andorra la Vella"
			countryName="Andorra"
			preload={[asador]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Sabor Kebab"
			subtitle="Halal · Andorra la Vella"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Sabor Kebab"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
