---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES } from '../data/site';
---

<section id="inicio" class="hero-astyle relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.fotoFachada}
			alt="Bar Restaurante Los Jardines en Cáceres"
			widths={[600, 1000]}
			sizes="100vw"
			quality={78}
			loading="eager"
			fetchpriority="high"
			class="h-full w-full object-cover opacity-45"
		/>
		<div class="from-neutral/90 via-neutral/40 absolute inset-0 bg-gradient-to-r"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-32">
		<div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
			<div>
				<p class="text-accent inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase">
					<span><i class="ri-map-pin-line"></i> {BUSINESS.city}</span>
					<span class="text-white/60">Restaurante</span>
				</p>
				<h1 class="font-display mt-4 text-5xl leading-[1.05] font-bold sm:text-6xl lg:text-7xl">
					Bar Restaurante Los Jardines<br />
					<span class="text-accent">en Cáceres</span>
				</h1>
				<p class="mt-3 text-xl font-semibold text-white/85 sm:text-2xl">{BUSINESS.tagline}</p>
				<p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80">
					Restaurante en <strong class="text-white">Cáceres</strong>. La ubicación exacta, el teléfono y el horario están en su ficha pública de Google Maps.
				</p>

				<div class="mt-8 flex flex-wrap gap-3">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-accent btn-lg gap-2 rounded-full"
					>
						<i class="ri-google-fill"></i>
						Ver ficha de Google
					</a>
				</div>

				<dl class="mt-10 grid max-w-lg grid-cols-3 gap-x-6 gap-y-5">
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Ciudad</dt>
						<dd class="mt-1 text-xl font-bold">Cáceres</dd>
					</div>
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Ficha</dt>
						<dd class="mt-1 text-xl font-bold">Google</dd>
					</div>
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Horario</dt>
						<dd class="mt-1 text-xl font-bold">A confirmar</dd>
					</div>
				</dl>
			</div>

			<figure class="relative hidden lg:block">
				<div class="rotate-2 overflow-hidden rounded-sm shadow-2xl ring-1 ring-white/15">
					<Image
						src={IMAGES.fotoCejas}
						alt="Bar Restaurante Los Jardines, Cáceres"
						widths={[500, 900]}
						sizes="(min-width: 1024px) 36vw, 90vw"
						quality={86}
						loading="eager"
						class="aspect-[4/5] w-full object-cover"
					/>
				</div>
				<figcaption class="text-accent bg-neutral absolute -bottom-5 -left-4 rounded-sm px-5 py-3 text-lg font-bold shadow-xl">
					Cáceres
				</figcaption>
			</figure>
		</div>
	</div>
</section>
