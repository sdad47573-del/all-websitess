---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/a-retoral-tapas-y-brasas-apaisada-01.jpg';
import carneBrasa from '../assets/fotos/a-retoral-tapas-y-brasas-vertical-02.jpg';
import pulpo from '../assets/fotos/a-retoral-tapas-y-brasas-apaisada-03.jpg';
import fachada from '../assets/fotos/a-retoral-tapas-y-brasas-panoramica-04.jpg';
import arroz from '../assets/fotos/a-retoral-tapas-y-brasas-apaisada-05.jpg';
import setas from '../assets/fotos/a-retoral-tapas-y-brasas-vertical-06.jpg';
import entrecot from '../assets/fotos/a-retoral-tapas-y-brasas-apaisada-07.jpg';
import chuleton from '../assets/fotos/a-retoral-tapas-y-brasas-vertical-08.jpg';
import rodaballo from '../assets/fotos/a-retoral-tapas-y-brasas-vertical-09.jpg';
import salsa from '../assets/fotos/a-retoral-tapas-y-brasas-vista-10-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Restaurante A Retoral Tapas y Brasas, en Lugar O Cruceiro 64 (36954 Moaña, Pontevedra). Tapas, raciones y carne a la brasa en O Morrazo. Comedor acristalado. Tel. 986 31 56 23.';

const galeria = [
	{
		src: comedor,
		alt: 'Comedor acristalado de A Retoral de noche, con mesas de madera, sillas negras y guirnaldas de luces en el techo',
	},
	{
		src: pulpo,
		alt: 'Ración de pulpo á feira con pimentón sobre tabla de madera, junto a un cuenco de chipirones fritos con limón',
	},
	{
		src: fachada,
		alt: 'Fachada de A Retoral de noche, con el rótulo A Retoral Taberna Vinos e Tapas, el toldo Mahou y gente en la puerta',
	},
	{
		src: arroz,
		alt: 'Arroz con carabineros, almejas, guisantes y tomate en una cazuela',
	},
	{
		src: setas,
		alt: 'Carne con salsa de setas, patatas fritas y un pimiento rojo asado en un plato blanco',
	},
	{
		src: carneBrasa,
		alt: 'Carne a la brasa cortada en tiras con patatas y sal gruesa en un plato de barro',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la brasa con patatas fritas en un plato de borde verde',
	},
	{
		src: chuleton,
		alt: 'Chuletón a la brasa sobre un plato negro, con un cuenco de sal al lado',
	},
	{
		src: rodaballo,
		alt: 'Rodaballo a la brasa entero con limón, tomate y guisantes en un plato decorado',
	},
	{
		src: salsa,
		alt: 'Carne en salsa con patatas fritas en un plato blanco',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#a-retoral`,
	name: BUSINESS.name,
	alternateName: ['A Retoral', 'A Retoral Tapas y Brasas', 'A Retoral Taberna', 'A Retoral Moaña'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 986 31 56 23',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Gallega', 'Brasa', 'Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Moaña' },
		{ '@type': 'AdministrativeArea', name: 'O Morrazo' },
		{ '@type': 'AdministrativeArea', name: 'Pontevedra' },
		{ '@type': 'AdministrativeArea', name: 'Galicia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '20:00',
			closes: '23:59',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'A Retoral · Tapas y brasas en Moaña';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#9c3f1d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="A Retoral, A Retoral Moaña, tapas Moaña, brasas Moaña, restaurante O Morrazo, comer en Moaña, pulpo á feira Moaña, arroz con carabineros Moaña, A Retoral Taberna"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="A Retoral · Tapas y brasas en Moaña"
			ogDescription="Tapas, raciones y carne a la brasa en A Retoral (Lugar O Cruceiro 64, Moaña). Comedor acristalado y cocina casera. Tel. 986 31 56 23."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Comedor acristalado de A Retoral en Moaña con mesas de madera y luces"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#9c3f1d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-GA"
			postalCode={BUSINESS.postalCode}
			phone="+34986315623"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="A RETORAL"
			subtitle="Tapas y brasas · Moaña"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Lugar O Cruceiro, 64 · Moaña"
				title="Tapas y brasas<br /><em>en Moaña.</em>"
				lede={`A Retoral es un restaurante gallego y brasería de Lugar O Cruceiro, 64, en Moaña (Pontevedra), con el rótulo de taberna sobre la puerta. Tapas, raciones y carne a la brasa en un comedor acristalado, con mesas de madera y luces de guirnalda. Abre de martes a domingo de 12:00 a 16:00, y los viernes y sábados también por la noche. Teléfono: ${BUSINESS.phoneDisplay}.`}
				image={comedor}
				imageAlt="Comedor acristalado de A Retoral de noche, con mesas de madera, sillas negras y guirnaldas de luces en el techo"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount.toLocaleString('es-ES')} reseñas)` },
					{ label: 'Cocina', html: 'Tapas, raciones y brasa' },
					{ label: 'Horario', html: 'Mar–dom · 12:00–16:00 · noches de viernes y sábado' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece A Retoral" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una taberna<br /><em>con brasa.</em>"
				paragraphs={[
					'A Retoral está en Lugar O Cruceiro, 64, en Moaña (Pontevedra), con el rótulo de «A Retoral Taberna · Vinos e Tapas» sobre la puerta. Google lo clasifica como restaurante gallego y brasería, y abre de martes a domingo: de 12:00 a 16:00, y los viernes y sábados también de 20:00 a 24:00. El lunes cierra.',
					'El comedor es acristalado: mesas de madera, sillas negras y guirnaldas de luces colgando del techo. Al fondo se ven las mesas del exterior a través del cristal. En la fachada, el toldo de la taberna cubre la entrada en la que se junta la gente las noches de fin de semana.',
					'Sus reseñas hablan de una cocina casera y generosa: «la carne muy rico y las raciones generosas». Otra recomienda «especialmente la ensalada de marisco y las croquetas», y una tercera enumera «zamburiñas, pulpo, calamares (chopitos fritos), pimientos de padrón…».',
					'En las fotos del perfil aparecen el pulpo á feira con pimentón, los chopitos fritos, el arroz con carabineros y almejas, el rodaballo a la brasa y varias carnes con patatas. Google le da 4,6 sobre 5 con 1.220 reseñas.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount.toLocaleString('es-ES')} opiniones en Google. Una de ellas: «${REVIEWS[2]}»`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Para picar<br /><em>y de la brasa.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que citan sus reseñas y lo que aparece en las fotos del perfil."
				cta={{ label: `Preguntar la carta: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados. Llama al 986 31 56 23 para saber qué hay hoy en la pizarra y si queda mesa."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor,<br /><em>la brasa y la mesa.</em>"
				description="Estas fotografías proceden del perfil de A Retoral en Google Maps: el comedor acristalado, la fachada de la taberna, el pulpo á feira con los chopitos, el arroz con carabineros, el rodaballo y las carnes a la brasa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en O Cruceiro.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: de martes a domingo de 12:00 a 16:00; viernes y sábados también de 20:00 a 24:00; lunes cerrado. Para grupos conviene llamar antes."
				mapTitle="Mapa de Restaurante A Retoral en Lugar O Cruceiro, 64, Moaña (Pontevedra)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="A Retoral · Moaña"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 986 31 56 23. La ficha de Google marca acceso para sillas de ruedas, aparcamiento adaptado, aseo adaptado y asientos adaptados."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a A Retoral"
		/>
	</body>
</html>
