---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import peixe from '../assets/fotos/tasca-do-beco-vertical-01.jpg';
import prato from '../assets/fotos/tasca-do-beco-apaisada-02.jpg';
import fachada from '../assets/fotos/tasca-do-beco-apaisada-04.jpg';
import noite from '../assets/fotos/tasca-do-beco-vertical-03.jpg';
import ardosia from '../assets/fotos/tasca-do-beco-vertical-05.jpg';

import {
	BUFFET,
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICOS,
} from '../data/site';

const title = 'A Tasca do Béco · peixe na brasa em Arroios, Lisboa';
const description =
	'Tasca de bairro na Calçada de Sant\'Ana, 139, em Lisboa: peixe grelhado na brasa, prato do dia e opções veganas a preços de tasca. 4,7 no Google com 15 críticas.';

const galeria = [
	{
		src: prato,
		alt: 'Prato de dourada grelhada com batatas e brócolos numa mesa de toalha de papel, com cerveja e cesto de pão',
	},
	{
		src: fachada,
		alt: 'Porta verde da tasca na Calçada de Sant\'Ana, com o número 139 pintado por cima da entrada',
	},
	{
		src: noite,
		alt: 'Jarro de água, copo de vinho e cesto de pão sobre a mesa, com a calçada iluminada ao fundo',
	},
	{
		src: ardosia,
		alt: 'Ardósia manuscrita na porta com o prato do dia, os grelhados, os bitoques e a secção vegan com preços',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#tasca-do-beco`,
	name: BUSINESS.name,
	alternateName: ['A Tasca do Beco', 'Tasca do Béco Lisboa', 'Traditional restaurant'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	priceRange: '10–20 €',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cozinha portuguesa', 'Peixe grelhado', 'Tasca de bairro'],
	acceptsReservations: 'False',
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Distrito de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
		author: { '@type': 'Person', name: review.author.split(',')[0] },
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A tasca', href: '#tasca' },
	{ label: 'A casa', href: '#casa' },
	{ label: 'A ardósia', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"tasca-do-beco-vertical-01.jpg": peixe,
	"tasca-do-beco-apaisada-02.jpg": prato,
	"tasca-do-beco-apaisada-04.jpg": fachada,
	"tasca-do-beco-vertical-03.jpg": noite,
	"tasca-do-beco-vertical-05.jpg": ardosia,
};
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f4034" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Caveat:wght@600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="A Tasca do Béco, A Tasca do Beco, Traditional restaurant Lisboa, tasca Arroios, peixe grelhado Lisboa, Calçada de Sant'Ana, comer barato Lisboa, tasca de bairro"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Peixe na brasa, prato do dia e opções veganas na Calçada de Sant'Ana, 139 · Arroios, Lisboa."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Prato de dourada grelhada com batatas e brócolos numa mesa da tasca"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1f4034"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lisboa"
			locale="pt_PT"
			countryName="Portugal"
			preload={[peixe]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="A Tasca do Béco"
			subtitle="Peixe na brasa · Arroios"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			cta={{ label: 'Como chegar', href: MAPS.directions, external: true }}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
				reviews={REVIEWS}
				googleMaps={MAPS.place}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Como chegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Informação elaborada a partir de fontes públicas; confirma horário, carta e preços antes da visita."
			ctaLabel="Como chegar à tasca"
			navAriaLabel="Ligações de A Tasca do Béco"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
