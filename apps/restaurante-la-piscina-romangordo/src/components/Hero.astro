---
import { Image } from 'astro:assets';
import { BUSINESS, IMAGES } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
---

<section id="inicio" class="hero-piscina relative overflow-hidden">
	<div class="relative mx-auto max-w-4xl px-4 pt-14 text-center sm:px-6 sm:pt-20 lg:px-8">
		<p
			class="text-primary/70 inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase"
		>
			<span><i class="ri-map-pin-line"></i> Romangordo</span>
			<span class="text-base-content/35">Monfragüe · Cáceres</span>
		</p>

		<h1 class="font-display mt-4 text-6xl leading-[0.9] font-semibold text-primary sm:text-7xl lg:text-8xl">
			La <span class="text-secondary italic">Piscina</span>
		</h1>

		<p class="text-base-content/70 mx-auto mt-6 max-w-xl text-base leading-relaxed sm:text-lg">
			Cocina extremeña junto a la piscina municipal: producto local, recetas de siempre y un toque
			contemporáneo, en el corazón de la reserva de la biosfera de Monfragüe.
		</p>

		<div class="mt-7 flex flex-wrap items-center justify-center gap-3">
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="badge badge-lg border-primary/15 bg-primary/5 text-primary gap-2 px-4 py-3 text-sm font-semibold"
			>
				<span class="text-secondary tracking-tight" aria-hidden="true">
					{estrellas.map((n) => (
						<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
					))}
				</span>
				{BUSINESS.rating.toString().replace('.', ',')} · {BUSINESS.reviewCount} reseñas en Google
			</a>
		</div>

		<div class="mt-8 flex flex-wrap justify-center gap-3">
			<a href={BUSINESS.phoneHref} class="btn btn-secondary btn-lg gap-2 rounded-full">
				<i class="ri-phone-line text-xl"></i>
				{BUSINESS.phone}
			</a>
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-outline btn-lg gap-2 rounded-full"
			>
				<i class="ri-google-fill"></i>
				Ver ficha de Google
			</a>
		</div>
	</div>

	<div class="relative mx-auto max-w-6xl px-4 pt-12 pb-24 sm:px-6 sm:pt-16 lg:px-8">
		<div class="grid grid-cols-3 items-start gap-2 sm:gap-4">
			<figure class="mt-6 overflow-hidden rounded-2xl shadow-xl">
				<Image
					src={IMAGES.fotoVertical3}
					alt="Interior de La Piscina en Romangordo"
					widths={[220, 420, 620]}
					sizes="(min-width: 640px) 30vw, 31vw"
					quality={85}
					loading="eager"
					class="foto-calida aspect-[3/4] w-full object-cover"
				/>
			</figure>
			<figure class="overflow-hidden rounded-2xl shadow-2xl">
				<Image
					src={IMAGES.fotoVertical1}
					alt="Restaurante La Piscina, en Romangordo"
					widths={[240, 460, 680]}
					sizes="(min-width: 640px) 32vw, 33vw"
					quality={85}
					loading="eager"
					fetchpriority="high"
					class="foto-calida aspect-[3/4] w-full object-cover"
				/>
			</figure>
			<figure class="mt-10 overflow-hidden rounded-2xl shadow-xl">
				<Image
					src={IMAGES.fotoVertical6}
					alt="Un plato de La Piscina"
					widths={[220, 420, 620]}
					sizes="(min-width: 640px) 30vw, 31vw"
					quality={85}
					loading="lazy"
					class="foto-calida aspect-[3/4] w-full object-cover"
				/>
			</figure>
		</div>

		<dl
			class="border-base-300 bg-base-100 relative z-10 mx-auto -mt-14 grid max-w-3xl divide-y divide-base-200 rounded-2xl border shadow-2xl sm:-mt-16 sm:grid-cols-3 sm:divide-x sm:divide-y-0"
		>
			<div class="px-5 py-5 text-center">
				<dt class="text-base-content/50 text-[0.65rem] tracking-[0.18em] uppercase">Horario</dt>
				<dd class="mt-1 text-sm font-bold">12:00 – 20:00</dd>
				<dd class="text-base-content/55 text-xs">Viernes a domingo, hasta 23:00</dd>
			</div>
			<div class="px-5 py-5 text-center">
				<dt class="text-base-content/50 text-[0.65rem] tracking-[0.18em] uppercase">Dónde</dt>
				<dd class="mt-1 text-sm font-bold">Junto a la piscina</dd>
				<dd class="text-base-content/55 text-xs">
					{BUSINESS.city} · {BUSINESS.region}
				</dd>
			</div>
			<div class="px-5 py-5 text-center">
				<dt class="text-base-content/50 text-[0.65rem] tracking-[0.18em] uppercase">Teléfono</dt>
				<dd class="mt-1 text-sm font-bold">
					<a href={BUSINESS.phoneHref} class="hover:text-secondary">{BUSINESS.phone}</a>
				</dd>
				<dd class="text-base-content/55 text-xs">Reservas y pedidos</dd>
			</div>
		</dl>
	</div>

	<div class="cenefa-piscina relative h-3 w-full"></div>
</section>
