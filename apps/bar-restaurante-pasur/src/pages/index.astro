---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import almuerzo from '../assets/fotos/bar-restaurante-pasur-vertical-05.jpg';
import comedor from '../assets/fotos/bar-restaurante-pasur-apaisada-01.jpg';
import bocadillo from '../assets/fotos/bar-restaurante-pasur-apaisada-04.jpg';
import ensalada from '../assets/fotos/bar-restaurante-pasur-apaisada-07.jpg';
import fachada from '../assets/fotos/bar-restaurante-pasur-apaisada-08.jpg';
import barra from '../assets/fotos/bar-restaurante-pasur-apaisada-10.jpg';
import vitrina from '../assets/fotos/bar-restaurante-pasur-panoramica-06.jpg';
import pescado from '../assets/fotos/bar-restaurante-pasur-vertical-02.jpg';
import mesas from '../assets/fotos/bar-restaurante-pasur-vertical-03.jpg';
import carajillo from '../assets/fotos/bar-restaurante-pasur-vertical-09.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description = BUSINESS.description;

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de Pasur con mesas de madera y paredes azul petróleo, listo para el servicio',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo de carne en pan de barra servido en el plato de Bar Restaurante Pasur',
	},
	{
		src: vitrina,
		alt: 'Vitrina de Pasur con platos preparados, guisos y ensaladas listos para servir',
	},
	{
		src: barra,
		alt: 'Barra de Pasur con clientes, botellas y televisión al fondo del comedor',
	},
	{
		src: pescado,
		alt: 'Pescado a la plancha con perejil y patatas fritas en el plato de Pasur',
	},
	{
		src: fachada,
		alt: 'Fachada de nave industrial de Bar Restaurante Pasur con el rótulo sobre la puerta',
	},
	{
		src: ensalada,
		alt: 'Ensalada de lechuga, tomate, aceitunas y cebolla morada en Pasur',
	},
	{
		src: mesas,
		alt: 'Mesas de madera del comedor de Pasur junto a la pared azul y los ventanales',
	},
	{
		src: carajillo,
		alt: 'Carajillo en vaso de caña sobre el plato, al final del almuerzo en Pasur',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': ['BarOrPub', 'Restaurant'],
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.fullName,
	alternateName: ['Pasur', 'Bar Pasur', 'Bar Restaurante Pasur Castellón'],
	slogan: BUSINESS.tagline,
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34622791161',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Cocina casera', 'Cocina española', 'Mediterránea', 'Bocadillos'],
	areaServed: [
		{ '@type': 'City', name: 'Castelló de la Plana' },
		{ '@type': 'Place', name: 'Polígono Industrial Autopista Sur' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.province,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '05:40',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '05:30',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados para sillas de ruedas', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El sitio', href: '#sitio' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Pasur · Bar restaurante de polígono en Castelló';
const cita = REVIEWS[0];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#22323d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Pasur, bar polígono Castellón, restaurante Autopista Sur, almuerzos Castellón, bocadillos polígono, menú del día Castellón, Calle Peri 15, bar restaurante Pasur"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Pasur · Bar restaurante de polígono en Castelló"
			ogDescription="Almuerzos, bocadillos, menú del día y cocina casera desde las 5:40, de lunes a viernes. 4,4 en Google con 671 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bocadillo de carne en pan de barra de Bar Restaurante Pasur, en Castelló"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#22323d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.province}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone="+34622791161"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Polígono Autopista Sur, Castelló"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'España',
				phone: '+34 622 79 11 61',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[almuerzo]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Bar restaurante · Polígono Sur"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Pol. Ind. Autopista Sur · Calle Peri, 15 · Nave 19"
				title="A las 5:40<br />ya hay café<br /><em>y bocadillos.</em>"
				lede="Pasur es el bar restaurante del Polígono Autopista Sur, en Castelló: abre antes de que empiece el turno, sirve almuerzos con la vitrina llena y pone menú del día a mediodía. De lunes a viernes, de madrugada a las cuatro."
				image={almuerzo}
				imageAlt="Almuerzo de Pasur con huevos fritos, morcilla, albóndigas, tortilla y pan"
				primaryCta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Abre 5:40"
				facts={[
					{ label: 'Nota', html: '<b>4,4 en Google</b> con 671 reseñas' },
					{ label: 'Apertura', html: '<b>5:40</b> · viernes 5:30' },
					{ label: 'Cierre', html: '<b>16:00</b>' },
					{ label: 'Días', html: '<b>Lunes a viernes</b>' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Qué ofrece Pasur" items={SERVICIOS} />

			<LocalAbout
				label="El bar del turno de mañana"
				title="Aquí se desayuna,<br />se almuerza<br /><em>y se vuelve al tajo.</em>"
				paragraphs={[
					'Pasur está en la calle Peri, 15, nave 19, dentro del Polígono Industrial Autopista Sur de Castelló de la Plana. Es un bar restaurante de nave: fachada de bloque, rótulo sobre la puerta, comedor amplio de mesas de madera y una barra donde se pide de pie el primer café. Abre a las 5:40, cuando aún no ha salido el sol, y cierra a las cuatro.',
					'La mañana se organiza en tres tiempos. Primero el café y el bocadillo de madrugada; después el almuerzo, con la vitrina de platos preparados y raciones para compartir; y a mediodía el menú del día, con cocina casera y pescado a la plancha. Las reseñas lo resumen mejor: «buen sitio para almorzar, mucha variedad y las camareras muy simpáticas».',
					'El comedor tiene sitio de sobra y el servicio va rápido, que es lo que se pide en un polígono: «buen trato, atienden bien y rápido» y «gran variedad de bocadillos, servicio rápido y muy buen trato». Se aparca en la misma calle Peri y en las naves del entorno. Sábados y domingos cierra.',
				]}
				note="«Buen sitio para almorzar, mucha variedad y las camareras muy simpáticas», dice una reseña. Otra: «gran variedad de bocadillos, servicio rápido y muy buen trato»."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="De la vitrina<br /><em>a la mesa.</em>"
				description="La ficha de Google no publica carta ni precios, así que esta selección sale de sus fotos y de sus reseñas: el café de las 5:40, la vitrina de platos preparados, los bocadillos, el almuerzo con huevos y morcilla, el menú del día y el pescado a la plancha."
				cta={{ label: 'Preguntar el menú de hoy', href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Sin precios: la ficha no los publica y esta web no los inventa. El menú del día y las raciones se consultan en la barra o por teléfono en el 622 79 11 61."
			/>

			<section class="cita" aria-label="Opinión destacada en Google">
				<div class="wrap">
					<blockquote>
						<p>“{cita.text}”</p>
						<footer>Reseña en Google · {cita.rating} estrellas</footer>
					</blockquote>
					<div class="cita-nota">
						<b>4,4</b>
						671 reseñas en Google
						<a href={MAPS.reviews} target="_blank" rel="noreferrer">Leerlas todas ↗</a>
					</div>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La nave,<br />la barra<br /><em>y el comedor.</em>"
				description="Estas fotografías proceden del perfil de Bar Restaurante Pasur en Google Maps: la fachada de nave en el polígono, el comedor de mesas de madera, la barra, la vitrina de platos preparados, el bocadillo de carne, el almuerzo, el pescado con patatas, la ensalada y el carajillo."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Calle Peri, 15 · Nave 19 · 12006 Castelló"
				title="Nos vemos<br /><em>en el polígono.</em>"
				addressLines={['Pol. Ind. Autopista Sur', BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Castelló · Plana Alta']}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="Horario publicado en la ficha de Google: de lunes a jueves de 5:40 a 16:00 y los viernes de 5:30 a 16:00. Sábado y domingo cerrado. En puentes y festivos puede cambiar: llama antes."
				mapTitle="Mapa de Bar Restaurante Pasur en la calle Peri, 15, nave 19, Castelló"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Pasur · Polígono Sur"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="Se reserva por teléfono, llamando al 622 79 11 61: no hay reserva online ni formulario en esta web. Para grupos de trabajo conviene llamar con antelación y confirmarlo con el local."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Pasur"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
