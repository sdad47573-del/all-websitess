---
import { BUSINESS, REVIEWS } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
---

<section id="opiniones" class="bg-base-200 border-base-300 border-y py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-10 lg:grid-cols-[0.74fr_1.26fr] lg:gap-16">
			<div>
				<p class="mono text-secondary text-[0.65rem] font-semibold tracking-[0.18em] uppercase">
					— Opiniones
				</p>
				<h2
					class="font-display mt-4 text-4xl leading-[0.96] font-black tracking-[-0.03em] uppercase sm:text-5xl"
				>
					Lo que dicen<br />
					<span class="text-primary">en el turno</span>
				</h2>
				<p class="text-base-content/60 mt-5 max-w-sm text-sm leading-relaxed">
					Tres reseñas de la ficha de Google: rapidez, variedad y trato de bar de siempre.
				</p>

				<div class="border-base-content/15 bg-base-100 mt-7 border-2 p-6">
					<div class="flex items-end gap-4">
						<span class="font-display text-6xl leading-none font-black tracking-tight">
							{BUSINESS.rating.toString().replace('.', ',')}
						</span>
						<div class="pb-1">
							<div class="text-secondary text-base tracking-tight" aria-hidden="true">
								{estrellas.map((n) => (
									<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
								))}
							</div>
							<p class="mono text-base-content/55 mt-1 text-[0.62rem]">
								{BUSINESS.reviewCount} reseñas en Google Maps
							</p>
						</div>
					</div>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline btn-sm border-base-content/20 hover:border-primary hover:bg-primary hover:text-primary-content mt-5 h-10 w-full gap-2 text-[0.68rem] font-bold uppercase"
					>
						<i class="ri-google-fill" aria-hidden="true"></i> Leer todas las reseñas
					</a>
					<p class="mono text-base-content/40 mt-3 text-center text-[0.55rem] tracking-[0.06em] uppercase">
						Valoración de Google · octubre de 2026
					</p>
				</div>
			</div>

			<div class="grid gap-3 sm:grid-cols-2">
				{REVIEWS.map((resena, index) => (
					<blockquote
						class={`border-base-content/15 bg-base-100 relative flex flex-col border-2 p-6 ${
							index === 0 ? 'sm:col-span-2 sm:p-8' : ''
						}`}
					>
						<span
							class="font-display text-base-300 pointer-events-none absolute top-1 right-5 text-7xl leading-none font-black select-none"
							aria-hidden="true"
						>
							”
						</span>
						<div
							class="text-secondary relative flex gap-1 text-[0.65rem] tracking-tight"
							role="img"
							aria-label={`${resena.rating} de 5 estrellas`}
						>
							{Array.from({ length: resena.rating }).map(() => (
								<i class="ri-star-fill" />
							))}
						</div>
						<p
							class={`font-display relative mt-3 flex-1 leading-tight font-bold ${
								index === 0 ? 'text-2xl sm:text-3xl' : 'text-xl'
							}`}
						>
							«{resena.text}»
						</p>
						<footer class="border-base-300 mt-5 flex items-center gap-3 border-t pt-3">
							<span class="bg-primary text-primary-content flex size-7 items-center justify-center text-[0.62rem] font-black">
								G
							</span>
							<span class="mono text-base-content/60 text-[0.58rem] font-semibold tracking-[0.08em] uppercase">
								Reseña en Google
							</span>
							<span class="mono text-base-content/35 ml-auto text-[0.55rem]">Google</span>
						</footer>
					</blockquote>
				))}
			</div>
		</div>
	</div>
</section>
