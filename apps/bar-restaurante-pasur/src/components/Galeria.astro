---
import { Image } from 'astro:assets';
import { BUSINESS, GALLERY } from '../data/site';

const spans = [
	'lg:col-span-7',
	'lg:col-span-5',
	'lg:col-span-4',
	'lg:col-span-8',
	'lg:col-span-4',
	'lg:col-span-4',
	'lg:col-span-4',
	'lg:col-span-7',
	'lg:col-span-5',
];
---

<section id="galeria" class="bg-base-100 relative overflow-hidden py-20 sm:py-24">
	<div class="blueprint pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="mono text-secondary text-[0.65rem] font-semibold tracking-[0.18em] uppercase">
					— Galería
				</p>
				<h2
					class="font-display mt-4 text-4xl leading-[0.96] font-black tracking-[-0.03em] uppercase sm:text-5xl"
				>
					El comedor,<br />
					<span class="text-primary">la barra y el plato</span>
				</h2>
			</div>
			<p class="text-base-content/60 max-w-xs text-sm leading-relaxed">
				Fotos de la ficha pública de Google Maps: la nave, el comedor, la vitrina y lo que sale
				de la cocina.
			</p>
		</div>

		<div class="mt-10 grid grid-cols-2 gap-2 sm:gap-3 lg:grid-cols-12">
			{GALLERY.map((foto, index) => (
				<figure class={`group relative h-60 overflow-hidden border border-base-content/15 bg-base-300 sm:h-64 lg:h-96 ${spans[index]}`}>
					<Image
						src={foto.src}
						alt={foto.alt}
						widths={[360, 560, 820, 1200]}
						sizes="(min-width: 1024px) 50vw, (min-width: 640px) 50vw, 100vw"
						quality={80}
						loading="lazy"
						class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
					/>
					<div
						class="from-neutral/75 pointer-events-none absolute inset-0 bg-gradient-to-t via-transparent to-transparent opacity-80"
						aria-hidden="true"
					></div>
					<figcaption
						class="mono absolute right-3 bottom-3 left-3 flex items-end justify-between gap-3 text-[0.62rem] font-semibold tracking-[0.08em] text-white uppercase"
					>
						<span>{foto.caption}</span>
						<span class="text-white/45">{String(index + 1).padStart(2, '0')}</span>
					</figcaption>
				</figure>
			))}
		</div>

		<p class="mono text-base-content/40 mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.6rem] uppercase">
			<i class="ri-google-fill" aria-hidden="true"></i>
			Imágenes de la ficha de {BUSINESS.name}. Si eres el titular y quieres retirarlas, avísanos.
		</p>
	</div>
</section>
