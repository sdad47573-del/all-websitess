---
import { BUSINESS } from '../data/site';
---

<section id="visitanos" class="bg-base-100 relative overflow-hidden py-20 sm:py-24">
	<div class="blueprint pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
			<div>
				<p class="mono text-secondary text-[0.65rem] font-semibold tracking-[0.18em] uppercase">
					— Visítanos
				</p>
				<h2
					class="font-display mt-4 text-4xl leading-[0.96] font-black tracking-[-0.03em] uppercase sm:text-5xl"
				>
					En la calle Peri,<br />
					<span class="text-primary">nave 19</span>
				</h2>
				<p class="text-base-content/65 mt-5 max-w-md leading-relaxed">
					Dentro del Polígono Industrial Autopista Sur, junto al rótulo de «Bar Restaurante
					Pasur». Se llega en coche y se aparca en la misma calle o en las naves del entorno.
				</p>

				<div class="mt-8 grid gap-3 sm:grid-cols-2">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="border-base-content/15 bg-base-100 hover:border-primary flex items-start gap-4 border-2 p-4 transition-colors"
					>
						<span class="bg-primary text-primary-content flex size-10 shrink-0 items-center justify-center">
							<i class="ri-map-pin-2-line text-lg" aria-hidden="true"></i>
						</span>
						<span>
							<span class="mono block text-[0.58rem] font-semibold tracking-[0.12em] text-base-content/45 uppercase">
								Dirección
							</span>
							<span class="mt-1 block text-sm font-bold">{BUSINESS.street}</span>
							<span class="text-base-content/60 block text-xs">{BUSINESS.landmark}</span>
							<span class="text-base-content/60 block text-xs">
								{BUSINESS.postalCode} {BUSINESS.city}
							</span>
						</span>
					</a>

					<a
						href={BUSINESS.phoneHref}
						class="border-base-content/15 bg-base-100 hover:border-primary flex items-start gap-4 border-2 p-4 transition-colors"
					>
						<span class="bg-primary text-primary-content flex size-10 shrink-0 items-center justify-center">
							<i class="ri-phone-line text-lg" aria-hidden="true"></i>
						</span>
						<span>
							<span class="mono block text-[0.58rem] font-semibold tracking-[0.12em] text-base-content/45 uppercase">
								Teléfono
							</span>
							<span class="mt-1 block text-sm font-bold">{BUSINESS.phone}</span>
							<span class="text-base-content/60 block text-xs">Menú, encargos y grupos</span>
						</span>
					</a>

					<div class="border-base-content/15 bg-base-100 flex items-start gap-4 border-2 p-4 sm:col-span-2">
						<span class="bg-primary text-primary-content flex size-10 shrink-0 items-center justify-center">
							<i class="ri-wheelchair-line text-lg" aria-hidden="true"></i>
						</span>
						<span>
							<span class="mono block text-[0.58rem] font-semibold tracking-[0.12em] text-base-content/45 uppercase">
								Accesibilidad
							</span>
							<span class="mt-1 block text-sm font-bold">
								Acceso, aseo y asientos adaptados
							</span>
							<span class="text-base-content/60 block text-xs">Según la ficha de Google</span>
						</span>
					</div>
				</div>

				<div class="border-base-content/15 bg-base-100 mt-4 border-2">
					<h3 class="border-base-content/15 flex items-center gap-2 border-b px-5 py-4">
						<i class="ri-time-line text-secondary text-lg" aria-hidden="true"></i>
						<span class="mono text-[0.62rem] font-semibold tracking-[0.14em] uppercase">
							Horario
						</span>
					</h3>
					<ul class="divide-base-200 divide-y px-5 py-1">
						{BUSINESS.hours.map((row) => (
							<li class="flex items-center justify-between gap-4 py-2.5 text-sm">
								<span class="mono text-[0.7rem] font-semibold tracking-[0.04em] uppercase">
									{row.days}
								</span>
								<span
									class={`text-right text-sm ${
										row.hours === 'Cerrado'
											? 'text-base-content/35'
											: 'font-bold text-base-content'
									}`}
								>
									{row.hours}
								</span>
							</li>
						))}
					</ul>
					<p class="text-base-content/45 px-5 pt-1 pb-4 text-xs leading-relaxed">
						{BUSINESS.hoursNote}
					</p>
				</div>

				<a
					href={BUSINESS.googleMaps}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-primary btn-block mt-4 h-12 gap-2 text-sm font-bold uppercase"
				>
					<i class="ri-route-line text-lg" aria-hidden="true"></i> Abrir ruta en Google Maps
				</a>
			</div>

			<div class="flex flex-col gap-4">
				<div class="offset-frame border-base-content/20 min-h-[26rem] flex-1 border-2 bg-base-200">
					<iframe
						title={`Mapa de ${BUSINESS.name} en ${BUSINESS.city}`}
						src={BUSINESS.googleMapsEmbed}
						width="100%"
						height="100%"
						class="min-h-[26rem] w-full"
						style="border:0"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
				</div>

				<div class="border-base-content/15 bg-base-100 grid grid-cols-2 gap-px border-2">
					<div class="p-5">
						<p class="mono text-base-content/45 text-[0.55rem] font-semibold tracking-[0.12em] uppercase">
							Solo entre semana
						</p>
						<p class="font-display mt-1.5 text-xl font-black uppercase">Lunes a viernes</p>
						<p class="text-base-content/55 mt-1 text-xs leading-relaxed">
							Sábados y domingos cerrado.
						</p>
					</div>
					<div class="border-base-content/15 border-l p-5">
						<p class="mono text-base-content/45 text-[0.55rem] font-semibold tracking-[0.12em] uppercase">
							Plus Code
						</p>
						<p class="font-display mt-1.5 text-xl font-black">{BUSINESS.plusCode}</p>
						<p class="text-base-content/55 mt-1 text-xs leading-relaxed">
							{BUSINESS.landmark}
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
