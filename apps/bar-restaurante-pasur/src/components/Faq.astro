---
import { BUSINESS, FAQ } from '../data/site';
---

<section id="faq" class="bg-base-200 border-base-300 border-t py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-10 lg:grid-cols-[0.62fr_1.38fr] lg:gap-16">
			<div class="lg:sticky lg:top-28 lg:self-start">
				<p class="mono text-secondary text-[0.65rem] font-semibold tracking-[0.18em] uppercase">
					— Preguntas frecuentes
				</p>
				<h2
					class="font-display mt-4 text-4xl leading-[0.96] font-black tracking-[-0.03em] uppercase sm:text-5xl"
				>
					Antes de<br />
					<span class="text-primary">venir</span>
				</h2>
				<p class="text-base-content/60 mt-5 max-w-xs text-sm leading-relaxed">
					Lo que más se pregunta sobre el horario, el menú y cómo llegar al polígono. Si
					falta algo, llama al bar.
				</p>
				<a
					href={BUSINESS.phoneHref}
					class="mono mt-5 inline-flex items-center gap-2 text-xs font-semibold uppercase underline decoration-2 underline-offset-4"
				>
					<i class="ri-phone-line" aria-hidden="true"></i> {BUSINESS.phone}
				</a>
			</div>

			<div class="border-base-300 border-t">
				{FAQ.map((item, index) => (
					<details class="group border-base-300 border-b" open={index === 0}>
						<summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left">
							<span class="flex items-baseline gap-4">
								<span class="mono text-base-content/30 text-[0.65rem] font-semibold">
									{String(index + 1).padStart(2, '0')}
								</span>
								<span class="text-base font-bold sm:text-lg">{item.q}</span>
							</span>
							<span
								class="border-base-content/20 text-primary flex size-8 shrink-0 items-center justify-center border transition-transform group-open:rotate-45"
							>
								<i class="ri-add-line text-lg" aria-hidden="true"></i>
							</span>
						</summary>
						<p class="text-base-content/65 max-w-2xl pb-6 pl-9 text-sm leading-relaxed">
							{item.a}
						</p>
					</details>
				))}
			</div>
		</div>
	</div>
</section>
