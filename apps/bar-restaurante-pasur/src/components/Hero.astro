---
import { Image } from 'astro:assets';
import { BUSINESS, IMAGES } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
const servicios = [
	'Almuerzos',
	'Bocadillos',
	'Menú del día',
	'Cocina casera',
	'Platos de vitrina',
	'Café',
	'Cerveza fría',
];
---

<section id="inicio" class="bg-base-100 relative overflow-hidden">
	<div class="blueprint pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>

	<div
		class="relative mx-auto grid max-w-7xl gap-12 px-4 pt-10 pb-14 sm:px-6 sm:pt-14 lg:grid-cols-[1.03fr_0.97fr] lg:items-center lg:gap-14 lg:px-8 lg:pt-16 lg:pb-20"
	>
		<div>
			<div class="flex flex-wrap items-center gap-2">
				<span class="tag bg-primary text-primary-content border-primary">
					<i class="ri-map-pin-2-line" aria-hidden="true"></i> Pol. Ind. Autopista Sur
				</span>
				<span class="tag text-base-content/60">Castellón de la Plana</span>
			</div>

			<h1
				class="font-display mt-6 text-[5.4rem] leading-[0.82] font-black tracking-[-0.055em] uppercase sm:text-[7.4rem] lg:text-[8.6rem]"
			>
				Pasur
				<span
					class="mono mt-5 block text-sm font-semibold tracking-[0.18em] text-base-content/55 uppercase sm:text-base"
				>
					Bar restaurante · Castellón
				</span>
			</h1>

			<p class="text-base-content/70 mt-6 max-w-lg text-lg leading-relaxed">
				Cocina casera, bocadillos y menú del día para quien madruga. En el polígono, con el
				café listo a las 5:40 y el comedor abierto hasta las cuatro.
			</p>

			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-6 inline-flex flex-wrap items-center gap-x-3 gap-y-1"
			>
				<span class="text-secondary text-sm tracking-tight" aria-hidden="true">
					{estrellas.map((n) => (
						<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
					))}
				</span>
				<span class="mono text-sm font-bold">
					{BUSINESS.rating.toString().replace('.', ',')}
				</span>
				<span class="text-base-content/55 mono text-xs">
					· {BUSINESS.reviewCount} reseñas en Google
				</span>
			</a>

			<div class="mt-8 flex flex-wrap gap-3">
				<a
					href={BUSINESS.phoneHref}
					class="btn btn-secondary btn-lg h-14 gap-2 px-6 text-sm font-bold uppercase"
				>
					<i class="ri-phone-line text-lg" aria-hidden="true"></i>
					{BUSINESS.phone}
				</a>
				<a
					href={BUSINESS.googleMaps}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-outline btn-lg border-base-300 hover:border-primary hover:bg-primary hover:text-primary-content h-14 gap-2 px-6 text-sm font-bold uppercase"
				>
					<i class="ri-route-line text-lg" aria-hidden="true"></i>
					Cómo llegar
				</a>
			</div>

			<dl
				class="border-base-300 mt-10 grid grid-cols-2 gap-x-6 gap-y-5 border-t pt-6 sm:grid-cols-3"
			>
				<div>
					<dt class="mono text-base-content/45 text-[0.58rem] font-semibold tracking-[0.14em] uppercase">
						Horario
					</dt>
					<dd class="mt-1.5 text-sm font-bold">L–V · desde las 5:40</dd>
					<dd class="text-base-content/55 text-xs">Hasta las 16:00</dd>
				</div>
				<div>
					<dt class="mono text-base-content/45 text-[0.58rem] font-semibold tracking-[0.14em] uppercase">
						Aquí
					</dt>
					<dd class="mt-1.5 text-sm font-bold">Menú del día</dd>
					<dd class="text-base-content/55 text-xs">Bocadillos y vitrina</dd>
				</div>
				<div class="col-span-2 sm:col-span-1">
					<dt class="mono text-base-content/45 text-[0.58rem] font-semibold tracking-[0.14em] uppercase">
						Dirección
					</dt>
					<dd class="mt-1.5 text-sm font-bold">{BUSINESS.street}</dd>
					<dd class="text-base-content/55 text-xs">
						{BUSINESS.postalCode} {BUSINESS.city}
					</dd>
				</div>
			</dl>
		</div>

		<div class="relative mx-auto w-full max-w-md lg:max-w-none">
			<figure class="relative">
				<div class="offset-frame border-base-content/20 relative border-2 bg-base-200">
					<Image
						src={IMAGES.fotoApaisada8}
						alt="Fachada de Bar Restaurante Pasur en el polígono, con el rótulo sobre la puerta"
						widths={[520, 820, 1200]}
						sizes="(min-width: 1024px) 44vw, 92vw"
						quality={82}
						loading="eager"
						fetchpriority="high"
						class="aspect-[16/11] w-full object-cover"
					/>
				</div>

				<div
					class="bg-accent text-accent-content border-base-content/20 absolute -bottom-6 -left-3 border-2 px-4 py-3 shadow-lg sm:-left-6 sm:px-5 sm:py-4"
				>
					<p class="mono text-[0.55rem] font-semibold tracking-[0.2em] uppercase">Abrimos</p>
					<p class="font-display mt-0.5 text-4xl leading-none font-black tracking-tight sm:text-5xl">
						05:40
					</p>
				</div>

				<div
					class="border-base-100 absolute -right-2 -bottom-10 w-32 rotate-2 border-4 shadow-xl sm:-right-4 sm:w-40"
				>
					<Image
						src={IMAGES.fotoApaisada4}
						alt="Bocadillo grande de carne servido en el bar, con un refresco al lado"
						widths={[260, 420]}
						sizes="(min-width: 640px) 10rem, 8rem"
						quality={82}
						loading="lazy"
						class="aspect-square w-full object-cover"
					/>
				</div>

				<div
					class="mono bg-primary text-primary-content absolute -top-4 right-3 px-3 py-2 text-[0.55rem] font-semibold tracking-[0.18em] uppercase sm:right-5"
				>
					Comida de turno
				</div>
			</figure>
		</div>
	</div>

	<div class="hazard h-2.5 w-full" aria-hidden="true"></div>

	<div class="bg-primary text-primary-content overflow-hidden py-3">
		<div class="marquee-track" aria-hidden="true">
			{[0, 1].map(() => (
				<div class="flex shrink-0 items-center">
					{servicios.map((servicio) => (
						<span class="mono flex items-center gap-6 px-6 text-[0.68rem] font-semibold tracking-[0.16em] uppercase">
							{servicio}
							<span class="text-accent">/</span>
						</span>
					))}
				</div>
			))}
		</div>
		<p class="sr-only">{servicios.join(' · ')}</p>
	</div>
</section>
