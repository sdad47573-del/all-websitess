---
import { BUSINESS, NAV, SUR_DIGITAL_URL } from '../data/site';

interface Props {
	base?: string;
}

const { base = '' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-neutral text-neutral-content relative overflow-hidden">
	<div class="hazard h-2.5 w-full" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-7xl px-4 pt-12 pb-28 sm:px-6 sm:pb-14 lg:px-8">
		<div class="flex flex-col gap-6 border-b border-white/15 pb-8 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="mono text-accent text-[0.58rem] font-semibold tracking-[0.2em] uppercase">
					{BUSINESS.landmark} · Castellón
				</p>
				<p class="font-display mt-2 text-4xl leading-none font-black tracking-[-0.04em] uppercase sm:text-5xl">
					Nos vemos en<br />
					<span class="text-accent">el turno</span>.
				</p>
			</div>
			<a
				href={BUSINESS.phoneHref}
				class="btn btn-secondary btn-sm h-11 w-fit gap-2 px-5 text-[0.72rem] font-bold uppercase"
			>
				<i class="ri-phone-line text-base" aria-hidden="true"></i>
				{BUSINESS.phone}
			</a>
		</div>

		<div class="mt-9 grid gap-9 sm:grid-cols-2 lg:grid-cols-4">
			<div class="sm:col-span-2 lg:col-span-1">
				<div class="flex items-center gap-3">
					<span class="bg-secondary text-secondary-content font-display flex size-10 items-center justify-center text-xl font-black">
						P
					</span>
					<p class="font-display text-2xl font-black uppercase">Pasur</p>
				</div>
				<p class="mt-4 max-w-xs text-sm leading-relaxed text-white/60">
					Bar restaurante de polígono en Castellón: desayunos desde las 5:40, almuerzos,
					bocadillos y menú del día de lunes a viernes.
				</p>
				<div class="mono mt-5 flex items-center gap-2 text-[0.65rem]">
					<i class="ri-star-fill text-accent" aria-hidden="true"></i>
					<span class="font-bold text-white">{BUSINESS.rating.toString().replace('.', ',')}</span>
					<span class="text-white/40">· {BUSINESS.reviewCount} reseñas en Google</span>
				</div>
			</div>

			<div>
				<h2 class="mono text-[0.58rem] font-semibold tracking-[0.18em] text-white/40 uppercase">
					La casa
				</h2>
				<ul class="mt-4 space-y-2.5 text-sm">
					{NAV.map((item) => (
						<li>
							<a href={`${base}${item.href}`} class="text-white/70 transition-colors hover:text-white">
								{item.label}
							</a>
						</li>
					))}
					<li>
						<a href={`${base}aviso-legal`} class="text-white/70 transition-colors hover:text-white">
							Aviso legal y privacidad
						</a>
					</li>
				</ul>
			</div>

			<div>
				<h2 class="mono text-[0.58rem] font-semibold tracking-[0.18em] text-white/40 uppercase">
					Horario
				</h2>
				<ul class="mono mt-4 space-y-1.5 text-[0.68rem]">
					{BUSINESS.hours.map((row) => (
						<li class="flex items-baseline justify-between gap-3">
							<span class="text-white/50">{row.days}</span>
							<span class={row.hours === 'Cerrado' ? 'text-white/30' : 'font-semibold text-white/80'}>
								{row.hours}
							</span>
						</li>
					))}
				</ul>
			</div>

			<div>
				<h2 class="mono text-[0.58rem] font-semibold tracking-[0.18em] text-white/40 uppercase">
					Contacto
				</h2>
				<ul class="mt-4 space-y-3 text-sm">
					<li class="flex gap-2">
						<i class="ri-map-pin-line text-accent mt-0.5" aria-hidden="true"></i>
						<a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="text-white/70 transition-colors hover:text-white"
						>
							{BUSINESS.street}
							<br />
							{BUSINESS.landmark}
							<br />
							{BUSINESS.postalCode} {BUSINESS.city}
						</a>
					</li>
					<li class="flex gap-2">
						<i class="ri-phone-line text-accent mt-0.5" aria-hidden="true"></i>
						<a href={BUSINESS.phoneHref} class="text-white/70 transition-colors hover:text-white">
							{BUSINESS.phone}
						</a>
					</li>
					<li class="flex gap-2">
						<i class="ri-google-fill text-accent mt-0.5" aria-hidden="true"></i>
						<a
							href={BUSINESS.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="text-white/70 transition-colors hover:text-white"
						>
							Ficha y reseñas en Google
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div
			class="mono mt-11 flex flex-col gap-3 border-t border-white/10 pt-5 text-[0.6rem] text-white/40 lg:flex-row lg:items-center lg:justify-between"
		>
			<p>© {year} {BUSINESS.name} · {BUSINESS.city}</p>
			<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
				<a href={`${base}aviso-legal`} class="transition-colors hover:text-white">Aviso legal</a>
				<a href={`${base}aviso-legal#cookies`} class="transition-colors hover:text-white">Cookies</a>
				<span class="hidden text-white/20 sm:inline">|</span>
				<p>
					Creado por Sur Digital ·
					<a
						href={SUR_DIGITAL_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-accent font-semibold text-white underline decoration-white/30 underline-offset-2 transition-colors"
					>
						sur-digital.vercel.app
					</a>
				</p>
			</div>
		</div>
	</div>
</footer>
