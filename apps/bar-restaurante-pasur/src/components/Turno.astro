---
import { TURNO } from '../data/site';
---

<section class="bg-neutral text-neutral-content border-neutral border-y" aria-label="Datos rápidos">
	<div class="mx-auto grid max-w-7xl grid-cols-2 gap-px bg-white/10 lg:grid-cols-4">
		{TURNO.map((item, index) => (
			<div class="bg-neutral relative px-5 py-7 sm:px-7 sm:py-8">
				<p class="mono text-[0.58rem] font-semibold tracking-[0.18em] text-white/40 uppercase">
					0{index + 1} / {item.label}
				</p>
				<p class="font-display mt-2 text-3xl leading-none font-black tracking-tight sm:text-4xl">
					{item.value}
				</p>
			</div>
		))}
	</div>
</section>
