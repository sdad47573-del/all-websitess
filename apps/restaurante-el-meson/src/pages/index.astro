---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
	} from '@astro-components';

import comedor from '../assets/fotos/restaurante-el-meson-vertical-01.jpg';
import flan from '../assets/fotos/restaurante-el-meson-vertical-02.jpg';
import patatas from '../assets/fotos/restaurante-el-meson-apaisada-03.jpg';
import ensalada from '../assets/fotos/restaurante-el-meson-vertical-04.jpg';
import lagarto from '../assets/fotos/restaurante-el-meson-vertical-08.jpg';
import entrecot from '../assets/fotos/restaurante-el-meson-vertical-06.jpg';
import mesa from '../assets/fotos/restaurante-el-meson-vertical-10.jpg';
import parrilla from '../assets/fotos/restaurante-el-meson-vista-7-07.jpg';
import postres from '../assets/fotos/restaurante-el-meson-apaisada-09.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	SERVICIOS,
	REVIEWS
} from '../data/site';

const description =
	'Restaurante El Mesón, parrilla y bar en la calle Camelias, 1 (Moraleja, Cáceres). Lagarto y carnes a la parrilla, ensalada de rulo, croquetas, pulpo y calamares. 4,4 en Google con 659 reseñas. Tel. 927 56 34 74.';

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de Restaurante El Mesón con mesa larga de mantel negro, sillas blancas y barra al fondo',
	},
	{
		src: mesa,
		alt: 'Rincón del comedor de El Mesón en Moraleja con vigas de madera, pared de ladrillo y mesas de madera',
	},
	{
		src: ensalada,
		alt: 'Ensalada de rulo de cabra en dados con frutos secos y vinagreta en Restaurante El Mesón',
	},
	{
		src: lagarto,
		alt: 'Lagarto a la parrilla cortado en tiras con un cuenco de salsa y patatas fritas al lado',
	},
	{
		src: parrilla,
		alt: 'Lagarto a la parrilla troceado con un cuenco de salsa en Restaurante El Mesón de Moraleja',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la parrilla con patatas panaderas y croquetas en sartén en El Mesón, Moraleja',
	},
	{
		src: postres,
		alt: 'Postres de El Mesón: tarta con helado y chocolate y flan con nata',
	},
	{
		src: flan,
		alt: 'Flan con caramelo y galleta servido en plato blanco en Restaurante El Mesón',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#el-meson`,
	name: BUSINESS.name,
	alternateName: ['El Mesón Moraleja', 'Restaurante El Mesón Moraleja', 'Bar El Mesón Moraleja'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 927 56 34 74',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Parrilla', 'Casera'],
	areaServed: [
		{ '@type': 'City', name: 'Moraleja' },
		{ '@type': 'AdministrativeArea', name: 'Sierra de Gata' },
		{ '@type': 'AdministrativeArea', name: 'Cáceres' },
		{ '@type': 'AdministrativeArea', name: 'Extremadura' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Camareros geniales, educados y simpáticos , buena relación calidad -precio.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Hemos pedido la ensalada de rulo, croquetas, pulpo, calamares y lagarto.',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El mesón', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Restaurante El Mesón · Parrilla en Moraleja';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-el-meson-apaisada-03.jpg": patatas,
	"restaurante-el-meson-vertical-01.jpg": comedor,
	"restaurante-el-meson-vertical-10.jpg": mesa,
	"restaurante-el-meson-vertical-04.jpg": ensalada,
	"restaurante-el-meson-vertical-08.jpg": lagarto,
	"restaurante-el-meson-vista-7-07.jpg": parrilla,
	"restaurante-el-meson-vertical-06.jpg": entrecot,
	"restaurante-el-meson-apaisada-09.jpg": postres,
	"restaurante-el-meson-vertical-02.jpg": flan,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#7c2d1b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante El Mesón Moraleja, El Mesón Moraleja, parrilla Moraleja, comer en Moraleja, bar Moraleja Cáceres, lagarto a la parrilla, C. Camelias Moraleja, restaurantes Sierra de Gata"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Restaurante El Mesón · Parrilla en Moraleja"
			ogDescription="Parrilla y bar en la calle Camelias, 1 (Moraleja): lagarto, carnes a la parrilla, ensalada de rulo, croquetas y raciones. 4,4 en Google con 659 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Entrecot a la parrilla con patatas y croquetas en Restaurante El Mesón, Moraleja"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#7c2d1b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			postalCode={BUSINESS.postalCode}
			phone="+34927563474"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[patatas]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Restaurante El Mesón"
			subtitle="Parrilla y bar · Moraleja"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
				reviews={REVIEWS}
				googleMaps={MAPS.place}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a El Mesón"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34927563474?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Moraleja." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Moraleja"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
