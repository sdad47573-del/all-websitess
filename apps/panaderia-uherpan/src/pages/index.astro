---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import baguettes from '../assets/fotos/panaderia-uherpan-apaisada-01.jpg';
import furgoneta from '../assets/fotos/panaderia-uherpan-vista-2-02.jpg';
import hogazas from '../assets/fotos/panaderia-uherpan-apaisada-03.jpg';
import carro from '../assets/fotos/panaderia-uherpan-apaisada-04.jpg';
import magdalenas from '../assets/fotos/panaderia-uherpan-vertical-05.jpg';
import masa from '../assets/fotos/panaderia-uherpan-panoramica-06.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería UHERPAN · obrador de pan en Las Quemadas, Córdoba';
const description =
	'Panadería UHERPAN S.C.A., en C. Simón Carpintero, parcela 13, nave 10 (Polígono Industrial Las Quemadas, 14014 Córdoba). Baguettes, hogazas, molletes y magdalenas de obrador. Turno de 22:30 a 14:00, domingo cerrado.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#uherpan`,
	name: BUSINESS.name,
	alternateName: ['UHERPAN', 'Panadería UHERPAN', 'Unión Hermanos Panaderos'],
	description:
		'Obrador de pan en el Polígono Industrial Las Quemadas (C. Simón Carpintero, parcela 13, nave 10, 14014 Córdoba). Baguettes, hogazas, molletes y magdalenas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34648127020',
	servesCuisine: ['Panadería', 'Pan artesano'],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '22:30',
			closes: '14:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '22:30',
			closes: '13:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El obrador', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Horario', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const galeria = [
	{
		src: hogazas,
		alt: 'Hogazas redondas de corte rústico y harina sobre una bandeja negra del obrador',
	},
	{
		src: baguettes,
		alt: 'Tres baguettes con greña y harina en la bandeja del horno',
	},
	{
		src: carro,
		alt: 'Carro de varillas con bandejas de panecillos y barras recién horneados',
	},
	{
		src: magdalenas,
		alt: 'Magdalenas en cápsula de papel sobre las bandejas del carro del obrador',
	},
	{
		src: masa,
		alt: 'Estanterías del obrador llenas de piezas de masa reposando antes de hornear',
	},
	{
		src: furgoneta,
		alt: 'Furgoneta blanca rotulada con el logo de UHERPAN, «Pan Artesano Caseras» y el teléfono',
	},
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"panaderia-uherpan-apaisada-03.jpg": hogazas,
	"panaderia-uherpan-apaisada-01.jpg": baguettes,
	"panaderia-uherpan-apaisada-04.jpg": carro,
	"panaderia-uherpan-vertical-05.jpg": magdalenas,
	"panaderia-uherpan-panoramica-06.jpg": masa,
	"panaderia-uherpan-vista-2-02.jpg": furgoneta,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#f6f1e7" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@300..700&family=Instrument+Serif:ital@0;1&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería UHERPAN, UHERPAN Córdoba, obrador de pan, Las Quemadas, pan artesano Córdoba, baguettes, hogazas, molletes, magdalenas, Simón Carpintero, 14014"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Baguettes, hogazas, molletes y magdalenas de obrador en el Polígono Las Quemadas. Turno de 22:30 a 14:00, domingo cerrado. 4,5 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Baguettes recién horneadas en el obrador de Panadería UHERPAN, Córdoba"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#f6f1e7"
			phone="+34648127020"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[hogazas]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="UHERPAN"
			subtitle="Panadería · S.C.A."
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y actividad pueden cambiar; confírmalos antes de ir."
			ctaLabel="Llamar a UHERPAN"
			navAriaLabel="Enlaces de la Panadería UHERPAN"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
