---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import baguettes from '../assets/fotos/panaderia-uherpan-apaisada-01.jpg';
import furgoneta from '../assets/fotos/panaderia-uherpan-vista-2-02.jpg';
import hogazas from '../assets/fotos/panaderia-uherpan-apaisada-03.jpg';
import carro from '../assets/fotos/panaderia-uherpan-apaisada-04.jpg';
import magdalenas from '../assets/fotos/panaderia-uherpan-vertical-05.jpg';
import masa from '../assets/fotos/panaderia-uherpan-panoramica-06.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería UHERPAN · obrador de pan en Las Quemadas, Córdoba';
const description =
	'Panadería UHERPAN S.C.A., en C. Simón Carpintero, parcela 13, nave 10 (Polígono Industrial Las Quemadas, 14014 Córdoba). Baguettes, hogazas, molletes y magdalenas de obrador. Turno de 22:30 a 14:00, domingo cerrado.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#uherpan`,
	name: BUSINESS.name,
	alternateName: ['UHERPAN', 'Panadería UHERPAN', 'Unión Hermanos Panaderos'],
	description:
		'Obrador de pan en el Polígono Industrial Las Quemadas (C. Simón Carpintero, parcela 13, nave 10, 14014 Córdoba). Baguettes, hogazas, molletes y magdalenas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34648127020',
	servesCuisine: ['Panadería', 'Pan artesano'],
	areaServed: [
		{ '@type': 'City', name: 'Córdoba' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Córdoba' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '22:30',
			closes: '14:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '22:30',
			closes: '13:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El obrador', href: '#casa' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Horario', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const galeria = [
	{
		src: hogazas,
		alt: 'Hogazas redondas de corte rústico y harina sobre una bandeja negra del obrador',
	},
	{
		src: baguettes,
		alt: 'Tres baguettes con greña y harina en la bandeja del horno',
	},
	{
		src: carro,
		alt: 'Carro de varillas con bandejas de panecillos y barras recién horneados',
	},
	{
		src: magdalenas,
		alt: 'Magdalenas en cápsula de papel sobre las bandejas del carro del obrador',
	},
	{
		src: masa,
		alt: 'Estanterías del obrador llenas de piezas de masa reposando antes de hornear',
	},
	{
		src: furgoneta,
		alt: 'Furgoneta blanca rotulada con el logo de UHERPAN, «Pan Artesano Caseras» y el teléfono',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#f6f1e7" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@300..700&family=Instrument+Serif:ital@0;1&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería UHERPAN, UHERPAN Córdoba, obrador de pan, Las Quemadas, pan artesano Córdoba, baguettes, hogazas, molletes, magdalenas, Simón Carpintero, 14014"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Baguettes, hogazas, molletes y magdalenas de obrador en el Polígono Las Quemadas. Turno de 22:30 a 14:00, domingo cerrado. 4,5 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Baguettes recién horneadas en el obrador de Panadería UHERPAN, Córdoba"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#f6f1e7"
			phone="+34648127020"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Córdoba"
			locale="es_ES"
			countryName="España"
			preload={[hogazas]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="UHERPAN"
			subtitle="Panadería · S.C.A."
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Polígono Las Quemadas · nave 10 · Córdoba"
				title="Pan de obrador, <br /><em>noche y mañana.</em>"
				lede={`UHERPAN es la panadería cooperativa que hornea en la calle Simón Carpintero, nave 10 del Polígono Las Quemadas. En sus fotos hay baguettes, hogazas enharinadas, panecillos y magdalenas recién salidas del horno, y una furgoneta rotulada con su nombre. El turno va de 22:30 a 14:00 y el domingo cierra. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={hogazas}
				imageAlt="Hogazas redondas de pan rústico, enharinadas, sobre una bandeja del obrador"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Dirección', html: '<b>Las Quemadas</b> · nave 10' },
					{ label: 'Turno', html: '<b>22:30–14:00</b> · domingo cerrado' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b>` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver las fotos en Google"
				tag="Obrador · S.C.A."
			/>

			<LocalChips label="Lo que hay en UHERPAN" items={SERVICIOS} />

			<LocalAbout
				label="El obrador"
				title="Una nave, <br /><em>seis bandejas.</em>"
				paragraphs={[
					'UHERPAN está en la calle Simón Carpintero, parcela 13, nave 10, dentro del Polígono Industrial Las Quemadas. No es un local de calle: la ficha apunta a una nave y todas sus fotos son de dentro del obrador, con bandejas negras, carros de varillas y estanterías.',
					'Lo que se ve es pan de verdad, sin escaparate: baguettes enharinadas con la greña abierta, hogazas redondas de corte rústico, panecillos alargados en carros de dos pisos y bandejas de magdalenas en cápsula de papel saliendo por tandas.',
					'En otra foto aparece un carro entero de piezas de masa reposando antes de entrar al horno, y en la última, la furgoneta blanca de reparto rotulada con el logo: «UHERPAN · Pan Artesano Caseras», «Unión Hermanos Panaderos» y el teléfono. Es la pista de que el pan sale de la nave hacia otros puntos.',
					'El horario también es de obrador: el turno empieza a las 22:30 y termina a las 14:00, con el sábado hasta las 13:30 y el domingo cerrado. La ficha de Google lo muestra partido a medianoche, en dos tramos que aquí se leen como uno solo.',
				]}
				note="La ficha de Google no publica carta, precios, web propia ni condiciones de venta o reparto, y no indica si la nave atiende al público. Esta página no lo afirma: si quieres comprar o encargar, llama antes al 648 12 70 20."
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas del obrador</p>
							<h2 id="three-title">Horno, carro <br /><em>y furgoneta.</em></h2>
						</div>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos"
				title="Dentro <br /><em>de la nave.</em>"
				description="Las seis imágenes de la ficha de Google Maps: hogazas, baguettes, dos carros de bandejas, las magdalenas y la furgoneta rotulada de la panadería."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026. Son las seis que publica la ficha."
			/>

			<section class="rating-band" aria-labelledby="rating-title">
				<div class="wrap rating-inner">
					<div class="rating-score">
						<strong>4,5</strong>
						<div>
							<span class="rating-stars" role="img" aria-label="4,5 de 5 estrellas">★★★★★</span>
							<p id="rating-title" style="margin:0;font-size:.78rem">8 reseñas en Google Maps</p>
						</div>
					</div>
					<p class="rating-copy">
						La nota de la ficha es 4,5 sobre 5 con 8 reseñas: pocas, pero suficientes para
						hacerse una idea. Esta página no reproduce sus textos; se leen enteros en Google.
					</p>
					<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
						Leer las reseñas en Google ↗
					</a>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Las Quemadas, <br /><em>nave 10.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de la Panadería UHERPAN en el Polígono Las Quemadas, Córdoba"
				mapEmbedUrl={MAPS.embed}
				mapLabel="UHERPAN · nave 10"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phone, href: BUSINESS.phoneHref }}
				reserveNote="La ficha de Google no publica web propia ni datos de accesibilidad, y no confirma horario de tienda al público. El teléfono es el que figura en esa ficha. Esta página no gestiona pedidos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>llamar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y actividad pueden cambiar; confírmalos antes de ir."
			ctaLabel="Llamar a UHERPAN"
			navAriaLabel="Enlaces de la Panadería UHERPAN"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
