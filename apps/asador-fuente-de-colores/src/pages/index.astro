---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import pollo from '../assets/fotos/asador-fuente-de-colores-apaisada-03.jpg';
import fachada from '../assets/fotos/asador-fuente-de-colores-apaisada-01.jpg';
import vitrinaFria from '../assets/fotos/asador-fuente-de-colores-apaisada-02.jpg';
import bandeja from '../assets/fotos/asador-fuente-de-colores-apaisada-06.jpg';
import fachadaMenu from '../assets/fotos/asador-fuente-de-colores-vertical-04.jpg';
import cartelMenus from '../assets/fotos/asador-fuente-de-colores-vertical-05.jpg';
import cartelCorregido from '../assets/fotos/asador-fuente-de-colores-vertical-08.jpg';
import vitrinaCaliente from '../assets/fotos/asador-fuente-de-colores-vertical-09.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Asador Fuente de Colores · Pollo asado y menús en Teatinos';
const description =
	'Asador Fuente de Colores, en Av. Jorge Luis Borges, 7, local 5 (Teatinos-Universidad, 29010 Málaga). Pollo asado, patatas, menús variados y especialidades caseras, de miércoles a domingo de 12:30 a 16:00.';

const galeria = [
	{
		src: pollo,
		alt: 'Una mesa con pollo asado, patatas fritas, pimientos fritos, ensaladilla rusa y un vaso de alioli',
	},
	{
		src: bandeja,
		alt: 'Una bandeja de aluminio con un pollo asado entero, recién hecho',
	},
	{
		src: vitrinaFria,
		alt: 'La vitrina fría del local con bandejas de pescado, pollo, albóndigas, guisos, callos y pisto',
	},
	{
		src: vitrinaCaliente,
		alt: 'La vitrina caliente con croquetas, empanadillas, albóndigas, lasaña y otras especialidades caseras',
	},
	{
		src: fachada,
		alt: 'La fachada de La Fuente de Colores con el toldo de asador de pollos y comidas para llevar y la persiana azul',
	},
	{
		src: fachadaMenu,
		alt: 'El cartel de menú del local con las especialidades: pollo asado, albóndigas, croquetas, migas, callos, ensaladas y bacalao',
	},
	{
		src: cartelMenus,
		alt: 'El cartel con los siete menús de pollo, el pollo asado suelto, el menú de comida y el pollo de corral ecológico',
	},
	{
		src: cartelCorregido,
		alt: 'El mismo cartel de menús con varios precios corregidos a mano sobre los impresos',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Asador Fuente de Colores',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#fuente-de-colores`,
	name: BUSINESS.name,
	alternateName: ['Asador Fuente De Colores', 'La Fuente de Colores', 'Asador La Fuente de Colores Málaga'],
	description:
		'Asador de pollos y comidas para llevar en la avenida Jorge Luis Borges, 7, local 5, Teatinos-Universidad (29010 Málaga). Pollo asado, patatas, menús y especialidades caseras.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34952611580',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Comida casera', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:30',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#191411" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Manrope:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador Fuente de Colores, La Fuente de Colores, pollo asado Teatinos, pollo asado Málaga, comida para llevar Teatinos, menús de pollo, croquetas caseras, albóndigas, Jorge Luis Borges"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado, patatas, menús variados y especialidades caseras en la avenida Jorge Luis Borges, 7, local 5. De miércoles a domingo, de 12:30 a 16:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de La Fuente de Colores con el toldo de asador de pollos"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#191411"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Teatinos"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[pollo]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Fuente de Colores"
			subtitle="Pollo asado · Teatinos"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. Jorge Luis Borges, 7, local 5 · Teatinos, Málaga"
				title="Pollo asado <br /><em>y menús de casa.</em>"
				lede={`La Fuente de Colores lleva el cartel de asador de pollos y comidas para llevar en la avenida Jorge Luis Borges. El pollo sale con patatas, pimientos y alioli, y el local tiene siete menús de pollo, un menú de comida completo y una vitrina de especialidades caseras. Abre de miércoles a domingo, de 12:30 a 16:00, y tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={pollo}
				imageAlt="Una mesa con pollo asado, patatas fritas, pimientos fritos, ensaladilla rusa y un vaso de alioli"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>12:30–16:00</b> · miércoles a domingo' },
					{ label: 'Servicio', html: '<b>Para llevar</b> y a domicilio' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Siete menús de pollo"
			/>

			<LocalChips label="Lo que ofrece Asador Fuente de Colores" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un asador de barrio <br /><em>con vitrina y menús.</em>"
				paragraphs={[
					'Asador Fuente de Colores está en la avenida Jorge Luis Borges, 7, local 5, en Teatinos. La fachada morada y el toldo anuncian «Asador de pollos · Comidas para llevar · TlF 952 611 580», y la persiana azul dibuja un pollo asado con las palabras «comida para llevar».',
					'Dentro manda la vitrina: bandejas de pollo, pescado, albóndigas, callos, migas, croquetas caseras, ensaladas y guisos. El cartel de especialidades lista pollo asado, albóndigas, croquetas caseras, migas, callos, ensaladas, lomo al horno, solomillo y bacalao.',
					'La casa tiene siete menús de pollo con patatas y bebida, un menú de comida con primero, segundo, postre y bebida, pollo asado suelto y pollo de corral ecológico por encargo. En las fotos se ve además el servicio a domicilio por 2 € con pedido mínimo de 10 €.',
					'Google le da 4,3 sobre 5 con 231 reseñas. Las opiniones destacadas hablan de un pollo «muy rico», de patatas «deliciosas», de menús «muy variados» y de un personal «muy agradable». Abre de miércoles a domingo, de 12:30 a 16:00; lunes y martes cierra.',
				]}
				note="La ficha no publica carta ni precios. Los menús y especialidades de esta página son los que aparecen en los carteles y la vitrina del local en las fotos de Google. Los precios del cartel están corregidos a mano en algunos casos, así que conviene confirmarlos por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que se asa</p>
					<h2 id="highlights-title">Pollo, menús <br /><em>y vitrina.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Menús y pollo <br /><em>de la casa.</em>"
				description="La ficha de Google no publica carta. Los menús y las especialidades son los que aparecen en el cartel y la vitrina del local, más lo que nombran las reseñas."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Los carteles del local listan siete menús de pollo, un menú de comida completo, pollo asado suelto y pollo de corral ecológico por encargo. Los precios aparecen corregidos a mano en el propio cartel y cambian; confírmalos por teléfono antes de pedir."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La fachada, el pollo <br /><em>y la vitrina.</em>"
				description="Ocho fotografías del perfil de Asador Fuente de Colores en Google Maps: el pollo asado en la mesa, la bandeja recién hecha, la vitrina fría y caliente y los carteles de menús y especialidades."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,3 sobre 5, <em>con 231 reseñas.</em></h2>
						<p>
							La valoración que publica Google en octubre de 2026 es de 4,3 con 231 opiniones. Las
							reseñas destacadas hablan del pollo, de las patatas, de la variedad de menús y del
							trato; aquí se reproducen tal como aparecen en la ficha.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,3</strong>
						<span>★★★★☆</span>
						<small>231 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En Teatinos, <br /><em>Jorge Luis Borges.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de miércoles a domingo, de 12:30 a 16:00, con el lunes y el martes cerrados. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Asador Fuente de Colores en la avenida Jorge Luis Borges, 7, local 5, Teatinos, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Av. Jorge Luis Borges, 7, local 5"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos y encargos por teléfono: la ficha no publica pedidos online. El cartel del local anuncia servicio a domicilio por 2 € con un pedido mínimo de 10 €. La ficha no publica datos de accesibilidad, así que conviene llamar antes si necesitas acceso para silla de ruedas."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a Fuente de Colores"
			navAriaLabel="Enlaces de Asador Fuente de Colores"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
