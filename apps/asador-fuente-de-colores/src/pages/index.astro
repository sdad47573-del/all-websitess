---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import pollo from '../assets/fotos/asador-fuente-de-colores-apaisada-03.jpg';
import fachada from '../assets/fotos/asador-fuente-de-colores-apaisada-01.jpg';
import vitrinaFria from '../assets/fotos/asador-fuente-de-colores-apaisada-02.jpg';
import bandeja from '../assets/fotos/asador-fuente-de-colores-apaisada-06.jpg';
import fachadaMenu from '../assets/fotos/asador-fuente-de-colores-vertical-04.jpg';
import cartelMenus from '../assets/fotos/asador-fuente-de-colores-vertical-05.jpg';
import cartelCorregido from '../assets/fotos/asador-fuente-de-colores-vertical-08.jpg';
import vitrinaCaliente from '../assets/fotos/asador-fuente-de-colores-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Asador Fuente de Colores · Pollo asado y menús en Teatinos';
const description =
	'Asador Fuente de Colores, en Av. Jorge Luis Borges, 7, local 5 (Teatinos-Universidad, 29010 Málaga). Pollo asado, patatas, menús variados y especialidades caseras, de miércoles a domingo de 12:30 a 16:00.';

const galeria = [
	{
		src: pollo,
		alt: 'Una mesa con pollo asado, patatas fritas, pimientos fritos, ensaladilla rusa y un vaso de alioli',
	},
	{
		src: bandeja,
		alt: 'Una bandeja de aluminio con un pollo asado entero, recién hecho',
	},
	{
		src: vitrinaFria,
		alt: 'La vitrina fría del local con bandejas de pescado, pollo, albóndigas, guisos, callos y pisto',
	},
	{
		src: vitrinaCaliente,
		alt: 'La vitrina caliente con croquetas, empanadillas, albóndigas, lasaña y otras especialidades caseras',
	},
	{
		src: fachada,
		alt: 'La fachada de La Fuente de Colores con el toldo de asador de pollos y comidas para llevar y la persiana azul',
	},
	{
		src: fachadaMenu,
		alt: 'El cartel de menú del local con las especialidades: pollo asado, albóndigas, croquetas, migas, callos, ensaladas y bacalao',
	},
	{
		src: cartelMenus,
		alt: 'El cartel con los siete menús de pollo, el pollo asado suelto, el menú de comida y el pollo de corral ecológico',
	},
	{
		src: cartelCorregido,
		alt: 'El mismo cartel de menús con varios precios corregidos a mano sobre los impresos',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Asador Fuente de Colores',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#fuente-de-colores`,
	name: BUSINESS.name,
	alternateName: ['Asador Fuente De Colores', 'La Fuente de Colores', 'Asador La Fuente de Colores Málaga'],
	description:
		'Asador de pollos y comidas para llevar en la avenida Jorge Luis Borges, 7, local 5, Teatinos-Universidad (29010 Málaga). Pollo asado, patatas, menús y especialidades caseras.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34952611580',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Comida casera', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '12:30',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"asador-fuente-de-colores-apaisada-03.jpg": pollo,
	"asador-fuente-de-colores-apaisada-06.jpg": bandeja,
	"asador-fuente-de-colores-apaisada-02.jpg": vitrinaFria,
	"asador-fuente-de-colores-vertical-09.jpg": vitrinaCaliente,
	"asador-fuente-de-colores-apaisada-01.jpg": fachada,
	"asador-fuente-de-colores-vertical-04.jpg": fachadaMenu,
	"asador-fuente-de-colores-vertical-05.jpg": cartelMenus,
	"asador-fuente-de-colores-vertical-08.jpg": cartelCorregido,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#191411" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Manrope:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador Fuente de Colores, La Fuente de Colores, pollo asado Teatinos, pollo asado Málaga, comida para llevar Teatinos, menús de pollo, croquetas caseras, albóndigas, Jorge Luis Borges"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado, patatas, menús variados y especialidades caseras en la avenida Jorge Luis Borges, 7, local 5. De miércoles a domingo, de 12:30 a 16:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de La Fuente de Colores con el toldo de asador de pollos"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#191411"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Teatinos"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[pollo]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Fuente de Colores"
			subtitle="Pollo asado · Teatinos"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a Fuente de Colores"
			navAriaLabel="Enlaces de Asador Fuente de Colores"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34952611580?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carta%20de%20Asador%20Fuente%20de%20Colores." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carta de Asador Fuente de Colores"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
