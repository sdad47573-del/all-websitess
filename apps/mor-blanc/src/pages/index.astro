---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import asado from '../assets/fotos/mor-blanc-apaisada-01.jpg';
import paella from '../assets/fotos/mor-blanc-apaisada-02.jpg';
import fachada from '../assets/fotos/mor-blanc-apaisada-03.jpg';
import piscina from '../assets/fotos/mor-blanc-vertical-04.jpg';
import terraza from '../assets/fotos/mor-blanc-apaisada-06.jpg';
import entrecot from '../assets/fotos/mor-blanc-apaisada-08.jpg';
import chuleta from '../assets/fotos/mor-blanc-apaisada-09.jpg';
import ensalada from '../assets/fotos/mor-blanc-panoramica-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Terraza Cafe Bar Restaurante Mor Blanc, en la calle de la Paz, 19 (Valdeobispo, Cáceres). Paella, sepia, pinchos, carnes a la brasa, terraza y piscina. Abierto todos los días de 10:00 a 24:00. Tel. 927 45 63 97.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada verde lima de Mor Blanc con el rótulo Bar - Restaurante y la terraza de sombrillas al fondo',
	},
	{
		src: terraza,
		alt: 'Terraza de Mor Blanc bajo los árboles, con césped, mesas de metal y sillas blancas',
	},
	{
		src: piscina,
		alt: 'Piscina de Mor Blanc con sombrillas, sillas rojas y gente bañándose en verano',
	},
	{
		src: paella,
		alt: 'Paella de Mor Blanc con langostinos, pimiento rojo y gajos de limón en la paellera',
	},
	{
		src: asado,
		alt: 'Asado de Mor Blanc con patatas panaderas y ensalada de tomate y cebolla',
	},
	{
		src: chuleta,
		alt: 'Chuleta a la brasa con pimientos verdes servida en Restaurante Mor Blanc',
	},
	{
		src: ensalada,
		alt: 'Ensalada mixta de Mor Blanc con atún, espárragos, maíz, remolacha y tomate',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la brasa en primer plano en Terraza Cafe Bar Restaurante Mor Blanc',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#mor-blanc`,
	name: 'Terraza Cafe Bar Restaurante Mor Blanc',
	alternateName: ['Mor Blanc', 'Bar Restaurante Mor Blanc', 'Mor Blanc Valdeobispo'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 927 45 63 97',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Arroces', 'Parrilla'],
	areaServed: [
		{ '@type': 'City', name: 'Valdeobispo' },
		{ '@type': 'City', name: 'Plasencia' },
		{ '@type': 'AdministrativeArea', name: 'Cáceres' },
		{ '@type': 'AdministrativeArea', name: 'Extremadura' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:00',
			closes: '23:59',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Piscina', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 4, bestRating: 5 },
			reviewBody: 'La paella, muy buena y la sepia, extraordinaria',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Excelente trato y buenos pinchos,',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Mor Blanc · Terraza, bar y restaurante en Valdeobispo';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#4b7f3f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Mor Blanc Valdeobispo, bar restaurante Mor Blanc, terraza Valdeobispo, comer en Valdeobispo, paella Valdeobispo, piscina Valdeobispo, restaurante cerca de Plasencia, C. de la Paz Valdeobispo"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Mor Blanc · Terraza, bar y restaurante en Valdeobispo"
			ogDescription="Paella, sepia, pinchos y carnes a la brasa en la calle de la Paz, 19 (Valdeobispo). Terraza, jardín y piscina. Abierto todos los días de 10:00 a 24:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Paella con langostinos y limón de Terraza Cafe Bar Restaurante Mor Blanc"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#4b7f3f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			postalCode={BUSINESS.postalCode}
			phone="+34927456397"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[paella]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Mor Blanc"
			subtitle="Terraza, bar y restaurante · Valdeobispo"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. de la Paz, 19 · Valdeobispo"
				title="Terraza, piscina<br /><em>y arroces.</em>"
				lede={`Mor Blanc es terraza, café, bar y restaurante en la calle de la Paz, 19, de Valdeobispo (Cáceres), a pocos kilómetros de Plasencia. Paella, sepia, pinchos y carnes a la brasa, con jardín y piscina para el verano. Abre todos los días de 10:00 a 24:00; reservas en el ${BUSINESS.phoneDisplay}.`}
				image={paella}
				imageAlt="Paella de Mor Blanc con langostinos, pimiento rojo y gajos de limón"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{
						label: 'Nota',
						html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)`,
					},
					{ label: 'Horario', html: 'Todos los días · 10:00–24:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phoneDisplay}</b>` },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Terraza Cafe Bar Restaurante Mor Blanc" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Fachada verde<br /><em>y jardín.</em>"
				paragraphs={[
					'Terraza Cafe Bar Restaurante Mor Blanc está en la calle de la Paz, 19, de Valdeobispo (Cáceres), en el norte de la provincia y a pocos kilómetros de Plasencia.',
					'El edificio es inconfundible: pared de color verde lima con el rótulo «BAR - RESTAURANTE MOR·BLANC», zócalo de piedra y una terraza de sombrillas blancas junto a la entrada. Detrás, un jardín de árboles con mesas y sillas de plástico sobre el césped, y una piscina con sombrillas y sillas rojas.',
					'La ficha de Google lo clasifica como restaurante y bar. Sus reseñas hablan de la paella («muy buena»), la sepia («extraordinaria»), los pinchos y las raciones, y de darse un baño en la piscina como plan de tarde.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. Una reseña lo resume así: «buen sitio para tomar raciones y darse un baño en piscina».`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Paella, sepia<br /><em>y brasa.</em>"
				description="La ficha de Google no publica carta ni precios: esto es lo que nombran sus reseñas y lo que se ve en las fotos de sus platos."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Sin carta publicada, los platos cambian según el día. Llama al 927 45 63 97 para saber qué hay y si la piscina está abierta."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La fachada<br /><em>y la piscina.</em>"
				description="Estas fotografías proceden del perfil de Mor Blanc en Google Maps: la fachada verde, la terraza del jardín, la piscina, la paella y las carnes a la brasa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Nos vemos<br /><em>en la terraza.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: todos los días de la semana, de 10:00 a 24:00. Para comer tarde o para la piscina, conviene llamar antes."
				mapTitle="Mapa de Terraza Cafe Bar Restaurante Mor Blanc en la calle de la Paz, 19, Valdeobispo (Cáceres)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Terraza Cafe Bar Restaurante Mor Blanc · Valdeobispo"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva llamando al 927 45 63 97. La ficha de Google marca acceso para sillas de ruedas y aseo adaptado. Está en la calle de la Paz, 19, de Valdeobispo, a pocos kilómetros de Plasencia."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Mor Blanc"
		/>
	</body>
</html>
