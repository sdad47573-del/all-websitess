---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/comidas-para-llevar-san-clemente-panoramica-03.jpg';
import paella from '../assets/fotos/comidas-para-llevar-san-clemente-apaisada-05.jpg';
import asado from '../assets/fotos/comidas-para-llevar-san-clemente-apaisada-10.jpg';
import codillo from '../assets/fotos/comidas-para-llevar-san-clemente-vertical-07.jpg';
import cuscus from '../assets/fotos/comidas-para-llevar-san-clemente-panoramica-08.jpg';
import guiso from '../assets/fotos/comidas-para-llevar-san-clemente-vista-2-02.jpg';
import patatasRellenas from '../assets/fotos/comidas-para-llevar-san-clemente-vertical-09.jpg';
import lasana from '../assets/fotos/comidas-para-llevar-san-clemente-vista-6-06.jpg';
import cocina from '../assets/fotos/comidas-para-llevar-san-clemente-panoramica-04.jpg';
import vitrina from '../assets/fotos/comidas-para-llevar-san-clemente-panoramica-01.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'San Clemente · Guisos y comida para llevar en Lorca';
const description =
	'Comidas para Llevar San Clemente, en C. Galicia, bajo 2 (30800 Lorca). Guisos caseros, asados, pescados, ensaladas y bollería para llevar, de 11:00 a 15:15.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de Comidas para Llevar y Asador Clemente en la calle Galicia de Lorca, con el rótulo en el escaparate',
	},
	{
		src: paella,
		alt: 'Una paella de marisco con gambas, mejillones, calamar y pimiento en la paellera',
	},
	{
		src: asado,
		alt: 'Una pieza grande de carne asada al horno en su jugo, en una bandeja de cocina',
	},
	{
		src: codillo,
		alt: 'Bandeja de codillo asado con patatas panadera doradas y su jugo',
	},
	{
		src: cuscus,
		alt: 'Una cazuela de cuscús con trozos de carne, pimientos rojos y verdes y guisantes',
	},
	{
		src: guiso,
		alt: 'Una bandeja de guiso de ternera en salsa de tomate espesa',
	},
	{
		src: patatasRellenas,
		alt: 'Patatas rellenas de carne gratinadas con queso en una bandeja de acero',
	},
	{
		src: lasana,
		alt: 'Cuatro bandejas de aluminio de lasaña recién gratinada, con la bechamel dorada',
	},
	{
		src: cocina,
		alt: 'La cocina del local con el horno, la plancha, la campana extractora y los cuchillos colgados',
	},
	{
		src: vitrina,
		alt: 'La vitrina del local vacía, con las bebidas alineadas y la pared verde al fondo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#san-clemente`,
	name: BUSINESS.fullName,
	alternateName: ['San Clemente Lorca', 'Comidas para Llevar y Asador Clemente', 'Comidas Clemente'],
	description:
		'Guisos caseros, asados, pescados, carnes, verduras y ensaladas para llevar en la calle Galicia, bajo 2 (30800 Lorca), con bollería por la mañana y pan todo el día.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34623228065',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina casera', 'Cocina murciana', 'Asador', 'Comida para llevar'],
	hasMenu: {
		'@type': 'Menu',
		name: 'Carta de San Clemente',
		inLanguage: 'es-ES',
		hasMenuSection: MENU.map((group) => ({
			'@type': 'MenuSection',
			name: group.title,
			hasMenuItem: group.items.map((item) => ({
				'@type': 'MenuItem',
				name: item.name,
				description: item.note,
			})),
		})),
	},
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Lorca' },
		{ '@type': 'AdministrativeArea', name: 'Región de Murcia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:00',
			closes: '15:15',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#243b53" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Lora:wght@400;500;600&family=Nunito+Sans:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Comidas para Llevar San Clemente Lorca, guisos caseros Lorca, asador Clemente, comida para llevar calle Galicia, paella Lorca, codillo asado, migas Lorca 30800"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Guisos caseros, asados y paellas para llevar en C. Galicia, bajo 2, Lorca. Bollería por la mañana y pan todo el día. De 11:00 a 15:15."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Una paella de marisco de Comidas para Llevar San Clemente, en Lorca"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#243b53"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lorca"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="San Clemente"
			subtitle="Comidas y asador · Lorca"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Galicia, bajo 2 · Lorca"
				title="Guisos calientes, <br /><em>sin manchar la cocina.</em>"
				lede={`Eso es exactamente lo que ofrece Comidas para Llevar San Clemente, en la calle Galicia de Lorca: guisos tradicionales, pescados, carnes, verduras, ensaladas, bollería por la mañana y pan todo el día. El local firma su ficha como «Comidas para Llevar y Asador Clemente» y anuncia migas los días lluviosos. Abre de 11:00 a 15:15, con el miércoles cerrado, y tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={fachada}
				imageAlt="La fachada de Comidas para Llevar y Asador Clemente en la calle Galicia de Lorca"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>11:00–15:15</b> · miércoles cerrado' },
					{ label: 'Especialidad', html: '<b>Guisos</b><br />y asador' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Comida para llevar"
			/>

			<LocalChips label="Lo que ofrece San Clemente" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="La cocina <br /><em>de cada día.</em>"
				paragraphs={[
					'Comidas para Llevar San Clemente está en la calle Galicia, bajo 2, en Lorca. La luna del escaparate lo dice con dibujo: una olla y unas cucharas de madera sobre el nombre «Clemente». Al lado, el cartel de la puerta anuncia el horario y el teléfono para encargar.',
					'Dentro, la cocina trabaja con horno, plancha y campana grande, y el mostrador se llena de bandejas: paella de marisco con gambas y mejillones, cuscús con carne y pimientos, guiso de ternera en salsa, patatas rellenas gratinadas, lasañas y canelones en bandejas individuales, codillo asado con patatas y piezas de carne al horno en su jugo.',
					'El propio negocio describe su oferta en la ficha: guisos calientes tradicionales, pescados, carnes, verduras, ensaladas, bollería por las mañanas y pan durante todo el día. Y avisa, con ganas, de las migas: «¡MIGAS LOS DÍAS LLUVIOSOS!».',
					`Tiene ${RATING.label} sobre 5 con ${RATING.count} reseñas. «Buena comida y mucha variedad» y «comida riquísima, trato excelente» son las que destaca Google; otra, de tres estrellas, se queja de una merluza «un poco seca» y de la cantidad.`,
				]}
				note="La ficha no publica carta con precios, reparto a domicilio ni formas de pago. Los platos de esta página salen de la descripción del negocio y de las bandejas que aparecen en las fotos del perfil; el menú de cada día se consulta en el 623 22 80 65."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que se lleva la gente</p>
					<h2 id="highlights-title">Cazuela, horno <br /><em>y mostrador.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La comida"
				title="Lo que hay <br /><em>en el mostrador.</em>"
				description="Guisos, asados y bandejas tomados de la descripción del negocio y de las fotos del perfil. La ficha no publica precios, así que aquí no hay importes."
				cta={{ label: `Preguntar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La lista cambia cada día. El menú, los precios y si hay migas se preguntan en el 623 22 80 65. Las migas solo se anuncian los días de lluvia."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La fachada, la cocina <br /><em>y las bandejas.</em>"
				description="Diez fotografías del perfil de San Clemente: la fachada con el rótulo, la paella de marisco, la carne asada al horno, el codillo con patatas, el cuscús, el guiso de ternera, las patatas rellenas, las lasañas, la cocina y la vitrina."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,6 sobre 5, <em>con 34 reseñas.</em></h2>
						<p>
							Google publica una media de 4,6 con 34 opiniones (noviembre de 2026). Las reseñas
							que se ven aquí elogian la comida, la variedad y el trato; la de tres estrellas
							critica una merluza seca y la cantidad. Son las que destaca la ficha; hay más
							opiniones en Google.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,6</strong>
						<span>★★★★★</span>
						<small>34 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En Lorca, <br /><em>calle Galicia.</em>"
				addressLines={[BUSINESS.street, BUSINESS.postalCode, `${BUSINESS.district}, ${BUSINESS.region}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha: de 11:00 a 15:15, con el miércoles cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Comidas para Llevar San Clemente en la calle Galicia, bajo 2, Lorca"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. Galicia, bajo 2 · Lorca"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote={`Pedidos por teléfono en el ${BUSINESS.phone} y recogida en el local. La ficha declara acceso para sillas de ruedas y no publica reparto a domicilio ni formas de pago.`}
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>llamar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultados en noviembre de 2026. La ficha no publica carta con precios: confirma el menú y el horario antes de ir."
			ctaLabel="Llamar a San Clemente"
			navAriaLabel="Enlaces de Comidas para Llevar San Clemente"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
