---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/comidas-para-llevar-san-clemente-panoramica-03.jpg';
import paella from '../assets/fotos/comidas-para-llevar-san-clemente-apaisada-05.jpg';
import asado from '../assets/fotos/comidas-para-llevar-san-clemente-apaisada-10.jpg';
import codillo from '../assets/fotos/comidas-para-llevar-san-clemente-vertical-07.jpg';
import cuscus from '../assets/fotos/comidas-para-llevar-san-clemente-panoramica-08.jpg';
import guiso from '../assets/fotos/comidas-para-llevar-san-clemente-vista-2-02.jpg';
import patatasRellenas from '../assets/fotos/comidas-para-llevar-san-clemente-vertical-09.jpg';
import lasana from '../assets/fotos/comidas-para-llevar-san-clemente-vista-6-06.jpg';
import cocina from '../assets/fotos/comidas-para-llevar-san-clemente-panoramica-04.jpg';
import vitrina from '../assets/fotos/comidas-para-llevar-san-clemente-panoramica-01.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'San Clemente · Guisos y comida para llevar en Lorca';
const description =
	'Comidas para Llevar San Clemente, en C. Galicia, bajo 2 (30800 Lorca). Guisos caseros, asados, pescados, ensaladas y bollería para llevar, de 11:00 a 15:15.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de Comidas para Llevar y Asador Clemente en la calle Galicia de Lorca, con el rótulo en el escaparate',
	},
	{
		src: paella,
		alt: 'Una paella de marisco con gambas, mejillones, calamar y pimiento en la paellera',
	},
	{
		src: asado,
		alt: 'Una pieza grande de carne asada al horno en su jugo, en una bandeja de cocina',
	},
	{
		src: codillo,
		alt: 'Bandeja de codillo asado con patatas panadera doradas y su jugo',
	},
	{
		src: cuscus,
		alt: 'Una cazuela de cuscús con trozos de carne, pimientos rojos y verdes y guisantes',
	},
	{
		src: guiso,
		alt: 'Una bandeja de guiso de ternera en salsa de tomate espesa',
	},
	{
		src: patatasRellenas,
		alt: 'Patatas rellenas de carne gratinadas con queso en una bandeja de acero',
	},
	{
		src: lasana,
		alt: 'Cuatro bandejas de aluminio de lasaña recién gratinada, con la bechamel dorada',
	},
	{
		src: cocina,
		alt: 'La cocina del local con el horno, la plancha, la campana extractora y los cuchillos colgados',
	},
	{
		src: vitrina,
		alt: 'La vitrina del local vacía, con las bebidas alineadas y la pared verde al fondo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#san-clemente`,
	name: BUSINESS.fullName,
	alternateName: ['San Clemente Lorca', 'Comidas para Llevar y Asador Clemente', 'Comidas Clemente'],
	description:
		'Guisos caseros, asados, pescados, carnes, verduras y ensaladas para llevar en la calle Galicia, bajo 2 (30800 Lorca), con bollería por la mañana y pan todo el día.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34623228065',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina casera', 'Cocina murciana', 'Asador', 'Comida para llevar'],
	hasMenu: {
		'@type': 'Menu',
		name: 'Carta de San Clemente',
		inLanguage: 'es-ES',
		hasMenuSection: MENU.map((group) => ({
			'@type': 'MenuSection',
			name: group.title,
			hasMenuItem: group.items.map((item) => ({
				'@type': 'MenuItem',
				name: item.name,
				description: item.note,
			})),
		})),
	},
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Lorca' },
		{ '@type': 'AdministrativeArea', name: 'Región de Murcia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:00',
			closes: '15:15',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"comidas-para-llevar-san-clemente-panoramica-03.jpg": fachada,
	"comidas-para-llevar-san-clemente-apaisada-05.jpg": paella,
	"comidas-para-llevar-san-clemente-apaisada-10.jpg": asado,
	"comidas-para-llevar-san-clemente-vertical-07.jpg": codillo,
	"comidas-para-llevar-san-clemente-panoramica-08.jpg": cuscus,
	"comidas-para-llevar-san-clemente-vista-2-02.jpg": guiso,
	"comidas-para-llevar-san-clemente-vertical-09.jpg": patatasRellenas,
	"comidas-para-llevar-san-clemente-vista-6-06.jpg": lasana,
	"comidas-para-llevar-san-clemente-panoramica-04.jpg": cocina,
	"comidas-para-llevar-san-clemente-panoramica-01.jpg": vitrina,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#243b53" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Lora:wght@400;500;600&family=Nunito+Sans:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Comidas para Llevar San Clemente Lorca, guisos caseros Lorca, asador Clemente, comida para llevar calle Galicia, paella Lorca, codillo asado, migas Lorca 30800"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Guisos caseros, asados y paellas para llevar en C. Galicia, bajo 2, Lorca. Bollería por la mañana y pan todo el día. De 11:00 a 15:15."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Una paella de marisco de Comidas para Llevar San Clemente, en Lorca"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#243b53"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MC"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lorca"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="San Clemente"
			subtitle="Comidas y asador · Lorca"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultados en noviembre de 2026. La ficha no publica carta con precios: confirma el menú y el horario antes de ir."
			ctaLabel="Llamar a San Clemente"
			navAriaLabel="Enlaces de Comidas para Llevar San Clemente"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
