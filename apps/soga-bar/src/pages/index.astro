---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/soga-bar-apaisada-01.jpg';
import carneSalsa from '../assets/fotos/soga-bar-apaisada-03.jpg';
import merengue from '../assets/fotos/soga-bar-apaisada-04.jpg';
import croquetas from '../assets/fotos/soga-bar-apaisada-05.jpg';
import ensaladaGambas from '../assets/fotos/soga-bar-apaisada-06.jpg';
import carnePlancha from '../assets/fotos/soga-bar-apaisada-07.jpg';
import jamon from '../assets/fotos/soga-bar-cuadrada-02.jpg';
import tartaChocolate from '../assets/fotos/soga-bar-cuadrada-08.jpg';
import tortellini from '../assets/fotos/soga-bar-vertical-09.jpg';
import ensaladaPollo from '../assets/fotos/soga-bar-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, HORARIO_AVISO, MAPS, MENU, RATING, SERVICIOS } from '../data/site';

const title = 'Soga bar · tapas, arroces y mantel en la Plaza de la Provincia';
const description = BUSINESS.description;

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de Soga bar con mesas de mantel blanco, banqueta de cuero y pared de madera iluminada con plantas colgando',
	},
	{
		src: ensaladaGambas,
		alt: 'Ensalada de gambas con láminas de pato, frambuesas, arándanos y brotes en plato azul',
	},
	{
		src: tortellini,
		alt: 'Tortellini de calabaza con rabo de toro guisado y su salsa, en plato de cerámica azul',
	},
	{
		src: carnePlancha,
		alt: 'Lonchas de carne a la plancha sobre crema de calabaza naranja',
	},
	{
		src: carneSalsa,
		alt: 'Lomo de ternera en lonchas con pisto y salsa naranja en fuente blanca',
	},
	{
		src: jamon,
		alt: 'Láminas de jamón ibérico sobre patata con cebollino, en plato blanco',
	},
	{
		src: croquetas,
		alt: 'Cuatro croquetas doradas en plato de cerámica azul y blanca',
	},
	{
		src: merengue,
		alt: 'Tarta de merengue con azúcar en polvo y helado blanco al lado',
	},
	{
		src: tartaChocolate,
		alt: 'Tarta de chocolate con crema inglesa y fresas en láminas',
	},
	{
		src: ensaladaPollo,
		alt: 'Ensalada de pollo escabechado con tomate, arándanos, frambuesas y brotes',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#soga-bar`,
	name: BUSINESS.name,
	alternateName: ['Soga bar Ciudad Real', 'Soga Bar Plaza de la Provincia'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Tapas', 'Cocina de mercado', 'Arroces', 'Pastas', 'Brunch'],
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.channel },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Entrada adaptada', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#101612" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Soga bar Ciudad Real, bar de tapas Plaza de la Provincia, restaurante centro Ciudad Real, tapas Ciudad Real, brunch Ciudad Real, ensaladas y arroces Ciudad Real, rabo de toro, croquetas Ciudad Real, 13001"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Bar de tapas y restaurante en la Plaza de la Provincia, 5, de Ciudad Real. Tapas, ensaladas, pastas, arroces, carnes y postres, también con brunch. 4,2 sobre 5 con 827 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tortellini de calabaza con rabo de toro de Soga bar"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#101612"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Tapas y mantel en la Provincia"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Tapas y mantel <br /><em>en la Provincia.</em>"
				lede={`Soga bar está en la Plaza de la Provincia, 5, en el centro de Ciudad Real. Bar de tapas y restaurante a la vez: croquetas, jamón, ensaladas con fruta, pastas, arroces, carnes y postres de casa, con etiqueta de brunch. La ficha de Google le da 4,2 sobre 5 con 827 reseñas.`}
				image={comedor}
				imageAlt="Comedor de Soga bar con mesas de mantel blanco, banqueta de cuero y pared de madera iluminada"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,2</b> en Google · 827 reseñas' },
					{
						label: 'Horario',
						html: '<b>No publicado</b><br />La ficha no da horas: llama antes',
					},
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> mesa y consultas` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Soga bar" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Dos velocidades, <br /><em>una plaza.</em>"
				paragraphs={[
					'Soga bar ocupa el número 5 de la Plaza de la Provincia, en pleno centro de Ciudad Real. Google lo clasifica a la vez como restaurante, bar y bar de tapas, y le añade la etiqueta «Brunch»: en la misma carta conviven la tapa rápida y el plato de mantel.',
					'El comedor aparece en la foto del perfil: mesas vestidas de blanco, una banqueta de cuero corrida contra la pared, madera de cerezo con luces lineales encastradas y plantas colgando del techo. Es un espacio cuidado, más de restaurante que de barra de pie.',
					'En la mesa, las fotos enseñan un poco de todo: croquetas en plato de cerámica azul, jamón ibérico sobre patata, ensalada de gambas con láminas de pato y frutos rojos, otra de pollo escabechado con arándanos, tortellini de calabaza con rabo de toro, carne a la plancha con crema de calabaza y dos postres de tarta.',
					'Las reseñas rematan la lista: «Pedimos tomate escaldado, pimientos con bacalao y suprema de bacalao», «Tapas fantásticas, la cerveza excelente, y las raciones inmejorables» y «Trabajan muy bien las ensaladas, pastas y arroces». Con 827 opiniones, la media se queda en 4,2 sobre 5.',
				]}
				note="Los datos salen de la ficha pública de Google Maps y de las fotos y reseñas del perfil. La ficha no publica horario, carta ni precios: esta web no los inventa. Para horario y mesa, el teléfono es el 926 92 13 68."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el bar en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="De la tapa <br /><em>al postre.</em>"
				description="Los platos que aparecen aquí son los que enseñan las fotos del perfil y los que nombran las reseñas. La casa no tiene carta publicada en Google ni web propia."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="Esta página no publica precios porque no hay carta oficial que copiar. El menú del día, las raciones y los importes se preguntan en el 926 92 13 68 o en la mesa."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Diez fotos <br /><em>de la mesa.</em>"
				description="Las fotografías del perfil de Soga bar en Google Maps: el comedor, las ensaladas, la pasta con rabo de toro, las carnes, el jamón, las croquetas y los postres."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Nos vemos <br /><em>en la plaza.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Castilla-La Mancha, España']}
				hours={HOURS}
				hoursCaption="Horario y datos"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de Soga bar en la Plaza de la Provincia 5, Ciudad Real"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Soga bar"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. El bar no publica web propia ni sistema de reservas, así que el teléfono es el canal directo para preguntar horario, reservar mesa o consultar el menú del día."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Soga bar"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
