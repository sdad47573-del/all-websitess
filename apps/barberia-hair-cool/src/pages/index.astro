---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	photoUrl,
	phoneHrefs,
	structuredData,
} from '../lib/business';

const title = 'Barbería Hair Cool | Barbería en Teatinos, Málaga';
const description =
	'Barbería Hair Cool, barbería en Avenida Jorge Luis Borges, 19 (Teatinos), Málaga. Cortes modernos y clásicos, degradados, barba y cejas. Llama al 685 57 22 56.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#101820" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=JetBrains+Mono:wght@400;600&family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={photoUrl} />
		<meta property="og:image:alt" content="Fotografía de Barbería Hair Cool compartida en Google Maps" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={photoUrl} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Barbería Hair Cool, inicio"><span class="brand-mark" aria-hidden="true">HC</span><span class="brand-label">HAIR COOL <small>BARBERÍA · TEATINOS</small></span></a>
			<nav aria-label="Navegación principal"><a href="#servicios">Servicios</a><a href="#contacto">Contacto</a></nav>
			<a class="header-phone" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> {business.phones[0]}</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-content">
					<p class="eyebrow"><span></span> BARBERÍA · CORTES · BARBA</p>
					<h1 id="hero-title">Tu estilo<br /><em>empieza aquí.</em></h1>
					<p class="hero-intro">Barbería Hair Cool, en pleno Teatinos (Málaga). Cortes modernos y clásicos, degradados apurados, arreglo de barba y perfilado de cejas con trato cercano y atención personalizada.</p>
					<div class="hero-actions"><a class="button button-accent" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Llamar a la barbería</a><a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-location"><span class="location-rule" aria-hidden="true"></span><p>{business.district}<br /><strong>{business.city} · Andalucía</strong></p></div>
				</div>
				<figure class="hero-photo">
					<div class="photo-label"><span>HC / 01</span><span>BARBERÍA · MÁLAGA</span></div>
					<a href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Ver la foto de Barbería Hair Cool y su galería en Google Maps"><img src={photoUrl} alt="Fotografía de Barbería Hair Cool publicada en Google Maps" width="900" height="1200" fetchpriority="high" decoding="async" /><span class="photo-open" aria-hidden="true">↗</span></a>
					<figcaption><span>FOTO DE LA FICHA DE GOOGLE MAPS</span><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha ↗</a></figcaption>
					<span class="photo-stamp" aria-hidden="true">HC<br /><i>✦</i><br />MÁLAGA</span>
				</figure>
			</section>

			<section class="salon-strip" id="servicios" aria-label="Servicios de Barbería Hair Cool">
				<p class="strip-title"><span>01 /</span> LO QUE HACEMOS</p>
				<div><span>01</span><strong>Corte y degradado</strong></div>
				<div><span>02</span><strong>Arreglo de barba</strong></div>
				<div><span>03</span><strong>Perfilado de cejas</strong></div>
				<div><span>04</span><strong>Corte infantil</strong></div>
			</section>

			<section class="about-section" aria-labelledby="about-title">
				<p class="section-label"><span>02 /</span> HAIR COOL · TEATINOS</p>
				<div class="about-content"><h2 id="about-title">Precisión<br /><em>y buen rollo.</em></h2><div><p>Un equipo de barberos apasionados por su trabajo, con años de experiencia en cortes modernos, clásicos y arreglos de barba. Nos formamos cada día para dominar las últimas tendencias sin perder las técnicas de siempre. Ambiente relajado y atención personalizada en el corazón de Teatinos.</p><a class="social-link" href={instagramUrl} target="_blank" rel="noreferrer">Síguenos en Instagram <span aria-hidden="true">↗</span></a></div></div>
				<div class="about-footer"><span>CORTES · BARBA · CEJAS</span><span>TEATINOS · MÁLAGA</span><span>✦</span></div>
			</section>

			<section class="contact-section" id="contacto" aria-labelledby="contact-title">
				<p class="section-label"><span>03 /</span> VISÍTANOS</p>
				<div class="contact-layout">
					<div class="contact-copy"><p class="contact-kicker">ESTAMOS EN TEATINOS</p><h2 id="contact-title">Reserva tu<br /><em>corte.</em></h2>
						<div class="contact-card">
							<div class="contact-row"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div></div>
							<div class="contact-row"><span aria-hidden="true">☎</span><div><small>LLÁMANOS</small><a href={phoneHrefs[0]}>{business.phones[0]}</a></div></div>
						</div>
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-card"><div class="map-header"><span><i></i> JORGE LUIS BORGES · MÁLAGA</span><a href={mapsUrl} target="_blank" rel="noreferrer">ABRIR MAPS ↗</a></div><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Barbería Hair Cool en Avenida Jorge Luis Borges, Málaga" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div><div class="map-footer"><span aria-hidden="true">⌖</span><div><strong>{business.name}</strong><small>{business.streetAddress} · {business.city}</small></div><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar a Barbería Hair Cool">↗</a></div></div>
				</div>
				<div class="social-row"><span>ENCUÉNTRANOS TAMBIÉN EN</span><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a><a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a></div>
			</section>
			<Galeria nombre="Barbería Hair Cool" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer"><a class="brand footer-brand" href="#inicio" aria-label="Barbería Hair Cool, volver al inicio"><span class="brand-mark">HC</span><span class="brand-label">HAIR COOL <small>BARBERÍA · TEATINOS</small></span></a><p>{business.streetAddress}, {business.city}<br /><a href={phoneHrefs[0]}>{business.phones[0]}</a></p><a class="footer-social" href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a><small>© {new Date().getFullYear()} Barbería Hair Cool · Málaga</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
</footer>
		<a class="phone-cta" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Llamar a Hair Cool <strong>{business.phones[0]}</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						<WhatsappFab phone={datos.phoneHrefs[0]} name={datos.business?.name} />
						</body>
</html>


