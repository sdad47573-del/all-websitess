---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import vitrina from '../assets/fotos/panaderia-pasteleria-fortes-apaisada-01.jpg';
import torrijas from '../assets/fotos/panaderia-pasteleria-fortes-panoramica-07.jpg';
import tartasFruta from '../assets/fotos/panaderia-pasteleria-fortes-apaisada-03.jpg';
import surtidoChocolate from '../assets/fotos/panaderia-pasteleria-fortes-apaisada-05.jpg';
import tartaManzana from '../assets/fotos/panaderia-pasteleria-fortes-apaisada-08.jpg';
import tartaDavid from '../assets/fotos/panaderia-pasteleria-fortes-cuadrada-04.jpg';
import tartaInfantil from '../assets/fotos/panaderia-pasteleria-fortes-vertical-02.jpg';
import tartaNata from '../assets/fotos/panaderia-pasteleria-fortes-vertical-06.jpg';
import surtidoDulces from '../assets/fotos/panaderia-pasteleria-fortes-vertical-09.jpg';
import tartaFresas from '../assets/fotos/panaderia-pasteleria-fortes-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'Fortes · Panadería y pastelería en Málaga';
const description =
	'Fortes, panadería y pastelería en la calle Pintor Berrobianco Menéndez (Carretera de Cádiz, 29006 Málaga). Tres generaciones de pan, tartas y dulces artesanos. Teléfono 952 34 45 20.';

const galeria = [
	{
		src: torrijas,
		alt: 'Bandejas de torrijas con el cartel de la bandeja en el escaparate',
	},
	{
		src: tartaFresas,
		alt: 'Tarta de fresas y moras cubierta de almíbar sobre un plato',
	},
	{
		src: tartaDavid,
		alt: 'Tarta de cumpleaños con un corazón rojo y el nombre David escrito en nata',
	},
	{
		src: surtidoChocolate,
		alt: 'Bandejas de pasteles de chocolate, napolitanas y frutos secos en el obrador',
	},
	{
		src: tartaInfantil,
		alt: 'Tarta de cumpleaños decorada con una figura azul de dibujos animados',
	},
	{
		src: tartaManzana,
		alt: 'Tarta de manzana con las láminas en espiral y mermelada en el centro',
	},
	{
		src: tartaNata,
		alt: 'Tarta de nata con los laterales de chocolate y el centro hundido',
	},
	{
		src: surtidoDulces,
		alt: 'Surtido de pasteles de nata, chocolate y colores en una bandeja',
	},
	{
		src: tartasFruta,
		alt: 'Tartas de nata, chocolate y fruta alineadas en la vitrina',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#fortes`,
	name: BUSINESS.fullName,
	alternateName: ['Fortes', 'Panadería Fortes Málaga', 'Pastelería Fortes'],
	description:
		'Panadería y pastelería de tres generaciones en la calle Pintor Berrobianco Menéndez (Carretera de Cádiz, 29006 Málaga). Pan, tartas y dulces artesanos.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 952 34 45 20',
	currenciesAccepted: 'EUR',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	/* La ficha publica la calle, pero no el número: no se declara uno. */
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '17:00',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '07:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '07:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '17:00',
			closes: '20:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'El escaparate', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"panaderia-pasteleria-fortes-apaisada-01.jpg": vitrina,
	"panaderia-pasteleria-fortes-panoramica-07.jpg": torrijas,
	"panaderia-pasteleria-fortes-vertical-10.jpg": tartaFresas,
	"panaderia-pasteleria-fortes-cuadrada-04.jpg": tartaDavid,
	"panaderia-pasteleria-fortes-apaisada-05.jpg": surtidoChocolate,
	"panaderia-pasteleria-fortes-vertical-02.jpg": tartaInfantil,
	"panaderia-pasteleria-fortes-apaisada-08.jpg": tartaManzana,
	"panaderia-pasteleria-fortes-vertical-06.jpg": tartaNata,
	"panaderia-pasteleria-fortes-vertical-09.jpg": surtidoDulces,
	"panaderia-pasteleria-fortes-apaisada-03.jpg": tartasFruta,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2c1a15" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Mulish:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Fortes panadería Málaga, pastelería Carretera de Cádiz, pan artesanal Málaga, tartas Málaga, dulces 29006, panadería Pintor Berrobianco Menéndez"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Tres generaciones de pan, tartas y dulces artesanos en la calle Pintor Berrobianco Menéndez, en Carretera de Cádiz (Málaga). Abre todos los días."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Vitrina con bollos, pan y pasteles de la panadería Fortes, en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#2c1a15"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Fortes"
			subtitle="Panadería · Pastelería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos y fotografías de la ficha pública de Google Maps. Sin carta ni precios publicados por el establecimiento."
			ctaLabel="Llamar a Fortes"
			navAriaLabel="Enlaces de la panadería y pastelería Fortes"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
