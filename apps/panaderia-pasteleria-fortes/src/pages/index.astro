---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import vitrina from '../assets/fotos/panaderia-pasteleria-fortes-apaisada-01.jpg';
import torrijas from '../assets/fotos/panaderia-pasteleria-fortes-panoramica-07.jpg';
import tartasFruta from '../assets/fotos/panaderia-pasteleria-fortes-apaisada-03.jpg';
import surtidoChocolate from '../assets/fotos/panaderia-pasteleria-fortes-apaisada-05.jpg';
import tartaManzana from '../assets/fotos/panaderia-pasteleria-fortes-apaisada-08.jpg';
import tartaDavid from '../assets/fotos/panaderia-pasteleria-fortes-cuadrada-04.jpg';
import tartaInfantil from '../assets/fotos/panaderia-pasteleria-fortes-vertical-02.jpg';
import tartaNata from '../assets/fotos/panaderia-pasteleria-fortes-vertical-06.jpg';
import surtidoDulces from '../assets/fotos/panaderia-pasteleria-fortes-vertical-09.jpg';
import tartaFresas from '../assets/fotos/panaderia-pasteleria-fortes-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const title = 'Fortes · Panadería y pastelería en Málaga';
const description =
	'Fortes, panadería y pastelería en la calle Pintor Berrobianco Menéndez (Carretera de Cádiz, 29006 Málaga). Tres generaciones de pan, tartas y dulces artesanos. Teléfono 952 34 45 20.';

const galeria = [
	{
		src: torrijas,
		alt: 'Bandejas de torrijas con el cartel de la bandeja en el escaparate',
	},
	{
		src: tartaFresas,
		alt: 'Tarta de fresas y moras cubierta de almíbar sobre un plato',
	},
	{
		src: tartaDavid,
		alt: 'Tarta de cumpleaños con un corazón rojo y el nombre David escrito en nata',
	},
	{
		src: surtidoChocolate,
		alt: 'Bandejas de pasteles de chocolate, napolitanas y frutos secos en el obrador',
	},
	{
		src: tartaInfantil,
		alt: 'Tarta de cumpleaños decorada con una figura azul de dibujos animados',
	},
	{
		src: tartaManzana,
		alt: 'Tarta de manzana con las láminas en espiral y mermelada en el centro',
	},
	{
		src: tartaNata,
		alt: 'Tarta de nata con los laterales de chocolate y el centro hundido',
	},
	{
		src: surtidoDulces,
		alt: 'Surtido de pasteles de nata, chocolate y colores en una bandeja',
	},
	{
		src: tartasFruta,
		alt: 'Tartas de nata, chocolate y fruta alineadas en la vitrina',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#fortes`,
	name: BUSINESS.fullName,
	alternateName: ['Fortes', 'Panadería Fortes Málaga', 'Pastelería Fortes'],
	description:
		'Panadería y pastelería de tres generaciones en la calle Pintor Berrobianco Menéndez (Carretera de Cádiz, 29006 Málaga). Pan, tartas y dulces artesanos.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 952 34 45 20',
	currenciesAccepted: 'EUR',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	/* La ficha publica la calle, pero no el número: no se declara uno. */
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '17:00',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '07:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '07:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '17:00',
			closes: '20:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'El escaparate', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2c1a15" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Mulish:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Fortes panadería Málaga, pastelería Carretera de Cádiz, pan artesanal Málaga, tartas Málaga, dulces 29006, panadería Pintor Berrobianco Menéndez"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Tres generaciones de pan, tartas y dulces artesanos en la calle Pintor Berrobianco Menéndez, en Carretera de Cádiz (Málaga). Abre todos los días."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Vitrina con bollos, pan y pasteles de la panadería Fortes, en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#2c1a15"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Fortes"
			subtitle="Panadería · Pastelería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<div class="band band-cream">
				<LocalHero
					eyebrow="C. Pintor Berrobianco Menéndez · Carretera de Cádiz"
					title="Tres generaciones <br /><em>de pan y dulces.</em>"
					lede={`Fortes es la panadería y pastelería de la calle Pintor Berrobianco Menéndez, en Carretera de Cádiz. Tres generaciones haciendo pan, tartas y dulces artesanos, con una despensa de gran variedad de alimentos. Tiene ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
					image={vitrina}
					imageAlt="Vitrina de la pastelería con bandejas de bollos, pan y pasteles"
					primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
					facts={[
						{ label: 'Nota', html: '<b>4,5</b> en Google · 34 reseñas' },
						{
							label: 'Horario',
							html: '<b>7:00–15:00</b> y 17:00–21:00, de lunes a viernes',
						},
						{ label: 'Barrio', html: '<b>Carretera de Cádiz</b>, Málaga' },
					]}
					galleryHref={MAPS.place}
					photoCredit="Foto del perfil de Google Maps"
					galleryLinkLabel="Ver la galería"
					tag="Abierta también los domingos"
				/>

				<LocalChips label="Lo que ofrece la panadería y pastelería Fortes" items={SERVICIOS} />
			</div>

			<div class="band band-cocoa">
				<LocalAbout
					label="La casa"
					title="Un obrador <br /><em>de tres generaciones.</em>"
					paragraphs={[
						'Fortes está en la calle del Pintor Berrobianco Menéndez, en la zona de Carretera de Cádiz. Google la clasifica como panadería y pastelería, y el propio establecimiento se presenta en su ficha como «gran panadería y pastelería, con muchos años de experiencia, tres generaciones».',
						'Su descripción insiste en lo artesanal: «todo artesanal, prueben nuestro pan, dulces y gran variedad de alimentos». Las fotos del perfil enseñan la vitrina, los surtidos de pastelería, la tarta de manzana, la de fresas y tartas de cumpleaños con el nombre escrito en nata.',
						'Abre todos los días: de lunes a viernes y el domingo en dos tramos, y el sábado solo por la mañana. La ficha indica acceso para sillas de ruedas, pero no aparcamiento adaptado. El teléfono es el 952 34 45 20.',
						'Esta página no publica carta ni precios: la ficha de Google no los recoge. Lo que se cuenta aquí sale de la ficha pública del establecimiento y de las fotografías de su perfil.',
					]}
					note="4,5 sobre 5 con 34 reseñas en Google. Una de ellas: «Muy buenos dulces y económica»."
					links={[
						{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
						{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					]}
				/>
			</div>

			<div class="band band-cream">
				<LocalMenu
					eyebrow="El mostrador"
					title="Pan, tartas <br /><em>y dulces.</em>"
					description="La ficha no publica carta ni precios. Estas familias son las que citan la descripción del establecimiento, las reseñas y las fotos del perfil."
					cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					groups={MENU}
					note="Sin precios publicados: la panadería no tiene web ni carta online en su ficha. Para saber qué hay cada día —y a qué precio—, lo mejor es llamar al 952 34 45 20 o pasarse por el mostrador."
				/>
			</div>

			<div class="band band-rose">
				<LocalGallery
					eyebrow="Fotos del perfil de Google Maps"
					title="El escaparate <br /><em>y las tartas.</em>"
					description="Nueve fotografías del perfil de Fortes: el escaparate de torrijas, los surtidos de pastelería, las tartas de fruta y las de cumpleaños. La décima es la vitrina que abre esta página."
					images={galeria}
					cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
					note="Imágenes alojadas en esta página y procedentes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
				/>
			</div>

			<div class="band band-cream">
				<LocalVisit
					eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
					title="En Carretera <br /><em>de Cádiz.</em>"
					addressLines={[
						BUSINESS.street,
						BUSINESS.district,
						`${BUSINESS.postalCode} ${BUSINESS.city}`,
					]}
					hours={HOURS}
					hoursCaption="Horario"
					hoursNote="Horario publicado en la ficha de Google. La ficha no publica el número de la calle, así que el mapa de al lado es la referencia buena. En festivos el horario puede cambiar: la propia ficha ya avisa de ello para el 1 de noviembre."
					mapTitle="Mapa de la panadería y pastelería Fortes en Carretera de Cádiz, Málaga"
					mapEmbedUrl={MAPS.embed}
					mapLabel="Fortes · Carretera de Cádiz"
					mapHref={MAPS.place}
					links={[
						{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref, variant: 'primary' },
						{ label: 'Cómo llegar', href: MAPS.directions, external: true },
						{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					]}
					contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					reserveNote="No hay web propia ni pedidos online: se atiende en el mostrador y por teléfono. Acceso para sillas de ruedas; la ficha no indica aparcamiento adaptado."
				/>
			</div>

			<div class="band band-sand">
				<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
			</div>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos y fotografías de la ficha pública de Google Maps. Sin carta ni precios publicados por el establecimiento."
			ctaLabel="Llamar a Fortes"
			navAriaLabel="Enlaces de la panadería y pastelería Fortes"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
