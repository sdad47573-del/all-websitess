---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/panaderia-sultana-marroqui-cuadrada-04.jpg';
import interior from '../assets/fotos/panaderia-sultana-marroqui-vertical-01.jpg';
import dulcesEspiral from '../assets/fotos/panaderia-sultana-marroqui-cuadrada-06.jpg';
import mediaLuna from '../assets/fotos/panaderia-sultana-marroqui-cuadrada-09.jpg';
import almendra from '../assets/fotos/panaderia-sultana-marroqui-vertical-02.jpg';
import pistacho from '../assets/fotos/panaderia-sultana-marroqui-vertical-05.jpg';
import tartaletas from '../assets/fotos/panaderia-sultana-marroqui-vertical-08.jpg';
import galletas from '../assets/fotos/panaderia-sultana-marroqui-vertical-10.jpg';
import marmolado from '../assets/fotos/panaderia-sultana-marroqui-panoramica-03.jpg';
import tartaChocolate from '../assets/fotos/panaderia-sultana-marroqui-panoramica-07.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'Sultana Marroquí · Panadería en Málaga';
const description =
	'Panadería Sultana Marroquí, en la calle Bocanegra, 2, local A2 (Carretera de Cádiz, 29003 Málaga). Pan árabe, pastelas, cuscús y dulces marroquíes artesanales. Abre todos los días de 10:00 a 22:00.';

const galeria = [
	{
		src: dulcesEspiral,
		alt: 'Bandeja de dulces en espiral con sésamo envuelta en plástico',
	},
	{
		src: pistacho,
		alt: 'Pasteles de almendra en forma de media luna con pistacho apilados',
	},
	{
		src: marmolado,
		alt: 'Tarta marmoleada de chocolate y vainilla cortada en porciones',
	},
	{
		src: mediaLuna,
		alt: 'Bandeja de pasteles de almendra recién hechos en el obrador',
	},
	{
		src: tartaletas,
		alt: 'Surtido de pastelitos y tartaletas pequeñas en una bandeja',
	},
	{
		src: tartaChocolate,
		alt: 'Tarta de chocolate con nata y fruta en el escaparate',
	},
	{
		src: galletas,
		alt: 'Galletas redondas con azúcar glas recién horneadas',
	},
	{
		src: almendra,
		alt: 'Detalle de pasteles de almendra con chocolate y frutos secos',
	},
	{
		src: interior,
		alt: 'Interior de la tienda con las estanterías de productos y la vitrina',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#sultana`,
	name: BUSINESS.name,
	alternateName: ['Sultana Marroquí', 'Panadería Sultana', 'Panadería árabe Sultana'],
	description:
		'Panadería marroquí en la calle Bocanegra, 2, local A2 (Carretera de Cádiz, 29003 Málaga). Pan árabe recién hecho, pastelas, cuscús y dulces marroquíes artesanales.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 633 52 21 03',
	currenciesAccepted: 'EUR',
	servesCuisine: 'Marroquí',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:00',
			closes: '22:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Dulces', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"panaderia-sultana-marroqui-cuadrada-04.jpg": fachada,
	"panaderia-sultana-marroqui-cuadrada-06.jpg": dulcesEspiral,
	"panaderia-sultana-marroqui-vertical-05.jpg": pistacho,
	"panaderia-sultana-marroqui-panoramica-03.jpg": marmolado,
	"panaderia-sultana-marroqui-cuadrada-09.jpg": mediaLuna,
	"panaderia-sultana-marroqui-vertical-08.jpg": tartaletas,
	"panaderia-sultana-marroqui-panoramica-07.jpg": tartaChocolate,
	"panaderia-sultana-marroqui-vertical-10.jpg": galletas,
	"panaderia-sultana-marroqui-vertical-02.jpg": almendra,
	"panaderia-sultana-marroqui-vertical-01.jpg": interior,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0d3f3c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Sultana Marroquí, panadería árabe Málaga, pan árabe Carretera de Cádiz, pastelas Málaga, cuscús marroquí 29003, dulces marroquíes Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan árabe recién hecho, pastelas, cuscús y dulces marroquíes artesanales en la calle Bocanegra, 2, en Carretera de Cádiz (Málaga). Todos los días de 10:00 a 22:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de la Panadería Sultana Marroquí en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#0d3f3c"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Sultana Marroquí"
			subtitle="Panadería · Carretera de Cádiz"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos y fotografías de la ficha pública de Google Maps. Sin carta ni precios publicados por el establecimiento."
			ctaLabel="Llamar a Sultana Marroquí"
			navAriaLabel="Enlaces de la Panadería Sultana Marroquí"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
