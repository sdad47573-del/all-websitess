---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	accesibilidad,
	business,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	hoursSummary,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	reviews,
	reviewsUrl,
	site,
} from '../data/site';

// Las fotos descargadas de la ficha viven en `src/assets/fotos`: se resuelven aquí para servirlas
// con `<Image>` (AVIF, srcset y lazy) en vez de copiarlas a `public`.
const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

/**
 * Galería completa: las diez fotografías de la ficha, en el orden en que las devolvió la
 * descarga. La primera es apaisada y ocupa dos columnas; el resto se recorta en vertical.
 */
const galeria = Object.keys(fotos)
	.sort((a, b) => a.localeCompare(b))
	.map((path) => ({ name: path.split('/').pop() as string, src: foto(path.split('/').pop() as string) }));

const title = 'Colom Restaurant · Cocina mediterránea en Barcelona';
const description =
	'Colom Restaurant, restaurante mediterráneo y marisquería en el Carrer dels Escudellers, 33, Ciutat Vella (Barcelona). 4,7 sobre 5 con 37.554 reseñas en Google.';

/**
 * Texto alternativo de las fotos.
 *
 * La ficha no describe el contenido de estas diez fotografías, así que no se inventa una
 * descripción y todos los `alt` avisan solo de dónde salen.
 */
const altFoto = 'Fotografía publicada en la ficha de Google Maps de Colom Restaurant, en Barcelona';
const altOg = 'Fotografía de Colom Restaurant publicada en su ficha de Google Maps';

const textoResenas = `${business.reviewCount.toLocaleString('es-ES')} reseñas`;
const nota = business.rating.toLocaleString('es-ES');
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0e3134" />
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="Colom Restaurant, restaurante Barcelona, marisquería Ciutat Vella, tapas Barcelona, Carrer dels Escudellers"
		/>
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CT" />
		<meta name="geo.placename" content={business.city} />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${site.siteUrl}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site.siteUrl}/`} />
		<meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altOg} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.province} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
		<meta name="twitter:image:alt" content={altOg} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">C</span>
				<span class="brand-text">
					Colom Restaurant
					<small>Ciutat Vella · Barcelona</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#resenas">Reseñas</a>
				<a href="#fotos">Fotos</a>
				<a href="#horario">Horario</a>
				<a href="#preguntas">Preguntas</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>
				<span aria-hidden="true">☎</span>
				{business.phoneDisplay}
			</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">Ciutat Vella · Barcelona</p>
						<h1 id="hero-title">
							Colom Restaurant,
							<em>mar y mesa,<br />en Barcelona.</em>
						</h1>
						<p class="hero-lede">
							Restaurante mediterráneo, marisquería y especialista en tapas en el Carrer dels
							Escudellers, 33, en el distrito de Ciutat Vella. Google le da <strong>{nota} sobre 5</strong>
							con {textoResenas} y lo resume como «{business.tagline}». Abre
							<strong>todos los días de 12:30 a 24:00</strong>.
						</p>
						<div class="hero-actions">
							<a class="btn btn-solid" href={phoneHref}>
								Llamar al {business.phoneDisplay}
							</a>
							<a
								class="btn btn-ghost"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<small>Dirección</small>
								<strong>
									{business.streetAddress} · {business.postalCode}
									{business.city}
								</strong>
							</li>
							<li>
								<small>Horario</small>
								<strong>{hoursSummary}</strong>
							</li>
							<li>
								<small>Valoración</small>
								<strong>
									{nota} sobre 5 con {textoResenas}
								</strong>
							</li>
						</ul>
					</div>

					<div class="hero-collage">
						<figure class="collage-item collage-item-a">
							<Image
								src={foto('colom-restaurant-vertical-03.jpg')}
								alt={altFoto}
								widths={[420, 620, 820]}
								sizes="(max-width: 1080px) 55vw, 26vw"
								format="avif"
								quality={68}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</figure>
						<figure class="collage-item collage-item-b">
							<Image
								src={foto('colom-restaurant-apaisada-02.jpg')}
								alt={altFoto}
								widths={[320, 480, 640]}
								sizes="(max-width: 1080px) 38vw, 18vw"
								format="avif"
								quality={68}
								loading="eager"
								decoding="async"
							/>
						</figure>
						<div class="hero-stamp">
							<strong>{nota}</strong>
							<span class="stars" aria-hidden="true">★★★★★</span>
							<small>{textoResenas} en Google Maps</small>
						</div>
					</div>
				</div>
			</section>

			<div class="band" aria-label="Datos rápidos de Colom Restaurant">
				<span>{nota} sobre 5 · {textoResenas}</span>
				<span>{business.streetAddress} · {business.postalCode} {business.city}</span>
				<span>{hoursSummary}</span>
				<span>Teléfono {business.phoneDisplay}</span>
			</div>

			<section class="section casa" id="casa" aria-labelledby="casa-title">
				<div class="wrap casa-grid">
					<div class="casa-text">
						<p class="kicker">La casa</p>
						<h2 class="title" id="casa-title">
							Un restaurante sencillo,
							<br />
							<em>de cocina tradicional.</em>
						</h2>
						<p class="lead">
							Así lo resume Google en su ficha. La clasificación publicada reúne cuatro
							etiquetas: restaurante mediterráneo, marisquería, restaurante de cocina española
							y restaurante especializado en tapas.
						</p>
						<p>
							El local está en el <strong>Carrer dels Escudellers, 33</strong>, con código postal
							08002, en el distrito de Ciutat Vella, Barcelona. La ficha publica el plus code
							95HG+WJ Barcelona y las coordenadas 41.3798528, 2.1765.
						</p>
						<p>
							En accesibilidad, la ficha señala acceso, aseo y asientos adaptados para sillas de
							ruedas; el aparcamiento adaptado figura como no disponible. Son los cuatro datos
							que publica y aquí se reproducen tal cual.
						</p>
						<p>
							La ficha no incluye descripción del titular, carta, precios ni web propia, así que
							esta web no los reproduce. Solo reúne lo que el propio local publica en Google
							Maps, consultada el {site.consultado}, y sus fotografías.
						</p>
						<a class="casa-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">
							Ver la ficha completa en Google Maps ↗
						</a>
					</div>

					<aside class="ficha" aria-label="Resumen de la ficha de Google Maps">
						<div class="ficha-head">
							<strong>La ficha</strong>
							<span>Google Maps</span>
						</div>
						<div class="ficha-score">
							<b>{nota}</b>
							<span>
								<span class="stars" aria-hidden="true">★★★★★</span>
								{textoResenas} en Google Maps
							</span>
						</div>
						<dl class="ficha-rows">
							<div>
								<dt>Dirección</dt>
								<dd>{business.streetAddress}, {business.postalCode} {business.city}</dd>
							</div>
							<div>
								<dt>Barrio</dt>
								<dd>{business.district}, {business.city}</dd>
							</div>
							<div>
								<dt>Horario</dt>
								<dd>{hoursSummary}</dd>
							</div>
							<div>
								<dt>Teléfono</dt>
								<dd>{business.phoneDisplay}</dd>
							</div>
							<div>
								<dt>Plus code</dt>
								<dd>{business.plusCode}</dd>
							</div>
						</dl>
						<ul class="tags" aria-label="Categorías publicadas por Google">
							{business.categories.map((categoria) => <li>{categoria}</li>)}
						</ul>
					</aside>
				</div>
			</section>

			<section class="section quotes" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<div class="quotes-head">
						<div>
							<p class="kicker">Lo que dicen</p>
							<h2 class="title" id="resenas-title">
								Tres reseñas,
								<br />
								<em>tal como están escritas.</em>
							</h2>
						</div>
						<div class="quotes-rating">
							<b>{nota}</b>
							<div>
								<span class="stars" aria-hidden="true">★★★★★</span>
								{textoResenas} en Google Maps
								<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
									Ver todas ↗
								</a>
							</div>
						</div>
					</div>
					<div class="quote-grid">
						{reviews.map((review) => (
							<blockquote class="quote">
								<p>{review.text}</p>
								<footer>
									<strong>{review.rating} / 5</strong>
									<span>{review.source}</span>
								</footer>
							</blockquote>
						))}
					</div>
					<p class="quotes-note">
						Textos literales de tres de las reseñas que destaca la ficha. Google no muestra el
						nombre de quienes las firman en esta vista, así que se atribuyen a la ficha y no se
						inventa ninguna autoría.
					</p>
				</div>
			</section>

			<section class="section" id="fotos" aria-labelledby="fotos-title">
				<div class="wrap">
					<p class="kicker">Las fotos</p>
					<h2 class="title" id="fotos-title">
						El local <em>en diez imágenes.</em>
					</h2>
					<p class="lead">
						Son las diez fotografías que Colom Restaurant publica en su ficha de Google Maps.
						El manifiesto de la descarga no atribuye ninguna a un autor con nombre, así que se
						publican sin pie y sin atribución. La ficha no describe su contenido y aquí no se
						inventa ninguna descripción.
					</p>
					<div class="fotos-grid">
						{galeria.map((item, index) => (
							<figure class:list={['foto', { 'foto-wide': index === 0 }]}>
								<Image
									src={item.src}
									alt={altFoto}
									widths={index === 0 ? [620, 900, 1200] : [360, 540, 760]}
									sizes={
										index === 0
											? '(max-width: 700px) 92vw, (max-width: 1080px) 62vw, 58vw'
											: '(max-width: 700px) 45vw, (max-width: 1080px) 30vw, 28vw'
									}
									format="avif"
									quality={68}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>{String(index + 1).padStart(2, '0')}</figcaption>
							</figure>
						))}
					</div>
					<p class="fotos-note">
						La ficha no publica carta ni precios, así que esta web no los reproduce. Para saber
						qué hay hoy, lo más rápido es{' '}
						<a href={phoneHref}>llamar al {business.phoneDisplay}</a> o mirar las fotos y
						reseñas de la{' '}
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							ficha en Google Maps ↗
						</a>
					</p>
				</div>
			</section>

			<section class="section visita" id="horario" aria-labelledby="horario-title">
				<div class="wrap visita-grid">
					<div>
						<p class="kicker">Horario y ubicación</p>
						<h2 class="title" id="horario-title">
							Carrer dels Escudellers,
							<br />
							<em>33, 08002 Barcelona.</em>
						</h2>
						<address>
							{business.streetAddress}
							<br />
							{business.postalCode} {business.city}
							<br />
							{business.district} · {business.province}
						</address>

						<table class="hours-table">
							<caption>Horario publicado en la ficha de Google Maps</caption>
							<tbody>
								{hours.map((item) => (
									<tr>
										<th scope="row">{item.day}</th>
										<td>{item.service}</td>
									</tr>
								))}
							</tbody>
						</table>
						<p class="hours-note">
							La ficha publica un horario continuo de <strong>12:30 a 24:00 todos los días</strong>.
							Es el horario de la ficha consultada el {site.consultado}; conviene confirmarlo por
							teléfono antes de ir.
						</p>

						<ul class="access-list" aria-label="Accesibilidad publicada en la ficha">
							{accesibilidad.map((item) => (
								<li class:list={[{ 'is-no': !item.disponible }]}>{item.label}</li>
							))}
						</ul>

						<a class="contact-line" href={phoneHref}>
							<small>Teléfono</small>
							<strong>{business.phoneDisplay}</strong>
						</a>

						<div class="place-actions">
							<a
								class="btn btn-solid"
								href={directionsUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Abrir indicaciones <span aria-hidden="true">↗</span>
							</a>
							<a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
								Ver la ficha en Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>

					<div class="map-card">
						<div class="map-frame">
							<iframe
								title={`Mapa de ${business.name} en ${business.city}`}
								src={mapEmbedUrl}
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
								allowfullscreen></iframe>
						</div>
						<div class="map-tag">
							<div>
								<strong>{business.shortName}</strong>
								<small>
									{business.streetAddress} · {business.postalCode} {business.city}
								</small>
							</div>
							<a href={directionsUrl} target="_blank" rel="noopener noreferrer">
								Cómo llegar ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<div class="wrap">
					<p class="kicker">Preguntas frecuentes</p>
					<h2 class="title" id="faq-title">
						Antes de <em>venir.</em>
					</h2>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<a class="footer-brand" href="#inicio" aria-label={`${business.name}, volver al inicio`}>
					<span class="brand-mark" aria-hidden="true">C</span>
					<span>
						Colom Restaurant
						<small>{business.streetAddress} · {business.postalCode} {business.city}</small>
					</span>
				</a>
				<nav class="footer-nav" aria-label="Contacto y ficha del local">
					<a href={phoneHref}>Llamar al {business.phoneDisplay}</a>
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ficha en Google Maps ↗
					</a>
					<a href={reviewsUrl} target="_blank" rel="noopener noreferrer">
						Reseñas en Google Maps ↗
					</a>
				</nav>
				<small class="footer-note">
					© {new Date().getFullYear()} Colom Restaurant · {business.streetAddress} ({business.postalCode}
					{business.city}). Web informativa elaborada con los datos, las etiquetas y las fotografías
					que el local publica en su ficha de Google Maps, consultada el {site.consultado}. Confirma
					horario y disponibilidad por teléfono antes de salir.
				</small>
			</div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>
			Llamar a Colom <span>{business.phoneDisplay}</span>
		</a>

		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
