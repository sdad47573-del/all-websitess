---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import { Image } from 'astro:assets';
import heroFoto from '../assets/fotos/le-barbiere-teatinos-apaisada-03.jpg';
import Galeria from '../components/Galeria.astro';
import {
	bookingUrl,
	business,
	directionsUrl,
	horario,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	reviewsUrl,
	structuredData,
} from '../lib/business';

const title = 'LE BARBIERE TEATINOS | Peluquería y barbería en Teatinos, Málaga';
const description =
	'PELUQUERÍA LE BARBIERE TEATINOS, en C. Hermes, 5 (Teatinos, Málaga). 4,8 sobre 5 con 221 reseñas; corte, barba y cuidado masculino. Reserva en Booksy o llama al 640 17 50 44.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#171714" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Oswald:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.jpg`} />
		<meta property="og:image:alt" content="Fotografía de LE BARBIERE TEATINOS compartida en Google Maps" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.jpg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.placename" content="Málaga" />
			<meta name="geo.position" content="36.7218951;-4.475792" />
			<meta name="ICBM" content="36.7218951, -4.475792" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="LE BARBIERE TEATINOS, inicio">
				<span class="brand-mark" aria-hidden="true">LB<span>✳</span></span>
				<span class="brand-name">LE BARBIERE <small>PELUQUERÍA · TEATINOS</small></span>
			</a>
			<nav aria-label="Navegación principal"><a href="#barberia">La barbería</a><a href="#ubicacion">Encuéntranos</a></nav>
			<a class="header-call" href={phoneHref}><span aria-hidden="true">☎</span> {business.phone}</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> PELUQUERÍA · BARBERÍA · TEATINOS</p>
					<h1 id="hero-title">ESTILO<br />CON <em>CARÁCTER.</em></h1>
					<p class="hero-description">LE BARBIERE TEATINOS, en C. Hermes, 5. Corte, barba y cuidado masculino con 4,8 sobre 5 y 221 reseñas en Google. Reserva online en Booksy o llama y pide tu cita.</p>
					<div class="hero-actions"><a class="button button-gold" href={bookingUrl} target="_blank" rel="noreferrer">Reservar en Booksy <span aria-hidden="true">↗</span></a><a class="button button-line" href={phoneHref}><span aria-hidden="true">☎</span> Llamar ahora</a></div>
					<div class="hero-address"><span class="address-icon" aria-hidden="true">⌖</span><p>{business.streetAddress}<br /><strong>{business.postalCode} · {business.city}</strong></p></div>
				</div>

				<figure class="hero-image">
					<div class="image-label"><span>LB / 01</span><span>LE BARBIERE TEATINOS</span></div>
					<a href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Abrir la fotografía y galería de LE BARBIERE TEATINOS en Google Maps">
						<Image src={heroFoto} alt="Fotografía de LE BARBIERE TEATINOS publicada en Google Maps" width={1200} height={900} fetchpriority="high" decoding="async" />
						<span class="image-open" aria-hidden="true">↗</span>
					</a>
					<figcaption><span>IMAGEN DE LA FICHA DE GOOGLE MAPS</span><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha ↗</a></figcaption>
					<div class="image-seal" aria-hidden="true">GOOD<br />CUTS<br /><b>✳</b></div>
				</figure>
				<span class="hero-mark" aria-hidden="true">✳</span>
			</section>

			<section class="barber-section" id="barberia" aria-labelledby="barber-title">
				<div class="section-index"><span>01</span> PELUQUERÍA Y BARBERÍA EN TEATINOS</div>
				<div class="barber-content">
					<h2 id="barber-title">Tu peluquería<br /><em>en Málaga.</em></h2>
					<div class="barber-text"><p>En LE BARBIERE TEATINOS el estilo empieza con una buena conversación. Acércate al local de C. Hermes y descubre corte de pelo, arreglo de barba y trato cercano, con reserva online en Booksy.</p><div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:12px;"><a href={bookingUrl} target="_blank" rel="noreferrer" class="text-link">Reservar en Booksy <span aria-hidden="true">↗</span></a><a href={reviewsUrl} target="_blank" rel="noreferrer" class="text-link">221 reseñas · 4,8/5 <span aria-hidden="true">↗</span></a><a href={instagramUrl} target="_blank" rel="noreferrer" class="text-link">@lebarbiere_teatinos <span aria-hidden="true">↗</span></a></div></div>
				</div>
				<div class="barber-details"><span>LE BARBIERE TEATINOS</span><span>HERMES 5 · MÁLAGA</span><span>✳</span></div>
			</section>

			<section class="location-section" id="ubicacion" aria-labelledby="location-title">
				<div class="section-index"><span>02</span> CÓMO LLEGAR</div>
				<div class="location-content">
					<div class="location-info"><p class="location-kicker">TE ESPERAMOS EN</p><h2 id="location-title">C. Hermes,<br /><em>Teatinos.</em></h2>
						<div class="contact-list">
							<div class="contact-item"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div></div>
							<div class="contact-item"><span aria-hidden="true">↗</span><div><small>TELÉFONO</small><a href={phoneHref}>{business.phone}</a></div></div>
							<div class="contact-item"><span aria-hidden="true">◷</span><div><small>HORARIO</small><p>{horario.map((h) => `${h.days}: ${h.hours}`).join(' · ')}</p></div></div>
						</div>
						<a class="button button-gold map-button" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-frame"><div class="map-head"><span><i></i> LE BARBIERE TEATINOS</span><a href={mapsUrl} target="_blank" rel="noreferrer">GOOGLE MAPS ↗</a></div><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de LE BARBIERE TEATINOS en C. Hermes, Teatinos, Málaga" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div><div class="map-caption"><span class="map-pin" aria-hidden="true">⌖</span><span><strong>LE BARBIERE TEATINOS</strong><small>{business.streetAddress} · {business.city}</small></span><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar">↗</a></div></div>
				</div>
			</section>
			<Galeria nombre="LE BARBIERE TEATINOS" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer"><a class="brand footer-brand" href="#inicio" aria-label="Volver arriba"><span class="brand-mark">LB<span>✳</span></span><span class="brand-name">LE BARBIERE <small>PELUQUERÍA · TEATINOS</small></span></a><p>{business.streetAddress}, {business.city}<br /><a href={phoneHref}>{business.phone}</a></p><a class="footer-maps" href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><small>© {new Date().getFullYear()} LE BARBIERE TEATINOS · Teatinos, Málaga · Fotos de la ficha de Google Maps</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
	<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
	<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
	<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
</nav>
</footer>
		<a class="phone-cta" href={phoneHref}><span aria-hidden="true">☎</span> Llamar a la barbería <strong>{business.phone}</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
			</nav>
						<WhatsappFab phone={datos.phoneHref} name={datos.business?.name} />
						</body>
</html>

