---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/fontana-restaurante-panoramica-06.jpg';
import foto1 from '../assets/fotos/fontana-restaurante-apaisada-01.jpg';
import foto2 from '../assets/fotos/fontana-restaurante-vertical-03.jpg';
import foto3 from '../assets/fotos/fontana-restaurante-vertical-04.jpg';
import foto4 from '../assets/fotos/fontana-restaurante-apaisada-09.jpg';
import foto5 from '../assets/fotos/fontana-restaurante-panoramica-05.jpg';

const business = {
	name: 'Fontana Restaurante',
	short: 'Fontana',
	street: 'Calle Serrano Alcázar, 7',
	city: 'Murcia',
	region: 'Región de Murcia',
	province: 'Murcia',
	postalCode: '30001',
	phone: '+34 968 21 86 22',
	latitude: 37.9865874,
	longitude: -1.130127,
	site: 'https://fontana-restaurante.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Fontana+Restaurante/@37.9865874,-1.130127,17z/data=!3m1!4b1!4m6!3m5!1s0xd63821b9b4f1e81:0xa7dc5cd6e7fa7c39!8m2!3d37.9865874!4d-1.130127!16s%2Fg%2F1v5_bs8q?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34968218622';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'La cocina',
		title: 'Comida casera',
		text: 'Comida casera de primera calidad, con productos frescos y un sabor auténtico que la casa reivindica en el centro de Murcia.',
	},
	{
		kicker: 'Al momento',
		title: 'Tradicional y saludable',
		text: 'El menú combina platos tradicionales y saludables, cocinados al momento con ingredientes seleccionados.',
	},
	{
		kicker: 'En casa',
		title: 'Para llevar y a domicilio',
		text: 'Servicio para llevar y comida a domicilio, para disfrutar de la carta en casa o en la oficina.',
	},
	{
		kicker: 'Con quién',
		title: 'Comidas de trabajo o en familia',
		text: 'Ideal para comidas de trabajo, familiares o con amigos, en un ambiente acogedor y con atención cercana.',
	},
	{
		kicker: 'El trato',
		title: 'Buen servicio',
		text: 'Buen servicio y buen trato: lo que se repite en las reseñas junto a la cocina y el precio.',
	},
	{
		kicker: 'De la carta',
		title: 'Pastel de puerros',
		text: 'Una de las reseñas destaca el pastel de puerros con su salsa, «muy fino al paladar». También se citan las pizzas.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de Fontana Restaurante publicada en su ficha de Google Maps (Murcia)' },
	{ src: photos.foto2, alt: 'Imagen de Fontana Restaurante en Murcia tomada de su galería de Google Maps' },
	{ src: photos.foto3, alt: 'Fotografía del restaurante en la calle Serrano Alcázar, 7, Murcia' },
	{ src: photos.foto4, alt: 'Imagen de Fontana Restaurante subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Vista de Fontana Restaurante según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está Fontana Restaurante?',
		a: 'En la calle Serrano Alcázar, 7, 30001 Murcia, en el centro de la ciudad. Coordenadas 37.9865874, -1.130127.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De lunes a viernes abre de 8:30 a 17:00 y el sábado de 10:00 a 17:00. El domingo cierra, según su ficha de Google Maps.',
	},
	{
		q: '¿Qué tipo de comida sirve?',
		a: 'Comida casera, con platos tradicionales y saludables cocinados al momento. La ficha lo clasifica como cocina española y mediterránea.',
	},
	{
		q: '¿Se puede pedir para llevar?',
		a: 'Sí. La ficha incluye los servicios de comida para llevar y comida a domicilio, además del servicio en el restaurante.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso, aparcamiento, aseo y asientos adaptados para sillas de ruedas. Para necesidades concretas, llama antes.',
	},
	{
		q: '¿Cómo se contacta?',
		a: 'Llamando al 968 21 86 22. Si vienes en festivo o quieres confirmar el horario, es mejor llamar antes.',
	},
];

const images = [
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'Fontana Restaurante, comida casera con producto fresco en el centro de Murcia: platos tradicionales, para llevar y a domicilio. Llama al 968 21 86 22.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: business.short,
	description,
	url: `${business.site}/`,
	telephone: business.phone,
	image: images,
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Mediterránea', 'Casera'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:30',
			closes: '17:00',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '10:00', closes: '17:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Comida para llevar', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Comida a domicilio', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.4,
		reviewCount: 379,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1a2320" />
		<meta
			name="description"
			content="Fontana Restaurante, comida casera con producto fresco en el centro de Murcia: platos tradicionales, para llevar y a domicilio. Llama al 968 21 86 22."
		/>
		<meta
			name="keywords"
			content="Fontana Restaurante, comida casera Murcia, restaurante centro Murcia, Serrano Alcázar, comida para llevar Murcia, cocina mediterránea Murcia"
		/>
		<meta name="author" content="Fontana Restaurante" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Fontana Restaurante | Comida casera en el centro de Murcia</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Fontana Restaurante · Comida casera en Murcia" />
		<meta
			property="og:description"
			content="Platos tradicionales y saludables con producto fresco en la calle Serrano Alcázar, 7 (Murcia). También para llevar y a domicilio."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="Fontana Restaurante, comida casera en el centro de Murcia" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Fontana Restaurante · Comida casera en Murcia" />
		<meta
			name="twitter:description"
			content="Comida casera y platos tradicionales en el centro de Murcia. Llama al 968 21 86 22."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Murcia" />
		<meta name="geo.position" content="37.9865874;-1.130127" />
		<meta name="ICBM" content="37.9865874, -1.130127" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Fontana Restaurante, inicio">
				<span class="brand-mark" aria-hidden="true">F</span>
				<span class="brand-name">Fontana Restaurante <small>Centro de Murcia</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">El restaurante</a>
				<a href="#cocina">La cocina</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>968 21 86 22</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Calle Serrano Alcázar, 7 · Murcia</p>
					<h1 id="hero-title">Comida casera<br />en el centro<br /><em>de Murcia.</em></h1>
					<p class="hero-lede">
						Fontana Restaurante cocina cada día platos tradicionales y saludables con producto fresco, en un
						ambiente acogedor del centro de Murcia. También hay servicio para llevar y comida a domicilio.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 968 21 86 22</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,4</b> en Google (379 reseñas)</li>
						<li>Comida casera</li>
						<li>Producto fresco</li>
						<li>Para llevar</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						alt="Fontana Restaurante, comida casera en el centro de Murcia"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,4</b><span>Google</span></div>
					<div><b>379</b><span>Reseñas</span></div>
					<div><b>6/7</b><span>Días</span></div>
				</div>
				<ul class="services">
					<li>Comida casera</li>
					<li>Cocina mediterránea</li>
					<li>Para llevar</li>
					<li>Comida a domicilio</li>
					<li>Ambiente acogedor</li>
					<li>Local accesible</li>
				</ul>
			</section>

			<section class="about section-pad" id="restaurante">
				<p class="section-label"><span aria-hidden="true"></span> En el centro de Murcia</p>
				<div class="about-grid">
					<h2>Cocina al momento<br />con producto<br /><em>fresco.</em></h2>
					<div class="about-copy">
						<p>
							Fontana Restaurante está en la calle Serrano Alcázar, 7, en el centro de Murcia. Comida casera
							de primera calidad con productos frescos y un sabor auténtico, según cuenta la propia casa.
						</p>
						<p>
							Su menú combina platos tradicionales y saludables, cocinados al momento con ingredientes
							seleccionados. Es un sitio para comidas de trabajo, familiares o con amigos, con ambiente
							acogedor y atención cercana; también hay servicio para llevar.
						</p>
						<p class="about-note">
							Abre de lunes a viernes de 8:30 a 17:00 y el sábado de 10:00 a 17:00. El domingo cierra. Llama al
							968 21 86 22 para consultar o encargar.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="cocina">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Lo que ofrece</p>
						<h2>Cocina de casa,<br />también <em>para llevar.</em></h2>
					</div>
					<p>
						Platos tradicionales y saludables, producto fresco y cocinado al momento. Eso es lo que anuncia la
						casa, que además ofrece servicio para llevar y comida a domicilio.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>Fontana<br /><em>en imágenes.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Fontana Restaurante. En la ficha
							encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="avif"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres el
					titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Calle Serrano Alcázar, 7</p>
					<h2>Ven a comer<br /><em>al centro.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes a viernes</th>
								<td>8:30 – 17:00</td>
							</tr>
							<tr>
								<th scope="row">Sábado</th>
								<td>10:00 – 17:00</td>
							</tr>
							<tr>
								<th scope="row">Domingo</th>
								<td>Cerrado</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, llama antes de venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar 968 21 86 22</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 968 21 86 22</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Fontana Restaurante en la calle Serrano Alcázar, 7, Murcia"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Fontana Restaurante · Murcia
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">F</span>
				<p>Fontana Restaurante<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Fontana Restaurante · Murcia. Fotografías procedentes de la ficha del restaurante en
				Google Maps.
			</small>

			<p class="footer-credit">
				Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> ·
				<a href="https://sur-digital.vercel.app/" rel="noopener">sur-digital.vercel.app</a>
			</p>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar a Fontana <span>968 21 86 22</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
