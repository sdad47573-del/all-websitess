---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/bon-appetit-cafeteria-carrefour-apaisada-04.jpg';
import comedor from '../assets/fotos/bon-appetit-cafeteria-carrefour-apaisada-01.jpg';
import vitrina from '../assets/fotos/bon-appetit-cafeteria-carrefour-apaisada-06.jpg';
import postres from '../assets/fotos/bon-appetit-cafeteria-carrefour-apaisada-09.jpg';
import bandeja from '../assets/fotos/bon-appetit-cafeteria-carrefour-vista-3-03.jpg';
import linea from '../assets/fotos/bon-appetit-cafeteria-carrefour-vertical-05.jpg';
import plato from '../assets/fotos/bon-appetit-cafeteria-carrefour-vertical-07.jpg';
import pasteles from '../assets/fotos/bon-appetit-cafeteria-carrefour-vertical-10.jpg';

import { BUSINESS, CARTA, CARTA_NOTE, FAQ, HORARIO, MAPS, RATING, SERVICIOS } from '../data/site';

const title = 'Bon Appétit · Cafetería Carrefour Andorra 2000';
const description = BUSINESS.description;

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de Bon Appétit con mesas de madera, sillas metálicas verdes y amarillas, estanterías con plantas y un mural de pizzas al fondo',
	},
	{
		src: vitrina,
		alt: 'Vitrina de Bon Appétit con bandejas de pollo asado, carnes y patatas, y el cartel del menú de 12,50 € con primero, segundo, postre y bebida',
	},
	{
		src: bandeja,
		alt: 'Bandeja con pollo asado, patatas panadera, pan, ensalada con tomate y aceitunas, una empanada y una lata de 7Up',
	},
	{
		src: plato,
		alt: 'Plato con una salchicha a la plancha y verduras asadas, junto a un plato de patata con verdura y un vaso de chocolate',
	},
	{
		src: postres,
		alt: 'Vitrina de postres en vaso con chocolate, fresas, arándanos y nata, junto a tarrinas y vasos apilados',
	},
	{
		src: pasteles,
		alt: 'Bandeja de pasteles de Bon Appétit con brownies, cupcakes de chocolate, tartas de fruta y napolitanas, sobre la nevera de refrescos',
	},
	{
		src: linea,
		alt: 'Línea de autoservicio de Bon Appétit con el cartel de «Amanides · Cafetería» y el mostrador de vitrinas junto al suelo de madera',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Menú de Bon Appétit',
	inLanguage: 'es-ES',
	hasMenuSection: CARTA.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'CafeOrCoffeeShop',
	'@id': `${BUSINESS.siteUrl}/#bon-appetit`,
	name: BUSINESS.fullName,
	alternateName: ['Bon Appétit Andorra', 'Cafetería Carrefour Andorra 2000', 'Bon Appetit Andorra la Vella'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cafetería', 'Desayunos', 'Tapas', 'Vegana'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '08:30',
			closes: '20:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El menú', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17211d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Bon Appétit Andorra, cafetería Carrefour Andorra 2000, menú del día Andorra la Vella, cafetería Andorra la Vella, desayunos Andorra, calle Sardana Andorra, comida para llevar Andorra"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cafetería del centro comercial Carrefour Andorra 2000, en la calle Sardana, 22. Menú de 12,50 € con primero, segundo, postre y bebida. Todos los días de 8:30 a 20:00. 3,5 sobre 5 con 129 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada verde de Bon Appétit Carrefour Andorra 2000 en la calle Sardana de Andorra la Vella"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.fullName}
			themeColor="#17211d"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-07"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Bon Appétit"
			subtitle="Carrefour Andorra 2000"
			nav={nav}
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="La cafetería <br /><em>del Andorra 2000.</em>"
				lede={`Bon Appétit es la cafetería del centro comercial Carrefour Andorra 2000, en la calle Sardana, 22, de Andorra la Vella. Menú con primero, segundo, postre y bebida por 12,50 €, vitrina de pollo asado y patatas, ensaladas, tapas y desayunos desde las 8:30. Abre todos los días hasta las 20:00. La ficha de Google le da ${RATING.label} sobre 5 con ${RATING.count} reseñas.`}
				image={fachada}
				imageAlt="Fachada verde de Bon Appétit Carrefour Andorra 2000 con el rótulo en blanco y el escaparate a la calle Sardana"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Menú', html: '<b>12,50 €</b><br />Primero, segundo, postre y bebida' },
					{ label: 'Horario', html: '<b>8:30–20:00</b> · todos los días' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Cafetería · Andorra la Vella"
			/>

			<LocalChips label="Lo que ofrece Bon Appétit" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Autoservicio <br /><em>en el Andorra 2000.</em>"
				paragraphs={[
					'Bon Appétit ocupa la esquina de la calle Sardana, 22, dentro del centro comercial Carrefour Andorra 2000. Fuera, la fachada es verde con el rótulo blanco de «BON APPÉTIT! Carrefour Andorra 2000»; dentro, el local se abre en una sala amplia de suelo de madera, con mesas de madera y sillas metálicas verdes, amarillas y granates.',
					'El servicio es de autoservicio: se pasa por la línea de vitrinas —con el cartel de «Amanides · Cafetería»— y se elige de las bandejas. En la vitrina se ven cuartos de pollo asado, carnes, patatas panadera, pizzas y ensaladas, y al lado la caja con el datáfono.',
					'En las fotos del perfil se leen los carteles de la vitrina: un menú con «1r plat, 2n plat, postres i beguda» por 12,50 €, «Plats únics» y el aviso de que no se puede comer comida traída de fuera. También hay una vitrina de postres en vaso —chocolate, fresas, arándanos y nata—, bollería y una nevera con refrescos y agua.',
					`La ficha de Google la clasifica como «Cafetería», «Restaurante de desayunos», «Comida a domicilio», «Bar de tapas» y «Restaurante vegano». Abre todos los días de 8:30 a 20:00 y tiene ${RATING.label} sobre 5 con ${RATING.count} reseñas (noviembre de 2026).`,
				]}
				note="La ficha de Google no publica teléfono, web, carta ni precios. Lo que se cuenta aquí sale de sus fotos y de las categorías que publica; el único precio es el del menú que se lee en el cartel de la vitrina."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<LocalMenu
				eyebrow="El menú"
				title="Menú a 12,50 € <br /><em>y vitrina.</em>"
				description="El menú con primero, segundo, postre y bebida es lo que anuncia el cartel de la vitrina en las fotos del perfil. El resto de platos son los que aparecen en las bandejas, sin precio publicado."
				cta={{ label: 'Cómo llegar', href: MAPS.directions }}
				groups={CARTA}
				note={CARTA_NOTE}
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor, <br /><em>la vitrina y la mesa.</em>"
				description="Siete fotografías del perfil de Bon Appétit en Google Maps: la fachada, el comedor, la vitrina con el cartel del menú, una bandeja de pollo con patatas, la línea de autoservicio, un plato de salchicha con verduras y la vitrina de postres y pasteles."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">3,5 sobre 5, <em>con 129 reseñas.</em></h2>
						<p>
							Un local de paso, dentro de un centro comercial, con 129 opiniones y una media
							de 3,5 sobre 5 (consultada el 2 de noviembre de 2026). No es una media alta: hay
							mesas bien valoradas y otras que no, así que conviene leer las reseñas enteras
							antes de decidir.
						</p>
						<p>
							Esta web no copia reseñas sueltas: para verlas con sus fechas y sus respuestas,
							abre la ficha en Google.
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver las 129 reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>3,5</strong>
						<span>★★★½☆</span>
						<small>129 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la calle Sardana, <br /><em>dentro del centro.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} · Andorra`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: todos los días de 8:30 a 20:00, sin día de cierre. No añade avisos de festivos; en una fecha señalada conviene comprobar el horario del centro comercial."
				mapTitle="Mapa de Bon Appétit en la calle Sardana, 22, Andorra la Vella"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Sardana, 22 · Andorra la Vella"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: 'Abrir la ficha en Google Maps', href: MAPS.place, external: true }}
				reserveNote="La ficha no publica teléfono, reservas ni pedidos online, así que no hay canal de contacto más que acudir al local. Es una cafetería de autoservicio dentro del centro comercial: se pide en la vitrina y se paga en caja."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Bon Appétit"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone=""
			phoneHref=""
			ctaLabel=""
			legal="Datos, horario, valoración y fotografías de la ficha pública de Google Maps, consultada en noviembre de 2026. La ficha no publica teléfono, carta ni precios: el menú de 12,50 € es el del cartel de la vitrina."
			navAriaLabel="Enlaces de Bon Appétit"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
