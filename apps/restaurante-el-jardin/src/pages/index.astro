---
import WhatsappFab from '../components/WhatsappFab.astro';
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

const business = {
	name: 'Restaurante El Jardín',
	tagline: 'Cocina mediterránea · Arroces · La Manga todo el año',
	street: 'Plaza Cavanna s/n, km 3 Gran Vía de La Manga',
	district: 'La Manga del Mar Menor',
	city: 'Cartagena',
	region: 'Región de Murcia',
	postalCode: '30380',
	phone: '968 56 31 70',
	mobile: '659 63 69 54',
	latitude: 37.6568679,
	longitude: -0.7219862,
	site: 'https://restaurante-el-jardin.vercel.app',
};

const mapsUrl = `https://www.google.com/maps/place/Restaurante+El+Jard%C3%ADn/@${business.latitude},${business.longitude},17z/data=!3m1!4b1!4m6!3m5!1s0xd631867718c8677:0x2dab98febb805529!8m2!3d${business.latitude}!4d${business.longitude}!16s%2Fg%2F11b88px39r`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&hl=es&output=embed`;
const phoneHref = 'tel:+34968563170';
const whatsappHref = 'tel:+34659636954';

const description =
	'Restaurante El Jardín, cocina mediterránea en Plaza Cavanna s/n, La Manga del Mar Menor: arroces por encargo, pescado fresco, menú del día 12–16 € y terraza. Abierto todo el año de martes a domingo. Tel. 968 56 31 70.';

const servicios = [
	'Arroces por encargo',
	'Menú del día 12–16 €',
	'Pescado fresco',
	'Terraza Plaza Cavanna',
	'Abierto todo el año',
	'Desayunos desde 07:30',
	'Para llevar',
	'Opciones sin gluten',
	'Reservado grupos 15–20',
];

const platos = [
	{ name: 'Arroz a banda, paella de marisco y arroz del senyoret', note: 'la catedral de la carta, en mesa o para llevar, por encargo' },
	{ name: 'Menú del día', note: 'primero + segundo + postre casero, 12–16 €, de lunes a viernes fuera de temporada' },
	{ name: 'Marineras de Santoña y anchoa 0,0', note: 'el clásico murciano para empezar' },
	{ name: 'Croqueta de carrillada y de calabaza con queso', note: 'fritura artesanal, también en opción vegetariana' },
	{ name: 'Huevos rotos con jamón ibérico o gulas', note: 'con patata natural frita' },
	{ name: 'Gambas al ajillo, tequila-lima y caballitos sweet chili', note: 'tres formas de gamba muy pedidas' },
	{ name: 'Calamar nacional, puntilla y sepia a la antigua', note: 'fritura y plancha de la bahía' },
	{ name: 'Pulpo a la gallega y a la parrilla', note: 'sobre patata con pimentón o a la brasa' },
	{ name: 'Tataki de atún, tartar de salmón y steak tartar', note: 'los cortes en crudo de la carta' },
	{ name: 'Postres caseros', note: 'cierre dulce sin firma de pastelero, menú infantil disponible' },
];

const fotos = [
	{ src: '/fotos/terraza-jardin.svg', alt: 'Ilustración placeholder de la terraza de El Jardín en Plaza Cavanna — sustituir por foto propia' },
	{ src: '/fotos/arroz-paella.svg', alt: 'Ilustración placeholder del arroz, plato estrella — sustituir por foto propia' },
	{ src: '/fotos/pescado-mar.svg', alt: 'Ilustración placeholder de pescado fresco, gamba y pulpo — sustituir por foto propia' },
	{ src: '/fotos/entrantes-huerta.svg', alt: 'Ilustración placeholder de entrantes, croquetas y marinera — sustituir por foto propia' },
	{ src: '/fotos/menu-dia.svg', alt: 'Ilustración placeholder del menú del día 12–16 € — sustituir por foto propia' },
	{ src: '/fotos/comedor-reservado.svg', alt: 'Ilustración placeholder del comedor y reservado para grupos — sustituir por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Restaurante El Jardín?',
		a: 'En Plaza Cavanna s/n, en el kilómetro 3 de la Gran Vía de La Manga (30380 La Manga del Mar Menor, Cartagena, Murcia), junto a uno de los núcleos hoteleros principales. Tiene comedor con mantel blanco, terraza a la plaza y reservado para grupos de 15 a 20 personas.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Abre todo el año de martes a domingo y descansa los lunes. Sirve desayunos desde las 07:30. El horario de cocina habitual es mediodía y noche; en verano conviene reservar. Confirma por teléfono (968 56 31 70) en festivos y temporada baja.',
	},
	{
		q: '¿Qué se come en El Jardín?',
		a: 'Mediterráneo tradicional: pan de pueblo con tomate, marineras, croquetas, torreznos, huevos rotos, gambas, calamar, sepia, pulpo, tataki y tartares, jamón ibérico de bellota y postres caseros. La estrella es el arroz (a banda, paella de marisco, del senyoret), que se prepara por encargo en mesa y para llevar.',
	},
	{
		q: '¿Cuánto cuesta?',
		a: 'El menú del día ronda los 12–16 € con primero, segundo y postre casero (entre semana y fuera de temporada alta). A la carta, entrantes desde unos 6 €, pescados 9–16 €, pulpo a la parrilla 20 € y jamón bellota 27,50 €. Precio orientativo: confirma la carta del día.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'En verano, sí: la terraza se llena y las mesas vuelan. Llama al 968 56 31 70 o al móvil 659 63 69 54. El resto del año es el comedor de cabecera de muchos residentes, y los domingos suele haber celebraciones en el reservado.',
	},
	{
		q: '¿Tienen opciones sin gluten, vegetarianas o infantiles?',
		a: 'Sí: hay menú sin gluten, opciones vegetarianas (croquetas de calabaza, cestita de berenjenas, creppes) y menú infantil con clásicos a precio reducido.',
	},
	{
		q: '¿Hacen comida para llevar?',
		a: 'Sí, especialidad en arroces para llevar por encargo. Pide primero por teléfono y recoge en el local.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 968 56 31 70',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Mediterránea', 'Española', 'Arroces', 'Pescados y mariscos'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Plaza Cavanna s/n',
		addressLocality: 'La Manga del Mar Menor',
		addressRegion: 'Murcia',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: { '@type': 'GeoCoordinates', latitude: business.latitude, longitude: business.longitude },
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Monday', opens: '00:00', closes: '00:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '07:30', closes: '23:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza exterior', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Comida para llevar', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Menú sin gluten', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Reservado para eventos', value: true },
	],
	aggregateRating: { '@type': 'AggregateRating', ratingValue: 4.6, reviewCount: 154, bestRating: 5 },
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Qué pedir', href: '#carta' },
	{ label: 'Fotos', href: '#fotos' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Restaurante El Jardín | Mediterráneo y arroces en La Manga</title>
		<meta name="theme-color" content="#0e2118" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Restaurante El Jardín, restaurante La Manga, Plaza Cavanna comer, arroz La Manga, paella Mar Menor, menú del día La Manga, mediterráneo Cartagena, pescado fresco La Manga"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Restaurante El Jardín · Mediterráneo y arroces en La Manga"
			ogDescription="Arroces por encargo, pescado fresco y menú 12–16 € en Plaza Cavanna, La Manga. Abierto todo el año de martes a domingo."
			ogImage={`${business.site}/og.svg`}
			ogImageAlt="Restaurante El Jardín, cocina mediterránea en Plaza Cavanna, La Manga del Mar Menor"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#0e2118"
			street={business.street}
			city="La Manga del Mar Menor"
			region="Murcia"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="La Manga del Mar Menor, Cartagena"
			preload={[]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="La Manga del Mar Menor" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<style>
			.hero-custom { display:grid; grid-template-columns: 1.05fr 0.95fr; gap:2.5rem; align-items:center; padding:4.5rem 0 2.5rem; }
			.hero-custom h1 { font-size: clamp(2.6rem, 5.4vw, 4.4rem); line-height:1.02; margin:0.6rem 0 1rem; }
			.hero-custom h1 em { color: var(--amber); font-style:normal; }
			.hero-custom img { width:100%; height:auto; border-radius: var(--radius); border:1px solid var(--line); }
			.fotos-grid { display:grid; grid-template-columns: repeat(3, 1fr); gap:1rem; margin-top:1.6rem; }
			.fotos-grid figure { margin:0; border:1px solid var(--line); border-radius:14px; overflow:hidden; background:var(--deep-2); }
			.fotos-grid img { width:100%; height:220px; object-fit:cover; display:block; }
			.fotos-grid figcaption { padding:0.6rem 0.8rem; font-size:0.85rem; color:var(--muted); }
			.aviso-fotos { border:1px dashed var(--amber); border-radius:14px; padding:1rem 1.2rem; background:rgba(242,193,78,0.08); font-size:0.95rem; }
			@media (max-width: 980px){ .hero-custom{grid-template-columns:1fr; padding-top:3rem;} .fotos-grid{grid-template-columns:1fr 1fr;} }
			@media (max-width: 640px){ .fotos-grid{grid-template-columns:1fr;} .fotos-grid img{height:200px;} }
		</style>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="J"
			name={business.name}
			subtitle="La Manga · todo el año"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<section class="hero-custom wrap" id="inicio" aria-labelledby="hero-title">
				<div>
					<p class="eyebrow"><span aria-hidden="true"></span> Plaza Cavanna · La Manga del Mar Menor</p>
					<h1 id="hero-title">Mediterráneo<br />de verdad<br /><em>todo el año.</em></h1>
					<p class="hero-lede">Mesón honesto en el km 3 de La Manga: arroces por encargo, pescado fresco, menú del día 12–16 € y terraza a la plaza. El que no cierra cuando todos se van — de martes a domingo, desayunos desde las 07:30.</p>
					<div class="hero-actions">
						<a class="button button-primary" href={phoneHref}>Llamar 968 56 31 70</a>
						<a class="button button-ghost" href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,6</b> en reseñas (154 opiniones)</li>
						<li><b>Menú 12–16 €</b> entre semana</li>
						<li><b>Arroces</b> en mesa y para llevar</li>
						<li><b>Lunes</b> cerrado</li>
					</ul>
				</div>
				<figure style="margin:0">
					<img src="/fotos/terraza-jardin.svg" alt="Ilustración de la terraza de Restaurante El Jardín en Plaza Cavanna" fetchpriority="high" />
					<figcaption style="color:var(--muted);font-size:0.85rem;margin-top:0.5rem">Imagen provisional — sustitúyela por fotos propias. <a href={mapsUrl} target="_blank" rel="noreferrer">Ver galería en Maps ↗</a></figcaption>
				</figure>
			</section>

			<LocalChips label="Servicios de Restaurante El Jardín" items={servicios} />

			<LocalAbout
				label="El mesón que no cierra en invierno"
				title="Arroz, huerta<br />y mar Menor<br /><em>en la misma mesa.</em>"
				paragraphs={[
					'El Jardín está en Plaza Cavanna, km 3 de La Manga: comedor de mantel blanco sin reformas caprichosas, terraza con sombrillas a la plaza y un reservado para grupos de 15 a 20 personas donde acaban las sobremesas largas de domingo.',
					'La carta no inventa nada: mediterráneo tradicional bien ejecutado — pescado fresco, verduras de la huerta, marineras, croquetas, gambas, pulpo y tartares — con los arroces como catedral: a banda, paella de marisco y del senyoret, por encargo, en mesa y para llevar.',
					'Mientras gran parte de La Manga baja la persiana de octubre a abril, El Jardín mantiene la cocina encendida los doce meses. Por eso lo frecuentan veraneantes y residentes del Campo de Cartagena todo el año.',
				]}
				note="Valoración media 4,6 sobre 154 reseñas públicas. En agosto las mesas de terraza vuelan: reservar por teléfono es obligado."
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
					{ label: 'Ficha en Google Maps', href: mapsUrl, external: true },
					{ label: 'WhatsApp 659 63 69 54', href: whatsappHref },
				]}
			/>

			<LocalMenu
				eyebrow="Lo más pedido"
				title="Qué pedir<br /><em>en El Jardín.</em>"
				description="Selección a partir de carta verificada 2026 y reseñas de clientes. Los arroces no tienen precio fijo: dependen de comensales y elaboración. Pregunta por el menú del día y la carta digital."
				cta={{ label: 'Reservar por teléfono', href: phoneHref }}
				groups={[{ title: 'La carta', items: platos }]}
				note="Arroces por encargo: llama antes si vas con hora justa. Menú infantil disponible."
			/>

			<section class="section-pad wrap" id="fotos" aria-labelledby="fotos-title">
				<p class="eyebrow"><span aria-hidden="true"></span> Fotos</p>
				<h2 id="fotos-title">El jardín, <em style="color:var(--amber);font-style:normal">en imágenes.</em></h2>
				<div class="aviso-fotos" role="note">
					<strong>⚠️ Sobre las fotos de Google Maps:</strong> no las he descargado ni copiado: las imágenes de la ficha de Google tienen derechos de sus autores y las condiciones de Google Maps no permiten extraerlas automáticamente. Esta web usa <strong>ilustraciones placeholder propias</strong> en <code>public/fotos/</code>. Sustitúyelas por fotos propias del local (mismo nombre de archivo) y se publicarán solas.
				</div>
				<div class="fotos-grid">
					{fotos.map((f) => (
						<figure>
							<img src={f.src} alt={f.alt} loading="lazy" decoding="async" />
							<figcaption>{f.alt.split('—')[0]}</figcaption>
						</figure>
					))}
				</div>
				<p style="margin-top:1rem"><a class="button button-ghost" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos reales en Google Maps ↗</a></p>
			</section>

			<LocalVisit
				eyebrow="Plaza Cavanna s/n · 30380 La Manga"
				title="Nos vemos<br /><em>en el km 3.</em>"
				addressLines={[
					'Plaza Cavanna s/n, km 3 Gran Vía de La Manga',
					'La Manga del Mar Menor',
					'30380 Cartagena (Murcia), España',
				]}
				hours={[
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: '07:30 – 23:00 *' },
					{ day: 'Miércoles', value: '07:30 – 23:00 *' },
					{ day: 'Jueves', value: '07:30 – 23:00 *' },
					{ day: 'Viernes', value: '07:30 – 23:00 *' },
					{ day: 'Sábado', value: '07:30 – 23:00 *' },
					{ day: 'Domingo', value: '07:30 – 23:00 *' },
				]}
				hoursNote="* Horario orientativo: desayunos desde las 07:30, cocina mediodía y noche. Lunes cerrado. Confirma por teléfono en festivos y temporada baja."
				mapTitle="Mapa de Restaurante El Jardín en Plaza Cavanna, La Manga del Mar Menor"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Restaurante El Jardín · La Manga"
				mapHref={mapsUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'WhatsApp', href: whatsappHref },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="En verano, reserva obligada: 968 56 31 70 · móvil 659 63 69 54. Arroces para llevar por encargo."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="J"
			name={business.name}
			address={`${business.street} · ${business.postalCode} La Manga`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Cómo llegar ↗', href: directionsUrl, external: true },
				{ label: business.phone, href: phoneHref },
				{ label: business.mobile, href: whatsappHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Ilustraciones propias provisionales. Información elaborada a partir de fuentes públicas; confirma horarios y precios antes de la visita."
			ctaLabel="Llamar a El Jardín"
		/>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
		<WhatsappFab phone={whatsappHref} name={business.name} />
	</body>
</html>
