---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/pollos-pineda-apaisada-01.jpg';
import despensa from '../assets/fotos/pollos-pineda-apaisada-02.jpg';
import arrozAlbondigas from '../assets/fotos/pollos-pineda-apaisada-04.jpg';
import vitrina from '../assets/fotos/pollos-pineda-apaisada-07.jpg';
import ensaladas from '../assets/fotos/pollos-pineda-vertical-03.jpg';
import guiso from '../assets/fotos/pollos-pineda-vertical-05.jpg';
import carneGuisada from '../assets/fotos/pollos-pineda-vertical-06.jpg';
import bandejasEventos from '../assets/fotos/pollos-pineda-vertical-08.jpg';
import polloPatatas from '../assets/fotos/pollos-pineda-vertical-09.jpg';
import carnePatatas from '../assets/fotos/pollos-pineda-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Pollos Pineda · Pollos asados y comida casera en Puerto de la Torre';
const description =
	'Pollos Pineda, asador en C. Lope de Rueda, 92, Puerto de la Torre (Málaga). Pollos asados halal, raciones caseras y encargos para celebraciones. Fotos, horario, teléfono y cómo llegar.';

const galeria = [
	{ src: fachada, alt: 'Fachada de Pollos Pineda en la calle Lope de Rueda con el rótulo del asador' },
	{ src: polloPatatas, alt: 'Pollo asado en bandeja de aluminio con patatas fritas para llevar' },
	{ src: carnePatatas, alt: 'Bandejas de carne especiada con patatas recién asadas' },
	{ src: guiso, alt: 'Bandejas de guiso casero con patatas, zanahoria, fideos y albóndigas' },
	{ src: arrozAlbondigas, alt: 'Bandeja de arroz amarillo con albóndigas, pimientos y aceitunas negras' },
	{ src: carneGuisada, alt: 'Carne guisada con hueso y verduras en una bandeja de barro' },
	{ src: vitrina, alt: 'Interior de Pollos Pineda con la vitrina de tuppers y las estanterías de bodega' },
	{ src: despensa, alt: 'Pared roja del local con el logotipo de Pollos Pineda, aceites y conservas' },
	{ src: ensaladas, alt: 'Tuppers de ensalada con fresa, maíz, lechuga y rábano para llevar' },
	{ src: bandejasEventos, alt: 'Bandejas de arroz y ensalada de fruta preparadas para un evento' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Oferta de Pollos Pineda',
	inLanguage: 'es-ES',
	description:
		'Selección basada en la descripción del negocio en Google, las reseñas públicas y las fotografías de la ficha; no es una carta oficial ni incluye precios.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#pollos-pineda`,
	name: BUSINESS.name,
	alternateName: ['Pineda Puerto de la Torre', 'Asador Pollos Pineda'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34951080262',
	servesCuisine: ['Pollos asados', 'Comida casera', 'Halal'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:30',
			closes: '16:00',
		},
	],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Oferta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"pollos-pineda-apaisada-01.jpg": fachada,
	"pollos-pineda-vertical-09.jpg": polloPatatas,
	"pollos-pineda-vertical-10.jpg": carnePatatas,
	"pollos-pineda-vertical-05.jpg": guiso,
	"pollos-pineda-apaisada-04.jpg": arrozAlbondigas,
	"pollos-pineda-vertical-06.jpg": carneGuisada,
	"pollos-pineda-apaisada-07.jpg": vitrina,
	"pollos-pineda-apaisada-02.jpg": despensa,
	"pollos-pineda-vertical-03.jpg": ensaladas,
	"pollos-pineda-vertical-08.jpg": bandejasEventos,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;500;600;700&family=Public+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Pollos Pineda, pollos asados Málaga, pollos asados halal Puerto de la Torre, comida casera para llevar Málaga, Lope de Rueda 92, encargos para celebraciones"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollos asados halal, raciones caseras y encargos para celebraciones en Puerto de la Torre. Consulta fotos, horario y teléfono."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Pollos Pineda en Puerto de la Torre, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#3a2317"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Puerto de la Torre, Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Pollos Pineda"
			subtitle="Asador · Puerto de la Torre"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma horario, platos y precios con el establecimiento."
			ctaLabel="Llamar a Pollos Pineda"
			navAriaLabel="Enlaces de Pollos Pineda"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
