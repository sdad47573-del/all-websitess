---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/pollos-pineda-apaisada-01.jpg';
import despensa from '../assets/fotos/pollos-pineda-apaisada-02.jpg';
import arrozAlbondigas from '../assets/fotos/pollos-pineda-apaisada-04.jpg';
import vitrina from '../assets/fotos/pollos-pineda-apaisada-07.jpg';
import ensaladas from '../assets/fotos/pollos-pineda-vertical-03.jpg';
import guiso from '../assets/fotos/pollos-pineda-vertical-05.jpg';
import carneGuisada from '../assets/fotos/pollos-pineda-vertical-06.jpg';
import bandejasEventos from '../assets/fotos/pollos-pineda-vertical-08.jpg';
import polloPatatas from '../assets/fotos/pollos-pineda-vertical-09.jpg';
import carnePatatas from '../assets/fotos/pollos-pineda-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Pollos Pineda · Pollos asados y comida casera en Puerto de la Torre';
const description =
	'Pollos Pineda, asador en C. Lope de Rueda, 92, Puerto de la Torre (Málaga). Pollos asados halal, raciones caseras y encargos para celebraciones. Fotos, horario, teléfono y cómo llegar.';

const galeria = [
	{ src: fachada, alt: 'Fachada de Pollos Pineda en la calle Lope de Rueda con el rótulo del asador' },
	{ src: polloPatatas, alt: 'Pollo asado en bandeja de aluminio con patatas fritas para llevar' },
	{ src: carnePatatas, alt: 'Bandejas de carne especiada con patatas recién asadas' },
	{ src: guiso, alt: 'Bandejas de guiso casero con patatas, zanahoria, fideos y albóndigas' },
	{ src: arrozAlbondigas, alt: 'Bandeja de arroz amarillo con albóndigas, pimientos y aceitunas negras' },
	{ src: carneGuisada, alt: 'Carne guisada con hueso y verduras en una bandeja de barro' },
	{ src: vitrina, alt: 'Interior de Pollos Pineda con la vitrina de tuppers y las estanterías de bodega' },
	{ src: despensa, alt: 'Pared roja del local con el logotipo de Pollos Pineda, aceites y conservas' },
	{ src: ensaladas, alt: 'Tuppers de ensalada con fresa, maíz, lechuga y rábano para llevar' },
	{ src: bandejasEventos, alt: 'Bandejas de arroz y ensalada de fruta preparadas para un evento' },
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Oferta de Pollos Pineda',
	inLanguage: 'es-ES',
	description:
		'Selección basada en la descripción del negocio en Google, las reseñas públicas y las fotografías de la ficha; no es una carta oficial ni incluye precios.',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#pollos-pineda`,
	name: BUSINESS.name,
	alternateName: ['Pineda Puerto de la Torre', 'Asador Pollos Pineda'],
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34951080262',
	servesCuisine: ['Pollos asados', 'Comida casera', 'Halal'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:30',
			closes: '16:00',
		},
	],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Oferta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;500;600;700&family=Public+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Pollos Pineda, pollos asados Málaga, pollos asados halal Puerto de la Torre, comida casera para llevar Málaga, Lope de Rueda 92, encargos para celebraciones"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollos asados halal, raciones caseras y encargos para celebraciones en Puerto de la Torre. Consulta fotos, horario y teléfono."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Pollos Pineda en Puerto de la Torre, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#3a2317"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Puerto de la Torre, Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Pollos Pineda"
			subtitle="Asador · Puerto de la Torre"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Lope de Rueda, 92 · Puerto de la Torre"
				title="Pollos asados <br /><em>de la brasa.</em>"
				lede={`Pollos Pineda es el asador de pollos de Puerto de la Torre: pollos asados halal y raciones de comida casera para llevar. La ficha de Google muestra ${RATING.label} sobre 5 con ${RATING.count} reseñas. También preparan comidas para celebraciones.`}
				image={fachada}
				imageAlt="Fachada de Pollos Pineda con el rótulo del asador y el cartel de pedidos"
				primaryCta={{ label: `Encargar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver ficha en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Especialidad', html: '<b>Pollo asado</b> halal' },
					{ label: 'Valoración', html: `<b>${RATING.label}</b> · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>9:30 – 16:00</b> de martes a domingo' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver fotos y ficha"
				tag="Para recoger"
			/>

			<LocalChips label="Servicios y oferta de Pollos Pineda" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Pineda, <br /><em>pollo y casero.</em>"
				paragraphs={[
					'Pollos Pineda está en la calle Lope de Rueda, 92, en Puerto de la Torre, y se presenta en Google como «Asador de Pollos Pineda, los mejores pollos asados de el Puerto de la Torre». El asador trabaja pollo halal y raciones de comida casera.',
					'Las fotos del local muestran el mostrador con tuppers preparados, guisos en bandejas, arroces, carnes con patatas y ensaladas. La ficha explica que todo se elabora con ingredientes de primera calidad y con las medidas higiénico-sanitarias que marca la ley.',
					'Además del servicio diario, preparan comidas para comuniones, bautizos y celebraciones. El negocio invita a reservar el pedido por teléfono para asegurarse de no quedarse sin él.',
				]}
				note="La ficha no publica carta ni precios. La información de esta página procede de la descripción del negocio, de sus fotografías y de las reseñas públicas; el surtido del día se consulta por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotografías', href: '#galeria' },
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<ul class="highlights">
				{
					HIGHLIGHTS.map((item) => (
						<li>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</li>
					))
				}
			</ul>

			<LocalMenu
				eyebrow="Del asador al tupper"
				title="Pollo, raciones <br /><em>y encargos.</em>"
				description="La descripción del negocio y las reseñas permiten hacerse una idea de la oferta: pollo asado halal, raciones caseras y comidas preparadas para celebraciones. No hay carta ni precios publicados."
				cta={{ label: `Reservar el pedido · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La ficha no publica precios ni una carta completa. Los platos citados son los que aparecen en la descripción del negocio y en las opiniones; confirma disponibilidad e importe al llamar."
			/>

			<LocalGallery
				eyebrow="Fotos del perfil de Google Maps"
				title="El asador <br /><em>y la vitrina.</em>"
				description="La fachada, el interior con la vitrina de raciones y algunos de los platos que aparecen en las fotografías públicas del establecimiento."
				images={galeria}
				cta={{ label: 'Abrir la ficha en Google Maps', href: MAPS.place }}
				note="Imágenes descargadas del perfil público de Pollos Pineda en Google Maps y servidas desde esta página."
			/>

			<section class="notas" aria-labelledby="notas-title">
				<div class="wrap notas-grid">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="notas-title">Lo que cuentan <em>las reseñas.</em></h2>
						<p class="notas-score">
							<strong>{RATING.label}</strong>
							<span>
								<b>★★★★★</b>
								{RATING.count} reseñas<br />en Google
							</span>
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer reseñas en Google ↗
						</a>
					</div>

					<div class="notas-copy">
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>{resena.texto}</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Opinión en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<p class="notas-foot">
							La valoración y el número de reseñas corresponden a la ficha consultada en octubre
							de 2026 y pueden variar. <a href={MAPS.reviews} target="_blank" rel="noreferrer"
								>Consulta las opiniones actualizadas en Google ↗</a
							>.
						</p>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Puerto <br /><em>de la Torre.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO}
				hoursCaption="Horario"
				hoursNote={HORARIO_AVISO}
				mapTitle="Mapa de Pollos Pineda en C. Lope de Rueda, 92, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. Lope de Rueda, 92 · Málaga"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="El local recomienda reservar el pedido con antelación. Llama para encargar el pollo, preguntar por las raciones del día o preparar una celebración."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>encargar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Información y fotografías de la ficha pública de Google Maps. Confirma horario, platos y precios con el establecimiento."
			ctaLabel="Llamar a Pollos Pineda"
			navAriaLabel="Enlaces de Pollos Pineda"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
