---
import '../styles/global.css';
import {
	business,
	directionsUrl,
	mapEmbedUrl,
	mapsUrl,
	photoUrl,
	phoneHref,
	structuredData,
} from '../lib/business';

const title = 'Barbershop Guillermo Val | Barbería en Málaga';
const description =
	'Barbershop Guillermo Val, barbería en C. Castilla, 19, Málaga. Llama al 600 24 13 83 o consulta cómo llegar desde Google Maps.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#171714" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Oswald:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={photoUrl} />
		<meta property="og:image:alt" content="Fotografía de Barbershop Guillermo Val compartida en Google Maps" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={photoUrl} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content="36.7211362;-4.4537981" />
		<meta name="ICBM" content="36.7211362, -4.4537981" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Barbershop Guillermo Val, inicio">
				<span class="brand-mark" aria-hidden="true">GV<span>✳</span></span>
				<span class="brand-name">GUILLERMO VAL <small>BARBERSHOP · MÁLAGA</small></span>
			</a>
			<nav aria-label="Navegación principal"><a href="#barberia">La barbería</a><a href="#ubicacion">Encuéntranos</a></nav>
			<a class="header-call" href={phoneHref}><span aria-hidden="true">☎</span> {business.phone}</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> BARBERSHOP · MÁLAGA</p>
					<h1 id="hero-title">CORTE<br />CON <em>CARÁCTER.</em></h1>
					<p class="hero-description">Barbershop Guillermo Val. Un espacio en Málaga para cuidar tu estilo, con atención cercana y el oficio de la barbería en cada detalle.</p>
					<div class="hero-actions"><a class="button button-gold" href={phoneHref}><span aria-hidden="true">☎</span> Llamar ahora</a><a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-address"><span class="address-icon" aria-hidden="true">⌖</span><p>{business.streetAddress}<br /><strong>{business.postalCode} · {business.city}</strong></p></div>
				</div>

				<figure class="hero-image">
					<div class="image-label"><span>GV / 01</span><span>BARBERSHOP GUILLERMO VAL</span></div>
					<a href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Abrir la fotografía y galería de Guillermo Val en Google Maps">
						<img src={photoUrl} alt="Fotografía de Barbershop Guillermo Val publicada en Google Maps" width="1200" height="900" fetchpriority="high" decoding="async" />
						<span class="image-open" aria-hidden="true">↗</span>
					</a>
					<figcaption><span>IMAGEN DE LA FICHA DE GOOGLE MAPS</span><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha ↗</a></figcaption>
					<div class="image-seal" aria-hidden="true">GOOD<br />CUTS<br /><b>✳</b></div>
				</figure>
				<span class="hero-mark" aria-hidden="true">✳</span>
			</section>

			<section class="barber-section" id="barberia" aria-labelledby="barber-title">
				<div class="section-index"><span>01</span> EL OFICIO DE LA BARBERÍA</div>
				<div class="barber-content">
					<h2 id="barber-title">Tu barbería<br /><em>en Málaga.</em></h2>
					<div class="barber-text"><p>En Barbershop Guillermo Val, el estilo empieza con una buena conversación. Acércate al local de C. Castilla y descubre una atención personal en un entorno pensado para la barbería.</p><a href={directionsUrl} target="_blank" rel="noreferrer" class="text-link">Visítanos en Málaga <span aria-hidden="true">↗</span></a></div>
				</div>
				<div class="barber-details"><span>BARBERSHOP GUILLERMO VAL</span><span>MÁLAGA · ANDALUCÍA</span><span>✳</span></div>
			</section>

			<section class="location-section" id="ubicacion" aria-labelledby="location-title">
				<div class="section-index"><span>02</span> CÓMO LLEGAR</div>
				<div class="location-content">
					<div class="location-info"><p class="location-kicker">TE ESPERAMOS EN</p><h2 id="location-title">C. Castilla,<br /><em>Málaga.</em></h2>
						<div class="contact-list">
							<div class="contact-item"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div></div>
							<div class="contact-item"><span aria-hidden="true">↗</span><div><small>TELÉFONO</small><a href={phoneHref}>{business.phone}</a></div></div>
						</div>
						<a class="button button-gold map-button" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-frame"><div class="map-head"><span><i></i> BARBERSHOP GUILLERMO VAL</span><a href={mapsUrl} target="_blank" rel="noreferrer">GOOGLE MAPS ↗</a></div><iframe title="Mapa de Barbershop Guillermo Val en C. Castilla, Málaga" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><div class="map-caption"><span class="map-pin" aria-hidden="true">⌖</span><span><strong>Barbershop Guillermo Val</strong><small>{business.streetAddress} · {business.city}</small></span><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar">↗</a></div></div>
				</div>
			</section>
		</main>

		<footer class="site-footer"><a class="brand footer-brand" href="#inicio" aria-label="Volver arriba"><span class="brand-mark">GV<span>✳</span></span><span class="brand-name">GUILLERMO VAL <small>BARBERSHOP · MÁLAGA</small></span></a><p>{business.streetAddress}, {business.city}<br /><a href={phoneHref}>{business.phone}</a></p><a class="footer-maps" href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><small>© {new Date().getFullYear()} Barbershop Guillermo Val · Málaga</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
</footer>
		<a class="phone-cta" href={phoneHref}><span aria-hidden="true">☎</span> Llamar a la barbería <strong>{business.phone}</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>
