---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import comedor from '../assets/fotos/bar-taberna-la-new-vertical-01.jpg';
import collage from '../assets/fotos/bar-taberna-la-new-vertical-02.jpg';
import tartar from '../assets/fotos/bar-taberna-la-new-vertical-03.jpg';
import timbale from '../assets/fotos/bar-taberna-la-new-vertical-04.jpg';
import ventanal from '../assets/fotos/bar-taberna-la-new-vertical-05.jpg';
import lomo from '../assets/fotos/bar-taberna-la-new-vertical-06.jpg';
import letrero from '../assets/fotos/bar-taberna-la-new-vertical-07.jpg';
import guiso from '../assets/fotos/bar-taberna-la-new-vertical-08.jpg';
import ostras from '../assets/fotos/bar-taberna-la-new-vertical-09.jpg';
import alcachofas from '../assets/fotos/bar-taberna-la-new-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const title = 'Taberna la New · Restaurante en Teatinos, Málaga';
const description = BUSINESS.description;

const galeria = [
	{
		src: letrero,
		alt: 'Letrero iluminado de Taberna la New, con el logotipo del león, el lema «Tradición & Actualidad» y una firma, con dos personas preparando una mesa delante',
	},
	{
		src: comedor,
		alt: 'Comedor de Taberna la New con mesas de tablero claro, sillas de terciopelo granate, lámparas de tubo de madera y el letrero del local enmarcado en la pared',
	},
	{
		src: ventanal,
		alt: 'Mesa de Taberna la New junto al ventanal, con vajilla de peces, copas de vino, sillas de terciopelo granate y una lámpara de madera',
	},
	{
		src: alcachofas,
		alt: 'Plato con corazones de alcachofa cubiertos de lonchas de jamón y sésamo negro sobre un fondo de salsa',
	},
	{
		src: tartar,
		alt: 'Tartar con base de aguacate sobre plato de porcelana, con aliño de aioli, migas negras y brotes',
	},
	{
		src: timbale,
		alt: 'Timbale de gambas con salsa rosa y una capa de tartar por encima, con cebollino y sésamo negro, junto a un pan fino',
	},
	{
		src: ostras,
		alt: 'Bola de bronce con ostras abiertas sobre hielo y un cuchillo de abrir, sostenida por una mano con guante negro',
	},
	{
		src: guiso,
		alt: 'Plato de carne guisada con su salsa sobre patatas fritas y una rama de tomillo, con panecillos al fondo',
	},
	{
		src: lomo,
		alt: 'Mesa de Taberna la New con un plato de lonchas de lomo y una porción de mostaza, cesta de pan, botella de Coca-Cola y copas de vino',
	},
	{
		src: collage,
		alt: 'Composición de seis fotografías de la casa: corte de jamón, platos de jamón, estantería de botellas, servicio de copa de vino y ostras sobre hielo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#taberna-la-new`,
	name: BUSINESS.name,
	alternateName: ['La New', 'Taberna la New Málaga', 'Taberna la New Teatinos'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Mediterránea', 'De mercado'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: `${BUSINESS.street}, ${BUSINESS.local}`,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '12:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '20:00',
			closes: '24:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#48102a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;0,6..96,700;1,6..96,500&family=Jost:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Taberna la New, Taberna la New Málaga, restaurante Teatinos, restaurante Málaga, comer en Teatinos, jamón cortado a cuchillo Málaga, ostras Málaga, Av. de Gregorio Prieto 19"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina de taberna en la Av. de Gregorio Prieto 19, local 2, en Teatinos (Málaga). Todos los días de 12:00 a 16:00 y de 20:00 a 24:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Comedor de Taberna la New con el letrero iluminado del local"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#48102a"
			street={`${BUSINESS.street}, ${BUSINESS.local}`}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Teatinos, Málaga"
			locale="es_ES"
			countryName="España"
			preload={[comedor]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Taberna la New"
			subtitle="Teatinos · Málaga"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.district}`}
				title="Taberna de barrio <br /><em>en Teatinos.</em>"
				lede={`Taberna la New está en la Av. de Gregorio Prieto 19, local 2, en Teatinos (Málaga). Abre todos los días de 12:00 a 16:00 y de 20:00 a 24:00, y la ficha de Google le da 4,7 sobre 5 con 326 reseñas.`}
				image={comedor}
				imageAlt="Comedor de Taberna la New con el letrero del local enmarcado en la pared, mesas de tablero claro y sillas de terciopelo granate"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,7</b> en Google · 326 reseñas' },
					{ label: 'Horario', html: '<b>12–16 y 20–24</b> todos los días' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> contacto publicado` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Lo que encuentras en Taberna la New" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Tradición <br /><em>y actualidad.</em>"
				paragraphs={[
					'Taberna la New está en la Av. de Gregorio Prieto 19, local 2, en el barrio de Teatinos-Universidad, en Málaga (29010). En el letrero iluminado del comedor se lee su nombre, el lema «Tradición & Actualidad» y el logotipo de una cervecera, junto a una firma.',
					'La Google clasifica el local como restaurante y le da 4,7 sobre 5 con 326 reseñas. La ficha publica el teléfono +34 611 67 21 97 y no enlaza ninguna web propia: muestra la opción de añadir una, lo que confirma que ahora mismo no hay ninguna publicada.',
					'El comedor tiene suelo de madera, mesas de tablero claro y sillas de terciopelo granate, con lámparas de tubo de madera y una pared de azulejo granate con relieve de botellas. Hay una mesa junto al ventanal y una estantería de botellas al fondo.',
					'En las mesas aparecen jamón cortado a cuchillo, ostras sobre hielo, alcachofas con jamón y sésamo, tartar sobre base de aguacate, un timbale de gambas con salsa rosa, carne guisada con patatas y lonchas de lomo con mostaza. El horario es partido y continuo todos los días: de 12:00 a 16:00 y de 20:00 a 24:00.',
				]}
				note="La información viene de la ficha pública de Google Maps y de las fotografías del perfil del local. La ficha no publica carta, precios ni web propia, así que ninguna de esas cosas aparece aquí."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La mesa"
				title="Jamón, ostras <br /><em>y guisos.</em>"
				description="La ficha de Google no publica carta ni precios, y el local no tiene web propia. Lo que sigue es lo que se ve en las fotografías del perfil: los platos servidos en las mesas y la bodega del fondo."
				cta={{ label: 'Ver fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="No hay carta publicada ni precios conocidos. Para confirmar platos del día, disponibilidad o reserva, el teléfono de la ficha es el único canal publicado."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Diez fotografías <br /><em>del local.</em>"
				description="Las fotografías del perfil de Taberna la New en Google Maps: el letrero, el comedor, la mesa del ventanal, los platos servidos y la bodega."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y procedentes del perfil del establecimiento en Google Maps. Si eres titular de alguna y quieres que la retiremos, escríbenos y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Pásate por <br /><em>Teatinos.</em>"
				addressLines={[`${BUSINESS.street}, ${BUSINESS.local}`, `${BUSINESS.district}`, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'España']}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: todos los días, de 12:00 a 16:00 y de 20:00 a 24:00. La ficha avisa de que en festivos podría ser diferente, así que conviene confirmarlo antes de ir."
				mapTitle="Mapa de Taberna la New en la Av. de Gregorio Prieto 19, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Taberna la New · Teatinos"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="El teléfono es el único canal de contacto que publica la ficha. No hay reservas ni pedidos en línea: el local no tiene web propia ni plataforma asociada. La ficha tampoco indica información sobre terraza, para llevar o accesibilidad."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y oferta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Taberna la New"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
