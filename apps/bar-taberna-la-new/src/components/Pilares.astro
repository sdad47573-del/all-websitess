---
import { PILARES, PRESS } from '../data/site';
---

<section id="esencia" class="bg-base-200 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">
				Nuestra esencia
			</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">Tradición y actualidad</h2>
			<div class="lanew-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/70 mt-6">
				Taberna de barrio con la mirada puesta en la ciudad: la raíz malagueña intacta y una carta
				que se mira al presente.
			</p>
		</div>

		<div class="mt-14 grid gap-6 sm:grid-cols-2">
			{
				PILARES.map((pilar) => (
					<article class="card border-base-300 bg-base-100 border">
						<div class="card-body gap-4">
							<span class="bg-primary/10 text-primary flex size-12 items-center justify-center rounded-xl">
								<i class={`${pilar.icon} text-2xl`} />
							</span>
							<h3 class="font-display text-2xl font-semibold">{pilar.title}</h3>
							<p class="text-base-content/75 leading-relaxed">{pilar.text}</p>
						</div>
					</article>
				))
			}
		</div>

		<figure
			class="border-base-300 bg-base-100 rounded-box border-l-accent mt-10 border border-l-4 p-7"
		>
			<blockquote class="text-base-content/80 font-display text-lg leading-relaxed italic">
				«{PRESS.text}»
			</blockquote>
			<figcaption class="text-base-content/55 mt-4 text-xs tracking-wide uppercase">
				{PRESS.outlet} · {PRESS.date}
			</figcaption>
		</figure>
	</div>
</section>
