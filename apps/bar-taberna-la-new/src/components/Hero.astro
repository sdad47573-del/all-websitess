---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES } from '../data/site';
---

<section id="inicio" class="bg-neutral text-neutral-content">
	<div
		class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1.15fr_1fr] lg:gap-16 lg:px-8 lg:py-24"
	>
		<div>
			<div
				class="mb-6 inline-flex items-center gap-3 rounded-full bg-white/10 px-4 py-2 ring-1 ring-white/15 backdrop-blur-sm"
			>
				<span class="text-accent text-xs font-semibold tracking-[0.2em] uppercase">
					{BUSINESS.district}
				</span>
				<span class="text-sm text-white/70">{BUSINESS.city}</span>
			</div>

			<h1 class="font-display text-shadow-soft text-5xl leading-[1.05] font-bold sm:text-6xl">
				Taberna <span class="text-accent">La New</span>
			</h1>

			<p class="font-display mt-5 text-xl text-white/90 sm:text-2xl">{BUSINESS.tagline}</p>

			<p class="mt-5 max-w-xl text-base text-white/80 sm:text-lg">{BUSINESS.summary}</p>

			<div class="mt-9 flex flex-wrap gap-3">
				<a
					href={BUSINESS.reservasUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-primary btn-lg gap-2 rounded-full"
				>
					<i class="ri-calendar-check-line text-xl"></i>
					Reservar mesa
				</a>
				<a
					href={BUSINESS.reservasHref}
					class="btn btn-lg gap-2 rounded-full border-white/30 bg-white/10"
				>
					<i class="ri-phone-line text-xl"></i>
					{BUSINESS.reservasDisplay}
				</a>
			</div>

			<ul class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm text-white/85">
				<li class="flex items-center gap-2">
					<i class="ri-map-pin-2-line text-accent"></i>
					{BUSINESS.street}, {BUSINESS.local}
				</li>
				<li class="flex items-center gap-2">
					<i class="ri-time-line text-accent"></i>
					Todos los días: 12:00 – 16:00 y 20:00 – 00:00
				</li>
				<li class="flex items-center gap-2">
					<i class="ri-train-line text-accent"></i>
					{BUSINESS.metro}
				</li>
			</ul>
		</div>

		<Image
			src={IMAGES.portada}
			alt="Taberna La New en la Avenida de Gregorio Prieto 19, Teatinos (Málaga)"
			loading="eager"
			fetchpriority="high"
			widths={[420, 540]}
			sizes="(min-width: 1024px) 40vw, 92vw"
			class="rounded-box aspect-4/3 w-full object-cover shadow-2xl"
		/>
	</div>
</section>
