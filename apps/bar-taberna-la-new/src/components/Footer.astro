---
import { BUSINESS, HOURS, NAV, PAGE_NAV } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-neutral text-neutral-content">
	<div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
		<div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
			<div class="lg:col-span-2">
				<div class="flex items-center gap-3">
					<span
						class="bg-primary font-display text-primary-content flex size-11 items-center justify-center rounded-xl text-xl font-bold"
						>N</span
					>
					<div>
						<p class="font-display text-xl font-semibold text-white">Taberna La New</p>
						<p class="text-xs tracking-[0.2em] text-white/50 uppercase">
							Cocina casera · Tapas · Guisos
						</p>
					</div>
				</div>
				<p class="mt-5 max-w-md text-sm leading-relaxed text-white/70">
					{BUSINESS.summary}
				</p>
				<div class="mt-6 flex gap-3">
					<a
						href={BUSINESS.instagram}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Instagram de Taberna La New"
						class="hover:bg-primary flex size-10 items-center justify-center rounded-full bg-white/10 transition-colors"
					>
						<i class="ri-instagram-line text-lg"></i>
					</a>
					<a
						href={BUSINESS.reservasUrl}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Reservar mesa en Taberna La New"
						class="hover:bg-primary flex size-10 items-center justify-center rounded-full bg-white/10 transition-colors"
					>
						<i class="ri-calendar-check-line text-lg"></i>
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Taberna La New en Google Maps"
						class="hover:bg-primary flex size-10 items-center justify-center rounded-full bg-white/10 transition-colors"
					>
						<i class="ri-map-pin-line text-lg"></i>
					</a>
				</div>
			</div>

			<div>
				<h3 class="font-display text-lg font-semibold text-white">Secciones</h3>
				<ul class="mt-4 space-y-2 text-sm text-white/70">
					{
						NAV.map((item) => (
							<li>
								<a href={`/${item.href}`} class="hover:text-accent transition-colors">
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
				<ul class="mt-4 space-y-2 border-t border-white/10 pt-4 text-sm text-white/70">
					{
						PAGE_NAV.map((item) => (
							<li>
								<a href={item.href} class="hover:text-accent transition-colors">
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h3 class="font-display text-lg font-semibold text-white">Contacto</h3>
				<ul class="mt-4 space-y-3 text-sm text-white/70">
					<li class="flex items-start gap-2">
						<i class="ri-map-pin-line text-accent mt-0.5"></i>
						<span>
							{BUSINESS.street}<br />
							{BUSINESS.postalCode}
							{BUSINESS.city}
						</span>
					</li>
					<li class="flex items-center gap-2">
						<i class="ri-phone-line text-accent"></i>
						<a href={BUSINESS.phoneHref} class="hover:text-accent">{BUSINESS.phoneDisplay}</a>
					</li>
					<li class="flex items-center gap-2">
						<i class="ri-calendar-check-line text-accent"></i>
						<a href={BUSINESS.reservasHref} class="hover:text-accent">{BUSINESS.reservasDisplay}</a>
					</li>
					{
						HOURS.map((item) => (
							<li class="flex items-center gap-2">
								<i class="ri-time-line text-accent" />
								<span>
									{item.service}: {item.hours}
								</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div
			class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-xs text-white/50 sm:flex-row"
		>
			<p>© {year} {BUSINESS.name}. Todos los derechos reservados.</p>
			<a
				href={BUSINESS.googleMaps}
				target="_blank"
				rel="noopener noreferrer"
				class="hover:text-accent">Ver ficha en Google Maps</a
			>
		</div>

		<div class="mt-6 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-6 text-xs text-white/50 sm:flex-row">
			<nav class="flex flex-wrap items-center gap-x-4 gap-y-2" aria-label="Información legal">
				<a href="/aviso-legal" class="hover:text-accent transition-colors">Aviso legal</a>
				<a href="/aviso-legal#privacidad" class="hover:text-accent transition-colors">Privacidad</a>
				<a href="/aviso-legal#cookies" class="hover:text-accent transition-colors">Cookies</a>
			</nav>
			<p>
				Web creada por
				<a href="https://sur-digital.vercel.app/" rel="noopener" class="hover:text-accent transition-colors">Sur Digital</a>
			</p>
		</div>
	</div>
</footer>
