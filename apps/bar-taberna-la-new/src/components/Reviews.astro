---
import { BUSINESS, REVIEWS } from '../data/site';
---

<section id="opiniones" class="bg-base-100 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">Opiniones</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">Lo que dicen de la taberna</h2>
			<div class="lanew-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/70 mt-6">
				Reseñas publicadas por quienes han venido a comer con nosotros.
			</p>
		</div>

		<div class="mt-14 grid gap-6 lg:grid-cols-3">
			{
				REVIEWS.map((review) => (
					<blockquote class="rounded-box border-base-300 bg-base-200 border p-7 shadow-sm">
						<div class="text-accent flex gap-0.5">
							<i class="ri-star-fill text-sm" />
							<i class="ri-star-fill text-sm" />
							<i class="ri-star-fill text-sm" />
							<i class="ri-star-fill text-sm" />
							<i class="ri-star-fill text-sm" />
						</div>
						<p class="text-base-content/80 mt-4 leading-relaxed">«{review.text}»</p>
						<footer class="text-base-content/55 mt-4 text-sm font-semibold">{review.author}</footer>
					</blockquote>
				))
			}
		</div>

		<div class="mt-12 flex flex-wrap justify-center gap-3">
			<a
				href={BUSINESS.reservasUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-primary gap-2 rounded-full"
			>
				<i class="ri-calendar-check-line"></i>
				Reservar mesa
			</a>
			<a
				href={BUSINESS.instagram}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-outline gap-2 rounded-full"
			>
				<i class="ri-instagram-line"></i>
				Ver más en Instagram
			</a>
		</div>
	</div>
</section>
