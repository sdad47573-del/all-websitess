---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import terraza from '../assets/fotos/restaurant-la-bufalina-vertical-01.jpg';
import carta from '../assets/fotos/restaurant-la-bufalina-vertical-02.jpg';
import fachada from '../assets/fotos/restaurant-la-bufalina-vertical-03.jpg';
import burrata from '../assets/fotos/restaurant-la-bufalina-apaisada-04.jpg';
import piadina from '../assets/fotos/restaurant-la-bufalina-apaisada-05.jpg';
import burrataTabla from '../assets/fotos/restaurant-la-bufalina-vertical-06.jpg';
import prosciutto from '../assets/fotos/restaurant-la-bufalina-vista-7-07.jpg';
import jamon from '../assets/fotos/restaurant-la-bufalina-vertical-08.jpg';
import margherita from '../assets/fotos/restaurant-la-bufalina-vista-9-09.jpg';
import terrazaCalle from '../assets/fotos/restaurant-la-bufalina-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Restaurant la Bufalina, pizzería italiana en Passeig de Vara de Rey, 13 (Eivissa). Pizza al horno, ensaladas, bowls y piadinas, con terraza y servicio a domicilio. Tel. 971 30 28 94.';

const galeria = [
	{
		src: terraza,
		alt: 'Terraza de la Bufalina con sombrillas blancas, farolillos de bambú y sillas de mimbre en Passeig de Vara de Rey',
	},
	{
		src: terrazaCalle,
		alt: 'Fachada amarilla de la Bufalina con el toldo verde y mesas en la acera de Vara de Rey',
	},
	{
		src: fachada,
		alt: 'Entrada de la Bufalina con el rótulo «Pizza & Fresh Food», la carta en el escaparate y un cajero automático al lado',
	},
	{
		src: carta,
		alt: 'Carta de la Bufalina en el escaparate, con las Maxi Ensaladas, las Maxi Bowls y las pizzas',
	},
	{
		src: margherita,
		alt: 'Pizza margherita con tomate, mozzarella y hojas de albahaca sobre una tabla de madera',
	},
	{
		src: burrata,
		alt: 'Pizza con burrata, prosciutto, rúcula y aceite de oliva en una tabla de madera',
	},
	{
		src: burrataTabla,
		alt: 'Pizza con burrata, prosciutto, tomate cherry y rúcula servida en tabla',
	},
	{
		src: prosciutto,
		alt: 'Pizza con prosciutto, burrata, tomate seco y albahaca vista de cerca',
	},
	{
		src: jamon,
		alt: 'Pizza con jamón, champiñones, alcachofas y mozzarella en su caja de cartón',
	},
	{
		src: piadina,
		alt: 'Piadina de fiambre y ensalada cortada por la mitad, con una cerveza en la mesa',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#la-bufalina`,
	name: BUSINESS.name,
	alternateName: ['La Bufalina', 'Bufalina Ibiza', 'Pizzería La Bufalina', 'La Bufalina Eivissa'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 971 30 28 94',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Italiana', 'Pizza', 'Mediterránea'],
	areaServed: [
		{ '@type': 'City', name: 'Eivissa' },
		{ '@type': 'AdministrativeArea', name: 'Ibiza' },
		{ '@type': 'AdministrativeArea', name: 'Islas Baleares' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '11:00',
			closes: '01:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Bucle magnético asistencial',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'La Bufalina · Pizzería italiana en Vara de Rey, Ibiza';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#b23a2f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Bufalina, pizzeria Ibiza, pizza Ibiza centro, Vara de Rey, comer pizza Eivissa, pizzería italiana Ibiza, pizza a domicilio Ibiza, ensaladas y bowls Ibiza"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="La Bufalina · Pizzería italiana en Vara de Rey, Ibiza"
			ogDescription="Pizza italiana, ensaladas, bowls y piadinas en Passeig de Vara de Rey, 13 (Eivissa), con terraza. Para llevar y a domicilio. Tel. 971 30 28 94."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Pizza con burrata, prosciutto y rúcula de la Bufalina"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#b23a2f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-IB"
			postalCode={BUSINESS.postalCode}
			phone="+34971302894"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			preload={[terraza]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Bufalina"
			subtitle="Pizzería italiana · Eivissa"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Passeig de Vara de Rey, 13 · Eivissa"
				title="Pizza italiana<br /><em>en Vara de Rey.</em>"
				lede={`La Bufalina es una pizzería italiana en Passeig de Vara de Rey, 13, en el centro de Eivissa. Terraza con sombrillas y farolillos de bambú, pizzas al horno con burrata, prosciutto y rúcula, margherita clásica, ensaladas, bowls y piadinas. Google la presenta como «la mejor pizzería de Ibiza, ganadora del premio Eccellenze Italiane 2021-2022». Abre todos los días de 11:00 a 01:00 y sirve para llevar y a domicilio. Teléfono: ${BUSINESS.phoneDisplay}.`}
				image={terraza}
				imageAlt="Terraza de la Bufalina con sombrillas blancas, farolillos de bambú y sillas de mimbre en Passeig de Vara de Rey"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)` },
					{ label: 'Cocina', html: 'Italiana · pizzería y fresh food' },
					{ label: 'Horario', html: 'Todos los días · 11:00–01:00' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Restaurant la Bufalina" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una pizzería<br /><em>de acera y mantel.</em>"
				paragraphs={[
					'La Bufalina está en Passeig de Vara de Rey, 13, en pleno centro de Eivissa, en una casa amarilla con balcones de forja. El rótulo de la fachada dice «La Bufalina · Pizza & Fresh Food», y la carta está expuesta en el escaparate y en el toldo verde de la terraza.',
					'La descripción de su ficha de Google lo presenta así: «la mejor pizzería de Ibiza, ganadora del premio Eccellenze Italiane 2021-2022. Desde hace 10 años, excelente pizza, excelente servicio, excelente ambiente». Google la clasifica como restaurante, restaurante italiano, pizzería, restaurante mediterráneo, comida a domicilio y comida para llevar.',
					'La terraza ocupa la acera bajo sombrillas blancas, con farolillos de bambú y sillas de mimbre. Dentro hay mesas altas y una vitrina con la carta. Abre todos los días de 11:00 a 01:00.',
					'En las fotos del perfil aparecen la margherita con albahaca, las pizzas con burrata, prosciutto y rúcula, la pizza con prosciutto, tomate seco y albahaca, la de jamón, champiñones y alcachofas, una pizza en su caja de cartón y una piadina de fiambre y ensalada. La carta de la puerta anuncia las Maxi Ensaladas y las Maxi Bowls. Google le da 4,5 sobre 5 con 2.905 reseñas.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google. Una de ellas: «${REVIEWS[0]}»`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Pedir: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Pizza al horno<br /><em>y fresh food.</em>"
				description="La ficha de Google no publica precios: esto es lo que aparece en las fotos del perfil, en la carta de la puerta y en la descripción del negocio."
				cta={{ label: `Pedir: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Los precios están en la carta de la puerta y en la ficha de Google. Llama al 971 30 28 94 para pedir para llevar o a domicilio."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La terraza,<br /><em>la masa y la burrata.</em>"
				description="Estas fotografías proceden del perfil de Restaurant la Bufalina en Google Maps: la terraza de Vara de Rey, la fachada, la carta, la margherita, las pizzas con burrata y prosciutto, la pizza de jamón y alcachofas y la piadina."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Te esperamos<br /><em>en Vara de Rey.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario de la ficha de Google: todos los días de 11:00 a 01:00, sin día de cierre. Para pedidos grandes conviene llamar con antelación."
				mapTitle="Mapa de Restaurant la Bufalina en Passeig de Vara de Rey, Eivissa"
				mapEmbedUrl={MAPS.embed}
				mapLabel="La Bufalina · Eivissa"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 971 30 28 94. Por teléfono también se encargan los pedidos para llevar y a domicilio. La ficha marca acceso para sillas de ruedas, aparcamiento adaptado, aseo adaptado, asientos adaptados y bucle magnético."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes del pedido."
			ctaLabel="Pedir en la Bufalina"
		/>
	</body>
</html>
