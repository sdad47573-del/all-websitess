---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import curryNaan from '../assets/fotos/sonar-bangla-vista-3-03.jpg';
import tikkaChana from '../assets/fotos/sonar-bangla-vertical-02.jpg';
import papadums from '../assets/fotos/sonar-bangla-apaisada-06.jpg';
import samosa from '../assets/fotos/sonar-bangla-vertical-09.jpg';
import haleem from '../assets/fotos/sonar-bangla-vertical-08.jpg';
import cartaFoto from '../assets/fotos/sonar-bangla-vertical-04.jpg';
import comedorRojo from '../assets/fotos/sonar-bangla-apaisada-01.jpg';
import comedorVerde from '../assets/fotos/sonar-bangla-apaisada-10.jpg';
import terrazaNoche from '../assets/fotos/sonar-bangla-vertical-07.jpg';
import fachada from '../assets/fotos/sonar-bangla-apaisada-05.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Sonar Bangla, restaurante indio y bangladesí en la Rua do Benformoso 262 (1100-084 Lisboa, Mouraria): biryani desde 7,95 €, arroces, pescado con arroz, samosas y chá desi. 4,4 en Google con 758 reseñas. Tel. 920 374 334.';

const galeria = [
	{
		src: curryNaan,
		alt: 'Curri de carne en karahi de metal con cilantro y naan recién hecho en Sonar Bangla, Lisboa',
	},
	{
		src: tikkaChana,
		alt: 'Pollo tikka masala con nata y chana masala de garbanzos en la mesa de Sonar Bangla',
	},
	{
		src: papadums,
		alt: 'Papadums crujientes con tres chutneys (menta, tamarindo y picante) sobre mantel de cuadros',
	},
	{
		src: samosa,
		alt: 'Samosa triangular de masa fina sobre cama de lechuga, servida en Sonar Bangla',
	},
	{
		src: haleem,
		alt: 'Cuenco de haleem de lentejas con cebolla frita y cilantro, con paratha al fondo',
	},
	{
		src: cartaFoto,
		alt: 'Tarjeta de la carta de Sonar Bangla con los precios de biryani, arroces y pescado con arroz',
	},
	{
		src: comedorRojo,
		alt: 'Comedor de Sonar Bangla con paredes rojas, verdes y amarillas y mesas con servilletas azules',
	},
	{
		src: comedorVerde,
		alt: 'Sala amplia de Sonar Bangla con paredes verdes, lámparas de araña y mesas vestidas',
	},
	{
		src: terrazaNoche,
		alt: 'Mesa con mantel de cuadros en la terraza de Sonar Bangla, en una calle empedrada de noche',
	},
	{
		src: fachada,
		alt: 'Fachada con el cartel verde de Ghoroa Restaurante Indiano, imagen del perfil de Sonar Bangla',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['Sonar Bangla Restaurante', 'Sonar Bangla Lisboa'],
	slogan: 'Cocina de Bangladesh y de la India en la Mouraria',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 920 374 334',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Bangladesí', 'India', 'Halal'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Área Metropolitana de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '09:00',
			closes: '23:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	hasMenu: {
		'@type': 'Menu',
		name: 'Carta de Sonar Bangla',
		hasMenuSection: MENU.filter((grupo) => grupo.items.some((item) => item.price)).map(
			(grupo) => ({
				'@type': 'MenuSection',
				name: grupo.title,
				hasMenuItem: grupo.items
					.filter((item) => item.price)
					.map((item) => ({
						'@type': 'MenuItem',
						name: item.name,
						description: item.note,
						offers: {
							'@type': 'Offer',
							price: Number(item.price.replace(',', '.').replace(' €', '')).toFixed(2),
							priceCurrency: 'EUR',
						},
					})),
			}),
		),
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Sonar Bangla · Cocina de Bangladesh en la Mouraria, Lisboa';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#12513c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Mulish:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Sonar Bangla Lisboa, restaurante bangladesí Lisboa, restaurante indio Mouraria, biryani Lisboa, Rua do Benformoso, curry Intendente, restaurante halal Lisboa, Sonar Bangla Mouraria"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Sonar Bangla · Cocina de Bangladesh en la Mouraria, Lisboa"
			ogDescription="Biryani desde 7,95 €, arroces, pescado con arroz, samosas y chá desi, todos los días de 9:00 a 23:30. 4,4 en Google con 758 reseñas. Tel. 920 374 334."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Curri de carne con naan en Sonar Bangla, Lisboa"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#12513c"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone="+351920374334"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.regionName}`}
			countryName="Portugal"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				phone: '+351 920 374 334',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[papadums]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Bangladesh e India · Mouraria"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="R. do Benformoso, 262 · Mouraria · Lisboa"
				title="Cocina de Bangladesh<br /><em>en la Mouraria.</em>"
				lede="Sonar Bangla es un restaurante de barrio en la Rua do Benformoso, la calle de los curris de Lisboa, entre el Intendente y Alfama. Biryani, arroces especiados, pescado con arroz y entrantes de la casa, con una tarjeta que no ha subido de los 8 € en el biryani de pollo. Abre todos los días, de la mañana a la noche."
				image={papadums}
				imageAlt="Papadums crujientes con tres chutneys (menta, tamarindo y picante) en la mesa de Sonar Bangla"
				primaryCta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Indio y bangladesí"
				facts={[
					{ label: 'Nota', html: '<b>4,4 en Google</b> con 758 reseñas' },
					{ label: 'Horario', html: '<b>Todos los días</b> 9:00 – 23:30' },
					{ label: 'Biryani', html: '<b>Desde 7,95 €</b> el de pollo' },
					{ label: 'Dónde', html: '<b>Mouraria</b>, junto al Intendente' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Sonar Bangla" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="La Rua do Benformoso,<br /><em>un viaje a Dhaka.</em>"
				paragraphs={[
					'La Rua do Benformoso es la calle de los curris de Lisboa: en pocos metros se encadenan los restaurantes bangladesíes e indios que atienden a la comunidad que vive entre la Mouraria y el Intendente. Sonar Bangla está en el número 262, en una sala con manteles de cuadros y sillas rojas, y también en una terraza que se monta en la propia calle empedrada.',
					'La carta se lee en tres bloques claros: biryani de pollo, ternera, cordero, verduras, gambas o mixto; arroces desde el blanco de 2,00 € al pilau o el de coco; y pescado con arroz, de la carpa ruhi al salmón. Las reseñas de Google añaden el resto: samosas de carne, aloo shingara, fiyaji, khala channa, sheikh kabab, bhuna beef, haleem con paratha y un chá desi para terminar.',
					'No es un sitio de mantel largo ni de carta infinita: es un comedor de barrio, con un gasto ajustado y raciones pensadas para compartir el arroz y el curri en el centro de la mesa. Con 758 reseñas y un 4,4, la cocina sale mejor parada que el servicio en las opiniones, que van de la atención excelente a la más fría.',
				]}
				note="En su propia ficha de Google el local ha dejado escrita la nota «RESTAURANT TRANSFER ON ANOTHER PLACE», que anuncia un traslado a otro local. La web mantiene la dirección y el teléfono que publica esa ficha; si vas a ir, llama antes para confirmar."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Biryani,<br />arroces<br /><em>y pescado con arroz.</em>"
				description="Los precios de esta carta son los de la tarjeta de la casa que aparece fotografiada en la galería de su ficha de Google Maps. Los platos del último bloque no llevan precio publicado."
				cta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La ficha no publica una carta completa con precios: esta sale de la tarjeta fotografiada en su galería y de los platos que citan las reseñas. Los precios de la tarjeta pueden haber cambiado desde que se hizo la foto, así que confírmalos al llamar al 920 374 334. En el local se acepta efectivo y tarjeta según la práctica habitual del barrio; pregunta si necesitas pagar con tarjeta."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Curris,<br />comedor<br /><em>y terraza.</em>"
				description="Estas fotografías proceden del perfil de Sonar Bangla en Google Maps: el curri en karahi con naan, el pollo tikka masala con chana masala, los papadums con sus tres chutneys, la samosa, el haleem, la tarjeta de la carta, las dos salas del comedor, la terraza de noche y la fachada."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="R. do Benformoso, 262 · 1100-084 Lisboa"
				title="En la Mouraria,<br /><em>abierto todo el día.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Mouraria · Intendente',
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="Abre todos los días de 9:00 a 23:30, también domingos, con cocina continua. En festivos la ficha avisa de que el horario podría cambiar, así que llama antes si vas en una fecha señalada."
				mapTitle="Mapa de Sonar Bangla en la Rua do Benformoso, 262, Lisboa"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Sonar Bangla · Lisboa"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se llama al 920 374 334. La ficha marca acceso para sillas de ruedas, pero no confirma aseo adaptado. La terraza está en la propia calle, con manteles de cuadros, y es lo que más se ve en las fotos nocturnas."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, platos y precios antes de la visita."
			ctaLabel="Llamar a Sonar Bangla"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
