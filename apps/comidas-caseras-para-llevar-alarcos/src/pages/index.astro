---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import mostrador from '../assets/fotos/comidas-caseras-para-llevar-alarcos-apaisada-01.jpg';
import arrozPollo from '../assets/fotos/comidas-caseras-para-llevar-alarcos-apaisada-04.jpg';
import fideos from '../assets/fotos/comidas-caseras-para-llevar-alarcos-apaisada-05.jpg';
import berenjena from '../assets/fotos/comidas-caseras-para-llevar-alarcos-apaisada-09.jpg';
import ensaladilla from '../assets/fotos/comidas-caseras-para-llevar-alarcos-apaisada-02.jpg';
import bandejas from '../assets/fotos/comidas-caseras-para-llevar-alarcos-vertical-03.jpg';
import pollo from '../assets/fotos/comidas-caseras-para-llevar-alarcos-vertical-06.jpg';
import pescado from '../assets/fotos/comidas-caseras-para-llevar-alarcos-vertical-07.jpg';
import croquetas from '../assets/fotos/comidas-caseras-para-llevar-alarcos-vertical-08.jpg';
import codillo from '../assets/fotos/comidas-caseras-para-llevar-alarcos-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Alarcos · Comida casera para llevar en Ciudad Real';
const description =
	'Comidas Caseras Alarcos, en C. de Alarcos, 28 (13001 Ciudad Real). Menús caseros, pollo asado y codillo en salsa de cebollitas. De 12:00 a 15:30, de martes a sábado.';

const galeria = [
	{
		src: mostrador,
		alt: 'El mostrador de Comidas Caseras Alarcos con bandejas de arroz negro, fideos con verduras, pasta gratinada y arroz amarillo',
	},
	{
		src: arrozPollo,
		alt: 'Una bandeja de aluminio con arroz amarillo, trozos de pollo, pimiento y guisantes',
	},
	{
		src: codillo,
		alt: 'Dos piezas de codillo en salsa oscura dentro de una bandeja de aluminio',
	},
	{
		src: bandejas,
		alt: 'Dos bandejas de comida para llevar sobre una mesa de obra: carne en salsa con patatas y patatas con bacon',
	},
	{
		src: pollo,
		alt: 'Pollo troceado en su jugo con hierbas en una bandeja de aluminio',
	},
	{
		src: berenjena,
		alt: 'Media berenjena rellena de carne y tomate, gratinada con queso, en un plato blanco',
	},
	{
		src: ensaladilla,
		alt: 'Una bandeja de aluminio con ensaladilla de patata y palitos de cangrejo',
	},
	{
		src: fideos,
		alt: 'Una bandeja de aluminio con fideos salteados con champiñones y tomate',
	},
	{
		src: croquetas,
		alt: 'Croquetas empanadas apiladas en una bandeja azul, listas para freír',
	},
	{
		src: pescado,
		alt: 'Filetes de pescado rebozado y frito, apilados en una bandeja de acero',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#alarcos`,
	name: BUSINESS.fullName,
	alternateName: ['Comidas Caseras Alarcos', 'Alarcos Ciudad Real', 'Comidas caseras para llevar Alarcos'],
	description:
		'Comida casera para llevar en la calle de Alarcos, 28 (13001 Ciudad Real): menús del día, pollo asado, codillo en salsa de cebollitas y guisos en bandeja.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34601622722',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina casera', 'Cocina manchega', 'Comida para llevar'],
	hasMenu: {
		'@type': 'Menu',
		name: 'Comida casera de Alarcos',
		inLanguage: 'es-ES',
		hasMenuSection: MENU.map((group) => ({
			'@type': 'MenuSection',
			name: group.title,
			hasMenuItem: group.items.map((item) => ({
				'@type': 'MenuItem',
				name: item.name,
				description: item.note,
			})),
		})),
	},
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '12:00',
			closes: '15:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"comidas-caseras-para-llevar-alarcos-apaisada-01.jpg": mostrador,
	"comidas-caseras-para-llevar-alarcos-apaisada-04.jpg": arrozPollo,
	"comidas-caseras-para-llevar-alarcos-vertical-10.jpg": codillo,
	"comidas-caseras-para-llevar-alarcos-vertical-03.jpg": bandejas,
	"comidas-caseras-para-llevar-alarcos-vertical-06.jpg": pollo,
	"comidas-caseras-para-llevar-alarcos-apaisada-09.jpg": berenjena,
	"comidas-caseras-para-llevar-alarcos-apaisada-02.jpg": ensaladilla,
	"comidas-caseras-para-llevar-alarcos-apaisada-05.jpg": fideos,
	"comidas-caseras-para-llevar-alarcos-vertical-08.jpg": croquetas,
	"comidas-caseras-para-llevar-alarcos-vertical-07.jpg": pescado,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#3f4a2a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;500;700&family=Work+Sans:wght@400;600;700&family=Caveat:wght@600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Comidas Caseras Alarcos, comida casera para llevar Ciudad Real, menú del día Ciudad Real, pollo asado Ciudad Real, codillo en salsa, calle Alarcos 28, 13001"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Menús caseros, pollo asado y codillo en salsa de cebollitas para llevar en la calle de Alarcos, 28, Ciudad Real. De 12:00 a 15:30, de martes a sábado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bandejas de comida casera de Comidas Caseras Alarcos, en Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#3f4a2a"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[mostrador]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Alarcos"
			subtitle="Comidas caseras · Ciudad Real"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultados en noviembre de 2026. La ficha no publica carta con precios: confirma el menú y el horario antes de ir."
			ctaLabel="Llamar a Alarcos"
			navAriaLabel="Enlaces de Comidas Caseras Alarcos"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34601622722?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Comida%20casera%20de%20Alarcos." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Comida casera de Alarcos"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
