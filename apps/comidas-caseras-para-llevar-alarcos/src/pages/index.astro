---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import mostrador from '../assets/fotos/comidas-caseras-para-llevar-alarcos-apaisada-01.jpg';
import arrozPollo from '../assets/fotos/comidas-caseras-para-llevar-alarcos-apaisada-04.jpg';
import fideos from '../assets/fotos/comidas-caseras-para-llevar-alarcos-apaisada-05.jpg';
import berenjena from '../assets/fotos/comidas-caseras-para-llevar-alarcos-apaisada-09.jpg';
import ensaladilla from '../assets/fotos/comidas-caseras-para-llevar-alarcos-apaisada-02.jpg';
import bandejas from '../assets/fotos/comidas-caseras-para-llevar-alarcos-vertical-03.jpg';
import pollo from '../assets/fotos/comidas-caseras-para-llevar-alarcos-vertical-06.jpg';
import pescado from '../assets/fotos/comidas-caseras-para-llevar-alarcos-vertical-07.jpg';
import croquetas from '../assets/fotos/comidas-caseras-para-llevar-alarcos-vertical-08.jpg';
import codillo from '../assets/fotos/comidas-caseras-para-llevar-alarcos-vertical-10.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Alarcos · Comida casera para llevar en Ciudad Real';
const description =
	'Comidas Caseras Alarcos, en C. de Alarcos, 28 (13001 Ciudad Real). Menús caseros, pollo asado y codillo en salsa de cebollitas. De 12:00 a 15:30, de martes a sábado.';

const galeria = [
	{
		src: mostrador,
		alt: 'El mostrador de Comidas Caseras Alarcos con bandejas de arroz negro, fideos con verduras, pasta gratinada y arroz amarillo',
	},
	{
		src: arrozPollo,
		alt: 'Una bandeja de aluminio con arroz amarillo, trozos de pollo, pimiento y guisantes',
	},
	{
		src: codillo,
		alt: 'Dos piezas de codillo en salsa oscura dentro de una bandeja de aluminio',
	},
	{
		src: bandejas,
		alt: 'Dos bandejas de comida para llevar sobre una mesa de obra: carne en salsa con patatas y patatas con bacon',
	},
	{
		src: pollo,
		alt: 'Pollo troceado en su jugo con hierbas en una bandeja de aluminio',
	},
	{
		src: berenjena,
		alt: 'Media berenjena rellena de carne y tomate, gratinada con queso, en un plato blanco',
	},
	{
		src: ensaladilla,
		alt: 'Una bandeja de aluminio con ensaladilla de patata y palitos de cangrejo',
	},
	{
		src: fideos,
		alt: 'Una bandeja de aluminio con fideos salteados con champiñones y tomate',
	},
	{
		src: croquetas,
		alt: 'Croquetas empanadas apiladas en una bandeja azul, listas para freír',
	},
	{
		src: pescado,
		alt: 'Filetes de pescado rebozado y frito, apilados en una bandeja de acero',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#alarcos`,
	name: BUSINESS.fullName,
	alternateName: ['Comidas Caseras Alarcos', 'Alarcos Ciudad Real', 'Comidas caseras para llevar Alarcos'],
	description:
		'Comida casera para llevar en la calle de Alarcos, 28 (13001 Ciudad Real): menús del día, pollo asado, codillo en salsa de cebollitas y guisos en bandeja.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34601622722',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina casera', 'Cocina manchega', 'Comida para llevar'],
	hasMenu: {
		'@type': 'Menu',
		name: 'Comida casera de Alarcos',
		inLanguage: 'es-ES',
		hasMenuSection: MENU.map((group) => ({
			'@type': 'MenuSection',
			name: group.title,
			hasMenuItem: group.items.map((item) => ({
				'@type': 'MenuItem',
				name: item.name,
				description: item.note,
			})),
		})),
	},
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '12:00',
			closes: '15:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La comida', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#3f4a2a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;500;700&family=Work+Sans:wght@400;600;700&family=Caveat:wght@600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Comidas Caseras Alarcos, comida casera para llevar Ciudad Real, menú del día Ciudad Real, pollo asado Ciudad Real, codillo en salsa, calle Alarcos 28, 13001"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Menús caseros, pollo asado y codillo en salsa de cebollitas para llevar en la calle de Alarcos, 28, Ciudad Real. De 12:00 a 15:30, de martes a sábado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bandejas de comida casera de Comidas Caseras Alarcos, en Ciudad Real"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#3f4a2a"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[mostrador]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Alarcos"
			subtitle="Comidas caseras · Ciudad Real"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. de Alarcos, 28 · Ciudad Real"
				title="Comida casera, <br /><em>para llevar.</em>"
				lede={`En la calle de Alarcos, a un paso del centro de Ciudad Real, este local lleva años llenando bandejas: arroces, fideos, guisos, pollo asado y codillo en salsa de cebollitas. Abre de 12:00 a 15:30 de martes a sábado y tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={mostrador}
				imageAlt="El mostrador de bandejas de Comidas Caseras Alarcos en Ciudad Real"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>12:00–15:30</b> · martes a sábado' },
					{ label: 'Especialidad', html: '<b>Menús</b><br />caseros' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Comida para llevar"
			/>

			<LocalChips label="Lo que ofrece Alarcos" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="El menú de casa, <br /><em>en una bandeja.</em>"
				paragraphs={[
					'Comidas Caseras Alarcos está en el número 28 de la calle de Alarcos, en Ciudad Real. El local trabaja como restaurante de comida para llevar: una batería de bandejas de acero en el mostrador, y detrás la cocina sacando arroces, guisos y fritos a lo largo de la mañana.',
					'En las fotos del perfil se ve el mostrador al completo: una bandeja de pasta gratinada con la bechamel dorada, arroz negro, fideos con verduras, arroz amarillo y fideos finos tostados. Es la carta real del día, la que se va reponiendo según se vacía.',
					'La carne llega en bandejas de aluminio: pollo troceado en su jugo con hierbas, carne en salsa con patatas, codillo cubierto de una salsa oscura y brillante —el que elogia una de las reseñas, «en salsa de cebollitas»—, berenjena rellena gratinada y filetes de pescado rebozado. También hay croquetas empanadas y ensaladilla de patata con palitos de cangrejo.',
					'La ficha no tiene descripción escrita por el negocio ni enlaza web o redes, así que lo que se cuenta aquí sale de la propia ficha y de su galería. Las opiniones que Google pone en portada son dos, ambas de cinco estrellas: una habla del precio de los menús y del tamaño de las raciones; la otra, del pollo asado y del codillo.',
					`Con ${RATING.count} reseñas y una media de ${RATING.label}, es uno de los locales de comida para llevar más comentados de la zona. Conviene llamar por la mañana: el menú cambia cada día y las bandejas se acaban.`,
				]}
				note="La ficha no publica carta con precios ni reparto a domicilio, y no indica mesas para comer en el local. Tampoco detalla accesibilidad, salvo que no hay asientos adaptados para sillas de ruedas. El menú de cada día se pregunta en el 601 62 27 22."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que se lleva la gente</p>
					<h2 id="highlights-title">Bandeja llena, <br /><em>precio de casa.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La comida"
				title="Lo que sale <br /><em>del mostrador.</em>"
				description="Platos tomados de las dos reseñas destacadas y de las bandejas que aparecen en las fotos del perfil. La ficha no publica carta ni precios, así que aquí no hay importes."
				cta={{ label: `Preguntar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La lista cambia cada día y se va reponiendo por tandas. El menú, los precios y lo que queda a esa hora se preguntan en el 601 62 27 22."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El mostrador <br /><em>y las bandejas.</em>"
				description="Diez fotografías del perfil del local: el mostrador con las bandejas, el arroz con pollo, el codillo en salsa, la carne en salsa con patatas, el pollo en su jugo, la berenjena rellena, la ensaladilla, los fideos con champiñones, las croquetas y el pescado rebozado."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,5 sobre 5, <em>con 184 reseñas.</em></h2>
						<p>
							Google publica una media de 4,5 con 184 opiniones (noviembre de 2026). Las dos
							que la ficha destaca son de cinco estrellas y hablan de dos cosas muy concretas:
							el precio de los menús con raciones abundantes, y el pollo asado con el codillo en
							salsa de cebollitas. Hay más opiniones en Google.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,5</strong>
						<span>★★★★★</span>
						<small>184 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En la calle <br /><em>de Alarcos.</em>"
				addressLines={[BUSINESS.street, BUSINESS.postalCode, `${BUSINESS.district}, ${BUSINESS.region}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha: de 12:00 a 15:30, de martes a sábado, con lunes y domingo cerrados. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Comidas Caseras Alarcos en la calle de Alarcos, 28, Ciudad Real"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. de Alarcos, 28 · Ciudad Real"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote={`Pedidos por teléfono en el ${BUSINESS.phone} y recogida en el local. La ficha no anuncia reparto a domicilio ni formas de pago, y solo detalla que no hay asientos adaptados para sillas de ruedas.`}
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>llamar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultados en noviembre de 2026. La ficha no publica carta con precios: confirma el menú y el horario antes de ir."
			ctaLabel="Llamar a Alarcos"
			navAriaLabel="Enlaces de Comidas Caseras Alarcos"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
