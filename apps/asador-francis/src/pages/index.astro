---
import '../styles/global.css';
import { LocalSeo } from '@astro-components';
import { Image } from 'astro:assets';

import horno from '../assets/fotos/asador-francis-vertical-02.jpg';
import fachada from '../assets/fotos/asador-francis-apaisada-04.jpg';
import polloPatatas from '../assets/fotos/asador-francis-apaisada-03.jpg';
import tortillas from '../assets/fotos/asador-francis-vertical-06.jpg';
import cocina from '../assets/fotos/asador-francis-apaisada-05.jpg';
import brocheta from '../assets/fotos/asador-francis-vertical-08.jpg';
import pollo from '../assets/fotos/asador-francis-apaisada-07.jpg';
import costillas from '../assets/fotos/asador-francis-vertical-10.jpg';
import cola from '../assets/fotos/asador-francis-apaisada-01.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS } from '../data/site';

const title = 'Asador Francis · Pollo asado y comida casera en Cruz de Humilladero, Málaga';
const description =
	'Asador de pollos y comida casera Francis, en Carril de Santa Rosa, 2 (Cruz de Humilladero, 29010 Málaga). Pollo asado, menús y guisos, de miércoles a domingo de 9:30 a 16:30. 4,7 sobre 5 con 211 reseñas.';

const galeria = [
	{
		src: polloPatatas,
		alt: 'Pollo asado entero en una bandeja de aluminio junto a otra bandeja de patatas fritas con salsa blanca',
		caption: 'Pollo asado y patatas',
		className: 'gallery-a',
	},
	{
		src: tortillas,
		alt: 'Dos tortillas cuajadas en sartén grande, en bandejas de aluminio, junto a una fuente de pasta',
		caption: 'Tortillas de la vitrina',
		className: 'gallery-b',
	},
	{
		src: cocina,
		alt: 'Cocina de Asador Francis con dos hornos asadores, una plancha y el puesto de trabajo',
		caption: 'El horno doble y la plancha',
		className: 'gallery-c',
	},
	{
		src: brocheta,
		alt: 'Plato de brocheta con patatas, queso rallado y cebolla morada junto a un vaso de vino tinto',
		caption: 'Brocheta con patatas',
		className: 'gallery-d',
	},
	{
		src: costillas,
		alt: 'Costillas asadas con patatas en bandejas de aluminio sobre la vitrina del local',
		caption: 'Costillas y patatas',
		className: 'gallery-e',
	},
	{
		src: pollo,
		alt: 'Un pollo asado entero en una bandeja metálica, recién sacado del horno',
		caption: 'Un pollo entero',
		className: 'gallery-f',
	},
	{
		src: cola,
		alt: 'Fachada de Asador Francis con clientes esperando en la acera al mediodía',
		caption: 'La cola del mediodía',
		className: 'gallery-g',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Lo que sale del asador',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#asador-francis`,
	name: BUSINESS.fullName,
	alternateName: ['Asador Francis', 'Francis Málaga', 'Asador de pollos Francis'],
	description:
		'Asador de pollos y comida casera en Carril de Santa Rosa, 2, Cruz de Humilladero (29010 Málaga). Pollo asado, brochetas, costillas, tortillas y guisos de mediodía.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34951994936',
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Pollo asado', 'Comida casera', 'Cocina andaluza'],
	hasMenu: menuSchema,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '09:30',
			closes: '16:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#mostrador' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const year = new Date().getFullYear();
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#5a1d21" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador Francis Málaga, pollo asado Cruz de Humilladero, comida casera Málaga, Carril de Santa Rosa, asador de pollos Málaga, menú del día Málaga, brochetas, costillas asadas, tortilla de patatas"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado, comida casera y menús en Carril de Santa Rosa, 2. De miércoles a domingo, de 9:30 a 16:30."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Pollo asado entero con patatas fritas de Asador Francis"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#5a1d21"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[horno]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<div class="topline">
			<div class="wrap topline-inner">
				<p>Carril de Santa Rosa, 2 · Cruz de Humilladero</p>
				<p class="topline-hours">Miércoles a domingo · 9:30–16:30</p>
				<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
			</div>
		</div>

		<header class="site-header" id="inicio">
			<div class="wrap header-inner">
				<a class="brand" href="#inicio" aria-label="Asador Francis, inicio">
					<span class="brand-stamp" aria-hidden="true">F</span>
					<span class="brand-name">Asador <strong>Francis</strong></span>
				</a>
				<nav class="site-nav" aria-label="Navegación principal">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="header-call" href={BUSINESS.phoneHref}>
					<span aria-hidden="true">☎</span> {BUSINESS.phone}
				</a>
			</div>
			<nav class="mobile-nav wrap" aria-label="Navegación principal en móvil">
				{nav.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
		</header>

		<main id="contenido">
			<section class="hero" aria-labelledby="hero-title">
				<p class="hero-word" aria-hidden="true">Francis</p>
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Asador de pollos y comida casera</p>
						<h1 id="hero-title" set:html={piezas.portada.titulo} />
						<p class="hero-lede">
							No es una forma de hablar: en la foto de la fachada hay gente esperando en la acera.
							En este asador de Cruz de Humilladero el mediodía sabe a pollo al horno, comida
							casera y menús. De miércoles a domingo, de 9:30 a 16:30.
						</p>
						<div class="hero-actions">
							<a class="btn btn-primary" href={BUSINESS.phoneHref}>
								Llamar · {BUSINESS.phone}
							</a>
							<a class="btn btn-ghost" href={MAPS.directions} target="_blank" rel="noreferrer">
								Cómo llegar <span aria-hidden="true">↗</span>
							</a>
						</div>
						<ul class="hero-facts">
							<li>
								<strong>{RATING.label}</strong>
								<span>sobre 5 · {RATING.count} reseñas</span>
							</li>
							<li>
								<strong>9:30–16:30</strong>
								<span>miércoles a domingo</span>
							</li>
							<li>
								<strong>Carril Sta. Rosa, 2</strong>
								<span>Cruz de Humilladero</span>
							</li>
						</ul>
					</div>

					<figure class="hero-figure">
						<div class="hero-frame">
							<Image
								src={horno}
								alt="Interior del horno asador de Asador Francis con varias bandejas de pollos enteros asándose"
								widths={[520, 760, 1080]}
								sizes="(max-width: 880px) 92vw, 42vw"
								loading="eager"
								fetchpriority="high"
							/>
							<span class="hero-sticker" aria-hidden="true">
								<small>Del horno</small>
								<strong>al mediodía</strong>
							</span>
						</div>
						<figcaption>
							El horno, con los pollos en los pinchos.
							<span>Foto del perfil de Google Maps</span>
						</figcaption>
					</figure>
				</div>
			</section>

			<div class="marquee" aria-hidden="true">
				<div class="marquee-track">
					<span>Pollo asado</span><span>·</span><span>Comida casera</span><span>·</span><span>Menús del día</span><span>·</span><span>Cruz de Humilladero</span><span>·</span>
					<span>Pollo asado</span><span>·</span><span>Comida casera</span><span>·</span><span>Menús del día</span><span>·</span><span>Cruz de Humilladero</span><span>·</span>
				</div>
			</div>

			<section class="about" id="casa" aria-labelledby="about-title">
				<div class="wrap">
					<div class="about-grid">
						<div class="about-intro">
							<p class="eyebrow"><span aria-hidden="true"></span> 01 — La casa</p>
							<h2 id="about-title">Un asador de barrio, <em>con la puerta abierta.</em></h2>
							<div class="about-copy">
								<p>
									El cartel de la fachada lo dice sin rodeos: «Pollo asado &amp; comidas
									caseras». Detrás del mostrador, dos hornos asadores y una plancha; delante, la
									cola del mediodía en el Carril de Santa Rosa.
								</p>
								<p>
									La ficha de Google clasifica el local como restaurante especializado en pollo y
									lo valora con 4,7 sobre 5 a partir de 211 reseñas. Una de ellas es difícil de
									superar: «Los pollos asados que más me han gustado de Málaga los he comprado
									aquí».
								</p>
								<p>
									Además del pollo, la casa es comida casera: tortillas cuajadas en sartén,
									ensaladilla, pasta, costillas y guisos. El menú del día no se publica en Google,
									así que se pregunta en el mostrador o por teléfono.
								</p>
							</div>
							<blockquote class="about-quote">
								<p>
									«Llevamos unos días probando los menús y estamos encantados.»
								</p>
								<cite>Reseña publicada en Google</cite>
							</blockquote>
						</div>

						<figure class="facade">
							<Image
								src={fachada}
								alt="Fachada de Asador Francis en Carril de Santa Rosa con el cartel de pollo asado y comidas caseras"
								widths={[480, 720, 1000]}
								sizes="(max-width: 880px) 92vw, 38vw"
							/>
							<figcaption>
								<span>El cartel de la casa</span>
								Pollo asado y comidas caseras. En la foto se leen los dos teléfonos del local:
								{BUSINESS.phone} y {BUSINESS.phoneAlt}.
							</figcaption>
						</figure>
					</div>

					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-number" aria-hidden="true">0{index + 1}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<section class="counter" id="mostrador" aria-labelledby="counter-title">
				<div class="wrap">
					<header class="section-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> 02 — Del horno y del mostrador</p>
							<h2 id="counter-title">Lo que sale <em>del asador.</em></h2>
						</div>
						<p>
							La ficha de Google no publica carta ni precios. Esto es lo que se reconoce en las
							fotos del local y lo que nombran las reseñas, sin inventar platos de la casa.
						</p>
					</header>

					<div class="counter-grid">
						<div class="menu-groups">
							{
								MENU.map((group) => (
									<div class="menu-group">
										<h3>{group.title}</h3>
										<ol>
											{group.items.map((item, index) => (
												<li class="menu-item">
													<span class="menu-index" aria-hidden="true">
														{String(index + 1).padStart(2, '0')}
													</span>
													<div>
														<h4>{item.name}</h4>
														<p>{item.note}</p>
													</div>
												</li>
											))}
										</ol>
									</div>
								))
							}
						</div>

						<aside class="counter-card" aria-labelledby="counter-card-title">
							<p class="card-kicker">Lo que hay hoy</p>
							<h3 id="counter-card-title">El menú cambia. <em>La llamada no.</em></h3>
							<p>
								La ficha no publica el menú del día ni los precios. Si quieres saber qué hay
								antes de salir de casa, llama al asador.
							</p>
							<a class="card-phone" href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
							<a class="card-alt" href={BUSINESS.phoneAltHref}>
								También en el cartel: {BUSINESS.phoneAlt}
							</a>
							<p class="card-note">
								Horario de mediodía: miércoles a domingo, de 9:30 a 16:30. Lunes y martes,
								cerrado.
							</p>
						</aside>
					</div>

					<p class="fine-print">
						Los nombres de los platos son los que se ven en las fotografías del perfil de Google y
						los que citan las reseñas. La ficha no confirma la carta completa, los ingredientes ni
						los precios. Consulta al local si tienes alguna alergia o intolerancia.
					</p>
				</div>
			</section>

			<section class="gallery" id="galeria" aria-labelledby="gallery-title">
				<div class="wrap">
					<header class="section-head section-head-light">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> 03 — La galería</p>
							<h2 id="gallery-title">El local, <em>sin filtros.</em></h2>
						</div>
						<p>
							Diez fotos públicas de la ficha, siete aquí. El horno, la vitrina, el pollo y la
							acera: lo que te vas a encontrar al llegar.
						</p>
					</header>

					<div class="gallery-grid">
						{
							galeria.map((photo) => (
								<figure class={photo.className}>
									<Image
										src={photo.src}
										alt={photo.alt}
										widths={[420, 700, 1000, 1400]}
										sizes="(max-width: 640px) 92vw, (max-width: 980px) 46vw, 55vw"
									/>
									<figcaption>{photo.caption}</figcaption>
								</figure>
							))
						}
					</div>

					<p class="gallery-credit">
						Fotografías del perfil público de {BUSINESS.fullName} en Google Maps, consultado en
						octubre de 2026.
						<a href={MAPS.place} target="_blank" rel="noreferrer">
							Ver la ficha completa <span aria-hidden="true">↗</span>
						</a>
					</p>
				</div>
			</section>

			<section class="reviews" aria-labelledby="reviews-title">
				<div class="wrap reviews-grid">
					<div class="rating-block">
						<p class="eyebrow"><span aria-hidden="true"></span> 04 — En Google</p>
						<p class="big-rating">{RATING.label}</p>
						<p class="stars" aria-label={`${RATING.label} de 5 estrellas`}>
							<span aria-hidden="true">★★★★★</span>
						</p>
						<p class="rating-count">{RATING.count} reseñas en Google</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Leer todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>

					<div class="review-list">
						<h2 id="reviews-title" class="visually-hidden">Reseñas de Asador Francis</h2>
						{
							RESENAS.map((resena, index) => (
								<blockquote class:list={['review', { 'review-lead': index === 0 }]}>
									<p>«{resena.texto}»</p>
									<footer>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
										</span>
										<cite>Reseña publicada en Google</cite>
									</footer>
								</blockquote>
							))
						}
					</div>
				</div>
			</section>

			<section class="visit" id="visitanos" aria-labelledby="visit-title">
				<div class="wrap">
					<header class="section-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> 05 — Visitar</p>
							<h2 id="visit-title">Carril de Santa Rosa, 2. <em>Miércoles a domingo.</em></h2>
						</div>
						<p>
							En pleno Cruz de Humilladero, a un paso del centro. El local abre al mediodía y
							cierra lunes y martes.
						</p>
					</header>

					<div class="visit-grid">
						<div class="visit-info">
							<div class="visit-block">
								<h3>Horario</h3>
								<table>
									<caption class="visually-hidden">Horario de Asador Francis</caption>
									<tbody>
										{
											HORARIO.map((row) => (
												<tr class:list={{ closed: row.closed }}>
													<th scope="row">{row.dia}</th>
													<td>{row.horas}</td>
												</tr>
											))
										}
									</tbody>
								</table>
								<p class="notice">{HORARIO_AVISO}</p>
							</div>

							<div class="visit-block">
								<h3>Dónde</h3>
								<address>
									<strong>{BUSINESS.street}</strong><br />
									{BUSINESS.district}<br />
									{BUSINESS.postalCode} {BUSINESS.city}
								</address>
								<p class="visit-links">
									<a href={MAPS.directions} target="_blank" rel="noreferrer">
										Cómo llegar <span aria-hidden="true">↗</span>
									</a>
									<a href={MAPS.streetView} target="_blank" rel="noreferrer">
										Vista de la calle <span aria-hidden="true">↗</span>
									</a>
								</p>
							</div>

							<div class="visit-block">
								<h3>Contacto</h3>
								<p class="visit-phone">
									<a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>
									<a href={BUSINESS.phoneAltHref}>{BUSINESS.phoneAlt}</a>
								</p>
								<p class="visit-note">
									Los dos números aparecen en el cartel de la fachada. La ficha de Google
									publica el primero.
								</p>
							</div>

							<div class="visit-block">
								<h3>Accesibilidad</h3>
								<p>
