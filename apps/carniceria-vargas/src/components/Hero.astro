---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES } from '../data/site';
---

<section id="inicio" class="hero-vargas relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.foto1}
			alt="Carnes y elaborados en el mostrador de Carnicería Vargas, carnicería en Málaga"
			widths={[600, 900]}
			sizes="100vw"
			quality={78}
			loading="eager"
			fetchpriority="high"
			format="webp"
			class="h-full w-full object-cover opacity-45"
		/>
		<div class="from-neutral/85 via-neutral/25 absolute inset-0 bg-gradient-to-r"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-32">
		<div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
			<div>
				<p
					class="text-accent inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase"
				>
					<span><i class="ri-map-pin-line"></i> {BUSINESS.district} · {BUSINESS.city}</span>
					<span class="text-white/60">Desde {BUSINESS.foundedYear}</span>
				</p>
				<h1
					class="font-display mt-4 text-4xl leading-[1.05] font-extrabold sm:text-5xl lg:text-6xl"
				>
					Carnicería<br />
					<span class="text-accent">Vargas</span>
				</h1>
				<p class="font-display mt-3 text-xl font-semibold text-white/85 sm:text-2xl">
					Carne fresca y elaborados de toda la vida
				</p>
				<p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80">
					Tu carnicería y charcutería de barrio en <strong class="text-white"
						>Cruz de Humilladero</strong
					>: carne fresca cortada al momento, embutidos, jamón al corte y elaborados caseros listos
					para cocinar.
				</p>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-secondary btn-lg gap-2 rounded-full">
						<i class="ri-phone-line"></i>
						Llamar al {BUSINESS.phoneDisplay}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline btn-lg hover:text-neutral rounded-full border-white/40 bg-white/5 text-white hover:border-white hover:bg-white"
					>
						<i class="ri-map-pin-line"></i> Cómo llegar
					</a>
				</div>

				<dl class="mt-10 grid max-w-lg grid-cols-2 gap-x-6 gap-y-5">
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Valoración en Google</dt>
						<dd class="font-display mt-1 text-xl font-bold">{BUSINESS.rating}★</dd>
					</div>
					<div>
						<dt class="text-xs tracking-wide text-white/50 uppercase">Reseñas</dt>
						<dd class="font-display mt-1 text-xl font-bold">+{BUSINESS.reviewsCount}</dd>
					</div>
				</dl>
				<p class="mt-4 text-xs text-white/55">
					Lunes a sábado de 8:30 a 14:30. Llama para confirmar el horario en festivos.
				</p>
			</div>

			<figure class="relative hidden lg:block">
				<div
					class="etiqueta-vargas rounded-box -rotate-2 overflow-hidden shadow-2xl ring-1 ring-white/15"
				>
					<Image
						src={IMAGES.foto1}
						alt="Carne y elaborados caseros en la Carnicería Vargas de Málaga"
						widths={[500, 800]}
						sizes="(min-width: 1024px) 40vw, 90vw"
						quality={86}
						loading="eager"
						class="aspect-[4/3] w-full object-cover"
					/>
				</div>
				<figcaption
					class="font-display text-accent rounded-box bg-neutral absolute -bottom-5 -left-4 px-5 py-3 text-lg font-bold shadow-xl"
				>
					Rafael Alberti, 9
				</figcaption>
			</figure>
		</div>
	</div>
</section>
