---
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	faqSchema,
	faqs,
	hours,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	specialties,
	structuredData,
} from '../lib/business';

const title = 'Restaurante a fuego lento | Comida casera en Córdoba';
const description =
	'Restaurante a fuego lento en Córdoba: cocina casera y tradicional cordobesa, menú del día y platos de siempre. Pje. del Balcón de Lagartijo, nave 27. Llama al 857 83 01 70.';
const keywordList =
	'Restaurante a fuego lento Córdoba, restaurante comida casera Córdoba, menú del día Córdoba, cocina tradicional cordobesa, salmorejo Córdoba, flamenquín cordobés, Pje. Balcón de Lagartijo, restaurante polígono Córdoba';

const weeklyHours = [
	{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '06:00', closes: '17:00' },
];
const restaurantSchema = { ...structuredData, openingHoursSpecification: weeklyHours };
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#211d19" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywordList} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:street-address" content={business.streetAddress} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
			<meta property="og:image" content="https://restaurante-a-fuego-lento.vercel.app/og.png" />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Restaurante a fuego lento, inicio">
				<span class="brand-mark" aria-hidden="true">F</span>
				<span class="brand-name">A fuego lento <small>Restaurante · Córdoba</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cocina">La cocina</a>
				<a href="#especialidades">Especialidades</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 857 83 01 70</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Cocina casera · Córdoba</p>
					<h1 id="hero-title">La cocina de siempre,<br /><em>hecha sin prisa.</em></h1>
					<p class="hero-intro">
						Cocina tradicional cordobesa, recetas caseras y menú del día en el Polígono Industrial Balcón de Lagartijo. Un lugar para disfrutar de los sabores de casa, de lunes a viernes.
					</p>
					<div class="hero-actions">
						<a class="button button-red" href={phoneHref}>Llamar para reservar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={mapsUrl} target="_blank" rel="noreferrer">Ver Google Maps <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Dirección</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div>
						<div><small>Teléfono y reservas</small><a href={phoneHref}>{business.phone}</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración de un plato de cocina casera, inspirada en los sabores tradicionales cordobeses">
					<span class="orbit" aria-hidden="true"></span>
					<div class="plate" aria-hidden="true"><div class="plate-content"></div></div>
					<div class="art-kicker"><strong>Sabor de casa</strong><span>Tradición cordobesa</span></div>
				</div>
			</section>

			<div class="promise-bar" aria-label="Lo que encontrarás en el restaurante">
				<span>Cocina tradicional cordobesa</span>
				<span>Menú del día</span>
				<span>Comida casera</span>
				<span>De lunes a viernes</span>
			</div>

			<section class="story section-pad" id="cocina" aria-labelledby="story-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Restaurante en Córdoba</p>
					<h2 id="story-title">Recetas de aquí,<br /><em>con sabor de casa.</em></h2>
				</div>
				<div class="story-copy">
					<p>
						Restaurante a fuego lento está en el Pasaje del Balcón de Lagartijo, nave 27, B2, en Córdoba. Su propuesta se centra en la cocina casera y los platos tradicionales, con un menú del día para disfrutar entre semana.
					</p>
					<p>
						En la mesa tienen sitio los sabores cordobeses de siempre: salmorejo, flamenquín, berenjenas con salmorejo y otras recetas caseras. Las opciones cambian; llama para consultar el menú y confirmar qué hay disponible ese día.
					</p>
					<p class="story-note">
						La información de horarios y platos puede variar. Confirma los detalles directamente con el restaurante antes de desplazarte.
					</p>
				</div>
			</section>

			<section class="specialties section-pad" id="especialidades" aria-labelledby="specialties-title">
				<div class="section-head">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Cocina tradicional</p>
						<h2 id="specialties-title">Sabores para<br /><em>disfrutar sin prisa.</em></h2>
					</div>
					<p>Una selección de platos mencionados en fuentes públicas del restaurante. Consulta la carta y el menú del día para conocer las propuestas y disponibilidad actuales.</p>
				</div>
				<div class="specialty-grid">
					{specialties.map((item, index) => (
						<article class="specialty-card">
							<span class="card-index">0{index + 1} / EN LA MESA</span>
							<h3>{item.name}</h3>
							<p>{item.description}</p>
						</article>
					))}
				</div>
				<p class="menu-note">El menú del día y la carta pueden cambiar según temporada. Llama al <a href={phoneHref}>857 83 01 70</a> para consultar las opciones y el precio vigentes.</p>
			</section>

			<section class="gallery section-pad" id="fotos" aria-labelledby="gallery-title">
				<div>
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Galería del restaurante</p>
					<h2 id="gallery-title">Mira el local<br /><em>y sus fotos reales.</em></h2>
					<div class="gallery-copy">
						<p>Las fotografías publicadas en Google Maps se mantienen en la ficha original del negocio para que puedas ver las imágenes reales y sus aportaciones más recientes.</p>
						<a class="button button-red" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a>
					</div>
				</div>
				<div class="gallery-preview">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
						title="Ficha y mapa de Restaurante a fuego lento en Córdoba; abre Google Maps para consultar sus fotos"
					 src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<div class="gallery-overlay"><span>Restaurante a fuego lento · Córdoba</span><a href={mapsUrl} target="_blank" rel="noreferrer">Abrir ficha ↗</a></div>
				</div>
				<p class="gallery-footnote">Las fotos y reseñas pertenecen a la ficha de Google Maps. Desde allí se puede consultar la galería completa, comprobar las imágenes más recientes y abrir indicaciones.</p>
			</section>

			<section class="visit section-pad" id="visitanos" aria-labelledby="visit-title">
				<div class="visit-copy">
					<p class="section-label"><span aria-hidden="true"></span> Balcón de Lagartijo · Córdoba</p>
					<h2 id="visit-title">Te esperamos<br /><em>entre semana.</em></h2>
					<address class="visit-address">{business.streetAddress}<br />{business.postalCode} {business.city}, España</address>
					<table class="hours">
						<caption>Horario publicado</caption>
						<tbody>
							{hours.map((item) => (
								<tr><th scope="row">{item.day}</th><td>{item.open && item.close ? `${item.open} – ${item.close}` : 'Cerrado'}</td></tr>
							))}
						</tbody>
					</table>
					<p class="hours-note">Horario indicado en fuentes públicas; puede cambiar en festivos. Recomendamos llamar antes de venir.</p>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={mapsUrl} target="_blank" rel="noreferrer">Ficha de Google Maps</a>
					</div>
					<a class="visit-phone" href={phoneHref}>Llamar: {business.phone}</a>
				</div>
				<div class="map-card">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe
						title="Mapa de Restaurante a fuego lento, Pasaje del Balcón de Lagartijo, Córdoba"
					 src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<div class="map-tag"><div><strong>{business.name}</strong><small>{business.streetAddress} · {business.city}</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
			<Galeria nombre="Restaurante a fuego lento" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="footer-brand" href="#inicio" aria-label="Restaurante a fuego lento, volver al inicio">
				<span class="brand-mark" aria-hidden="true">F</span>
				<span>Restaurante a fuego lento<small>{business.streetAddress} · {business.postalCode} {business.city}</small></span>
			</a>
			<nav class="footer-nav" aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Restaurante a fuego lento · Córdoba. Horarios, carta y disponibilidad sujetos a cambios; confirma por teléfono antes de venir.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>857 83 01 70</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>


