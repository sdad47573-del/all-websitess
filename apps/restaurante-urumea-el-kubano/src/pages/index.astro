---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import interior from '../assets/fotos/restaurante-urumea-el-kubano-vista-1-01.jpg';
import chipirones from '../assets/fotos/restaurante-urumea-el-kubano-apaisada-02.jpg';
import risotto from '../assets/fotos/restaurante-urumea-el-kubano-vertical-03.jpg';
import chuletillas from '../assets/fotos/restaurante-urumea-el-kubano-vertical-04.jpg';
import ensalada from '../assets/fotos/restaurante-urumea-el-kubano-apaisada-05.jpg';
import fachada from '../assets/fotos/restaurante-urumea-el-kubano-apaisada-06.jpg';
import barra from '../assets/fotos/restaurante-urumea-el-kubano-vertical-07.jpg';
import chipironesDos from '../assets/fotos/restaurante-urumea-el-kubano-apaisada-08.jpg';
import chipironesTres from '../assets/fotos/restaurante-urumea-el-kubano-vertical-09.jpg';
import setas from '../assets/fotos/restaurante-urumea-el-kubano-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Restaurante Urumea el Kubano, bar restaurante en Alto de los Robles Kalea, 10 (20014 Donostia / San Sebastián). Cocina casera, 4,5 sobre 5 en Google y 123 reseñas. Teléfono 943 46 05 36. Cierra los sábados.';

const galeria = [
	{
		src: interior,
		alt: 'Comedor de Restaurante Urumea el Kubano con mesas y sillas de madera y un rótulo de La Salve en la pared de piedra',
	},
	{
		src: barra,
		alt: 'Barra del local con grifos de sidra La Salve y dos cubiteras de vino Castillo Monjardín',
	},
	{
		src: chipirones,
		alt: 'Chipirones a la plancha con perejil en un plato blanco',
	},
	{
		src: risotto,
		alt: 'Arroz cremoso con setas en un plato blanco',
	},
	{
		src: chuletillas,
		alt: 'Chuletillas de cordero con patatas paja y pimientos rojos',
	},
	{
		src: ensalada,
		alt: 'Ensalada con lechuga, palitos de cangrejo y salsa',
	},
	{
		src: setas,
		alt: 'Setas a la plancha con ajo y perejil',
	},
	{
		src: chipironesDos,
		alt: 'Ración de chipirones a la plancha con las patas en el centro',
	},
	{
		src: chipironesTres,
		alt: 'Chipirones a la plancha con perejil, vistos desde arriba',
	},
	{
		src: fachada,
		alt: 'Fachada de Restaurante Urumea el Kubano en Alto de los Robles Kalea, con toldo negro y barricas en la puerta',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#urumea-el-kubano`,
	name: BUSINESS.name,
	alternateName: [
		BUSINESS.alternateName,
		'Urumea el Kubano',
		'Restaurante Urumea Donostia',
		'Bar restaurante el Kubano',
	],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: `+34 ${BUSINESS.phone}`,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina casera'],
	knowsLanguage: [
		{ '@type': 'Language', name: 'Español' },
		{ '@type': 'Language', name: 'Euskera' },
	],
	areaServed: [
		{ '@type': 'City', name: 'Donostia / San Sebastián' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '10:00',
			closes: '18:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '10:00',
			closes: '21:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Las reseñas', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Restaurante Urumea el Kubano · Bar restaurante en Donostia';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#123a35" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Manrope:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Urumea el Kubano, Urumea el Kubano Donostia, Urumea Jatetxea, bar restaurante Donostia, Alto de los Robles, comer en Donostia, cocina casera Donostia, restaurante Gipuzkoa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Bar restaurante en Alto de los Robles Kalea, 10 (Donostia). Cocina casera, 4,5 sobre 5 en Google y 123 reseñas. De domingo a viernes; sábados cerrado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Restaurante Urumea el Kubano con toldo negro y barricas de vino en la puerta"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#123a35"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Alto de los Robles, Donostia"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Urumea el Kubano"
			subtitle="Bar restaurante · Donostia"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Alto de los Robles Kalea, 10 · Donostia"
				title="Cocina casera <br /><em>en el alto de Donostia.</em>"
				lede={`Restaurante Urumea el Kubano es un bar restaurante en Alto de los Robles Kalea, 10, en Donostia. Google le da 4,5 sobre 5 con 123 reseñas que hablan de comida casera, buena atención y precio razonable. Abre de domingo a viernes y cierra los sábados: para venir, llama al ${BUSINESS.phone}.`}
				image={fachada}
				imageAlt="Fachada de Restaurante Urumea el Kubano en Alto de los Robles Kalea, con toldo negro y barricas en la puerta"
				primaryCta={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5</b> en Google · 123 reseñas' },
					{ label: 'La casa', html: '<b>Cocina casera</b> al momento' },
					{ label: 'Horario', html: '<b>Sábados</b> cerrado' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Restaurante Urumea el Kubano" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un bar restaurante <br /><em>de comida casera.</em>"
				paragraphs={[
					'En el número 10 de Alto de los Robles Kalea está Restaurante Urumea el Kubano, un bar restaurante que Google puntúa con 4,5 sobre 5 a partir de 123 reseñas.',
					'Su ficha no publica descripción, carta ni precios, así que esta web no los inventa: reúne lo que sí consta —dirección, teléfono, horario e idiomas— y lo que cuentan sus opiniones.',
					'Las reseñas destacadas hablan de «comida casera preparada en el momento», «excelente atención» y un «ambiente acogedor», todo «a un precio razonable».',
					'En las fotos del perfil se ve la fachada con el toldo «Restaurante Urumea · La Salve del Kubano», la barra con los grifos de sidra y platos como chipirones a la plancha, chuletillas de cordero, arroz con setas y ensalada.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} opiniones en Google. La ficha también indica que en el local se habla español y euskera.`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="Lo que cuentan las reseñas"
				title="Sin carta publicada, <br /><em>pero con pistas.</em>"
				description="La ficha de Google no publica carta ni precios. Esto no es un menú: es lo que dicen quienes han comido allí y las etiquetas que pone Google."
				cta={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados ni carta en la ficha. Para saber qué hay hoy, lo más directo es llamar al 943 46 05 36."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Diez fotos <br /><em>de la casa.</em>"
				description="Las diez fotografías publicadas en el perfil de Restaurante Urumea el Kubano en Google Maps: la fachada, el comedor, la barra y sus platos."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a Alto de los Robles <br /><em>a comer casero.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, `${BUSINESS.regionName}, España`]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario de la ficha de Google: de lunes a viernes de 10:00 a 21:00 y los domingos de 10:00 a 18:00. Los sábados cierra. Conviene confirmarlo por teléfono antes de ir."
				mapTitle="Mapa de Restaurante Urumea el Kubano en Alto de los Robles Kalea, 10, Donostia"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Urumea el Kubano · Donostia"
				mapHref={MAPS.cid}
				links={[
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref, variant: 'primary' },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="El teléfono 943 46 05 36 es el único canal de contacto que publica la ficha de Google: no hay correo ni web propia. La ficha marca español y euskera como idiomas del local."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Urumea el Kubano"
		/>
	</body>
</html>
