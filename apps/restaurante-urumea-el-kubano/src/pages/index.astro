---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import interior from '../assets/fotos/restaurante-urumea-el-kubano-vista-1-01.jpg';
import chipirones from '../assets/fotos/restaurante-urumea-el-kubano-apaisada-02.jpg';
import risotto from '../assets/fotos/restaurante-urumea-el-kubano-vertical-03.jpg';
import chuletillas from '../assets/fotos/restaurante-urumea-el-kubano-vertical-04.jpg';
import ensalada from '../assets/fotos/restaurante-urumea-el-kubano-apaisada-05.jpg';
import fachada from '../assets/fotos/restaurante-urumea-el-kubano-apaisada-06.jpg';
import barra from '../assets/fotos/restaurante-urumea-el-kubano-vertical-07.jpg';
import chipironesDos from '../assets/fotos/restaurante-urumea-el-kubano-apaisada-08.jpg';
import chipironesTres from '../assets/fotos/restaurante-urumea-el-kubano-vertical-09.jpg';
import setas from '../assets/fotos/restaurante-urumea-el-kubano-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Restaurante Urumea el Kubano, bar restaurante en Alto de los Robles Kalea, 10 (20014 Donostia / San Sebastián). Cocina casera, 4,5 sobre 5 en Google y 123 reseñas. Teléfono 943 46 05 36. Cierra los sábados.';

const galeria = [
	{
		src: interior,
		alt: 'Comedor de Restaurante Urumea el Kubano con mesas y sillas de madera y un rótulo de La Salve en la pared de piedra',
	},
	{
		src: barra,
		alt: 'Barra del local con grifos de sidra La Salve y dos cubiteras de vino Castillo Monjardín',
	},
	{
		src: chipirones,
		alt: 'Chipirones a la plancha con perejil en un plato blanco',
	},
	{
		src: risotto,
		alt: 'Arroz cremoso con setas en un plato blanco',
	},
	{
		src: chuletillas,
		alt: 'Chuletillas de cordero con patatas paja y pimientos rojos',
	},
	{
		src: ensalada,
		alt: 'Ensalada con lechuga, palitos de cangrejo y salsa',
	},
	{
		src: setas,
		alt: 'Setas a la plancha con ajo y perejil',
	},
	{
		src: chipironesDos,
		alt: 'Ración de chipirones a la plancha con las patas en el centro',
	},
	{
		src: chipironesTres,
		alt: 'Chipirones a la plancha con perejil, vistos desde arriba',
	},
	{
		src: fachada,
		alt: 'Fachada de Restaurante Urumea el Kubano en Alto de los Robles Kalea, con toldo negro y barricas en la puerta',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#urumea-el-kubano`,
	name: BUSINESS.name,
	alternateName: [
		BUSINESS.alternateName,
		'Urumea el Kubano',
		'Restaurante Urumea Donostia',
		'Bar restaurante el Kubano',
	],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: `+34 ${BUSINESS.phone}`,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina casera'],
	knowsLanguage: [
		{ '@type': 'Language', name: 'Español' },
		{ '@type': 'Language', name: 'Euskera' },
	],
	areaServed: [
		{ '@type': 'City', name: 'Donostia / San Sebastián' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '10:00',
			closes: '18:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '10:00',
			closes: '21:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Las reseñas', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Restaurante Urumea el Kubano · Bar restaurante en Donostia';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-urumea-el-kubano-apaisada-06.jpg": fachada,
	"restaurante-urumea-el-kubano-vista-1-01.jpg": interior,
	"restaurante-urumea-el-kubano-vertical-07.jpg": barra,
	"restaurante-urumea-el-kubano-apaisada-02.jpg": chipirones,
	"restaurante-urumea-el-kubano-vertical-03.jpg": risotto,
	"restaurante-urumea-el-kubano-vertical-04.jpg": chuletillas,
	"restaurante-urumea-el-kubano-apaisada-05.jpg": ensalada,
	"restaurante-urumea-el-kubano-apaisada-10.jpg": setas,
	"restaurante-urumea-el-kubano-apaisada-08.jpg": chipironesDos,
	"restaurante-urumea-el-kubano-vertical-09.jpg": chipironesTres,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#123a35" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Manrope:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Urumea el Kubano, Urumea el Kubano Donostia, Urumea Jatetxea, bar restaurante Donostia, Alto de los Robles, comer en Donostia, cocina casera Donostia, restaurante Gipuzkoa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Bar restaurante en Alto de los Robles Kalea, 10 (Donostia). Cocina casera, 4,5 sobre 5 en Google y 123 reseñas. De domingo a viernes; sábados cerrado."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Restaurante Urumea el Kubano con toldo negro y barricas de vino en la puerta"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#123a35"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Alto de los Robles, Donostia"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Urumea el Kubano"
			subtitle="Bar restaurante · Donostia"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Urumea el Kubano"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34943460536?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Espa%C3%B1ol." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Español"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
