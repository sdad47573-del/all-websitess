---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';
import bocadillo from '../assets/fotos/restaurante-el-torreon-apaisada-06.jpg';
import arrozPlato from '../assets/fotos/restaurante-el-torreon-apaisada-07.jpg';
import vitrina from '../assets/fotos/restaurante-el-torreon-apaisada-09.jpg';
import comedor from '../assets/fotos/restaurante-el-torreon-apaisada-10.jpg';
import banquete from '../assets/fotos/restaurante-el-torreon-panoramica-01.jpg';
import paella from '../assets/fotos/restaurante-el-torreon-panoramica-03.jpg';
import cafe from '../assets/fotos/restaurante-el-torreon-vertical-04.jpg';
import fachada from '../assets/fotos/restaurante-el-torreon-vertical-05.jpg';

const business = {
	name: 'Restaurante El Torreó',
	brand: 'El Torreó',
	street: 'Carrer Comercial la Travessa, 31',
	city: "La Vall d'Uixó",
	region: 'Castellón',
	postalCode: '12600',
	phone: '617 68 42 20',
	latitude: 39.8219278,
	longitude: -0.2121452,
	rating: 4.5,
	reviewsCount: 916,
	site: 'https://restaurante-el-torreon.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd600e1b87964cef:0xf746b682d5a01be5';
const cidDecimal = '17818129648783989733';
const placeId = 'ChIJ70yWhxsOYA0R5Rug1YK2Rvc';

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+El+Torre%C3%B3/@39.8219278,-0.2121452,17z/data=!3m1!4b1!4m6!3m5!1s0xd600e1b87964cef:0xf746b682d5a01be5!8m2!3d39.8219278!4d-0.2121452!16s%2Fg%2F11cncbv1yh?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34617684220';

const description =
	'Restaurante El Torreó, en el polígono La Travessa de La Vall d\'Uixó (Castellón): desayunos, bocadillos, menú del día, arroces y platos de cuchara.';

const servicios = [
	'Cocina española',
	'Desayunos desde las 5:00',
	'Bocadillos',
	'Menú del día',
	'Arroces',
	'Carnes guisadas',
	'Pescados',
	'Entremeses',
	'Postres',
	'Comidas de grupo',
	'Acceso adaptado',
	'Bucle magnético',
];

const grupos = [
	{
		title: 'Barra y desayuno',
		items: [
			{
				name: 'Café en vaso',
				note: 'solo o con leche, servido en vaso sobre el plato, como sale de la máquina',
			},
			{
				name: 'Bocadillo de tortilla y carne',
				note: 'en pan de bocadillo, con la tortilla y la carne a la plancha dentro',
			},
			{
				name: 'Entremeses',
				note: 'para empezar, como los que piden en las reseñas antes del plato principal',
			},
		],
	},
	{
		title: 'Menú del día',
		items: [
			{
				name: 'Menú del mediodía',
				note: 'primero y segundo de la casa, con pan y bebida; los platos del día se preguntan en el local',
			},
			{
				name: 'Carrillada',
				note: 'guisada despacio, en su salsa; una de las que citan las opiniones',
			},
			{
				name: 'Lomo de merluza',
				note: 'a la plancha, el pescado que aparece en las reseñas junto a la carrillada',
			},
		],
	},
	{
		title: 'Arroces',
		items: [
			{
				name: 'Arroz de la casa',
				note: 'con carne y judías verdes, como el de la paella grande que sale en las fotos',
			},
			{
				name: 'Arroz para grupos',
				note: 'la paella grande se prepara para mesas de celebración; si vais a pedir arroz, avisad al reservar',
			},
		],
	},
	{
		title: 'Postres y celebraciones',
		items: [
			{
				name: 'Flan de queso',
				note: 'el postre que destacan las reseñas, junto al arroz',
			},
			{
				name: 'Mesas para grupos',
				note: 'el comedor tiene mesas largas montadas para banquetes y comidas de empresa',
			},
		],
	},
];

const galeria = [
	{
		src: fachada,
		alt: 'Fachada color teja de Restaurante El Torreó, con las almenas, el rótulo y los faroles, en La Vall d\'Uixó',
	},
	{
		src: comedor,
		alt: 'Comedor de El Torreó con mesas y sillas de madera y la barra al fondo',
	},
	{
		src: paella,
		alt: 'Paella grande de arroz con carne y judías verdes en El Torreó, La Vall d\'Uixó',
	},
	{
		src: cafe,
		alt: 'Dos cafés en vaso sobre sus platos, en una mesa de madera de El Torreó',
	},
	{
		src: vitrina,
		alt: 'Vitrina de El Torreó con cazuelas de carnes guisadas, longaniza y albóndigas',
	},
	{
		src: arrozPlato,
		alt: 'Plato de arroz con pollo y judías verdes en El Torreó, La Vall d\'Uixó',
	},
	{
		src: banquete,
		alt: 'Mesa larga preparada para un banquete en El Torreó, con mantel rosa y copas',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo de tortilla y carne en El Torreó, La Vall d\'Uixó',
	},
];

const faqs = [
	{
		q: '¿Dónde está el Restaurante El Torreó?',
		a: 'En el polígono comercial La Travessa, Carrer Comercial la Travessa, 31, 12600 La Vall d\'Uixó (Castellón). El edificio es inconfundible: una fachada color teja rematada en almenas, con el rótulo «El Torreó» entre dos faroles. Desde esta página puedes abrir el mapa y trazar la ruta.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Abre de 5:00 a 16:00 de lunes a viernes, y los sábados de 5:00 a 12:30. Los domingos permanece cerrado. Es un horario pensado para el turno del polígono, así que la cocina trabaja sobre todo a mediodía; en festivos conviene llamar al 617 68 42 20 antes de ir.',
	},
	{
		q: '¿Se puede desayunar?',
		a: 'Sí. El restaurante abre a las 5:00 y en la barra se sirve café en vaso y bocadillos, como el de tortilla y carne que aparece en las fotos de la ficha. Es el desayuno de quien entra a trabajar en el polígono o sale de turno de noche.',
	},
	{
		q: '¿Qué se come?',
		a: 'Cocina española de la de todos los días. En las reseñas aparecen los entremeses, la carrillada, el lomo de merluza, el arroz y el flan de queso; en las fotos, además, los arroces con carne y judías verdes, las cazuelas de la vitrina y los bocadillos. Las opiniones destacan las «cantidades correctas» y el trato de las camareras.',
	},
	{
		q: '¿Hay menú del día?',
		a: 'Sí, al mediodía. Esta web no publica la carta ni los precios porque el local no tiene carta oficial publicada: los platos del día se preguntan en el restaurante o por teléfono, en el 617 68 42 20.',
	},
	{
		q: '¿Se puede ir en grupo o celebrar una comida?',
		a: 'El comedor es amplio, con mesas de madera y mesas largas montadas para banquetes, así que admite comidas de empresa, familiares y celebraciones. Las reservas se hacen por teléfono, en el 617 68 42 20; no hay reserva online ni formulario en esta web.',
	},
	{
		q: '¿Es accesible y hay aparcamiento?',
		a: 'La ficha de Google marca entrada, aseo, asientos y aparcamiento adaptados para sillas de ruedas, y también un bucle magnético asistencial. Al estar en un polígono comercial, el aparcamiento en la calle y en las parcelas del entorno es amplio.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['El Torreó', 'Restaurante El Torreón', 'El Torreó La Vall d\'Uixó'],
	slogan: 'Cocina española de cada día en el polígono La Travessa',
	description,
	url: `${business.site}/`,
	telephone: '+34 617 68 42 20',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Española', 'Cocina de mercado', 'Arroces', 'Menú del día'],
	areaServed: [
		{ '@type': 'City', name: "La Vall d'Uixó" },
		{ '@type': 'AdministrativeArea', name: 'Plana Baixa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '05:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '05:00',
			closes: '12:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Bucle magnético asistencial',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Restaurante El Torreó · Cocina española en La Vall d'Uixó</title>
		<meta name="theme-color" content="#b5603a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Restaurante El Torreó, El Torreó La Vall d'Uixó, restaurante La Vall d'Uixó, menú del día La Vall d'Uixó, comer en el polígono La Travessa, arroces Castellón, desayunos La Vall, carrillada, lomo de merluza, restaurante Plana Baixa"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Restaurante El Torreó · Cocina española en La Vall d'Uixó"
			ogDescription="Desayunos desde las 5:00, menú del día, arroces y platos de cuchara en el polígono La Travessa. 4,5 en Google con 916 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Paella de arroz con carne y judías verdes del Restaurante El Torreó"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#b5603a"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="La Vall d'Uixó, Castellón"
			contact={{
				street: business.street,
				locality: business.city,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[fachada]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="ET"
			name={business.name}
			subtitle="La Vall d'Uixó · Polígono La Travessa"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Polígono La Travessa · La Vall d'Uixó"
				title="Cocina de cada día,<br />abierta<br /><em>desde las 5:00.</em>"
				lede="El Torreó es el restaurante del polígono La Travessa, en La Vall d'Uixó. Cocina española sin adornos: desayunos y bocadillos desde primera hora, menú del día, arroces y platos de cuchara, con comedor amplio para grupos."
				image={fachada}
				imageAlt="Fachada color teja de Restaurante El Torreó, con las almenas y el rótulo, en La Vall d'Uixó"
				primaryCta={{ label: 'Llamar 617 68 42 20', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5</b> en Google (916 reseñas)' },
					{ label: 'Entre semana', html: '<b>5:00 – 16:00</b> de lunes a viernes' },
					{ label: 'Sábado', html: '<b>5:00 – 12:30</b> y domingo cerrado' },
					{ label: 'Dónde', html: '<b>La Travessa</b>, La Vall d\'Uixó' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece El Torreó" items={servicios} />

			<LocalAbout
				label="Cocina española en el polígono La Travessa"
				title="Un torreón<br />de ladrillo<br /><em>con comedor.</em>"
				paragraphs={[
					'El Torreó está en el polígono comercial La Travessa, en el Carrer Comercial la Travessa, 31, de La Vall d\'Uixó. Se reconoce desde lejos por la fachada color teja rematada en almenas, como la de un torreón, con el rótulo entre dos faroles y una ventana redonda en el centro.',
					'Abre a las 5:00, cuando empieza el turno en el polígono, y sirve hasta las 16:00 de lunes a viernes; los sábados cierra a las 12:30 y los domingos descansa. En la barra se desayuna café en vaso y bocadillos, y en la vitrina se ven las cazuelas del día: carnes guisadas, longaniza y albóndigas.',
					'En la mesa, la cocina es la de siempre. Entremeses, carrillada, lomo de merluza y arroces con carne y judías verdes, servidos en paellas grandes cuando hay grupo. El comedor es amplio, con mesas de madera y mantel, y se monta con mesas largas para banquetes y comidas de empresa.',
				]}
				note="La ficha de Google reúne 916 opiniones con una nota media de 4,5. En las reseñas se repiten el trato de las camareras, el arroz, el flan de queso y unas cantidades que describen como correctas."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="Lo que sale de la cocina"
				title="De la barra<br /><em>a la paella.</em>"
				description="El local no tiene carta publicada en Google, así que esta selección se ha hecho con lo que aparece en sus fotos y con lo que citan las reseñas: café y bocadillos de la barra, entremeses, carrillada, lomo de merluza, arroces y flan de queso."
				cta={{ label: 'Preguntar el menú por teléfono', href: phoneHref }}
				groups={grupos}
				note="Esta web no publica precios: no hay carta ni tarifas publicadas en la ficha de Google. El menú del día, los platos de la vitrina y su importe se confirman en el local o llamando al 617 68 42 20."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La fachada,<br /><em>la vitrina y la mesa.</em>"
				description="Estas fotografías proceden del perfil de El Torreó en Google Maps: la fachada de teja y almenas, el comedor, la vitrina de cazuelas, los arroces, el bocadillo, los cafés y una mesa larga preparada para banquete."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer Comercial la Travessa, 31 · 12600 La Vall d'Uixó"
				title="Nos vemos<br /><em>en La Travessa.</em>"
				addressLines={[
					business.street,
					`Polígono Comercial la Travessa · ${business.postalCode} ${business.city}`,
					'Castellón, España',
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: '5:00 – 16:00' },
					{ day: 'Martes', value: '5:00 – 16:00' },
					{ day: 'Miércoles', value: '5:00 – 16:00' },
					{ day: 'Jueves', value: '5:00 – 16:00' },
					{ day: 'Viernes', value: '5:00 – 16:00' },
					{ day: 'Sábado', value: '5:00 – 12:30' },
					{ day: 'Domingo', value: 'Cerrado', closed: true },
				]}
				hoursNote="Horario publicado en la ficha de Google: de 5:00 a 16:00 de lunes a viernes, de 5:00 a 12:30 los sábados y cerrado los domingos. En festivos y en agosto puede cambiar, así que llama al 617 68 42 20 antes de desplazarte."
				mapTitle="Mapa del Restaurante El Torreó en el polígono La Travessa, La Vall d'Uixó"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="El Torreó · La Vall d'Uixó"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Las reservas se hacen por teléfono, llamando al 617 68 42 20: no hay reserva online ni formulario en esta web. Para grupos, banquetes o comidas de empresa conviene llamar con días de antelación, y si alguien tiene una alergia o necesita acceso adaptado se puede indicar al reservar."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="ET"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a El Torreó"
		/>
	</body>
</html>
