---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/ks-restaurante-e-cafe-vertical-01.jpg';
import carilFrango from '../assets/fotos/ks-restaurante-e-cafe-vertical-02.jpg';
import folheto from '../assets/fotos/ks-restaurante-e-cafe-apaisada-03.jpg';
import arrozFrango from '../assets/fotos/ks-restaurante-e-cafe-vertical-04.jpg';
import balcao from '../assets/fotos/ks-restaurante-e-cafe-vertical-05.jpg';
import logotipo from '../assets/fotos/ks-restaurante-e-cafe-vertical-06.jpg';
import frangoBatata from '../assets/fotos/ks-restaurante-e-cafe-vertical-08.jpg';
import mesaKebab from '../assets/fotos/ks-restaurante-e-cafe-vertical-09.jpg';
import clientes from '../assets/fotos/ks-restaurante-e-cafe-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICOS } from '../data/site';

const title = 'Ks Restaurante e Café · Döner kebab em Sacavém';
const description = BUSINESS.description;

const galeria = [
	{
		src: carilFrango,
		alt: 'Frango estufado em molho alaranjado, com gengibre em juliana e coentros, numa frigideira preta',
	},
	{
		src: arrozFrango,
		alt: 'Arroz com frango, limão e coentros num prato preto, com uma lata de Coca-Cola ao lado',
	},
	{
		src: frangoBatata,
		alt: 'Frango grelhado com batata frita e salada numa bandeja, com uma lata de Sumol ao lado',
	},
	{
		src: balcao,
		alt: 'Balcão do Ks com vitrine de pastelaria, máquina de café e um cliente a beber café',
	},
	{
		src: clientes,
		alt: 'Grupo de clientes à mesa, num almoço com kebab e batata frita',
	},
	{
		src: fachada,
		alt: 'Fachada do Ks Cafe Restaurant com o logótipo na vitrina e o folheto de kebab exposto',
	},
	{
		src: logotipo,
		alt: 'Autocolante redondo com o logótipo KS Cafe & Restaurant e a morada, Rua Salvador Allende 27, Sacavém',
	},
	{
		src: folheto,
		alt: 'Folheto do KS Cafe & Restaurante com a lista de pizzas, os menus e os contactos da casa',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#ks`,
	name: BUSINESS.name,
	alternateName: ['KS Cafe', 'KS Cafe & Restaurante', 'Ks Restaurante e Cafe Sacavém'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	currenciesAccepted: 'EUR',
	servesCuisine: ['Döner kebab', 'Grelhados'],
	areaServed: [
		{ '@type': 'City', name: 'Sacavém' },
		{ '@type': 'AdministrativeArea', name: 'Loures' },
		{ '@type': 'AdministrativeArea', name: 'Distrito de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '05:00',
			closes: '22:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A cozinha', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#23201d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,600;0,700;1,400&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Ks Restaurante e Café, KS Cafe Sacavém, döner kebab Sacavém, kebab Sacavém, comer em Sacavém, restaurante Rua Salvador Allende, kebab perto de Lisboa, café Sacavém"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Restaurante de döner kebab na R. Salvador Allende 27c, em Sacavém. Aberto todos os dias das 5:00 às 22:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Mesa posta com frango grelhado e kebab no Ks Restaurante e Café"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#23201d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Sacavém, Lisboa"
			locale="pt_PT"
			countryName="Portugal"
			preload={[mesaKebab]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Ks Cafe"
			subtitle="Restaurante · Sacavém"
			nav={nav}
			cta={{ label: 'Google Maps', href: MAPS.place, external: true }}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow="R. Salvador Allende 27c · Sacavém"
				title="Kebab e café <br /><em>em Sacavém.</em>"
				lede={`O Ks Restaurante e Café é um restaurante de döner kebab na R. Salvador Allende 27c, em Sacavém. Está aberto todos os dias, das 5:00 às 22:00, e a ficha de Google dá-lhe 4,2 sobre 5 com 37 críticas.`}
				image={mesaKebab}
				imageAlt="Mesa posta com dois pratos de frango grelhado e kebab, com batata frita e salada"
				primaryCta={{ label: 'Como chegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha e críticas no Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,2</b> no Google · 37 críticas' },
					{ label: 'Horário', html: '<b>5:00–22:00</b> todos os dias' },
					{ label: 'Cozinha', html: '<b>Döner kebab</b> e grelhados' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto do perfil de Google Maps"
				galleryLinkLabel="Ver a galeria"
			/>

			<LocalChips label="O que encontras no Ks Restaurante e Café" items={SERVICOS} />

			<LocalAbout
				label="A casa"
				title="Um café de bairro <br /><em>com kebab ao balcão.</em>"
				paragraphs={[
					'O Ks Restaurante e Café fica na R. Salvador Allende 27c, em Sacavém (2685-114), no distrito de Lisboa. A casa apresenta-se como «Ks Cafe & Restaurant» e ocupa o rés-do-chão de um prédio, com uma vitrina ampla e um letreiro redondo na porta.',
					'A Google classifica-o como restaurante especializado em döner kebab e dá-lhe 4,2 sobre 5 com 37 críticas. O próprio espaço complementa a ficha com três palavras: «Doner Kebab sacavem».',
					'As fotografias do perfil mostram o que sai da cozinha: kebab no pão e no prato, frango grelhado com batata frita e salada, arroz com frango, caril com gengibre e coentros, além do café e da pastelaria na vitrine. Ao balcão há máquina de café, e as mesas enchem-se ao almoço.',
					'O horário é dos que começam cedo: todos os dias, das 5:00 às 22:00, sem dia de fecho indicado. A ficha não publica telefone, e-mail, site próprio, carta nem preços, por isso esta página não adianta nenhum desses dados.',
				]}
				note={`Tem ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 com ${BUSINESS.reviewsCount} críticas no Google. As fotografias da casa são a fonte para o que aqui se descreve da cozinha.`}
				links={[
					{ label: 'Ficha e críticas no Google', href: MAPS.reviews, external: true },
					{ label: 'Ver a casa no Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="A cozinha"
				title="Kebab, grelhados <br /><em>e arroz.</em>"
				description="A ficha de Google não publica carta nem preços, e o restaurante não tem site próprio. O que segue descreve o que o próprio espaço mostra na sua galeria de fotografias, além da categoria e da descrição da ficha."
				cta={{ label: 'Ver fotos no Google Maps', href: MAPS.place }}
				groups={MENU}
				note="Não há carta nem preços publicados. O folheto que a casa tem na galeria mostra uma carta de pizzas e menus, mas não está datado e o site que indica já não está ativo, por isso não se copiam aqui preços que podem estar desatualizados."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Oito fotografias <br /><em>da casa.</em>"
				description="As fotografias do perfil do Ks Restaurante e Café em Google Maps: os pratos, o balcão com a vitrine, a fachada, o logótipo, o folheto da casa e a mesa cheia ao almoço."
				images={galeria}
				cta={{ label: 'Ver tudo no Google Maps', href: MAPS.place }}
				note="Imagens alojadas nesta página e provenientes do perfil do estabelecimento em Google Maps. Se tens os direitos de alguma e queres retirá-la, diz-nos e apagamo-la."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Passa pela <br /><em>Salvador Allende.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Lisboa, Portugal']}
				hours={HOURS}
				hoursCaption="Horário"
				hoursNote="Horário publicado na ficha de Google: todos os dias, das 5:00 às 22:00, sem dia de fecho indicado. Convém confirmá-lo antes de ir, sobretudo em feriados."
				mapTitle="Mapa do Ks Restaurante e Café na R. Salvador Allende 27c, Sacavém"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Ks Restaurante e Café · Sacavém"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Como chegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: 'Abrir no Google Maps', href: MAPS.place, external: true }}
				reserveNote="Sem telefone público: a ficha de Google não publica número, e-mail nem site, por isso não existe um canal de reservas ou encomendas publicado. No folheto da galeria aparecem dois números, mas o site que o acompanha já não está ativo e o folheto não está datado — confirma na ficha antes de ligar. A ficha também não indica informação sobre acessibilidade nem sobre esplanada ou take-away."
			/>

			<LocalFaq items={FAQ} eyebrow="Perguntas frequentes" title="Antes de <em>vir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Informação elaborada a partir de fontes públicas; confirma horário e oferta antes da visita."
			ctaLabel="Ver no Google Maps"
			navAriaLabel="Ligações do Ks Restaurante e Café"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
