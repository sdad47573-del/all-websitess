---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/restaurante-hostal-frasca-vertical-01.jpg';
import comedor from '../assets/fotos/restaurante-hostal-frasca-apaisada-04.jpg';
import terraza from '../assets/fotos/restaurante-hostal-frasca-apaisada-05.jpg';
import ensalada from '../assets/fotos/restaurante-hostal-frasca-apaisada-07.jpg';
import carnePlancha from '../assets/fotos/restaurante-hostal-frasca-apaisada-02.jpg';
import torreznos from '../assets/fotos/restaurante-hostal-frasca-vertical-03.jpg';
import bandejaCarnes from '../assets/fotos/restaurante-hostal-frasca-vertical-06.jpg';
import cartaMahou from '../assets/fotos/restaurante-hostal-frasca-vertical-08.jpg';
import migas from '../assets/fotos/restaurante-hostal-frasca-vertical-09.jpg';
import chorizo from '../assets/fotos/restaurante-hostal-frasca-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, RATING, SERVICIOS } from '../data/site';

const title = 'Restaurante Hostal Frasca · tapas y raciones en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: comedor,
		alt: 'Comedor del Hostal Frasca con manteles rojos, sillas de madera, flores y un espejo grande en la pared',
	},
	{
		src: migas,
		alt: 'Cazuela de hierro con migas manchegas y dos sardinas, sobre mantel rojo y con pan aparte',
	},
	{
		src: bandejaCarnes,
		alt: 'Bandeja de carnes a la plancha con chorizo, morcilla y patatas fritas en una mesa de terraza',
	},
	{
		src: chorizo,
		alt: 'Chorizo criollo a la plancha sobre rebanadas de pan, con patatas y pimiento frito',
	},
	{
		src: torreznos,
		alt: 'Plato de torreznos fritos con ajos enteros y una cuchara de metal',
	},
	{
		src: carnePlancha,
		alt: 'Filete de carne a la plancha con patatas fritas, rodaja de tomate y pimiento verde',
	},
	{
		src: ensalada,
		alt: 'Ensalada mixta con atún, tomate, aceitunas, maíz y cebolla en una mesa de terraza',
	},
	{
		src: terraza,
		alt: 'Mesas y sillas de terraza en la plaza, junto a la fachada del local, un día de sol',
	},
	{
		src: cartaMahou,
		alt: 'Carta impresa del Hostal Frasca junto a dos botellines de cerveza y un plato de tortilla con pan',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante-hostal-frasca`,
	name: BUSINESS.name,
	alternateName: ['Hostal Frasca', 'Restaurante Frasca Ciudad Real', 'Bar Frasca Ciudad Real'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Tapas', 'Cocina manchega', 'Cocina española'],
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.channel },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:00',
			closes: '01:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '08:00',
			closes: '17:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17130f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante Hostal Frasca Ciudad Real, bar de tapas Ciudad Real, Plaza Agustín Salido 2, migas con sardinas, torreznos Ciudad Real, raciones Ciudad Real, restaurante centro Ciudad Real, tapas 13003"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Tapas, raciones y cocina de plancha en la Plaza Agustín Salido, 2, de Ciudad Real. De lunes a sábado de 8:00 a 1:00 y domingos hasta las 17:00. 3,9 sobre 5 con 531 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Carne a la plancha con patatas del Restaurante Hostal Frasca"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#17130f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Restaurante · bar de tapas"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Tapas, plancha <br /><em>y sobremesa.</em>"
				lede={`El Restaurante Hostal Frasca está en la Plaza Agustín Salido, 2, en el centro de Ciudad Real. Abre todos los días a las 8:00: café y tostadas por la mañana, tapas y raciones al mediodía y cocina de plancha hasta la 1:00 de la madrugada, con el domingo más corto. La ficha de Google le da 3,9 sobre 5 con 531 reseñas.`}
				image={fachada}
				imageAlt="Fachada del Hostal Frasca con el toldo granate y el rótulo «Hostal Frasca» en la Plaza Agustín Salido"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>3,9</b> en Google · 531 reseñas' },
					{
						label: 'Horario',
						html: '<b>8:00–1:00</b><br />Lunes a sábado · domingo hasta las 17:00',
					},
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> reservas y consultas` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas del Restaurante Hostal Frasca" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Restaurante <br /><em>de plaza.</em>"
				paragraphs={[
					'El Frasca ocupa un edificio de ladrillo en la Plaza Agustín Salido, 2, con el rótulo «Hostal ★★ Frasca» sobre el toldo granate de la entrada. Google lo clasifica como restaurante y bar de tapas, y le añade la etiqueta «Brunch»: la misma casa sirve el café de las ocho y la última ración de la madrugada.',
					'Dentro hay dos ambientes: el comedor de manteles rojos, sillas de madera y espejos grandes, que es el de las comidas y las celebraciones, y la barra de siempre, con la carta impresa, los botellines y la tarjeta de mesa que anuncia el WiFi de la casa.',
					'La cocina que enseñan las fotos del perfil es la de aquí: migas manchegas en cazuela de hierro con sardinas, torreznos con ajos, chorizo criollo y morcilla a la plancha sobre pan, carne con patatas fritas, tortilla, ensalada mixta y bocadillos. Las reseñas lo resumen así: «muy buenas tapas y abundantes raciones» y «muy buenas las tostas, bocadillos y hamburguesas».',
					'El horario es largo: de 8:00 a 1:00 de lunes a sábado, y los domingos de 8:00 a 17:00. La ficha marca acceso para sillas de ruedas y asientos adaptados, y aclara que no hay aparcamiento adaptado. No publica web propia: el teléfono y el mostrador son el canal.',
				]}
				note="Los datos salen de la ficha pública de Google Maps, de las reseñas destacadas y de las fotos del perfil. La ficha no publica carta con precios ni datos de alojamiento: si algo cambia, manda lo que digan en el local o por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el restaurante en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Plancha, cazuela <br /><em>y barra.</em>"
				description="Los platos que aparecen aquí son los que enseñan las fotos del perfil y los que nombran las reseñas del restaurante. La carta impresa existe —sale en una de las fotos—, pero el local no la tiene publicada."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="Esta página no publica precios porque la ficha no los tiene: la carta del local no está colgada en su perfil. Lo que hay cada día, el precio de la ración y las opciones sin gluten o vegetarianas se preguntan en el mostrador o en el 651 83 86 60."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Nueve fotos <br /><em>de la casa.</em>"
				description="Las fotografías del perfil del Restaurante Hostal Frasca en Google Maps: el comedor, la terraza de la plaza, las migas, las carnes a la plancha y la carta sobre la barra."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a la Plaza <br /><em>Agustín Salido.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Castilla-La Mancha, España',
				]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: de 8:00 a 1:00 de lunes a sábado —la 1:00 es ya la madrugada del día siguiente— y de 8:00 a 17:00 los domingos. No figura ningún día de cierre semanal; en festivos puede cambiar, así que llama antes si vas en fecha señalada."
				mapTitle="Mapa del Restaurante Hostal Frasca en la Plaza Agustín Salido 2, Ciudad Real"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Restaurante Hostal Frasca"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. El local no publica web propia ni sistema de reservas, así que el teléfono es el canal directo para reservar mesa, preguntar por el menú o encargar raciones."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces del Restaurante Hostal Frasca"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
