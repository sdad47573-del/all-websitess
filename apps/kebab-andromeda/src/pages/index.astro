---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import interior from '../assets/fotos/kebab-andromeda-panoramica-01.jpg';
import techo from '../assets/fotos/kebab-andromeda-apaisada-02.jpg';
import bandejaHamburguesas from '../assets/fotos/kebab-andromeda-apaisada-03.jpg';
import barra from '../assets/fotos/kebab-andromeda-vertical-04.jpg';
import bandejaSalsas from '../assets/fotos/kebab-andromeda-apaisada-05.jpg';
import cartelPrecios from '../assets/fotos/kebab-andromeda-apaisada-06.jpg';
import fachada from '../assets/fotos/kebab-andromeda-vertical-07.jpg';
import asador from '../assets/fotos/kebab-andromeda-vertical-08.jpg';
import vitrina from '../assets/fotos/kebab-andromeda-vertical-09.jpg';
import rollo from '../assets/fotos/kebab-andromeda-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Kebab Andrómeda · Kebab y pizza turca en Teatinos, Málaga';
const description =
	'Kebab Andrómeda, kebab, pizza turca y hamburguesas en C. Andrómeda, 15, local 2 (Teatinos-Universidad, 29010 Málaga). Abierto todos los días de 13:00 a 16:00 y de 20:00 a 1:00.';

const galeria = [
	{
		src: fachada,
		alt: 'La fachada de Kebab Andrómeda de noche, con el rótulo negro y rojo y el cartel de precios iluminado junto a la puerta',
	},
	{
		src: interior,
		alt: 'Interior de Kebab Andrómeda: mesas de madera clara, sillas turquesa, la barra con la vitrina y los asadores al fondo, junto al ventanal a la calle',
	},
	{
		src: asador,
		alt: 'Un pincho de pollo en el asador giratorio, con la carne ya cortada en la bandeja y otra pieza asándose al lado',
	},
	{
		src: barra,
		alt: 'La barra de Kebab Andrómeda con la vitrina de verduras, dos asadores de pollo y el cartel de precios en la parte superior',
	},
	{
		src: vitrina,
		alt: 'La vitrina de la barra con tomate, lechuga, cebolla y champiñones, y los botes de salsa de yogur, kétchup y mostaza',
	},
	{
		src: cartelPrecios,
		alt: 'El cartel de precios del local con los rollos, hamburguesas, hot dog y el sultán, cada uno con su precio',
	},
	{
		src: bandejaSalsas,
		alt: 'Bandeja de aluminio con patatas, carne de kebab y salsa de yogur y picante por encima',
	},
	{
		src: rollo,
		alt: 'Un rollo de kebab abierto en pan de dürüm con carne, cebolla morada y pepinillos, junto a una alita frita y una Coca-Cola',
	},
	{
		src: bandejaHamburguesas,
		alt: 'Bandeja con dos hamburguesas, dos raciones de patatas fritas, Aquarius y Coca-Cola, sobre una mesa con la carta del local',
	},
	{
		src: techo,
		alt: 'Techo del local con lámparas de mimbre, el aire acondicionado y una pantalla de televisión sobre la pared de madera',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Kebab Andrómeda',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#kebab-andromeda`,
	name: BUSINESS.name,
	alternateName: ['Kebab Andromeda Málaga', 'Kebab Andrómeda Teatinos', 'Hamburguesería Andrómeda'],
	description:
		'Kebab, pizza turca y hamburguesas en la calle Andrómeda, 15, local 2 (Teatinos-Universidad, 29010 Málaga). Abierto todos los días en dos turnos, con salsa de yogur y picante.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina turca', 'Kebab', 'Comida rápida'],
	hasMenu: menuSchema,
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '01:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"kebab-andromeda-vertical-07.jpg": fachada,
	"kebab-andromeda-panoramica-01.jpg": interior,
	"kebab-andromeda-vertical-08.jpg": asador,
	"kebab-andromeda-vertical-04.jpg": barra,
	"kebab-andromeda-vertical-09.jpg": vitrina,
	"kebab-andromeda-apaisada-06.jpg": cartelPrecios,
	"kebab-andromeda-apaisada-05.jpg": bandejaSalsas,
	"kebab-andromeda-vertical-10.jpg": rollo,
	"kebab-andromeda-apaisada-03.jpg": bandejaHamburguesas,
	"kebab-andromeda-apaisada-02.jpg": techo,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#131a2e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Kebab Andrómeda Málaga, kebab Teatinos, pizza turca Málaga, hamburguesería Teatinos, kebab cerca de la universidad, comida turca Málaga, kebab a domicilio Teatinos"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Kebab, pizza turca, rollos y hamburguesas en Teatinos. Abierto todos los días de 13:00 a 16:00 y de 20:00 a 1:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bandeja con dos hamburguesas, patatas fritas y refrescos de Kebab Andrómeda"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="restaurant.restaurant"
			author={BUSINESS.name}
			themeColor="#131a2e"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Kebab Andrómeda"
			subtitle="Kebab y pizza turca · Teatinos"
			nav={nav}
			cta={{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true }}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario, carta y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Ver en Google Maps"
			navAriaLabel="Enlaces de Kebab Andrómeda"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
