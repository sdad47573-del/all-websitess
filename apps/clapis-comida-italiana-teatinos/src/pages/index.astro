---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import terraza from '../assets/fotos/clapis-comida-italiana-teatinos-apaisada-01.jpg';
import mesa from '../assets/fotos/clapis-comida-italiana-teatinos-apaisada-10.jpg';
import pizza from '../assets/fotos/clapis-comida-italiana-teatinos-apaisada-07.jpg';
import interior from '../assets/fotos/clapis-comida-italiana-teatinos-vertical-03.jpg';
import pastas from '../assets/fotos/clapis-comida-italiana-teatinos-vertical-04.jpg';
import postre from '../assets/fotos/clapis-comida-italiana-teatinos-vertical-05.jpg';
import carpaccio from '../assets/fotos/clapis-comida-italiana-teatinos-vertical-06.jpg';
import carbonara from '../assets/fotos/clapis-comida-italiana-teatinos-vertical-09.jpg';
import tortellini from '../assets/fotos/clapis-comida-italiana-teatinos-vertical-02.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Clapis · Comida italiana en Teatinos, Málaga';
const description =
	'Clapis, en C. Andrómeda, 15, Loc 3 (Teatinos-Universidad, 29010 Málaga). Pasta fresca, auténtica pizza italiana y postres caseros. Mediodía de martes a domingo y cenas martes, miércoles, viernes y sábados.';

const galeria = [
	{
		src: mesa,
		alt: 'Una mesa de Clapis con pizzas, pasta al pesto, pasta con tomate, croquetas, aceitunas y spritz',
	},
	{
		src: pastas,
		alt: 'Varios platos de pasta de Clapis: rigatoni al pesto, pasta con gambas, carbonara y ensalada de brócoli',
	},
	{
		src: pizza,
		alt: 'Pizza de Clapis con prosciutto, crema de queso y rúcula sobre masa crujiente',
	},
	{
		src: carbonara,
		alt: 'Un plato de rigatoni a la carbonara con bacon crujiente y parmesano rallado',
	},
	{
		src: tortellini,
		alt: 'Tortellini de la casa con una salsa oscura y crema de queso',
	},
	{
		src: carpaccio,
		alt: 'Carpaccio de ternera con rúcula, parmesano y una salsa amarilla',
	},
	{
		src: postre,
		alt: 'Cuencos con tartaletas cubiertas de crema de mascarpone, listos para servir',
	},
	{
		src: interior,
		alt: 'El interior de Clapis con mesas de madera, luces de cadena y la pared cubierta de notas de colores',
	},
	{
		src: terraza,
		alt: 'La terraza nocturna de Clapis con mesas y sillas negras, luces y el cartel de Spritz, Pizza y Pasta Fresca',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Clapis',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#clapis`,
	name: 'Clapis',
	alternateName: ['CLAPIS COMIDA ITALIANA TEATINOS', 'Clapis Teatinos', 'Clapis Málaga'],
	description:
		'Restaurante italiano en la calle Andrómeda, 15, local 3, Teatinos-Universidad (29010 Málaga). Pasta fresca, auténtica pizza italiana y postres caseros.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34614464115',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina italiana', 'Pizza', 'Pasta'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Teatinos-Universidad' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Friday', 'Saturday'],
			opens: '20:00',
			closes: '23:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"clapis-comida-italiana-teatinos-apaisada-01.jpg": terraza,
	"clapis-comida-italiana-teatinos-apaisada-10.jpg": mesa,
	"clapis-comida-italiana-teatinos-vertical-04.jpg": pastas,
	"clapis-comida-italiana-teatinos-apaisada-07.jpg": pizza,
	"clapis-comida-italiana-teatinos-vertical-09.jpg": carbonara,
	"clapis-comida-italiana-teatinos-vertical-02.jpg": tortellini,
	"clapis-comida-italiana-teatinos-vertical-06.jpg": carpaccio,
	"clapis-comida-italiana-teatinos-vertical-05.jpg": postre,
	"clapis-comida-italiana-teatinos-vertical-03.jpg": interior,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#191411" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Manrope:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name="Clapis · Comida italiana"
			description={description}
			keywords="Clapis, comida italiana Teatinos, pizza italiana Málaga, pasta fresca Málaga, restaurante italiano Teatinos, cacio e pepe, carbonara, postres caseros, Andrómeda"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pasta fresca, auténtica pizza italiana y postres caseros en la calle Andrómeda, 15, Teatinos. Mediodía de martes a domingo y cenas cuatro días."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La terraza nocturna de Clapis con sus mesas y luces"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author="Clapis"
			themeColor="#191411"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Teatinos"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[terraza]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Clapis"
			subtitle="Comida italiana · Teatinos"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Clapis · Comida italiana"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a Clapis"
			navAriaLabel="Enlaces de Clapis"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34614464115?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Carta%20de%20Clapis." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Carta de Clapis"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
