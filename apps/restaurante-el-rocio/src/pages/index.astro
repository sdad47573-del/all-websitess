---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import mesaPuesta from '../assets/fotos/restaurante-el-rocio-apaisada-01.jpg';
import mejillones from '../assets/fotos/restaurante-el-rocio-apaisada-02.jpg';
import patatasAlioli from '../assets/fotos/restaurante-el-rocio-apaisada-03.jpg';
import menuDia from '../assets/fotos/restaurante-el-rocio-apaisada-04.jpg';
import entrecot from '../assets/fotos/restaurante-el-rocio-apaisada-05.jpg';
import almejas from '../assets/fotos/restaurante-el-rocio-apaisada-06.jpg';
import potaje from '../assets/fotos/restaurante-el-rocio-apaisada-07.jpg';
import arrozConejo from '../assets/fotos/restaurante-el-rocio-apaisada-08.jpg';
import gambasAjillo from '../assets/fotos/restaurante-el-rocio-apaisada-09.jpg';
import calamares from '../assets/fotos/restaurante-el-rocio-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Restaurante "El Rocío" en Fortuna (Murcia): cocina española, arroces, carnes a la brasa y raciones generosas en la Avenida Narciso Yepes, 22. De lunes a sábado, de 9:00 a 18:00. Reservas en el 868 68 03 03.';

const galeria = [
	{
		src: mesaPuesta,
		alt: 'Mesa preparada con la carta de Restaurante El Rocío y el cartel de reservado, en Fortuna (Murcia)',
	},
	{
		src: arrozConejo,
		alt: 'Arroz con conejo y caracoles en paella de Restaurante El Rocío, Fortuna',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la brasa con patatas y pimientos de Padrón en Restaurante El Rocío, Fortuna',
	},
	{
		src: mejillones,
		alt: 'Mejillones al vapor en cazuela de barro con limón, Restaurante El Rocío',
	},
	{
		src: almejas,
		alt: 'Almejas a la marinera en cazuela de barro, Restaurante El Rocío (Fortuna)',
	},
	{
		src: gambasAjillo,
		alt: 'Gambas al ajillo en cazuela de barro, Restaurante El Rocío (Fortuna, Murcia)',
	},
	{
		src: calamares,
		alt: 'Calamares a la plancha con ensalada, limón y salsa verde en Restaurante El Rocío',
	},
	{
		src: potaje,
		alt: 'Potaje de alubias con chorizo y morcilla de Restaurante El Rocío, Fortuna',
	},
	{
		src: patatasAlioli,
		alt: 'Patatas fritas en cuenco con alioli aparte, Restaurante El Rocío (Fortuna)',
	},
	{
		src: menuDia,
		alt: 'Menú del día de Restaurante El Rocío: sopa, pollo con patatas, ensalada, postre, pan y café',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	acceptsReservations: true,
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['El Rocío Fortuna', 'Restaurante El Rocio', 'El Rocío Murcia'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	telephone: '+34 868 68 03 03',
	priceRange: BUSINESS.priceRange,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Murciana', 'Arroces'],
	areaServed: [
		{ '@type': 'City', name: 'Fortuna' },
		{ '@type': 'AdministrativeArea', name: 'Región de Murcia' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId }],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '09:00',
			closes: '18:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Reserva por teléfono', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'El restaurante', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title =
	'Restaurante "El Rocío" · Cocina española en Fortuna, Murcia';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#8d2b2b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante El Rocío Fortuna, El Rocío Fortuna Murcia, restaurante Fortuna, cocina española Fortuna, arroz con conejo y caracoles, paella Fortuna, carnes a la brasa Murcia, menú del día Fortuna, Avenida Narciso Yepes, reservar restaurante Fortuna"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Restaurante El Rocío · Cocina española en Fortuna, Murcia"
			ogDescription="Cocina española, arroces y carnes a la brasa en la Av. Narciso Yepes, 22 (Fortuna). De lunes a sábado, 9:00–18:00. 4,4 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Mesa preparada con la carta de Restaurante El Rocío, en Fortuna (Murcia)"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#8d2b2b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			postalCode={BUSINESS.postalCode}
			phone="+34868680303"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`Fortuna, ${BUSINESS.regionName}`}
			preload={[mesaPuesta]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="El Rocío"
			subtitle="Cocina española · Fortuna"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Fortuna · Región de Murcia"
				title="Cocina española<br /><em>y raciones de las de antes.</em>"
				lede={`En la Avenida Narciso Yepes, 22, a la entrada de Fortuna. Arroces, carnes a la brasa, platos de cuchara y entrantes para compartir, con el menú del día de lunes a sábado. Reservas en el ${BUSINESS.phoneDisplay}.`}
				image={mesaPuesta}
				imageAlt="Mesa preparada con la carta de Restaurante El Rocío y el cartel de reservado, en Fortuna"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${BUSINESS.rating.toFixed(1).replace('.', ',')}</b> en Google (${BUSINESS.reviewsCount} reseñas)` },
					{ label: 'Horario', html: 'Lunes a sábado, 9:00–18:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phoneDisplay}</b>` },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Restaurante El Rocío" items={SERVICIOS} />

			<LocalAbout
				label="El restaurante"
				title="Cocina de casa<br /><em>en Fortuna.</em>"
				paragraphs={[
					`Restaurante "El Rocío" está en la Avenida Narciso Yepes, 22, en Fortuna (30620, Murcia). Un restaurante de cocina española de los de mantel y servicio de siempre, con mesas grandes, carta impresa en la mesa y aparcamiento en la zona.`,
					'Se come de todo y abundante: entrantes para compartir como mejillones, almejas a la marinera, gambas al ajillo o calamares a la plancha; arroces al fuego, entre ellos el arroz con conejo y caracoles y la paella; carnes a la brasa al punto y platos de cuchara como el potaje de alubias con chorizo y morcilla.',
					'La ficha de Google no publica la carta completa ni los precios, así que aquí no se inventan: lo que hay en esta web es lo que se ve en sus fotos y lo que cuentan sus reseñas. Para el día a día está el menú del día, con primero, segundo y postre.',
				]}
				note={`La nota media en Google es ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre ${BUSINESS.reviewsCount} opiniones. Lo que más se repite es el tamaño de las raciones —hay quien las llama «enormes»— y la paella; también hay quien las considera caras para lo que son, así que pregunta precios antes de pedir de más.`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.cid, external: true },
					{ label: `Llamar al ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Entrantes, arroces<br /><em>y brasa.</em>"
				description="Resumen de lo que se sirve, sacado de las fotos de la ficha de Google Maps del restaurante. No es la carta completa ni tiene precios: pídelos en el local o al reservar."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La carta cambia con la temporada y el mercado. Si vas por un plato concreto, llámanos antes: no publicamos precios porque el restaurante no los tiene publicados."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Los platos<br /><em>y la mesa.</em>"
				description="Estas fotografías proceden del perfil de Restaurante El Rocío en Google Maps, con imágenes de la ficha y de sus clientes. En la ficha del restaurante están todas las fotos y las reseñas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} Fortuna`}
				title="Nos vemos<br /><em>en El Rocío.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					`${BUSINESS.regionName}, España`,
				]}
				hours={HOURS}
				hoursNote="Horario publicado en la ficha de Google. Abre de lunes a sábado y cierra los domingos; en festivos y puentes puede cambiar, así que confírmalo por teléfono si vienes de lejos."
				mapTitle="Mapa de Restaurante El Rocío en la Avenida Narciso Yepes, 22, Fortuna, Murcia"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Restaurante El Rocío · Fortuna"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Aparcamiento en la zona', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva llamando al restaurante. La ficha de Google indica acceso, aparcamiento, aseo y asientos adaptados para sillas de ruedas; si necesitas una mesa concreta, avisa al reservar."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.cid, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a El Rocío"
		/>
	</body>
</html>
