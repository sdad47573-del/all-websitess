---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/itxaropena-1910-apaisada-01.jpg';
import zamburinas from '../assets/fotos/itxaropena-1910-apaisada-02.jpg';
import entrada from '../assets/fotos/itxaropena-1910-panoramica-03.jpg';
import barra from '../assets/fotos/itxaropena-1910-apaisada-04.jpg';
import carta from '../assets/fotos/itxaropena-1910-vertical-05.jpg';
import puerta from '../assets/fotos/itxaropena-1910-vertical-06.jpg';
import calamares from '../assets/fotos/itxaropena-1910-cuadrada-07.jpg';
import tartar from '../assets/fotos/itxaropena-1910-apaisada-08.jpg';
import zamburinasDos from '../assets/fotos/itxaropena-1910-vertical-09.jpg';
import interior from '../assets/fotos/itxaropena-1910-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Itxaropena 1910, bar restaurante en Enbeltran Kalea, 16 (20003 Donostia / San Sebastián). Tapas, pintxos, raciones y vinos, con 4,3 sobre 5 en Google y 1.588 reseñas. Teléfono 943 43 62 10. Cierra los miércoles.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de Itxaropena 1910 en Enbeltran Kalea, con el toldo negro y una pizarra en la puerta',
	},
	{
		src: entrada,
		alt: 'Entrada de Itxaropena 1910 con la carta expuesta y clientes en la barra',
	},
	{
		src: zamburinas,
		alt: 'Dos zamburiñas con cebolla morada en un plato blanco',
	},
	{
		src: calamares,
		alt: 'Calamares fritos con limón y salsa alioli',
	},
	{
		src: tartar,
		alt: 'Tartar de carne con yema de huevo y puré de patata',
	},
	{
		src: carta,
		alt: 'Carta en francés del local con tapas y raciones',
	},
	{
		src: puerta,
		alt: 'Puerta de madera de Itxaropena 1910 con una bandera azul y blanca en el balcón',
	},
	{
		src: zamburinasDos,
		alt: 'Zamburiñas con salsa y cebolla morada, vistas desde arriba',
	},
	{
		src: interior,
		alt: 'Mesa con una croqueta, judías verdes y una copa de vino blanco, con la pizarra de raciones al fondo',
	},
	{
		src: barra,
		alt: 'Barra de Itxaropena 1910 con bandejas de pintxos y botellas en las estanterías',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#itxaropena-1910`,
	name: BUSINESS.name,
	alternateName: ['Itxaropena', 'Itxaropena Donostia', 'Bar Itxaropena', 'Itxaropena 1910 Donostia'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: `+34 ${BUSINESS.phone}`,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Tapas', 'Pintxos', 'Raciones'],
	areaServed: [
		{ '@type': 'City', name: 'Donostia / San Sebastián' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '12:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La barra', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Itxaropena 1910 · Tapas y vinos en Donostia';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#26323a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Public+Sans:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Itxaropena 1910, Itxaropena Donostia, bar Itxaropena, tapas Donostia, pintxos Donostia, raciones Donostia, vinoteca Donostia, Enbeltran Kalea, restaurante Donostia"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Bar restaurante y vinoteca en Enbeltran Kalea, 16 (Donostia). Tapas, pintxos y raciones, con 4,3 sobre 5 en Google y 1.588 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Barra de Itxaropena 1910 con bandejas de pintxos y botellas en las estanterías"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#26323a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Enbeltran Kalea, Donostia"
			preload={[barra]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Itxaropena"
			subtitle="Tapas y vinos · Donostia"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Enbeltran Kalea, 16 · Donostia"
				title="Tapas, raciones <br /><em>y vinos.</em>"
				lede={`Itxaropena 1910 es un bar restaurante en Enbeltran Kalea, 16, en Donostia. Google lo presenta como «tapas en un restaurante con paredes de piedra» y le da 4,3 sobre 5 con 1.588 reseñas. Abre de jueves a martes, de 12:00 a 23:00, y cierra los miércoles: para venir, llama al ${BUSINESS.phone}.`}
				image={barra}
				imageAlt="Barra de Itxaropena 1910 con bandejas de pintxos y botellas en las estanterías"
				primaryCta={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver ficha de Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,3</b> en Google · 1.588 reseñas' },
					{ label: 'La casa', html: '<b>Tapas</b> y raciones' },
					{ label: 'Horario', html: '<b>Miércoles</b> cerrado' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Itxaropena 1910" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Piedra, tapas <br /><em>y buen vino.</em>"
				paragraphs={[
					'En el número 16 de Enbeltran Kalea está Itxaropena 1910, un bar restaurante que Google puntúa con 4,3 sobre 5 a partir de 1.588 reseñas.',
					'Google lo presenta como «tapas en un restaurante con paredes de piedra». Su ficha no publica descripción propia, carta completa, precios, correo ni web, así que esta web no los inventa.',
					'Sus reseñas hablan de una vinoteca con pinchos y raciones «muy buenas a precio razonable», y citan la ensalada de alcachofas, el taco de chuleta, las carrilleras y el pintxo de zamburiñas.',
					'La ficha marca acceso para sillas de ruedas, aseo adaptado y asientos adaptados, y también indica que no hay aparcamiento adaptado.',
				]}
				note={`Tiene ${BUSINESS.rating.toFixed(1).replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount.toLocaleString('es-ES')} opiniones en Google. Cierra los miércoles; el resto de días abre de 12:00 a 23:00.`}
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<LocalMenu
				eyebrow="La barra"
				title="Lo que citan <br /><em>las reseñas.</em>"
				description="La ficha de Google no publica carta completa ni precios. Esto no es un menú: es lo que dicen sus opiniones y la frase con la que Google describe el local."
				cta={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="No hay precios publicados en la ficha. Para saber qué hay hoy, lo más directo es llamar al 943 43 62 10."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Diez fotos <br /><em>de la casa.</em>"
				description="Las diez fotografías publicadas en el perfil de Itxaropena 1910 en Google Maps: la fachada, la barra, los pintxos y sus platos."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del establecimiento en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a Enbeltran <br /><em>a tapear.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, `${BUSINESS.regionName}, España`]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario de la ficha de Google: de jueves a martes de 12:00 a 23:00; los miércoles cierra. Conviene confirmarlo por teléfono antes de ir."
				mapTitle="Mapa de Itxaropena 1910 en Enbeltran Kalea, 16, Donostia"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Itxaropena 1910 · Donostia"
				mapHref={MAPS.cid}
				links={[
					{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref, variant: 'primary' },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="El teléfono 943 43 62 10 es el único canal de contacto que publica la ficha de Google: no hay correo ni web propia. La ficha marca acceso, aseo y asientos adaptados, pero no aparcamiento adaptado."
			/>

			<LocalFaq items={FAQ} />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Itxaropena"
		/>
	</body>
</html>
