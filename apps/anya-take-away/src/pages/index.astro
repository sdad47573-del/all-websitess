---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalHero,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import portada from '../assets/fotos/anya-take-away-portada.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Anya Take Away · Comida para llevar y a domicilio en Andorra la Vella';
const description =
	'Anya Take Away, Andorra la Vella. Comida a domicilio y restaurante familiar: servicio para llevar y reparto por teléfono (+376 666 669). 4,9 sobre 5 con 7 reseñas. Abre de 8:00 a 22:00; martes y domingo hasta las 15:00.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#anya-take-away`,
	name: BUSINESS.name,
	alternateName: ['Anya', 'Anya Takeaway', 'Anya Take Away Andorra'],
	description:
		'Comida a domicilio y restaurante familiar en Andorra la Vella: servicio para llevar y reparto por teléfono.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+376666669',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida para llevar'],
	hasDelivery: true,
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Andorra la Vella' },
		{ '@type': 'AdministrativeArea', name: 'Andorra' },
	],
	address: {
		'@type': 'PostalAddress',
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Plus Code', value: BUSINESS.plusCode },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:00',
			closes: '22:00',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Tuesday', opens: '08:00', closes: '15:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '09:00', closes: '15:00' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1b2a2b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&family=Public+Sans:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Anya Take Away Andorra, comida a domicilio Andorra la Vella, comida para llevar Andorra, restaurante familiar Andorra, pedidos por teléfono Andorra la Vella"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida a domicilio y restaurante familiar en Andorra la Vella. Pedidos por teléfono, de 8:00 a 22:00. 4,9 en Google con 7 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tarjeta con el nombre Anya Take Away y el teléfono, sobre fondo verde oscuro"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1b2a2b"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="AD-07"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={BUSINESS.district}
			locale="es_ES"
			countryName="Andorra"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[portada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Anya Take Away"
			subtitle="Comida a domicilio · Andorra la Vella"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Andorra la Vella · AD500"
				title="Comida para llevar <br /><em>y a domicilio.</em>"
				lede={`Anya Take Away es un negocio de comida a domicilio y restaurante familiar en Andorra la Vella. Funciona por teléfono —no hay web propia ni pedidos online—, abre de 8:00 a 22:00 de lunes a sábado y cierra a media tarde el martes y el domingo. Google le da ${RATING.label} sobre 5, aunque con solo ${RATING.count} reseñas.`}
				image={portada}
				imageAlt="Tarjeta de Anya Take Away con el teléfono y el dibujo de una bolsa de comida para llevar"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha en Google Maps', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>8:00–22:00</b> · de lunes a sábado' },
					{ label: 'Servicio', html: '<b>A domicilio</b> · y para llevar' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Portada gráfica de esta web: la ficha de Google no tiene fotos"
				galleryLinkLabel="Ver la ficha en Google Maps"
				tag="Take away"
			/>

			<LocalChips label="Lo que ofrece Anya Take Away" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Andorra la Vella, <br /><em>puerta a puerta.</em>"
				paragraphs={[
					'Anya Take Away es un negocio de comida para llevar y a domicilio de Andorra la Vella. La ficha de Google lo sitúa en las coordenadas 42.506709, 1.5187141, Plus Code GG49+MF, y publica el teléfono +376 666 669 como única vía de contacto.',
					'La ficha no publica la calle: el campo de dirección solo trae «Ad500», que es el código postal. Tampoco tiene fotos en el perfil ni carta ni precios. Por eso esta web no enseña una galería de platos ni una carta inventada: lo que hay es lo que dice la ficha, y el resto se pregunta por teléfono.',
					'Google lo clasifica con dos categorías: «Comida a domicilio» y «Restaurante familiar». La primera explica el negocio —se pide y se lleva a casa— y la segunda el tipo de cocina: comida de casa, para todos los días, no de carta larga.',
					`El horario es amplio: de 8:00 a 22:00 de lunes a sábado, con el martes cerrando a las 15:00, y el domingo de 9:00 a 15:00. La valoración es de ${RATING.label} sobre 5, pero con solo ${RATING.count} reseñas: es una ficha nueva y no permite hablar de una media consolidada.`,
				]}
				note="Google no publica la dirección exacta de este negocio. Para una ubicación fiable, usa el mapa de esta página o llama al +376 666 669 antes de ir."
				links={[
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> El servicio</p>
					<h2 id="highlights-title">Se pide, se recoge <br /><em>o se reparte.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,9 sobre 5, <em>con solo 7 reseñas.</em></h2>
						<p>
							Siete opiniones son demasiado pocas para sacar conclusiones, y preferimos decirlo
							antes que lucir un 4,9 que todavía no significa gran cosa. Lo que sí está claro es el
							horario y el tipo de servicio: comida a domicilio y para llevar.
						</p>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver las reseñas en Google <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,9</strong>
						<span>★★★★★</span>
						<small>7 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow="Andorra la Vella · AD500"
				title="Sin calle publicada, <br /><em>con mapa.</em>"
				addressLines={[
					'Andorra la Vella (la ficha no publica la calle)',
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Principado de Andorra',
				]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de 8:00 a 22:00 de lunes a sábado (el martes hasta las 15:00) y el domingo de 9:00 a 15:00. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Anya Take Away en Andorra la Vella"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Andorra la Vella · Plus Code GG49+MF"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote={`Los pedidos se hacen por teléfono, en el ${BUSINESS.phone}: el local no tiene web propia ni pedidos online. Conviene preguntar en la misma llamada por la zona de reparto, el importe mínimo y la dirección exacta de recogida.`}
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`Andorra la Vella · ${BUSINESS.postalCode}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y valoración de la ficha pública de Google Maps, consultada en noviembre de 2026. La ficha no tiene fotos: la portada es un gráfico de esta web."
			ctaLabel="Llamar a Anya Take Away"
			navAriaLabel="Enlaces de Anya Take Away"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
