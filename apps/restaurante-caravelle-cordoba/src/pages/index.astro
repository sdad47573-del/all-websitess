---
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	facebookPhotosUrl,
	facebookUrl,
	faqSchema,
	faqs,
	mapEmbedUrl,
	mapsPhotosUrl,
	mapsUrl,
	openingHours,
	phoneHref,
	restaurantSchema,
	specialties,
	tripadvisorUrl,
} from '../lib/business';

const title = 'Restaurante Caravelle | Cocina tradicional en Poniente Sur, Córdoba';
const description =
	'Restaurante Caravelle en Córdoba: cocina tradicional andaluza en Poniente Sur. Salmorejo cremoso, berenjenas con salmorejo, fabes con mejillones, croquetas de boletus y frituras. Terraza y para llevar. C. José María Martorell, 40 · 957 41 09 65.';
const keywords =
	'Restaurante Caravelle Córdoba, Caravelle Córdoba, comer en Poniente Sur Córdoba, cocina tradicional Córdoba, salmorejo Córdoba, berenjenas con salmorejo, croquetas de boletus Córdoba, fabes con mejillones, calamares fritos, restaurante José María Martorell 40 Córdoba, reserva restaurante Córdoba';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#4a2b3f" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Nunito+Sans:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración original de azulejos con un pez para Restaurante Caravelle; no es una fotografía del establecimiento" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante Caravelle, inicio">
				<span class="brand-mark" aria-hidden="true">CV</span>
				<span class="brand-copy">Caravelle <small>Restaurante · Córdoba</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">La carta</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 957 41 09 65</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Poniente Sur · Córdoba</p>
					<h1 id="hero-title">Cocina de toda<br /><em>la vida, bien hecha.</em></h1>
					<p class="hero-intro">Restaurante Caravelle es una casa de comidas de Poniente Sur con ambiente tranquilo y familiar: salmorejo cremoso, berenjenas crujientes, fabes con mejillones, croquetas de boletus y una fritura que no resulta pesada. Producto fresco y precios justos.</p>
					<div class="hero-actions">
						<a class="button button-apricot" href={phoneHref}>Reservar por teléfono <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Nos encontrarás en</small><address>{business.streetAddress}<br />{business.postalCode} · Córdoba</address></div>
						<div><small>Reservas</small><a href={phoneHref}>{business.phone}</a><br /><a href={mapsUrl} target="_blank" rel="noreferrer">Ficha en Google Maps ↗</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración original de un panel de azulejos; no es una fotografía del establecimiento">
					<span class="art-tile" aria-hidden="true"></span>
					<div class="azulejos" aria-hidden="true">
						<i class="rayas"></i><i class="puntos"></i><i class="pez"></i><i class="cuadros"></i><i class="rayas b"></i><i class="puntos b"></i>
					</div>
					<div class="sala-tag" aria-hidden="true"><small>Terraza y salón</small><strong>Comidas y cenas</strong><span>De 12:00 a 16:00 y de 20:00 a 01:00</span></div>
					<div class="art-caption"><strong>Caravelle</strong>Cocina tradicional</div>
				</div>
			</section>

			<div class="promise" aria-label="Información de Restaurante Caravelle">
				<span>Cocina tradicional</span><span>Salmorejo y berenjenas</span><span>Frituras y guisos</span><span>Terraza y para llevar</span>
			</div>

			<section class="section intro" id="casa" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Una casa de comidas en Poniente Sur</p>
					<h2 id="intro-title">Producto fresco,<br /><em>raciones sin medida.</em></h2>
				</div>
				<div class="intro-copy">
					<p>En la calle José María Martorell, Caravelle es uno de esos restaurantes de barrio que llevan años ganándose a la clientela de Poniente Sur. La cocina es tradicional andaluza, con producto fresco y sin artificios: guisos de cuchara, frituras, carnes y el salmorejo que muchos consideran de los mejores de la ciudad.</p>
					<p>El local, dirigido por Juan, tiene salón interior y terraza, sirve comidas de mediodía y cenas hasta la una de la madrugada y ofrece comida para llevar. El equipo atiende también las alergias alimentarias: prepara los platos en freidoras separadas con aceite limpio cuando un cliente lo necesita.</p>
					<p class="source-note">La información de esta página procede de la ficha de Google Maps, de la página de Facebook del restaurante y de directorios gastronómicos. La carta y los horarios pueden cambiar: confirma antes de tu visita.</p>
				</div>
			</section>

			<section class="section carta" id="carta" aria-labelledby="carta-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Carta tradicional</p>
						<h2 id="carta-title">Platos que<br /><em>repiten los clientes.</em></h2>
					</div>
					<p>Una selección orientativa de los platos más mencionados por la clientela en reseñas y fuentes gastronómicas. No sustituye la carta vigente.</p>
				</div>
				<div class="carta-grid">
					{specialties.map((dish, index) => (
						<article class="carta-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<div class="carta-extra">
					<p><strong>Relación calidad-precio:</strong> muy valorada por los comensales, con raciones generosas y precios moderados.</p>
					<p><strong>Alergias:</strong> el equipo puede preparar platos en freidoras separadas con aceite limpio. Comunícaselo al reservar.</p>
					<p class="menu-note">Consulta la carta, los platos del día y los alérgenos con el restaurante. <a href={phoneHref}>Llama al 957 41 09 65</a>.</p>
				</div>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<div class="gallery-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Imágenes del restaurante</p>
						<h2 id="gallery-title">Caravelle,<br /><em>en fotos.</em></h2>
					</div>
					<p>Consulta fotos reales del local, de la terraza y de los platos en la ficha de Google Maps, en Facebook y en Tripadvisor.</p>
				</div>
				<div class="gallery-grid">
					<a class="photo-card" href={mapsPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Restaurante Caravelle en Google Maps">
						<span class="photo-label">Fotos de la ficha</span><span class="photo-title">Google Maps <span aria-hidden="true">↗</span></span>
					</a>
					<a class="photo-card alt" href={facebookPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Caravelle Córdoba en Facebook">
						<span class="photo-label">Página del negocio</span><span class="photo-title">Facebook <span aria-hidden="true">↗</span></span>
					</a>
					<a class="photo-card alt2" href={tripadvisorUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de Caravelle en Tripadvisor">
						<span class="photo-label">Fotos de viajeros</span><span class="photo-title">Tripadvisor <span aria-hidden="true">↗</span></span>
					</a>
				</div>
				<p class="gallery-note">El enlace de Google Maps identifica la ficha, pero no expone URLs directas a los archivos de imagen, por lo que las fotos se consultan en las galerías enlazadas. Las ilustraciones de esta web son gráficos originales, no fotografías del establecimiento.</p>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14005 · Poniente Sur, Córdoba</p>
					<h2 id="visit-title">Ven a comer<br /><em>a Caravelle.</em></h2>
					<address>{business.streetAddress}<br />{business.postalCode} {business.locality}<br />{business.province}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Reservas y consultas</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Ubicación</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Redes y reseñas</small><a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a> · <a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar y reservar</a>
					</div>
					<p class="hours-note">Se recomienda reservar los fines de semana y en días de alta ocupación. Los horarios pueden variar en festivos: llama antes de desplazarte.</p>
				</div>
				<div class="visit-side">
					<div class="hours-card">
						<h3>Horario orientativo</h3>
						<ul>
							{openingHours.map((slot) => (
								<li><span>{slot.day}</span><strong>{slot.hours}</strong></li>
							))}
						</ul>
					</div>
					<div class="map-card">
						<div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
							<button type="button" data-cargar-mapa aria-label="Cargar mapa interactivo" style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
								<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
								<strong style="font-size:1rem;">Cargar mapa interactivo</strong>
								<small style="opacity:0.65;">Se carga solo al pulsar</small>
							</button>
<iframe title="Mapa de Restaurante Caravelle en Calle José María Martorell, Córdoba" data-src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-label"><div><strong>Restaurante Caravelle</strong><small>José María Martorell, 40 · Córdoba</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
			<Galeria nombre="Restaurante Caravelle" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="Restaurante Caravelle, volver al inicio">
				<span class="brand-mark" aria-hidden="true">CV</span><span class="brand-copy">Caravelle <small>Restaurante · Poniente Sur</small></span>
			</a>
			<nav class="footer-nav" aria-label="Fuentes y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Restaurante Caravelle · Córdoba. Consulta horarios, carta y alérgenos directamente con el establecimiento.</small>
		</footer>
		<a class="mobile-call" href={phoneHref}>Reservar en Caravelle <span>957 41 09 65</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>

<script>
// mapa-fachada: la URL del iframe vive en data-src y solo se asigna al pulsar (ahorra ~1MB de JS).
document.addEventListener('click', function (e) {
	var t = e.target && e.target.closest ? e.target.closest('[data-cargar-mapa]') : null;
	if (!t) return;
	var w = t.closest('[data-mapa-fachada]');
	if (!w || w.dataset.cargado) return;
	var f = w.querySelector('iframe');
	if (!f || !f.dataset.src || f.getAttribute('src')) return;
	w.dataset.cargado = '1';
	f.setAttribute('src', f.dataset.src);
	t.remove();
});
</script>
