---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import vitrina from '../assets/fotos/asador-onapulitan-apaisada-03.jpg';
import pastaFrita from '../assets/fotos/asador-onapulitan-apaisada-07.jpg';
import asador from '../assets/fotos/asador-onapulitan-vertical-01.jpg';
import panecillos from '../assets/fotos/asador-onapulitan-vertical-02.jpg';
import bocadillo from '../assets/fotos/asador-onapulitan-vertical-04.jpg';
import rollos from '../assets/fotos/asador-onapulitan-vertical-05.jpg';
import croquetasRedondas from '../assets/fotos/asador-onapulitan-vertical-06.jpg';
import bebidas from '../assets/fotos/asador-onapulitan-vertical-08.jpg';
import croquetas from '../assets/fotos/asador-onapulitan-vertical-09.jpg';
import pizza from '../assets/fotos/asador-onapulitan-vertical-10.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = "Asador O'Napulitan · Cocina napolitana para llevar en Málaga";
const description =
	"Asador O'Napulitan, en C. Lara Castañeda, 19 (Puerto de la Torre, 29190 Málaga). Cocina casera napolitana para llevar: bocadillos, pizza al taglio, croquetas y tiramisú.";

const galeria = [
	{
		src: vitrina,
		alt: 'La vitrina de Asador O\'Napulitan con pizza, empanadas, ensaladilla, carne, postres y bebidas',
	},
	{
		src: asador,
		alt: 'El asador giratorio del local con pollos asándose y una bandeja de patatas en la base',
	},
	{
		src: bocadillo,
		alt: 'Un bocadillo de pollo con pimientos y salsa junto al cartel de pollos asados recién hechos',
	},
	{
		src: pizza,
		alt: 'Porciones de pizza al taglio con tomate, mozzarella y albahaca en la vitrina',
	},
	{
		src: croquetas,
		alt: 'Croquetas alargadas recién fritas en un plato',
	},
	{
		src: croquetasRedondas,
		alt: 'Cuatro croquetas redondas fritas en una bandeja metálica',
	},
	{
		src: pastaFrita,
		alt: 'Trozos de pasta frita dorada, cortados en porciones, sobre un plato metálico',
	},
	{
		src: rollos,
		alt: 'Bandeja de rollos de masa rellenos de bacon y queso gratinado',
	},
	{
		src: panecillos,
		alt: 'Bollos de pan redondos recién horneados sobre papel de horno',
	},
	{
		src: bebidas,
		alt: 'El escaparate del local con cervezas Peroni y Messina, vinos italianos, taralli y conservas',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: "Carta de Asador O'Napulitan",
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
			...(item.price
				? {
						offers: {
							'@type': 'Offer',
							price: item.price.replace(' €', '').replace(',', '.'),
							priceCurrency: 'EUR',
						},
					}
				: {}),
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#onapulitan`,
	name: BUSINESS.name,
	alternateName: ["Asador O'Napulitan Málaga", "O'Napulitan Puerto de la Torre", 'Asador Onapulitan'],
	description:
		'Cocina casera napolitana para llevar en la calle Lara Castañeda, 19, Puerto de la Torre (29190 Málaga). Bocadillos, pizza al taglio, croquetas, pollos asados y tiramisú.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34672723282',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina napolitana', 'Comida casera', 'Comida para llevar'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Puerto de la Torre' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Monday',
			opens: '11:30',
			closes: '15:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:30',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#191411" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Manrope:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador O'Napulitan, comida napolitana Málaga, cocina casera Puerto de la Torre, bocadillos Málaga, pizza al taglio Málaga, tiramisú, croquetas, comida para llevar Lara Castañeda"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Cocina casera napolitana para llevar en la calle Lara Castañeda, 19, Puerto de la Torre. Bocadillos, pizza al taglio, croquetas y tiramisú."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La vitrina de Asador O'Napulitan con pizza, bocadillos y comida casera"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#191411"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Puerto de la Torre"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="O'Napulitan"
			subtitle="Cocina napolitana · Puerto de la Torre"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Lara Castañeda, 19 · Puerto de la Torre, Málaga"
				title="Nápoles <br /><em>en Málaga.</em>"
				lede={`O'Napulitan es una casa napolitana de comida para llevar en Puerto de la Torre. La vitrina mezcla pizza al taglio, bocadillos, croquetas y pasta frita con los pollos del asador, y la cocina sigue las recetas de familia que la casa trae «desde el corazón de Nápoles». Abre todos los días, de 11:30 a 16:00, y tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={vitrina}
				imageAlt="La vitrina de Asador O'Napulitan con pizza, empanadas, ensaladilla, carne, postres y bebidas"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>11:30–16:00</b> · todos los días' },
					{ label: 'Cocina', html: '<b>Napolitana y casera</b> · para llevar' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Recetas de Nápoles · hechas en Málaga"
			/>

			<LocalChips label="Lo que ofrece Asador O'Napulitan" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una familia napolitana <br /><em>en Puerto de la Torre.</em>"
				paragraphs={[
					"O'Napulitan está en la calle Lara Castañeda, 19, en Puerto de la Torre. El local es pequeño y la vitrina manda: pizza al taglio, bocadillos, croquetas, pasta frita, rollos rellenos y postres conviven con el asador de pollos y la bandeja de patatas.",
					'La ficha de Google cuenta la historia con orgullo: «Somos napolitanos. Nuestra historia nace de una tradición familiar que pasa de generación en generación, desde el corazón de Nápoles hasta Málaga». Y añade: «Cada plato que preparamos es un pedacito de nuestra tierra».',
					'La casa se presenta como «Asador O\'Napulitan (cocina casera y más)» y promete «ingredientes de calidad, recetas auténticas y, sobre todo, ¡MUCHO AMOR!». Abre todos los días: el lunes de 11:30 a 15:30 y de martes a domingo de 11:30 a 16:00.',
					'Google le da 5,0 sobre 5 con 18 reseñas. Una destaca los bocadillos y el tiramisú; otra celebra tener cerca «comida preparada diferente»; y una tercera habla de «una familia encantadora y muy buenos cocineros».',
				]}
				note="La ficha no publica página web, carta ni precios. Los platos de esta página son los que nombran la descripción del negocio, las reseñas y las fotos de su perfil de Google. La disponibilidad se consulta por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que se cocina</p>
					<h2 id="highlights-title">Recetas de Nápoles <br /><em>y vitrina de barrio.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Del mostrador <br /><em>a la mesa de casa.</em>"
				description="La ficha de Google no publica carta ni precios. Esto es lo que nombran la descripción del negocio y las reseñas, más los platos que aparecen en las fotos del local."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La ficha no publica precios. Los platos de esta lista son los que aparecen en la galería del perfil de Google del local, consultada en octubre de 2026, y los que nombran la descripción y las reseñas. La disponibilidad cambia: confírmala por teléfono."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La vitrina <br /><em>y el asador.</em>"
				description="Diez fotografías del perfil de Asador O'Napulitan en Google Maps: la vitrina, el asador de pollos, el bocadillo, la pizza al taglio, las croquetas, la pasta frita y el escaparate de bebidas italianas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">5,0 sobre 5, <em>con 18 reseñas.</em></h2>
						<p>
							La valoración que publica Google en noviembre de 2026 es de 5,0 con 18 opiniones. Las
							reseñas destacadas hablan de los bocadillos, del tiramisú, de la comida preparada y
							del trato de la familia; aquí se reproducen tal como aparecen en la ficha.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>5,0</strong>
						<span>★★★★★</span>
						<small>18 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En Puerto de la Torre, <br /><em>Lara Castañeda.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: lunes de 11:30 a 15:30 y de martes a domingo de 11:30 a 16:00. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Asador O'Napulitan en la calle Lara Castañeda, 19, Puerto de la Torre, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. Lara Castañeda, 19 · Puerto de la Torre"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos y consultas por teléfono: la ficha no publica reservas ni pedidos online. La ficha tampoco publica datos de accesibilidad, así que conviene llamar antes si necesitas acceso para silla de ruedas."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a O'Napulitan"
			navAriaLabel="Enlaces de Asador O'Napulitan"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
