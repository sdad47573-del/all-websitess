---
import '../styles/global.css';
import { BUSINESS, MAPS, RATING } from '../data/site';
import foto from '../assets/fotos/las-fritas-01.jpg';

const title = `${BUSINESS.name} · ${BUSINESS.city}`;
const description = BUSINESS.description;
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
	<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Restaurant",
	"@id": "https://las-fritas.vercel.app/#negocio",
	"name": "Las Fritas",
	"url": "https://las-fritas.vercel.app/",
	"description": "Las Fritas, snack bar en Gurutze Kalea, 6 (Ibaiondo, 48005 Bilbao, Bizkaia). Según su ficha de Google Maps, snack bar.",
	"image": "https://las-fritas.vercel.app/og.jpg",
	"telephone": "+34946057624",
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 43.258029,
		"longitude": -2.9222647
	},
	"hasMap": "https://www.google.com/maps/place/Las+Fritas/@43.258029,-2.9222647,16z/data=!3m1!4b1!4m6!3m5!1s0xd4e4fcbfa2f9a7f:0xd93063718d46b380!8m2!3d43.258029!4d-2.9222647!16s%2Fg%2F11b7ck8v3q?authuser=0&hl=es&entry=ttu"
}
</script>
</head>
	<body>
		<header class="site-header">
			<h1 set:html={piezas.portada.titulo} />
			<p>{BUSINESS.tagline}</p>
		</header>
		<main>
			<img src={foto.src} width={foto.width} height={foto.height} alt={`Foto de ${BUSINESS.name}`} />
			<section>
				<h2>Dirección</h2>
				<p>{BUSINESS.street}, {BUSINESS.postalCode} {BUSINESS.city}</p>
				<p>Teléfono: <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a></p>
				<p>Valoración en Google Maps: {RATING.label}</p>
				<p><a href={MAPS.place} target="_blank" rel="noreferrer">Ver en Google Maps</a> · <a href={MAPS.directions} target="_blank" rel="noreferrer">Cómo llegar</a></p>
			</section>
		</main>
		<footer class="site-footer">
			<p>© {new Date().getFullYear()} {BUSINESS.fullName}</p>
			<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a> · sur-digital.vercel.app</small>
		</footer>
	</body>
</html>
