---
import Footer from '../components/Footer.astro';
---

<div class="min-h-screen bg-white">
	<section
		class="relative flex h-screen items-center justify-center bg-cover bg-center"
		style='background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url("https://readdy.ai/api/search-image?query=Modern%20vaping%20store%20interior%20with%20sleek%20displays%2C%20contemporary%20lighting%2C%20premium%20vaping%20devices%20showcased%2C%20professional%20retail%20environment%2C%20clean%20minimalist%20design%2C%20warm%20ambient%20lighting%2C%20sophisticated%20atmosphere&width=1920&height=1080&seq=7&orientation=landscape");'
	>
		<div class="mx-auto max-w-4xl px-6 text-center text-white">
			<h1 class="mb-6 text-6xl font-bold" style="font-family: Pacifico, serif;">VapeStore</h1><p
				class="mb-8 text-2xl font-light"
			>
				La mejor selección de vapers y líquidos premium
			</p><p class="mx-auto mb-12 max-w-2xl text-lg opacity-90">
				Descubre nuestra amplia gama de dispositivos de vapeo de alta calidad, líquidos premium y
				accesorios para una experiencia única
			</p><div class="flex flex-col justify-center gap-4 sm:flex-row">
				<button
					class="cursor-pointer rounded-full bg-teal-500 px-8 py-4 text-lg font-semibold whitespace-nowrap text-white transition-colors hover:bg-teal-600"
					>Ver Productos</button
				><button
					class="cursor-pointer rounded-full border-2 border-white px-8 py-4 text-lg font-semibold whitespace-nowrap text-white transition-colors hover:bg-white hover:text-gray-900"
					>Guía para Principiantes</button
				>
			</div>
		</div>
	</section><section class="bg-gray-50 py-16">
		<div class="mx-auto max-w-7xl px-6">
			<h2 class="mb-12 text-center text-4xl font-bold text-gray-900">
				Explora Nuestras Categorías
			</h2><div class="mb-12 flex flex-wrap justify-center gap-4">
				<button
					class="cursor-pointer rounded-full bg-teal-500 px-6 py-3 font-semibold whitespace-nowrap text-white transition-colors"
					>Todos</button
				><button
					class="cursor-pointer rounded-full bg-white px-6 py-3 font-semibold whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-100"
					>Kits Iniciales</button
				><button
					class="cursor-pointer rounded-full bg-white px-6 py-3 font-semibold whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-100"
					>Mods</button
				><button
					class="cursor-pointer rounded-full bg-white px-6 py-3 font-semibold whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-100"
					>Líquidos</button
				><button
					class="cursor-pointer rounded-full bg-white px-6 py-3 font-semibold whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-100"
					>Accesorios</button
				>
			</div>
		</div>
	</section><section class="py-16" data-product-shop="true">
		<div class="mx-auto max-w-7xl px-6">
			<h2 class="mb-12 text-center text-4xl font-bold text-gray-900">Productos Destacados</h2><div
				class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3"
			>
				<div
					class="cursor-pointer overflow-hidden rounded-2xl bg-white shadow-lg transition-shadow hover:shadow-xl"
				>
					<div class="relative">
						<img
							alt="Kit Vaper Pro X1"
							class="h-64 w-full object-cover object-top"
							src="https://readdy.ai/api/search-image?query=Modern%20sleek%20electronic%20vaping%20device%20kit%20with%20metallic%20finish%2C%20professional%20product%20photography%20on%20clean%20white%20background%2C%20minimalist%20design%2C%20premium%20quality%20appearance%2C%20studio%20lighting&width=300&height=300&seq=1&orientation=squarish"
						/><div
							class="absolute top-4 right-4 rounded-full bg-red-500 px-3 py-1 text-sm font-semibold text-white"
						>
							-25%
						</div>
					</div><div class="p-6">
						<h3 class="mb-2 text-xl font-bold text-gray-900">Kit Vaper Pro X1</h3><div
							class="mb-3 flex items-center"
						>
							<div class="flex text-yellow-400">
								<i class="ri-star-fill text-sm"></i><i class="ri-star-fill text-sm"></i><i
									class="ri-star-fill text-sm"></i><i class="ri-star-fill text-sm"></i><i
									class="ri-star-line text-sm"></i>
							</div><span class="ml-2 text-sm text-gray-600">(124 reseñas)</span>
						</div><div class="flex items-center justify-between">
							<div class="flex items-center gap-2">
								<span class="text-2xl font-bold text-teal-600">€89.99</span><span
									class="text-lg text-gray-400 line-through">€119.99</span
								>
							</div><button
								class="cursor-pointer rounded-full bg-teal-500 px-6 py-2 font-semibold whitespace-nowrap text-white transition-colors hover:bg-teal-600"
								>Añadir</button
							>
						</div>
					</div>
				</div><div
					class="cursor-pointer overflow-hidden rounded-2xl bg-white shadow-lg transition-shadow hover:shadow-xl"
				>
					<div class="relative">
						<img
							alt="Mod Avanzado Zeus"
							class="h-64 w-full object-cover object-top"
							src="https://readdy.ai/api/search-image?query=Advanced%20vaping%20mod%20device%20with%20digital%20display%2C%20premium%20metallic%20construction%2C%20professional%20product%20photography%20on%20clean%20white%20background%2C%20high-tech%20appearance%2C%20studio%20lighting&width=300&height=300&seq=2&orientation=squarish"
						/><div
							class="absolute top-4 right-4 rounded-full bg-red-500 px-3 py-1 text-sm font-semibold text-white"
						>
							-20%
						</div>
					</div><div class="p-6">
						<h3 class="mb-2 text-xl font-bold text-gray-900">Mod Avanzado Zeus</h3><div
							class="mb-3 flex items-center"
						>
							<div class="flex text-yellow-400">
								<i class="ri-star-fill text-sm"></i><i class="ri-star-fill text-sm"></i><i
									class="ri-star-fill text-sm"></i><i class="ri-star-fill text-sm"></i><i
									class="ri-star-line text-sm"></i>
							</div><span class="ml-2 text-sm text-gray-600">(89 reseñas)</span>
						</div><div class="flex items-center justify-between">
							<div class="flex items-center gap-2">
								<span class="text-2xl font-bold text-teal-600">€159.99</span><span
									class="text-lg text-gray-400 line-through">€199.99</span
								>
							</div><button
								class="cursor-pointer rounded-full bg-teal-500 px-6 py-2 font-semibold whitespace-nowrap text-white transition-colors hover:bg-teal-600"
								>Añadir</button
							>
						</div>
					</div>
				</div><div
					class="cursor-pointer overflow-hidden rounded-2xl bg-white shadow-lg transition-shadow hover:shadow-xl"
				>
					<div class="relative">
						<img
							alt="Líquido Premium Menta"
							class="h-64 w-full object-cover object-top"
							src="https://readdy.ai/api/search-image?query=Premium%20vaping%20liquid%20bottle%20with%20mint%20flavor%2C%20elegant%20glass%20bottle%20design%2C%20professional%20product%20photography%20on%20clean%20white%20background%2C%20premium%20packaging%2C%20studio%20lighting&width=300&height=300&seq=3&orientation=squarish"
						/><div
							class="absolute top-4 right-4 rounded-full bg-red-500 px-3 py-1 text-sm font-semibold text-white"
						>
							-17%
						</div>
					</div><div class="p-6">
						<h3 class="mb-2 text-xl font-bold text-gray-900">Líquido Premium Menta</h3><div
							class="mb-3 flex items-center"
						>
							<div class="flex text-yellow-400">
								<i class="ri-star-fill text-sm"></i><i class="ri-star-fill text-sm"></i><i
									class="ri-star-fill text-sm"></i><i class="ri-star-fill text-sm"></i><i
									class="ri-star-line text-sm"></i>
							</div><span class="ml-2 text-sm text-gray-600">(256 reseñas)</span>
						</div><div class="flex items-center justify-between">
							<div class="flex items-center gap-2">
								<span class="text-2xl font-bold text-teal-600">€24.99</span><span
									class="text-lg text-gray-400 line-through">€29.99</span
								>
							</div><button
								class="cursor-pointer rounded-full bg-teal-500 px-6 py-2 font-semibold whitespace-nowrap text-white transition-colors hover:bg-teal-600"
								>Añadir</button
							>
						</div>
					</div>
				</div><div
					class="cursor-pointer overflow-hidden rounded-2xl bg-white shadow-lg transition-shadow hover:shadow-xl"
				>
					<div class="relative">
						<img
							alt="Kit Compacto Stealth"
							class="h-64 w-full object-cover object-top"
							src="https://readdy.ai/api/search-image?query=Compact%20stealth%20vaping%20device%2C%20small%20portable%20design%2C%20professional%20product%20photography%20on%20clean%20white%20background%2C%20sleek%20modern%20appearance%2C%20studio%20lighting&width=300&height=300&seq=4&orientation=squarish"
						/><div
							class="absolute top-4 right-4 rounded-full bg-red-500 px-3 py-1 text-sm font-semibold text-white"
						>
							-29%
						</div>
					</div><div class="p-6">
						<h3 class="mb-2 text-xl font-bold text-gray-900">Kit Compacto Stealth</h3><div
							class="mb-3 flex items-center"
						>
							<div class="flex text-yellow-400">
								<i class="ri-star-fill text-sm"></i><i class="ri-star-fill text-sm"></i><i
									class="ri-star-fill text-sm"></i><i class="ri-star-fill text-sm"></i><i
									class="ri-star-line text-sm"></i>
							</div><span class="ml-2 text-sm text-gray-600">(178 reseñas)</span>
						</div><div class="flex items-center justify-between">
							<div class="flex items-center gap-2">
								<span class="text-2xl font-bold text-teal-600">€49.99</span><span
									class="text-lg text-gray-400 line-through">€69.99</span
								>
							</div><button
								class="cursor-pointer rounded-full bg-teal-500 px-6 py-2 font-semibold whitespace-nowrap text-white transition-colors hover:bg-teal-600"
								>Añadir</button
							>
						</div>
					</div>
				</div><div
					class="cursor-pointer overflow-hidden rounded-2xl bg-white shadow-lg transition-shadow hover:shadow-xl"
				>
					<div class="relative">
						<img
							alt="Atomizador RTA Pro"
							class="h-64 w-full object-cover object-top"
							src="https://readdy.ai/api/search-image?query=Professional%20RTA%20atomizer%20for%20vaping%2C%20precision%20engineering%2C%20stainless%20steel%20construction%2C%20professional%20product%20photography%20on%20clean%20white%20background%2C%20technical%20appearance%2C%20studio%20lighting&width=300&height=300&seq=5&orientation=squarish"
						/><div
							class="absolute top-4 right-4 rounded-full bg-red-500 px-3 py-1 text-sm font-semibold text-white"
						>
							-20%
						</div>
					</div><div class="p-6">
						<h3 class="mb-2 text-xl font-bold text-gray-900">Atomizador RTA Pro</h3><div
							class="mb-3 flex items-center"
						>
							<div class="flex text-yellow-400">
								<i class="ri-star-fill text-sm"></i><i class="ri-star-fill text-sm"></i><i
									class="ri-star-fill text-sm"></i><i class="ri-star-fill text-sm"></i><i
									class="ri-star-line text-sm"></i>
							</div><span class="ml-2 text-sm text-gray-600">(92 reseñas)</span>
						</div><div class="flex items-center justify-between">
							<div class="flex items-center gap-2">
								<span class="text-2xl font-bold text-teal-600">€79.99</span><span
									class="text-lg text-gray-400 line-through">€99.99</span
								>
							</div><button
								class="cursor-pointer rounded-full bg-teal-500 px-6 py-2 font-semibold whitespace-nowrap text-white transition-colors hover:bg-teal-600"
								>Añadir</button
							>
						</div>
					</div>
				</div><div
					class="cursor-pointer overflow-hidden rounded-2xl bg-white shadow-lg transition-shadow hover:shadow-xl"
				>
					<div class="relative">
						<img
							alt="Líquido Frutal Mix"
							class="h-64 w-full object-cover object-top"
							src="https://readdy.ai/api/search-image?query=Fruity%20vaping%20liquid%20bottle%20with%20colorful%20fruit%20flavors%2C%20vibrant%20packaging%20design%2C%20professional%20product%20photography%20on%20clean%20white%20background%2C%20appetizing%20appearance%2C%20studio%20lighting&width=300&height=300&seq=6&orientation=squarish"
						/><div
							class="absolute top-4 right-4 rounded-full bg-red-500 px-3 py-1 text-sm font-semibold text-white"
						>
							-20%
						</div>
					</div><div class="p-6">
						<h3 class="mb-2 text-xl font-bold text-gray-900">Líquido Frutal Mix</h3><div
							class="mb-3 flex items-center"
						>
							<div class="flex text-yellow-400">
								<i class="ri-star-fill text-sm"></i><i class="ri-star-fill text-sm"></i><i
									class="ri-star-fill text-sm"></i><i class="ri-star-fill text-sm"></i><i
									class="ri-star-line text-sm"></i>
							</div><span class="ml-2 text-sm text-gray-600">(203 reseñas)</span>
						</div><div class="flex items-center justify-between">
							<div class="flex items-center gap-2">
								<span class="text-2xl font-bold text-teal-600">€19.99</span><span
									class="text-lg text-gray-400 line-through">€24.99</span
								>
							</div><button
								class="cursor-pointer rounded-full bg-teal-500 px-6 py-2 font-semibold whitespace-nowrap text-white transition-colors hover:bg-teal-600"
								>Añadir</button
							>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section><section class="bg-gray-50 py-16">
		<div class="mx-auto max-w-7xl px-6">
			<h2 class="mb-12 text-center text-4xl font-bold text-gray-900">
				¿Por Qué Elegir VapeStore?
			</h2><div class="grid grid-cols-1 gap-8 md:grid-cols-3">
				<div class="text-center">
					<div
						class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-teal-500"
					>
						<i class="ri-shield-check-line text-2xl text-white"></i>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Calidad Garantizada</h3><p
						class="text-gray-600"
					>
						Todos nuestros productos pasan rigurosos controles de calidad para garantizar la mejor
						experiencia de vapeo
					</p>
				</div><div class="text-center">
					<div
						class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-teal-500"
					>
						<i class="ri-truck-line text-2xl text-white"></i>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Envío Rápido</h3><p
						class="text-gray-600"
					>
						Envío gratuito en pedidos superiores a €50. Recibe tu pedido en 24-48 horas
					</p>
				</div><div class="text-center">
					<div
						class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-teal-500"
					>
						<i class="ri-customer-service-2-line text-2xl text-white"></i>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Soporte Experto</h3><p
						class="text-gray-600"
					>
						Nuestro equipo de expertos está disponible para ayudarte a elegir el producto perfecto
						para ti
					</p>
				</div>
			</div>
		</div>
	</section><section class="bg-teal-500 py-16">
		<div class="mx-auto max-w-4xl px-6 text-center">
			<h2 class="mb-6 text-4xl font-bold text-white">Mantente Actualizado</h2><p
				class="mb-8 text-xl text-teal-100"
			>
				Suscríbete a nuestro newsletter y recibe ofertas exclusivas y novedades
			</p><form
				id="newsletter_subscription"
				data-readdy-form="true"
				action="https://readdy.ai/api/form/d3vvmk4um42jkjthsof0"
				method="POST"
				class="mx-auto flex max-w-md flex-col gap-4 sm:flex-row"
			>
				<input
					placeholder="Tu email"
					aria-label="Tu correo electrónico"
					class="flex-1 rounded-full px-6 py-3 text-sm text-gray-900"
					required=""
					type="email"
					name="email"
				/><button
					type="submit"
					class="cursor-pointer rounded-full bg-white px-8 py-3 font-semibold whitespace-nowrap text-teal-500 transition-colors hover:bg-gray-100"
					>Suscribirse</button
				>
			</form>
		</div>
