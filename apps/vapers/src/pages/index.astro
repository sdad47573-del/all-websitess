---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Sur Digital Málaga | Tu Presencia Digital Comienza Aquí | Agencia de Marketing Web Online"
  description="Empieza hoy desde 0€, crea tu presencia online en menos de 7 días. Webs rápidas, modernas y optimizadas."
>
  <div id="root">
    <div class="min-h-screen">
      <header class="w-full bg-white shadow-sm sticky top-0 z-50">
        <div class="w-full px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between h-16">
            <div class="flex-shrink-0">
              <h1
                class="text-2xl font-bold"
                style="font-family: Pacifico, serif;"
              >
                VapeSolo
              </h1>
            </div><nav class="hidden lg:flex items-center space-x-8">
              <a
                href="#shop"
                class="text-sm font-medium text-gray-700 hover:text-black transition-colors cursor-pointer"
