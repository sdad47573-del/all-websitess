---
import '../styles/index.css';
import 'remixicon/fonts/remixicon.css';

import { Layout } from '@astro-components';
import Favicon from '../components/Favicon.astro';
import Footer from '../components/Footer.astro';
import Topbar from '../components/Topbar.astro';

import { MAIL, PHONE, STREET } from '../data/data.astro';

const SITE = 'https://vapers.vercel.app';
const TITLE = 'VapeSolo · Tienda de vapers y líquidos premium en Málaga';
const DESCRIPTION = `VapeSolo en ${STREET}. Vapers, líquidos premium y accesorios. Compra online o en tienda. Tel. ${PHONE}.`;

const schemaData = {
	'@context': 'https://schema.org',
	'@type': 'Store',
	name: 'VapeSolo',
	description: DESCRIPTION,
	url: `${SITE}/`,
	telephone: `+34${PHONE.replace(/\s/g, '')}`,
	email: MAIL,
	address: {
		'@type': 'PostalAddress',
		streetAddress: STREET,
		addressLocality: 'Málaga',
		postalCode: '29005',
		addressCountry: 'ES',
	},
};
---

<Layout
	Topbar={Topbar}
	Footer={Footer}
	Favicon={Favicon}
	title={TITLE}
	description={DESCRIPTION}
	keywords="vapers Málaga, tienda de vapers, líquidos de vapeo, cachimbos, VapeSolo"
	author="VapeSolo"
	canonical={`${SITE}/`}
	ogTitle={TITLE}
	ogDescription={DESCRIPTION}
	ogUrl={`${SITE}/`}
	ogImage={`${SITE}/og.png`}
	ogSitename="VapeSolo"
	themeColor="#000000"
	schemaData={schemaData}
