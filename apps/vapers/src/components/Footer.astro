---
import { PHONE, HREF_PHONE, MAIL, HREF_MAIL, STREET } from '../data/data.astro';
---

<footer class="bg-gray-900 py-12 text-white">
	<div class="mx-auto max-w-7xl px-6">
		<div class="grid grid-cols-1 gap-8 md:grid-cols-4">
			<div>
				<h3 class="mb-4 text-2xl font-bold" style="font-family: Pacifico, serif;">VapeStore</h3><p
					class="mb-4 text-gray-400"
				>
					Tu tienda de confianza para productos de vapeo de alta calidad
				</p><div class="flex space-x-4">
					<i class="ri-facebook-fill cursor-pointer text-xl hover:text-teal-400"></i>
					<i class="ri-instagram-line cursor-pointer text-xl hover:text-teal-400"></i>
					<i class="ri-twitter-line cursor-pointer text-xl hover:text-teal-400"></i>
					<i class="ri-youtube-line cursor-pointer text-xl hover:text-teal-400"></i>
				</div>
			</div><div>
				<h4 class="mb-4 text-lg font-semibold">Productos</h4><ul class="space-y-2 text-gray-400">
					<li>
						<a href="#" class="cursor-pointer hover:text-white">Kits Iniciales</a>
					</li><li>
						<a href="#" class="cursor-pointer hover:text-white">Mods Avanzados</a>
					</li><li>
						<a href="#" class="cursor-pointer hover:text-white">Líquidos Premium</a>
					</li><li>
						<a href="#" class="cursor-pointer hover:text-white">Accesorios</a>
					</li>
				</ul>
			</div><div>
				<h4 class="mb-4 text-lg font-semibold">Ayuda</h4><ul class="space-y-2 text-gray-400">
					<li>
						<a href="#" class="cursor-pointer hover:text-white">Guía para Principiantes</a>
					</li><li>
						<a href="#" class="cursor-pointer hover:text-white">Envíos y Devoluciones</a>
					</li><li>
						<a href="#" class="cursor-pointer hover:text-white">Preguntas Frecuentes</a>
					</li><li>
						<a href="#" class="cursor-pointer hover:text-white">Contacto</a>
					</li>
				</ul>
			</div><div>
				<h4 class="mb-4 text-lg font-semibold">Contacto</h4><ul class="space-y-2 text-gray-400">
				<li class="flex items-center">
					<i class="ri-phone-line mr-2"></i><a href={HREF_PHONE} class="hover:text-white"
						>{PHONE}</a
					>
				</li><li class="flex items-center">
					<i class="ri-mail-line mr-2"></i><a href={HREF_MAIL} class="hover:text-white"
						>{MAIL}</a
					>
				</li><li class="flex items-center">
					<i class="ri-map-pin-line mr-2"></i><span>{STREET}</span>
				</li>
				</ul>
			</div>
		</div><div class="mt-8 border-t border-gray-800 pt-8 text-center text-gray-400">
			<p>
				© 2024 VapeStore. Todos los derechos reservados. |<a
					href="https://readdy.ai/?origin=logo"
					class="ml-1 cursor-pointer hover:text-white">Powered by Readdy</a
				>
			</p>
		</div>
	</div>

			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
					</footer>
