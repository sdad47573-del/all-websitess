---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import cartaPared from '../assets/fotos/don-pollo-vertical-01.jpg';
import cartaImpresa from '../assets/fotos/don-pollo-apaisada-02.jpg';
import carteles from '../assets/fotos/don-pollo-vertical-03.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Don Pollo · Pollo, kebab y pizza hasta las 2:00 en Sevilla';
const description = BUSINESS.description;

const galeria = [
	{
		src: cartaPared,
		alt: 'El interior de Don Pollo con la carta de la pared sobre fondo morado y las mesas de metal',
	},
	{
		src: cartaImpresa,
		alt: 'La carta impresa de Don Pollo: hamburguesas, pizzas, pepitos, serranitos, empanados, kebab y papas asadas',
	},
	{
		src: carteles,
		alt: 'Los carteles de la carta de Don Pollo con las pizzas, las papas asadas y las bolas de queso',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Don Pollo',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#donpollo`,
	name: BUSINESS.name,
	alternateName: ['DON POLLO', 'Don Pollo Sevilla', 'Pollo asado La Sirena Varada'],
	description:
		'Restaurante de pollo, empanados, kebab, pizzas y papas asadas en la calle la Sirena Varada, 41013 Sevilla. Abre de 21:00 a 2:00 y hace pedidos a domicilio.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34955095278',
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Pollo', 'Kebab', 'Pizza', 'Comida rápida'],
	areaServed: { '@type': 'City', name: 'Sevilla' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '21:00',
			closes: '02:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1d1224" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:ital,wght@0,400..800;1,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Don Pollo Sevilla, pollo asado Sevilla, kebab Sevilla, pizza 5 euros Sevilla, papas asadas, empanados, La Sirena Varada, comida a domicilio Sevilla, abierto hasta las 2"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo, empanados, kebab, pizzas de 5 € y papas asadas en la calle la Sirena Varada (41013 Sevilla), todas las noches hasta las 2:00. Pedidos a domicilio por teléfono."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Cartel de Don Pollo con su nombre sobre fondo morado y la dirección en Sevilla"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1d1224"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Sevilla"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[cartaPared]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Don Pollo"
			subtitle="Pollo · kebab · pizza"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. la Sirena Varada · 41013 Sevilla"
				title="Pollo, kebab <br /><em>y pizza.</em>"
				lede={`Don Pollo es la parada de madrugada de la Sirena Varada: pollo y empanados, kebab, pizzas de 5 € y papas asadas. Abre todas las noches de 21:00 a 2:00 y hace pedidos a domicilio. Tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={cartaPared}
				imageAlt="El interior de Don Pollo con la carta de la pared sobre fondo morado y las mesas de metal"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>21:00–02:00</b> · domingo cerrado' },
					{ label: 'Servicio', html: '<b>A domicilio</b> con 1,50 € de recargo' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Fotos de la ficha de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Pollo · kebab · pizza · papas asadas"
			/>

			<LocalChips label="Lo que ofrece Don Pollo" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="La parada <br /><em>de la madrugada.</em>"
				paragraphs={[
					'Don Pollo está en la calle la Sirena Varada, 41013 Sevilla. Dentro, la pared morada sostiene la carta entera: baguettes, tapas, sándwiches, empanados, kebab y papas asadas, con las fotos de los platos pegadas alrededor y mesas de metal para comer allí.',
					'La cocina es de noche: abre de 21:00 a 2:00 de lunes a sábado y descansa el domingo. Es cocina rápida de barrio, con el pollo y el empanado como bandera y precios que rondan los 2 y 3 €.',
					'La carta impresa añade hamburguesas, perritos, serranitos, tortillas, paninis y veinte pizzas de un solo tamaño a 5 €. Las papas asadas van numeradas del 1 al 4 y llevan maíz, queso, pollo, atún o alioli según la versión.',
					'Google le da 4,3 sobre 5 con 51 reseñas. Las que publica la ficha hablan de «servicio rápido», «precios muy buenos», limpieza y del «típico empanado del barrio».',
				]}
				note="La ficha no publica página web ni redes sociales. La carta y los precios de esta página salen de las fotos publicadas en la ficha de Google (octubre de 2026) y pueden haber cambiado; confírmalos al pedir."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que sale de la cocina</p>
					<h2 id="highlights-title">Pollo, pizzas <br /><em>y papas asadas.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Pollo, kebab <br /><em>y pizzas de 5 €.</em>"
				description="La ficha no tiene carta online: esto es lo que se lee en las fotos de la carta del local. Precios tal como aparecen."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Precios de la carta fotografiada en la ficha de Google (octubre de 2026); pueden haber cambiado. Los pedidos a domicilio llevan un recargo de 1,50 € y el mínimo es de 10 €. La disponibilidad se confirma por teléfono."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La casa <br /><em>y la carta.</em>"
				description="Las tres fotografías del perfil de Don Pollo en Google Maps: el interior con la carta de la pared y las dos cartas donde se leen los platos y los precios."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,3 sobre 5, <em>con 51 reseñas.</em></h2>
						<p>
							La valoración que publica Google en octubre de 2026 es de 4,3 con 51 opiniones. Las
							tres reseñas que muestra la ficha hablan de comida rápida, precios y limpieza; aquí
							se reproducen tal cual, también las que no son entusiastas.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,3</strong>
						<span>★★★★☆</span>
						<small>51 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la Sirena Varada, <br /><em>hasta las dos.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: de 21:00 a 2:00 de lunes a sábado, con el domingo cerrado. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Don Pollo en la calle la Sirena Varada, 41013 Sevilla"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. la Sirena Varada"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos por teléfono: la ficha no publica pedidos online. La carta anuncia reparto a domicilio con 1,50 € de recargo y pedido mínimo de 10 €; la zona se confirma llamando. En accesibilidad la ficha solo marca que no hay aparcamiento adaptado para sillas de ruedas."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a Don Pollo"
			navAriaLabel="Enlaces de Don Pollo"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
