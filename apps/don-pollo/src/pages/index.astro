---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import pizarra from '../assets/fotos/don-pollo-vertical-01.jpg';
import carteles from '../assets/fotos/don-pollo-vertical-03.jpg';
import carta from '../assets/fotos/don-pollo-apaisada-02.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const title = 'Don Pollo · Pollo, pizzas y kebab en Sevilla';
const description = BUSINESS.description;

const galeria = [
	{
		src: pizarra,
		alt: 'Interior de Don Pollo con la pizarra verde de la carta sobre la pared morada, carteles de precios y mesas de metal',
	},
	{
		src: carteles,
		alt: 'Carteles de precios en la pared morada del local: papas asadas, carne con tomate y bolitas de queso con bebida de regalo',
	},
	{
		src: carta,
		alt: 'Pizarra amarilla con los precios de hamburguesas, pizzas, pepitos, serranitos, empanado de pollo, tortillas y kebab',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#don-pollo`,
	name: BUSINESS.name,
	alternateName: ['Don Pollo Sevilla', 'Don Pollo Cerillo', 'Don Pollo Sirena Varada'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	priceRange: '€',
	servesCuisine: ['Pollo', 'Pizza', 'Kebab', 'Comida rápida'],
	areaServed: { '@type': 'City', name: 'Sevilla' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '21:00',
			closes: '02:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17120c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Don Pollo Sevilla, pollo Sirena Varada, pizzas a 5 euros Sevilla, kebab 41013, papas asadas Sevilla, hamburguesas Sevilla 41013, Don Pollo Cerillo, comida a domicilio 41013"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pizzas de un solo tamaño a 5 €, kebab con patatas y bebida, bocatas y papas asadas en la calle Sirena Varada, 41013 Sevilla. Abre de 21:00 a 2:00 de lunes a sábado y reparte con 10 € de mínimo."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Cartel de Don Pollo con la dirección, el horario y el teléfono del restaurante"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#17120c"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Calle Sirena Varada, Sevilla"
			preload={[pizarra]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Don Pollo"
			subtitle="Pollo · pizzas · kebab"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Pollo, pizzas <br /><em>y kebab.</em>"
				lede="Don Pollo abre solo de noche en la calle Sirena Varada, en el 41013 de Sevilla: de 21:00 a 2:00, de lunes a sábado. La pizarra del local, fotografiada en su ficha de Google, anuncia pizzas de un solo tamaño a 5 €, kebab con patatas y bebida, hamburguesas, bocatas y papas asadas. Los pedidos a domicilio llevan 1,50 € de recargo y 10 € de mínimo."
				image={pizarra}
				imageAlt="Interior de Don Pollo con la pizarra verde de la carta sobre la pared morada y las mesas de metal"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,3</b> en Google · 51 reseñas' },
					{ label: 'Horario', html: '<b>21:00–2:00</b><br />Lunes a sábado · domingo cerrado' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> pedidos y consultas` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Don Pollo" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Pollo y pizza <br /><em>hasta las dos.</em>"
				paragraphs={[
					'Don Pollo es un local de barrio de la calle Sirena Varada, en el 41013 de Sevilla. Google lo clasifica como restaurante especializado en pollo y la propia pizarra del local se presenta como «Don Pollo · Cerillo», con la carta escrita en verde sobre la pared morada y los carteles de precios alrededor.',
					'El horario es de noche: abre a las 21:00 y sirve hasta las 2:00, de lunes a sábado. El domingo figura cerrado, así que no hay servicio de mediodía ni de mañana.',
					'La carta se organiza en pizzas de un solo tamaño, kebab con patatas y bebida, hamburguesas y bocatas, revueltos, tortillas, paninis y papas asadas con cuatro combinaciones. Los carteles que cuelgan de la pared repiten algunos de esos precios, y el más llamativo es la pizza a 5 €.',
					'La pizarra también resuelve la duda del reparto: «Pedidos a domicilio incremento 1,50 €» y «Pedidos mínimo 10 €». Para encargar hay un teléfono publicado en la ficha, el 955 09 52 78.',
				]}
				note="Los precios de esta página están transcritos de la pizarra que aparece en las fotos del perfil de Google. Son los del cartel y pueden cambiar: confírmalos por teléfono antes de pedir."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="La pizarra <br /><em>del local.</em>"
				description="Pizzas, kebab, hamburguesas, bocatas, revueltos y papas asadas, tal como están escritos en la pizarra del local y en los carteles de la pared."
				cta={{ label: 'Ver la carta en las fotos de Google', href: MAPS.place }}
				groups={MENU}
				note="Precios transcritos de la pizarra del local, que aparece en las fotos de su perfil de Google. Los pedidos a domicilio llevan un incremento de 1,50 € y el mínimo es de 10 €. El kebab se anuncia con patatas y bebida y cuesta 4,50 € en todas sus variedades, según la pizarra. Confirma precios y disponibilidad al llamar."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
					<div class="reviews-head">
						<h2 id="resenas-title">Lo que dicen <br /><em>los vecinos.</em></h2>
						<p>
							Cuatro coma tres sobre cinco con 51 reseñas. Estas son las tres que Google destaca en
							la ficha del local, con la puntuación que les dio su autor.
						</p>
					</div>
					<div class="review-grid">
						{
							REVIEWS.map((review) => (
								<figure class="review-card">
									<p class="review-stars" aria-label={`${review.rating} sobre 5`}>
										{'★'.repeat(review.rating)}
										<span aria-hidden="true">{'★'.repeat(5 - review.rating)}</span>
									</p>
									<blockquote>{review.quote}</blockquote>
									<figcaption>Reseña publicada en Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="review-note">
						Citas de las reseñas públicas del local, con la puntuación del autor y la puntuación del
						texto normalizada. Puedes leerlas todas en la ficha de Google.
					</p>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Tres fotos <br /><em>del local.</em>"
				description="El perfil de Don Pollo tiene tres fotos: la pizarra verde con la carta, los carteles de precios de la pared morada y una vista de las mesas."
				images={galeria}
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a la <br /><em>Sirena Varada.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'España']}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: solo noche, de 21:00 a 2:00, de lunes a sábado. El domingo figura cerrado. En festivos puede cambiar; llama antes si vas en día señalado."
				mapTitle="Mapa de Don Pollo en la calle Sirena Varada, Sevilla"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Don Pollo"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="Los pedidos a domicilio se hacen por teléfono: la pizarra del local marca 1,50 € de incremento y 10 € de pedido mínimo. Esta página no tramita encargos ni reservas."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías tomados del perfil público del restaurante en Google Maps. La carta está transcrita de la pizarra del local: confirma precios y horario antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Don Pollo"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
