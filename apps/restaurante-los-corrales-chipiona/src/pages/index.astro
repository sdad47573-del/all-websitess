---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/restaurante-los-corrales-chipiona-apaisada-04.jpg';
import foto1 from '../assets/fotos/restaurante-los-corrales-chipiona-apaisada-01.jpg';
import foto2 from '../assets/fotos/restaurante-los-corrales-chipiona-apaisada-02.jpg';
import foto3 from '../assets/fotos/restaurante-los-corrales-chipiona-apaisada-03.jpg';
import foto4 from '../assets/fotos/restaurante-los-corrales-chipiona-vertical-07.jpg';
import foto5 from '../assets/fotos/restaurante-los-corrales-chipiona-apaisada-05.jpg';

const business = {
	name: 'Restaurante Los Corrales',
	street: 'Paseo de las Canteras, s/n',
	city: 'Chipiona',
	region: 'Andalucía',
	province: 'Cádiz',
	postalCode: '11550',
	phone: '+34 956 37 51 29',
	latitude: 36.7398127,
	longitude: -6.439965,
	site: 'https://restaurante-los-corrales-chipiona.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+Los+Corrales/@36.7398127,-6.439965,17z/data=!3m1!4b1!4m6!3m5!1s0xd0e75062b5cc2b9:0x30e894a2a2270e6b!8m2!3d36.7398127!4d-6.439965!16s%2Fg%2F11c4b3mt4z?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34956375129';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'A la brasa',
		title: 'Pescados de la zona',
		text: 'Restaurante especializado en pescados a la brasa y mariscos de la zona, con años mimando los productos de su mar.',
	},
	{
		kicker: 'De cuchara',
		title: 'Arroces y guisos',
		text: 'Destacan además de pescados y mariscos sus guisos marineros y arroces: arroz de marisco entre lo más pedido.',
	},
	{
		kicker: 'Para compartir',
		title: 'Zamburiñas y coquinas',
		text: 'Zamburiñas, coquinas, gambas y almejas: marisco para compartir frente a la playa céntrica de Chipiona.',
	},
	{
		kicker: 'Frescos',
		title: 'Salpicón y pescado asado',
		text: 'Salpicón de corvina y pescado asado espectacular, además de pulpo, croquetas y tomate entre los entrantes.',
	},
	{
		kicker: 'En la playa',
		title: 'Plena playa céntrica',
		text: 'En plena playa céntrica de Chipiona, para ofrecerte lo mejor de su gastronomía con vistas al mar.',
	},
	{
		kicker: 'Aviso',
		title: 'Miércoles cerrado',
		text: 'El miércoles cierra. El resto de días abre de 13:30 a 16:00 y de 20:30 a 23:00. Llama en festivos.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de Restaurante Los Corrales publicada en su ficha de Google Maps (Chipiona)' },
	{ src: photos.foto2, alt: 'Terraza de Restaurante Los Corrales, en el paseo de las Canteras, Chipiona' },
	{ src: photos.foto3, alt: 'Fotografía de Restaurante Los Corrales en Chipiona, desde Google Maps' },
	{ src: photos.foto4, alt: 'Imagen de Restaurante Los Corrales (Chipiona) subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Detalle de Restaurante Los Corrales según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está Restaurante Los Corrales?',
		a: 'En el paseo de las Canteras, s/n, 11550 Chipiona (Cádiz), en plena playa céntrica. Coordenadas 36.7398127, -6.439965.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'Miércoles cerrado. Lunes, martes, jueves, viernes, sábado y domingo abre de 13:30 a 16:00 y de 20:30 a 23:00. Confirma festivos.',
	},
	{
		q: '¿Cómo reservo mesa?',
		a: 'Llamando al 956 37 51 29. Con 4,4 estrellas y más de 1.700 reseñas y vistas a la playa, para grupos conviene llamar con antelación.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Pescados a la brasa y mariscos de la zona: arroz de marisco, zamburiñas, coquinas, gambas, almejas, salpicón de corvina, pulpo y guisos marineros.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso, aseo y asientos adaptados para sillas de ruedas. Para necesidades concretas, llama antes.',
	},
];

const images = [
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'Restaurante Los Corrales en Chipiona (paseo de las Canteras, s/n): pescados a la brasa, marisco, arroces y guisos marineros. Reserva en el 956 37 51 29.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 956 37 51 29',
	image: images,
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo, tarjeta de crédito',
	servesCuisine: ['Pescados y mariscos', 'Brasa', 'Arroces', 'Andaluza'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:30',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Vistas a la playa', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Ideal para grupos', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.4,
		reviewCount: 1716,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1b1714" />
		<meta
			name="description"
			content="Restaurante Los Corrales en Chipiona: pescados a la brasa, marisco, arroces y guisos marineros en el paseo de las Canteras. Reserva en el 956 37 51 29."
		/>
		<meta
			name="keywords"
			content="Restaurante Los Corrales Chipiona, paseo Canteras restaurante, pescado brasa Chipiona, marisco Chipiona, arroz marisco, zamburiñas"
		/>
		<meta name="author" content="Restaurante Los Corrales" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Restaurante Los Corrales | Pescado a la brasa en Chipiona</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Restaurante Los Corrales · Pescado a la brasa en Chipiona" />
		<meta
			property="og:description"
			content="Pescados a la brasa, mariscos, arroces y guisos marineros en plena playa céntrica de Chipiona."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="Restaurante Los Corrales, en Chipiona" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Restaurante Los Corrales · Pescado a la brasa en Chipiona" />
		<meta
			name="twitter:description"
			content="Marisco y pescado a la brasa en el paseo de las Canteras (Chipiona)."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Chipiona" />
		<meta name="geo.position" content="36.7398127;-6.439965" />
		<meta name="ICBM" content="36.7398127, -6.439965" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Restaurante Los Corrales, inicio">
				<span class="brand-mark" aria-hidden="true">C</span>
				<span class="brand-name">Restaurante Los Corrales <small>Chipiona · Canteras</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#corrales">Los Corrales</a>
				<a href="#especialidades">Especialidades</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>956 37 51 29</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Paseo de las Canteras · Chipiona</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante Los Corrales en plena playa céntrica de Chipiona: pescados a la brasa y mariscos de la
						zona, además de guisos marineros y arroces. Años mimando los productos de su mar.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>
							Reservar 956 37 51 29
						</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,4</b> en Google (1.716 reseñas)</li>
						<li>Brasa</li>
						<li>Marisco</li>
						<li>Playa</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						alt="Fotografía de Restaurante Los Corrales publicada en su ficha de Google Maps (Chipiona)"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,4</b><span>Google</span></div>
					<div><b>1.7k</b><span>Reseñas</span></div>
					<div><b>Playa</b><span>Céntrica</span></div>
				</div>
				<ul class="services">
					<li>Brasa</li>
					<li>Marisco</li>
					<li>Local accesible</li>
					<li>Grupos</li>
					<li>Reservas</li>
					<li>Terraza</li>
				</ul>
			</section>

			<section class="about section-pad" id="corrales">
				<p class="section-label"><span aria-hidden="true"></span> Un restaurante en Chipiona</p>
				<div class="about-grid">
					<h2>Lo mejor de la mar<br />en la playa céntrica<br /><em>de Chipiona.</em></h2>
					<div class="about-copy">
						<p>
							Restaurante Los Corrales está en el paseo de las Canteras, s/n, 11550 Chipiona (Cádiz), en plena
							playa céntrica. Restaurante y bar restaurante especializado en pescados a la brasa y mariscos.
						</p>
						<p>
							Lo que más citan sus clientes: arroz de marisco, zamburiñas, coquinas, salpicón de corvina,
							pescado asado espectacular, gambas, almejas, pulpo y croquetas. Guisos marineros y arroces completan
							la carta.
						</p>
						<p class="about-note">
							Sobre el horario: la ficha de Google Maps marca miércoles cerrado y el resto de días de 13:30 a 16:00
							y de 20:30 a 23:00. Si vienes en festivo, llama antes.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="especialidades">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su carta</p>
						<h2>Lo que más<br />se pide <em>en la mesa.</em></h2>
					</div>
					<p>
						Platos citados en la descripción del propio local y en las reseñas de sus clientes. La carta cambia
						según lonja, así que confirma disponibilidad al reservar.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>Los Corrales<br /><em>por dentro.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de Restaurante Los Corrales. En la ficha
							encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="avif"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres
					el titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Paseo de las Canteras, s/n</p>
					<h2>Ven a la playa<br /><em>a comer.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Miércoles</th>
								<td>Cerrado</td>
							</tr>
							<tr>
								<th scope="row">Lunes, martes y jueves a domingo</th>
								<td>13:30 – 16:00 · 20:30 – 23:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, llama antes de
						venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>
							Llamar 956 37 51 29
						</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 956 37 51 29</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de Restaurante Los Corrales en el paseo de las Canteras, Chipiona"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Restaurante Los Corrales · Chipiona
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">C</span>
				<p>Restaurante Los Corrales<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Restaurante Los Corrales · Chipiona. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>

			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar a Los Corrales <span>956 37 51 29</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
