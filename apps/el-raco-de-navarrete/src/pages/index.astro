---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/el-raco-de-navarrete-apaisada-01.jpg';
import arroz from '../assets/fotos/el-raco-de-navarrete-apaisada-04.jpg';
import bocadillo from '../assets/fotos/el-raco-de-navarrete-apaisada-05.jpg';
import comedor from '../assets/fotos/el-raco-de-navarrete-apaisada-06.jpg';
import barra from '../assets/fotos/el-raco-de-navarrete-apaisada-08.jpg';
import ensalada from '../assets/fotos/el-raco-de-navarrete-apaisada-09.jpg';
import carajillo from '../assets/fotos/el-raco-de-navarrete-vertical-03.jpg';
import brasa from '../assets/fotos/el-raco-de-navarrete-vertical-07.jpg';
import sardinas from '../assets/fotos/el-raco-de-navarrete-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HABITACIONES,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description = BUSINESS.description;

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de El Racó de Navarrete con mesas de madera, manteles y la televisión al fondo',
	},
	{
		src: brasa,
		alt: 'Surtido de longaniza, chorizo, morcilla y chuletilla a la brasa con patatas',
	},
	{
		src: arroz,
		alt: 'Arroz amarillo con pollo servido en plato blanco de El Racó de Navarrete',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo de longaniza y chorizo a la brasa en El Racó de Navarrete',
	},
	{
		src: barra,
		alt: 'Barra y comedor de El Racó de Navarrete con mesas de mantel azul y sillas de madera',
	},
	{
		src: ensalada,
		alt: 'Ensalada con tomate, huevo cocido, zanahoria y remolacha de El Racó de Navarrete',
	},
	{
		src: sardinas,
		alt: 'Sardinas asadas con verduras y patata en El Racó de Navarrete',
	},
	{
		src: carajillo,
		alt: 'Carajillo servido en vaso de cristal sobre plato blanco en El Racó de Navarrete',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': ['Restaurant', 'Hotel'],
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.fullName,
	alternateName: ['El Racó', 'El Racó de Navarrete Cabanes', 'Hotel El Racó de Navarrete'],
	slogan: BUSINESS.tagline,
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34964332060',
	email: BUSINESS.email,
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Cocina casera', 'Cocina mediterránea', 'Carnes a la brasa', 'Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Cabanes' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.province,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '06:00',
			closes: '00:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento gratuito', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Wifi gratuito', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Hotel', href: '#hotel' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const title = 'El Racó de Navarrete · Restaurante y hotel en Cabanes';
const cita = REVIEWS[2];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"el-raco-de-navarrete-apaisada-01.jpg": fachada,
	"el-raco-de-navarrete-apaisada-06.jpg": comedor,
	"el-raco-de-navarrete-vertical-07.jpg": brasa,
	"el-raco-de-navarrete-apaisada-04.jpg": arroz,
	"el-raco-de-navarrete-apaisada-05.jpg": bocadillo,
	"el-raco-de-navarrete-apaisada-08.jpg": barra,
	"el-raco-de-navarrete-apaisada-09.jpg": ensalada,
	"el-raco-de-navarrete-vertical-10.jpg": sardinas,
	"el-raco-de-navarrete-vertical-03.jpg": carajillo,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f3f35" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=Outfit:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="El Racó de Navarrete, restaurante Cabanes, hotel Cabanes, carnes a la brasa Castelló, menú del día Cabanes, almuerzos AP-7, Av. España 1 Cabanes, hotel de carretera"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="El Racó de Navarrete · Restaurante y hotel en Cabanes"
			ogDescription="Cocina casera y carnes a la brasa, menú del día desde 10 € y 11 habitaciones, con parking y wifi gratis. 4,2 en Google con 2.567 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de El Racó de Navarrete con el rótulo de hotel y la terraza de sombrillas"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#2f3f35"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.province}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone="+34964332060"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Cabanes, Castelló"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'España',
				phone: '+34 964 33 20 60',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Restaurante y hotel · Cabanes"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a El Racó"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
