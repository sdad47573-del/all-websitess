---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import biryaniCurry from '../assets/fotos/busy-bites-vista-8-08.jpg';
import fachadaDia from '../assets/fotos/busy-bites-apaisada-06.jpg';
import fachadaNoche from '../assets/fotos/busy-bites-apaisada-09.jpg';
import barra from '../assets/fotos/busy-bites-apaisada-01.jpg';
import sala from '../assets/fotos/busy-bites-apaisada-10.jpg';
import entrante from '../assets/fotos/busy-bites-apaisada-04.jpg';
import naan from '../assets/fotos/busy-bites-vertical-05.jpg';
import biryani from '../assets/fotos/busy-bites-cuadrada-03.jpg';
import curries from '../assets/fotos/busy-bites-vertical-07.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description =
	'Busy Bites Indian Restaurant, cocina india en la Praça Luís de Camões 50 de Seixal: curries, tandoori, biryani y naan, con bar y reparto a domicilio. Comida y cena de lunes a sábado; martes cerrado. 4,8 en Google con 256 reseñas. Tel. 939 383 344.';

const galeria = [
	{
		src: fachadaDia,
		alt: 'Fachada amarilla de Busy Bites en la Praça Luís de Camões de Seixal, con el cartel redondo y la terraza de mesas fuera',
	},
	{
		src: fachadaNoche,
		alt: 'Terraza y fachada de Busy Bites de noche, con el cartel de «Comida Indiana» en la ventana',
	},
	{
		src: barra,
		alt: 'Interior de Busy Bites con la barra iluminada, la pizarra del menú y las mesas puestas',
	},
	{
		src: sala,
		alt: 'Comedor de Busy Bites con mesas de tablero oscuro, banquetas blancas y ukeleles en la pared',
	},
	{
		src: entrante,
		alt: 'Pollo crujiente especiado con salsa de menta servido en un plato de cerámica en Busy Bites',
	},
	{
		src: naan,
		alt: 'Naan de ajo y cilantro en un cesto, con chutney de menta y salsa roja al lado',
	},
	{
		src: biryani,
		alt: 'Biryani de verduras en cazuela de cobre con el logotipo de Busy Bites Indian Restaurant & Bar',
	},
	{
		src: curries,
		alt: 'Dos curries en cuencos de barro servidos en la mesa de Busy Bites',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['Busy Bites', 'Busy Bites Seixal', 'BusyBites Indian Restaurant'],
	slogan: 'Cocina india y bar en Seixal',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 939 383 344',
	currenciesAccepted: 'EUR',
	servesCuisine: ['India', 'Tandoori', 'Curry'],
	areaServed: [
		{ '@type': 'City', name: 'Seixal' },
		{ '@type': 'AdministrativeArea', name: 'Setúbal' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '12:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '19:00',
			closes: '23:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '12:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '19:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Estacionamiento accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos accesibles para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'WC accesible para sillas de ruedas',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Bucle de inducción magnética', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Acepta perros', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((body) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
		reviewBody: body,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Busy Bites · Restaurante indio en Seixal';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#22304f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Marcellus&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Busy Bites Seixal, restaurante indio Seixal, curry Seixal, biryani Seixal, tandoori Seixal, comer indio en Seixal, Praça Luís de Camões 50, restaurante indiano Setúbal, reparto comida india Seixal"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Busy Bites · Restaurante indio en Seixal"
			ogDescription="Curries, tandoori, biryani y naan, con bar y reparto a domicilio. Comida y cena de lunes a sábado; martes cerrado. 4,8 en Google con 256 reseñas. Tel. 939 383 344."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Busy Bites Indian Restaurant en la Praça Luís de Camões, Seixal"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#22304f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-15"
			postalCode={BUSINESS.postalCode}
			phone="+351939383344"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.regionName}`}
			countryName="Portugal"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				phone: '+351 939 383 344',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[biryaniCurry]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Cocina india · Seixal"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Praça Luís de Camões, 50 · Seixal"
				title="Sabores de la India,<br /><em>en Seixal.</em>"
				lede="Busy Bites es un restaurante indio y bar en la Praça Luís de Camões, en Seixal: curries, tandoori, biryani y naan recién hecho, con terraza y reparto a domicilio. Comida y cena de lunes a sábado; el martes cierra."
				image={biryaniCurry}
				imageAlt="Biryani de verduras y curry con nata servidos en Busy Bites, en Seixal"
				primaryCta={{ label: `Pedir: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Cocina india"
				facts={[
					{ label: 'Nota', html: '<b>4,8 en Google</b> con 256 reseñas' },
					{ label: 'Comida y cena', html: '<b>12:00–15:00 · 19:00–23:30</b>' },
					{ label: 'Martes', html: '<b>Martes cerrado</b>' },
					{ label: 'Reparto', html: '<b>A domicilio</b>' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Busy Bites" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Curry,<br /><em>bar y terraza.</em>"
				paragraphs={[
					'Busy Bites está en la Praça Luís de Camões, 50, en un edificio amarillo de azulejos con el cartel redondo de «BUSY BITES» sobre la puerta. En la calle, la terraza de mesas blancas y sillas de mimbre se protege con sombrillas; dentro, la sala es moderna, con la barra iluminada, la pizarra del menú y ukeleles colgados en la pared.',
					'El restaurante se presenta así en su ficha: «Authentic Indian flavours in Seixal. Experience classic curries, fresh ingredients, and innovative dishes in a modern setting. Restaurant & Bar, Delivery available». Y lo cumple: hay barra, cócteles y servicio de reparto, además de mesa y terraza.',
					'De la cocina salen los platos de las fotos: biryani al azafrán servido en cazuela de cobre, curry con la nata dibujada en espiral, pollo especiado con chutney de menta y naan de ajo y cilantro con sus dos salsas. Las reseñas insisten en el sabor y en la frescura de los productos.',
				]}
				note="«Todos os pratos com sabores maravilhosos, frescos e bem servidos», dice una reseña. Otra lo resume: «Restaurante 5estrelas com muito boa comida e ambiente!»."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Curry,<br /><em>tandoor y naan.</em>"
				description="La ficha no publica carta: estos platos salen de las fotos del perfil y del cartel de la ventana, que anuncia «Comida Indiana» y el bar del restaurante."
				cta={{ label: `Pedir o preguntar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Busy Bites no publica precios en Google y esta web no los inventa. En el cartel de la ventana aparecen los platos con sus precios; para pedir, reservar o consultar el reparto, llama al 939 383 344. La ficha tampoco ofrece reserva online."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La terraza,<br />la sala<br /><em>y la mesa.</em>"
				description="Estas fotografías proceden del perfil de Busy Bites en Google Maps: la fachada amarilla de la plaza, la terraza de noche, la barra y el comedor, y los platos que salen de la cocina."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Praça Luís de Camões, 50 · 2840-488 Seixal"
				title="En la plaza,<br /><em>comida y cena.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Setúbal, Portugal']}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="De lunes a sábado abre dos turnos: 12:00–15:00 y 19:00–23:30. El domingo la cena acaba a las 23:00 y el martes cierra. La ficha avisa de que el horario puede cambiar en festivos; llama antes si vas en día señalado."
				mapTitle="Mapa de Busy Bites en la Praça Luís de Camões, 50, Seixal"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Busy Bites · Seixal"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva por teléfono, en el 939 383 344. El restaurante anuncia reparto a domicilio gratuito y pedidos por WhatsApp. La ficha marca estacionamiento, entrada, asientos y WC accesibles, además de bucle de inducción magnética y el atributo «Aceita cães»."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta, precios y reparto antes del pedido."
			ctaLabel="Llamar a Busy Bites"
			creditLabel="Creado por"
		/>
	</body>
</html>
