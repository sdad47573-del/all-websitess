<dialog
	id={modalId}
	class="m-auto w-full max-w-sm overflow-hidden rounded-2xl bg-white p-0 shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-sm"
>
	<div class="relative">
		<div class="aspect-square w-full overflow-hidden bg-gray-50">
			<Image src={src} alt={title} title={title} class="h-full w-full object-cover object-top" />
		</div>
		<button
			onclick={`document.getElementById('${modalId}').close()`}
			class="absolute top-3 right-3 rounded-full bg-black/50 p-2 text-white transition-colors hover:bg-black/70 focus:outline-none"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				fill="none"
				viewBox="0 0 24 24"
				stroke-width="2.5"
				stroke="currentColor"
				class="size-5"
			>
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
			</svg>
		</button>
	</div>
	<div class="p-5">
		<h3 class="mb-2 text-xl leading-tight font-bold text-gray-900">{title}</h3>
		<div class="flex items-center justify-between border-t border-gray-100 pt-4">
			<span class="font-medium text-gray-500">Stock disponible</span>
			<span class="text-2xl font-bold text-teal-600">{amount}</span>
		</div>
	</div>
</dialog>

<style>
	dialog[open] {
		animation: zoom-in 0.2s ease-out;
	}
	@keyframes zoom-in {
		from {
			transform: scale(0.95);
			opacity: 0;
		}
		to {
			transform: scale(1);
			opacity: 1;
		}
	}
</style>
