---
import { Image } from '@astro-components';

const { src, title, amount } = Astro.props;
---

<div
	class="vap-item cursor-pointer overflow-hidden rounded-xl border border-gray-100 bg-white shadow-md transition-transform active:scale-95"
	data-title={title}
	data-amount={amount}
	data-src={JSON.stringify(src)}
>
	<div class="relative aspect-square overflow-hidden bg-gray-50">
		<Image src={src} alt={title} title={title} class="h-full w-full object-cover object-top" />
	</div><div class="p-3">
		<h3 class="mb-1 truncate text-sm font-semibold text-gray-900">{title}</h3><div
			class="flex items-center justify-between"
		>
			<span class="text-xs text-gray-500">Cantidad:</span><span
				class="text-sm font-bold text-teal-600">{amount}</span
			>
		</div>
	</div>
</div>

<script>
	import { openModal } from '../stores/modalStore';

	const items = document.querySelectorAll('.vap-item');

	items.forEach((item) => {
		item.addEventListener('click', () => {
			const title = item.getAttribute('data-title');
			const amount = Number(item.getAttribute('data-amount'));
			const src = JSON.parse(item.getAttribute('data-src') || '{}');

			if (title && !isNaN(amount)) {
				openModal({ title, amount, src });
			}
		});
	});
</script>
