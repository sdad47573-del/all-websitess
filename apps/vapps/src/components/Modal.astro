---

---

<div class="fixed inset-0 z-50 flex items-end justify-center bg-black/50 p-4 sm:items-center">
	<div class="max-h-[90vh] w-full max-w-md overflow-y-auto rounded-t-3xl bg-white sm:rounded-3xl">
		<div
			class="sticky top-0 flex items-center justify-between rounded-t-3xl border-b border-gray-100 bg-white px-6 py-4"
		>
			<h2 class="text-xl font-bold text-gray-900">Detalles del Objeto</h2><button
				class="flex h-8 w-8 cursor-pointer items-center justify-center text-gray-400 transition-colors hover:text-gray-600"
				aria-label="Cerrar"><i class="ri-close-line text-2xl"></i></button
			>
		</div><div class="p-6">
			<div class="mb-6 aspect-square overflow-hidden rounded-2xl bg-gray-50">
				<img
					alt="Reloj Deportivo"
					title="Reloj Deportivo"
					class="h-full w-full object-cover object-top"
					src="https://readdy.ai/api/search-image?query=modern%20sports%20watch%20with%20digital%20display%20on%20clean%20white%20background%20product%20photography%20style%20minimalist%20setting%20professional%20lighting%20high%20quality%20commercial%20photo%20centered%20composition&width=400&height=400&seq=obj1&orientation=squarish"
				/>
			</div><div class="mb-6 space-y-4">
				<div><h3 class="mb-2 text-2xl font-bold text-gray-900">Reloj Deportivo</h3></div><div
					class="grid grid-cols-2 gap-4"
				>
					<div class="rounded-xl bg-gray-50 p-4">
						<p class="mb-1 text-xs text-gray-500">Cantidad</p><p
							class="text-2xl font-bold text-teal-600"
						>
							15
						</p>
					</div><div class="rounded-xl bg-gray-50 p-4">
						<p class="mb-1 text-xs text-gray-500">Precio Compra</p><p
							class="text-2xl font-bold text-gray-900"
						>
							45€
						</p>
					</div>
				</div>
			</div><div class="border-t border-gray-100 pt-6">
				<h4 class="mb-4 font-semibold text-gray-900">Precio de Venta</h4><div
					class="mb-4 grid grid-cols-4 gap-3"
				>
					<button
						class="cursor-pointer rounded-xl bg-teal-600 px-4 py-3 font-bold whitespace-nowrap text-white transition-colors hover:bg-teal-700"
						>10€</button
					><button
						class="cursor-pointer rounded-xl bg-teal-600 px-4 py-3 font-bold whitespace-nowrap text-white transition-colors hover:bg-teal-700"
						>9€</button
					><button
						class="cursor-pointer rounded-xl bg-teal-600 px-4 py-3 font-bold whitespace-nowrap text-white transition-colors hover:bg-teal-700"
						>8€</button
					><button
						class="cursor-pointer rounded-xl bg-teal-600 px-4 py-3 font-bold whitespace-nowrap text-white transition-colors hover:bg-teal-700"
						>11€</button
					>
				</div><div class="space-y-3">
					<label class="block"
						><span class="mb-2 block text-sm font-medium text-gray-700">Precio Personalizado</span
						><input
							step="0.01"
							min="0"
							placeholder="Introduce el precio"
							class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm outline-none focus:border-transparent focus:ring-2 focus:ring-teal-500"
							type="number"
							value=""
						/></label
					><button
						disabled=""
						class="w-full cursor-pointer rounded-xl bg-gray-900 px-6 py-3 font-bold whitespace-nowrap text-white transition-colors hover:bg-gray-800 disabled:cursor-not-allowed disabled:bg-gray-300"
						>Confirmar Venta</button
					>
				</div>
			</div>
		</div>
	</div>
</div>
