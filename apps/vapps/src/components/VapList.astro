---
import { imageMap } from '../data/maps/img';
import { getAllItems } from '../services/items.service';
import Modal from './Modal';
import VapListItem from './VapListItem.astro';

const { data: stock } = await getAllItems();

const DATA = stock
	.map((vaper) => ({
		id: vaper.id,
		src: imageMap[vaper.title],
		title: vaper.es_title,
		amount: vaper.amount,
	}))
	.filter((item) => item.src);
---

<div
	class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"
	id="vap-list-container"
>
	{DATA.map((item) => <VapListItem {...item} />)}
</div>

<Modal client:only="react" />

<script>
	import { modalData, isModalOpen } from '../stores/modal.store';

	document.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		const vapItem = target.closest('.vap-item');
		if (!vapItem) return;
		const { id, title, src, amount } = vapItem.dataset;
		if (id && title && src && amount) {
			let parsedSrc = src;
			try {
				const srcObj = JSON.parse(src);
				parsedSrc = srcObj.src || srcObj;
			} catch (_) {
				parsedSrc = src;
			}
			modalData.set({
				id: Number(id),
				title,
				src: parsedSrc,
				amount: Number(amount),
			});
			isModalOpen.set(true);
		}
	});
</script>
