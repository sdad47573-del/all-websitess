---
import { twJoin } from 'tailwind-merge';

const { title = 'Resumen y Estadísticas', items } = Astro.props;
---

<div class="bg-gradient-to-br from-gray-50 to-gray-100 p-5 shadow-sm">
	<h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-gray-900">
		<i class="ri-dashboard-line text-teal-600"></i>{title}
	</h2>
	<div class="grid grid-cols-2 gap-3">
		{
			items.map((item) => (
				<div class="rounded-xl border border-gray-100 bg-white p-4 shadow-sm">
					<div class="mb-2 flex items-center gap-3">
						<div
							class={twJoin('flex h-10 w-10 items-center justify-center rounded-lg', item.color)}
						>
							<i class={twJoin('text-xl text-white', item.icon)} />
						</div>
					</div>
					<p class="mb-1 text-xs text-gray-500">{item.label}</p>
					<p class="text-xl font-bold text-gray-900">{item.value}</p>
				</div>
			))
		}
	</div>
</div>
