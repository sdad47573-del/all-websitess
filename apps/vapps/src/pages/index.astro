---
// obliga a que esta ruta se renderice on-demand en el server
export const prerender = false;

import ConnectedModal from '../components/ConnectedModal';
import Stats from '../components/Stats';
import VapList from '../components/VapList';
import CustomLayout from '../layouts/CustomLayout.astro';
import { getAllItems } from '../services/items.service';

const { data: stock } = await getAllItems();

const total = stock ? (stock as any[]).reduce((acc, item) => acc + item.amount, 0) : 0;
---

<CustomLayout>
	<main>
		<Stats
			client:load
			items={[
				{
					label: 'Cantidad de vapers',
					value: total,
					icon: 'ri-stack-line',
					color: 'bg-blue-500',
					isTotal: true,
				},
				{
					label: 'Vaper más vendido',
					value: 'Lima Limón',
					icon: 'ri-medal-line',
					color: 'bg-yellow-500',
				},
			]}
		/>
		<div class="px-4">
			<div class="py-5">
				<h2 class="text-xl font-semibold">Vapers Disponibles</h2>
			</div>
			<VapList client:load />
			<ConnectedModal client:load />
		</div>
	</main>
</CustomLayout>
