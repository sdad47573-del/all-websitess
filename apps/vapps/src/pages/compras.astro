---
import Stats from '../components/Stats.astro';
import VapListItem from '../components/VapListItem.astro';
import { BUY, TOTAL_BUY } from '../data/BUY';
import { TOTAL_INGRESOS } from '../data/INGRESOS';
import { imageMap } from '../data/maps/img';
import { translateItem } from '../data/maps/spanish';
import CustomLayout from '../layouts/CustomLayout.astro';
---

<CustomLayout>
	<!-- <Modal /> -->
	<main class="pb-6">
		<Stats
			items={[
				{
					label: 'Cantidad Totales',
					value: BUY.reduce((total, buy) => total + buy.quantity, 0),
					icon: 'ri-shopping-cart-line',
					color: 'bg-blue-500',
				},
				{
					label: 'Compras Totales',
					value: TOTAL_BUY + '€',
					icon: 'ri-money-euro-circle-line',
					color: 'bg-green-500',
				},
				{
					label: 'Cubierto %',
					value: ((TOTAL_INGRESOS / TOTAL_BUY) * 100).toFixed(2) + '%',
					icon: 'ri-bar-chart-line',
					color: 'bg-purple-500',
				},
				{
					label: 'Restante',
					value: (TOTAL_INGRESOS - TOTAL_BUY).toFixed(2) + '€',
					icon: 'ri-line-chart-line',
					color: 'bg-teal-500',
				},
			]}
		/>

		<div class="p-5">
			<h2 class="text-xl font-semibold">Compras</h2>
		</div>
		<!-- TODO: hacer un comp de vapslit generico -->
		<!-- <VapList /> -->

		<ul class="space-y-">
			{
				BUY.map((buy) => (
					<li class="p-4 pb-6 shadow">
						<div class="mb-3 flex justify-between">
							<h3 class="text-lg font-bold text-teal-700">Fecha: {buy.data}</h3>
							<div class="w-28">
								<p class="text-gray-600">
									Precio: <span class="font-semibold">{buy.price} €</span>
								</p>
								<p class="text-gray-600">
									Cantidad: <span class="font-semibold">{buy.quantity}</span>
								</p>
							</div>
						</div>
						<div class="grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6">
							{buy.items.map((item) => (
								<VapListItem
									src={imageMap[item.name]}
									title={translateItem(item.name)}
									amount={item.amount}
								/>
							))}
						</div>
					</li>
				))
			}
		</ul>
	</main>
</CustomLayout>
