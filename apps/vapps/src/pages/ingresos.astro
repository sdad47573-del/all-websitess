---
import { INGRESOS } from '../data/INGRESOS';
import CustomLayout from '../layouts/CustomLayout.astro';
---

<CustomLayout>
	<!-- <Modal /> -->

	<main class="px-4 py-6">
		<!-- <Stats /> -->

		<div class="rounded-2xl bg-gradient-to-br from-gray-50 to-gray-100 p-5 shadow-sm">
			<h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-gray-900">
				<i class="ri-dashboard-line text-teal-600"></i>Resumen y Estadísticas
			</h2><div class="grid grid-cols-2 gap-3">
				<div class="rounded-xl border border-gray-100 bg-white p-4 shadow-sm">
					<div class="mb-2 flex items-center gap-3">
						<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-500">
							<i class="ri-shopping-cart-line text-xl text-white"></i>
						</div>
					</div><p class="mb-1 text-xs text-gray-500">Ingresos Totales</p><p
						class="text-xl font-bold text-gray-900"
					>
						{INGRESOS.reduce((total, buy) => total + buy.EUR, 0)}€
					</p>
				</div>
			</div>
		</div>

		<h2 class="mb-4 text-xl font-semibold">Compras</h2>
		<!-- TODO: hacer un comp de vapslit generico -->
		<!-- <VapList /> -->

		<ul class="space-y-6">
			{
				INGRESOS.map((buy) => (
					<li class="rounded-lg bg-white p-4 shadow-md">
						<div class="mb-3">
							<h3 class="text-lg font-bold text-teal-700">Concepto: {buy.label}</h3>
							<p class="text-gray-600">
								Importe: <span class="font-semibold">{buy.EUR} €</span>
							</p>
							<p class="text-gray-600">
								Fecha:{' '}
								<span class="font-semibold">
									{buy.FECHA.getDate()}/{buy.FECHA.getMonth() + 1}/{buy.FECHA.getFullYear()}
								</span>
							</p>
						</div>
					</li>
				))
			}
		</ul>
	</main>
</CustomLayout>
