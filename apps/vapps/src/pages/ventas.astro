---
import Stats from '../components/Stats.astro';
import VapListItem from '../components/VapListItem.astro';
import { getAllSales } from '../services/sales.service';
import { imageMap } from '../data/maps/img';
import { translateItem } from '../data/maps/spanish';
import CustomLayout from '../layouts/CustomLayout.astro';

const { data: sales, error } = await getAllSales();

// Type for sales data
type Vaper = {
	id: number;
	title: string;
};

type Sale = {
	id: number;
	vaper_id: number;
	vapers: Vaper;
	amount: number;
	price_per_unit: number;
	payment?: number;
	concept?: string;
	created_at: string;
};

const typedSales = (sales || []) as Sale[];

// Calculate totals from sales data
const totalCalculated = typedSales.reduce(
	(total, sale) => total + sale.price_per_unit * sale.amount,
	0,
);
const totalReceived = typedSales.reduce((total, sale) => total + (sale.payment || 0), 0);

// Format date helper
const formatDate = (dateString: string) => {
	if (!dateString) return 'N/A';
	const date = new Date(dateString);
	return date.toLocaleDateString('es-ES', {
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
	});
};
---

<CustomLayout>
	<main class="">
		<Stats
			items={[
				{
					label: 'Calculo Total',
					value: totalCalculated.toFixed(2) + '€',
					icon: 'ri-shopping-cart-line',
					color: 'bg-blue-500',
				},
				{
					label: 'Cobrado Total',
					value: totalReceived.toFixed(2) + '€',
					icon: 'ri-money-euro-circle-line',
					color: 'bg-green-500',
				},
			]}
		/>

		<div class="p-5">
			<h2 class="mb-4 text-xl font-semibold">Historial de Ventas</h2>
		</div>

		{
			error && (
				<div class="mx-5 rounded-lg bg-red-100 p-4 text-red-700">
					Error al cargar las ventas: {error.message}
				</div>
			)
		}

		{
			typedSales.length === 0 ? (
				<div class="mx-5 rounded-lg bg-gray-100 p-8 text-center text-gray-600">
					No hay ventas registradas
				</div>
			) : (
				<ul class="space-y-4 px-5 pb-5">
					{typedSales.map((sale) => (
						<li class="rounded-lg bg-white p-4 shadow-md">
							<div class="flex flex-col gap-2">
								<div class="flex items-center justify-between border-b border-gray-200 pb-2">
									<h3 class="text-lg font-bold text-teal-700">Venta #{sale.id}</h3>
									<span class="text-sm text-gray-500">{formatDate(sale.created_at)}</span>
								</div>

								<div class="mb-3 max-w-3xs">
									<p class="mb-2 text-xs text-gray-500">Producto</p>
									<VapListItem
										src={imageMap[sale.vapers.title]}
										title={translateItem(sale.vapers.title)}
										amount={sale.amount}
									/>
								</div>

								<div class="grid grid-cols-2 gap-3 md:grid-cols-3">
									<div>
										<p class="text-xs text-gray-500">Precio Unitario</p>
										<p class="font-semibold text-gray-900">{sale.price_per_unit}€</p>
									</div>
									<div>
										<p class="text-xs text-gray-500">Cantidad</p>
										<p class="font-semibold text-gray-900">{sale.amount}</p>
									</div>
									<div>
										<p class="text-xs text-gray-500">Total</p>
										<p class="font-semibold text-teal-600">
											{(sale.price_per_unit * sale.amount).toFixed(2)}€
										</p>
									</div>
								</div>

								{sale.concept && (
									<div class="mt-2">
										<p class="text-xs text-gray-500">Concepto</p>
										<p class="text-sm text-gray-700">{sale.concept}</p>
									</div>
								)}

								{sale.payment !== undefined && sale.payment !== null && (
									<div class="mt-2 rounded-md bg-green-50 p-2">
										<p class="text-xs text-gray-500">Pago Recibido</p>
										<p class="font-semibold text-green-700">{sale.payment}€</p>
									</div>
								)}
							</div>
						</li>
					))}
				</ul>
			)
		}
	</main>
</CustomLayout>
